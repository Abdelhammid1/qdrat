@model QdratNew.ViewModels.Frontend.CourseLeadFormVM

@{
    ViewData["Title"] = "التسجيل";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">

            <div class="card shadow-sm border-0">

                <!-- Header -->
                <div class="card-header bg-white text-center border-0 pt-4">
                    <h4 class="fw-bold mb-1">سجل بياناتك</h4>
                    <p class="text-muted small mb-0">
                        اختر البرنامج المناسب لك وسيتم التواصل معك
                    </p>
                </div>

                <!-- Body -->
                <div class="card-body px-4 py-4">
                    <form method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <!-- اسم الطالب -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                اسم الطالب
                            </label>
                            <input asp-for="StudentName"
                                   class="form-control form-control-lg"
                                   placeholder="اكتب اسمك بالكامل" />
                            <span asp-validation-for="StudentName"
                                  class="text-danger small"></span>
                        </div>

                        <!-- رقم الهاتف -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                رقم الهاتف
                            </label>
                            <input asp-for="PhoneNumber"
                                   class="form-control form-control-lg"
                                   placeholder="05xxxxxxxx" />
                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger small"></span>
                        </div>

                        <!-- البرنامج -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                البرنامج
                            </label>
                            <select asp-for="SelectedProgram"
                                    asp-items="Model.Programs"
                                    class="form-select form-select-lg">
                                <option value="">-- اختر البرنامج --</option>
                            </select>
                            <span asp-validation-for="SelectedProgram"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Submit -->
                        <button type="submit"
                                class="btn btn-primary btn-lg w-100">
                            إرسال البيانات
                        </button>
                    </form>
                </div>

            </div>

        </div>
    </div>
</div>
