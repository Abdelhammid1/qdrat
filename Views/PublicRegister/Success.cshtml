@{
    ViewData["Title"] = "تم استلام طلبك";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/public-register.css" asp-append-version="true" />
}

<div class="rl-register">
    <div class="container rl-success">
        <div class="rl-success-card">
            <span class="rl-success-icon" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
            <ol class="rl-stepper rl-stepper-done" aria-hidden="true">
                <li class="rl-step is-done"><span class="rl-step-num"><i class="fa-solid fa-check"></i></span><span>اختر الدورات</span></li>
                <li class="rl-step is-done"><span class="rl-step-num"><i class="fa-solid fa-check"></i></span><span>بياناتك</span></li>
                <li class="rl-step is-current"><span class="rl-step-num"><i class="fa-solid fa-check"></i></span><span>تم الإرسال</span></li>
            </ol>
            <h1>تم استلام طلبك</h1>
            <p>شكرًا لاختيارك معهد قدرات. سيتواصل معك فريق المعهد قريبًا لتأكيد التفاصيل.</p>
            <a href="/" class="rl-submit rl-success-btn">العودة إلى الصفحة الرئيسية</a>
        </div>
    </div>
</div>
