@* أنماط الباقات المشتركة — تُدرَج مرة واحدة لكل صفحة. لون الباقة يُمرَّر فقط عبر --pkg-accent / --pkg-on-accent *@

<style>
    /* ===== Qudurat Design System tokens (مقيّدة بنطاق .qd-pkg) ===== */
    .qd-pkg {
        --qd-teal-700: #2a5f62;
        --qd-teal-600: #36787c;
        --qd-teal-500: #479498;
        --qd-teal-100: #dff0f1;
        --qd-teal-50: #f0f8f8;
        --qd-clay-600: #c4623a;
        --qd-clay-500: #da784d;
        --qd-ink-900: #2b2622;
        --qd-ink-600: #5e554d;
        --qd-ink-100: #f0ece6;
        --qd-border: #e7e1da;
        --qd-surface: #ffffff;
        --qd-r-md: 10px;
        --qd-r-lg: 14px;
        --qd-r-xl: 20px;
        --qd-shadow-md: 0 4px 14px rgba(70, 52, 38, .10);
        --qd-shadow-lg: 0 14px 36px rgba(70, 52, 38, .14);

        direction: rtl;
        font-family: 'Cairo', 'Tajawal', sans-serif;
        color: var(--qd-ink-900);
    }

    .qd-pkg--section { padding-block: 64px; background: var(--qd-teal-50); }
    .qd-pkg--page { padding-block: 40px 72px; background: var(--qd-teal-50); min-height: 60vh; }

    .qd-pkg__head { text-align: center; margin-block-end: 36px; }
    .qd-pkg__eyebrow {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 4px 14px; border-radius: 999px;
        background: var(--qd-teal-100); color: var(--qd-teal-700);
        font-size: .8rem; font-weight: 700; margin-block-end: 12px;
    }
    .qd-pkg__title { font-weight: 800; font-size: clamp(1.5rem, 3vw, 2.1rem); margin: 0 0 8px; }
    .qd-pkg__lead { color: var(--qd-ink-600); margin: 0; }

    .qd-pkg__grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
    @@media (min-width: 768px) { .qd-pkg__grid { grid-template-columns: repeat(2, 1fr); } }
    @@media (min-width: 1200px) { .qd-pkg__grid { grid-template-columns: repeat(3, 1fr); } }

    /* ===== البطاقة: البيانات يمينًا، البوستر كاملًا يسارًا بكامل الارتفاع، والأزرار أسفلهما ===== */
    .qd-pkgcard {
        display: grid; height: 100%;
        grid-template-columns: 1fr;
        grid-template-areas: "media" "content" "foot";
        background: var(--qd-surface); border: 1px solid var(--qd-border);
        border-radius: var(--qd-r-xl); box-shadow: var(--qd-shadow-md);
        overflow: hidden; transition: box-shadow .2s ease;
    }
    .qd-pkgcard:hover { box-shadow: var(--qd-shadow-lg); }
    /* RTL: العمود الأول يمين المحتوى → البيانات يمين والبوستر يسار */
    @@media (min-width: 480px) {
        .qd-pkgcard {
            grid-template-columns: 1fr minmax(110px, 38%);
            grid-template-rows: 1fr auto;
            grid-template-areas: "content media" "foot foot";
        }
    }

    .qd-pkgcard__media {
        grid-area: media; display: flex; align-items: center; justify-content: center;
        min-height: 200px; padding: 8px; overflow: hidden;
        background: var(--qd-teal-50); border-inline-end: 1px solid var(--qd-border);
    }
    /* الصورة كاملة بمقاسها بدون أي قص */
    .qd-pkgcard__media { position: relative; }
    .qd-pkgcard__media img { position: absolute; inset: 8px; width: calc(100% - 16px); height: calc(100% - 16px); object-fit: contain; }
    .qd-pkgcard__media-fallback {
        align-self: stretch; width: 100%; display: flex; align-items: center; justify-content: center;
        padding: 12px; text-align: center; font-weight: 800; font-size: 1rem; border-radius: 10px;
        background: var(--pkg-accent, #14A8AE); color: var(--pkg-on-accent, #fff);
    }
    @@media (max-width: 479px) {
        .qd-pkgcard__media { min-height: 0; max-height: 380px; }
        .qd-pkgcard__media img { position: static; width: 100%; height: auto; max-height: 380px; }
    }

    .qd-pkgcard__content { grid-area: content; display: flex; flex-direction: column; padding: 14px 16px 8px; min-width: 0; }
    .qd-pkgcard__head { margin-block-end: 10px; }
    .qd-pkgcard__name { font-weight: 800; font-size: 1.05rem; margin: 6px 0 0; line-height: 1.4; color: var(--qd-ink-900); }
    .qd-pkgcard__sub { margin: 2px 0 0; font-weight: 600; font-size: .8rem; color: var(--qd-ink-600); }
    .qd-pkgcard__grade {
        display: inline-block; padding: 2px 10px; border-radius: 999px;
        font-size: .7rem; font-weight: 700;
        background: var(--pkg-accent, #14A8AE); color: var(--pkg-on-accent, #fff);
    }
    .qd-pkgcard__label { font-weight: 800; font-size: .78rem; margin: 0 0 6px; color: var(--qd-ink-600); }

    .qd-pkgitems { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
    .qd-pkgitem {
        display: flex; align-items: center; gap: 8px;
        padding: 6px 8px; background: var(--qd-teal-50);
        border-radius: 8px; border-inline-start: 3px solid var(--item-color, var(--pkg-accent, #14A8AE));
    }
    .qd-pkgitem__num {
        flex: 0 0 auto; width: 20px; height: 20px; border-radius: 50%;
        display: inline-flex; align-items: center; justify-content: center;
        background: var(--item-color, var(--pkg-accent, #14A8AE)); color: #fff;
        font-weight: 800; font-size: .68rem; text-shadow: 0 0 2px rgba(0,0,0,.35);
    }
    .qd-pkgitem__icon { color: var(--qd-ink-600); font-size: .9rem; flex: 0 0 auto; }
    .qd-pkgitem__title { font-weight: 700; font-size: .8rem; line-height: 1.45; }

    .qd-pkgtags { display: flex; flex-wrap: wrap; gap: 6px; margin-block-start: 10px; }
    .qd-pkgtag {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 2px 10px; border-radius: 999px; font-size: .72rem; font-weight: 700;
        background: var(--qd-teal-100); color: var(--qd-teal-700);
    }

    .qd-pkgdiscount {
        margin-block-start: 10px; padding: 7px 12px; border-radius: var(--qd-r-md);
        background: var(--pkg-accent, #14A8AE); color: var(--pkg-on-accent, #fff);
        display: flex; align-items: center; justify-content: center; gap: 8px; text-align: center;
    }
    .qd-pkgdiscount__pct { font-weight: 800; font-size: 1rem; line-height: 1.2; }
    .qd-pkgdiscount__cap { font-weight: 600; font-size: .75rem; }

    .qd-pkgcard__foot { grid-area: foot; display: flex; flex-wrap: wrap; gap: 8px; padding: 8px 16px 14px; border-top: 1px solid var(--qd-border); }

    /* ===== الأزرار ===== */
    .qd-pkgbtn {
        flex: 1 1 110px; min-height: 40px; padding: 6px 12px;
        display: inline-flex; align-items: center; justify-content: center; gap: 6px;
        border-radius: var(--qd-r-md); border: 2px solid transparent;
        font-family: inherit; font-weight: 800; font-size: .8rem;
        text-decoration: none !important; cursor: pointer; transition: transform .2s ease, background-color .2s ease;
    }
    .qd-pkgbtn--primary { background: var(--qd-clay-600); color: #fff !important; }
    .qd-pkgbtn--primary:hover { background: #a9522f; transform: translateY(-2px); }
    .qd-pkgbtn--ghost { background: transparent; color: var(--qd-teal-700) !important; border-color: var(--qd-teal-500); }
    .qd-pkgbtn--ghost:hover { background: var(--qd-teal-100); }
    .qd-pkg a:focus-visible, .qd-pkg button:focus-visible { outline: 3px solid var(--qd-teal-500); outline-offset: 3px; }

    /* ===== صفحة التفاصيل ===== */
    .qd-pkgpage__hero .qd-pkgcard__grade { background: var(--pkg-on-accent, #fff); color: var(--pkg-accent, #14A8AE); margin-block-start: 12px; font-size: .8rem; padding: 3px 14px; }
    .qd-pkgpage__hero {
        background: var(--pkg-accent, #14A8AE); color: var(--pkg-on-accent, #fff);
        border-radius: var(--qd-r-xl); padding: 36px 28px; text-align: center;
        box-shadow: var(--qd-shadow-md); margin-block-end: 24px;
    }
    .qd-pkgpage__hero h1 { font-weight: 800; font-size: clamp(1.7rem, 4vw, 2.6rem); margin: 0; }
    .qd-pkgpage__hero p { margin: 8px 0 0; font-weight: 700; }
    .qd-pkgpanel {
        background: var(--qd-surface); border: 1px solid var(--qd-border);
        border-radius: var(--qd-r-xl); box-shadow: var(--qd-shadow-md);
        padding: 24px; margin-block-end: 24px;
    }
    .qd-pkgpanel h2 { font-weight: 800; font-size: 1.2rem; margin: 0 0 16px; }
    .qd-pkgpanel p { color: var(--qd-ink-600); line-height: 1.9; margin: 0; }

    .qd-pkgsched { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
    .qd-pkgsched__row {
        display: flex; align-items: flex-start; gap: 14px; padding: 14px 16px;
        border: 1px solid var(--qd-border); border-radius: var(--qd-r-lg);
        border-inline-start: 5px solid var(--item-color, var(--pkg-accent, #14A8AE));
    }
    .qd-pkgsched__title { font-weight: 800; margin: 0; }
    .qd-pkgsched__date { margin: 2px 0 0; color: var(--qd-ink-600); font-weight: 600; }
    .qd-pkgsched__note { margin: 2px 0 0; color: var(--qd-ink-600); font-size: .85rem; }

    .qd-pkgactions { display: flex; flex-wrap: wrap; gap: 10px; margin-block-start: 16px; }
    .qd-pkgposter-img { width: 100%; height: auto; border-radius: var(--qd-r-lg); }

    .qd-pkgempty { text-align: center; padding: 48px 16px; color: var(--qd-ink-600); }
    .qd-pkgempty i { font-size: 2.4rem; color: var(--qd-teal-500); display: block; margin-block-end: 10px; }

    @@media (max-width: 575px) {
        .qd-pkg--section { padding-block: 44px; }
        .qd-pkgpage__hero { padding: 28px 18px; }
        .qd-pkgpanel { padding: 18px; }
    }
    @@media (prefers-reduced-motion: reduce) {
        .qd-pkgcard, .qd-pkgbtn { transition: none; }
        .qd-pkgcard:hover, .qd-pkgbtn--primary:hover { transform: none; }
    }
</style>
