@model QdratNew.ViewModels.Frontend.Packages.PackageCardViewModel
@{
    var hasPoster = !string.IsNullOrWhiteSpace(Model.PosterImagePath);
}

@* AccentColor/OnAccentColor موثّقان بـ PackageStyleGuard.IsValidHex في الخدمة قبل الوصول إلى هنا *@
<article class="qd-pkgcard" style="--pkg-accent:@Model.AccentColor;--pkg-on-accent:@Model.OnAccentColor">
    <a class="qd-pkgcard__media" href="/packages/@Model.Slug" tabindex="-1" aria-hidden="true">
        @if (hasPoster)
        {
            <img src="@Model.PosterImagePath" alt="" loading="lazy" />
        }
        else
        {
            <span class="qd-pkgcard__media-fallback">@Model.Name</span>
        }
    </a>

    <div class="qd-pkgcard__content">
        <header class="qd-pkgcard__head">
            <span class="qd-pkgcard__grade">@Model.GradeLabel</span>
            <h3 class="qd-pkgcard__name">@Model.Name</h3>
            @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
            {
                <p class="qd-pkgcard__sub">@Model.Subtitle</p>
            }
        </header>

        @if (Model.Items.Count > 0)
        {
            <h4 class="qd-pkgcard__label">يشمل البكج</h4>
            <ul class="qd-pkgitems">
                @foreach (var item in Model.Items)
                {
                    <li class="qd-pkgitem" style="@(item.ColorHex != null ? "--item-color:" + item.ColorHex : null)">
                        <span class="qd-pkgitem__num" aria-hidden="true">@item.Number</span>
                        <i class="@item.IconBiClass qd-pkgitem__icon" aria-hidden="true"></i>
                        <span class="qd-pkgitem__title">@item.Title</span>
                    </li>
                }
            </ul>
        }

        @if (Model.Tags.Count > 0)
        {
            <div class="qd-pkgtags">
                @foreach (var tag in Model.Tags)
                {
                    <span class="qd-pkgtag">
                        @if (!string.IsNullOrEmpty(tag.IconBiClass)) { <i class="@tag.IconBiClass" aria-hidden="true"></i> }
                        @tag.Text
                    </span>
                }
            </div>
        }

        @if (Model.DiscountPercent.HasValue)
        {
            <div class="qd-pkgdiscount">
                <span class="qd-pkgdiscount__pct">خصم @Model.DiscountPercent%</span>
                @if (!string.IsNullOrWhiteSpace(Model.DiscountCaption))
                {
                    <span class="qd-pkgdiscount__cap">@Model.DiscountCaption</span>
                }
            </div>
        }

    </div>

    <div class="qd-pkgcard__foot">
        <a class="qd-pkgbtn qd-pkgbtn--ghost" href="/packages/@Model.Slug">التفاصيل والجدول</a>
        <a class="qd-pkgbtn qd-pkgbtn--primary" href="/packages/@Model.Slug#book">@Model.ButtonText</a>
    </div>
</article>
