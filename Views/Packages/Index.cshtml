@model List<QdratNew.ViewModels.Frontend.Packages.PackageCardViewModel>
@{
    ViewData["Title"] = "الباقات";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}

@await Html.PartialAsync("_PackagesStyles")

<section class="qd-pkg qd-pkg--page" aria-labelledby="packagesPageHeading">
    <div class="container">
        <header class="qd-pkg__head">
            <h1 id="packagesPageHeading" class="qd-pkg__title">الباقات</h1>
            <p class="qd-pkg__lead">اجمع دوراتك في باقة واحدة ووفّر أكثر.</p>
        </header>

        @if (Model.Count == 0)
        {
            <div class="qd-pkgempty">
                <i class="bi bi-box2" aria-hidden="true"></i>
                <p>لا توجد باقات متاحة حاليًا. تابعنا قريبًا.</p>
            </div>
        }
        else
        {
            <div class="qd-pkg__grid">
                @foreach (var package in Model)
                {
                    @await Html.PartialAsync("_PackageCard", package)
                }
            </div>
        }
    </div>
</section>
