@model QdratNew.ViewModels.Frontend.Packages.PackageDetailsPageViewModel
@{
    var pkg = Model.Package;
    ViewData["Title"] = pkg.Name;
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
    var hasPoster = !string.IsNullOrWhiteSpace(pkg.PosterImagePath);
    var hasErrors = !ViewData.ModelState.IsValid;
}

<style>
    /* ===== Qudurat Design System tokens (مقيّدة بنطاق .qd-pkgd) ===== */
    .qd-pkgd {
        --qd-teal-700: #2a5f62;
        --qd-teal-600: #36787c;
        --qd-teal-500: #479498;
        --qd-teal-100: #dff0f1;
        --qd-teal-50: #f0f8f8;
        --qd-clay-600: #c4623a;
        --qd-clay-500: #da784d;
        --qd-ink-900: #2b2622;
        --qd-ink-600: #5e554d;
        --qd-border: #e7e1da;
        --qd-surface: #ffffff;
        --qd-danger: #b3261e;
        --qd-r-md: 10px;
        --qd-r-lg: 14px;
        --qd-r-xl: 22px;
        --qd-shadow-md: 0 4px 14px rgba(70, 52, 38, .10);
        --qd-shadow-lg: 0 18px 44px rgba(70, 52, 38, .16);

        direction: rtl;
        font-family: 'Cairo', 'Tajawal', sans-serif;
        color: var(--qd-ink-900);
        background:
            radial-gradient(900px 340px at 85% -80px, color-mix(in srgb, var(--pkg-accent, #14A8AE) 22%, transparent), transparent 70%),
            var(--qd-teal-50);
        padding-block: 28px 80px;
    }

    .qd-pkgd__crumb { font-size: .85rem; margin-block-end: 18px; }
    .qd-pkgd__crumb a { color: var(--qd-teal-700); text-decoration: none; font-weight: 700; }
    .qd-pkgd__crumb a:hover { text-decoration: underline; }

    .qd-pkgd__layout { display: grid; grid-template-columns: 1fr; gap: 24px; align-items: start; }
    @@media (min-width: 992px) { .qd-pkgd__layout { grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr); gap: 32px; } }
    .qd-pkgd__aside { display: grid; gap: 20px; }
    @@media (min-width: 992px) { .qd-pkgd__aside { position: sticky; inset-block-start: 96px; } }

    .qd-pkgd__card {
        background: var(--qd-surface); border: 1px solid var(--qd-border);
        border-radius: var(--qd-r-xl); box-shadow: var(--qd-shadow-md); padding: 24px;
    }
    .qd-pkgd__card + .qd-pkgd__card { margin-block-start: 20px; }
    .qd-pkgd__h2 { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.05rem; margin: 0 0 16px; }
    .qd-pkgd__h2 i { color: var(--pkg-accent, #14A8AE); }

    /* ===== الترويسة ===== */
    .qd-pkgd__hero { position: relative; overflow: hidden; border-block-start: 6px solid var(--pkg-accent, #14A8AE); }
    .qd-pkgd__grade {
        display: inline-flex; align-items: center; gap: 6px; padding: 3px 14px; border-radius: 999px;
        font-size: .78rem; font-weight: 700;
        background: var(--pkg-accent, #14A8AE); color: var(--pkg-on-accent, #fff);
    }
    .qd-pkgd__name { font-weight: 800; font-size: clamp(1.6rem, 3.4vw, 2.3rem); line-height: 1.3; margin: 12px 0 4px; }
    .qd-pkgd__sub { font-weight: 700; color: var(--qd-ink-600); margin: 0 0 4px; }
    .qd-pkgd__intro { color: var(--qd-ink-600); line-height: 1.9; margin: 12px 0 0; font-size: .95rem; }
    .qd-pkgd__discount {
        display: inline-flex; align-items: center; gap: 10px; margin-block-start: 18px;
        padding: 8px 16px; border-radius: var(--qd-r-lg);
        background: var(--pkg-accent, #14A8AE); color: var(--pkg-on-accent, #fff);
    }
    .qd-pkgd__discount b { font-size: 1.4rem; line-height: 1; font-weight: 800; }
    .qd-pkgd__discount span { font-weight: 700; font-size: .85rem; }

    .qd-pkgd__tags { display: flex; flex-wrap: wrap; gap: 8px; margin-block-start: 16px; }
    .qd-pkgd__tag {
        display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 999px;
        font-size: .8rem; font-weight: 700; background: var(--qd-teal-100); color: var(--qd-teal-700);
    }

    /* ===== يشمل البكج ===== */
    .qd-pkgd__chips { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
    @@media (min-width: 576px) { .qd-pkgd__chips { grid-template-columns: repeat(2, 1fr); } }
    .qd-pkgd__chip {
        display: flex; align-items: center; gap: 10px; padding: 10px 12px;
        background: var(--qd-teal-50); border-radius: var(--qd-r-md);
        border-inline-start: 4px solid var(--item-color, var(--pkg-accent, #14A8AE));
    }
    .qd-pkgd__chip i { font-size: 1.15rem; color: var(--item-color, var(--qd-teal-700)); flex: 0 0 auto; }
    .qd-pkgd__chip span { font-weight: 700; font-size: .9rem; line-height: 1.5; }

    /* ===== جدول الدورات (خط زمني) ===== */
    .qd-pkgd__timeline { list-style: none; margin: 0; padding: 0; position: relative; }
    .qd-pkgd__step { position: relative; display: flex; gap: 16px; padding-block-end: 22px; }
    .qd-pkgd__step:last-child { padding-block-end: 0; }
    .qd-pkgd__step::before {
        content: ""; position: absolute; inset-block: 36px 0; inset-inline-start: 17px; width: 2px;
        background: var(--qd-border);
    }
    .qd-pkgd__step:last-child::before { display: none; }
    .qd-pkgd__num {
        flex: 0 0 36px; width: 36px; height: 36px; border-radius: 50%;
        display: inline-flex; align-items: center; justify-content: center;
        font-weight: 800; font-size: .9rem; color: #fff;
        background: var(--item-color, var(--pkg-accent, #14A8AE));
        text-shadow: 0 0 3px rgba(0, 0, 0, .35); position: relative; z-index: 1;
    }
    .qd-pkgd__stepbody { flex: 1; min-width: 0; padding-block-start: 2px; }
    .qd-pkgd__steptitle { font-weight: 800; margin: 0; font-size: 1rem; }
    .qd-pkgd__stepdate { margin: 2px 0 0; display: flex; align-items: center; gap: 6px; color: var(--qd-ink-600); font-weight: 600; font-size: .9rem; }
    .qd-pkgd__stepnote { margin: 2px 0 0; color: var(--qd-ink-600); font-size: .82rem; }

    /* ===== البوستر ===== */
    .qd-pkgd__poster { padding: 12px; }
    .qd-pkgd__posterbtn {
        display: block; width: 100%; padding: 0; border: 0; background: transparent;
        border-radius: var(--qd-r-lg); cursor: zoom-in; position: relative; overflow: hidden;
    }
    .qd-pkgd__posterbtn img { display: block; width: 100%; height: auto; border-radius: var(--qd-r-lg); }
    .qd-pkgd__zoom {
        position: absolute; inset-block-end: 10px; inset-inline-start: 10px; padding: 4px 12px; border-radius: 999px;
        background: rgba(43, 38, 34, .78); color: #fff; font-size: .75rem; font-weight: 700;
        display: inline-flex; align-items: center; gap: 6px;
    }

    /* ===== نموذج الحجز ===== */
    .qd-pkgd__book { border-block-start: 6px solid var(--qd-clay-500); scroll-margin-block-start: 96px; }
    .qd-pkgd__booktitle { font-weight: 800; font-size: 1.2rem; margin: 0 0 4px; }
    .qd-pkgd__booksub { color: var(--qd-ink-600); font-size: .88rem; margin: 0 0 18px; }
    .qd-pkgd__field { margin-block-end: 14px; }
    .qd-pkgd__label { display: block; font-weight: 700; font-size: .85rem; margin-block-end: 6px; }
    .qd-pkgd__input {
        width: 100%; min-height: 48px; padding: 10px 14px; font: inherit; font-size: .95rem;
        color: var(--qd-ink-900); background: #fff; border: 2px solid var(--qd-border); border-radius: var(--qd-r-md);
        transition: border-color .2s ease, box-shadow .2s ease;
    }
    .qd-pkgd__input:focus { outline: none; border-color: var(--qd-teal-500); box-shadow: 0 0 0 4px var(--qd-teal-100); }
    .qd-pkgd__input[aria-invalid="true"] { border-color: var(--qd-danger); }
    .qd-pkgd__input--phone { direction: ltr; text-align: right; }
    .qd-pkgd__error { display: block; margin-block-start: 6px; color: var(--qd-danger); font-size: .8rem; font-weight: 700; }
    .qd-pkgd__hp { position: absolute; inset-inline-start: -9999px; width: 1px; height: 1px; overflow: hidden; }
    .qd-pkgd__submit {
        width: 100%; min-height: 50px; display: inline-flex; align-items: center; justify-content: center; gap: 10px;
        border: 0; border-radius: var(--qd-r-lg); background: var(--qd-clay-600); color: #fff;
        font: inherit; font-weight: 800; font-size: 1rem; cursor: pointer;
        box-shadow: 0 8px 20px rgba(196, 98, 58, .28); transition: background-color .2s ease, transform .2s ease;
    }
    .qd-pkgd__submit:hover { background: #a9522f; transform: translateY(-2px); }
    .qd-pkgd__submit:disabled { opacity: .7; cursor: progress; transform: none; }
    .qd-pkgd__privacy { margin: 12px 0 0; text-align: center; color: var(--qd-ink-600); font-size: .78rem; }
    .qd-pkgd a:focus-visible, .qd-pkgd button:focus-visible, .qd-pkgd__input:focus-visible { outline: 3px solid var(--qd-teal-500); outline-offset: 3px; }

    /* ===== رسالة الشكر ===== */
    .qd-pkgd__thanks { text-align: center; padding-block: 8px; }
    .qd-pkgd__thanks-icon {
        width: 76px; height: 76px; margin: 0 auto 16px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center; font-size: 2.2rem;
        background: #e4f4ea; color: #2e8b57; animation: qd-pop .5s ease both;
    }
    .qd-pkgd__thanks h2 { font-weight: 800; font-size: 1.3rem; margin: 0 0 10px; }
    .qd-pkgd__thanks p { color: var(--qd-ink-600); line-height: 1.9; margin: 0 0 8px; font-size: .95rem; }
    .qd-pkgd__thanks .qd-pkgd__warm { color: var(--qd-teal-700); font-weight: 700; }
    .qd-pkgd__back {
        display: inline-flex; align-items: center; gap: 8px; margin-block-start: 14px; min-height: 44px; padding: 8px 20px;
        border-radius: var(--qd-r-lg); border: 2px solid var(--qd-teal-500); color: var(--qd-teal-700);
        font-weight: 800; text-decoration: none;
    }
    .qd-pkgd__back:hover { background: var(--qd-teal-100); }
    @@keyframes qd-pop { from { transform: scale(.6); opacity: 0; } to { transform: scale(1); opacity: 1; } }

    @@media (max-width: 575px) {
        .qd-pkgd { padding-block: 18px 56px; }
        .qd-pkgd__card { padding: 18px; }
    }
    @@media (prefers-reduced-motion: reduce) {
        .qd-pkgd__thanks-icon { animation: none; }
        .qd-pkgd__submit, .qd-pkgd__input { transition: none; }
        .qd-pkgd__submit:hover { transform: none; }
    }
</style>

<div class="qd-pkgd" style="--pkg-accent:@pkg.AccentColor;--pkg-on-accent:@pkg.OnAccentColor">
    <div class="container">
        <nav class="qd-pkgd__crumb" aria-label="مسار التنقل">
            <a href="/packages"><i class="bi bi-arrow-right" aria-hidden="true"></i> كل الباقات</a>
        </nav>

        <div class="qd-pkgd__layout">
            <!-- ===== البيانات ===== -->
            <div class="qd-pkgd__main">
                <section class="qd-pkgd__card qd-pkgd__hero" aria-labelledby="pkgName">
                    <span class="qd-pkgd__grade"><i class="bi bi-mortarboard-fill" aria-hidden="true"></i> @pkg.GradeLabel</span>
                    <h1 id="pkgName" class="qd-pkgd__name">@pkg.Name</h1>
                    @if (!string.IsNullOrWhiteSpace(pkg.Subtitle))
                    {
                        <p class="qd-pkgd__sub">@pkg.Subtitle</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(pkg.IntroText))
                    {
                        <p class="qd-pkgd__intro">@pkg.IntroText</p>
                    }
                    @if (pkg.Tags.Count > 0)
                    {
                        <div class="qd-pkgd__tags">
                            @foreach (var tag in pkg.Tags)
                            {
                                <span class="qd-pkgd__tag">
                                    @if (!string.IsNullOrEmpty(tag.IconBiClass)) { <i class="@tag.IconBiClass" aria-hidden="true"></i> }
                                    @tag.Text
                                </span>
                            }
                        </div>
                    }
                    @if (pkg.DiscountPercent.HasValue)
                    {
                        <div class="qd-pkgd__discount">
                            <b>خصم @pkg.DiscountPercent%</b>
                            @if (!string.IsNullOrWhiteSpace(pkg.DiscountCaption)) { <span>@pkg.DiscountCaption</span> }
                        </div>
                    }
                </section>

                @if (pkg.Items.Count > 0)
                {
                    <section class="qd-pkgd__card" aria-labelledby="pkgIncludes">
                        <h2 id="pkgIncludes" class="qd-pkgd__h2"><i class="bi bi-box2-heart" aria-hidden="true"></i> يشمل البكج</h2>
                        <ul class="qd-pkgd__chips">
                            @foreach (var item in pkg.Items)
                            {
                                <li class="qd-pkgd__chip" style="@(item.ColorHex != null ? "--item-color:" + item.ColorHex : null)">
                                    <i class="@item.IconBiClass" aria-hidden="true"></i>
                                    <span>@item.Title</span>
                                </li>
                            }
                        </ul>
                    </section>

                    <section class="qd-pkgd__card" aria-labelledby="pkgSchedule">
                        <h2 id="pkgSchedule" class="qd-pkgd__h2"><i class="bi bi-calendar-event" aria-hidden="true"></i> جدول الدورات</h2>
                        <ol class="qd-pkgd__timeline">
                            @foreach (var item in pkg.Items)
                            {
                                <li class="qd-pkgd__step" style="@(item.ColorHex != null ? "--item-color:" + item.ColorHex : null)">
                                    <span class="qd-pkgd__num" aria-hidden="true">@item.Number</span>
                                    <div class="qd-pkgd__stepbody">
                                        <p class="qd-pkgd__steptitle">@item.ScheduleTitle</p>
                                        @if (!string.IsNullOrWhiteSpace(item.ScheduleText))
                                        {
                                            <p class="qd-pkgd__stepdate"><i class="bi bi-clock" aria-hidden="true"></i> @item.ScheduleText</p>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.ScheduleNote))
                                        {
                                            <p class="qd-pkgd__stepnote">@item.ScheduleNote</p>
                                        }
                                    </div>
                                </li>
                            }
                        </ol>
                    </section>
                }
            </div>

            <!-- ===== الصورة + الحجز ===== -->
            <aside class="qd-pkgd__aside">
                @if (hasPoster)
                {
                    <div class="qd-pkgd__card qd-pkgd__poster">
                        <button type="button" class="qd-pkgd__posterbtn" data-bs-toggle="modal" data-bs-target="#packagePosterModal"
                                aria-label="عرض بوستر @pkg.Name بحجم أكبر">
                            <img src="@pkg.PosterImagePath" alt="@pkg.Name" />
                            <span class="qd-pkgd__zoom"><i class="bi bi-zoom-in" aria-hidden="true"></i> تكبير</span>
                        </button>
                    </div>
                }

                <section id="book" class="qd-pkgd__card qd-pkgd__book" aria-labelledby="bookTitle">
                    @if (Model.Submitted)
                    {
                        <div class="qd-pkgd__thanks" role="status" aria-live="polite" tabindex="-1" id="bookThanks">
                            <div class="qd-pkgd__thanks-icon" aria-hidden="true"><i class="bi bi-heart-fill"></i></div>
                            <h2 id="bookTitle">شكرًا لك، أسعدنا اهتمامك!</h2>
                            <p>استلمنا طلب حجزك في <strong>@pkg.Name</strong> بنجاح.</p>
                            <p class="qd-pkgd__warm">سيتواصل معك فريق الإدارة قريبًا جدًا على رقم جوالك لإكمال الحجز.</p>
                            <p>يسعدنا أن نكون جزءًا من رحلتك نحو التفوق، ونتمنى لك كل التوفيق.</p>
                            <a class="qd-pkgd__back" href="/packages"><i class="bi bi-grid" aria-hidden="true"></i> تصفّح باقات أخرى</a>
                        </div>
                    }
                    else
                    {
                        <h2 id="bookTitle" class="qd-pkgd__booktitle">احجز مكانك الآن</h2>
                        <p class="qd-pkgd__booksub">اترك اسمك ورقم جوالك وسنتواصل معك لإكمال الحجز.</p>

                        <form method="post" action="/packages/@pkg.Slug" id="bookForm" novalidate>
                            @Html.AntiForgeryToken()
                            <div class="qd-pkgd__hp" aria-hidden="true">
                                <label for="Website">لا تملأ هذا الحقل</label>
                                <input type="text" id="Website" name="Website" tabindex="-1" autocomplete="off" />
                            </div>

                            <div class="qd-pkgd__field">
                                <label class="qd-pkgd__label" for="FullName">الاسم الكامل</label>
                                <input class="qd-pkgd__input" type="text" id="FullName" name="FullName" maxlength="150"
                                       autocomplete="name" value="@Model.Form.FullName" required
                                       aria-invalid="@(ViewData.ModelState["FullName"]?.Errors.Count > 0 ? "true" : "false")" />
                                @if (ViewData.ModelState["FullName"]?.Errors.Count > 0)
                                {
                                    <span class="qd-pkgd__error">@ViewData.ModelState["FullName"]!.Errors[0].ErrorMessage</span>
                                }
                            </div>

                            <div class="qd-pkgd__field">
                                <label class="qd-pkgd__label" for="PhoneNumber">رقم الجوال</label>
                                <input class="qd-pkgd__input qd-pkgd__input--phone" type="tel" id="PhoneNumber" name="PhoneNumber"
                                       inputmode="numeric" maxlength="15" autocomplete="tel" placeholder="05XXXXXXXX"
                                       value="@Model.Form.PhoneNumber" required
                                       aria-invalid="@(ViewData.ModelState["PhoneNumber"]?.Errors.Count > 0 ? "true" : "false")" />
                                @if (ViewData.ModelState["PhoneNumber"]?.Errors.Count > 0)
                                {
                                    <span class="qd-pkgd__error">@ViewData.ModelState["PhoneNumber"]!.Errors[0].ErrorMessage</span>
                                }
                            </div>

                            <button type="submit" class="qd-pkgd__submit" id="bookSubmit">
                                <i class="bi bi-send-fill" aria-hidden="true"></i>
                                <span>@pkg.ButtonText</span>
                            </button>
                            <p class="qd-pkgd__privacy"><i class="bi bi-shield-check" aria-hidden="true"></i> بياناتك محفوظة ولا تُستخدم إلا للتواصل معك.</p>
                        </form>
                    }
                </section>
            </aside>
        </div>
    </div>
</div>

@if (hasPoster)
{
    <div class="modal fade" id="packagePosterModal" tabindex="-1" aria-labelledby="packagePosterModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="packagePosterModalLabel">@pkg.Name</h2>
                    <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
                <div class="modal-body">
                    <img src="@pkg.PosterImagePath" alt="@pkg.Name" class="img-fluid d-block mx-auto" loading="lazy" />
                </div>
            </div>
        </div>
    </div>
}

<script>
    (function () {
        var form = document.getElementById("bookForm");
        if (form) {
            form.addEventListener("submit", function () {
                var btn = document.getElementById("bookSubmit");
                if (!btn || btn.disabled) return;
                btn.disabled = true;
                btn.querySelector("span").textContent = "جارٍ الإرسال...";
            });
        }
        var target = document.getElementById("bookThanks") || (@(hasErrors ? "true" : "false") ? document.getElementById("book") : null);
        if (target) {
            target.scrollIntoView({ behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "center" });
            if (target.id === "bookThanks") target.focus({ preventScroll: true });
        }
    })();
</script>
