@model QdratNew.ViewModels.Frontend.Packages.PackageDetailsPageViewModel
@{
    var pkg = Model.Package;
    ViewData["Title"] = pkg.Name;
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
    var hasPoster = !string.IsNullOrWhiteSpace(pkg.PosterImagePath);
    var hasErrors = !ViewData.ModelState.IsValid;
}

<style>
    /* ===== Qudurat Design System tokens (مقيّدة بنطاق .qd-pkgd) — نفس هوية صفحة الباقات ===== */
    .qd-pkgd {
        --qd-teal-700: #2a5f62;
        --qd-teal-600: #36787c;
        --qd-teal-500: #479498;
        --qd-teal-100: #dff0f1;
        --qd-teal-50: #f0f8f8;
        --qd-clay-600: #c4623a;
        --qd-clay-500: #da784d;
        --qd-ink-900: #2b2622;
        --qd-ink-600: #5e554d;
        --qd-border: #e7e1da;
        --qd-surface: #ffffff;
        --qd-danger: #b3261e;
        --qd-r-md: 10px;
        --qd-r-lg: 14px;
        --qd-r-xl: 20px;
        --qd-shadow-md: 0 4px 14px rgba(70, 52, 38, .10);
        --qd-shadow-lg: 0 14px 36px rgba(70, 52, 38, .14);

        direction: rtl;
        font-family: 'Cairo', 'Tajawal', sans-serif;
        color: var(--qd-ink-900);
        background: var(--qd-teal-50);
        padding-block: 28px 80px;
    }

    .qd-pkgd__crumb { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: .85rem; margin-block-end: 18px; color: var(--qd-ink-600); }
    .qd-pkgd__crumb a { color: var(--qd-teal-700); text-decoration: none; font-weight: 700; }
    .qd-pkgd__crumb a:hover { text-decoration: underline; }
    .qd-pkgd__crumb i { font-size: .7rem; }

    .qd-pkgd__card {
        background: var(--qd-surface); border: 1px solid var(--qd-border);
        border-radius: var(--qd-r-xl); box-shadow: var(--qd-shadow-md); padding: 24px;
    }
    .qd-pkgd__h2 { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.1rem; margin: 0 0 18px; }
    .qd-pkgd__h2 i {
        width: 34px; height: 34px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center;
        background: var(--qd-teal-100); color: var(--qd-teal-700); font-size: 1rem;
    }
    .qd-pkgd__h2 small { margin-inline-start: auto; font-size: .78rem; font-weight: 700; color: var(--qd-ink-600); }

    /* ===== الترويسة: البيانات يمينًا والبوستر يسارًا (مثل بطاقة الباقة) ===== */
    .qd-pkgd__hero {
        display: grid; grid-template-columns: 1fr; padding: 0; overflow: hidden;
        border-block-start: 6px solid var(--pkg-accent, #14A8AE);
        background: var(--qd-teal-50);
        background: linear-gradient(135deg, color-mix(in srgb, var(--pkg-accent, #14A8AE) 14%, #fff), color-mix(in srgb, var(--pkg-accent, #14A8AE) 5%, #fff));
    }
    @@media (min-width: 992px) {
        .qd-pkgd__hero--poster { grid-template-columns: minmax(0, 1fr) 260px; }
    }
    .qd-pkgd__herotext { padding: 32px; min-width: 0; }
    .qd-pkgd__grade {
        display: inline-flex; align-items: center; gap: 6px; padding: 3px 14px; border-radius: 999px;
        font-size: .8rem; font-weight: 700; background: var(--pkg-accent, #14A8AE); color: var(--pkg-on-accent, #fff);
    }
    .qd-pkgd__name { font-weight: 800; font-size: clamp(1.7rem, 3.6vw, 2.5rem); line-height: 1.3; margin: 14px 0 4px; }
    .qd-pkgd__sub { font-weight: 700; color: var(--qd-ink-600); font-size: 1.05rem; margin: 0; }
    .qd-pkgd__intro { color: var(--qd-ink-600); line-height: 2; font-size: .98rem; margin: 16px 0 0; max-width: 62ch; }

    .qd-pkgd__tags { display: flex; flex-wrap: wrap; gap: 8px; margin-block-start: 18px; }
    .qd-pkgd__tag {
        display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 999px;
        font-size: .8rem; font-weight: 700; background: var(--qd-teal-100); color: var(--qd-teal-700);
    }

    .qd-pkgd__facts {
        display: flex; flex-wrap: wrap; gap: 12px; margin: 22px 0 0; padding: 0; list-style: none;
    }
    .qd-pkgd__fact {
        display: flex; align-items: center; gap: 10px; padding: 8px 14px 8px 16px;
        background: #fff; border: 1px solid var(--qd-border); border-radius: var(--qd-r-lg);
    }
    .qd-pkgd__fact i { font-size: 1.2rem; color: var(--qd-teal-700); }
    .qd-pkgd__fact b { display: block; font-weight: 800; font-size: 1rem; line-height: 1.2; }
    .qd-pkgd__fact span { display: block; font-size: .75rem; font-weight: 600; color: var(--qd-ink-600); }
    .qd-pkgd__fact--discount { background: var(--pkg-accent, #14A8AE); border-color: transparent; color: var(--pkg-on-accent, #fff); }
    .qd-pkgd__fact--discount i, .qd-pkgd__fact--discount span { color: inherit; }

    .qd-pkgd__cta { display: flex; flex-wrap: wrap; gap: 10px; margin-block-start: 24px; }
    .qd-pkgd__btn {
        min-height: 48px; padding: 8px 24px; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        border-radius: var(--qd-r-lg); border: 2px solid transparent; font: inherit; font-weight: 800; font-size: .95rem;
        text-decoration: none; cursor: pointer; transition: transform .2s ease, background-color .2s ease;
    }
    .qd-pkgd__btn--primary { background: #a9522f; color: #fff; box-shadow: 0 8px 20px rgba(196, 98, 58, .28); }
    .qd-pkgd__btn--primary:hover { background: #8f4325; color: #fff; transform: translateY(-2px); }
    .qd-pkgd__btn--ghost { color: var(--qd-teal-700); border-color: var(--qd-teal-500); background: transparent; }
    .qd-pkgd__btn--ghost:hover { background: var(--qd-teal-100); color: var(--qd-teal-700); }

    .qd-pkgd__media { background: rgba(255, 255, 255, .55); border-inline-end: 1px solid var(--qd-border); padding: 16px; display: flex; align-items: center; justify-content: center; }
    @@media (max-width: 991px) { .qd-pkgd__media { order: -1; border-inline-end: 0; border-block-end: 1px solid var(--qd-border); } }
    .qd-pkgd__posterbtn {
        display: block; width: 100%; padding: 0; border: 0; background: transparent; cursor: zoom-in;
        border-radius: var(--qd-r-lg); position: relative; overflow: hidden; align-self: center;
    }
    .qd-pkgd__posterbtn img { display: block; width: 100%; height: auto; max-height: 340px; object-fit: contain; border-radius: var(--qd-r-lg); }
    @@media (max-width: 991px) { .qd-pkgd__posterbtn { width: auto; max-width: 220px; } .qd-pkgd__media { padding: 12px; } .qd-pkgd__posterbtn img { max-height: 280px; } }
    .qd-pkgd__zoom {
        position: absolute; inset-block-end: 10px; inset-inline-start: 10px; padding: 4px 12px; border-radius: 999px;
        background: rgba(43, 38, 34, .8); color: #fff; font-size: .75rem; font-weight: 700;
        display: inline-flex; align-items: center; gap: 6px;
    }

    /* ===== التخطيط ===== */
    .qd-pkgd__layout { display: grid; grid-template-columns: 1fr; gap: 24px; align-items: start; margin-block-start: 24px; }
    @@media (min-width: 992px) { .qd-pkgd__layout { grid-template-columns: minmax(0, 1fr) 380px; gap: 28px; } }
    .qd-pkgd__main { display: grid; gap: 24px; min-width: 0; }
    @@media (min-width: 992px) { .qd-pkgd__aside { position: sticky; inset-block-start: 96px; } }
    .qd-pkgd__anchor { scroll-margin-block-start: 96px; }

    /* ===== يشمل البكج ===== */
    .qd-pkgd__chips { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
    @@media (min-width: 576px) { .qd-pkgd__chips { grid-template-columns: repeat(2, 1fr); } }
    .qd-pkgd__chip {
        display: flex; align-items: center; gap: 10px; padding: 10px 12px;
        background: var(--qd-teal-50); border-radius: var(--qd-r-md);
        border-inline-start: 4px solid var(--item-color, var(--pkg-accent, #14A8AE));
    }
    .qd-pkgd__chipnum {
        flex: 0 0 24px; width: 24px; height: 24px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;
        font-weight: 800; font-size: .72rem; background: var(--item-color, var(--pkg-accent, #14A8AE)); color: var(--item-on, var(--pkg-on-accent, #fff));
    }
    .qd-pkgd__chip i { color: var(--qd-ink-600); font-size: 1rem; flex: 0 0 auto; }
    .qd-pkgd__chip span:last-child { font-weight: 700; font-size: .9rem; line-height: 1.5; }

    /* ===== جدول الدورات ===== */
    .qd-pkgd__sched { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
    .qd-pkgd__row {
        display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 16px; align-items: center; padding: 14px 16px;
        border: 1px solid var(--qd-border); border-radius: var(--qd-r-lg);
        border-inline-start: 5px solid var(--item-color, var(--pkg-accent, #14A8AE));
        transition: box-shadow .2s ease;
    }
    .qd-pkgd__row:hover { box-shadow: var(--qd-shadow-md); }
    .qd-pkgd__num {
        width: 40px; height: 40px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center;
        font-weight: 800; background: var(--item-color, var(--pkg-accent, #14A8AE)); color: var(--item-on, var(--pkg-on-accent, #fff));
    }
    .qd-pkgd__steptitle { font-weight: 800; margin: 0; font-size: 1rem; }
    .qd-pkgd__stepdate { margin: 4px 0 0; display: flex; align-items: center; gap: 6px; color: var(--qd-teal-700); font-weight: 700; font-size: .9rem; }
    .qd-pkgd__stepnote { margin: 4px 0 0; color: var(--qd-ink-600); font-size: .82rem; }

    /* ===== نموذج الحجز ===== */
    .qd-pkgd__book { padding: 0; overflow: hidden; border-block-start: 6px solid var(--qd-clay-500); scroll-margin-block-start: 96px; box-shadow: var(--qd-shadow-lg); }
    .qd-pkgd__bookhead { padding: 22px 24px 0; }
    .qd-pkgd__bookbody { padding: 0 24px 24px; }
    .qd-pkgd__booktitle { display: flex; align-items: center; gap: 8px; font-weight: 800; font-size: 1.25rem; margin: 0 0 4px; }
    .qd-pkgd__booktitle i { color: var(--qd-clay-600); }
    .qd-pkgd__booksub { color: var(--qd-ink-600); font-size: .88rem; margin: 0 0 18px; }
    .qd-pkgd__offer {
        display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 0 24px 18px; padding: 10px 16px;
        border-radius: var(--qd-r-lg); background: var(--pkg-accent, #14A8AE); color: var(--pkg-on-accent, #fff);
    }
    .qd-pkgd__offer b { font-size: 1.5rem; font-weight: 800; line-height: 1; }
    .qd-pkgd__offer span { font-weight: 700; font-size: .85rem; text-align: end; }
    .qd-pkgd__field { margin-block-end: 14px; }
    .qd-pkgd__label { display: block; font-weight: 700; font-size: .85rem; margin-block-end: 6px; }
    .qd-pkgd__input {
        width: 100%; min-height: 48px; padding: 10px 14px; font: inherit; font-size: .95rem;
        color: var(--qd-ink-900); background: #fff; border: 2px solid var(--qd-border); border-radius: var(--qd-r-md);
        transition: border-color .2s ease, box-shadow .2s ease;
    }
    .qd-pkgd__input:focus { outline: none; border-color: var(--qd-teal-500); box-shadow: 0 0 0 4px var(--qd-teal-100); }
    .qd-pkgd__input[aria-invalid="true"] { border-color: var(--qd-danger); }
    .qd-pkgd__input--phone { direction: ltr; text-align: right; }
    .qd-pkgd__error { display: block; margin-block-start: 6px; color: var(--qd-danger); font-size: .8rem; font-weight: 700; }
    .qd-pkgd__hp { position: absolute; inset-inline-start: -9999px; width: 1px; height: 1px; overflow: hidden; }
    .qd-pkgd__submit {
        width: 100%; min-height: 52px; display: inline-flex; align-items: center; justify-content: center; gap: 10px;
        border: 0; border-radius: var(--qd-r-lg); background: #a9522f; color: #fff;
        font: inherit; font-weight: 800; font-size: 1rem; cursor: pointer;
        box-shadow: 0 8px 20px rgba(196, 98, 58, .28); transition: background-color .2s ease, transform .2s ease;
    }
    .qd-pkgd__submit:hover { background: #8f4325; transform: translateY(-2px); }
    .qd-pkgd__submit:disabled { opacity: .7; cursor: progress; transform: none; }
    .qd-pkgd__privacy { margin: 12px 0 0; text-align: center; color: var(--qd-ink-600); font-size: .78rem; }
    .qd-pkgd a:focus-visible, .qd-pkgd button:focus-visible, .qd-pkgd__input:focus-visible { outline: 3px solid var(--qd-teal-500); outline-offset: 3px; }

    /* ===== رسالة الشكر ===== */
    .qd-pkgd__thanks { text-align: center; padding: 28px 24px; }
    .qd-pkgd__thanks-icon {
        width: 76px; height: 76px; margin: 0 auto 16px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center; font-size: 2.2rem;
        background: #e4f4ea; color: #2e8b57; animation: qd-pop .5s ease both;
    }
    .qd-pkgd__thanks h2 { font-weight: 800; font-size: 1.3rem; margin: 0 0 10px; }
    .qd-pkgd__thanks p { color: var(--qd-ink-600); line-height: 1.9; margin: 0 0 8px; font-size: .95rem; }
    .qd-pkgd__thanks .qd-pkgd__warm { color: var(--qd-teal-700); font-weight: 700; }
    .qd-pkgd__back {
        display: inline-flex; align-items: center; gap: 8px; margin-block-start: 14px; min-height: 44px; padding: 8px 20px;
        border-radius: var(--qd-r-lg); border: 2px solid var(--qd-teal-500); color: var(--qd-teal-700);
        font-weight: 800; text-decoration: none;
    }
    .qd-pkgd__back:hover { background: var(--qd-teal-100); }
    @@keyframes qd-pop { from { transform: scale(.6); opacity: 0; } to { transform: scale(1); opacity: 1; } }

    /* ===== شريط الحجز السفلي (جوال) ===== */
    .qd-pkgd__sticky {
        position: fixed; inset-inline: 0; inset-block-end: 0; z-index: 1030; display: none;
        padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); background: var(--qd-surface);
        border-block-start: 1px solid var(--qd-border); box-shadow: 0 -8px 24px rgba(70, 52, 38, .12);
    }
    .qd-pkgd__sticky a {
        display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 48px; border-radius: var(--qd-r-lg);
        background: #a9522f; color: #fff; font-weight: 800; text-decoration: none;
    }
    @@media (max-width: 991px) { .qd-pkgd__sticky { display: block; } .qd-pkgd { padding-block-end: 96px; } }

    @@media (max-width: 575px) {
        .qd-pkgd { padding-block-start: 18px; }
        .qd-pkgd__card { padding: 18px; }
        .qd-pkgd__herotext { padding: 22px 18px; }
        .qd-pkgd__book { padding: 0; }
        .qd-pkgd__bookhead { padding: 18px 18px 0; }
        .qd-pkgd__bookbody { padding: 0 18px 18px; }
        .qd-pkgd__offer { margin-inline: 18px; }
        .qd-pkgd__btn { flex: 1 1 100%; }
    }
    @@media (prefers-reduced-motion: reduce) {
        .qd-pkgd__thanks-icon { animation: none; }
        .qd-pkgd__submit, .qd-pkgd__input, .qd-pkgd__btn, .qd-pkgd__row { transition: none; }
        .qd-pkgd__submit:hover, .qd-pkgd__btn--primary:hover { transform: none; }
    }
</style>

<div class="qd-pkgd" style="--pkg-accent:@pkg.AccentColor;--pkg-on-accent:@pkg.OnAccentColor">
    <div class="container">
        <nav class="qd-pkgd__crumb" aria-label="مسار التنقل">
            <a href="/">الرئيسية</a>
            <i class="bi bi-chevron-left" aria-hidden="true"></i>
            <a href="/packages">الباقات</a>
            <i class="bi bi-chevron-left" aria-hidden="true"></i>
            <span aria-current="page">@pkg.Name</span>
        </nav>

        <!-- ===== الترويسة: مقدمة عن الباقة ===== -->
        <header class="qd-pkgd__card qd-pkgd__hero@(hasPoster ? " qd-pkgd__hero--poster" : "")">
            <div class="qd-pkgd__herotext">
                <span class="qd-pkgd__grade"><i class="bi bi-mortarboard-fill" aria-hidden="true"></i> @pkg.GradeLabel</span>
                <h1 id="pkgName" class="qd-pkgd__name">@pkg.Name</h1>
                @if (!string.IsNullOrWhiteSpace(pkg.Subtitle))
                {
                    <p class="qd-pkgd__sub">@pkg.Subtitle</p>
                }
                @if (!string.IsNullOrWhiteSpace(pkg.IntroText))
                {
                    <p class="qd-pkgd__intro">@pkg.IntroText</p>
                }
                @if (pkg.Tags.Count > 0)
                {
                    <div class="qd-pkgd__tags">
                        @foreach (var tag in pkg.Tags)
                        {
                            <span class="qd-pkgd__tag">
                                @if (!string.IsNullOrEmpty(tag.IconBiClass)) { <i class="@tag.IconBiClass" aria-hidden="true"></i> }
                                @tag.Text
                            </span>
                        }
                    </div>
                }

                @if (pkg.Items.Count > 0 || pkg.DiscountPercent.HasValue)
                {
                    <ul class="qd-pkgd__facts">
                        @if (pkg.Items.Count > 0)
                        {
                            <li class="qd-pkgd__fact">
                                <i class="bi bi-collection-play" aria-hidden="true"></i>
                                <div><b>@pkg.Items.Count</b><span>@(pkg.Items.Count == 1 ? "دورة ضمن الباقة" : "دورات ضمن الباقة")</span></div>
                            </li>
                        }
                        @if (pkg.DiscountPercent.HasValue)
                        {
                            <li class="qd-pkgd__fact qd-pkgd__fact--discount">
                                <i class="bi bi-percent" aria-hidden="true"></i>
                                <div><b>خصم @pkg.DiscountPercent%</b>@if (!string.IsNullOrWhiteSpace(pkg.DiscountCaption)) { <span>@pkg.DiscountCaption</span> }</div>
                            </li>
                        }
                    </ul>
                }

                @if (!Model.Submitted)
                {
                    <div class="qd-pkgd__cta">
                        <a class="qd-pkgd__btn qd-pkgd__btn--primary" href="#book"><i class="bi bi-bookmark-star-fill" aria-hidden="true"></i> @pkg.ButtonText</a>
                        @if (pkg.Items.Count > 0)
                        {
                            <a class="qd-pkgd__btn qd-pkgd__btn--ghost" href="#pkgSchedule"><i class="bi bi-calendar-event" aria-hidden="true"></i> جدول الدورات</a>
                        }
                    </div>
                }
            </div>

            @if (hasPoster)
            {
                <div class="qd-pkgd__media">
                    <button type="button" class="qd-pkgd__posterbtn" data-bs-toggle="modal" data-bs-target="#packagePosterModal"
                            aria-label="عرض بوستر @pkg.Name بحجم أكبر">
                        <img src="@pkg.PosterImagePath" alt="@pkg.Name" />
                        <span class="qd-pkgd__zoom"><i class="bi bi-zoom-in" aria-hidden="true"></i> تكبير</span>
                    </button>
                </div>
            }
        </header>

        <div class="qd-pkgd__layout">
            <!-- ===== المحتوى ===== -->
            <div class="qd-pkgd__main">
                @if (pkg.Items.Count > 0)
                {
                    <section class="qd-pkgd__card" aria-labelledby="pkgIncludes">
                        <h2 id="pkgIncludes" class="qd-pkgd__h2"><i class="bi bi-box2-heart" aria-hidden="true"></i> يشمل البكج <small>@pkg.Items.Count عناصر</small></h2>
                        <ul class="qd-pkgd__chips">
                            @foreach (var item in pkg.Items)
                            {
                                <li class="qd-pkgd__chip" style="@(item.ColorHex != null ? "--item-color:" + item.ColorHex + ";--item-on:" + item.OnColorHex : null)">
                                    <span class="qd-pkgd__chipnum" aria-hidden="true">@item.Number</span>
                                    <i class="@item.IconBiClass" aria-hidden="true"></i>
                                    <span>@item.Title</span>
                                </li>
                            }
                        </ul>
                    </section>

                    <section id="pkgSchedule" class="qd-pkgd__card qd-pkgd__anchor" aria-labelledby="pkgScheduleTitle">
                        <h2 id="pkgScheduleTitle" class="qd-pkgd__h2"><i class="bi bi-calendar-event" aria-hidden="true"></i> جدول الدورات</h2>
                        <ol class="qd-pkgd__sched">
                            @foreach (var item in pkg.Items)
                            {
                                <li class="qd-pkgd__row" style="@(item.ColorHex != null ? "--item-color:" + item.ColorHex + ";--item-on:" + item.OnColorHex : null)">
                                    <span class="qd-pkgd__num" aria-hidden="true">@item.Number</span>
                                    <div>
                                        <p class="qd-pkgd__steptitle">@item.ScheduleTitle</p>
                                        @if (!string.IsNullOrWhiteSpace(item.ScheduleText))
                                        {
                                            <p class="qd-pkgd__stepdate"><i class="bi bi-clock" aria-hidden="true"></i> @item.ScheduleText</p>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.ScheduleNote))
                                        {
                                            <p class="qd-pkgd__stepnote">@item.ScheduleNote</p>
                                        }
                                    </div>
                                </li>
                            }
                        </ol>
                    </section>
                }
            </div>

            <!-- ===== الحجز ===== -->
            <aside class="qd-pkgd__aside">
                <section id="book" class="qd-pkgd__card qd-pkgd__book" aria-labelledby="bookTitle">
                    @if (Model.Submitted)
                    {
                        <div class="qd-pkgd__thanks" role="status" aria-live="polite" tabindex="-1" id="bookThanks">
                            <div class="qd-pkgd__thanks-icon" aria-hidden="true"><i class="bi bi-heart-fill"></i></div>
                            <h2 id="bookTitle">شكرًا لك، أسعدنا اهتمامك!</h2>
                            <p>استلمنا طلب حجزك في <strong>@pkg.Name</strong> بنجاح.</p>
                            <p class="qd-pkgd__warm">سيتواصل معك فريق الإدارة قريبًا جدًا على رقم جوالك لإكمال الحجز.</p>
                            <p>يسعدنا أن نكون جزءًا من رحلتك نحو التفوق، ونتمنى لك كل التوفيق.</p>
                            <a class="qd-pkgd__back" href="/packages"><i class="bi bi-grid" aria-hidden="true"></i> تصفّح باقات أخرى</a>
                        </div>
                    }
                    else
                    {
                        <div class="qd-pkgd__bookhead">
                            <h2 id="bookTitle" class="qd-pkgd__booktitle"><i class="bi bi-bookmark-star-fill" aria-hidden="true"></i> احجز مكانك الآن</h2>
                            <p class="qd-pkgd__booksub">اترك اسمك ورقم جوالك وسنتواصل معك لإكمال الحجز.</p>
                        </div>
                        @if (pkg.DiscountPercent.HasValue)
                        {
                            <div class="qd-pkgd__offer">
                                <b>خصم @pkg.DiscountPercent%</b>
                                @if (!string.IsNullOrWhiteSpace(pkg.DiscountCaption)) { <span>@pkg.DiscountCaption</span> }
                            </div>
                        }
                        <div class="qd-pkgd__bookbody">
                            <form method="post" action="/packages/@pkg.Slug" id="bookForm" novalidate>
                                @Html.AntiForgeryToken()
                                <div class="qd-pkgd__hp" aria-hidden="true">
                                    <label for="Website">لا تملأ هذا الحقل</label>
                                    <input type="text" id="Website" name="Website" tabindex="-1" autocomplete="off" />
                                </div>

                                <div class="qd-pkgd__field">
                                    <label class="qd-pkgd__label" for="FullName">الاسم الكامل</label>
                                    <input class="qd-pkgd__input" type="text" id="FullName" name="FullName" maxlength="150"
                                           autocomplete="name" value="@Model.Form.FullName" required
                                           aria-invalid="@(ViewData.ModelState["FullName"]?.Errors.Count > 0 ? "true" : "false")" />
                                    @if (ViewData.ModelState["FullName"]?.Errors.Count > 0)
                                    {
                                        <span class="qd-pkgd__error">@ViewData.ModelState["FullName"]!.Errors[0].ErrorMessage</span>
                                    }
                                </div>

                                <div class="qd-pkgd__field">
                                    <label class="qd-pkgd__label" for="PhoneNumber">رقم الجوال</label>
                                    <input class="qd-pkgd__input qd-pkgd__input--phone" type="tel" id="PhoneNumber" name="PhoneNumber"
                                           inputmode="numeric" maxlength="15" autocomplete="tel" placeholder="05XXXXXXXX"
                                           value="@Model.Form.PhoneNumber" required
                                           aria-invalid="@(ViewData.ModelState["PhoneNumber"]?.Errors.Count > 0 ? "true" : "false")" />
                                    @if (ViewData.ModelState["PhoneNumber"]?.Errors.Count > 0)
                                    {
                                        <span class="qd-pkgd__error">@ViewData.ModelState["PhoneNumber"]!.Errors[0].ErrorMessage</span>
                                    }
                                </div>

                                <button type="submit" class="qd-pkgd__submit" id="bookSubmit">
                                    <i class="bi bi-send-fill" aria-hidden="true"></i>
                                    <span>@pkg.ButtonText</span>
                                </button>
                                <p class="qd-pkgd__privacy"><i class="bi bi-shield-check" aria-hidden="true"></i> بياناتك محفوظة ولا تُستخدم إلا للتواصل معك.</p>
                            </form>
                        </div>
                    }
                </section>
            </aside>
        </div>
    </div>

    @if (!Model.Submitted)
    {
        <div class="qd-pkgd__sticky">
            <a href="#book"><i class="bi bi-bookmark-star-fill" aria-hidden="true"></i> @pkg.ButtonText</a>
        </div>
    }
</div>

@if (hasPoster)
{
    <div class="modal fade" id="packagePosterModal" tabindex="-1" aria-labelledby="packagePosterModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="packagePosterModalLabel">@pkg.Name</h2>
                    <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
                <div class="modal-body">
                    <img src="@pkg.PosterImagePath" alt="@pkg.Name" class="img-fluid d-block mx-auto" loading="lazy" />
                </div>
            </div>
        </div>
    </div>
}

<script>
    (function () {
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var form = document.getElementById("bookForm");
        if (form) {
            form.addEventListener("submit", function () {
                var btn = document.getElementById("bookSubmit");
                if (!btn || btn.disabled) return;
                btn.disabled = true;
                btn.querySelector("span").textContent = "جارٍ الإرسال...";
            });
        }
        var target = document.getElementById("bookThanks") || (@(hasErrors ? "true" : "false") ? document.getElementById("book") : null);
        if (target) {
            target.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "center" });
            if (target.id === "bookThanks") target.focus({ preventScroll: true });
        }
        if (!reduce) document.documentElement.style.scrollBehavior = "smooth";
    })();
</script>
