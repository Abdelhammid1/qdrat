@model QdratNew.Entities.StaticPage
@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}

<section class="static-page-section py-5" style="direction: rtl;">
    <div class="container">
        <!-- العنوان -->
        <div class="text-center mb-5" data-aos="fade-down">
            <h1 class="fw-bold text-primary mb-3">@Model.Title</h1>
            <div class="underline mx-auto mb-3"></div>
            <p class="text-muted fs-5">
                نؤمن بأن الوضوح هو سر الثقة، لذلك نضع بين يديك هذه الصفحة لتتعرف على تفاصيلنا.
            </p>
        </div>

        <!-- المحتوى -->
        <div class="card shadow border-0 rounded-4 p-4 p-md-5 bg-white" data-aos="fade-up">
            <div class="page-content fs-5 lh-lg" style="color:#333;">
                @Html.Raw(Model.Content)
            </div>
        </div>

        <!-- ذيل بسيط -->
        <div class="text-center mt-5 text-muted small">
            <i class="bi bi-shield-check text-primary me-1"></i>
            جميع الحقوق محفوظة لمنصة <strong>معهد القدرات</strong> © @DateTime.Now.Year
        </div>
    </div>
</section>

<style>
    body {
        background: #f9fbfb;
        font-family: 'Cairo', sans-serif;
    }

    .static-page-section h1 {
        font-size: 2.2rem;
        letter-spacing: -0.5px;
    }

    .underline {
        width: 80px;
        height: 4px;
        background: linear-gradient(to right, #2B7D77, #3D9494);
        border-radius: 2px;
    }

    .card {
        background-color: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        transition: all 0.3s ease-in-out;
    }

        .card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 24px rgba(0,0,0,0.08);
        }

    .page-content h2,
    .page-content h3 {
        color: #2B7D77;
        font-weight: 700;
        margin-top: 25px;
        margin-bottom: 10px;
    }

    .page-content p {
        text-align: justify;
        margin-bottom: 1rem;
    }

    .page-content ul {
        padding-right: 1.5rem;
    }

    .page-content li {
        margin-bottom: 0.5rem;
    }

    @@media (max-width: 768px) {
        .page-content

    {
        font-size: 1.05rem;
    }

    }
</style>
