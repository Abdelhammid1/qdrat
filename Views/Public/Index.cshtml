@{
    ViewData["Title"] = "الصفحة الرئيسية - منصة القدرات";
}

<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    body {
        font-family: 'Cairo', sans-serif;
        background: #f9fafb;
        direction: rtl;
        overflow-x: hidden;
    }

    /* 🟦 Hero Section */
    .hero {
        background: linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.65)), url('/images/hero-bg.jpg') center/cover no-repeat;
        color: white;
        padding: 160px 0;
        text-align: center;
    }

        .hero h1 {
            font-size: 3rem;
            font-weight: 800;
        }

        .hero p {
            font-size: 1.2rem;
            color: #e5e7eb;
        }

    /* 🟩 About Section */
    .about {
        padding: 80px 0;
    }

        .about h2 {
            color: #2563eb;
            font-weight: 800;
        }

    /* 🟨 Features */
    .feature-card {
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 6px 14px rgba(0,0,0,0.08);
        background: white;
        transition: 0.3s;
    }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        }

    /* 🟧 Promo Test */
    .promo-test {
        background: linear-gradient(135deg, #2563eb, #9333ea);
        color: white;
        padding: 100px 0;
        border-radius: 20px;
    }

    /* 🟪 Success Stories */
    .success-card {
        border-radius: 16px;
        background: white;
        box-shadow: 0 3px 10px rgba(0,0,0,0.05);
        text-align: center;
        padding: 25px;
    }

    /* 🟫 Contact */
    .contact {
        background: #f3f4f6;
        padding: 100px 0;
    }

    footer {
        background: #111827;
        color: #d1d5db;
        padding: 40px 0;
        text-align: center;
    }

        footer a {
            color: #9ca3af;
            margin: 0 10px;
            text-decoration: none;
        }

            footer a:hover {
                color: white;
            }
</style>

<!-- 🟦 HERO SECTION -->
<section class="hero">
    <div class="container">
        <h1>منصة القدرات – الذكاء الاصطناعي في خدمة التعليم</h1>
        <p class="mt-3">حلل أداءك، تعلّم بطريقتك، وابدأ رحلتك نحو التفوق.</p>
        <div class="mt-4">
            <a href="#PromoTest" class="btn btn-light btn-lg fw-bold me-2">ابدأ الاختبار التجريبي</a>
            <a href="/Public/About" class="btn btn-outline-light btn-lg">اعرف المزيد عنا</a>
        </div>
    </div>
</section>

<!-- 🟩 ABOUT SECTION -->
<section class="about text-center">
    <div class="container">
        <h2 class="mb-4">من نحن</h2>
        <p class="lead mb-5 text-secondary">
            نحن معهد القدرات، نسعى لتطوير تجربة التعليم باستخدام التحليل الذكي والتقنيات الحديثة.
            منصتنا تتابع أداء الطالب وتقترح له خطة علاجية مخصصة بخوارزميات الذكاء الاصطناعي.
        </p>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card">
                    <i class="bi bi-cpu-fill fs-1 text-primary mb-3"></i>
                    <h5>ذكاء اصطناعي تعليمي</h5>
                    <p>نظامنا يحلل أداءك ويقترح دروسًا تناسب مستواك.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <i class="bi bi-graph-up-arrow fs-1 text-success mb-3"></i>
                    <h5>تحليل الأداء</h5>
                    <p>لوحات تحليلية متقدمة لقياس تقدم الطلاب والمدربين.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <i class="bi bi-bell-fill fs-1 text-warning mb-3"></i>
                    <h5>إشعارات ذكية</h5>
                    <p>نظام إشعارات لحظي للتذكير بالواجبات والاختبارات.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 🟧 PROMO TEST SECTION -->
<section id="PromoTest" class="promo-test text-center my-5">
    <div class="container">
        <h2 class="fw-bold mb-4">اختبر نفسك مجانًا 🎯</h2>
        <p class="lead mb-5">جرّب الآن اختبار القدرات الترويجي واحصل على تحليل فوري لنتيجتك</p>
        <a href="/Public/PromoTest" class="btn btn-light btn-lg px-5 fw-bold">ابدأ الآن</a>
    </div>
</section>

<!-- 🟪 SUCCESS STORIES -->
<section class="my-5">
    <div class="container">
        <h2 class="text-center text-primary fw-bold mb-4">قصص نجاح طلابنا</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="success-card">
                    <h5>محمد العتيبي</h5>
                    <p>تحسّن بنسبة 45% بعد أول خطة علاجية</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="success-card">
                    <h5>سارة العنزي</h5>
                    <p>انتقلت من مستوى “مقبول” إلى “ممتاز” خلال شهرين فقط</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="success-card">
                    <h5>عبدالله الشهري</h5>
                    <p>حقق أعلى معدل في اختبار مؤشرات الأداء لعام 2025</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 🟫 CONTACT SECTION -->
<section class="contact text-center">
    <div class="container">
        <h2 class="text-primary fw-bold mb-4">تواصل معنا</h2>
        <p class="mb-5 text-secondary">نسعد بخدمتك والإجابة عن استفساراتك.</p>
        <form class="row justify-content-center">
            <div class="col-md-6">
                <input type="text" class="form-control mb-3" placeholder="الاسم الكامل">
                <input type="email" class="form-control mb-3" placeholder="البريد الإلكتروني">
                <textarea class="form-control mb-3" rows="4" placeholder="اكتب رسالتك هنا"></textarea>
                <button type="submit" class="btn btn-primary px-5">إرسال</button>
            </div>
        </form>
    </div>
</section>

<!-- ⚫ FOOTER -->
<footer>
    <div class="text-center text-light py-3">
        <p>© @DateTime.Now.Year منصة القدرات - جميع الحقوق محفوظة</p>
        <div>
            <a asp-controller="Public" asp-action="Page" asp-route-slug="about">من نحن</a>
            <a href="/Public/Page/privacy" class="text-light mx-2">سياسة الخصوصية</a> |
            <a href="/Public/Page/terms" class="text-light mx-2">الشروط والأحكام</a> |
            <a href="/Public/Page/contact" class="text-light mx-2">تواصل معنا</a>
        </div>
    </div>
</footer>

