@model Dictionary<string, string>

<!-- ✅ إعدادات الميتا واسم الموقع -->
<title>@Model["SiteName"]</title>
<meta name="description" content="@Model["SiteMetaDescription"]" />
<meta name="keywords" content="@Model["SiteMetaKeywords"]" />
<link rel="icon" href="@Model["SiteFaviconPath"]" />

<!-- 🟦 المتغير التالي يستخدمه الـ Layout لإظهار اللوجو -->
@{
    ViewData["SiteLogoPath"] = Model["SiteLogoPath"];
}
