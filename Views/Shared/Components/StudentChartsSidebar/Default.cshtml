@model QdratNew.ViewModels.Students.StudentSidebarAnalyticsViewModel






<div class="card mb-4 shadow-sm">
    <div class="card-header bg-aqua text-white">
        <i class="fas fa-chart-line"></i> الأداء في الواجبات
    </div>
    <div class="card-body">
        @if (Model.HomeworkScoresOverTime.Any())
        {
            <canvas id="homeworkChart" height="200"></canvas>
        }
        else
        {
            <div class="text-muted text-center">لا توجد بيانات متاحة بعد.</div>
        }
    </div>
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-warning text-white">
        <i class="fas fa-chart-bar"></i> الأداء في الاختبارات
    </div>
    <div class="card-body">
        @if (Model.ExamScoresOverTime.Any())
        {
            <canvas id="examChart" height="200"></canvas>
        }
        else
        {
            <div class="text-muted text-center">لا توجد بيانات متاحة بعد.</div>
        }
    </div>
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-primary text-white">
        <i class="fas fa-bolt"></i> توصيات الذكاء الاصطناعي
    </div>
    <ul class="list-group list-group-flush">
        @if (Model.AITips != null && Model.AITips.Any())
        {
            foreach (var tip in Model.AITips)
            {
                <li class="list-group-item">
                    <div class="fw-bold"><i class="fas fa-lightbulb text-warning me-2"></i> @tip.Title</div>
                    <div class="text-muted ps-4">@tip.Description</div>
                </li>
            }
        }
        else
        {
            <li class="list-group-item text-muted text-center">
                لا توجد توصيات حالياً.
            </li>
        }
    </ul>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    @if (Model.HomeworkScoresOverTime.Any())
    {
        <script>
            const hwLabels = @Html.Raw(Json.Serialize(Model.HomeworkScoresOverTime.Select(h => h.Label)));
            const hwData = @Html.Raw(Json.Serialize(Model.HomeworkScoresOverTime.Select(h => h.Score)));
            const hwColors = hwData.map(score => score >= 85 ? '#28a745' : score >= 60 ? '#ffc107' : '#dc3545');

            const ctx1 = document.getElementById('homeworkChart').getContext('2d');
            new Chart(ctx1, {
                type: 'line',
                data: {
                    labels: hwLabels,
                    datasets: [{
                        label: 'درجة الواجب',
                        data: hwData,
                        borderColor: '#17a2b8',
                        backgroundColor: 'rgba(23,162,184,0.1)',
                        pointBackgroundColor: hwColors,
                        pointRadius: 6,
                        pointHoverRadius: 8,
                        tension: 0.3
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100
                        }
                    }
                }
            });
        </script>
    }

    @if (Model.ExamScoresOverTime.Any())
    {
        <script>
            const examLabels = @Html.Raw(Json.Serialize(Model.ExamScoresOverTime.Select(e => e.Label)));
            const examData = @Html.Raw(Json.Serialize(Model.ExamScoresOverTime.Select(e => e.Score)));
            const examColors = examData.map(score => score >= 85 ? '#28a745' : score >= 60 ? '#ffc107' : '#dc3545');

            const ctx2 = document.getElementById('examChart').getContext('2d');
            new Chart(ctx2, {
                type: 'bar',
                data: {
                    labels: examLabels,
                    datasets: [{
                        label: 'درجة الاختبار',
                        data: examData,
                        backgroundColor: examColors,
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100
                        }
                    }
                }
            });
        </script>
    }
}
