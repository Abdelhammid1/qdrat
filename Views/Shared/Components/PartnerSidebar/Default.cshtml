@using QdratNew.ViewModels.Partner
@model PartnerSidebarPermissionsVM
<style>


    .partner-sidebar {
        height: 100vh; /* يأخذ ارتفاع الشاشة */
        overflow-y: auto; /* تفعيل التمرير العمودي */
        overflow-x: hidden;
        padding-bottom: 20px;
    }

        /* تحسين سلوك التمرير */
        .partner-sidebar::-webkit-scrollbar {
            width: 6px;
        }

        .partner-sidebar::-webkit-scrollbar-thumb {
            background-color: rgba(0,0,0,0.2);
            border-radius: 4px;
        }

    /* =========================
       Partner Sidebar Font Fix
       ========================= */

        .partner-sidebar a,
        .partner-sidebar .sidebar-section-title {
            font-size: 15px; /* كان غالبًا 13 أو 14 */
            line-height: 1.6;
        }


    .partner-sidebar i {
        font-size: 15px; /* الأيقونات أكبر قليلاً */
    }

    /* العناوين داخل الأقسام */
    .partner-sidebar .sidebar-section-title {
        font-size: 15.5px;
        font-weight: 600;
    }

    /* تحسين التباعد */
    .partner-sidebar a {
        padding: 10px 12px;
    }

    /* =========================
       Partner Logout Button
       ========================= */

    .partner-sidebar-logout {
        margin-top: auto; /* يثبّت الزر أسفل القائمة */
        padding: 15px 12px 5px;
    }

    .partner-logout-link {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #dc3545;
        font-weight: 600;
        padding: 10px 12px;
        border-radius: 8px;
        text-decoration: none;
        transition: background 0.2s ease-in-out;
    }

        .partner-logout-link:hover {
            background-color: rgba(220, 53, 69, 0.1);
            color: #bb2d3b;
        }




</style>
<aside class="partner-sidebar">
    <div class="partner-sidebar-logo text-center mb-2">
    <img src="@(string.IsNullOrWhiteSpace(Model.PartnerLogoPath)
                ? "/images/160×100-W.png"
                : Model.PartnerLogoPath)"
         alt="Partner Logo"
         class="img-fluid"
         style="max-height:55px; object-fit:contain;" />
</div>

    <!-- الرئيسية -->
    <a asp-area="Partner" asp-controller="Dashboard" asp-action="Index">
        📊 لوحة التحكم
    </a>


    <!-- الطلاب -->
    <a asp-area="Partner"
       asp-controller="Students"
       asp-action="Index">
        <i class="fas fa-users"></i>
        <span>الطلاب</span>
    </a>

    <!-- الدفعات -->
    <a asp-area="Partner"
       asp-controller="Batches"
       asp-action="Index">
        <i class="fas fa-layer-group"></i>
        <span>الدفعات</span>
    </a>

    <!-- الدورات -->
    <a asp-area="Partner"
       asp-controller="Courses"
       asp-action="Index">
        <i class="fas fa-book"></i>
        <span>الدورات</span>
    </a>
    <!-- المدربون -->
    @if (Model.CanManageInstructors)
    {
        <div class="sidebar-section">
            <div class="sidebar-section-title text-qdrat">
                <i class="fas fa-chalkboard-user"></i>
                <span>المدربون</span>
            </div>

            <a asp-area="Partner"
               asp-controller="PartnerInstructors"
               asp-action="Index">
                <i class="fas fa-user-tie"></i>
                <span>إدارة المدربين</span>
            </a>
        </div>
    }
    <!-- الواجبات -->
    @if (Model.CanCreateHomework)
    {
        <div class="sidebar-section">
            <div class="sidebar-section-title text-qdrat">
                <i class="fas fa-clipboard-list"></i>
                <span>الواجبات</span>
            </div>

            <a asp-area="Partner"
               asp-controller="HomeworkDrafts"
               asp-action="Index">
                <i class="fas fa-file-pen"></i>
                <span>نماذج الواجب</span>
            </a>

            <a asp-area="Partner"
               asp-controller="SentHomeworks"
               asp-action="Index">
                <i class="fas fa-paper-plane"></i>
                <span>الواجبات المرسلة</span>
            </a>
        </div>
    }

    <!-- الاختبارات -->
    @if (Model.CanCreateExams)
    {
        <div class="sidebar-section">
            <div class="sidebar-section-title text-qdrat">
                <i class="fas fa-file-lines"></i>
                <span>الاختبارات</span>
            </div>

            <!-- توليد الاختبارات -->
            <a asp-area="Partner"
               asp-controller="PartnerExam"
               asp-action="Generate">
                <i class="fas fa-plus-circle"></i>
                <span>توليد نماذج اختبار</span>
            </a>
            <a asp-area="Partner"
               asp-controller="PartnerExam"
               asp-action="Drafts">
                <i class="fas fa-file-pen"></i>
                <span>نماذج الاختبارات</span>
            </a>

            <a asp-area="Partner"
               asp-controller="PartnerExam"
               asp-action="SentExams">
                <i class="fas fa-paper-plane"></i>
                <span>الاختبارات المرسلة</span>
            </a>

            <!-- اختبارات تحديد المستوى -->
            @if (Model.CanUsePlacementExams)
            {
                <a asp-area="Partner"
                   asp-controller="PlacementExams"
                   asp-action="Index">
                    <i class="fas fa-signal"></i>
                    <span>تحديد المستوى</span>
                </a>
            }

            <!-- اختبارات مؤشر الأداء -->
            @if (Model.CanUsePerformanceIndicatorExams)
            {
                <a asp-area="Partner"
                   asp-controller="PerformanceExams"
                   asp-action="Index">
                    <i class="fas fa-chart-line"></i>
                    <span>مؤشر الأداء</span>
                </a>
            }
        </div>
    }

    <!-- المهارات التعزيزية -->
    @if (Model.CanUseReinforcementSkills)
    {
        <a asp-area="Partner"
           asp-controller="ReinforcementSkills"
           asp-action="Index">
            <i class="fas fa-dumbbell"></i>
            <span>المهارات التعزيزية</span>
        </a>
    }

    <!-- الخطط العلاجية -->
    @if (Model.CanUseRemedialPlans)
    {
        <a asp-area="Partner"
           asp-controller="RemedialPlans"
           asp-action="Index">
            <i class="fas fa-notes-medical"></i>
            <span>الخطط العلاجية</span>
        </a>
    }

    <!-- الجلسات العلاجية -->
    @if (Model.CanUseRemedialSessions)
    {
        <a asp-area="Partner"
           asp-controller="RemedialSessions"
           asp-action="Index">
            <i class="fas fa-user-nurse"></i>
            <span>الجلسات العلاجية</span>
        </a>
    }

    <!-- المحتوى التعليمي -->
    @if (Model.CanAccessEducationalContent)
    {
        <a asp-area="Partner"
           asp-controller="EducationalContent"
           asp-action="Index">
            <i class="fas fa-graduation-cap"></i>
            <span>المحتوى التعليمي</span>
        </a>
    }

    <!-- النماذج الاحترافية -->
    @if (Model.CanUseProfessionalModels)
    {
        <a asp-area="Partner"
           asp-controller="ProfessionalModels"
           asp-action="Index">
            <i class="fas fa-layer-group"></i>
            <span>النماذج </span>
        </a>
    }

    <!-- تسجيل الخروج -->
    <div class="partner-sidebar-logout">
        <a asp-area="Identity"
           asp-page="/Account/Logout"
           class="partner-logout-link">
            <i class="fas fa-right-from-bracket"></i>
            <span>تسجيل الخروج</span>
        </a>
    </div>


</aside>
