@model List<QdratNew.ViewModels.Students.StudentActivityEntry>




<div class="card shadow-sm mb-4">
    <div class="card-header bg-dark text-white">
        <i class="fas fa-bolt"></i> أنشطتي الأخيرة
    </div>
    <ul class="list-group list-group-flush">
        @if (Model.Any())
        {
            foreach (var log in Model)
            {
                <li class="list-group-item">
                    <i class="fas fa-check text-success me-2"></i>
                    <strong>@log.Type:</strong> @log.Description
                    <span class="text-muted float-end small">@log.Timestamp.ToString("dd MMM HH:mm")</span>
                </li>
            }
        }
        else
        {
            <li class="list-group-item text-muted">لا يوجد أنشطة مسجلة بعد.</li>
        }
    </ul>
</div>
