@model QdratNew.ViewModels.Layout.StudentNotificationNavViewModel
@using QdratNew.Enums

@functions {
    private static string SafeNotificationUrl(string? targetUrl)
    {
        return !string.IsNullOrWhiteSpace(targetUrl) && targetUrl.StartsWith("/")
            ? targetUrl
            : "/Students/Notifications/Index";
    }

    private static string CategoryIcon(NotificationCategory category)
    {
        return category switch
        {
            NotificationCategory.Homework => "fas fa-pen-to-square",
            NotificationCategory.Exam => "fas fa-file-lines",
            NotificationCategory.Remedial => "fas fa-heart-pulse",
            NotificationCategory.Important => "fas fa-triangle-exclamation",
            NotificationCategory.Reminder => "fas fa-clock",
            _ => "fas fa-bell"
        };
    }

    private static string BadgeText(int count)
    {
        return count > 99 ? "+99" : count.ToString();
    }
}

<div class="ql-notif dropdown">
    <button type="button"
            class="ql-hbtn ql-notif-btn"
            data-bs-toggle="dropdown"
            data-bs-auto-close="outside"
            aria-expanded="false"
            title="الإشعارات">
        <i class="fas fa-bell"></i>
        @if (Model.TotalUnreadCount > 0)
        {
            <span class="ql-notif-count">@BadgeText(Model.TotalUnreadCount)</span>
        }
    </button>

    <div class="dropdown-menu ql-notif-menu dropdown-menu-end">
        <div class="ql-notif-head">
            <strong>الإشعارات</strong>
            @if (Model.TotalUnreadCount > 0)
            {
                <span>@Model.TotalUnreadCount غير مقروء</span>
            }
        </div>

        @if (Model.RecentNotifications.Any())
        {
            <div class="ql-notif-list">
                @foreach (var notification in Model.RecentNotifications)
                {
                    <a class="ql-notif-item @(notification.IsRead ? "" : "unread")"
                       href="@SafeNotificationUrl(notification.TargetUrl)">
                        <span class="ql-notif-item-icon">
                            <i class="@CategoryIcon(notification.Category)"></i>
                        </span>
                        <span class="ql-notif-item-body">
                            <span class="ql-notif-message">@notification.Message</span>
                            <small>@notification.SentAt.ToString("yyyy/MM/dd HH:mm")</small>
                        </span>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="ql-notif-empty">
                <i class="fas fa-bell-slash"></i>
                <span>لا توجد إشعارات حالياً</span>
            </div>
        }

        <a class="ql-notif-all" href="/Students/Notifications/Index">
            عرض كل الإشعارات
        </a>
    </div>
</div>
