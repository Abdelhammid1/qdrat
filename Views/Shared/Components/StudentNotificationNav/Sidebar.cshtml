@model QdratNew.ViewModels.Layout.StudentNotificationNavViewModel

@functions {
    private static string BadgeText(int count)
    {
        return count > 99 ? "+99" : count.ToString();
    }
}

<a href="/Students/StudentHomeworkDashboardNew/Dashboard" class="ql-nav-item" data-title="الواجبات">
    <span class="ql-nav-icon"><i class="fas fa-pen-to-square"></i></span>
    <span class="ql-nav-text">الواجبات</span>
    @if (Model.HomeworkUnreadCount > 0)
    {
        <span class="ql-nav-badge" title="إشعار جديد للواجبات">@BadgeText(Model.HomeworkUnreadCount)</span>
    }
</a>

<a href="/Students/StudentEnhancementSkills/Dashboard" class="ql-nav-item" data-title="المهارات التعزيزية">
    <span class="ql-nav-icon"><i class="fas fa-bolt"></i></span>
    <span class="ql-nav-text">المهارات التعزيزية</span>
</a>

<a href="/Students/StudentExamDashboard/" class="ql-nav-item" data-title="الاختبارات">
    <span class="ql-nav-icon"><i class="fas fa-file-lines"></i></span>
    <span class="ql-nav-text">الاختبارات</span>
    @if (Model.ExamUnreadCount > 0)
    {
        <span class="ql-nav-badge" title="إشعار جديد للاختبارات">@BadgeText(Model.ExamUnreadCount)</span>
    }
</a>

<a href="/Students/StudentIndividualExams/" class="ql-nav-item" data-title="الاختبارات الفردية">
    <span class="ql-nav-icon"><i class="fas fa-user-check"></i></span>
    <span class="ql-nav-text">اختباراتك الفردية</span>
    @if (Model.IndividualExamUnreadCount > 0)
    {
        <span class="ql-nav-badge" title="إشعار جديد للاختبارات الفردية">@BadgeText(Model.IndividualExamUnreadCount)</span>
    }
</a>
