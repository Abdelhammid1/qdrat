@model QdratNew.ViewModels.Partner.PartnerTopbarVM
@using QdratNew.Helpers

<div class="partner-topbar px-3 py-2 border-bottom bg-white">
    <div class="d-flex align-items-center justify-content-between">

        <!-- ================= LEFT ================= -->
        <div class="d-flex align-items-center gap-3">

            @if (!string.IsNullOrEmpty(Model.ActivePartnerLogo))
            {
                <img src="@Model.ActivePartnerLogo"
                     alt="Partner Logo"
                     style="height:42px;width:auto;" />
            }

            <div class="d-flex flex-column">
                <strong class="lh-1">@Model.FullName</strong>

                @if (!string.IsNullOrEmpty(Model.ActivePartnerName))
                {
                    <small class="text-muted">@Model.ActivePartnerName</small>
                }
            </div>
        </div>

        <!-- ================= CENTER ================= -->
        <div class="d-flex align-items-center gap-2">

            <!-- تبديل الدور -->
            @if (Model.AvailableRoles.Count > 1)
            {
                <form asp-area="Identity"
                      asp-page="/Account/SwitchRole"
                      method="post">
                    @Html.AntiForgeryToken()

                    <select name="role"
                            class="form-select form-select-sm"
                            onchange="this.form.submit()">
                        @foreach (var role in Model.AvailableRoles)
                        {
                            <option value="@role" selected="@(role == Model.ActiveRole)">
                                @(RoleNamesHelper.RoleDisplay.ContainsKey(role)
                                                        ? RoleNamesHelper.RoleDisplay[role]
                                                        : role)
                    </option>
                                        }
                    </select>
                </form>
            }

            <!-- تبديل الشريك -->
            @if (Model.Partners.Count > 1)
            {
                <form asp-area="Partner"
                      asp-controller="Partners"
                      asp-action="ActivatePartner"
                      method="post">
                    @Html.AntiForgeryToken()

                    <select name="partnerId"
                            class="form-select p-10 form-select-sm"
                            onchange="this.form.submit()">
                        @foreach (var p in Model.Partners)
                        {
                            <option value="@p.Id" selected="@(p.Id == Model.ActivePartnerId)">
                                @p.Name
                            </option>
                        }
                    </select>
                </form>
            }

            <!-- تبديل المدرسة -->
            @if (Model.Schools.Count > 1)
            {
                <form asp-area="Partner"
                      asp-controller="PartnerContext"
                      asp-action="SelectSchool"
                      method="post">
                    @Html.AntiForgeryToken()

                    <select name="schoolId"
                            class="form-select form-select-sm"
                            onchange="this.form.submit()">
                        @foreach (var s in Model.Schools)
                        {
                            <option value="@s.Id" selected="@(s.Id == Model.ActiveSchoolId)">
                                @s.Name
                            </option>
                        }
                    </select>
                </form>
            }
        </div>

       
    </div>
</div>
