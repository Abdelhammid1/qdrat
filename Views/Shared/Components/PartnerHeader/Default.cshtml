@model QdratNew.ViewModels.Partner.PartnerDropdownViewModel

@if (Model.HasMultiplePartners)
{
    <form asp-area="Partner"
          asp-controller="Partners"
          asp-action="ActivatePartner"
          method="post"
          class="d-inline">

        @Html.AntiForgeryToken()

        <select name="partnerId"
                class="form-select form-select-sm"
                style="min-width:200px"
                onchange="this.form.submit()">

            @foreach (var partner in Model.Partners)
            {
                <option value="@partner.Id"
                        selected="@(partner.Id == Model.ActivePartnerId)">
                    @partner.Name
                </option>
            }
        </select>
    </form>
}
