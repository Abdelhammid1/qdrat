@model List<QdratNew.ViewModels.Students.StudentCourseSwitchItemVm>

@{
    var active = Model.FirstOrDefault(c => c.IsActive) ?? Model.First();
    var hasMultiple = Model.Count > 1;
}

<style>
    .ql-course-block {
        padding: 10px 14px 12px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        flex-shrink: 0;
    }

    .ql-course-label {
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.42);
        margin-bottom: 6px;
        white-space: nowrap;
        overflow: hidden;
        transition: opacity .28s, max-height .28s;
        max-height: 20px;
    }

    #ql-sidebar.collapsed .ql-course-label { opacity: 0; max-height: 0; }

    .ql-course-row {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .ql-course-icon {
        width: 32px; height: 32px;
        border-radius: 8px;
        background: rgba(255,255,255,0.15);
        display: flex; align-items: center; justify-content: center;
        font-size: 0.85rem; color: #fff;
        flex-shrink: 0;
    }

    .ql-course-text {
        overflow: hidden;
        transition: opacity .28s, max-width .28s;
        max-width: 160px; opacity: 1;
        flex: 1; min-width: 0;
    }

    #ql-sidebar.collapsed .ql-course-text { opacity: 0; max-width: 0; }

    .ql-course-name {
        font-size: 0.82rem;
        font-weight: 700;
        color: #fff;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ql-batch-name {
        font-size: 0.68rem;
        color: rgba(255,255,255,0.6);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ql-switch-btn {
        width: 26px; height: 26px;
        border-radius: 6px;
        background: rgba(255,255,255,0.12);
        border: none;
        color: rgba(255,255,255,0.75);
        display: flex; align-items: center; justify-content: center;
        font-size: 0.72rem;
        cursor: pointer;
        transition: background .18s, color .18s;
        flex-shrink: 0;
    }

    .ql-switch-btn:hover { background: rgba(255,255,255,0.25); color: #fff; }

    /* Modal overrides */
    .ql-switch-modal .modal-header {
        background: #1d5e5e;
        color: #fff;
        border-bottom: none;
        border-radius: 12px 12px 0 0;
    }

    .ql-switch-modal .modal-content {
        border-radius: 12px;
        border: none;
        overflow: hidden;
    }

    .ql-switch-modal .btn-close { filter: invert(1); }

    .ql-course-card {
        border-radius: 10px;
        border: 1.5px solid #e2e8f0;
        padding: 14px 16px;
        cursor: default;
        transition: border-color .18s, box-shadow .18s;
        background: #fff;
    }

    .ql-course-card.active-card {
        border-color: #339999;
        background: #f0fafa;
    }

    .ql-course-card-title { font-size: 0.9rem; font-weight: 700; color: #1e293b; }
    .ql-course-card-batch { font-size: 0.78rem; color: #64748b; margin-top: 2px; }

    .ql-switch-submit {
        background: #339999;
        color: #fff;
        border: none;
        border-radius: 7px;
        padding: 6px 14px;
        font-size: 0.8rem;
        font-family: 'Cairo', sans-serif;
        cursor: pointer;
        transition: background .18s;
    }

    .ql-switch-submit:hover { background: #267a7a; }
</style>

<div class="ql-course-block">
    <div class="ql-course-label">الدورة النشطة</div>
    <div class="ql-course-row">
        <div class="ql-course-icon">
            <i class="fas fa-book-open"></i>
        </div>
        <div class="ql-course-text">
            <div class="ql-course-name" title="@active.CourseTitle">@active.CourseTitle</div>
            <div class="ql-batch-name">@active.BatchTitle</div>
        </div>
        @if (hasMultiple)
        {
            <button class="ql-switch-btn"
                    data-bs-toggle="modal"
                    data-bs-target="#qlCourseSwitchModal"
                    title="تغيير الدورة">
                <i class="fas fa-exchange-alt"></i>
            </button>
        }
    </div>
</div>

@if (hasMultiple)
{
    <div class="modal fade ql-switch-modal" id="qlCourseSwitchModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title mb-0">
                        <i class="fas fa-exchange-alt me-2"></i>تغيير الدورة
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="d-flex flex-column gap-2">
                        @foreach (var item in Model)
                        {
                            <div class="ql-course-card @(item.IsActive ? "active-card" : "")">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="ql-course-card-title">@item.CourseTitle</div>
                                        <div class="ql-course-card-batch">
                                            <i class="fas fa-users fa-xs me-1"></i>@item.BatchTitle
                                        </div>
                                    </div>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge" style="background:#339999;font-size:0.65rem;">نشطة</span>
                                    }
                                    else
                                    {
                                        <form asp-area="Students"
                                              asp-controller="CourseSwitch"
                                              asp-action="Set"
                                              method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="courseId" value="@item.CourseId" />
                                            <input type="hidden" name="batchId" value="@item.BatchId" />
                                            <input type="hidden" name="returnUrl"
                                                   value="@Context.Request.Path@Context.Request.QueryString" />
                                            <button type="submit" class="ql-switch-submit">
                                                تحديد
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        (function () {
            var modal = document.getElementById('qlCourseSwitchModal');
            if (modal && modal.parentNode !== document.body) {
                document.body.appendChild(modal);
            }
        })();
    </script>
}
