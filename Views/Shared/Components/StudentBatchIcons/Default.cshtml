@model List<QdratNew.ViewModels.Students.StudentBatchIconVm>

<div class="student-batch-icons d-flex flex-wrap gap-2 justify-content-start mb-3">

    @foreach (var item in Model)
    {
        <form asp-area="Students"
              asp-controller="Dashboard"
              asp-action="Index"
              method="get"
              class="m-0">

            <input type="hidden" name="batchId" value="@item.BatchId" />

            <button type="submit"
                    class="btn btn-sm @(item.IsActive ? "btn-primary" : "btn-outline-secondary")">
                <div class="fw-bold">@item.CourseTitle</div>
                <small class="d-block" style="color:#da784d;">دفعة: @item.BatchTitle</small>
            </button>

        </form>
    }

</div>
