@using QdratNew.ViewModels.Students
@model IEnumerable<StudentCourseBatchSwitcherVm>

@{
    int? selectedCourseId = ViewBag.ActiveCourseId as int?;
    int? selectedBatchId = ViewBag.ActiveBatchId as int?;

    string currentUrl = Context.Request.Path + Context.Request.QueryString;
}


<form asp-area="Students"
      asp-controller="CourseSwitch"
      asp-action="Set"
      method="post"
      class="mb-3">

    @Html.AntiForgeryToken()

    <input type="hidden" name="returnUrl" value="@currentUrl" />

    <div class="d-grid gap-2">

        @foreach (var c in Model)
        {
            bool isActive =
            selectedCourseId == c.CourseId &&
            selectedBatchId == c.BatchId;

            <button type="submit"
                    class="btn @(isActive ? "btn-light" : "btn-outline-light")"
                    name="submit"
                    value="1">

                <input type="hidden" name="courseId" value="@c.CourseId" />
                <input type="hidden" name="batchId" value="@c.BatchId" />
                <input type="hidden" name="courseTitle" value="@c.CourseName" />
                <input type="hidden" name="batchTitle" value="@c.BatchName" />

                @c.CourseName
                <small class="opacity-75">(@c.BatchName)</small>
            </button>
        }
    </div>
</form>
