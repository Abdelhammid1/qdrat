@* ===============================
   الشريط العلاجي الأفقي (Top Nav)
   =============================== *@
<style>
    .remedial-navbar {
        background: linear-gradient(90deg, #339999 0%, #339999 100%);
        border-radius: 8px;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
        padding: 10px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #fff;
        flex-wrap: wrap;
    }

        .remedial-navbar h5 {
            font-weight: 700;
            margin: 0;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
        }

            .remedial-navbar h5 i {
                margin-left: 8px;
            }

    .remedial-links {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

        .remedial-links a {
            color: #fff;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
        }

            .remedial-links a i {
                margin-left: 6px;
                font-size: 1.1rem;
            }

            .remedial-links a:hover {
                color: #ffe082;
                transform: translateY(-2px);
            }

    @@media (max-width: 768px) {
        .remedial-navbar

    {
        flex-direction: column;
        text-align: center;
    }

    .remedial-links {
        justify-content: center;
        gap: 12px;
        margin-top: 10px;
    }

    }
</style>

<div class="remedial-navbar mb-4">
    <h5><i class="bi bi-brain"></i> النظام العلاجي</h5>

    <div class="remedial-links">
        <a href="@Url.Action("Index", "RemedialDashboard", new { area = "Admin" })"><i class="bi bi-graph-up"></i> لوحة المتابعة</a>
        <a href="@Url.Action("Index", "RemedialPlans", new { area = "Admin" })"><i class="bi bi-journal-check"></i> الخطط</a>
        <a href="@Url.Action("Index", "RemedialSessions", new { area = "Admin" })"><i class="bi bi-calendar-week"></i> الجلسات</a>
        <a href="@Url.Action("Index", "RemedialVideos", new { area = "Admin" })"><i class="bi bi-play-btn"></i> الفيديوهات</a>
        <a href="@Url.Action("AnalyzeSectionIndicators", "RemedialAnalysis", new { area = "Admin" })"><i class="bi bi-bar-chart-line"></i> مؤشرات الأداء</a>
        <a href="@Url.Action("StudentReport", "RemedialStudentReport", new { area = "Admin", studentId = 0 })"><i class="bi bi-person-vcard"></i> تقارير الطلاب</a>
        <a href="@Url.Action("BatchReport", "RemedialBatchReport", new { area = "Admin", batchId = 0 })"><i class="bi bi-people-fill"></i> تقارير الدُفعات</a>
    </div>
</div>
