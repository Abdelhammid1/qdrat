@inject QdratNew.Interfaces.IUserAccountDropdownService AccountDropdownService
@inject QdratNew.Services.Interfaces.IUserContextService UserContext

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>لوحة المدرب - QdratNew</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap RTL (مرة واحدة فقط) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo&display=swap" rel="stylesheet" />

    <link href="~/css/instructor.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/qdrat.css" rel="stylesheet" asp-append-version="true" />

    @RenderSection("Styles", required: false)

    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f5f7fa;
        }

        .sidebar {
            background-color: #1c1e26;
            color: #fff;
            height: 100vh;
            position: fixed;
            right: 0;
            top: 0;
            width: 250px;
            padding: 20px;
        }

        .content {
            margin-right: 270px;
            padding: 30px;
        }

        .topbar {
            background-color: #fff;
            padding: 10px 20px;
            border-bottom: 1px solid #ddd;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
        }
    </style>
</head>

<body>

    @Html.Partial("_InstructorSidebar")

    <div class="content">

        <!-- ✅ Topbar موحد -->
        <div class="topbar">
            <div class="fw-bold text-success">
                لوحة المدرب
            </div>

            <div class="d-flex align-items-center gap-3">
                @{
                    try
                    {
                        var account = await AccountDropdownService.GetDropdownViewModelAsync(User);
                        if (account != null)
                        {
                            @await Html.PartialAsync("_UnifiedAccountMenu", account)
                        }
                    }
                    catch
                    {
                        <span class="text-danger small">خطأ تحميل الحساب</span>
                    }
                }
            </div>
        </div>

        <main class="mt-4">
            @RenderBody()
        </main>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>
