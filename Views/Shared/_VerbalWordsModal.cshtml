<div class="modal fade" id="verbalWordsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-highlighter"></i> اختيار الكلمات المميزة في السؤال اللفظي</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">

                <textarea class="form-control mb-3" id="verbalFullText" rows="5" placeholder="الصق هنا نص السؤال..."></textarea>

                <button type="button" class="btn btn-outline-primary mb-3" onclick="processVerbalWords()">تحليل النص واختيار الكلمات</button>

                <div class="border rounded p-3 bg-light" id="verbalWordSelectorArea" style="min-height: 100px;">
                    <small class="text-muted">سيتم عرض الكلمات هنا...</small>
                </div>

                <div class="mt-3">
                    <strong>الكلمات المختارة:</strong>
                    <div id="selectedWordsPreview" class="mt-2 text-danger fw-bold"></div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" onclick="insertVerbalToQuestionText()">نسخ إلى نص السؤال</button>
                <button type="button" class="btn btn-dark" onclick="fillOptionsFromSelectedWords()">تعبئة الاختيارات تلقائيًا</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
            </div>
        </div>
    </div>
</div>
