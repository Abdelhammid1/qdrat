@model List<QdratNew.Entities.Question>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning text-center">لا توجد أسئلة لعرضها.</div>
}
else
{
    <div class="card shadow-sm border mb-3">
        <div class="card-header bg-primary text-white fw-bold">
            👁 معاينة الأسئلة المختارة
        </div>
        <div class="card-body">

            @foreach (var q in Model)
            {
                <div class="border rounded p-3 mb-3">

                    <div class="fw-bold text-dark mb-2">
                        سؤال: @Html.Raw(q.Title)
                    </div>


                    @if (!string.IsNullOrEmpty(q.ImageUrl))
                    {
                        <img src="@q.ImageUrl"
                             class="img-fluid rounded mb-2"
                             style="max-height: 200px;" />
                    }

                    <div class="mt-2 text-muted">
                        <small>نوع السؤال: @@q.DisplayType</small>
                    </div>
                </div>
            }

        </div>
    </div>
}
