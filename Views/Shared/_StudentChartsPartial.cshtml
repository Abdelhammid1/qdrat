@model QdratNew.ViewModels.Students.StudentAIUnifiedAnalysisViewModel

<div class="card shadow-sm mt-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <span>📊 الرسوم البيانية للأداء</span>
        <i class="bi bi-bar-chart-line"></i>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6 mb-4">
                <canvas id="successChart" height="200"></canvas>
            </div>
            <div class="col-md-6 mb-4">
                <canvas id="riskChart" height="200"></canvas>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <canvas id="performanceTrendChart" height="200"></canvas>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <canvas id="batchComparisonChart" height="200"></canvas>
    </div>
    <div class="mt-4">
        <canvas id="homeworkTimeChart" height="200"></canvas>
    </div>
    <div class="mt-4">
        <canvas id="radarChart" height="300"></canvas>
    </div>

</div>
