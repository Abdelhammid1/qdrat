@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <!-- ✅ مكتبات أساسية -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background: #f8fafc;
            color: #1e293b;
            line-height: 1.6;
        }

        /* 🎨 الألوان الأساسية */
        :root {
            --main-color: #339999;
        }

        /* 🎯 إعدادات الطباعة */
        @@media print {
            body {
                background: #fff !important;
                -webkit-print-color-adjust: exact !important;
                color-adjust: exact !important;
            }
            /* ✅ في الطباعة نخفي فقط هيدر لوحة الإدارة وليس هيدر التقرير */
            header:not(.report-header), nav, .sidebar, .no-print {
                display: none !important;
                visibility: hidden !important;
            }


            .shadow, .shadow-md, .shadow-lg {
                box-shadow: none !important;
            }

            .card, section, table, tr, td, th, canvas {
                page-break-inside: avoid !important;
                break-inside: avoid !important;
            }

            .container, .max-w-6xl {
                width: 100% !important;
                max-width: none !important;
                margin: 0 auto !important;
                padding: 0 20px !important;
            }

            @@page {
                size: A4 portrait;
                margin: 10mm;
            }

            /* ✅ إصلاح قص الرسومات */
            canvas {
                page-break-inside: avoid !important;
                break-inside: avoid !important;
                display: block !important;
                width: 100% !important;
                max-width: 100% !important;
                height: 250px !important;
                transform: scale(0.95);
                transform-origin: top center;
                margin: 10px 0 !important;
            }

            .card, .chart-container {
                overflow: visible !important;
            }
        }

        /* 🧾 تصميم الكروت */
        .card {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
            padding: 20px;
            transition: 0.25s;
        }

        .card:hover {
            transform: translateY(-3px);
        }

        .chart-title {
            font-weight: 700;
            color: var(--main-color);
            border-right: 4px solid var(--main-color);
            padding-right: 10px;
            margin-bottom: 15px;
        }

        .footer-note {
            text-align: center;
            margin-top: 40px;
            color: #666;
            font-size: 13px;
        }

        @@media screen {
            :root {
                --report-bg: #0b1020;
                --report-card: #121a2f;
                --report-card-2: #182238;
                --report-border: rgba(255,255,255,.10);
                --report-text: #f8fafc;
                --report-muted: #94a3b8;
                --main-color: #4CA6A8;
            }

            body {
                background: var(--report-bg) !important;
                color: var(--report-text) !important;
            }

            .card,
            section,
            .analysis-card,
            .report-header,
            .summary-card,
            .chart-container {
                background: var(--report-card) !important;
                color: var(--report-text) !important;
                border: 1px solid var(--report-border) !important;
                box-shadow: 0 12px 30px rgba(0,0,0,.22) !important;
            }

            table,
            th,
            td {
                border-color: var(--report-border) !important;
            }

            th,
            thead,
            .bg-slate-50 {
                background: var(--report-card-2) !important;
                color: var(--report-text) !important;
            }

            .footer-note,
            .label,
            .text-gray-500,
            .text-slate-500,
            .text-slate-700,
            .text-slate-800,
            .text-slate-900 {
                color: var(--report-muted) !important;
            }
        }
    </style>
</head>

<body class="min-h-screen">
    <div class="max-w-6xl mx-auto p-6 space-y-6">

        <!-- 🟩 رأس التقرير -->
  @*       <header class="flex justify-between items-center bg-white shadow-md rounded-xl p-4">
            <div class="flex items-center gap-4">
                <img src="~/images/160×100.png" alt="شعار معهد القدرات"
                     class="rounded-md border border-gray-200 shadow-sm" style="width:130px;height:85px;" />
                <div>
                    <h1 class="text-2xl font-bold text-[var(--main-color)]">@ViewData["Title"]</h1>
                    <p class="text-gray-500 text-sm">نظام التقارير الذكية لمعهد القدرات</p>
                </div>
            </div>
            <div class="text-right">
                <p class="bg-[var(--main-color)]/10 text-[var(--main-color)] px-4 py-1 rounded-full text-sm font-semibold">
                    📅 @DateTime.Now.ToString("yyyy/MM/dd")
                </p>
            </div>
        </header>
 *@
        <!-- ✅ هنا يتم حقن محتوى التقرير -->
        @RenderBody()

        <!-- ✍️ العبارة الختامية -->
        <div class="footer-note print:mt-8">
            <hr class="my-4 border-gray-300" />
            <p>📘 صادر عن إدارة التقويم الأكاديمي - معهد القدرات © @DateTime.Now.Year</p>
        </div>
    </div>
    @RenderSection("Scripts", required: false)
</body>
</html>
