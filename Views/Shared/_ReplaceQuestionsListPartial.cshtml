@model IEnumerable<QdratNew.ViewModels.Question.QuestionSimpleViewModel>

<table class="table table-hover text-center align-middle">
    <thead class="table-light">
        <tr>
            <th>نص السؤال</th>
            <th>الصعوبة</th>
            <th>الإجابة الصحيحة</th>
            <th>إجراء</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var q in Model)
            {
                <tr>
                    <td class="text-start">@Html.Raw(q.Title)</td>
                    <td>@q.Difficulty</td>
                    <td>@q.CorrectAnswer</td>
                    <td>
                        <button class="btn btn-success btn-sm"
                                onclick="confirmReplace('@ViewBag.ExamId', '@ViewBag.OldQuestionId', '@q.Id')">
                            اختيار
                        </button>


                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-muted">لا توجد أسئلة متاحة لهذا المحور</td>
            </tr>
        }
    </tbody>
</table>
