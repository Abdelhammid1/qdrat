@model QdratNew.ViewModels.Users.UserAccountDropdownViewModel
@using Microsoft.AspNetCore.Identity
@using QdratNew.Entities
@using QdratNew.Helpers
@inject SignInManager<ApplicationUser> SignInManager

@if (!SignInManager.IsSignedIn(User))
{
    <a href="/LMS/login?returnUrl=%2F"
       class="btn btn-primary btn-sm">
        تسجيل الدخول
    </a>
}
else
{
    <div class="dropdown">
        <a href="#" class="d-block" data-bs-toggle="dropdown">
            <img src="@(string.IsNullOrEmpty(Model.ProfileImageUrl)
                                             ? "/images/default-avatar.png"
                                             : Model.ProfileImageUrl)"
             class="user-avatar"
             style="width:36px;height:36px;border-radius:50%;object-fit:cover;" />
    </a>

        <div class="dropdown-menu dropdown-menu-end p-3 text-end"
             style="min-width:320px;">

            <!-- البريد -->
            <div class="small text-muted text-center">@Model.Email</div>

            <!-- الصورة -->
            <div class="text-center my-3 position-relative">
                <img src="@(string.IsNullOrEmpty(Model.ProfileImageUrl)
                                                 ? "/images/default-avatar.png"
                                                 : Model.ProfileImageUrl)"
                 class="rounded-circle"
                 width="80"
                 height="80"
                 style="object-fit:cover;" />

                <a href="@Model.ProfileImageUploadUrl"
                   class="position-absolute bottom-0 end-50 translate-middle-x
                              bg-white border rounded-circle p-1"
                   title="تغيير الصورة">
                    <i class="fas fa-camera"></i>
                </a>
            </div>

            <!-- الاسم -->
            <div class="text-center mb-2">
                <div class="fw-bold">@Model.FullName</div>
            </div>

            <!-- ملفي الشخصي -->
            <div class="text-center mb-2">
                @{
                    var currentPath = Context.Request.Path.ToString().ToLower();
                    var profileUrl = currentPath.Contains("/admin")
                        ? "/Admin/AdminProfile/Index"
                        : "/Students/StudentProfile/Index";
                }
                <a href="@profileUrl"
                   class="btn btn-sm w-100"
                   style="background:#f1f5f9; color:#475569; border-radius:8px; font-size:0.82rem; font-weight:600;">
                    <i class="fas fa-user-edit me-1"></i>
                    ملفي الشخصي
                </a>
            </div>

            @* ===== Role Switcher (FAST – NO FORM) ===== *@
        @if (Model.Roles != null && Model.Roles.Count > 1)
            {
                <hr />
                <label class="form-label small mb-1">الدور النشط</label>

                <select class="form-select form-select-sm"
                        onchange="switchRoleFast(this.value)">
                    @foreach (var role in Model.Roles)
                    {
                        <option value="@role"
                                selected="@(role == Model.SelectedRole)">
                            @RoleNamesHelper.RoleDisplay.GetValueOrDefault(role, role)
                        </option>
                    }
                </select>
            }

            <hr />

            <!-- تسجيل الخروج -->
            <form method="post"
                  asp-area="Identity"
                  asp-page="/Account/Logout">
                <button type="submit"
                        class="btn btn-sm btn-outline-danger w-100">
                    تسجيل الخروج
                </button>
            </form>
        </div>
    </div>
}
<script>
    function switchRoleFast(role) {
        fetch("/Account/SwitchRole", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(role)
        })
        .then(r => r.json())
        .then(d => {
            if (d.redirectUrl) {
                window.location.href = d.redirectUrl;
            }
        });
    }
</script>


