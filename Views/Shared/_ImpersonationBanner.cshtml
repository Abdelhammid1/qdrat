@* ═══════════════════════════════════════════════════════════════
   شريط التخفي العلوي — يظهر فقط أثناء جلسة Impersonation
   يُضمَّن في بداية <body> في كل Layout رئيسي
═══════════════════════════════════════════════════════════════ *@
@using QdratNew.Services
@inject ImpersonationService ImpSvc
@{
    var data       = ImpSvc.Read();
    bool active    = data != null;
    var startLocal = data != null ? data.StartUtc.ToLocalTime() : DateTime.Now;
}

@if (active)
{
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      crossorigin="anonymous" referrerpolicy="no-referrer" />
<style>
  body { padding-top: 48px !important; }
</style>

<div id="impBar" style="
    position:fixed;top:0;right:0;left:0;z-index:99999;
    background:linear-gradient(90deg,#1e1b4b 0%,#312e81 45%,#4338CA 100%);
    color:#fff;
    display:flex;align-items:center;justify-content:space-between;
    gap:16px;padding:0 20px;height:48px;
    font-family:'Cairo','Segoe UI',sans-serif;font-size:13px;
    box-shadow:0 3px 12px rgba(0,0,0,.35);
    direction:rtl;">

  @* ── يسار: أيقونة + بيانات المستخدم + وقت البدء ── *@
  <div style="display:flex;align-items:center;gap:10px;overflow:hidden;min-width:0;">
    <span style="background:rgba(255,255,255,.15);border-radius:50%;
        width:30px;height:30px;flex-shrink:0;
        display:flex;align-items:center;justify-content:center;">
      <i class="fa-solid fa-user-secret" style="font-size:13px;"></i>
    </span>
    <span style="font-weight:700;color:#a5b4fc;white-space:nowrap;">وضع التخفي</span>
    <span style="color:rgba(255,255,255,.4);">|</span>
    <span style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
      <strong style="color:#fff;">@data!.TargetName</strong>
      @if (!string.IsNullOrEmpty(data.TargetEmail))
      {
        <span style="font-size:11px;color:#c7d2fe;margin-right:6px;">(@data.TargetEmail)</span>
      }
    </span>
    <span style="color:rgba(255,255,255,.4);">|</span>
    <span style="font-size:11px;color:#c7d2fe;white-space:nowrap;">
      <i class="fa-solid fa-clock" style="margin-left:3px;"></i>
      بدأ: @startLocal.ToString("hh:mm tt — dd/MM/yyyy")
    </span>
  </div>

  @* ── يمين: مؤقت التشغيل + زر الإلغاء ── *@
  <div style="display:flex;align-items:center;gap:10px;flex-shrink:0;">
    <div id="impTimer" style="
        background:rgba(0,0,0,.28);border-radius:8px;
        padding:4px 14px;font-size:13px;font-weight:700;
        font-variant-numeric:tabular-nums;
        min-width:82px;text-align:center;
        color:#e0e7ff;letter-spacing:.5px;">00:00:00</div>

    <form action="/Impersonation/Cancel" method="post" style="margin:0;">
      @Html.AntiForgeryToken()
      <button type="submit" style="
          display:flex;align-items:center;gap:6px;
          background:rgba(239,68,68,.85);color:#fff;
          border:1px solid rgba(255,255,255,.18);
          border-radius:8px;padding:5px 15px;
          font-family:'Cairo','Segoe UI',sans-serif;
          font-size:12px;font-weight:700;cursor:pointer;
          transition:background .18s;white-space:nowrap;"
          onmouseover="this.style.background='rgba(220,38,38,1)'"
          onmouseout="this.style.background='rgba(239,68,68,.85)'">
        <i class="fa-solid fa-right-from-bracket"></i>
        إنهاء التخفي والعودة
      </button>
    </form>
  </div>
</div>

<script>
(function () {
  var start = new Date('@data!.StartUtc.ToString("O")');
  function pad(n) { return n < 10 ? '0' + n : '' + n; }
  function tick() {
    var diff = Math.max(0, Math.floor((Date.now() - start.getTime()) / 1000));
    var h = Math.floor(diff / 3600);
    var m = Math.floor((diff % 3600) / 60);
    var s = diff % 60;
    var el = document.getElementById('impTimer');
    if (el) el.textContent = pad(h) + ':' + pad(m) + ':' + pad(s);
  }
  tick();
  setInterval(tick, 1000);
})();
</script>
}
