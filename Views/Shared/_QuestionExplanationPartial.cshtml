@model dynamic

@{
    var isRTL = Model.IsRTL ?? true;
    var explanation = Model.Explanation as string;
    var videoUrl = Model.VideoUrl as string;
    var id = Model.QuestionId;
}

@if (!string.IsNullOrWhiteSpace(explanation) || !string.IsNullOrWhiteSpace(videoUrl))
{
    <div class="d-flex gap-2 align-items-center">

        @* 📄 شرح *@
        @if (!string.IsNullOrWhiteSpace(explanation))
        {
            <i class="fa-solid fa-file-lines text-qdrat explanation-toggle fs-3"
               style="cursor:pointer;"
               data-id="@id"
               data-bs-toggle="tooltip"
               data-bs-placement="top"
               title="شرح السؤال"></i>
        }

        @* 🎥 فيديو *@
        @if (!string.IsNullOrWhiteSpace(videoUrl))
        {
            <i class="fa-solid fa-video text-qdrat video-toggle fs-3"
               style="cursor:pointer;"
               data-id="@id"
               data-bs-toggle="tooltip"
               data-bs-placement="top"
               title="فيديو الشرح"></i>
        }

    </div>

    <div id="extra-content-@id"
         class="mt-3"
         style="display:none;">

        @* 📄 الشرح *@
        @if (!string.IsNullOrWhiteSpace(explanation))
        {
            <div class="explanation-content mb-3" style="display:none;">
                <div class="card border-0 shadow-sm rounded-3 explanation-card">

                    <div class="card-header bg-light d-flex align-items-center gap-2">
                        <i class="fa-solid fa-lightbulb text-warning"></i>
                        <span class="fw-bold">شرح السؤال</span>
                    </div>

                    <div class="card-body smart-text"
                         dir="@(isRTL ? "rtl" : "ltr")"
                         style="text-align:@(isRTL ? "right" : "left"); line-height:1.8;">

                        @Html.Raw(explanation)

                    </div>

                </div>
            </div>
        }

        @* 🎥 الفيديو *@
        @if (!string.IsNullOrWhiteSpace(videoUrl))
        {
            <div class="video-content" style="display:none;">
                <div class="card border-0 shadow-sm rounded-3">

                    <div class="card-header bg-light d-flex align-items-center gap-2">
                        <i class="fa-solid fa-video text-danger"></i>
                        <span class="fw-bold">فيديو الشرح</span>
                    </div>

                    <div class="card-body p-2">

                        <div class="ratio ratio-16x9">
                            <iframe src="@videoUrl"
                                    frameborder="0"
                                    allow="autoplay; fullscreen"
                                    allowfullscreen>
                            </iframe>
                        </div>

                    </div>

                </div>
            </div>
        }

    </div>
}





<style>
    .explanation-card {
        border-left: 4px solid #ffc107;
    }

    .explanation-toggle,
    .video-toggle {
        transition: 0.2s;
    }

        .explanation-toggle:hover,
        .video-toggle:hover {
            transform: scale(1.2);
        }
</style>