@model QdratNew.ViewModels.Students.StudentAIUnifiedAnalysisViewModel

<script>
    const successCtx = document.getElementById('successChart')?.getContext('2d');
    if (successCtx) {
        new Chart(successCtx, {
            type: 'doughnut',
            data: {
                labels: ['نجاح', 'باقي'],
                datasets: [{
                    data: [@Model.SuccessRate, @(100 - Model.SuccessRate)],
                    backgroundColor: ['#339999', '#ccc']
                }]
            },
            options: {
                plugins: {
                    title: { display: true, text: 'نسبة النجاح' },
                    legend: { position: 'bottom' }
                }
            }
        });
    }

  
       const riskCtx = document.getElementById('riskChart')?.getContext('2d');
       if (riskCtx) {
           new Chart(riskCtx, {
               type: 'pie',
               data: {
                   labels: ['خطورة', 'باقي'],
                   datasets: [{
                       data: [@Model.RiskScore * 33.3, @(100 - @Model.RiskScore * 33.3)],
                       backgroundColor: ['#4CA6A8', '#e0e0e0'],
                       borderWidth: 1
                   }]
               },
               options: {
                   plugins: {
                       title: {
                           display: true,
                           text: 'تحليل الخطورة',
                           color: '#4CA6A8',
                           font: {
                               size: 16,
                               weight: 'bold'
                           }
                       },
                       legend: {
                           position: 'bottom',
                           labels: {
                               color: '#333'
                           }
                       }
                   }
               }
           });
       }



    const trendCtx = document.getElementById('performanceTrendChart')?.getContext('2d');
    if (trendCtx) {
        new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: [
                    @foreach (var sec in Model.SectionSummaries)
                    {
                            @Html.Raw($"'{sec.SectionTitle}',")
                    }
                ],
                datasets: [{
                    label: 'متوسط الدرجات',
                    data: [
                        @foreach (var sec in Model.SectionSummaries)
                        {
                                @Html.Raw($"{sec.AverageScore},")
                        }
                    ],
                    borderColor: '#4CA6A8',
                    tension: 0.3,
                    fill: false
                }]
            },
            options: {
                plugins: {
                    title: { display: true, text: 'تطور الأداء حسب المحاور' }
                }
            }
        });
    }
</script>
<script>
    const batchCtx = document.getElementById('batchComparisonChart')?.getContext('2d');
    if (batchCtx) {
        new Chart(batchCtx, {
            type: 'bar',
            data: {
                labels: ['نسبة النجاح', 'معدل الخطورة', 'وقت حل الواجب'],
                datasets: [
                    {
                        label: 'الطالب',
                        data: [@Model.SuccessRate, @Model.RiskScore * 33.3, @Model.AverageHomeworkTime],
                        backgroundColor: 'rgba(76, 166, 168, 0.8)'
                    },
                    {
                        label: 'متوسط الدفعة',
                        data: [@Model.AverageBatchSuccessRate, @Model.AverageBatchRiskScore * 33.3, @Model.AverageBatchHomeworkTime],
                        backgroundColor: '#ccc'
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    title: {
                        display: true,
                        text: 'مقارنة الطالب بمتوسط الدفعة',
                        color: '#4CA6A8',
                        font: {
                            size: 16,
                            weight: 'bold'
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100
                    }
                }
            }
        });
    }
</script>
<script>
    const homeworkCtx = document.getElementById('homeworkTimeChart')?.getContext('2d');
    if (homeworkCtx) {
        new Chart(homeworkCtx, {
            type: 'bar',
            data: {
                labels: ['متوسط وقت الطالب', 'الزمن المثالي'],
                datasets: [{
                    label: 'الزمن بالثواني',
                    data: [@Model.AverageHomeworkTime, 600],
                    backgroundColor: ['#4CA6A8', '#A8C4C7'],
                    borderRadius: 5
                }]
            },
            options: {
                plugins: {
                    title: {
                        display: true,
                        text: 'تحليل زمن حل الواجب',
                        color: '#4CA6A8',
                        font: {
                            size: 16,
                            weight: 'bold'
                        }
                    },
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 100 }
                    }
                }
            }
        });
    }
</script>
<script>
    const radarCtx = document.getElementById('radarChart')?.getContext('2d');
    if (radarCtx) {
        new Chart(radarCtx, {
            type: 'radar',
            data: {
                labels: [
                    @foreach (var sec in Model.SectionSummaries)
                    {
                            @Html.Raw($"'{sec.SectionTitle}',")
                    }
                ],
                datasets: [{
                    label: 'متوسط أداء الطالب',
                    data: [
                        @foreach (var sec in Model.SectionSummaries)
                        {
                                @Html.Raw($"{sec.AverageScore},")
                        }
                    ],
                    backgroundColor: 'rgba(76, 166, 168, 0.2)',
                    borderColor: '#4CA6A8',
                    pointBackgroundColor: '#4CA6A8',
                    pointBorderColor: '#fff',
                    pointHoverBackgroundColor: '#fff',
                    pointHoverBorderColor: '#4CA6A8',
                    borderWidth: 2,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    title: {
                        display: true,
                        text: 'تحليل أداء الطالب حسب المحاور',
                        font: { size: 16, weight: 'bold' },
                        color: '#4CA6A8'
                    },
                    legend: {
                        position: 'top',
                        labels: {
                            color: '#333'
                        }
                    }
                },
                scales: {
                    r: {
                        angleLines: { display: true, color: '#ddd' },
                        grid: { color: '#eaeaea' },
                        pointLabels: {
                            color: '#333',
                            font: { size: 13 }
                        },
                        suggestedMin: 0,
                        suggestedMax: 100,
                        ticks: {
                            stepSize: 20,
                            backdropColor: 'transparent',
                            color: '#999'
                        }
                    }
                }
            }
        });
    }
</script>
