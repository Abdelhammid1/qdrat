@model QdratNew.ViewModels.Instructor.Lectures.InstructorLectureFormViewModel

@{
    var isEdit = Model.Id > 0;
    var actionName = isEdit ? "Edit" : "Create";
}

<div class="lecture-form-page" dir="rtl">
    <div class="form-card">
        <div class="form-header">
            <h1>@(isEdit ? "تعديل محاضرة" : "إنشاء محاضرة جديدة")</h1>
            <p>المحاضرة سيتم ربطها بالمدرب الحالي فقط.</p>
        </div>

        <form asp-area="Instructors"
              asp-controller="InstructorLectures"
              asp-action="@actionName"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CourseId" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Title" class="form-label">عنوان المحاضرة</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Date" class="form-label">تاريخ ووقت المحاضرة</label>
                    <input asp-for="Date" type="datetime-local" class="form-control" />
                    <span asp-validation-for="Date" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="BatchId" class="form-label">الدفعة</label>
                    <select asp-for="BatchId" asp-items="Model.Batches" class="form-select" id="batchSelect">
                        <option value="">اختر الدفعة</option>
                    </select>
                    <span asp-validation-for="BatchId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="SectionId" class="form-label">المحور</label>
                    <select asp-for="SectionId" asp-items="Model.Sections" class="form-select" id="sectionSelect">
                        <option value="">اختر المحور</option>
                    </select>
                    <span asp-validation-for="SectionId" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Location" class="form-label">مكان المحاضرة</label>
                    <input asp-for="Location" class="form-control" placeholder="مثال: قاعة 1 / أونلاين / المعمل" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    @(isEdit ? "حفظ التعديل" : "إنشاء المحاضرة")
                </button>

                <a asp-area="Instructors"
                   asp-controller="InstructorLectures"
                   asp-action="Index"
                   asp-route-batchId="@Model.BatchId"
                   class="btn btn-light">
                    رجوع
                </a>
            </div>
        </form>
    </div>
</div>

<style>
    .lecture-form-page {
        padding: 28px;
        background: #f6f8fb;
        min-height: calc(100vh - 90px);
    }

    .form-card {
        background: #fff;
        border: 1px solid #e5edf7;
        border-radius: 26px;
        padding: 26px;
        box-shadow: 0 16px 38px rgba(15, 23, 42, .08);
        max-width: 980px;
        margin: auto;
    }

    .form-header {
        margin-bottom: 24px;
        padding-bottom: 18px;
        border-bottom: 1px solid #edf2f7;
    }

        .form-header h1 {
            margin: 0 0 8px;
            font-weight: 900;
            color: #0f172a;
        }

        .form-header p {
            margin: 0;
            color: #64748b;
            font-weight: 700;
        }

    .form-label {
        font-weight: 900;
        color: #334155;
    }

    .form-control,
    .form-select {
        min-height: 48px;
        border-radius: 14px;
        border-color: #dbe5f1;
        font-weight: 700;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 24px;
    }

        .form-actions .btn {
            min-width: 150px;
            border-radius: 14px;
            font-weight: 900;
            padding: 11px 18px;
        }

    @@media(max-width: 768px) {
        .lecture-form-page {
            padding: 16px;
        }

        .form-actions {
            flex-direction: column;
        }

            .form-actions .btn {
                width: 100%;
            }
    }
</style>

<script>
    document.getElementById('batchSelect')?.addEventListener('change', function () {
        var batchId = this.value;
        var sectionSelect = document.getElementById('sectionSelect');

        sectionSelect.innerHTML = '<option value="">اختر المحور</option>';

        if (!batchId) {
            return;
        }

        fetch('/Instructors/InstructorLectures/GetSectionsByBatch?batchId=' + encodeURIComponent(batchId))
            .then(function (response) {
                return response.json();
            })
            .then(function (items) {
                items.forEach(function (item) {
                    var option = document.createElement('option');
                    option.value = item.id;
                    option.textContent = item.title;
                    sectionSelect.appendChild(option);
                });
            });
    });
</script>