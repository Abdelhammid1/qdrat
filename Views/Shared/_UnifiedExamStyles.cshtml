<style>
    /* ══════════════════════════════════════════════════════════
       CSS Variables
    ══════════════════════════════════════════════════════════ */
    :root {
        --qx-primary:       #4f46e5;
        --qx-primary-light: #eef2ff;
        --qx-primary-mid:   #c7d2fe;
        --qx-success:       #059669;
        --qx-success-light: #d1fae5;
        --qx-warning:       #d97706;
        --qx-warning-light: #fef3c7;
        --qx-danger:        #dc2626;
        --qx-danger-light:  #fee2e2;
        --qx-neutral:       #6b7280;
        --qx-neutral-light: #f3f4f6;
        --qx-border:        #e5e7eb;
        --qx-text:          #111827;
        --qx-text-muted:    #6b7280;
        --qx-bg:            #f8fafc;
        --qx-card-bg:       #ffffff;
        --qx-radius:        16px;
        --qx-shadow:        0 4px 24px rgba(79,70,229,.10);
        --qx-shadow-hover:  0 8px 32px rgba(79,70,229,.18);
    }

    /* ══════════════════════════════════════════════════════════
       Shell
    ══════════════════════════════════════════════════════════ */
    .qx-shell {
        width: 100%;
        padding: 0 0 120px;
        font-family: 'Tajawal', 'Cairo', sans-serif;
    }

    .qx-rtl { direction: rtl; text-align: right; }
    .qx-ltr { direction: ltr; text-align: left; }
    .rtl-mode { direction: rtl; text-align: right; }
    .ltr-mode { direction: ltr; text-align: left; }

    /* ══════════════════════════════════════════════════════════
       Header row
    ══════════════════════════════════════════════════════════ */
    .qx-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: .75rem 0 1.25rem;
        flex-wrap: wrap;
    }

    .qx-header__meta {
        display: flex;
        align-items: center;
        gap: .65rem;
        flex-wrap: wrap;
    }

    /* Question number badge */
    .qx-question-badge {
        display: inline-flex;
        align-items: baseline;
        gap: .3rem;
        background: var(--qx-primary);
        color: #fff;
        border-radius: 50px;
        padding: .35rem 1.1rem;
        font-weight: 700;
        font-size: .9rem;
        box-shadow: 0 2px 10px rgba(79,70,229,.35);
        user-select: none;
    }

    .qx-question-badge__num {
        font-size: 1.15rem;
        line-height: 1;
    }

    .qx-question-badge__sep,
    .qx-question-badge__total {
        opacity: .75;
        font-size: .8rem;
    }

    .qx-question-badge__label {
        font-size: .75rem;
        opacity: .85;
        letter-spacing: .03em;
    }

    /* Section chip */
    .qx-section-chip {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        background: var(--qx-primary-light);
        color: var(--qx-primary);
        border: 1px solid var(--qx-primary-mid);
        border-radius: 50px;
        padding: .3rem .9rem;
        font-size: .8rem;
        font-weight: 600;
    }

    /* ══════════════════════════════════════════════════════════
       Stopwatch badge (functional classes preserved)
    ══════════════════════════════════════════════════════════ */
    .question-stopwatch-badge {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: var(--qx-card-bg);
        border: 1.5px solid var(--qx-border);
        border-radius: 50px;
        padding: .3rem .85rem;
        font-size: .82rem;
        font-weight: 700;
        color: var(--qx-neutral);
        box-shadow: 0 1px 6px rgba(0,0,0,.06);
        transition: background .3s, color .3s, border-color .3s;
        user-select: none;
    }

    .question-stopwatch-badge.sw-warning {
        background: var(--qx-warning-light);
        border-color: #fcd34d;
        color: var(--qx-warning);
    }

    .question-stopwatch-badge.sw-alert {
        background: var(--qx-danger-light);
        border-color: #fca5a5;
        color: var(--qx-danger);
        animation: sw-pulse .8s ease-in-out infinite alternate;
    }

    @@keyframes sw-pulse {
        from { opacity: 1; }
        to   { opacity: .6; }
    }

    .stopwatch-icon { flex-shrink: 0; opacity: .75; }
    .stopwatch-digits { font-variant-numeric: tabular-nums; min-width: 2.8ch; }

    /* ══════════════════════════════════════════════════════════
       Passage
    ══════════════════════════════════════════════════════════ */
    .qx-passage {
        margin-bottom: 1.25rem;
        border-radius: var(--qx-radius);
        overflow: hidden;
    }

    .qx-passage--text {
        border: 1.5px solid #bfdbfe;
        background: #eff6ff;
    }

    .qx-passage__title {
        display: flex;
        align-items: center;
        gap: .5rem;
        padding: .65rem 1rem;
        font-weight: 700;
        color: #1d4ed8;
        font-size: .88rem;
        border-bottom: 1px solid #bfdbfe;
    }

    .qx-passage__scroll-hint {
        margin-inline-start: auto;
        font-size: .74rem;
        font-weight: 600;
        color: #3b82f6;
        opacity: .85;
    }

    .qx-passage__body {
        padding: 1rem 1.25rem;
        line-height: 1.9;
        font-size: .95rem;
        color: var(--qx-text);
    }

    /* قطعة طويلة: نمنع سيطرتها على طول الصفحة ونجعلها قابلة للتمرير داخليًا فقط */
    .qx-passage--long .qx-passage__body {
        max-height: 320px;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--qx-primary-mid) transparent;
    }

    .qx-passage--long .qx-passage__body::-webkit-scrollbar { width: 7px; }
    .qx-passage--long .qx-passage__body::-webkit-scrollbar-track { background: transparent; }
    .qx-passage--long .qx-passage__body::-webkit-scrollbar-thumb {
        background: var(--qx-primary-mid);
        border-radius: 10px;
    }

    /* ─── تطبيع تنسيق المحتوى الغني ───
       محتوى القطعة قادم من محرر نصوص إداري وقد يحمل ألوان/أحجام خط عشوائية (مثال متكرر: نص أبيض
       غير مقروء على الخلفية الفاتحة، أو حجم خط كبير جدًا يُكبّر الصندوق). نفرض هنا لونًا وحجمًا
       موحّدين مقروءين دائمًا، مع الإبقاء على التنسيق البنيوي (عريض/مائل/روابط/قوائم/جداول/تظليل). */
    .qx-passage__body,
    .qx-passage__body p,
    .qx-passage__body span,
    .qx-passage__body div,
    .qx-passage__body li,
    .qx-passage__body td,
    .qx-passage__body th,
    .qx-passage__body font {
        color: var(--qx-text) !important;
        background-color: transparent !important;
        font-size: 1em !important;
        font-family: inherit !important;
    }

    .qx-passage__body p {
        margin: 0 0 .85em;
    }

    .qx-passage__body p:last-child {
        margin-bottom: 0;
    }

    .qx-passage__body strong,
    .qx-passage__body b {
        font-weight: 700 !important;
        color: inherit !important;
    }

    .qx-passage__body em,
    .qx-passage__body i {
        font-style: italic;
    }

    .qx-passage__body u {
        text-decoration: underline;
    }

    .qx-passage__body h1,
    .qx-passage__body h2,
    .qx-passage__body h3,
    .qx-passage__body h4,
    .qx-passage__body h5,
    .qx-passage__body h6 {
        font-size: 1.08em !important;
        font-weight: 700 !important;
        color: var(--qx-text) !important;
        margin: 0 0 .5em;
        line-height: 1.6;
    }

    .qx-passage__body a {
        color: #1d4ed8 !important;
        text-decoration: underline;
    }

    .qx-passage__body img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        margin: .5em 0;
    }

    .qx-passage__body table {
        width: 100%;
        border-collapse: collapse;
        font-size: .92em !important;
        margin: .5em 0;
    }

    .qx-passage__body table td,
    .qx-passage__body table th {
        border: 1px solid #bfdbfe;
        padding: .4em .6em;
    }

    .qx-passage__body ul,
    .qx-passage__body ol {
        padding-inline-start: 1.4em;
        margin: 0 0 .85em;
    }

    .qx-passage__body mark {
        background: #fef08a !important;
        color: #713f12 !important;
        padding: 0 .2em;
        border-radius: 3px;
    }

    /* ══════════════════════════════════════════════════════════
       Question card
    ══════════════════════════════════════════════════════════ */
    .qx-question-card {
        background: var(--qx-card-bg);
        border-radius: var(--qx-radius);
        box-shadow: var(--qx-shadow);
        border: 1.5px solid var(--qx-border);
        border-right: 5px solid var(--qx-primary);
        margin-bottom: 1.25rem;
        overflow: hidden;
    }

    .qx-ltr .qx-question-card {
        border-right: 1.5px solid var(--qx-border);
        border-left: 5px solid var(--qx-primary);
    }

    .qx-question-card__body {
        padding: 1.25rem 1.5rem;
        font-size: 1.05rem;
        line-height: 1.85;
        color: var(--qx-text);
        unicode-bidi: isolate;
    }

    .qx-question-card__body svg { direction: ltr !important; }
    .qx-question-card__body * { unicode-bidi: isolate; }

    /* Comparison */
    .qx-comparison {
        display: flex;
        align-items: stretch;
        gap: 0;
        border-top: 1px solid var(--qx-border);
        margin: 0;
    }

    .qx-comparison__col {
        flex: 1;
        padding: 1rem;
        text-align: center;
    }

    .qx-comparison__divider {
        width: 1px;
        background: var(--qx-border);
        align-self: stretch;
    }

    .qx-comparison__label {
        display: block;
        font-size: .75rem;
        font-weight: 700;
        color: var(--qx-primary);
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-bottom: .4rem;
    }

    .qx-comparison__val {
        font-size: 1rem;
        color: var(--qx-text);
    }

    .qx-comparison__img-wrap {
        flex: 0 0 auto;
        padding: .75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-left: 1px solid var(--qx-border);
    }

    .qx-comparison__img {
        max-height: 180px;
        border-radius: 8px;
        object-fit: contain;
    }

    /* Question image */
    .qx-question-img-wrap {
        padding: .75rem 1.5rem 1rem;
        text-align: center;
    }

    .qx-question-img {
        max-height: 280px;
        max-width: 100%;
        border-radius: 10px;
        object-fit: contain;
    }

    /* ══════════════════════════════════════════════════════════
       Options
    ══════════════════════════════════════════════════════════ */
    .qx-options {
        display: flex;
        flex-direction: column;
        gap: .6rem;
        margin-bottom: 1.5rem;
    }

    .qx-option {
        display: flex;
        align-items: center;
        gap: .85rem;
        background: var(--qx-card-bg);
        border: 1.5px solid var(--qx-border);
        border-radius: 12px;
        padding: .75rem 1rem;
        cursor: pointer;
        transition: border-color .18s ease, background .18s ease, box-shadow .18s ease, transform .12s ease;
        position: relative;
        user-select: none;
    }

    .qx-option--rtl {
        direction: rtl;
        flex-direction: row;
        text-align: right;
    }

    .qx-option--rtl .qx-option__check {
        order: -1;
        margin-inline-start: 0;
    }

    .qx-option--rtl .qx-option__content,
    .qx-option--rtl .qx-option__text {
        text-align: right;
    }

    .qx-option--rtl .qx-option__combo {
        align-items: flex-start;
    }

    .qx-option:hover {
        border-color: var(--qx-primary-mid);
        background: var(--qx-primary-light);
        transform: translateY(-1px);
        box-shadow: 0 4px 16px rgba(79,70,229,.10);
    }

    .qx-option--selected {
        border-color: var(--qx-primary) !important;
        background: var(--qx-primary-light) !important;
        box-shadow: 0 0 0 3px rgba(79,70,229,.12) !important;
    }

    .qx-option__radio {
        position: absolute;
        opacity: 0;
        pointer-events: none;
        width: 0;
        height: 0;
    }

    /* Check icon */
    .qx-option__check {
        flex-shrink: 0;
        margin-inline-start: auto;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: transparent;
        border: 1.5px solid var(--qx-border);
        display: flex;
        align-items: center;
        justify-content: center;
        color: transparent;
        transition: background .18s, border-color .18s, color .18s;
    }

    .qx-option--selected .qx-option__check {
        background: var(--qx-primary);
        border-color: var(--qx-primary);
        color: #fff;
    }

    .qx-option__content {
        flex: 1;
        min-width: 0;
    }

    .qx-option__text {
        font-size: .97rem;
        color: var(--qx-text);
        font-weight: 500;
        display: block;
    }

    .qx-option--selected .qx-option__text {
        color: var(--qx-primary);
        font-weight: 700;
    }

    .qx-option__img {
        max-height: 80px;
        border-radius: 8px;
        object-fit: contain;
    }

    .qx-option__img--inline {
        max-height: 55px;
        margin-bottom: .25rem;
    }

    .qx-option__combo {
        display: flex;
        flex-direction: column;
        gap: .35rem;
    }

    .qx-no-options {
        background: #fef9c3;
        border: 1px solid #fde68a;
        border-radius: 10px;
        padding: .85rem 1.25rem;
        color: #92400e;
        font-size: .9rem;
        margin-bottom: 1.5rem;
    }

    /* ══════════════════════════════════════════════════════════
       Navigation bar (exam-nav-fixed preserved for JS)
    ══════════════════════════════════════════════════════════ */
    .qx-nav-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(255,255,255,.95);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-top: 1.5px solid var(--qx-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        padding: .75rem 1.5rem;
        z-index: 900;
        box-shadow: 0 -4px 24px rgba(0,0,0,.08);
    }

    .qx-nav-btn {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        border: none;
        border-radius: 50px;
        font-weight: 700;
        font-size: .9rem;
        cursor: pointer;
        transition: background .18s, transform .12s, box-shadow .18s;
        white-space: nowrap;
    }

    .qx-nav-btn:disabled {
        opacity: .35;
        cursor: not-allowed;
        transform: none !important;
    }

    .qx-nav-btn:not(:disabled):hover {
        transform: translateY(-2px);
    }

    /* Previous */
    .qx-nav-btn--prev {
        background: var(--qx-neutral-light);
        color: var(--qx-text);
        padding: .6rem 1.3rem;
        box-shadow: 0 2px 8px rgba(0,0,0,.07);
    }

    .qx-nav-btn--prev:not(:disabled):hover {
        background: #e5e7eb;
        box-shadow: 0 4px 14px rgba(0,0,0,.12);
    }

    /* Flag */
    .qx-nav-btn--flag {
        background: var(--qx-warning-light);
        color: var(--qx-warning);
        padding: .6rem 1.15rem;
        border: 1.5px solid #fcd34d;
    }

    .qx-nav-btn--flag:hover {
        background: #fde68a;
        box-shadow: 0 4px 14px rgba(217,119,6,.20);
    }

    /* Next */
    .qx-nav-btn--next {
        background: var(--qx-primary);
        color: #fff;
        padding: .6rem 1.5rem;
        box-shadow: 0 4px 14px rgba(79,70,229,.35);
    }

    .qx-nav-btn--next:hover {
        background: #4338ca;
        box-shadow: 0 6px 20px rgba(79,70,229,.45);
    }

    /* Review trigger */
    .qx-review-trigger-wrap {
        text-align: center;
        padding: 2rem 0 1rem;
    }

    .qx-review-trigger-btn {
        display: inline-flex;
        align-items: center;
        gap: .6rem;
        background: var(--qx-primary);
        color: #fff;
        border: none;
        border-radius: 50px;
        padding: .75rem 2rem;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        box-shadow: 0 4px 18px rgba(79,70,229,.35);
        transition: background .18s, transform .15s, box-shadow .18s;
    }

    .qx-review-trigger-btn:hover {
        background: #4338ca;
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(79,70,229,.42);
    }

    /* Review mode hides nav */
    .exam-in-review-mode .exam-nav-fixed,
    .exam-in-review-mode .exam-show-review-wrap {
        display: none !important;
    }

    /* ══════════════════════════════════════════════════════════
       Review panel
    ══════════════════════════════════════════════════════════ */
    .qx-review-panel {
        max-width: 700px;
        margin: 1.5rem auto 2.5rem;
        background: var(--qx-card-bg);
        border-radius: 20px;
        box-shadow: 0 8px 40px rgba(0,0,0,.10);
        border: 1.5px solid var(--qx-border);
        overflow: hidden;
        padding: 0;
    }

    /* Head */
    .qx-review-head {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.25rem 1.5rem;
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        color: #fff;
    }

    .qx-review-head__icon {
        width: 46px;
        height: 46px;
        background: rgba(255,255,255,.18);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .qx-review-head__title {
        font-size: 1.1rem;
        font-weight: 800;
        margin: 0 0 .15rem;
        color: #fff;
    }

    .qx-review-head__sub {
        font-size: .82rem;
        opacity: .85;
        margin: 0;
        color: #fff;
    }

    /* Progress bar */
    .qx-progress-track {
        height: 7px;
        background: #e5e7eb;
    }

    .qx-progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #059669, #34d399);
        transition: width .5s ease;
    }

    .qx-progress-label {
        display: flex;
        justify-content: space-between;
        padding: .4rem 1.5rem .1rem;
        font-size: .75rem;
        color: var(--qx-text-muted);
        font-weight: 600;
    }

    /* Stats */
    .qx-review-stats {
        display: flex;
        justify-content: center;
        gap: 0;
        margin: .25rem 1.5rem 1.25rem;
        border-radius: 12px;
        overflow: hidden;
        border: 1.5px solid var(--qx-border);
    }

    .qx-rstat {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: .75rem .5rem;
        gap: .15rem;
    }

    .qx-rstat + .qx-rstat {
        border-inline-start: 1px solid var(--qx-border);
    }

    .qx-rstat--answered  { background: var(--qx-success-light); }
    .qx-rstat--flagged   { background: var(--qx-warning-light); }
    .qx-rstat--unanswered { background: var(--qx-neutral-light); }

    .qx-rstat__num {
        font-size: 1.5rem;
        font-weight: 800;
        line-height: 1;
    }

    .qx-rstat--answered  .qx-rstat__num { color: var(--qx-success); }
    .qx-rstat--flagged   .qx-rstat__num { color: var(--qx-warning); }
    .qx-rstat--unanswered .qx-rstat__num { color: var(--qx-neutral); }

    .qx-rstat__lbl {
        font-size: .72rem;
        font-weight: 600;
        color: var(--qx-text-muted);
        text-align: center;
    }

    /* Grid of question buttons */
    .qx-q-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: .55rem;
        padding: .5rem 1.25rem 1.25rem;
    }

    /* Circular buttons — classes review-btn-circle and review-jump still used by JS */
    .review-btn-circle {
        width: 44px;
        height: 44px;
        border-radius: 50% !important;
        padding: 0 !important;
        display: flex !important;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: .82rem;
        line-height: 1;
        transition: transform .15s ease, box-shadow .15s ease;
        position: relative;
        flex-shrink: 0;
        border-width: 2px !important;
    }

    .review-btn-circle:hover {
        transform: scale(1.15);
        box-shadow: 0 4px 16px rgba(0,0,0,.18);
        z-index: 1;
    }

    /* Current question highlight (review-btn--current used by JS) */
    .review-btn--current {
        outline: 3px solid var(--qx-primary) !important;
        outline-offset: 3px;
    }

    /* Legend */
    .qx-legend {
        display: flex;
        justify-content: center;
        gap: 1.25rem;
        flex-wrap: wrap;
        padding: 0 1.5rem .9rem;
        font-size: .75rem;
        color: var(--qx-text-muted);
        font-weight: 600;
    }

    .qx-legend__item {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
    }

    .qx-legend__dot {
        width: 11px;
        height: 11px;
