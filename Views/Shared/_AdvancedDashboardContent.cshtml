@* ══════════════════════════════════════════════════════════════════════
   SCRIPTS — Lesson Pagination
   ══════════════════════════════════════════════════════════════════════ *@
<script>
    let lessonCurrentPage = 1;
    const lessonPageSize  = @lessonPageSize;
    const lessonTotalRows = @lessonRows.Count;
    const lessonTotalPages = Math.max(1, Math.ceil(lessonTotalRows / lessonPageSize));

    function renderLessonPage() {
        const rows = document.querySelectorAll(".lesson-page-row");
        const startIndex = (lessonCurrentPage - 1) * lessonPageSize + 1;
        const endIndex   = Math.min(lessonCurrentPage * lessonPageSize, lessonTotalRows);

        rows.forEach(row => {
            const idx = parseInt(row.getAttribute("data-row-index"));
            row.style.display = (idx >= startIndex && idx <= endIndex) ? "" : "none";
        });

        const get = id => document.getElementById(id);
        if (get("lessonCurrentPage")) get("lessonCurrentPage").textContent = lessonCurrentPage;
        if (get("lessonTotalPages"))  get("lessonTotalPages").textContent  = lessonTotalPages;
        if (get("lessonPageFrom"))    get("lessonPageFrom").textContent    = lessonTotalRows === 0 ? 0 : startIndex;
        if (get("lessonPageTo"))      get("lessonPageTo").textContent      = endIndex;
        if (get("lessonPrevBtn"))     get("lessonPrevBtn").disabled        = lessonCurrentPage <= 1;
        if (get("lessonNextBtn"))     get("lessonNextBtn").disabled        = lessonCurrentPage >= lessonTotalPages;
    }

    function changeLessonPage(direction) {
        const next = lessonCurrentPage + direction;
        if (next < 1 || next > lessonTotalPages) return;
        lessonCurrentPage = next;
        renderLessonPage();
    }

    document.addEventListener("DOMContentLoaded", renderLessonPage);
</script>

@* ══════════════════════════════════════════════════════════════════════
   SCRIPTS — Bulk Actions + Toast System
   ══════════════════════════════════════════════════════════════════════ *@
<script>
(function () {
    if (!document.getElementById('qd-toast-wrap')) {
        const wrap = document.createElement('div');
        wrap.id = 'qd-toast-wrap';
        wrap.style.cssText = 'position:fixed;bottom:20px;left:20px;z-index:9999;display:flex;flex-direction:column;gap:8px;pointer-events:none;';
        document.body.appendChild(wrap);
    }

    window.showQdToast = function (msg, type = 'success') {
        const wrap   = document.getElementById('qd-toast-wrap');
        const colors = { success:'#16a34a', danger:'#dc2626', warning:'#d97706', info:'#0891b2' };
        const icons  = { success:'bi-check-circle-fill', danger:'bi-x-octagon-fill', warning:'bi-exclamation-triangle-fill', info:'bi-info-circle-fill' };
        const toast  = document.createElement('div');
        toast.style.cssText = `background:#fff;border-radius:12px;padding:14px 18px;box-shadow:0 8px 24px rgba(0,0,0,.12);display:flex;align-items:center;gap:10px;min-width:280px;pointer-events:all;border-right:4px solid ${colors[type]};font-family:inherit;direction:rtl;animation:toast-in .25s ease;`;
        toast.innerHTML = `<i class="bi ${icons[type]}" style="color:${colors[type]};font-size:20px;flex-shrink:0"></i><span style="font-size:14px;font-weight:700;flex:1">${msg}</span><button onclick="this.closest('div').remove()" style="border:none;background:none;cursor:pointer;color:#9ca3af;font-size:16px;line-height:1;padding:0;">&times;</button>`;
        wrap.appendChild(toast);
        setTimeout(() => {
            toast.style.animation = 'toast-out .25s ease forwards';
            setTimeout(() => toast.remove(), 250);
        }, 4000);
    };

    window.setButtonLoading = function (btn, loading) {
        if (loading) {
            btn.dataset.originalText = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>جاري...';
            btn.disabled = true;
        } else {
            btn.innerHTML = btn.dataset.originalText || btn.innerHTML;
            btn.disabled = false;
        }
    };

    window.qdConfirm = function (msg) {
        return new Promise(resolve => {
            const modal = document.createElement('div');
            modal.innerHTML = `
                <div style="position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:10000;display:flex;align-items:center;justify-content:center;direction:rtl;">
                    <div style="background:#fff;border-radius:16px;padding:28px;max-width:380px;width:calc(100% - 32px);box-shadow:0 20px 60px rgba(0,0,0,.2);">
                        <div style="font-size:17px;font-weight:800;margin-bottom:12px;color:#111827;">تأكيد الإجراء</div>
                        <p style="color:#6b7280;margin-bottom:20px;font-size:15px;">${msg}</p>
                        <div style="display:flex;gap:10px;justify-content:flex-end;">
                            <button id="qd-cancel-btn" style="padding:9px 20px;border-radius:8px;border:1px solid #e5e7eb;background:#f9fafb;cursor:pointer;font-weight:700;font-family:inherit;">إلغاء</button>
                            <button id="qd-confirm-btn" style="padding:9px 20px;border-radius:8px;border:none;background:#dc2626;color:#fff;cursor:pointer;font-weight:700;font-family:inherit;">تأكيد</button>
                        </div>
                    </div>
                </div>`;
            document.body.appendChild(modal);
            modal.querySelector('#qd-confirm-btn').onclick = () => { modal.remove(); resolve(true); };
            modal.querySelector('#qd-cancel-btn').onclick  = () => { modal.remove(); resolve(false); };
        });
    };

    function getFilterParams() {
        const get = id => document.getElementById(id)?.value || '';
        return new URLSearchParams({
            curriculumId: get('curriculumId'),
            batchId:      get('batchId'),
            instructorId: get('instructorId')
        });
    }

    async function postAction(btn, confirmMsg, url) {
        const ok = await qdConfirm(confirmMsg);
        if (!ok) return;
        setButtonLoading(btn, true);
        try {
            const res  = await fetch(url, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
                body:   getFilterParams()
            });
            const data = await res.json();
            if (data.success) showQdToast(data.message || 'تم تنفيذ الإجراء بنجاح', 'success');
            else              showQdToast(data.error   || 'حدث خطأ أثناء التنفيذ', 'danger');
        } catch {
            showQdToast('فشل الاتصال بالخادم', 'danger');
        } finally {
            setButtonLoading(btn, false);
        }
    }

    window.handleSendNotification = btn => postAction(btn, 'سيتم إرسال إشعار لجميع الطلاب ذوي الأولوية العالية في الدفعة المحددة. هل تريد المتابعة؟', '/Admin/Analytics/SendBulkNotification');
    window.handleScheduleSession  = btn => postAction(btn, 'سيتم إنشاء جلسة تحليل مجدولة للدفعة المحددة ومدربيها. هل تريد المتابعة؟', '/Admin/Analytics/ScheduleAnalyticsSession');
    window.handleAssignInstructor = btn => postAction(btn, 'سيتم تعيين مدرب لمتابعة الحالات الحرجة في الدفعة المحددة. هل تريد المتابعة؟', '/Admin/Analytics/AssignAnalyticsInstructor');
})();
</script>

@* ═══════════════════════════════════════════════════════════════════
   OFFCANVAS 1 — إجمالي الدفعات
   ═══════════════════════════════════════════════════════════════════ *@
<div class="offcanvas offcanvas-end qd-offcanvas" tabindex="-1" id="batchesOffcanvas" aria-labelledby="batchesOffcanvasLabel" data-bs-scroll="true">
    <div class="offcanvas-header" style="background:linear-gradient(135deg,#1e3a8a,#1e40af)">
        <div>
            <h5 class="offcanvas-title" id="batchesOffcanvasLabel" style="font-size:17px;font-weight:800">
                <i class="bi bi-layers-fill me-2"></i> إجمالي الدفعات
            </h5>
            <div style="font-size:13px;opacity:.8;margin-top:3px">@(Model?.TotalBatches ?? 0) دفعة نشطة في النظام</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div class="qd-oc-summary">
            <button type="button" class="qd-badge badge-danger qd-risk-filter-btn"
                    data-risk="High" onclick="qdFilterBatchRisk('High', this)"
                    style="cursor:pointer;border:none;font-family:inherit;">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>خطر عالي: @(Model?.RiskHigh ?? 0)
            </button>
            <button type="button" class="qd-badge badge-warning qd-risk-filter-btn"
                    data-risk="Medium" onclick="qdFilterBatchRisk('Medium', this)"
                    style="cursor:pointer;border:none;font-family:inherit;">
                <i class="bi bi-dash-circle-fill me-1"></i>متوسط: @(Model?.RiskMedium ?? 0)
            </button>
            <button type="button" class="qd-badge badge-success qd-risk-filter-btn"
                    data-risk="Low" onclick="qdFilterBatchRisk('Low', this)"
                    style="cursor:pointer;border:none;font-family:inherit;">
                <i class="bi bi-check-circle-fill me-1"></i>جيد: @(Model?.RiskLow ?? 0)
            </button>
        </div>
        <div class="qd-oc-list">
            @if (Model?.Batches == null || !Model.Batches.Any())
            {
                <div class="qd-empty">
                    <i class="bi bi-layers"></i>
                    <div class="qd-empty-title">لا توجد دفعات</div>
                    <div class="qd-empty-sub">لم يتم إضافة دفعات بعد</div>
                </div>
            }
            else
            {
                @foreach (var batch in Model.Batches)
                {
                    var bRisk = batch.RiskLevel == "High" ? "badge-danger" : batch.RiskLevel == "Medium" ? "badge-warning" : "badge-success";
                    var bRiskLabel = batch.RiskLevel == "High" ? "خطر عالي" : batch.RiskLevel == "Medium" ? "متوسط" : "جيد";
                    Model.DecisionStatusMap.TryGetValue(batch.BatchId, out var batchDecision);
                    <div class="qd-oc-item" data-batch-risk="@batch.RiskLevel">
                        <div class="qd-oc-item-title d-flex align-items-center gap-2 flex-wrap">
                            @batch.BatchName
                            @if (batchDecision != null && batchDecision.StatusLabel != "لا قرار")
                            {
                                <span class="badge bg-@batchDecision.StatusCssClass" style="font-size:10px;font-weight:700;">@batchDecision.StatusLabel</span>
                            }
                            @if (batchDecision?.HasActiveInterventionTask == true && batchDecision.LatestDecisionAt.HasValue)
                            {
                                var daysSince = (int)(DateTime.Now - batchDecision.LatestDecisionAt.Value).TotalDays;
                                <span class="badge" style="background:#ede9fe;color:#5b21b6;font-size:10px;font-weight:700;"><i class="fas fa-bolt me-1"></i>تدخل جارٍ منذ @daysSince يوم</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(batch.CourseName))
                        { <div class="qd-oc-item-sub"><i class="bi bi-book me-1"></i>@batch.CourseName</div> }
                        <div class="qd-oc-item-stats">
                            <span class="qd-badge @bRisk">@bRiskLabel</span>
                            <span class="qd-badge badge-primary"><i class="bi bi-people-fill me-1"></i>@batch.StudentsCount طالب</span>
                            @if (batch.WeakLessonsCount > 0) { <span class="qd-badge badge-warning"><i class="bi bi-exclamation-diamond me-1"></i>@batch.WeakLessonsCount درس ضعيف</span> }
                            @if (batch.AffectedStudents > 0) { <span class="qd-badge badge-danger"><i class="bi bi-person-fill-exclamation me-1"></i>@batch.AffectedStudents متأثر</span> }
                        </div>
                        @if ((batch.RiskLevel == "High" || batch.RiskLevel == "Medium") && (User.IsInRole("Owner") || User.IsInRole("Developer")))
                        {
                            var batchBridgeCtx = new AnalyticsDecisionBridgeContext { BatchId = batch.BatchId, CurriculumId = Model.SelectedCurriculumId, InstructorId = Model.SelectedInstructorId, SourceMetric = batch.RiskLevel == "High" ? "high-risk-batch" : "medium-risk-batch", SourcePage = "AdvancedDashboard", ReturnUrl = Url.Action("AdvancedDashboard","Analytics",new{area="Admin",curriculumId=Model.SelectedCurriculumId,batchId=batch.BatchId,instructorId=Model.SelectedInstructorId})??"" };
                            var batchDashUrl = Url.Action("AdvancedDashboard","Analytics",new{area="Admin",batchId=batch.BatchId,curriculumId=Model.SelectedCurriculumId,instructorId=Model.SelectedInstructorId})??"#";
                            var btnColor = batch.RiskLevel == "High" ? "var(--q-danger)" : "var(--q-warning)";
                            <div class="mt-2 d-flex gap-2 flex-wrap">
                                <a href="@batchDashUrl" class="qd-nav-btn" style="font-size:12px;padding:4px 10px;background:@btnColor;color:#fff;border-color:@btnColor;text-decoration:none;"><i class="bi bi-lightning-charge-fill"></i> اتخذ قراراً لهذه الدفعة</a>
                                <a href="@Url.ToBatchAnalysisUrl(batchBridgeCtx)" class="qd-nav-btn qd-nav-btn-secondary" style="font-size:12px;padding:4px 10px;text-decoration:none;"><i class="bi bi-bar-chart-line"></i> تحليل الدفعة</a>
                            </div>
                        }
                    </div>
                }
            }
        </div>
        <div class="qd-oc-footer">
            <button type="button" class="qd-nav-btn qd-nav-btn-ghost" data-bs-dismiss="offcanvas"><i class="bi bi-x-lg"></i> إغلاق</button>
            <a class="qd-nav-btn qd-nav-btn-secondary" asp-area="Admin" asp-controller="Analytics" asp-action="MetricDecisionDetails" asp-route-metric="total-batches" asp-route-curriculumId="@Model?.SelectedCurriculumId" asp-route-batchId="@Model?.SelectedBatchId" asp-route-instructorId="@Model?.SelectedInstructorId"><i class="bi bi-graph-up"></i> تحليل القرار</a>
            <a class="qd-nav-btn qd-nav-btn-primary" asp-area="Admin" asp-controller="Analytics" asp-action="AdvancedDashboard" asp-route-curriculumId="@Model?.SelectedCurriculumId" asp-route-batchId="@Model?.SelectedBatchId" asp-route-instructorId="@Model?.SelectedInstructorId"><i class="bi bi-bar-chart-fill"></i> لوحة التحليلات</a>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════════
   OFFCANVAS 2 — المدربون النشطون
   ═══════════════════════════════════════════════════════════════════ *@
<div class="offcanvas offcanvas-end qd-offcanvas" tabindex="-1" id="instructorsOffcanvas" aria-labelledby="instructorsOffcanvasLabel" data-bs-scroll="true">
    <div class="offcanvas-header" style="background:linear-gradient(135deg,#164e63,#0891b2)">
        <div>
            <h5 class="offcanvas-title" id="instructorsOffcanvasLabel" style="font-size:17px;font-weight:800"><i class="bi bi-person-badge-fill me-2"></i> المدربون النشطون</h5>
            <div style="font-size:13px;opacity:.8;margin-top:3px">@(Model?.TotalInstructors ?? 0) مدرب مرتبط بدفعات</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div class="qd-oc-list">
            @if (Model?.Instructors == null || !Model.Instructors.Any())
            {
                <div class="qd-empty"><i class="bi bi-person-badge"></i><div class="qd-empty-title">لا يوجد مدربون</div><div class="qd-empty-sub">لم يتم تعيين مدربين بعد</div></div>
            }
            else
            {
                @foreach (var instr in Model.Instructors)
                {
                    var iRisk = instr.RiskLevel == "High" ? "badge-danger" : instr.RiskLevel == "Medium" ? "badge-warning" : "badge-success";
                    var iRiskLabel = instr.RiskLevel == "High" ? "خطر عالي" : instr.RiskLevel == "Medium" ? "متوسط" : "جيد";
                    var scoreColor = instr.AvgScore >= 70 ? "var(--q-success)" : instr.AvgScore >= 50 ? "var(--q-warning)" : "var(--q-danger)";
                    <div class="qd-oc-item">
                        <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
                            <div><div class="qd-oc-item-title">@instr.InstructorName</div><div class="qd-oc-item-sub"><i class="bi bi-layers me-1"></i>@instr.BatchesCount دفعة</div></div>
                            <div style="font-size:22px;font-weight:900;color:@scoreColor;flex-shrink:0">@Math.Round(instr.AvgScore)%</div>
                        </div>
                        <div class="qd-oc-item-stats">
                            <span class="qd-badge @iRisk">@iRiskLabel</span>
                            @if (instr.WeakLessonsCount > 0) { <span class="qd-badge badge-warning"><i class="bi bi-exclamation-diamond me-1"></i>@instr.WeakLessonsCount درس ضعيف</span> }
                            else { <span class="qd-badge badge-success"><i class="bi bi-check2-circle me-1"></i>لا دروس ضعيفة</span> }
                        </div>
                    </div>
                }
            }
        </div>
        <div class="qd-oc-footer">
            <button type="button" class="qd-nav-btn qd-nav-btn-ghost" data-bs-dismiss="offcanvas"><i class="bi bi-x-lg"></i> إغلاق</button>
            <a class="qd-nav-btn qd-nav-btn-secondary" asp-area="Admin" asp-controller="Analytics" asp-action="MetricDecisionDetails" asp-route-metric="total-instructors" asp-route-curriculumId="@Model?.SelectedCurriculumId" asp-route-batchId="@Model?.SelectedBatchId" asp-route-instructorId="@Model?.SelectedInstructorId"><i class="bi bi-graph-up"></i> تحليل القرار</a>
            <a class="qd-nav-btn qd-nav-btn-primary" asp-area="Admin" asp-controller="Analytics" asp-action="AdvancedDashboard" asp-route-curriculumId="@Model?.SelectedCurriculumId" asp-route-batchId="@Model?.SelectedBatchId" asp-route-instructorId="@Model?.SelectedInstructorId"><i class="bi bi-bar-chart-fill"></i> لوحة التحليلات</a>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════════
   OFFCANVAS 3 — الطلاب المحللون
   ═══════════════════════════════════════════════════════════════════ *@
@{
    var allStudents    = Model?.Students ?? new List<QdratNew.ViewModels.Admin.Analytics.StudentAnalyticsVM>();
    var ocExcellent    = allStudents.Count(s => s.Priority == "Low"  || (s.ExamScore >= 70 && s.HomeworkScore >= 70));
    var ocMedium       = allStudents.Count(s => s.Priority == "Medium");
    var ocWeak         = allStudents.Count(s => s.Priority == "High");
    var criticalStudents = allStudents.Where(s => s.Priority == "High").OrderBy(s => s.ExamScore).ToList();
}
<div class="offcanvas offcanvas-end qd-offcanvas" tabindex="-1" id="studentsAnalyticsOffcanvas" aria-labelledby="studentsAnalyticsOffcanvasLabel" data-bs-scroll="true">
    <div class="offcanvas-header" style="background:linear-gradient(135deg,#92400e,#d97706)">
        <div>
            <h5 class="offcanvas-title" id="studentsAnalyticsOffcanvasLabel" style="font-size:17px;font-weight:800"><i class="bi bi-people-fill me-2"></i> الطلاب المحللون</h5>
            <div style="font-size:13px;opacity:.8;margin-top:3px">@allStudents.Count طالب لديهم مؤشرات أداء</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div class="qd-oc-summary">
            <span class="qd-badge badge-success"><i class="bi bi-star-fill me-1"></i>ممتاز: @ocExcellent</span>
            <span class="qd-badge badge-warning"><i class="bi bi-dash-circle me-1"></i>متوسط: @ocMedium</span>
            <span class="qd-badge badge-danger"><i class="bi bi-arrow-down-circle-fill me-1"></i>ضعيف: @ocWeak</span>
        </div>
        <div class="qd-oc-list">
            @if (!allStudents.Any())
            {
                <div class="qd-empty"><i class="bi bi-people"></i><div class="qd-empty-title">لا يوجد طلاب محللون</div><div class="qd-empty-sub">لم يتم تسجيل محاولات بعد</div></div>
            }
            else
            {
                @foreach (var st in allStudents.OrderBy(s => s.ExamScore))
                {
                    var stBadge = st.Priority == "High" ? "badge-danger" : st.Priority == "Medium" ? "badge-warning" : "badge-success";
                    var stLabel = st.Priority == "High" ? "أولوية عالية" : st.Priority == "Medium" ? "متوسط" : "جيد";
                    var examColor = st.ExamScore >= 70 ? "var(--q-success)" : st.ExamScore >= 50 ? "var(--q-warning)" : "var(--q-danger)";
                    <div class="qd-oc-item">
                        <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
                            <div style="flex:1;min-width:0"><div class="qd-oc-item-title">@st.StudentName</div>@if (!string.IsNullOrEmpty(st.WeakReason)) { <div class="qd-oc-item-sub"><i class="bi bi-exclamation-circle me-1"></i>@st.WeakReason</div> }</div>
                            <div style="font-size:20px;font-weight:900;color:@examColor;flex-shrink:0">@Math.Round(st.ExamScore)%</div>
                        </div>
                        <div class="qd-oc-item-stats">
                            <span class="qd-badge @stBadge">@stLabel</span>
                            <span class="qd-badge badge-primary"><i class="bi bi-journal-check me-1"></i>واجبات: @Math.Round(st.HomeworkScore)%</span>
                            <span class="qd-badge badge-info"><i class="bi bi-calendar2-check me-1"></i>حضور: @Math.Round(st.Attendance)%</span>
                        </div>
                        @if (st.BatchId.HasValue && (User.IsInRole("Owner") || User.IsInRole("Developer")))
                        {
                            var stBridgeCtx = new AnalyticsDecisionBridgeContext { BatchId = st.BatchId, CurriculumId = Model.SelectedCurriculumId, SourceMetric = "student-weak-" + st.Priority.ToLower(), SourcePage = "AdvancedDashboard", ReturnUrl = Url.Action("AdvancedDashboard","Analytics",new{area="Admin",curriculumId=Model.SelectedCurriculumId,batchId=Model.SelectedBatchId,instructorId=Model.SelectedInstructorId})??"" };
                            <div class="mt-2"><a href="@Url.ToDecisionLabUrl(stBridgeCtx)" class="qd-nav-btn" style="font-size:11px;padding:3px 9px;background:var(--q-primary);color:#fff;border-color:var(--q-primary);text-decoration:none;"><i class="bi bi-lightning-charge-fill"></i> اتخذ قراراً للدفعة</a></div>
                        }
                    </div>
                }
            }
        </div>
        <div class="qd-oc-footer">
            <button type="button" class="qd-nav-btn qd-nav-btn-ghost" data-bs-dismiss="offcanvas"><i class="bi bi-x-lg"></i> إغلاق</button>
            <a class="qd-nav-btn qd-nav-btn-secondary" asp-area="Admin" asp-controller="Analytics" asp-action="MetricDecisionDetails" asp-route-metric="analyzed-students" asp-route-curriculumId="@Model?.SelectedCurriculumId" asp-route-batchId="@Model?.SelectedBatchId" asp-route-instructorId="@Model?.SelectedInstructorId"><i class="bi bi-graph-up"></i> تحليل القرار</a>
            <a class="qd-nav-btn qd-nav-btn-primary" asp-area="Admin" asp-controller="Analytics" asp-action="AnalyzedStudentsDetails" asp-route-curriculumId="@Model?.SelectedCurriculumId" asp-route-batchId="@Model?.SelectedBatchId" asp-route-instructorId="@Model?.SelectedInstructorId"><i class="bi bi-people-fill"></i> تفاصيل الطلاب</a>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════════
   OFFCANVAS 4 — حالات أولوية عالية
   ═══════════════════════════════════════════════════════════════════ *@
<div class="offcanvas offcanvas-end qd-offcanvas" tabindex="-1" id="criticalOffcanvas" aria-labelledby="criticalOffcanvasLabel" data-bs-scroll="true">
    <div class="offcanvas-header" style="background:linear-gradient(135deg,#7f1d1d,#dc2626)">
        <div>
            <h5 class="offcanvas-title" id="criticalOffcanvasLabel" style="font-size:17px;font-weight:800"><i class="bi bi-person-fill-exclamation me-2"></i> حالات أولوية عالية</h5>
            <div style="font-size:13px;opacity:.8;margin-top:3px">@(Model?.CriticalCases ?? 0) حالة تحتاج تدخل فوري</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div class="qd-oc-list">
            @if (!criticalStudents.Any())
            {
                <div class="qd-empty"><i class="bi bi-shield-check" style="color:var(--q-success);opacity:.6"></i><div class="qd-empty-title" style="color:var(--q-success)">لا توجد حالات حرجة</div><div class="qd-empty-sub">جميع الطلاب في وضع مقبول</div></div>
            }
            else
            {
                @foreach (var cs in criticalStudents)
                {
                    var examCol = cs.ExamScore >= 50 ? "var(--q-warning)" : "var(--q-danger)";
                    <div class="qd-oc-item" style="border-right:4px solid var(--q-danger)">
                        <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
                            <div style="flex:1;min-width:0"><div class="qd-oc-item-title">@cs.StudentName</div>@if (!string.IsNullOrEmpty(cs.WeakReason)) { <div class="qd-oc-item-sub"><i class="bi bi-exclamation-circle me-1" style="color:var(--q-danger)"></i>@cs.WeakReason</div> }</div>
                            <div style="font-size:20px;font-weight:900;color:@examCol;flex-shrink:0">@Math.Round(cs.ExamScore)%</div>
                        </div>
                        <div class="qd-oc-item-stats">
                            <span class="qd-badge badge-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>أولوية عالية</span>
                            <span class="qd-badge badge-warning"><i class="bi bi-journal-check me-1"></i>واجبات: @Math.Round(cs.HomeworkScore)%</span>
                            <span class="qd-badge badge-info"><i class="bi bi-calendar2-check me-1"></i>حضور: @Math.Round(cs.Attendance)%</span>
                        </div>
                        @if (!string.IsNullOrEmpty(cs.ActionRequired)) { <div style="margin-top:8px;padding:6px 10px;background:var(--q-danger-light);border-radius:6px;font-size:12px;font-weight:700;color:#991b1b"><i class="bi bi-lightning-charge-fill me-1"></i>@cs.ActionRequired</div> }
                        @if (cs.BatchId.HasValue && (User.IsInRole("Owner") || User.IsInRole("Developer")))
                        {
                            var csBridgeCtx = new AnalyticsDecisionBridgeContext { BatchId = cs.BatchId, CurriculumId = Model.SelectedCurriculumId, SourceMetric = "critical-student", SourcePage = "AdvancedDashboard", ReturnUrl = Url.Action("AdvancedDashboard","Analytics",new{area="Admin",curriculumId=Model.SelectedCurriculumId,batchId=Model.SelectedBatchId,instructorId=Model.SelectedInstructorId})??"" };
                            <div class="mt-2 d-flex gap-2 flex-wrap">
                                <a href="@Url.ToDecisionLabUrl(csBridgeCtx)" class="qd-nav-btn" style="font-size:11px;padding:3px 9px;background:var(--q-danger);color:#fff;border-color:var(--q-danger);text-decoration:none;"><i class="bi bi-lightning-charge-fill"></i> اتخذ قراراً فورياً</a>
                                <a href="@Url.ToBatchAnalysisUrl(csBridgeCtx)" class="qd-nav-btn qd-nav-btn-secondary" style="font-size:11px;padding:3px 9px;text-decoration:none;"><i class="bi bi-bar-chart-line"></i> تحليل الدفعة</a>
                            </div>
                        }
                    </div>
                }
            }
        </div>
        <div class="qd-oc-footer">
            <button type="button" class="qd-nav-btn qd-nav-btn-ghost" data-bs-dismiss="offcanvas"><i class="bi bi-x-lg"></i> إغلاق</button>
            <a class="qd-nav-btn qd-nav-btn-secondary" asp-area="Admin" asp-controller="Analytics" asp-action="MetricDecisionDetails" asp-route-metric="critical-cases" asp-route-curriculumId="@Model?.SelectedCurriculumId" asp-route-batchId="@Model?.SelectedBatchId" asp-route-instructorId="@Model?.SelectedInstructorId"><i class="bi bi-graph-up"></i> تحليل القرار</a>
            <a class="qd-nav-btn qd-nav-btn-primary" asp-area="Admin" asp-controller="Analytics" asp-action="CriticalStudentsDetails" asp-route-curriculumId="@Model?.SelectedCurriculumId" asp-route-batchId="@Model?.SelectedBatchId" asp-route-instructorId="@Model?.SelectedInstructorId"><i class="bi bi-person-fill-exclamation"></i> تفاصيل الحالات</a>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════════
   OFFCANVAS 5 — دروس عالية الخطورة
   ═══════════════════════════════════════════════════════════════════ *@
@{
    var highRiskLessons = (Model?.Lessons ?? new List<QdratNew.ViewModels.Admin.Analytics.LessonAnalyticsVM>())
        .Where(l => l.WeakPercentage >= 70).OrderByDescending(l => l.WeakPercentage).ToList();
}
<div class="offcanvas offcanvas-end qd-offcanvas" tabindex="-1" id="highRiskOffcanvas" aria-labelledby="highRiskOffcanvasLabel" data-bs-scroll="true">
    <div class="offcanvas-header" style="background:linear-gradient(135deg,#7f1d1d,#b91c1c)">
        <div>
            <h5 class="offcanvas-title" id="highRiskOffcanvasLabel" style="font-size:17px;font-weight:800"><i class="bi bi-exclamation-diamond-fill me-2"></i> دروس عالية الخطورة</h5>
            <div style="font-size:13px;opacity:.8;margin-top:3px">@(Model?.HighRiskCount ?? 0) درس بنسبة ضعف ≥ 70%</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div class="qd-oc-summary">
            <span class="qd-badge badge-danger"><i class="bi bi-exclamation-diamond-fill me-1"></i>خطر عالي ≥ 70%: @highRiskLessons.Count</span>
            <span class="qd-badge badge-warning"><i class="bi bi-exclamation-triangle me-1"></i>متوسط 50–69%: @(Model?.Lessons?.Count(l => l.WeakPercentage >= 50 && l.WeakPercentage < 70) ?? 0)</span>
        </div>
        <div class="qd-oc-list">
            @if (!highRiskLessons.Any())
            {
                <div class="qd-empty"><i class="bi bi-shield-check" style="color:var(--q-success);opacity:.6"></i><div class="qd-empty-title" style="color:var(--q-success)">لا توجد دروس عالية الخطورة</div><div class="qd-empty-sub">جميع الدروس ضمن النسب المقبولة</div></div>
            }
            else
            {
                @foreach (var lesson in highRiskLessons)
                {
                    var weakColor = lesson.WeakPercentage >= 85 ? "var(--q-danger)" : "var(--q-warning)";
                    var weakBadge = lesson.WeakPercentage >= 85 ? "badge-danger" : "badge-warning";
                    <div class="qd-oc-item" style="border-right:4px solid @weakColor">
                        <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
                            <div style="flex:1;min-width:0">
                                <div class="qd-oc-item-title">@lesson.LessonName</div>
                                <div class="qd-oc-item-sub">
                                    @if (!string.IsNullOrEmpty(lesson.BatchName)) { <span><i class="bi bi-layers me-1"></i>@lesson.BatchName</span> }
                                    @if (!string.IsNullOrEmpty(lesson.InstructorName)) { <span class="ms-2"><i class="bi bi-person-badge me-1"></i>@lesson.InstructorName</span> }
                                </div>
                            </div>
                            <div style="font-size:20px;font-weight:900;color:@weakColor;flex-shrink:0">@Math.Round(lesson.WeakPercentage)%</div>
                        </div>
                        <div class="qd-oc-item-stats">
                            <span class="qd-badge @weakBadge"><i class="bi bi-arrow-down-circle-fill me-1"></i>نسبة الضعف: @Math.Round(lesson.WeakPercentage)%</span>
                            @if (lesson.AffectedStudents > 0) { <span class="qd-badge badge-primary"><i class="bi bi-people-fill me-1"></i>@lesson.AffectedStudents طالب متأثر</span> }
                            @if (lesson.TotalAttempts > 0)   { <span class="qd-badge badge-info"><i class="bi bi-clipboard-data me-1"></i>@lesson.TotalAttempts محاولة</span> }
                        </div>
                        @if (lesson.BatchId.HasValue && (User.IsInRole("Owner") || User.IsInRole("Developer")))
                        {
                            var lessonBridgeCtx = new AnalyticsDecisionBridgeContext { BatchId = lesson.BatchId, CurriculumId = Model.SelectedCurriculumId, SourceMetric = "high-risk-lesson", SourcePage = "AdvancedDashboard", ReturnUrl = Url.Action("AdvancedDashboard","Analytics",new{area="Admin",curriculumId=Model.SelectedCurriculumId,batchId=Model.SelectedBatchId,instructorId=Model.SelectedInstructorId})??"" };
                            var lessonBtnColor = lesson.WeakPercentage >= 85 ? "var(--q-danger)" : "var(--q-warning)";
                            <div class="mt-2 d-flex gap-2 flex-wrap">
                                <a href="@Url.ToDecisionLabUrl(lessonBridgeCtx)" class="qd-nav-btn" style="font-size:11px;padding:3px 9px;background:@lessonBtnColor;color:#fff;border-color:@lessonBtnColor;text-decoration:none;"><i class="bi bi-lightning-charge-fill"></i> اتخذ قراراً للدفعة</a>
                                <a href="@Url.ToBatchAnalysisUrl(lessonBridgeCtx)" class="qd-nav-btn qd-nav-btn-secondary" style="font-size:11px;padding:3px 9px;text-decoration:none;"><i class="bi bi-bar-chart-line"></i> تحليل الدفعة</a>
                            </div>
                        }
                    </div>
                }
            }
        </div>
        <div class="qd-oc-footer">
            <button type="button" class="qd-nav-btn qd-nav-btn-ghost" data-bs-dismiss="offcanvas"><i class="bi bi-x-lg"></i> إغلاق</button>
            <a class="qd-nav-btn qd-nav-btn-secondary" asp-area="Admin" asp-controller="Analytics" asp-action="MetricDecisionDetails" asp-route-metric="high-risk-lessons" asp-route-curriculumId="@Model?.SelectedCurriculumId" asp-route-batchId="@Model?.SelectedBatchId" asp-route-instructorId="@Model?.SelectedInstructorId"><i class="bi bi-graph-up"></i> تحليل القرار</a>
            <a class="qd-nav-btn qd-nav-btn-primary" asp-area="Admin" asp-controller="Analytics" asp-action="AdvancedDashboard" asp-route-curriculumId="@Model?.SelectedCurriculumId" asp-route-batchId="@Model?.SelectedBatchId" asp-route-instructorId="@Model?.SelectedInstructorId"><i class="bi bi-bar-chart-fill"></i> لوحة التحليلات</a>
        </div>
    </div>
</div>

<script>
(function () {
    'use strict';

    /* ── Batch Risk Filter (badges inside #batchesOffcanvas) ── */
    window.qdFilterBatchRisk = function (risk, btn) {
        var list   = document.querySelector('#batchesOffcanvas .qd-oc-list');
        var btns   = document.querySelectorAll('#batchesOffcanvas .qd-risk-filter-btn');
        var items  = list ? list.querySelectorAll('[data-batch-risk]') : [];

        // determine if this button is already active (toggle off = show all)
        var isActive = btn.classList.contains('qdrf-active');

        // reset all button highlights
        btns.forEach(function (b) {
            b.classList.remove('qdrf-active');
            b.style.outline = '';
            b.style.boxShadow = '';
        });

        if (isActive) {
            // second click on the same badge → show all
            items.forEach(function (el) { el.style.display = ''; });
            return;
        }

        // highlight this badge and filter the list
        btn.classList.add('qdrf-active');
        btn.style.outline = '2px solid currentColor';
        btn.style.boxShadow = '0 0 0 3px rgba(0,0,0,.12)';

        items.forEach(function (el) {
            el.style.display = el.getAttribute('data-batch-risk') === risk ? '' : 'none';
        });
    };
})();
</script>
