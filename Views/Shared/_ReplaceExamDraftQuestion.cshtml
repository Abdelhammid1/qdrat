@model QdratNew.ViewModels.Partner.Exam.ReplaceExamDraftQuestionVM

<form asp-action="ConfirmReplaceQuestion" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="draftId" value="@Model.DraftId" />
    <input type="hidden" name="oldQuestionId" value="@Model.OldQuestionId" />

    <div class="modal-header">
        <h5 class="modal-title">🔄 استبدال السؤال</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">

        @if (!Model.Candidates.Any())
        {
            <div class="alert alert-warning">
                لا توجد أسئلة بديلة متاحة في هذا المؤشر.
            </div>
        }
        else
        {
            <div class="list-group">
                @foreach (var q in Model.Candidates)
                {
                    <label class="list-group-item">
                        <input type="radio"
                               name="newQuestionId"
                               value="@q.QuestionId"
                               required />
                        @q.Title
                    </label>
                }
            </div>
        }

    </div>

    <div class="modal-footer">
        <button type="submit" class="btn btn-warning">
            🔄 استبدال
        </button>
    </div>
</form>
