@using Microsoft.AspNetCore.Identity
@using QdratNew.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = string.IsNullOrWhiteSpace(currentUser?.FullName)
        ? currentUser?.UserName
        : currentUser.FullName;

    var avatarPath = !string.IsNullOrEmpty(currentUser?.ProfileImagePath)
        ? currentUser.ProfileImagePath
        : "/images/avatar-male.png"; // صورة افتراضية
}

@if (SignInManager.IsSignedIn(User))
{
    <div class="d-flex align-items-center gap-3">

        <span class="text-success fw-bold">مرحبًا، @displayName</span>
        <img src="@avatarPath" alt="الصورة" class="rounded-circle" style="width: 45px; height: 45px; object-fit: cover; border: 1px solid #ccc;" />

        <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index")" class="d-inline">
            <button type="submit" class="btn btn-sm btn-outline-danger">
                <i class="fas fa-sign-out-alt me-1"></i> خروج
            </button>
        </form>

    </div>
}
else
{
    <div class="d-flex align-items-center gap-3">
        <a href="/LMS/login" class="btn btn-sm btn-outline-primary">تسجيل الدخول</a>
@*         <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-sm btn-outline-success">مستخدم جديد</a>
 *@    </div>
}
