<!-- ═══════════════════ Change Photo Modal ═══════════════════ -->
<div class="photo-modal-backdrop" id="photoModal" onclick="handleModalBackdropClick(event)">
    <div class="photo-modal-card" role="dialog" aria-modal="true" aria-labelledby="photoModalTitle">

        <div class="photo-modal-header">
            <div class="photo-modal-title" id="photoModalTitle">
                <i class="fas fa-camera"></i>
                تغيير صورة الملف الشخصي
            </div>
            <button class="photo-modal-close" onclick="closePhotoModal()" aria-label="إغلاق">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="photo-preview-area">
            <img src="@(account?.ProfileImageUrl ?? "/images/default-avatar.png")"
                 id="photoPreviewImg"
                 class="photo-preview-img"
                 alt="معاينة الصورة" />
            <div class="photo-preview-label">الصورة الحالية</div>
        </div>

        <form id="changePhotoForm"
              method="post"
              enctype="multipart/form-data"
              asp-controller="Profile"
              asp-action="UpdatePhoto"
              asp-area="">
            @Html.AntiForgeryToken()

            <div class="drop-zone" id="dropZone" onclick="triggerFileInput()">
                <i class="fas fa-cloud-upload-alt drop-zone-icon"></i>
                <div class="drop-zone-text">اضغط أو اسحب صورتك هنا</div>
                <div class="drop-zone-hint">PNG، JPG، WEBP — حتى 5 ميغابايت</div>
            </div>

            <input type="file"
                   id="photoFileInput"
                   name="photo"
                   accept="image/png,image/jpeg,image/webp"
                   style="display:none;"
                   onchange="handlePhotoSelect(this)" />

            <div class="photo-modal-actions">
                <button type="submit" class="btn-save-photo">
                    <i class="fas fa-save"></i>
                    حفظ الصورة
                </button>
                <button type="button" class="btn-cancel-photo" onclick="closePhotoModal()">
                    إلغاء
                </button>
            </div>
        </form>

    </div>
</div>


<script>
    /* ── Photo Modal ── */
    function openPhotoModal() {
        document.getElementById('photoModal').classList.add('open');
        document.body.style.overflow = 'hidden';
    }

    function closePhotoModal() {
        document.getElementById('photoModal').classList.remove('open');
        document.body.style.overflow = '';
    }

    function handleModalBackdropClick(e) {
        if (e.target === document.getElementById('photoModal')) closePhotoModal();
    }

    function triggerFileInput() {
        document.getElementById('photoFileInput').click();
    }

    function handlePhotoSelect(input) {
        if (!input.files || !input.files[0]) return;
        const file = input.files[0];
        const reader = new FileReader();
        reader.onload = function (e) {
            document.getElementById('photoPreviewImg').src = e.target.result;
            document.getElementById('sidebarAvatar').src = e.target.result;
            const dz = document.getElementById('dropZone');
            dz.style.borderColor = '#4CA6A8';
            dz.style.background  = '#F0FAFA';
            dz.querySelector('.drop-zone-text').textContent = file.name;
        };
        reader.readAsDataURL(file);
    }

    /* Drag-over effect */
    (function () {
        const dz = document.getElementById('dropZone');
        if (!dz) return;
        dz.addEventListener('dragover', function (e) {
            e.preventDefault();
            dz.classList.add('drag-over');
        });
        dz.addEventListener('dragleave', function () {
            dz.classList.remove('drag-over');
        });
        dz.addEventListener('drop', function (e) {
            e.preventDefault();
            dz.classList.remove('drag-over');
            const input = document.getElementById('photoFileInput');
            input.files = e.dataTransfer.files;
            handlePhotoSelect(input);
        });
    })();

    /* ── Collapse arrow sync ── */
    document.querySelectorAll('.nav-collapse-btn').forEach(function (btn) {
        const targetSelector = btn.getAttribute('data-bs-target');
        if (!targetSelector) return;
        const panel = document.querySelector(targetSelector);
        if (!panel) return;

        panel.addEventListener('show.bs.collapse',  function () { btn.classList.add('open');    });
        panel.addEventListener('hide.bs.collapse',  function () { btn.classList.remove('open'); });
    });
</script>
