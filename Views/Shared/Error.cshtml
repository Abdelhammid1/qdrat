@model QdratNew.Models.ErrorViewModel
@using Microsoft.AspNetCore.Identity
@inject UserManager<QdratNew.Entities.ApplicationUser> UserManager
@{
    ViewData["Title"] = "حدث خطأ";
    bool isDeveloper = false;

    // ✅ تحديد إذا كان المستخدم الحالي مطور أو من الأدوار العليا
    if (User.Identity?.IsAuthenticated == true)
    {
        var currentUser = await UserManager.GetUserAsync(User);
        var roles = await UserManager.GetRolesAsync(currentUser);
        isDeveloper = roles.Contains("Developer") || roles.Contains("SuperAdmin") || roles.Contains("Owner");
    }

    string errorMessage = Model?.Message ?? "حدث خطأ غير متوقع أثناء معالجة الطلب.";
}

<div class="container mt-5" dir="rtl">
    <div class="card shadow border-0 rounded-4">
        <div class="card-body text-center py-5">

            <!-- 🧭 العنوان -->
            <h1 class="text-danger mb-3 fw-bold">
                <i class="fas fa-exclamation-triangle me-2"></i> عذرًا! حدث خطأ
            </h1>

            <!-- 🟡 الرسالة الموجهة للمستخدم -->
            <p class="lead mb-4 text-muted">
                @errorMessage
            </p>

            @if (Model?.ShowRequestId ?? false)
            {
                <p class="text-muted">
                    <small>رقم التتبع: <code>@Model.RequestId</code></small>
                </p>
            }

            @if (isDeveloper)
            {
                <hr class="my-4" />
                <div class="alert alert-warning text-start" dir="ltr">
                    <h5><i class="fas fa-bug me-2"></i> تفاصيل للمطور</h5>
                    <pre class="text-danger bg-light p-3 rounded-3 border">@errorMessage</pre>
                    <p class="text-muted mt-2">بيئة العمل الحالية: <strong>@Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT")</strong></p>
                    <p><strong>Request ID:</strong> @Model?.RequestId</p>
                </div>
            }
            else
            {
                <div class="alert alert-info mt-4" role="alert">
                    <i class="fas fa-info-circle me-1"></i>
                    تم تسجيل هذا الخطأ وإبلاغ فريق الدعم الفني للتحقق من السبب. يُرجى المحاولة لاحقًا.
                </div>
            }

            <div class="mt-4">
                <a href="javascript:history.back()" class="btn btn-outline-secondary">
                    ⬅️ العودة للصفحة السابقة
                </a>
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary ms-2">
                    🏠 العودة إلى الصفحة الرئيسية
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://kit.fontawesome.com/a2d5c6e6b2.js" crossorigin="anonymous"></script>
}
