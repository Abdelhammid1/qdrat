@model List<QdratNew.ViewModels.Exam.ExamReviewQuestionVm>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning text-center">لا توجد أسئلة في هذا المحور.</div>
    return;
}

<div class="question-buttons d-flex flex-wrap gap-2">
    @foreach (var q in Model)
    {
        <button class="btn btn-outline-primary review-question-btn"
                data-qid="@q.QuestionId">
            سؤال @q.QuestionOrder
        </button>
    }
</div>

<hr />

<div id="review-question-container" class="mt-4">
    <div class="alert alert-info text-center">
        اضغط على أي سؤال لعرضه.
    </div>
</div>
