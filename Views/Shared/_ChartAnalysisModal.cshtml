@model QdratNew.ViewModels.AI.ChartAnalysisInputViewModel

<button class="btn btn-sm btn-outline-secondary float-start"
        data-bs-toggle="modal"
        data-bs-target="#chartAnalysisModal-@Model.ChartId">
    <i class="fas fa-search"></i> تحليل ذكي
</button>

<!-- ✅ Modal التحليل -->
<div class="modal fade" id="chartAnalysisModal-@Model.ChartId" tabindex="-1" aria-labelledby="chartModalLabel-@Model.ChartId" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="chartModalLabel-@Model.ChartId">
                    <i class="fas fa-brain"></i> تحليل الرسم البياني: @Model.Title
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center" id="analysisResult-@Model.ChartId">
                <div class="spinner-border text-primary"></div>
                <p class="mt-2">جاري التحليل...</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modalId = "chartAnalysisModal-@Model.ChartId";
            const resultId = "analysisResult-@Model.ChartId";
            const endpoint = "/Admin/ChartAI/GetInsight";

            document.getElementById(modalId).addEventListener('shown.bs.modal', function () {
                fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title: "@Model.Title", dataPoints: @Html.Raw(Json.Serialize(Model.DataPoints)) })
                })
                .then(res => res.json())
                .then(data => {
                    document.getElementById(resultId).innerHTML = `
                        <p class="text-primary fw-bold"><i class="fas fa-comment-dots"></i> ${data.comment}</p>
                        <p class="text-success fw-bold"><i class="fas fa-lightbulb"></i> ${data.recommendation}</p>
                    `;
                })
                .catch(() => {
                    document.getElementById(resultId).innerHTML = `<p class='text-danger'>⚠️ حدث خطأ أثناء التحليل.</p>`;
                });
            });
        });
    </script>
}
