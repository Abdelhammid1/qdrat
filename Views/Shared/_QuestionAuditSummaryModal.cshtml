@model QdratNew.ViewModels.Question.QuestionAuditSummaryViewModel

@if (Model?.LatestAudit != null)
{
    <div>
        <p><strong>العملية:</strong> @Model.LatestAudit.Action</p>
        <p><strong>منفذ العملية:</strong> @Model.LatestAudit.PerformedByName</p>
        <p><strong>الدور:</strong> @Model.LatestAudit.PerformedByRole</p>
        <p><strong>التاريخ:</strong> @Model.LatestAudit.PerformedAt.ToString("yyyy/MM/dd - hh:mm tt")</p>
        <p><strong>التعديلات:</strong> @Model.LatestAudit.ChangedFieldsSummary</p>
    </div>

    <a asp-action="FullAudit" asp-route-id="@Model.QuestionId"
       target="_blank"
       class="btn btn-sm btn-outline-primary mt-2">
        <i class="fas fa-list"></i> عرض السجل الكامل
    </a>
}
else
{
    <p class="text-danger">❌ لا يوجد تعديلات لهذا السؤال.</p>
}
