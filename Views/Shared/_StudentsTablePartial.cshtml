@model IEnumerable<QdratNew.ViewModels.Partner.StudentListViewModel>

<table class="table table-hover mb-0 text-center align-middle" id="studentsTable">
    <thead class="table-light">
        <tr>
            <th class="col-cb"><input type="checkbox" class="row-cb" id="stSelectAllCb" /></th>
            <th>الاسم</th>
            <th>رقم الهوية</th>
            <th>الحالة</th>
            <th>إجراءات</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-muted py-4">
                    لا توجد نتائج.
                </td>
            </tr>
        }
        else
        {
            @foreach (var s in Model)
            {
                <tr class="student-row" data-id="@s.Id" data-name="@s.FullName" data-active="@s.IsActiveForLearning.ToString().ToLower()">
                    <td class="col-cb">
                        <input type="checkbox" class="row-cb" onclick="event.stopPropagation()" />
                    </td>
                    <td>@s.FullName</td>
                    <td>@s.NationalId</td>
                    <td>
                        @if (s.IsActiveForLearning)
                        {
                            <span class="badge bg-success">نشط</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">موقوف</span>
                        }
                    </td>
                    <td>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-primary dropdown-toggle"
                                    data-bs-toggle="dropdown">
                                إجراءات
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end text-end">
                                <li>
                                    <a class="dropdown-item"
                                       asp-action="Details"
                                       asp-route-id="@s.Id">📄 تفاصيل</a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-action="Edit"
                                       asp-route-id="@s.Id">✏️ تعديل</a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-action="ResetPassword"
                                       asp-route-id="@s.Id">🔐 إعادة تعيين كلمة المرور</a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item text-success fw-semibold"
                                       asp-action="AddToBatch"
                                       asp-route-studentId="@s.Id">
                                        ➕ إلحاق بدفعة
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
