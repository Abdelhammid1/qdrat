@using Microsoft.AspNetCore.Identity
@using QdratNew.Entities
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
    var fullName = currentUser?.FullName ?? "الطالب";
    var profileImage = string.IsNullOrEmpty(currentUser?.ProfileImagePath)
        ? Url.Content("~/images/avatar-male.png")
        : Url.Content(currentUser.ProfileImagePath);
}

<a href="/Students/StudentProfile/Index" class="ql-avatar-wrap text-decoration-none" title="ملفي الشخصي" style="display:flex; align-items:center; gap:12px; padding:16px 14px; border-bottom:1px solid rgba(255,255,255,0.12); flex-shrink:0; overflow:hidden; transition:background .2s;">
    <div style="position:relative; flex-shrink:0;">
        <img src="@profileImage" class="ql-avatar" alt="صورة الطالب" />
        <span style="position:absolute; bottom:0; left:0; width:16px; height:16px; background:#339999; border-radius:50%; border:2px solid rgba(255,255,255,0.3); display:flex; align-items:center; justify-content:center; font-size:0.5rem; color:#fff;">
            <i class="fas fa-pen"></i>
        </span>
    </div>
    <div class="ql-avatar-info">
        <div class="ql-avatar-name">@fullName</div>
        <div class="ql-avatar-badge">
            <i class="fas fa-circle" style="font-size:0.5rem; color:#6ee7b7;"></i>
            ملفي الشخصي
        </div>
    </div>
</a>
