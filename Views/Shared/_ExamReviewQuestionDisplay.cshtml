@model QdratNew.ViewModels.Exam.ExamReviewQuestionVm
@using QdratNew.Helpers

@if (Model == null)
{
    <div class="alert alert-danger text-center">خطأ: لم يتم العثور على السؤال.</div>
    return;
}

<div class="card p-4 shadow-sm" style="border-radius:14px;">

    <!-- 🟦 عنوان السؤال -->
    <h4 class="fw-bold text-qdrat mb-4">
        @Html.Raw(Model.IsQuantitative
                ? NumberHelper.ToIndicNumbersSafe(Model.QuestionTitle)
                : Model.QuestionTitle)
    </h4>

    <!-- 🟣 القطعة -->
    @if (!string.IsNullOrWhiteSpace(Model.VerbalPassageContent))
    {
        <div class="alert alert-info p-3 mb-3">
            @Html.Raw(Model.VerbalPassageContent)
        </div>
    }

    <!-- 🖼 صورة السؤال -->
    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
    {
        <div class="text-center mb-3">
            <img src="@Model.ImageUrl" class="img-fluid rounded shadow-sm" style="max-height:300px;" />
        </div>
    }

    <!-- 🔶 مقارنة نصية -->
    @if (Model.DisplayType == QdratNew.Enums.QuestionDisplayType.ComparisonText)
    {
        <div class="row text-center mb-4">
            <div class="col-md-6 border-end">
                <strong>القيمة الأولى:</strong>
                <div>@Model.ComparisonValue1</div>
            </div>
            <div class="col-md-6">
                <strong>القيمة الثانية:</strong>
                <div>@Model.ComparisonValue2</div>
            </div>
        </div>
    }

    <!-- 🔶 مقارنة بصورة -->
    @if (Model.DisplayType == QdratNew.Enums.QuestionDisplayType.ComparisonWithImage)
    {
        <div class="row text-center mb-4 align-items-center">
            <div class="col-md-4">
                <img src="@Model.ImageUrl" style="max-height:200px;" class="img-fluid rounded shadow-sm" />
            </div>
            <div class="col-md-4 border-end">
                <strong>القيمة الأولى:</strong>
                <div>@Model.ComparisonValue1</div>
            </div>
            <div class="col-md-4">
                <strong>القيمة الثانية:</strong>
                <div>@Model.ComparisonValue2</div>
            </div>
        </div>
    }

    <!-- 🔹 الاختيارات -->
    <div class="mt-3">
        @foreach (var o in Model.Options)
        {
            var cls =
            o.Text == Model.CorrectAnswer ? "choice-correct" :
            o.Text == Model.StudentAnswer ? "choice-wrong" :
            "choice-neutral";

            <div class="choice-item @cls">

                @if (!string.IsNullOrWhiteSpace(o.ImageUrl))
                {
                    <img src="@o.ImageUrl" style="max-height:60px;" />
                }
                else
                {
                    <span>@Html.Raw(o.Text)</span>
                }

                @if (o.Text == Model.CorrectAnswer)
                {
                    <span class="text-success fw-bold">✔</span>
                }
                else if (o.Text == Model.StudentAnswer)
                {
                    <span class="text-danger fw-bold">✖</span>
                }
            </div>
        }
    </div>

    <!-- ⏱ الوقت -->
    <p class="mt-3 text-muted">
        <i class="fa-regular fa-clock"></i>
        الوقت على السؤال: @Model.TimeTakenSeconds ثانية
    </p>

</div>
