@* Overlays الأمنية لصفحة حل الواجب — تُضمَّن في _QuestionStudentLayout أو في View الرئيسي *@

<style>
    .hw-security-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, .72);
        backdrop-filter: blur(6px);
        z-index: 99999;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: hwFadeIn .25s ease;
    }

    .hw-security-overlay.hw-hidden {
        display: none;
    }

    .hw-security-card {
        background: #fff;
        border-radius: 16px;
        padding: 2rem 2.5rem;
        text-align: center;
        max-width: 420px;
        width: 90%;
        box-shadow: 0 20px 60px rgba(0,0,0,.3);
        direction: rtl;
    }

    .hw-security-card .hw-icon {
        font-size: 3rem;
        margin-bottom: .75rem;
    }

    .hw-security-card h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: .5rem;
    }

    .hw-security-card p {
        color: #64748b;
        font-size: .95rem;
        line-height: 1.6;
        margin-bottom: 1.25rem;
    }

    .hw-security-card .hw-btn {
        display: inline-block;
        padding: .65rem 1.75rem;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        font-size: .95rem;
        font-weight: 600;
        transition: opacity .2s;
    }

    .hw-security-card .hw-btn:hover { opacity: .85; }
    .hw-security-card .hw-btn-primary { background: #3b82f6; color: #fff; }
    .hw-security-card .hw-btn-danger  { background: #ef4444; color: #fff; }

    @@keyframes hwFadeIn {
        from { opacity: 0; transform: scale(.96); }
        to   { opacity: 1; transform: scale(1); }
    }

    @@media (prefers-color-scheme: dark) {
        .hw-security-card { background: #1e293b; }
        .hw-security-card h3 { color: #f1f5f9; }
        .hw-security-card p  { color: #94a3b8; }
    }
</style>

<!-- تحذير زر الرجوع -->
<div id="hw-back-warning" class="hw-security-overlay hw-hidden" role="alertdialog" aria-modal="true" aria-labelledby="hwBackTitle">
    <div class="hw-security-card">
        <div class="hw-icon">⚠️</div>
        <h3 id="hwBackTitle">لا يمكن الرجوع</h3>
        <p>لا يُسمح بالرجوع أثناء حل الواجب. ستعود إلى السؤال الحالي تلقائياً.</p>
        <button class="hw-btn hw-btn-primary" onclick="document.getElementById('hw-back-warning').classList.add('hw-hidden')">
            متابعة الحل
        </button>
    </div>
</div>

<!-- تحذير التبويب المكرر -->
<div id="hw-duplicate-warning" class="hw-security-overlay hw-hidden" role="alertdialog" aria-modal="true" aria-labelledby="hwDupTitle">
    <div class="hw-security-card">
        <div class="hw-icon">🚫</div>
        <h3 id="hwDupTitle">تبويب آخر مفتوح</h3>
        <p>تم اكتشاف أن هذا الواجب مفتوح في تبويب آخر. يُرجى إغلاق التبويبات الأخرى للمتابعة.</p>
        <p style="font-size:.82rem; color:#94a3b8;">سيُفعَّل هذا التبويب تلقائياً عند إغلاق الآخر.</p>
    </div>
</div>

<!-- تحذير انتهاء الواجب مسبقاً -->
<div id="hw-submitted-warning" class="hw-security-overlay hw-hidden" role="alertdialog" aria-modal="true" aria-labelledby="hwSubTitle">
    <div class="hw-security-card">
        <div class="hw-icon">✅</div>
        <h3 id="hwSubTitle">الواجب مكتمل</h3>
        <p>لقد قمت بتسليم هذا الواجب مسبقاً ولا يمكن إعادة حله.</p>
        <button class="hw-btn hw-btn-primary"
                onclick="window.location.href='/Students/StudentHomeworkDashboard/Dashboard'">
            الذهاب للوحة التحكم
        </button>
    </div>
</div>
