    <script>
        document.addEventListener("DOMContentLoaded", function () {

            AOS.init({
                duration: 1000,
                once: true,
                offset: 120,
                easing: "ease-in-out"
            });

            // 🔴 هذا السطر هو المفتاح الحقيقي
            setTimeout(function () {
                AOS.refresh();
            }, 300);

