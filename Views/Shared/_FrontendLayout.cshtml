    <style>
        /* ✅ الحاوية العامة لتثبيت التموضع */
        .dropdown-container {
            position: relative;
            display: inline-block;
        }

        /* ✅ القائمة المنبثقة */
        .courses-dropdown {
            position: absolute;
            top: 100%;
            right: 0; /* محاذاة للقائمة من اليمين */
            transform: translateY(10px);
            background: #fff;
            min-width: 420px;
            opacity: 1;
            visibility: hidden;
            transition: all 0.3s ease;
            z-index: 9999;
            box-shadow: 0 8px 24px rgba(0,0,0,0.15);
        }

        /* ✅ عند المرور بالماوس */
        .dropdown-container:hover .courses-dropdown {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        /* ✅ الكروت الصغيرة */
        .course-item {
            width: 115px;
            transition: transform 0.3s ease;
        }

        .course-thumb {
            width: 100%;
            height: 75px;
            object-fit: cover;
            border-radius: 8px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        }

        .course-item:hover {
            transform: translateY(-4px);
        }

        /* ✅ مثلث صغير تحت اللينك */
        .courses-dropdown::before {
            content: "";
            position: absolute;
            top: -10px;
            right: 50px; /* بالضبط تحت كلمة الدورات */
            border-width: 0 8px 10px 8px;
            border-style: solid;
            border-color: transparent transparent #fff transparent;
        }

        @@media (max-width: 768px) {
            .courses-dropdown

        {
            min-width: 100%;
            right: 0;
        }

        .course-item {
            width: 100px;
        }

        }
    </style>
