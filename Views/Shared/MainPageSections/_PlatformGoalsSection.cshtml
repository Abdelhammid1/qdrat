@model QdratNew.ViewModels.Public.HomePage.HomePageContentViewModel

@{
    var goals = Model.PlatformGoals;
}

@if (goals.Any())
{
    <section id="platform-goals" class="py-5 bg-light" style="direction:rtl;">
        <div class="container text-center">
            <h2 class="fw-bold text-qdrat mb-4">أهداف معهد القدرات</h2>
            <p class="text-muted mb-5">نعمل على تمكين طلابنا لتحقيق التميز الأكاديمي والمهني عبر برامج نوعية وشراكات استراتيجية.</p>

            <div class="row g-4">
                @foreach (var goal in goals)
                {
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm p-4 rounded-4 h-100">
                            <div class="icon mb-3 fs-1"><i class="@goal.IconClass" style="color:#da784d;"></i></div>
                            <h5 class="fw-bold text-qdrat">@goal.Title</h5>
                            <p class="text-muted small">@goal.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
