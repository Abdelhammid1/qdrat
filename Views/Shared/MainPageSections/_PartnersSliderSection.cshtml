@model QdratNew.ViewModels.Public.HomePage.HomePageContentViewModel

@{
    var partners = Model.SuccessPartners;
}

@if (partners.Any())
{
    <section id="partners" class="py-5" style="background:#ffffff; direction:rtl;">
        <div class="container text-center">
            <h2 class="fw-bold mb-4 text-qdrat"> شركاؤنا في النجاح</h2>
            <p class="text-muted mb-5">
                نفتخر بشراكتنا مع مؤسسات وطنية كبرى تدعم التطوير والابتكار نحو تحقيق رؤية المملكة 2030.
            </p>

            <div class="row g-4 justify-content-center align-items-center">
                @foreach (var p in partners)
                {
                    <div class="col-6 col-md-4 col-lg-2 fade-logo">
                        @if (!string.IsNullOrEmpty(p.Url))
                        {
                            <a href="@p.Url" target="_blank">
                                <img src="@p.LogoPath" alt="@p.Name" class="partner-logo img-fluid" />
                            </a>
                        }
                        else
                        {
                            <img src="@p.LogoPath" alt="@p.Name" class="partner-logo img-fluid" />
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    <style>
        #partners {
            background-color: #fff;
        }

        .partner-logo {
            height: 90px;
            object-fit: contain;
            filter: grayscale(50%);
            transition: all 0.4s ease;
            opacity: 0.9;
        }

            .partner-logo:hover {
                filter: grayscale(0%);
                transform: scale(1.05);
                opacity: 1;
            }

        /* ✨ تأثير الفيد (الظهور التدريجي) */
        .fade-logo {
            opacity: 0;
            transform: translateY(20px);
            animation: fadeInUp 0.8s ease forwards;
        }

        @@keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 768px) {
            .partner-logo {
                height: 70px;
                margin-bottom: 10px;
            }
        }
    </style>
}
