@using QdratNew.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext _context

@{
    var slides = await _context.HeroSlides
        .Where(s => s.IsActive)
        .OrderBy(s => s.DisplayOrder)
        .ToListAsync();
}

<section id="heroSlider" class="ai-hero position-relative overflow-hidden text-white">
    <div class="slider-wrapper">
        @if (slides.Any())
        {
            int index = 0;
            foreach (var s in slides)
            {
                <div class="hero-slide @(index == 0 ? "active" : "") @s.Alignment"
                     style="background-image:url('@Url.Content(s.ImagePath)');">

                    <!-- ⚡ التأثير فوق الصورة -->
                    <canvas class="ai-overlay"></canvas>

                    <div class="content-box" data-aos="fade-up">
                        <h1>@Html.Raw(s.Title)</h1>
                        <p>@Html.Raw(s.Description)</p>
                        @if (s.ShowButton)
                        {
                            <a href="@s.ButtonUrl" class="btn btn-accent">@s.ButtonText</a>
                        }
                    </div>
                </div>
                index++;
            }
        }
        else
        {
            <div class="alert alert-warning text-center mt-5">⚠️ لا توجد شرائح حالياً.</div>
        }
    </div>

    <button class="slider-arrow left" id="prevSlide"><i class="bi bi-chevron-left"></i></button>
    <button class="slider-arrow right" id="nextSlide"><i class="bi bi-chevron-right"></i></button>
</section>

<style>
    .ai-hero {
        height: 500px;
        position: relative;
        background: #002f2f;
    }

    .hero-slide {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center center;
        background-repeat: no-repeat;
        opacity: 0;
        transition: opacity 1s ease-in-out;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1;
    }

        .hero-slide.active {
            opacity: 1;
            z-index: 2;
        }

    /* 🔹 التأثير فوق الصورة */
    .ai-overlay {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 2;
        pointer-events: none;
        mix-blend-mode: lighten;
    }

    .content-box {
        position: relative;
        z-index: 3;
        background: rgba(255, 255, 255, 0.88);
        color: #111;
        padding: 30px 50px;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        text-align: center;
        max-width: 700px;
        animation: fadeInUp 1.2s ease both;
    }

        .content-box h1 {
            font-weight: 800;
            font-size: 2.2rem;
            margin-bottom: 10px;
        }

        .content-box p {
            font-size: 1.15rem;
            margin-bottom: 20px;
        }

    /* 🔹 محاذاة النص */
    .hero-slide.align-left {
        justify-content: flex-start;
        align-items: center;
        padding-left: 8%;
    }

    .hero-slide.align-right {
        justify-content: flex-end;
        align-items: center;
        padding-right: 8%;
    }

    .hero-slide.align-bottom {
        justify-content: center;
        align-items: flex-end;
        padding-bottom: 5%;
    }

    .hero-slide.align-center {
        justify-content: center;
        align-items: center;
    }

    .hero-slide.align-top {
        justify-content: center;
        align-items: flex-start;
        padding-top: 5%;
    }

    /* 🔹 الأزرار */
    .btn-accent {
        background-color: #009999;
        color: #fff;
        font-weight: 700;
        padding: 10px 30px;
        border-radius: 25px;
        border: none;
        transition: all 0.3s ease-in-out;
        text-decoration: none;
    }

        .btn-accent:hover {
            background-color: #00b3b3;
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(0, 153, 153, 0.3);
            color: #fff;
        }

    /* 🔹 الأسهم */
    .slider-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255, 255, 255, 0.3);
        border: none;
        color: white;
        font-size: 2rem;
        padding: 8px 14px;
        border-radius: 50%;
        cursor: pointer;
        transition: 0.3s;
        z-index: 10;
    }

        .slider-arrow:hover {
            background: rgba(255, 255, 255, 0.6);
        }

        .slider-arrow.left {
            left: 25px;
        }

        .slider-arrow.right {
            right: 25px;
        }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        // 🔹 السلايدر
        const slides = document.querySelectorAll(".hero-slide");
        let current = 0;
        function showSlide(i) {
            slides.forEach((s, idx) => s.classList.toggle("active", idx === i));
        }
        document.getElementById("nextSlide").onclick = () => { current = (current + 1) % slides.length; showSlide(current); };
        document.getElementById("prevSlide").onclick = () => { current = (current - 1 + slides.length) % slides.length; showSlide(current); };
        setInterval(() => { current = (current + 1) % slides.length; showSlide(current); }, 7000);

        // ⚡ أنيميشن AI المتعدد الألوان
        document.querySelectorAll(".ai-overlay").forEach(canvas => {
            const ctx = canvas.getContext("2d");
            let width = canvas.width = canvas.offsetWidth;
            let height = canvas.height = canvas.offsetHeight;

            const POINTS_COUNT = 45;
            const points = Array.from({ length: POINTS_COUNT }, () => ({
                x: Math.random() * width,
                y: Math.random() * height,
                vx: (Math.random() - 0.5) * 0.6,
                vy: (Math.random() - 0.5) * 0.6
            }));

            let hueShift = 0;

            function draw() {
                ctx.clearRect(0, 0, width, height);

                // توليد تدرج لوني متغير باستمرار
                const gradient = ctx.createLinearGradient(0, 0, width, height);
                gradient.addColorStop(0, `hsl(${(hueShift) % 360}, 80%, 60%)`);
                gradient.addColorStop(1, `hsl(${(hueShift + 100) % 360}, 80%, 60%)`);
                hueShift += 0.5;

                // خطوط بين النقاط
                for (let i = 0; i < POINTS_COUNT; i++) {
                    for (let j = i + 1; j < POINTS_COUNT; j++) {
                        const dx = points[i].x - points[j].x;
                        const dy = points[i].y - points[j].y;
                        const dist = Math.sqrt(dx * dx + dy * dy);
                        if (dist < 150) {
                            const opacity = 1 - dist / 150;
                            ctx.strokeStyle = gradient;
                            ctx.globalAlpha = opacity * 0.6;
                            ctx.shadowBlur = 8;
                            ctx.shadowColor = "rgba(255,255,255,0.6)";
                            ctx.lineWidth = 1;
                            ctx.beginPath();
                            ctx.moveTo(points[i].x, points[i].y);
                            ctx.lineTo(points[j].x, points[j].y);
                            ctx.stroke();
                        }
                    }
                }

                // النقاط
                ctx.globalAlpha = 1;
                for (let p of points) {
                    p.x += p.vx;
                    p.y += p.vy;
                    if (p.x < 0 || p.x > width) p.vx *= -1;
                    if (p.y < 0 || p.y > height) p.vy *= -1;

                    ctx.fillStyle = gradient;
                    ctx.shadowBlur = 6;
                    ctx.shadowColor = "white";
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, 2.8, 0, Math.PI * 2);
                    ctx.fill();
                }

                requestAnimationFrame(draw);
            }

            draw();

            window.addEventListener("resize", () => {
                width = canvas.width = canvas.offsetWidth;
                height = canvas.height = canvas.offsetHeight;
            });
        });
    });
</script>
