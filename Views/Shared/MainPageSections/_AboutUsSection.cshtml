@model QdratNew.ViewModels.Public.HomePage.HomePageContentViewModel

@{
    // 🧩 الصفحة الثابتة (Slug = about) من كاش الصفحة الرئيسية
    var aboutPage = Model.AboutPage;

    string imagePath = aboutPage?.ImagePath ?? "/images/about-team.jpg"; // الصورة الافتراضية لو ما تم تحديدها
}

<section id="about-us" class="bg-qdrat-soft py-5" style="direction:rtl;">
    <div class="container">
        <div class="row align-items-center">

            <!-- الصورة -->
            <div class="col-lg-6 text-center aos-init aos-animate" data-aos="zoom-in">
                <img src="@Url.Content(imagePath)" alt="عن المعهد"
                     class="img-fluid rounded-4 shadow-sm"
                     style="max-height:400px; object-fit:cover;">
            </div>

            <!-- النص -->
            <div class="col-lg-6 text-center aos-init aos-animate" data-aos="zoom-in">
                <h2 class="fw-bold mb-3" style="color:#2B7D77;">من نحن</h2>

                @if (aboutPage != null)
                {
                    <div class="text-muted lh-lg">
                        @Html.Raw(aboutPage.Content)
                    </div>

                    <a href="/Public/Page/about"
                       class="btn btn-outline-success mt-3 px-4 py-2">
                        اقرأ المزيد عنا
                    </a>
                }
                else
                {
                    <p class="text-muted">لم يتم العثور على محتوى صفحة "من نحن" في النظام.</p>
                }
            </div>
        </div>
    </div>
</section>
