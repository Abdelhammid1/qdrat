@using Microsoft.EntityFrameworkCore
@inject QdratNew.Data.ApplicationDbContext _context

@{
    // 🧩 جلب صفحة رؤية 2030 من قاعدة البيانات
    var visionPage = await _context.StaticPages
        .AsNoTracking()
        .FirstOrDefaultAsync(p => p.Slug == "mnsh-alqdrat-wroyh-almmlkh-2030" && p.IsActive);
}

@if (visionPage != null)
{
    <section id="vision2030" class="py-5 bg-qdrat-light" style="direction:rtl;">
        <div class="container">
            <div class="row align-items-center">

                <!-- النص -->
                <div class="col-lg-6 mb-4 mb-lg-0 aos-init aos-animate" data-aos="fade-left">
                    <h2 class="fw-bold mb-3" style="color:#2B7D77;">@visionPage.Title</h2>
                    <div class="text-muted lh-lg fs-6">
                        @Html.Raw(visionPage.Content)
                    </div>
                </div>

                <!-- الصورة -->
                <div class="col-lg-6 text-center aos-init aos-animate" data-aos="zoom-in">
                    @if (!string.IsNullOrEmpty(visionPage.ImagePath))
                    {
                        <img src="@Url.Content(visionPage.ImagePath)" alt="@visionPage.Title"
                             class="img-fluid rounded-4 shadow-sm"
                             style="max-height:420px;object-fit:cover;">
                    }
                    else
                    {
                        <img src="~/images/vision2030-banner.png"
                             alt="رؤية المملكة 2030"
                             class="img-fluid rounded-4 shadow-sm"
                             style="max-height:420px;object-fit:cover;">
                    }
                </div>

            </div>
        </div>
    </section>
}
else
{
    <section class="py-5 text-center bg-light" dir="rtl">
        <div class="container">
            <div class="alert alert-warning fw-bold shadow-sm rounded-3">
                ⚠️ لم يتم العثور على صفحة <strong>منصة القدرات ورؤية المملكة 2030</strong>.<br />
                تأكد من أن الصفحة موجودة في <strong>الصفحات الثابتة</strong> وأن <code>Slug = mnsh-alqdrat-wroyh-almmlkh-2030</code>.
            </div>
        </div>
    </section>
}
