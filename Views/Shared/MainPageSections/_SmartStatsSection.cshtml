<section class="py-5 bg-white text-center">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <h2 class="fw-bold counter" data-count="10275" data-suffix="">0</h2>
                <p>خريج وثق فينا لتحقيق هدفه المهني</p>
            </div>

            <div class="col-md-4">
                <h2 class="fw-bold counter" data-suffix="+" data-count="500">0</h2>
                <p>برنامج تدريبي نُفّذ بمعايير مهنية رفيعة</p>
            </div>

            <div class="col-md-4">
                <h2 class="fw-bold counter" data-count="25" data-suffix="+">0</h2>
                <p>اعتمادات دولية ومحلية تعزز ثقة شركائنا</p>
            </div>
        </div>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const counters = document.querySelectorAll('.counter');
                const duration = 2000; // المدة الكلية بالمللي ثانية

                counters.forEach(counter => {
                    const target = parseInt(counter.getAttribute('data-count'));
                    const suffix = counter.getAttribute('data-suffix') || "";
                    let current = 0;
                    const step = Math.ceil(target / (duration / 30));

                    const animate = () => {
                        current += step;
                        if (current < target) {
                            counter.textContent = current.toLocaleString();
                            setTimeout(animate, 30);
                        } else {
                            counter.textContent = target.toLocaleString() + suffix;
                        }
                    };

                    // ✅ تشغيل العد عند ظهور العنصر في الشاشة
                    const observer = new IntersectionObserver(entries => {
                        entries.forEach(entry => {
                            if (entry.isIntersecting) {
                                animate();
                                observer.unobserve(counter);
                            }
                        });
                    }, { threshold: 0.5 });

                    observer.observe(counter);
                });
            });
        </script>

    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll(".counter").forEach(el => {
                const target = +el.getAttribute("data-count");
                let count = 0;
                const step = Math.max(1, target / 80);
                const update = () => {
                    count += step;
                    if (count < target) { el.textContent = Math.floor(count); requestAnimationFrame(update); }
                    else el.textContent = target;
                };
                update();
            });
        });
    </script>




}
