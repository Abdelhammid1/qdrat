@using Microsoft.EntityFrameworkCore
@inject QdratNew.Data.ApplicationDbContext DbContext
@{
    var partnerSetting = await DbContext.CorporateRegistrationSettings
        .AsNoTracking()
        .FirstOrDefaultAsync(x => x.CompanyName == "petrojet");

    var showPartnersSection = partnerSetting == null || partnerSetting.IsVisibleOnHomePage;
}

@if (showPartnersSection)
{
    <section class="partners-section py-5 bg-white">
        <div class="container text-center">
            <h2 class="fw-bold mb-4 text-qdrat">شركاؤنا في النجاح</h2>
            <div class="row justify-content-center">
                <div class="col-md-4">
                    <div class="p-4 border rounded-4 shadow-sm">
                        <img src="~/images/sponsors/petrojet.png" class="img-fluid mb-3" style="max-height:80px;" />
                        <h5 class="fw-bold text-qdrat">شركة بتروجت</h5>
                        <p class="text-muted small">شريك استراتيجي في تطوير مهارات العاملين بالذكاء الاصطناعي.</p>
                        <a href="/Public/CorporateRegistration/Register?company=petrojet" class="btn btn-qdrat w-100">📋 التسجيل</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
