<section class="fixed-bg py-5" style="background-color: #f7fafa; direction: rtl;">
    <div class="container text-center position-relative" style="min-height: 600px;">
        <h2 class="fw-bold mb-5" style="color: #2B7D77;" data-aos="fade-up">ركائز منصة قدرات الذكية</h2>

        <!-- الدائرة المركزية -->
        <div class="position-absolute top-50 start-50 translate-middle rounded-circle shadow d-flex align-items-center justify-content-center"
             style="width: 120px; height: 120px; background-color: white; border: 4px solid #2B7D77; z-index: 2;">
            <strong class="text-primary">الطالب</strong>
        </div>

        <!-- عنصر 1 (أعلى) -->
        <div class="position-absolute top-0 start-50 translate-middle-x" data-aos="fade-down">
            <div class="card shadow rounded p-3" style="width: 220px; background: linear-gradient(to right, #D946EF, #9333EA); color: white;">
                <div class="fs-3 mb-2"><i class="bi bi-bar-chart-fill"></i></div>
                <h6 class="fw-bold">تحليل الأداء</h6>
                <p class="small mb-0">تحليل متقدم لنقاط القوة والضعف للطالب.</p>
            </div>
        </div>

        <!-- عنصر 2 (يمين) -->
        <div class="position-absolute top-50 end-0 translate-middle-y" data-aos="fade-left" data-aos-delay="100">
            <div class="card shadow rounded p-3" style="width: 220px; background: linear-gradient(to right, #2563EB, #1E40AF); color: white;">
                <div class="fs-3 mb-2"><i class="bi bi-gear-wide-connected"></i></div>
                <h6 class="fw-bold">خطة ذكية</h6>
                <p class="small mb-0">نقترح تدريبات مخصصة تلقائيًا.</p>
            </div>
        </div>

        <!-- عنصر 3 (أسفل) -->
        <div class="position-absolute bottom-0 start-50 translate-middle-x" data-aos="fade-up" data-aos-delay="200">
            <div class="card shadow rounded p-3" style="width: 220px; background: linear-gradient(to right, #F59E0B, #D97706); color: white;">
                <div class="fs-3 mb-2"><i class="bi bi-lightning-charge-fill"></i></div>
                <h6 class="fw-bold">استجابة فورية</h6>
                <p class="small mb-0">التوصيات تظهر لحظيًا بعد كل أداء.</p>
            </div>
        </div>

        <!-- عنصر 4 (يسار) -->
        <div class="position-absolute top-50 start-0 translate-middle-y" data-aos="fade-right" data-aos-delay="300">
            <div class="card shadow rounded p-3" style="width: 220px; background: linear-gradient(to right, #14B8A6, #0F766E); color: white;">
                <div class="fs-3 mb-2"><i class="bi bi-award-fill"></i></div>
                <h6 class="fw-bold">متابعة الإنجاز</h6>
                <p class="small mb-0">نرصد الإنجازات ونحفّز الطالب باستمرار.</p>
            </div>
        </div>
    </div>
</section>
