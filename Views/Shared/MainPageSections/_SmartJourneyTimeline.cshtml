<section class="w-100 position-relative py-5" style="background: linear-gradient(to left, #E0F7FA, #CDE7EC); direction: rtl;">
    <div class="container-fluid px-5">
        <h2 class="text-center fw-bold mb-5" style="color: #2B7D77;" data-aos="fade-up">رحلتك الذكية في منصة قدرات</h2>

        @{
            var steps = new[]
            {
        new { Num = 1, Icon = "bi-person-plus-fill", Title = "تسجيل الطالب", Desc = "يدخل بياناته ويبدأ الرحلة", Color = "primary" },
        new { Num = 2, Icon = "bi-inbox-fill", Title = "استلام الواجب", Desc = "واجبات تولد تلقائيًا حسب الدرس", Color = "success" },
        new { Num = 3, Icon = "bi-pencil-square", Title = "حل المهام", Desc = "يحل الأسئلة الذكية بكل سهولة", Color = "warning" },
        new { Num = 4, Icon = "bi-graph-up", Title = "تحليل الأداء", Desc = "نحلل الأداء فورًا بعد الحل", Color = "danger" },
        new { Num = 5, Icon = "bi-lightbulb-fill", Title = "خطة علاجية", Desc = "نقترح تدريبات مخصصة", Color = "info" },
        new { Num = 6, Icon = "bi-award-fill", Title = "الإنجاز", Desc = "يحصل على تقييم وشهادة تقدير", Color = "secondary" }
        };

            var delay = 0;
        }

        <!-- الصف الأول -->
        <div class="row justify-content-center align-items-center mb-4">
            @for (int i = 0; i < 3; i++)
            {
                var s = steps[i];
                <div class="col-md-3 text-center" data-aos="zoom-in" data-aos-delay="@delay">
                    <div class="circle bg-@s.Color text-white mb-3 mx-auto">@s.Num</div>
                    <div class="fs-2 mb-2 text-@s.Color"><i class="bi @s.Icon"></i></div>
                    <h6 class="fw-bold">@s.Title</h6>
                    <p class="small">@s.Desc</p>
                </div>

                @if (i < 2)
                {
                    delay += 100;
                    <div class="col-md-1 d-none d-md-block text-center" data-aos="fade-left" data-aos-delay="@delay">
                        <i class="bi bi-arrow-left-short fs-1 text-muted"></i>
                    </div>
                }

                delay += 100;
            }
        </div>

        <!-- الصف الثاني -->
        <div class="row justify-content-center align-items-center">
            @for (int i = 3; i < 6; i++)
            {
                var s = steps[i];
                <div class="col-md-3 text-center" data-aos="zoom-in" data-aos-delay="@delay">
                    <div class="circle bg-@s.Color text-white mb-3 mx-auto">@s.Num</div>
                    <div class="fs-2 mb-2 text-@s.Color"><i class="bi @s.Icon"></i></div>
                    <h6 class="fw-bold">@s.Title</h6>
                    <p class="small">@s.Desc</p>
                </div>

                @if (i < 5)
                {
                    delay += 100;
                    <div class="col-md-1 d-none d-md-block text-center" data-aos="fade-left" data-aos-delay="@delay">
                        <i class="bi bi-arrow-left-short fs-1 text-muted"></i>
                    </div>
                }

                delay += 100;
            }
        </div>
    </div>
</section>
