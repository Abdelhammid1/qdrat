@using Microsoft.EntityFrameworkCore
@inject QdratNew.Data.ApplicationDbContext _context

@{
    // 🧩 جلب الدورات من قاعدة البيانات
    var courses = await _context.FrontendCourses
        .Include(c => c.SubCourses.Where(s => s.IsActive))
        .Where(c => c.IsActive)
        .OrderBy(c => c.Id)
        .ToListAsync();
}

<section id="programs" class="py-5" style="background-color:#f8f9fa; direction:rtl;">
    <div class="container text-center">
        <h2 class="fw-bold mb-4 text-primary">🎓 البرامج والدورات التدريبية</h2>
        <p class="text-muted mb-5">
            نسعى دائمًا لتقديم أفضل البرامج والخدمات التي تلبي احتياجات المتدربين وتساعدهم على تحقيق أهدافهم الأكاديمية والمهنية.
        </p>

        @if (courses.Any())
        {
            <div class="row g-4">
                @foreach (var course in courses)
                {
                    <div class="col-md-4">
                        <div class="card h-100 shadow border-0 rounded-4 overflow-hidden">
                            <img src="@Url.Content(course.ImagePath ?? "/uploads/Main/default-course.jpg")"
                                 class="card-img-top"
                                 alt="@course.Title"
                                 style="height:200px;object-fit:cover;">
                            <div class="card-body text-end">
                                <h5 class="fw-bold" style="color:#da784d;">@course.Title</h5>
                                <p class="text-muted small">
                                    @(string.IsNullOrEmpty(course.ShortDescription)
                                                                ? "تعرف على محتوى هذا البرنامج التدريبي."
                                                                : (course.ShortDescription.Length > 180
                                                                ? course.ShortDescription.Substring(0, 180) + "..."
                                                                : course.ShortDescription))
                        </p>

                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <a href="/Public/FrontendCourses/Details/@course.Slug"
                                       class="btn btn-qdrat btn-sm">📘 عرض التفاصيل</a>

                            @if (course.SubCourses != null && course.SubCourses.Any())
                                    {
                                        <a href="/Public/Enrollments/Register/@course.SubCourses.First().Id"
                                           class="btn btn-qdrat-o btn-sm">📝 سجّل الآن</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info mt-4">
                لا توجد برامج أو دورات متاحة حاليًا، سيتم تحديث القائمة قريبًا.
            </div>
        }
    </div>
</section>
