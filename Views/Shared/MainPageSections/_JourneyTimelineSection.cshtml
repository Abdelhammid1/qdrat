<section id="journey" class="py-5" style="background:#F8F9FA; direction:rtl;">
    <div class="container">
        <h2 class="fw-bold text-center mb-5" style="color:#2B7D77;" data-aos="fade-up">
            رحلة الطالب داخل منصة قدرات
        </h2>

        <div class="timeline position-relative">
            <!-- خط العمود -->
            <div class="position-absolute top-0 start-50 translate-middle-x bg-qdrat" style="width:4px; height:100%;"></div>

            <!-- المرحلة 1 -->
            <div class="timeline-item row align-items-center mb-5" data-aos="fade-left">
                <div class="col-md-6 text-end">
                    <h5 class="fw-bold text-qdrat"><i class="bi bi-person-plus-fill me-2"></i> تسجيل الطالب</h5>
                    <p class="text-muted mb-0">يبدأ الطالب رحلته بتسجيل بياناته والانضمام إلى الدفعة المناسبة.</p>
                </div>
                <div class="col-md-6 position-relative">
                    <div class="dot bg-primary position-absolute top-50 start-50 translate-middle"></div>
                </div>
            </div>

            <!-- المرحلة 2 -->
            <div class="timeline-item row align-items-center mb-5 flex-md-row-reverse" data-aos="fade-right">
                <div class="col-md-6 text-start">
                    <h5 class="fw-bold text-success"><i class="bi bi-bar-chart-fill me-2"></i> أداء الواجبات</h5>
                    <p class="text-muted mb-0">يؤدي الطالب واجباته التفاعلية لتحليل تقدمه الأكاديمي.</p>
                </div>
                <div class="col-md-6 position-relative">
                    <div class="dot bg-success position-absolute top-50 start-50 translate-middle"></div>
                </div>
            </div>

            <!-- المرحلة 3 -->
            <div class="timeline-item row align-items-center mb-5" data-aos="fade-left">
                <div class="col-md-6 text-end">
                    <h5 class="fw-bold text-warning"><i class="bi bi-tools me-2"></i> الخطة العلاجية</h5>
                    <p class="text-muted mb-0">يُنشئ النظام تلقائيًا خطة علاجية تعالج نقاط الضعف المكتشفة.</p>
                </div>
                <div class="col-md-6 position-relative">
                    <div class="dot bg-warning position-absolute top-50 start-50 translate-middle"></div>
                </div>
            </div>

            <!-- المرحلة 4 -->
            <div class="timeline-item row align-items-center mb-5 flex-md-row-reverse" data-aos="fade-right">
                <div class="col-md-6 text-start">
                    <h5 class="fw-bold text-danger"><i class="bi bi-award-fill me-2"></i> الإنجاز والتقييم</h5>
                    <p class="text-muted mb-0">يحصل الطالب على تقييم شامل وتحليل لمستواه الجديد بعد العلاج.</p>
                </div>
                <div class="col-md-6 position-relative">
                    <div class="dot bg-danger position-absolute top-50 start-50 translate-middle"></div>
                </div>
            </div>
        </div>
    </div>

    <style>
        #journey .timeline {
            position: relative;
        }

        #journey .dot {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            z-index: 2;
        }
    </style>
</section>
