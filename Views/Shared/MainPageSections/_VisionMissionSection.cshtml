@model QdratNew.ViewModels.Public.HomePage.HomePageContentViewModel

@{
    // 🟢 صفحتا الرؤية والرسالة من كاش الصفحة الرئيسية
    var vision = Model.VisionPage;
    var mission = Model.MissionPage;
}

@if (vision != null || mission != null)
{
    <section id="vision-mission" class="py-5 position-relative bg-qdrat text-white"
             style="direction: rtl;">
        <div class="container position-relative z-1">

            <!-- 🟦 العنوان الرئيسي -->
            <div class="text-center mb-5 aos-init aos-animate" data-aos="fade-down">
                <h2 class="fw-bold display-5 mb-3" style="color:#da784d;">🌟 رؤيتنا ورسالتنا</h2>
                <p class="lead text-light mb-0" style="max-width:700px;margin:auto;">
                    نؤمن بأن التعليم الذكي هو مستقبل التعلم، وأن الذكاء الاصطناعي هو البوصلة التي تقود طلابنا نحو التفوق والتميز.
                </p>
            </div>

            <!-- 🟢 الرؤية -->
            <div class="row align-items-center mt-5">

                @if (vision != null)
                {
                    <div class="col-md-6 mb-4 mb-md-0 aos-init aos-animate" data-aos="fade-left" data-aos-delay="200">
                        <div class="card bg-transparent border-0 text-end p-4 vision-card">
                            <div class="d-flex align-items-center mb-3">
                                <div class="icon-circle me-3"><i class="bi bi-eye fs-2 text-warning"></i></div>
                                <h3 class="fw-bold text-white">@vision.Title</h3>
                            </div>
                            <div class="text-light fs-5">
                                @Html.Raw(vision.Content)
                            </div>
                        </div>
                    </div>
                }

                <!-- 🟢 الرسالة -->
                @if (mission != null)
                {
                    <div class="col-md-6 aos-init aos-animate" data-aos="fade-right" data-aos-delay="400">
                        <div class="card bg-transparent border-0 text-end p-4 mission-card">
                            <div class="d-flex align-items-center mb-3">
                                <div class="icon-circle me-3"><i class="bi bi-lightbulb-fill fs-2 text-info"></i></div>
                                <h3 class="fw-bold text-white">@mission.Title</h3>
                            </div>
                            <div class="text-light fs-5">
                                @Html.Raw(mission.Content)
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>

        <div class="animated-bg"></div>
    </section>
}
else
{
    <section class="py-5 text-center bg-light" dir="rtl">
        <div class="container">
            <div class="alert alert-warning fw-bold">
                ⚠️ لم يتم العثور على صفحات <strong>رؤيتنا</strong> أو <strong>رسالتنا</strong>.<br />
                تأكد من أن الصفحتين نشطتين وأن Slug للرؤية = <code>roytna</code>
                وللرسالة = <code>rsaltna</code>.
            </div>
        </div>
    </section>
}

<style>
    .animated-bg {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 30% 20%, rgba(255,255,255,0.1), transparent 70%), radial-gradient(circle at 80% 70%, rgba(255,255,255,0.1), transparent 70%), linear-gradient(135deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02));
        animation: moveLight 8s ease-in-out infinite alternate;
        z-index: 0;
    }
    @@keyframes moveLight {
        from

    {
        transform: translateX(-20px) translateY(-20px) scale(1);
    }

    to {
        transform: translateX(20px) translateY(20px) scale(1.05);
    }

    }

    .icon-circle {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: rgba(255,255,255,0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 15px rgba(255,255,255,0.1);
        transition: all 0.4s ease;
    }

        .icon-circle:hover {
            background: rgba(255,255,255,0.2);
            transform: scale(1.1);
        }

    .vision-card, .mission-card {
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(6px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.2);
        transition: transform 0.4s ease, box-shadow 0.4s ease;
    }

        .vision-card:hover, .mission-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }
    @@media (max-width: 768px) {
        .vision-card, .mission-card

    {
        text-align: center;
    }

    .icon-circle {
        margin: 0 auto 10px;
    }

    }
</style>
