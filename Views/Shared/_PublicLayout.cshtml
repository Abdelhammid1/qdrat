@*
    🌐 QdratNew - Public Layout
    القالب العام للصفحات الدعائية العامة (Public Pages)
*@
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - معهد القدرات</title>

    <!-- الخطوط والأيقونات -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f9fafc;
            color: #333;
            overflow-x: hidden;
        }

        /* 🟦 شريط التنقل */
        .navbar {
            background: linear-gradient(90deg, #1e88e5, #6a11cb);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        }

        .navbar-brand {
            color: #fff !important;
            font-weight: 800;
            font-size: 1.5rem;
        }

        .navbar-nav .nav-link {
            color: #fff !important;
            font-weight: 600;
            transition: color 0.3s ease;
            margin: 0 6px;
        }

            .navbar-nav .nav-link:hover,
            .navbar-nav .nav-link.active {
                color: #ffc107 !important;
            }

        /* 🟩 المحتوى الرئيسي */
        main {
            min-height: 75vh;
            padding: 60px 0;
        }

        /* 🟫 الفوتر */
        footer {
            background: #0f172a;
            color: #e5e7eb;
            padding: 50px 0 30px;
        }

            footer h6 {
                color: #fff;
                font-weight: 700;
                margin-bottom: 20px;
            }

            footer a {
                color: #9ca3af;
                text-decoration: none;
                transition: color 0.3s;
            }

                footer a:hover {
                    color: #fff;
                }

        .footer-logo {
            font-weight: 800;
            color: #fff;
            font-size: 1.3rem;
        }

        .social-icons a {
            color: #9ca3af;
            margin: 0 6px;
            font-size: 1.4rem;
        }

            .social-icons a:hover {
                color: #3b82f6;
            }

        .footer-bottom {
            border-top: 1px solid #1f2937;
            margin-top: 30px;
            padding-top: 15px;
            text-align: center;
            color: #9ca3af;
            font-size: 0.95rem;
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>

    <!-- 🟦 رأس الموقع -->
    <nav class="navbar navbar-expand-lg navbar-dark py-3">
        <div class="container">
            <a class="navbar-brand" asp-controller="Public" asp-action="Index">
                <i class="fa-solid fa-brain me-2"></i> معهد القدرات
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto text-center">
                    <li class="nav-item"><a class="nav-link" asp-controller="Public" asp-action="Page" asp-route-slug="about">من نحن</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Public" asp-action="Page" asp-route-slug="privacy">سياسة الخصوصية</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Public" asp-action="Page" asp-route-slug="terms">الشروط والأحكام</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Public" asp-action="Page" asp-route-slug="contact">تواصل معنا</a></li>
                    <li class="nav-item">
                        <a class="btn btn-warning text-dark fw-bold px-3 ms-lg-3" href="/LMS/login">
                            <i class="fa-solid fa-user-lock me-1"></i> تسجيل الدخول
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- 🟩 منطقة المحتوى -->
    <main>
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- 🟫 الفوتر -->
    <footer>
        <div class="container">
            <div class="row gy-4">
                <!-- شعار ونبذة -->
                <div class="col-md-4">
                    <div class="footer-logo mb-3">معهد القدرات</div>
                    <p>منصّة تعليمية ذكية تعتمد على الذكاء الاصطناعي لتحليل أداء الطلاب وتطوير قدراتهم بأسلوب مبتكر.</p>
                    <div class="social-icons mt-3">
                        <a href="#"><i class="fab fa-facebook"></i></a>
                        <a href="#"><i class="fab fa-twitter"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-youtube"></i></a>
                    </div>
                </div>

                <!-- روابط سريعة -->
                <div class="col-md-4 text-md-center">
                    <h6>روابط سريعة</h6>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Public" asp-action="Page" asp-route-slug="about">من نحن</a></li>
                        <li><a asp-controller="Public" asp-action="Page" asp-route-slug="privacy">سياسة الخصوصية</a></li>
                        <li><a asp-controller="Public" asp-action="Page" asp-route-slug="terms">الشروط والأحكام</a></li>
                        <li><a asp-controller="Public" asp-action="Page" asp-route-slug="contact">تواصل معنا</a></li>
                    </ul>
                </div>

                <!-- التواصل -->
                <div class="col-md-4">
                    <h6>تواصل معنا</h6>
                    <p class="mb-1"><i class="fa-solid fa-envelope text-warning me-2"></i> support@qdrat.edu.sa</p>
                    <p class="mb-1"><i class="fa-solid fa-phone text-warning me-2"></i> 920000000</p>
                    <p><i class="fa-solid fa-location-dot text-warning me-2"></i> المملكة العربية السعودية - الرياض</p>
                </div>
            </div>

            <div class="footer-bottom">
                © @DateTime.Now.Year منصة القدرات - جميع الحقوق محفوظة
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
