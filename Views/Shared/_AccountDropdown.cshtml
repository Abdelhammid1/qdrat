@model QdratNew.ViewModels.Users.UserAccountDropdownViewModel
@using QdratNew.Entities
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="dropdown">
        <a href="#" class="d-block" id="userMenuLink" data-bs-toggle="dropdown" aria-expanded="false">
            <img src="~/images/default-avatar.png" alt="Profile" class="user-avatar">
        </a>
        <ul class="dropdown-menu text-end" aria-labelledby="userMenuLink" style="min-width: 250px;">
            <!-- البريد والاسم -->
            <li class="px-3 py-2">
                <div class="small text-muted">@Model.Email</div>
                <div class="fw-bold">@Model.FullName</div>
                @if (!string.IsNullOrEmpty(Model.EditNameUrl))
                {
                    <a href="@Model.EditNameUrl" class="d-inline-block text-decoration-none small text-primary mt-1">
                        <i class="fas fa-edit"></i> تعديل الاسم
                    </a>
                }
            </li>

            @if (Model.Roles != null && Model.Roles.Count > 1)
            {
                <li><hr class="dropdown-divider"></li>
                <li class="px-3 py-2">
                    <label class="form-label small mb-1">اختر الدور الحالي:</label>
                    <select class="form-select form-select-sm" onchange="changeRole(this.value)">
                        @foreach (var role in Model.Roles)
                        {
                            <option value="@role" selected="@(role == Model.SelectedRole)">
                                @role
                            </option>
                        }
                    </select>
                </li>
            }

            @if (Model.IsStudent && Model.Courses != null && Model.Courses.Count > 1)
            {
                <li><hr class="dropdown-divider"></li>
                <li class="px-3 py-2">
                    <label class="form-label small mb-1">اختر الدورة:</label>
                    <select class="form-select form-select-sm" onchange="changeCourse(this.value)">
                        @foreach (var course in Model.Courses)
                        {
                            <option value="@course.Id" selected="@(course.Id == Model.SelectedCourseId)">
                                @course.Title
                            </option>
                        }
                    </select>
                </li>
            }

            <li><hr class="dropdown-divider"></li>
            <li class="px-3">
                <a href="@Model.LogoutUrl" class="btn btn-sm btn-outline-danger w-100">
                    <i class="fas fa-sign-out-alt"></i> تسجيل الخروج
                </a>
            </li>
        </ul>
    </div>

    <script>
        function changeRole(role) {
            fetch('/Account/SetActiveRole', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ role: role })
            }).then(() => location.reload());
        }

        function changeCourse(courseId) {
            fetch('/Account/SetActiveCourse', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ courseId: courseId })
            }).then(() => location.reload());
        }
    </script>
}
