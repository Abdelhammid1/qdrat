@* حارس الرجوع في صفحات حل الاختبارات: أي رجوع/استعادة من الكاش (bfcache) يُجبر الصفحة على إعادة الطلب من الخادم،
   والخادم يحوّل الطالب مباشرة للنتيجة/الترحيب إن كانت المرحلة أو الاختبار منتهيًا. *@
<script>
    (function () {
        'use strict';

        function isBackForward() {
            try {
                var nav = performance.getEntriesByType('navigation')[0];
                return !!nav && nav.type === 'back_forward';
            } catch (e) { return false; }
        }

        // استعادة من bfcache
        window.addEventListener('pageshow', function (e) {
            if (e.persisted) window.location.reload();
        });

        // رجوع عادي (قد يعرض نسخة قديمة من الكاش)
        if (isBackForward()) window.location.reload();
    })();
</script>
