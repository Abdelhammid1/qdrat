@model List<QdratNew.ViewModels.Instructor.Exam.InstructorSentExamItemVM>

<div class="table-responsive">

    <table class="instructor-table">

        <thead class="table-light">
            <tr>
                <th>العنوان</th>
                <th>الجهة</th>
                <th>البداية</th>
                <th>النهاية</th>
                <th>المدة</th>
                <th>تاريخ الإرسال</th>
                <th>إدارة</th> <!-- 🔥 جديد -->
            </tr>
        </thead>

        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7">لا يوجد بيانات</td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>

                        <td>@item.Title</td>
                        <td>@item.TargetName</td>

                        <td>@(item.StartAt?.ToString("yyyy/MM/dd HH:mm") ?? "-")</td>
                        <td>@(item.EndAt?.ToString("yyyy/MM/dd HH:mm") ?? "-")</td>

                        <td>@item.DurationMinutes دقيقة</td>
                        <td>@item.CreatedAt.ToString("yyyy/MM/dd")</td>

                        <!-- 🔥 الأزرار -->
                        <td>

                            <a asp-area="Instructors"
                               asp-controller="InstructorExamMonitoring"
                               asp-action="Students"
                               asp-route-examAssignmentId="@item.ExamAssignmentId"
                               asp-route-type="@item.ExamType"
                               class="btn btn-sm btn-outline-primary">
                                👨‍🎓
                            </a>

                            <a asp-area="Instructors"
                               asp-controller="InstructorExamMonitoring"
                               asp-action="Report"
                               asp-route-examAssignmentId="@item.ExamAssignmentId"
                               class="btn btn-sm btn-outline-dark">
                                📊 عام
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>

    </table>

</div>