@model QdratNew.ViewModels.Exam.ExamReviewSectionVm

<div class="section-card review-section"
     data-section="@Model.SectionTitle">

    <div class="section-title">@Model.SectionTitle</div>

    <div class="section-stats mt-2 d-flex justify-content-between">
        <span class="text-primary">@Model.TotalQuestions سؤال</span>
        <span class="text-success">@Model.CorrectCount ✔</span>
        <span class="text-danger">@Model.WrongCount ✖</span>
        <span class="text-warning">@Model.SkippedCount ⧗</span>
    </div>

</div>
