@model List<QdratNew.ViewModels.Exam.ExamReviewQuestionVm>
@using QdratNew.Helpers

<div class="d-flex flex-wrap gap-2">

    @foreach (var q in Model.OrderBy(x => x.QuestionOrder))
    {
        var color = q.IsCorrect
        ? "q-correct"
        : (!string.IsNullOrWhiteSpace(q.StudentAnswer) ? "q-wrong" : "q-skipped");

        <button class="question-btn review-q-btn @color"
                data-qid="@q.QuestionId">
            @NumberHelper.ToIndicNumbersSafe(q.QuestionOrder.ToString())
        </button>
    }

</div>
