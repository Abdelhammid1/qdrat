@model QdratNew.ViewModels.Exam.ExamReviewQuestionVm
@using QdratNew.Helpers

@if (Model == null)
{
    <div class="alert alert-danger text-center">خطأ: لم يتم العثور على السؤال.</div>
    return;
}

@{
    var q = Model;

    Func<string, string> Safe = s =>
        q.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(s ?? "") : (s ?? "");

    string decodedTitle = System.Net.WebUtility.HtmlDecode(q.QuestionTitle ?? "");
    decodedTitle = decodedTitle
        .Replace("<style", "&lt;style")
        .Replace("</style>", "&lt;/style&gt;")
        .Replace("<script", "&lt;script")
        .Replace("</script>", "&lt;/script&gt;");
}

<div class="card shadow-sm border-0 p-3" dir="rtl">

    <!-- ---- عنوان السؤال ---- -->
    <h5 class="fw-bold mb-3 text-qdrat">
        @Html.Raw(Safe(decodedTitle))
    </h5>


    <!-- ---- القطعة اللفظية إن وجدت ---- -->
    @if (!string.IsNullOrWhiteSpace(q.VerbalPassageContent))
    {
        <div class="card border-primary shadow-sm mb-4">
            <div class="card-header bg-light fw-bold text-primary">
                <i class="bi bi-journal-text me-2"></i> القطعة اللفظية
            </div>
            <div class="card-body bg-white" style="line-height:1.9; text-align:justify;">
                @Html.Raw(q.VerbalPassageContent)
            </div>
        </div>
    }


    <!-- ---- حالات السؤال حسب نوعه ---- -->
    <!-- مقارنة نصية -->
    @if (!string.IsNullOrWhiteSpace(q.ComparisonValue1) &&
        !string.IsNullOrWhiteSpace(q.ComparisonValue2) &&
        string.IsNullOrWhiteSpace(q.ImageUrl))
    {
        <div class="row mb-3 text-center">
            <div class="col-md-6 border-end">
                <strong>القيمة الأولى:</strong>
                <div>@Html.Raw(Safe(q.ComparisonValue1))</div>
            </div>

            <div class="col-md-6">
                <strong>القيمة الثانية:</strong>
                <div>@Html.Raw(Safe(q.ComparisonValue2))</div>
            </div>
        </div>
    }

    <!-- مقارنة مع صورة -->
    @if (!string.IsNullOrWhiteSpace(q.ImageUrl) &&
        !string.IsNullOrWhiteSpace(q.ComparisonValue1) &&
        !string.IsNullOrWhiteSpace(q.ComparisonValue2))
    {
        <div class="row mb-3 text-center align-items-center">
            <div class="col-md-4">
                <img src="@q.ImageUrl"
                     class="img-fluid rounded shadow-sm"
                     style="max-height: 250px;" />
            </div>

            <div class="col-md-4 border-end">
                <strong>القيمة الأولى:</strong>
                <div>@Html.Raw(Safe(q.ComparisonValue1))</div>
            </div>

            <div class="col-md-4">
                <strong>القيمة الثانية:</strong>
                <div>@Html.Raw(Safe(q.ComparisonValue2))</div>
            </div>
        </div>
    }

    <!-- صورة فقط -->
    @if (!string.IsNullOrWhiteSpace(q.ImageUrl) &&
        string.IsNullOrWhiteSpace(q.ComparisonValue1))
    {
        <div class="text-center mb-3">
            <img src="@q.ImageUrl"
                 class="img-fluid rounded shadow-sm"
                 style="max-height: 280px;" />
        </div>
    }


    <!-- ---- خيارات السؤال ---- -->
    <div class="list-group mt-4">

        @foreach (var opt in q.Options)
        {
            bool isCorrect = opt.Text == q.CorrectAnswer;
            bool isSelected = opt.Text == q.StudentAnswer;

            string cssClass =
            isCorrect ? "list-group-item border-success bg-success bg-opacity-10" :
            isSelected ? "list-group-item border-danger bg-danger bg-opacity-10" :
            "list-group-item";

            <div class="@cssClass p-3 d-flex justify-content-between align-items-center">

                <!-- محتوى الاختيار -->
                <div class="fw-bold">

                    <!-- نص فقط -->
                    @if (!string.IsNullOrWhiteSpace(opt.Text) &&
                                    string.IsNullOrWhiteSpace(opt.ImageUrl))
                    {
                        @Html.Raw(Safe(opt.Text))
                    }

                    <!-- صورة فقط -->
                    @if (!string.IsNullOrWhiteSpace(opt.ImageUrl) &&
                                    string.IsNullOrWhiteSpace(opt.Text))
                    {
                        <img src="@opt.ImageUrl" class="img-fluid rounded" style="max-height: 80px;" />
                    }

                    <!-- نص + صورة -->
                    @if (!string.IsNullOrWhiteSpace(opt.ImageUrl) &&
                                    !string.IsNullOrWhiteSpace(opt.Text))
                    {
                        <div class="d-flex align-items-center gap-2">
                            <img src="@opt.ImageUrl" class="img-fluid rounded" style="max-height: 60px;" />
                            <span>@Html.Raw(Safe(opt.Text))</span>
                        </div>
                    }

                </div>

                <!-- علامة صح أو خطأ -->
                <div>
                    @if (isCorrect)
                    {
                        <span class="text-success fw-bold">✔</span>
                    }
                    else if (isSelected)
                    {
                        <span class="text-danger fw-bold">✖</span>
                    }
                </div>

            </div>
        }

    </div>


    <!-- ---- الوقت المستغرق ---- -->
    <div class="text-end mt-3">
        <span class="text-muted">
            ⏱ الوقت على السؤال:
            <strong>@q.TimeTakenSeconds ثانية</strong>
        </span>
    </div>

</div>
