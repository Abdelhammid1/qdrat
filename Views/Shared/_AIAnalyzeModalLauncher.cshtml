@model int // ID الخاص بالفرع أو الكيان

<button class="btn btn-sm btn-outline-primary float-start"
        data-bs-toggle="modal"
        data-bs-target="#aiModal-@Model">
    <i class="fas fa-robot"></i> تحليل ذكي
</button>

<!-- ✅ الموديول الذكي -->
<div class="modal fade" id="aiModal-@Model" tabindex="-1" aria-labelledby="aiModalLabel-@Model" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="aiModalLabel-@Model"><i class="fas fa-brain"></i> التحليل الذكي للفرع</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body text-center p-4">
                <div id="aiAnalysisContent-@Model">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">جاري التحليل...</span>
                    </div>
                    <p class="mt-3 fw-bold text-muted">جاري التحليل باستخدام الذكاء الاصطناعي...</p>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-outline-secondary" href="/Admin/BranchSmartReport/Analyze/@Model" target="_blank">
                    <i class="fas fa-external-link-alt"></i> عرض التحليل الكامل
                </a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modalId = 'aiModal-@Model';
            const contentId = 'aiAnalysisContent-@Model';
            const endpoint = `/Admin/BranchSmartReport/GetQuickInsight?id=@Model`;

            document.getElementById(modalId).addEventListener('shown.bs.modal', function () {
                const content = document.getElementById(contentId);
                content.innerHTML = `<div class="spinner-border text-primary" role="status"></div><p class="mt-3 fw-bold">جاري التحميل...</p>`;

                fetch(endpoint)
                    .then(res => res.json())
                    .then(data => {
                        content.innerHTML = `
                            <p class="text-primary fw-bold"><i class="fas fa-comment-dots"></i> ${data.comment}</p>
                            <p class="text-success fw-bold"><i class="fas fa-lightbulb"></i> ${data.recommendation}</p>
                        `;
                    }).catch(() => {
                        content.innerHTML = `<p class="text-danger">حدث خطأ أثناء جلب التحليل.</p>`;
                    });
            });
        });
    </script>
}
