@model List<QdratNew.ViewModels.Exam.ExamListVm>

<table class="table table-bordered text-center align-middle shadow-sm">
    <thead class="table-light">
        <tr>
            <th>العنوان</th>
            <th>تاريخ الإرسال</th>
            <th>الموعد</th>
            <th>النتيجة</th>
            <th>الحالة</th>
            <th>التحكم</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var exam in Model)
        {
            <tr>
                <td>@exam.Title</td>
                <td>@exam.AssignedAt.ToString("yyyy/MM/dd HH:mm")</td>
                <td>@(exam.ScheduledDate?.ToString("yyyy/MM/dd HH:mm") ?? "—")</td>
                <td>
                    @if (exam.Score > 0)
                    {
                        <span class="fw-bold text-success">@exam.Score%</span>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td>
                    @if (exam.IsSubmitted)
                    {
                        <span class="badge bg-success">تم التسليم</span>
                    }
                    else if (exam.IsUpcoming)
                    {
                        <span class="badge bg-warning text-dark">لم يبدأ بعد</span>
                    }
                    else if (exam.IsActive)
                    {
                        <span class="badge bg-primary">متاح الآن</span>
                    }
                    else if (exam.IsExpired)
                    {
                        <span class="badge bg-secondary">انتهى الوقت</span>
                    }
                </td>
                <td>
                    @if (exam.IsSubmitted)
                    {
                        <a asp-action="ExamResult" asp-route-id="@exam.ExamAssignmentId" class="btn btn-sm btn-info">عرض النتيجة</a>
                    }
                    else if (exam.IsActive)
                    {
                        <a asp-action="StartExam" asp-route-examAssignmentId="@exam.ExamAssignmentId" class="btn btn-sm btn-success">بدء الاختبار</a>
                    }
                    else if (exam.IsUpcoming)
                    {
                        <button class="btn btn-sm btn-outline-warning" disabled>⏳ لم يبدأ بعد</button>
                    }
                    else if (exam.IsExpired)
                    {
                        <button class="btn btn-sm btn-outline-secondary" disabled>⛔ انتهى الوقت</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
