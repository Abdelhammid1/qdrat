@model QdratNew.ViewModels.Question.EditQuestionLabelsViewModel

<form id="editLabelsForm">
    @foreach (var label in Model.AllLabels)
    {
        <div class="form-check">
            <input class="form-check-input" type="checkbox"
                   name="SelectedLabels" value="@label"
                   @(Model.SelectedLabels.Contains(label) ? "checked" : "") />
            <label class="form-check-label">@label</label>
        </div>
    }

    <input type="hidden" name="QuestionId" value="@Model.QuestionId" />
    <button type="submit" class="btn btn-primary mt-3">حفظ التعديلات</button>
</form>

<script>
    document.getElementById("editLabelsForm").addEventListener("submit", async function (e) {
        e.preventDefault();

        const formData = new FormData(this);
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        const response = await fetch("/Instructors/QuestionsReview/UpdateLabels", {
            method: "POST",
            headers: { 'RequestVerificationToken': token },
            body: new URLSearchParams([...formData])
        });

        const result = await response.json();
        if (result.success) {
            Swal.fire('تم', result.message, 'success').then(() => location.reload());
        } else {
            Swal.fire('خطأ', result.message, 'error');
        }
    });
</script>
