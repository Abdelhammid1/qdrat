@model QdratNew.ViewModels.Students.StudentSidebarAnalyticsViewModel

<div class="card bg-light p-3">
    <h5>تحليلك الذكي</h5>
    <hr />
    <p><strong>نسبة النجاح:</strong> @Model.OverallSuccessRate%</p>

    <h6>توصيات الذكاء الاصطناعي:</h6>
    <ul>
        @foreach (var tip in Model.AITips)
        {
            <li>@tip</li>
        }
    </ul>

    <canvas id="homeworkChart" height="150"></canvas>
    <canvas id="examChart" height="150" class="mt-3"></canvas>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const homeworkLabels = @Html.Raw(Json.Serialize(
        Model.HomeworkScoresOverTime.Select((_, i) => "واجب " + (i + 1))
    ));
    const homeworkData = @Html.Raw(Json.Serialize(Model.HomeworkScoresOverTime));

    const examLabels = @Html.Raw(Json.Serialize(
        Model.ExamScoresOverTime.Select((_, i) => "اختبار " + (i + 1))
    ));
    const examData = @Html.Raw(Json.Serialize(Model.ExamScoresOverTime));

    new Chart(document.getElementById('homeworkChart').getContext('2d'), {
        type: 'line',
        data: {
            labels: homeworkLabels,
            datasets: [{
                label: 'نتائج الواجبات',
                data: homeworkData,
                borderColor: '#28a745',
                backgroundColor: 'rgba(40, 167, 69, 0.1)',
                fill: true,
                tension: 0.3
            }]
        }
    });

    new Chart(document.getElementById('examChart').getContext('2d'), {
        type: 'line',
        data: {
            labels: examLabels,
            datasets: [{
                label: 'نتائج الاختبارات',
                data: examData,
                borderColor: '#ffc107',
                backgroundColor: 'rgba(255, 193, 7, 0.1)',
                fill: true,
                tension: 0.3
            }]
        }
    });
</script>
