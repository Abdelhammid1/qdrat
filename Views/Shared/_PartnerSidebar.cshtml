<div class="partner-sidebar">

    <div class="logo">
        لوحة الشريك
    </div>

    <a asp-area="Partner" asp-controller="Dashboard" asp-action="Index">
        📊 لوحة التحكم
    </a>

    <a asp-area="Partner" asp-controller="Students" asp-action="Index">
        <i class="fa-solid fa-users"></i>
        <span>الطلاب</span>
    </a>

    <a asp-area="Partner" asp-controller="Batches" asp-action="Index">
        <i class="fa-solid fa-layer-group"></i>
        <span>الدفعات</span>
    </a>

    <a asp-area="Partner" asp-controller="Courses" asp-action="Index">
        <i class="fa-solid fa-book-open"></i>
        <span>الدورات</span>
    </a>

    <!-- 👨‍🏫 المدربون -->
    <div class="sidebar-section">
        <div class="sidebar-section-title">
            <i class="fa-solid fa-chalkboard-user"></i>
            <span>المدربون</span>
        </div>

        <a asp-area="Partner"
           asp-controller="PartnerInstructors"
           asp-action="Index"
           class="submenu">
            <i class="fa-solid fa-user-tie"></i>
            <span>إدارة المدربين</span>
        </a>
    </div>

    <!-- 📝 الواجبات -->
    <div class="sidebar-section">
        <div class="sidebar-section-title">
            <i class="fa-solid fa-clipboard-list"></i>
            <span>الواجبات</span>
        </div>

        <a asp-area="Partner"
           asp-controller="HomeworkDrafts"
           asp-action="Index"
           class="submenu">
            <i class="fa-solid fa-pen-to-square"></i>
            <span>نماذج الواجب</span>
        </a>

        <a asp-area="Partner"
           asp-controller="Homeworks"
           asp-action="Index"
           class="submenu">
            <i class="fa-solid fa-paper-plane"></i>
            <span>الواجبات المرسلة</span>
        </a>
    </div>

</div>