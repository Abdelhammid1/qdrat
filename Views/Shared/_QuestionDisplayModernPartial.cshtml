@model QdratNew.ViewModels.Question.QuestionDisplayViewModel
@using QdratNew.Helpers

@{
    var q = Model;
    Func<string, string> convert = q.IsQuantitative
        ? s => NumberHelper.ToIndicNumbersSafe(s)
        : s => s;

    string questionText = q.Title ?? q.QuestionText ?? q.Title ?? "";
    bool hasPassage = !string.IsNullOrWhiteSpace(q.VerbalPassageContent);
    bool hasImage = !string.IsNullOrWhiteSpace(q.ImageUrl);
    bool isComparison = q.DisplayType.ToString().Contains("Comparison");
}

<div class="question-table-wrapper my-3">
    <table class="table table-bordered align-middle shadow-sm bg-white text-end" dir="rtl">
        <tbody>
            <!-- 🔹 نص السؤال -->
            <tr>
                <td class="fw-bold text-primary fs-5" colspan="2">
                    @Html.Raw(convert(questionText))
                </td>
            </tr>

            <!-- 🔹 القطعة اللفظية -->
            @if (hasPassage)
            {
                <tr>
                    <td colspan="2">
                        <div class="p-3 border rounded bg-light-subtle text-secondary">
                            @Html.Raw(convert(q.VerbalPassageContent))
                        </div>
                    </td>
                </tr>
            }

            <!-- 🔹 صورة السؤال -->
            @if (hasImage)
            {
                <tr>
                    <td colspan="2" class="text-center">
                        <img src="@Url.Content(q.ImageUrl)"
                             alt="صورة السؤال"
                             class="img-fluid rounded shadow-sm"
                             style="max-height:220px; object-fit:contain;" />
                    </td>
                </tr>
            }

            <!-- 🔹 المقارنة -->
            @if (isComparison)
            {
                <tr>
                    <td colspan="2">
                        <table class="table table-sm table-bordered text-center mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-center">القيمة الأولى</th>
                                    <th class="text-center">القيمة الثانية</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>@Html.Raw(convert(q.ComparisonValue1))</td>
                                    <td>@Html.Raw(convert(q.ComparisonValue2))</td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            }

            <!-- 🔹 الاختيارات -->
            @if (q.Options != null && q.Options.Any())
            {
                <tr>
                    <td colspan="2">
                        <table class="table table-sm table-bordered text-center mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:80px;">#</th>
                                    <th class="text-center">النص / الصورة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < q.Options.Count; i++)
                                {
                                    var opt = q.Options[i];
                                    <tr>
                                        <td class="fw-bold">@NumberHelper.ToIndicNumbersSafe((i + 1).ToString())</td>
                                        <td class="text-end">
                                            @if (!string.IsNullOrWhiteSpace(opt.ImageUrl))
                                            {
                                                <img src="@Url.Content(opt.ImageUrl)"
                                                     class="img-fluid rounded shadow-sm"
                                                     style="max-height:100px; object-fit:contain;" />
                                            }
                                            else
                                            {
                                                @Html.Raw(convert(opt.Text))
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </td>
                </tr>
            }
            else
            {
                <tr>
                    <td colspan="2" class="text-muted text-end">❌ لا توجد اختيارات لهذا السؤال.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    .question-table-wrapper table {
        border-radius: 10px;
        overflow: hidden;
    }

    .question-table-wrapper td {
        vertical-align: middle !important;
    }

    .table-sm th, .table-sm td {
        padding: 0.6rem !important;
    }

    .bg-light-subtle {
        background-color: #f8f9fa !important;
    }

    .text-end {
        text-align: right !important;
    }
</style>
