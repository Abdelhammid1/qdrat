@model QdratNew.ViewModels.Homework.HomeworkSolveViewModel
@using QdratNew.Helpers
@using QdratNew.Enums

@{
    var q = Model.Question;
    var isRTL = q?.IsRTL ?? true;

    Func<string, string> T = key => isRTL ? key : key switch
    {
        "السؤال"                      => "Question",
        "من"                          => "of",
        "القيمة الأولى"               => "Value A",
        "القيمة الثانية"              => "Value B",
        "القطعة اللفظية"              => "Passage",
        "مراجعة سريعة لجميع الأسئلة" => "Quick Review",
        "إنهاء وتسليم الواجب"        => "Submit Homework",
        "السابق"                      => "Previous",
        "التالي"                      => "Next",
        "ضع علامة للمراجعة"          => "Mark for Review",
        "مراجعة سريعة للأسئلة"       => "Review Questions",
        "الوقت"                       => "Time",
        _                             => key
    };

    Func<string, string> htmlConvert = s =>
    {
        if (string.IsNullOrWhiteSpace(s)) return s;
        try
        {
            if (Model.IsQuantitative)
            {
                if (s.Contains("style=", StringComparison.OrdinalIgnoreCase))
                    return NumberHelper.ToIndicNumbersInsideHtml(s);
                return HtmlNumberHelper.ConvertHtmlPreservingTags(s, true);
            }
            return s;
        }
        catch { return s; }
    };

    var isLastQuestion = Model.CurrentIndex == Model.Total;
}

<!-- ============================================================
     STYLES
============================================================ -->
<style>
    :root {
        color-scheme: light dark;
        --hw-primary:      #4f46e5;
        --hw-primary-soft: #eef2ff;
        --hw-success:      #16a34a;
        --hw-success-soft: #dcfce7;
        --hw-warning:      #d97706;
        --hw-warning-soft: #fef3c7;
        --hw-danger:       #dc2626;
        --hw-surface:      #ffffff;
        --hw-bg:           #f1f5f9;
        --hw-border:       #e2e8f0;
        --hw-text-main:    #1e293b;
        --hw-text-muted:   #64748b;
        --hw-radius:       14px;
        --hw-radius-sm:    8px;
        --hw-shadow:       0 4px 24px rgba(79,70,229,.08);
        --hw-shadow-card:  0 2px 12px rgba(0,0,0,.06);
        --hw-font:         'Cairo', 'Tajawal', system-ui, sans-serif;
        --hw-nav-h:        72px;
        --hw-top-h:        64px;
    }

    /* ── Reset & Base ── */
    .hw-page {
        font-family: var(--hw-font);
        background: var(--hw-bg);
        min-height: 100dvh;
        color: var(--hw-text-main);
        padding-top: var(--hw-top-h);
        padding-bottom: calc(var(--hw-nav-h) + 24px);
    }

    /* ── Top Bar ── */
    .hw-topbar {
        position: fixed;
        top: 0; left: 0; right: 0;
        height: var(--hw-top-h);
        background: var(--hw-surface);
        border-bottom: 1px solid var(--hw-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 20px;
        z-index: 1100;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
        gap: 12px;
    }

    .hw-topbar-title {
        font-size: .9rem;
        font-weight: 700;
        color: var(--hw-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 180px;
    }

    .hw-counter {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .hw-counter-badge {
        background: var(--hw-primary-soft);
        color: var(--hw-primary);
        font-weight: 700;
        font-size: .9rem;
        padding: 4px 14px;
        border-radius: 20px;
        white-space: nowrap;
    }

    /* Progress dots */
    .hw-progress-dots {
        display: flex;
        gap: 4px;
        align-items: center;
        overflow: hidden;
        max-width: 140px;
        flex-wrap: wrap;
    }

    .hw-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--hw-border);
        flex-shrink: 0;
        transition: background .2s;
    }
    .hw-dot.answered  { background: var(--hw-success); }
    .hw-dot.current   { background: var(--hw-primary); transform: scale(1.35); }
    .hw-dot.marked    { background: var(--hw-warning); }

    /* ── Circular Timer ── */
    .hw-circular-timer {
        position: relative;
        width: 56px;
        height: 56px;
        flex-shrink: 0;
    }
    .hw-circular-timer svg {
        transform: rotate(-90deg);
        width: 100%;
        height: 100%;
    }
    .hw-ct-track {
        fill: none;
        stroke: #e2e8f0;
        stroke-width: 4;
    }
    .hw-ct-ring {
        fill: none;
        stroke: var(--hw-primary);
        stroke-width: 4;
        stroke-linecap: round;
        stroke-dasharray: 125.66;
        stroke-dashoffset: 125.66;
        transition: stroke-dashoffset .5s linear, stroke .3s;
    }
    .hw-circular-timer.warning .hw-ct-ring {
        stroke: var(--hw-danger);
    }
    .hw-ct-text {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .58rem;
        font-weight: 800;
        color: var(--hw-text-muted);
        letter-spacing: -.01em;
        pointer-events: none;
    }
    .hw-circular-timer.warning .hw-ct-text { color: var(--hw-danger); }

    @@keyframes pulse {
        0%,100% { opacity: 1; }
        50%      { opacity: .45; }
    }

    /* ── Scroll Area — عرض كامل ── */
    .hw-scroll {
        width: 100%;
        padding: 24px 32px;
    }

    /* ── Passage Box ── */
    .hw-passage {
        background: #fffbeb;
        border: 1.5px solid #fde68a;
        border-radius: var(--hw-radius);
        padding: 18px 20px;
        margin-bottom: 20px;
    }

    .hw-passage-title {
        font-size: .8rem;
        font-weight: 700;
        color: var(--hw-warning);
        text-transform: uppercase;
        letter-spacing: .05em;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .hw-passage-text {
        font-size: 1.05rem;
        line-height: 2;
        color: var(--hw-text-main);
    }

    /* Custom Audio Player */
    .hw-audio-wrapper {
        background: #f8fafc;
        border: 1px solid var(--hw-border);
        border-radius: var(--hw-radius);
        padding: 16px 20px;
        margin-bottom: 20px;
    }

    .hw-audio-wrapper audio {
        width: 100%;
        height: 40px;
        border-radius: 8px;
    }

    .hw-audio-label {
        font-size: .82rem;
        color: var(--hw-text-muted);
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    /* ── Question Card ── */
    .hw-qcard {
        background: var(--hw-surface);
        border-radius: var(--hw-radius);
        box-shadow: var(--hw-shadow-card);
        border: 1px solid var(--hw-border);
        overflow: hidden;
        margin-bottom: 20px;
    }

    .hw-qtitle {
        padding: 20px 24px;
        font-size: 1.55rem;
        font-weight: 600;
        line-height: 1.85;
        color: var(--hw-text-main);
        border-bottom: 1px solid var(--hw-border);
        background: #fafbff;
    }

    .hw-qbody {
        padding: 20px 24px;
    }

    /* Comparison layout */
    .hw-comparison {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 12px;
        align-items: center;
        margin-bottom: 16px;
    }

    .hw-cmp-box {
        background: var(--hw-primary-soft);
        border-radius: var(--hw-radius-sm);
        padding: 16px;
        text-align: center;
    }

    .hw-cmp-label {
        font-size: .72rem;
        font-weight: 700;
        color: var(--hw-primary);
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-bottom: 8px;
    }

    .hw-cmp-val {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--hw-text-main);
    }

    .hw-cmp-divider {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--hw-border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .85rem;
        color: var(--hw-text-muted);
        flex-shrink: 0;
    }

    .hw-qimage {
        text-align: center;
        margin-bottom: 16px;
    }

    .hw-qimage img {
        max-height: 240px;
        width: auto;
        max-width: 100%;
        border-radius: var(--hw-radius-sm);
        box-shadow: var(--hw-shadow-card);
    }

    .hw-cmp-img img {
        max-height: 120px;
        width: auto;
        max-width: 100%;
        border-radius: var(--hw-radius-sm);
    }

    /* ── Options ── */
    .hw-options { display: flex; flex-direction: column; gap: 10px; }

    .hw-option {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 18px;
        border-radius: var(--hw-radius-sm);
        border: 1.5px solid #d1d5db;   /* رمادي فاتح واضح */
        cursor: pointer;
        transition: border-color .18s, background .18s, transform .12s, box-shadow .18s;
        background: #fff;
        position: relative;
        user-select: none;
        text-decoration: none !important;
        color: var(--hw-text-main);
    }

    .hw-option:hover {
        border-color: var(--hw-primary);
        background: #f5f3ff;
        transform: translateY(-1px);
    }

    /* ✅ الخيار المُختار — تباين عالٍ وواضح */
    .hw-option.selected {
        border: 2px solid var(--hw-primary);
        background: var(--hw-primary-soft);
        box-shadow: 0 0 0 3px rgba(79,70,229,.15), 0 2px 8px rgba(79,70,229,.12);
    }
    .hw-option.selected .hw-option-text {
        color: var(--hw-primary);
        font-weight: 600;
    }

    /* ○ دائرة الراديو */
    .hw-radio {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        border: 2.5px solid #9ca3af;   /* رمادي واضح عند عدم الاختيار */
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: border-color .15s, background .15s;
    }

    .hw-option:hover .hw-radio  { border-color: var(--hw-primary); }

    /* ● الراديو المُختار */
    .hw-option.selected .hw-radio {
        border-color: var(--hw-primary);
        background: var(--hw-primary);
    }

    .hw-radio::after {
        content: '';
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: white;
        opacity: 0;
        transform: scale(.5);
        transition: opacity .15s, transform .15s;
    }

    .hw-option.selected .hw-radio::after { opacity: 1; transform: scale(1); }

    .hw-option-text {
        font-size: 1.1rem;
        font-weight: 500;
        line-height: 1.7;
        flex: 1;
        text-decoration: none !important;
        color: inherit;
    }

    .hw-option-img {
        max-height: 200px;
        width: auto;
        max-width: 100%;
        border-radius: var(--hw-radius-sm);
        object-fit: contain;
    }

    /* Image-only options: grid layout */
    .hw-options.img-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .hw-options.img-grid .hw-option {
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 12px;
    }

    /* Hidden real radio */
    .hw-option input[type="radio"] {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    /* ── Bottom Nav ── */
    .hw-navbar {
        position: fixed;
        bottom: 0; left: 0; right: 0;
        height: var(--hw-nav-h);
        background: var(--hw-surface);
        border-top: 1px solid var(--hw-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 20px;
        z-index: 1100;
        box-shadow: 0 -2px 12px rgba(0,0,0,.06);
        gap: 10px;
    }

    .hw-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 22px;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        font-family: var(--hw-font);
        font-size: .95rem;
        font-weight: 700;
        transition: opacity .18s, transform .12s, box-shadow .18s;
        white-space: nowrap;
    }

    .hw-btn:hover:not(:disabled) { opacity: .88; transform: translateY(-1px); }
    .hw-btn:active:not(:disabled) { transform: translateY(0); }
    .hw-btn:disabled { opacity: .4; cursor: not-allowed; }

    .hw-btn-ghost {
        background: var(--hw-bg);
        color: var(--hw-text-muted);
        border: 1.5px solid var(--hw-border);
    }

    .hw-btn-primary {
        background: var(--hw-primary);
        color: #fff;
        box-shadow: 0 4px 14px rgba(79,70,229,.3);
    }

    .hw-btn-warning {
        background: #fffbeb;
        color: var(--hw-warning);
        border: 1.5px solid #fde68a;
    }

    .hw-btn-warning.marked {
        background: var(--hw-warning);
        color: #fff;
        border-color: var(--hw-warning);
    }

    .hw-btn-success {
        background: var(--hw-success);
        color: #fff;
        box-shadow: 0 4px 14px rgba(22,163,74,.3);
    }

    /* ── Review mode ── */
    .hw-review-header {
        background: var(--hw-primary-soft);
        border-radius: var(--hw-radius);
        padding: 20px 24px;
        margin-bottom: 24px;
        text-align: center;
    }

    .hw-review-header h3 {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--hw-primary);
        margin-bottom: 4px;
    }

    .hw-review-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(44px, 1fr));
        gap: 8px;
        margin-bottom: 24px;
    }

    .hw-review-dot {
        aspect-ratio: 1;
        border-radius: var(--hw-radius-sm);
        border: none;
        cursor: pointer;
        font-weight: 700;
        font-size: .85rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform .15s, box-shadow .15s;
    }

    .hw-review-dot:hover { transform: scale(1.1); box-shadow: 0 4px 12px rgba(0,0,0,.15); }
    .hw-review-dot.answered  { background: var(--hw-success); color: #fff; }
    .hw-review-dot.unanswered{ background: var(--hw-border);  color: var(--hw-text-muted); }
    .hw-review-dot.marked    { background: var(--hw-warning); color: #fff; }
    .hw-review-dot.current   { background: var(--hw-primary); color: #fff; outline: 3px solid rgba(79,70,229,.4); }

    .hw-review-legend {
        display: flex;
        gap: 16px;
        justify-content: center;
        flex-wrap: wrap;
        font-size: .8rem;
        color: var(--hw-text-muted);
        margin-bottom: 20px;
    }

    .hw-legend-dot {
        width: 12px; height: 12px;
        border-radius: 3px;
        display: inline-block;
    }

    /* ── Dark mode ── */
    @@media (prefers-color-scheme: dark) {
        :root {
            --hw-surface:   #1e293b;
            --hw-bg:        #0f172a;
            --hw-border:    #334155;
            --hw-text-main: #f1f5f9;
            --hw-text-muted:#94a3b8;
        }
        .hw-topbar, .hw-navbar { background: #1e293b; }
        .hw-qcard { background: #1e293b; }
        .hw-qtitle { background: #172033; }
        .hw-passage { background: #1c1a0f; border-color: #78350f; }
        .hw-option  { background: #1e293b; }
        .hw-option:hover, .hw-option.selected { background: #1e1b4b; }

        /* عناصر ذات خلفية فاتحة ثابتة — يجب تثبيت لون النص كي لا ينقلب للأبيض */
        .hw-cmp-box {
            background: #1e1b4b;
            border: 1px solid #3730a3;
        }
        .hw-cmp-val { color: #f1f5f9; }
        .hw-counter-badge { background: #1e1b4b; }
        .hw-review-header { background: #1e1b4b; }
        .hw-review-header p { color: #cbd5e1 !important; }
        .hw-btn-warning { background: #2a2110; }
        .hw-btn-ghost { background: #0f172a; }
    }

    /* ── Mobile ── */
    @@media (max-width: 600px) {
        .hw-topbar-title { display: none; }
        .hw-scroll { padding: 14px 12px; }
        .hw-qtitle { font-size: 1.3rem; padding: 16px; }
        .hw-qbody  { padding: 14px; }
        .hw-btn    { padding: 9px 14px; font-size: .85rem; }
        .hw-comparison { grid-template-columns: 1fr; }
        .hw-cmp-divider { margin: 0 auto; }
        .hw-options.img-grid { grid-template-columns: 1fr; }
        .hw-circular-timer { width: 44px; height: 44px; }
        .hw-ct-text { font-size: .52rem; }
    }

    /* ── Animations ── */
    .hw-qcard { animation: hwSlideIn .22s ease; }
    @@keyframes hwSlideIn {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @@keyframes hwSpin { to { transform: rotate(360deg); } }
</style>

@* ============================================================
   REVIEW MODE
============================================================ *@
@if (Model.IsReviewMode && Model.ForceReviewVisible)
{
    <div class="hw-page @(isRTL ? "" : "ltr")" dir="@(isRTL ? "rtl" : "ltr")">

        <!-- Top Bar -->
        <header class="hw-topbar">
            <div class="hw-topbar-title">@T("مراجعة سريعة لجميع الأسئلة")</div>
            <div class="hw-counter">
                <span class="hw-counter-badge">
                    @Model.AllQuestionIds.Count @T("من") @Model.AllQuestionIds.Count
                </span>
            </div>
            <div class="hw-circular-timer" id="hw-timer-display" title="الوقت المستغرق">
                <svg viewBox="0 0 48 48" width="56" height="56">
                    <circle class="hw-ct-track" cx="24" cy="24" r="20"/>
                    <circle class="hw-ct-ring"  cx="24" cy="24" r="20" id="hw-timer-ring"/>
                </svg>
                <span class="hw-ct-text" id="hw-timer-val">00:00</span>
            </div>
        </header>

        <div class="hw-scroll">

            <!-- Review legend -->
            <div class="hw-review-header">
                <h3>📋 @T("مراجعة سريعة لجميع الأسئلة")</h3>
                <p style="margin:0; color: var(--hw-text-muted); font-size:.9rem;">اضغط على رقم السؤال للانتقال إليه</p>
            </div>

            <div class="hw-review-legend">
                <span><span class="hw-legend-dot" style="background:var(--hw-success)"></span> تم الإجابة</span>
                <span><span class="hw-legend-dot" style="background:var(--hw-warning)"></span> معلّم للمراجعة</span>
                <span><span class="hw-legend-dot" style="background:var(--hw-border)"></span> لم يُجب</span>
            </div>

            <div class="hw-review-grid">
                @for (int i = 0; i < Model.AllQuestionIds.Count; i++)
                {
                    var qid = Model.AllQuestionIds[i];
                    var hasAns = Model.AnswersMap.TryGetValue(qid, out var ans) && !string.IsNullOrWhiteSpace(ans);
                    var isMarked = Model.ReviewMarkedIds.Contains(qid);
                    var isCurrent = qid == Model.CurrentQuestionId;

                    string dotClass = isCurrent ? "current" : isMarked ? "marked" : hasAns ? "answered" : "unanswered";

                    <button class="hw-review-dot @dotClass review-jump"
                            data-target="@qid"
                            title="@T("السؤال") @(i + 1)"
                            aria-label="@T("السؤال") @(i + 1)">
                        @Html.Raw(htmlConvert((i + 1).ToString()))
                    </button>
                }
            </div>

            <!-- السؤال الحالي في وضع المراجعة -->
            @if (q != null)
            {
                <form method="post"
                      id="homework-question-form"
                      data-homework-id="@Model.HomeworkSetId"
                      data-current-question-id="@Model.CurrentQuestionId">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.HomeworkSetId" />
                    <input type="hidden" name="q" value="@Model.CurrentQuestionId" />
                    <input type="hidden" name="AllIds" value="@string.Join(",", Model.AllQuestionIds)" />

                    <div class="hw-qcard">
                        <div class="hw-qtitle">@Html.Raw(htmlConvert(q.Title ?? ""))</div>
                        <div class="hw-qbody">
                            @* ── Question body by type ── *@
                            @switch (q.DisplayType)
                            {
                                case QuestionDisplayType.WithImage:
                                    if (!string.IsNullOrWhiteSpace(q.ImageUrl))
                                    {
                                        <div class="hw-qimage">
                                            <img src="@Url.Content(q.ImageUrl)" alt="" loading="lazy" />
                                        </div>
                                    }
                                    break;

                                case QuestionDisplayType.ComparisonText:
                                    <div class="hw-comparison">
                                        <div class="hw-cmp-box">
                                            <div class="hw-cmp-label">@T("القيمة الأولى")</div>
                                            <div class="hw-cmp-val">@Html.Raw(htmlConvert(q.ComparisonValue1 ?? ""))</div>
                                        </div>
                                        <div class="hw-cmp-divider">⟷</div>
                                        <div class="hw-cmp-box">
                                            <div class="hw-cmp-label">@T("القيمة الثانية")</div>
                                            <div class="hw-cmp-val">@Html.Raw(htmlConvert(q.ComparisonValue2 ?? ""))</div>
                                        </div>
                                    </div>
                                    break;

                                case QuestionDisplayType.ComparisonWithImage:
                                    <div class="hw-comparison">
                                        <div class="hw-cmp-box">
                                            <div class="hw-cmp-label">@T("القيمة الأولى")</div>
                                            <div class="hw-cmp-val">@Html.Raw(htmlConvert(q.ComparisonValue1 ?? ""))</div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(q.ImageUrl))
                                        {
                                            <div class="hw-cmp-img">
                                                <img src="@Url.Content(q.ImageUrl)" alt="" loading="lazy" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="hw-cmp-divider">⟷</div>
                                        }
                                        <div class="hw-cmp-box">
                                            <div class="hw-cmp-label">@T("القيمة الثانية")</div>
                                            <div class="hw-cmp-val">@Html.Raw(htmlConvert(q.ComparisonValue2 ?? ""))</div>
                                        </div>
                                    </div>
                                    break;
                            }

                            @{
                                bool allImgOnlyR = q.Options.All(o => !string.IsNullOrWhiteSpace(o.ImageUrl) && string.IsNullOrWhiteSpace(o.Text));
                                string gridClassR = allImgOnlyR ? "img-grid" : "";
                            }
                            <div class="hw-options @gridClassR" id="hw-options-list">
                                @foreach (var opt in q.Options)
                                {
                                    bool isSelected = opt.IsSelected ||
                                        (!string.IsNullOrWhiteSpace(Model.SelectedAnswer) &&
                                         string.Equals(opt.Text, Model.SelectedAnswer, StringComparison.OrdinalIgnoreCase));

                                    <label class="hw-option @(isSelected ? "selected" : "")"
                                           role="radio"
                                           aria-checked="@isSelected.ToString().ToLower()">
                                        <input type="radio"
                                               name="SelectedOption"
                                               value="@opt.Text"
                                               @(isSelected ? "checked" : "")
                                               tabindex="0" />
                                        <span class="hw-radio" aria-hidden="true"></span>
                                        @if (!string.IsNullOrWhiteSpace(opt.ImageUrl) && string.IsNullOrWhiteSpace(opt.Text))
                                        {
                                            <img src="@Url.Content(opt.ImageUrl)" class="hw-option-img" alt="" loading="lazy" />
                                        }
                                        else
                                        {
                                            <span class="hw-option-text">@Html.Raw(htmlConvert(opt.Text ?? ""))</span>
                                        }
                                    </label>
                                }
                            </div>
                        </div>
                    </div>
                </form>
            }
            else
            {
                <form method="post" id="homework-question-form"
                      data-homework-id="@Model.HomeworkSetId"
                      data-current-question-id="@Model.CurrentQuestionId">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.HomeworkSetId" />
                    <input type="hidden" name="q" value="@Model.CurrentQuestionId" />
                    <input type="hidden" name="AllIds" value="@string.Join(",", Model.AllQuestionIds)" />
                </form>
            }

        </div>

        <!-- Bottom Nav -->
        <nav class="hw-navbar">
            <div></div>
            <button id="submitHomework" class="hw-btn hw-btn-success">
                ✔ @T("إنهاء وتسليم الواجب")
            </button>
            <div></div>
        </nav>
    </div>
}
else
{
    @* ============================================================
       NORMAL SOLVE MODE
    ============================================================ *@
    <div class="hw-page @(isRTL ? "" : "ltr")" dir="@(isRTL ? "rtl" : "ltr")">

        <!-- Top Bar -->
        <header class="hw-topbar">
            <div class="hw-topbar-title">@T("السؤال")</div>

            <div class="hw-counter">
                <span class="hw-counter-badge">
                    @T("السؤال") @Html.Raw(htmlConvert(Model.CurrentIndex.ToString()))
                    @T("من") @Html.Raw(htmlConvert(Model.Total.ToString()))
                </span>
            </div>

            <!-- Progress dots (max 20 shown) -->
            @if (Model.AllQuestionIds.Count <= 20)
            {
                <div class="hw-progress-dots" aria-hidden="true">
                    @for (int i = 0; i < Model.AllQuestionIds.Count; i++)
                    {
                        var qid = Model.AllQuestionIds[i];
                        var hasAns = Model.AnswersMap.TryGetValue(qid, out var ans2) && !string.IsNullOrWhiteSpace(ans2);
                        var isMarked = Model.ReviewMarkedIds.Contains(qid);
                        var isCurrent = qid == Model.CurrentQuestionId;
                        string dc = isCurrent ? "current" : isMarked ? "marked" : hasAns ? "answered" : "";
                        <span class="hw-dot @dc"></span>
                    }
                </div>
            }

            <div class="hw-circular-timer" id="hw-timer-display" title="الوقت المستغرق">
                <svg viewBox="0 0 48 48" width="56" height="56">
                    <circle class="hw-ct-track" cx="24" cy="24" r="20"/>
                    <circle class="hw-ct-ring"  cx="24" cy="24" r="20" id="hw-timer-ring"/>
                </svg>
                <span class="hw-ct-text" id="hw-timer-val">00:00</span>
            </div>
        </header>

        <!-- Scrollable content -->
        <div class="hw-scroll">

            <form method="post"
                  id="homework-question-form"
                  data-homework-id="@Model.HomeworkSetId"
                  data-current-question-id="@Model.CurrentQuestionId">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.HomeworkSetId" />
                <input type="hidden" name="q" value="@Model.CurrentQuestionId" />
                <input type="hidden" name="AllIds" value="@string.Join(",", Model.AllQuestionIds)" />

                @* ── Verbal Passage ── *@
                @if (q.VerbalPassageType == PassageType.Audio && !string.IsNullOrWhiteSpace(q.VerbalPassageMediaUrl))
                {
                    <div class="hw-audio-wrapper">
                        <div class="hw-audio-label">
                            🎧 @(isRTL ? "القطعة الصوتية" : "Audio Passage")
                            @if (!string.IsNullOrWhiteSpace(q.VerbalPassageTitle))
                            {
                                <span> — @q.VerbalPassageTitle</span>
                            }
                        </div>
                        <audio controls controlslist="nodownload"
                               @(q.VerbalPassageRequireFullListen ? "onended=\"this.dataset.done='1'\"" : "")>
                            @if (q.PassageStartSeconds.HasValue || q.PassageEndSeconds.HasValue)
                            {
                                <source src="@q.VerbalPassageMediaUrl#t=@(q.PassageStartSeconds ?? 0),@(q.PassageEndSeconds ?? 0)" />
                            }
                            else
                            {
                                <source src="@q.VerbalPassageMediaUrl" />
                            }
                        </audio>
                    </div>
                }
                else if (q.VerbalPassageType == PassageType.Video && !string.IsNullOrWhiteSpace(q.VerbalPassageMediaUrl))
                {
                    <div class="hw-audio-wrapper">
                        <div class="hw-audio-label">🎥 @(isRTL ? "القطعة المرئية" : "Video Passage")</div>
                        <video controls style="width:100%; border-radius:8px; max-height:280px;">
                            <source src="@q.VerbalPassageMediaUrl" />
                        </video>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(q.VerbalPassageContent))
                {
                    <div class="hw-passage">
                        <div class="hw-passage-title">
                            📖
                            @if (!string.IsNullOrWhiteSpace(q.VerbalPassageTitle))
                            {
                                @q.VerbalPassageTitle
                            }
                            else
                            {
                                @T("القطعة اللفظية")
                            }
                        </div>
                        <div class="hw-passage-text">
                            @Html.Raw(htmlConvert(q.VerbalPassageContent))
                        </div>
                    </div>
                }

                @* ── Question Card ── *@
                <div class="hw-qcard">
                    <div class="hw-qtitle">
                        @Html.Raw(htmlConvert(q.Title ?? ""))
                    </div>

                    <div class="hw-qbody">

                        @* ── Question body by type ── *@
                        @switch (q.DisplayType)
                        {
                            case QuestionDisplayType.WithImage:
                                if (!string.IsNullOrWhiteSpace(q.ImageUrl))
                                {
                                    <div class="hw-qimage">
                                        <img src="@Url.Content(q.ImageUrl)" alt="" loading="lazy" />
                                    </div>
                                }
                                break;

                            case QuestionDisplayType.ComparisonText:
                                <div class="hw-comparison">
                                    <div class="hw-cmp-box">
                                        <div class="hw-cmp-label">@T("القيمة الأولى")</div>
                                        <div class="hw-cmp-val">@Html.Raw(htmlConvert(q.ComparisonValue1 ?? ""))</div>
                                    </div>
                                    <div class="hw-cmp-divider">⟷</div>
                                    <div class="hw-cmp-box">
                                        <div class="hw-cmp-label">@T("القيمة الثانية")</div>
                                        <div class="hw-cmp-val">@Html.Raw(htmlConvert(q.ComparisonValue2 ?? ""))</div>
                                    </div>
                                </div>
                                break;

                            case QuestionDisplayType.ComparisonWithImage:
                                <div class="hw-comparison">
                                    <div class="hw-cmp-box">
                                        <div class="hw-cmp-label">@T("القيمة الأولى")</div>
                                        <div class="hw-cmp-val">@Html.Raw(htmlConvert(q.ComparisonValue1 ?? ""))</div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(q.ImageUrl))
                                    {
                                        <div class="hw-cmp-img">
                                            <img src="@Url.Content(q.ImageUrl)" alt="" loading="lazy" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="hw-cmp-divider">⟷</div>
                                    }
                                    <div class="hw-cmp-box">
                                        <div class="hw-cmp-label">@T("القيمة الثانية")</div>
                                        <div class="hw-cmp-val">@Html.Raw(htmlConvert(q.ComparisonValue2 ?? ""))</div>
                                    </div>
                                </div>
                                break;
                        }

                        @* ── Options ── *@
                        @{
                            bool allImgOnly = q.Options.All(o => !string.IsNullOrWhiteSpace(o.ImageUrl) && string.IsNullOrWhiteSpace(o.Text));
                            string gridClass = allImgOnly ? "img-grid" : "";
                        }
                        <div class="hw-options @gridClass" id="hw-options-list">
                            @foreach (var opt in q.Options)
                            {
                                bool isSelected = opt.IsSelected ||
                                    (!string.IsNullOrWhiteSpace(Model.SelectedAnswer) &&
                                     string.Equals(opt.Text, Model.SelectedAnswer, StringComparison.OrdinalIgnoreCase));

                                <label class="hw-option @(isSelected ? "selected" : "")"
                                       role="radio"
                                       aria-checked="@isSelected.ToString().ToLower()">
                                    <input type="radio"
                                           name="SelectedOption"
                                           value="@opt.Text"
                                           @(isSelected ? "checked" : "")
                                           tabindex="0" />
                                    <span class="hw-radio" aria-hidden="true"></span>

                                    @if (!string.IsNullOrWhiteSpace(opt.ImageUrl) && string.IsNullOrWhiteSpace(opt.Text))
                                    {
                                        <img src="@Url.Content(opt.ImageUrl)" class="hw-option-img" alt="" loading="lazy" />
                                    }
                                    else if (!string.IsNullOrWhiteSpace(opt.ImageUrl))
                                    {
                                        <div style="display:flex;align-items:center;gap:10px;flex:1">
                                            <img src="@Url.Content(opt.ImageUrl)" class="hw-option-img" alt="" loading="lazy"
                                                 style="max-height:80px;" />
                                            <span class="hw-option-text">@Html.Raw(htmlConvert(opt.Text ?? ""))</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="hw-option-text">@Html.Raw(htmlConvert(opt.Text ?? ""))</span>
                                    }
                                </label>
                            }
                        </div>

                    </div><!-- /.hw-qbody -->
                </div><!-- /.hw-qcard -->

            </form>
        </div><!-- /.hw-scroll -->

        <!-- ── Bottom Navigation ── -->
        <nav class="hw-navbar" role="navigation">

            <button type="button"
                    class="hw-btn hw-btn-ghost homework-nav-button"
                    data-nav="prev"
                    @(Model.CurrentIndex == 1 ? "disabled" : "")
                    aria-label="@T("السابق")">
                @(isRTL ? "▶" : "◀") @T("السابق")
            </button>

            <button type="button"
                    class="hw-btn hw-btn-warning @(Model.ReviewMarkedIds.Contains(Model.CurrentQuestionId) ? "marked" : "") homework-nav-button"
                    id="hw-mark-btn"
                    data-nav="review"
                    aria-label="@T("ضع علامة للمراجعة")">
                🔖 @T("ضع علامة للمراجعة")
            </button>

            @if (!isLastQuestion)
            {
                <button type="button"
                        class="hw-btn hw-btn-primary homework-nav-button"
                        data-nav="next"
                        aria-label="@T("التالي")">
                    @T("التالي") @(isRTL ? "◀" : "▶")
                </button>
            }
            else
            {
                <button type="button"
                        class="hw-btn hw-btn-success homework-nav-button"
                        data-nav="showReview"
                        aria-label="@T("مراجعة سريعة للأسئلة")">
                    📋 @T("مراجعة سريعة للأسئلة")
                </button>
            }

        </nav>

    </div>
}

<!-- ============================================================
     JAVASCRIPT (Stopwatch + Option UI + Timer state)
============================================================ -->
<script>
(function () {

    /* ── Stopwatch — فقط كـ fallback إذا لم يكن HWManager موجوداً ── */
    let _timerEl   = document.getElementById('hw-timer-val');
    let _timerDisp = document.getElementById('hw-timer-display');
    let _timerInterval = null;

    function _startTimer() {
        if (!_timerEl) return;
        if (_timerInterval) clearInterval(_timerInterval);

        const startMs = window.HomeworkState?.questionStartTime ?? Date.now();
        const ring = document.getElementById('hw-timer-ring');

        // fire immediately so display is correct on first second
        function _tick() {
            const elapsed = Math.floor((Date.now() - startMs) / 1000);
            const m = Math.floor(elapsed / 60).toString().padStart(2, '0');
            const s = (elapsed % 60).toString().padStart(2, '0');
            _timerEl.textContent = m + ':' + s;

            // animate SVG ring: fills over 2 minutes (circumference = 125.66)
            if (ring) {
                const pct = Math.min(elapsed / 120, 1);
                ring.style.strokeDashoffset = (125.66 * (1 - pct)).toFixed(2);
            }

            if (elapsed > 120 && _timerDisp) _timerDisp.classList.add('warning');
        }

        _tick();
        _timerInterval = setInterval(_tick, 1000);
    }

    /* ── Indic numerals ── */
    @if (Model.IsQuantitative || Model.UseIndicNumbers)
    {
        <text>
    (function convertToIndic() {
        const map = { '0':'٠','1':'١','2':'٢','3':'٣','4':'٤','5':'٥','6':'٦','7':'٧','8':'٨','9':'٩' };
        function walk(node) {
            if (node.nodeType === 3) {
                node.nodeValue = node.nodeValue.replace(/[0-9]/g, d => map[d]);
            } else if (!['SCRIPT','STYLE','INPUT','TEXTAREA'].includes(node.nodeName)) {
                node.childNodes.forEach(walk);
            }
        }
        const container = document.querySelector('.hw-page');
        if (container) walk(container);
    })();
        </text>
    }

    /* ── Init ── */
    // HWManager يتحكم في الـ Timer — الـ Partial يبدأ فقط كـ fallback
    const _hwIsPresent = typeof window.HWManager !== 'undefined';

    function _boot() {
        if (!_hwIsPresent) _startTimer();
        // تهيئة الخيارات والعلامات يعالجها HWManager عبر _restoreAnswerInDOM و _refreshMarkButton
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', _boot);
    } else {
        _boot();
    }

    // expose للـ Start.cshtml (fallback إذا لم يكن HWManager)
    window._hwRestartTimer = _hwIsPresent ? window._hwRestartTimer : _startTimer;

})();
</script>
