@inject QdratNew.Interfaces.IUserAccountDropdownService AccountDropdownService
@using QdratNew.Data

@inject QdratNew.Services.Interfaces.IUserContextService UserContext
@inject QdratNew.Interfaces.IUserPartnerDropdownService PartnerDropdownService

@using QdratNew.Helpers



@{
    var activePartnerId = Context.Session.GetInt32("ActivePartnerId");

 
}
@{
    var partnerDropdown =
        await PartnerDropdownService.GetAsync(
            User,
            Context.Session.GetInt32("ActivePartnerId")
        );
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>لوحة الشريك</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/partnerdatatable.css" rel="stylesheet" />
    <style>
        :root {
            --partner-main: #da784d;
            --partner-dark: #c5663d;
            --bg-light: #f5f7fa;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: var(--bg-light);
            margin: 0;
        }

        /* ===== Sidebar ===== */
        .partner-sidebar {
            position: fixed;
            right: 0;
            top: 0;
            width: 260px;
            height: 100vh;
            background: linear-gradient(180deg, var(--partner-main), var(--partner-dark));
            padding: 20px;
            color: #fff;
        }

        /* ===== Brand ===== */
        .partner-brand {
            background: rgba(255,255,255,.15);
            border-radius: 18px;
            padding: 16px;
            margin-bottom: 30px;
            text-align: center;
        }

        .platform-logo img {
            max-height: 55px;
            background: #fff;
            padding: 8px 12px;
            border-radius: 14px;
            margin-bottom: 12px;
        }

        .partner-logo-box {
            background: #fff;
            border-radius: 14px;
            padding: 10px;
        }

            .partner-logo-box img {
                max-height: 42px;
                display: block;
                margin: 0 auto 6px;
            }

        .partner-name {
            font-size: 13px;
            font-weight: 600;
            color: #555;
        }

        /* ===== Menu ===== */
        .partner-sidebar a {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #fff;
            text-decoration: none;
            padding: 12px 16px;
            border-radius: 12px;
            margin-bottom: 6px;
            transition: .25s;
        }

            .partner-sidebar a:hover,
            .partner-sidebar a.active {
                background: rgba(255,255,255,.22);
            }

        /* ===== Content ===== */
        .partner-content {
            margin-right: 260px;
            padding: 30px;
        }

        /* ===== Topbar ===== */
        .partner-topbar {
            background: #fff;
            padding: 14px 20px;
            border-radius: 16px;
            box-shadow: 0 4px 12px rgba(0,0,0,.05);
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

            .partner-topbar img {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                object-fit: cover;
            }

        /* ===== Mobile ===== */
        @@media (max-width: 768px) {
            .partner-sidebar

        {
            transform: translateX(100%);
        }

        .partner-content {
            margin-right: 0;
        }

        }




        /* ===============================
   Partner Sidebar – Compact Mode
   =============================== */

.partner-sidebar {
    display: flex;
    flex-direction: column;
    gap: 8px;                 /* تقليل المسافة بين العناصر */
    padding: 8px 6px;
    font-size: 16px;          /* تصغير الخط */
}

/* الروابط */
.partner-sidebar a {
    display: flex;
    align-items: center;
    gap: 8px;                 /* مسافة صغيرة بين الأيقونة والنص */
    padding: 6px 10px;         /* تقليل ارتفاع الرابط */
    border-radius: 6px;
    line-height: 1.2;
}

/* الأيقونات */
.partner-sidebar a i {
    font-size: 16px;          /* تصغير الأيقونة */
    min-width: 18px;
    text-align: center;
}

/* عناوين الأقسام */
.partner-sidebar .sidebar-section {
    margin-top: 6px;
}

.partner-sidebar .sidebar-section-title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 16px;
    font-weight: 600;
    color: #6c757d;
    padding: 4px 8px;
    margin-bottom: 2px;
}

/* روابط داخل الأقسام */
.partner-sidebar .sidebar-section a {
    padding: 5px 8px;
    font-size: 13px;
}

/* Hover */
.partner-sidebar a:hover {
    background-color: rgba(0, 0, 0, 0.05);
}

/* Active (اختياري) */
        .partner-sidebar a.active {
            background-color: #e9f2ff;
            color: #0d6efd;
        }

        .partner-sidebar-logo img {
            max-width: 100%;
            display: block;
            margin: 0 auto;
        }

    </style>
</head>

<body>


    @await Component.InvokeAsync("PartnerSidebar")


    <div class="partner-content">
        <header class="partner-topbar">
          



            @inject QdratNew.Services.Interfaces.IUserContextService UserContext

            @if (UserContext.HasMultipleRoles)
            {
                <form asp-area="Identity"
                      asp-page="/Account/SwitchRole"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <select name="role"
                            class="form-select form-select-sm"
                            style="min-width:150px"
                            onchange="this.form.submit()">

                        @foreach (var role in UserContext.AvailableRoles)
                        {
                            <option value="@role"
                                    selected="@(role == UserContext.ActiveRole)">
                                @(RoleNamesHelper.RoleDisplay.ContainsKey(role)
                                                        ? RoleNamesHelper.RoleDisplay[role]
                                                        : role)
                    </option>
                                        }
                    </select>
                </form>
            }



            <div class="align-items-start">
                @await Component.InvokeAsync("PartnerTopbar")
            </div>
        </header>
        @{
            var account = await AccountDropdownService.GetDropdownViewModelAsync(User);
        }
      


        <main>
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>
