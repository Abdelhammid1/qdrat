@model QdratNew.ViewModels.Students.StudentActivityLogViewModel
@using QdratNew.Enums

<div class="card mb-2 shadow-sm border-@(Model.WasCorrect == false ? "danger" : Model.WasCorrect == true ? "success" : "secondary")" style="font-size: 0.85rem;">
    <div class="card-body py-3 px-3">

        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="badge bg-dark text-white px-2 py-1" style="font-size: 0.7rem;">
                @(Model.ActivityType switch {
                    StudentActivityType.Homework => "📘 واجب",
                    StudentActivityType.Exam => "📝 اختبار",
                    StudentActivityType.Video => "🎥 فيديو",
                    StudentActivityType.Lesson => "📚 درس",
                    _ => "⚙️ نشاط"
                })
            </span>
            <span class="text-muted small">@Model.Timestamp.ToString("yyyy/MM/dd hh:mm tt")</span>
        </div>

        <h6 class="mb-2 text-success" style="font-size: 0.95rem;">
            @if (Model.ActivityType == StudentActivityType.Homework)
            {
                @Html.Raw($"💡 حل سؤال: {Model.ActivityTitle}")
            }
            else if (Model.ActivityType == StudentActivityType.Exam)
            {
                @Html.Raw($"📌 اختبار: {Model.ActivityTitle}")
            }
            else
            {
                @Html.Raw(Model.ActivityTitle)
            }
        </h6>

        @if (!string.IsNullOrEmpty(Model.SectionTitle) || !string.IsNullOrEmpty(Model.LessonTitle))
        {
            <div class="mb-2 text-muted">
                @if (!string.IsNullOrEmpty(Model.SectionTitle))
                {
                    <div><strong>المحور:</strong> @Model.SectionTitle</div>
                }
                @if (!string.IsNullOrEmpty(Model.LessonTitle))
                {
                    <div><strong>المؤشر:</strong> @Model.LessonTitle</div>
                }
            </div>
        }

        @if (Model.WasCorrect.HasValue)
        {
            <div class="mb-1">
                <strong>النتيجة:</strong>
                @if (Model.WasCorrect.Value)
                {
                    <span class="text-success">✔️ إجابة صحيحة</span>
                }
                else
                {
                    <span class="text-danger">❌ إجابة خاطئة</span>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.StudentAnswer) || !string.IsNullOrWhiteSpace(Model.CorrectAnswer))
        {
            <div class="mb-2 px-3 py-2 rounded" style="background-color: #f9f9f9; font-size: 0.85rem; border: 1px dashed #ccc;">
              @if (!string.IsNullOrWhiteSpace(Model.StudentAnswer) && Model.WasCorrect == false)
{
    <div>
        <span class="text-danger">❌ <strong>إجابتك:</strong> @Html.Raw(Model.StudentAnswer)</span>
    </div>
}
@if (!string.IsNullOrWhiteSpace(Model.CorrectAnswer))
{
    <div>
        <span class="text-success">✔ <strong>الإجابة الصحيحة:</strong> @Html.Raw(Model.CorrectAnswer)</span>
    </div>
}

            </div>
        }

        @if (Model.Score.HasValue)
        {
            <div class="mb-1">
                <strong>الدرجة:</strong> @Model.Score.Value%
            </div>
        }

        @if (Model.ActivityType is StudentActivityType.Homework or StudentActivityType.Exam)
        {
            <div class="rounded mt-2 px-3 py-2 text-center text-dark" style="background-color: #d9f0f0;">
                @(Model.ActivityType == StudentActivityType.Exam && !(Model.Source?.ToLower().Contains("mock") ?? false)
                    ? "🧑‍🏫 تم الحل داخل المعهد"
                    : "🌐 تم الحل أونلاين")
            </div>
        }

        @if (Model.IsPredictedWeakness)
        {
            <div class="alert alert-danger mt-2 p-2 mb-1">
                <i class="bi bi-exclamation-triangle-fill"></i>
                تم رصد نقطة ضعف بواسطة الذكاء الاصطناعي.
            </div>
        }

    </div>
</div>
