@model QdratNew.ViewModels.Students.StudentNewsTickerViewModel

<div class="alert px-3 py-2 mb-3 ticker-bar overflow-hidden position-relative rounded shadow-sm"
     style="height: 45px; background-color: #339999; color: white;">
    <div class="ticker-content d-flex align-items-center" style="white-space: nowrap; animation: scroll-left 20s linear infinite;">
        @foreach (var note in Model.Notifications)
        {
            <a href="#" class="news-link me-5 text-white text-decoration-none">
                📢 @note
            </a>
        }
    </div>
</div>


