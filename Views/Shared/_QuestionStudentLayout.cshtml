    <!-- jQuery -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>

    <!-- Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- سكربت تصغير الشريط الجانبي -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggleBtn = document.getElementById("toggleSidebar");
            const sidebar = document.querySelector(".sidebar");

            if (toggleBtn && sidebar) {
                toggleBtn.addEventListener("click", function () {
                    sidebar.classList.toggle("collapsed-sidebar");

                    const icon = toggleBtn.querySelector("i");
                    if (sidebar.classList.contains("collapsed-sidebar")) {
                        icon.classList.remove("fa-angle-double-left");
                        icon.classList.add("fa-angle-double-right");
                    } else {
                        icon.classList.add("fa-angle-double-left");
                        icon.classList.remove("fa-angle-double-right");
                    }
                });
            }
        });
    </script>

    <!-- Scripts من الصفحات -->
    @RenderSection("Scripts", required: false)

    @await Html.PartialAsync("_TranslationGuardOverlay")
    <script src="~/js/translation-guard.js"></script>

    <!-- 🥇 jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/numeric-converter.js"></script>
    <script>
        function applyIndicNumbersNow() {
            if (!window.enableIndicNumbers) return;

            const map = {
                '0': '٠',
                '1': '١',
                '2': '٢',
                '3': '٣',
                '4': '٤',
                '5': '٥',
                '6': '٦',
                '7': '٧',
                '8': '٨',
                '9': '٩'
            };

            function walk(node) {
                if (node.nodeType === Node.TEXT_NODE) {
                    node.nodeValue = node.nodeValue.replace(/\d/g, d => map[d]);
                    return;
                }
                node.childNodes.forEach(walk);
            }

            walk(document.body);
        }

        // 🔹 عند أول تحميل
        document.addEventListener("DOMContentLoaded", applyIndicNumbersNow);

        // 🔹 عند أي ضغط زر داخل الصفحة
        document.addEventListener("click", function (e) {
            if (e.target.closest(".homework-nav-button")) {
                setTimeout(applyIndicNumbersNow, 50);
            }
        });
    </script>


</body>
</html>
