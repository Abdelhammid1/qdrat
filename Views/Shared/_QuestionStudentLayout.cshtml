         @*    <div class="offcanvas-body p-0 text-white">
                @Html.Partial("_StudentMenuPartial")
            </div> *@
        </div>

     @*    <!-- Sidebar ديسكتوب ثابت -->
        <div class="sidebar d-none d-lg-flex flex-column">
            @Html.Partial("_StudentMenuPartial")
        </div> *@

        <!-- المحتوى الرئيسي -->
