<!-- ✅ مودال الكسر -->
<div class="modal fade" id="fractionModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title">➕ إدخال كسر</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label>البسط</label>
                <input type="text" id="numeratorInput" class="form-control mb-3" />
                <label>المقام</label>
                <input type="text" id="denominatorInput" class="form-control mb-3" />
                <label>📌 المعاينة:</label>
                <div id="fractionPreview" class="border rounded bg-light p-3 mb-3"></div>
                <button class="btn btn-primary" onclick="insertStyledFraction()">إدراج الكسر</button>
            </div>
        </div>
    </div>
</div>

<!-- ✅ مودال الجذر -->
<div class="modal fade" id="rootModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title">√ إدخال جذر</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label>القيمة داخل الجذر</label>
                <input type="text" id="rootValue" class="form-control mb-3" />
                <label>نوع الجذر</label>
                <select id="rootType" class="form-select mb-3">
                    <option value="2">جذر تربيعي</option>
                    <option value="3">جذر تكعيبي</option>
                </select>
                <label>📌 المعاينة:</label>
                <div id="rootPreview" class="border rounded bg-light p-3 mb-3"></div>
                <button class="btn btn-primary" onclick="insertRoot()">إدراج الجذر</button>
            </div>
        </div>
    </div>
</div>
<!-- ✅ مودال الجذر المتداخل -->
<!-- ✅ مودال الجذر المتداخل -->
<div class="modal fade" id="nestedRootModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title">🌲 إدخال جذر متداخل</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="nestedRootsContainer" class="mb-3"></div>
                <button type="button" class="btn btn-outline-secondary mb-3" onclick="addRootLevel()">
                    ➕ إضافة مستوى جذر
                </button>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="mb-0">📌 المعاينة:</label>
                    <button class="btn btn-sm btn-outline-secondary" onclick="generateNestedRootPreview()">🔍 معاينة</button>
                </div>
                <div id="nestedRootPreview" class="border rounded p-2 bg-light mb-3"></div>
                <button class="btn btn-primary" onclick="insertNestedRoot()">إدراج الجذر المتداخل</button>
            </div>
        </div>
    </div>
</div>

<!-- ✅ مودال الأس -->
<div class="modal fade" id="exponentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title">🡱 إدخال أُس</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label>الأساس</label>
                <input type="text" id="baseInput" class="form-control mb-3" />
                <label>الأس</label>
                <input type="text" id="exponentInput" class="form-control mb-3" />
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="mb-0">📌 المعاينة:</label>
                    <button class="btn btn-sm btn-outline-secondary" onclick="updateExponentPreview()">🔍 معاينة</button>
                </div>
                <div id="exponentPreview" class="border rounded p-2 bg-light mb-3"></div>
                <button class="btn btn-primary" onclick="insertExponent()">إدراج الأُس</button>
            </div>
        </div>
    </div>
</div>

<!-- ✅ مودال الجذر + أُس -->
<div class="modal fade" id="rootWithExponentModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title">🌿 إدخال جذر + أُس</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label>القيمة داخل الجذر</label>
                <input type="text" id="rootBaseValue" class="form-control mb-3" />
                <label>الأس</label>
                <input type="text" id="rootExponentValue" class="form-control mb-3" />
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="mb-0">📌 المعاينة:</label>
                    <button class="btn btn-sm btn-outline-secondary" onclick="updateRootWithExponentPreview()">🔍 معاينة</button>
                </div>
                <div id="rootWithExponentPreview" class="border rounded p-2 bg-light mb-3"></div>
                <button class="btn btn-primary" onclick="insertRootWithExponent()">إدراج جذر + أُس</button>
            </div>
        </div>
    </div>
</div>

