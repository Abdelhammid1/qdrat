@model List<QdratNew.ViewModels.Exam.ExamListVm>

<table class="table table-striped align-middle text-center mb-0 w-100">
    <thead class="table-light">
        <tr>
            <th>العنوان</th>
            <th>تاريخ الإرسال</th>
            <th>الموعد</th>
            <th>النتيجة</th>
            <th>الحالة</th>
            <th>الإجراء</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var exam in Model)
        {
            <tr>
                <td class="fw-bold">@exam.Title</td>

                <td>@exam.AssignedAt.ToString("yyyy/MM/dd HH:mm")</td>

                <td>@exam.ScheduledDate?.ToString("yyyy/MM/dd HH:mm") ?? "—"</td>

                <td>
                    @if (exam.IsSubmitted)
                    {
                        <span class="badge bg-success px-3 py-2">
                            ٪ @Math.Round((double)exam.Score, 1)
                        </span>
                    }

                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>

                <td>
                    <span class="badge bg-info px-3 py-2">@exam.StatusText</span>
                </td>

                <td>
                    @if (exam.StatusText == "متاح الآن")
                    {
                        <a asp-action="StartExam"
                           asp-route-examAssignmentId="@exam.ExamAssignmentId"
                           asp-route-examId="@exam.ExamId"
                           class="btn btn-sm btn-success w-100">
                            بدء الآن
                        </a>
                    }
                    else if (exam.IsSubmitted)
                    {
                        <a asp-action="ExamResult"
                           asp-route-id="@exam.ExamAssignmentId"
                           class="btn btn-sm btn-outline-primary w-100">
                            النتيجة
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-secondary w-100" disabled>@exam.StatusText</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
