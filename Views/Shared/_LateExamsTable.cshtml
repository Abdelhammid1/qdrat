@model List<QdratNew.ViewModels.Exam.StudentExamCardViewModel>

<table class="table table-striped align-middle text-center late-exams-table">
    <thead class="table-light">
        <tr>
            <th>العنوان</th>
            <th class="d-none d-md-table-cell">وقت البدء</th>
            <th class="d-none d-md-table-cell">وقت الانتهاء</th>
            <th class="d-none d-md-table-cell">الحالة</th>
            <th>التحكم</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var exam in Model)
        {
            var start = exam.ScheduledDate ?? exam.AssignedAt;
            var end = exam.EndAt ?? start.AddMinutes(exam.DurationMinutes);

            // ===============================
            // 🟢 StatusText SAFE handling
            // ===============================
            var status = exam.StatusText ?? "متأخر";
            string cls = "bg-secondary";

            if (status == "متأخر")
                cls = "bg-danger text-white";
            else if (status.Contains("سيتأخر"))
                cls = "bg-warning text-dark";
            else if (status == "قادِم")
                cls = "bg-info text-white";

            <tr>

                <!-- العنوان -->
                <td data-label="العنوان" class="fw-bold">
                    @exam.Title
                </td>

                <!-- وقت البدء -->
                <td class="d-none d-md-table-cell" data-label="وقت البدء">
                    @start.ToString("yyyy/MM/dd HH:mm")
                </td>

                <!-- وقت الانتهاء -->
                <td class="d-none d-md-table-cell" data-label="وقت الانتهاء">
                    @end.ToString("yyyy/MM/dd HH:mm")
                </td>

                <!-- الحالة -->
                <td class="d-none d-md-table-cell" data-label="الحالة">
                    <span class="badge @cls px-3 py-2">
                        @status
                    </span>
                </td>

                <!-- التحكم -->
                <td data-label="التحكم">
                    <a asp-area="Students"
                       asp-controller="StudentExamFlow"
                       asp-action="StartExam"
                       asp-route-examAssignmentId="@exam.ExamAssignmentId"
                       class="btn btn-sm btn-outline-primary rounded-pill px-4">
                        بدء الحل
                    </a>
                </td>

            </tr>
        }
    </tbody>
</table>

@section Styles {
    <style>
        /* ======== تصميم الموبايل ======== */
        @@media (max-width: 768px) {

            .late-exams-table thead {
                display: none !important;
            }

            .late-exams-table tbody tr {
                display: block !important;
                margin-bottom: 1rem;
                border: 1px solid #e3e3e3;
                padding: 12px;
                border-radius: 10px;
                background: #fff;
                box-shadow: 0 2px 6px rgba(0,0,0,0.08);
                text-align: right !important;
            }

            .late-exams-table tbody td {
                display: flex !important;
                justify-content: space-between !important;
                padding: 6px 0 !important;
                border: none !important;
                font-size: 14px;
            }

                .late-exams-table tbody td::before {
                    content: attr(data-label);
                    font-weight: bold;
                    color: #1ba098;
                    font-size: 14px;
                }

            td[data-label="العنوان"] {
                font-size: 1.05rem;
                color: #1ba098;
                font-weight: bold;
                padding-top: 6px;
            }

            td[data-label="التحكم"] .btn {
                width: 100%;
                padding: 10px;
                font-size: 14px;
                margin-top: 6px;
            }
        }
    </style>
}
