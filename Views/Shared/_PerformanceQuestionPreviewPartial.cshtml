@model QdratNew.ViewModels.Question.QuestionDisplayViewModel
@using EntQuestionTemplate = QdratNew.Enums.QuestionTemplate
@using QdratNew.Helpers

<div class="container-fluid py-3" dir="rtl" style="max-width: 900px;">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body">

            <!-- 🟦 عنوان السؤال -->
            <h5 class="fw-bold text-primary mb-3">
                <i class="bi bi-question-circle"></i> نص السؤال
            </h5>
            <div class="p-3 border rounded bg-light mb-3">
                @Html.Raw(NumberHelper.ToIndicNumbersSafe(Model.Title ?? "—"))
            </div>

            <!-- 🟢 القيمتين للمقارنة (إن وجدت) -->
            <!-- 🟢 القيمتين للمقارنة (إن وجدت) -->
            @if (!string.IsNullOrEmpty(Model.ComparisonValue1) || !string.IsNullOrEmpty(Model.ComparisonValue2))
            {
                <div class="row text-center mb-4">
                    <div class="col-md-6 mb-3">
                        <div class="border rounded bg-white p-3 shadow-sm">
                            <strong class="text-secondary d-block mb-2">القيمة (A)</strong>
                            @{
                                bool isImageA = Model.ComparisonValue1?.StartsWith("http", StringComparison.OrdinalIgnoreCase) == true
                                && (Model.ComparisonValue1.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase)
                                || Model.ComparisonValue1.EndsWith(".png", StringComparison.OrdinalIgnoreCase)
                                || Model.ComparisonValue1.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase)
                                || Model.ComparisonValue1.EndsWith(".webp", StringComparison.OrdinalIgnoreCase));
                            }
                            @if (isImageA)
                            {
                                <img src="@Model.ComparisonValue1" class="img-fluid rounded" style="max-height:150px;" />
                            }
                            else
                            {
                                <span>@Html.Raw(NumberHelper.ToIndicNumbersSafe(Model.ComparisonValue1 ?? "—"))</span>
                            }
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="border rounded bg-white p-3 shadow-sm">
                            <strong class="text-secondary d-block mb-2">القيمة (B)</strong>
                            @{
                                bool isImageB = Model.ComparisonValue2?.StartsWith("http", StringComparison.OrdinalIgnoreCase) == true
                                && (Model.ComparisonValue2.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase)
                                || Model.ComparisonValue2.EndsWith(".png", StringComparison.OrdinalIgnoreCase)
                                || Model.ComparisonValue2.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase)
                                || Model.ComparisonValue2.EndsWith(".webp", StringComparison.OrdinalIgnoreCase));
                            }
                            @if (isImageB)
                            {
                                <img src="@Model.ComparisonValue2" class="img-fluid rounded" style="max-height:150px;" />
                            }
                            else
                            {
                                <span>@Html.Raw(NumberHelper.ToIndicNumbersSafe(Model.ComparisonValue2 ?? "—"))</span>
                            }
                        </div>
                    </div>
                </div>
            }
            <!-- 🟨 صورة السؤال إن وجدت -->
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="text-center mb-4">
                    <img src="@Model.ImageUrl" alt="صورة السؤال" class="img-fluid rounded shadow-sm" style="max-height:200px;" />
                </div>
            }

            <!-- 🟪 عرض الخيارات -->
            @if (Model.Options != null && Model.Options.Any())
            {
                <h6 class="fw-bold text-secondary mb-3">
                    <i class="bi bi-list-ul"></i> الخيارات:
                </h6>
                <ul class="list-group mb-4">
                    @foreach (var opt in Model.Options)
                    {
                        var isCorrect = opt.Text?.Trim() == Model.CorrectAnswer?.Trim();
                        <li class="list-group-item d-flex align-items-center justify-content-between">
                            <div>
                                @if (!string.IsNullOrEmpty(opt.ImageUrl))
                                {
                                    <img src="@opt.ImageUrl" class="img-thumbnail me-2" style="max-height:60px;" />
                                }
                                @Html.Raw(NumberHelper.ToIndicNumbersSafe(opt.Text ?? ""))
                            </div>
                            @if (isCorrect)
                            {
                                <span class="badge bg-success rounded-pill">
                                    <i class="bi bi-check-circle"></i> الإجابة الصحيحة
                                </span>
                            }
                        </li>
                    }
                </ul>
            }

            <!-- 🟧 التفسير أو الفيديو -->
            @if (!string.IsNullOrEmpty(Model.Explanation) || !string.IsNullOrEmpty(Model.VideoUrl))
            {
                <div class="border-top pt-3 mt-4">
                    @if (!string.IsNullOrEmpty(Model.Explanation))
                    {
                        <p class="fw-bold text-secondary mb-2">
                            <i class="bi bi-lightbulb"></i> التفسير:
                        </p>
                        <div class="p-3 bg-light rounded mb-3">
                            @Html.Raw(NumberHelper.ToIndicNumbersSafe(Model.Explanation))
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.VideoUrl))
                    {
                        <div class="ratio ratio-16x9 mb-2">
                            <iframe src="@Model.VideoUrl" frameborder="0" allowfullscreen></iframe>
                        </div>
                    }
                </div>
            }

            <!-- 🩵 تفاصيل إضافية -->
            <div class="mt-4 small text-muted">
                <i class="bi bi-geo"></i> <strong>المؤشر (الدرس):</strong> @Model.LessonTitle <br />
                <i class="bi bi-diagram-3"></i> <strong>المحور:</strong> @Model.SectionTitle <br />
                <i class="bi bi-bar-chart"></i> <strong>مستوى الصعوبة:</strong> @Model.Difficulty
            </div>
        </div>
    </div>
</div>
