@model QdratNew.ViewModels.Question.QuestionDisplayViewModel
@using QdratNew.Helpers

@{
    var labels = new[] { "أ", "ب", "ج", "د" };
    var selectedAnswer = ViewBag.SelectedAnswer as string ?? "";
}

@if (Model == null)
{
    <div class="alert alert-danger">⚠️ لم يتم تحميل السؤال بشكل صحيح (Model is null).</div>
    return;
}

<style>
    .question-box {
        border: 1px solid #339999;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        margin-top: 20px;
    }

    .question-title-header {
        background-color: rgba(51, 153, 153, 0.1);
        color: #004d4d;
        font-weight: bold;
        font-size: 18px;
        padding: 10px 20px;
        text-align: right;
        white-space: normal !important;
        word-break: break-word !important;
        line-height: 1.8;
    }

    .option-cell {
        border: 1px solid #339999;
        padding: 15px 10px;
        text-align: center;
        font-weight: bold;
        font-size: 16px;
        min-height: 70px;
    }

    .selected-option {
        background-color: rgba(255, 193, 7, 0.2);
    }
</style>

<div class="question-box">

    @if (!string.IsNullOrWhiteSpace(Model.VerbalPassageContent))
    {
        <div class="p-3 bg-light border-bottom">
            <h5 class="text-info">✍️ القطعة المرتبطة:</h5>
            <div class="border rounded bg-white p-3" style="line-height: 1.8;">
                @Html.Raw(Model.VerbalPassageContent)
            </div>
        </div>
    }

    <div class="question-title-header">
        @Html.Raw(Model.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(Model.Title) : Model.Title)
    </div>

    @if (!string.IsNullOrEmpty(Model.ImageUrl) && Model.DisplayType == QdratNew.Enums.QuestionDisplayType.WithImage)
    {
        <div class="text-center p-3">
            <img src="@Model.ImageUrl" alt="صورة السؤال" class="img-fluid" style="max-height: 200px;" />
        </div>
    }

    @if (Model.DisplayType == QdratNew.Enums.QuestionDisplayType.ComparisonText)
    {
        <div class="row m-0 p-3 border-top" style="background-color: #f0f8ff;">
            <div class="col-md-6 text-center">
                <strong>القيمة الأولى:</strong><br />
                <div class="fs-5">
                    @Html.Raw(Model.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(Model.ComparisonValue1 ?? "") : (Model.ComparisonValue1 ?? ""))
                </div>
            </div>
            <div class="col-md-6 text-center">
                <strong>القيمة الثانية:</strong><br />
                <div class="fs-5">
                    @Html.Raw(Model.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(Model.ComparisonValue2 ?? "") : (Model.ComparisonValue2 ?? ""))
                </div>
            </div>
        </div>
    }

    @if (Model.DisplayType == QdratNew.Enums.QuestionDisplayType.ComparisonWithImage)
    {
        <div class="row m-0 border-top" style="background-color: #f0f8ff;">
            <div class="col-md-3 d-flex align-items-center justify-content-center p-2">
                <img src="@Model.ImageUrl" alt="صورة المقارنة" class="img-fluid" style="max-height: 150px;" />
            </div>
            <div class="col-md-4 text-center d-flex align-items-center justify-content-center border-start">
                <div>
                    <div class="fw-bold fs-5 text-info">القيمة الثانية</div>
                    <div class="fs-4">
                        @Html.Raw(Model.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(Model.ComparisonValue2 ?? "") : (Model.ComparisonValue2 ?? ""))
                    </div>
                </div>
            </div>
            <div class="col-md-5 text-center d-flex align-items-center justify-content-center">
                <div>
                    <div class="fw-bold fs-5 text-info">القيمة الأولى</div>
                    <div class="fs-4">
                        @Html.Raw(Model.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(Model.ComparisonValue1 ?? "") : (Model.ComparisonValue1 ?? ""))
                    </div>
                </div>
            </div>
        </div>
    }

    <table class="table text-center" style="border: 1px solid #339999;">
        <tr>
            @for (int i = 0; i < Model.Options.Count; i++)
            {
                var option = Model.Options[i];
                var isSelected = selectedAnswer == option.Text;

                <td class="fw-bold text-white align-middle"
                    style="background-color:#339999; border: 1px solid #339999; width: 5%;">
                    <label class="w-100 h-100 d-block">@(i<labels.Length? labels[i] : $"({i + 1})")</label>
                </td>

                <td class="option-cell align-middle @(isSelected ? "selected-option" : "")"
                    style="border: 1px solid #339999; width: 20%;">
                    <label class="w-100 h-100 d-block">

                        @if (!string.IsNullOrEmpty(option.ImageUrl))
                        {
                            <img src="@option.ImageUrl" alt="اختيار @(labels[i])"
                                 class="img-fluid mb-1" style="max-height: 80px;" />
                        }
                        else
                        {
                    <div class="fw-bold">
                        @Html.Raw(Model.IsQuantitative
                                                ? NumberHelper.ToIndicNumbersSafe(option.Text ?? "")
                                                : (option.Text ?? ""))
                    </div>
                                        }

                    <input type="radio"
                           name="SelectedOption"
                           value="@option.Text"
                           class="form-check-input me-1 mt-2"
                           @(isSelected ? "checked" : "") />

                </label>
            </td>
                        }
        </tr>
    </table>

</div>
