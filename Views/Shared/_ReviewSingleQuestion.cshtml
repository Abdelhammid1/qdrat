@model QdratNew.ViewModels.Exam.ExamReviewQuestionVm
@using QdratNew.Helpers
@{
    Func<string, string> convert = s => Model.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(s) : s;
}

<div class="review-question-card">

    <h5 class="question-title">@Html.Raw(convert(Model.QuestionTitle))</h5>

    <hr />

    @if (!string.IsNullOrWhiteSpace(Model.VerbalPassageContent))
    {
        <div class="alert alert-secondary">
            @Html.Raw(convert(Model.VerbalPassageContent))
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
    {
        <div class="text-center mb-3">
            <img src="@Model.ImageUrl" class="img-fluid rounded shadow-sm" style="max-height:260px;" />
        </div>
    }

    <h6 class="fw-bold">الاختيارات:</h6>

    @foreach (var opt in Model.Options)
    {
        var isSel = opt.Text == Model.StudentAnswer;
        var isCorrect = opt.Text == Model.CorrectAnswer;

        var css = isCorrect
        ? "choice-item choice-correct"
        : isSel
        ? "choice-item choice-wrong"
        : "choice-item choice-neutral";

        <div class="@css">
            <span>@Html.Raw(convert(opt.Text))</span>

            @if (isCorrect)
            {
                <span class="badge bg-success">✔ صحيح</span>
            }
            else if (isSel)
            {
                <span class="badge bg-danger">✘ إجابتك</span>
            }
        </div>
    }

</div>
