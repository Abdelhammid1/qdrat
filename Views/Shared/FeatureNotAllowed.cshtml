@using QdratNew.Helpers
@{
    Layout = "~/Views/Shared/_PartnerLayout.cshtml";
    ViewData["Title"] = "الخدمة غير مشمولة في العقد";

    var featureName = ViewData["FeatureName"] is Enum feature
        ? EnumHelper.GetDisplayName(feature)
        : null;
}

<div class="container mt-5 text-center" dir="rtl">
    <h3 class="mb-3" style="color: var(--partner-dark);">🔒 هذه الخدمة غير مشمولة في عقدكم الحالي</h3>

    @if (!string.IsNullOrEmpty(featureName))
    {
        <p class="fw-semibold mb-2">الخدمة المطلوبة: @featureName</p>
    }

    <p class="text-muted">
        لإضافة هذه الخدمة إلى العقد، يُرجى التواصل مع معهد القدرات.
    </p>

    <a asp-area="Partner"
       asp-controller="Dashboard"
       asp-action="Index"
       class="btn btn-outline-secondary mt-3">
        الرجوع إلى لوحة التحكم
    </a>
</div>
