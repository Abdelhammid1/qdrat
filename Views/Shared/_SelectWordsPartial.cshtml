<div class="card mb-4">
    <div class="card-header bg-light fw-bold">
        <i class="fas fa-highlighter text-danger"></i> اختيار الكلمات المميزة في السؤال اللفظي
    </div>
    <div class="card-body">

        <div class="form-group mb-3">
            <label>📝 أدخل النص الكامل:</label>
            <textarea class="form-control" id="verbalFullText" rows="5" placeholder="الصق هنا النص الكامل للسؤال..."></textarea>
        </div>

        <button type="button" class="btn btn-outline-primary mb-3" onclick="processVerbalWords()">
            تحليل النص واختيار الكلمات
        </button>

        <div class="border rounded p-3 bg-light" id="verbalWordSelectorArea" style="min-height: 100px;">
            <small class="text-muted">سيتم عرض الكلمات القابلة للاختيار هنا...</small>
        </div>

        <div class="mt-3">
            <strong>الكلمات المختارة:</strong>
            <div id="selectedWordsPreview" class="mt-2 text-danger fw-bold"></div>
        </div>

        <button type="button" class="btn btn-success mt-3" onclick="insertVerbalToQuestionText()">
            نسخ النص مع التمييز إلى نص السؤال
        </button>

        <button type="button" class="btn btn-dark mt-3" onclick="fillOptionsFromSelectedWords()">
            تعبئة الاختيارات تلقائيًا من الكلمات المختارة
        </button>

    </div>
</div>
