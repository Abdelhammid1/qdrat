@model QdratNew.ViewModels.Question.EditQuestionUsageTypesViewModel

<form id="editUsageTypesForm" class="text-end">
    <div class="mb-3">
        @foreach (var usageType in Model.AllUsageTypes)
        {
            <div class="form-check form-switch">
                <input class="form-check-input"
                       type="checkbox"
                       name="selectedTypes"
                       value="@((int)usageType)"
                       @(Model.SelectedUsageTypes.HasFlag(usageType) ? "checked" : "") />
                <label class="form-check-label me-2">@usageType</label>
            </div>
        }
    </div>

    <input type="hidden" name="questionId" value="@Model.QuestionId" />
    <button type="submit" class="btn btn-primary mt-3">حفظ</button>
</form>

<script>
    document.getElementById("editUsageTypesForm").addEventListener("submit", async function (e) {
        e.preventDefault();

        const form = this;
        const params = new URLSearchParams();

        // التصنيفات المختارة فقط
        form.querySelectorAll('input[name="selectedTypes"]:checked').forEach(cb => {
            params.append("selectedTypes", cb.value);
        });

        params.append("questionId", form.querySelector('input[name="questionId"]').value);

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        const response = await fetch("/Instructors/QuestionsReview/UpdateUsageTypes", {
            method: "POST",
            headers: {
                'RequestVerificationToken': token
            },
            body: params
        });

        const result = await response.json();
        if (result.success) {
            Swal.fire('تم', result.message, 'success').then(() => location.reload());
        } else {
            Swal.fire('خطأ', result.message, 'error');
        }
    });
</script>
