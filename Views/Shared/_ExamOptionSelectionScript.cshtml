<script>
    // Shared with the general exam; delegated events also cover AJAX question replacement.
    (function () {
        function syncOptionStyles(container) {
            container = container || document;
            container.querySelectorAll('.qx-options').forEach(function (group) {
                group.querySelectorAll('.qx-option').forEach(function (label) {
                    var radio = label.querySelector('.qx-option__radio');
                    if (!radio) return;
                    label.classList.toggle('qx-option--selected', radio.checked);
                });
            });
        }

        window.syncOptionStyles = syncOptionStyles;

        if (!window.__qxOptionSelectionBound) {
            document.addEventListener('change', function (e) {
                if (e.target && e.target.matches('.qx-option__radio')) {
                    var group = e.target.closest('.qx-options');
                    if (group) window.syncOptionStyles(group.parentElement);
                }
            });
            window.__qxOptionSelectionBound = true;
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function () { window.syncOptionStyles(); }, { once: true });
        } else {
            syncOptionStyles();
        }
    })();
</script>
