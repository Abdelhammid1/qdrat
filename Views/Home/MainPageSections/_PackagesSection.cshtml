@inject QdratNew.Services.Frontend.Packages.ICoursePackagePublicService PackageService
@{
    var packages = await PackageService.GetHomeSectionAsync();
    if (packages.Count == 0) { return; }
}

@await Html.PartialAsync("~/Views/Packages/_PackagesStyles.cshtml")

<section id="packages" class="qd-pkg qd-pkg--section" aria-labelledby="packagesHeading">
    <div class="container">
        <header class="qd-pkg__head">
            <span class="qd-pkg__eyebrow"><i class="bi bi-box2-heart" aria-hidden="true"></i> الباقات</span>
            <h2 id="packagesHeading" class="qd-pkg__title">باقاتنا بأسعار مخفّضة</h2>
            <p class="qd-pkg__lead">اجمع دوراتك في باقة واحدة ووفّر أكثر.</p>
        </header>

        <div class="qd-pkg__grid">
            @foreach (var package in packages)
            {
                @await Html.PartialAsync("~/Views/Packages/_PackageCard.cshtml", package)
            }
        </div>
    </div>
</section>
