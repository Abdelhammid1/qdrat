@model QdratNew.ViewModels.Frontend.CourseCollections.CourseCollectionCardViewModel
@{
    var multiRegisterUrl = $"/Public/CourseCollections/{Model.Slug}/Register";
    var courseCount = Model.Courses.Count;
    var heroStyle = !string.IsNullOrEmpty(Model.BackgroundImagePath)
        ? $"background-image:url('{Model.BackgroundImagePath}')"
        : null;
}

<section class="ccs-section" id="cc-@Model.Slug" aria-label="@Model.Name">
    <div class="container">
        <div class="ccs-hero ccs-reveal"@(heroStyle != null ? Html.Raw($" style=\"{heroStyle}\"") : null)>
            <div class="ccs-hero-bg-pattern" aria-hidden="true"></div>
            @if (string.IsNullOrEmpty(Model.BackgroundImagePath))
            {
                <div class="ccs-hero-glow-a" aria-hidden="true"></div>
                <div class="ccs-hero-glow-b" aria-hidden="true"></div>
            }
            <div class="ccs-hero-overlay" aria-hidden="true"></div>

            <div class="ccs-hero-content">
                <div class="ccs-hero-eyebrow">
                    <i class="fas fa-sparkles" aria-hidden="true"></i>
                    مجموعة دورات
                </div>

                <div class="ccs-hero-logo">
                    @if (!string.IsNullOrEmpty(Model.LogoPath))
                    {
                        <img src="@Model.LogoPath" alt="@Model.Name" loading="lazy">
                    }
                    else
                    {
                        <i class="fas fa-layer-group" aria-hidden="true"></i>
                    }
                </div>

                <h2 class="ccs-hero-title">@Model.Name</h2>
                @if (!string.IsNullOrEmpty(Model.Subtitle))
                {
                    <p class="ccs-hero-subtitle">@Model.Subtitle</p>
                }
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="ccs-hero-desc">@Model.Description</p>
                }

                <div class="ccs-hero-actions">
                    <a href="@multiRegisterUrl" class="ccs-hero-cta">
                        <i class="fas fa-pen-to-square" aria-hidden="true"></i>
                        @(string.IsNullOrEmpty(Model.ButtonText) ? "سجّل الدورات الآن" : Model.ButtonText)
                    </a>
                    @if (courseCount > 0)
                    {
                        <span class="ccs-hero-count">
                            <i class="fas fa-circle-check" aria-hidden="true"></i>
                            @(courseCount == 1 ? "دورة واحدة متاحة" : courseCount + " دورات متاحة")
                        </span>
                    }
                </div>
            </div>
        </div>

        @if (Model.Sponsors.Count > 0)
        {
            <div class="ccs-sponsors-row ccs-reveal">
                <div class="ccs-sponsors-label">برعاية</div>
                <div class="ccs-sponsors-logos">
                    @foreach (var sponsor in Model.Sponsors)
                    {
                        if (!string.IsNullOrEmpty(sponsor.LinkUrl))
                        {
                            <a class="ccs-sponsor-logo" href="@sponsor.LinkUrl" target="_blank" rel="noopener" title="@sponsor.Name">
                                <img src="@sponsor.LogoPath" alt="@(sponsor.Name ?? "راعٍ")" loading="lazy">
                            </a>
                        }
                        else
                        {
                            <div class="ccs-sponsor-logo" title="@sponsor.Name">
                                <img src="@sponsor.LogoPath" alt="@(sponsor.Name ?? "راعٍ")" loading="lazy">
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
</section>
