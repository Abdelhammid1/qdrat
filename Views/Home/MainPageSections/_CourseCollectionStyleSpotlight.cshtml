@model QdratNew.ViewModels.Frontend.CourseCollections.CourseCollectionCardViewModel
@{
    var multiRegisterUrl = $"/Public/CourseCollections/{Model.Slug}/Register";
    var courseCount = Model.Courses.Count;
    var sectionStyle = !string.IsNullOrEmpty(Model.BackgroundImagePath)
        ? $"background-image:url('{Model.BackgroundImagePath}')"
        : null;
}

<section class="ccs-spot-section" id="cc-@Model.Slug" aria-label="@Model.Name"@(sectionStyle != null ? Html.Raw($" style=\"{sectionStyle}\"") : null)>
    @if (!string.IsNullOrEmpty(Model.BackgroundImagePath))
    {
        <div class="ccs-spot-scrim" aria-hidden="true"></div>
    }
    else
    {
        <div class="ccs-spot-glow-a" aria-hidden="true"></div>
        <div class="ccs-spot-glow-b" aria-hidden="true"></div>
    }

    <div class="container">
        <div class="ccs-spot-inner ccs-reveal">
            <div class="ccs-spot-logo">
                @if (!string.IsNullOrEmpty(Model.LogoPath))
                {
                    <img src="@Model.LogoPath" alt="@Model.Name" loading="lazy">
                }
                else
                {
                    <i class="fas fa-star" aria-hidden="true"></i>
                }
            </div>

            <h2 class="ccs-spot-title">@Model.Name</h2>
            @if (!string.IsNullOrEmpty(Model.Subtitle))
            {
                <p class="ccs-spot-subtitle">@Model.Subtitle</p>
            }
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="ccs-spot-desc">@Model.Description</p>
            }

            @if (courseCount > 0)
            {
                <div class="ccs-spot-count">
                    <i class="fas fa-circle-check" aria-hidden="true"></i>
                    @(courseCount == 1 ? "دورة واحدة متاحة" : courseCount + " دورات متاحة")
                </div>
            }
            <div>
                <a href="@multiRegisterUrl" class="ccs-spot-cta">
                    <i class="fas fa-pen-to-square" aria-hidden="true"></i>
                    @(string.IsNullOrEmpty(Model.ButtonText) ? "سجّل الدورات الآن" : Model.ButtonText)
                </a>
            </div>

            @if (Model.Sponsors.Count > 0)
            {
                <div class="ccs-spot-sponsors">
                    <div class="ccs-spot-sponsors-label">بدعم من</div>
                    <div class="ccs-spot-sponsors-logos">
                        @foreach (var sponsor in Model.Sponsors)
                        {
                            if (!string.IsNullOrEmpty(sponsor.LinkUrl))
                            {
                                <a class="ccs-spot-sponsor-logo" href="@sponsor.LinkUrl" target="_blank" rel="noopener" title="@sponsor.Name">
                                    <img src="@sponsor.LogoPath" alt="@(sponsor.Name ?? "راعٍ")" loading="lazy">
                                </a>
                            }
                            else
                            {
                                <div class="ccs-spot-sponsor-logo" title="@sponsor.Name">
                                    <img src="@sponsor.LogoPath" alt="@(sponsor.Name ?? "راعٍ")" loading="lazy">
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>
