@inject QdratNew.Services.Frontend.ProfessionalCertificates.IProfessionalCertificateService ProfCertService
@{
    var vm = await ProfCertService.GetHomeSectionAsync();
    if (!vm.IsEnabled) { return; }
}

<style>
    /* ── Tokens ── */
    :root {
        --pc-navy:       #0c2340;
        --pc-navy-mid:   #1a3a5c;
        --pc-teal:       #0f766e;
        --pc-teal-light: #14b8a6;
        --pc-amber:      #f59e0b;
        --pc-bg:         #f0f5f9;
        --pc-card:       #ffffff;
        --pc-border:     rgba(12,35,64,0.07);
        --pc-shadow:     0 2px 14px rgba(12,35,64,0.06);
        --pc-shadow-lg:  0 16px 48px rgba(12,35,64,0.13);
        --pc-muted:      #64748b;
        --pc-radius:     16px;
        --pc-radius-lg:  24px;
    }

    /* ── Section ── */
    .pcs-section {
        position: relative;
        padding: 88px 0 104px;
        background: var(--pc-bg);
        direction: rtl;
        overflow: hidden;
    }
    .pcs-section::before {
        content: '';
        position: absolute; inset: 0;
        background-image: radial-gradient(circle, rgba(12,35,64,0.05) 1px, transparent 1px);
        background-size: 26px 26px;
        pointer-events: none;
    }

    /* Blobs */
    .pcs-blob {
        position: absolute; border-radius: 50%;
        filter: blur(90px); pointer-events: none;
    }
    .pcs-blob--a {
        width: 560px; height: 560px;
        background: radial-gradient(circle, rgba(15,118,110,0.11), transparent 70%);
        top: -160px; right: -140px;
    }
    .pcs-blob--b {
        width: 480px; height: 480px;
        background: radial-gradient(circle, rgba(12,35,64,0.09), transparent 70%);
        bottom: -80px; left: -80px;
    }
    .pcs-blob--c {
        width: 300px; height: 300px;
        background: radial-gradient(circle, rgba(245,158,11,0.07), transparent 70%);
        bottom: 20%; left: 30%;
    }

    /* ── Header ── */
    .pcs-header { text-align: center; margin-bottom: 52px; }

    .pcs-eyebrow {
        display: inline-flex; align-items: center; gap: 9px;
        background: linear-gradient(135deg, rgba(15,118,110,0.1), rgba(20,184,166,0.07));
        border: 1px solid rgba(15,118,110,0.2);
        color: var(--pc-teal);
        font-size: 0.76rem; font-weight: 700;
        padding: 7px 18px; border-radius: 50px;
        letter-spacing: 0.7px; text-transform: uppercase;
        margin-bottom: 18px;
    }
    .pcs-eyebrow-dot {
        width: 7px; height: 7px; background: var(--pc-teal);
        border-radius: 50%;
        animation: pcs-blink 2.2s ease-in-out infinite;
        flex-shrink: 0;
    }
    @@keyframes pcs-blink {
        0%,100% { transform: scale(1); opacity: 1; }
        50%      { transform: scale(1.5); opacity: 0.5; }
    }

    .pcs-title {
        font-size: clamp(1.7rem, 3.2vw, 2.6rem);
        font-weight: 900; color: var(--pc-navy);
        line-height: 1.25; margin-bottom: 12px;
        letter-spacing: -0.3px;
    }
    .pcs-subtitle-text { color: var(--pc-teal); font-size: 1rem; font-weight: 600; margin-bottom: 8px; }
    .pcs-desc-text {
        color: var(--pc-muted); font-size: 0.93rem;
        line-height: 1.75; max-width: 540px; margin: 0 auto;
    }
    .pcs-divider {
        display: flex; align-items: center; justify-content: center;
        gap: 14px; margin-top: 26px;
    }
    .pcs-divider-line {
        height: 1.5px; width: 50px;
        background: linear-gradient(90deg, transparent, var(--pc-teal));
        border-radius: 2px;
    }
    .pcs-divider-line--rev { background: linear-gradient(90deg, var(--pc-teal), transparent); }
    .pcs-divider-icon { color: var(--pc-teal); font-size: 0.85rem; }

    /* ── Grid — 4 columns ── */
    .pcs-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
    }
    @@media (max-width: 1199px) { .pcs-grid { grid-template-columns: repeat(3, 1fr); } }
    @@media (max-width: 767px)  { .pcs-grid { grid-template-columns: repeat(2, 1fr); } }
    @@media (max-width: 479px)  { .pcs-grid { grid-template-columns: 1fr; } }

    /* ── Card ── */
    .pcs-card {
        background: var(--pc-card);
        border: 1px solid var(--pc-border);
        border-radius: var(--pc-radius);
        display: flex; flex-direction: column;
        position: relative; overflow: hidden;
        box-shadow: var(--pc-shadow);
        transition: transform 0.25s cubic-bezier(.22,.68,0,1.2), box-shadow 0.25s ease;
    }
    /* Left accent bar (RTL) */
    .pcs-card::after {
        content: '';
        position: absolute;
        top: 0; bottom: 0; right: 0;
        width: 3px;
        background: linear-gradient(180deg, var(--pc-teal), var(--pc-teal-light));
        border-radius: 0 var(--pc-radius) var(--pc-radius) 0;
        transition: width 0.22s ease;
    }
    .pcs-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--pc-shadow-lg);
    }
    .pcs-card:hover::after { width: 4px; }

    /* ── Card Header row ── */
    .pcs-card-head {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 18px 20px 12px;
    }

    /* Logo — compact */
    .pcs-logo {
        width: 56px; height: 56px; flex-shrink: 0;
        border-radius: 12px; border: 1.5px solid rgba(15,118,110,0.14);
        background: #f0fdf9;
        display: flex; align-items: center; justify-content: center;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(15,118,110,0.12);
        transition: transform 0.22s ease;
    }
    .pcs-card:hover .pcs-logo { transform: scale(1.06); }
    .pcs-logo img { width: 44px; height: 44px; object-fit: contain; }

    /* Icon fallback */
    .pcs-icon {
        width: 56px; height: 56px; flex-shrink: 0;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--pc-teal), #065f46);
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 4px 14px rgba(15,118,110,0.26);
        transition: transform 0.22s ease;
    }
    .pcs-card:hover .pcs-icon { transform: scale(1.06); }
    .pcs-icon i { font-size: 1.3rem; color: #fff; }

    /* Head info (next to logo) */
    .pcs-head-info { flex: 1; min-width: 0; }
    .pcs-card-title {
        font-size: 0.92rem; font-weight: 800; color: var(--pc-navy);
        line-height: 1.45; margin-bottom: 6px;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .pcs-code {
        display: inline-flex; align-items: center; gap: 3px;
        background: #fffbeb; color: #92400e;
        font-size: 0.63rem; font-weight: 700;
        padding: 3px 8px; border-radius: 5px;
        font-family: 'Courier New', monospace;
        border: 1px solid #fde68a; letter-spacing: 0.3px;
        white-space: nowrap;
    }

    /* ── Card Body ── */
    .pcs-card-body {
        padding: 0 20px 14px;
        flex: 1;
    }
    .pcs-badge {
        display: inline-flex; align-items: center; gap: 4px;
        background: linear-gradient(135deg, #ecfdf5, #d1fae5);
        color: #065f46; font-size: 0.62rem; font-weight: 700;
        padding: 3px 9px; border-radius: 5px;
        border: 1px solid #a7f3d0; margin-bottom: 8px;
    }
    .pcs-card-desc {
        font-size: 0.8rem; color: var(--pc-muted);
        line-height: 1.65; margin: 0;
        display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* ── Card Footer — status only ── */
    .pcs-card-footer {
        padding: 0 20px 14px;
    }
    .pcs-status {
        display: inline-flex; align-items: center; gap: 5px;
        font-size: 0.68rem; font-weight: 600;
        padding: 3px 9px; border-radius: 5px;
    }
    .pcs-status--open   { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
    .pcs-status--closed { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
    .pcs-status--full   { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }

    /* ── Section CTA Button ── */
    .pcs-section-cta {
        display: inline-flex; align-items: center; gap: 9px;
        background: linear-gradient(135deg, var(--pc-teal) 0%, #065f46 100%);
        color: #fff !important; text-decoration: none !important;
        font-size: 0.92rem; font-weight: 700;
        padding: 13px 32px; border-radius: 12px;
        margin-top: 24px;
        transition: transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 4px 18px rgba(15,118,110,0.25);
    }
    .pcs-section-cta:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 28px rgba(15,118,110,0.35);
        color: #fff !important;
    }

    /* ── Bottom Banner ── */
    .pcs-banner {
        margin-top: 60px;
        background: linear-gradient(130deg, var(--pc-navy) 0%, var(--pc-navy-mid) 50%, #0d2a45 100%);
        border-radius: var(--pc-radius-lg);
        padding: 48px 44px;
        display: flex; align-items: center; gap: 28px;
        position: relative; overflow: hidden;
        border: 1px solid rgba(255,255,255,0.05);
    }
    .pcs-banner::before {
        content: '';
        position: absolute;
        width: 360px; height: 360px;
        background: radial-gradient(circle, rgba(15,118,110,0.22), transparent 65%);
        top: -100px; right: -80px; pointer-events: none;
    }
    .pcs-banner::after {
        content: '';
        position: absolute;
        width: 240px; height: 240px;
        background: radial-gradient(circle, rgba(245,158,11,0.1), transparent 65%);
        bottom: -60px; left: 28%; pointer-events: none;
    }
    .pcs-banner-orb {
        flex-shrink: 0; width: 100px; height: 100px;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.03);
        display: flex; align-items: center; justify-content: center;
        position: relative; z-index: 1;
    }
    .pcs-banner-orb::after {
        content: ''; position: absolute; inset: 10px; border-radius: 50%;
        background: rgba(15,118,110,0.18);
        border: 1px solid rgba(20,184,166,0.2);
    }
    .pcs-banner-orb i { font-size: 2rem; color: var(--pc-teal-light); position: relative; z-index: 1; }
    .pcs-banner-content { flex: 1; position: relative; z-index: 1; }
    .pcs-banner-tag {
        display: inline-flex; align-items: center; gap: 7px;
        font-size: 0.7rem; font-weight: 700; color: var(--pc-teal-light);
        letter-spacing: 1px; text-transform: uppercase; margin-bottom: 9px;
    }
    .pcs-banner-tag::before {
        content: ''; width: 20px; height: 1.5px;
        background: var(--pc-teal-light); border-radius: 2px; display: inline-block;
    }
    .pcs-banner h3 { font-size: 1.4rem; font-weight: 800; color: #fff; margin-bottom: 8px; line-height: 1.35; }
    .pcs-banner p  { font-size: 0.88rem; color: rgba(255,255,255,0.65); line-height: 1.7; margin: 0; max-width: 480px; }
    .pcs-banner-cta {
        display: inline-flex; align-items: center; gap: 8px;
        background: var(--pc-amber); color: #1c1917 !important;
        font-weight: 800; font-size: 0.86rem;
        padding: 13px 28px; border-radius: 11px;
        text-decoration: none !important;
        flex-shrink: 0; position: relative; z-index: 1;
        transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
        white-space: nowrap;
    }
    .pcs-banner-cta:hover {
        background: #fbbf24; transform: translateY(-2px);
        box-shadow: 0 10px 26px rgba(245,158,11,0.33);
        color: #1c1917 !important;
    }
    @@media (max-width: 768px) {
        .pcs-banner { flex-direction: column; padding: 36px 22px; text-align: center; }
        .pcs-banner-tag { justify-content: center; }
        .pcs-banner-orb { display: none; }
        .pcs-banner p { max-width: 100%; }
        .pcs-banner-cta { width: 100%; justify-content: center; }
    }

    /* ── Reveal ── */
    .pcs-reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.52s ease, transform 0.52s ease; }
    .pcs-reveal.pcs-visible { opacity: 1; transform: translateY(0); }
    .pcs-card.pcs-reveal { transition-delay: calc(var(--di, 0) * 65ms); }
</style>

<section class="pcs-section" id="professional-certificates" aria-label="الشهادات الدولية الاحترافية">
    <div class="pcs-blob pcs-blob--a" aria-hidden="true"></div>
    <div class="pcs-blob pcs-blob--b" aria-hidden="true"></div>
    <div class="pcs-blob pcs-blob--c" aria-hidden="true"></div>

    <div class="container position-relative">

        <!-- Header -->
        <header class="pcs-header pcs-reveal">
            <div class="pcs-eyebrow">
                <span class="pcs-eyebrow-dot" aria-hidden="true"></span>
                اعتمادات دولية معترف بها
            </div>
            <h2 class="pcs-title">@vm.Title</h2>
            @if (!string.IsNullOrEmpty(vm.Subtitle))
            {
                <p class="pcs-subtitle-text">@vm.Subtitle</p>
            }
            @if (!string.IsNullOrEmpty(vm.Description))
            {
                <p class="pcs-desc-text">@vm.Description</p>
            }
            <div class="pcs-divider" aria-hidden="true">
                <span class="pcs-divider-line"></span>
                <i class="fas fa-certificate pcs-divider-icon"></i>
                <span class="pcs-divider-line pcs-divider-line--rev"></span>
            </div>
            <a href="/Public/ProfessionalCertificates/Register" class="pcs-section-cta">
                <i class="fas fa-pen-to-square" aria-hidden="true"></i>
                سجّل اهتمامك الآن
            </a>
        </header>

        <!-- Banner -->
        <div class="pcs-banner pcs-reveal">
            <div class="pcs-banner-orb" aria-hidden="true">
                <i class="fas fa-headset"></i>
            </div>
            <div class="pcs-banner-content">
                <div class="pcs-banner-tag">فريق الدعم المتخصص</div>
                <h3>هل تحتاج مساعدة في اختيار البرنامج المناسب؟</h3>
                <p>فريقنا المتخصص جاهز لمساعدتك في اختيار الشهادة الأنسب لمسيرتك المهنية في مجال السلامة والصحة المهنية.</p>
            </div>
            <a href="#contact" class="pcs-banner-cta">
                <i class="fas fa-headset" aria-hidden="true"></i>
                تواصل معنا الآن
            </a>
        </div>

    </div>
</section>

<script>
    (function () {
        var els = document.querySelectorAll('#professional-certificates .pcs-reveal');
        if (!('IntersectionObserver' in window)) {
            els.forEach(function (el) { el.classList.add('pcs-visible'); });
            return;
        }
        var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
                if (e.isIntersecting) {
                    e.target.classList.add('pcs-visible');
                    io.unobserve(e.target);
                }
            });
        }, { threshold: 0.1 });
        els.forEach(function (el) { io.observe(el); });
    })();
</script>
