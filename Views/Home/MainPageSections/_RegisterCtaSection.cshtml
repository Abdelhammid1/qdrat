@* سكشن الدعوة للتسجيل — يقود إلى /register (PublicRegisterController) حيث تُحفظ الطلبات في FrontendLeads *@

<style>
    /* ===== Qudurat Design System tokens (مقيّدة بالسكشن) ===== */
    .qd-regcta {
        --qd-teal-600: #36787c;
        --qd-teal-500: #479498;
        --qd-teal-100: #dff0f1;
        --qd-teal-50: #f0f8f8;
        --qd-clay-600: #c4623a;
        --qd-clay-500: #da784d;
        --qd-ink-900: #2b2622;
        --qd-ink-600: #5e554d;
        --qd-border: #e7e1da;
        --qd-surface: #ffffff;
        --qd-r-md: 10px;
        --qd-r-lg: 14px;
        --qd-r-xl: 20px;
        --qd-shadow-md: 0 4px 14px rgba(70, 52, 38, .10);
        --qd-shadow-lg: 0 14px 36px rgba(70, 52, 38, .14);

        direction: rtl;
        font-family: 'Cairo', 'Tajawal', sans-serif;
        padding-block: 64px;
        background: var(--qd-teal-50);
    }

    .qd-regcta__panel {
        position: relative;
        overflow: hidden;
        background: var(--qd-surface);
        border: 1px solid var(--qd-border);
        border-block-start: 4px solid var(--qd-clay-500);
        border-radius: var(--qd-r-xl);
        box-shadow: var(--qd-shadow-md);
        padding: 48px 40px;
        text-align: center;
    }

    .qd-regcta__eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 4px 14px;
        border-radius: 999px;
        background: var(--qd-teal-100);
        color: var(--qd-teal-600);
        font-size: .8rem;
        font-weight: 700;
        margin-block-end: 16px;
    }

    .qd-regcta__title {
        font-weight: 800;
        font-size: clamp(1.5rem, 3vw, 2.1rem);
        color: var(--qd-ink-900);
        margin: 0 0 12px;
    }

    .qd-regcta__desc {
        max-width: 620px;
        margin: 0 auto 32px;
        color: var(--qd-ink-600);
        line-height: 1.9;
        font-size: 1rem;
    }

    .qd-regcta__steps {
        list-style: none;
        margin: 0 0 36px;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .qd-regcta__step {
        background: var(--qd-teal-50);
        border: 1px solid var(--qd-teal-100);
        border-radius: var(--qd-r-lg);
        padding: 20px 16px;
    }

    .qd-regcta__num {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--qd-teal-500);
        color: #fff;
        font-weight: 800;
        margin-block-end: 10px;
    }

    .qd-regcta__step-title {
        margin: 0 0 4px;
        font-size: 1rem;
        font-weight: 700;
        color: var(--qd-ink-900);
    }

    .qd-regcta__step-text {
        margin: 0;
        font-size: .88rem;
        color: var(--qd-ink-600);
        line-height: 1.7;
    }

    .qd-regcta__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: center;
    }

    .qd-regcta__btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 32px;
        border-radius: var(--qd-r-md);
        font-weight: 700;
        font-size: 1rem;
        text-decoration: none;
        border: 1px solid transparent;
        transition: transform 120ms ease-out, box-shadow 120ms ease-out, background-color 120ms ease-out;
    }

    .qd-regcta__btn:focus-visible {
        outline: 3px solid var(--qd-teal-100);
        outline-offset: 2px;
    }

    .qd-regcta__btn--primary {
        background: var(--qd-clay-500);
        color: #fff;
        box-shadow: var(--qd-shadow-md);
    }

    .qd-regcta__btn--primary:hover {
        background: var(--qd-clay-600);
        color: #fff;
        transform: translateY(-2px);
        box-shadow: var(--qd-shadow-lg);
    }

    .qd-regcta__btn--soft {
        background: var(--qd-teal-100);
        color: var(--qd-teal-600);
    }

    .qd-regcta__btn--soft:hover {
        background: var(--qd-teal-500);
        color: #fff;
    }

    @@media (max-width: 767px) {
        .qd-regcta { padding-block: 40px; }
        .qd-regcta__panel { padding: 32px 20px; }
        .qd-regcta__steps { grid-template-columns: 1fr; }
        .qd-regcta__btn { width: 100%; justify-content: center; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .qd-regcta__btn { transition: none; }
        .qd-regcta__btn--primary:hover { transform: none; }
    }
</style>

<section id="register-cta" class="qd-regcta" aria-labelledby="qdRegCtaTitle">
    <div class="container">
        <div class="qd-regcta__panel">
            <span class="qd-regcta__eyebrow"><i class="bi bi-stars"></i> التسجيل مفتوح</span>
            <h2 id="qdRegCtaTitle" class="qd-regcta__title">ابدأ رحلتك مع معهد القدرات</h2>
            <p class="qd-regcta__desc">
                اختر الدورة أو البرنامج المناسب لك وسجّل بياناتك في دقائق، وسيتواصل معك فريقنا لإتمام الالتحاق.
            </p>

            <ol class="qd-regcta__steps">
                <li class="qd-regcta__step">
                    <span class="qd-regcta__num">1</span>
                    <h3 class="qd-regcta__step-title">اختر برنامجك</h3>
                    <p class="qd-regcta__step-text">تصفّح البرامج والدورات المتاحة وحدّد ما يناسبك.</p>
                </li>
                <li class="qd-regcta__step">
                    <span class="qd-regcta__num">2</span>
                    <h3 class="qd-regcta__step-title">سجّل بياناتك</h3>
                    <p class="qd-regcta__step-text">املأ نموذج الطلب ببياناتك أو بيانات ولي الأمر.</p>
                </li>
                <li class="qd-regcta__step">
                    <span class="qd-regcta__num">3</span>
                    <h3 class="qd-regcta__step-title">نتواصل معك</h3>
                    <p class="qd-regcta__step-text">يراجع فريقنا طلبك ويتواصل معك لإكمال الالتحاق.</p>
                </li>
            </ol>

            <div class="qd-regcta__actions">
                <a href="/register" class="qd-regcta__btn qd-regcta__btn--primary">
                    <i class="bi bi-pencil-square"></i> سجل معنا الآن
                </a>
                <a href="#programs" class="qd-regcta__btn qd-regcta__btn--soft">
                    <i class="bi bi-grid"></i> استعرض البرامج
                </a>
            </div>
        </div>
    </div>
</section>
