@using QdratNew.Enums
@inject QdratNew.Services.Frontend.CourseCollections.ICourseCollectionService CourseCollectionService
@{
    var vm = await CourseCollectionService.GetHomeSectionAsync();
    if (vm.Collections.Count == 0) { return; }
}

<style>
    :root {
        --ccs-navy:       #0c2340;
        --ccs-navy-mid:   #1a3a5c;
        --ccs-teal:       #0f766e;
        --ccs-teal-light: #14b8a6;
        --ccs-amber:      #f59e0b;
        --ccs-bg:         #f0f5f9;
        --ccs-border:     rgba(12,35,64,0.07);
        --ccs-shadow:     0 2px 14px rgba(12,35,64,0.06);
        --ccs-shadow-lg:  0 20px 56px rgba(12,35,64,0.18);
        --ccs-muted:      #64748b;
        --ccs-radius:     20px;
        --ccs-radius-lg:  28px;
    }

    /* ═══════════════ Grid style — bright hero card ═══════════════ */
    .ccs-section { position: relative; padding: 64px 0; direction: rtl; }

    .ccs-hero {
        position: relative; overflow: hidden; border-radius: var(--ccs-radius-lg);
        min-height: 460px; display: flex; align-items: center;
        background: linear-gradient(130deg, var(--ccs-navy) 0%, var(--ccs-navy-mid) 55%, #0d3b3a 100%);
        background-size: cover; background-position: center;
        box-shadow: var(--ccs-shadow-lg);
    }
    .ccs-hero-bg-pattern {
        position: absolute; inset: 0;
        background-image: radial-gradient(circle, rgba(255,255,255,0.07) 1.5px, transparent 1.5px);
        background-size: 30px 30px; pointer-events: none; opacity: .7;
    }
    .ccs-hero-glow-a { position: absolute; width: 460px; height: 460px; border-radius: 50%; filter: blur(110px); background: radial-gradient(circle, rgba(20,184,166,0.35), transparent 70%); top: -140px; left: -100px; pointer-events: none; }
    .ccs-hero-glow-b { position: absolute; width: 380px; height: 380px; border-radius: 50%; filter: blur(110px); background: radial-gradient(circle, rgba(245,158,11,0.22), transparent 70%); bottom: -120px; right: -80px; pointer-events: none; }
    .ccs-hero-overlay {
        position: absolute; inset: 0;
        background: linear-gradient(90deg, rgba(12,35,64,0.88) 0%, rgba(12,35,64,0.72) 45%, rgba(12,35,64,0.42) 100%);
    }

    .ccs-hero-content { position: relative; z-index: 2; padding: 64px 56px; max-width: 640px; }
    .ccs-hero-logo {
        width: 180px; height: 180px; margin-bottom: 22px;
        display: flex; align-items: center; justify-content: center;
        filter: drop-shadow(0 10px 24px rgba(0,0,0,0.35));
    }
    .ccs-hero-logo img { width: 100%; height: 100%; object-fit: contain; }
    .ccs-hero-logo i { font-size: 4.2rem; color: var(--ccs-teal-light); }

    .ccs-hero-eyebrow {
        display: inline-flex; align-items: center; gap: 8px;
        background: rgba(20,184,166,0.14); border: 1px solid rgba(20,184,166,0.32);
        color: var(--ccs-teal-light); font-size: 0.72rem; font-weight: 800; letter-spacing: .8px;
        padding: 6px 16px; border-radius: 50px; margin-bottom: 16px;
    }
    .ccs-hero-title { font-size: clamp(1.6rem, 3.2vw, 2.5rem); font-weight: 900; color: #fff; line-height: 1.28; margin-bottom: 12px; }
    .ccs-hero-subtitle { color: var(--ccs-teal-light); font-size: 1rem; font-weight: 700; margin-bottom: 10px; }
    .ccs-hero-desc { color: rgba(255,255,255,0.72); font-size: 0.93rem; line-height: 1.8; margin-bottom: 28px; max-width: 520px; }

    .ccs-hero-actions { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
    .ccs-hero-cta {
        display: inline-flex; align-items: center; gap: 10px;
        background: linear-gradient(135deg, var(--ccs-amber) 0%, #d97706 100%);
        color: #1c1917 !important; text-decoration: none !important;
        font-size: 0.94rem; font-weight: 800; padding: 15px 34px; border-radius: 14px;
        box-shadow: 0 10px 30px rgba(245,158,11,0.32); transition: transform .22s, box-shadow .22s;
    }
    .ccs-hero-cta:hover { transform: translateY(-3px); box-shadow: 0 16px 40px rgba(245,158,11,0.42); color: #1c1917 !important; }
    .ccs-hero-count {
        display: inline-flex; align-items: center; gap: 8px;
        color: rgba(255,255,255,0.75); font-size: 0.83rem; font-weight: 600;
    }
    .ccs-hero-count i { color: var(--ccs-teal-light); }

    @@media (max-width: 767px) {
        .ccs-hero { min-height: auto; }
        .ccs-hero-content { padding: 44px 26px; max-width: 100%; }
        .ccs-hero-logo { width: 120px; height: 120px; }
    }

    .ccs-sponsors-row { margin-top: 34px; text-align: center; }
    .ccs-sponsors-label { font-size: 0.75rem; font-weight: 700; color: var(--ccs-muted); margin-bottom: 16px; letter-spacing: .5px; }
    .ccs-sponsors-logos { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 22px; }
    .ccs-sponsor-logo { width: 64px; height: 64px; border-radius: 12px; background: #fff; border: 1px solid var(--ccs-border); display: flex; align-items: center; justify-content: center; box-shadow: var(--ccs-shadow); transition: transform .2s; }
    .ccs-sponsor-logo:hover { transform: translateY(-3px); }
    .ccs-sponsor-logo img { width: 46px; height: 46px; object-fit: contain; }

    /* ═══════════════ Spotlight style — immersive full-bleed dark ═══════════════ */
    .ccs-spot-section {
        position: relative; padding: 90px 0; direction: rtl; overflow: hidden;
        background: linear-gradient(130deg, var(--ccs-navy) 0%, var(--ccs-navy-mid) 55%, #0d2a45 100%);
        background-size: cover; background-position: center;
    }
    .ccs-spot-section::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(255,255,255,0.05) 1px, transparent 1px); background-size: 26px 26px; pointer-events: none; }
    .ccs-spot-scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(12,35,64,0.55) 0%, rgba(12,35,64,0.86) 100%); pointer-events: none; }
    .ccs-spot-glow-a { position: absolute; width: 480px; height: 480px; border-radius: 50%; filter: blur(100px); background: radial-gradient(circle, rgba(20,184,166,0.3), transparent 70%); top: -140px; left: -100px; pointer-events: none; }
    .ccs-spot-glow-b { position: absolute; width: 380px; height: 380px; border-radius: 50%; filter: blur(100px); background: radial-gradient(circle, rgba(245,158,11,0.18), transparent 70%); bottom: -100px; right: -60px; pointer-events: none; }

    .ccs-spot-inner { position: relative; z-index: 1; text-align: center; max-width: 720px; margin: 0 auto; }
    .ccs-spot-logo {
        width: 180px; height: 180px; margin: 0 auto 22px;
        display: flex; align-items: center; justify-content: center;
        filter: drop-shadow(0 12px 28px rgba(0,0,0,0.4));
    }
    .ccs-spot-logo img { width: 100%; height: 100%; object-fit: contain; }
    .ccs-spot-logo i { font-size: 4.2rem; color: var(--ccs-teal-light); }

    .ccs-spot-title { font-size: clamp(1.7rem, 3.4vw, 2.6rem); font-weight: 900; color: #fff; line-height: 1.28; margin-bottom: 10px; }
    .ccs-spot-subtitle { font-size: 1rem; color: var(--ccs-teal-light); font-weight: 700; margin-bottom: 14px; }
    .ccs-spot-desc { color: rgba(255,255,255,0.68); font-size: 0.92rem; line-height: 1.8; margin: 0 auto 28px; max-width: 560px; }

    .ccs-spot-count { display: inline-flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.7); font-size: 0.83rem; font-weight: 600; margin-bottom: 30px; }
    .ccs-spot-count i { color: var(--ccs-teal-light); }

    .ccs-spot-cta {
        display: inline-flex; align-items: center; gap: 10px;
        background: var(--ccs-amber); color: #1c1917 !important; text-decoration: none !important;
        font-size: 0.95rem; font-weight: 800; padding: 15px 36px; border-radius: 14px;
        box-shadow: 0 10px 30px rgba(245,158,11,0.3); transition: transform .22s, box-shadow .22s;
    }
    .ccs-spot-cta:hover { transform: translateY(-3px); box-shadow: 0 16px 40px rgba(245,158,11,0.4); color: #1c1917 !important; }

    .ccs-spot-sponsors { margin-top: 46px; position: relative; z-index: 1; }
    .ccs-spot-sponsors-label { font-size: 0.72rem; font-weight: 700; color: rgba(255,255,255,0.5); letter-spacing: .8px; text-transform: uppercase; margin-bottom: 18px; }
    .ccs-spot-sponsors-logos { display: flex; align-items: center; justify-content: center; gap: 16px; flex-wrap: wrap; }
    .ccs-spot-sponsor-logo { width: 54px; height: 54px; border-radius: 12px; background: rgba(255,255,255,0.94); display: flex; align-items: center; justify-content: center; transition: transform .2s; }
    .ccs-spot-sponsor-logo:hover { transform: translateY(-3px); }
    .ccs-spot-sponsor-logo img { width: 38px; height: 38px; object-fit: contain; }

    @@media (max-width: 767px) {
        .ccs-spot-logo { width: 130px; height: 130px; }
    }

    /* ── Reveal (shared) ── */
    .ccs-reveal { opacity: 0; transform: translateY(24px); transition: opacity .52s ease, transform .52s ease; }
    .ccs-reveal.ccs-visible { opacity: 1; transform: translateY(0); }
</style>

@foreach (var collection in vm.Collections)
{
    if (collection.DisplayStyle == CourseCollectionDisplayStyle.Spotlight)
    {
        @await Html.PartialAsync("MainPageSections/_CourseCollectionStyleSpotlight", collection)
    }
    else
    {
        @await Html.PartialAsync("MainPageSections/_CourseCollectionStyleGrid", collection)
    }
}

<script>
    (function () {
        var els = document.querySelectorAll('.ccs-reveal');
        if (!('IntersectionObserver' in window)) {
            els.forEach(function (el) { el.classList.add('ccs-visible'); });
            return;
        }
        var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
                if (e.isIntersecting) {
                    e.target.classList.add('ccs-visible');
                    io.unobserve(e.target);
                }
            });
        }, { threshold: 0.1 });
        els.forEach(function (el) { io.observe(el); });
    })();
</script>
