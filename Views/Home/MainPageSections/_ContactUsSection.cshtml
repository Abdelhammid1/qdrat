<style>
    :root {
        --cu-navy:    #0c2340;
        --cu-teal:    #0f766e;
        --cu-teal-lt: #14b8a6;
        --cu-amber:   #f59e0b;
        --cu-bg:      #f0f5f9;
        --cu-muted:   #64748b;
        --cu-border:  rgba(12,35,64,0.08);
        --cu-radius:  20px;
    }

    /* ── Section ── */
    .cu-section {
        background: var(--cu-bg);
        padding: 90px 0 100px;
        direction: rtl;
        position: relative;
        overflow: hidden;
    }
    .cu-section::before {
        content: '';
        position: absolute; inset: 0;
        background-image: radial-gradient(circle, rgba(12,35,64,0.048) 1px, transparent 1px);
        background-size: 26px 26px;
        pointer-events: none;
    }

    /* ambient blobs */
    .cu-blob {
        position: absolute; border-radius: 50%;
        filter: blur(90px); pointer-events: none;
    }
    .cu-blob--a {
        width: 500px; height: 500px;
        background: radial-gradient(circle, rgba(15,118,110,0.1), transparent 70%);
        bottom: -120px; left: -100px;
    }
    .cu-blob--b {
        width: 380px; height: 380px;
        background: radial-gradient(circle, rgba(12,35,64,0.08), transparent 70%);
        top: -80px; right: -80px;
    }

    /* ── Layout ── */
    .cu-layout {
        display: grid;
        grid-template-columns: 1fr 1.45fr;
        gap: 36px;
        align-items: center;
    }
    @@media (max-width: 991px) {
        .cu-layout { grid-template-columns: 1fr; }
        .cu-info { order: 2; }
        .cu-form-side { order: 1; }
    }

    /* ── Info Side ── */
    .cu-eyebrow {
        display: inline-flex; align-items: center; gap: 8px;
        background: linear-gradient(135deg, rgba(15,118,110,0.1), rgba(20,184,166,0.07));
        border: 1px solid rgba(15,118,110,0.2);
        color: var(--cu-teal);
        font-size: 0.775rem; font-weight: 700;
        padding: 7px 18px; border-radius: 50px;
        letter-spacing: 0.7px; text-transform: uppercase;
        margin-bottom: 20px;
    }
    .cu-eyebrow-dot {
        width: 7px; height: 7px;
        background: var(--cu-teal); border-radius: 50%;
        animation: cu-blink 2.2s ease-in-out infinite;
    }
    @@keyframes cu-blink {
        0%,100% { transform: scale(1); opacity: 1; }
        50%      { transform: scale(1.5); opacity: 0.5; }
    }

    .cu-title {
        font-size: clamp(1.7rem, 3vw, 2.4rem);
        font-weight: 900; color: var(--cu-navy);
        line-height: 1.25; margin-bottom: 14px;
        letter-spacing: -0.3px;
    }
    .cu-title span {
        background: linear-gradient(130deg, var(--cu-teal), var(--cu-teal-lt));
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .cu-desc {
        font-size: 0.95rem; color: var(--cu-muted);
        line-height: 1.75; margin-bottom: 32px; max-width: 440px;
    }

    /* Info cards */
    .cu-info-cards { display: flex; flex-direction: column; gap: 14px; }

    .cu-info-card {
        display: flex; align-items: center; gap: 14px;
        background: #fff;
        border: 1px solid var(--cu-border);
        border-radius: 14px;
        padding: 16px 18px;
        box-shadow: 0 2px 12px rgba(12,35,64,0.05);
        transition: transform 0.22s ease, box-shadow 0.22s ease;
    }
    .cu-info-card:hover {
        transform: translateX(-4px);
        box-shadow: 0 6px 24px rgba(12,35,64,0.1);
    }
    .cu-info-card-icon {
        width: 46px; height: 46px; border-radius: 12px;
        background: linear-gradient(135deg, var(--cu-teal), #065f46);
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: 1.1rem; flex-shrink: 0;
        box-shadow: 0 4px 12px rgba(15,118,110,0.22);
    }
    .cu-info-card-text strong {
        display: block; font-size: 0.82rem; font-weight: 700;
        color: var(--cu-navy); margin-bottom: 2px;
    }
    .cu-info-card-text span {
        font-size: 0.82rem; color: var(--cu-muted);
    }

    /* ── Form Card ── */
    .cu-form-card {
        background: #fff;
        border: 1px solid var(--cu-border);
        border-radius: var(--cu-radius);
        box-shadow: 0 4px 28px rgba(12,35,64,0.08);
        overflow: hidden;
    }

    .cu-form-top {
        padding: 24px 28px 20px;
        background: linear-gradient(135deg, #f8fbff 0%, #f0f8f6 100%);
        border-bottom: 1px solid rgba(12,35,64,0.07);
    }
    .cu-form-top h3 {
        font-size: 1.1rem; font-weight: 800; color: var(--cu-navy);
        margin: 0 0 3px;
        display: flex; align-items: center; gap: 10px;
    }
    .cu-form-top-icon {
        width: 36px; height: 36px; border-radius: 10px;
        background: linear-gradient(135deg, var(--cu-teal), #065f46);
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: 0.9rem; flex-shrink: 0;
    }
    .cu-form-top p {
        font-size: 0.82rem; color: var(--cu-muted); margin: 0; padding-right: 46px;
    }

    .cu-form-body { padding: 24px 28px 28px; }

    .cu-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    @@media (max-width: 575px) { .cu-row { grid-template-columns: 1fr; } }

    .cu-field { margin-bottom: 16px; }
    .cu-field:last-of-type { margin-bottom: 0; }

    .cu-label {
        display: flex; align-items: center; gap: 6px;
        font-size: 0.84rem; font-weight: 700; color: #374151;
        margin-bottom: 6px;
    }
    .cu-label-icon {
        width: 20px; height: 20px; border-radius: 5px;
        background: rgba(15,118,110,0.1);
        display: flex; align-items: center; justify-content: center;
        color: var(--cu-teal); font-size: 0.62rem; flex-shrink: 0;
    }
    .cu-required { color: #dc2626; }

    .cu-input {
        width: 100%; background: #fafbfc;
        border: 1.5px solid #e2e8f0;
        border-radius: 11px; padding: 10px 13px;
        font-size: 0.88rem; color: var(--cu-navy);
        transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
        outline: none; font-family: inherit;
    }
    .cu-input::placeholder { color: #b0bec5; }
    .cu-input:focus {
        border-color: var(--cu-teal);
        box-shadow: 0 0 0 3px rgba(15,118,110,0.1);
        background: #fff;
    }
    textarea.cu-input { resize: vertical; min-height: 100px; }

    /* Submit */
    .cu-submit {
        display: flex; align-items: center; justify-content: center; gap: 9px;
        width: 100%;
        background: linear-gradient(135deg, var(--cu-teal) 0%, #065f46 100%);
        color: #fff; border: none;
        border-radius: 12px; padding: 13px 20px;
        font-size: 0.92rem; font-weight: 700;
        cursor: pointer; font-family: inherit;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        margin-top: 18px;
    }
    .cu-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 28px rgba(15,118,110,0.3);
    }
    .cu-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; box-shadow: none; }

    /* Success / Error states */
    .cu-success {
        display: none;
        padding: 32px 28px;
        text-align: center;
    }
    .cu-success-icon {
        width: 72px; height: 72px; border-radius: 50%;
        background: linear-gradient(135deg, #dcfce7, #bbf7d0);
        border: 2px solid #86efac;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 16px;
        font-size: 1.8rem; color: #16a34a;
    }
    .cu-success h4 { font-size: 1.1rem; font-weight: 800; color: var(--cu-navy); margin-bottom: 8px; }
    .cu-success p { font-size: 0.88rem; color: var(--cu-muted); margin: 0; }
    .cu-success-new {
        display: inline-flex; align-items: center; gap: 7px;
        margin-top: 18px; font-size: 0.82rem; font-weight: 600;
        color: var(--cu-teal); cursor: pointer;
        background: none; border: none; font-family: inherit;
        text-decoration: underline; text-underline-offset: 3px;
    }

    .cu-error-alert {
        background: #fef2f2; border: 1px solid #fecaca;
        border-radius: 10px; padding: 12px 14px;
        font-size: 0.83rem; color: #991b1b;
        margin-bottom: 16px; display: none;
        align-items: flex-start; gap: 8px;
    }

    /* scroll-reveal */
    .cu-reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.55s ease, transform 0.55s ease; }
    .cu-reveal.cu-visible { opacity: 1; transform: translateY(0); }
    .cu-form-side.cu-reveal { transition-delay: 120ms; }
</style>

<section class="cu-section" id="contact" aria-label="تواصل معنا">
    <div class="cu-blob cu-blob--a" aria-hidden="true"></div>
    <div class="cu-blob cu-blob--b" aria-hidden="true"></div>

    <div class="container position-relative">
        <div class="cu-layout">

            <!-- ── Info Side ── -->
            <div class="cu-info cu-reveal">
                <div class="cu-eyebrow">
                    <span class="cu-eyebrow-dot" aria-hidden="true"></span>
                    نحن هنا لمساعدتك
                </div>
                <h2 class="cu-title">
                    تواصل معنا<br /><span>ونجيب على استفساراتك</span>
                </h2>
                <p class="cu-desc">
                    سواء كنت تبحث عن معلومات حول برامجنا، أو تحتاج مساعدة في اختيار الشهادة المناسبة — فريقنا جاهز للإجابة على جميع استفساراتك.
                </p>

                <div class="cu-info-cards">
                    <div class="cu-info-card">
                        <div class="cu-info-card-icon"><i class="fas fa-phone-volume" aria-hidden="true"></i></div>
                        <div class="cu-info-card-text">
                            <strong>تواصل هاتفياً</strong>
                            <span>السبت — الخميس، 8ص — 5م</span>
                        </div>
                    </div>
                    <div class="cu-info-card">
                        <div class="cu-info-card-icon"><i class="fas fa-envelope" aria-hidden="true"></i></div>
                        <div class="cu-info-card-text">
                            <strong>البريد الإلكتروني</strong>
                            <span>سنردّ خلال 24 ساعة عمل</span>
                        </div>
                    </div>
                    <div class="cu-info-card">
                        <div class="cu-info-card-icon"><i class="fab fa-whatsapp" aria-hidden="true"></i></div>
                        <div class="cu-info-card-text">
                            <strong>واتساب</strong>
                            <span>تواصل سريع مع فريق الدعم</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Form Side ── -->
            <div class="cu-form-side cu-reveal">
                <div class="cu-form-card">
                    <!-- Header -->
                    <div class="cu-form-top">
                        <h3>
                            <span class="cu-form-top-icon" aria-hidden="true"><i class="fas fa-paper-plane"></i></span>
                            أرسل رسالتك
                        </h3>
                        <p>سنردّ عليك في أقرب وقت ممكن</p>
                    </div>

                    <!-- Form -->
                    <div class="cu-form-body">
                        <div class="cu-error-alert" id="cuErrorAlert" role="alert">
                            <i class="fas fa-circle-exclamation" aria-hidden="true"></i>
                            <span id="cuErrorMsg"></span>
                        </div>

                        <form id="cuContactForm" novalidate>
                            @Html.AntiForgeryToken()

                            <div class="cu-row">
                                <div class="cu-field">
                                    <label class="cu-label" for="cuFullName">
                                        <span class="cu-label-icon"><i class="fas fa-user" aria-hidden="true"></i></span>
                                        الاسم الكامل <span class="cu-required">*</span>
                                    </label>
                                    <input type="text" id="cuFullName" name="FullName" class="cu-input"
                                           placeholder="أدخل اسمك" maxlength="100" required autocomplete="name" />
                                </div>

                                <div class="cu-field">
                                    <label class="cu-label" for="cuPhone">
                                        <span class="cu-label-icon"><i class="fas fa-mobile-screen" aria-hidden="true"></i></span>
                                        رقم الجوال
                                    </label>
                                    <input type="tel" id="cuPhone" name="PhoneNumber" class="cu-input"
                                           placeholder="05xxxxxxxx" maxlength="20" autocomplete="tel" dir="ltr" />
                                </div>
                            </div>

                            <div class="cu-field">
                                <label class="cu-label" for="cuEmail">
                                    <span class="cu-label-icon"><i class="fas fa-envelope" aria-hidden="true"></i></span>
                                    البريد الإلكتروني <span class="cu-required">*</span>
                                </label>
                                <input type="email" id="cuEmail" name="Email" class="cu-input"
                                       placeholder="example@email.com" maxlength="200" required autocomplete="email" dir="ltr" />
                            </div>

                            <div class="cu-field">
                                <label class="cu-label" for="cuMessage">
                                    <span class="cu-label-icon"><i class="fas fa-pen-to-square" aria-hidden="true"></i></span>
                                    رسالتك <span class="cu-required">*</span>
                                </label>
                                <textarea id="cuMessage" name="Message" class="cu-input" rows="4"
                                          placeholder="اكتب استفسارك أو رسالتك هنا..." maxlength="1000" required></textarea>
                            </div>

                            <button type="submit" class="cu-submit" id="cuSubmitBtn">
                                <i class="fas fa-paper-plane" aria-hidden="true"></i>
                                إرسال الرسالة
                            </button>
                        </form>

                        <!-- Success state -->
                        <div class="cu-success" id="cuSuccess">
                            <div class="cu-success-icon"><i class="fas fa-check" aria-hidden="true"></i></div>
                            <h4>تم إرسال رسالتك بنجاح!</h4>
                            <p>شكراً لتواصلك معنا. سيردّ عليك فريقنا في أقرب وقت ممكن.</p>
                            <button class="cu-success-new" id="cuNewMsg" type="button">
                                <i class="fas fa-plus" aria-hidden="true"></i>
                                إرسال رسالة أخرى
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<script>
    (function () {
        // Scroll reveal
        var els = document.querySelectorAll('#contact .cu-reveal');
        if ('IntersectionObserver' in window) {
            var io = new IntersectionObserver(function (entries) {
                entries.forEach(function (e) {
                    if (e.isIntersecting) { e.target.classList.add('cu-visible'); io.unobserve(e.target); }
                });
            }, { threshold: 0.1 });
            els.forEach(function (el) { io.observe(el); });
        } else {
            els.forEach(function (el) { el.classList.add('cu-visible'); });
        }

        // Form submit
        var form   = document.getElementById('cuContactForm');
        var btn    = document.getElementById('cuSubmitBtn');
        var success = document.getElementById('cuSuccess');
        var errBox = document.getElementById('cuErrorAlert');
        var errMsg = document.getElementById('cuErrorMsg');

        function showError(msg) {
            errMsg.textContent = msg;
            errBox.style.display = 'flex';
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-paper-plane"></i> إرسال الرسالة';
        }

        form.addEventListener('submit', function (e) {
            e.preventDefault();

            var name = document.getElementById('cuFullName').value.trim();
            var email = document.getElementById('cuEmail').value.trim();
            var msg = document.getElementById('cuMessage').value.trim();

            errBox.style.display = 'none';

            if (!name) { showError('يرجى إدخال الاسم الكامل.'); return; }
            if (!email) { showError('يرجى إدخال البريد الإلكتروني.'); return; }
            if (!msg) { showError('يرجى كتابة رسالتك.'); return; }

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جارٍ الإرسال...';

            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            var formData = new FormData(form);

            fetch('/Public/SendContact', {
                method: 'POST',
                headers: token ? { 'RequestVerificationToken': token.value } : {},
                body: formData
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.success) {
                    form.style.display = 'none';
                    success.style.display = 'block';
                } else {
                    showError(data.message || 'حدث خطأ. يرجى المحاولة مجدداً.');
                }
            })
            .catch(function () {
                showError('حدث خطأ في الاتصال. يرجى المحاولة مجدداً.');
            });
        });

        document.getElementById('cuNewMsg').addEventListener('click', function () {
            form.reset();
            success.style.display = 'none';
            form.style.display = 'block';
        });
    })();
</script>
