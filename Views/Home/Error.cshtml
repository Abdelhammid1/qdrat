@model QdratNew.Models.ErrorViewModel

@{
    ViewData["Title"] = "حدث خطأ";
}

<div class="container py-5 text-center" dir="rtl">
    <div class="alert alert-danger shadow-sm rounded-4">
        <h1 class="h4 mb-3">حدث خطأ غير متوقع</h1>
        <p class="mb-2">نعتذر، حدث خطأ أثناء تنفيذ الطلب.</p>

        @if (!string.IsNullOrWhiteSpace(Model?.RequestId))
        {
            <small class="text-muted d-block mt-3">
                رقم التتبع: @Model.RequestId
            </small>
        }
    </div>

    <a href="/" class="btn btn-primary mt-3">
        العودة للرئيسية
    </a>
</div>