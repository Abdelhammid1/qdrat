@model QdratNew.Entities.Frontend.FrontendCourse
@{
    ViewData["Title"] = Model.Title;
}

<div class="container-fluid p-0" dir="rtl">

    <!-- 🟦 سلايدر أو صورة الغلاف -->
    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <div class="position-relative">
            <img src="@Url.Content(Model.ImagePath)" alt="@Model.Title"
                 class="img-fluid w-100" style="max-height:450px;object-fit:cover;">
            <div class="position-absolute top-50 start-50 translate-middle text-center text-white bg-dark bg-opacity-50 p-4 rounded-4">
                <h2 class="fw-bold">@Model.Title</h2>
                <p class="mb-0">@Html.Raw(Model.ShortDescription ?? "")</p>
            </div>
        </div>
    }

    <div class="container py-5">

        <!-- 🟣 قائمة الدورات الفرعية -->
        @if (Model.SubCourses != null && Model.SubCourses.Any())
        {
            <div class="text-center mb-5">
                <h3 class="fw-bold text-success mb-3">📚 الدورات الفرعية المرتبطة</h3>
                <p class="text-muted">اختر الدورة التي تناسبك للتسجيل أو لمعرفة المزيد من التفاصيل.</p>
            </div>

            <div class="row g-4 justify-content-center">
                @foreach (var sub in Model.SubCourses.OrderBy(s => s.DisplayOrder))
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="card shadow-sm h-100 border-0 rounded-4 overflow-hidden hover-shadow">
                            <img src="@Url.Content(sub.ImagePath ?? "/images/default-course.jpg")"
                                 class="card-img-top" alt="@sub.Title"
                                 style="height:200px;object-fit:cover;">
                            <div class="card-body d-flex flex-column">
                                <h5 class="fw-bold text-primary text-center mb-2">@sub.Title</h5>
                                <p class="text-muted small flex-grow-1 text-center">
                                    @(string.IsNullOrEmpty(sub.ShortDescription)
                                                                ? "تعرف على محتوى هذه الدورة."
                                                                : (sub.ShortDescription.Length > 120 ? sub.ShortDescription.Substring(0, 120) + "..." : sub.ShortDescription))
                        </p>

                                <div class="text-center mt-3">
                                    <a href="/Public/SubCourses/Details/@sub.Slug"
                                       class="btn btn-outline-primary btn-sm me-2 px-4">📘 المزيد</a>

                                    <a href="/Public/Enrollments/Register/@sub.Id"
                                       class="btn btn-success btn-sm px-4">📝 سجّل الآن</a>
                                </div>
                            </div>
                        </div>
                    </div>
                        }
            </div>
        }

        <!-- 🟢 تفاصيل الدورة الرئيسية -->
        <div class="mt-5">
            <h3 class="fw-bold text-primary mb-3">عن الدورة الرئيسية</h3>

            @if (!string.IsNullOrEmpty(Model.FullDescription))
            {
                <div class="text-secondary lh-lg" style="font-size:1.05rem;">
                    @Html.Raw(Model.FullDescription)
                </div>
            }
            else
            {
                <p class="text-muted">سيتم تحديث تفاصيل الدورة قريبًا.</p>
            }

            <!-- زر التسجيل العام -->
         
        </div>
    </div>
</div>
