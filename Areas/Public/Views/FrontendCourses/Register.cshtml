@model QdratNew.Entities.Frontend.FrontendCourseRegistration
@{
    ViewData["Title"] = "التسجيل في الدورة";
    var course = ViewBag.Course as QdratNew.Entities.Frontend.FrontendCourse;
}

<div class="container my-5" dir="rtl">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">📝 التسجيل في @course.Title</h2>
    </div>

    <form asp-action="Register" method="post" class="shadow-sm bg-white p-4 rounded-4" style="max-width:600px;margin:auto;">
        <input type="hidden" asp-for="FrontendCourseId" />

        <div class="mb-3">
            <label class="form-label">الاسم الكامل</label>
            <input asp-for="FullName" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">البريد الإلكتروني</label>
            <input asp-for="Email" type="email" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">رقم الهوية الوطنية</label>
            <input asp-for="NationalId" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">رقم الجوال</label>
            <input asp-for="Phone" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">كلمة المرور</label>
            <input asp-for="Password" type="password" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-success w-100 py-2">✅ إرسال</button>
    </form>
</div>
