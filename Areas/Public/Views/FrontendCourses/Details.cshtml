@model QdratNew.Entities.Frontend.FrontendCourse
@{
    ViewData["Title"] = Model.Title;
}

<div class="container my-5" dir="rtl">

    <!-- 🟦 عنوان الدورة -->
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">@Model.Title</h2>
        @if (!string.IsNullOrEmpty(Model.ShortDescription))
        {
            <p class="lead">@Html.Raw(Model.ShortDescription)</p>
        }
    </div>

    <!-- 🖼️ صورة الغلاف -->
    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <div class="text-center mb-5">
            <img src="@Url.Content(Model.ImagePath)" alt="@Model.Title"
                 class="img-fluid rounded-4 shadow-sm" style="max-height:400px;object-fit:cover;" />
        </div>
    }

    <!-- 🟢 وصف الدورة الكامل -->
    @if (!string.IsNullOrEmpty(Model.FullDescription))
    {
        <div class="mb-5 text-secondary lh-lg" style="font-size:1.05rem;">
            @Html.Raw(Model.FullDescription)
        </div>
    }

    <!-- 🟣 عرض الدورات الفرعية -->
    @if (Model.SubCourses != null && Model.SubCourses.Any())
    {
        <h4 class="fw-bold text-center mb-4 text-success">الدورات الفرعية التابعة</h4>
        <div class="row g-4">
            @foreach (var sub in Model.SubCourses.OrderBy(s => s.DisplayOrder))
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0">
                        <img src="@Url.Content(sub.ImagePath ?? "/images/default-course.jpg")"
                             class="card-img-top" alt="@sub.Title"
                             style="height:200px;object-fit:cover;border-top-left-radius:10px;border-top-right-radius:10px;" />
                        <div class="card-body d-flex flex-column">
                            <h5 class="fw-bold text-dark">@sub.Title</h5>
                            <p class="text-muted small flex-grow-1">
                                @(string.IsNullOrEmpty(sub.ShortDescription)
                                                        ? "تعرف على محتوى هذه الدورة."
                                                        : (sub.ShortDescription.Length > 150 ? sub.ShortDescription.Substring(0, 150) + "..." : sub.ShortDescription))
                    </p>
                    <div class="text-center mt-3">
                        <a href="/Public/Enrollments/Register/@sub.Id" class="btn btn-success btn-sm px-4">
                            📝 سجّل الآن
                        </a>

                                <a href="/Public/SubCourses/Details/@sub.Slug" class="btn btn-outline-primary btn-sm px-3">
                                    📘 المزيد
                                </a>

                    </div>
                </div>
            </div>
        </div>
                }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center mt-5">
            لا توجد دورات فرعية لهذه الدورة حاليًا.
        </div>
    }

    <!-- 🟧 زر التسجيل العام -->
    <div class="text-center mt-5">
        <a href="/Public/FrontendCourses/Register/@Model.Id" class="btn btn-primary btn-lg px-5 py-2">
            ✍️ سجّل في الدورة الرئيسية
        </a>
    </div>

</div>
