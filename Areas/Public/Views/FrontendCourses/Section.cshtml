@model QdratNew.Entities.Frontend.FrontendCourseSection
@{
    ViewData["Title"] = Model.Title;
}

<div class="container my-5" dir="rtl">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">@Model.Title</h2>
        <p class="text-muted">ضمن دورة @Model.FrontendCourse.Title</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <div class="text-center mb-4">
            <img src="@Url.Content(Model.ImagePath)" class="img-fluid rounded shadow-sm" style="max-height:400px;" />
        </div>
    }

    <div class="card shadow border-0 p-4">
        @Html.Raw(Model.Content)
    </div>

    <div class="text-center mt-4">
        <a href="/Public/FrontendCourses/Details/@Model.FrontendCourse.Slug" class="btn btn-outline-secondary">
            ⬅ العودة إلى الدورة
        </a>
    </div>
</div>
