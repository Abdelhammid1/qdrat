<style>
    .subcourse-hero {
        position: relative;
        height: 400px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .subcourse-hero .hero-bg {
            position: absolute;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 0;
        }

    .feature-card:hover {
        transform: translateY(-8px);
        background: linear-gradient(180deg, #ffffff, #f5fdfc);
        box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    }

        .subcourse-hero .hero-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0,0.0);
            z-index: 1;
        }

        .subcourse-hero .hero-content {
            position: relative;
            z-index: 2;
            color: white;
            max-width: 700px;
        }

    .feature-card {
        border-radius: 15px;
        transition: transform 0.3s ease;
    }

        .feature-card:hover {
            transform: translateY(-8px);
        }

    .cta {
        background: linear-gradient(90deg, #006666, #00b3b3);
    }
</style>
