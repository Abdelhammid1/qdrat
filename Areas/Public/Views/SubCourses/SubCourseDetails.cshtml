    <div class="container">
        <h3 class="fw-bold mb-3">ابدأ الآن وارتقِ بمهاراتك</h3>
        <p class="lead">سجّل الآن وكن من ضمن المتدربين المتميزين في هذه الدورة</p>

        <!-- ✅ زر التسجيل المعدّل -->
