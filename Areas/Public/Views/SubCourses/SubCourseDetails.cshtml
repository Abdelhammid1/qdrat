@model QdratNew.Entities.Frontend.SubCourse
@{
    ViewData["Title"] = Model.Title;
}

<!-- 🎯 Hero Section -->
<section class="subcourse-hero text-center text-white position-relative">
    <img src="@Url.Content(Model.ImagePath ?? "/images/default-course.jpg")" class="hero-bg" alt="@Model.Title" />
    <div class="hero-overlay"></div>
   @*  <div class="hero-content">
        <h1 class="fw-bold">@Model.Title</h1>
        <p class="lead">@Html.Raw(Model.ShortDescription)</p>

        <!-- ✅ رابط التسجيل الصحيح باستخدام asp-route -->
        <a asp-area="Public" asp-controller="Enrollments" asp-action="Register"
           asp-route-subCourseId="@Model.Id"
           class="btn btn-lg btn-success mt-3">
            📝 سجّل الآن
        </a>
    </div> *@
</section>

<!-- 💡 Highlights -->
<section class="features py-5 bg-light text-center">
    <div class="container">
        <h3 class="fw-bold text-primary mb-4">لماذا تختار هذه الدورة؟</h3>
        <div class="row g-4">

            <div class="col-md-3 col-sm-6">
                <div class="card feature-card shadow-sm border-0 p-4">
                    <i class="bi bi-cpu-fill text-info fs-2 mb-3"></i>
                    <h5 class="fw-bold">تحليل أداء ذكي</h5>
                    <p class="text-muted small">
                        نظام ذكاء اصطناعي يقيّم مستوى المتدرب ويقترح مسار تعلم مخصص لتطويره.
                    </p>
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <div class="card feature-card shadow-sm border-0 p-4">
                    <i class="bi bi-lightning-charge-fill text-warning fs-2 mb-3"></i>
                    <h5 class="fw-bold">تطبيقات عملية تفاعلية</h5>
                    <p class="text-muted small">
                        محتوى تدريبي تطبيقي مع اختبارات تفاعلية تحاكي مواقف واقعية في الاختبار.
                    </p>
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <div class="card feature-card shadow-sm border-0 p-4">
                    <i class="bi bi-person-video3 text-success fs-2 mb-3"></i>
                    <h5 class="fw-bold">إشراف مباشر من المدربين</h5>
                    <p class="text-muted small">
                        متابعة شخصية من المدربين وتقارير تقدم أسبوعية لضمان التحسن المستمر.
                    </p>
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <div class="card feature-card shadow-sm border-0 p-4">
                    <i class="bi bi-diagram-3 text-primary fs-2 mb-3"></i>
                    <h5 class="fw-bold">خطة تعلم مخصصة</h5>
                    <p class="text-muted small">
                        النظام يكوّن مسارًا تدريبيًا يتناسب مع قدراتك ونقاط قوتك لتحسين النتائج بسرعة.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>


<!-- 🧠 About -->
<section class="about-course py-5">
    <div class="container">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-primary">عن الدورة</h3>
        </div>
        <div class="content px-md-5 text-secondary fs-5">
            @Html.Raw(Model.FullDescription)
        </div>
    </div>
</section>

<!-- 🚀 Call To Action -->
