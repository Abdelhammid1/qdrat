@model QdratNew.Areas.Public.Controllers.EnrollmentFormViewModel

@{
    ViewData["Title"] = "📋 التسجيل في الدورة";
}

<div class="container py-5" dir="rtl" style="font-family:'Cairo', sans-serif;">

    <!-- ✅ رسائل التنبيه -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center fw-bold shadow-sm">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success text-center fw-bold shadow-sm">@TempData["Success"]</div>
    }

    <!-- 🟦 العنوان الرئيسي -->
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">
            التسجيل في: <span class="text-success">@Model.SubCourseTitle</span>
        </h2>
        <p class="text-muted mt-2">
            الرجاء إدخال بياناتك بدقة لتأكيد الحجز في الدورة.
        </p>
    </div>

    <!-- 🧩 كارت النموذج -->
    <div class="card shadow-lg border-0 mx-auto" style="max-width:600px;border-radius:20px;">
        <div class="card-body p-4 p-md-5">

            <form asp-area="Public" asp-controller="Enrollments"
                  asp-action="Register"
                  asp-route-subCourseId="@Model.SubCourseId"
                  method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-bold text-secondary"></label>
                    <input asp-for="FullName" class="form-control form-control-lg shadow-sm" placeholder="اكتب اسمك الثلاثي" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NationalId" class="form-label fw-bold text-secondary"></label>
                    <input asp-for="NationalId" class="form-control form-control-lg shadow-sm" placeholder="أدخل رقم الهوية الوطنية" />
                    <span asp-validation-for="NationalId" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Phone" class="form-label fw-bold text-secondary"></label>
                    <input asp-for="Phone" class="form-control form-control-lg shadow-sm" placeholder="أدخل رقم الجوال" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>

                <!-- 🔹 ملاحظة توضيحية -->
            
                <!-- زر الإرسال -->
                <div class="text-center">
                    <button type="submit" class="btn btn-success btn-lg px-5 shadow-sm" style="border-radius:10px;">
                        ✅ تأكيد التسجيل
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ✅ بيانات الدورة -->
    <div class="text-center mt-5 text-muted">
        <p class="mb-1 fw-bold">البرنامج الرئيسي: <span class="text-dark">@Model.FrontCourseTitle</span></p>
        <small>شكراً لاختيارك منصة <span class="text-success fw-bold">قدرات</span> التعليمية 🌟</small>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
