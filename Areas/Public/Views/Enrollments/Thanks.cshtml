@model QdratNew.Entities.Frontend.FrontendCourseRegistration
@{
    ViewData["Title"] = "🎉 تم التسجيل بنجاح";
}

<div class="container text-center my-5" dir="rtl">
    <h2 class="fw-bold text-success mb-4">🎉 شكرًا لتسجيلك في @Model.SubCourse?.Title</h2>

    <p class="lead text-muted mb-4">
        تم استلام طلبك بنجاح، وسيتم التواصل معك قريبًا من إدارة <strong>@Model.SubCourse?.FrontendCourse?.Title</strong>.
    </p>

    <div class="alert alert-info w-75 mx-auto">
        <h5 class="fw-bold mb-2">📞 تواصل معنا للحجز والتنسيق:</h5>
        <p class="mb-1">رقم الهاتف: <strong>985 657 552 966+ - 590 217 0144</strong></p>
        <p class="mb-0">البريد الإلكتروني: <strong>support@qdrat.edu.sa</strong></p>
    </div>

    <div class="mt-4 d-flex justify-content-center gap-3">
        <a href="/" class="btn btn-primary px-4">🏠 العودة إلى الصفحة الرئيسية</a>

        <!-- 🔗 زر جديد لعرض تفاصيل الدورة -->
        @if (Model.SubCourse != null)
        {
            <a href="/Public/SubCourses/Details/@Model.SubCourse.Slug" class="btn btn-outline-success px-4">
                📘 عرض تفاصيل الدورة
            </a>
        }
    </div>
</div>
