@model QdratNew.ViewModels.Frontend.CourseCollections.CourseCollectionThanksViewModel
@{
    ViewData["Title"] = "تم استلام طلبك بنجاح";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}

<style>
    .thanks-page {
        background: #f5f9fc;
        min-height: 80vh;
        display: flex;
        align-items: center;
        padding: 80px 0;
        direction: rtl;
    }
    .thanks-card {
        background: #fff;
        border-radius: 20px;
        padding: 56px 40px;
        text-align: center;
        border: 0.5px solid #dbe7ef;
        max-width: 560px;
        margin: 0 auto;
    }
    .thanks-icon {
        width: 88px;
        height: 88px;
        background: #dcfce7;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 24px;
    }
    .thanks-icon i { font-size: 2.5rem; color: #16a34a; }
    .thanks-title { color: #0f2f4a; font-size: 1.5rem; font-weight: 800; margin-bottom: 8px; }
    .thanks-subtitle { color: #64748b; font-size: 0.95rem; margin-bottom: 32px; }
    .thanks-info { background: #f8fafc; border-radius: 12px; padding: 20px; margin-bottom: 28px; text-align: right; }
    .thanks-info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid #e2e8f0;
        font-size: 0.88rem;
    }
    .thanks-info-row:last-child { border-bottom: none; }
    .thanks-info-label { color: #64748b; font-weight: 500; }
    .thanks-info-value { color: #1f2937; font-weight: 700; }
    .thanks-btn {
        display: inline-block;
        background: linear-gradient(135deg, #0f766e, #065f46);
        color: #fff;
        padding: 13px 36px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.92rem;
        text-decoration: none;
        transition: opacity 0.2s;
    }
    .thanks-btn:hover { opacity: 0.88; color: #fff; }
</style>

<div class="thanks-page">
    <div class="container">
        <div class="thanks-card">
            <div class="thanks-icon">
                <i class="fas fa-circle-check"></i>
            </div>
            <h1 class="thanks-title">تم استلام طلبك بنجاح!</h1>
            <p class="thanks-subtitle">
                شكراً لاهتمامك بـ @Model.CollectionName. سيتواصل معك فريق الدعم الفني قريباً لاستكمال تفاصيل التسجيل.
            </p>

            <div class="thanks-info">
                <div class="thanks-info-row">
                    <span class="thanks-info-label">المجموعة</span>
                    <span class="thanks-info-value">@Model.CollectionName</span>
                </div>
                <div class="thanks-info-row">
                    <span class="thanks-info-label">الدورة المختارة</span>
                    <span class="thanks-info-value">@Model.CourseTitleAr</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.StandardCode))
                {
                    <div class="thanks-info-row">
                        <span class="thanks-info-label">الكود</span>
                        <span class="thanks-info-value" style="font-family:monospace">@Model.StandardCode</span>
                    </div>
                }
                <div class="thanks-info-row">
                    <span class="thanks-info-label">رقم الطلب</span>
                    <span class="thanks-info-value">#@Model.RegistrationId</span>
                </div>
                <div class="thanks-info-row">
                    <span class="thanks-info-label">تاريخ الطلب</span>
                    <span class="thanks-info-value">@Model.SubmittedAt.ToString("dd/MM/yyyy — hh:mm tt")</span>
                </div>
            </div>

            <a href="/" class="thanks-btn">
                <i class="fas fa-house me-2"></i>
                العودة إلى الصفحة الرئيسية
            </a>
        </div>
    </div>
</div>
