@model QdratNew.ViewModels.Frontend.CourseCollections.CourseCollectionMultiThanksViewModel
@{
    ViewData["Title"] = "تم استلام طلبك";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}

<style>
    .mt-page {
        background: #f0f5f9; min-height: 80vh;
        padding: 72px 0 96px; direction: rtl;
        display: flex; align-items: center;
    }
    .mt-card {
        background: #fff; border-radius: 24px;
        padding: 56px 48px; text-align: center;
        border: 1px solid rgba(12,35,64,0.07);
        box-shadow: 0 8px 40px rgba(12,35,64,0.1);
        max-width: 620px; margin: 0 auto;
    }
    .mt-icon-wrap {
        width: 88px; height: 88px; border-radius: 50%;
        background: linear-gradient(135deg, #dcfce7, #bbf7d0);
        border: 3px solid #86efac;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 24px;
        animation: mt-pop 0.5s cubic-bezier(.22,.68,0,1.2);
    }
    @@keyframes mt-pop {
        from { transform: scale(0.5); opacity: 0; }
        to   { transform: scale(1);   opacity: 1; }
    }
    .mt-icon-wrap i { font-size: 2.4rem; color: #16a34a; }

    .mt-card h2 { font-size: 1.6rem; font-weight: 900; color: #0c2340; margin-bottom: 8px; }
    .mt-card .mt-sub { font-size: 0.92rem; color: #64748b; margin-bottom: 28px; line-height: 1.6; }

    .mt-courses-list {
        background: #f8fafc; border-radius: 14px;
        border: 1px solid rgba(12,35,64,0.07);
        padding: 18px 20px; text-align: right;
        margin-bottom: 28px;
    }
    .mt-courses-title {
        font-size: 0.75rem; font-weight: 700; color: #0f766e;
        letter-spacing: 0.8px; text-transform: uppercase;
        margin-bottom: 12px;
        display: flex; align-items: center; gap: 6px;
    }
    .mt-course-item {
        display: flex; align-items: center; gap: 8px;
        font-size: 0.86rem; color: #0c2340; font-weight: 600;
        padding: 6px 0;
        border-bottom: 1px solid rgba(12,35,64,0.05);
    }
    .mt-course-item:last-child { border-bottom: none; }
    .mt-course-item i { color: #0f766e; font-size: 0.78rem; flex-shrink: 0; }

    .mt-steps {
        display: flex; flex-direction: column; gap: 12px;
        margin-bottom: 28px;
    }
    .mt-step {
        display: flex; align-items: center; gap: 12px;
        background: #f0fdf9; border-radius: 10px; padding: 12px 16px;
        border: 1px solid rgba(15,118,110,0.1);
        font-size: 0.83rem; color: #0c2340; text-align: right;
    }
    .mt-step-num {
        width: 28px; height: 28px; border-radius: 50%;
        background: #0f766e; color: #fff;
        display: flex; align-items: center; justify-content: center;
        font-size: 0.75rem; font-weight: 800; flex-shrink: 0;
    }

    .mt-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    .mt-btn-primary {
        display: inline-flex; align-items: center; gap: 7px;
        background: linear-gradient(135deg, #0f766e, #065f46);
        color: #fff !important; font-weight: 700; font-size: 0.88rem;
        padding: 12px 28px; border-radius: 11px; text-decoration: none !important;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .mt-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(15,118,110,0.3); color: #fff !important; }
    .mt-btn-sec {
        display: inline-flex; align-items: center; gap: 7px;
        background: #f1f5f9; color: #0c2340 !important;
        font-weight: 700; font-size: 0.88rem;
        padding: 12px 24px; border-radius: 11px; text-decoration: none !important;
        border: 1px solid #e2e8f0;
        transition: background 0.2s;
    }
    .mt-btn-sec:hover { background: #e2e8f0; color: #0c2340 !important; }

    @@media (max-width: 575px) {
        .mt-card { padding: 40px 24px; }
        .mt-actions { flex-direction: column; }
        .mt-btn-primary, .mt-btn-sec { width: 100%; justify-content: center; }
    }
</style>

<div class="mt-page">
    <div class="container">
        <div class="mt-card">
            <div class="mt-icon-wrap">
                <i class="fas fa-check" aria-hidden="true"></i>
            </div>

            <h2>تم استلام طلبك بنجاح!</h2>
            <p class="mt-sub">
                شكراً لك <strong>@Model.FullName</strong>، تم استلام طلب تسجيلك في
                @Model.RegisteredCourseNames.Count @(Model.RegisteredCourseNames.Count == 1 ? "دورة" : "دورات")
                من مجموعة @Model.CollectionName بنجاح.
            </p>

            @if (Model.RegisteredCourseNames.Any())
            {
                <div class="mt-courses-list">
                    <div class="mt-courses-title">
                        <i class="fas fa-list-check" aria-hidden="true"></i>
                        الدورات المسجّل بها
                    </div>
                    @foreach (var name in Model.RegisteredCourseNames)
                    {
                        <div class="mt-course-item">
                            <i class="fas fa-circle-check" aria-hidden="true"></i>
                            @name
                        </div>
                    }
                </div>
            }

            <div class="mt-steps">
                <div class="mt-step">
                    <span class="mt-step-num">١</span>
                    <span>سيراجع فريقنا المتخصص طلبك خلال 24-48 ساعة</span>
                </div>
                <div class="mt-step">
                    <span class="mt-step-num">٢</span>
                    <span>سيتواصل معك أحد مستشارينا على رقم الجوال المسجّل</span>
                </div>
                <div class="mt-step">
                    <span class="mt-step-num">٣</span>
                    <span>تُكمل إجراءات التسجيل وتبدأ رحلتك في هذه المجموعة</span>
                </div>
            </div>

            <div class="mt-actions">
                <a href="/" class="mt-btn-primary">
                    <i class="fas fa-house" aria-hidden="true"></i> العودة للرئيسية
                </a>
                <a href="/Public/CourseCollections/@Model.CollectionSlug/Register" class="mt-btn-sec">
                    <i class="fas fa-plus" aria-hidden="true"></i> طلب آخر
                </a>
            </div>
        </div>
    </div>
</div>
