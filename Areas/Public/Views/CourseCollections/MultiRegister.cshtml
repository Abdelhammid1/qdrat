@model QdratNew.ViewModels.Frontend.CourseCollections.CourseCollectionMultiRegisterViewModel
@{
    ViewData["Title"] = "التسجيل في " + Model.CollectionName;
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}

<style>
/* ═══════════════════════════════════════════════════
   TOKENS
═══════════════════════════════════════════════════ */
:root {
    --rg-navy:      #0c2340;
    --rg-navy-deep: #071626;
    --rg-navy-mid:  #142e52;
    --rg-teal:      #0f766e;
    --rg-teal-lt:   #14b8a6;
    --rg-amber:     #f59e0b;
    --rg-amber-dk:  #d97706;
    --rg-white:     #ffffff;
    --rg-bg:        #eef3f9;
    --rg-muted:     #64748b;
    --rg-danger:    #dc2626;
    --rg-radius:    18px;
    --rg-trans:     0.22s ease;
}

.rg-page { direction: rtl; background: var(--rg-bg); min-height: 100vh; }

.rg-hero { background: var(--rg-navy); position: relative; overflow: hidden; padding: 56px 0 76px; }
.rg-hero::before {
    content: ''; position: absolute; inset: 0;
    background:
        radial-gradient(ellipse 80% 60% at 20% 50%, rgba(15,118,110,0.22) 0%, transparent 60%),
        radial-gradient(ellipse 60% 80% at 80% 20%, rgba(245,158,11,0.10) 0%, transparent 55%),
        radial-gradient(ellipse 50% 70% at 60% 90%, rgba(20,184,166,0.12) 0%, transparent 50%);
    pointer-events: none;
}
.rg-hero::after {
    content: ''; position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,0.055) 1px, transparent 1px);
    background-size: 28px 28px; pointer-events: none;
}
.rg-hero-inner { position: relative; z-index: 1; text-align: center; }
.rg-hero-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(245,158,11,0.12); border: 1px solid rgba(245,158,11,0.28);
    color: var(--rg-amber); font-size: 0.72rem; font-weight: 800; letter-spacing: 1.2px;
    text-transform: uppercase; padding: 7px 20px; border-radius: 50px; margin-bottom: 20px;
}
.rg-hero h1 { font-size: clamp(1.7rem, 3.5vw, 2.6rem); font-weight: 900; color: var(--rg-white); line-height: 1.2; margin-bottom: 14px; }
.rg-hero h1 span { color: var(--rg-teal-lt); }
.rg-hero-sub { font-size: 0.93rem; color: rgba(255,255,255,0.6); max-width: 540px; margin: 0 auto 36px; line-height: 1.75; }

.rg-steps {
    display: inline-flex; align-items: center; background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1); border-radius: 50px; padding: 8px 24px;
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
}
.rg-step { display: flex; align-items: center; gap: 8px; font-size: 0.78rem; font-weight: 700; color: rgba(255,255,255,0.38); padding: 0 12px; }
.rg-step.active { color: var(--rg-teal-lt); }
.rg-step-num {
    width: 26px; height: 26px; border-radius: 50%; background: rgba(255,255,255,0.1);
    display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 900; flex-shrink: 0;
}
.rg-step.active .rg-step-num { background: var(--rg-teal); color: #fff; box-shadow: 0 0 0 4px rgba(15,118,110,0.28); }
.rg-step-div { width: 28px; height: 1px; background: rgba(255,255,255,0.14); flex-shrink: 0; }

.rg-breadcrumb { display: flex; align-items: center; gap: 7px; font-size: 0.79rem; color: rgba(255,255,255,0.42); margin-bottom: 28px; position: relative; z-index: 1; }
.rg-breadcrumb a { color: rgba(255,255,255,0.58); text-decoration: none; transition: color var(--rg-trans); }
.rg-breadcrumb a:hover { color: var(--rg-teal-lt); }
.rg-breadcrumb .bc-sep { font-size: 0.55rem; }
.rg-breadcrumb .bc-cur { color: rgba(255,255,255,0.7); font-weight: 600; }

.rg-body { padding: 52px 0 80px; }
.rg-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start; }
@@media (max-width: 899px) {
    .rg-layout { grid-template-columns: 1fr; }
    .rg-courses-col { order: 1; }
    .rg-form-col    { order: 2; }
}

.rg-col-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 10px; }
.rg-col-title { font-size: 1rem; font-weight: 900; color: var(--rg-navy); display: flex; align-items: center; gap: 9px; }
.rg-col-title-icon {
    width: 34px; height: 34px; border-radius: 9px; background: linear-gradient(135deg, var(--rg-teal), #065f46);
    display: flex; align-items: center; justify-content: center; color: #fff; font-size: 0.85rem; flex-shrink: 0;
}
.rg-counter-pill {
    display: inline-flex; align-items: center; gap: 6px; padding: 5px 14px; border-radius: 50px;
    font-size: 0.78rem; font-weight: 700; background: #e2e8f0; color: var(--rg-muted);
    transition: background var(--rg-trans), color var(--rg-trans), transform var(--rg-trans); cursor: default;
}
.rg-counter-pill.has-sel { background: var(--rg-teal); color: #fff; animation: rg-pop 0.35s cubic-bezier(.22,.68,0,1.2); }
@@keyframes rg-pop { 0% { transform: scale(0.92); } 60% { transform: scale(1.07); } 100% { transform: scale(1); } }

.rg-courses-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
@@media (max-width: 599px) { .rg-courses-grid { grid-template-columns: 1fr; } }
@@media (min-width: 1300px) { .rg-courses-grid { grid-template-columns: repeat(3, 1fr); } }

.rg-course-card {
    position: relative; background: var(--rg-white); border: 2px solid transparent; border-radius: var(--rg-radius);
    cursor: pointer; user-select: none; overflow: hidden;
    transition: border-color var(--rg-trans), box-shadow var(--rg-trans), transform var(--rg-trans), background var(--rg-trans);
    opacity: 0; transform: translateY(16px); animation: rg-card-in 0.4s ease forwards;
}
@@keyframes rg-card-in { to { opacity: 1; transform: translateY(0); } }
.rg-course-card:hover:not(.rg-unavail) { border-color: rgba(15,118,110,0.32); box-shadow: 0 6px 28px rgba(15,118,110,0.11); transform: translateY(-3px); }
.rg-course-card.rg-sel {
    border-color: var(--rg-teal); background: linear-gradient(145deg, #f0fdf9 0%, #e6fbf8 100%);
    box-shadow: 0 0 0 4px rgba(15,118,110,0.09), 0 8px 32px rgba(15,118,110,0.17); transform: translateY(-2px);
}
.rg-course-card.rg-unavail { opacity: 0.5; cursor: not-allowed; background: #f8fafc; }

.rg-card-bar { height: 4px; background: linear-gradient(90deg, var(--rg-teal), var(--rg-teal-lt)); opacity: 0; transition: opacity var(--rg-trans); }
.rg-course-card.rg-sel .rg-card-bar { opacity: 1; }

.rg-card-body { padding: 18px 16px 14px; }
.rg-card-top { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 10px; }

.rg-card-logo {
    width: 64px; height: 64px; border-radius: 14px; border: 1.5px solid rgba(15,118,110,0.12);
    background: linear-gradient(135deg, #f0fdf9, #e8f9f6); display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; overflow: hidden; transition: border-color var(--rg-trans), box-shadow var(--rg-trans);
}
.rg-card-logo img { width: 48px; height: 48px; object-fit: contain; }
.rg-course-card.rg-sel .rg-card-logo { border-color: rgba(15,118,110,0.28); box-shadow: 0 0 0 3px rgba(15,118,110,0.07); }

.rg-card-icon {
    width: 64px; height: 64px; border-radius: 14px; background: linear-gradient(135deg, var(--rg-teal), #065f46);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.rg-card-icon i { font-size: 1.5rem; color: #fff; }

.rg-card-meta { flex: 1; min-width: 0; }
.rg-card-title {
    font-size: 0.87rem; font-weight: 800; color: var(--rg-navy); line-height: 1.4; margin-bottom: 7px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.rg-card-tags { display: flex; align-items: center; gap: 5px; flex-wrap: wrap; }
.rg-tag-code {
    display: inline-flex; align-items: center; gap: 3px; background: #fffbeb; color: #92400e; border: 1px solid #fde68a;
    font-size: 0.6rem; font-weight: 800; padding: 2px 7px; border-radius: 4px; font-family: 'Courier New', monospace;
}
.rg-tag-badge { display: inline-block; background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; font-size: 0.6rem; font-weight: 700; padding: 2px 7px; border-radius: 4px; }

.rg-check-circle {
    width: 26px; height: 26px; border-radius: 50%; border: 2px solid #cbd5e1; background: #fff;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px; transition: all var(--rg-trans);
}
.rg-check-circle i { font-size: 0.65rem; color: #fff; opacity: 0; transform: scale(0.3) rotate(-10deg); transition: all 0.22s cubic-bezier(.22,.68,0,1.3); }
.rg-course-card.rg-sel .rg-check-circle { background: var(--rg-teal); border-color: var(--rg-teal); box-shadow: 0 0 0 3px rgba(15,118,110,0.16); }
.rg-course-card.rg-sel .rg-check-circle i { opacity: 1; transform: scale(1) rotate(0deg); }

.rg-card-desc { font-size: 0.75rem; color: var(--rg-muted); line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

.rg-card-foot { padding: 9px 16px; border-top: 1px solid rgba(12,35,64,0.05); display: flex; align-items: center; justify-content: space-between; }
.rg-avail-tag { display: inline-flex; align-items: center; gap: 5px; font-size: 0.67rem; font-weight: 700; color: #059669; }
.rg-avail-tag i { font-size: 0.5rem; }
.rg-unavail-tag { display: inline-flex; align-items: center; gap: 5px; background: #fee2e2; color: #991b1b; font-size: 0.67rem; font-weight: 700; padding: 3px 8px; border-radius: 5px; }
.rg-hint-tap { font-size: 0.67rem; color: var(--rg-teal); font-weight: 600; opacity: 0; transition: opacity var(--rg-trans); }
.rg-course-card:hover:not(.rg-unavail):not(.rg-sel) .rg-hint-tap { opacity: 1; }
.rg-course-card input[type="checkbox"] { position: absolute; opacity: 0; pointer-events: none; }

.rg-alert-no-sel {
    display: none; align-items: center; gap: 10px; background: linear-gradient(135deg, #fef3c7, #fffbeb);
    border: 1px solid #fde68a; border-right: 4px solid var(--rg-amber); border-radius: 12px; padding: 13px 16px;
    font-size: 0.83rem; color: #78350f; font-weight: 600; margin-top: 16px; animation: rg-alert-slide 0.28s ease;
}
@@keyframes rg-alert-slide { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

.rg-form-panel { position: sticky; top: 80px; border-radius: var(--rg-radius); overflow: hidden; box-shadow: 0 20px 60px rgba(7,22,38,0.28), 0 4px 18px rgba(7,22,38,0.16); }
.rg-form-head { background: linear-gradient(160deg, var(--rg-navy-mid) 0%, var(--rg-navy-deep) 100%); padding: 28px 28px 22px; position: relative; overflow: hidden; }
.rg-form-head::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 20px 20px; pointer-events: none; }
.rg-form-head::after { content: ''; position: absolute; top: -50px; left: -50px; width: 180px; height: 180px; background: radial-gradient(circle, rgba(15,118,110,0.22), transparent 65%); pointer-events: none; }
.rg-form-head-ct { position: relative; z-index: 1; }
.rg-form-head-icon {
    width: 46px; height: 46px; border-radius: 12px; background: linear-gradient(135deg, var(--rg-teal), #065f46);
    display: flex; align-items: center; justify-content: center; color: #fff; font-size: 1.1rem; margin-bottom: 14px;
    box-shadow: 0 4px 16px rgba(15,118,110,0.35);
}
.rg-form-head h3 { font-size: 1.05rem; font-weight: 900; color: #fff; margin: 0 0 5px; }
.rg-form-head p { font-size: 0.78rem; color: rgba(255,255,255,0.48); margin: 0; }

.rg-sel-strip {
    background: rgba(15,118,110,0.1); border-top: 1px solid rgba(15,118,110,0.18); padding: 10px 28px;
    display: flex; align-items: center; gap: 8px; font-size: 0.78rem; color: var(--rg-teal-lt); font-weight: 700; min-height: 44px;
}
.rg-sel-strip .rg-sel-badge { background: var(--rg-teal); color: #fff; border-radius: 20px; padding: 1px 9px; font-size: 0.72rem; font-weight: 800; display: inline-block; }

.rg-form-body { background: #fff; padding: 24px 28px 28px; }
.rg-err-box {
    background: #fef2f2; border: 1px solid #fecaca; border-right: 4px solid var(--rg-danger); border-radius: 10px;
    padding: 12px 14px; margin-bottom: 16px; font-size: 0.82rem; color: #991b1b; display: flex; gap: 8px; align-items: flex-start;
}
.rg-err-box i { flex-shrink: 0; margin-top: 2px; }

.rg-field { margin-bottom: 15px; }
.rg-label { display: flex; align-items: center; gap: 6px; font-size: 0.8rem; font-weight: 700; color: #374151; margin-bottom: 6px; }
.rg-lbl-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--rg-teal); flex-shrink: 0; }
.rg-req { color: var(--rg-amber); font-weight: 900; }

.rg-input {
    width: 100%; background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 10px; padding: 10px 13px;
    font-size: 0.87rem; color: var(--rg-navy); font-family: inherit; outline: none;
    transition: border-color var(--rg-trans), box-shadow var(--rg-trans), background var(--rg-trans);
}
.rg-input::placeholder { color: #b0bec5; font-size: 0.82rem; }
.rg-input:focus { border-color: var(--rg-teal); box-shadow: 0 0 0 3px rgba(15,118,110,0.11); background: #fff; }
textarea.rg-input { resize: vertical; min-height: 80px; }
.rg-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
@@media (max-width: 479px) { .rg-2col { grid-template-columns: 1fr; } }
.field-validation-error { font-size: 0.72rem; color: var(--rg-danger); margin-top: 4px; display: block; }

.rg-submit {
    display: flex; align-items: center; justify-content: center; gap: 9px; width: 100%;
    background: linear-gradient(135deg, var(--rg-amber), var(--rg-amber-dk)); color: var(--rg-navy); border: none;
    border-radius: 12px; padding: 14px 22px; font-size: 0.92rem; font-weight: 900; font-family: inherit; cursor: pointer;
    letter-spacing: 0.2px; margin-top: 8px; box-shadow: 0 4px 20px rgba(245,158,11,0.28);
    transition: transform var(--rg-trans), box-shadow var(--rg-trans), filter var(--rg-trans);
}
.rg-submit:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(245,158,11,0.38); filter: brightness(1.04); }
.rg-submit:disabled { opacity: 0.65; cursor: not-allowed; transform: none; box-shadow: none; filter: none; }
.rg-submit .rg-arrow-chip { display: flex; align-items: center; gap: 4px; background: rgba(12,35,64,0.12); padding: 3px 9px; border-radius: 20px; font-size: 0.77rem; font-weight: 700; }

.rg-trust {
    display: flex; align-items: flex-start; gap: 7px; margin-top: 14px; font-size: 0.73rem; color: var(--rg-muted);
    line-height: 1.55; background: #f8fafc; border-radius: 9px; padding: 10px 12px; border: 1px solid #e9eef5;
}
.rg-trust i { color: var(--rg-teal); flex-shrink: 0; margin-top: 2px; }
</style>

<div class="rg-page">

    <!-- ══ HERO ══ -->
    <div class="rg-hero">
        <div class="container">
            <nav class="rg-breadcrumb" aria-label="breadcrumb">
                <a href="/"><i class="fas fa-house" aria-hidden="true"></i> الرئيسية</a>
                <i class="fas fa-chevron-left bc-sep" aria-hidden="true"></i>
                <a href="/#course-collections">@Model.CollectionName</a>
                <i class="fas fa-chevron-left bc-sep" aria-hidden="true"></i>
                <span class="bc-cur">التسجيل</span>
            </nav>

            <div class="rg-hero-inner">
                <div class="rg-hero-eyebrow">
                    <i class="fas fa-award" aria-hidden="true"></i>
                    @Model.CollectionName
                </div>
                <h1>اختر <span>الدورات</span><br>التي تهمّك من هذه المجموعة</h1>
                <p class="rg-hero-sub">
                    حدّد الدورات التي تناسبك، وأدخل بياناتك الشخصية — سيتواصل معك فريقنا المتخصص لإتمام إجراءات التسجيل
                </p>

                <div class="rg-steps">
                    <div class="rg-step active">
                        <span class="rg-step-num">١</span>
                        اختر الدورات
                    </div>
                    <div class="rg-step-div"></div>
                    <div class="rg-step active">
                        <span class="rg-step-num">٢</span>
                        أدخل بياناتك
                    </div>
                    <div class="rg-step-div"></div>
                    <div class="rg-step">
                        <span class="rg-step-num">٣</span>
                        انتظر التواصل
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ BODY ══ -->
    <div class="rg-body">
        <div class="container">
            <div class="rg-layout">

                <!-- ═ COURSES COL ═ -->
                <div class="rg-courses-col">

                    <div class="rg-col-head">
                        <div class="rg-col-title">
                            <span class="rg-col-title-icon" aria-hidden="true">
                                <i class="fas fa-layer-group"></i>
                            </span>
                            اختر الدورات التي تهمّك
                        </div>
                        <div class="rg-counter-pill" id="rgCountPill">
                            <i class="fas fa-circle-check" aria-hidden="true"></i>
                            <span id="rgCountTxt">لم تختر أي دورة</span>
                        </div>
                    </div>

                    <div class="rg-courses-grid" id="rgGrid">
                        @{ int ci = 0; }
                        @foreach (var course in Model.Courses)
                        {
                            ci++;
                            var isUnavail = !course.IsAvailable;
                            <div class="rg-course-card @(isUnavail ? "rg-unavail" : "")"
                                 id="rgCard-@course.Id"
                                 style="animation-delay:@(ci * 0.07)s"
                                 onclick="rgToggle(@course.Id)"
                                 role="checkbox"
                                 aria-checked="false"
                                 tabindex="@(isUnavail ? "-1" : "0")"
                                 @(isUnavail ? Html.Raw("aria-disabled=\"true\"") : Html.Raw(""))>

                                <input type="checkbox"
                                       value="@course.Id"
                                       id="rgChk-@course.Id"
                                       @(isUnavail ? "disabled" : "") />

                                <div class="rg-card-bar" aria-hidden="true"></div>

                                <div class="rg-card-body">
                                    <div class="rg-card-top">
                                        @if (!string.IsNullOrEmpty(course.LogoPath))
                                        {
                                            <div class="rg-card-logo">
                                                <img src="@course.LogoPath" alt="@course.TitleAr" loading="lazy" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="rg-card-icon">
                                                <i class="@(string.IsNullOrEmpty(course.IconClass) ? "fas fa-certificate" : course.IconClass)" aria-hidden="true"></i>
                                            </div>
                                        }

                                        <div class="rg-card-meta">
                                            <div class="rg-card-title">@course.TitleAr</div>
                                            <div class="rg-card-tags">
                                                @if (!string.IsNullOrEmpty(course.StandardCode))
                                                {
                                                    <span class="rg-tag-code">
                                                        <i class="fas fa-hashtag" aria-hidden="true"></i>@course.StandardCode
                                                    </span>
                                                }
                                                @if (!string.IsNullOrEmpty(course.BadgeText))
                                                {
                                                    <span class="rg-tag-badge">@course.BadgeText</span>
                                                }
                                            </div>
                                        </div>

                                        <div class="rg-check-circle" aria-hidden="true">
                                            <i class="fas fa-check"></i>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(course.ShortDescription))
                                    {
                                        <p class="rg-card-desc">@course.ShortDescription</p>
                                    }
                                </div>

                                <div class="rg-card-foot">
                                    @if (course.IsAvailable)
                                    {
                                        <span class="rg-avail-tag">
                                            <i class="fas fa-circle" aria-hidden="true"></i>
                                            التسجيل مفتوح
                                        </span>
                                        <span class="rg-hint-tap">
                                            انقر للاختيار <i class="fas fa-hand-pointer" aria-hidden="true"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="rg-unavail-tag">
                                            <i class="fas fa-lock" aria-hidden="true"></i>
                                            @(course.IsMaxReached ? "اكتمل العدد" : "مغلق مؤقتاً")
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="rg-alert-no-sel" id="rgNoSelAlert" role="alert">
                        <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
                        <span>يرجى اختيار دورة واحدة على الأقل ثم أكمل البيانات وأرسل الطلب</span>
                    </div>
                </div>

                <!-- ═ FORM COL ═ -->
                <div class="rg-form-col">
                    <div class="rg-form-panel">

                        <div class="rg-form-head">
                            <div class="rg-form-head-ct">
                                <div class="rg-form-head-icon" aria-hidden="true">
                                    <i class="fas fa-user-pen"></i>
                                </div>
                                <h3>بيانات التواصل</h3>
                                <p>سيتواصل معك فريقنا بعد مراجعة الطلب</p>
                            </div>
                        </div>

                        <div class="rg-sel-strip" id="rgSelStrip">
                            <i class="fas fa-list-check" aria-hidden="true"></i>
                            <span id="rgStripTxt">لم يتم اختيار أي دورة بعد</span>
                        </div>

                        <div class="rg-form-body">

                            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                            {
                                <div class="rg-err-box" role="alert">
                                    <i class="fas fa-circle-exclamation" aria-hidden="true"></i>
                                    <div>@Html.ValidationSummary(false, "", new { @class = "mb-0" })</div>
                                </div>
                            }

                            <form asp-area="Public"
                                  asp-controller="CourseCollections"
                                  asp-action="MultiRegister"
                                  asp-route-collectionSlug="@(ViewContext.RouteData.Values["collectionSlug"])"
                                  method="post"
                                  id="rgForm"
                                  novalidate>
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="CollectionSlug" />
                                <input type="hidden" asp-for="CollectionName" />
                                <div id="rgHiddens"></div>

                                <div class="rg-field">
                                    <label asp-for="FullName" class="rg-label">
                                        <span class="rg-lbl-dot" aria-hidden="true"></span>
                                        الاسم الكامل <span class="rg-req">*</span>
                                    </label>
                                    <input asp-for="FullName"
                                           class="rg-input"
                                           placeholder="أدخل اسمك الكامل"
                                           maxlength="200"
                                           autocomplete="name" />
                                    <span asp-validation-for="FullName" class="field-validation-error"></span>
                                </div>

                                <div class="rg-2col">
                                    <div class="rg-field">
                                        <label asp-for="PhoneNumber" class="rg-label">
                                            <span class="rg-lbl-dot" aria-hidden="true"></span>
                                            الجوال <span class="rg-req">*</span>
                                        </label>
                                        <input asp-for="PhoneNumber"
                                               class="rg-input"
                                               type="tel"
                                               placeholder="05xxxxxxxx"
                                               maxlength="20"
                                               dir="ltr"
                                               autocomplete="tel" />
                                        <span asp-validation-for="PhoneNumber" class="field-validation-error"></span>
                                    </div>
                                    <div class="rg-field">
                                        <label asp-for="NationalId" class="rg-label">
                                            <span class="rg-lbl-dot" aria-hidden="true"></span>
                                            رقم الهوية <span class="rg-req">*</span>
                                        </label>
                                        <input asp-for="NationalId"
                                               class="rg-input"
                                               placeholder="10xxxxxxxx"
                                               maxlength="20"
                                               autocomplete="off"
                                               dir="ltr" />
                                        <span asp-validation-for="NationalId" class="field-validation-error"></span>
                                    </div>
                                </div>

                                <div class="rg-field">
                                    <label asp-for="Email" class="rg-label">
                                        <span class="rg-lbl-dot" aria-hidden="true"></span>
                                        البريد الإلكتروني
                                    </label>
                                    <input asp-for="Email"
                                           class="rg-input"
                                           type="email"
                                           placeholder="example@email.com"
                                           maxlength="200"
                                           dir="ltr"
                                           autocomplete="email" />
                                    <span asp-validation-for="Email" class="field-validation-error"></span>
                                </div>

                                <div class="rg-field">
                                    <label asp-for="City" class="rg-label">
                                        <span class="rg-lbl-dot" aria-hidden="true"></span>
                                        المدينة
                                    </label>
                                    <input asp-for="City"
                                           class="rg-input"
                                           placeholder="الرياض، جدة، الدمام..."
                                           maxlength="150" />
                                </div>

                                <div class="rg-field">
                                    <label asp-for="Notes" class="rg-label">
                                        <span class="rg-lbl-dot" aria-hidden="true"></span>
                                        ملاحظات
                                    </label>
                                    <textarea asp-for="Notes"
                                              class="rg-input"
                                              rows="3"
                                              placeholder="أي استفسارات أو ملاحظات إضافية..."
                                              maxlength="1000"></textarea>
                                </div>

                                <button type="submit" class="rg-submit" id="rgSubmitBtn">
                                    <i class="fas fa-paper-plane" aria-hidden="true"></i>
                                    إرسال طلب التسجيل
                                    <span class="rg-arrow-chip" aria-hidden="true">
                                        <i class="fas fa-arrow-left"></i>
                                    </span>
                                </button>

                                <div class="rg-trust">
                                    <i class="fas fa-shield-halved" aria-hidden="true"></i>
                                    <span>بياناتك محمية تمامًا ولن تُشارك مع أي طرف ثالث — نستخدمها فقط للتواصل معك بخصوص طلبك</span>
                                </div>

                            </form>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
    (function () {
        'use strict';
        var sel = new Set();

        window.rgToggle = function (id) {
            var card = document.getElementById('rgCard-' + id);
            var chk  = document.getElementById('rgChk-' + id);
            if (!card || card.classList.contains('rg-unavail')) return;

            if (sel.has(id)) {
                sel.delete(id);
                card.classList.remove('rg-sel');
                card.setAttribute('aria-checked', 'false');
                if (chk) chk.checked = false;
            } else {
                sel.add(id);
                card.classList.add('rg-sel');
                card.setAttribute('aria-checked', 'true');
                if (chk) chk.checked = true;
            }
            syncUI();
        };

        document.querySelectorAll('.rg-course-card[tabindex]').forEach(function (card) {
            card.addEventListener('keydown', function (e) {
                if (e.key === ' ' || e.key === 'Enter') {
                    e.preventDefault();
                    var id = parseInt(card.id.replace('rgCard-', ''), 10);
                    window.rgToggle(id);
                }
            });
        });

        function syncUI() {
            var n       = sel.size;
            var pill    = document.getElementById('rgCountPill');
            var pillTxt = document.getElementById('rgCountTxt');
            var strip   = document.getElementById('rgStripTxt');
            var alert   = document.getElementById('rgNoSelAlert');

            if (n > 0 && alert.style.display === 'flex') {
                alert.style.display = 'none';
            }

            if (n === 0) {
                pill.classList.remove('has-sel');
                pillTxt.textContent = 'لم تختر أي دورة';
                strip.textContent   = 'لم يتم اختيار أي دورة بعد';
            } else {
                pill.classList.add('has-sel');
                var lbl = n === 1 ? 'دورة واحدة' : n + ' دورات';
                pillTxt.textContent = 'تم اختيار ' + lbl;
                strip.innerHTML = 'الدورات المختارة: <span class="rg-sel-badge">' + n + '</span>';
            }
        }

        document.getElementById('rgForm').addEventListener('submit', function (e) {
            if (sel.size === 0) {
                e.preventDefault();
                var alert = document.getElementById('rgNoSelAlert');
                alert.style.display = 'flex';
                document.getElementById('rgGrid').scrollIntoView({ behavior: 'smooth', block: 'start' });
                return;
            }

            var ct = document.getElementById('rgHiddens');
            ct.innerHTML = '';
            sel.forEach(function (id) {
                var inp  = document.createElement('input');
                inp.type = 'hidden';
                inp.name = 'SelectedCourseIds';
                inp.value = id;
                ct.appendChild(inp);
            });

            var btn = document.getElementById('rgSubmitBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin" aria-hidden="true"></i> جارٍ الإرسال...';
        });
    })();
    </script>
}
