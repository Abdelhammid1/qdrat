@model QdratNew.ViewModels.Frontend.CourseCollections.CourseCollectionRegisterViewModel
@{
    ViewData["Title"] = "التسجيل في " + Model.CourseTitleAr;
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}

<style>
    /* ── Tokens ── */
    :root {
        --rp-navy:      #0c2340;
        --rp-navy-mid:  #1a3a5c;
        --rp-teal:      #0f766e;
        --rp-teal-lt:   #14b8a6;
        --rp-amber:     #f59e0b;
        --rp-danger:    #dc2626;
        --rp-bg:        #f0f5f9;
        --rp-card:      #ffffff;
        --rp-border:    rgba(12,35,64,0.1);
        --rp-muted:     #64748b;
        --rp-radius:    18px;
        --rp-shadow:    0 4px 24px rgba(12,35,64,0.08);
        --rp-shadow-lg: 0 20px 60px rgba(12,35,64,0.14);
    }

    /* ── Page ── */
    .rp-page {
        background: var(--rp-bg);
        min-height: 100vh;
        padding: 56px 0 80px;
        direction: rtl;
        position: relative;
    }

    .rp-page::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle, rgba(12,35,64,0.045) 1px, transparent 1px);
        background-size: 26px 26px;
        pointer-events: none;
    }

    /* ── Layout ── */
    .rp-layout {
        display: grid;
        grid-template-columns: 380px 1fr;
        gap: 28px;
        align-items: start;
        position: relative;
    }

    @@media (max-width: 991px) {
        .rp-layout { grid-template-columns: 1fr; }
        .rp-panel  { order: 2; position: static !important; }
        .rp-form-wrap { order: 1; }
    }

    /* ── Left: Course Panel ── */
    .rp-panel {
        background: linear-gradient(155deg, var(--rp-navy) 0%, var(--rp-navy-mid) 60%, #0f3356 100%);
        border-radius: var(--rp-radius);
        overflow: hidden;
        position: sticky;
        top: 80px;
        box-shadow: var(--rp-shadow-lg);
        border: 1px solid rgba(255,255,255,0.05);
    }

    .rp-panel::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle, rgba(255,255,255,0.04) 1px, transparent 1px);
        background-size: 22px 22px;
        pointer-events: none;
        border-radius: inherit;
    }

    .rp-panel::after {
        content: '';
        position: absolute;
        width: 280px; height: 280px;
        background: radial-gradient(circle, rgba(15,118,110,0.22), transparent 65%);
        top: -60px; right: -60px;
        pointer-events: none;
        border-radius: 50%;
    }

    .rp-panel-logo-zone {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 36px 32px 24px;
        position: relative; z-index: 1;
    }

    .rp-logo-box {
        width: 116px; height: 116px;
        border-radius: 22px;
        background: #fff;
        display: flex; align-items: center; justify-content: center;
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(0,0,0,0.25), 0 2px 8px rgba(0,0,0,0.15);
        border: 2px solid rgba(255,255,255,0.15);
    }
    .rp-logo-box img {
        width: 90px; height: 90px;
        object-fit: contain;
    }

    .rp-logo-icon {
        width: 116px; height: 116px;
        border-radius: 22px;
        background: rgba(255,255,255,0.08);
        border: 2px solid rgba(255,255,255,0.15);
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 8px 32px rgba(0,0,0,0.2);
    }
    .rp-logo-icon i { font-size: 2.8rem; color: rgba(255,255,255,0.85); }

    .rp-panel-body {
        padding: 0 28px 32px;
        position: relative; z-index: 1;
    }

    .rp-panel-label {
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--rp-teal-lt);
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 8px;
        display: flex; align-items: center; gap: 6px;
    }
    .rp-panel-label::before {
        content: '';
        width: 18px; height: 1.5px;
        background: var(--rp-teal-lt);
        border-radius: 2px;
        display: inline-block;
    }

    .rp-panel-title {
        font-size: 1.3rem;
        font-weight: 800;
        color: #fff;
        line-height: 1.4;
        margin-bottom: 14px;
    }

    .rp-code-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(245,158,11,0.15);
        color: #fbbf24;
        border: 1px solid rgba(245,158,11,0.25);
        font-size: 0.75rem;
        font-weight: 700;
        padding: 5px 14px;
        border-radius: 8px;
        font-family: 'Courier New', monospace;
        margin-bottom: 18px;
    }

    .rp-panel-desc {
        font-size: 0.87rem;
        color: rgba(255,255,255,0.72);
        line-height: 1.7;
        margin-bottom: 24px;
    }

    .rp-steps {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 12px;
        padding: 18px 20px;
    }
    .rp-steps-title {
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--rp-teal-lt);
        margin-bottom: 12px;
        display: flex; align-items: center; gap: 6px;
    }
    .rp-step {
        display: flex; align-items: flex-start; gap: 10px;
        margin-bottom: 10px;
        font-size: 0.82rem;
        color: rgba(255,255,255,0.75);
        line-height: 1.5;
    }
    .rp-step:last-child { margin-bottom: 0; }
    .rp-step-num {
        flex-shrink: 0;
        width: 22px; height: 22px;
        border-radius: 50%;
        background: rgba(15,118,110,0.3);
        border: 1px solid rgba(20,184,166,0.3);
        color: var(--rp-teal-lt);
        font-size: 0.7rem;
        font-weight: 800;
        display: flex; align-items: center; justify-content: center;
    }

    /* ── Right: Form Card ── */
    .rp-form-card {
        background: var(--rp-card);
        border-radius: var(--rp-radius);
        border: 1px solid var(--rp-border);
        box-shadow: var(--rp-shadow);
        overflow: hidden;
    }

    .rp-form-header {
        padding: 28px 32px 24px;
        border-bottom: 1px solid rgba(12,35,64,0.07);
        background: linear-gradient(135deg, #f8fbff 0%, #f0f8f6 100%);
    }
    .rp-form-header h3 {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--rp-navy);
        margin: 0 0 4px;
        display: flex; align-items: center; gap: 10px;
    }
    .rp-form-header h3 .rp-header-icon {
        width: 38px; height: 38px;
        border-radius: 10px;
        background: linear-gradient(135deg, var(--rp-teal), #065f46);
        display: flex; align-items: center; justify-content: center;
        color: #fff;
        font-size: 1rem;
        flex-shrink: 0;
    }
    .rp-form-header p {
        font-size: 0.84rem;
        color: var(--rp-muted);
        margin: 0;
        padding-right: 48px;
    }

    .rp-form-body { padding: 28px 32px 32px; }

    .rp-field {
        margin-bottom: 20px;
    }
    .rp-field:last-child { margin-bottom: 0; }

    .rp-label {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.86rem;
        font-weight: 700;
        color: #374151;
        margin-bottom: 7px;
    }
    .rp-label-icon {
        width: 22px; height: 22px;
        border-radius: 6px;
        background: linear-gradient(135deg, rgba(15,118,110,0.1), rgba(20,184,166,0.08));
        display: flex; align-items: center; justify-content: center;
        color: var(--rp-teal);
        font-size: 0.65rem;
        flex-shrink: 0;
    }
    .rp-required { color: var(--rp-danger); margin-right: 1px; font-size: 0.9rem; }

    .rp-input {
        width: 100%;
        background: #fafbfc;
        border: 1.5px solid #e2e8f0;
        border-radius: 11px;
        padding: 11px 14px;
        font-size: 0.9rem;
        color: var(--rp-navy);
        transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
        outline: none;
        font-family: inherit;
    }
    .rp-input::placeholder { color: #b0bec5; }
    .rp-input:focus {
        border-color: var(--rp-teal);
        box-shadow: 0 0 0 3px rgba(15,118,110,0.1);
        background: #fff;
    }
    .rp-input.input-validation-error {
        border-color: var(--rp-danger);
        box-shadow: 0 0 0 3px rgba(220,38,38,0.08);
    }
    textarea.rp-input { resize: vertical; min-height: 90px; }

    .field-validation-error {
        display: block;
        font-size: 0.78rem;
        color: var(--rp-danger);
        margin-top: 5px;
        display: flex; align-items: center; gap: 4px;
    }
    .field-validation-error::before {
        content: '\f06a';
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        font-size: 0.7rem;
    }

    .rp-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }
    @@media (max-width: 575px) {
        .rp-row { grid-template-columns: 1fr; }
        .rp-form-header, .rp-form-body { padding-left: 20px; padding-right: 20px; }
    }

    .rp-form-divider {
        display: flex; align-items: center; gap: 12px;
        margin: 24px 0 20px;
    }
    .rp-form-divider-line {
        flex: 1; height: 1px;
        background: linear-gradient(90deg, transparent, rgba(12,35,64,0.1), transparent);
    }
    .rp-form-divider span {
        font-size: 0.75rem;
        color: var(--rp-muted);
        font-weight: 600;
        white-space: nowrap;
    }

    .rp-submit {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        background: linear-gradient(135deg, var(--rp-teal) 0%, #065f46 100%);
        color: #fff;
        border: none;
        border-radius: 13px;
        padding: 15px 24px;
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s;
        position: relative;
        overflow: hidden;
        margin-top: 8px;
        font-family: inherit;
    }
    .rp-submit::after {
        content: '';
        position: absolute; inset: 0;
        background: rgba(255,255,255,0);
        transition: background 0.2s;
    }
    .rp-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 28px rgba(15,118,110,0.32);
    }
    .rp-submit:hover::after { background: rgba(255,255,255,0.06); }
    .rp-submit:disabled {
        opacity: 0.65;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    .rp-privacy {
        display: flex; align-items: flex-start; gap: 8px;
        margin-top: 14px;
        font-size: 0.78rem;
        color: var(--rp-muted);
        line-height: 1.5;
    }
    .rp-privacy i { color: var(--rp-teal); margin-top: 2px; flex-shrink: 0; }

    .rp-alert {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 12px;
        padding: 14px 18px;
        margin-bottom: 20px;
        font-size: 0.87rem;
        color: #991b1b;
        display: flex; gap: 10px;
    }
    .rp-alert i { flex-shrink: 0; margin-top: 1px; }
</style>

<div class="rp-page">
    <div class="container position-relative">

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb" style="font-size:0.82rem;">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none" style="color:var(--rp-teal);">الرئيسية</a></li>
                <li class="breadcrumb-item"><a href="/#course-collections" class="text-decoration-none" style="color:var(--rp-teal);">@Model.CollectionName</a></li>
                <li class="breadcrumb-item active text-muted" aria-current="page">@Model.CourseTitleAr</li>
            </ol>
        </nav>

        <div class="rp-layout">

            <!-- ── Course Panel ── -->
            <aside class="rp-panel" aria-label="معلومات الدورة">
                <div class="rp-panel-logo-zone">
                    @if (!string.IsNullOrEmpty(Model.LogoPath))
                    {
                        <div class="rp-logo-box">
                            <img src="@Model.LogoPath" alt="@Model.CourseTitleAr" />
                        </div>
                    }
                    else
                    {
                        <div class="rp-logo-icon">
                            <i class="fas fa-certificate" aria-hidden="true"></i>
                        </div>
                    }
                </div>

                <div class="rp-panel-body">
                    <div class="rp-panel-label">@Model.CollectionName</div>
                    <h2 class="rp-panel-title">@Model.CourseTitleAr</h2>
                    @if (!string.IsNullOrEmpty(Model.StandardCode))
                    {
                        <span class="rp-code-pill">
                            <i class="fas fa-hashtag" aria-hidden="true"></i>
                            @Model.StandardCode
                        </span>
                    }

                    @if (!string.IsNullOrEmpty(Model.CourseShortDescription))
                    {
                        <p class="rp-panel-desc">@Model.CourseShortDescription</p>
                    }

                    <div class="rp-steps">
                        <div class="rp-steps-title">
                            <i class="fas fa-list-check" aria-hidden="true"></i>
                            ماذا يحدث بعد الإرسال؟
                        </div>
                        <div class="rp-step">
                            <span class="rp-step-num">١</span>
                            <span>يصلنا طلبك فوراً ويُراجَع من قِبل فريق المختصين</span>
                        </div>
                        <div class="rp-step">
                            <span class="rp-step-num">٢</span>
                            <span>يتواصل معك أحد مستشارينا لتأكيد التفاصيل والرسوم</span>
                        </div>
                        <div class="rp-step">
                            <span class="rp-step-num">٣</span>
                            <span>تُكمل إجراءات التسجيل وتبدأ رحلتك في هذه المجموعة</span>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- ── Registration Form ── -->
            <main class="rp-form-wrap">
                <div class="rp-form-card">

                    <div class="rp-form-header">
                        <h3>
                            <span class="rp-header-icon" aria-hidden="true">
                                <i class="fas fa-file-pen"></i>
                            </span>
                            أدخل بياناتك للتسجيل
                        </h3>
                        <p>يُرجى ملء جميع الحقول المطلوبة بدقة لضمان التواصل السليم</p>
                    </div>

                    <div class="rp-form-body">

                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                        {
                            <div class="rp-alert" role="alert">
                                <i class="fas fa-circle-exclamation"></i>
                                <div>@Html.ValidationSummary(false, "", new { @class = "mb-0" })</div>
                            </div>
                        }

                        <form asp-area="Public" asp-controller="CourseCollections" asp-action="Register"
                              asp-route-collectionSlug="@(ViewContext.RouteData.Values["collectionSlug"])"
                              asp-route-courseSlug="@(ViewContext.RouteData.Values["courseSlug"])"
                              method="post" id="regForm" novalidate>
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="CollectionSlug" />
                            <input type="hidden" asp-for="CollectionName" />
                            <input type="hidden" asp-for="CourseId" />
                            <input type="hidden" asp-for="CourseTitleAr" />
                            <input type="hidden" asp-for="StandardCode" />

                            <!-- Row 1: Name + Phone -->
                            <div class="rp-row">
                                <div class="rp-field">
                                    <label asp-for="FullName" class="rp-label">
                                        <span class="rp-label-icon"><i class="fas fa-user" aria-hidden="true"></i></span>
                                        الاسم الكامل <span class="rp-required">*</span>
                                    </label>
                                    <input asp-for="FullName" class="rp-input" placeholder="أدخل اسمك الكامل"
                                           maxlength="200" autocomplete="name" />
                                    <span asp-validation-for="FullName" class="field-validation-error"></span>
                                </div>

                                <div class="rp-field">
                                    <label asp-for="PhoneNumber" class="rp-label">
                                        <span class="rp-label-icon"><i class="fas fa-mobile-screen" aria-hidden="true"></i></span>
                                        رقم الجوال <span class="rp-required">*</span>
                                    </label>
                                    <input asp-for="PhoneNumber" class="rp-input" type="tel"
                                           placeholder="05xxxxxxxx" maxlength="20" autocomplete="tel" dir="ltr" />
                                    <span asp-validation-for="PhoneNumber" class="field-validation-error"></span>
                                </div>
                            </div>

                            <!-- Row 2: NationalId + Email -->
                            <div class="rp-row">
                                <div class="rp-field">
                                    <label asp-for="NationalId" class="rp-label">
                                        <span class="rp-label-icon"><i class="fas fa-id-card" aria-hidden="true"></i></span>
                                        رقم الهوية الوطنية <span class="rp-required">*</span>
                                    </label>
                                    <input asp-for="NationalId" class="rp-input" placeholder="10xxxxxxxx"
                                           maxlength="20" autocomplete="off" dir="ltr" />
                                    <span asp-validation-for="NationalId" class="field-validation-error"></span>
                                </div>

                                <div class="rp-field">
                                    <label asp-for="Email" class="rp-label">
                                        <span class="rp-label-icon"><i class="fas fa-envelope" aria-hidden="true"></i></span>
                                        البريد الإلكتروني
                                    </label>
                                    <input asp-for="Email" class="rp-input" type="email"
                                           placeholder="example@email.com" maxlength="200" autocomplete="email" dir="ltr" />
                                    <span asp-validation-for="Email" class="field-validation-error"></span>
                                </div>
                            </div>

                            <!-- City -->
                            <div class="rp-field">
                                <label asp-for="City" class="rp-label">
                                    <span class="rp-label-icon"><i class="fas fa-location-dot" aria-hidden="true"></i></span>
                                    المدينة
                                </label>
                                <input asp-for="City" class="rp-input" placeholder="الرياض، جدة، الدمام..." maxlength="150" />
                                <span asp-validation-for="City" class="field-validation-error"></span>
                            </div>

                            <!-- Divider -->
                            <div class="rp-form-divider">
                                <span class="rp-form-divider-line"></span>
                                <span>معلومات إضافية (اختياري)</span>
                                <span class="rp-form-divider-line"></span>
                            </div>

                            <!-- Notes -->
                            <div class="rp-field">
                                <label asp-for="Notes" class="rp-label">
                                    <span class="rp-label-icon"><i class="fas fa-pen-to-square" aria-hidden="true"></i></span>
                                    ملاحظات
                                </label>
                                <textarea asp-for="Notes" class="rp-input" rows="3"
                                          placeholder="أي استفسارات أو معلومات تود مشاركتها مع الفريق..." maxlength="1000"></textarea>
                                <span asp-validation-for="Notes" class="field-validation-error"></span>
                            </div>

                            <!-- Submit -->
                            <button type="submit" class="rp-submit" id="submitBtn">
                                <i class="fas fa-paper-plane" aria-hidden="true"></i>
                                إرسال طلب التسجيل
                            </button>

                            <!-- Privacy note -->
                            <div class="rp-privacy">
                                <i class="fas fa-shield-halved"></i>
                                بياناتك محمية ولن تُشارك مع أي طرف ثالث. سيتواصل معك فريقنا حصرياً لإتمام تسجيلك.
                            </div>

                        </form>
                    </div>
                </div>
            </main>

        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('regForm').addEventListener('submit', function () {
            var btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جارٍ الإرسال...';
        });
    </script>
}
