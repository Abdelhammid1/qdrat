@model QdratNew.ViewModels.CorporateRegistrationViewModel
@{
    ViewData["Title"] = "تسجيل موظفي بتروجت - ديناميكية الفن وارتباطها بالرسم الهندسي";

    // محتويات الدورة (الأيقونة، العنوان) بترتيب العرض
    var topics = new (string Icon, string Title)[]
    {
        ("fa-sun",               "الضوء والظل كتجسيم وأبعاد"),
        ("fa-bezier-curve",      "الخطوط بين الحركة والسكون وتقنياتها"),
        ("fa-border-all",        "الملامس والمحاور الخطية وتأثيرها"),
        ("fa-leaf",              "الطبيعة الحية ومزجها بالهندسة"),
        ("fa-shapes",            "الأشكال الهندسية وتظليلها"),
        ("fa-palette",           "الجانب الإبداعي للتكوين الهندسي"),
        ("fa-lightbulb",         "الإيديولوجية الإبداعية للأشكال الهندسية"),
        ("fa-compass-drafting",  "التصميم وتأثيره في اتخاذ القرار"),
        ("fa-circle-half-stroke","المساقط الضوئية للضوء والظل"),
        ("fa-vector-square",     "المساقط الهندسية في الرسم الهندسي"),
        ("fa-cube",              "الأيزومتري تخيلياً ويدوياً")
    };
}

<!-- 🟢 خط كايرو -->
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
    :root {
        --qdrat-main: #339999;
        --qdrat-dark: #205f5f;
        --qdrat-light: #eef7f7;
        --petro-red: #d9251d;
        --petro-navy: #0b3d59;
        --gold: #c99a3e;
        --text-main: #1f2a2e;
        --text-muted: #5a6b6e;
        --card-radius: 20px;
    }

    html[dir="rtl"] body {
        direction: rtl;
        text-align: right;
    }

    body {
        background: linear-gradient(180deg, #f4faf9 0%, #eef7f7 100%);
        font-family: 'Cairo', sans-serif;
        color: var(--text-main);
        overflow-x: hidden;
        margin: 0;
        padding: 0;
    }

    /* 🟢 رأس الصفحة */
    .hero {
        position: relative;
        text-align: center;
        padding: 55px 20px 60px;
        background: linear-gradient(135deg, var(--petro-navy) 0%, var(--qdrat-dark) 100%);
        overflow: hidden;
    }

        .hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 20% 20%, rgba(255,255,255,0.08), transparent 40%),
                        radial-gradient(circle at 80% 80%, rgba(255,255,255,0.06), transparent 45%);
            pointer-events: none;
        }

    .hero-logos {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 22px;
        flex-wrap: wrap;
        margin-bottom: 22px;
        z-index: 1;
    }

    .logo-badge {
        background: #fff;
        border-radius: 16px;
        padding: 10px 18px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.18);
    }

        .logo-badge img {
            max-height: 55px;
            display: block;
            transition: transform 0.3s ease;
        }

        .logo-badge:hover img {
            transform: scale(1.06);
        }

    .hero-divider {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 6px 16px rgba(201,154,62,0.5);
        z-index: 1;
        position: relative;
    }

        .hero-divider i {
            color: #fff;
            font-size: 1.1rem;
        }

    .hero-eyebrow {
        position: relative;
        z-index: 1;
        display: inline-block;
        background: rgba(255,255,255,0.12);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.35);
        padding: 6px 18px;
        border-radius: 30px;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        margin-bottom: 16px;
    }

    .hero h1 {
        position: relative;
        z-index: 1;
        font-weight: 800;
        color: #fff;
        margin-bottom: 8px;
        font-size: 1.75rem;
        max-width: 780px;
        margin-inline: auto;
        line-height: 1.6;
    }

    .hero .hero-sub {
        position: relative;
        z-index: 1;
        color: rgba(255,255,255,0.85);
        font-size: 1rem;
        max-width: 680px;
        margin: 10px auto 0;
    }

    /* 📜 خطاب الإعلان */
    .announcement-card {
        background: #fff;
        border-radius: var(--card-radius);
        box-shadow: 0 10px 30px rgba(11,61,89,0.08);
        max-width: 860px;
        margin: -35px auto 0;
        padding: 42px 45px;
        position: relative;
        z-index: 2;
        border-top: 5px solid var(--gold);
    }

    .announcement-card .badge-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--qdrat-dark);
        font-weight: 800;
        font-size: 1.15rem;
        margin-bottom: 18px;
    }

        .announcement-card .badge-title i {
            color: var(--petro-red);
        }

    .announcement-card p {
        color: var(--text-main);
        font-size: 1.02rem;
        line-height: 2.1;
        margin-bottom: 16px;
    }

    .announcement-card .greeting {
        font-weight: 700;
        color: var(--petro-navy);
    }

    .program-title-box {
        background: var(--qdrat-light);
        border-right: 5px solid var(--qdrat-main);
        border-radius: 12px;
        padding: 18px 22px;
        margin: 22px 0;
        text-align: center;
    }

        .program-title-box .label {
            display: block;
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 6px;
            font-weight: 600;
        }

        .program-title-box .title {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--qdrat-dark);
        }

    .info-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin: 22px 0;
    }

    .chip {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #fff;
        border: 1.5px solid var(--qdrat-main);
        color: var(--qdrat-dark);
        border-radius: 30px;
        padding: 8px 16px;
        font-weight: 700;
        font-size: 0.92rem;
    }

        .chip i {
            color: var(--gold);
        }

    .signature {
        text-align: left;
        margin-top: 26px;
        padding-top: 18px;
        border-top: 1px dashed #d8e3e3;
        color: var(--petro-navy);
        font-weight: 700;
    }

    html[dir="rtl"] .signature {
        text-align: right;
    }

    /* 🧾 البطاقة */
    .registration-card {
        background: #fff;
        border-radius: var(--card-radius);
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
        max-width: 780px;
        margin: 55px auto;
        padding: 50px;
        transition: 0.3s;
        border-top: 5px solid var(--petro-red);
    }

        .registration-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 28px rgba(0,0,0,0.1);
        }

        .registration-card h4 {
            color: var(--qdrat-dark);
            font-weight: 800;
            text-align: center;
            margin-bottom: 6px;
        }

        .registration-card .form-sub {
            text-align: center;
            color: var(--text-muted);
            margin-bottom: 28px;
            font-size: 0.95rem;
        }

    .form-label {
        font-weight: 600;
        color: var(--text-main);
    }

    .form-control {
        border: 1px solid #ccc;
        border-radius: 10px;
        padding: 10px 12px;
        background: #f9fafa;
        color: var(--text-main);
        transition: 0.3s;
        font-family: 'Cairo', sans-serif;
    }

        .form-control:focus {
            border-color: var(--qdrat-main);
            box-shadow: 0 0 0 3px rgba(51,153,153,0.25);
            background: #fff;
        }

    .btn-qdrat {
        background: linear-gradient(90deg, var(--qdrat-main), var(--qdrat-dark));
        border: none;
        color: #fff;
        font-weight: 700;
        padding: 12px;
        font-size: 1.05rem;
        border-radius: 10px;
        width: 100%;
        transition: all 0.3s ease;
    }

        .btn-qdrat:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(43,127,127,0.4);
        }

    /* ⚙️ شركاؤنا */
    .partners-strip {
        background: #fff;
        margin-top: 90px;
        padding: 30px 0;
        border-top: 3px solid var(--qdrat-main);
    }

        .partners-strip h6 {
            color: var(--qdrat-dark);
            font-weight: 700;
            margin-bottom: 15px;
        }

        .partners-strip img {
            height: 45px;
            margin: 0 18px;
            opacity: 0.85;
            transition: 0.3s;
        }

            .partners-strip img:hover {
                opacity: 1;
                transform: scale(1.08);
            }

    @@media (max-width: 768px) {
        .announcement-card, .registration-card {
            padding: 28px 22px;
            margin: 30px 12px;
        }

        .hero h1 {
            font-size: 1.35rem;
        }

        .signature {
            text-align: center;
        }
    }

    /* Dark mode */
    @@media (prefers-color-scheme: dark) {
        body {
            background: #10191a;
            color: #e7f0ef;
        }

        .announcement-card, .registration-card {
            background: #172323;
            color: #e7f0ef;
        }

        .announcement-card p, .form-label {
            color: #d7e4e3;
        }

        .program-title-box {
            background: #102626;
        }

        .form-control {
            background: #0f1b1c;
            color: #e7f0ef;
            border-color: #2c4142;
        }

        .partners-strip {
            background: #172323;
        }
    }

    html { scroll-behavior: smooth; }

    /* 🎨 شبكة أيزومترية خفيفة في الهيرو */
    .hero {
        background-image:
            repeating-linear-gradient(30deg, rgba(255,255,255,0.045) 0 1px, transparent 1px 42px),
            repeating-linear-gradient(150deg, rgba(255,255,255,0.045) 0 1px, transparent 1px 42px),
            linear-gradient(135deg, var(--petro-navy) 0%, var(--qdrat-dark) 100%);
    }

    .iso-deco {
        position: absolute;
        pointer-events: none;
        opacity: 0.9;
        z-index: 0;
    }
    .iso-deco.one { width: 170px; top: 28px; inset-inline-start: 5%; }
    .iso-deco.two { width: 96px; bottom: 26px; inset-inline-end: 7%; }

    .hero-course {
        position: relative;
        z-index: 1;
        display: block;
        color: #ffd27a;
        font-size: 2.1rem;
        font-weight: 900;
        line-height: 1.5;
        margin-top: 6px;
    }

    .hero-cta {
        position: relative;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-top: 26px;
        background: var(--gold);
        color: #1b2a30;
        font-weight: 800;
        padding: 12px 30px;
        border-radius: 40px;
        text-decoration: none;
        box-shadow: 0 8px 20px rgba(201,154,62,0.45);
        transition: transform .25s ease, box-shadow .25s ease;
    }
    .hero-cta:hover { transform: translateY(-2px); color: #1b2a30; box-shadow: 0 12px 26px rgba(201,154,62,0.55); }

    /* 🎯 هدف الدورة */
    .goal-box {
        display: flex;
        gap: 16px;
        align-items: flex-start;
        background: linear-gradient(135deg, #fff8ea 0%, #fff 100%);
        border: 1px solid #f0e1bd;
        border-right: 5px solid var(--gold);
        border-radius: 14px;
        padding: 18px 22px;
        margin: 22px 0;
    }
    .goal-box .goal-icon {
        flex: 0 0 46px;
        height: 46px;
        border-radius: 50%;
        background: var(--gold);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }
    .goal-box .goal-label { display: block; font-size: .85rem; color: var(--text-muted); font-weight: 600; margin-bottom: 4px; }
    .goal-box .goal-text { font-size: 1.12rem; font-weight: 800; color: var(--petro-navy); line-height: 1.8; }

    /* 📚 محتويات الدورة */
    .topics-section { max-width: 1040px; margin: 55px auto 0; padding: 0 12px; }
    .section-head { text-align: center; margin-bottom: 30px; }
    .section-head h2 { color: var(--qdrat-dark); font-weight: 800; font-size: 1.5rem; margin-bottom: 6px; }
    .section-head p { color: var(--text-muted); margin: 0; }
    .section-head .bar { width: 64px; height: 4px; background: var(--gold); border-radius: 4px; margin: 12px auto 0; }

    .topics-grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
        gap: 22px;
    }

    .topic-card {
        position: relative;
        display: flex;
        align-items: center;
        gap: 14px;
        background: #fff;
        border: 1.5px solid #dcebea;
        border-radius: 16px;
        padding: 18px 18px;
        overflow: hidden;
        /* ظل مُلقى بزاوية ثابتة كأنه ظل جسم هندسي */
        box-shadow: 6px 6px 0 rgba(32,95,95,0.14);
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }
    .topic-card:hover {
        transform: translate(-2px, -2px);
        border-color: var(--qdrat-main);
        box-shadow: 9px 9px 0 rgba(32,95,95,0.2);
    }
    html[dir="rtl"] .topic-card { box-shadow: -6px 6px 0 rgba(32,95,95,0.14); }
    html[dir="rtl"] .topic-card:hover { box-shadow: -9px 9px 0 rgba(32,95,95,0.2); }

    .topic-num {
        position: absolute;
        top: 4px;
        inset-inline-end: 12px;
        font-size: 2.6rem;
        font-weight: 900;
        line-height: 1;
        color: rgba(51,153,153,0.10);
        user-select: none;
    }
    .topic-icon {
        flex: 0 0 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 1.15rem;
        background: linear-gradient(135deg, var(--qdrat-main), var(--qdrat-dark));
        /* وجه مضيء ووجه معتم كالمجسم */
        box-shadow: inset -6px -6px 0 rgba(0,0,0,0.12), inset 4px 4px 0 rgba(255,255,255,0.14);
    }
    .topic-card:nth-child(3n+2) .topic-icon { background: linear-gradient(135deg, var(--petro-navy), #1b5f86); }
    .topic-card:nth-child(3n) .topic-icon { background: linear-gradient(135deg, #b8862c, var(--gold)); }
    .topic-title { font-weight: 700; color: var(--text-main); line-height: 1.8; font-size: 1rem; position: relative; }

    .topics-note {
        text-align: center;
        color: var(--text-muted);
        margin-top: 26px;
        font-size: .95rem;
    }

    @@media (max-width: 768px) {
        .hero-course { font-size: 1.55rem; }
        .iso-deco.one { width: 100px; top: 14px; }
        .iso-deco.two { display: none; }
        .topics-grid { grid-template-columns: 1fr; gap: 16px; }
        .goal-box { flex-direction: column; }
    }

    @@media (prefers-color-scheme: dark) {
        .goal-box { background: #1d2a26; border-color: #3a3524; }
        .goal-box .goal-text { color: #ffd27a; }
        .topic-card { background: #172323; border-color: #2c4142; }
        .topic-title { color: #e7f0ef; }
        .section-head h2 { color: #8fd6d6; }
        .chip { background: #172323; color: #cfe7e6; }
    }
</style>

<!-- 🟩 رأس الصفحة -->
<section class="hero" dir="rtl">
    <svg class="iso-deco one" viewBox="0 0 120 138" aria-hidden="true" focusable="false">
        <polygon points="60,4 116,36 60,68 4,36" fill="rgba(255,255,255,0.34)" />
        <polygon points="4,36 60,68 60,134 4,102" fill="rgba(255,255,255,0.12)" />
        <polygon points="116,36 60,68 60,134 116,102" fill="rgba(0,0,0,0.30)" />
        <polyline points="4,36 60,68 116,36" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.2" />
        <line x1="60" y1="68" x2="60" y2="134" stroke="rgba(255,255,255,0.5)" stroke-width="1.2" />
    </svg>
    <svg class="iso-deco two" viewBox="0 0 120 138" aria-hidden="true" focusable="false">
        <polygon points="60,4 116,36 60,68 4,36" fill="rgba(255,255,255,0.34)" />
        <polygon points="4,36 60,68 60,134 4,102" fill="rgba(255,255,255,0.12)" />
        <polygon points="116,36 60,68 60,134 116,102" fill="rgba(0,0,0,0.30)" />
        <polyline points="4,36 60,68 116,36" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.2" />
        <line x1="60" y1="68" x2="60" y2="134" stroke="rgba(255,255,255,0.5)" stroke-width="1.2" />
    </svg>
    <span class="hero-eyebrow">إعلان تدريبي رسمي</span>
    <div class="hero-logos">
        <div class="logo-badge">
            <img src="~/images/160×100.png" alt="شعار معهد القدرات" fetchpriority="high" />
        </div>
        <div class="hero-divider">
            <i class="fas fa-handshake"></i>
        </div>
        <div class="logo-badge">
            <img src="~/images/sponsors/petrojet.png" alt="شعار شركة بتروجت" />
        </div>
    </div>
    <h1>
        دورة تدريبية بين <strong style="color:#fff;">معهد القدرات للتدريب</strong> وشركة <strong style="color:#ffd27a;">بتروجت للمشروعات البترولية</strong>
        <span class="hero-course">ديناميكية الفن وارتباطها بالرسم الهندسي</span>
    </h1>
    <p class="hero-sub">مزج الفن والرسم بالهندسة وتنمية قوة الإبداع اليدوي.</p>
    <a href="#register" class="hero-cta"><i class="fas fa-pen-to-square"></i> سجّل بياناتك الآن</a>
</section>

<!-- 📜 خطاب الإعلان -->
<section class="container" dir="rtl">
    <div class="announcement-card">
        <div class="badge-title">
            <i class="fas fa-bullhorn"></i>
            <span>إعلان هام لموظفي شركة بتروجت</span>
        </div>

        <p class="greeting">السادة/ موظفي شركة بتروجت للمشروعات البترولية المحترمين،</p>

        <p>
            يسر الشركة أن تعلن عن التوصل إلى اتفاق مع <strong style="color:var(--qdrat-dark);">معهد القدرات للتدريب</strong>
            لتنفيذ دورة تدريبية بعنوان:
        </p>

        <div class="program-title-box">
            <span class="label">اسم الدورة</span>
            <span class="title">"ديناميكية الفن وارتباطها بالرسم الهندسي"</span>
        </div>

        <div class="goal-box">
            <div class="goal-icon"><i class="fas fa-bullseye"></i></div>
            <div>
                <span class="goal-label">هدف الدورة</span>
                <span class="goal-text">مزج الفن والرسم بالهندسة وتنمية قوة الإبداع اليدوي</span>
            </div>
        </div>

        <div class="info-chips">
            <div class="chip"><i class="fas fa-clock"></i> مدة الدورة: 4 شهور</div>
            <div class="chip"><i class="fas fa-list-check"></i> @topics.Length محورًا تدريبيًا</div>
            <div class="chip"><i class="fas fa-building"></i> بالتعاون مع معهد القدرات</div>
        </div>

        <p>
            وسيتم تزويد الموظفين خلال الفترة القادمة بكافة التفاصيل المتعلقة بـ <strong>مواعيد بدء الدورة</strong>،
            و<strong>آلية التسجيل</strong>، و<strong>جدول التدريب</strong>، والمتطلبات اللازمة للمشاركة.
        </p>

        <p>
            نتطلع إلى مشاركة الجميع والاستفادة من هذه الفرصة التطويرية، متمنين لكم دوام التوفيق والنجاح.
        </p>

        <div class="signature">
            إدارة شركة بتروجت للمشروعات البترولية
        </div>
    </div>
</section>

<!-- 📚 محتويات الدورة -->
<section class="topics-section" dir="rtl" aria-labelledby="topics-heading">
    <div class="section-head">
        <h2 id="topics-heading">محتويات الدورة</h2>
        <p>@topics.Length محورًا تجمع بين الفن والرسم الهندسي</p>
        <div class="bar"></div>
    </div>

    <ol class="topics-grid">
        @for (var i = 0; i < topics.Length; i++)
        {
            <li class="topic-card">
                <span class="topic-num" aria-hidden="true">@((i + 1).ToString("00"))</span>
                <span class="topic-icon"><i class="fas @topics[i].Icon" aria-hidden="true"></i></span>
                <span class="topic-title">@topics[i].Title</span>
            </li>
        }
    </ol>
</section>

<!-- 🧾 نموذج التسجيل -->
<section class="container" dir="rtl" id="register">
    <div class="registration-card">

        <h4>📋 نموذج تسجيل موظفي شركة <strong style="color:var(--petro-red);">بتروجت</strong></h4>
        <p class="form-sub">سجّل بياناتك الآن ليتم التواصل معك بتفاصيل البرنامج التدريبي فور بدء التسجيل</p>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success text-center">@TempData["Success"]</div>
        }

        <form asp-action="Register" method="post">
            <input type="hidden" asp-for="CompanyName" value="بتروجيت" />

            <div class="row g-3">
                <div class="col-md-12">
                    <label asp-for="FullName" class="form-label">الاسم الكامل</label>
                    <input asp-for="FullName" class="form-control" placeholder="اكتب الاسم الثلاثي هنا..." />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="Email" class="form-label">البريد الإلكتروني</label>
                    <input asp-for="Email" class="form-control" placeholder="example@domain.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="EmployeeNumber" class="form-label">الرقم الوظيفي</label>
                    <input asp-for="EmployeeNumber" class="form-control" placeholder="أدخل رقمك الوظيفي بالشركة" />
                    <span asp-validation-for="EmployeeNumber" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="NationalID" class="form-label">رقم الهوية الوطنية</label>
                    <input asp-for="NationalID" class="form-control" placeholder="أدخل رقم الهوية المكون من 10 أرقام" />
                    <span asp-validation-for="NationalID" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label">رقم الجوال</label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="05XXXXXXXX" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Residence" class="form-label">محل الإقامة</label>
                    <input asp-for="Residence" class="form-control" placeholder="المدينة أو الحي" />
                </div>
            </div>

            <button type="submit" class="btn btn-qdrat mt-4">
                📩 إرسال الطلب
            </button>
        </form>
    </div>
</section>

<!-- 🧩 شركاؤنا -->
<div class="partners-strip text-center" dir="rtl">
    <h6>شركاؤنا في النجاح</h6>
    <div class="d-flex justify-content-center align-items-center flex-wrap">
        <img src="~/images/sponsors/petrojet.png" alt="Petrojet" loading="lazy" />
    </div>
</div>
