@model QdratNew.ViewModels.CorporateRegistrationViewModel
@{
    ViewData["Title"] = "تسجيل موظفي بتروجت - برنامج تطبيقات وأدوات الذكاء الاصطناعي";
}

<!-- 🟢 خط كايرو -->
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
    :root {
        --qdrat-main: #339999;
        --qdrat-dark: #205f5f;
        --qdrat-light: #eef7f7;
        --petro-red: #d9251d;
        --petro-navy: #0b3d59;
        --gold: #c99a3e;
        --text-main: #1f2a2e;
        --text-muted: #5a6b6e;
        --card-radius: 20px;
    }

    html[dir="rtl"] body {
        direction: rtl;
        text-align: right;
    }

    body {
        background: linear-gradient(180deg, #f4faf9 0%, #eef7f7 100%);
        font-family: 'Cairo', sans-serif;
        color: var(--text-main);
        overflow-x: hidden;
        margin: 0;
        padding: 0;
    }

    /* 🟢 رأس الصفحة */
    .hero {
        position: relative;
        text-align: center;
        padding: 55px 20px 60px;
        background: linear-gradient(135deg, var(--petro-navy) 0%, var(--qdrat-dark) 100%);
        overflow: hidden;
    }

        .hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 20% 20%, rgba(255,255,255,0.08), transparent 40%),
                        radial-gradient(circle at 80% 80%, rgba(255,255,255,0.06), transparent 45%);
            pointer-events: none;
        }

    .hero-logos {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 22px;
        flex-wrap: wrap;
        margin-bottom: 22px;
        z-index: 1;
    }

    .logo-badge {
        background: #fff;
        border-radius: 16px;
        padding: 10px 18px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.18);
    }

        .logo-badge img {
            max-height: 55px;
            display: block;
            transition: transform 0.3s ease;
        }

        .logo-badge:hover img {
            transform: scale(1.06);
        }

    .hero-divider {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 6px 16px rgba(201,154,62,0.5);
        z-index: 1;
        position: relative;
    }

        .hero-divider i {
            color: #fff;
            font-size: 1.1rem;
        }

    .hero-eyebrow {
        position: relative;
        z-index: 1;
        display: inline-block;
        background: rgba(255,255,255,0.12);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.35);
        padding: 6px 18px;
        border-radius: 30px;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        margin-bottom: 16px;
    }

    .hero h1 {
        position: relative;
        z-index: 1;
        font-weight: 800;
        color: #fff;
        margin-bottom: 8px;
        font-size: 1.75rem;
        max-width: 780px;
        margin-inline: auto;
        line-height: 1.6;
    }

    .hero .hero-sub {
        position: relative;
        z-index: 1;
        color: rgba(255,255,255,0.85);
        font-size: 1rem;
        max-width: 680px;
        margin: 10px auto 0;
    }

    /* 📜 خطاب الإعلان */
    .announcement-card {
        background: #fff;
        border-radius: var(--card-radius);
        box-shadow: 0 10px 30px rgba(11,61,89,0.08);
        max-width: 860px;
        margin: -35px auto 0;
        padding: 42px 45px;
        position: relative;
        z-index: 2;
        border-top: 5px solid var(--gold);
    }

    .announcement-card .badge-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--qdrat-dark);
        font-weight: 800;
        font-size: 1.15rem;
        margin-bottom: 18px;
    }

        .announcement-card .badge-title i {
            color: var(--petro-red);
        }

    .announcement-card p {
        color: var(--text-main);
        font-size: 1.02rem;
        line-height: 2.1;
        margin-bottom: 16px;
    }

    .announcement-card .greeting {
        font-weight: 700;
        color: var(--petro-navy);
    }

    .program-title-box {
        background: var(--qdrat-light);
        border-right: 5px solid var(--qdrat-main);
        border-radius: 12px;
        padding: 18px 22px;
        margin: 22px 0;
        text-align: center;
    }

        .program-title-box .label {
            display: block;
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 6px;
            font-weight: 600;
        }

        .program-title-box .title {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--qdrat-dark);
        }

    .info-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin: 22px 0;
    }

    .chip {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #fff;
        border: 1.5px solid var(--qdrat-main);
        color: var(--qdrat-dark);
        border-radius: 30px;
        padding: 8px 16px;
        font-weight: 700;
        font-size: 0.92rem;
    }

        .chip i {
            color: var(--gold);
        }

    .signature {
        text-align: left;
        margin-top: 26px;
        padding-top: 18px;
        border-top: 1px dashed #d8e3e3;
        color: var(--petro-navy);
        font-weight: 700;
    }

    html[dir="rtl"] .signature {
        text-align: right;
    }

    /* 🧾 البطاقة */
    .registration-card {
        background: #fff;
        border-radius: var(--card-radius);
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
        max-width: 780px;
        margin: 55px auto;
        padding: 50px;
        transition: 0.3s;
        border-top: 5px solid var(--petro-red);
    }

        .registration-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 28px rgba(0,0,0,0.1);
        }

        .registration-card h4 {
            color: var(--qdrat-dark);
            font-weight: 800;
            text-align: center;
            margin-bottom: 6px;
        }

        .registration-card .form-sub {
            text-align: center;
            color: var(--text-muted);
            margin-bottom: 28px;
            font-size: 0.95rem;
        }

    .form-label {
        font-weight: 600;
        color: var(--text-main);
    }

    .form-control {
        border: 1px solid #ccc;
        border-radius: 10px;
        padding: 10px 12px;
        background: #f9fafa;
        color: var(--text-main);
        transition: 0.3s;
        font-family: 'Cairo', sans-serif;
    }

        .form-control:focus {
            border-color: var(--qdrat-main);
            box-shadow: 0 0 0 3px rgba(51,153,153,0.25);
            background: #fff;
        }

    .btn-qdrat {
        background: linear-gradient(90deg, var(--qdrat-main), var(--qdrat-dark));
        border: none;
        color: #fff;
        font-weight: 700;
        padding: 12px;
        font-size: 1.05rem;
        border-radius: 10px;
        width: 100%;
        transition: all 0.3s ease;
    }

        .btn-qdrat:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(43,127,127,0.4);
        }

    /* ⚙️ شركاؤنا */
    .partners-strip {
        background: #fff;
        margin-top: 90px;
        padding: 30px 0;
        border-top: 3px solid var(--qdrat-main);
    }

        .partners-strip h6 {
            color: var(--qdrat-dark);
            font-weight: 700;
            margin-bottom: 15px;
        }

        .partners-strip img {
            height: 45px;
            margin: 0 18px;
            opacity: 0.85;
            transition: 0.3s;
        }

            .partners-strip img:hover {
                opacity: 1;
                transform: scale(1.08);
            }

    @@media (max-width: 768px) {
        .announcement-card, .registration-card {
            padding: 28px 22px;
            margin: 30px 12px;
        }

        .hero h1 {
            font-size: 1.35rem;
        }

        .signature {
            text-align: center;
        }
    }

    /* Dark mode */
    @@media (prefers-color-scheme: dark) {
        body {
            background: #10191a;
            color: #e7f0ef;
        }

        .announcement-card, .registration-card {
            background: #172323;
            color: #e7f0ef;
        }

        .announcement-card p, .form-label {
            color: #d7e4e3;
        }

        .program-title-box {
            background: #102626;
        }

        .form-control {
            background: #0f1b1c;
            color: #e7f0ef;
            border-color: #2c4142;
        }

        .partners-strip {
            background: #172323;
        }
    }
</style>

<!-- 🟩 رأس الصفحة -->
<section class="hero" dir="rtl">
    <span class="hero-eyebrow">إعلان تدريبي رسمي</span>
    <div class="hero-logos">
        <div class="logo-badge">
            <img src="~/images/160×100.png" alt="شعار معهد القدرات" fetchpriority="high" />
        </div>
        <div class="hero-divider">
            <i class="fas fa-handshake"></i>
        </div>
        <div class="logo-badge">
            <img src="~/images/sponsors/petrojet.png" alt="شعار شركة بتروجت" />
        </div>
    </div>
    <h1>شراكة تدريبية بين <strong style="color:#fff;">معهد القدرات للتدريب</strong> وشركة <strong style="color:#ffd27a;">بتروجت للمشروعات البترولية</strong></h1>
    <p class="hero-sub">برنامج تدريبي متخصص في تطبيقات وأدوات الذكاء الاصطناعي لتطوير أداء الموظفين ورفع كفاءتهم الرقمية.</p>
</section>

<!-- 📜 خطاب الإعلان -->
<section class="container" dir="rtl">
    <div class="announcement-card">
        <div class="badge-title">
            <i class="fas fa-bullhorn"></i>
            <span>إعلان هام لموظفي شركة بتروجت</span>
        </div>

        <p class="greeting">السادة/ موظفي شركة بتروجت للمشروعات البترولية المحترمين،</p>

        <p>
            يسر الشركة أن تعلن عن التوصل إلى اتفاق مع <strong style="color:var(--qdrat-dark);">معهد القدرات للتدريب</strong>
            لتنفيذ برنامج تدريبي بعنوان:
        </p>

        <div class="program-title-box">
            <span class="label">عنوان البرنامج التدريبي</span>
            <span class="title">"تطبيقات وأدوات الذكاء الاصطناعي (110 أداة)"</span>
        </div>

        <p>
            ويهدف البرنامج إلى تمكين الموظفين من اكتساب <strong>المهارات العملية</strong> في استخدام أحدث
            تطبيقات وأدوات الذكاء الاصطناعي، بما يسهم في <strong style="color:var(--petro-red);">رفع الكفاءة والإنتاجية</strong>
            وتطوير الأداء في بيئة العمل.
        </p>

        <div class="info-chips">
            <div class="chip"><i class="fas fa-clock"></i> مدة البرنامج: 6 أشهر</div>
            <div class="chip"><i class="fas fa-robot"></i> 110 أداة ذكاء اصطناعي</div>
            <div class="chip"><i class="fas fa-building"></i> بالتعاون مع معهد القدرات</div>
        </div>

        <p>
            وسيتم تزويد الموظفين خلال الفترة القادمة بكافة التفاصيل المتعلقة بـ <strong>مواعيد بدء البرنامج</strong>،
            و<strong>آلية التسجيل</strong>، و<strong>جدول التدريب</strong>، والمتطلبات اللازمة للمشاركة.
        </p>

        <p>
            نتطلع إلى مشاركة الجميع والاستفادة من هذه الفرصة التطويرية، متمنين لكم دوام التوفيق والنجاح.
        </p>

        <div class="signature">
            إدارة شركة بتروجت للمشروعات البترولية
        </div>
    </div>
</section>

<!-- 🧾 نموذج التسجيل -->
<section class="container" dir="rtl">
    <div class="registration-card">

        <h4>📋 نموذج تسجيل موظفي شركة <strong style="color:var(--petro-red);">بتروجت</strong></h4>
        <p class="form-sub">سجّل بياناتك الآن ليتم التواصل معك بتفاصيل البرنامج التدريبي فور بدء التسجيل</p>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success text-center">@TempData["Success"]</div>
        }

        <form asp-action="Register" method="post">
            <input type="hidden" asp-for="CompanyName" value="بتروجيت" />

            <div class="row g-3">
                <div class="col-md-12">
                    <label asp-for="FullName" class="form-label">الاسم الكامل</label>
                    <input asp-for="FullName" class="form-control" placeholder="اكتب الاسم الثلاثي هنا..." />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="Email" class="form-label">البريد الإلكتروني</label>
                    <input asp-for="Email" class="form-control" placeholder="example@domain.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="EmployeeNumber" class="form-label">الرقم الوظيفي</label>
                    <input asp-for="EmployeeNumber" class="form-control" placeholder="أدخل رقمك الوظيفي بالشركة" />
                    <span asp-validation-for="EmployeeNumber" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="NationalID" class="form-label">رقم الهوية الوطنية</label>
                    <input asp-for="NationalID" class="form-control" placeholder="أدخل رقم الهوية المكون من 10 أرقام" />
                    <span asp-validation-for="NationalID" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label">رقم الجوال</label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="05XXXXXXXX" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Residence" class="form-label">محل الإقامة</label>
                    <input asp-for="Residence" class="form-control" placeholder="المدينة أو الحي" />
                </div>
            </div>

            <button type="submit" class="btn btn-qdrat mt-4">
                📩 إرسال الطلب
            </button>
        </form>
    </div>
</section>

<!-- 🧩 شركاؤنا -->
<div class="partners-strip text-center" dir="rtl">
    <h6>شركاؤنا في النجاح</h6>
    <div class="d-flex justify-content-center align-items-center flex-wrap">
        <img src="~/images/sponsors/petrojet.png" alt="Petrojet" loading="lazy" />
    </div>
</div>
