@model string
@{
    ViewData["Title"] = "التسجيل غير متاح";
}

<div class="container mt-5 text-center">

    <div class="card shadow-sm border-0 p-5 rounded-4">
        <h3 class="text-danger fw-bold mb-3">🚫 تم إغلاق التسجيل</h3>

        <p class="fs-5 text-muted">
            تم الاكتفاء بعدد المتدربين الحالي في شركة
            <strong class="text-primary">@Model</strong>
            نظرًا لعدم وجود مقاعد فارغة.
        </p>

        <p class="text-secondary">نشكركم على اهتمامكم وتفهمكم.</p>
    </div>

</div>
