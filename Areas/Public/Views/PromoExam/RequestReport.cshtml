@model QdratNew.ViewModels.Promo.PromoLeadInputViewModel
@{
    ViewData["Title"] = "طلب التقرير الذكي";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}

<section class="py-5" style="direction: rtl;">
    <div class="container text-center">
        <h2 class="fw-bold text-primary mb-3">📩 اطلب تقريرك الذكي</h2>
        <p class="text-muted mb-4">
            أدخل بياناتك ليصلك تقرير مفصل عن أدائك في الاختبار الترويجي وتحليلك بالذكاء الاصطناعي.
        </p>

        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow border-0">
                    <div class="card-body p-4">

                        <form asp-action="RequestReport" method="post">
                            <input type="hidden" name="SessionId" value="@Model.SessionId" />

                            <div class="mb-3 text-start">
                                <label class="form-label fw-bold">الاسم الكامل:</label>
                                <input asp-for="FullName" class="form-control" placeholder="مثلاً: محمد علي القحطاني" required />
                            </div>

                            <div class="mb-3 text-start">
                                <label class="form-label fw-bold">رقم الجوال:</label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="05xxxxxxxx" required />
                            </div>

                            <div class="mb-3 text-start">
                                <label class="form-label fw-bold">رقم واتساب (اختياري):</label>
                                <input asp-for="WhatsAppNumber" class="form-control" placeholder="05xxxxxxxx" />
                            </div>

                            <div class="form-text text-danger mb-3 text-start">
                                ⚠️ في حال عدم إرسال البيانات لن يتم الاحتفاظ بنتيجة اختبارك.
                            </div>

                            <button type="submit" class="btn btn-success btn-lg w-100">
                                📬 إرسال البيانات واستلام التقرير
                            </button>
                        </form>
                    </div>
                </div>

                <div class="mt-4 text-muted small">
                    سنرسل لك تحليلاً ذكياً على رقم الجوال أو الواتساب خلال 24 ساعة بإذن الله.
                </div>
            </div>
        </div>
    </div>
</section>
