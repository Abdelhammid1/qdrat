@model QdratNew.ViewModels.Promo.PromoExamResultViewModel
@{
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
    ViewData["Title"] = "نتيجتك في الاختبار الترويجي";

    var percent = Model.ScorePercent;
    string message = percent switch
    {
        >= 90 => "🌟 أداء خارق! واضح إنك مبدع و جاهز للاختبار الفعلي فورًا 💪",
        >= 75 => "👏 ممتاز! مستواك رائع جدًا و تحتاج فقط لبعض التمارين الإضافية.",
        >= 60 => "💪 أداء جيد جدًا! أنت في الطريق الصحيح نحو الإتقان.",
        >= 40 => "📘 بداية موفقة! تحتاج فقط لتدريب مركز على بعض المهارات.",
        _ => "🚀 لا تيأس! هذه أول خطوة نحو التميز، و الفريق جاهز لدعمك خطوة بخطوة."
    };
}

<section class="promo-result-section py-5" style="direction: rtl;">
    <div class="container text-center">
        <!-- العنوان -->
        <h2 class="fw-bold mb-4 text-primary" data-aos="fade-down">
            🎯 نتيجتك في الاختبار الترويجي
        </h2>

        <!-- البطاقة الرئيسية -->
        <div class="card border-0 shadow-lg rounded-4 p-4 mx-auto" style="max-width: 650px;" data-aos="zoom-in">
            <div class="card-body">

                <!-- نسبة الإنجاز -->
                <div class="progress-ring my-4 mx-auto" style="--percent:@percent">
                    <div class="inner-ring">
                        <h3 class="fw-bold mb-0 text-primary">@percent%</h3>
                        <small class="text-muted">نسبة النجاح</small>
                    </div>
                </div>

                <!-- التفاصيل الرقمية -->
                <div class="row text-center mb-4">
                    <div class="col-6 col-md-3">
                        <div class="info-box text-success">
                            <i class="bi bi-check-circle-fill fs-3"></i>
                            <p>الصحيحة</p>
                            <h5 class="fw-bold">@Model.CorrectAnswers</h5>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="info-box text-danger">
                            <i class="bi bi-x-circle-fill fs-3"></i>
                            <p>الخاطئة</p>
                            <h5 class="fw-bold">@Model.WrongAnswers</h5>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 mt-3 mt-md-0">
                        <div class="info-box text-secondary">
                            <i class="bi bi-skip-forward-circle fs-3"></i>
                            <p>المتخطاة</p>
                            <h5 class="fw-bold">@Model.SkippedQuestions</h5>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 mt-3 mt-md-0">
                        <div class="info-box text-dark">
                            <i class="bi bi-123 fs-3"></i>
                            <p>إجمالي الأسئلة</p>
                            <h5 class="fw-bold">@Model.TotalQuestions</h5>
                        </div>
                    </div>
                </div>

                <!-- الرسالة التحفيزية -->
                <div class="alert alert-light border-start border-5 border-primary text-center fw-bold fs-5 py-3" data-aos="fade-up">
                    @message
                </div>

                <!-- التنبيه التسويقي -->
                <div class="alert alert-warning mt-4 fw-bold w-100 mx-auto">
                    ⚠️ لتصلك <span class="text-primary">تحليلات الذكاء الاصطناعي</span> وتوصيات التحسين، أدخل بياناتك الآن لتستلم تقريرك الذكي المجاني 📄
                </div>

                <!-- زر إرسال البيانات -->
                <a asp-action="RequestReport" asp-route-sessionId="@Model.SessionId"
                   class="btn btn-success btn-lg fw-bold mt-3 px-5 shadow">
                    📩 أرسل بياناتي للحصول على التقرير الذكي
                </a>
            </div>
        </div>

        <!-- تنويه خفيف -->
        <div class="mt-5 text-muted small">
            هذا الاختبار مقدمة بسيطة من نظام معهد القدرات الذكي لتحليل الأداء بدقة ❤️
            <br />هل أنت مستعد للانضمام إلى مئات الطلاب المتفوقين؟ 🚀
        </div>
    </div>
</section>

<style>
    body {
        background: #f7fbfb;
    }

    .progress-ring {
        --size: 150px;
        --percent: 0;
        width: var(--size);
        height: var(--size);
        border-radius: 50%;
        background: conic-gradient(#2b8f89 calc(var(--percent) * 1%), #dcdcdc 0);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        margin: 0 auto;
    }

        .progress-ring::after {
            content: "";
            position: absolute;
            width: calc(var(--size) - 20px);
            height: calc(var(--size) - 20px);
            border-radius: 50%;
            background: white;
        }

    .inner-ring {
        position: relative;
        z-index: 2;
    }

    .info-box {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 12px;
        transition: 0.3s;
    }

        .info-box:hover {
            transform: scale(1.05);
            background: #f1f9f8;
        }

    .alert-warning {
        background-color: #fff6e6;
        border-color: #ffe5b4;
        color: #aa7200;
    }

    .btn-success {
        background: linear-gradient(to right, #2B7D77, #3D9494);
        border: none;
        transition: 0.4s ease;
    }

        .btn-success:hover {
            transform: scale(1.05);
            box-shadow: 0 0 15px rgba(59, 140, 133, 0.4);
        }
</style>
