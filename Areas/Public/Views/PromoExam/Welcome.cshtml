@{
    ViewData["Title"] = "مرحبا بك في الاختبار الترويجي";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}

<section class="w-100 py-5" style="background-color: rgba(210, 123, 74, 0.07); direction: rtl;">
    <div class="container text-center">
        <h2 class="fw-bold text-primary mb-4" data-aos="fade-down">يا هلا وغلا فيك 👋</h2>

        <p class="lead mb-4" data-aos="fade-up">
            هذا اختبار ترويجي مجاني مقدم من <strong>معهد القدرات</strong> لمساعدتك على قياس مستواك في إحدى الدورات التدريبية المتاحة.
        </p>

        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6" data-aos="zoom-in">
                <div class="bg-white p-4 shadow rounded">
                    <h5 class="fw-bold mb-3 text-dark">قبل أن تبدأ...</h5>

                    <!-- ✅ الفورم الآن يستدعي الأكشن الجديد Start -->
                    <form asp-action="Start" method="post">
                        <div class="mb-3 text-start">
                            <label for="CourseId" class="form-label fw-bold">اختر الدورة التي تود اختبار نفسك فيها:</label>
                            <select id="CourseId" name="CourseId" class="form-select" required>
                                <option value="">اختر الدورة التدريبية</option>
                                @foreach (var course in ViewBag.Courses as List<SelectListItem>)
                                {
                                    <option value="@course.Value">@course.Text</option>
                                }
                            </select>
                        </div>

                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-success btn-lg px-5">
                                🚀 ابدأ الاختبار الآن
                            </button>
                        </div>
                    </form>

                    <div class="mt-4 text-muted small">
                        عدد الأسئلة: <strong>20 سؤالًا عشوائيًا</strong><br />
                        الوقت المتوقع: <strong>أقل من 10 دقائق</strong><br />
                        بدون تسجيل أو بريد إلكتروني
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
