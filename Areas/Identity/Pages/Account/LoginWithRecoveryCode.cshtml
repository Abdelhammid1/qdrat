@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "تسجيل الدخول باستخدام رمز الاسترداد";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card shadow-sm p-4" style="max-width: 450px; width: 100%; border-radius: 15px;" dir="rtl">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-primary">@ViewData["Title"]</h3>
            <p class="text-muted small">
                يمكنك استخدام رمز الاسترداد لتسجيل الدخول إذا فقدت الوصول إلى تطبيق المصادقة.
            </p>
            <i class="fas fa-key fa-3x text-primary my-3"></i>
        </div>

        <form method="post" class="text-end">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.RecoveryCode" class="form-label fw-bold text-secondary">رمز الاسترداد:</label>
                <input asp-for="Input.RecoveryCode" class="form-control form-control-lg text-center border-primary" autocomplete="off" placeholder="أدخل رمز الاسترداد" />
                <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2" style="border-radius: 10px;">
                <i class="fas fa-key me-2"></i> تسجيل الدخول
            </button>
        </form>

        <div class="text-center mt-4">
            <a href="/" class="text-decoration-none small text-muted">
                <i class="fas fa-home me-1"></i> العودة للرئيسية
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
