@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "تأكيد التسجيل";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card shadow-sm p-4" style="max-width: 450px; width: 100%; border-radius: 15px;" dir="rtl">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-primary">@ViewData["Title"]</h3>
            <p class="text-muted small">
                تم إنشاء حسابك بنجاح. يرجى التحقق من بريدك الإلكتروني لتأكيد الحساب.
            </p>
            <i class="fas fa-check-circle fa-3x text-success my-3"></i>
        </div>

        @if (Model.DisplayConfirmAccountLink)
        {
            <div class="alert alert-warning text-center">
                <p class="mb-2 small">هذه المنصة حالياً لا تستخدم مزود بريد إلكتروني حقيقي.</p>
                <a id="confirm-link" href="@Model.EmailConfirmationUrl" class="btn btn-outline-primary">
                    <i class="fas fa-envelope me-2"></i> اضغط هنا لتأكيد حسابك يدوياً
                </a>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">
                <i class="fas fa-envelope me-2"></i> تم إرسال رابط التفعيل إلى بريدك الإلكتروني.
            </div>
        }

        <div class="text-center mt-4">
            <a href="/" class="btn btn-outline-primary w-100 py-2" style="border-radius: 10px;">
                <i class="fas fa-home me-2"></i> العودة للصفحة الرئيسية
            </a>
        </div>
    </div>
</div>
