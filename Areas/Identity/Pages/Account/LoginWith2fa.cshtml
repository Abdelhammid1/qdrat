@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "التحقق بخطوتين";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card shadow-sm p-4" style="max-width: 450px; width: 100%; border-radius: 15px;" dir="rtl">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-primary">@ViewData["Title"]</h3>
            <p class="text-muted small">
                تم حماية تسجيل دخولك بواسطة تطبيق المصادقة.
                <br />من فضلك أدخل رمز التحقق الذي يظهر لديك الآن.
            </p>
            <i class="fas fa-shield-alt fa-3x text-primary my-3"></i>
        </div>

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="text-end">
            <input asp-for="RememberMe" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.TwoFactorCode" class="form-label fw-bold text-secondary">رمز التحقق:</label>
                <input asp-for="Input.TwoFactorCode" class="form-control form-control-lg text-center border-primary" autocomplete="off" placeholder="أدخل الرمز المكون من 6 أرقام" />
                <span asp-validation-for="Input.TwoFactorCode" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="Input.RememberMachine" class="form-check-input" />
                <label asp-for="Input.RememberMachine" class="form-check-label">تذكر هذا الجهاز مستقبلاً</label>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2" style="border-radius: 10px;">
                <i class="fas fa-lock me-2"></i> تسجيل الدخول
            </button>
        </form>

        <div class="text-center mt-4">
            <p class="small">
                لا يمكنك الوصول لتطبيق المصادقة؟
                <a id="recovery-code-login" asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-underline">استخدم رمز الاسترداد</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
