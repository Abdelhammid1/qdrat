@page
@model LockoutModel
@{
    ViewData["Title"] = "تم إيقاف الحساب مؤقتاً";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card shadow-sm p-4 text-center" style="max-width: 450px; width: 100%; border-radius: 15px;" dir="rtl">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-danger">@ViewData["Title"]</h3>
            <p class="text-muted small">
                تم إيقاف حسابك مؤقتاً بسبب عدة محاولات فاشلة لتسجيل الدخول.
                <br />
                الرجاء المحاولة مرة أخرى لاحقاً أو التواصل مع الإدارة.
            </p>
            <i class="fas fa-user-lock fa-3x text-danger my-3"></i>
        </div>

        <div class="text-center">
            <a href="/" class="btn btn-outline-primary w-100 py-2" style="border-radius: 10px;">
                <i class="fas fa-home me-2"></i> العودة للصفحة الرئيسية
            </a>
        </div>
    </div>
</div>
