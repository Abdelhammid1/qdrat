@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "تأكيد إعادة تعيين كلمة المرور";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card shadow-sm p-4" style="max-width: 450px; width: 100%; border-radius: 15px;" dir="rtl">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-success">@ViewData["Title"]</h3>
            <p class="text-muted small">
                تم إرسال رابط إعادة تعيين كلمة المرور إلى بريدك الإلكتروني.
                <br />
                من فضلك قم بمراجعة بريدك الإلكتروني لإكمال العملية.
            </p>
            <i class="fas fa-envelope-open-text fa-3x text-success my-3"></i>
        </div>

        <div class="text-center">
            <a href="/" class="btn btn-outline-primary w-100 py-2" style="border-radius: 10px;">
                <i class="fas fa-home me-2"></i> العودة للصفحة الرئيسية
            </a>
        </div>
    </div>
</div>
