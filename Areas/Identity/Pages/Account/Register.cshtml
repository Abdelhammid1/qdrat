@page
@model RegisterModel
@{
    ViewData["Title"] = "التسجيل";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}

<h2 class="text-start mb-4 fw-bold text-qdrat">إنشاء حساب جديد</h2>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header text-white fw-bold" style="background-color: #4CA6A8;">
                <i class="fas fa-user-plus me-2"></i> معلومات الحساب
            </div>
            <div class="card-body text-end p-4">
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- 🔹 رقم الهوية -->
                    <div class="form-floating mb-3">
                        <input asp-for="Input.NationalID" class="form-control" placeholder="رقم الهوية الوطنية" />
                        <label asp-for="Input.NationalID"><i class="fas fa-id-card me-1"></i> رقم الهوية الوطنية</label>
                        <span asp-validation-for="Input.NationalID" class="text-danger"></span>
                    </div>

                    <!-- 🔹 البريد الإلكتروني -->
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" />
                        <label asp-for="Input.Email"><i class="fas fa-envelope me-1"></i> البريد الإلكتروني</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <!-- 🔹 كلمة المرور -->
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" placeholder="كلمة المرور" />
                        <label asp-for="Input.Password"><i class="fas fa-lock me-1"></i> كلمة المرور</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <!-- 🔹 تأكيد كلمة المرور -->
                    <div class="form-floating mb-4">
                        <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="تأكيد كلمة المرور" />
                        <label asp-for="Input.ConfirmPassword"><i class="fas fa-lock me-1"></i> تأكيد كلمة المرور</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <!-- 🔹 زر التسجيل -->
                    <button id="registerSubmit" type="submit" class="btn w-100 text-white py-2 fw-bold" style="background-color: #4CA6A8;">
                        <i class="fas fa-user-plus me-1"></i> إنشاء الحساب
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
