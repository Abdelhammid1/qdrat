@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "تم إعادة تعيين كلمة المرور";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card shadow-sm p-4 text-center" style="max-width: 450px; width: 100%; border-radius: 15px;" dir="rtl">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-success">@ViewData["Title"]</h3>
            <p class="text-muted small">
                تم إعادة تعيين كلمة المرور بنجاح. يمكنك الآن تسجيل الدخول باستخدام كلمة المرور الجديدة.
            </p>
            <i class="fas fa-check-circle fa-3x text-success my-3"></i>
        </div>

        <div class="text-center">
            <a asp-page="./Login" class="btn btn-outline-primary w-100 py-2" style="border-radius: 10px;">
                <i class="fas fa-sign-in-alt me-2"></i> تسجيل الدخول الآن
            </a>
        </div>
    </div>
</div>
