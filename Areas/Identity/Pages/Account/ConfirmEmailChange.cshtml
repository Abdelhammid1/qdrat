@page
@model ConfirmEmailChangeModel
@{
    ViewData["Title"] = "تأكيد تغيير البريد الإلكتروني";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card shadow-sm p-4 text-center" style="max-width: 450px; width: 100%; border-radius: 15px;" dir="rtl">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-primary">@ViewData["Title"]</h3>
            <p class="text-muted small">
                تم تأكيد تغيير البريد الإلكتروني بنجاح. يمكنك الآن تسجيل الدخول باستخدام بريدك الجديد.
            </p>
            <i class="fas fa-envelope fa-3x text-primary my-3"></i>
        </div>

        <partial name="_StatusMessage" model="Model.StatusMessage" />

        <div class="text-center mt-4">
            <a asp-page="./Login" class="btn btn-outline-primary w-100 py-2" style="border-radius: 10px;">
                <i class="fas fa-sign-in-alt me-2"></i> تسجيل الدخول الآن
            </a>
        </div>
    </div>
</div>
