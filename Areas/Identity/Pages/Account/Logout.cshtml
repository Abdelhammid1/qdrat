@page
@model LogoutModel
@{
    ViewData["Title"] = "تسجيل الخروج";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card shadow-sm p-4" style="max-width: 450px; width: 100%; border-radius: 15px;" dir="rtl">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-danger">@ViewData["Title"]</h3>
            <p class="text-muted small">لقد قمت بتسجيل الخروج من النظام بنجاح.</p>
            <i class="fas fa-sign-out-alt fa-3x text-danger my-3"></i>
        </div>

        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                <button type="submit" class="btn btn-outline-danger w-100 py-2" style="border-radius: 10px;">
                    <i class="fas fa-sign-out-alt me-2"></i> اضغط هنا لتأكيد تسجيل الخروج
                </button>
            </form>
        }
        else
        {
            <div class="alert alert-success text-center">
                <i class="fas fa-check-circle me-2"></i> تم تسجيل الخروج بنجاح.
            </div>
            <div class="text-center mt-3">
                <a href="/" class="btn btn-primary">العودة للصفحة الرئيسية</a>
            </div>
        }
    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const btn = document.querySelector('button[type="submit"]');
            if (!btn) return;

            btn.addEventListener('click', function () {
                btn.disabled = true;                // منع الضغط المتكرر
                btn.innerText = "جاري تسجيل الخروج...";
            });
        });
    </script>
}
