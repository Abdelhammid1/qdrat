@model ParentWeeklyReportViewModel
@{
    ViewData["Title"] = "التقرير الأسبوعي";
}

<div class="mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
        <h2 style="font-size:18px;font-weight:800;color:var(--parent-primary);margin:0;">التقرير الأسبوعي</h2>
        <p style="color:#6b7c93;font-size:13px;margin:4px 0 0;">@Model.StudentName — @Model.WeekRange</p>
    </div>
    <a asp-area="Parents" asp-controller="Reports" asp-action="Monthly"
       asp-route-studentId="@Model.StudentId"
       class="btn-parent-outline" style="font-size:13px;">
        <i class="fas fa-calendar-alt"></i>
        التقرير الشهري
    </a>
</div>

<!-- ملخص الأسبوع -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card success">
            <div class="stat-value" style="color:var(--parent-success);">@Model.CompletedHomeworks</div>
            <div class="stat-label">واجبات مُنجزة</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card danger">
            <div class="stat-value" style="color:var(--parent-danger);">@Model.LateHomeworks</div>
            <div class="stat-label">واجبات متأخرة</div>
        </div>
    </div>
    @if (Model.BestScore.HasValue)
    {
        <div class="col-6 col-md-3">
            <div class="stat-card @(Model.BestScore >= 75 ? "success" : Model.BestScore >= 60 ? "warning" : "danger")">
                <div class="stat-value">@Model.BestScore.Value.ToString("0.0")%</div>
                <div class="stat-label">أفضل درجة</div>
            </div>
        </div>
    }
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-2 mb-1">
                <i class="fas @Model.CommitmentIcon" style="color:var(--parent-@Model.CommitmentColor);"></i>
                <span style="font-size:11px;color:#7a8ba0;">الالتزام</span>
            </div>
            <div class="stat-value" style="font-size:16px;">@Model.CommitmentSummary</div>
        </div>
    </div>
</div>

<!-- ملاحظة الاختبارات -->
@if (!string.IsNullOrEmpty(Model.ExamSummary))
{
    <div class="parent-card mb-3">
        <div class="section-header mb-3">
            <div class="section-icon"><i class="fas fa-file-alt"></i></div>
            <h2>ملخص الاختبارات</h2>
        </div>
        <p style="font-size:14px;color:#4a5a6a;line-height:1.8;margin:0;">@Model.ExamSummary</p>
    </div>
}

<!-- ملاحظة التحسن -->
@if (!string.IsNullOrEmpty(Model.ImprovementNote))
{
    <div class="parent-card mb-3" style="border-right:3px solid var(--parent-success);">
        <div class="section-header mb-2">
            <div class="section-icon" style="background:#d4f0e3;"><i class="fas fa-trending-up" style="color:var(--parent-success);"></i></div>
            <h2>ملاحظة التحسن</h2>
        </div>
        <p style="font-size:14px;color:#2d6a4f;line-height:1.8;margin:0;">@Model.ImprovementNote</p>
    </div>
}

<!-- ملخص نشاط المنصة -->
@if (!string.IsNullOrEmpty(Model.PlatformActionSummary))
{
    <div class="parent-card mb-3">
        <div class="section-header mb-2">
            <div class="section-icon"><i class="fas fa-laptop"></i></div>
            <h2>نشاط ابنك على المنصة</h2>
        </div>
        <p style="font-size:13px;color:#5a6a7e;line-height:1.8;margin:0;">@Model.PlatformActionSummary</p>
    </div>
}

<!-- التوصية الأسبوعية -->
@if (!string.IsNullOrEmpty(Model.WeekRecommendation))
{
    <div class="action-box">
        <p class="action-title"><i class="fas fa-lightbulb me-1"></i> توصية هذا الأسبوع</p>
        <p class="action-text">@Model.WeekRecommendation</p>
        <a asp-area="Parents" asp-controller="SmartPractice" asp-action="Create"
           asp-route-studentId="@Model.StudentId"
           class="btn-parent-white" style="font-size:13px;">
            <i class="fas fa-brain"></i>
            ابدأ تدريباً ذكياً
        </a>
    </div>
}
