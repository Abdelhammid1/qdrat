@model ParentMonthlyReportViewModel
@{
    ViewData["Title"] = "التقرير الشهري";
}

<div class="mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
        <h2 style="font-size:18px;font-weight:800;color:var(--parent-primary);margin:0;">التقرير الشهري</h2>
        <p style="color:#6b7c93;font-size:13px;margin:4px 0 0;">@Model.StudentName — @Model.MonthLabel</p>
    </div>
    <a asp-area="Parents" asp-controller="Reports" asp-action="Weekly"
       asp-route-studentId="@Model.StudentId"
       class="btn-parent-outline" style="font-size:13px;">
        <i class="fas fa-calendar-week"></i>
        التقرير الأسبوعي
    </a>
</div>

<!-- ملخص الشهر -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-value">@Model.TotalHomeworks</div>
            <div class="stat-label">واجبات الشهر</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card success">
            <div class="stat-value" style="color:var(--parent-success);">@Model.CompletedHomeworks</div>
            <div class="stat-label">واجبات منجزة</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-value">@Model.TotalPracticeRequests</div>
            <div class="stat-label">جلسات تدريب</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-2 mb-1">
                <i class="fas @Model.TrendIcon @Model.TrendColor"></i>
                <span style="font-size:11px;color:#7a8ba0;">الاتجاه العام</span>
            </div>
            <div class="stat-value" style="font-size:16px;">@Model.OverallTrend</div>
        </div>
    </div>
</div>

<!-- نقاط التحسن -->
@if (Model.ImprovementPoints.Any())
{
    <div class="parent-card mb-3" style="border-right:3px solid var(--parent-success);">
        <div class="section-header mb-3">
            <div class="section-icon" style="background:#d4f0e3;"><i class="fas fa-thumbs-up" style="color:var(--parent-success);"></i></div>
            <h2>تحسينات هذا الشهر</h2>
        </div>
        <ul style="margin:0;padding-right:20px;">
            @foreach (var point in Model.ImprovementPoints)
            {
                <li style="font-size:14px;color:#2d6a4f;margin-bottom:6px;line-height:1.7;">@point</li>
            }
        </ul>
    </div>
}

<!-- نقاط المتابعة -->
@if (Model.FollowUpPoints.Any())
{
    <div class="parent-card mb-3" style="border-right:3px solid var(--parent-warning);">
        <div class="section-header mb-3">
            <div class="section-icon"><i class="fas fa-exclamation-triangle"></i></div>
            <h2>تحتاج متابعة</h2>
        </div>
        <ul style="margin:0;padding-right:20px;">
            @foreach (var point in Model.FollowUpPoints)
            {
                <li style="font-size:14px;color:#7a5c00;margin-bottom:6px;line-height:1.7;">@point</li>
            }
        </ul>
    </div>
}

<!-- أثر المنصة -->
@if (!string.IsNullOrEmpty(Model.PlatformImpactSummary))
{
    <div class="parent-card mb-3">
        <div class="section-header mb-2">
            <div class="section-icon"><i class="fas fa-laptop"></i></div>
            <h2>أثر استخدام المنصة</h2>
        </div>
        <p style="font-size:13px;color:#5a6a7e;line-height:1.8;margin:0;">@Model.PlatformImpactSummary</p>
    </div>
}

<!-- التوصية الشهرية -->
@if (!string.IsNullOrEmpty(Model.MonthRecommendation))
{
    <div class="action-box">
        <p class="action-title"><i class="fas fa-lightbulb me-1"></i> توصية هذا الشهر</p>
        <p class="action-text">@Model.MonthRecommendation</p>
        <a asp-area="Parents" asp-controller="SmartPractice" asp-action="Create"
           asp-route-studentId="@Model.StudentId"
           class="btn-parent-white" style="font-size:13px;">
            <i class="fas fa-brain"></i>
            تدريب ذكي مخصص
        </a>
    </div>
}
