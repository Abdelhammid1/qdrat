@model ParentLearningStatusViewModel
@{
    ViewData["Title"] = "مستوى التعلم";
}

<div class="mb-4">
    <h2 style="font-size:18px;font-weight:800;color:var(--parent-primary);margin:0;">مستوى التعلم</h2>
    <p style="color:#6b7c93;font-size:13px;margin:4px 0 0;">@Model.StudentName — تحليل آمن لمسيرة الطالب</p>
</div>

<div class="row g-3 mb-4">
    <!-- الحالة العامة -->
    <div class="col-12 col-md-4">
        <div class="parent-card text-center h-100">
            <div style="width:70px;height:70px;border-radius:50%;background:var(--parent-accent-light);display:grid;place-items:center;margin:0 auto 12px;">
                <i class="fas fa-graduation-cap fa-2x" style="color:var(--parent-accent);"></i>
            </div>
            <div style="font-size:22px;font-weight:800;color:var(--parent-primary);">@Model.OverallStatus</div>
            <div style="font-size:12px;color:#7a8ba0;margin-top:4px;">الحالة العامة</div>
        </div>
    </div>

    <!-- الالتزام -->
    <div class="col-12 col-md-4">
        <div class="parent-card h-100">
            <div class="section-header mb-3">
                <div class="section-icon"><i class="fas fa-check-double"></i></div>
                <h2>الالتزام الأكاديمي</h2>
            </div>
            <div style="font-size:32px;font-weight:900;color:var(--parent-@(Model.StatusColor));">
                @Model.CommitmentPercent%
            </div>
            <div class="progress-parent mt-2">
                <div class="fill @(Model.CommitmentPercent >= 75 ? "success" : Model.CommitmentPercent >= 50 ? "warning" : "danger")"
                     style="width:@Model.CommitmentPercent%;transition:width 1s ease;"></div>
            </div>
            <p style="font-size:12px;color:#7a8ba0;margin-top:8px;">@Model.CommitmentLevel</p>
        </div>
    </div>

    <!-- اتجاه الأداء -->
    <div class="col-12 col-md-4">
        <div class="parent-card h-100">
            <div class="section-header mb-3">
                <div class="section-icon"><i class="fas fa-chart-line"></i></div>
                <h2>اتجاه الأداء</h2>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div style="width:50px;height:50px;border-radius:12px;background:var(--parent-accent-light);display:grid;place-items:center;flex-shrink:0;">
                    <i class="fas @Model.TrendIcon fa-xl @Model.TrendColor"></i>
                </div>
                <div>
                    <div style="font-size:18px;font-weight:800;color:var(--parent-primary);">@Model.PerformanceTrend</div>
                    <div style="font-size:12px;color:#7a8ba0;">مقارنة بالفترة السابقة</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- إحصاءات الواجبات -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-value">@Model.TotalHomeworks</div>
            <div class="stat-label">إجمالي الواجبات</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card success">
            <div class="stat-value" style="color:var(--parent-success);">@Model.CompletedHomeworks</div>
            <div class="stat-label">واجبات مُنجزة</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card danger">
            <div class="stat-value" style="color:var(--parent-danger);">@Model.LateHomeworks</div>
            <div class="stat-label">واجبات متأخرة</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-value">@Model.LastExamScore.ToString("0.0")%</div>
            <div class="stat-label">آخر اختبار</div>
        </div>
    </div>
</div>

<!-- نقاط تحتاج اهتماماً -->
@if (!string.IsNullOrEmpty(Model.WeaknessSummary))
{
    <div class="parent-card mb-3">
        <div class="section-header">
            <div class="section-icon"><i class="fas fa-exclamation-triangle"></i></div>
            <h2>نقاط تحتاج اهتماماً</h2>
        </div>
        <div style="background:#fef9e7;border-radius:10px;padding:16px;border-right:4px solid var(--parent-warning);">
            <p style="margin:0;font-size:14px;color:#7a5c00;line-height:1.8;">@Model.WeaknessSummary</p>
        </div>
        <div class="mt-3 d-flex gap-2 flex-wrap">
            <a asp-area="Parents" asp-controller="SmartPractice" asp-action="Create"
               asp-route-studentId="@Model.StudentId"
               class="btn-parent-primary" style="font-size:13px;">
                <i class="fas fa-brain"></i>
                تدريب ذكي مخصص
            </a>
        </div>
    </div>
}

<!-- نقاط القوة -->
@if (!string.IsNullOrEmpty(Model.StrengthSummary))
{
    <div class="parent-card mb-3" style="border-right:3px solid var(--parent-success);">
        <div class="section-header">
            <div class="section-icon" style="background:#d4f0e3;"><i class="fas fa-star" style="color:var(--parent-success);"></i></div>
            <h2>نقاط قوة ابنك</h2>
        </div>
        <div style="background:#f0f9f4;border-radius:10px;padding:14px 16px;">
            <p style="margin:0;font-size:14px;color:#2d6a4f;line-height:1.8;">@Model.StrengthSummary</p>
        </div>
    </div>
}

@if (Model.HasUpcomingExam && !string.IsNullOrEmpty(Model.UpcomingExamDate))
{
    <div class="action-box">
        <p class="action-title"><i class="fas fa-calendar-check me-1"></i> اختبار قادم</p>
        <p class="action-text">موعد الاختبار القادم: @Model.UpcomingExamDate</p>
        <a asp-area="Parents" asp-controller="SmartPractice" asp-action="Create"
           asp-route-studentId="@Model.StudentId" class="btn-parent-white" style="font-size:13px;">
            <i class="fas fa-brain"></i>
            تدريب لتحضير الاختبار
        </a>
    </div>
}
