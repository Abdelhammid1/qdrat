@model ParentInstitutePlanFollowUpViewModel
@{
    ViewData["Title"] = "خطة المعهد";
}

<div class="mb-4">
    <h2 style="font-size:18px;font-weight:800;color:var(--parent-primary);margin:0;">خطة المعهد المعتمدة</h2>
    <p style="color:#6b7c93;font-size:13px;margin:4px 0 0;">@Model.StudentName</p>
</div>

@if (!Model.HasApprovedPlan)
{
    <div class="parent-card text-center py-5">
        <i class="fas fa-clipboard-list fa-3x mb-3" style="color:#c0ccd8;"></i>
        <p style="color:#7a8ba0;margin:0;font-size:14px;">لا توجد خطة متابعة معتمدة حالياً.</p>
        <p style="color:#aab6c4;font-size:12px;margin-top:8px;">تواصل مع المعهد لمزيد من المعلومات.</p>
    </div>
}
else
{
    <!-- بطاقات الحالة -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="stat-card @(Model.IsCompleted ? "success" : "warning")">
                <div class="stat-value" style="font-size:16px;">@Model.PlanStatusLabel</div>
                <div class="stat-label">حالة الخطة</div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="stat-card">
                <div class="stat-value">@((int)Model.CompletionPercentage)%</div>
                <div class="stat-label">نسبة الإنجاز</div>
                <div class="progress-parent mt-1">
                    <div class="fill @(Model.CompletionPercentage >= 75 ? "success" : "warning")"
                         style="width:@((int)Model.CompletionPercentage)%"></div>
                </div>
            </div>
        </div>
        @if (Model.TotalSessions.HasValue)
        {
            <div class="col-12 col-md-4">
                <div class="stat-card">
                    <div class="stat-value">@Model.CompletedSessions / @Model.TotalSessions</div>
                    <div class="stat-label">الجلسات المنجزة</div>
                </div>
            </div>
        }
    </div>

    <!-- التفاصيل -->
    <div class="parent-card mb-3">
        <div class="section-header mb-3">
            <div class="section-icon"><i class="fas fa-info-circle"></i></div>
            <h2>تفاصيل الخطة</h2>
        </div>
        <div class="row g-3">
            @if (!string.IsNullOrEmpty(Model.StartDate))
            {
                <div class="col-6">
                    <div style="background:#f0f7ff;border-radius:10px;padding:12px 16px;">
                        <span style="font-size:12px;color:#6b7c93;display:block;margin-bottom:4px;">تاريخ البدء</span>
                        <p style="margin:0;font-size:14px;color:var(--parent-primary);font-weight:600;">@Model.StartDate</p>
                    </div>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.EndDate))
            {
                <div class="col-6">
                    <div style="background:#f0f7ff;border-radius:10px;padding:12px 16px;">
                        <span style="font-size:12px;color:#6b7c93;display:block;margin-bottom:4px;">تاريخ الانتهاء المتوقع</span>
                        <p style="margin:0;font-size:14px;color:var(--parent-primary);font-weight:600;">@Model.EndDate</p>
                    </div>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.NextAppointmentDate))
            {
                <div class="col-12">
                    <div style="background:#fef9e7;border-radius:10px;padding:12px 16px;border-right:3px solid var(--parent-warning);">
                        <span style="font-size:12px;color:#7a5c00;font-weight:600;">
                            <i class="fas fa-calendar-check me-1"></i>
                            الموعد القادم: @Model.NextAppointmentDate
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- التوصية -->
    @if (!string.IsNullOrEmpty(Model.SafeRecommendation))
    {
        <div class="action-box">
            <p class="action-title"><i class="fas fa-lightbulb me-1"></i> توصية النظام</p>
            <p class="action-text">@Model.SafeRecommendation</p>
        </div>
    }

    <!-- تنبيه: الخطة العلاجية حق المعهد -->
    <div class="parent-card mt-3" style="background:#f8fdf9;border:1.5px solid #b7e5cc;">
        <div class="d-flex align-items-start gap-3">
            <i class="fas fa-shield-alt" style="color:var(--parent-success);margin-top:2px;"></i>
            <div>
                <p style="margin:0;font-size:13px;color:#2d6a4f;font-weight:600;">الخطة العلاجية حق أصيل للمعهد</p>
                <p style="margin:4px 0 0;font-size:12px;color:#52796f;">
                    هذه المعلومات للاطلاع فقط. التعديل على الخطة يتم من قِبل المعهد حصراً.
                </p>
            </div>
        </div>
    </div>
}
