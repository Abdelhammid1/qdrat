@using Microsoft.AspNetCore.Identity
@inject SignInManager<QdratNew.Entities.ApplicationUser> SignInManager
@inject UserManager<QdratNew.Entities.ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - بوابة ولي الأمر | معهد القدرات</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    @RenderSection("Styles", required: false)

    <style>
        :root {
            --parent-primary: #1e3a5f;
            --parent-accent: #2e86de;
            --parent-accent-light: #e8f3ff;
            --parent-success: #27ae60;
            --parent-warning: #f39c12;
            --parent-danger: #e74c3c;
            --parent-bg: #f0f4f8;
            --parent-card: #ffffff;
            --parent-sidebar-w: 260px;
            --parent-topbar-h: 60px;
            --font-main: 'Cairo', sans-serif;
            --radius: 12px;
            --shadow-card: 0 2px 12px rgba(0,0,0,0.08);
            --shadow-hover: 0 6px 20px rgba(30,58,95,0.15);
            --transition: 0.22s ease;
        }

        *, *::before, *::after { box-sizing: border-box; }

        html, body {
            height: 100%;
            font-family: var(--font-main);
            font-size: 14px;
            background: var(--parent-bg);
            color: #1a2332;
            overflow-x: hidden;
        }

        /* ======= SHELL ======= */
        .parent-shell { display: flex; height: 100vh; overflow: hidden; }

        /* ======= SIDEBAR ======= */
        .parent-sidebar {
            width: var(--parent-sidebar-w);
            background: var(--parent-primary);
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            height: 100vh;
            overflow-y: auto;
            overflow-x: hidden;
            transition: width var(--transition);
            z-index: 100;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 20px 18px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .sidebar-brand .brand-icon {
            width: 38px; height: 38px;
            background: var(--parent-accent);
            border-radius: 10px;
            display: grid; place-items: center;
            color: #fff; font-size: 18px;
            flex-shrink: 0;
        }

        .sidebar-brand .brand-text { color: #fff; font-weight: 700; font-size: 15px; line-height: 1.2; }
        .sidebar-brand .brand-sub { color: rgba(255,255,255,0.55); font-size: 11px; }

        .sidebar-section-label {
            color: rgba(255,255,255,0.35);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 16px 18px 6px;
        }

        .sidebar-nav { list-style: none; margin: 0; padding: 0 10px; }

        .sidebar-nav li a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 8px;
            color: rgba(255,255,255,0.75);
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 500;
            transition: all var(--transition);
            margin-bottom: 2px;
        }

        .sidebar-nav li a:hover,
        .sidebar-nav li a.active {
            background: rgba(255,255,255,0.1);
            color: #fff;
        }

        .sidebar-nav li a.active {
            background: var(--parent-accent);
            box-shadow: 0 3px 10px rgba(46,134,222,0.35);
        }

        .sidebar-nav li a i { width: 20px; text-align: center; font-size: 15px; }

        .sidebar-footer {
            margin-top: auto;
            padding: 14px 10px;
            border-top: 1px solid rgba(255,255,255,0.08);
        }

        .sidebar-footer a {
            display: flex;
            align-items: center;
            gap: 8px;
            color: rgba(255,255,255,0.5);
            font-size: 13px;
            padding: 8px 12px;
            border-radius: 8px;
            text-decoration: none;
            transition: all var(--transition);
        }

        .sidebar-footer a:hover { color: #fff; background: rgba(255,255,255,0.08); }

        /* ======= MAIN AREA ======= */
        .parent-main { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

        .parent-topbar {
            height: var(--parent-topbar-h);
            background: #fff;
            border-bottom: 1px solid #e5eaf2;
            display: flex;
            align-items: center;
            padding: 0 24px;
            gap: 12px;
            flex-shrink: 0;
            box-shadow: 0 1px 4px rgba(0,0,0,0.05);
            z-index: 50;
        }

        .topbar-toggle {
            display: none;
            background: none;
            border: none;
            color: #666;
            font-size: 20px;
            cursor: pointer;
            padding: 4px 8px;
        }

        .topbar-breadcrumb { flex: 1; }
        .topbar-breadcrumb .page-title {
            font-size: 16px;
            font-weight: 700;
            color: var(--parent-primary);
            margin: 0;
        }

        .topbar-actions { display: flex; align-items: center; gap: 12px; }

        .notif-btn {
            position: relative;
            background: none;
            border: none;
            color: #555;
            font-size: 18px;
            cursor: pointer;
            padding: 6px 8px;
            border-radius: 8px;
            transition: background var(--transition);
        }

        .notif-btn:hover { background: #f0f4f8; }

        .notif-badge {
            position: absolute;
            top: 2px;
            left: 2px;
            background: var(--parent-danger);
            color: #fff;
            font-size: 9px;
            width: 16px; height: 16px;
            border-radius: 50%;
            display: grid; place-items: center;
            font-weight: 700;
        }

        .user-chip {
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--parent-accent-light);
            border-radius: 24px;
            padding: 5px 14px 5px 8px;
        }

        .user-chip .avatar {
            width: 30px; height: 30px;
            background: var(--parent-primary);
            border-radius: 50%;
            display: grid; place-items: center;
            color: #fff; font-size: 13px;
            font-weight: 700;
        }

        .user-chip .name { font-size: 13px; font-weight: 600; color: var(--parent-primary); }

        /* ======= CONTENT ======= */
        .parent-content {
            flex: 1;
            overflow-y: auto;
            padding: 24px;
        }

        /* ======= CARDS ======= */
        .parent-card {
            background: var(--parent-card);
            border-radius: var(--radius);
            box-shadow: var(--shadow-card);
            padding: 20px;
            transition: box-shadow var(--transition);
        }

        .parent-card:hover { box-shadow: var(--shadow-hover); }

        .stat-card {
            background: var(--parent-card);
            border-radius: var(--radius);
            box-shadow: var(--shadow-card);
            padding: 18px 20px;
            border-top: 3px solid var(--parent-accent);
        }

        .stat-card.success { border-top-color: var(--parent-success); }
        .stat-card.warning { border-top-color: var(--parent-warning); }
        .stat-card.danger  { border-top-color: var(--parent-danger); }
        .stat-card.primary { border-top-color: var(--parent-accent); }

        .stat-value { font-size: 26px; font-weight: 800; color: var(--parent-primary); }
        .stat-label { font-size: 12px; color: #7a8ba0; margin-top: 2px; }

        /* ======= ALERT-BOX ======= */
        .action-box {
            background: linear-gradient(135deg, var(--parent-accent) 0%, #1a6db5 100%);
            border-radius: var(--radius);
            color: #fff;
            padding: 20px 24px;
        }

        .action-box .action-title { font-size: 13px; opacity: 0.85; margin: 0 0 4px; }
        .action-box .action-text { font-size: 16px; font-weight: 700; margin: 0 0 14px; }

        .btn-parent-primary {
            background: var(--parent-accent);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 9px 20px;
            font-family: var(--font-main);
            font-size: 13.5px;
            font-weight: 600;
            cursor: pointer;
            transition: all var(--transition);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .btn-parent-primary:hover { background: #1a6db5; color: #fff; transform: translateY(-1px); }

        .btn-parent-white {
            background: rgba(255,255,255,0.2);
            color: #fff;
            border: 1.5px solid rgba(255,255,255,0.4);
            border-radius: 8px;
            padding: 8px 18px;
            font-family: var(--font-main);
            font-size: 13.5px;
            font-weight: 600;
            cursor: pointer;
            transition: all var(--transition);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            backdrop-filter: blur(4px);
        }

        .btn-parent-white:hover { background: rgba(255,255,255,0.35); color: #fff; }

        /* Status badges */
        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .status-pill::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
        .status-pill.success { background: #e9f9ef; color: var(--parent-success); }
        .status-pill.warning { background: #fef9e7; color: var(--parent-warning); }
        .status-pill.danger  { background: #fdecea; color: var(--parent-danger); }
        .status-pill.secondary { background: #f0f0f0; color: #777; }

        /* Progress bar */
        .progress-parent { background: #e8edf3; border-radius: 10px; height: 8px; overflow: hidden; }
        .progress-parent .fill { background: var(--parent-accent); height: 100%; border-radius: 10px; transition: width 0.5s ease; }
        .progress-parent .fill.success { background: var(--parent-success); }
        .progress-parent .fill.warning { background: var(--parent-warning); }
        .progress-parent .fill.danger  { background: var(--parent-danger); }

        /* Section header */
        .section-header {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 16px;
        }

        .section-header h2 {
            font-size: 16px;
            font-weight: 700;
            color: var(--parent-primary);
            margin: 0;
        }

        .section-header .section-icon {
            width: 32px; height: 32px;
            background: var(--parent-accent-light);
            border-radius: 8px;
            display: grid; place-items: center;
            color: var(--parent-accent);
            font-size: 14px;
        }

        /* Alert messages */
        .toast-success {
            background: var(--parent-success);
            color: #fff;
            border-radius: 10px;
            padding: 12px 18px;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .toast-error {
            background: var(--parent-danger);
            color: #fff;
            border-radius: 10px;
            padding: 12px 18px;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* ======= RESPONSIVE ======= */
        @@media (max-width: 768px) {
            .parent-sidebar {
                position: fixed;
                right: 0; top: 0;
                height: 100vh;
                transform: translateX(100%);
                transition: transform 0.28s ease;
                z-index: 999;
                box-shadow: -4px 0 20px rgba(0,0,0,0.2);
            }

            .parent-sidebar.open { transform: translateX(0); }

            .topbar-toggle { display: block; }

            .parent-content { padding: 16px; }

            .sidebar-overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.4);
                z-index: 998;
            }

            .sidebar-overlay.show { display: block; }
        }

        /* Dark mode */
        @@media (prefers-color-scheme: dark) {
            :root {
                --parent-bg: #0f1621;
                --parent-card: #1a2233;
                --parent-primary: #1e3a5f;
            }
            body { color: #dde6f0; }
            .parent-topbar { background: #1a2233; border-color: #263348; }
            .topbar-breadcrumb .page-title { color: #e2ecf6; }
        }
    </style>
</head>
<body>
<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

<div class="parent-shell">
    <!-- ===== SIDEBAR ===== -->
    <aside class="parent-sidebar" id="parentSidebar">
        <div class="sidebar-brand">
            <div class="brand-icon"><i class="fas fa-graduation-cap"></i></div>
            <div>
                <div class="brand-text">معهد القدرات</div>
                <div class="brand-sub">بوابة ولي الأمر</div>
            </div>
        </div>

        <div class="sidebar-section-label">القائمة الرئيسية</div>
        <ul class="sidebar-nav">
            <li>
                <a asp-area="Parents" asp-controller="Dashboard" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                    <i class="fas fa-home"></i>
                    <span>الرئيسية</span>
                </a>
            </li>
            <li>
                <a asp-area="Parents" asp-controller="Children" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Children" ? "active" : "")">
                    <i class="fas fa-users"></i>
                    <span>أبنائي</span>
                </a>
            </li>
            <li>
                <a asp-area="Parents" asp-controller="LearningStatus" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "LearningStatus" ? "active" : "")">
                    <i class="fas fa-chart-line"></i>
                    <span>الحالة التعليمية</span>
                </a>
            </li>
        </ul>

        <div class="sidebar-section-label">المتابعة</div>
        <ul class="sidebar-nav">
            <li>
                <a asp-area="Parents" asp-controller="HomeworkFollowUp" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "HomeworkFollowUp" ? "active" : "")">
                    <i class="fas fa-book-open"></i>
                    <span>الواجبات</span>
                </a>
            </li>
            <li>
                <a asp-area="Parents" asp-controller="ExamFollowUp" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "ExamFollowUp" ? "active" : "")">
                    <i class="fas fa-file-alt"></i>
                    <span>الاختبارات</span>
                </a>
            </li>
            <li>
                <a asp-area="Parents" asp-controller="InstitutePlanFollowUp" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "InstitutePlanFollowUp" ? "active" : "")">
                    <i class="fas fa-clipboard-list"></i>
                    <span>خطة المعهد</span>
                </a>
            </li>
        </ul>

        <div class="sidebar-section-label">الأدوات</div>
        <ul class="sidebar-nav">
            <li>
                <a asp-area="Parents" asp-controller="SmartPractice" asp-action="Create"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "SmartPractice" ? "active" : "")">
                    <i class="fas fa-brain"></i>
                    <span>تدريب ذكي</span>
                </a>
            </li>
            <li>
                <a asp-area="Parents" asp-controller="Reports" asp-action="Weekly"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")">
                    <i class="fas fa-chart-bar"></i>
                    <span>التقارير</span>
                </a>
            </li>
            <li>
                <a asp-area="Parents" asp-controller="Notifications" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Notifications" ? "active" : "")">
                    <i class="fas fa-bell"></i>
                    <span>الإشعارات</span>
                </a>
            </li>
            <li>
                <a asp-area="Parents" asp-controller="Messages" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Messages" ? "active" : "")">
                    <i class="fas fa-envelope"></i>
                    <span>رسائلي</span>
                </a>
            </li>
        </ul>

        <div class="sidebar-footer">
            <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                <button type="submit" style="background:none;border:none;padding:0;width:100%;">
                    <a style="color:rgba(255,255,255,0.5);" class="d-flex align-items-center gap-2 p-2">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>تسجيل الخروج</span>
                    </a>
                </button>
            </form>
        </div>
    </aside>

    <!-- ===== MAIN ===== -->
    <div class="parent-main">
        <!-- Topbar -->
        <header class="parent-topbar">
            <button class="topbar-toggle" onclick="toggleSidebar()" aria-label="القائمة">
                <i class="fas fa-bars"></i>
            </button>

            <div class="topbar-breadcrumb">
                <h1 class="page-title">@(ViewData["Title"] ?? "بوابة ولي الأمر")</h1>
            </div>

            <div class="topbar-actions">
                <a asp-area="Parents" asp-controller="Notifications" asp-action="Index" class="notif-btn" title="الإشعارات">
                    <i class="fas fa-bell"></i>
                </a>

                <a asp-area="Parents" asp-controller="Messages" asp-action="Create" class="btn-parent-primary" style="padding:7px 14px;font-size:13px;">
                    <i class="fas fa-paper-plane"></i>
                    <span class="d-none d-sm-inline">راسل المعهد</span>
                </a>

                <div class="user-chip">
                    <div class="avatar">
                        @{
                            var currentUser = await UserManager.GetUserAsync(User);
                            var initials = currentUser?.FullName?.Length > 0
                                ? currentUser.FullName[0].ToString()
                                : "و";
                        }
                        @initials
                    </div>
                    <span class="name d-none d-sm-inline">@(currentUser?.FullName ?? "ولي الأمر")</span>
                </div>
            </div>
        </header>

        <!-- Content -->
        <main class="parent-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="toast-success mb-3">
                    <i class="fas fa-check-circle"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="toast-error mb-3">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
            }

            @RenderBody()
        </main>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
@RenderSection("Scripts", required: false)

<script>
    function toggleSidebar() {
        document.getElementById('parentSidebar').classList.toggle('open');
        document.getElementById('sidebarOverlay').classList.toggle('show');
    }
    function closeSidebar() {
        document.getElementById('parentSidebar').classList.remove('open');
        document.getElementById('sidebarOverlay').classList.remove('show');
    }
</script>
</body>
</html>
