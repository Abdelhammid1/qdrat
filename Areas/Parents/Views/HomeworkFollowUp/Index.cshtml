@model ParentHomeworkFollowUpViewModel
@{
    ViewData["Title"] = "متابعة الواجبات";
}

<div class="mb-4">
    <h2 style="font-size:18px;font-weight:800;color:var(--parent-primary);margin:0;">متابعة الواجبات</h2>
    <p style="color:#6b7c93;font-size:13px;margin:4px 0 0;">@Model.StudentName</p>
</div>

<!-- ملخص -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-value">@Model.TotalAssigned</div>
            <div class="stat-label">إجمالي الواجبات</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card success">
            <div class="stat-value" style="color:var(--parent-success);">@Model.Completed</div>
            <div class="stat-label">مُسلَّمة</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card danger">
            <div class="stat-value" style="color:var(--parent-danger);">@Model.Late</div>
            <div class="stat-label">متأخرة</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card @Model.CommitmentColor">
            <div class="stat-value">@Model.CommitmentPercent%</div>
            <div class="stat-label">نسبة الالتزام</div>
            <div class="progress-parent mt-1">
                <div class="fill @(Model.CommitmentPercent >= 75 ? "success" : Model.CommitmentPercent >= 50 ? "warning" : "danger")"
                     style="width:@Model.CommitmentPercent%"></div>
            </div>
        </div>
    </div>
</div>

@if (Model.Late > 0)
{
    <div class="parent-card mb-3" style="border-right:4px solid var(--parent-danger);">
        <div class="d-flex align-items-center gap-2">
            <i class="fas fa-exclamation-circle" style="color:var(--parent-danger);"></i>
            <span style="font-size:14px;font-weight:700;color:var(--parent-danger);">
                يوجد @Model.Late واجب متأخر — يرجى التواصل مع ابنك لتسليمها
            </span>
        </div>
    </div>
}

<!-- توصية -->
@if (!string.IsNullOrEmpty(Model.SafeRecommendation))
{
    <div class="action-box mb-3">
        <p class="action-title"><i class="fas fa-lightbulb me-1"></i> توصية</p>
        <p class="action-text">@Model.SafeRecommendation</p>
    </div>
}

<!-- قائمة الواجبات الأخيرة -->
@if (!Model.RecentHomeworks.Any())
{
    <div class="parent-card text-center py-5">
        <i class="fas fa-book-open fa-3x mb-3" style="color:#c0ccd8;"></i>
        <p style="color:#7a8ba0;margin:0;">لا توجد واجبات حديثة.</p>
    </div>
}
else
{
    <div class="parent-card">
        <div class="section-header mb-3">
            <div class="section-icon"><i class="fas fa-book-open"></i></div>
            <h2>سجل الواجبات الأخيرة</h2>
        </div>
        <div class="d-flex flex-column gap-2">
            @foreach (var hw in Model.RecentHomeworks)
            {
                <div class="d-flex align-items-center gap-3 p-3 rounded-3"
                     style="background:#f7f9fc;border:1px solid #e0e7ef;">
                    <div style="width:36px;height:36px;border-radius:10px;
                                background:@(hw.Status == "Done" ? "#eafaf3" : hw.Status == "Late" ? "#fdf0f0" : "#fffaf0");
                                display:grid;place-items:center;flex-shrink:0;">
                        <i class="fas @(hw.Status == "Done" ? "fa-check" : hw.Status == "Late" ? "fa-times" : "fa-clock")"
                           style="color:@(hw.Status == "Done" ? "var(--parent-success)" : hw.Status == "Late" ? "var(--parent-danger)" : "var(--parent-warning)");font-size:14px;"></i>
                    </div>
                    <div class="flex-1">
                        <div style="font-size:14px;font-weight:700;color:var(--parent-primary);">@hw.Title</div>
                        @if (!string.IsNullOrEmpty(hw.DueDate))
                        {
                            <div style="font-size:12px;color:#7a8ba0;">موعد التسليم: @hw.DueDate</div>
                        }
                    </div>
                    <span class="status-pill @hw.StatusColor">
                        @(hw.Status == "Done" ? "مُسلَّم" : hw.Status == "Late" ? "متأخر" : "معلّق")
                    </span>
                </div>
            }
        </div>
    </div>
}
