@model ParentNotificationViewModel
@{
    ViewData["Title"] = "الإشعارات";
}

<div class="mb-4 d-flex align-items-center justify-content-between">
    <div>
        <h2 style="font-size:18px;font-weight:800;color:var(--parent-primary);margin:0;">الإشعارات</h2>
        @if (Model.UnreadCount > 0)
        {
            <p style="color:#6b7c93;font-size:13px;margin:4px 0 0;">
                لديك <strong style="color:var(--parent-accent);">@Model.UnreadCount</strong> إشعار غير مقروء
            </p>
        }
    </div>

    @if (Model.Notifications.Any(n => !n.IsRead))
    {
        <form method="post" asp-action="MarkRead" asp-area="Parents" asp-controller="Notifications">
            @Html.AntiForgeryToken()
            <input type="hidden" name="notificationId" value="0" />
            <button type="submit" class="btn-parent-outline" style="font-size:13px;">
                <i class="fas fa-check-double"></i>
                تحديد الكل كمقروء
            </button>
        </form>
    }
</div>

@if (!Model.Notifications.Any())
{
    <div class="parent-card text-center py-5">
        <i class="fas fa-bell-slash fa-3x mb-3" style="color:#c0ccd8;"></i>
        <p style="color:#7a8ba0;margin:0;">لا توجد إشعارات حتى الآن.</p>
    </div>
}
else
{
    <div class="parent-card">
        <div class="d-flex flex-column gap-2">
            @foreach (var notif in Model.Notifications)
            {
                <div class="d-flex align-items-start gap-3 p-3 rounded-3"
                     style="background:@(notif.IsRead ? "#f7f9fc" : "#f0f7ff");
                            border:1px solid @(notif.IsRead ? "#e0e7ef" : "#c6dff8");
                            transition:background .2s;">
                    <div style="width:40px;height:40px;border-radius:12px;
                                background:@(notif.IsRead ? "#eef1f5" : "var(--parent-accent-light)");
                                display:grid;place-items:center;flex-shrink:0;">
                        <i class="fas @notif.IconClass"
                           style="color:@(notif.IsRead ? "#8a99ab" : "var(--parent-accent)");font-size:16px;"></i>
                    </div>
                    <div class="flex-1">
                        <p style="margin:0 0 4px;font-size:14px;color:@(notif.IsRead ? "#4a5a6a" : "#1a2332");
                                  font-weight:@(notif.IsRead ? "400" : "600");">
                            @notif.Message
                        </p>
                        <div class="d-flex align-items-center gap-3">
                            <span style="font-size:11px;color:#9aa8b8;">
                                <i class="fas fa-clock me-1"></i>
                                @notif.TimeAgo
                            </span>
                            <span class="status-pill @notif.BadgeColor" style="font-size:10px;">@notif.Title</span>
                        </div>
                    </div>
                    <div class="d-flex gap-2 flex-shrink-0">
                        @if (!notif.IsRead)
                        {
                            <form method="post" asp-action="MarkRead" asp-area="Parents" asp-controller="Notifications">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="notificationId" value="@notif.Id" />
                                <button type="submit" class="btn-parent-outline" style="font-size:11px;padding:4px 10px;">
                                    <i class="fas fa-check"></i>
                                    قراءة
                                </button>
                            </form>
                        }
                        @if (!string.IsNullOrEmpty(notif.TargetUrl))
                        {
                            <a href="@notif.TargetUrl" class="btn-parent-primary" style="font-size:11px;padding:4px 10px;">
                                <i class="fas fa-external-link-alt"></i>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}
