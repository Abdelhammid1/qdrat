@using QdratNew.Enums
@using QdratNew.Services.RemedialTracks
@using QdratNew.ViewModels.RemedialTracks
@model QdratNew.ViewModels.RemedialTracks.RemedialTrackParentReportDetailsVm
@inject QdratNew.Services.Interfaces.ITimeZoneService Tz
@functions {
    static string OutcomeText(RemedialTrackReportAxisOutcome o) => o switch
    {
        RemedialTrackReportAxisOutcome.Passed => "اجتاز المحور",
        RemedialTrackReportAxisOutcome.NeedsFollowUp => "لم يجتز — يحتاج متابعة",
        RemedialTrackReportAxisOutcome.MovedByAdmin => "لم يجتز — فتحت الإدارة المحور التالي",
        RemedialTrackReportAxisOutcome.InProgress => "قيد التنفيذ",
        _ => "لم يصل إليه بعد"
    };
    static string OutcomeClass(RemedialTrackReportAxisOutcome o) => o switch
    {
        RemedialTrackReportAxisOutcome.Passed => "bg-success",
        RemedialTrackReportAxisOutcome.NeedsFollowUp or RemedialTrackReportAxisOutcome.MovedByAdmin => "bg-danger",
        RemedialTrackReportAxisOutcome.InProgress => "bg-primary",
        _ => "bg-secondary"
    };
    static string Pct(double? v) => v.HasValue ? v.Value.ToString("0.#") + "%" : "—";
    string Date(DateTime? utc) => utc.HasValue ? Tz.ConvertToSaudi(utc.Value).ToString("yyyy/MM/dd") : "—";
    string DateTimeText(DateTime utc) => Tz.ConvertToSaudi(utc).ToString("yyyy/MM/dd HH:mm");

    string BodyText(RemedialTrackParentReportDetailsVm m) => m.Kind == RemedialTrackParentReportKind.AxisNotPassed
        ? RemedialTrackParentCopy.AxisNotPassedBody(m.Snapshot.FocusAxisTitle ?? "—")
        : RemedialTrackParentCopy.FinalBody(m.Snapshot.PassedAxes, m.Snapshot.TotalAxes, m.Snapshot.FollowUpAxes);
}
@{
    var s = Model.Snapshot;
    ViewData["Title"] = RemedialTrackParentCopy.Title(Model.Kind);
    var message = TempData["RtkParentReportMessage"] as string;
}

@section Styles {
    <style>
        .rtk-pr { max-width: 900px; margin-inline: auto; }
        .rtk-pr__head { text-align: center; border-bottom: 2px solid var(--parent-accent, #2e86de); padding-bottom: 12px; margin-bottom: 16px; }
        .rtk-pr__axis { border: 1px solid #dee2e6; border-radius: 12px; padding: 14px; margin-bottom: 12px; background: #fff; break-inside: avoid; }
        .rtk-pr__rec { background: #e8f3ff; border-radius: 10px; padding: 10px 12px; font-size: .92rem; }
        .rtk-pr .table { font-size: .85rem; }
        .rtk-pr__btn { min-height: 44px; }
        @@media print {
            @@page { size: A4; margin: 14mm; }
            .no-print, .parent-sidebar, .parent-topbar, aside, header, nav, footer { display: none !important; }
            body, html { background: #fff !important; height: auto !important; overflow: visible !important; }
            .parent-shell { display: block !important; height: auto !important; overflow: visible !important; }
        }
    </style>
}

<div class="container-fluid py-3" dir="rtl">
    <div class="rtk-pr">
        <div class="d-flex gap-2 flex-wrap mb-3 no-print">
            <a class="btn btn-outline-secondary rtk-pr__btn" asp-action="Index"><i class="fas fa-arrow-right ms-1"></i> كل التقارير</a>
            <button type="button" class="btn btn-outline-primary rtk-pr__btn" onclick="window.print()"><i class="fas fa-print ms-1"></i> طباعة / حفظ PDF</button>
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert alert-success no-print" role="status">@message</div>
        }

        <article aria-label="تقرير الخطة العلاجية">
            <header class="rtk-pr__head">
                <h1 class="h4 fw-bold mb-1">معهد القدرات للتدريب — @RemedialTrackParentCopy.Title(Model.Kind)</h1>
                <p class="text-muted mb-0">@s.TrackTitle · @s.CurriculumTitle</p>
            </header>

            <dl class="row mb-3">
                <dt class="col-4 col-md-3">الطالب</dt><dd class="col-8 col-md-9">@s.StudentName</dd>
                <dt class="col-4 col-md-3">الدفعة</dt><dd class="col-8 col-md-9">@s.BatchName</dd>
                <dt class="col-4 col-md-3">تاريخ التقرير</dt><dd class="col-8 col-md-9">@DateTimeText(Model.SentAtUtc)</dd>
            </dl>

            <div class="alert alert-warning" role="note">
                <strong class="d-block mb-1">@(Model.Kind == RemedialTrackParentReportKind.AxisNotPassed ? "تنبيه متابعة" : "ملخص الخطة")</strong>
                @BodyText(Model)
            </div>

            <div class="row g-2 text-center mb-3">
                <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="h5 fw-bold mb-0">@s.PassedAxes / @s.TotalAxes</div><div class="small text-muted">محاور اجتازها</div></div></div>
                <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="h5 fw-bold mb-0">@s.FollowUpAxes</div><div class="small text-muted">محاور تحتاج متابعة</div></div></div>
                <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="h5 fw-bold mb-0">@(s.AverageScorePercent.HasValue ? s.AverageScorePercent.Value.ToString("0.#") + "%" : "—")</div><div class="small text-muted">متوسط النتائج</div></div></div>
                <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="h5 fw-bold mb-0">@s.PassPercent%</div><div class="small text-muted">حد الاجتياز</div></div></div>
            </div>

            <h2 class="h6 fw-bold">تفاصيل المحاور</h2>
            @if (s.Axes.Count == 0)
            {
                <div class="alert alert-light border text-center">لا توجد محاور في هذه الخطة.</div>
            }
            @foreach (var a in s.Axes)
            {
                <section class="rtk-pr__axis">
                    <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                        <h3 class="h6 fw-bold mb-1">@a.Order. @a.Title</h3>
                        <span class="badge @OutcomeClass(a.Outcome)">@OutcomeText(a.Outcome)</span>
                    </div>

                    @if (a.Outcome != RemedialTrackReportAxisOutcome.NotReached)
                    {
                        <div class="small text-muted mb-2">
                            الفيديوهات المكتملة: @a.VideosDoneRound1 من @a.VideoTotal
                            @if (a.HasRound2) { <text> · إعادة المشاهدة: @a.VideosDoneRound2 من @a.VideoTotal</text> }
                            · زمن المشاهدة: @a.WatchedMinutes دقيقة@(a.VideoMinutes > 0 ? $" (من {a.VideoMinutes} دقيقة)" : "")
                        </div>

                        @if (a.Attempts.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-2">
                                    <thead>
                                        <tr><th>الاختبار</th><th>التاريخ</th><th>الدرجة</th><th>النسبة</th><th>النتيجة</th><th>المدة</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var t in a.Attempts)
                                        {
                                            <tr>
                                                <td>@t.ExamNumber.DisplayName()</td>
                                                <td>@Date(t.SubmittedAtUtc)</td>
                                                <td>@t.CorrectCount / @t.TotalQuestions</td>
                                                <td>@Pct(t.ScorePercent) <span class="text-muted">(الحد @s.PassPercent%)</span></td>
                                                <td>@(t.IsPassed ? "ناجح" : "لم يجتز")</td>
                                                <td>@t.DurationMinutes د</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="small text-muted mb-2">لم يؤدِّ الطالب اختبارًا لهذا المحور بعد.</div>
                        }

                        @if (a.Outcome == RemedialTrackReportAxisOutcome.MovedByAdmin)
                        {
                            <div class="small text-danger mb-2">فتحت الإدارة المحور التالي بتاريخ @Date(a.AdminOpenedAtUtc) دون اجتياز هذا المحور، والمحور ما زال بحاجة لمتابعتكم.</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(a.Recommendation))
                        {
                            <div class="rtk-pr__rec"><strong>التوصية: </strong>@a.Recommendation</div>
                        }
                    }
                </section>
            }

            <p class="small text-muted mt-3">@RemedialTrackParentCopy.ResponsibilityFooter</p>
        </article>

        <div class="card mt-3 no-print">
            <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-2">
                @if (Model.AcknowledgedAtUtc.HasValue)
                {
                    <span class="text-success fw-bold"><i class="fas fa-check-circle ms-1"></i> أقررتم بالاطلاع على هذا التقرير بتاريخ @DateTimeText(Model.AcknowledgedAtUtc.Value)</span>
                }
                else
                {
                    <span>يرجى الإقرار بالاطلاع على التقرير ومتابعته مع الطالب.</span>
                    <form asp-action="Acknowledge" asp-route-id="@Model.Id" method="post" id="rtkAckForm">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success rtk-pr__btn" id="rtkAckBtn"><i class="fas fa-check ms-1"></i> أقرّ بالاطلاع</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('rtkAckForm');
            if (!form || form.dataset.bound === '1') return;
            form.dataset.bound = '1';
            form.addEventListener('submit', function () {
                var btn = document.getElementById('rtkAckBtn');
                if (btn) { btn.disabled = true; btn.textContent = 'جارٍ التسجيل...'; }
            });
        })();
    </script>
}
