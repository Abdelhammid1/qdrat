@using QdratNew.Enums
@using QdratNew.Services.RemedialTracks
@model QdratNew.ViewModels.RemedialTracks.RemedialTrackParentReportListVm
@inject QdratNew.Services.Interfaces.ITimeZoneService Tz
@{
    ViewData["Title"] = "تقارير الخطة العلاجية";
}

<div class="container-fluid py-3" dir="rtl">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <h1 class="h4 fw-bold mb-0"><i class="fas fa-file-medical ms-2"></i> تقارير الخطة العلاجية</h1>
        <span class="text-muted small">@Model.Total تقرير</span>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="alert alert-light border text-center py-5" role="status">
            <i class="fas fa-inbox fa-2x mb-2 d-block text-muted"></i>
            لا توجد تقارير للخطة العلاجية حتى الآن. ستصلكم التقارير هنا عند عدم اجتياز الطالب أحد المحاور أو عند انتهاء الخطة.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var r in Model.Items)
            {
                <div class="col-12 col-lg-6">
                    <a class="card h-100 text-decoration-none text-reset shadow-sm" asp-action="Details" asp-route-id="@r.Id">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <h2 class="h6 fw-bold mb-1">@RemedialTrackParentCopy.Title(r.Kind)</h2>
                                @if (r.AcknowledgedAtUtc.HasValue)
                                {
                                    <span class="badge bg-success">تم الاطلاع</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">بانتظار اطلاعكم</span>
                                }
                            </div>
                            <div class="small text-muted">الطالب: @r.StudentName</div>
                            <div class="small text-muted">الخطة: @r.TrackTitle</div>
                            @if (!string.IsNullOrEmpty(r.FocusAxisTitle))
                            {
                                <div class="small">المحور: <strong>@r.FocusAxisTitle</strong></div>
                            }
                            <div class="small text-muted mt-2">@Tz.ConvertToSaudi(r.SentAtUtc).ToString("yyyy/MM/dd HH:mm")</div>
                        </div>
                    </a>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3" aria-label="التنقل بين الصفحات">
                <ul class="pagination justify-content-center flex-wrap">
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>
