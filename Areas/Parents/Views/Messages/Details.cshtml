@model ParentMessageViewModel
@{
    ViewData["Title"] = "تفاصيل الرسالة";
}

<div class="mb-4">
    <div class="d-flex align-items-center gap-2 mb-1">
        <a asp-area="Parents" asp-controller="Messages" asp-action="Index"
           style="color:#7a8ba0;text-decoration:none;font-size:13px;">
            <i class="fas fa-arrow-right me-1"></i>رسائلي
        </a>
    </div>
    <h2 style="font-size:18px;font-weight:800;color:var(--parent-primary);margin:0;">@Model.Subject</h2>
    <p style="color:#6b7c93;font-size:13px;margin:4px 0 0;">
        بشأن: @Model.StudentName • @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
    </p>
</div>

<!-- نص الرسالة -->
<div class="parent-card mb-3">
    <div class="section-header mb-3">
        <div class="section-icon"><i class="fas fa-envelope"></i></div>
        <h2>رسالتك</h2>
    </div>
    <div style="background:#f7f9fc;border-radius:10px;padding:16px;border-right:3px solid var(--parent-accent);">
        <p style="margin:0;font-size:14px;color:#1a2332;line-height:1.9;white-space:pre-line;">@Model.MessageBody</p>
    </div>
    <div class="mt-3">
        <span class="status-pill @Model.StatusColor">@Model.StatusLabel</span>
    </div>
</div>

<!-- رد المعهد -->
@if (Model.HasReply)
{
    <div class="parent-card mb-3" style="border-right:3px solid var(--parent-success);">
        <div class="section-header mb-3">
            <div class="section-icon" style="background:#d4f0e3;"><i class="fas fa-reply" style="color:var(--parent-success);"></i></div>
            <h2>رد المعهد</h2>
        </div>
        @if (!string.IsNullOrEmpty(Model.RepliedAt))
        {
            <p style="font-size:12px;color:#7a8ba0;margin:0 0 8px;">@Model.RepliedAt</p>
        }
        <div style="background:#f0f9f4;border-radius:10px;padding:16px;">
            <p style="margin:0;font-size:14px;color:#1a2332;line-height:1.9;white-space:pre-line;">@Model.ReplyBody</p>
        </div>
    </div>
}
else
{
    <div class="parent-card" style="background:#fffaf0;border:1.5px solid #f5d98c;">
        <div class="d-flex align-items-center gap-2">
            <i class="fas fa-clock" style="color:var(--parent-warning);"></i>
            <p style="margin:0;font-size:13px;color:#7a5c00;">
                لم يصل الرد بعد. سيتواصل معك فريق المعهد قريباً.
            </p>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-area="Parents" asp-controller="Messages" asp-action="Create"
       class="btn-parent-primary" style="font-size:13px;">
        <i class="fas fa-plus"></i>
        رسالة جديدة
    </a>
</div>
