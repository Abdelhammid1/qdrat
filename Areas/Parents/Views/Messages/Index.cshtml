@model ParentMessagesListViewModel
@{
    ViewData["Title"] = "رسائلي";
}

<div class="mb-4 d-flex align-items-center justify-content-between">
    <div>
        <h2 style="font-size:18px;font-weight:800;color:var(--parent-primary);margin:0;">رسائلي إلى المعهد</h2>
        @if (Model.UnrepliedCount > 0)
        {
            <p style="color:#6b7c93;font-size:13px;margin:4px 0 0;">
                <strong style="color:var(--parent-warning);">@Model.UnrepliedCount</strong> رسالة في انتظار الرد
            </p>
        }
    </div>
    <a asp-area="Parents" asp-controller="Messages" asp-action="Create"
       class="btn-parent-primary" style="font-size:13px;">
        <i class="fas fa-paper-plane"></i>
        رسالة جديدة
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="parent-card mb-3" style="background:#eafaf3;border:1.5px solid #b7e5cc;">
        <div class="d-flex align-items-center gap-2">
            <i class="fas fa-check-circle" style="color:var(--parent-success);"></i>
            <span style="color:#2d6a4f;font-size:14px;font-weight:600;">@TempData["SuccessMessage"]</span>
        </div>
    </div>
}

@if (!Model.Messages.Any())
{
    <div class="parent-card text-center py-5">
        <i class="fas fa-comments fa-3x mb-3" style="color:#c0ccd8;"></i>
        <p style="color:#7a8ba0;margin:0;">لا توجد رسائل بعد.</p>
        <div class="mt-3">
            <a asp-area="Parents" asp-controller="Messages" asp-action="Create"
               class="btn-parent-primary" style="font-size:13px;">
                <i class="fas fa-plus"></i>
                أرسل أول رسالة
            </a>
        </div>
    </div>
}
else
{
    <div class="parent-card">
        <div class="d-flex flex-column gap-2">
            @foreach (var msg in Model.Messages)
            {
                <a asp-area="Parents" asp-controller="Messages" asp-action="Details"
                   asp-route-id="@msg.Id"
                   class="d-flex align-items-start gap-3 p-3 rounded-3 text-decoration-none"
                   style="background:@(msg.HasReply ? "#f0f9f4" : msg.Status == "New" ? "#fffaf0" : "#f7f9fc");
                          border:1px solid @(msg.HasReply ? "#b7e5cc" : msg.Status == "New" ? "#f5d98c" : "#e0e7ef");
                          transition:opacity .2s;"
                   onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'">
                    <div style="width:40px;height:40px;border-radius:12px;
                                background:@(msg.HasReply ? "#d4f0e3" : "#e8edf3");
                                display:grid;place-items:center;flex-shrink:0;">
                        <i class="fas @(msg.HasReply ? "fa-reply" : "fa-envelope")"
                           style="color:@(msg.HasReply ? "var(--parent-success)" : "#8a99ab");font-size:16px;"></i>
                    </div>
                    <div class="flex-1">
                        <div style="font-size:14px;font-weight:@(msg.HasReply ? "600" : "700");color:var(--parent-primary);">
                            @msg.Subject
                        </div>
                        <div style="font-size:12px;color:#7a8ba0;margin-top:2px;">
                            @msg.StudentName • @msg.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>
                    <span class="status-pill @msg.StatusColor" style="font-size:11px;flex-shrink:0;">
                        @msg.StatusLabel
                    </span>
                </a>
            }
        </div>
    </div>
}
