@model ParentMessageCreateViewModel
@{
    ViewData["Title"] = "رسالة جديدة";
}

<div class="mb-4">
    <div class="d-flex align-items-center gap-2 mb-1">
        <a asp-area="Parents" asp-controller="Messages" asp-action="Index"
           style="color:#7a8ba0;text-decoration:none;font-size:13px;">
            <i class="fas fa-arrow-right me-1"></i>رسائلي
        </a>
    </div>
    <h2 style="font-size:18px;font-weight:800;color:var(--parent-primary);margin:0;">رسالة جديدة إلى المعهد</h2>
</div>

<div class="parent-card" style="max-width:640px;">
    <form method="post" asp-action="Create" asp-area="Parents" asp-controller="Messages">
        @Html.AntiForgeryToken()

        @if (!Model.AvailableStudents.Any())
        {
            <div class="mb-3" style="background:#fef9e7;border-radius:10px;padding:12px 16px;border-right:3px solid var(--parent-warning);">
                <p style="margin:0;font-size:13px;color:#7a5c00;">
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    لا يوجد طلاب مرتبطون بحسابك. الرجاء التواصل مع المعهد أولاً.
                </p>
            </div>
        }
        else
        {
            <!-- اختيار الطالب -->
            <div class="mb-3">
                <label style="font-size:13px;font-weight:700;color:#4a5a6a;display:block;margin-bottom:6px;">
                    بشأن الطالب *
                </label>
                <select name="StudentId" asp-for="StudentId"
                        style="width:100%;border:1.5px solid #d0dcea;border-radius:10px;padding:10px 14px;font-family:var(--font-main);font-size:14px;color:var(--parent-primary);background:#fff;">
                    <option value="">-- اختر الطالب --</option>
                    @foreach (var s in Model.AvailableStudents)
                    {
                        <option value="@s.StudentId" selected="@(s.StudentId == Model.StudentId)">@s.StudentName</option>
                    }
                </select>
                <span asp-validation-for="StudentId" style="color:var(--parent-danger);font-size:12px;"></span>
            </div>

            <!-- الموضوع -->
            <div class="mb-3">
                <label style="font-size:13px;font-weight:700;color:#4a5a6a;display:block;margin-bottom:6px;">
                    موضوع الرسالة *
                </label>
                <input asp-for="Subject" placeholder="مثال: استفسار عن واجب الرياضيات"
                       style="width:100%;border:1.5px solid #d0dcea;border-radius:10px;padding:10px 14px;font-family:var(--font-main);font-size:14px;color:var(--parent-primary);box-sizing:border-box;" />
                <span asp-validation-for="Subject" style="color:var(--parent-danger);font-size:12px;"></span>
            </div>

            <!-- نص الرسالة -->
            <div class="mb-4">
                <label style="font-size:13px;font-weight:700;color:#4a5a6a;display:block;margin-bottom:6px;">
                    نص الرسالة *
                </label>
                <textarea asp-for="MessageBody" rows="6" placeholder="اكتب رسالتك هنا..."
                          style="width:100%;border:1.5px solid #d0dcea;border-radius:10px;padding:10px 14px;font-family:var(--font-main);font-size:14px;color:var(--parent-primary);resize:vertical;box-sizing:border-box;"></textarea>
                <span asp-validation-for="MessageBody" style="color:var(--parent-danger);font-size:12px;"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn-parent-primary" style="font-size:14px;">
                    <i class="fas fa-paper-plane"></i>
                    إرسال الرسالة
                </button>
                <a asp-area="Parents" asp-controller="Messages" asp-action="Index"
                   class="btn-parent-outline" style="font-size:14px;">
                    إلغاء
                </a>
            </div>
        }
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
