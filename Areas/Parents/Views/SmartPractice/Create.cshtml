@model ParentSmartPracticeCreateViewModel
@{
    ViewData["Title"] = "طلب تدريب ذكي";
}

<div class="mb-4">
    <div class="d-flex align-items-center gap-2 mb-1">
        <a asp-area="Parents" asp-controller="SmartPractice" asp-action="Index"
           asp-route-studentId="@Model.StudentId"
           style="color:#7a8ba0;text-decoration:none;font-size:13px;">
            <i class="fas fa-arrow-right me-1"></i>التدريب الذكي
        </a>
    </div>
    <h2 style="font-size:18px;font-weight:800;color:var(--parent-primary);margin:0;">طلب تدريب ذكي</h2>
</div>

@if (Model.AvailableStudents.Count > 1)
{
    <div class="parent-card mb-4" style="background:#f7f9fc;padding:14px 16px;">
        <form method="get"
              asp-action="Create"
              asp-controller="SmartPractice"
              asp-area="Parents"
              class="d-flex align-items-center gap-3 flex-wrap">
            <span style="font-size:13px;font-weight:700;color:#4a5a6a;white-space:nowrap;">
                <i class="fas fa-user-graduate me-1" style="color:var(--parent-accent);"></i>
                إرسال التدريب إلى:
            </span>
            <select name="studentId"
                    onchange="this.form.submit()"
                    style="border:1.5px solid #d0dcea;border-radius:8px;padding:7px 14px;font-family:var(--font-main);font-size:13px;font-weight:700;background:#fff;color:var(--parent-primary);min-width:160px;">
                @foreach (var child in Model.AvailableStudents)
                {
                    <option value="@child.StudentId"
                            selected="@(child.StudentId == Model.StudentId)">
                        @child.StudentName
                    </option>
                }
            </select>
        </form>
    </div>
}

@if (!Model.CanCreate)
{
    <div class="parent-card" style="border-right:4px solid var(--parent-danger);background:#fdf0f0;">
        <div class="d-flex align-items-start gap-3">
            <i class="fas fa-ban" style="color:var(--parent-danger);font-size:20px;margin-top:2px;"></i>
            <div>
                <p style="margin:0 0 6px;font-size:15px;font-weight:800;color:var(--parent-danger);">
                    لا يمكن إنشاء تدريب الآن
                </p>
                <p style="margin:0;font-size:14px;color:#c0392b;">@Model.BlockingReason</p>
            </div>
        </div>
        <div class="mt-3">
            <a asp-area="Parents" asp-controller="Dashboard" asp-action="Index"
               asp-route-studentId="@Model.StudentId"
               class="btn-parent-primary" style="font-size:13px;">
                <i class="fas fa-home"></i>
                العودة للرئيسية
            </a>
        </div>
    </div>
    return;
}

@if (!Model.AvailableCurriculums.Any())
{
    <div class="parent-card text-center py-5">
        <i class="fas fa-book-open fa-3x mb-3" style="color:#c0ccd8;"></i>
        <p style="color:#7a8ba0;margin:0;">لا تتوفر مناهج للتدريب حالياً.</p>
    </div>
    return;
}

<!-- ملاحظة الذكاء -->
@if (!string.IsNullOrEmpty(Model.StudentInsightSummary))
{
    <div class="action-box mb-4">
        <p class="action-title"><i class="fas fa-lightbulb me-1"></i> ما يحتاجه ابنك الآن</p>
        <p class="action-text">@Model.StudentInsightSummary</p>
    </div>
}

<form method="post" asp-action="Create" asp-area="Parents" asp-controller="SmartPractice">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="StudentId" />

    <div class="row g-3">
        <div class="col-12 col-md-6">
            <div class="parent-card h-100">
                <div class="section-header mb-3">
                    <div class="section-icon"><i class="fas fa-book"></i></div>
                    <h2>اختيار المنهج والوحدة</h2>
                </div>

                <!-- المنهج -->
                <div class="mb-3">
                    <label style="font-size:13px;font-weight:700;color:#4a5a6a;display:block;margin-bottom:6px;">المنهج</label>
                    <select asp-for="CurriculumId" id="curriculumSelect"
                            style="width:100%;border:1.5px solid #d0dcea;border-radius:10px;padding:10px 14px;font-family:var(--font-main);font-size:14px;color:var(--parent-primary);background:#fff;">
                        <option value="0">-- كل المناهج --</option>
                        @foreach (var c in Model.AvailableCurriculums)
                        {
                            <option value="@c.Id">@c.Title</option>
                        }
                    </select>
                </div>

                <!-- الوحدة -->
                <div class="mb-3">
                    <label style="font-size:13px;font-weight:700;color:#4a5a6a;display:block;margin-bottom:6px;">الوحدة (اختياري)</label>
                    <select asp-for="SectionId" id="sectionSelect"
                            style="width:100%;border:1.5px solid #d0dcea;border-radius:10px;padding:10px 14px;font-family:var(--font-main);font-size:14px;color:var(--parent-primary);background:#fff;">
                        <option value="">-- كل الوحدات --</option>
                        @foreach (var s in Model.AvailableSections)
                        {
                            <option value="@s.Id">@s.Title</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="parent-card h-100">
                <div class="section-header mb-3">
                    <div class="section-icon"><i class="fas fa-sliders-h"></i></div>
                    <h2>إعدادات التدريب</h2>
                </div>

                <!-- عدد الأسئلة -->
                <div class="mb-3">
                    <label style="font-size:13px;font-weight:700;color:#4a5a6a;display:block;margin-bottom:6px;">
                        عدد الأسئلة: <strong id="qDisplay">@Model.QuestionCount</strong>
                    </label>
                    <input type="range" asp-for="QuestionCount"
                           min="3" max="15" step="1"
                           id="qRange"
                           oninput="document.getElementById('qDisplay').textContent=this.value"
                           style="width:100%;accent-color:var(--parent-accent);" />
                    <div class="d-flex justify-content-between" style="font-size:11px;color:#9aa8b8;">
                        <span>3</span><span>10</span><span>15</span>
                    </div>
                </div>

                <!-- المدة -->
                <div class="mb-3">
                    <label style="font-size:13px;font-weight:700;color:#4a5a6a;display:block;margin-bottom:6px;">المدة (دقيقة)</label>
                    <select asp-for="DurationMinutes"
                            style="width:100%;border:1.5px solid #d0dcea;border-radius:10px;padding:10px 14px;font-family:var(--font-main);font-size:14px;color:var(--parent-primary);background:#fff;">
                        <option value="5">5 دقائق</option>
                        <option value="10">10 دقائق</option>
                        <option value="15" selected>15 دقيقة</option>
                        <option value="20">20 دقيقة</option>
                        <option value="30">30 دقيقة</option>
                    </select>
                </div>

                <!-- وضع التدريب -->
                <div class="mb-3">
                    <label style="font-size:13px;font-weight:700;color:#4a5a6a;display:block;margin-bottom:6px;">وضع التدريب</label>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var mode in new[] {
                            ("QuickPractice", "تدريب سريع — متوازن ومناسب", "fa-bolt"),
                            ("Challenge", "تحدي — أسئلة صعبة", "fa-fire"),
                            ("ExamPrep", "تحضير للاختبار — شامل ومتدرج", "fa-graduation-cap")
                        })
                        {
                            <label style="display:flex;align-items:center;gap:10px;cursor:pointer;padding:10px 12px;border:1.5px solid #d0dcea;border-radius:10px;background:#f7f9fc;">
                                <input type="radio" name="PracticeMode" value="@mode.Item1"
                                       @(Model.PracticeMode == mode.Item1 ? "checked" : "")
                                       style="accent-color:var(--parent-accent);width:16px;height:16px;" />
                                <div>
                                    <i class="fas @mode.Item3 me-1" style="color:var(--parent-accent);"></i>
                                    <span style="font-size:13px;font-weight:700;color:var(--parent-primary);">@mode.Item1</span>
                                    <br/>
                                    <span style="font-size:11px;color:#7a8ba0;">@mode.Item2</span>
                                </div>
                            </label>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ملاحظة أمان -->
    <div class="parent-card mt-3 mb-3" style="background:#f8fdf9;border:1.5px solid #b7e5cc;">
        <div class="d-flex align-items-start gap-2">
            <i class="fas fa-shield-alt" style="color:var(--parent-success);margin-top:2px;"></i>
            <p style="margin:0;font-size:12px;color:#2d6a4f;">
                <strong>خصوصية مصونة:</strong> لا يُكشف عن محتوى الاختبارات أو الإجابات الصحيحة.
                التدريب لتعزيز فهم المفاهيم فقط.
            </p>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn-parent-primary" style="font-size:14px;">
            <i class="fas fa-brain"></i>
            إنشاء التدريب
        </button>
        <a asp-area="Parents" asp-controller="SmartPractice" asp-action="Index"
           asp-route-studentId="@Model.StudentId"
           class="btn-parent-outline" style="font-size:14px;">
            إلغاء
        </a>
    </div>
</form>

<script>
    document.getElementById('curriculumSelect').addEventListener('change', function () {
        var cid = this.value;
        var sectionSelect = document.getElementById('sectionSelect');
        sectionSelect.innerHTML = '<option value="">-- كل الوحدات --</option>';
        if (!cid || cid === '0') return;

        fetch('@Url.Action("GetSections", "SmartPractice", new { area = "Parents" })?curriculumId=' + cid)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                data.forEach(function (s) {
                    var opt = document.createElement('option');
                    opt.value = s.id;
                    opt.textContent = s.title;
                    sectionSelect.appendChild(opt);
                });
            });
    });
</script>
