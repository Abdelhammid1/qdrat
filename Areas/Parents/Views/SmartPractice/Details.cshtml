@model ParentSmartPracticeDetailsViewModel
@{
    ViewData["Title"] = "تفاصيل التدريب";
}

<div class="mb-4">
    <div class="d-flex align-items-center gap-2 mb-1">
        <a asp-area="Parents" asp-controller="SmartPractice" asp-action="Index"
           style="color:#7a8ba0;text-decoration:none;font-size:13px;">
            <i class="fas fa-arrow-right me-1"></i>التدريب الذكي
        </a>
    </div>
    <h2 style="font-size:18px;font-weight:800;color:var(--parent-primary);margin:0;">تفاصيل التدريب</h2>
    <p style="color:#6b7c93;font-size:13px;margin:4px 0 0;">
        @Model.StudentName • @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
    </p>
</div>

<!-- بطاقات الملخص -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card @Model.StatusColor">
            <div class="stat-value" style="font-size:16px;">@Model.StatusLabel</div>
            <div class="stat-label">الحالة</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-value">@Model.QuestionCount</div>
            <div class="stat-label">عدد الأسئلة</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-value">@Model.DurationMinutes د</div>
            <div class="stat-label">المدة</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-value" style="font-size:13px;">@Model.PracticeModeLabel</div>
            <div class="stat-label">وضع التدريب</div>
        </div>
    </div>
</div>

<!-- الملخص الآمن -->
@if (!string.IsNullOrEmpty(Model.SafeSummary))
{
    <div class="parent-card mb-3">
        <div class="section-header mb-3">
            <div class="section-icon"><i class="fas fa-info-circle"></i></div>
            <h2>ملخص التدريب</h2>
        </div>
        <div style="background:#f0f7ff;border-radius:10px;padding:14px 16px;border-right:3px solid var(--parent-accent);">
            <p style="margin:0;font-size:14px;color:var(--parent-primary);line-height:1.8;">@Model.SafeSummary</p>
        </div>
    </div>
}

<!-- نتيجة التدريب -->
@if (Model.HasResult && Model.ResultScore.HasValue)
{
    var pct = (int)Math.Round(Model.ResultScore.Value);
    <div class="parent-card mb-3">
        <div class="section-header mb-3">
            <div class="section-icon" style="background:#d4f0e3;"><i class="fas fa-chart-pie" style="color:var(--parent-success);"></i></div>
            <h2>نتيجة التدريب</h2>
        </div>
        <div class="text-center mb-3">
            <div style="font-size:42px;font-weight:900;color:var(--parent-@(pct >= 75 ? "success" : pct >= 50 ? "warning" : "danger"));">
                @pct%
            </div>
            <span class="status-pill @(pct >= 75 ? "success" : pct >= 50 ? "warning" : "danger")" style="font-size:14px;padding:6px 16px;">
                @(pct >= 75 ? "ممتاز" : pct >= 60 ? "جيد" : "يحتاج مراجعة")
            </span>
        </div>
        <div class="progress-parent">
            <div class="fill @(pct >= 75 ? "success" : pct >= 50 ? "warning" : "danger")"
                 style="width:@pct%;transition:width 1.5s ease;"></div>
        </div>
        @if (!string.IsNullOrEmpty(Model.SafeResultSummary))
        {
            <div class="mt-3" style="background:#fef9e7;border-radius:10px;padding:12px 16px;border-right:3px solid var(--parent-warning);">
                <p style="margin:0;font-size:13px;color:#7a5c00;">
                    <i class="fas fa-lightbulb me-1"></i>
                    @Model.SafeResultSummary
                </p>
            </div>
        }
    </div>
}
else if (Model.Status == "Pending" || Model.Status == "InProgress")
{
    <div class="parent-card" style="background:#fffaf0;border:1.5px solid #f5d98c;">
        <div class="d-flex align-items-center gap-2">
            <i class="fas fa-spinner fa-spin" style="color:var(--parent-warning);"></i>
            <p style="margin:0;font-size:13px;color:#7a5c00;">التدريب قيد التنفيذ. شجّع ابنك على إكماله!</p>
        </div>
    </div>
}

<!-- أمان بنك الأسئلة -->
<div class="parent-card mt-3" style="background:#f8fdf9;border:1.5px solid #b7e5cc;">
    <div class="d-flex align-items-center gap-2">
        <i class="fas fa-lock" style="color:var(--parent-success);"></i>
        <p style="margin:0;font-size:12px;color:#2d6a4f;">
            محتوى الأسئلة والإجابات محمي ولا يظهر لولي الأمر. النتيجة المعروضة للمتابعة فقط.
        </p>
    </div>
</div>
