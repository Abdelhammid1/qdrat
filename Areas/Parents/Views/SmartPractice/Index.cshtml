@model List<ParentSmartPracticeDetailsViewModel>
@using QdratNew.ViewModels.Parents
@{
    ViewData["Title"] = "التدريب الذكي";
    var studentId = ViewBag.StudentId as int? ?? 0;
    var children = ViewBag.Children as List<ParentChildCardViewModel> ?? new();
    var sidStr = studentId > 0 ? studentId.ToString() : "";
}

<div class="mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
        <h2 style="font-size:18px;font-weight:800;color:var(--parent-primary);margin:0;">التدريب الذكي</h2>
        <p style="color:#6b7c93;font-size:13px;margin:4px 0 0;">
            تدريبات مخصصة — بدون كشف محتوى الاختبارات
        </p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        @if (children.Count > 1)
        {
            <form method="get"
                  asp-action="Index"
                  asp-controller="SmartPractice"
                  asp-area="Parents"
                  class="d-flex align-items-center gap-2">
                <label style="font-size:13px;color:#6b7c93;white-space:nowrap;">تابع:</label>
                <select name="studentId"
                        onchange="this.form.submit()"
                        style="border:1.5px solid #d0dcea;border-radius:8px;padding:6px 12px;font-family:var(--font-main);font-size:13px;background:#fff;color:var(--parent-primary);">
                    @foreach (var child in children)
                    {
                        <option value="@child.StudentId"
                                selected="@(child.StudentId == studentId)">
                            @child.StudentName
                        </option>
                    }
                </select>
            </form>
        }
        <a asp-area="Parents" asp-controller="SmartPractice" asp-action="Create"
           asp-route-studentId="@sidStr"
           class="btn-parent-primary" style="font-size:13px;">
            <i class="fas fa-plus"></i>
            طلب تدريب جديد
        </a>
    </div>
</div>

<!-- شرح النظام -->
<div class="parent-card mb-4" style="background:linear-gradient(135deg,#f0f7ff 0%,#e8f4fd 100%);border:1.5px solid #c6dff8;">
    <div class="d-flex align-items-start gap-3">
        <div style="width:44px;height:44px;border-radius:12px;background:var(--parent-accent);display:grid;place-items:center;flex-shrink:0;">
            <i class="fas fa-brain fa-lg" style="color:#fff;"></i>
        </div>
        <div>
            <p style="margin:0 0 4px;font-size:14px;font-weight:700;color:var(--parent-primary);">كيف يعمل التدريب الذكي؟</p>
            <p style="margin:0;font-size:13px;color:#3a6b9e;line-height:1.7;">
                يحلل النظام نقاط ضعف ابنك بشكل آمن ويصمم جلسة تدريب مخصصة. الهدف تعزيز المفاهيم وليس حفظ الاختبارات.
            </p>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="parent-card text-center py-5">
        <i class="fas fa-brain fa-3x mb-3" style="color:#c0ccd8;"></i>
        <p style="color:#7a8ba0;margin:0;font-size:14px;">لا توجد تدريبات سابقة.</p>
        <div class="mt-3">
            <a asp-area="Parents" asp-controller="SmartPractice" asp-action="Create"
               asp-route-studentId="@studentId"
               class="btn-parent-primary" style="font-size:13px;">
                <i class="fas fa-plus"></i>
                ابدأ تدريباً الآن
            </a>
        </div>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var req in Model)
        {
            <div class="parent-card">
                <div class="d-flex align-items-start justify-content-between gap-3">
                    <div class="flex-1">
                        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                            <span class="status-pill @req.StatusColor">@req.StatusLabel</span>
                            <span style="font-size:13px;font-weight:700;color:var(--parent-primary);">@req.PracticeModeLabel</span>
                            @if (children.Count > 1)
                            {
                                <span style="font-size:12px;color:#7a8ba0;background:#f0f3f7;border-radius:6px;padding:2px 8px;">
                                    <i class="fas fa-user-graduate me-1"></i>@req.StudentName
                                </span>
                            }
                        </div>
                        <p style="margin:0 0 4px;font-size:13px;color:#5a6a7e;">
                            @req.CreatedAt.ToString("dd/MM/yyyy HH:mm") •
                            @req.QuestionCount سؤال •
                            @req.DurationMinutes دقيقة
                        </p>
                        @if (!string.IsNullOrEmpty(req.SafeSummary))
                        {
                            <p style="margin:4px 0 0;font-size:12px;color:#7a8ba0;">@req.SafeSummary</p>
                        }
                        @if (req.HasResult && req.ResultScore.HasValue)
                        {
                            <div class="mt-2 d-flex align-items-center gap-2">
                                <span style="font-size:13px;font-weight:700;color:var(--parent-@(req.ResultScore >= 75 ? "success" : req.ResultScore >= 50 ? "warning" : "danger"));">
                                    @req.ResultScore.Value.ToString("0.0")%
                                </span>
                                <span style="font-size:11px;color:#7a8ba0;">نتيجة التدريب</span>
                            </div>
                        }
                    </div>
                    <a asp-area="Parents" asp-controller="SmartPractice" asp-action="Details"
                       asp-route-id="@req.RequestId"
                       class="btn-parent-outline" style="font-size:12px;flex-shrink:0;">
                        <i class="fas fa-eye"></i>
                        تفاصيل
                    </a>
                </div>
            </div>
        }
    </div>
}
