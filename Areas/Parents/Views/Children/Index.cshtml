@model List<ParentChildCardViewModel>
@{
    ViewData["Title"] = "أبنائي";
}

<div class="mb-4">
    <h2 style="font-size:18px;font-weight:800;color:var(--parent-primary);margin:0;">أبنائي المسجّلون</h2>
    <p style="color:#6b7c93;font-size:13px;margin:4px 0 0;">جميع الطلاب المرتبطون بحسابك</p>
</div>

@if (!Model.Any())
{
    <div class="parent-card text-center py-5">
        <i class="fas fa-user-slash fa-3x mb-3" style="color:#c0ccd8;"></i>
        <p style="color:#7a8ba0;margin:0;">لا يوجد طلاب مرتبطون بحسابك حالياً.</p>
        <p style="color:#aab6c4;font-size:12px;margin-top:6px;">تواصل مع المعهد لإتمام ربط حساب ابنك.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var child in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="parent-card h-100" style="position:relative;overflow:hidden;">
                    <!-- شريط لوني علوي -->
                    <div style="position:absolute;top:0;right:0;left:0;height:4px;background:linear-gradient(90deg,var(--parent-accent),var(--parent-primary));"></div>

                    <div class="d-flex align-items-center gap-3 mb-3 mt-1">
                        <div style="width:50px;height:50px;border-radius:50%;background:var(--parent-accent-light);display:grid;place-items:center;flex-shrink:0;">
                            <i class="fas fa-user-graduate" style="color:var(--parent-accent);font-size:20px;"></i>
                        </div>
                        <div>
                            <h3 style="font-size:15px;font-weight:800;color:var(--parent-primary);margin:0;">@child.StudentName</h3>
                            @if (!string.IsNullOrEmpty(child.Level))
                            {
                                <span style="font-size:12px;color:#6b7c93;">@child.Level</span>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(child.OverallStatus))
                    {
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="status-pill @child.StatusColor">@child.OverallStatus</span>
                        </div>
                    }

                    @if (child.CommitmentPercent.HasValue)
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span style="font-size:12px;color:#7a8ba0;">الالتزام</span>
                                <span style="font-size:12px;font-weight:700;color:var(--parent-primary);">@child.CommitmentPercent%</span>
                            </div>
                            <div class="progress-parent">
                                <div class="fill @(child.CommitmentPercent >= 75 ? "success" : child.CommitmentPercent >= 50 ? "warning" : "danger")"
                                     style="width:@child.CommitmentPercent%"></div>
                            </div>
                        </div>
                    }

                    <div class="d-flex gap-2 flex-wrap mt-auto">
                        <a asp-area="Parents" asp-controller="Dashboard" asp-action="Index"
                           asp-route-studentId="@child.StudentId"
                           class="btn-parent-primary" style="font-size:12px;flex:1;text-align:center;">
                            <i class="fas fa-tachometer-alt"></i>
                            لوحة المتابعة
                        </a>
                        <a asp-area="Parents" asp-controller="SmartPractice" asp-action="Create"
                           asp-route-studentId="@child.StudentId"
                           class="btn-parent-outline" style="font-size:12px;flex:1;text-align:center;">
                            <i class="fas fa-brain"></i>
                            تدريب ذكي
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
