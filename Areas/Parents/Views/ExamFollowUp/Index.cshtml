@model ParentExamFollowUpViewModel
@{
    ViewData["Title"] = "متابعة الاختبارات";
}

<div class="mb-4">
    <h2 style="font-size:18px;font-weight:800;color:var(--parent-primary);margin:0;">متابعة الاختبارات</h2>
    <p style="color:#6b7c93;font-size:13px;margin:4px 0 0;">@Model.StudentName</p>
</div>

<!-- ملخص -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-2 mb-1">
                <i class="fas @Model.TrendIcon @Model.TrendColor"></i>
                <span style="font-size:11px;color:#7a8ba0;font-weight:600;">اتجاه الأداء</span>
            </div>
            <div class="stat-value" style="font-size:17px;">@Model.PerformanceTrend</div>
        </div>
    </div>

    @if (Model.LastExamScore.HasValue)
    {
        <div class="col-6 col-md-3">
            <div class="stat-card @(Model.LastExamScore >= 60 ? "success" : "danger")">
                <div class="stat-value">@Model.LastExamScore.Value.ToString("0.0")%</div>
                <div class="stat-label">آخر اختبار</div>
            </div>
        </div>
    }

    @if (Model.HasUpcomingExam)
    {
        <div class="col-6 col-md-3">
            <div class="stat-card warning">
                <div class="stat-value" style="font-size:13px;">@Model.UpcomingExamDate</div>
                <div class="stat-label">اختبار قادم</div>
            </div>
        </div>
    }

    @if (Model.NeedsBoostPractice)
    {
        <div class="col-6 col-md-3">
            <div class="stat-card danger">
                <div class="stat-value" style="font-size:13px;">يحتاج دعم</div>
                <div class="stat-label">حالة التدريب</div>
            </div>
        </div>
    }
</div>

<!-- توصية آمنة -->
@if (!string.IsNullOrEmpty(Model.SafeRecommendation))
{
    <div class="action-box mb-4">
        <p class="action-title"><i class="fas fa-lightbulb me-1"></i> توصية النظام</p>
        <p class="action-text">@Model.SafeRecommendation</p>
        @if (Model.NeedsBoostPractice)
        {
            <a asp-area="Parents" asp-controller="SmartPractice" asp-action="Create"
               asp-route-studentId="@Model.StudentId"
               class="btn-parent-white" style="font-size:13px;">
                <i class="fas fa-brain"></i>
                ابدأ تدريباً داعماً
            </a>
        }
    </div>
}

<!-- نتائج الاختبارات الأخيرة -->
@if (!Model.RecentResults.Any())
{
    <div class="parent-card text-center py-5">
        <i class="fas fa-file-alt fa-3x mb-3" style="color:#c0ccd8;"></i>
        <p style="color:#7a8ba0;margin:0;">لا توجد نتائج اختبارات حديثة.</p>
    </div>
}
else
{
    <div class="parent-card">
        <div class="section-header mb-3">
            <div class="section-icon"><i class="fas fa-file-alt"></i></div>
            <h2>نتائج الاختبارات الأخيرة</h2>
        </div>
        <div class="d-flex flex-column gap-2">
            @foreach (var exam in Model.RecentResults)
            {
                var pct = (int)Math.Round(exam.Score);
                <div class="p-3 rounded-3" style="background:#f7f9fc;border:1px solid #e0e7ef;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div>
                            <div style="font-size:14px;font-weight:700;color:var(--parent-primary);">@exam.ExamTitle</div>
                            <div style="font-size:12px;color:#7a8ba0;">@exam.ExamDate</div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span style="font-size:18px;font-weight:900;" class="@exam.ScoreColor">@exam.Score.ToString("0.0")%</span>
                        </div>
                    </div>
                    <div class="progress-parent">
                        <div class="fill @(pct >= 75 ? "success" : pct >= 50 ? "warning" : "danger")"
                             style="width:@pct%"></div>
                    </div>
                </div>
            }
        </div>
    </div>
}
