@model QdratNew.Areas.Internal.QuestionBank.ViewModels.QuestionBankExplorerVM

@{
    ViewData["Title"] = "استكشاف بنك الأسئلة (نسخة داخلية)";
}

<!-- ===================== ICONS ===================== -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

<!-- ===================== STYLES ===================== -->
<style>
    .page-title {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 16px;
    }

    /* ---------- Status ---------- */
    .status-badge {
        font-size: 12px;
        padding: 5px 10px;
        border-radius: 20px;
        font-weight: 600;
        white-space: nowrap;
        display: inline-block;
    }

    .status-incomplete {
        background: #adb5bd;
        color: #fff;
    }

    .status-missing {
        background: #dc3545;
        color: #fff;
    }

    .status-ready {
        background: #0dcaf0;
        color: #000;
    }

    .status-approved {
        background: #198754;
        color: #fff;
    }

    /* ---------- Sidebar ---------- */
    .sidebar-card {
        border-radius: 10px;
    }

    /* ---------- Stats ---------- */
    .stat-card {
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 4px 10px rgba(0,0,0,.05);
    }

    .stat-title {
        font-size: 13px;
        color: #6c757d;
    }

    .stat-value {
        font-size: 24px;
        font-weight: 700;
    }

    .stat-icon {
        font-size: 28px;
        opacity: .7;
    }

    .stat-total {
        border-right: 5px solid #0d6efd;
    }

    .stat-incomplete {
        border-right: 5px solid #6c757d;
    }

    .stat-missing {
        border-right: 5px solid #dc3545;
    }

    .stat-approved {
        border-right: 5px solid #198754;
    }

    /* ---------- Table ---------- */
    table td {
        vertical-align: middle;
        white-space: nowrap;
    }

    table th {
        font-size: 13px;
        white-space: nowrap;
    }


    .question-bank-table thead th {
        font-size: 13px;
        font-weight: 700;
        color: #339999;
        white-space: nowrap;
    }

    .question-bank-table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .question-title-cell {
        max-width: 520px;
    }

    .question-title-content {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        font-size: 14px;
    }

    .question-actions {
        margin-top: 6px;
    }

        .question-actions button {
            padding: 2px 8px;
            font-size: 12px;
        }
    /* ================== TABLE LAYOUT FIX ================== */

    /* لا نكسر كل الأعمدة */
    .question-bank-table td,
    .question-bank-table th {
        white-space: normal;
        vertical-align: middle;
    }

    /* عمود السؤال */
    .question-title-cell {
        max-width: 420px;
    }

    .question-title-content {
        font-size: 14px;
        line-height: 1.6;
        color: #212529;
    }

    /* عمود الملاحظة الداخلية */
    .internal-note-cell {
        max-width: 220px;
        font-size: 12px;
        color: #6c757d;
        line-height: 1.4;
    }

    /* عمود الإجراءات */
    .actions-cell {
        text-align: center;
        white-space: nowrap;
    }

        .actions-cell .btn {
            padding: 4px 6px;
            font-size: 12px;
        }

    /* تحسين الهيدر */
    .question-bank-table thead th {
        background: #f8f9fa;
        border-bottom: 2px solid #dee2e6;
    }

    .rtl-text {
        direction: rtl;
        text-align: right;
    }

    .ltr-text {
        direction: ltr;
        text-align: left;
    }


    .question-bank-table {
        overflow: visible;
    }

</style>

<div class="container-fluid">
    <div class="row">

        <!-- ===================== SIDEBAR ===================== -->
        <aside class="col-lg-3 col-md-3 mb-3">

            <a href="/Admin/Questions/Create"
               target="_blank"
               class="col-md-12 btn" style="color:#339999;">

                <i class="bi bi-plus-circle me-1"></i>
                إضافة سؤال جديد
            </a>
          
            <hr />



            <hr />
            <div class="card sidebar-card shadow-sm">

             

                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-funnel me-1"></i>
                    الفلاتر
                </div>

                <div class="card-body">
                    <form id="filtersForm" class="d-grid gap-3">

                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-journal-text"></i></span>
                            <select id="curriculumSelect" class="form-select">
                                <option value="">اختر المنهج</option>
                                @foreach (var c in Model.Curriculums)
                                {
                                    <option value="@c.Value">@c.Text</option>
                                }
                            </select>
                        </div>

                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-diagram-3"></i></span>
                            <select id="sectionSelect" class="form-select"></select>
                            
                        </div>


                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-book"></i></span>
                            <select id="lessonSelect" class="form-select">
                                <option value="">اختر الدرس</option>
                            </select>
                        </div>

                        <button type="button" id="applyFiltersBtn" class="btn btn-primary w-100">
                            <i class="bi bi-search me-1"></i>
                            تحميل البيانات
                        </button>
                    </form>
                </div>
            </div>
            <hr />
            <!-- ===================== INSIGHTS ===================== -->
            <div class="row g-3">

                <div class="col-md-12">
                    <div class="card shadow-sm">
                        <div class="card-header fw-bold">📊 الحالة العامة لبنك الأسئلة</div>
                        <div class="card-body">
                            <canvas id="overallStatusChart"></canvas>
                        </div>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="card shadow-sm">
                        <div class="card-header fw-bold">🧪 جودة الأسئلة والمراجعة</div>
                        <div class="card-body">
                            <canvas id="qualityChart"></canvas>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-header fw-bold">📚 تغطية المناهج</div>
                        <div class="card-body">
                            <canvas id="coverageChart"></canvas>
                        </div>
                    </div>
                </div>

            </div>


        </aside>

        <!-- ===================== MAIN ===================== -->
        <section class="col-lg-9 col-md-9">

           

            <!-- ===== Stats ===== -->
            <div class="row g-3 mb-4">

                <div class="col-lg-3 col-6">
                    <div class="stat-card stat-total p-3 d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-title">إجمالي</div>
                            <div class="stat-value">@Model.Stats.TotalQuestions</div>
                        </div>
                        <i class="bi bi-collection stat-icon"></i>
                    </div>
                </div>

                <div class="col-lg-3 col-6">
                    <div class="stat-card stat-incomplete p-3 d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-title">غير مكتملة</div>
                            <div class="stat-value">@Model.Stats.IncompleteCount</div>
                        </div>
                        <i class="bi bi-pencil-square stat-icon"></i>
                    </div>
                </div>

                <div class="col-lg-3 col-6">
                    <div class="stat-card stat-missing p-3 d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-title">بدون إجابة</div>
                            <div class="stat-value">@Model.Stats.MissingAnswerCount</div>
                        </div>
                        <i class="bi bi-x-circle stat-icon"></i>
                    </div>
                </div>

                <div class="col-lg-3 col-6">
                    <div class="stat-card stat-approved p-3 d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-title">معتمدة</div>
                            <div class="stat-value">@Model.Stats.ApprovedCount</div>
                        </div>
                        <i class="bi bi-check-circle stat-icon"></i>
                    </div>
                </div>

            </div>


            <div class="d-flex justify-content-between align-items-center mb-3">

                <div class="page-title mb-0">
                    <i class="bi bi-table me-1"></i>
                    قائمة الأسئلة
                </div>

                <div class="col-md-6 page-title mb-0">
                <input type="text"
                       id="searchInput"
                       class="form-control p-2"
                       placeholder="ابحث في بنك الأسئلة..." />


</div>

            </div>



            <!-- ===== Table ===== -->
            <div class="card shadow-sm border-0">

                <div class="table-responsive">
                    <table class="table table-hover bg-qdrat align-middle mb-0 question-bank-table">
                        <thead class="table-light">
                            <tr>
                                <th style="width:90px" class="text-center">#</th>

                                <th style="width:70px" class="text-center">👁</th>
                                <th>السؤال</th>
                                <th style="width:100px">المنهج</th>
                                <th style="width:150px">المحور</th>
                                <th style="width:150px">الدرس</th>

                                <th style="width:120px">
                                    <div class="d-flex flex-column gap-1">
                                        <span>الحالة</span>
                                        <select id="statusFilter" class="form-select form-select-sm">
                                            <option value="">الكل</option>
                                            <option value="Approved">معتمد</option>
                                            <option value="ReadyForReview">جاهز للمراجعة</option>
                                            <option value="MissingAnswer">بدون إجابة</option>
                                            <option value="Incomplete">غير مكتمل</option>
                                        </select>
                                    </div>
                                </th>

                                <th style="width:100px">التاريخ</th>
                                <th style="width:70px">ملاحظة داخلية</th>
                                <th style="width:70px" class="text-center">إجراءات</th>
                            </tr>
                        </thead>

                        <tbody id="questionsTableBody">
                            <!-- Loaded via Fetch -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ===== Pager ===== -->
            <div class="d-flex justify-content-between align-items-center mt-3">
                <div id="pagingInfo" class="text-muted small"></div>
                <div class="btn-group">
                    <button id="prevPageBtn" class="btn btn-outline-secondary btn-sm">السابق</button>
                    <button id="nextPageBtn" class="btn btn-outline-secondary btn-sm">التالي</button>
                </div>
            </div>

        </section>
    </div>
</div>




<div class="modal fade" id="questionPreviewModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" id="questionPreviewWrapper">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-eye me-1"></i>
                    معاينة السؤال
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="questionPreviewBody">
                <div class="text-center text-muted py-5">
                    جاري التحميل...
                </div>
            </div>
        </div>
    </div>
</div>






<div class="modal fade" id="auditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-scrollable">
        <div class="modal-content text-end">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title"><i class="fas fa-history"></i> آخر التعديلات</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="auditModalBody"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="labelsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-scrollable">
        <div class="modal-content text-end">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-tags"></i> التصنيفات</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="labelsModalBody"></div>
        </div>
    </div>
</div>


<div class="modal fade" id="similarModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title"><i class="fas fa-copy"></i> الأسئلة المتشابهة</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="similarResults" class="list-group"></div>
            </div>
        </div>
    </div>
</div>





<!-- ===================== SCRIPTS ===================== -->
@section Scripts {


    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>




    <script>
        function stripHtmlAndLimit(text, maxLength) {
            const div = document.createElement("div");
            div.innerHTML = text;
            const plainText = div.textContent || div.innerText || "";

            if (plainText.length <= maxLength)
                return plainText;

            return plainText.substring(0, maxLength) + "…";
        }
    </script>


    <script>
        async function loadInsights() {

            const curriculumId = document.getElementById("curriculumSelect")?.value || "";
            const sectionId = document.getElementById("sectionSelect")?.value || "";
            const lessonId = document.getElementById("lessonSelect")?.value || "";

            const res = await fetch(
                `/internal/question-bank/insights?curriculumId=${curriculumId}&sectionId=${sectionId}&lessonId=${lessonId}`
            );

            if (!res.ok) {
                console.error("Insights API failed");
                return;
            }

            const data = await res.json();

            /* ================= Chart 1: Overall Status ================= */
            const overallEl = document.getElementById("overallStatusChart");
            if (overallEl) {
                new Chart(overallEl, {
                    type: "doughnut",
                    data: {
                        labels: ["معتمد", "جاهز للمراجعة", "بدون إجابة", "غير مكتمل"],
                        datasets: [{
                            data: [
                                data.OverallStatus.Approved,
                                data.OverallStatus.ReadyForReview,
                                data.OverallStatus.MissingAnswer,
                                data.OverallStatus.Incomplete
                            ],
                            backgroundColor: ["#339999", "#da784d", "#787878", "#adb5bd"]
                        }]
                    }
                });
            }

            /* ================= Chart 2: Quality ================= */
            const qualityEl = document.getElementById("qualityChart");
            if (qualityEl) {
                new Chart(qualityEl, {
                    type: "bar",
                    data: {
                        labels: ["مكتملة", "تمت مراجعتها", "بإجابة صحيحة"],
                        datasets: [{
                            data: [
                                data.Quality.Complete,
                                data.Quality.Reviewed,
                                data.Quality.WithCorrectAnswer
                            ],
                            backgroundColor: "#da784d"
                        }]
                    }
                });
            }

            /* ================= Chart 3: Coverage ================= */
            const coverageEl = document.getElementById("coverageChart");
            if (coverageEl) {
                new Chart(coverageEl, {
                    type: "bar",
                    data: {
                        labels: data.CurriculumCoverage.map(x => x.Name),
                        datasets: [{
                            data: data.CurriculumCoverage.map(x => x.Count),
                            backgroundColor: "#339999"
                        }]
                    }
                });
            }
        }

        document.addEventListener("DOMContentLoaded", loadInsights);
    </script>



    <script>
        document.addEventListener("DOMContentLoaded", function () {

            let currentPage = 1;
            const pageSize = 50;

            const curriculumSelect = document.getElementById("curriculumSelect");
            const sectionSelect = document.getElementById("sectionSelect");
            const lessonSelect = document.getElementById("lessonSelect");
            const statusFilter = document.getElementById("statusFilter");
            const searchInput = document.getElementById("searchInput");

            const tableBody = document.getElementById("questionsTableBody");
            const pagingInfo = document.getElementById("pagingInfo");
            const prevBtn = document.getElementById("prevPageBtn");
            const nextBtn = document.getElementById("nextPageBtn");
            const applyBtn = document.getElementById("applyFiltersBtn");

            function safe(v, fallback = "-") {
                return v === null || v === undefined || v === "" ? fallback : v;
            }

            function renderStatus(status) {
                switch (status) {
                    case "Approved":
                        return `<span class="status-badge status-approved">معتمد</span>`;
                    case "MissingAnswer":
                        return `<span class="status-badge status-missing">بدون إجابة</span>`;
                    case "ReadyForReview":
                        return `<span class="status-badge status-ready">جاهز للمراجعة</span>`;
                    default:
                        return `<span class="status-badge status-incomplete">غير مكتمل</span>`;
                }
            }

            function getFilters() {
                return {
                    curriculumId: curriculumSelect.value || "",
                    sectionId: sectionSelect.value || "",
                    lessonId: lessonSelect.value || "",
                    searchText: searchInput.value || "",
                    status: statusFilter.value || ""
                };
            }


                    function loadPage(page) {
            currentPage = page;
            const f = getFilters();

            const url =
                `/Internal/QuestionBankExplorer/LoadPage` +
                `?curriculumId=${f.curriculumId}` +
                `&sectionId=${f.sectionId}` +
                `&lessonId=${f.lessonId}` +
                `&searchText=${encodeURIComponent(f.searchText)}` +
                `&status=${f.status}` +
                `&page=${page}` +
                `&pageSize=${pageSize}`;

            fetch(url)
                .then(r => r.ok ? r.json() : null)
                .then(d => {

                    tableBody.innerHTML = "";

                    if (!d || !d.Items || d.Items.length === 0) {
                        tableBody.innerHTML = `
                            <tr>
                                <td colspan="10" class="text-center text-muted">
                                    لا توجد بيانات
                                </td>
                            </tr>`;
                        pagingInfo.innerText = "";
                        prevBtn.disabled = true;
                        nextBtn.disabled = true;
                        return;
                    }

                    // 🔢 الرقم التسلسلي – نفس منطق البنك القديم
                    let rowIndex = ((currentPage - 1) * pageSize) + 1;

                           d.Items.forEach(q => {
            tableBody.insertAdjacentHTML("beforeend", `
        <tr>
            <!-- الرقم المرجعي الحقيقي -->
            <td class="text-center fw-bold text-primary">
                ${q.ReferenceNumber ?? "—"}
            </td>

            <td class="text-center">
                <button class="btn btn-outline-primary btn-sm preview-btn"
                        data-id="${q.Id}">
                    <i class="bi bi-eye"></i>
                </button>
            </td>

            <td class="question-title-cell">
        <div class="question-title-content ${q.IsRTL ? 'rtl-text' : 'ltr-text'}">
                    ${stripHtmlAndLimit(safe(q.Title), 50)}
                </div>
            </td>

            <td>${safe(q.CurriculumTitle)}</td>
            <td>${safe(q.SectionTitle)}</td>
            <td>${safe(q.LessonTitle)}</td>

            <td>${renderStatus(q.Status)}</td>

            <td class="text-muted small">
                ${q.CreatedAt ? q.CreatedAt.substring(0, 10) : "-"}
            </td>

        <td class="internal-note-cell ${q.IsRTL ? 'rtl-text' : 'ltr-text'}">
        ${stripHtmlAndLimit(safe(q.InternalNote, "—"), 60)}
            </td>

            <td class="text-center actions-cell">
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-primary dropdown-toggle"
                            type="button"
                            data-bs-toggle="dropdown">
                        إجراءات
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end text-end">
                        <li>
                            <a class="dropdown-item" href="/Admin/Questions/Edit/${q.Id}" target="_blank">
                                ✏️ تعديل
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="/Admin/Questions/Display/${q.Id}" target="_blank">
                                🪪 كارت السؤال
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="/Admin/Questions/Details/${q.Id}">
                                📄 التفاصيل
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" href="/Admin/Questions/Audit/${q.Id}">
                                🕘 آخر التعديلات
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="/Admin/Questions/Labels/${q.Id}">
                                🏷️ التصنيفات
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item text-danger" href="/Admin/Questions/Delete/${q.Id}">
                                🗑️ حذف
                            </a>
                        </li>
                    </ul>
                </div>
            </td>
        </tr>
                        `);

                        rowIndex++;
                    });

                    // إعادة تهيئة Dropdown
                    tableBody
                        .querySelectorAll('[data-bs-toggle="dropdown"]')
                        .forEach(el => new bootstrap.Dropdown(el));

                    const start = ((currentPage - 1) * pageSize) + 1;
                    const end = Math.min(currentPage * pageSize, d.TotalCount);

                    pagingInfo.innerText = `عرض ${start} إلى ${end} من ${d.TotalCount}`;
                    prevBtn.disabled = currentPage === 1;
                    nextBtn.disabled = end >= d.TotalCount;
                })
                .catch(() => {
                    tableBody.innerHTML = `
                        <tr>
                            <td colspan="10" class="text-center text-danger">
                                خطأ أثناء تحميل البيانات
                            </td>
                        </tr>`;
                });
        }



                if (applyBtn) {
            applyBtn.addEventListener("click", () => loadPage(1));
        }

        if (prevBtn) {
            prevBtn.addEventListener("click", () => {
                if (currentPage > 1) {
                    loadPage(currentPage - 1);
                }
            });
        }

        if (nextBtn) {
            nextBtn.addEventListener("click", () => {
                loadPage(currentPage + 1);
            });
        }

            let searchTimeout;
            searchInput.addEventListener("input", () => {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => loadPage(1), 400);
            });

            statusFilter.addEventListener("change", () => loadPage(1));

            loadPage(1);
        });
    </script>



   
    
    
    <script>
                        function previewQuestion(questionId) {
            const modal = new bootstrap.Modal(
                document.getElementById("questionPreviewModal")
            );

            const body = document.getElementById("questionPreviewBody");
            const wrapper = document.getElementById("questionPreviewWrapper");

            body.innerHTML = `<div class="text-center text-muted py-5">جاري التحميل...</div>`;

            fetch(`/Admin/Questions/Preview?id=${questionId}`, {
                credentials: "same-origin"
            })
            .then(async r => {
                const html = await r.text();

                // ✅ اقرأ الاتجاه من البارشال نفسه (بدون Header)
                const isRTL = html.includes('dir="rtl"');

                // ✅ فرض الاتجاه على المودال بالكامل
                wrapper.style.direction = isRTL ? "rtl" : "ltr";
                wrapper.style.textAlign = isRTL ? "right" : "left";

                // ✅ عرض المحتوى كما هو
                body.innerHTML = html;

                modal.show();
            })
            .catch(() => {
                body.innerHTML = `<div class="text-danger text-center">فشل تحميل المعاينة</div>`;
            });
        }

    </script>


    <script>
        document.addEventListener("click", function (e) {
            const btn = e.target.closest(".preview-btn");
            if (!btn) return;

            e.preventDefault();

            const questionId = btn.getAttribute("data-id");
            if (!questionId) return;

            previewQuestion(questionId);
        });
    </script>


    <script>
document.addEventListener("DOMContentLoaded", function () {

    const curriculumSelect = document.getElementById("curriculumSelect");
    const sectionSelect = document.getElementById("sectionSelect");
    const lessonSelect = document.getElementById("lessonSelect");

    // ===== تحميل المحاور عند اختيار المنهج =====
            if (curriculumSelect) {
            curriculumSelect.addEventListener("change", async function () {
                const curriculumId = this.value;

                sectionSelect.innerHTML = `<option value="">جارٍ تحميل المحاور...</option>`;
                lessonSelect.innerHTML = `<option value="">اختر الدرس</option>`;

                if (!curriculumId) {
                    sectionSelect.innerHTML = `<option value="">اختر المحور</option>`;
                    return;
                }

                const res = await fetch(
                    `/Admin/Questions/GetSectionsByCurriculum?curriculumId=${curriculumId}`
                );

                if (!res.ok) {
                    sectionSelect.innerHTML = `<option value="">فشل تحميل المحاور</option>`;
                    return;
                }

                const data = await res.json();

                sectionSelect.innerHTML = `<option value="">اختر المحور</option>`;
                data.forEach(x => {
                    sectionSelect.insertAdjacentHTML(
                        "beforeend",
                        `<option value="${x.id}">${x.title}</option>`
                    );
                });
            });
        }


    // ===== تحميل الدروس عند اختيار المحور =====
            if (sectionSelect) {
            sectionSelect.addEventListener("change", async function () {
                const sectionId = this.value;

                lessonSelect.innerHTML = `<option value="">جارٍ تحميل الدروس...</option>`;

                if (!sectionId) {
                    lessonSelect.innerHTML = `<option value="">اختر الدرس</option>`;
                    return;
                }

                const res = await fetch(
                    `/Admin/Questions/GetLessonsBySection?sectionId=${sectionId}`
                );

                if (!res.ok) {
                    lessonSelect.innerHTML = `<option value="">فشل تحميل الدروس</option>`;
                    return;
                }

                const data = await res.json();

                lessonSelect.innerHTML = `<option value="">اختر الدرس</option>`;
                data.forEach(x => {
                    lessonSelect.insertAdjacentHTML(
                        "beforeend",
                        `<option value="${x.id}">${x.title}</option>`
                    );
                });
            });
        }


});
</script>


    <script>
        document.addEventListener("click", function (e) {
            const btn = e.target.closest(".action-btn");
            if (!btn) return;

            const questionId = btn.getAttribute("data-id");

            const modalEl = document.getElementById("questionActionsModal");
            const modal = new bootstrap.Modal(modalEl);
            const body = document.getElementById("questionActionsBody");

            body.innerHTML = `<div class="text-center text-muted py-4">جاري التحميل...</div>`;

            fetch(`/Admin/Questions/Actions?questionId=${questionId}`, {
                credentials: "same-origin"
            })
                .then(r => {
                    if (!r.ok) throw new Error();
                    return r.text();
                })
                .then(html => {
                    body.innerHTML = html;
                    modal.show();
                })
                .catch(() => {
                    body.innerHTML = `<div class="text-danger text-center">فشل تحميل الإجراءات</div>`;
                });
        });
    </script>

    <script>
        function openAuditModal(id) {
            fetch(`/Admin/Questions/Audit/${id}`)
                .then(response => {
                    if (!response.ok) throw new Error();
                    return response.text();
                })
                .then(html => {
                    document.getElementById('auditModalBody').innerHTML = html;
                    new bootstrap.Modal(document.getElementById('auditModal')).show();
                })
                .catch(() => {
