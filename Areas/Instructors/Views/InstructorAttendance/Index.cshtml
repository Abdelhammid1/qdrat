@model QdratNew.ViewModels.Instructor.Attendance.InstructorAttendanceIndexVM

@{
    ViewData["Title"] = "دفعات الحضور والانصراف";
}

<div class="container-fluid py-4" dir="rtl">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h3 class="fw-bold mb-1">الحضور والانصراف</h3>
            <div class="text-muted">
                اختر الدفعة أولًا، ثم انتقل إلى محاضراتها لتسجيل الحضور والانصراف.
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">دفعات المدرب</div>
                    <div class="fs-3 fw-bold">@Model.TotalBatches</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">إجمالي المحاضرات</div>
                    <div class="fs-3 fw-bold">@Model.TotalLectures</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">محاضرات اليوم</div>
                    <div class="fs-3 fw-bold text-warning">@Model.TodayLectures</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">محاضرات لم تسجل</div>
                    <div class="fs-3 fw-bold text-danger">@Model.PendingAttendanceLectures</div>
                </div>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">دفعاتك المسجلة في المحاضرات</h5>
            <span class="badge bg-light text-dark">@Model.BatchCards.Count دفعة</span>
        </div>

        <div class="card-body">

            @if (!Model.BatchCards.Any())
            {
                <div class="text-center py-5 text-muted">
                    لا توجد دفعات مرتبطة بمحاضرات مسجلة لك حتى الآن.
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var batch in Model.BatchCards)
                    {
                        <div class="col-xl-4 col-lg-6">
                            <div class="card h-100 border rounded-4 shadow-sm batch-card">
                                <div class="card-body">

                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <h5 class="fw-bold mb-1">@batch.BatchName</h5>
                                            <div class="text-muted small">@batch.CourseTitle</div>
                                        </div>

                                        <span class="badge bg-primary">@batch.TotalStudents طالب</span>
                                    </div>

                                    <div class="row g-2 text-center mb-3">
                                        <div class="col-4">
                                            <div class="p-2 bg-light rounded-3">
                                                <div class="fw-bold">@batch.TotalLectures</div>
                                                <div class="text-muted small">محاضرة</div>
                                            </div>
                                        </div>

                                        <div class="col-4">
                                            <div class="p-2 bg-light rounded-3">
                                                <div class="fw-bold text-success">@batch.RecordedLectures</div>
                                                <div class="text-muted small">مسجلة</div>
                                            </div>
                                        </div>

                                        <div class="col-4">
                                            <div class="p-2 bg-light rounded-3">
                                                <div class="fw-bold text-danger">@batch.PendingLectures</div>
                                                <div class="text-muted small">متبقية</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between small mb-1">
                                            <span class="text-muted">متوسط الحضور</span>
                                            <span class="fw-bold">@batch.AttendancePercentage%</span>
                                        </div>

                                        <div class="progress" style="height: 8px;">
                                            <div class="progress-bar"
                                                 role="progressbar"
                                                 style="width:@batch.AttendancePercentage%">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between text-muted small mb-3">
                                        <span>تأخير: @batch.LateArrivalCount</span>
                                        <span>إذن مبكر: @batch.EarlyLeavePermissionCount</span>
                                    </div>

                                    <a asp-area="Instructors"
                                       asp-controller="InstructorAttendance"
                                       asp-action="Lectures"
                                       asp-route-batchId="@batch.BatchId"
                                       class="btn btn-primary w-100">
                                        فتح محاضرات الدفعة
                                    </a>

                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

        </div>
    </div>

</div>

<style>
    .batch-card {
        transition: transform .15s ease, box-shadow .15s ease;
    }

        .batch-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(0,0,0,.08) !important;
        }
</style>