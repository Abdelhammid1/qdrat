@model QdratNew.ViewModels.Instructor.Attendance.MarkInstructorAttendanceVM

@{
    ViewData["Title"] = "تسجيل حضور وانصراف";
}

<div class="container-fluid py-4" dir="rtl">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h3 class="fw-bold mb-1">تسجيل حضور وانصراف</h3>
            <div class="text-muted">
                @Model.LectureTitle -
                @Model.BatchName -
                @Model.LectureDate.ToString("yyyy/MM/dd")
            </div>
        </div>

        <a asp-area="Instructors"
           asp-controller="InstructorAttendance"
           asp-action="Lectures"
           class="btn btn-outline-secondary">
            رجوع للمحاضرات
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-3">
                    <div class="text-muted small">الدفعة</div>
                    <div class="fw-bold">@Model.BatchName</div>
                </div>

                <div class="col-md-3">
                    <div class="text-muted small">الدورة / المنهج</div>
                    <div class="fw-bold">@Model.CourseTitle</div>
                </div>

                <div class="col-md-3">
                    <div class="text-muted small">المحور</div>
                    <div class="fw-bold">@Model.SectionTitle</div>
                </div>

                <div class="col-md-3">
                    <div class="text-muted small">المكان</div>
                    <div class="fw-bold">@(string.IsNullOrWhiteSpace(Model.Location) ? "—" : Model.Location)</div>
                </div>

                <div class="col-md-3">
                    <div class="text-muted small">عدد الطلاب</div>
                    <div class="fw-bold">@Model.Students.Count</div>
                </div>

            </div>
        </div>
    </div>

    <form asp-area="Instructors"
          asp-controller="InstructorAttendance"
          asp-action="Record"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="LectureId" />
        <input type="hidden" asp-for="BatchId" />
        <input type="hidden" asp-for="LectureTitle" />
        <input type="hidden" asp-for="BatchName" />
        <input type="hidden" asp-for="CourseTitle" />
        <input type="hidden" asp-for="SectionTitle" />
        <input type="hidden" asp-for="Location" />
        <input type="hidden" asp-for="LectureDate" />

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="fw-bold mb-0">طلاب الدفعة</h5>

                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-success" onclick="markAllPresent()">
                        تحديد الكل حاضر
                    </button>

                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearAllAttendance()">
                        إلغاء تحديد الكل
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle text-center mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>الطالب</th>
                            <th>الهوية</th>
                            <th>الجوال</th>
                            <th>حاضر</th>
                            <th>متأخر</th>
                            <th>إذن انصراف مبكر</th>
                            <th>وقت الحضور</th>
                            <th>وقت الانصراف</th>
                            <th>ملاحظات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (!Model.Students.Any())
                        {
                            <tr>
                                <td colspan="9" class="py-5 text-muted">
                                    لا يوجد طلاب في دفعة هذه المحاضرة.
                                </td>
                            </tr>
                        }
                        else
                        {
                            for (int i = 0; i < Model.Students.Count; i++)
                            {
                                <tr>
                                    <td class="text-start">
                                        <input type="hidden" asp-for="Students[i].StudentId" />
                                        <input type="hidden" asp-for="Students[i].StudentName" />
                                        <input type="hidden" asp-for="Students[i].NationalId" />
                                        <input type="hidden" asp-for="Students[i].PhoneNumber" />
                                        <input type="hidden" asp-for="Students[i].BranchName" />

                                        <div class="fw-bold">@Model.Students[i].StudentName</div>

                                        @if (!string.IsNullOrWhiteSpace(Model.Students[i].BranchName))
                                        {
                                            <div class="text-muted small">@Model.Students[i].BranchName</div>
                                        }
                                    </td>

                                    <td>@Model.Students[i].NationalId</td>
                                    <td>@(string.IsNullOrWhiteSpace(Model.Students[i].PhoneNumber) ? "—" : Model.Students[i].PhoneNumber)</td>

                                    <td>
                                        <div class="form-check d-flex justify-content-center">
                                            <input asp-for="Students[i].IsPresent"
                                                   class="form-check-input student-present"
                                                   onchange="syncAttendanceRow(this)" />
                                        </div>
                                    </td>

                                    <td>
                                        <div class="form-check d-flex justify-content-center">
                                            <input asp-for="Students[i].IsLateArrival"
                                                   class="form-check-input student-late" />
                                        </div>
                                    </td>

                                    <td>
                                        <div class="form-check d-flex justify-content-center">
                                            <input asp-for="Students[i].HasEarlyLeavePermission"
                                                   class="form-check-input student-early" />
                                        </div>
                                    </td>

                                    <td style="min-width:130px;">
                                        <input asp-for="Students[i].ActualArrivalTime"
                                               type="time"
                                               class="form-control form-control-sm" />
                                    </td>

                                    <td style="min-width:130px;">
                                        <input asp-for="Students[i].ActualDepartureTime"
                                               type="time"
                                               class="form-control form-control-sm" />
                                    </td>

                                    <td style="min-width:240px;">
                                        <input asp-for="Students[i].Notes"
                                               class="form-control form-control-sm"
                                               placeholder="ملاحظة اختيارية" />
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between flex-wrap gap-2">
                <a asp-area="Instructors"
                   asp-controller="InstructorAttendance"
                   asp-action="Lectures"
                   class="btn btn-outline-secondary">
                    إلغاء
                </a>

                <button type="submit" class="btn btn-primary px-5">
                    حفظ الحضور والانصراف
                </button>
            </div>
        </div>
    </form>

</div>

@section Scripts {
    <script>
        function markAllPresent() {
            document.querySelectorAll('.student-present').forEach(function (el) {
                el.checked = true;
            });
        }

        function clearAllAttendance() {
            document.querySelectorAll('.student-present').forEach(function (el) {
                el.checked = false;
            });

            document.querySelectorAll('.student-late').forEach(function (el) {
                el.checked = false;
            });

            document.querySelectorAll('.student-early').forEach(function (el) {
                el.checked = false;
            });
        }

        function syncAttendanceRow(el) {
            if (!el.checked) {
                var row = el.closest('tr');
                if (!row) return;

                var late = row.querySelector('.student-late');
                var early = row.querySelector('.student-early');

                if (late) late.checked = false;
                if (early) early.checked = false;
            }
        }
    </script>
}