@model QdratNew.ViewModels.Instructor.Attendance.MarkInstructorAttendanceVM

@{
    ViewData["Title"] = "تقرير حضور المحاضرة";

    var total = Model.Students.Count;
    var present = Model.Students.Count(x => x.IsPresent);
    var absent = total - present;
    var late = Model.Students.Count(x => x.IsLateArrival);
    var early = Model.Students.Count(x => x.HasEarlyLeavePermission);
    var rate = total > 0 ? Math.Round((present * 100.0) / total, 1) : 0;
}

<div class="container-fluid py-4" dir="rtl">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h3 class="fw-bold mb-1">تقرير حضور المحاضرة</h3>
            <div class="text-muted">
                @Model.LectureTitle -
                @Model.BatchName -
                @Model.LectureDate.ToString("yyyy/MM/dd")
            </div>
        </div>

        <a asp-area="Instructors"
           asp-controller="InstructorAttendance"
           asp-action="Lectures"
           asp-route-batchId="@Model.BatchId"
           class="btn btn-outline-secondary">
            رجوع لمحاضرات الدفعة
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-3">
                    <div class="text-muted small">الدفعة</div>
                    <div class="fw-bold">@Model.BatchName</div>
                </div>

                <div class="col-md-3">
                    <div class="text-muted small">الدورة / المنهج</div>
                    <div class="fw-bold">@Model.CourseTitle</div>
                </div>

                <div class="col-md-3">
                    <div class="text-muted small">المحور</div>
                    <div class="fw-bold">@Model.SectionTitle</div>
                </div>

                <div class="col-md-3">
                    <div class="text-muted small">المكان</div>
                    <div class="fw-bold">@(string.IsNullOrWhiteSpace(Model.Location) ? "—" : Model.Location)</div>
                </div>

            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-2">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">الطلاب</div>
                    <div class="fs-3 fw-bold">@total</div>
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">حاضر</div>
                    <div class="fs-3 fw-bold text-success">@present</div>
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">غائب</div>
                    <div class="fs-3 fw-bold text-danger">@absent</div>
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">متأخر</div>
                    <div class="fs-3 fw-bold text-warning">@late</div>
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">إذن مبكر</div>
                    <div class="fs-3 fw-bold text-info">@early</div>
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">النسبة</div>
                    <div class="fs-3 fw-bold">@rate%</div>
                </div>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">تفاصيل الطلاب</h5>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print()">
                طباعة
            </button>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle text-center mb-0">
                <thead class="table-light">
                    <tr>
                        <th>الطالب</th>
                        <th>الهوية</th>
                        <th>الجوال</th>
                        <th>حاضر</th>
                        <th>متأخر</th>
                        <th>إذن مبكر</th>
                        <th>وقت الحضور</th>
                        <th>وقت الانصراف</th>
                        <th>ملاحظات</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Students.Any())
                    {
                        <tr>
                            <td colspan="9" class="py-5 text-muted">
                                لا توجد بيانات حضور لهذه المحاضرة.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Students)
                        {
                            <tr>
                                <td class="text-start">
                                    <div class="fw-bold">@item.StudentName</div>

                                    @if (!string.IsNullOrWhiteSpace(item.BranchName))
                                    {
                                        <div class="text-muted small">@item.BranchName</div>
                                    }
                                </td>

                                <td>@item.NationalId</td>
                                <td>@(string.IsNullOrWhiteSpace(item.PhoneNumber) ? "—" : item.PhoneNumber)</td>

                                <td>
                                    @if (item.IsPresent)
                                    {
                                        <span class="badge bg-success">حاضر</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">غائب</span>
                                    }
                                </td>

                                <td>
                                    @if (item.IsLateArrival)
                                    {
                                        <span class="badge bg-warning text-dark">متأخر</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @if (item.HasEarlyLeavePermission)
                                    {
                                        <span class="badge bg-info text-dark">بإذن</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>@(item.ActualArrivalTime.HasValue? item.ActualArrivalTime.Value.ToString(@"hh\:mm") : "—")</td>
                                <td>@(item.ActualDepartureTime.HasValue? item.ActualDepartureTime.Value.ToString(@"hh\:mm") : "—")</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Notes) ? "—" : item.Notes)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<style>
    @@media print {
        .btn,
        .navbar,
        .sidebar,
        aside {
            display: none !important;
        }

        .card {
            box-shadow: none !important;
            border: 1px solid #ddd !important;
        }

        body {
            background: #fff !important;
        }
    }
</style>