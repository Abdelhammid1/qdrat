@model QdratNew.ViewModels.Instructor.Attendance.InstructorBatchLecturesVM

@{
    ViewData["Title"] = "محاضرات الدفعة";
}

<div class="container-fluid py-4" dir="rtl">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h3 class="fw-bold mb-1">محاضرات الدفعة</h3>
            <div class="text-muted">
                @Model.BatchName - @Model.CourseTitle
            </div>
        </div>

        <a asp-area="Instructors"
           asp-controller="InstructorAttendance"
           asp-action="Index"
           class="btn btn-outline-secondary">
            رجوع للدفعات
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">طلاب الدفعة</div>
                    <div class="fs-3 fw-bold">@Model.TotalStudents</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">محاضرات الدفعة</div>
                    <div class="fs-3 fw-bold">@Model.TotalLectures</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">تم تسجيلها</div>
                    <div class="fs-3 fw-bold text-success">@Model.CompletedAttendanceLectures</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">لم تسجل بعد</div>
                    <div class="fs-3 fw-bold text-danger">@Model.PendingAttendanceLectures</div>
                </div>
            </div>
        </div>

    </div>

    <form method="get"
          asp-area="Instructors"
          asp-controller="InstructorAttendance"
          asp-action="Lectures"
          class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">
            <input type="hidden" name="batchId" value="@Model.BatchId" />

            <div class="row g-3 align-items-end">

                <div class="col-md-4">
                    <label class="form-label">من تاريخ</label>
                    <input type="date"
                           name="dateFrom"
                           class="form-control"
                           value="@(Model.DateFrom.HasValue? Model.DateFrom.Value.ToString("yyyy-MM-dd") : "")" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">إلى تاريخ</label>
                    <input type="date"
                           name="dateTo"
                           class="form-control"
                           value="@(Model.DateTo.HasValue? Model.DateTo.Value.ToString("yyyy-MM-dd") : "")" />
                </div>

                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        تصفية
                    </button>

                    <a asp-area="Instructors"
                       asp-controller="InstructorAttendance"
                       asp-action="Lectures"
                       asp-route-batchId="@Model.BatchId"
                       class="btn btn-outline-secondary w-100">
                        إلغاء
                    </a>
                </div>

            </div>
        </div>
    </form>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">محاضرات @Model.BatchName</h5>
            <span class="badge bg-light text-dark">@Model.Lectures.Count محاضرة</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle text-center mb-0">
                <thead class="table-light">
                    <tr>
                        <th>المحاضرة</th>
                        <th>التاريخ</th>
                        <th>المحور</th>
                        <th>المكان</th>
                        <th>الطلاب</th>
                        <th>الحضور</th>
                        <th>الغياب</th>
                        <th>تأخير</th>
                        <th>إذن مبكر</th>
                        <th>الحالة</th>
                        <th>الإجراء</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Lectures.Any())
                    {
                        <tr>
                            <td colspan="11" class="py-5 text-muted">
                                لا توجد محاضرات لهذه الدفعة حسب الفلتر الحالي.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Lectures)
                        {
                            <tr class="@(item.IsToday ? "table-warning" : "")">
                                <td class="text-start">
                                    <div class="fw-bold">@item.Title</div>
                                    @if (item.IsToday)
                                    {
                                        <span class="badge bg-warning text-dark">اليوم</span>
                                    }
                                </td>

                                <td>@item.Date.ToString("yyyy/MM/dd")</td>
                                <td>@item.SectionTitle</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Location) ? "—" : item.Location)</td>
                                <td>@item.TotalStudents</td>

                                <td>
                                    <span class="fw-bold text-success">@item.PresentCount</span>
                                    <div class="small text-muted">@item.AttendancePercentage%</div>
                                </td>

                                <td class="fw-bold text-danger">@item.AbsentCount</td>
                                <td class="fw-bold text-warning">@item.LateArrivalCount</td>
                                <td class="fw-bold text-info">@item.EarlyLeavePermissionCount</td>

                                <td>
                                    @if (item.HasAttendance)
                                    {
                                        <span class="badge bg-success">مسجل</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">لم يسجل</span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-area="Instructors"
                                           asp-controller="InstructorAttendance"
                                           asp-action="Record"
                                           asp-route-lectureId="@item.LectureId"
                                           class="btn btn-sm btn-primary">
                                            تسجيل
                                        </a>

                                        <a asp-area="Instructors"
                                           asp-controller="InstructorAttendance"
                                           asp-action="LectureReport"
                                           asp-route-lectureId="@item.LectureId"
                                           class="btn btn-sm btn-outline-secondary">
                                            تقرير
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>