@model QdratNew.ViewModels.Instructor.InstructorBatches.InstructorBatchesIndexViewModel

@{
    ViewData["Title"] = "دفعاتي";
}

<div class="qdrat-batches-page" dir="rtl">

    <section class="batches-hero">
        <div class="hero-content">
            <span class="hero-kicker">
                <i class="bi bi-mortarboard"></i>
                منطقة المدرب
            </span>

            <h1>دفعاتي التدريبية</h1>
            <p>إدارة الدفعات، الطلاب، والحضور والانصراف من مكان واحد.</p>
        </div>

        <div class="hero-stat">
            <strong>@(Model?.Batches?.Count ?? 0)</strong>
            <span>دفعة متاحة</span>
        </div>
    </section>

    <section class="batches-toolbar">
        <div class="search-wrapper">
            <i class="bi bi-search"></i>
            <input type="text"
                   id="batchSearchInput"
                   class="form-control"
                   placeholder="ابحث باسم الدفعة أو الدورة أو نوع الارتباط..." />
        </div>

        <button type="button" class="btn btn-clear" onclick="clearBatchSearch()">
            <i class="bi bi-x-lg"></i>
            مسح البحث
        </button>
    </section>

    @if (Model?.Batches == null || !Model.Batches.Any())
    {
        <section class="empty-state">
            <div class="empty-icon">
                <i class="bi bi-collection"></i>
            </div>

            <h3>لا توجد دفعات مرتبطة بك</h3>
            <p>لن تظهر هنا إلا الدفعات التي تم ربطها بحسابك كمدرب.</p>
        </section>
    }
    else
    {
        <section class="batches-grid" id="batchesContainer">
            @foreach (var batch in Model.Batches)
            {
                <article class="batch-card batch-item"
                         data-search="@($"{batch.BatchName} {batch.CourseTitle} {batch.AccessSource}".ToLower())">

                    <div class="batch-card-header">
                        <div class="batch-main">
                            <div class="batch-icon">
                                <i class="bi bi-people-fill"></i>
                            </div>

                            <div>
                                <h2>@batch.BatchName</h2>
                                <p>@batch.CourseTitle</p>
                            </div>
                        </div>

                        <span class="batch-badge">@batch.AccessSource</span>
                    </div>

                    <div class="batch-metrics">
                        <div class="metric-box">
                            <span>عدد الطلاب</span>
                            <strong>@batch.StudentsCount</strong>
                        </div>

                        <div class="metric-box">
                            <span>رقم الدفعة</span>
                            <strong>@batch.BatchId</strong>
                        </div>
                    </div>

                    <div class="batch-actions">
                        <a asp-area="Instructors"
                           asp-controller="InstructorBatches"
                           asp-action="Details"
                           asp-route-id="@batch.BatchId"
                           class="btn action-primary">
                            <i class="bi bi-eye"></i>
                            التفاصيل
                        </a>

                        <a asp-area="Instructors"
                           asp-controller="InstructorBatches"
                           asp-action="Students"
                           asp-route-id="@batch.BatchId"
                           class="btn action-secondary">
                            <i class="bi bi-person-lines-fill"></i>
                            الطلاب
                        </a>

                        <a asp-area="Instructors"
                           asp-controller="InstructorAttendance"
                           asp-action="Lectures"
                           asp-route-batchId="@batch.BatchId"
                           class="btn action-attendance">
                            <i class="bi bi-calendar-check"></i>
                            الحضور والانصراف
                        </a>
                    </div>
                </article>
            }
        </section>

        <div id="noBatchResults" class="no-results d-none">
            لا توجد دفعات مطابقة لبحثك.
        </div>
    }
</div>

<style>
    .qdrat-batches-page {
        width: 100%;
        min-height: calc(100vh - 90px);
        padding: 28px;
        background: radial-gradient(circle at top right, rgba(37, 99, 235, 0.08), transparent 34%), linear-gradient(180deg, #f8fafc 0%, #eef3f9 100%);
    }

    .batches-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 34px;
        margin-bottom: 22px;
        border-radius: 28px;
        color: #fff;
        background: linear-gradient(135deg, #0f172a 0%, #16365f 55%, #1d4ed8 100%);
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
        overflow: hidden;
        position: relative;
    }

        .batches-hero::before {
            content: "";
            position: absolute;
            width: 240px;
            height: 240px;
            left: -80px;
            top: -90px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
        }

        .batches-hero::after {
            content: "";
            position: absolute;
            width: 160px;
            height: 160px;
            right: 42%;
            bottom: -90px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.06);
        }

    .hero-content,
    .hero-stat {
        position: relative;
        z-index: 1;
    }

    .hero-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        margin-bottom: 16px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.13);
        border: 1px solid rgba(255, 255, 255, 0.22);
        color: #dbeafe;
        font-size: 14px;
        font-weight: 800;
    }

    .hero-content h1 {
        margin: 0 0 10px;
        font-size: 34px;
        font-weight: 900;
        letter-spacing: -0.5px;
    }

    .hero-content p {
        margin: 0;
        color: #dbeafe;
        font-size: 16px;
        font-weight: 500;
    }

    .hero-stat {
        min-width: 155px;
        padding: 22px;
        border-radius: 24px;
        text-align: center;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.20);
        backdrop-filter: blur(8px);
    }

        .hero-stat strong {
            display: block;
            font-size: 42px;
            line-height: 1;
            font-weight: 900;
        }

        .hero-stat span {
            display: block;
            margin-top: 8px;
            color: #dbeafe;
            font-weight: 800;
        }

    .batches-toolbar {
        display: grid;
        grid-template-columns: 1fr 220px;
        gap: 14px;
        padding: 18px;
        margin-bottom: 26px;
        border-radius: 24px;
        background: #fff;
        border: 1px solid #e5edf7;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.07);
    }

    .search-wrapper {
        position: relative;
    }

        .search-wrapper i {
            position: absolute;
            right: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 18px;
            z-index: 2;
        }

        .search-wrapper .form-control {
            height: 52px;
            padding-right: 50px;
            border-radius: 18px;
            border: 1px solid #dbe5f1;
            background: #f8fafc;
            font-weight: 700;
            box-shadow: none;
        }

            .search-wrapper .form-control:focus {
                background: #fff;
                border-color: #2563eb;
                box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.08);
            }

    .btn-clear {
        height: 52px;
        border-radius: 18px;
        background: #f8fafc;
        border: 1px solid #dbe5f1;
        color: #334155;
        font-weight: 900;
    }

        .btn-clear:hover {
            background: #e2e8f0;
            color: #0f172a;
        }

    .batches-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
        gap: 22px;
        align-items: stretch;
    }

    .batch-card {
        background: #fff;
        border: 1px solid #e5edf7;
        border-radius: 28px;
        padding: 24px;
        box-shadow: 0 16px 38px rgba(15, 23, 42, 0.08);
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }

        .batch-card:hover {
            transform: translateY(-4px);
            border-color: #c7d7ef;
            box-shadow: 0 22px 48px rgba(15, 23, 42, 0.12);
        }

    .batch-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 14px;
        margin-bottom: 22px;
    }

    .batch-main {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
    }

    .batch-icon {
        width: 62px;
        height: 62px;
        border-radius: 22px;
        background: linear-gradient(135deg, #eff6ff, #dbeafe);
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        flex-shrink: 0;
    }

    .batch-main h2 {
        margin: 0 0 7px;
        color: #0f172a;
        font-size: 24px;
        font-weight: 900;
        line-height: 1.25;
    }

    .batch-main p {
        margin: 0;
        color: #64748b;
        font-size: 14px;
        font-weight: 700;
    }

    .batch-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 7px 12px;
        border-radius: 999px;
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #bbf7d0;
        font-size: 12px;
        font-weight: 900;
        white-space: nowrap;
    }

    .batch-metrics {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 20px;
    }

    .metric-box {
        padding: 16px;
        border-radius: 20px;
        background: #f8fafc;
        border: 1px solid #edf2f7;
    }

        .metric-box span {
            display: block;
            margin-bottom: 8px;
            color: #64748b;
            font-size: 13px;
            font-weight: 800;
        }

        .metric-box strong {
            display: block;
            color: #0f172a;
            font-size: 22px;
            font-weight: 900;
            word-break: break-word;
        }

    .batch-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

        .batch-actions .btn {
            min-height: 48px;
            border-radius: 18px;
            display: inline-flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            font-weight: 900;
            border-width: 1px;
        }

    .action-primary {
        background: #2563eb;
        border-color: #2563eb;
        color: #fff;
    }

        .action-primary:hover {
            background: #1d4ed8;
            border-color: #1d4ed8;
            color: #fff;
        }

    .action-secondary {
        background: #fff;
        border-color: #2563eb;
        color: #2563eb;
    }

        .action-secondary:hover {
            background: #eff6ff;
            color: #1d4ed8;
            border-color: #1d4ed8;
        }

    .action-attendance {
        grid-column: 1 / -1;
        background: #ecfdf5;
        color: #047857;
        border-color: #bbf7d0;
    }

        .action-attendance:hover {
            background: #047857;
            border-color: #047857;
            color: #fff;
        }

    .empty-state {
        padding: 60px 20px;
        border-radius: 28px;
        background: #fff;
        border: 1px solid #e5edf7;
        text-align: center;
        box-shadow: 0 16px 38px rgba(15, 23, 42, 0.07);
    }

    .empty-icon {
        width: 82px;
        height: 82px;
        margin: 0 auto 18px;
        border-radius: 28px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
    }

    .empty-state h3 {
        margin: 0 0 8px;
        color: #0f172a;
        font-size: 24px;
        font-weight: 900;
    }

    .empty-state p {
        margin: 0;
        color: #64748b;
        font-weight: 700;
    }

    .no-results {
        margin-top: 20px;
        padding: 18px;
        border-radius: 20px;
        text-align: center;
        background: #fff7ed;
        color: #9a3412;
        border: 1px solid #fed7aa;
        font-weight: 900;
    }

    @@media (max-width: 992px) {
        .batches-toolbar {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .qdrat-batches-page {
            padding: 16px;
        }

        .batches-hero {
            flex-direction: column;
            align-items: stretch;
            padding: 24px;
        }

        .hero-stat {
            width: 100%;
        }

        .batches-grid {
            grid-template-columns: 1fr;
        }

        .batch-card-header {
            flex-direction: column;
        }

        .batch-badge {
            align-self: flex-start;
        }
    }

    @@media (max-width: 480px) {
        .batch-metrics,
        .batch-actions {
            grid-template-columns: 1fr;
        }

        .action-attendance {
            grid-column: auto;
        }

        .hero-content h1 {
            font-size: 28px;
        }
    }
</style>

<script>
    function clearBatchSearch() {
        var input = document.getElementById('batchSearchInput');

        if (!input) {
            return;
        }

        input.value = '';
        filterBatches('');
    }

    function filterBatches(value) {
        var keyword = (value || '').toLowerCase().trim();
        var items = document.querySelectorAll('.batch-item');
        var visibleCount = 0;

        items.forEach(function (item) {
            var searchableText = item.getAttribute('data-search') || '';
            var isVisible = searchableText.indexOf(keyword) !== -1;

            item.style.display = isVisible ? '' : 'none';

            if (isVisible) {
                visibleCount++;
            }
        });

        var noResults = document.getElementById('noBatchResults');

        if (noResults) {
            if (visibleCount === 0 && items.length > 0) {
                noResults.classList.remove('d-none');
            } else {
                noResults.classList.add('d-none');
            }
        }
    }

    document.getElementById('batchSearchInput')?.addEventListener('input', function () {
        filterBatches(this.value);
    });
</script>