@model QdratNew.ViewModels.Instructor.InstructorBatches.InstructorBatchDetailsViewModel

@{
    ViewData["Title"] = "تفاصيل الدفعة";
}

<div class="qdrat-instructor-page" dir="rtl">

    <div class="page-hero">
        <div>
            <div class="hero-label">تفاصيل الدفعة</div>
            <h1>@Model.BatchName</h1>
            <p>@Model.CourseTitle</p>
        </div>

        <div class="hero-actions">
            <a asp-area="Instructors"
               asp-controller="InstructorBatches"
               asp-action="Index"
               class="btn btn-light">
                <i class="bi bi-arrow-right-circle"></i>
                الرجوع للدفعات
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-4 col-md-6">
            <div class="stat-card">
                <div class="stat-icon blue">
                    <i class="bi bi-people"></i>
                </div>
                <div>
                    <span>عدد الطلاب</span>
                    <strong>@Model.StudentsCount</strong>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="stat-card">
                <div class="stat-icon green">
                    <i class="bi bi-journal-text"></i>
                </div>
                <div>
                    <span>المناهج المرتبطة بك</span>
                    <strong>@(Model.Curriculums?.Count ?? 0)</strong>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-12">
            <div class="stat-card">
                <div class="stat-icon purple">
                    <i class="bi bi-hash"></i>
                </div>
                <div>
                    <span>رقم الدفعة</span>
                    <strong>@Model.BatchId</strong>
                </div>
            </div>
        </div>
    </div>

    <div class="content-card mb-4">
        <div class="section-title">
            <div>
                <h3>المناهج المرتبطة</h3>
                <p>المناهج التي يحق لك متابعتها داخل هذه الدفعة.</p>
            </div>
        </div>

        @if (Model.Curriculums == null || !Model.Curriculums.Any())
        {
            <div class="soft-alert warning">
                لا توجد مناهج مرتبطة بك داخل هذه الدفعة.
            </div>
        }
        else
        {
            <div class="curriculum-grid">
                @foreach (var curriculum in Model.Curriculums)
                {
                    <div class="curriculum-card">
                        <i class="bi bi-book"></i>
                        <span>@curriculum.CurriculumTitle</span>
                    </div>
                }
            </div>
        }
    </div>

    <div class="content-card">
        <div class="section-title with-action">
            <div>
                <h3>طلاب الدفعة</h3>
                <p>قائمة مختصرة بأسماء الطلاب داخل الدفعة.</p>
            </div>

            <a asp-area="Instructors"
               asp-controller="InstructorBatches"
               asp-action="Students"
               asp-route-id="@Model.BatchId"
               class="btn btn-primary">
                <i class="bi bi-person-lines-fill"></i>
                عرض كل الطلاب
            </a>
        </div>

        @if (Model.Students == null || !Model.Students.Any())
        {
            <div class="soft-alert info">
                لا يوجد طلاب مسجلون في هذه الدفعة حاليًا.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table qdrat-table align-middle">
                    <thead>
                        <tr>
                            <th>الطالب</th>
                            <th>رقم الهوية</th>
                            <th>الجوال</th>
                            <th>المستوى</th>
                            <th>الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model.Students)
                        {
                            <tr>
                                <td>
                                    <div class="student-cell">
                                        <div class="avatar">@GetInitial(student.FullName)</div>
                                        <div>
                                            <strong>@student.FullName</strong>
                                            <small>كود الطالب: @student.StudentId</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@student.NationalId</td>
                                <td>@DisplayValue(student.PhoneNumber)</td>
                                <td>@DisplayValue(student.Level)</td>
                                <td>
                                    <span class="status-badge">@DisplayValue(student.EnrollmentStatus)</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>

@functions {
    private string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "غير محدد" : value;
    }

    private string GetInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "ط";
        }

        return name.Trim().Substring(0, 1);
    }
}

<style>
    .qdrat-instructor-page {
        padding: 24px;
        background: #f5f7fb;
        min-height: calc(100vh - 80px);
    }

    .page-hero {
        background: linear-gradient(135deg, #0f172a, #1e3a5f);
        color: #fff;
        border-radius: 24px;
        padding: 28px;
        margin-bottom: 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.18);
    }

    .hero-label {
        display: inline-flex;
        padding: 6px 12px;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.18);
        border-radius: 999px;
        font-size: 13px;
        margin-bottom: 12px;
        color: #dbeafe;
    }

    .page-hero h1 {
        margin: 0 0 8px;
        font-size: 30px;
        font-weight: 800;
    }

    .page-hero p {
        margin: 0;
        color: #dbeafe;
    }

    .hero-actions .btn {
        border-radius: 16px;
        font-weight: 800;
        padding: 10px 16px;
    }

    .stat-card {
        background: #fff;
        border: 1px solid #e8eef7;
        border-radius: 22px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
        height: 100%;
    }

    .stat-icon {
        width: 54px;
        height: 54px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
    }

        .stat-icon.blue {
            background: #eff6ff;
            color: #2563eb;
        }

        .stat-icon.green {
            background: #ecfdf5;
            color: #059669;
        }

        .stat-icon.purple {
            background: #f5f3ff;
            color: #7c3aed;
        }

    .stat-card span {
        display: block;
        color: #64748b;
        font-size: 14px;
        margin-bottom: 6px;
    }

    .stat-card strong {
        display: block;
        color: #0f172a;
        font-size: 28px;
        font-weight: 900;
    }

    .content-card {
        background: #fff;
        border: 1px solid #e8eef7;
        border-radius: 24px;
        padding: 24px;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
    }

    .section-title {
        margin-bottom: 18px;
    }

        .section-title.with-action {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
        }

        .section-title h3 {
            margin: 0 0 6px;
            font-size: 21px;
            font-weight: 900;
            color: #0f172a;
        }

        .section-title p {
            margin: 0;
            color: #64748b;
            font-size: 14px;
        }

        .section-title .btn {
            border-radius: 16px;
            font-weight: 800;
            padding: 10px 16px;
        }

    .curriculum-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 12px;
    }

    .curriculum-card {
        background: #f8fafc;
        border: 1px solid #e8eef7;
        border-radius: 18px;
        padding: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #0f172a;
        font-weight: 800;
    }

        .curriculum-card i {
            color: #2563eb;
            font-size: 20px;
        }

    .soft-alert {
        padding: 16px;
        border-radius: 18px;
        font-weight: 700;
    }

        .soft-alert.warning {
            background: #fff7ed;
            color: #9a3412;
            border: 1px solid #fed7aa;
        }

        .soft-alert.info {
            background: #eff6ff;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
        }

    .qdrat-table {
        margin-bottom: 0;
    }

        .qdrat-table thead th {
            background: #f8fafc;
            color: #475569;
            border-bottom: 1px solid #e2e8f0;
            padding: 14px;
            font-weight: 900;
            white-space: nowrap;
        }

        .qdrat-table tbody td {
            padding: 14px;
            border-bottom: 1px solid #eef2f7;
            color: #334155;
            vertical-align: middle;
        }

    .student-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .student-cell strong {
            display: block;
            color: #0f172a;
            font-weight: 800;
        }

        .student-cell small {
            display: block;
            color: #64748b;
            margin-top: 3px;
        }

    .avatar {
        width: 44px;
        height: 44px;
        border-radius: 16px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        flex-shrink: 0;
    }

    .status-badge {
        display: inline-flex;
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #bbf7d0;
        border-radius: 999px;
        padding: 6px 12px;
        font-size: 13px;
        font-weight: 800;
    }

    @@media (max-width: 768px) {
        .qdrat-instructor-page {
            padding: 14px;
        }

        .page-hero,
        .section-title.with-action {
            flex-direction: column;
            align-items: stretch;
        }
    }
</style>