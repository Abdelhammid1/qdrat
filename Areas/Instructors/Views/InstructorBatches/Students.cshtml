@model List<QdratNew.ViewModels.Instructor.InstructorBatches.InstructorBatchStudentViewModel>

@{
    ViewData["Title"] = "طلاب الدفعة";
}

<div class="qdrat-instructor-page" dir="rtl">

    <div class="page-hero">
        <div>
            <div class="hero-label">طلاب الدفعة</div>
            <h1>قائمة الطلاب</h1>
            <p>عرض الطلاب داخل الدفعة المصرح بها للمدرب الحالي.</p>
        </div>

        <div class="hero-counter">
            <span>@(Model?.Count ?? 0)</span>
            <small>طالب</small>
        </div>
    </div>

    <div class="toolbar-card">
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text"
                   id="studentSearchInput"
                   class="form-control"
                   placeholder="ابحث باسم الطالب أو رقم الهوية أو الجوال أو المستوى..." />
        </div>
    </div>

    <div class="content-card">
        @if (Model == null || !Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="bi bi-people"></i>
                </div>
                <h3>لا يوجد طلاب في هذه الدفعة</h3>
                <p>سيظهر الطلاب هنا بعد ربطهم بالدفعة.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table qdrat-table align-middle">
                    <thead>
                        <tr>
                            <th>الطالب</th>
                            <th>رقم الهوية</th>
                            <th>الجوال</th>
                            <th>المستوى</th>
                            <th>الحالة</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var student in Model)
                        {
                            <tr class="student-row"
                                data-search="@($"{student.FullName} {student.NationalId} {student.PhoneNumber} {student.Level} {student.EnrollmentStatus}".ToLower())">
                                <td>
                                    <div class="student-cell">
                                        <div class="avatar">@GetInitial(student.FullName)</div>
                                        <div>
                                            <strong>@student.FullName</strong>
                                            <small>كود الطالب: @student.StudentId</small>
                                        </div>
                                    </div>
                                </td>

                                <td>@DisplayValue(student.NationalId)</td>
                                <td>@DisplayValue(student.PhoneNumber)</td>
                                <td>@DisplayValue(student.Level)</td>
                                <td>
                                    <span class="status-badge">@DisplayValue(student.EnrollmentStatus)</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="noStudentResults" class="no-results d-none">
                لا توجد نتائج مطابقة لبحثك.
            </div>
        }
    </div>

</div>

@functions {
    private string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "غير محدد" : value;
    }

    private string GetInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "ط";
        }

        return name.Trim().Substring(0, 1);
    }
}

<style>
    .qdrat-instructor-page {
        padding: 24px;
        background: #f5f7fb;
        min-height: calc(100vh - 80px);
    }

    .page-hero {
        background: linear-gradient(135deg, #0f172a, #1e3a5f);
        color: #fff;
        border-radius: 24px;
        padding: 28px;
        margin-bottom: 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.18);
    }

    .hero-label {
        display: inline-flex;
        padding: 6px 12px;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.18);
        border-radius: 999px;
        font-size: 13px;
        margin-bottom: 12px;
        color: #dbeafe;
    }

    .page-hero h1 {
        margin: 0 0 8px;
        font-size: 30px;
        font-weight: 800;
    }

    .page-hero p {
        margin: 0;
        color: #dbeafe;
    }

    .hero-counter {
        min-width: 130px;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.18);
        border-radius: 20px;
        padding: 18px;
        text-align: center;
    }

        .hero-counter span {
            display: block;
            font-size: 34px;
            font-weight: 900;
            line-height: 1;
        }

        .hero-counter small {
            color: #dbeafe;
        }

    .toolbar-card {
        background: #fff;
        border: 1px solid #e8eef7;
        border-radius: 20px;
        padding: 18px;
        margin-bottom: 22px;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
    }

    .search-box {
        position: relative;
    }

        .search-box i {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 2;
        }

        .search-box .form-control {
            height: 48px;
            border-radius: 16px;
            border-color: #dbe4f0;
            padding-right: 44px;
            box-shadow: none;
        }

            .search-box .form-control:focus {
                border-color: #2563eb;
            }

    .content-card {
        background: #fff;
        border: 1px solid #e8eef7;
        border-radius: 24px;
        padding: 24px;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
    }

    .qdrat-table {
        margin-bottom: 0;
    }

        .qdrat-table thead th {
            background: #f8fafc;
            color: #475569;
            border-bottom: 1px solid #e2e8f0;
            padding: 14px;
            font-weight: 900;
            white-space: nowrap;
        }

        .qdrat-table tbody td {
            padding: 14px;
            border-bottom: 1px solid #eef2f7;
            color: #334155;
            vertical-align: middle;
        }

    .student-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .student-cell strong {
            display: block;
            color: #0f172a;
            font-weight: 800;
        }

        .student-cell small {
            display: block;
            color: #64748b;
            margin-top: 3px;
        }

    .avatar {
        width: 44px;
        height: 44px;
        border-radius: 16px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        flex-shrink: 0;
    }

    .status-badge {
        display: inline-flex;
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #bbf7d0;
        border-radius: 999px;
        padding: 6px 12px;
        font-size: 13px;
        font-weight: 800;
    }

    .empty-state {
        text-align: center;
        padding: 55px 20px;
    }

    .empty-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 16px;
        border-radius: 24px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 34px;
    }

    .empty-state h3 {
        margin: 0 0 8px;
        font-weight: 900;
        color: #0f172a;
    }

    .empty-state p {
        margin: 0;
        color: #64748b;
    }

    .no-results {
        margin-top: 18px;
        background: #fff7ed;
        color: #9a3412;
        border: 1px solid #fed7aa;
        padding: 16px;
        border-radius: 18px;
        text-align: center;
        font-weight: 800;
    }

    @@media (max-width: 768px) {
        .qdrat-instructor-page {
            padding: 14px;
        }

        .page-hero {
            flex-direction: column;
            align-items: stretch;
        }

        .hero-counter {
            width: 100%;
        }
    }
</style>

<script>
    document.getElementById('studentSearchInput')?.addEventListener('input', function () {
        var keyword = (this.value || '').toLowerCase().trim();
        var rows = document.querySelectorAll('.student-row');
        var visibleCount = 0;

        rows.forEach(function (row) {
            var searchableText = row.getAttribute('data-search') || '';
            var isVisible = searchableText.indexOf(keyword) !== -1;

            row.style.display = isVisible ? '' : 'none';

            if (isVisible) {
                visibleCount++;
            }
        });

        var noResults = document.getElementById('noStudentResults');
        if (noResults) {
            if (visibleCount === 0 && rows.length > 0) {
                noResults.classList.remove('d-none');
            } else {
                noResults.classList.add('d-none');
            }
        }
    });
</script>