@model QdratNew.ViewModels.Homework.HomeworkAnalyticsViewModel
@using Newtonsoft.Json
@{
    ViewData["Title"] = "تقرير الواجب";
    var rec = Model.Recommendation;
}

@section Styles {
    <link href="~/css/instructor/instructor-homeworks.css" rel="stylesheet" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Scope Tailwind's Preflight reset to avoid Bootstrap conflicts */
        .tw-scope *, .tw-scope *::before, .tw-scope *::after { box-sizing: border-box; }
        /* Print */
        @@media print { .no-print { display: none; } }
    </style>
}

<div class="tw-scope" dir="rtl">
<div class="max-w-6xl mx-auto px-4 py-6 space-y-6">

    <!-- عنوان ومعلومات عامة -->
    <section class="card">
        <div class="flex justify-between items-center flex-wrap gap-6 border-b border-gray-100 pb-3">
            <div>
                <h1 class="text-2xl font-extrabold text-slate-900 flex items-center gap-2">
                    📘 تقرير الواجب
                </h1>
                <p class="text-slate-500 mt-1">@Model.BestSection</p>
            </div>
            <img src="~/images/160×100.png" class="h-16 md:h-20" alt="شعار المعهد" />
        </div>

        <div class="grid sm:grid-cols-2 gap-6 mt-4">
            <div class="grid grid-cols-3 gap-y-2 text-sm md:text-base">
                <div class="label">اسم الطالب:</div>   <div class="col-span-2 value">@Model.StudentName</div>
                <div class="label">الدفعة:</div>       <div class="col-span-2 value">@Model.BatchName</div>
                <div class="label">عدد الأسئلة:</div>  <div class="col-span-2 value">@Model.TotalQuestions</div>
                <div class="label">الإجابات الصحيحة:</div><div class="col-span-2 value">@Model.CorrectCount</div>
                <div class="label">الوقت المستغرق:</div><div class="col-span-2 value">@Model.TimeSpentMinutes دقيقة</div>
            </div>
            <div class="grid grid-cols-3 gap-y-2 text-sm md:text-base">
                <div class="label">النسبة العامة:</div>
                <div class="col-span-2 value text-emerald-600">@Model.ScorePercentage%</div>
                <div class="label">الأسئلة الخاطئة:</div>
                <div class="col-span-2 value text-red-500">@Model.WrongCount</div>
                <div class="label">غير المجابة:</div>
                <div class="col-span-2 value text-amber-600">@Model.SkippedCount</div>
            </div>
        </div>
    </section>

    <!-- الرسوم البيانية -->
    <section class="grid md:grid-cols-2 gap-6">
        <div class="card flex flex-col items-center justify-center h-full">
            <h2 class="font-bold text-slate-700 mb-4 text-center">تحليل الأداء حسب المحاور</h2>
            <canvas id="sectionsChart" class="w-full" height="220"></canvas>
        </div>
        <div class="card flex flex-col items-center justify-center h-full">
            <h2 class="font-bold text-slate-700 mb-4 text-center">توزيع الإجابات</h2>
            <canvas id="answersPie" class="w-full" height="220"></canvas>
        </div>
    </section>

    <!-- جدول المؤشرات -->
    <section class="card overflow-x-auto">
        <h2 class="font-bold text-slate-800 mb-3 text-center">تحليل المؤشرات داخل الواجب</h2>

        @if (Model.LessonsPerformance?.Any() == true)
        {
            <table class="min-w-full text-center border border-gray-200 rounded-lg text-sm">
                <thead class="bg-slate-50">
                    <tr class="text-slate-700">
                        <th class="py-2 px-3">المؤشر</th>
                        <th class="py-2 px-3">عدد الأسئلة</th>
                        <th class="py-2 px-3">نسبة النجاح</th>
                        <th class="py-2 px-3">عرض الأسئلة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.LessonsPerformance)
                    {
                        <tr class="border-b hover:bg-slate-50 transition">
                            <td class="py-2 font-medium">@l.LessonTitle</td>
                            <td>@l.TotalQuestions</td>
                            <td class="@(l.SuccessRate >= 60 ? "text-emerald-600" : "text-red-500") font-semibold">@l.SuccessRate%</td>
                            <td>
                                <a asp-action="ReviewLesson"
                                   asp-route-homeworkSetId="@Model.HomeworkSetId"
                                   asp-route-lessonId="@l.LessonId"
                                   class="px-2 py-1 rounded-md bg-sky-50 text-sky-600 border border-sky-200 hover:bg-sky-100 transition">
                                    عرض
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-center text-gray-500">لا توجد بيانات مؤشرات لهذا الواجب.</p>
        }
    </section>

    <!-- توصيات الذكاء الاصطناعي -->
    <div class="card bg-gradient-to-b from-sky-50 to-white border border-sky-200 rounded-2xl shadow-sm mt-6">
        <h3 class="text-sky-800 font-extrabold text-lg text-center mb-5 flex items-center justify-center gap-2">
            <i class="fa-solid fa-list-check text-sky-600"></i> توصيات حسب المؤشرات
        </h3>

        <div class="space-y-3">
            @{ int tipIndex = 0; }
            @foreach (var tip in rec.LessonTips)
            {
                var bgColor = tipIndex % 2 == 0 ? "bg-white" : "bg-gray-50";
                tipIndex++;
                <div class="flex items-start gap-3 @bgColor border border-sky-100 rounded-xl p-4 shadow-sm hover:shadow-md transition-all">
                    <div class="flex-shrink-0">
                        <div class="w-9 h-9 flex items-center justify-center rounded-full bg-sky-100 text-sky-700 font-bold text-lg">📘</div>
                    </div>
                    <div class="flex-grow text-gray-800 leading-relaxed text-sm md:text-base">
                        @Html.Raw(tip)
                    </div>
                </div>
            }
        </div>

        <div class="mt-6 text-center">
            <p class="text-emerald-700 font-semibold text-sm bg-emerald-50 py-3 px-5 inline-block rounded-full border border-emerald-200 shadow-sm">
                🌟 @rec.FinalAdvice
            </p>
        </div>
    </div>

</div>
</div>

@section Scripts {
    <script>
        new Chart(document.getElementById("sectionsChart"), {
            type: 'bar',
            data: {
                labels: @Html.Raw(JsonConvert.SerializeObject(Model.SectionsPerformance.Select(s => s.SectionTitle).ToList())),
                datasets: [{
                    data: @Html.Raw(JsonConvert.SerializeObject(Model.SectionsPerformance.Select(s => s.Accuracy).ToList())),
                    backgroundColor: '#4CA6A8',
                    borderRadius: 6
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, max: 100 } }
            }
        });

        new Chart(document.getElementById("answersPie"), {
            type: 'doughnut',
            data: {
                labels: ["صحيحة", "خاطئة", "غير مجابة"],
                datasets: [{
                    data: [@Model.CorrectCount, @Model.WrongCount, @Model.SkippedCount],
                    backgroundColor: ["#22c55e", "#ef4444", "#f59e0b"],
                    borderWidth: 3,
                    borderColor: '#fff'
                }]
            },
            options: {
                plugins: { legend: { position: 'bottom' } },
                responsive: true,
                cutout: '65%'
            }
        });
    </script>
}
