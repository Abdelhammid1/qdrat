@model QdratNew.ViewModels.Homework.HomeworkResultViewModel
@using QdratNew.Helpers

@{
    ViewData["Title"] = "نتيجة الواجب";

    var successRate = Model.ScorePercentage;
    int wrongAnswers = Model.TotalQuestions - Model.CorrectAnswers;

    string performanceMessage = successRate >= 90 ? "🎉 أداء ممتاز! استمر بهذا المستوى الرائع."
                            : successRate >= 75 ? "👏 أداء جيد جدًا، فقط ركز أكثر على مراجعة الأخطاء."
                            : successRate >= 60 ? "🙂 أداء مقبول، حاول تحسين تركيزك في الأسئلة الصعبة."
                            : "⚠️ تحتاج إلى مراجعة المحاور الضعيفة وتحسين مستواك.";

    string performanceIcon = successRate >= 90 ? "bi-trophy-fill text-warning"
                           : successRate >= 75 ? "bi-emoji-smile-fill text-success"
                           : successRate >= 60 ? "bi-emoji-neutral-fill text-info"
                           : "bi-emoji-frown-fill text-danger";
}

@section Styles {
    <link href="~/css/instructor/instructor-homeworks.css" rel="stylesheet" asp-append-version="true" />
}

<div class="container py-5" dir="rtl">

    <!-- العنوان -->
    <div class="text-center mb-5">
        <h2 class="fw-bold mb-2" style="color:var(--hw-primary)">
            <i class="bi bi-journal-check"></i> نتيجة الواجب
        </h2>
        <h5 class="text-secondary">@Model.CurriculumTitle</h5>
        <div class="text-muted">@Model.SectionTitle - @Model.LessonTitle</div>
    </div>

    <!-- كروت الإحصائيات -->
    <div class="row text-center mb-4">

        <div class="col-md-4 mb-3">
            <div class="student-result-card">
                <div class="card-body">
                    <h6 class="text-muted">عدد الأسئلة الكلي</h6>
                    <h3 class="fw-bold" style="color:var(--hw-text)">
                        @NumberHelper.ToIndicNumbersSafe(Model.TotalQuestions.ToString())
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="student-result-card">
                <div class="card-body">
                    <h6 class="text-muted">الإجابات الصحيحة</h6>
                    <h3 class="fw-bold text-success">
                        @NumberHelper.ToIndicNumbersSafe(Model.CorrectAnswers.ToString())
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="student-result-card">
                <div class="card-body">
                    <h6 class="text-muted">الإجابات الخاطئة</h6>
                    <h3 class="fw-bold text-danger">
                        @NumberHelper.ToIndicNumbersSafe(wrongAnswers.ToString())
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <!-- شريط التقدم -->
    <div class="text-center mb-4">
        <h5 class="fw-bold mb-3">النتيجة المئوية</h5>
        <div class="hw-progress mx-auto" style="max-width:400px;">
            <div class="hw-progress-bar"
                 role="progressbar"
                 style="width:@Model.ScorePercentage%"
                 aria-valuenow="@Model.ScorePercentage"
                 aria-valuemin="0"
                 aria-valuemax="100">
                @Model.ScorePercentage%
            </div>
        </div>
    </div>

    <!-- رسالة الأداء -->
    <div class="hw-alert-result mb-5 mx-auto" style="max-width:600px;">
        <i class="bi @performanceIcon fs-3 me-2"></i>
        <span class="fw-bold">@performanceMessage</span>
    </div>

    <!-- زر مراجعة الإجابات -->
    <div class="text-center mt-4">
        <a asp-action="ReviewStudent"
           asp-route-homeworkSetId="@Model.HomeworkSetId"
           asp-route-studentId="@ViewBag.StudentId"
           class="btn btn-lg rounded-pill px-4"
           style="background:var(--hw-primary);color:#fff;font-weight:700;border:0;">
            <i class="fa-solid fa-list-check me-2"></i>
            عرض تفاصيل الأسئلة
        </a>
    </div>

</div>
