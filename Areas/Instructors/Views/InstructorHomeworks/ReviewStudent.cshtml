@model QdratNew.ViewModels.Homework.HomeworkReviewViewModel
@using QdratNew.Helpers

@{
    ViewData["Title"] = "مراجعة أسئلة الواجب";
}

@section Styles {
    <link href="~/css/instructor/instructor-homeworks.css" rel="stylesheet" asp-append-version="true" />
}

<div class="questions-container">

    <!-- Header -->
    <div class="page-header">
        <h2>مراجعة أسئلة الواجب</h2>

        <div class="stats">
            <div class="stat-card">
                <span>إجمالي الأسئلة</span>
                <strong>@NumberHelper.ToIndicNumbersSafe(Model.TotalQuestions.ToString())</strong>
            </div>
            <div class="stat-card success">
                <span>إجابات صحيحة</span>
                <strong>@NumberHelper.ToIndicNumbersSafe(Model.CorrectAnswers.ToString())</strong>
            </div>
            <div class="stat-card danger">
                <span>إجابات خاطئة</span>
                <strong>@NumberHelper.ToIndicNumbersSafe(Model.WrongAnswers.ToString())</strong>
            </div>
        </div>
    </div>

    <!-- Questions Grid -->
    <div class="questions-grid">

        @foreach (var item in Model.Questions.Select((q, i) => new { q, i }))
        {
            var q     = item.q;
            var index = item.i + 1;
            Func<string, string> convert = s => q.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(s) : s;

            <div class="question-card">

                <div class="question-header">
                    <div class="question-number">
                        سؤال @NumberHelper.ToIndicNumbersSafe(index.ToString())
                    </div>
                    @if (q.IsCorrect)
                    {
                        <span class="badge correct"><i class="fa fa-check"></i> إجابة صحيحة</span>
                    }
                    else
                    {
                        <span class="badge wrong"><i class="fa fa-times"></i> إجابة خاطئة</span>
                    }
                </div>

                <div class="question-title">@Html.Raw(convert(q.QuestionText))</div>

                @if (!string.IsNullOrWhiteSpace(q.VerbalPassageContent))
                {
                    <div class="passage">
                        <div class="passage-title">📘 @q.VerbalPassageTitle</div>
                        <div class="passage-content">@Html.Raw(convert(q.VerbalPassageContent))</div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(q.ImageUrl))
                {
                    <div class="question-image">
                        <img src="@Url.Content(q.ImageUrl)" />
                    </div>
                }

                @if (q.DisplayType == QdratNew.Enums.QuestionDisplayType.ComparisonText)
                {
                    <div class="comparison">
                        <div class="value"><span>القيمة الأولى</span>@Html.Raw(convert(q.ComparisonValue1))</div>
                        <div class="value"><span>القيمة الثانية</span>@Html.Raw(convert(q.ComparisonValue2))</div>
                    </div>
                }

                <div class="options">
                    @foreach (var opt in q.Options)
                    {
                        var css = "option";
                        if (opt.IsCorrect)          css += " correct";
                        else if (opt.IsSelectedByStudent) css += " selected";

                        <div class="@css">
                            @if (!string.IsNullOrWhiteSpace(opt.ImageUrl))
                            {
                                <img src="@Url.Content(opt.ImageUrl)" />
                            }
                            else
                            {
                                <span>@Html.Raw(convert(opt.Text))</span>
                            }
                            @if (opt.IsCorrect)                            { <i class="fa fa-check icon"></i> }
                            @if (opt.IsSelectedByStudent && !opt.IsCorrect) { <i class="fa fa-times icon"></i> }
                        </div>
                    }
                </div>

                <div class="answer-summary">
                    <div><strong>إجابة الطالب:</strong> @q.StudentAnswer</div>
                    <div><strong>الإجابة الصحيحة:</strong> @q.CorrectAnswer</div>
                </div>

            </div>
        }

    </div>
</div>
