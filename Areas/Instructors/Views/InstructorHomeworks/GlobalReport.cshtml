@model QdratNew.ViewModels.Instructor.Homework.HomeworkGlobalReportVM

@{
    ViewData["Title"] = "تحليل الواجب";
}

@section Styles {
    <link href="~/css/instructor/instructor-homeworks.css" rel="stylesheet" asp-append-version="true" />
}

<div class="container mt-4" dir="rtl">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3 class="fw-bold text-primary">
            <i class="fa-solid fa-chart-line me-1"></i>
            تحليل أداء الواجب
        </h3>

        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-right"></i>
            رجوع
        </a>

    </div>

    <!-- ============================= -->
    <!-- KPI Cards -->
    <!-- ============================= -->

    <div class="row g-3 mb-4">

        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-0 text-center p-3">
                <div class="small text-muted">عدد الطلاب</div>
                <div class="fs-2 fw-bold text-dark">
                    @Model.TotalStudents
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-0 text-center p-3">
                <div class="small text-muted">الطلاب الذين حلوا</div>
                <div class="fs-2 fw-bold text-success">
                    @Model.SubmittedStudents
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-0 text-center p-3">
                <div class="small text-muted">لم يحلوا الواجب</div>
                <div class="fs-2 fw-bold text-danger">
                    @Model.NotSubmittedStudents
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-0 text-center p-3">
                <div class="small text-muted">متوسط الدرجة</div>
                <div class="fs-2 fw-bold text-primary">
                    @Model.AverageScore %
                </div>
            </div>
        </div>

    </div>


    <!-- ============================= -->
    <!-- Students Ranking -->
    <!-- ============================= -->

    <div class="row g-3 mb-4">

        <!-- أفضل الطلاب -->

        <div class="col-lg-6">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-light fw-bold text-success">
                    أفضل الطلاب
                </div>

                <div class="table-responsive">

                    <table class="table table-sm align-middle text-center mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>#</th>
                                <th>الدرجة</th>
                                <th>وقت التسليم</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var s in Model.TopStudents)
                            {
                                <tr>
                                    <td>@s.StudentName</td>
                                    <td class="fw-bold text-success">@s.Score</td>
                                    <td>@s.SubmittedAt</td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>


        <!-- أضعف الطلاب -->

        <div class="col-lg-6">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-light fw-bold text-danger">
                    أضعف الطلاب
                </div>

                <div class="table-responsive">

                    <table class="table table-sm align-middle text-center mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>#</th>
                                <th>الدرجة</th>
                                <th>وقت التسليم</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var s in Model.WeakStudents)
                            {
                                <tr>
                                    <td>@s.StudentName</td>
                                    <td class="fw-bold text-danger">@s.Score</td>
                                    <td>@s.SubmittedAt</td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>



    <!-- ============================= -->
    <!-- Hardest / Easiest Questions -->
    <!-- ============================= -->

    <div class="row g-3 mb-4">

        <!-- أصعب الأسئلة -->

        <div class="col-lg-6">

            <div class="card shadow-sm border-0">

                <div class="card-header fw-bold text-danger bg-light">
                    أصعب الأسئلة
                </div>

                <div class="list-group list-group-flush">

                    @foreach (var q in Model.HardestQuestions)
                    {

                        <div class="list-group-item">

                            <div class="fw-bold text-danger mb-1">
                                نسبة النجاح: @q.Accuracy %
                            </div>

                            <div>
                                @Html.Raw(q.QuestionTitle)
                            </div>

                        </div>

                    }

                </div>

            </div>

        </div>


        <!-- أسهل الأسئلة -->

        <div class="col-lg-6">

            <div class="card shadow-sm border-0">

                <div class="card-header fw-bold text-success bg-light">
                    أسهل الأسئلة
                </div>

                <div class="list-group list-group-flush">

                    @foreach (var q in Model.EasiestQuestions)
                    {

                        <div class="list-group-item">

                            <div class="fw-bold text-success mb-1">
                                نسبة النجاح: @q.Accuracy %
                            </div>

                            <div>
                                @Html.Raw(q.QuestionTitle)
                            </div>

                        </div>

                    }

                </div>

            </div>

        </div>

    </div>



    <!-- ============================= -->
    <!-- Questions Analysis -->
    <!-- ============================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-light fw-bold">
            تحليل الأسئلة
        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle text-center mb-0">

                <thead class="table-light">

                    <tr>
                        <th style="width:40%">السؤال</th>
                        <th>صحيحة</th>
                        <th>خاطئة</th>
                        <th>متخطاة</th>
                        <th>متوسط الوقت</th>
                        <th>نسبة النجاح</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var q in Model.Questions)
                    {

                        var color =
                        q.Accuracy >= 70 ? "text-success" :
                        q.Accuracy >= 40 ? "text-warning" :
                        "text-danger";

                        <tr>

                            <td class="text-start">

                                <div style="max-width:600px">
                                    @Html.Raw(q.QuestionTitle)
                                </div>

                            </td>

                            <td class="fw-bold text-success">
                                @q.CorrectAnswers
                            </td>

                            <td class="fw-bold text-danger">
                                @q.WrongAnswers
                            </td>

                            <td class="fw-bold text-warning">
                                @q.SkippedAnswers
                            </td>

                            <td>
                                @q.AverageTimeSeconds ثانية
                            </td>

                            <td class="fw-bold @color">
                                @q.Accuracy %
                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    </div>



    <!-- ============================= -->
    <!-- Chart -->
    <!-- ============================= -->

    <div class="card shadow-sm border-0 p-3">

        <div class="fw-bold mb-3">
            أداء الأسئلة
        </div>

        <canvas id="questionsChart" height="120"></canvas>

    </div>


</div>



@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const labels = [
        @foreach (var q in Model.Questions)
        {
                <text>"@Html.Raw(q.QuestionTitle.Replace("\"", ""))",</text>
        }
        ];

        const correct = [
        @foreach (var q in Model.Questions)
        {
                <text>@q.CorrectAnswers,</text>
        }
        ];

        const wrong = [
        @foreach (var q in Model.Questions)
        {
                <text>@q.WrongAnswers,</text>
        }
        ];

        new Chart(document.getElementById('questionsChart'), {

        type: 'bar',

        data: {

        labels: labels,

        datasets: [

        {
        label: 'إجابات صحيحة',
        data: correct,
        backgroundColor: '#28a745'
        },

        {
        label: 'إجابات خاطئة',
        data: wrong,
        backgroundColor: '#dc3545'
        }

        ]

        },

        options:{
        plugins:{legend:{position:"bottom"}},
        scales:{y:{beginAtZero:true}}
        }

        });

    </script>

}