@model IEnumerable<QdratNew.ViewModels.Instructor.Homework.HomeworkStudentVM>

@{
    ViewData["Title"] = "الطلاب";
}

@section Styles {
    <link href="~/css/instructor/instructor-homeworks.css" rel="stylesheet" asp-append-version="true" />
}

<div class="container mt-4" dir="rtl">

    <div class="instructor-card">

        <div class="card-title-box mb-3">
            <h3>
            الطلاب الذين استلموا الواجب
        </h3>

    </div>
        <div class="table-responsive">

            <table class="instructor-table">

                <thead>

            <tr>
                <th>الطالب</th>
                <th>الحالة</th>
                <th>الدرجة</th>
                <th>وقت التسليم</th>
                <th>إجراءات</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var s in Model)
            {
                <tr>

                    <td class="fw-semibold">
                        @s.StudentName
                    </td>

                    <td>

                        @if (s.IsSolved)
                        {
                            <span class="badge bg-success">
                                تم الحل
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                لم يحل
                            </span>
                        }

                    </td>

                    <td>

                        @if (s.Score.HasValue)
                        {
                            <span class="fw-bold text-success">
                                @s.Score
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                —
                            </span>
                        }

                    </td>

                    <td>

                        @if (s.SubmittedAt.HasValue)
                        {
                            @s.SubmittedAt.Value.ToString("yyyy/MM/dd HH:mm")
                        }
                        else
                        {
                            <span class="text-muted">
                                —
                            </span>
                        }

                    </td>

                    <td>

                        @if (s.IsSolved)
                        {
                            <a asp-action="StudentResult"
                               asp-route-studentId="@s.StudentId"
                               asp-route-homeworkSetId="@ViewBag.HomeworkSetId"
                               class="btn btn-sm btn-outline-success">

                                <i class="fa fa-chart-line"></i>
                            </a>

                            <a asp-action="ReviewStudent"
                               asp-route-studentId="@s.StudentId"
                               asp-route-homeworkSetId="@ViewBag.HomeworkSetId"
                               class="btn btn-sm btn-outline-primary">

                                <i class="fa fa-eye"></i>
                            </a>

                            <a asp-action="StudentHomeworkPerformanceReport"
                               asp-route-homeworkSetId="@ViewBag.HomeworkSetId"
                               asp-route-studentId="@s.StudentId"
                               class="btn btn-sm btn-outline-primary">

                                <i class="fa fa-chart-bar"></i>

                            </a>




                        }

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>
</div>
</div>