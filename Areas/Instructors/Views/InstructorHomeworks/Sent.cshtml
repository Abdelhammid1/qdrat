@model IEnumerable<QdratNew.ViewModels.Instructor.Homework.HomeworkSentListVM>

@{
    ViewData["Title"] = "الواجبات المرسلة";
}

@section Styles {
    <link href="~/css/instructor/instructor-homeworks.css" rel="stylesheet" asp-append-version="true" />
}

<div class="container mt-4" dir="rtl">

    <div class="d-flex justify-content-between mb-3">

        <h3 class="fw-bold">
            الواجبات المرسلة
        </h3>

    </div>

    <table class="table table-bordered table-hover align-middle text-center">

        <thead class="table-light">

            <tr>
                <th>العنوان</th>
                <th>عدد الأسئلة</th>
                <th>الطلاب الذين حلوا</th>
                <th>لم يحلوا</th>
                <th>تاريخ الإرسال</th>
                <th>إجراءات</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var hw in Model)
            {
                <tr>

                    <td>@hw.Title</td>

                    <td>@hw.TotalQuestions</td>

                    <td class="text-success fw-bold">
                        @hw.StudentsSolved
                    </td>

                    <td class="text-danger fw-bold">
                        @hw.StudentsPending
                    </td>

                    <td>
                        @hw.SentAt.ToString("yyyy/MM/dd")
                    </td>

                    <td class="text-nowrap">

                        <a asp-action="Details"
                           asp-route-id="@hw.HomeworkId"
                           class="btn btn-sm btn-outline-primary"
                           title="تفاصيل الواجب">

                            <i class="fa fa-eye"></i>

                        </a>

                        <a asp-action="Students"
                           asp-route-homeworkId="@hw.HomeworkId"
                           class="btn btn-sm btn-outline-info"
                           title="الطلاب">

                            <i class="fa fa-users"></i>

                        </a>

                        <a asp-action="Report"
                           asp-route-homeworkId="@hw.HomeworkId"
                           class="btn btn-sm btn-outline-success"
                           title="التقرير">

                            <i class="fa fa-chart-bar"></i>

                        </a>

                        <a asp-action="PreviewQuestions"
                           asp-route-homeworkId="@hw.HomeworkId"
                           class="btn btn-sm btn-outline-secondary"
                           title="مراجعة الأسئلة">

                            <i class="fa fa-list"></i>

                        </a>

                        <form asp-action="Delete"
                              method="post"
                              style="display:inline">

                            <input type="hidden"
                                   name="id"
                                   value="@hw.HomeworkId" />

                            <button class="btn btn-sm btn-danger"
                                    title="حذف الواجب">

                                <i class="fa fa-trash"></i>

                            </button>

                        </form>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>