@model QdratNew.ViewModels.Exam.SectionLessonsViewModel

@{
    ViewData["Title"] = "مؤشرات المحور - " + Model.SectionTitle;
}

@section Styles {
    <link href="~/css/instructor/instructor-homeworks.css" rel="stylesheet" asp-append-version="true" />
}

<div class="instructor-page">

    <div class="hw-page-header">
        <h3 class="hw-page-title">
            <i class="fas fa-layer-group"></i>
            المحور: @Model.SectionTitle
        </h3>
    </div>

    <div class="instructor-card">

        <div class="card-title-box mb-3">
            مؤشرات الأداء داخل المحور
        </div>

        <div class="table-responsive">
            <table class="instructor-table">
                <thead>
                    <tr>
                        <th>المؤشر</th>
                        <th>عدد الأسئلة</th>
                        <th>نسبة النجاح</th>
                        <th>متوسط الزمن (ث)</th>
                        <th>مؤشر الصعوبة</th>
                        <th>الأسئلة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.Lessons)
                    {
                        string successClass = l.AvgSuccessRate >= 80 ? "badge-success"
                                           : l.AvgSuccessRate >= 60 ? "badge-warning"
                                           : "badge-danger";
                        <tr>
                            <td class="fw-semibold">@l.LessonTitle</td>
                            <td>@l.QuestionCount</td>
                            <td>
                                <span class="rate-badge @successClass">@l.AvgSuccessRate %</span>
                            </td>
                            <td>@Math.Round(l.AvgTimeSeconds, 1)</td>
                            <td style="min-width:160px">
                                <div class="difficulty-bar">
                                    <div class="difficulty-fill" style="width:@l.HardnessIndex%"></div>
                                    <span class="difficulty-text">@l.HardnessIndex %</span>
                                </div>
                            </td>
                            <td class="text-center">
                                <a asp-area="Instructors"
                                   asp-controller="InstructorHomeworks"
                                   asp-action="HomeworkLessonQuestionsDetail"
                                   asp-route-homeworkSetId="@Model.HomeworkSetId"
                                   asp-route-lessonId="@l.LessonId"
                                   asp-route-studentId="@Model.StudentId"
                                   class="btn-table-action">
                                    <i class="fas fa-chart-bar"></i> عرض الأسئلة
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>
