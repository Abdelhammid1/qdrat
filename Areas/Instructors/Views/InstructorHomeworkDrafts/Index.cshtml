@model IEnumerable<QdratNew.ViewModels.Partner.HomeworkDraft.HomeworkDraftListVM>

@{
    ViewData["Title"] = "نماذج الواجبات";
}

@section Styles {
    <link href="~/css/instructor/instructor-drafts.css" rel="stylesheet" asp-append-version="true" />
}

<div class="instructor-page">

    <div class="instructor-card">

        <div class="card-title-box">
            <h3><i class="fas fa-file-alt text-primary me-1"></i> نماذج الواجبات</h3>
            <div class="d-flex gap-2">
                <a asp-action="Archived" class="btn btn-sm btn-outline-secondary">
                    <i class="fas fa-box-archive"></i> الأرشيف
                </a>
                <a asp-action="Create" class="btn btn-sm btn-primary">
                    <i class="fas fa-plus"></i> إنشاء نموذج
                </a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="instructor-table">
                <thead>
                    <tr>
                        <th>العنوان</th>
                        <th>الدورة</th>
                        <th>عدد الأسئلة</th>
                        <th>تاريخ الإنشاء</th>
                        <th style="width:220px">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var draft in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@draft.Title</td>
                            <td>@draft.CourseName</td>
                            <td>@draft.TotalQuestions</td>
                            <td>@draft.CreatedAt.ToString("yyyy/MM/dd")</td>
                            <td class="text-nowrap">

                                <a asp-action="Preview"
                                   asp-route-id="@draft.DraftId"
                                   class="btn btn-sm btn-outline-primary"
                                   title="معاينة النموذج">
                                    <i class="fa-solid fa-eye"></i>
                                </a>

                                <a asp-action="SendDraft"
                                   asp-route-draftId="@draft.DraftId"
                                   class="btn btn-sm btn-success"
                                   title="إرسال الواجب">
                                    <i class="fa-solid fa-paper-plane"></i>
                                </a>

                                <form asp-action="Archive" method="post" style="display:inline">
                                    <input type="hidden" name="id" value="@draft.DraftId" />
                                    <button type="submit"
                                            class="btn btn-sm btn-warning"
                                            title="أرشفة"
                                            onclick="return confirm('ترحيل النموذج إلى الأرشيف؟')">
                                        <i class="fa-solid fa-box-archive"></i>
                                    </button>
                                </form>

                                <form asp-action="Delete" method="post" style="display:inline">
                                    <input type="hidden" name="id" value="@draft.DraftId" />
                                    <button type="submit"
                                            class="btn btn-sm btn-danger"
                                            title="حذف"
                                            onclick="return confirm('حذف النموذج نهائيًا؟')">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

</div>
