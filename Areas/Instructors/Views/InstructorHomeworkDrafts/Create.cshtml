@model QdratNew.ViewModels.Partner.Homework.HomeworkDraftCreateVM

@{
    ViewData["Title"] = "إنشاء واجب";
}

@section Styles {
    <link href="~/css/instructor/instructor-drafts.css" rel="stylesheet" asp-append-version="true" />
}

<div class="instructor-page">

    <div class="hw-page-header">
        <h3 class="hw-page-title">
            <i class="fas fa-plus-circle"></i>
            إنشاء واجب جديد
        </h3>
        <a asp-action="Index" class="hw-back-btn ms-auto">
            <i class="fas fa-arrow-right"></i> رجوع
        </a>
    </div>

    @if (!Model.Courses.Any())
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>
            لا توجد دورات متاحة
        </div>
    }
    else
    {
        <div class="instructor-card">
            <div class="card-title-box">
                <h3><i class="fas fa-graduation-cap"></i> اختر الدورة</h3>
            </div>

            <div class="d-flex flex-column gap-2">
                @foreach (var course in Model.Courses)
                {
                    <a asp-action="AutoGenerate"
                       asp-route-courseId="@course.CourseId"
                       class="draft-course-item">
                        <span>@course.CourseName</span>
                        <span class="draft-course-badge">
                            <i class="fas fa-bolt"></i> توليد تلقائي
                        </span>
                    </a>
                }
            </div>
        </div>
    }

</div>
