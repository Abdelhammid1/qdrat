@model QdratNew.ViewModels.Partner.HomeworkDraft.AddHomeworkDraftQuestionVM

@{
    ViewData["Title"] = "إضافة سؤال";
}

@section Styles {
    <link href="~/css/instructor/instructor-drafts.css" rel="stylesheet" asp-append-version="true" />
}

<div class="instructor-page">

    <div class="hw-page-header">
        <h3 class="hw-page-title">
            <i class="fas fa-plus-circle"></i>
            إضافة سؤال للنموذج
        </h3>
    </div>

    <div class="instructor-card">
        <div class="table-responsive">
            <table class="instructor-table">
                <thead>
                    <tr>
                        <th>السؤال</th>
                        <th style="width:160px">إجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in Model.Questions)
                    {
                        <tr>
                            <td>@Html.Raw(q.Title)</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            data-bs-toggle="modal"
                                            data-bs-target="#questionPreviewModal"
                                            data-question-id="@q.QuestionId"
                                            title="معاينة">
                                        <i class="fa fa-eye"></i>
                                    </button>
                                    <form method="post" asp-action="ConfirmAddQuestion">
                                        <input type="hidden" name="draftId" value="@Model.DraftId" />
                                        <input type="hidden" name="questionId" value="@q.QuestionId" />
                                        <button class="btn btn-sm btn-success" title="إضافة">
                                            <i class="fas fa-plus"></i> إضافة
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<div class="modal fade" id="questionPreviewModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">معاينة السؤال</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="questionPreviewContent">
                <div class="text-center text-muted py-5">جاري التحميل...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('questionPreviewModal')
            .addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const questionId = button.getAttribute('data-question-id');
                const container = document.getElementById('questionPreviewContent');
                container.innerHTML = 'جاري التحميل...';
                fetch('/Instructors/InstructorHomeworkDrafts/PreviewQuestion?questionId=' + questionId)
                    .then(r => r.text())
                    .then(html => container.innerHTML = html);
            });
    </script>
}
