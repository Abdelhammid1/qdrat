@model List<QdratNew.Entities.HomeworkDraft>

@{
    ViewData["Title"] = "أرشيف النماذج";
}

@section Styles {
    <link href="~/css/instructor/instructor-drafts.css" rel="stylesheet" asp-append-version="true" />
}

<div class="instructor-page">

    <div class="hw-page-header">
        <div>
            <h3 class="hw-page-title">
                <i class="fas fa-box-archive"></i>
                أرشيف نماذج الواجب
            </h3>
            <p class="text-muted small mb-0">النماذج المؤرشفة لا تظهر في القائمة الرئيسية</p>
        </div>
        <a asp-action="Index" class="hw-back-btn ms-auto">
            <i class="fas fa-arrow-right"></i> رجوع للنماذج
        </a>
    </div>

    <div class="instructor-card">
        <div class="table-responsive">
            <table class="instructor-table">
                <thead>
                    <tr>
                        <th>العنوان</th>
                        <th>عدد الأسئلة</th>
                        <th>تاريخ الإنشاء</th>
                        <th style="width:200px">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                لا توجد نماذج مؤرشفة
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var draft in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@draft.Title</td>
                                <td>@draft.Questions.Count</td>
                                <td>@draft.CreatedAt.ToString("yyyy/MM/dd")</td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-action="Preview"
                                           asp-route-id="@draft.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fa fa-eye"></i> معاينة
                                        </a>
                                        <form asp-action="Restore" method="post">
                                            <input type="hidden" name="id" value="@draft.Id" />
                                            <button class="btn btn-sm btn-success">
                                                <i class="fas fa-rotate-left"></i> استرجاع
                                            </button>
                                        </form>
                                        <form asp-action="Delete" method="post">
                                            <input type="hidden" name="id" value="@draft.Id" />
                                            <button class="btn btn-sm btn-danger"
                                                    onclick="return confirm('هل تريد حذف المسودة نهائياً؟')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
