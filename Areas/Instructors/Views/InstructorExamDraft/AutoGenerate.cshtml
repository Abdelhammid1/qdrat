@model QdratNew.ViewModels.Instructor.Exam.ExamAutoGenerateVM

@{
    ViewData["Title"] = "إعداد نموذج الاختبار";
}

@section Styles {
    <link href="~/css/instructor/instructor-drafts.css" rel="stylesheet" asp-append-version="true" />
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-triangle-exclamation me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-circle-check me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div><i class="fas fa-triangle-exclamation me-1"></i> @error.ErrorMessage</div>
        }
    </div>
}

<div class="instructor-page">

    <div class="hw-page-header">
        <h3 class="hw-page-title">
            <i class="fas fa-gear"></i>
            إعداد نموذج الاختبار
        </h3>
        <a asp-action="Create" class="hw-back-btn ms-auto">
            <i class="fas fa-arrow-right"></i> رجوع
        </a>
    </div>

    <div class="draft-form-card">
        <form method="post">
            <input type="hidden" asp-for="CurriculumId" />

            <div class="mb-4">
                <label class="draft-field-label">عنوان النموذج</label>
                <input asp-for="Title" class="form-control" placeholder="أدخل عنوان النموذج..." />
            </div>

            @for (int i = 0; i < Model.Sections.Count; i++)
            {
                <div class="draft-section-block mb-4">
                    <div class="section-header">
                        <i class="fas fa-book-open"></i>
                        @Model.Sections[i].SectionName
                    </div>
                    <div class="section-body">
                        @for (int j = 0; j < Model.Sections[i].Lessons.Count; j++)
                        {
                            <div class="lesson-row">
                                <div>
                                    <div class="lesson-name">@Model.Sections[i].Lessons[j].LessonName</div>
                                    <div class="lesson-meta">
                                        عدد الأسئلة المتاحة: @Model.Sections[i].Lessons[j].AvailableQuestionsCount
                                    </div>
                                </div>
                                <div>
                                    <input type="hidden"
                                           name="Sections[@i].Lessons[@j].LessonId"
                                           value="@Model.Sections[i].Lessons[j].LessonId" />
                                    <input type="number"
                                           name="Sections[@i].Lessons[@j].SelectedCount"
                                           value="@Model.Sections[i].Lessons[j].SelectedCount"
                                           class="form-control lesson-count-input"
                                           min="0"
                                           max="@Model.Sections[i].Lessons[j].AvailableQuestionsCount" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="text-end">
                <button type="submit" class="btn btn-success px-5">
                    <i class="fas fa-bolt me-1"></i> توليد النموذج
                </button>
            </div>

        </form>
    </div>

</div>
