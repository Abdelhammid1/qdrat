@model QdratNew.ViewModels.Instructor.Exam.ExamDraftCreateVM

@{
    ViewData["Title"] = "إنشاء نموذج اختبار";
}

@section Styles {
    <link href="~/css/instructor/instructor-drafts.css" rel="stylesheet" asp-append-version="true" />
}

<div class="instructor-page">

    <div class="hw-page-header">
        <h3 class="hw-page-title">
            <i class="fas fa-brain"></i>
            إنشاء نموذج اختبار
        </h3>
        <a asp-action="Drafts" class="hw-back-btn ms-auto">
            <i class="fas fa-arrow-right"></i> رجوع
        </a>
    </div>

    <div class="draft-form-card">
        <form method="get" asp-action="AutoGenerate">

            <div class="mb-4">
                <label class="draft-field-label">اختر المنهج</label>
                <select name="curriculumId" class="form-select" required>
                    <option value="">-- اختر المنهج --</option>
                    @foreach (var item in Model.Curriculums)
                    {
                        <option value="@item.Id">@item.Name</option>
                    }
                </select>
            </div>

            <div class="text-end">
                <button type="submit" class="btn btn-primary px-5">
                    التالي <i class="fas fa-arrow-left ms-1"></i>
                </button>
            </div>

        </form>
    </div>

</div>
