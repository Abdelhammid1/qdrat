@model List<QdratNew.ViewModels.Instructor.Exam.ExamDraftVM>

@{
    ViewData["Title"] = "أرشيف نماذج الاختبارات";
}

@section Styles {
    <link href="~/css/instructor/instructor-drafts.css" rel="stylesheet" asp-append-version="true" />
}

<div class="instructor-page">

    <div class="hw-page-header">
        <h3 class="hw-page-title">
            <i class="fas fa-box-archive"></i>
            أرشيف نماذج الاختبارات
        </h3>
        <a asp-action="Drafts" class="hw-back-btn ms-auto">
            <i class="fas fa-arrow-right"></i> رجوع للنماذج
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mb-3">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mb-3">@TempData["Error"]</div>
    }

    <div class="instructor-card">
        <div class="table-responsive">
            <table class="instructor-table">
                <thead>
                    <tr>
                        <th>العنوان</th>
                        <th>عدد الأسئلة</th>
                        <th>تاريخ الإنشاء</th>
                        <th style="width:180px">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                لا توجد نماذج مؤرشفة
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var draft in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@draft.Title</td>
                                <td>@draft.QuestionCount</td>
                                <td>@draft.CreatedAt.ToString("yyyy/MM/dd")</td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <form asp-action="Restore" method="post" style="display:inline">
                                            <input type="hidden" name="id" value="@draft.Id" />
                                            <button type="submit" class="btn btn-sm btn-success" title="استرجاع">
                                                <i class="fa-solid fa-rotate-left"></i>
                                            </button>
                                        </form>
                                        <form asp-action="Delete" method="post" style="display:inline">
                                            <input type="hidden" name="id" value="@draft.Id" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="return confirm('حذف نهائي؟')"
                                                    title="حذف">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
