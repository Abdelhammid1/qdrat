@model QdratNew.ViewModels.Instructor.InterventionTasks.CompleteWithHomeworkVM
@{
    ViewData["Title"] = "إتمام المهمة وإعداد الواجب";
    bool hasQuestions = Model.Questions.Any();
    bool hasLessons   = Model.Lessons.Any();
    bool hasStudents  = Model.Students.Any();
    string homeworkQuestionIdsJson = System.Text.Json.JsonSerializer.Serialize(Model.SelectedHomeworkQuestionIds);
    string lectureQuestionIdsJson  = System.Text.Json.JsonSerializer.Serialize(Model.SelectedLectureQuestionIds);
    string homeworkLessonIdsJson   = System.Text.Json.JsonSerializer.Serialize(Model.SelectedHomeworkLessonIds);
    string lectureLessonIdsJson    = System.Text.Json.JsonSerializer.Serialize(Model.SelectedLectureLessonIds);
}

@section Styles {
<style>
:root {
  --cwh-p:    #4F46E5;
  --cwh-p50:  #EEF2FF;
  --cwh-grn:  #059669;
  --cwh-grn50:#ECFDF5;
  --cwh-amb:  #D97706;
  --cwh-amb50:#FFFBEB;
  --cwh-red:  #DC2626;
  --cwh-red50:#FEF2F2;
  --cwh-bg:   #F0F2FF;
  --cwh-card: #ffffff;
  --cwh-t9:   #0F172A;
  --cwh-t7:   #334155;
  --cwh-t5:   #64748B;
  --cwh-t4:   #94A3B8;
  --cwh-bdr:  #E2E8F0;
  --cwh-sh:   0 1px 4px rgba(15,23,42,.08);
  --cwh-shm:  0 6px 24px rgba(15,23,42,.12);
  --cwh-r:    14px;
  --cwh-font: 'Cairo', sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}

.cwh-page {
  direction: rtl;
  font-family: var(--cwh-font);
  background: var(--cwh-bg);
  min-height: 100vh;
  padding: 20px 0 80px;
}

/* ── Hero ── */
.cwh-hero {
  background: linear-gradient(135deg, #1e3a8a 0%, #4F46E5 100%);
  border-radius: var(--cwh-r);
  padding: 24px 28px;
  margin-bottom: 24px;
  color:#fff;
  position: relative;
  overflow: hidden;
}
.cwh-hero::before {
  content:'';position:absolute;inset:0;
  background:url("data:image/svg+xml,%3Csvg width='40' height='40' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='20' cy='20' r='1' fill='%23ffffff' fill-opacity='0.07'/%3E%3C/svg%3E");
}
.cwh-hero-inner{position:relative;display:flex;align-items:flex-start;justify-content:space-between;gap:20px;flex-wrap:wrap}
.cwh-hero-eyebrow{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.6);margin-bottom:6px}
.cwh-hero-title{font-size:clamp(18px,2.5vw,24px);font-weight:900;margin-bottom:4px}
.cwh-hero-sub{font-size:13px;color:rgba(255,255,255,.7)}
.cwh-hero-step{
  background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.25);
  border-radius:10px;padding:12px 18px;text-align:center;flex-shrink:0;min-width:110px
}
.cwh-hero-step-num{font-size:26px;font-weight:900;display:block}
.cwh-hero-step-lbl{font-size:11px;color:rgba(255,255,255,.7);font-weight:600}

/* ── Section card ── */
.cwh-section {
  background: var(--cwh-card);
  border: 1px solid var(--cwh-bdr);
  border-radius: var(--cwh-r);
  box-shadow: var(--cwh-sh);
  margin-bottom: 20px;
  overflow: hidden;
}
.cwh-section-head {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 20px;
  border-bottom: 1px solid var(--cwh-bdr);
  background: #fafbff;
}
.cwh-section-icon {
  width: 36px;height: 36px;border-radius: 10px;
  display:flex;align-items:center;justify-content:center;
  font-size:15px;flex-shrink:0;
}
.cwh-si-blue   {background:#eff6ff;color:#2563eb}
.cwh-si-purple {background:#f5f3ff;color:#7c3aed}
.cwh-si-green  {background:#f0fdf4;color:#059669}
.cwh-si-amber  {background:#fffbeb;color:#d97706}
.cwh-si-rose   {background:#fff1f2;color:#e11d48}

.cwh-section-title{font-size:15px;font-weight:800;color:var(--cwh-t9)}
.cwh-section-sub  {font-size:12px;color:var(--cwh-t5);margin-top:2px}
.cwh-section-body {padding:20px}

/* ── Question / Lesson card ── */
.cwh-item-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 14px;
}
.cwh-item {
  border: 2px solid var(--cwh-bdr);
  border-radius: 12px;
  padding: 14px;
  cursor: pointer;
  transition: all .18s ease;
  background: #fafbff;
  position: relative;
}
.cwh-item:hover { border-color: var(--cwh-p); background: var(--cwh-p50); }
.cwh-item-title {
  font-size: 13px;font-weight: 700;color: var(--cwh-t9);
  margin-bottom: 6px;line-height: 1.4;
}
.cwh-item-meta {
  display: flex;flex-wrap: wrap;gap: 6px;margin-bottom: 10px;
}
.cwh-chip {
  font-size: 11px;font-weight: 700;border-radius: 6px;
  padding: 2px 8px;display:inline-flex;align-items:center;gap:3px;
}
.cwh-chip-err  {background:#fee2e2;color:#b91c1c}
.cwh-chip-risk-Critical {background:#fee2e2;color:#b91c1c}
.cwh-chip-risk-High     {background:#ffedd5;color:#c2410c}
.cwh-chip-risk-Medium   {background:#fef9c3;color:#92400e}
.cwh-chip-risk-Low      {background:#dcfce7;color:#15803d}
.cwh-chip-stu  {background:#ede9fe;color:#6d28d9}
.cwh-chip-les  {background:#dbeafe;color:#1d4ed8}

/* ── action toggle ── */
.cwh-item-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
}
.cwh-action-btn {
  display: flex;align-items: center;justify-content: center;gap: 6px;
  border: 2px solid var(--cwh-bdr);border-radius: 8px;
  padding: 7px 6px;font-size: 12px;font-weight: 700;
  cursor: pointer;transition: all .15s;background: #fff;
  color: var(--cwh-t7);font-family: var(--cwh-font);
}
.cwh-action-btn:hover { border-color: var(--cwh-p); color: var(--cwh-p); }
.cwh-action-btn.selected-lecture {
  border-color: var(--cwh-grn);background: var(--cwh-grn50);color: var(--cwh-grn);
}
.cwh-action-btn.selected-homework {
  border-color: var(--cwh-p);background: var(--cwh-p50);color: var(--cwh-p);
}
/* checkmark on selected */
.cwh-item.sel-lecture  { border-color: var(--cwh-grn)!important; }
.cwh-item.sel-homework { border-color: var(--cwh-p)!important;   }

/* ── hidden inputs container ── */
#hiddenInputs { display:none; }

/* ── Send options ── */
.cwh-send-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin-bottom: 20px;
}
.cwh-send-opt {
  border: 2px solid var(--cwh-bdr);border-radius: 12px;padding: 16px;
  cursor: pointer;transition: all .15s;background: #fafbff;
  display: flex;align-items: flex-start;gap: 12px;
}
.cwh-send-opt:hover { border-color: var(--cwh-p); background: var(--cwh-p50); }
.cwh-send-opt.active { border-color: var(--cwh-p); background: var(--cwh-p50); }
.cwh-send-opt input[type="radio"] { margin-top: 2px; accent-color: var(--cwh-p); }
.cwh-send-opt-icon {
  width:38px;height:38px;border-radius:10px;background:var(--cwh-p50);color:var(--cwh-p);
  display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;
}
.cwh-send-opt-title { font-size: 14px;font-weight: 800;color: var(--cwh-t9); }
.cwh-send-opt-sub   { font-size: 12px;color: var(--cwh-t5);margin-top:2px; }

/* ── Student list ── */
.cwh-stu-search {
  width:100%;border:1.5px solid var(--cwh-bdr);border-radius:10px;
  padding:9px 14px;font-family:var(--cwh-font);font-size:13px;
  margin-bottom:12px;outline:none;transition:border-color .15s;
}
.cwh-stu-search:focus { border-color: var(--cwh-p); }
.cwh-stu-controls {
  display:flex;gap:8px;margin-bottom:12px;
}
.cwh-stu-ctrl-btn {
  font-size:12px;font-weight:700;border:1.5px solid var(--cwh-bdr);
  border-radius:8px;padding:5px 12px;cursor:pointer;background:#fff;
  font-family:var(--cwh-font);color:var(--cwh-t7);transition:all .15s;
}
.cwh-stu-ctrl-btn:hover { border-color:var(--cwh-p);color:var(--cwh-p); }
.cwh-stu-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 8px;
  max-height: 300px;
  overflow-y: auto;
  border: 1.5px solid var(--cwh-bdr);
  border-radius: 10px;
  padding: 10px;
}
.cwh-stu-item {
  display: flex;align-items: center;gap: 8px;
  border: 1.5px solid var(--cwh-bdr);border-radius: 8px;
  padding: 7px 10px;cursor: pointer;
  transition: all .15s;background: #fafbff;
}
.cwh-stu-item:hover { border-color: var(--cwh-p);background: var(--cwh-p50); }
.cwh-stu-item.checked { border-color: var(--cwh-p);background: var(--cwh-p50); }
.cwh-stu-item input { accent-color: var(--cwh-p);flex-shrink:0; }
.cwh-stu-name { font-size: 12px;font-weight: 700;color: var(--cwh-t9); }
#stuPanel { display:none; }

/* ── Fields ── */
.cwh-field { margin-bottom: 16px; }
.cwh-label {
  display: block;font-size: 13px;font-weight: 700;
  color: var(--cwh-t7);margin-bottom: 6px;
}
.cwh-input, .cwh-textarea {
  width: 100%;border: 1.5px solid var(--cwh-bdr);border-radius: 10px;
  padding: 10px 14px;font-family: var(--cwh-font);font-size: 13px;
  color: var(--cwh-t9);outline: none;transition: border-color .15s;background: #fff;
}
.cwh-input:focus, .cwh-textarea:focus { border-color: var(--cwh-p); }
.cwh-textarea { resize: vertical;min-height: 80px; }

/* ── Sticky bar ── */
.cwh-bar {
  position: fixed;bottom: 0;left: 0;right: 0;z-index: 999;
  background: rgba(255,255,255,.92);backdrop-filter: blur(10px);
  border-top: 1px solid var(--cwh-bdr);
  box-shadow: 0 -4px 20px rgba(15,23,42,.10);
  padding: 14px 24px;
  display: flex;align-items: center;justify-content: space-between;gap: 12px;flex-wrap: wrap;
}
.cwh-bar-info { font-size: 13px;font-weight: 700;color: var(--cwh-t7); }
.cwh-bar-info span { color: var(--cwh-p); font-size: 18px; }
.cwh-bar-btns { display:flex;gap:10px; }
.cwh-btn {
  display:inline-flex;align-items:center;gap:7px;
  border-radius: 10px;font-family: var(--cwh-font);font-size: 13px;font-weight: 700;
  padding: 10px 22px;text-decoration: none;cursor: pointer;border: none;transition: all .18s;
}
.cwh-btn-primary   { background: var(--cwh-p);color: #fff;box-shadow:0 2px 8px rgba(79,70,229,.3); }
.cwh-btn-primary:hover { background: #3730a3;transform:translateY(-1px); }
.cwh-btn-secondary { background: #f1f5f9;color: var(--cwh-t7); }
.cwh-btn-secondary:hover { background: #e2e8f0; }

/* ── Empty state ── */
.cwh-empty {
  text-align:center;padding:32px;color:var(--cwh-t4);
}
.cwh-empty i { font-size:36px;display:block;margin-bottom:10px; }

/* ── Summary badges (bar) ── */
.cwh-sum-badge {
  display:inline-flex;align-items:center;gap:5px;
  border-radius:8px;padding:4px 10px;font-size:12px;font-weight:700;
}
.cwh-sum-lec { background: var(--cwh-grn50);color: var(--cwh-grn); }
.cwh-sum-hw  { background: var(--cwh-p50);  color: var(--cwh-p);   }

/* ── Responsive ── */
@@media (max-width:640px){
  .cwh-send-grid { grid-template-columns:1fr; }
  .cwh-item-grid { grid-template-columns:1fr; }
  .cwh-bar { flex-direction:column;align-items:stretch; }
  .cwh-bar-btns { justify-content:flex-end; }
}
</style>
}

<div class="cwh-page">
  <div class="container-fluid" style="max-width:1100px;padding:0 16px">

    <!-- Hero -->
    <div class="cwh-hero">
      <div class="cwh-hero-inner">
        <div>
          <div class="cwh-hero-eyebrow">DecisionLab · إتمام مهمة التدخل</div>
          <div class="cwh-hero-title">@Model.TaskTitle</div>
          <div class="cwh-hero-sub">الدفعة: <strong style="color:#fff">@Model.BatchName</strong></div>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap">
          <div class="cwh-hero-step">
            <span class="cwh-hero-step-num">@Model.Questions.Count</span>
            <span class="cwh-hero-step-lbl">سؤال معرّض للخطر</span>
          </div>
          <div class="cwh-hero-step">
            <span class="cwh-hero-step-num">@Model.Lessons.Count</span>
            <span class="cwh-hero-step-lbl">مؤشر ضعيف</span>
          </div>
          <div class="cwh-hero-step">
            <span class="cwh-hero-step-num">@Model.Students.Count</span>
            <span class="cwh-hero-step-lbl">طالب في الدفعة</span>
          </div>
        </div>
      </div>
      @if (!string.IsNullOrWhiteSpace(Model.OwnerInstructions))
      {
        <div style="margin-top:14px;background:rgba(255,255,255,.12);border-radius:10px;padding:12px 16px;font-size:13px;color:rgba(255,255,255,.9)">
          <i class="fas fa-user-tie me-2" style="opacity:.7"></i>@Model.OwnerInstructions
        </div>
      }
    </div>

    <form id="cwh-form" method="post"
          asp-area="Instructors"
          asp-controller="InstructorInterventionTasks"
          asp-action="SubmitCompletion">
      @Html.AntiForgeryToken()
      <input type="hidden" name="TaskId" value="@Model.TaskId" />

      <!-- ═══ QUESTIONS ═══ -->
      <div class="cwh-section">
        <div class="cwh-section-head">
          <div class="cwh-section-icon cwh-si-rose"><i class="fas fa-circle-exclamation"></i></div>
          <div>
            <div class="cwh-section-title">الأسئلة عالية الخطورة</div>
            <div class="cwh-section-sub">لكل سؤال: هل تمّ حله في المحاضرة أم يُرسل كواجب؟</div>
          </div>
          @if (hasQuestions)
          {
            <div style="margin-right:auto;display:flex;gap:8px">
              <button type="button" class="cwh-stu-ctrl-btn" onclick="bulkSetQuestions('lecture')">
                <i class="fas fa-chalkboard me-1"></i>كلها محاضرة
              </button>
              <button type="button" class="cwh-stu-ctrl-btn" onclick="bulkSetQuestions('homework')">
                <i class="fas fa-book-open me-1"></i>كلها واجب
              </button>
            </div>
          }
        </div>
        <div class="cwh-section-body">
          @if (hasQuestions)
          {
            <div class="cwh-item-grid" id="questionsGrid">
              @foreach (var q in Model.Questions)
              {
                string riskCss = q.RiskLevel switch {
                  "Critical" => "cwh-chip-risk-Critical",
                  "High"     => "cwh-chip-risk-High",
                  "Medium"   => "cwh-chip-risk-Medium",
                  _          => "cwh-chip-risk-Low"
                };
                <div class="cwh-item" id="qcard-@q.QuestionId" data-qid="@q.QuestionId">
                  @if (!string.IsNullOrWhiteSpace(q.ReferenceNumber))
                  {
                    <div style="font-size:10px;color:var(--cwh-t4);margin-bottom:4px"># @q.ReferenceNumber</div>
                  }
                  <div class="cwh-item-title">@q.QuestionTitle</div>
                  <div class="cwh-item-meta">
                    <span class="cwh-chip cwh-chip-les"><i class="fas fa-book"></i>@q.LessonTitle</span>
                    <span class="cwh-chip cwh-chip-err"><i class="fas fa-percent"></i>@q.ErrorPercentage.ToString("F0")% خطأ</span>
                    <span class="cwh-chip @riskCss">@q.RiskLevel</span>
                    <span class="cwh-chip cwh-chip-stu"><i class="fas fa-users"></i>@q.AffectedStudentsCount طالب</span>
                  </div>
                  <div class="cwh-item-actions">
                    <button type="button" class="cwh-action-btn" id="q-lec-@q.QuestionId"
                            onclick="setQuestionAction('@q.QuestionId','lecture')">
                      <i class="fas fa-chalkboard-user"></i>حُلّ في المحاضرة
                    </button>
                    <button type="button" class="cwh-action-btn" id="q-hw-@q.QuestionId"
                            onclick="setQuestionAction('@q.QuestionId','homework')">
                      <i class="fas fa-paper-plane"></i>أرسل كواجب
                    </button>
                  </div>
                </div>
              }
            </div>
          }
          else
          {
            <div class="cwh-empty"><i class="fas fa-circle-check"></i><p>لا توجد أسئلة مرفقة بالمهمة.</p></div>
          }
        </div>
      </div>

      <!-- ═══ LESSONS ═══ -->
      @if (hasLessons)
      {
        <div class="cwh-section">
          <div class="cwh-section-head">
            <div class="cwh-section-icon cwh-si-blue"><i class="fas fa-book-open"></i></div>
            <div>
              <div class="cwh-section-title">المؤشرات (الدروس) الضعيفة</div>
              <div class="cwh-section-sub">وضّح كيف تعاملت مع كل مؤشر في المحاضرة</div>
            </div>
            <div style="margin-right:auto;display:flex;gap:8px">
              <button type="button" class="cwh-stu-ctrl-btn" onclick="bulkSetLessons('lecture')">كلها تمّت</button>
              <button type="button" class="cwh-stu-ctrl-btn" onclick="bulkSetLessons('homework')">كلها واجب</button>
            </div>
          </div>
          <div class="cwh-section-body">
            <div class="cwh-item-grid">
              @foreach (var l in Model.Lessons)
              {
                string lriskCss = l.RiskLevel switch {
                  "Critical" => "cwh-chip-risk-Critical",
                  "High"     => "cwh-chip-risk-High",
                  "Medium"   => "cwh-chip-risk-Medium",
                  _          => "cwh-chip-risk-Low"
                };
                <div class="cwh-item" id="lcard-@l.LessonId" data-lid="@l.LessonId">
                  <div class="cwh-item-title">@l.LessonTitle</div>
                  <div class="cwh-item-meta">
                    <span class="cwh-chip cwh-chip-les"><i class="fas fa-layer-group"></i>@l.SectionTitle</span>
                    <span class="cwh-chip cwh-chip-err"><i class="fas fa-percent"></i>@l.ErrorPercentage.ToString("F0")% خطأ</span>
                    <span class="cwh-chip @lriskCss">@l.RiskLevel</span>
                    <span class="cwh-chip cwh-chip-stu"><i class="fas fa-question"></i>@l.RelatedQuestionsCount سؤال</span>
                  </div>
                  <div class="cwh-item-actions">
                    <button type="button" class="cwh-action-btn" id="l-lec-@l.LessonId"
                            onclick="setLessonAction(@l.LessonId,'lecture')">
                      <i class="fas fa-chalkboard-user"></i>تمّ في المحاضرة
                    </button>
                    <button type="button" class="cwh-action-btn" id="l-hw-@l.LessonId"
                            onclick="setLessonAction(@l.LessonId,'homework')">
                      <i class="fas fa-paper-plane"></i>يرحل كواجب
                    </button>
                  </div>
                </div>
              }
            </div>
          </div>
        </div>
      }

      <!-- ═══ HOMEWORK SETTINGS ═══ -->
      @if (hasQuestions)
      {
        <div class="cwh-section">
          <div class="cwh-section-head">
            <div class="cwh-section-icon cwh-si-purple"><i class="fas fa-paper-plane"></i></div>
            <div>
              <div class="cwh-section-title">إعدادات الواجب</div>
              <div class="cwh-section-sub">يُرسل فقط للأسئلة المصنّفة كـ"واجب" أعلاه</div>
            </div>
          </div>
          <div class="cwh-section-body">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
              <div class="cwh-field">
                <label class="cwh-label" for="hw-title">عنوان الواجب</label>
                <input type="text" class="cwh-input" id="hw-title" name="HomeworkTitle"
                       value="@Model.SuggestedHomeworkTitle" required />
              </div>
              <div class="cwh-field">
                <label class="cwh-label" for="hw-end">موعد انتهاء الواجب</label>
                <input type="datetime-local" class="cwh-input" id="hw-end" name="HomeworkEndAt"
                       value="@Model.HomeworkEndAt.ToString("yyyy-MM-ddTHH:mm")" required />
              </div>
            </div>
          </div>
        </div>

        <!-- ═══ SEND TO ═══ -->
        <div class="cwh-section">
          <div class="cwh-section-head">
            <div class="cwh-section-icon cwh-si-green"><i class="fas fa-users"></i></div>
            <div>
              <div class="cwh-section-title">إرسال الواجب إلى</div>
              <div class="cwh-section-sub">اختر نطاق إرسال الواجب</div>
            </div>
          </div>
          <div class="cwh-section-body">
            <div class="cwh-send-grid">
              <label class="cwh-send-opt active" id="opt-batch" onclick="setSendTo('Batch')">
                <input type="radio" name="SendTo" value="Batch" checked onchange="setSendTo('Batch')" />
                <div class="cwh-send-opt-icon"><i class="fas fa-users"></i></div>
                <div>
                  <div class="cwh-send-opt-title">الدفعة كاملة</div>
                  <div class="cwh-send-opt-sub">يُرسل الواجب لجميع طلاب دفعة @Model.BatchName (@Model.Students.Count طالب)</div>
                </div>
              </label>
              <label class="cwh-send-opt" id="opt-students" onclick="setSendTo('Students')">
                <input type="radio" name="SendTo" value="Students" onchange="setSendTo('Students')" />
                <div class="cwh-send-opt-icon" style="background:#f0fdf4;color:#059669"><i class="fas fa-user-check"></i></div>
                <div>
                  <div class="cwh-send-opt-title">طلاب محددون</div>
                  <div class="cwh-send-opt-sub">اختر الطلاب يدوياً من قائمة دفعة المهمة</div>
                </div>
              </label>
            </div>

            <!-- Student picker -->
            <div id="stuPanel">
              <input type="text" class="cwh-stu-search" id="stuSearch"
                     placeholder="ابحث عن طالب..." oninput="filterStudents()" />
              <div class="cwh-stu-controls">
                <button type="button" class="cwh-stu-ctrl-btn" onclick="selectAllStudents()">تحديد الكل</button>
                <button type="button" class="cwh-stu-ctrl-btn" onclick="deselectAllStudents()">إلغاء الكل</button>
                <span id="stuSelCount" style="font-size:12px;color:var(--cwh-t5);margin-right:auto;align-self:center">
                  0 طالب محدد
                </span>
              </div>
              <div class="cwh-stu-grid" id="stuGrid">
                @foreach (var s in Model.Students)
                {
                  <label class="cwh-stu-item" id="stu-@s.StudentId">
                    <input type="checkbox" name="SelectedStudentIds" value="@s.StudentId"
                           onchange="updateStudentCount()" class="stu-chk" />
                    <span class="cwh-stu-name">@s.FullName</span>
                  </label>
                }
              </div>
            </div>
          </div>
        </div>
      }

      <!-- ═══ EXECUTION NOTES ═══ -->
      <div class="cwh-section">
        <div class="cwh-section-head">
          <div class="cwh-section-icon cwh-si-amber"><i class="fas fa-pen-to-square"></i></div>
          <div>
            <div class="cwh-section-title">ملاحظات التنفيذ</div>
            <div class="cwh-section-sub">سجّل ما نفّذته في المحاضرة (اختياري)</div>
          </div>
        </div>
        <div class="cwh-section-body">
          <textarea class="cwh-textarea" name="ExecutionNotes" rows="4"
                    placeholder="مثال: تمّ شرح الأسئلة ذات نسبة الخطأ العالية وحل 3 أسئلة نموذجية. الأسئلة المتبقية أُرسلت كواجب..."></textarea>
        </div>
      </div>

      <!-- Hidden inputs populated by JS -->
      <div id="hiddenInputs"></div>

    </form><!-- end form -->
  </div><!-- container -->
</div><!-- page -->

<!-- ═══ STICKY BAR ═══ -->
<div class="cwh-bar">
  <div class="cwh-bar-info">
    <span id="bar-hw-count">0</span> سؤال كواجب &nbsp;·&nbsp;
    <span id="bar-lec-count">0</span> سؤال محاضرة
  </div>
  <div class="cwh-bar-btns">
    <a class="cwh-btn cwh-btn-secondary"
       asp-area="Instructors" asp-controller="InstructorInterventionTasks"
       asp-action="Details" asp-route-id="@Model.TaskId">
      <i class="fas fa-arrow-right"></i>رجوع
    </a>
    <button type="button" class="cwh-btn cwh-btn-primary" onclick="submitForm()">
      <i class="fas fa-check-double"></i>إتمام المهمة وإرسال الواجب
    </button>
  </div>
</div>

@section Scripts {
<script>
/* ── State ── */
const qState  = {};   // questionId -> 'lecture' | 'homework' | null
const lState  = {};   // lessonId   -> 'lecture' | 'homework' | null
const carriedHomeworkQuestionIds = @Html.Raw(homeworkQuestionIdsJson);
const carriedLectureQuestionIds  = @Html.Raw(lectureQuestionIdsJson);
const carriedHomeworkLessonIds   = @Html.Raw(homeworkLessonIdsJson);
const carriedLectureLessonIds    = @Html.Raw(lectureLessonIdsJson);

/* ── Question actions ── */
function setQuestionAction(qid, action) {
    qState[qid] = action;
    const card   = document.getElementById('qcard-' + qid);
    const btnLec = document.getElementById('q-lec-' + qid);
    const btnHw  = document.getElementById('q-hw-'  + qid);
    if (!card || !btnLec || !btnHw) {
        updateBar();
        return;
    }
    card.classList.remove('sel-lecture','sel-homework');
    btnLec.classList.remove('selected-lecture','selected-homework');
    btnHw.classList.remove('selected-lecture','selected-homework');
    if (action === 'lecture') {
        card.classList.add('sel-lecture');
        btnLec.classList.add('selected-lecture');
    } else {
        card.classList.add('sel-homework');
        btnHw.classList.add('selected-homework');
    }
    updateBar();
}

function bulkSetQuestions(action) {
    document.querySelectorAll('[id^="qcard-"]').forEach(card => {
        const qid = card.dataset.qid;
        if (qid) setQuestionAction(qid, action);
    });
}

/* ── Lesson actions ── */
function setLessonAction(lid, action) {
    lState[lid] = action;
    const card   = document.getElementById('lcard-' + lid);
    const btnLec = document.getElementById('l-lec-' + lid);
    const btnHw  = document.getElementById('l-hw-'  + lid);
    if (!card || !btnLec || !btnHw) {
        return;
    }
    card.classList.remove('sel-lecture','sel-homework');
    btnLec.classList.remove('selected-lecture','selected-homework');
    btnHw.classList.remove('selected-lecture','selected-homework');
    if (action === 'lecture') {
        card.classList.add('sel-lecture');
        btnLec.classList.add('selected-lecture');
    } else if (action === 'homework') {
        card.classList.add('sel-homework');
        btnHw.classList.add('selected-homework');
    }
}

function bulkSetLessons(action) {
    document.querySelectorAll('[id^="lcard-"]').forEach(card => {
        const lid = parseInt(card.dataset.lid);
        if (lid) setLessonAction(lid, action);
    });
}

/* ── Send-to toggle ── */
function setSendTo(val) {
    document.getElementById('opt-batch').classList.toggle('active', val === 'Batch');
    document.getElementById('opt-students').classList.toggle('active', val === 'Students');
    const stuPanel = document.getElementById('stuPanel');
    if (stuPanel) stuPanel.style.display = val === 'Students' ? 'block' : 'none';
}

/* ── Student search ── */
function filterStudents() {
    const q = document.getElementById('stuSearch').value.toLowerCase();
    document.querySelectorAll('.cwh-stu-item').forEach(item => {
        const name = item.querySelector('.cwh-stu-name').textContent.toLowerCase();
        item.style.display = name.includes(q) ? '' : 'none';
    });
}
function selectAllStudents() {
    document.querySelectorAll('.stu-chk').forEach(c => { c.checked = true; c.closest('.cwh-stu-item').classList.add('checked'); });
    updateStudentCount();
}
function deselectAllStudents() {
    document.querySelectorAll('.stu-chk').forEach(c => { c.checked = false; c.closest('.cwh-stu-item').classList.remove('checked'); });
    updateStudentCount();
}
function updateStudentCount() {
    const n = document.querySelectorAll('.stu-chk:checked').length;
    const el = document.getElementById('stuSelCount');
    if (el) el.textContent = n + ' طالب محدد';
    document.querySelectorAll('.cwh-stu-item').forEach(item => {
        item.classList.toggle('checked', item.querySelector('.stu-chk').checked);
    });
}

/* ── Bar counters ── */
function updateBar() {
    const hw  = Object.values(qState).filter(v => v === 'homework').length;
    const lec = Object.values(qState).filter(v => v === 'lecture').length;
    document.getElementById('bar-hw-count').textContent  = hw;
    document.getElementById('bar-lec-count').textContent = lec;
}

function applyCarriedSelections() {
    if (Array.isArray(carriedHomeworkQuestionIds)) {
        carriedHomeworkQuestionIds.forEach(qid => {
            if (qid) setQuestionAction(qid, 'homework');
        });
    }

    if (Array.isArray(carriedLectureQuestionIds)) {
        carriedLectureQuestionIds.forEach(qid => {
            if (qid && !qState[qid]) setQuestionAction(qid, 'lecture');
        });
    }

    if (Array.isArray(carriedHomeworkLessonIds)) {
        carriedHomeworkLessonIds.forEach(lid => {
            if (lid) setLessonAction(lid, 'homework');
        });
    }

    if (Array.isArray(carriedLectureLessonIds)) {
        carriedLectureLessonIds.forEach(lid => {
            if (lid && !lState[lid]) setLessonAction(lid, 'lecture');
        });
    }

    updateBar();
}

/* ── Submit ── */
function submitForm() {
    const container = document.getElementById('hiddenInputs');
    container.innerHTML = '';

    // Homework questions
    Object.entries(qState).forEach(([qid, action]) => {
        const inp = document.createElement('input');
        inp.type = 'hidden';
        inp.name = action === 'homework' ? 'HomeworkQuestionIds' : 'LectureQuestionIds';
        inp.value = qid;
        container.appendChild(inp);
    });

    // Lessons
    Object.entries(lState).forEach(([lid, action]) => {
        if (action === 'lecture' || action === 'homework') {
            const inp = document.createElement('input');
            inp.type = 'hidden';
            inp.name = action === 'homework' ? 'HomeworkLessonIds' : 'LectureLessonIds';
            inp.value = lid;
            container.appendChild(inp);
        }
    });

    document.getElementById('cwh-form').submit();
}

/* ── Init ── */
applyCarriedSelections();
</script>
}
