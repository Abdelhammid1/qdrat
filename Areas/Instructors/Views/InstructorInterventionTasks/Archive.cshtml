@model List<QdratNew.ViewModels.Instructor.InterventionTasks.InstructorTaskListItemVM>

@{
    ViewData["Title"] = "أرشيف المهام المكتملة";

    string PriorityBadge(string priority) => priority switch
    {
        "High"   => "badge bg-danger",
        "Medium" => "badge bg-warning text-dark",
        "Low"    => "badge bg-secondary",
        _        => "badge bg-light text-dark"
    };

    string PriorityLabel(string priority) => priority switch
    {
        "High"   => "عالية",
        "Medium" => "متوسطة",
        "Low"    => "منخفضة",
        _        => priority
    };
}

<div class="qdrat-instructor-page" dir="rtl">

    <div class="page-hero mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <div class="hero-label">
                    <i class="bi bi-archive me-1"></i>
                    منطقة المدرب
                </div>
                <h1 class="mb-1">أرشيف المهام المكتملة</h1>
                <p class="text-muted mb-0">المهام التي أنهيتها ونقلتها إلى الأرشيف.</p>
            </div>
            <a asp-area="Instructors"
               asp-controller="InstructorInterventionTasks"
               asp-action="Index"
               class="btn btn-outline-primary btn-sm">
                <i class="bi bi-arrow-right me-1"></i>
                العودة للمهام
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-archive fs-1 text-muted d-block mb-3"></i>
            <h5 class="text-muted">الأرشيف فارغ حالياً</h5>
            <p class="text-muted small">المهام المكتملة التي تنقلها ستظهر هنا.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var task in Model)
            {
                <div class="col-12">
                    <div class="card shadow-sm border-0 h-100" style="opacity:.85;">
                        <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">

                            <div class="flex-grow-1">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                    <span class="badge bg-success">
                                        <i class="bi bi-archive-fill me-1"></i>مؤرشفة
                                    </span>
                                    <span class="@PriorityBadge(task.Priority)">@PriorityLabel(task.Priority)</span>
                                    <span class="badge bg-light text-dark border">@task.TaskType</span>
                                </div>
                                <h6 class="mb-1 fw-bold">@task.Title</h6>
                                <small class="text-muted">
                                    <i class="bi bi-people me-1"></i>@task.BatchName
                                    @if (task.DueDate.HasValue)
                                    {
                                        <span class="ms-3">
                                            <i class="bi bi-calendar-event me-1"></i>
                                            الاستحقاق: @task.DueDate.Value.ToString("yyyy/MM/dd")
                                        </span>
                                    }
                                    <span class="ms-3">
                                        <i class="bi bi-clock-history me-1"></i>
                                        تاريخ الإنشاء: @task.CreatedAt.ToString("yyyy/MM/dd")
                                    </span>
                                </small>
                            </div>

                            <div>
                                <a asp-area="Instructors"
                                   asp-controller="InstructorInterventionTasks"
                                   asp-action="Details"
                                   asp-route-id="@task.Id"
                                   class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-eye me-1"></i>
                                    عرض التفاصيل
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
