@model List<QdratNew.ViewModels.Instructor.InterventionTasks.InstructorTaskListItemVM>

@{
    ViewData["Title"] = "مهام التدخل التعليمي";

    string StatusBadge(string status) => status switch
    {
        "Assigned"               => "badge bg-primary",
        "InProgress"             => "badge bg-warning text-dark",
        "NeedsFollowUp"          => "badge bg-danger",
        "CompletedByInstructor"  => "badge bg-success",
        _                        => "badge bg-secondary"
    };

    string StatusLabel(string status) => status switch
    {
        "Assigned"               => "مُسندة",
        "InProgress"             => "قيد التنفيذ",
        "NeedsFollowUp"          => "تحتاج متابعة",
        "CompletedByInstructor"  => "مكتملة",
        _                        => status
    };

    string PriorityBadge(string priority) => priority switch
    {
        "High"   => "badge bg-danger",
        "Medium" => "badge bg-warning text-dark",
        "Low"    => "badge bg-secondary",
        _        => "badge bg-light text-dark"
    };

    string PriorityLabel(string priority) => priority switch
    {
        "High"   => "عالية",
        "Medium" => "متوسطة",
        "Low"    => "منخفضة",
        _        => priority
    };

    var activeTasks    = Model.Where(t => t.Status != "ArchivedByInstructor").ToList();
    var completedCount = activeTasks.Count(t => t.Status == "CompletedByInstructor");
}

<div class="qdrat-instructor-page" dir="rtl">

    <div class="page-hero mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <div class="hero-label">
                    <i class="bi bi-clipboard-check me-1"></i>
                    منطقة المدرب
                </div>
                <h1 class="mb-1">مهام التدخل التعليمي</h1>
                <p class="text-muted mb-0">المهام المُسندة إليك من الإدارة لتحسين أداء الدفعات.</p>
            </div>
            <a asp-area="Instructors"
               asp-controller="InstructorInterventionTasks"
               asp-action="Archive"
               class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-archive me-1"></i>
                أرشيف المكتمل
            </a>
        </div>
    </div>

    <div class="alert alert-info d-flex align-items-start gap-2 mb-4" role="alert">
        <i class="bi bi-info-circle-fill fs-5 mt-1 flex-shrink-0"></i>
        <div>
            <strong>تنبيه:</strong>
            هذه المهام مرسلة من الإدارة لتحسين أداء الدفعة في نقطة ضعف محددة.
            يُرجى مراجعة تفاصيل كل مهمة، البدء في تنفيذها، وتعليمها مكتملة مع كتابة ملاحظاتك.
        </div>
    </div>

    @if (!activeTasks.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
            <h5 class="text-muted">لا توجد مهام مُسندة إليك حالياً</h5>
            <p class="text-muted small">ستظهر هنا المهام التي ترسلها الإدارة لتحسين أداء الدفعات.</p>
        </div>
    }
    else
    {
        <form asp-area="Instructors"
              asp-controller="InstructorInterventionTasks"
              asp-action="ArchiveTasks"
              method="post"
              id="archiveForm">
            @Html.AntiForgeryToken()

            @if (completedCount > 0)
            {
                <div class="d-flex align-items-center justify-content-between bg-success bg-opacity-10 border border-success rounded-3 px-3 py-2 mb-3 gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <input type="checkbox" id="selectAll" class="form-check-input mt-0" style="width:1.1rem;height:1.1rem;" />
                        <label for="selectAll" class="mb-0 text-success fw-semibold">
                            <i class="bi bi-check2-all me-1"></i>
                            تحديد جميع المكتملة
                            <span class="badge bg-success ms-1">@completedCount</span>
                        </label>
                    </div>
                    <button type="button"
                            class="btn btn-success btn-sm"
                            id="archiveBtn"
                            disabled
                            onclick="confirmArchive()">
                        <i class="bi bi-archive-fill me-1"></i>
                        نقل المحدد إلى الأرشيف
                    </button>
                </div>
            }

            <div class="row g-3">
                @foreach (var task in activeTasks)
                {
                    var isCompleted = task.Status == "CompletedByInstructor";
                    <div class="col-12">
                        <div class="card shadow-sm border-0 h-100 @(isCompleted ? "border-start border-success border-3" : "")">
                            <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">

                                @if (isCompleted)
                                {
                                    <div class="flex-shrink-0">
                                        <input type="checkbox"
                                               name="selectedIds"
                                               value="@task.Id"
                                               class="form-check-input task-checkbox mt-0"
                                               style="width:1.2rem;height:1.2rem;" />
                                    </div>
                                }

                                <div class="flex-grow-1">
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                        <span class="@StatusBadge(task.Status)">@StatusLabel(task.Status)</span>
                                        <span class="@PriorityBadge(task.Priority)">@PriorityLabel(task.Priority)</span>
                                        <span class="badge bg-light text-dark border">@task.TaskType</span>
                                    </div>
                                    <h6 class="mb-1 fw-bold">@task.Title</h6>
                                    <small class="text-muted">
                                        <i class="bi bi-people me-1"></i>@task.BatchName
                                        @if (task.DueDate.HasValue)
                                        {
                                            <span class="ms-3">
                                                <i class="bi bi-calendar-event me-1"></i>
                                                الاستحقاق: @task.DueDate.Value.ToString("yyyy/MM/dd")
                                            </span>
                                        }
                                    </small>
                                </div>

                                <div>
                                    <a asp-area="Instructors"
                                       asp-controller="InstructorInterventionTasks"
                                       asp-action="Details"
                                       asp-route-id="@task.Id"
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-eye me-1"></i>
                                        عرض التفاصيل
                                    </a>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            </div>
        </form>
    }

</div>

<!-- Modal تأكيد الأرشفة -->
<div class="modal fade" id="archiveConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" dir="rtl">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title">
                    <i class="bi bi-archive-fill text-success me-2"></i>
                    تأكيد نقل إلى الأرشيف
                </h5>
            </div>
            <div class="modal-body">
                <p class="mb-0">هل أنت متأكد من نقل المهام المحددة إلى أرشيف المكتمل؟</p>
                <p class="text-muted small mt-1">يمكنك مراجعتها في أي وقت من صفحة الأرشيف.</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-success btn-sm" id="confirmArchiveBtn">
                    <i class="bi bi-archive-fill me-1"></i>
                    نعم، نقل إلى الأرشيف
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // تحديد الكل
    const selectAll = document.getElementById('selectAll');
    const checkboxes = document.querySelectorAll('.task-checkbox');
    const archiveBtn = document.getElementById('archiveBtn');

    function updateArchiveBtn() {
        if (!archiveBtn) return;
        const anyChecked = [...checkboxes].some(c => c.checked);
        archiveBtn.disabled = !anyChecked;
    }

    if (selectAll) {
        selectAll.addEventListener('change', function () {
            checkboxes.forEach(c => c.checked = this.checked);
            updateArchiveBtn();
        });
    }

    checkboxes.forEach(c => c.addEventListener('change', function () {
        if (selectAll && !this.checked) selectAll.checked = false;
        if (selectAll && [...checkboxes].every(cb => cb.checked)) selectAll.checked = true;
        updateArchiveBtn();
    }));

    function confirmArchive() {
        var modal = new bootstrap.Modal(document.getElementById('archiveConfirmModal'));
        modal.show();
    }

    document.getElementById('confirmArchiveBtn')?.addEventListener('click', function () {
        document.getElementById('archiveForm').submit();
    });
</script>
}
