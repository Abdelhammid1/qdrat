@model List<QdratNew.ViewModels.Instructor.InstructorHomeworkPerformanceViewModel>
@{
    ViewBag.Title = "متوسط أداء الواجبات";
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";
}

<h2 class="mb-4">📊 متوسط أداء الطلاب في الواجبات</h2>

<table class="table table-bordered table-striped">
    <thead class="thead-dark">
        <tr>
            <th>الطالب</th>
            <th>الدفعة</th>
            <th>عدد الواجبات المصححة</th>
            <th>عدد الإجابات الصحيحة</th>
            <th>نسبة الأداء</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.StudentName</td>
                <td>@item.BatchName</td>
                <td>@item.TotalChecked</td>
                <td>@item.CorrectCount</td>
                <td>@item.Percentage.ToString("0.0")%</td>
            </tr>
        }
    </tbody>
</table>
