@model List<QdratNew.ViewModels.Instructor.SentAssignmentViewModel>
@{
    ViewBag.Title = "الواجبات المرسلة";
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";
}

<h2 class="mb-4">📚 الواجبات المرسلة</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>العنوان</th>
            <th>الدفعة</th>
            <th>تاريخ الإرسال</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Title</td>
                <td>@a.BatchName</td>
                <td>@a.CreatedAt.ToString("yyyy/MM/dd hh:mm tt")</td>
            </tr>
        }
    </tbody>
</table>
