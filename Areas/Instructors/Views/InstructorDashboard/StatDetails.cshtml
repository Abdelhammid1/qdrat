@model QdratNew.ViewModels.Instructor.InstructorStatDetailsViewModel

@{
    ViewData["Title"] = Model.Title;

    var hasCards = Model.Cards != null && Model.Cards.Any();
    var hasRows = Model.Rows != null && Model.Rows.Any();
}

<style>
    .sd-page {
        direction: rtl;
        width: 100%;
        min-height: calc(100vh - 130px);
        background: linear-gradient(180deg, #f5f9f9 0%, #eef5f5 100%);
        padding: 28px;
        border-radius: 22px;
    }

    .sd-container {
        max-width: 1320px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 22px;
    }

    .sd-hero {
        background: #fff;
        border: 1px solid #e5eeee;
        border-radius: 28px;
        padding: 34px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 280px;
        gap: 24px;
        box-shadow: 0 18px 45px rgba(16,24,40,.06);
    }

    .sd-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #339999;
        text-decoration: none;
        font-weight: 800;
        margin-bottom: 22px;
    }

    .sd-badge {
        display: inline-flex;
        background: #eaf7f7;
        color: #287d7d;
        padding: 7px 15px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 16px;
    }

    .sd-title {
        margin: 0 0 12px;
        font-size: 48px;
        font-weight: 900;
        color: #101828;
        line-height: 1.15;
    }

    .sd-subtitle {
        margin: 0;
        max-width: 820px;
        color: #667085;
        font-size: 18px;
        line-height: 1.9;
        font-weight: 600;
    }

    .sd-main-value {
        background: linear-gradient(135deg, #339999, #267d7d);
        border-radius: 24px;
        color: #fff;
        padding: 28px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        box-shadow: 0 18px 35px rgba(51,153,153,.25);
        text-align: center;
    }

        .sd-main-value span {
            font-size: 14px;
            opacity: .9;
            font-weight: 700;
        }

        .sd-main-value strong {
            margin: 14px 0 10px;
            font-size: 64px;
            font-weight: 900;
            line-height: 1;
        }

        .sd-main-value small {
            opacity: .85;
            font-size: 13px;
        }

    .sd-cards {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
    }

    .sd-card {
        background: #fff;
        border: 1px solid #e5eeee;
        border-radius: 22px;
        padding: 22px;
        min-height: 120px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: 0 12px 30px rgba(16,24,40,.045);
    }

    .sd-card-icon {
        width: 52px;
        height: 52px;
        border-radius: 18px;
        background: #eaf7f7;
        color: #339999;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        flex-shrink: 0;
    }

    .sd-card span {
        display: block;
        color: #667085;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .sd-card strong {
        color: #101828;
        font-size: 34px;
        font-weight: 900;
        line-height: 1.1;
    }

    .sd-grid {
        display: grid;
        grid-template-columns: .9fr 1.1fr;
        gap: 22px;
        align-items: start;
    }

    .sd-panel {
        background: #fff;
        border: 1px solid #e5eeee;
        border-radius: 26px;
        padding: 28px;
        box-shadow: 0 14px 34px rgba(16,24,40,.045);
    }

        .sd-panel.insight {
            border-right: 6px solid #339999;
        }

    .sd-panel-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
        margin-bottom: 22px;
    }

    .sd-panel-label {
        display: inline-flex;
        background: #eaf7f7;
        color: #287d7d;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 800;
    }

    .sd-panel h2 {
        margin: 13px 0 0;
        color: #101828;
        font-size: 30px;
        font-weight: 900;
    }

    .sd-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 44px;
        padding: 0 18px;
        border-radius: 15px;
        background: #339999;
        color: #fff;
        text-decoration: none;
        font-weight: 800;
        white-space: nowrap;
    }

        .sd-action:hover {
            color: #fff;
            background: #287d7d;
        }

    .sd-insight {
        background: #f8fbfb;
        border: 1px solid #edf3f3;
        border-radius: 20px;
        padding: 22px;
        color: #475467;
        font-size: 18px;
        line-height: 2;
        font-weight: 600;
    }

    .sd-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .sd-row {
        min-height: 78px;
        padding: 18px 20px;
        background: #f8fbfb;
        border: 1px solid #edf3f3;
        border-radius: 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        text-decoration: none;
        color: inherit;
    }

        .sd-row:hover {
            background: #effafa;
            border-color: rgba(51,153,153,.35);
            color: inherit;
        }

        .sd-row strong {
            display: block;
            color: #101828;
            font-size: 17px;
            font-weight: 900;
            margin-bottom: 6px;
        }

        .sd-row span {
            display: block;
            color: #667085;
            font-size: 14px;
            line-height: 1.6;
        }

    .sd-row-value {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #339999;
        flex-shrink: 0;
    }

        .sd-row-value b {
            font-size: 18px;
            font-weight: 900;
        }

    .sd-empty {
        border: 1px dashed #cfdada;
        border-radius: 22px;
        background: #f8fbfb;
        min-height: 220px;
        padding: 32px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        text-align: center;
    }

        .sd-empty i {
            color: #339999;
            font-size: 42px;
        }

        .sd-empty strong {
            color: #101828;
            font-size: 20px;
            font-weight: 900;
        }

        .sd-empty span {
            color: #667085;
        }

    @@media (max-width: 1200px) {
        .sd-hero {
            grid-template-columns: 1fr;
        }

        .sd-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 992px) {
        .sd-cards {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 576px) {
        .sd-page {
            padding: 14px;
            border-radius: 16px;
        }

        .sd-hero,
        .sd-panel {
            padding: 20px;
            border-radius: 20px;
        }

        .sd-title {
            font-size: 34px;
        }

        .sd-cards {
            grid-template-columns: 1fr;
        }

        .sd-panel-header,
        .sd-row {
            flex-direction: column;
            align-items: stretch;
        }

        .sd-action {
            width: 100%;
        }
    }

</style>

<div class="sd-page">

    <div class="sd-container">

        <section class="sd-hero">

            <div>
                <a class="sd-back"
                   href="@Url.Action("Index", "InstructorDashboard", new { area = "Instructors" })">
                    <i class="fa-solid fa-arrow-right"></i>
                    <span>العودة للداشبورد</span>
                </a>

                <div class="sd-badge">
                    تفاصيل المؤشر
                </div>

                <h1 class="sd-title">
                    @Model.Title
                </h1>

                <p class="sd-subtitle">
                    @Model.Subtitle
                </p>
            </div>

            <div class="sd-main-value">
                <span>القيمة الحالية</span>
                <strong>@Model.Value</strong>
                <small>آخر قراءة متاحة للمؤشر</small>
            </div>

        </section>

        @if (hasCards)
        {
            <section class="sd-cards">
                @foreach (var card in Model.Cards)
                {
                    <article class="sd-card">
                        <div class="sd-card-icon">
                            <i class="fa-solid fa-chart-simple"></i>
                        </div>

                        <div>
                            <span>@card.Label</span>
                            <strong>@card.Value</strong>
                        </div>
                    </article>
                }
            </section>
        }

        <section class="sd-grid">

            <div class="sd-panel insight">

                <div class="sd-panel-header">

                    <div>
                        <span class="sd-panel-label">تحليل سريع</span>
                        <h2>الخلاصة العملية</h2>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.ActionUrl))
                    {
                        <a class="sd-action" href="@Model.ActionUrl">
                            <span>@Model.ActionText</span>
                            <i class="fa-solid fa-arrow-left"></i>
                        </a>
                    }

                </div>

                <div class="sd-insight">
                    @Model.Insight
                </div>

            </div>

            <div class="sd-panel">

                <div class="sd-panel-header">
                    <div>
                        <span class="sd-panel-label">بيانات مرتبطة</span>
                        <h2>تفاصيل مرتبطة</h2>
                    </div>
                </div>

                @if (hasRows)
                {
                    <div class="sd-list">
                        @foreach (var row in Model.Rows)
                        {
                            if (!string.IsNullOrWhiteSpace(row.Url))
                            {
                                <a class="sd-row" href="@row.Url">
                                    <div>
                                        <strong>@row.Title</strong>
                                        <span>@row.Meta</span>
                                    </div>

                                    <div class="sd-row-value">
                                        <b>@row.Value</b>
                                        <i class="fa-solid fa-chevron-left"></i>
                                    </div>
                                </a>
                            }
                            else
                            {
                                <div class="sd-row">
                                    <div>
                                        <strong>@row.Title</strong>
                                        <span>@row.Meta</span>
                                    </div>

                                    <div class="sd-row-value">
                                        <b>@row.Value</b>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    <div class="sd-empty">
                        <i class="fa-regular fa-folder-open"></i>
                        <strong>لا توجد بيانات تفصيلية</strong>
                        <span>لا توجد بيانات متاحة حاليًا لهذا المؤشر.</span>
                    </div>
                }

            </div>

        </section>

    </div>

</div>
