@model QdratNew.ViewModels.Instructor.InstructorAIPageViewModel
@{
    ViewData["Title"] = "تحليل الذكاء الاصطناعي";
}

<style>
    .ai-card { border-radius: 14px; box-shadow: 0 2px 12px rgba(0,0,0,.08); }
    .progress { height: 10px; border-radius: 8px; }
    .batch-card { border-radius: 14px; border: 1px solid #e5e7eb; transition: box-shadow .2s; }
    .batch-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,.12); }
    .reco-green { background: linear-gradient(135deg, #f0fdf4, #dcfce7); border-right: 4px solid #22c55e; border-radius: 10px; }
    .reco-amber  { background: linear-gradient(135deg, #fffbeb, #fef3c7); border-right: 4px solid #f59e0b; border-radius: 10px; }
    .risk-badge  { background: #fee2e2; color: #dc2626; padding: 2px 10px; border-radius: 20px; font-size: .75rem; font-weight: 600; }
    .perf-bar-label { font-size: .78rem; color: #6b7280; min-width: 105px; }
</style>

<div class="container-fluid py-4">

    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <h4 class="mb-0 fw-bold" style="color:#1e293b;">تحليل الذكاء الاصطناعي</h4>
            <p class="text-muted mb-0 small">تحليل شامل لأداء دفعاتك وتوجيهات مخصصة</p>
        </div>
        <span class="badge rounded-pill px-3 py-2" style="background:#e0f2fe;color:#0369a1;font-size:.85rem;">
            المدرب: @Model.InstructorName
        </span>
    </div>

    @if (!Model.BatchInsights.Any())
    {
        <div class="alert alert-info rounded-3 text-center py-4">
            لا توجد دفعات مرتبطة بك حتى الآن.
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-4 col-lg-2">
                <div class="ai-card p-3 h-100" style="background:#eff6ff;">
                    <div class="fw-bold fs-5 text-primary">@Model.TotalStudents</div>
                    <div class="text-muted small">الطلاب</div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="ai-card p-3 h-100" style="background:#f0fdf4;">
                    <div class="fw-bold fs-5 text-success">@Model.TotalBatches</div>
                    <div class="text-muted small">الدفعات</div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="ai-card p-3 h-100" style="background:#faf5ff;">
                    <div class="fw-bold fs-5" style="color:#7c3aed;">@Model.AvgExamScore%</div>
                    <div class="text-muted small">متوسط الاختبارات</div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="ai-card p-3 h-100" style="background:#fff7ed;">
                    <div class="fw-bold fs-5" style="color:#ea580c;">@Model.AvgHomeworkCompletionRate%</div>
                    <div class="text-muted small">إتمام الواجبات</div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="ai-card p-3 h-100" style="background:#f0fdfa;">
                    <div class="fw-bold fs-5" style="color:#0d9488;">@Model.AvgAttendanceRate%</div>
                    <div class="text-muted small">نسبة الحضور</div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="ai-card p-3 h-100" style="background:#fff1f2;">
                    <div class="fw-bold fs-5 text-danger">@Model.TotalAtRiskStudents</div>
                    <div class="text-muted small">طلاب في خطر</div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="reco-green p-3 h-100">
                    <div class="fw-semibold mb-2" style="color:#15803d;">🤖 توصية الذكاء الاصطناعي</div>
                    <p class="mb-0 text-dark">@Model.OverallAIRecommendation</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="reco-amber p-3 h-100">
                    <div class="fw-semibold mb-2" style="color:#92400e;">💡 توصية تحليلية</div>
                    <p class="mb-0 text-dark">@Model.RuleBasedRecommendation</p>
                </div>
            </div>
        </div>

        <h6 class="fw-bold text-secondary mb-3">تحليل الدفعات</h6>
        <div class="row g-3 mb-4">
            @foreach (var batch in Model.BatchInsights)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="batch-card p-4 h-100 bg-white">

                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <div class="fw-bold fs-6">@batch.BatchName</div>
                                <div class="text-muted small">@batch.CourseName</div>
                            </div>
                            <span class="badge bg-@batch.PerformanceTone px-2 py-1">@batch.PerformanceLevel</span>
                        </div>

                        <div class="d-flex gap-4 mb-3">
                            <div class="text-center">
                                <div class="fw-bold fs-5 text-primary">@batch.StudentCount</div>
                                <div class="text-muted" style="font-size:.7rem;">طالب</div>
                            </div>
                            <div class="text-center">
                                <div class="fw-bold fs-5 text-success">@batch.AvgExamScore%</div>
                                <div class="text-muted" style="font-size:.7rem;">الاختبارات</div>
                            </div>
                            <div class="text-center">
                                <div class="fw-bold fs-5 text-danger">@batch.AtRiskCount</div>
                                <div class="text-muted" style="font-size:.7rem;">في خطر</div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="perf-bar-label">الحضور</span>
                                <span class="small fw-semibold">@batch.AvgAttendance%</span>
                            </div>
                            <div class="progress mb-2">
                                <div class="progress-bar" style="width:@batch.AvgAttendance%;background:#0d9488;"></div>
                            </div>

                            <div class="d-flex justify-content-between mb-1">
                                <span class="perf-bar-label">إتمام الواجبات</span>
                                <span class="small fw-semibold">@batch.HomeworkCompletionRate%</span>
                            </div>
                            <div class="progress mb-2">
                                <div class="progress-bar bg-warning" style="width:@batch.HomeworkCompletionRate%;"></div>
                            </div>

                            <div class="d-flex justify-content-between mb-1">
                                <span class="perf-bar-label">إتمام الدروس</span>
                                <span class="small fw-semibold">@batch.LessonsCompletionRate%</span>
                            </div>
                            <div class="progress">
                                <div class="progress-bar bg-info" style="width:@batch.LessonsCompletionRate%;"></div>
                            </div>
                        </div>

                        <div class="rounded-3 p-2 mb-3"
                             style="background:#f8fafc;border-right:3px solid #6366f1;font-size:.82rem;">
                            <span style="color:#4f46e5;">🤖</span>
                            <span class="text-dark ms-1">@batch.AIRecommendation</span>
                        </div>

                        @if (batch.AtRiskStudents.Any())
                        {
                            <div>
                                <div class="small fw-semibold text-danger mb-2">
                                    ⚠️ طلاب يحتاجون متابعة (@batch.AtRiskCount)
                                </div>
                                @foreach (var stu in batch.AtRiskStudents.Take(3))
                                {
                                    <div class="d-flex justify-content-between align-items-center py-1 border-bottom border-light">
                                        <span class="small text-dark">@stu.StudentName</span>
                                        <span class="risk-badge">@stu.AvgScore%</span>
                                    </div>
                                }
                                @if (batch.AtRiskStudents.Count > 3)
                                {
                                    <div class="text-muted small mt-1">
                                        و @(batch.AtRiskStudents.Count - 3) طلاب آخرون...
                                    </div>
                                }
                            </div>
                        }

                    </div>
                </div>
            }
        </div>

        @if (Model.GlobalAtRiskStudents.Any())
        {
            <h6 class="fw-bold text-danger mb-3">⚠️ قائمة الطلاب الأكثر احتياجاً للمتابعة</h6>
            <div class="ai-card bg-white p-4 mb-4">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>الطالب</th>
                                <th>الدفعة</th>
                                <th>متوسط الدرجات</th>
                                <th>عدد الاختبارات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int rank = 1; }
                            @foreach (var stu in Model.GlobalAtRiskStudents)
                            {
                                <tr>
                                    <td class="text-muted small">@(rank++)</td>
                                    <td class="fw-semibold">@stu.StudentName</td>
                                    <td class="text-muted small">@stu.BatchName</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height:6px;min-width:60px;">
                                                <div class="progress-bar bg-danger"
                                                     style="width:@stu.AvgScore%;"></div>
                                            </div>
                                            <span class="small text-danger fw-bold">@stu.AvgScore%</span>
                                        </div>
                                    </td>
                                    <td class="text-muted small">@stu.ExamCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }

</div>
