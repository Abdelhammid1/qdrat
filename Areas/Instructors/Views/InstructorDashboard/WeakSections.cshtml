@model List<QdratNew.ViewModels.Instructor.WeakSectionViewModel>
@{
    ViewData["Title"] = "المحاور ذات الأداء الضعيف";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="text-center mb-4" style="color:#339999;">📉 المحاور (المؤشرات) ذات الأداء الضعيف</h2>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped text-center align-middle">
                <thead class="table-secondary">
                    <tr>
                        <th style="width:40%;">📚 اسم المحور</th>
                        <th style="width:40%;">📘 اسم المنهج</th>
                        <th style="width:20%;">❌ عدد الأخطاء</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-danger">@item.SectionTitle</td>
                            <td class="fw-bold">@item.CurriculumTitle</td>
                            <td class="fw-bold text-dark">@item.ErrorCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            لا توجد مؤشرات ضعيفة حاليًا في أداء الطلاب.
        </div>
    }

    <div class="text-center mt-4">
        <a href="@Url.Action("Index", "InstructorDashboard")" class="btn btn-outline-secondary">
            🔙 العودة للوحة القيادة
        </a>
    </div>
</div>
