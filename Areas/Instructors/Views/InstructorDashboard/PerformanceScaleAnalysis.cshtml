@model List<QdratNew.ViewModels.Instructor.PerformanceScaleSectionViewModel>
@{
    ViewBag.Title = "تحليل اختبارات مقياس الأداء حسب المحور";
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";
}

<h2 class="mb-4">📊 تحليل اختبارات مقياس الأداء</h2>

<table class="table table-bordered text-center">
    <thead class="thead-dark">
        <tr>
            <th>المحور</th>
            <th>متوسط الدرجة</th>
            <th>تفاصيل</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SectionTitle</td>
                <td>@item.AverageScore.ToString("0.0")%</td>
                <td>
                    <a asp-action="PerformanceExamStudents" asp-route-examId="@item.ExamId" class="btn btn-sm btn-outline-primary">عرض الطلاب</a>
                </td>
            </tr>
        }
    </tbody>
</table>
