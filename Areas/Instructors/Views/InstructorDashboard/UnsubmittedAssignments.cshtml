@model List<QdratNew.ViewModels.Instructor.InstructorStudentUnsubmittedViewModel>

@{
    ViewData["Title"] = "الطلاب الذين لم يسلموا الواجبات";
}

<div class="container py-4">
    <h3 class="mb-4 text-danger">🧍‍♂️ الطلاب الذين لم يسلموا أي واجب</h3>

    <table class="table table-bordered table-striped">
        <thead class="table-light">
            <tr>
                <th>اسم الطالب</th>
                <th>الدفعة</th>
                <th>عدد الواجبات غير المسلمة</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model)
            {
                <tr>
                    <td>@student.StudentName</td>
                    <td>@student.BatchName</td>
                    <td>@student.UnsubmittedCount</td>
                </tr>
            }
        </tbody>
    </table>
</div>
