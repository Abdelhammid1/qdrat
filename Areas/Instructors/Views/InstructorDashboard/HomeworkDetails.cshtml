@model List<QdratNew.ViewModels.Instructor.InstructorStudentHomeworkStatusViewModel>
@{
    ViewData["Title"] = ViewBag.Type;
}

<h2 class="mb-4">@ViewBag.Type</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>الطالب</th>
            <th>الدفعة</th>
            <th>عنوان الواجب</th>
            <th>تاريخ الإرسال</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.StudentName</td>
                <td>@item.BatchName</td>
                <td>@item.HomeworkSetTitle</td>
                <td>@item.AssignedAt.ToString("yyyy/MM/dd")</td>
            </tr>
        }
    </tbody>
</table>
