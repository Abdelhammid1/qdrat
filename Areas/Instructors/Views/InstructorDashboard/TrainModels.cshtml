@{
    ViewData["Title"] = "توليد النماذج الذكية";
}

<div class="container py-5 text-center">
    <h2 class="text-primary mb-4">توليد النماذج الذكية</h2>

    <div class="mb-4">
        <button id="trainInstructorModelBtn" class="btn btn-primary btn-lg">🔄 توليد نموذج المدرب</button>
        <div id="trainModelResult" class="mt-2"></div>
    </div>

    <div class="mb-4">
        <button id="trainRiskModelBtn" class="btn btn-success btn-lg">🧠 توليد نموذج تحليل الخطر الأكاديمي</button>
        <div id="trainRiskModelResult" class="mt-2"></div>
    </div>
</div>


<div class="card mt-4">
    <div class="card-header bg-light" style="border-right: 5px solid #339999;">
        <h5 class="mb-0 text-dark">🔁 تدريب النموذج الذكي للمدرب</h5>
    </div>
    <div class="card-body">
        <button id="trainBatchInsightModelBtn" class="btn btn-primary">🚀 اضغط لتدريب النموذج الآن</button>
        <div id="trainModelStatus" class="mt-3 text-info fw-bold"></div>
    </div>


    <div class="mb-4">
        <button id="trainHomeworkModelBtn" class="btn btn-warning btn-lg">🧠 توليد نموذج تحليل أداء الواجبات</button>
        <div id="trainHomeworkModelResult" class="mt-2"></div>
    </div>

</div>







@section Scripts {
    <script>
               document.getElementById("trainInstructorModelBtn").addEventListener("click", function () {
            const resultDiv = document.getElementById("trainModelResult");
            resultDiv.innerText = "⏳ جاري توليد النموذج...";

            fetch("/Instructors/InstructorDashboard/TrainInstructorModel", {
                method: "POST"
            })
                .then(res => res.json())
                .then(data => {
                    resultDiv.innerText = data.message;
                    resultDiv.className = data.success ? "mt-3 text-success" : "mt-3 text-danger";
                })
                .catch(() => {
                    resultDiv.innerText = "❌ فشل في الاتصال بالخادم.";
                    resultDiv.className = "mt-3 text-danger";
                });
        });

    </script>
    <script>
        document.getElementById("trainRiskModelBtn").addEventListener("click", function () {
            const resultDiv = document.getElementById("trainRiskModelResult");
            resultDiv.innerText = "⏳ جاري التدريب...";

            fetch("/Instructors/InstructorDashboard/TrainStudentRiskModel", {
                method: "POST"
            })
                .then(res => res.text())
                .then(msg => {
                    resultDiv.innerText = msg;
                    resultDiv.className = "mt-2 " + (msg.includes("✅") ? "text-success" : "text-danger");
                })
                .catch(() => {
                    resultDiv.innerText = "❌ حدث خطأ أثناء الاتصال بالخادم.";
                    resultDiv.className = "mt-2 text-danger";
                });
        });
    </script>
    <script>
        document.getElementById("trainHomeworkModelBtn").addEventListener("click", function () {
            const resultDiv = document.getElementById("trainHomeworkModelResult");
            resultDiv.innerText = "⏳ جاري تدريب النموذج...";

            fetch("/Instructors/InstructorDashboard/TrainHomeworkPerformanceModel", {
                method: "POST"
            })
                .then(res => res.text())
                .then(msg => {
                    resultDiv.innerText = msg;
                    resultDiv.className = "mt-2 " + (msg.includes("✅") ? "text-success" : "text-danger");
                })
                .catch(() => {
                    resultDiv.innerText = "❌ حدث خطأ أثناء الاتصال بالخادم.";
                    resultDiv.className = "mt-2 text-danger";
                });
        });
    </script>

    <script>
              document.getElementById("trainBatchInsightModelBtn").addEventListener("click", async () => {
            const status = document.getElementById("trainModelStatus");
            status.textContent = "⏳ جاري تدريب النموذج...";

            try {
                const response = await fetch("/Admin/AITraining/TrainBatchTeachingModel", {
                    method: "POST"
                });

                const result = await response.text();
                console.log("نتيجة السيرفر:", result);
                if (response.ok && result.includes("✅")) {
                    status.textContent = result;
                    status.className = "text-success fw-bold";
                } else {
                    status.textContent = "❌ فشل في التدريب: " + result;
                    status.className = "text-danger fw-bold";
                }
            } catch (error) {
                console.error("خطأ في الاتصال:", error);
                status.textContent = "❌ حدث خطأ أثناء الاتصال بالخادم.";
                status.className = "text-danger fw-bold";
            }
        });

    </script>





}
