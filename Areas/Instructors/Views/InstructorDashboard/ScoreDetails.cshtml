@model List<QdratNew.ViewModels.Instructor.StudentScoreViewModel>
@{
    ViewData["Title"] = "تفاصيل درجات الطلاب";
}

<h4 class="mb-4">الطلاب - مستوى: @ViewBag.Level</h4>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>الاسم</th>
            <th>الدفعة</th>
            <th>الدرجة</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.StudentName</td>
                <td>@s.BatchName</td>
                <td>@s.Score</td>
            </tr>
        }
    </tbody>
</table>
