@model List<QdratNew.ViewModels.Instructor.StudentAttendanceSummaryViewModel>

@{
    ViewData["Title"] = "تفاصيل الغياب";
}

<div class="container mt-4">
    <h3 class="mb-3 text-primary">سجل حضور الطلاب</h3>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>الاسم</th>
                <th>الدفعة</th>
                <th>عدد المحاضرات</th>
                <th>حضور</th>
                <th>غياب</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model)
            {
                <tr>
                    <td>@student.StudentName</td>
                    <td>@student.BatchName</td>
                    <td>@student.TotalLectures</td>
                    <td class="text-success">@student.Attended</td>
                    <td class="text-danger">@student.Missed</td>
                </tr>
            }
        </tbody>
    </table>
</div>
