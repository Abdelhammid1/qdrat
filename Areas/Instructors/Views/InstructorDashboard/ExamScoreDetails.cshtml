@model List<QdratNew.ViewModels.Instructor.StudentScoreChartViewModel>
@{
    ViewData["Title"] = "تفاصيل توزيع الدرجات";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="text-center mb-4 text-info">📊 تفاصيل توزيع درجات الطلاب</h2>

    @if (Model != null && Model.Any())
    {
        <div class="mb-4">
            <canvas id="scoreDistributionChart" height="140"></canvas>
        </div>

        <table class="table table-bordered table-striped text-center align-middle">
            <thead class="table-secondary">
                <tr>
                    <th>#</th>
                    <th>اسم الطالب</th>
                    <th>الدرجة</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@Model[i].StudentName</td>
                        <td>@Model[i].Score</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info text-center">
            لا توجد نتائج اختبار حالية لعرضها.
        </div>
    }

    <div class="text-center mt-4">
        <a href="@Url.Action("Index", "InstructorDashboard")" class="btn btn-outline-secondary">
            🔙 العودة للوحة القيادة
        </a>
    </div>
</div>

@section Scripts {
    <script>
        const ctx = document.getElementById('scoreDistributionChart').getContext('2d');
        const chart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Select(x => x.StudentName))),
                datasets: [{
                    label: 'الدرجة',
                    data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Select(x => x.Score))),
                    backgroundColor: '#339999'
                }]
            },
            options: {
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100
                    }
                }
            }
        });
    </script>
}
