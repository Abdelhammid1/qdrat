@model List<QdratNew.ViewModels.Instructor.InstructorStudentExamInsightViewModel>
@{
    ViewData["Title"] = "الطلاب الراسبين";
}
<h2 class="mb-4">الطلاب الراسبين في الاختبارات</h2>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>اسم الطالب</th>
            <th>الدرجة</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.StudentName</td>
                <td>@s.Score</td>
            </tr>
        }
    </tbody>
</table>
