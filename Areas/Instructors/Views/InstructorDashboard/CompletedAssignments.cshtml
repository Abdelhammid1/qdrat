@model List<QdratNew.ViewModels.Instructor.CompletedAssignmentStudentViewModel>
@{
    ViewData["Title"] = "الطلاب الذين أكملوا جميع الواجبات";
}

<h4 class="mb-4">الطلاب الذين أكملوا واجباتهم</h4>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>الاسم</th>
            <th>الدفعة</th>
            <th>عدد الواجبات المكتملة</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.StudentName</td>
                <td>@s.BatchName</td>
                <td>@s.CompletedCount</td>
            </tr>
        }
    </tbody>
</table>
