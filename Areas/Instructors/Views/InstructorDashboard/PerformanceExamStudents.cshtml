@model List<QdratNew.ViewModels.Instructor.StudentScoreViewModel>
@{
    ViewBag.Title = "درجات الطلاب في اختبار مقياس الأداء";
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";
}

<h3 class="mb-4">📋 درجات الطلاب</h3>

<table class="table table-striped text-center">
    <thead>
        <tr>
            <th>الطالب</th>
            <th>الدفعة</th>
            <th>الدرجة</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.StudentName</td>
                <td>@s.BatchName</td>
                <td>@s.Score.ToString("0.0")%</td>
            </tr>
        }
    </tbody>
</table>
