@model List<QdratNew.ViewModels.Instructor.StudentExamScoreViewModel>
@{
    ViewBag.Title = "تحليل متوسط درجات الاختبارات";
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";
}

<h2 class="mb-4">🎯 تحليل متوسط درجات الطلاب في الاختبارات</h2>

<table class="table table-bordered table-striped text-center">
    <thead class="thead-dark">
        <tr>
            <th>الطالب</th>
            <th>الدفعة</th>
            <th>متوسط الدرجة</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.StudentName</td>
                <td>@student.BatchName</td>
                <td><span class="badge bg-success">@student.AverageScore.ToString("0.0")%</span></td>
            </tr>
        }
    </tbody>
</table>
