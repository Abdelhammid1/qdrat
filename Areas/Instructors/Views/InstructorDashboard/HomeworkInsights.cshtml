@model List<QdratNew.ViewModels.Instructor.InstructorStudentHomeworkInsightViewModel>
@{
    ViewData["Title"] = "الطلاب الذين لم يسلموا واجبات";
}
<h2 class="mb-4">الطلاب الذين لم يسلموا واجباتهم</h2>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>اسم الطالب</th>
            <th>الدفعة</th>
            <th>عدد الواجبات المتأخرة</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.StudentName</td>
                <td>@s.BatchName</td>
                <td>@s.UnsubmittedCount</td>
            </tr>
        }
    </tbody>
</table>
