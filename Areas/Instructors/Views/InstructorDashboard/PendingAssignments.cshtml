@model List<QdratNew.ViewModels.Instructor.InstructorStudentHomeworkStatusViewModel>

@{
    ViewData["Title"] = "واجبات لم تُحل";
}

<div class="container py-4">
    <h3 class="mb-4 text-primary">📚 الطلاب الذين لم يُكملوا واجباتهم</h3>

    <table class="table table-bordered table-striped">
        <thead class="table-light">
            <tr>
                <th>اسم الطالب</th>
                <th>الدفعة</th>
                <th>عنوان الواجب</th>
                <th>تاريخ الإرسال</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.StudentName</td>
                    <td>@item.BatchName</td>
                    <td>@item.HomeworkSetTitle</td>
                    <td>@item.AssignedAt.ToString("yyyy/MM/dd")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
