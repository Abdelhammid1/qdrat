@model List<QdratNew.ViewModels.Instructor.BatchSummaryViewModel>
@{
    ViewData["Title"] = "تفاصيل الدفعات";
}
<h2 class="mb-4">تفاصيل الدفعات المرتبطة بك</h2>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>اسم الدفعة</th>
            <th>النوع</th>
            <th>عدد الطلاب</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var batch in Model)
        {
            <tr>
                <td>@batch.Name</td>
                <td>@batch.Gender</td>
                <td>@batch.StudentsCount</td>
            </tr>
        }
    </tbody>
</table>
