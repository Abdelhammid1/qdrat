@model List<QdratNew.ViewModels.Instructor.LessonCompletionViewModel>

@{
    ViewData["Title"] = "نسبة إكمال المؤشرات";
}

<h3 class="mb-4 text-primary">📘 تقرير إكمال المؤشرات</h3>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>الدفعة</th>
            <th>المنهج</th>
            <th>المحور</th>
            <th>المؤشر</th>
            <th>الحالة</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.BatchName</td>
                <td>@item.CurriculumTitle</td>
                <td>@item.SectionTitle</td>
                <td>@item.LessonTitle</td>
                <td>
                    @if (item.IsCompleted)
                    {
                        <span class="badge bg-success">تم</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">لم يُنجز</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
