@model List<QdratNew.ViewModels.Instructor.InstructorExamMissingStudentViewModel>
@{
    ViewBag.Title = "الطلاب الذين لم يؤدوا اختباراتهم";
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";
}

<h2 class="mb-4">📝 الطلاب الذين لم يؤدوا اختباراتهم</h2>

<table class="table table-bordered table-striped text-center">
    <thead class="thead-dark">
        <tr>
            <th>الطالب</th>
            <th>الدفعة</th>
            <th>عدد الاختبارات غير المؤداة</th>
            <th>أول اختبار مُعين</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.StudentName</td>
                <td>@s.BatchName</td>
                <td><span class="badge bg-danger">@s.MissingExamCount</span></td>
                <td>@s.EarliestAssignedAt.ToString("yyyy/MM/dd hh:mm tt")</td>
            </tr>
        }
    </tbody>
</table>
