@using QdratNew.ViewModels.Instructor.Exam
@model InstructorSentExamsPageVM

@{
    ViewData["Title"] = "الاختبارات المرسلة";
}

@section Styles {
    <link href="~/css/instructor/instructor-drafts.css" rel="stylesheet" asp-append-version="true" />
}

<div class="instructor-page">

    <div class="hw-page-header">
        <h3 class="hw-page-title">
            <i class="fas fa-chart-bar"></i>
            الاختبارات المرسلة
        </h3>
    </div>

    <div class="instructor-card">
        <ul class="nav nav-tabs mb-3" id="examTabs">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#batch">
                    <i class="fas fa-layer-group me-1"></i> دفعات
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#individual">
                    <i class="fas fa-user me-1"></i> فردي
                </button>
            </li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="batch">
                @Html.Partial("_SentExamTable", Model.BatchExams)
            </div>
            <div class="tab-pane fade" id="individual">
                @Html.Partial("_SentExamTable", Model.IndividualExams)
            </div>
        </div>
    </div>

</div>
