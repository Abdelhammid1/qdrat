@model List<QdratNew.Areas.Instructors.Controllers.QuestionReviewItem>
@{
    ViewData["Title"] = "بنك الأسئلة — إضافة سؤال";
    var lessonId = (int)ViewBag.LessonId;
}

@functions {
    static string StripHtml(string html, int maxLen = 80)
    {
        if (string.IsNullOrWhiteSpace(html)) return "—";
        var plain = System.Text.RegularExpressions.Regex.Replace(html, "<[^>]+>", " ");
        plain = System.Net.WebUtility.HtmlDecode(plain).Trim();
        plain = System.Text.RegularExpressions.Regex.Replace(plain, @"\s+", " ").Trim();
        return plain.Length <= maxLen ? plain : plain.Substring(0, maxLen) + "…";
    }
}

@section Styles {
<style>
    :root {
        --brand-500: #0d9488; --brand-600: #0f766e; --brand-700: #115e59;
        --brand-100: #ccfbf1; --brand-50: #f0fdfa;
        --slate-800: #1e293b; --slate-700: #334155; --slate-600: #475569;
        --slate-500: #64748b; --slate-400: #94a3b8; --slate-200: #e2e8f0;
        --slate-100: #f1f5f9; --slate-50: #f8fafc;
        --green-600: #16a34a; --green-100: #dcfce7; --green-50: #f0fdf4;
        --yellow-100:#fef9c3; --red-100: #fee2e2; --red-500: #ef4444;
        --blue-100: #dbeafe; --blue-500: #3b82f6;
        --radius-sm: 8px; --radius-md: 12px; --radius-lg: 16px; --radius-xl: 20px;
        --shadow-sm: 0 1px 3px rgba(0,0,0,.08), 0 1px 2px rgba(0,0,0,.06);
        --shadow-md: 0 4px 16px rgba(0,0,0,.08);
        --transition: all .22s cubic-bezier(.4,0,.2,1);
    }

    .bb-page { padding: 20px 18px 60px; direction: rtl; }

    .bb-hero {
        background: linear-gradient(135deg, #1d4ed8 0%, var(--slate-800) 100%);
        border-radius: var(--radius-xl); padding: 20px 24px; color: #fff;
        margin-bottom: 16px; display: flex; align-items: center;
        justify-content: space-between; flex-wrap: wrap; gap: 12px;
        position: relative; overflow: hidden;
    }
    .bb-hero::before {
        content: ''; position: absolute; inset: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none'%3E%3Cg fill='%23fff' fill-opacity='.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }
    .bb-hero-info { position: relative; }
    .bb-badge {
        display: inline-flex; align-items: center; gap: 6px;
        background: rgba(255,255,255,.15); backdrop-filter: blur(6px);
        border: 1px solid rgba(255,255,255,.2); border-radius: 20px;
        padding: 3px 12px; font-size: .72rem; font-weight: 700; color: #fff;
        margin-bottom: 7px;
    }
    .bb-hero h2 { font-size: 1.1rem; font-weight: 800; margin: 0 0 3px; }
    .bb-hero p  { font-size: .78rem; opacity: .75; margin: 0; }
    .btn-hero-close {
        display: inline-flex; align-items: center; gap: 7px;
        background: rgba(255,255,255,.15); backdrop-filter: blur(6px);
        border: 1px solid rgba(255,255,255,.25); border-radius: var(--radius-md);
        padding: 7px 14px; color: #fff; font-size: .78rem; font-weight: 700;
        cursor: pointer; position: relative; font-family: inherit;
    }
    .btn-hero-close:hover { background: rgba(255,255,255,.28); }

    .bb-toolbar {
        display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 14px;
    }
    .bb-search { flex: 1; min-width: 160px; position: relative; }
    .bb-search input {
        width: 100%; background: #fff; border: 1.5px solid var(--slate-200);
        border-radius: var(--radius-md); padding: 9px 38px 9px 14px;
        font-size: .875rem; font-family: inherit; outline: none; transition: var(--transition);
    }
    .bb-search input:focus { border-color: var(--brand-500); box-shadow: 0 0 0 3px rgba(13,148,136,.1); }
    .bb-search .s-icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--slate-400); font-size: .8rem; pointer-events: none; }

    .bank-card {
        background: #fff; border-radius: var(--radius-lg);
        border: 1.5px solid var(--slate-200); box-shadow: var(--shadow-sm); overflow: hidden;
    }
    .bank-card-header {
        padding: 13px 18px;
        background: var(--slate-50); border-bottom: 1px solid var(--slate-200);
        display: flex; align-items: center; gap: 10px;
    }
    .bank-icon {
        width: 34px; height: 34px; border-radius: var(--radius-sm);
        background: linear-gradient(135deg, #3b82f6, #1d4ed8);
        color: #fff; display: flex; align-items: center; justify-content: center;
        font-size: .82rem;
    }
    .bank-header-title { font-size: .88rem; font-weight: 700; color: var(--slate-800); }
    .bank-header-sub   { font-size: .7rem; color: var(--slate-400); margin-top: 1px; }

    .q-list  { padding: 10px 12px; display: flex; flex-direction: column; gap: 8px; }
    .bq-row  {
        display: flex; align-items: center; gap: 10px; padding: 10px 14px;
        border-radius: var(--radius-md); border: 1.5px solid var(--slate-100);
        background: var(--slate-50); transition: var(--transition);
    }
    .bq-row:hover { border-color: var(--brand-100); background: #fff; box-shadow: var(--shadow-sm); }
    .bq-num {
        width: 26px; height: 26px; border-radius: 50%;
        background: var(--slate-200); color: var(--slate-600);
        display: flex; align-items: center; justify-content: center;
        font-size: .7rem; font-weight: 800; flex-shrink: 0;
    }
    .bq-text { flex: 1; font-size: .85rem; font-weight: 500; color: var(--slate-700); line-height: 1.4; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .bq-badges { display: flex; gap: 5px; flex-shrink: 0; flex-wrap: wrap; }
    .bqbadge { font-size: .65rem; font-weight: 800; padding: 2px 7px; border-radius: 20px; }
    .bqbadge-easy   { background: var(--green-100); color: var(--green-600); }
    .bqbadge-medium { background: var(--yellow-100); color: #a16207; }
    .bqbadge-hard   { background: var(--red-100); color: var(--red-500); }
    .bqbadge-opts   { background: var(--blue-100); color: var(--blue-500); }

    .bq-actions { display: flex; gap: 6px; flex-shrink: 0; }
    .bq-btn {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 6px 12px; border-radius: var(--radius-sm);
        font-size: .74rem; font-weight: 700; cursor: pointer;
        transition: var(--transition); border: 1.5px solid; font-family: inherit; text-decoration: none;
    }
    .bq-btn-preview { background: var(--blue-100); color: var(--blue-500); border-color: #bfdbfe; }
    .bq-btn-preview:hover { background: var(--blue-500); color: #fff; }

    .empty-state { padding: 50px 20px; text-align: center; color: var(--slate-400); }
    .empty-icon  {
        width: 64px; height: 64px; border-radius: 50%;
        background: var(--slate-100); display: flex; align-items: center; justify-content: center;
        font-size: 1.6rem; margin: 0 auto 14px;
    }

    .preview-modal .modal-dialog  { max-width: 760px; }
    .preview-modal .modal-header  {
        background: linear-gradient(135deg, var(--brand-600), var(--slate-800));
        color: #fff;
    }
    .preview-modal .modal-header .btn-close { filter: invert(1); }

    #bbNoResults { display: none; text-align: center; padding: 36px; color: var(--slate-400); font-size: .875rem; }

    @@media (max-width: 640px) { .bq-badges { display: none; } }
</style>
}

<div class="bb-page container-fluid">

    <div class="bb-hero">
        <div class="bb-hero-info">
            <div class="bb-badge"><i class="fas fa-database me-1"></i> بنك الأسئلة</div>
            <h2>إضافة سؤال للمؤشر</h2>
            <p>
                <i class="fas fa-bookmark me-1" style="opacity:.7"></i>
                @ViewBag.LessonTitle
                @if (!string.IsNullOrEmpty(ViewBag.SectionTitle?.ToString()))
                {
                    <span style="opacity:.4"> · </span>@ViewBag.SectionTitle
                }
            </p>
        </div>
        <button class="btn-hero-close" onclick="window.close()">
            <i class="fas fa-times"></i> إغلاق
        </button>
    </div>

    <div class="bb-toolbar">
        <div class="bb-search">
            <i class="fas fa-search s-icon"></i>
            <input type="text" id="bbSearch" placeholder="ابحث في نص السؤال..." />
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="fas fa-inbox"></i></div>
            <p style="font-size:.95rem;font-weight:700;color:var(--slate-600)">لا توجد أسئلة في البنك</p>
            <p style="font-size:.82rem;margin-top:4px">لا توجد أسئلة مكتملة ومراجعة لهذا المؤشر</p>
        </div>
    }
    else
    {
        <div class="bank-card">
            <div class="bank-card-header">
                <div class="bank-icon"><i class="fas fa-database"></i></div>
                <div>
                    <div class="bank-header-title">@ViewBag.LessonTitle</div>
                    <div class="bank-header-sub">@Model.Count سؤال مكتمل ومراجع</div>
                </div>
            </div>
            <div class="q-list" id="bbList">
                @{ int n = 1; }
                @foreach (var q in Model)
                {
                    var dc = q.Difficulty switch { "Easy" => "bqbadge-easy", "Hard" or "VeryHard" => "bqbadge-hard", _ => "bqbadge-medium" };
                    var dl = q.Difficulty switch { "Easy" => "سهل", "Hard" => "صعب", "VeryHard" => "صعب جداً", _ => "متوسط" };

                    <div class="bq-row" data-title="@StripHtml(q.Title, 200).ToLower()">
                        <div class="bq-num">@n</div>
                        <span class="bq-text" title="@StripHtml(q.Title, 200)">@StripHtml(q.Title)</span>
                        <div class="bq-badges">
                            <span class="bqbadge @dc">@dl</span>
                            @if (q.OptionsCount > 0)
                            {
                                <span class="bqbadge bqbadge-opts">@q.OptionsCount خيارات</span>
                            }
                        </div>
                        <div class="bq-actions">
                            <button type="button"
                                    class="bq-btn bq-btn-preview"
                                    data-question-id="@q.Id"
                                    title="معاينة">
                                <i class="fas fa-eye"></i> معاينة
                            </button>
                        </div>
                    </div>
                    n++;
                }
            </div>
            <p id="bbNoResults">
                <i class="fas fa-search" style="font-size:1.4rem;display:block;margin-bottom:8px;opacity:.3"></i>
                لا توجد نتائج
            </p>
        </div>
    }
</div>

<div class="modal fade preview-modal" id="bbPreviewModal" tabindex="-1" dir="rtl">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-eye me-2"></i> معاينة السؤال</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0" id="bbPreviewBody">
                <div style="display:flex;align-items:center;justify-content:center;height:180px;color:#94a3b8">
                    <div class="spinner-border text-secondary"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const bsModal   = new bootstrap.Modal(document.getElementById('bbPreviewModal'));
    const previewBody = document.getElementById('bbPreviewBody');
    const loading = `<div style="display:flex;align-items:center;justify-content:center;height:180px;color:#94a3b8">
        <div class="spinner-border text-secondary"></div></div>`;

    document.querySelectorAll('.bq-btn-preview').forEach(btn => {
        btn.addEventListener('click', function () {
            previewBody.innerHTML = loading;
            bsModal.show();
            fetch('/Instructors/QuestionReview/PreviewQuestion?questionId=' + this.dataset.questionId)
                .then(r => r.text())
                .then(html => { previewBody.innerHTML = html; })
                .catch(() => {
                    previewBody.innerHTML = '<div class="text-danger p-4 text-center">تعذر تحميل السؤال</div>';
                });
        });
    });

    const searchInp = document.getElementById('bbSearch');
    const list      = document.getElementById('bbList');
    const noRes     = document.getElementById('bbNoResults');

    if (!searchInp || !list) return;

    searchInp.addEventListener('input', function () {
        const term = this.value.trim().toLowerCase();
        const rows = list.querySelectorAll('.bq-row');
        let visible = 0;
        rows.forEach(row => {
            const match = !term || (row.dataset.title || '').includes(term);
            row.style.display = match ? '' : 'none';
            if (match) visible++;
        });
        if (noRes) noRes.style.display = visible === 0 ? '' : 'none';
    });
})();
</script>
}
