                        let isQuantitative = false;

                        // 🔢 تحويل الأرقام إلى هندية مع احترام العناصر داخل HTML
                        function toIndicDigitsSafe(input) {
                            const map = { '0': '٠', '1': '١', '2': '٢', '3': '٣', '4': '٤', '5': '٥', '6': '٦', '7': '٧', '8': '٨', '9': '٩' };
                            let result = '';
                            let insideTag = false;

                            for (let i = 0; i < input.length; i++) {
                                const char = input[i];
                                if (char === '<') insideTag = true;
                                if (!insideTag && map[char]) {
                                    result += map[char];
                                } else {
                                    result += char;
                                }
                                if (char === '>') insideTag = false;
                            }

                            return result;
                        }

