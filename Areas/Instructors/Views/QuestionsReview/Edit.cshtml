                                  async function loadQuestionPreview() {
                    console.log("📤 بدء معاينة السؤال...");

                    const getInputValue = (id) => document.getElementById(id)?.value?.trim() || "";

                    // ✅ تحميل صورة السؤال كـ base64 إن وجدت
                    const imageInput = document.getElementById("question-image-input");
                    let imageDataUrl = "";

                    if (imageInput && imageInput.files.length > 0) {
                        const file = imageInput.files[0];
                        const reader = new FileReader();

                        const readImageAsBase64 = () =>
                            new Promise((resolve) => {
                                reader.onload = () => resolve(reader.result);
                                reader.readAsDataURL(file);
                            });

                        imageDataUrl = await readImageAsBase64();
                    }

                    // ✅ بناء نموذج المعاينة
                    const question = {
                        Title: getInputValue("questionText"),
                               ValueA: isQuantitative ? toIndicDigitsSafe(getInputValue("ValueA")) : getInputValue("ValueA"),
                               ValueB: isQuantitative ? toIndicDigitsSafe(getInputValue("ValueB")) : getInputValue("ValueB"),

                        Template: parseInt(document.querySelector("input[name='Template']:checked")?.value || 0),
                        IsQuantitative: isQuantitative,
                        ImageUrl: imageDataUrl, // ✅ الصورة base64
                        CorrectAnswer: (() => {
                            const selectedRadio = document.querySelector("input[name='SelectedCorrectIndex']:checked");
                            if (!selectedRadio) return "";
                            const index = selectedRadio.value;
                            const optionInput = document.getElementById(`optionText_${index}`);
                            return optionInput?.value || "";
                        })(),
                        Options: []
                    };

                    // ✅ تحميل الاختيارات
                    for (let i = 0; i < 4; i++) {
                        const optionInput = document.getElementById(`optionText_${i}`);
                        if (optionInput && optionInput.value.trim()) {
                            question.Options.push({ Text: optionInput.value.trim() });
                        }
                    }

                    if (!question.Title) {
                        alert("⚠️ يرجى إدخال نص السؤال.");
                        return;
                    }

                    if (question.Options.length === 0) {
                        alert("⚠️ يجب إدخال خيار واحد على الأقل.");
                        return;
                    }

                    try {
                        const res = await fetch(`${fetchBasePath}/PreviewFromCreate`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(question)
                        });

                        const html = await res.text();
                        document.getElementById("questionPreviewContainer").innerHTML = html;
                        new bootstrap.Modal(document.getElementById("questionPreviewModal")).show();
                    } catch (err) {
                        console.error("❌ خطأ في تحميل المعاينة:", err);
                        document.getElementById("questionPreviewContainer").innerHTML = "<div class='text-danger'>فشل في تحميل المعاينة</div>";
                    }
                }






