                        // ✅ عند اختيار مقارنة أو مقارنة بصورة نقترح تلقائيًا الاختيارات المعتادة
                document.querySelectorAll(".template-selector").forEach(radio => {
                    radio.addEventListener("change", function () {
                        const templateValue = this.value;
                        const isComparison = templateValue === "1" || templateValue === "3"; // 1 نصي - 3 مقارنة

                        if (isComparison) {
                            const suggestions = [
                                "القيمة الأولى أكبر",
                                "القيمة الثانية أكبر",
                                "القيمتان متساويتان",
                                "المعطيات غير كافية"
                            ];

                            suggestions.forEach((text, i) => {
                                const optionInput = document.getElementById(`optionText_${i}`);
                                if (optionInput) {
                                    optionInput.value = text;
                                }
                            });

                            // تأكد من إلغاء تحديد أي اختيار صحيح سابق
                            document.querySelectorAll("input[name='SelectedCorrectIndex']").forEach(radio => {
                                radio.checked = false;
                            });
                        }
                    });
                });


                // تغيير الكلمات باللون الاحمر

                         let selectedWords = [];

                function processVerbalWords() {
                    const area = document.getElementById("verbalWordSelectorArea");
                    const text = document.getElementById("verbalFullText").value;
                    area.innerHTML = "";

                    selectedWords = [];

                    const words = text.trim().split(/\s+/);
                    words.forEach(word => {
                        const span = document.createElement("span");
                        span.className = "mx-1";
                        span.innerText = word;
                        span.style.cursor = "pointer";
                        span.onclick = function () {
                            if (selectedWords.includes(word)) {
                                selectedWords = selectedWords.filter(w => w !== word);
                                span.classList.remove("highlight-word");
                            } else if (selectedWords.length < 4) {
                                selectedWords.push(word);
                                span.classList.add("highlight-word");
                            }
                            updateSelectedWordsPreview();
                        };
                        area.appendChild(span);
                    });

                    updateSelectedWordsPreview();
                }

                function updateSelectedWordsPreview() {
                    document.getElementById("selectedWordsPreview").innerText = selectedWords.join(" - ");
                }

                    function insertVerbalToQuestionText() {
                    const text = document.getElementById("verbalFullText").value;
                    if (!text) return;

                    let highlighted = text;

                    selectedWords.forEach(word => {
                        highlighted = highlighted.split(word).join(`<span class='highlight-word'>${word}</span>`);
                    });

                    // ✅ ضع النص في Textarea كما كنت تفعل مع الكسر والجذر
                    document.getElementById("questionText").value = highlighted;

                    // ✅ لتحديث المعاينة المباشرة
                    document.getElementById("questionText").dispatchEvent(new Event('input'));
                }


                function fillOptionsFromSelectedWords() {
                    selectedWords.forEach((word, index) => {
                        const input = document.getElementById(`optionText_${index}`);
                        if (input) input.value = word;
                    });
                }






    </script>

    <script>
        // ✅ عند فتح Edit نقوم بتحميل المحاور والمؤشرات تلقائيًا حسب الحفظ السابق
        document.addEventListener("DOMContentLoaded", function () {
            const curriculumSelect = document.getElementById("curriculumSelect");
            const sectionSelect = document.getElementById("sectionSelect");
            const lessonSelect = document.getElementById("lessonSelect");

            const existingSectionId = '@Model.SectionId';
            const existingLessonId = '@Model.LessonId';

            const curriculumId = curriculumSelect.value; // ✅ الحل هنا

            if (curriculumId) {
                fetch(`${fetchBasePath}/GetSectionsByCurriculum?curriculumId=${curriculumId}`)
                    .then(res => res.json())
                    .then(sections => {
                        sectionSelect.innerHTML = `<option value="">اختر المحور</option>`;
                        sections.forEach(section => {
                            const option = document.createElement('option');
                            option.value = section.id;
                            option.textContent = section.title;
                            if (option.value === existingSectionId) option.selected = true;
                            sectionSelect.appendChild(option);
                        });

                        if (existingSectionId) {
                            fetch(`${fetchBasePath}/GetLessonsBySection?sectionId=${existingSectionId}`)
                                .then(res => res.json())
                                .then(data => {
                                    lessonSelect.innerHTML = `<option value="">اختر الدرس</option>`;
                                    data.forEach(lesson => {
                                        const option = document.createElement('option');
                                        option.value = lesson.id;
                                        option.textContent = lesson.title;
                                        if (option.value === existingLessonId) option.selected = true;
                                        lessonSelect.appendChild(option);
                                    });
                                });
                        }
                    });
            }
        });

    </script>


    <script>

                function appendOptionsToTitle() {
            const questionInput = document.getElementById('questionText');

            // تأكد إذا فيه span موجود بالفعل لا تضيفه مرة ثانية
            if (questionInput.value.includes('<span style="display:none;">')) {
                alert("⚠️ تم إضافة النص المخفي سابقًا بالفعل.");
                return;
            }

            const optionTexts = [];
            for (let i = 0; i < 4; i++) {
                const input = document.getElementById(`optionText_${i}`);
                if (input && input.value.trim() !== "") {
                    optionTexts.push(input.value.trim());
                }
            }

            const hiddenText = optionTexts.join(" - ");

            if (hiddenText && questionInput) {
                questionInput.value += ` <span style="display:none;">${hiddenText}</span>`;
                questionInput.dispatchEvent(new Event('input'));
                alert("✅ تم إخفاء الخيارات داخل نص السؤال بنجاح.");
            }
        }


    </script>

    <script>
                document.addEventListener("DOMContentLoaded", function () {
            const removeBtn = document.getElementById("removeImageBtn");
            const preview = document.getElementById('question-image-preview');
            const existingInput = document.querySelector('input[name="ExistingImageUrl"]');

            if (removeBtn) {
                removeBtn.addEventListener("click", () => {
                    if (!confirm("هل أنت متأكد أنك تريد حذف الصورة الحالية؟")) return;

                    preview.src = "#";
                    preview.classList.add('d-none');
                    existingInput.value = "";
                    removeBtn.style.display = "none";

                    alert("✅ تم حذف الصورة بنجاح. عند الحفظ لن يتم الاحتفاظ بها.");
                });
            }
        });

    </script>



