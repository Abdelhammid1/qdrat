@model QdratNew.ViewModels.Question.QuestionCreateViewModel
@using QdratNew.Enums
@using QdratNew.Helpers

@{
    ViewData["Title"] = "تعديل سؤال ذكي";
    var fetchBasePath = "/Instructors/QuestionsReview";

}
@section Styles {

    <!-- في الـ Layout -->
    <link rel="stylesheet" href="https://unpkg.com/mathlive/dist/mathlive.core.css">
    <link rel="stylesheet" href="https://unpkg.com/mathlive/dist/mathlive.css">

    <style>
        table.dataTable td {
            white-space: nowrap; /* يمنع نزول النص للسطر التالي */
            font-size: 14px !important; /* حجم الخط */
            vertical-align: middle; /* توسيط عمودي */
        }

        table.dataTable th {
            white-space: nowrap;
            font-size: 14px !important;
        }

        .table th, .table td {
            padding: 8px 12px;
        }

        .table .btn {
            font-size: 13px;
            padding: 4px 8px;
        }

        textarea {
            direction: rtl !important;
            unicode-bidi: plaintext !important;
            white-space: pre-line;
        }

        .highlight-word {
            color: red;
            text-decoration: underline;
            cursor: pointer;
        }

    </style>





}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-qdrat mb-0">
        <i class="fas fa-question-circle"></i> إضافة سؤال ذكي
    </h2>

    <a asp-action="PendingReview" class="btn btn-qdrat">
        <i class="fas fa-arrow-circle-left"></i> العودة إلى القائمة
    </a>
</div>


@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}


<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ExistingImageUrl" />


    <!-- ✅ الروابط المنهجية -->
    <div class="card mb-3">
        <div class="card-header bg-light fw-bold text-qdrat">
            <i class="fas fa-link text-dark"></i> ربط المنهج والمحور والدرس
        </div>
        <div class="card-body row">
            <div class="col-md-4">
                <label class="mb-2" asp-for="CurriculumId">القسم</label>
                <select asp-for="CurriculumId" asp-items="Model.Curriculums" class="form-control" id="curriculumSelect">
                    <option value="">اختر القسم</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="mb-2" asp-for="SectionId">المحور</label>
                <select asp-for="SectionId" class="form-control" id="sectionSelect">
                    <option value="">اختر المحور</option>
                </select>
            </div>
            @*      <div class="col-md-3">
                <label>الوحدة</label>
                <select id="unitSelect" class="form-control">
                    <option value="">اختر الوحدة</option>
                </select>
            </div> *@

            <div class="col-md-4">
                <label class="mb-2" asp-for="LessonId">المؤشر</label>
                <select asp-for="LessonId" class="form-control" id="lessonSelect">
                    <option value="">اختر المؤشر</option>
                </select>
            </div>


        </div>

        <div class="card mb-4">
            <div class="card-header bg-light fw-bold text-qdrat">
                <i class="fas fa-link text-dark"></i> القطعة اللفظية (اختيارية )
            </div>
            <div class="card-body row">
                <div class="mb-3">
                    <label asp-for="VerbalPassageId" class="form-label">اختر القطعة اللفظية (اختياري)</label>
                    <select asp-for="VerbalPassageId" asp-items="Model.VerbalPassages" class="form-control">
                        <option value="">بدون</option>
                    </select>
                </div>

            </div>
        </div>
    </div>

    <!-- ✅ نوع السؤال -->
    <div class="card mb-4">
        <div class="card-header bg-light fw-bold text-qdrat">
            <i class="fas fa-sliders-h me-1 text-dark"></i> نوع السؤال
        </div>
        <div class="card-body">
            <div class="btn-group d-flex flex-wrap">
                @foreach (var type in Enum.GetValues(typeof(QuestionTemplate)))
                {
                    var selected = (int)type == (int)Model.Template ? "checked" : "";
                    <label class="btn btn-outline-success m-1">
                        <input type="radio" name="Template" value="@((int)type)" class="me-2 template-selector" @selected />
                        @(
                                            type.ToString()
                                            .Replace("TextOnly", "نصي")
                                            .Replace("CompareValues", "مقارنة")
                                            .Replace("WithImage", "صورة")
                                            .Replace("CompareWithImage", "صورة + مقارنة")
                                            .Replace("ImageOptions", "إجابات بصور")
                                            )
                </label>

                                }
            </div>
        </div>
    </div>

    <!-- ✅ نص السؤال + أدوات الإدخال -->
    <div class="card mb-4">
        <div class="card-header bg-light fw-bold text-qdrat">
            <i class="fas fa-pen me-1 text-dark"></i> نص السؤال وأدوات الرياضيات
        </div>
        @*         <partial name="~/Views/Shared/_SelectWordsPartial.cshtml" />
 *@
        <div class="card-body">
            <label class="mb-2" asp-for="Title">نص السؤال</label>

            <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#verbalWordsModal">
                🔴 اختيار الكلمات المميزة (اللفظي)
            </button>

            <button style="float:left;" type="button" class="btn btn-outline-secondary btn-sm" onclick="appendOptionsToTitle()">
                📥 إخفاء السؤال في المفردة الشاذة داخل السؤال
            </button>



            <div class="input-group mb-2">
<textarea asp-for="Title"
          class="form-control"
          rows="3"
          id="questionText"
          style="direction: rtl; unicode-bidi: plaintext; font-family: 'Tahoma', 'Arial';">
</textarea>
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="d-flex flex-wrap gap-2 mb-3">

                @*       <button type="button" class="btn btn-warning btn-sm" onclick="cleanQuestionText()">
                    🧹 تنظيف النص من شوائب النسخ
                </button>
 *@



                <button type="button" class="btn btn-dark btn-sm" onclick="openFractionModal('questionText')" title="إدخال كسر">
                    <i class="fas fa-divide"></i>
                </button>
                <!-- زر فتح كسر ذكي (يحتوي على الجذر والأس داخليًا) -->
                <button type="button" class="btn btn-dark btn-sm" onclick="openFractionModal('questionText')" title="إدخال كسر ذكي (يدعم الجذر والأس)">
                    <i class="fas fa-divide"></i><sup>+</sup>
                </button>

                <button type="button" class="btn btn-dark btn-sm" onclick="openRootModal('questionText')" title="إدخال جذر">
                    <i class="fas fa-square-root-alt"></i>
                </button>
                <button type="button" class="btn btn-dark btn-sm" onclick="openNestedRootModal('questionText')" title="إدخال جذر متداخل">
                    <i class="fas fa-stream"></i>
                </button>
                <button type="button" class="btn btn-dark btn-sm" onclick="openExponentModal('questionText')" title="إدخال أُس">
                    <i class="fas fa-superscript"></i>
                </button>
                <button type="button" class="btn btn-dark btn-sm" onclick="openRootWithExponentModal('questionText')" title="جذر + أُس">
                    <i class="fas fa-leaf"></i>
                </button>

                <button type="button" class="btn btn-dark btn-sm" onclick="openAdvancedMathSymbolModal('questionText')" title="علامات كمية متقدمة">
                    <i class="fas fa-magic"></i> إضافة علامة كمية متقدمة
                </button>

                @*      <button type="button" class="btn btn-dark btn-sm" onclick="openMathLiveModal('questionText')">
                    <i class="fas fa-square-root-alt"></i> إدخال معادلة رياضية
                </button>
 *@




            </div>

            <label class="form-label">📌 المعاينة الفورية:</label>
            <div id="questionPreview"
                 class="border rounded bg-light p-3"
                 style="min-height: 50px; font-size: 22px; font-weight: bold; line-height: 1.6;">
            </div>





        </div>
    </div>

    <!-- ✅ قيم المقارنة -->
    <div class="card mb-4" id="valueFields" style="display:none;">
        <div class="card-header bg-light fw-bold text-qdrat">
            <i class="fas fa-balance-scale text-dark"></i> قيم المقارنة
        </div>
        <div class="card-body row">
            <div class="col-md-6">
                <label>القيمة الأولى</label>
                <input asp-for="ValueA" class="form-control" id="ValueA" />
            </div>
            <div class="col-md-6">
                <label>القيمة الثانية</label>
                <input asp-for="ValueB" class="form-control" id="ValueB" />
            </div>
        </div>
    </div>

    <!-- ✅ صورة السؤال -->
    <!-- ✅ صورة السؤال -->
    <div class="card mb-4" id="imageField" style="display:none;">
        <div class="card-header bg-light fw-bold text-qdrat">
            <i class="fas fa-image text-dark"></i> صورة السؤال
        </div>
        <div class="card-body row">
            <!-- ✅ منطقة السحب والإفلات (نصف العرض) -->
            <div class="col-md-6">
                <div id="question-dropzone" class="border border-secondary rounded p-4 text-center bg-light" style="cursor: pointer;">
                    اسحب الصورة هنا أو انقر لاختيارها
                </div>
                <input asp-for="ImageFile" type="file" class="d-none" id="question-image-input" />
            </div>

            <!-- ✅ معاينة الصورة بجوارها -->
            <div class="col-md-6 d-flex align-items-center justify-content-center">
                <img id="question-image-preview"
                     src="@(string.IsNullOrWhiteSpace(Model.ExistingImageUrl) ? "#" : Model.ExistingImageUrl)"
                     alt="معاينة الصورة"
                     class="img-thumbnail @(string.IsNullOrWhiteSpace(Model.ExistingImageUrl) ? "d-none" : "")"
                     style="max-width: 100%; max-height: 150px;" />



                @if (!string.IsNullOrWhiteSpace(Model.ExistingImageUrl))
                {
                    <button type="button" id="removeImageBtn" class="btn btn-outline-danger btn-sm mt-2 p-1">
                        <i class="fas fa-trash"></i> حذف الصورة الحالية
                    </button>
                }

            </div>


        </div>
    </div>





    <!-- ✅ درجة الصعوبة -->
    <div class="card mb-4">
        <div class="card-header bg-light fw-bold text-qdrat">
            <i class="fas fa-tachometer-alt text-dark"></i> درجة الصعوبة
        </div>
        <select asp-for="Difficulty" class="form-control">
            @foreach (DifficultyLevel level in Enum.GetValues(typeof(DifficultyLevel)))
            {
                <option value="@level">@level.GetDisplayName()</option>
            }
        </select>

    </div>

    <!-- ✅ الاختيارات -->
    <div class="card mb-4">
        <div class="card-header bg-light fw-bold text-qdrat">
            <i class="fas fa-list-ul text-dark"></i> الاختيارات والإجابات
        </div>
        <div class="card-body">
            @for (int i = 0; i < Model.Options.Count; i++)
            {
                <div class="row align-items-start mb-4">
                    <div class="col-md-6">
                        <label class="mb-2">الإجابة @(i + 1)</label>
                        <input asp-for="Options[@i].Text" class="form-control mb-2" id="optionText_@i" />

                        @if (Model.Options[i].Text == "[صورة]" && !string.IsNullOrWhiteSpace(Model.Options[i].ExistingImageUrl))
                        {
                            <div class="text-muted small mt-1">
                                <i class="fas fa-image"></i> هذا الخيار يحتوي صورة فقط بدون نص.
                            </div>
                        }


                        <!-- ✅ أدوات الرياضيات -->
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-dark btn-sm" onclick="openFractionModal('optionText_@i')" title="إدخال كسر">
                                <i class="fas fa-divide"></i>
                            </button>
                            <button type="button" class="btn btn-dark btn-sm" onclick="openFractionModal('optionText_@i')" title="إدخال كسر">
                                <i class="fas fa-divide"></i>
                            </button>
                            <button type="button" class="btn btn-dark btn-sm" onclick="openRootModal('optionText_@i')" title="إدخال جذر">
                                <i class="fas fa-square-root-alt"></i>
                            </button>
                            <button type="button" class="btn btn-dark btn-sm" onclick="openNestedRootModal('optionText_@i')" title="جذر متداخل">
                                <i class="fas fa-stream"></i>
                            </button>
                            <button type="button" class="btn btn-dark btn-sm" onclick="openExponentModal('optionText_@i')" title="أُس">
                                <i class="fas fa-superscript"></i>
                            </button>
                            <button type="button" class="btn btn-dark btn-sm" onclick="openAdvancedMathSymbolModal('questionText')" title="علامات كمية متقدمة">
                                <i class="fas fa-magic"></i> إضافة علامة كمية متقدمة
                            </button>

                        </div>
                    </div>

                    <div class="col-md-1 text-center">
                        <label>صحيحة؟</label><br />
                        <input type="radio"
                               name="SelectedCorrectIndex"
                               value="@i"
                               class="form-check-input mt-2"
                               @(Model.SelectedCorrectIndex == i ? "checked" : "") />
                    </div>

                    <div class="col-md-5">
                        <button type="button" class="btn btn-outline-secondary btn-sm toggle-img mt-3" data-target="imgField_@i">
                            <i class="fas fa-plus"></i> صورة
                        </button>

                        <div id="imgField_@i" class="mt-2" style="@(string.IsNullOrWhiteSpace(Model.Options[i].ExistingImageUrl) ? "display:none;" : "display:block;")">
                            <label>تحميل صورة جديدة</label>
                            <input asp-for="Options[@i].ImageFile" class="form-control mb-2" />

                            @* ✅ هنا نعرض الصورة القديمة إن وُجد *@
                            @if (!string.IsNullOrWhiteSpace(Model.Options[i].ExistingImageUrl))
                            {
                                <div class="mt-2">
                                    <img src="@Model.Options[i].ExistingImageUrl"
                                         alt="صورة الإجابة"
                                         style="max-width: 120px; max-height: 120px; border: 1px solid #ccc; padding: 4px;" />
                                    <div class="form-check mt-1">
                                        <input asp-for="Options[@i].RemoveImage" class="form-check-input" />
                                        <label class="form-check-label">حذف الصورة</label>
                                    </div>
                                </div>
                            }

                            @* Hidden input لحفظ مسار الصورة القديمة *@
                            <input type="hidden" asp-for="Options[@i].ExistingImageUrl" />
                        </div>
                    </div>


                </div>
            }
        </div>
    </div>

    <!-- ✅ التصنيفات الخاصة بالسؤال -->
    <!-- ✅ التصنيفات الخاصة بالسؤال -->
    <div class="card mb-4">
        <div class="card-header bg-light fw-bold text-qdrat">
            <i class="fas fa-tags text-dark"></i> تصنيف السؤال (يمكن اختيار أكثر من نوع)
        </div>
        <div class="card-body d-flex flex-wrap gap-3">
            @foreach (var type in Enum.GetValues(typeof(QuestionUsageType)).Cast<QuestionUsageType>())
            {
                if (type == QuestionUsageType.None) continue;

                <div class="form-check me-3">
                    <input class="form-check-input"
                           type="checkbox"
                           name="SelectedUsageTypes"
                           value="@type"
                           @(Model.SelectedUsageTypes.Contains(type) ? "checked" : "") />

                    <label class="form-check-label">
                        @type.GetDisplayName()
                    </label>
                </div>
            }

        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-light fw-bold text-qdrat">
            <i class="fas fa-sticky-note text-dark"></i> تلميح
        </div>
        <div class="card-body">
            <textarea asp-for="InternalNote" class="form-control" rows="2" placeholder="ضع لمحتك"></textarea>
        </div>
    </div>

    <!-- ✅ الشرح ورابط الفيديو -->
    <div class="card mb-4">
        <div class="card-header bg-light fw-bold text-qdrat">
            <i class="fas fa-info-circle text-dark"></i> شرح إضافي ورابط فيديو
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label class="mb-2" asp-for="Explanation">شرح إضافي</label>
                <textarea asp-for="Explanation" class="form-control"></textarea>
            </div>
            <div>
                <label class="mb-2" asp-for="VideoUrl">رابط الفيديو</label>
                <input asp-for="VideoUrl" class="form-control" />
            </div>
        </div>
    </div>
    <div class="text-center mt-4 mb-5">
        <button type="button"
                class="btn btn-qdrat"
                onclick="loadQuestionPreview()">
            <i class="fas fa-eye"></i> معاينة السؤال قبل الحفظ
        </button>

    </div>
    <button type="submit" class="btn btn-qdrat btn-lg mt-3">
        <i class="fas fa-save"></i> حفظ
    </button>
</form>

<hr />

<partial name="_QuestionFractionAndRootModals" />


<div class="modal fade" id="advancedMathSymbolModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-magic"></i> إدراج علامة كمية متقدمة</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label>نوع العلامة:</label>
                    <select id="mathSymbolType" class="form-select">
                        <option value="overline">شرطة أفقية</option>
                        <option value="arc">قوس منحني</option>
                        <option value="angle">زاوية هندسية</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label>النص أو الحروف المراد وضع العلامة فوقها:</label>
                    <input type="text" id="mathSymbolText" class="form-control" placeholder="مثال: أ ب ج أو ١ + ٢">
                </div>
                <button class="btn btn-success w-100" onclick="insertAdvancedMathSymbol()">إدراج</button>
            </div>
        </div>
    </div>
</div>



<div class="modal fade" id="questionPreviewModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-eye"></i> معاينة السؤال</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="questionPreviewContainer">
                <div class="text-center text-muted">جاري التحميل...</div>
            </div>
        </div>
    </div>



</div>




<div class="modal fade" id="verbalWordsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-highlighter"></i> اختيار الكلمات المميزة في السؤال اللفظي</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">

                <textarea class="form-control mb-3" id="verbalFullText" rows="5" placeholder="الصق هنا نص السؤال..."></textarea>

                <button type="button" class="btn btn-outline-primary mb-3" onclick="processVerbalWords()">تحليل النص واختيار الكلمات</button>

                <div class="border rounded p-3 bg-light" id="verbalWordSelectorArea" style="min-height: 100px;">
                    <small class="text-muted">سيتم عرض الكلمات هنا...</small>
                </div>

                <div class="mt-3">
                    <strong>الكلمات المختارة:</strong>
                    <div id="selectedWordsPreview" class="mt-2 text-danger fw-bold"></div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" onclick="insertVerbalToQuestionText()">نسخ إلى نص السؤال</button>
                <button type="button" class="btn btn-dark" onclick="fillOptionsFromSelectedWords()">تعبئة الاختيارات تلقائيًا</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
            </div>
        </div>
    </div>
</div>






@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.0/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/mathlive/dist/mathlive.min.js"></script>

    <script>
                     // ✅ عند فتح Edit نقوم بتحميل المحاور والمؤشرات تلقائيًا حسب الحفظ السابق
        document.addEventListener("DOMContentLoaded", function () {
            const curriculumSelect = document.getElementById("curriculumSelect");
            const sectionSelect = document.getElementById("sectionSelect");
            const lessonSelect = document.getElementById("lessonSelect");

            const existingSectionId = '@Model.SectionId';
            const existingLessonId = '@Model.LessonId';

            const curriculumId = curriculumSelect?.value;

            if (!curriculumId) return;

            // ✅ تحميل المحاور من السيرفر
            fetch(`/Instructors/QuestionsReview/GetSectionsByCurriculum?id=${curriculumId}`)
                .then(res => res.json())
                .then(sections => {
                    sectionSelect.innerHTML = `<option value="">اختر المحور</option>`;
                    sections.forEach(section => {
                        const option = document.createElement('option');
                        option.value = section.id;
                        option.textContent = section.title;
                        if (section.id == existingSectionId) option.selected = true;
                        sectionSelect.appendChild(option);
                    });

                    // ✅ بعد تحميل المحاور، نحمّل المؤشرات لو كان sectionId موجود
                    if (existingSectionId) {
                        fetch(`/Instructors/QuestionsReview/GetLessonsBySection?id=${existingSectionId}`)
                            .then(res => res.json())
                            .then(lessons => {
                                lessonSelect.innerHTML = `<option value="">اختر الدرس</option>`;
                                lessons.forEach(lesson => {
                                    const option = document.createElement('option');
                                    option.value = lesson.id;
                                    option.textContent = lesson.title;
                                    if (lesson.id == existingLessonId) option.selected = true;
                                    lessonSelect.appendChild(option);
                                });
                            });
                    }
                });
        });

                        let activeInputId = null;
                        let rootTargetFieldId = null;
                        let nestedRootInputTarget = null;
                        let nestedRootLevel = 1;

                        // ✅ تحديد رمز الجذر حسب طول القيمة
                        function getRootSymbolBasedOnLength(value) {
                            const clean = value.replace(/<[^>]*>?/gm, '').trim();
