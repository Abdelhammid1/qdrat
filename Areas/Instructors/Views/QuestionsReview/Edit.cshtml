                            dropzone.classList.remove('bg-info', 'text-white');
                        });
                    });

                    dropzone.addEventListener('click', () => input.click());

                    dropzone.addEventListener('drop', e => {
                        const file = e.dataTransfer.files[0];
                        if (file && file.type.startsWith('image/')) {
                            input.files = e.dataTransfer.files;
                            showPreview(file);
                        }
                    });

                    input.addEventListener('change', () => {
                        const file = input.files[0];
                        if (file) showPreview(file);
                    });

                    function showPreview(file) {
                        const reader = new FileReader();
                        reader.onload = e => {
                            preview.src = e.target.result;
                            preview.classList.remove('d-none');
                        };
                        reader.readAsDataURL(file);
                    }

                function cleanQuestionText() {
                    const textarea = document.getElementById('questionText');
                    if (!textarea) return;

                    let text = textarea.value;

                    text = text
                        .replace(/[\u200B-\u200F\u202A-\u202E\u2060-\u206F\uFEFF]/g, '') // حذف كل الرموز المخفية
                        .replace(/[\r\n]+/g, '\n') // توحيد نهاية الأسطر
                        .replace(/[ ]{2,}/g, ' ') // إزالة تكرار المسافات
                        .replace(/\s*\n\s*/g, '\n') // حذف الفراغ قبل وبعد كل سطر
                        .trim(); // إزالة الفراغ أول وآخر النص

                    textarea.value = text;
                    textarea.dispatchEvent(new Event('input')); // لتحديث المعاينة الفورية
                }



