@model QdratNew.ViewModels.Instructor.Lectures.InstructorLectureListItemViewModel

@{
    ViewData["Title"] = "تفاصيل المحاضرة";
}

<div class="lecture-details-page" dir="rtl">
    <div class="details-card">
        <h1>@Model.Title</h1>

        <div class="details-grid">
            <div>
                <span>الدفعة</span>
                <strong>@Model.BatchName</strong>
            </div>

            <div>
                <span>الدورة</span>
                <strong>@Model.CourseName</strong>
            </div>

            <div>
                <span>المحور</span>
                <strong>@Model.SectionTitle</strong>
            </div>

            <div>
                <span>المكان</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.Location) ? "غير محدد" : Model.Location)</strong>
            </div>

            <div>
                <span>التاريخ</span>
                <strong>@Model.Date.ToString("yyyy/MM/dd HH:mm")</strong>
            </div>
        </div>

        <div class="details-actions">
            <a asp-area="Instructors"
               asp-controller="InstructorAttendance"
               asp-action="Record"
               asp-route-lectureId="@Model.LectureId"
               class="btn btn-success">
                تسجيل الحضور
            </a>

            <a asp-area="Instructors"
               asp-controller="InstructorLectures"
               asp-action="Edit"
               asp-route-id="@Model.LectureId"
               class="btn btn-primary">
                تعديل
            </a>

            <a asp-area="Instructors"
               asp-controller="InstructorLectures"
               asp-action="Index"
               class="btn btn-light">
                رجوع
            </a>
        </div>
    </div>
</div>

<style>
    .lecture-details-page {
        padding: 28px;
        background: #f6f8fb;
        min-height: calc(100vh - 90px);
    }

    .details-card {
        background: #fff;
        border: 1px solid #e5edf7;
        border-radius: 26px;
        padding: 28px;
        box-shadow: 0 16px 38px rgba(15, 23, 42, .08);
    }

        .details-card h1 {
            margin: 0 0 22px;
            font-weight: 900;
            color: #0f172a;
        }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 14px;
    }

        .details-grid div {
            background: #f8fafc;
            border: 1px solid #edf2f7;
            border-radius: 18px;
            padding: 16px;
        }

        .details-grid span {
            display: block;
            color: #64748b;
            font-weight: 800;
            margin-bottom: 7px;
        }

        .details-grid strong {
            color: #0f172a;
            font-weight: 900;
        }

    .details-actions {
        display: flex;
        gap: 12px;
        margin-top: 24px;
    }

        .details-actions .btn {
            border-radius: 14px;
            font-weight: 900;
            padding: 11px 18px;
        }

    @@media(max-width: 768px) {
        .lecture-details-page {
            padding: 16px;
        }

        .details-actions {
            flex-direction: column;
        }
    }
</style>