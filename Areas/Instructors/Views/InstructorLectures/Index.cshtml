@model QdratNew.ViewModels.Instructor.Lectures.InstructorLecturesIndexViewModel

@{
    ViewData["Title"] = "محاضراتي";
}

<div class="lecture-page" dir="rtl">
    <div class="lecture-hero">
        <div>
            <span>منطقة المدرب</span>
            <h1>محاضراتي</h1>
            <p>إدارة المحاضرات المرتبطة بدفعاتك فقط.</p>
        </div>

        <a asp-area="Instructors"
           asp-controller="InstructorLectures"
           asp-action="Create"
           asp-route-batchId="@Model.BatchId"
           class="btn btn-create">
            إنشاء محاضرة
        </a>
    </div>

    <form method="get" class="lecture-filter">
        <select asp-for="BatchId" asp-items="Model.Batches" class="form-select">
            <option value="">كل الدفعات</option>
        </select>

        <button type="submit" class="btn btn-primary">تصفية</button>
    </form>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (Model.Lectures == null || !Model.Lectures.Any())
    {
        <section class="empty-state">
            <div class="empty-icon">
                <i class="bi bi-calendar-x"></i>
            </div>
            @if (Model.BatchId.HasValue)
            {
                <h3>لا توجد محاضرات لهذه الدفعة</h3>
                <p>جرّب اختيار دفعة أخرى أو عرض كل الدفعات.</p>
            }
            else
            {
                <h3>لا توجد محاضرات حتى الآن</h3>
                <p>لن تظهر هنا إلا المحاضرات المرتبطة بدفعاتك كمدرب.</p>
            }
        </section>
    }
    else
    {
        <div class="lecture-grid">
            @foreach (var item in Model.Lectures)
            {
                <div class="lecture-card">
                    <div class="lecture-card-head">
                        <div>
                            <h3>@item.Title</h3>
                            <p>@item.BatchName - @item.CourseName</p>
                        </div>

                        <span>@item.Date.ToString("yyyy/MM/dd HH:mm")</span>
                    </div>

                    <div class="lecture-info">
                        <div>
                            <small>المحور</small>
                            <strong>@item.SectionTitle</strong>
                        </div>

                        <div>
                            <small>المكان</small>
                            <strong>@(string.IsNullOrWhiteSpace(item.Location) ? "غير محدد" : item.Location)</strong>
                        </div>
                    </div>

                    <div class="lecture-actions">
                        <a asp-area="Instructors"
                           asp-controller="InstructorLectures"
                           asp-action="Details"
                           asp-route-id="@item.LectureId"
                           class="btn btn-outline-primary">
                            التفاصيل
                        </a>

                        <a asp-area="Instructors"
                           asp-controller="InstructorLectures"
                           asp-action="Edit"
                           asp-route-id="@item.LectureId"
                           class="btn btn-outline-secondary">
                            تعديل
                        </a>

                        <a asp-area="Instructors"
                           asp-controller="InstructorAttendance"
                           asp-action="Record"
                           asp-route-lectureId="@item.LectureId"
                           class="btn btn-success">
                            تسجيل الحضور
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .lecture-page {
        padding: 28px;
        background: #f6f8fb;
        min-height: calc(100vh - 90px);
    }

    .lecture-hero {
        background: linear-gradient(135deg, #0f172a, #1d4ed8);
        color: #fff;
        border-radius: 26px;
        padding: 28px;
        margin-bottom: 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
    }

        .lecture-hero span {
            display: inline-block;
            background: rgba(255,255,255,.15);
            border-radius: 999px;
            padding: 7px 14px;
            margin-bottom: 12px;
            font-weight: 700;
        }

        .lecture-hero h1 {
            margin: 0 0 8px;
            font-weight: 900;
        }

        .lecture-hero p {
            margin: 0;
            color: #dbeafe;
        }

    .btn-create {
        background: #fff;
        color: #1d4ed8;
        font-weight: 900;
        border-radius: 16px;
        padding: 12px 18px;
    }

    .lecture-filter {
        background: #fff;
        border: 1px solid #e5edf7;
        border-radius: 20px;
        padding: 18px;
        margin-bottom: 22px;
        display: grid;
        grid-template-columns: 1fr 160px;
        gap: 12px;
    }

        .lecture-filter .form-select,
        .lecture-filter .btn {
            height: 48px;
            border-radius: 14px;
            font-weight: 800;
        }

    .lecture-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
        gap: 18px;
    }

    .lecture-card {
        background: #fff;
        border: 1px solid #e5edf7;
        border-radius: 24px;
        padding: 22px;
        box-shadow: 0 12px 30px rgba(15, 23, 42, .07);
    }

    .lecture-card-head {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 18px;
    }

        .lecture-card-head h3 {
            margin: 0 0 6px;
            font-weight: 900;
            color: #0f172a;
        }

        .lecture-card-head p {
            margin: 0;
            color: #64748b;
            font-weight: 700;
        }

        .lecture-card-head span {
            background: #eff6ff;
            color: #1d4ed8;
            border-radius: 999px;
            padding: 7px 12px;
            font-weight: 900;
            white-space: nowrap;
            height: fit-content;
        }

    .lecture-info {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 18px;
    }

        .lecture-info div {
            background: #f8fafc;
            border: 1px solid #edf2f7;
            border-radius: 16px;
            padding: 14px;
        }

        .lecture-info small {
            display: block;
            color: #64748b;
            margin-bottom: 6px;
            font-weight: 800;
        }

        .lecture-info strong {
            color: #0f172a;
            font-weight: 900;
        }

    .lecture-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

        .lecture-actions .btn {
            border-radius: 14px;
            font-weight: 900;
        }

        .lecture-actions .btn-success {
            grid-column: 1 / -1;
        }

    .empty-box {
        background: #fff;
        border-radius: 22px;
        padding: 40px;
        text-align: center;
        font-weight: 900;
        color: #64748b;
    }

    .empty-state {
        padding: 60px 20px;
        border-radius: 28px;
        background: #fff;
        border: 1px solid #e5edf7;
        text-align: center;
        box-shadow: 0 16px 38px rgba(15, 23, 42, 0.07);
    }

    .empty-icon {
        width: 82px;
        height: 82px;
        margin: 0 auto 18px;
        border-radius: 28px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
    }

    .empty-state h3 {
        margin: 0 0 8px;
        color: #0f172a;
        font-size: 24px;
        font-weight: 900;
    }

    .empty-state p {
        margin: 0;
        color: #64748b;
        font-weight: 700;
    }

    @@media(max-width: 768px) {
        .lecture-page {
            padding: 16px;
        }

        .lecture-hero,
        .lecture-card-head {
            flex-direction: column;
            align-items: stretch;
        }

        .lecture-filter,
        .lecture-info,
        .lecture-actions {
            grid-template-columns: 1fr;
        }

            .lecture-actions .btn-success {
                grid-column: auto;
            }
    }
</style>