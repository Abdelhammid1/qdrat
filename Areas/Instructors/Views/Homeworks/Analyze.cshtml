@model QdratNew.ViewModels.Instructor.StudentHomeworkAnalysisViewModel

@{
    ViewData["Title"] = "تحليل أداء الطالب";
    Layout = "~/Views/Shared/_Layout.cshtml"; // ✳️ عدّله حسب Layout الخاص بالمدرب

}

<h2 class="text-primary mb-4">📊 تحليل أداء الطالب: @Model.StudentName</h2>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card border-success mb-3 text-center">
            <div class="card-header bg-success text-white">إجمالي الواجبات</div>
            <div class="card-body">
                <h5 class="card-title">@Model.TotalHomeworks</h5>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-info mb-3 text-center">
            <div class="card-header bg-info text-white">نسبة الإكمال</div>
            <div class="card-body">
                <h5 class="card-title">@Model.CompletionRate %</h5>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-warning mb-3 text-center">
            <div class="card-header bg-warning text-white">الدقة</div>
            <div class="card-body">
                <h5 class="card-title">@Model.AccuracyRate %</h5>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-danger mb-3 text-center">
            <div class="card-header bg-danger text-white">عدد الإجابات الخاطئة</div>
            <div class="card-body">
                <h5 class="card-title">@Model.IncorrectAnswers</h5>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-secondary text-white">
        🧠 التوصية الذكية بناءً على الأداء
    </div>
    <div class="card-body">
        <p class="mb-0">@Model.AIRecommendation</p>
    </div>
</div>

<h4 class="mt-4 text-danger">📉 المؤشرات الضعيفة</h4>
@if (Model.WeakLessons.Any())
{
    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>المحور</th>
                <th>المؤشر</th>
                <th>عدد الأخطاء</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.WeakLessons)
            {
                <tr>
                    <td>@item.SectionTitle</td>
                    <td>@item.LessonTitle</td>
                    <td>@item.ErrorCount</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-success">✅ لا توجد مؤشرات ضعيفة حاليًا.</p>
}

<h4 class="mt-4 text-primary">📝 أحدث 10 واجبات</h4>
@if (Model.LatestHomeworks.Any())
{
    <table class="table table-hover">
        <thead class="table-light">
            <tr>
                <th>المحور</th>
                <th>الدرجة</th>
                <th>مكتمل؟</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var h in Model.LatestHomeworks)
            {
                <tr>
                    <td>@h.SectionTitle</td>
                    <td>@(h.Score.HasValue ? $"{h.Score}/100" : "—")</td>
                    <td>@(h.IsCompleted ? "✅" : "❌")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">لا توجد واجبات حتى الآن.</p>
}

<a href="@Url.Action("Index", "Homeworks", new { area = "Instructors" })" class="btn btn-secondary mt-3">🔙 العودة إلى الواجبات</a>
