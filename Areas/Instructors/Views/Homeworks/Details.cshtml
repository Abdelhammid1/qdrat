@model QdratNew.ViewModels.Instructor.StudentHomeworkDetailsViewModel

@{
    ViewData["Title"] = "تفاصيل واجب الطالب";
    Layout = "~/Views/Shared/_Layout.cshtml"; // عدله لو عندك Layout مخصص للمدرب
}

<h3 class="mb-4 text-primary">📄 تفاصيل الواجب: @Model.HomeworkSetTitle</h3>
<p><strong>👨‍🎓 الطالب:</strong> @Model.StudentName</p>
<p><strong>🕒 تاريخ التسليم:</strong> @(Model.SubmittedAt?.ToString("yyyy/MM/dd HH:mm") ?? "—")</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>السؤال</th>
            <th>إجابة الطالب</th>
            <th>الإجابة الصحيحة</th>
            <th>الصحة</th>
            <th>شرح</th>
            <th>فيديو</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var q in Model.Questions)
        {
            <tr>
                <td>@q.QuestionTitle</td>
                <td>@q.StudentAnswer</td>
                <td>@q.CorrectAnswer</td>
                <td>
                    @if (q.IsCorrect == true)
                    {
                        <span class="text-success">✔️ صحيحة</span>
                    }
                    else if (q.IsCorrect == false)
                    {
                        <span class="text-danger">❌ خاطئة</span>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </td>
                <td>@q.Explanation</td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(q.VideoUrl))
                    {
                        <a href="@q.VideoUrl" target="_blank" class="btn btn-sm btn-outline-info">🎥 فيديو</a>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<a class="btn btn-secondary mt-3" href="@Url.Action("StudentHomeworks", "Homeworks", new { area = "Instructors" })">🔙 العودة</a>
