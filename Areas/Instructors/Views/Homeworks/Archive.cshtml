@model QdratNew.ViewModels.Instructor.StudentHomeworkArchiveViewModel

@{
    ViewData["Title"] = "أرشيف واجبات الطالب";
    Layout = "~/Views/Shared/_Layout.cshtml"; // ✳️ عدّله حسب Layout الخاص بالمدرب

}

<h3 class="mb-4 text-primary">📚 أرشيف واجبات @Model.StudentName</h3>

<table class="table table-bordered table-hover w-100">
    <thead>
        <tr>
            <th>المحور</th>
            <th>المؤشر</th>
            <th>المحاضرة</th>
            <th>الدرجة</th>
            <th>الحالة</th>
            <th>الإجابة</th>
            <th>تاريخ التسليم</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var hw in Model.Homeworks)
        {
            <tr>
                <td>@hw.SectionTitle</td>
                <td>@hw.LessonTitle</td>
                <td>@(hw.LectureDate?.ToString("yyyy/MM/dd") ?? "—")</td>
                <td>@(hw.Score.HasValue? hw.Score + " / 1" : "-")</td>
                <td>@(hw.IsCompleted ? "✅ مكتمل" : "⏳ غير مكتمل")</td>
                <td>
                    @if (hw.IsCorrect == true)
                    {
                        <span class="text-success">✔️ صحيحة</span>
                    }
                    else if (hw.IsCorrect == false)
                    {
                        <span class="text-danger">❌ خاطئة</span>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </td>
                <td>@(hw.SubmittedAt?.ToString("yyyy/MM/dd HH:mm") ?? "—")</td>
            </tr>
        }
    </tbody>
</table>
