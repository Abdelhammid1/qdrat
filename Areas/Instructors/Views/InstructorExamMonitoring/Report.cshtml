@model QdratNew.ViewModels.Instructor.Exam.InstructorExamReportVM

@{
    ViewData["Title"] = "تقرير الاختبار";
}

@section Styles {
    <link href="~/css/instructor/instructor-exams.css" rel="stylesheet" asp-append-version="true" />
}

<div class="instructor-page">

    <div class="hw-page-header">
        <h3 class="hw-page-title">
            <i class="fas fa-chart-bar"></i>
            تقرير الاختبار
        </h3>
    </div>

    <div class="row g-3 mb-4 text-center">
        <div class="col-md-3 col-6">
            <div class="exam-stat-card">
                <div class="stat-label">عدد الطلاب</div>
                <div class="stat-value">@Model.TotalStudents</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="exam-stat-card">
                <div class="stat-label">متوسط الدرجات</div>
                <div class="stat-value">@Model.AvgScore</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="exam-stat-card">
                <div class="stat-label">أعلى درجة</div>
                <div class="stat-value" style="color:var(--ex-success)">@Model.HighestScore</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="exam-stat-card">
                <div class="stat-label">أقل درجة</div>
                <div class="stat-value" style="color:var(--ex-danger)">@Model.LowestScore</div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card-box chart-card">
                <h5 class="text-center">نسبة النجاح</h5>
                <canvas id="successChart"></canvas>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card-box chart-card">
                <h5 class="text-center">توزيع الدرجات</h5>
                <canvas id="scoreChart"></canvas>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        new Chart(document.getElementById('successChart'), {
            type: 'doughnut',
            data: {
                labels: ['ناجح', 'راسب'],
                datasets: [{
                    data: [@Model.SuccessCount, @Model.FailCount],
                    backgroundColor: ['#16A34A', '#DC2626'],
                    borderWidth: 3,
                    borderColor: '#fff'
                }]
            },
            options: {
                plugins: { legend: { position: 'bottom' } },
                cutout: '60%',
                responsive: true,
                maintainAspectRatio: false
            }
        });

        new Chart(document.getElementById('scoreChart'), {
            type: 'bar',
            data: {
                labels: ['0-50', '50-75', '75-100'],
                datasets: [{
                    label: 'عدد الطلاب',
                    data: [@Model.Range0_50, @Model.Range50_75, @Model.Range75_100],
                    backgroundColor: ['#DC2626', '#D97706', '#16A34A'],
                    borderRadius: 6
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,.05)' } } },
                responsive: true,
                maintainAspectRatio: false
            }
        });
    </script>
}
