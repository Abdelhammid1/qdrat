@model QdratNew.ViewModels.Partner.Exam.PartnerExamAttemptsVM

@{
    ViewData["Title"] = "محاولات الطالب";
}

@section Styles {
    <link href="~/css/instructor/instructor-exams.css" rel="stylesheet" asp-append-version="true" />
}

<div class="instructor-page">

    <div class="hw-page-header">
        <div>
            <h3 class="hw-page-title">
                <i class="fas fa-clock-rotate-left"></i>
                @Model.StudentName
            </h3>
            <p class="text-muted small mb-0">@Model.ExamTitle</p>
        </div>
    </div>

    <div class="instructor-card">
        <div class="table-responsive">
            <table class="instructor-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>الوقت</th>
                        <th>النتيجة</th>
                        <th>المدة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Attempts)
                    {
                        <tr>
                            <td>@a.AttemptNumber</td>
                            <td>@a.AttemptedAt.ToString("yyyy/MM/dd HH:mm")</td>
                            <td>
                                @if (a.IsCorrect)
                                {
                                    <span class="text-success fw-bold">
                                        <i class="fas fa-check me-1"></i> صحيح
                                    </span>
                                }
                                else
                                {
                                    <span class="text-danger fw-bold">
                                        <i class="fas fa-xmark me-1"></i> خطأ
                                    </span>
                                }
                            </td>
                            <td>
                                @(a.TimeTakenSeconds > 0 ? a.TimeTakenSeconds + " ثانية" : "-")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
