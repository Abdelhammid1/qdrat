@model QdratNew.ViewModels.Partner.Exam.PartnerExamStudentsVM

@{
    ViewData["Title"] = "طلاب الاختبار";
}

@section Styles {
    <link href="~/css/instructor/instructor-exams.css" rel="stylesheet" asp-append-version="true" />
}

<div class="instructor-page">

    <div class="hw-page-header">
        <div>
            <h3 class="hw-page-title">
                <i class="fas fa-users"></i>
                @Model.ExamTitle
            </h3>
            <p class="text-muted small mb-0">@Model.BatchName</p>
        </div>
    </div>

    <div class="instructor-card">
        <div class="table-responsive">
            <table class="instructor-table">
                <thead>
                    <tr>
                        <th>الطالب</th>
                        <th>الحالة</th>
                        <th style="width:200px">الإجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Students)
                    {
                        <tr>
                            <td class="fw-semibold">@s.StudentName</td>
                            <td>
                                @if (s.Status == "تم التسليم")
                                {
                                    <span class="badge bg-success">تم التسليم</span>
                                }
                                else if (s.Status == "قيد الحل")
                                {
                                    <span class="badge bg-warning text-dark">قيد الحل</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">لم يبدأ</span>
                                }
                            </td>
                            <td>
                                <a asp-action="ReviewExamStudent"
                                   asp-route-examAssignmentId="@Model.ExamAssignmentId"
                                   asp-route-studentId="@s.StudentId"
                                   class="btn btn-sm btn-outline-primary mb-1">
                                    <i class="fas fa-book-open me-1"></i> مراجعة
                                </a>
                                <a asp-action="ExamStudentReport"
                                   asp-route-examAssignmentId="@Model.ExamAssignmentId"
                                   asp-route-studentId="@s.StudentId"
                                   class="btn btn-sm btn-outline-success">
                                    <i class="fas fa-chart-bar me-1"></i> تقرير
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
