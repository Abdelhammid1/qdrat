@model List<QdratNew.ViewModels.Notifications.NotificationViewModel>
@{
    ViewData["Title"] = "الإشعارات المرسلة";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="text-center mb-4" style="color:#339999;">📬 سجل الإشعارات المرسلة</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">لا توجد إشعارات مرسلة بعد.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-light text-center">
                    <tr>
                        <th>👤 الطالب</th>
                        <th>📝 الرسالة</th>
                        <th>📂 التصنيف</th>
                        <th>🕒 التاريخ</th>
                        <th>🔗 الرابط</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.StudentName</td>
                            <td>@item.Message</td>
                            <td>
                                <span class="badge bg-secondary">
                                    @item.Category
                                </span>
                            </td>
                            <td>@item.SentAt.ToString("yyyy/MM/dd - HH:mm")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.TargetUrl))
                                {
                                    <a href="@item.TargetUrl" class="btn btn-sm btn-outline-info" target="_blank">الذهاب</a>
                                }
                                else
                                {
                                    <span class="text-muted">لا يوجد</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
