@model List<QdratNew.ViewModels.Homework.HomeworkReportViewModel>

@{
    ViewData["Title"] = "تقرير الواجبات المرسلة";
}

<h3 class="mb-4 text-info">📊 تقرير الواجبات التي أرسلتها</h3>

<table class="table table-bordered table-striped text-center">
    <thead class="table-dark">
        <tr>
            <th>العنوان</th>
            <th>الدفعة</th>
            <th>المنهج</th>
            <th>تاريخ الإرسال</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var hw in Model)
        {
            <tr>
                <td>@hw.Title</td>
                <td>@hw.BatchName</td>
                <td>@hw.CurriculumTitle</td>
                <td>@hw.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
            </tr>
        }
    </tbody>
</table>
