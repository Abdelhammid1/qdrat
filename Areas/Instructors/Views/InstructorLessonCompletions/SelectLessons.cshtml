@model QdratNew.ViewModels.Lesson.LessonCompletionFormViewModel
@{
    ViewData["Title"] = "تسجيل المؤشرات المنتهية";
}

@section Styles {
<style>
    :root {
        --brand-500: #0d9488;
        --brand-600: #0f766e;
        --brand-700: #115e59;
        --brand-100: #ccfbf1;
        --brand-50:  #f0fdfa;
        --slate-900: #0f172a;
        --slate-800: #1e293b;
        --slate-700: #334155;
        --slate-600: #475569;
        --slate-500: #64748b;
        --slate-400: #94a3b8;
        --slate-300: #cbd5e1;
        --slate-200: #e2e8f0;
        --slate-100: #f1f5f9;
        --slate-50:  #f8fafc;
        --red-500: #ef4444;
        --red-100: #fee2e2;
        --amber-500: #f59e0b;
        --blue-500: #3b82f6;
        --blue-50: #eff6ff;
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
        --radius-xl: 20px;
        --shadow-sm: 0 1px 3px rgba(0,0,0,.08), 0 1px 2px rgba(0,0,0,.06);
        --shadow-md: 0 4px 16px rgba(0,0,0,.08), 0 2px 6px rgba(0,0,0,.05);
        --shadow-lg: 0 10px 32px rgba(0,0,0,.1), 0 4px 12px rgba(0,0,0,.06);
        --transition: all .22s cubic-bezier(.4,0,.2,1);
    }

    /* ─── Page Layout ─────────────────────────── */
    .slc-page { padding: 24px 20px 100px; direction: rtl; }

    /* ─── Step Indicator ──────────────────────── */
    .step-indicator {
        display: flex;
        align-items: center;
        gap: 0;
        margin-bottom: 28px;
        background: #fff;
        border-radius: var(--radius-lg);
        padding: 14px 24px;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--slate-200);
    }
    .step-item {
        display: flex;
        align-items: center;
        gap: 12px;
        flex: 1;
    }
    .step-dot {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .85rem;
        font-weight: 800;
        flex-shrink: 0;
        transition: var(--transition);
    }
    .step-dot.active {
        background: var(--brand-500);
        color: #fff;
        box-shadow: 0 4px 14px rgba(13,148,136,.35);
    }
    .step-dot.pending {
        background: var(--slate-100);
        color: var(--slate-400);
        border: 2px solid var(--slate-200);
    }
    .step-dot.done {
        background: var(--brand-100);
        color: var(--brand-600);
    }
    .step-text strong {
        display: block;
        font-size: .85rem;
        font-weight: 700;
        color: var(--slate-800);
        line-height: 1.3;
    }
    .step-text span {
        font-size: .75rem;
        color: var(--slate-400);
    }
    .step-divider {
        flex: 0 0 40px;
        height: 2px;
        background: var(--slate-200);
        border-radius: 2px;
        margin: 0 8px;
    }
    .step-divider.done { background: var(--brand-500); }

    /* ─── Page Hero ───────────────────────────── */
    .page-hero {
        background: linear-gradient(135deg, var(--brand-600) 0%, var(--slate-800) 100%);
        border-radius: var(--radius-xl);
        padding: 28px 32px;
        color: #fff;
        margin-bottom: 24px;
        position: relative;
        overflow: hidden;
    }
    .page-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }
    .page-hero h2 { font-size: 1.35rem; font-weight: 800; margin: 0 0 6px; }
    .page-hero p  { margin: 0; opacity: .8; font-size: .875rem; line-height: 1.6; }
    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,255,255,.15);
        backdrop-filter: blur(6px);
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 20px;
        padding: 4px 14px;
        font-size: .75rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 14px;
    }

    /* ─── Alert ───────────────────────────────── */
    .slc-alert {
        border-radius: var(--radius-md);
        padding: 14px 18px;
        margin-bottom: 20px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        font-size: .875rem;
        border: none;
    }
    .slc-alert.error {
        background: var(--red-100);
        color: #991b1b;
    }
    .slc-alert .alert-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: #fca5a5;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: .8rem;
    }
    .slc-alert .alert-close {
        margin-right: auto;
        background: none;
        border: none;
        color: #b91c1c;
        cursor: pointer;
        padding: 0;
        font-size: .85rem;
        opacity: .7;
    }

    /* ─── Panel Card ──────────────────────────── */
    .panel-card {
        background: #fff;
        border-radius: var(--radius-lg);
        border: 1px solid var(--slate-200);
        box-shadow: var(--shadow-sm);
        margin-bottom: 20px;
        overflow: hidden;
        transition: var(--transition);
    }
    .panel-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 22px;
        border-bottom: 1px solid var(--slate-100);
        background: var(--slate-50);
    }
    .panel-icon {
        width: 40px;
        height: 40px;
        border-radius: var(--radius-sm);
        background: linear-gradient(135deg, var(--brand-500), var(--brand-700));
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .9rem;
        flex-shrink: 0;
        box-shadow: 0 4px 10px rgba(13,148,136,.25);
    }
    .panel-title {
        font-size: .95rem;
        font-weight: 700;
        color: var(--slate-800);
        margin: 0;
    }
    .panel-subtitle {
        font-size: .75rem;
        color: var(--slate-500);
        margin: 2px 0 0;
    }
    .panel-body { padding: 22px; }

    /* ─── Form Controls ───────────────────────── */
    .field-label {
        display: block;
        font-size: .75rem;
        font-weight: 700;
        color: var(--slate-500);
        text-transform: uppercase;
        letter-spacing: .05em;
        margin-bottom: 7px;
    }
    .field-control {
        width: 100%;
        background: #fff;
        border: 1.5px solid var(--slate-200);
        border-radius: var(--radius-md);
        padding: 10px 14px;
        font-size: .875rem;
        color: var(--slate-800);
        font-family: inherit;
        transition: var(--transition);
        outline: none;
        appearance: none;
    }
    .field-control:focus {
        border-color: var(--brand-500);
        box-shadow: 0 0 0 4px rgba(13,148,136,.12);
    }
    .field-control:disabled {
        background: var(--slate-50);
        color: var(--slate-400);
        cursor: not-allowed;
    }
    .field-control::placeholder { color: var(--slate-400); }
    .select-wrapper { position: relative; }
    .select-wrapper::after {
        content: '\f107';
        font-family: 'Font Awesome 5 Free';
        font-weight: 900;
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--slate-400);
        pointer-events: none;
        font-size: .8rem;
    }
    .select-wrapper .field-control { padding-left: 36px; }

    .field-hint {
        font-size: .72rem;
        color: var(--slate-400);
        margin-top: 5px;
    }

    /* ─── Lesson Transfer UI ──────────────────── */
    .transfer-wrapper {
        display: grid;
        grid-template-columns: 1fr 52px 1fr;
        gap: 0;
        align-items: stretch;
        min-height: 300px;
    }
    @@media (max-width: 640px) {
        .transfer-wrapper {
            grid-template-columns: 1fr;
            grid-template-rows: auto auto auto;
        }
    }

    .transfer-col-label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
    }
    .transfer-col-label span {
        font-size: .78rem;
        font-weight: 700;
        color: var(--slate-600);
        text-transform: uppercase;
        letter-spacing: .04em;
    }
    .t-count {
        font-size: .72rem;
        font-weight: 800;
        padding: 3px 10px;
        border-radius: 20px;
        line-height: 1.2;
    }
    .t-count.available { background: var(--blue-50); color: var(--blue-500); }
    .t-count.completed { background: var(--brand-100); color: var(--brand-600); }

    .lesson-pool {
        list-style: none;
        padding: 8px;
        margin: 0;
        min-height: 260px;
        border-radius: var(--radius-md);
        border: 2px dashed var(--slate-200);
        background: var(--slate-50);
        overflow-y: auto;
        max-height: 420px;
        transition: border-color .2s, background .2s;
    }
    .lesson-pool.is-done {
        border-color: #a7f3d0;
        background: var(--brand-50);
    }
    .lesson-pool:has(.lesson-item:hover) { border-color: var(--brand-500); }

    .lesson-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        margin-bottom: 6px;
        background: #fff;
        border: 1.5px solid var(--slate-200);
        border-radius: var(--radius-sm);
        font-size: .84rem;
        font-weight: 600;
        color: var(--slate-700);
        cursor: pointer;
        transition: var(--transition);
        user-select: none;
    }
    .lesson-item:last-child { margin-bottom: 0; }
    .lesson-item:hover {
        border-color: var(--brand-500);
        background: var(--brand-50);
        color: var(--brand-700);
        transform: translateX(-2px);
        box-shadow: var(--shadow-sm);
    }
    .lesson-item.done-item {
        border-color: #6ee7b7;
        background: #f0fdf4;
        color: #065f46;
    }
    .lesson-item.done-item:hover {
        border-color: var(--red-500);
        background: #fff1f2;
        color: #991b1b;
        transform: translateX(2px);
    }
    .li-bullet {
        width: 28px;
        height: 28px;
        border-radius: 7px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .75rem;
        flex-shrink: 0;
        transition: var(--transition);
    }
    .lesson-item:not(.done-item) .li-bullet { background: #dbeafe; color: #1d4ed8; }
    .lesson-item.done-item .li-bullet { background: #d1fae5; color: #065f46; }
    .li-text { flex: 1; line-height: 1.4; }
    .li-action {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .7rem;
        border: none;
        cursor: pointer;
        transition: var(--transition);
        flex-shrink: 0;
    }
    .li-action-add { background: var(--brand-100); color: var(--brand-600); }
    .li-action-add:hover { background: var(--brand-500); color: #fff; }
    .li-action-rem { background: var(--red-100); color: var(--red-500); }
    .li-action-rem:hover { background: var(--red-500); color: #fff; }

    /* Pool Empty State */
    .pool-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 220px;
        gap: 10px;
        color: var(--slate-400);
        text-align: center;
        padding: 20px;
    }
    .pool-empty-icon {
        width: 52px;
        height: 52px;
        border-radius: var(--radius-md);
        background: var(--slate-100);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        margin-bottom: 4px;
    }
    .pool-empty p { font-size: .8rem; margin: 0; line-height: 1.5; }

    /* Transfer Controls Column */
    .transfer-controls {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 28px 4px 0;
    }
    @@media (max-width: 640px) {
        .transfer-controls { flex-direction: row; padding: 8px 0; justify-content: center; }
    }
    .tc-btn {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #fff;
        border: 1.5px solid var(--slate-200);
        color: var(--slate-500);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .8rem;
        cursor: pointer;
        transition: var(--transition);
        box-shadow: var(--shadow-sm);
    }
    .tc-btn:hover {
        border-color: var(--brand-500);
        color: var(--brand-500);
        background: var(--brand-50);
        transform: scale(1.08);
    }

    /* ─── Skeleton Loader ─────────────────────── */
    .sk-item {
        height: 46px;
        border-radius: var(--radius-sm);
        margin-bottom: 6px;
        background: linear-gradient(90deg, var(--slate-100) 25%, var(--slate-50) 50%, var(--slate-100) 75%);
        background-size: 200% 100%;
        animation: shimmer 1.4s infinite ease-in-out;
    }
    .sk-item:nth-child(2) { width: 88%; }
    .sk-item:nth-child(3) { width: 74%; }
    @@keyframes shimmer { to { background-position: -200% 0; } }

    /* ─── Submit Bar ──────────────────────────── */
    .submit-bar {
        position: sticky;
        bottom: 0;
        background: rgba(255,255,255,.95);
        backdrop-filter: blur(12px);
        border-top: 1px solid var(--slate-200);
        padding: 14px 22px;
        border-radius: 0 0 var(--radius-lg) var(--radius-lg);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        box-shadow: 0 -4px 20px rgba(0,0,0,.07);
        z-index: 10;
    }
    .submit-bar-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .selected-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--brand-100);
        color: var(--brand-700);
        border-radius: 20px;
        padding: 5px 14px;
        font-size: .82rem;
        font-weight: 800;
        transition: var(--transition);
    }
    .submit-bar-info p {
        font-size: .82rem;
        color: var(--slate-500);
        margin: 0;
    }

    /* ─── Buttons ─────────────────────────────── */
    .btn-primary-brand {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        background: linear-gradient(135deg, var(--brand-500), var(--brand-700));
        color: #fff;
        border: none;
        border-radius: var(--radius-md);
        padding: 11px 26px;
        font-size: .875rem;
        font-family: inherit;
        font-weight: 700;
        cursor: pointer;
        transition: var(--transition);
        box-shadow: 0 4px 14px rgba(13,148,136,.3);
        white-space: nowrap;
    }
    .btn-primary-brand:hover:not(:disabled) {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(13,148,136,.4);
        filter: brightness(1.05);
    }
    .btn-primary-brand:disabled {
        background: var(--slate-300);
        color: var(--slate-500);
        box-shadow: none;
        cursor: not-allowed;
    }
    .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: none;
        color: var(--slate-500);
        border: 1.5px solid var(--slate-200);
        border-radius: var(--radius-md);
        padding: 9px 18px;
        font-size: .82rem;
        font-family: inherit;
        font-weight: 600;
        cursor: pointer;
        transition: var(--transition);
    }
    .btn-ghost:hover {
        border-color: var(--red-500);
        color: var(--red-500);
        background: var(--red-100);
    }

    /* ─── Lessons card enter animation ───────── */
    .panel-card.entering {
        animation: cardEnter .3s ease forwards;
    }
    @@keyframes cardEnter {
        from { opacity: 0; transform: translateY(14px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* ─── Dark mode ───────────────────────────── */
    @@media (prefers-color-scheme: dark) {
        :root {
            --slate-50:  #0f172a;
            --slate-100: #1e293b;
            --slate-200: #334155;
            --slate-300: #475569;
            --slate-400: #64748b;
            --slate-500: #94a3b8;
            --slate-600: #cbd5e1;
            --slate-700: #e2e8f0;
            --slate-800: #f1f5f9;
        }
        .panel-card, .lesson-item, .tc-btn { background: #1e293b; }
        .lesson-pool { background: #0f172a; }
        .submit-bar { background: rgba(15,23,42,.95); }
        .field-control { background: #1e293b; color: #f1f5f9; }
    }
</style>
}

<div class="slc-page container-fluid">

    @* Step Indicator *@
    <div class="step-indicator">
        <div class="step-item">
            <div class="step-dot active">
                <i class="fas fa-list-check"></i>
            </div>
            <div class="step-text">
                <strong>اختيار المؤشرات</strong>
                <span>الخطوة الأولى</span>
            </div>
        </div>
        <div class="step-divider"></div>
        <div class="step-item">
            <div class="step-dot pending">
                <i class="fas fa-paper-plane"></i>
            </div>
            <div class="step-text">
                <strong>مراجعة وإرسال</strong>
                <span>الخطوة الثانية</span>
            </div>
        </div>
    </div>

    @* Hero *@
    <div class="page-hero">
        <div class="hero-badge">
            <i class="fas fa-graduation-cap"></i>
            نظام المؤشرات المنتهية
        </div>
        <h2>تسجيل المؤشرات التي انتهيت من شرحها</h2>
        <p>اختر الدفعة والمنهج والمحور، ثم انقل المؤشرات المنتهية، وسيتم توليد واجب تلقائي للطلاب</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="slc-alert error" role="alert">
            <div class="alert-icon"><i class="fas fa-exclamation"></i></div>
            <div style="flex:1">
                <strong style="display:block;margin-bottom:2px;font-size:.82rem">خطأ</strong>
                @TempData["Error"]
            </div>
            <button class="alert-close" onclick="this.closest('.slc-alert').remove()">
                <i class="fas fa-times"></i>
            </button>
        </div>
    }

    <form asp-action="SaveCompletedLessons" method="post" id="mainForm">
        @Html.AntiForgeryToken()
        <input type="hidden" id="CompletedLessonIds" name="CompletedLessonIds" />

        @* Panel 1: Filters *@
        <div class="panel-card">
            <div class="panel-header">
                <div class="panel-icon"><i class="fas fa-sliders-h"></i></div>
                <div>
                    <p class="panel-title">تحديد النطاق</p>
                    <p class="panel-subtitle">اختر الدفعة والمنهج والمحور لتحميل المؤشرات</p>
                </div>
            </div>
            <div class="panel-body">
                <div class="row g-3">
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="field-label" for="CompletionTitle">
                            <i class="fas fa-tag me-1"></i> عنوان التسجيل
                        </label>
                        <input type="text"
                               class="field-control"
                               name="CompletionTitle"
                               id="CompletionTitle"
                               value="@Model.CompletionTitle"
                               placeholder="مثال: مؤشرات الأسبوع الثالث"
                               required />
                        <p class="field-hint">سيظهر كعنوان للواجب المرسل للطلاب</p>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="field-label" for="SelectedBatchId">
                            <i class="fas fa-users me-1"></i> الدفعة
                        </label>
                        <div class="select-wrapper">
                            <select asp-for="SelectedBatchId"
                                    class="field-control"
                                    asp-items="Model.BatchList"
                                    id="SelectedBatchId">
                                <option value="" disabled selected>-- اختر دفعة --</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="field-label" for="SelectedCurriculumId">
                            <i class="fas fa-book me-1"></i> المنهج
                        </label>
                        <div class="select-wrapper">
                            <select asp-for="SelectedCurriculumId"
                                    class="field-control"
                                    id="SelectedCurriculumId"
                                    disabled>
                                <option value="" disabled selected>-- اختر الدفعة أولاً --</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="field-label" for="SelectedSectionId">
                            <i class="fas fa-layer-group me-1"></i> المحور
                        </label>
                        <div class="select-wrapper">
                            <select asp-for="SelectedSectionId"
                                    class="field-control"
                                    id="SelectedSectionId"
                                    disabled>
                                <option value="" disabled selected>-- اختر المنهج أولاً --</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Panel 2: Lesson Transfer *@
        <div class="panel-card entering" id="lessonsCard" style="display:none;">
            <div class="panel-header">
                <div class="panel-icon"><i class="fas fa-exchange-alt"></i></div>
                <div>
                    <p class="panel-title">تحديد المؤشرات المنتهية</p>
                    <p class="panel-subtitle">اضغط على مؤشر أو استخدم الأزرار للنقل بين القائمتين</p>
                </div>
            </div>
            <div class="panel-body">
                <div class="transfer-wrapper">
                    @* Available Column *@
                    <div>
                        <div class="transfer-col-label">
                            <span><i class="fas fa-layer-group me-1"></i> المؤشرات المتاحة</span>
                            <span class="t-count available" id="availableCount">0</span>
                        </div>
                        <ul class="lesson-pool" id="availableLessons">
                            <li class="pool-empty">
                                <div class="pool-empty-icon"><i class="fas fa-layer-group"></i></div>
                                <p>اختر المحور<br>لتظهر المؤشرات هنا</p>
                            </li>
                        </ul>
                    </div>

                    @* Transfer Buttons *@
                    <div class="transfer-controls">
                        <button type="button" class="tc-btn" id="moveAllBtn" title="نقل الكل للمنتهية">
                            <i class="fas fa-angles-left"></i>
                        </button>
                        <button type="button" class="tc-btn" id="returnAllBtn" title="إرجاع الكل">
                            <i class="fas fa-angles-right"></i>
                        </button>
                    </div>

                    @* Completed Column *@
                    <div>
                        <div class="transfer-col-label">
                            <span><i class="fas fa-check-circle me-1"></i> المؤشرات المنتهية</span>
                            <span class="t-count completed" id="completedCount">0</span>
                        </div>
                        <ul class="lesson-pool is-done" id="completedLessons">
                            <li class="pool-empty">
                                <div class="pool-empty-icon" style="background:var(--brand-100);color:var(--brand-600)">
                                    <i class="fas fa-check"></i>
                                </div>
                                <p>المؤشرات التي<br>انتهيت منها تظهر هنا</p>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            @* Submit Bar *@
            <div class="submit-bar">
                <div class="submit-bar-info">
                    <div class="selected-pill">
                        <i class="fas fa-check-circle"></i>
                        <span id="selectedBadge">0</span> مؤشر محدد
                    </div>
                    <p id="submitHint" style="display:none">جاهز للإرسال</p>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <button type="button" class="btn-ghost" id="clearBtn" style="display:none;">
                        <i class="fas fa-rotate-left"></i> مسح الكل
                    </button>
                    <button type="submit" class="btn-primary-brand" id="submitBtn" disabled>
                        <i class="fas fa-paper-plane"></i>
                        مراجعة وإرسال الواجب
                    </button>
                </div>
            </div>
        </div>

    </form>
</div>

@section Scripts {
<script>
(function () {
    const batchSel  = document.getElementById('SelectedBatchId');
    const currSel   = document.getElementById('SelectedCurriculumId');
    const sectSel   = document.getElementById('SelectedSectionId');
    const available = document.getElementById('availableLessons');
    const completed = document.getElementById('completedLessons');
    const hiddenIds = document.getElementById('CompletedLessonIds');
    const submitBtn = document.getElementById('submitBtn');
    const clearBtn  = document.getElementById('clearBtn');
    const card      = document.getElementById('lessonsCard');
    const avCount   = document.getElementById('availableCount');
    const coCount   = document.getElementById('completedCount');
    const badge     = document.getElementById('selectedBadge');
    const hint      = document.getElementById('submitHint');

    const EMPTY_AV = `<li class="pool-empty">
        <div class="pool-empty-icon"><i class="fas fa-layer-group"></i></div>
        <p>اختر المحور<br>لتظهر المؤشرات هنا</p></li>`;
    const EMPTY_CO = `<li class="pool-empty">
        <div class="pool-empty-icon" style="background:var(--brand-100);color:var(--brand-600)">
            <i class="fas fa-check"></i></div>
        <p>المؤشرات التي<br>انتهيت منها تظهر هنا</p></li>`;
    const SKELETON = `<div class="sk-item"></div><div class="sk-item"></div><div class="sk-item"></div>`;

    function sync() {
        const avN = available.querySelectorAll('li.lesson-item').length;
        const coN = completed.querySelectorAll('li.lesson-item').length;
        avCount.textContent = avN;
        coCount.textContent = coN;
        badge.textContent   = coN;
        hiddenIds.value     = [...completed.querySelectorAll('li.lesson-item')].map(l => l.dataset.id).join(',');
        submitBtn.disabled  = coN === 0;
        clearBtn.style.display = coN > 0 ? '' : 'none';
        hint.style.display     = coN > 0 ? '' : 'none';
        if (!available.querySelector('li.lesson-item') && !completed.querySelector('li.lesson-item')) {
            available.innerHTML = EMPTY_AV;
        }
        if (!completed.querySelector('li.lesson-item')) {
            completed.innerHTML = EMPTY_CO;
        }
    }

    function makeItem(id, title, isDone) {
        const li = document.createElement('li');
        li.className  = 'lesson-item' + (isDone ? ' done-item' : '');
        li.dataset.id = id;
        li.innerHTML  = `
          <div class="li-bullet"><i class="fas ${isDone ? 'fa-check' : 'fa-bookmark'}"></i></div>
          <span class="li-text">${title}</span>
          <button type="button" class="li-action ${isDone ? 'li-action-rem' : 'li-action-add'}" title="${isDone ? 'إرجاع' : 'إضافة'}">
              <i class="fas ${isDone ? 'fa-minus' : 'fa-plus'}"></i>
          </button>`;
        const toggle = () => {
            const inDone = completed.contains(li);
            const t = li.querySelector('.li-text').textContent;
            li.remove();
            const target = inDone ? available : completed;
            const empty  = target.querySelector('li.pool-empty');
            if (empty) empty.remove();
            target.appendChild(makeItem(id, t, !inDone));
            sync();
        };
        li.addEventListener('click', e => { if (!e.target.closest('.li-action')) toggle(); });
        li.querySelector('.li-action').addEventListener('click', toggle);
        return li;
    }

    batchSel.addEventListener('change', function () {
        currSel.disabled = true;
        sectSel.disabled = true;
        currSel.innerHTML = '<option disabled selected>جاري التحميل...</option>';
        sectSel.innerHTML = '<option disabled selected>-- اختر المنهج أولاً --</option>';
        available.innerHTML = EMPTY_AV;
        card.style.display = 'none';
        sync();
        fetch(`/Instructors/InstructorLessonCompletions/GetCurriculaByBatch?batchId=${this.value}`)
            .then(r => r.json())
            .then(data => {
                currSel.innerHTML = '<option value="" disabled selected>-- اختر المنهج --</option>';
                data.forEach(c => currSel.innerHTML += `<option value="${c.id}">${c.title}</option>`);
                currSel.disabled = false;
            });
    });

    currSel.addEventListener('change', function () {
        sectSel.disabled = true;
        sectSel.innerHTML = '<option disabled selected>جاري التحميل...</option>';
        available.innerHTML = EMPTY_AV;
        card.style.display = 'none';
        fetch(`/Instructors/InstructorLessonCompletions/GetSectionsByCurriculum?curriculumId=${this.value}`)
            .then(r => r.json())
            .then(data => {
                sectSel.innerHTML = '<option value="" disabled selected>-- اختر المحور --</option>';
                data.forEach(s => sectSel.innerHTML += `<option value="${s.id}">${s.title}</option>`);
                sectSel.disabled = false;
            });
    });

    sectSel.addEventListener('change', function () {
        card.style.display = '';
        card.classList.add('entering');
        setTimeout(() => card.classList.remove('entering'), 400);
        available.innerHTML = SKELETON;
        fetch(`/Instructors/InstructorLessonCompletions/GetLessonsBySection?sectionId=${this.value}`)
            .then(r => r.json())
            .then(data => {
                available.innerHTML = '';
                const doneIds = new Set([...completed.querySelectorAll('li.lesson-item')].map(l => l.dataset.id));
                if (!data.length) {
                    available.innerHTML = `<li class="pool-empty">
                        <div class="pool-empty-icon"><i class="fas fa-inbox"></i></div>
                        <p>لا توجد مؤشرات نشطة في هذا المحور</p></li>`;
                } else {
                    data.filter(l => !doneIds.has(String(l.id))).forEach(l => available.appendChild(makeItem(l.id, l.title, false)));
                    if (!available.querySelector('li.lesson-item')) {
                        available.innerHTML = `<li class="pool-empty">
                            <div class="pool-empty-icon" style="background:var(--brand-100);color:var(--brand-600)">
                                <i class="fas fa-check-double"></i></div>
                            <p>جميع مؤشرات هذا المحور<br>تم تحديدها بالفعل</p></li>`;
                    }
                }
                sync();
            });
    });

    document.getElementById('moveAllBtn').addEventListener('click', () => {
        [...available.querySelectorAll('li.lesson-item')].forEach(li => {
            const id = li.dataset.id, t = li.querySelector('.li-text').textContent;
            li.remove();
            const empty = completed.querySelector('li.pool-empty');
            if (empty) empty.remove();
            completed.appendChild(makeItem(id, t, true));
        });
        available.innerHTML = EMPTY_AV;
        sync();
    });

    document.getElementById('returnAllBtn').addEventListener('click', () => {
        [...completed.querySelectorAll('li.lesson-item')].forEach(li => {
            const id = li.dataset.id, t = li.querySelector('.li-text').textContent;
            li.remove();
            const empty = available.querySelector('li.pool-empty');
            if (empty) empty.remove();
            available.appendChild(makeItem(id, t, false));
        });
        completed.innerHTML = EMPTY_CO;
        sync();
    });

    clearBtn.addEventListener('click', () => {
        [...completed.querySelectorAll('li.lesson-item')].forEach(li => {
            const id = li.dataset.id, t = li.querySelector('.li-text').textContent;
            li.remove();
            const empty = available.querySelector('li.pool-empty');
            if (empty) empty.remove();
            available.appendChild(makeItem(id, t, false));
        });
        completed.innerHTML = EMPTY_CO;
        sync();
    });

    sync();
})();
</script>
}

