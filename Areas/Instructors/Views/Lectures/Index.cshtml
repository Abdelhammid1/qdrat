@model List<QdratNew.ViewModels.Instructor.InstructorLectureViewModel>
@{
    ViewData["Title"] = "محاضراتي";
}

<div class="container mt-4" dir="rtl">
    <h2 class="text-primary mb-4"><i class="fas fa-chalkboard-teacher"></i> المحاضرات المرتبطة بي</h2>

    <table class="table table-bordered text-center">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>العنوان</th>
                <th>الموقع</th>
                <th>التاريخ</th>
                <th>الحضور</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var lecture in Model)
            {
                <tr>
                    <td>@lecture.Id</td>
                    <td>@lecture.Title</td>
                    <td>@lecture.Location</td>
                    <td>@lecture.Date.ToString("yyyy/MM/dd")</td>
                    <td>
                        <a asp-action="Attendance" asp-route-id="@lecture.Id" class="btn btn-sm btn-primary">
                            <i class="fas fa-users"></i> عرض الحضور
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
