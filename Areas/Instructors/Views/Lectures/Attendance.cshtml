@model QdratNew.ViewModels.Instructor.InstructorLectureAttendanceViewModel
@{
    ViewData["Title"] = "حضور الطلاب";
}

<div class="container mt-4" dir="rtl">
    <h2 class="text-primary mb-4"><i class="fas fa-calendar-check"></i> حضور الطلاب: @Model.LectureTitle (@Model.LectureDate.ToString("yyyy/MM/dd"))</h2>

    <table class="table table-bordered text-center">
        <thead class="table-dark">
            <tr>
                <th>اسم الطالب</th>
                <th>الحضور</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model.Students)
            {
                <tr>
                    <td>@student.StudentName</td>
                    <td>
                        @if (student.IsPresent)
                        {
                            <span class="badge bg-success">✔️ حاضر</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">❌ غائب</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
