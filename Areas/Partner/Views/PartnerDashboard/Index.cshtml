@using QdratNew.ViewModels.Partner.Reports
@model PartnerDashboardVM
@{
    ViewData["Title"] = "لوحة تحكم الشريك";
}

<h3 class="mb-4">📊 لوحة تحكم الشريك</h3>

<div class="row g-4">

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted">عدد الطلاب</h6>
                <h2 class="fw-bold">@Model.TotalStudents</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted">الدفعات النشطة</h6>
                <h2 class="fw-bold">@Model.ActiveBatches</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted">اختبارات مرسلة</h6>
                <h2 class="fw-bold">@Model.TotalSentExams</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted">اختبارات محلولة</h6>
                <h2 class="fw-bold text-success">@Model.TotalSolvedExams</h2>
            </div>
        </div>
    </div>

</div>

<hr class="my-4" />

<div class="row g-4">

    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted">اختبارات لم تُحل</h6>
                <h2 class="fw-bold text-danger">@Model.TotalUnsolvedExams</h2>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted">متوسط الأداء العام</h6>
                <h2 class="fw-bold text-primary">@Model.AverageScorePercent %</h2>
            </div>
        </div>
    </div>

</div>
