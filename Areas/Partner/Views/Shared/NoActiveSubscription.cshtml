@{
    ViewData["Title"] = "لا يوجد اشتراك نشط";
    Layout = "~/Views/Shared/_PartnerLayout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">

            <div class="alert alert-warning p-4">
                <h4 class="mb-3">⚠️ لا يوجد اشتراك نشط</h4>

                <p class="mb-3">
                    لا يمكن الوصول إلى لوحة الشريك في الوقت الحالي
                    لعدم وجود عقد أو فترة اشتراك نشطة.
                </p>

                <p class="text-muted mb-4">
                    يرجى التواصل مع إدارة المنصة لتفعيل الاشتراك
                    أو الانتظار حتى بدء فترة جديدة.
                </p>

                @* PPL-S6.3: التقارير المتاحة بعد انتهاء العقد تُفتح من الدفعات *@
                <a asp-area="Partner" asp-controller="Batches" asp-action="Index" class="btn btn-outline-primary">
                    الدفعات وتقاريرها
                </a>

                <a href="/" class="btn btn-outline-secondary">
                    العودة للرئيسية
                </a>
            </div>

        </div>
    </div>
</div>
