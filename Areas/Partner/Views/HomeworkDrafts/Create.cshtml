@model QdratNew.ViewModels.Partner.Homework.HomeworkDraftCreateVM

@{
    ViewData["Title"] = "إنشاء واجب جديد";
}

<div class="container mt-4" dir="rtl">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">➕ إنشاء واجب جديد</h3>
        <a asp-action="Index" class="btn btn-outline-secondary">
            رجوع
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 p-4">

        <h5 class="fw-bold mb-3">🎓 اختر الدورة</h5>

        @if (!Model.Courses.Any())
        {
            <div class="alert alert-warning">
                لا توجد دورات متاحة ضمن العقد الحالي.
            </div>
        }
        else
        {
            <div class="list-group">

                @foreach (var course in Model.Courses)
                {
                    <a asp-action="AutoGenerate"
                       asp-route-courseId="@course.CourseId"
                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">

                        <span class="fw-semibold">
                            @course.CourseName
                        </span>

                        <span class="badge bg-primary">
                            توليد تلقائي
                        </span>
                    </a>
                }

            </div>
        }

    </div>
</div>
