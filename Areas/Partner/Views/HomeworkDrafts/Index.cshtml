@using QdratNew.ViewModels.Partner.HomeworkDraft
@model List<HomeworkDraftListVM>

@{
    ViewData["Title"] = "نماذج الواجبات";
    var stats = ViewBag.Stats
        as QdratNew.Services.Statistics.DTOs.HomeworkDraftStatsDto;
}

@if (stats != null)
{
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6>إجمالي النماذج</h6>
                    <h3>@stats.TotalDrafts</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6>متوسط عدد الأسئلة</h6>
                    <h3>@stats.AverageQuestions</h3>
                </div>
            </div>
        </div>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">نماذج الواجبات</h2>

    <a asp-action="Create" class="btn btn-primary">
        إنشاء واجب جديد
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        لا توجد نماذج واجبات بعد.
    </div>
}
else
{
    <table class="table table-bordered table-hover text-center">
        <thead class="table-light">
            <tr>
                <th>العنوان</th>
                <th>الدورة</th>
                <th>عدد الأسئلة</th>
                <th>تاريخ الإنشاء</th>
                <th>إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td>@d.Title</td>
                    <td>@d.CourseName</td>
                    <td>@d.TotalQuestions</td>
                    <td>@d.CreatedAt.ToString("yyyy/MM/dd")</td>
                    <td>
                        <a asp-action="Preview"
                           asp-route-id="@d.DraftId"
                           class="btn btn-sm btn-outline-info">
                            مراجعة
                        </a>

                        <a asp-action="SendDraft"
                           asp-route-draftId="@d.DraftId"
                           class="btn btn-sm btn-success ms-1">
                            إرسال
                        </a>


                        <form asp-action="DeleteDraft"
                              method="post"
                              style="display:inline-block;"
                              onsubmit="return confirm('هل أنت متأكد من حذف هذه المسودة؟');">

                            @Html.AntiForgeryToken()

                            <input type="hidden" name="draftId" value="@d.DraftId" />

                            <button type="submit" class="btn btn-sm btn-danger">
                                <i class="fa-solid fa-trash"></i>
                                حذف
                            </button>
                        </form>


                    </td>
                </tr>
            }
        </tbody>
    </table>
}
