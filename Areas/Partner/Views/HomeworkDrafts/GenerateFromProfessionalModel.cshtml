@model QdratNew.ViewModels.Partner.Homework.HomeworkGenerateFromProfessionalModelVM

<h3 class="mb-4">توليد واجب من نموذج </h3>

<div class="alert alert-info">
    سيتم إنشاء <strong>نموذج واجب</strong> اعتمادًا على النموذج ،
    ويمكنك مراجعة الأسئلة قبل الإرسال للطلاب.
</div>

<form method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="ProfessionalModelId" />

    <div class="mb-3">
        <label asp-for="Title" class="form-label">عنوان الواجب</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CourseId" class="form-label">الدورة</label>
        <select asp-for="CourseId"
                asp-items="Model.Courses"
                class="form-select">
            <option value="">اختر الدورة</option>
        </select>
        <span asp-validation-for="CourseId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        إنشاء مسودة الواجب
    </button>
</form>
