@model QdratNew.ViewModels.Partner.HomeworkDraft.SendHomeworkDraftVM

<h3>إرسال نموذج الواجب</h3>

<form asp-action="SendDraft" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="DraftId" />

    <div class="mb-3">
        <label>تاريخ البدء</label>
        <input asp-for="StartAt"
               type="datetime-local"
               step="1"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>تاريخ الانتهاء</label>
        <input asp-for="EndAt"
               type="datetime-local"
               step="1"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">الدفعات</label>

        <select asp-for="BatchIds"
                asp-items="Model.Batches"
                multiple
                class="form-select">
        </select>

        <small class="text-muted">
            يمكنك اختيار أكثر من دفعة لإرسال نفس الواجب لها.
        </small>
    </div>


    <button type="submit" class="btn btn-primary">
        إرسال الواجب
    </button>
</form>
