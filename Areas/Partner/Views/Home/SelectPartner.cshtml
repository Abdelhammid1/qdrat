@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "اختيار المدرسة";
}

<div class="container mt-5" dir="rtl" style="max-width:600px;">
    <h4 class="fw-bold mb-4 text-center">اختر المدرسة</h4>

    <form method="post" asp-action="SetActivePartner">
        <div class="mb-3">
            <select name="partnerId" class="form-select" required>
                <option value="">-- اختر المدرسة --</option>
                @foreach (var p in Model)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </select>
        </div>

        <button type="submit" class="btn btn-success w-100">
            دخول لوحة المدرسة
        </button>
    </form>
</div>
