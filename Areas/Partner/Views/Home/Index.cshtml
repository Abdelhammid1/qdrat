@model QdratNew.ViewModels.Partner.PartnerDashboardViewModel
@{
    ViewData["Title"] = "لوحة تحكم الشريك";
}

<div class="container mt-4" dir="rtl">

    <!-- 🏫 بيانات الشريك -->
    <div class="d-flex align-items-center mb-4">
        @if (!string.IsNullOrEmpty(Model.LogoUrl))
        {
            <img src="@Model.LogoUrl" class="me-3 rounded" style="height:60px;" />
        }
        <h3 class="fw-bold mb-0">@Model.PartnerName</h3>
    </div>

    <!-- ⏳ حالة الشراكة -->
    @if (!Model.IsActive)
    {
        <div class="alert alert-danger">
            ⚠️ انتهت مدة الشراكة.
        </div>
    }
    else if (Model.ShowExpiryWarning)
    {
        <div class="alert alert-warning">
            ⏳ متبقي @Model.DaysRemaining يوم على انتهاء الشراكة.
        </div>
    }

    <!-- 📊 إحصائيات عامة -->
    <div class="row g-3 mt-3">

        <div class="col-md-4">
            <div class="card shadow-sm text-center p-3 h-100">
                <h6 class="text-muted">عدد الطلاب</h6>
                <h3 class="fw-bold">@Model.StudentsCount</h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm text-center p-3 h-100">
                <h6 class="text-muted">عدد الدفعات</h6>
                <h3 class="fw-bold">@Model.BatchesCount</h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm text-center p-3 h-100">
                <h6 class="text-muted">عدد الدورات المتاحة</h6>
                <h3 class="fw-bold">@Model.CoursesCount</h3>
            </div>
        </div>

    </div>

    <!-- 📦 الدورات المتعاقد عليها -->
    <div class="card shadow-sm border-0 rounded-4 mt-4">
        <div class="card-header fw-bold">
            📦 الدورات المتعاقد عليها
        </div>
        <div class="card-body p-0">

            @if (Model.Courses == null || !Model.Courses.Any())
            {
                <div class="p-3 text-muted">
                    لا توجد دورات متاحة ضمن العقد الحالي.
                </div>
            }
            else
            {
                <table class="table table-bordered mb-0 text-center align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>الدورة</th>
                            <th>بنك أسئلة المنصة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model.Courses)
                        {
                            <tr>
                                <td>@course.CourseName</td>
                                <td>
                                    @if (course.CanUsePlatformQuestionBank)
                                    {
                                        <span class="badge bg-success">مسموح</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">غير مسموح</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

        </div>
    </div>

</div>
