@model QdratNew.Services.Exams.Placement.PlacementSendSummary

@{
    ViewData["Title"] = "تأكيد إرسال اختبار تحديد المستوى";

    var canSend = Model.IsActive && Model.TotalStudents > 0 && Model.TotalQuestions > 0;
}

<div class="pp-page">
    <partial name="_PlacementAlerts" />

    <div class="pp-head">
        <div>
            <h1><i class="fa-solid fa-paper-plane" aria-hidden="true"></i> تأكيد إرسال الاختبار</h1>
            <p>@Model.Title</p>
        </div>

        <div class="pp-head-actions">
            <a asp-action="Review" asp-route-examId="@Model.ExamId" class="pp-btn pp-btn-light">
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                العودة للمراجعة
            </a>
        </div>
    </div>

    <div class="pp-stats">
        <div class="pp-stat"><b>@Model.TotalStudents</b><span>طالب سيصله الاختبار</span></div>
        <div class="pp-stat"><b>@Model.TotalQuestions</b><span>إجمالي الأسئلة</span></div>
        <div class="pp-stat"><b>@Model.DurationMinutes</b><span>الزمن (دقيقة)</span></div>
        <div class="pp-stat"><b>@(string.IsNullOrWhiteSpace(Model.ReferenceCode) ? "أونلاين" : "حضوري")</b><span>طريقة الاختبار</span></div>
    </div>

    @if (!Model.IsActive)
    {
        <div class="pp-alert pp-alert-warn" role="status">
            <i class="fa-solid fa-eye-slash" aria-hidden="true"></i>
            <span>هذا الاختبار مخفي، استرجعه أولًا قبل الإرسال.</span>
        </div>
    }
    else if (Model.TotalQuestions == 0)
    {
        <div class="pp-alert pp-alert-warn" role="status">
            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
            <span>لا توجد أسئلة في هذا الاختبار.</span>
        </div>
    }
    else if (Model.TotalStudents == 0)
    {
        <div class="pp-alert pp-alert-warn" role="status">
            <i class="fa-solid fa-users-slash" aria-hidden="true"></i>
            <span>لا يوجد طلاب نشطون في الدفعات المرتبطة بهذا الاختبار.</span>
        </div>
    }

    <div class="pp-card">
        <h2 class="pp-card-title"><i class="fa-solid fa-users" aria-hidden="true"></i> الدفعات المستهدفة</h2>
        <p class="pp-card-sub">يصل الاختبار لطلاب هذه الدفعات النشطين فقط، ويبدأ وقته عندما يدخل الطالب إليه.</p>

        <div class="pp-table-wrap">
            <table class="pp-table">
                <thead>
                    <tr>
                        <th>الدفعة</th>
                        <th>عدد الطلاب</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var batch in Model.Batches)
                    {
                        <tr>
                            <td>@batch.BatchName</td>
                            <td>@batch.StudentCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="pp-card">
        <div class="pp-alert pp-alert-info" role="status">
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
            <span>بعد الإرسال يصل إشعار للطلاب ولا يمكن تعديل أسئلة الاختبار.</span>
        </div>

        @if (canSend)
        {
            <form asp-action="SendExamToStudents" method="post" data-busy="1">
                <input type="hidden" name="examId" value="@Model.ExamId" />
                <button type="submit" class="pp-btn pp-btn-primary">
                    <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
                    إرسال الاختبار لـ @Model.TotalStudents طالب
                </button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/partner-placement.js" asp-append-version="true"></script>
}
