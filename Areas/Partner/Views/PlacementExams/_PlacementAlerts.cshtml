<link href="~/css/partner-placement.css" rel="stylesheet" asp-append-version="true" />

@if (TempData["Success"] != null)
{
    <div class="pp-alert pp-alert-success" role="status">
        <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@if (TempData["Info"] != null)
{
    <div class="pp-alert pp-alert-info" role="status">
        <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
        <span>@TempData["Info"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="pp-alert pp-alert-danger" role="alert">
        <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
        <span>@TempData["Error"]</span>
    </div>
}
