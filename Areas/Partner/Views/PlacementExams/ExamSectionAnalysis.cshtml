@model QdratNew.ViewModels.Partner.PartnerPlacementReportPageVm<QdratNew.ViewModels.Reports.AdminExamSectionAnalysisViewModel>

@{
    ViewData["Title"] = "تقرير المحاور";
}

<div class="pp-page">
    <partial name="_PlacementAlerts" />

    <div class="pp-head">
        <div>
            <h1><i class="fa-solid fa-diagram-project" aria-hidden="true"></i> تقرير المحاور: @Model.Report.ExamTitle</h1>
            <p>الطالب: @Model.Report.StudentName</p>
        </div>

        <div class="pp-head-actions no-print">
            <a asp-action="StudentPlacementReport"
               asp-route-studentId="@Model.StudentId"
               asp-route-examId="@Model.ExamId"
               asp-route-assignmentId="@Model.AssignmentId"
               asp-route-batchId="@Model.BatchId"
               class="pp-btn pp-btn-light">
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                تقرير الطالب
            </a>
        </div>
    </div>

    @if (!Model.Report.SectionReports.Any())
    {
        <div class="pp-card">
            <div class="pp-empty">
                <i class="fa-solid fa-inbox" aria-hidden="true"></i>
                <h2>لا توجد أسئلة في هذا الاختبار</h2>
            </div>
        </div>
    }

    @foreach (var sectionReport in Model.Report.SectionReports)
    {
        <div class="pp-card">
            <div class="pp-toolbar">
                <h2 class="pp-card-title"><i class="fa-solid fa-layer-group" aria-hidden="true"></i> @sectionReport.SectionTitle</h2>
                <span class="pp-badge pp-badge-main">@sectionReport.TotalQuestions سؤال · @sectionReport.Score%</span>
            </div>

            <div class="pp-table-wrap">
                <table class="pp-table pp-table-cards">
                    <thead>
                        <tr>
                            <th>المؤشر</th>
                            <th>عدد الأسئلة</th>
                            <th>الصحيحة</th>
                            <th>الخاطئة</th>
                            <th>النسبة</th>
                            <th>الإجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lesson in sectionReport.LessonBreakdown)
                        {
                            <tr>
                                <td data-label="المؤشر">@lesson.LessonTitle</td>
                                <td data-label="عدد الأسئلة">@lesson.TotalQuestions</td>
                                <td data-label="الصحيحة" class="pp-text-ok">@lesson.Correct</td>
                                <td data-label="الخاطئة" class="pp-text-bad">@lesson.Wrong</td>
                                <td data-label="النسبة"><b>@lesson.Score%</b></td>
                                <td data-label="الإجراء">
                                    <a asp-action="ReviewLessonQuestions"
                                       asp-route-assignmentId="@Model.AssignmentId"
                                       asp-route-studentId="@Model.StudentId"
                                       asp-route-lessonId="@lesson.LessonId"
                                       asp-route-batchId="@Model.BatchId"
                                       class="pp-btn pp-btn-light pp-btn-sm">
                                        <i class="fa-solid fa-eye" aria-hidden="true"></i>
                                        عرض الأسئلة
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
