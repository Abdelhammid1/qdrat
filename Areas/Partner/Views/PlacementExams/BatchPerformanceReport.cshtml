@model QdratNew.ViewModels.Partner.PartnerPlacementReportPageVm<QdratNew.ViewModels.Reports.AdminExamSectionAnalysisViewModel>

@{
    ViewData["Title"] = "أداء الدفعة";
}

<div class="pp-page">
    <partial name="_PlacementAlerts" />

    <div class="pp-head">
        <div>
            <h1><i class="fa-solid fa-chart-column" aria-hidden="true"></i> أداء الدفعة: @Model.Report.ExamTitle</h1>
            <p>جميع طلاب @Model.Report.StudentName</p>
        </div>

        <div class="pp-head-actions no-print">
            <a asp-action="BatchStudents" asp-route-examId="@Model.ExamId" asp-route-batchId="@Model.BatchId" class="pp-btn pp-btn-light">
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                طلاب الاختبار
            </a>
        </div>
    </div>

    @foreach (var sectionReport in Model.Report.SectionReports)
    {
        <div class="pp-card">
            <div class="pp-toolbar">
                <h2 class="pp-card-title"><i class="fa-solid fa-layer-group" aria-hidden="true"></i> @sectionReport.SectionTitle</h2>
                <span class="pp-badge pp-badge-main">@sectionReport.TotalQuestions سؤال · @sectionReport.Score%</span>
            </div>

            <div class="pp-table-wrap">
                <table class="pp-table pp-table-cards">
                    <thead>
                        <tr>
                            <th>المؤشر</th>
                            <th>عدد الأسئلة</th>
                            <th>إجابات صحيحة</th>
                            <th>إجابات خاطئة</th>
                            <th>النسبة العامة</th>
                            <th>الإجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lesson in sectionReport.LessonBreakdown)
                        {
                            <tr>
                                <td data-label="المؤشر">@lesson.LessonTitle</td>
                                <td data-label="عدد الأسئلة">@lesson.TotalQuestions</td>
                                <td data-label="إجابات صحيحة" class="pp-text-ok">@lesson.Correct</td>
                                <td data-label="إجابات خاطئة" class="pp-text-bad">@lesson.Wrong</td>
                                <td data-label="النسبة العامة"><b>@lesson.Score%</b></td>
                                <td data-label="الإجراء">
                                    <a asp-action="ReviewLessonQuestionsBatch"
                                       asp-route-examId="@Model.ExamId"
                                       asp-route-lessonId="@lesson.LessonId"
                                       asp-route-batchId="@Model.BatchId"
                                       class="pp-btn pp-btn-light pp-btn-sm">
                                        <i class="fa-solid fa-chart-simple" aria-hidden="true"></i>
                                        تقرير الأسئلة
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
