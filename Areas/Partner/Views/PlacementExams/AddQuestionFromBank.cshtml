@model QdratNew.ViewModels.Exam.AddQuestionFromBankVm

@functions {
    string ShortPlainText(string? html, int length = 120)
    {
        if (string.IsNullOrWhiteSpace(html))
            return "—";

        var plain = System.Net.WebUtility.HtmlDecode(
            System.Text.RegularExpressions.Regex.Replace(html, "<.*?>", string.Empty)).Trim();

        return plain.Length <= length ? plain : plain.Substring(0, length) + "...";
    }
}

@{
    ViewData["Title"] = "إضافة سؤال من البنك";
}

<div class="pp-page">
    <partial name="_PlacementAlerts" />

    <div class="pp-head">
        <div>
            <h1><i class="fa-solid fa-plus" aria-hidden="true"></i> إضافة سؤال من البنك</h1>
            <p>المحور: @Model.SectionTitle</p>
        </div>

        <div class="pp-head-actions">
            <a asp-action="Review" asp-route-examId="@Model.ExamId" class="pp-btn pp-btn-light">
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                العودة للمراجعة
            </a>
        </div>
    </div>

    <div class="pp-card">
        @if (!Model.Questions.Any())
        {
            <div class="pp-empty">
                <i class="fa-solid fa-inbox" aria-hidden="true"></i>
                <h2>لا توجد أسئلة متاحة للإضافة</h2>
                <p>كل أسئلة هذا المحور موجودة بالفعل في الاختبار.</p>
            </div>
        }
        else
        {
            <div class="pp-toolbar">
                <span class="pp-badge pp-badge-main">@Model.Questions.Count سؤال متاح</span>
                <input type="search"
                       class="pp-search"
                       placeholder="ابحث في نص السؤال..."
                       aria-label="ابحث في نص السؤال"
                       data-search-target=".pp-question-row" />
            </div>

            <form asp-action="AddQuestionFromBank" method="post">
                <input type="hidden" name="examId" value="@Model.ExamId" />
                <input type="hidden" name="sectionId" value="@Model.SectionId" />

                <div class="pp-table-wrap">
                    <table class="pp-table">
                        <thead>
                            <tr>
                                <th>السؤال</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var question in Model.Questions)
                            {
                                var text = ShortPlainText(question.Title);

                                <tr class="pp-question-row" data-search="@text">
                                    <td>@text</td>
                                    <td>
                                        <div class="pp-actions">
                                            <button type="button"
                                                    class="pp-btn pp-btn-light pp-btn-sm"
                                                    data-preview-url="@Url.Action("PreviewQuestion", new { examId = Model.ExamId, questionId = question.QuestionId })">
                                                <i class="fa-solid fa-eye" aria-hidden="true"></i>
                                                معاينة
                                            </button>
                                            <button type="submit"
                                                    name="questionId"
                                                    value="@question.QuestionId"
                                                    class="pp-btn pp-btn-primary pp-btn-sm">
                                                إضافة
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </form>
        }
    </div>
</div>

<partial name="_QuestionPreviewModal" />

@section Scripts {
    <script src="~/js/partner-placement.js" asp-append-version="true"></script>
}
