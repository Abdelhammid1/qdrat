@model QdratNew.ViewModels.Partner.PartnerPlacementReportPageVm<QdratNew.ViewModels.Exam.StudentExamDetailsVm>
@using QdratNew.Services.Exams.Placement

@{
    ViewData["Title"] = "إجابات الطالب";
}

<div class="pp-page">
    <partial name="_PlacementAlerts" />

    <div class="pp-head">
        <div>
            <h1><i class="fa-solid fa-list-check" aria-hidden="true"></i> إجابات الطالب: @Model.Report.StudentName</h1>
            <p>@Model.Report.ExamTitle</p>
        </div>

        <div class="pp-head-actions no-print">
            <a asp-action="DownloadStudentReport" asp-route-examId="@Model.ExamId" asp-route-studentId="@Model.StudentId" class="pp-btn pp-btn-light">
                <i class="fa-solid fa-file-pdf" aria-hidden="true"></i>
                تحميل PDF
            </a>

            @if (Model.BatchId > 0)
            {
                <a asp-action="BatchStudents" asp-route-examId="@Model.ExamId" asp-route-batchId="@Model.BatchId" class="pp-btn pp-btn-light">
                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                    طلاب الاختبار
                </a>
            }
            else
            {
                <a href="javascript:history.back()" class="pp-btn pp-btn-light">
                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                    عودة
                </a>
            }
        </div>
    </div>

    <div class="pp-stats">
        <div class="pp-stat"><b>@Model.Report.TotalQuestions</b><span>إجمالي الأسئلة</span></div>
        <div class="pp-stat"><b>@Model.Report.CorrectCount</b><span>إجابات صحيحة</span></div>
        <div class="pp-stat"><b>@Model.Report.WrongCount</b><span>إجابات خاطئة</span></div>
    </div>

    <div class="pp-card">
        @if (!Model.Report.Answers.Any())
        {
            <div class="pp-empty">
                <i class="fa-solid fa-inbox" aria-hidden="true"></i>
                <h2>لم يُجب الطالب عن أي سؤال بعد</h2>
            </div>
        }
        else
        {
            <div class="pp-table-wrap">
                <table class="pp-table pp-table-cards">
                    <thead>
                        <tr>
                            <th>السؤال</th>
                            <th>إجابة الطالب</th>
                            <th>الإجابة الصحيحة</th>
                            <th>النتيجة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var answer in Model.Report.Answers)
                        {
                            <tr>
                                <td data-label="السؤال">@Html.Raw(NumberHelper.ToIndicNumbersSafe(answer.QuestionTitle))</td>
                                @* إجابة الطالب نص حر من المتصفح، فلا تُعرض بـ Html.Raw *@
                                <td data-label="إجابة الطالب">@NumberHelper.ToIndicNumbersSafe(PlacementReportText.ToPlainText(answer.SelectedAnswer))</td>
                                <td data-label="الإجابة الصحيحة">@Html.Raw(NumberHelper.ToIndicNumbersSafe(answer.CorrectAnswer ?? "—"))</td>
                                <td data-label="النتيجة">
                                    @if (answer.IsCorrect)
                                    {
                                        <span class="pp-badge pp-badge-ok">صحيح</span>
                                    }
                                    else
                                    {
                                        <span class="pp-badge pp-badge-bad">خطأ</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
