@model QdratNew.ViewModels.Partner.PartnerPlacementBrandingVm

@* PPL-S6.2: ترويسة تقارير الطالب *@
<div class="pp-report-brand">
    @if (!string.IsNullOrEmpty(Model?.LogoUrl))
    {
        <img src="@Url.Content(Model.LogoUrl)" alt="شعار @Model.PartnerName" />
    }
    <div>
        <div class="pp-report-brand-name">@Model?.PartnerName</div>
        <div class="pp-report-brand-sub">بالتعاون مع معهد القدرات</div>
    </div>
</div>
