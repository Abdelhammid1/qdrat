@model QdratNew.ViewModels.Partner.PartnerExamModelsVm

@{
    ViewData["Title"] = "إرسال اختبار من نموذج";
}

<div class="pp-page">
    <partial name="~/Areas/Partner/Views/PlacementExams/_PlacementAlerts.cshtml" />
    <link href="~/css/partner-model-send.css" rel="stylesheet" asp-append-version="true" />

    <div class="pp-head">
        <div>
            <h1><i class="fa-solid fa-layer-group" aria-hidden="true"></i> إرسال اختبار من نموذج</h1>
            <p>اختر نموذجًا جاهزًا وأرسله مباشرة إلى دفعاتكم دون المرور بمسودة.</p>
        </div>

        @if (Model.CanCreateExams)
        {
            <div class="pp-head-actions">
                <a asp-controller="PartnerExam" asp-action="SentExams" class="pp-btn pp-btn-light">
                    <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
                    الاختبارات المرسلة
                </a>
            </div>
        }
    </div>

    @if (!Model.CanCreateExams)
    {
        <div class="pp-card">
            <div class="pp-empty">
                <i class="fa-solid fa-lock" aria-hidden="true"></i>
                <h2>إرسال الاختبارات غير مشمول في عقدكم</h2>
                <p>لإضافة هذه الخدمة إلى العقد، تواصلوا مع المعهد.</p>
            </div>
        </div>
    }
    else if (!Model.Models.Any())
    {
        <div class="pp-card">
            <div class="pp-empty">
                <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
                <h2>لا توجد نماذج اختبارات متاحة</h2>
                <p>لا توجد نماذج اختبارات متاحة لكم حاليًا. تواصلوا مع المعهد.</p>
            </div>
        </div>
    }
    else
    {
        <div class="pp-batches">
            @foreach (var item in Model.Models)
            {
                <div class="pp-batch">
                    <div class="pp-batch-name">@item.Title</div>

                    <div class="pp-batch-meta">
                        <span class="pp-badge pp-badge-main">@NumberHelper.ToIndicNumbersSafe(item.QuestionCount.ToString()) سؤال</span>
                        @if (!string.IsNullOrWhiteSpace(item.CurriculumTitle))
                        {
                            <span class="pp-badge pp-badge-muted">@item.CurriculumTitle</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(item.Description))
                    {
                        <p class="pms-description">@item.Description</p>
                    }

                    <div class="pp-actions pms-card-actions">
                        <a asp-action="Preview" asp-route-id="@item.Id" class="pp-btn pp-btn-light pp-btn-sm">
                            <i class="fa-solid fa-eye" aria-hidden="true"></i>
                            معاينة
                        </a>

                        @if (item.QuestionCount > 0)
                        {
                            <a asp-action="SendExam" asp-route-id="@item.Id" class="pp-btn pp-btn-primary pp-btn-sm">
                                <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
                                إرسال كاختبار
                            </a>

                            @if (Model.CanUsePlacementExams)
                            {
                                <a asp-controller="PlacementExams" asp-action="CreateFromProfessionalModel" asp-route-modelId="@item.Id" class="pp-btn pp-btn-light pp-btn-sm">
                                    <i class="fa-solid fa-signal" aria-hidden="true"></i>
                                    تحديد مستوى من هذا النموذج
                                </a>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
