@model IReadOnlyList<QdratNew.Services.ProfessionalModels.PreviewQuestionVm>

@if (!Model.Any())
{
    <div class="pp-empty">
        <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
        <h2>لا توجد بدائل متاحة</h2>
        <p>لا توجد أسئلة أخرى من نفس الدرس في بنك المنصة، أو أن عقدكم لا يتيح البنك لدورات هذا النموذج.</p>
    </div>
}
else
{
    foreach (var candidate in Model)
    {
        <div class="pp-question" data-candidate="@candidate.QuestionId">
            <div data-role="candidate-body">
                <partial name="_ModelQuestionBody" model="candidate" />
            </div>

            <div class="pp-actions">
                <button type="button" class="pp-btn pp-btn-primary pp-btn-sm" data-choose-candidate>
                    <i class="fa-solid fa-check" aria-hidden="true"></i>
                    اختيار هذا السؤال
                </button>
            </div>
        </div>
    }
}
