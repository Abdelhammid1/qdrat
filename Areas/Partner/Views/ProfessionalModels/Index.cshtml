@using QdratNew.Enums
@model List<QdratNew.Entities.ProfessionalModel>

@{
    ViewData["Title"] = "النماذج ";
}

<h2 class="fw-bold mb-4">النماذج </h2>

<div class="table-responsive">
    <table class="table table-hover align-middle text-center">
        <thead class="table-light">
            <tr>
                <th>العنوان</th>
                <th>الوصف</th>
                <th>عدد الأسئلة</th>
                <th style="width:120px;">إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td class="fw-semibold">@m.Title</td>

                    <td class="text-muted">
                        @(string.IsNullOrWhiteSpace(m.Description)
                                            ? "—"
                                            : m.Description)
                </td>

                    <td>
                        <span class="badge bg-dark fs-6">
                            @(m.Questions?.Count(q => q.Question != null) ?? 0) سؤال
                        </span>
                    </td>


                    <td>
                        <div class="d-flex justify-content-center gap-2">

                            <!-- 🔍 معاينة -->
                            <a asp-action="Preview"
                               asp-route-id="@m.Id"
                               class="btn btn-outline-info btn-sm"
                               data-bs-toggle="tooltip"
                               data-bs-placement="top"
                               title="معاينة النموذج">
                                <i class="fa-solid fa-eye"></i>
                            </a>

                            <!-- 📝 استخدام كنموذج واجب -->
                            <a asp-area="Partner"
                               asp-controller="HomeworkDrafts"
                               asp-action="GenerateFromProfessionalModel"
                               asp-route-modelId="@m.Id"
                               class="btn btn-outline-primary btn-sm"
                               data-bs-toggle="tooltip"
                               data-bs-placement="top"
                               title="استخدام كنموذج واجب">
                                <i class="fa-solid fa-clipboard-list"></i>
                            </a>

                        </div>
                    </td>
                </tr>
                        }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var tooltipTriggerList = [].slice.call(
                document.querySelectorAll('[data-bs-toggle="tooltip"]')
            );

            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}
