@model QdratNew.Services.ProfessionalModels.PreviewQuestionVm

@* نص السؤال من بنك المنصة وقد يحتوي HTML، حسب Docs/QUESTION_DISPLAY_PATTERNS.md *@
<div class="pp-question-title" dir="auto">
    @Html.Raw(Model.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(Model.Title ?? string.Empty) : Model.Title)
</div>

@if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
{
    <img src="@Model.ImageUrl" alt="صورة السؤال" class="pp-question-img" loading="lazy" />
}
