@model IEnumerable<QdratNew.ViewModels.Partner.PartnerCourseListViewModel>

@{
    ViewData["Title"] = "الدورات المتعاقد عليها";
}

<div class="container mt-4" dir="rtl">

    <!-- العنوان -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">📘 الدورات المتعاقد عليها</h3>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            لا توجد دورات متاحة ضمن العقد الحالي.
        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach (var course in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm border-0 rounded-4 h-100">

                        <div class="card-body d-flex flex-column">

                            <!-- اسم الدورة -->
                            <h5 class="fw-bold mb-2">
                                @course.CourseName
                            </h5>

                            <!-- الصلاحيات -->
                            <ul class="list-unstyled small text-muted mb-3">
                                <li>
                                    📚 بنك الأسئلة:
                                    @if (course.CanUsePlatformQuestionBank)
                                    {
                                        <span class="text-success fw-semibold">مسموح</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-semibold">غير مسموح</span>
                                    }
                                </li>
                                <li>
                                    ✍️ أسئلة خاصة:
                                    @if (course.CanCreatePrivateQuestions)
                                    {
                                        <span class="text-success fw-semibold">مسموح</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-semibold">غير مسموح</span>
                                    }
                                </li>
                            </ul>

                            <!-- عدد الدفعات -->
                            <div class="mb-3">
                                <span class="badge bg-primary">
                                    عدد الدفعات: @course.BatchesCount
                                </span>
                            </div>

                            <!-- زر الانتقال -->
                            <div class="mt-auto">
                                <a asp-area="Partner"
                                   asp-controller="Batches"
                                   asp-action="Index"
                                   asp-route-courseId="@course.CourseId"
                                   class="btn btn-outline-primary w-100">
                                    📂 عرض الدفعات
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            }

        </div>
    }
</div>
