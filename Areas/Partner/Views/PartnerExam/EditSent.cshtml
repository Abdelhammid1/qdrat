@model QdratNew.Services.PartnerDispatch.PartnerOwnedItemEditVm
@{
    ViewData["Title"] = "تعديل الاختبار";
}

<div class="container py-4" dir="rtl" style="max-width:720px">
    <h1 class="h4 fw-bold mb-1">تعديل الاختبار</h1>
    <p class="text-muted mb-3">الدفعة: @Model.BatchName</p>

    <form asp-action="EditSent" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label fw-bold">العنوان</label>
            <input asp-for="Title" class="form-control" maxlength="200" required />
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="StartAtLocal" class="form-label fw-bold">يبدأ في</label>
                <input asp-for="StartAtLocal" type="datetime-local" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label asp-for="EndAtLocal" class="form-label fw-bold">ينتهي في</label>
                <input asp-for="EndAtLocal" type="datetime-local" class="form-control" required />
            </div>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-primary">حفظ</button>
            <a asp-action="SentExams" class="btn btn-outline-secondary">رجوع</a>
        </div>
    </form>
</div>
