@model QdratNew.ViewModels.Partner.Exam.SendExamDraftVM

@{
    ViewData["Title"] = "إرسال النموذج للدفعات";
}

<h4 class="mb-3">@Model.ExamTitle</h4>

<form asp-action="SendDraft" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="DraftId" />
    <input type="hidden" asp-for="CurriculumId" />
    <input type="hidden" asp-for="CourseId" />

    <div class="mb-3">
        <label class="form-label">الدفعات</label>
        @foreach (var b in Model.AvailableBatches)
        {
            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       name="BatchIds"
                       value="@b.BatchId" />
                <label class="form-check-label">
                    @b.BatchName
                </label>
            </div>
        }
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">تاريخ البدء</label>
            <input asp-for="StartAt" type="datetime-local" class="form-control" required />
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label">تاريخ الانتهاء</label>
            <input asp-for="EndAt" type="datetime-local" class="form-control" required />
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label">المدة (بالدقائق)</label>
            <input asp-for="DurationMinutes" class="form-control" min="1" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary">
        إرسال الاختبار
    </button>
</form>
