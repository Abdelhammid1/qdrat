@model QdratNew.ViewModels.Partner.Exam.AddExamDraftQuestionVM

@{
    ViewData["Title"] = "إضافة سؤال نموذج الاختبار";
}

<div class="container mt-4" dir="rtl">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1">➕ إضافة سؤال للاختبار</h4>
            <div class="text-muted small">
                اختر سؤالًا من نفس المحور لإضافته إلى النموذج
            </div>
        </div>

        <a asp-action="DraftPreview"
           asp-route-draftId="@Model.DraftId"
           class="btn btn-outline-secondary">
            رجوع
        </a>
    </div>

    <!-- Questions Table -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body">

            <table id="addExamQuestionsTable"
                   class="table table-bordered table-hover align-middle text-center w-100">
                <thead class="table-light">
                    <tr>
                        <th>السؤال</th>
                        <th style="width:120px">معاينة</th>
                        <th style="width:140px">إجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in Model.Questions)
                    {
                        <tr>
                            <td class="text-start">
                                @Html.Raw(q.Title)
                            </td>

                            <td>
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#questionPreviewModal"
                                        data-question-id="@q.QuestionId">
                                    👁️
                                </button>
                            </td>

                            <td>
                                <form asp-action="ConfirmAddQuestion"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="DraftId" value="@Model.DraftId" />
                                    <input type="hidden" name="QuestionId" value="@q.QuestionId" />

                                    <button type="submit"
                                            class="btn btn-sm btn-success"
                                            onclick="return confirm('هل أنت متأكد من إضافة السؤال؟');">
                                        إضافة
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>

<!-- Preview Modal -->
<div class="modal fade" id="questionPreviewModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">معاينة السؤال</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="questionPreviewContent">
                <div class="text-center text-muted py-5">جاري التحميل...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#addExamQuestionsTable').DataTable({
                pageLength: 25,
                lengthChange: false,
                ordering: false,
                responsive: true,
                language: {
                    search: "بحث:",
                    paginate: {
                        previous: "السابق",
                        next: "التالي"
                    },
                    info: "عرض _START_ إلى _END_ من _TOTAL_ سؤال",
                    infoEmpty: "لا توجد أسئلة",
                    zeroRecords: "لا توجد نتائج مطابقة"
                }
            });
        });
    </script>

    <script>
        document.getElementById('questionPreviewModal')
            .addEventListener('show.bs.modal', function (event) {

                const button = event.relatedTarget;
                const questionId = button.getAttribute('data-question-id');
                const container = document.getElementById('questionPreviewContent');

                container.innerHTML = '<div class="text-center py-5">جاري التحميل...</div>';

                fetch('/Partner/HomeworkDrafts/PreviewQuestion?questionId=' + questionId)
                    .then(r => r.text())
                    .then(html => container.innerHTML = html);
            });
    </script>
}
