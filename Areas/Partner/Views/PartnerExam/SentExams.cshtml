@model IEnumerable<QdratNew.ViewModels.Partner.Exam.SentExamListVM>

@{
    ViewData["Title"] = "الاختبارات المرسلة";
}

<h2 class="mb-4">الاختبارات المرسلة</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        لا توجد اختبارات مرسلة حتى الآن.
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-striped table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>عنوان الاختبار</th>
                        <th>الدفعة</th>
                        <th>إجمالي الطلاب</th>
                        <th>خاضوا</th>
                        <th>لم يخوضوا</th>
                        <th>تاريخ الإرسال</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = 1;
                    }
                    @foreach (var exam in Model)
                    {
                        <tr>
                            <td>@i</td>
                            <td>@exam.ExamTitle</td>
                            <td>@exam.BatchName</td>
                            <td>@exam.StudentsCount</td>
                            <td class="text-success fw-bold">@exam.AttemptedCount</td>
                            <td class="text-danger fw-bold">@exam.NotAttemptedCount</td>
                            <td>@exam.SentAt.ToString("yyyy/MM/dd HH:mm")</td>
                            <td class="d-flex gap-1">
                                <a asp-area="Partner"
                                   asp-controller="PartnerExam"
                                   asp-action="Details"
                                   asp-route-examId="@exam.ExamId"
                                   asp-route-batchId="@exam.BatchId"
                                   class="btn btn-sm btn-outline-primary">
                                    الأسئلة
                                </a>

                                <a asp-area="Partner"
                                   asp-controller="PartnerExam"
                                   asp-action="Students"
                                   asp-route-examAssignmentId="@exam.ExamAssignmentId"
                                   class="btn btn-sm btn-outline-success">
                                    تقارير الطلاب
                                </a>

                                <form asp-action="DeleteSentExam"
                                      method="post"
                                      style="display:inline-block;"
                                      onsubmit="return confirm('هل أنت متأكد من حذف هذا الاختبار؟');">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="examAssignmentId"
                                           value="@exam.ExamAssignmentId" />

                                    <button type="submit" class="btn btn-sm btn-danger">
                                        حذف
                                    </button>
                                </form>


                            </td>
                        </tr>
                        i++;
                    }
                </tbody>

            </table>
        </div>
    </div>
}
