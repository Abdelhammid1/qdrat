@model QdratNew.Services.Exams.Models.GeneratedExamResult

@{
    ViewData["Title"] = "مراجعة الاختبار قبل الحفظ";

    var sections = Model.Questions
        .GroupBy(q => new { q.SectionId, q.SectionTitle })
        .ToList();
}

@functions {
    string ShortHtmlText(string html, int length = 60)
    {
        if (string.IsNullOrWhiteSpace(html))
            return "";

        var plain = System.Text.RegularExpressions.Regex
            .Replace(html, "<.*?>", string.Empty);

        return plain.Length <= length
            ? plain
            : plain.Substring(0, length) + "...";
    }
}

<div class="container mt-4" dir="rtl">

    <!-- ================= Header ================= -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">👀 مراجعة الاختبار قبل الحفظ</h3>
            <div class="text-muted small">
                يمكنك معاينة الأسئلة، استبدالها أو إضافة أسئلة قبل حفظ النموذج.
            </div>
        </div>
    </div>

    <!-- ================= Summary ================= -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-4">
                    <div class="fw-semibold">عنوان الاختبار</div>
                    <div class="text-muted">@Model.ExamTitle</div>
                </div>

                <div class="col-md-4">
                    <div class="fw-semibold">عدد المحاور</div>
                    <div class="text-muted">@sections.Count محور</div>
                </div>

                <div class="col-md-4">
                    <div class="fw-semibold">إجمالي الأسئلة</div>
                    <div class="text-muted">@Model.Questions.Count سؤال</div>
                </div>

            </div>
        </div>
    </div>

    <!-- ================= Sections ================= -->
    @foreach (var sec in sections)
    {
        <div class="card shadow-sm border-0 rounded-4 mb-4">

            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <strong>📘 @sec.Key.SectionTitle</strong>

                <!-- إضافة سؤال -->
                <a asp-action="AddQuestion"
                   asp-route-sectionId="@sec.Key.SectionId"
                   class="btn btn-sm btn-outline-success">
                    ➕ إضافة سؤال
                </a>
            </div>

            <div class="card-body p-0">
                <ol class="list-group list-group-numbered list-group-flush">

                    @foreach (var q in sec)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">

                            <!-- عنوان مختصر -->
                            <div class="fw-semibold text-truncate" style="max-width:65%">
                                @ShortHtmlText(q.Title)
                            </div>

                            <!-- أدوات -->
                            <div class="btn-group btn-group-sm">

                                <!-- معاينة -->
                                <button type="button"
                                        class="btn btn-outline-primary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#questionPreviewModal"
                                        data-question-id="@q.QuestionId">
                                    👁️
                                </button>

                                <!-- استبدال -->
                                <a asp-action="ReplaceQuestion"
                                   asp-route-oldQuestionId="@q.QuestionId"
                                   asp-route-sectionId="@sec.Key.SectionId"
                                   class="btn btn-outline-warning">
                                    🔁
                                </a>

                            </div>
                        </li>
                    }
                </ol>
            </div>
        </div>
    }

    <!-- ================= Save ================= -->
    <form asp-action="SaveDraft" method="post" class="d-flex justify-content-end">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-success px-4">
            💾 حفظ النموذج
        </button>
    </form>

</div>

<!-- ================= Modal: Question Preview ================= -->
<div class="modal fade" id="questionPreviewModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">معاينة السؤال</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="questionPreviewContent">
                <div class="text-center text-muted py-5">
                    جاري تحميل السؤال...
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('questionPreviewModal')
            .addEventListener('show.bs.modal', function (event) {

                const button = event.relatedTarget;
                const questionId = button.getAttribute('data-question-id');
                const container = document.getElementById('questionPreviewContent');

                container.innerHTML = 'جاري التحميل...';

                fetch('/Partner/HomeworkDrafts/PreviewQuestion?questionId=' + questionId)
                    .then(r => r.text())
                    .then(html => container.innerHTML = html);
            });
    </script>
}
