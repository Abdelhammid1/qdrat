@using QdratNew.ViewModels.Partner.Exam
@model PartnerExamAttemptsVM

@{
    ViewData["Title"] = "سجل محاولات الطالب";
}

<h4 class="mb-2">@Model.StudentName</h4>
<p class="text-muted">
    الاختبار: @Model.ExamTitle <br />
    عدد مرات إعادة الإرسال: <strong>@Model.ResendCount</strong>
</p>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-bordered table-striped mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>وقت المحاولة</th>
                    <th>النتيجة</th>
                    <th>الزمن (ث)</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int i = 1;
                }
                @foreach (var a in Model.Attempts)
                {
                    <tr>
                        <td>@i</td>
                        <td>@a.AttemptedAt.ToString("yyyy/MM/dd HH:mm")</td>
                        <td>
                            @if (a.IsCorrect)
                            {
                                <span class="badge bg-success">صحيحة</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">خاطئة</span>
                            }
                        </td>
                        <td>@a.TimeTakenSeconds</td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
</div>
