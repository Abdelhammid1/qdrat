@model QdratNew.ViewModels.Partner.Exam.DeleteExamWarningVm

<h3 class="text-danger fw-bold">⚠ يوجد نشاط على هذا الاختبار</h3>

<p>
    عدد الطلاب الذين بدأوا الاختبار:
    <strong>@Model.StudentsStarted</strong>
</p>

<p>
    عدد الطلاب الذين قاموا بالتسليم:
    <strong>@Model.StudentsSubmitted</strong>
</p>

<hr />

<p class="text-danger fw-bold">
    في حال تأكيد الحذف سيتم حذف جميع:
    <br />
    - محاولات الطلاب
    <br />
    - نتائج الاختبار
    <br />
    - الحالات المسجلة
</p>

<div class="d-flex gap-3 mt-4">

    <form asp-action="DeleteSentExam" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="examAssignmentId" value="@Model.ExamAssignmentId" />
        <input type="hidden" name="forceDelete" value="true" />
        <button type="submit" class="btn btn-danger">
            حذف نهائي
        </button>
    </form>

    <a asp-action="SentExams" class="btn btn-secondary">
        تراجع
    </a>

</div>