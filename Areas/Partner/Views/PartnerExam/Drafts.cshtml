@model IEnumerable<QdratNew.ViewModels.Partner.Exam.ExamDraftListVM>

@{
    ViewData["Title"] = "نموذج الاختبارات";
}

<h2 class="mb-4">نماذج الاختبارات</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        لا توجد نماذج اختبارات حتى الآن.
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-bordered table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>عنوان الاختبار</th>
                        <th>المنهج</th>
                        <th>عدد الأسئلة</th>
                        <th>تاريخ الإنشاء</th>
                        <th style="width:220px">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = 1;
                    }
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td>@i</td>
                            <td>@d.Title</td>
                            <td>@d.CurriculumTitle</td>
                            <td>@d.QuestionsCount</td>
                            <td>@d.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                            <td>
                                <a asp-action="PreviewDraft"
                                   asp-route-draftId="@d.DraftId"
                                   class="btn btn-sm btn-outline-secondary">
                                    معاينة
                                </a>

                                <a asp-action="SendDraft"
                                   asp-route-draftId="@d.DraftId"
                                   class="btn btn-sm btn-success ms-1">
                                    إرسال
                                </a>

                                <form asp-action="DeleteDraft"
                                      method="post"
                                      style="display:inline-block;"
                                      onsubmit="return confirm('هل أنت متأكد من حذف هذه المسودة؟');">

                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="draftId" value="@d.DraftId" />

                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="fa-solid fa-trash"></i>
                                        حذف
                                    </button>
                                </form>


                            </td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>
    </div>
}
