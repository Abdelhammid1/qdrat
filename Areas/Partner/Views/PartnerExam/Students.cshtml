@using QdratNew.ViewModels.Partner.Exam
@model PartnerExamStudentsVM

@{
    ViewData["Title"] = "طلاب الاختبار";
}

<h3 class="mb-4">@Model.ExamTitle</h3>
<p class="text-muted">الدفعة: @Model.BatchName</p>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-bordered table-striped mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>اسم الطالب</th>
                    <th>الحالة</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int i = 1;
                }
                @foreach (var s in Model.Students)
                {
                    <tr>
                        <td>@i</td>
                        <td>@s.StudentName</td>
                        <td>
                            @if (s.Status == "تم التسليم")
                            {
                                <span class="badge bg-success">تم التسليم</span>
                            }
                            else if (s.Status == "قيد الحل")
                            {
                                <span class="badge bg-warning text-dark">قيد الحل</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">لم يبدأ</span>
                            }
                        </td>
                        <td class="d-flex gap-1">

                            @if (s.IsSubmitted)
                            {
                                <a asp-area="Partner"
                                   asp-controller="PartnerExam"
                                   asp-action="StudentExamReport"
                                   asp-route-examAssignmentId="@Model.ExamAssignmentId"
                                   asp-route-studentId="@s.StudentId"
                                   class="btn btn-success btn-sm">
                                    📊 التقرير
                                </a>
                            }


                            <form asp-action="ResendExamToStudent"
                                  method="post"
                                  class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="examAssignmentId" value="@Model.ExamAssignmentId" />
                                <input type="hidden" name="studentId" value="@s.StudentId" />
                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('إعادة إرسال الاختبار لهذا الطالب؟');">
                                    إعادة الإرسال
                                </button>
                            </form>

                        </td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
</div>
