@model List<QdratNew.Entities.Partner>

@{
    ViewData["Title"] = "اختيار المدرسة";
}

<div class="container mt-5" dir="rtl">

    <div class="card shadow-sm border-0 rounded-4 mx-auto" style="max-width:600px;">
        <div class="card-header bg-light fw-bold text-center">
            🏫 اختر المدرسة
        </div>

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="alert alert-warning text-center">
                    لا توجد مدارس مرتبطة بحسابك.
                </div>
            }
            else
            {
                <form asp-action="Set" method="post">

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            المدرسة
                        </label>

                        <select name="partnerId" class="form-select" required>
                            <option value="">-- اختر المدرسة --</option>
                            @foreach (var partner in Model)
                            {
                                <option value="@partner.Id">
                                    @partner.Name
                                </option>
                            }
                        </select>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary">
                            متابعة
                        </button>
                    </div>

                </form>
            }

        </div>
    </div>

</div>
