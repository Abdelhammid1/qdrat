@model QdratNew.ViewModels.OnlineLecture.PartnerLearningLectureDetailsVm
@using QdratNew.Enums
@inject QdratNew.Services.Interfaces.ITimeZoneService Tz
@* OLC-S4.3 — تقدّم طلاب الشريك في محاضرة واحدة (قراءة فقط — R19). التقدّم بزمن الخادم، ولا يُعرض أي مصدر فيديو. *@
@{
    ViewData["Title"] = "المحتوى التعليمي — " + Model.Lecture.Title;
    var isIndicator = Model.Lecture.Mode == LectureContentMode.IndicatorVideos;
    var total = Model.Students.Count;
}
<link href="~/css/partner-placement.css" rel="stylesheet" asp-append-version="true" />

<div class="pp-page" dir="rtl">
    <div class="pp-head">
        <div>
            <h1><i class="fa-solid fa-circle-play" aria-hidden="true"></i> @Model.Lecture.Title</h1>
            <p>@Model.BatchName · @Model.Lecture.LectureTitle · @Model.Lecture.LectureDate.ToString("yyyy/MM/dd") · @Model.Lecture.SectionTitle</p>
        </div>
        <div class="pp-head-actions">
            <a asp-action="Batch" asp-route-id="@Model.BatchId" class="pp-btn pp-btn-sm pp-btn-light">رجوع</a>
        </div>
    </div>

    <div class="pp-stats">
        <div class="pp-stat"><b>@total</b><span>طالب نشط</span></div>
        <div class="pp-stat"><b>@Model.Lecture.StartedCount</b><span>بدأ المشاهدة</span></div>
        <div class="pp-stat"><b>@Model.Lecture.CompletedCount</b><span>أتمّ المحاضرة</span></div>
        <div class="pp-stat"><b>@(total - Model.Lecture.StartedCount)</b><span>لم يبدأ</span></div>
    </div>

    <div class="pp-card">
        @if (total == 0)
        {
            <div class="pp-empty">
                <i class="fa-solid fa-users-slash" aria-hidden="true"></i>
                <h2>لا يوجد طلاب نشطون في هذه الدفعة</h2>
            </div>
        }
        else
        {
            <div class="pp-table-wrap">
                <table class="pp-table pp-table-cards">
                    <thead>
                        <tr>
                            <th>الطالب</th>
                            <th>الحالة</th>
                            <th>التقدّم</th>
                            <th>آخر نشاط</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Students)
                        {
                            <tr>
                                <td data-label="الطالب">@s.FullName</td>
                                <td data-label="الحالة">
                                    @if (s.IsCompleted)
                                    {
                                        <span class="pp-badge pp-badge-ok">أتمّ</span>
                                    }
                                    else if (s.Started)
                                    {
                                        <span class="pp-badge pp-badge-warn">قيد المشاهدة</span>
                                    }
                                    else
                                    {
                                        <span class="pp-badge pp-badge-muted">لم يبدأ</span>
                                    }
                                </td>
                                <td data-label="التقدّم">
                                    <div>
                                        @s.ProgressPercent%
                                        @if (isIndicator)
                                        {
                                            <span class="pp-muted">(@s.CompletedItems من @Model.Lecture.ItemsCount فيديو)</span>
                                        }
                                    </div>
                                    <div class="pp-bar" role="progressbar" aria-valuenow="@s.ProgressPercent" aria-valuemin="0" aria-valuemax="100">
                                        <span class="@(s.IsCompleted ? "is-good" : s.ProgressPercent >= 40 ? "is-mid" : "is-low")" style="width:@(s.ProgressPercent)%"></span>
                                    </div>
                                </td>
                                <td data-label="آخر نشاط">@(s.LastActivityUtc.HasValue ? Tz.ConvertToSaudi(s.LastActivityUtc.Value).ToString("yyyy/MM/dd HH:mm") : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
