@model QdratNew.ViewModels.OnlineLecture.PartnerLearningBatchDetailsVm
@using QdratNew.Enums
@* OLC-S4.3 — محاضرات دفعة الشريك ذات المحتوى المنشور: من بدأ ومن أتم (قراءة فقط — R19) *@
@{
    ViewData["Title"] = "المحتوى التعليمي — " + Model.BatchName;
    string ModeText(LectureContentMode m) => m == LectureContentMode.FullVideo ? "فيديو كامل" : "فيديوهات المؤشرات";
}
<link href="~/css/partner-placement.css" rel="stylesheet" asp-append-version="true" />

<div class="pp-page" dir="rtl">
    <div class="pp-head">
        <div>
            <h1><i class="fa-solid fa-layer-group" aria-hidden="true"></i> @Model.BatchName</h1>
            <p>@Model.CourseName · @Model.StudentsCount طالب نشط</p>
        </div>
        <div class="pp-head-actions">
            <a asp-action="Index" class="pp-btn pp-btn-sm pp-btn-light">رجوع</a>
        </div>
    </div>

    <div class="pp-card">
        @if (!Model.Lectures.Any())
        {
            <div class="pp-empty">
                <i class="fa-solid fa-video-slash" aria-hidden="true"></i>
                <h2>لم يُنشر محتوى لمحاضرات هذه الدفعة بعد</h2>
            </div>
        }
        else
        {
            <div class="pp-table-wrap">
                <table class="pp-table pp-table-cards">
                    <thead>
                        <tr>
                            <th>المحاضرة</th>
                            <th>المحور</th>
                            <th>النوع</th>
                            <th>بدأ المشاهدة</th>
                            <th>أتمّ</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.Lectures)
                        {
                            <tr>
                                <td data-label="المحاضرة">
                                    <strong>@l.Title</strong>
                                    <div class="pp-muted">@l.LectureTitle · @l.LectureDate.ToString("yyyy/MM/dd")</div>
                                </td>
                                <td data-label="المحور">@l.SectionTitle</td>
                                <td data-label="النوع">
                                    @ModeText(l.Mode)
                                    @if (l.Mode == LectureContentMode.IndicatorVideos)
                                    {
                                        <span class="pp-muted">(@l.ItemsCount فيديو)</span>
                                    }
                                </td>
                                <td data-label="بدأ المشاهدة">@l.StartedCount من @Model.StudentsCount</td>
                                <td data-label="أتمّ">
                                    <span class="pp-badge @(l.CompletedCount > 0 ? "pp-badge-ok" : "pp-badge-muted")">@l.CompletedCount من @Model.StudentsCount</span>
                                </td>
                                <td data-label="">
                                    <a asp-action="Lecture" asp-route-id="@l.LectureContentId" class="pp-btn pp-btn-sm pp-btn-primary">الطلاب</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
