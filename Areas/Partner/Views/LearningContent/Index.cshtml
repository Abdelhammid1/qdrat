@model QdratNew.ViewModels.OnlineLecture.PartnerLearningIndexVm
@*
    OLC-S4.3 — «المحتوى التعليمي» للشريك (قراءة فقط — R19): دفعاته الأونلاين ونسبة إتمام طلابه.
    لا روابط فيديو ولا إنشاء/تعديل هنا — المحتوى يديره المعهد من منطقة الأدمن (R18).
*@
@{
    ViewData["Title"] = "المحتوى التعليمي";
}
<link href="~/css/partner-placement.css" rel="stylesheet" asp-append-version="true" />

<div class="pp-page" id="partnerLearningContent" dir="rtl">
    <div class="pp-head">
        <div>
            <h1><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i> المحتوى التعليمي</h1>
            <p>محاضرات دفعاتك الأونلاين التي نشرها معهد القدرات، ومتابعة مشاهدة طلابك لها. للعرض فقط.</p>
        </div>
    </div>

    @if (Model.IsReadAfterExpiry)
    {
        <div class="pp-alert pp-alert-warn" role="status">انتهى عقدك الحالي — البيانات متاحة للقراءة فقط حتى نهاية مهلة الوصول.</div>
    }

    <div class="pp-card">
        @if (!Model.FeatureEnabled)
        {
            <div class="pp-empty">
                <i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>
                <h2>المحتوى التعليمي أونلاين غير متاح بعد</h2>
                <p class="pp-muted">سيظهر هنا عند إطلاق الخدمة من معهد القدرات.</p>
            </div>
        }
        else if (!Model.Batches.Any())
        {
            <div class="pp-empty">
                <i class="fa-solid fa-inbox" aria-hidden="true"></i>
                <h2>لا توجد دفعات أونلاين لك بعد</h2>
                <p class="pp-muted">يفعّل معهد القدرات التعليم أونلاين لدفعاتك وفق بند «المحتوى التعليمي» في عقدك.</p>
            </div>
        }
        else
        {
            <div class="pp-table-wrap">
                <table class="pp-table pp-table-cards">
                    <thead>
                        <tr>
                            <th>الدفعة</th>
                            <th>الطلاب</th>
                            <th>المحاضرات المنشورة</th>
                            <th>نسبة الإتمام</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.Batches)
                        {
                            var pct = b.CompletionPercent;
                            <tr>
                                <td data-label="الدفعة">
                                    <strong>@b.Name</strong>
                                    @if (!string.IsNullOrEmpty(b.CourseName))
                                    {
                                        <div class="pp-muted">@b.CourseName</div>
                                    }
                                </td>
                                <td data-label="الطلاب">@b.StudentsCount</td>
                                <td data-label="المحاضرات المنشورة">@b.PublishedCount</td>
                                <td data-label="نسبة الإتمام">
                                    <div>@pct%</div>
                                    <div class="pp-bar" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                                        <span class="@(pct >= 70 ? "is-good" : pct >= 40 ? "is-mid" : "is-low")" style="width:@(pct)%"></span>
                                    </div>
                                </td>
                                <td data-label="">
                                    <a asp-action="Batch" asp-route-id="@b.BatchId" class="pp-btn pp-btn-sm pp-btn-primary">المحاضرات</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
