@model QdratNew.ViewModels.Partner.PartnerStudentDetailsViewModel

@{
    ViewData["Title"] = "ملف الطالب";
}

<div class="container mt-4" dir="rtl">

    <!-- العنوان -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">👨‍🎓 ملف الطالب</h3>

        <a asp-area="Partner"
           asp-controller="Students"
           asp-action="AddToBatch"
           asp-route-studentId="@Model.StudentId"
           class="btn btn-success">
            ➕ إلحاق بدفعة
        </a>
    </div>

    <!-- بطاقة بيانات الطالب -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body">

            <div class="row g-3">
                <div class="col-md-4">
                    <strong>الاسم</strong>
                    <div class="text-muted">@Model.FullName</div>
                </div>

                <div class="col-md-4">
                    <strong>رقم الهوية</strong>
                    <div class="text-muted">@Model.NationalId</div>
                </div>

                <div class="col-md-4">
                    <strong>الحالة التعليمية</strong><br />
                    @if (Model.IsActiveForLearning)
                    {
                        <span class="badge bg-success">نشط</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">موقوف</span>
                    }
                </div>
            </div>

        </div>
    </div>

    <!-- بطاقة الدفعات -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-light fw-semibold">
            📚 الدفعات المسجل بها الطالب
        </div>

        <div class="card-body p-0">

            <table class="table table-hover mb-0 text-center align-middle">
                <thead class="table-light">
                    <tr>
                        <th>الدورة</th>
                        <th>الدفعة</th>
                        <th>تاريخ الإلحاق</th>
                        <th>الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Batches.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-muted py-4">
                                الطالب غير ملتحق بأي دفعة حتى الآن.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var b in Model.Batches)
                        {
                            <tr>
                                <td>@b.CourseName</td>
                                <td>@b.BatchName</td>
                                <td>@b.EnrolledAt.ToString("yyyy/MM/dd")</td>
                                <td>
                                    <span class="badge bg-info">
                                        @b.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>
    </div>

    <!-- رجوع -->
    <div class="mt-4">
        <a asp-area="Partner"
           asp-controller="Students"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ⬅️ رجوع للقائمة
        </a>
    </div>

</div>
