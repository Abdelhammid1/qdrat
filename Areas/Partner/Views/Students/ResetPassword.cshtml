@model QdratNew.ViewModels.Partner.ResetStudentPasswordViewModel

@{
    ViewData["Title"] = "إعادة تعيين كلمة المرور";
}

<h2 class="mb-4">🔐 إعادة تعيين كلمة المرور</h2>

<form asp-action="ResetPassword" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="StudentId" />

    <div class="alert alert-warning">
        سيتم تعيين كلمة المرور إلى رقم الهوية:
        <strong>@Model.NationalId</strong>
    </div>

    <button type="submit" class="btn btn-danger">
        تأكيد إعادة التعيين
    </button>

    <a asp-action="Index" class="btn btn-secondary ms-2">إلغاء</a>
</form>
