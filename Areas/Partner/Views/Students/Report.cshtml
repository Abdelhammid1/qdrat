@model QdratNew.ViewModels.Partner.PartnerStudentReportViewModel

<div class="container mt-4" dir="rtl">

    <h3 class="fw-bold mb-4">📊 تقرير الطالب</h3>

    <div class="card shadow-sm p-4 mb-3">
        <p><strong>الاسم:</strong> @Model.FullName</p>
        <p><strong>رقم الهوية:</strong> @Model.NationalId</p>
        <p><strong>الهاتف:</strong> @Model.Phone</p>
        <p><strong>المستوى:</strong> @Model.Level</p>
        <p><strong>المدرسة:</strong> @Model.School</p>
    </div>

    <div class="card shadow-sm p-4">
        <h5 class="mb-3">📚 الدفعات</h5>

        @if (!Model.Batches.Any())
        {
            <p class="text-muted">لا يوجد دفعات</p>
        }
        else
        {
            <ul>
                @foreach (var b in Model.Batches)
                {
                    <li>@b</li>
                }
            </ul>
        }
    </div>

</div>