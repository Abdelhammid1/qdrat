@model QdratNew.ViewModels.Partner.CreatePartnerStudentViewModel

@{
    ViewData["Title"] = "إضافة طالب جديد";
}

<div class="container mt-4" dir="rtl">

    <!-- العنوان -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">➕ إضافة طالب جديد</h3>
        <a asp-action="Index" class="btn btn-outline-secondary">
            رجوع
        </a>
    </div>

    <!-- عرض الأخطاء العامة -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="Create" method="post" class="card shadow-sm border-0 rounded-4 p-4">
        @Html.AntiForgeryToken()

        <!-- 🧑‍🎓 بيانات الطالب -->
        <div class="card mb-4 border-0">
            <div class="card-header bg-light fw-bold">
                🧑‍🎓 بيانات الطالب
            </div>
            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">اسم الطالب</label>
                        <input asp-for="FullName" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">الجنس</label>
                        <select asp-for="Gender" class="form-select">
                            <option value="">-- اختر الجنس --</option>
                            <option value="Male">ذكر</option>
                            <option value="Female">أنثى</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">رقم الهوية</label>
                        <input asp-for="NationalId" class="form-control" />
                        <small class="text-muted">
                            سيتم استخدامه كاسم مستخدم وكلمة مرور
                        </small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">المرحلة / المستوى</label>
                        <select asp-for="Level" class="form-select">
                            <option value="">-- اختر المستوى --</option>
                            <option value="Middle">متوسط</option>
                            <option value="High">ثانوي</option>
                            <option value="Tahseeli">تحصيلي</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">رقم الجوال</label>
                        <input asp-for="Phone" class="form-control" />
                    </div>

                </div>

            </div>
        </div>

        <!-- 🎓 التوزيع الأكاديمي -->
        <div class="card mb-4 border-0">
            <div class="card-header bg-light fw-bold">
                🎓 التوزيع الأكاديمي
            </div>
            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">الدورة</label>
                        <select asp-for="CourseId"
                                asp-items="Model.Courses"
                                class="form-select"
                                onchange="loadBatches(this.value)">
                            <option value="">-- اختر الدورة --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">الدفعة</label>
                        <select asp-for="BatchId" class="form-select">
                            <option value="">-- اختر الدفعة --</option>
                        </select>
                    </div>

                </div>

            </div>
        </div>

        <!-- أزرار التحكم -->
        <div class="d-flex justify-content-end gap-2">
            <button type="submit" class="btn btn-success px-4">
                حفظ الطالب
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                إلغاء
            </a>
        </div>

    </form>
</div>

@section Scripts {
    <script>
        function loadBatches(courseId) {
            const ddl = document.querySelector('[name="BatchId"]');
            ddl.innerHTML = '<option value="">-- اختر الدفعة --</option>';

            if (!courseId) return;

            fetch(`/Partner/Students/GetBatchesByCourse?courseId=${courseId}`)
                .then(r => r.json())
                .then(data => {
                    data.forEach(b => {
                        ddl.innerHTML += `<option value="${b.id}">${b.name}</option>`;
                    });
                });
        }
    </script>
}
