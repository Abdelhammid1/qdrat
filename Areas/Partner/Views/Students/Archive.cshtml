@model IEnumerable<QdratNew.ViewModels.Partner.StudentListViewModel>

@{
    ViewData["Title"] = "أرشيف الطلاب";
}

<h2 class="mb-3">🗂️ أرشيف الطلاب</h2>

<a asp-action="Index" class="btn btn-secondary mb-3">⬅️ رجوع</a>

<table class="table table-bordered">
    <thead class="table-dark">
        <tr>
            <th>الاسم</th>
            <th>رقم الهوية</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.FullName</td>
                <td>@s.NationalId</td>
            </tr>
        }
    </tbody>
</table>
