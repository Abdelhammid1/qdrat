@model QdratNew.ViewModels.Partner.EditPartnerStudentViewModel

@{
    ViewData["Title"] = "تعديل بيانات الطالب";
}

<h3 class="mb-4">تعديل بيانات الطالب</h3>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">اسم الطالب</label>
            <input asp-for="FullName" class="form-control" />
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">رقم الجوال</label>
            <input asp-for="Phone" class="form-control" />
        </div>

        <div class="col-md-6 mb-3">
            <div class="form-check mt-4">
                <input asp-for="IsActiveForLearning" class="form-check-input" />
                <label asp-for="IsActiveForLearning" class="form-check-label">
                    الطالب نشط تعليميًا
                </label>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">حفظ التعديلات</button>
    <a asp-action="Index" class="btn btn-secondary">رجوع</a>
</form>
