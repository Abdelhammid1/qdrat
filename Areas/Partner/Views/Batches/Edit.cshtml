@model QdratNew.ViewModels.Partner.EditPartnerBatchViewModel

@{
    ViewData["Title"] = "تعديل دفعة";
}

<div class="container mt-4" dir="rtl">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">✏️ تعديل الدفعة</h3>
        <a asp-action="Index" class="btn btn-outline-secondary">
            رجوع
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="Edit" method="post" class="card shadow-sm border-0 rounded-4 p-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label">اسم الدفعة</label>
            <input asp-for="Name" class="form-control" />
        </div>

        <div class="mb-4">
            <label class="form-label">الدورة</label>
            <select asp-for="CourseId"
                    asp-items="Model.Courses"
                    class="form-select">
                <option value="">-- اختر الدورة --</option>
            </select>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <button type="submit" class="btn btn-primary px-4">
                حفظ التعديلات
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                إلغاء
            </a>
        </div>
    </form>
</div>
