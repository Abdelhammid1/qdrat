@model QdratNew.ViewModels.Partner.MinistrySim.PartnerMinistrySimIndexVm

@{
    ViewData["Title"] = "معمل القياس";
}

<div class="pp-page" id="partnerMinistrySim">
    <partial name="~/Areas/Partner/Views/PerformanceIndicatorExams/_PerformanceAlerts.cshtml" />

    <div class="pp-head">
        <div>
            <h1><i class="fa-solid fa-flask" aria-hidden="true"></i> معمل القياس</h1>
            <p>اختبارات محاكاة الوزارة التي أسندها معهد القدرات لطلابك. تابع هنا حالتهم ونتائجهم وتحليلات دفعاتهم وتقارير أولياء الأمور.</p>
        </div>
    </div>

    <div class="pp-tabs">
        <a asp-action="Index" class="pp-tab @(!Model.ShowHidden ? "is-active" : "")">الاختبارات</a>
        <a asp-action="Index" asp-route-hidden="true" class="pp-tab @(Model.ShowHidden ? "is-active" : "")">المخفية (@Model.HiddenCount)</a>
    </div>

    <div class="pp-card">
        @if (!Model.Exams.Any())
        {
            <div class="pp-empty">
                <i class="fa-solid fa-inbox" aria-hidden="true"></i>
                <h2>@(Model.ShowHidden ? "لا توجد اختبارات مخفية" : "لم يُسند لك اختبار معمل قياس بعد")</h2>
                @if (!Model.ShowHidden)
                {
                    <p class="pp-muted">تظهر هنا الاختبارات التي يسندها المعهد لدفعاتك أو لطلاب منها.</p>
                }
            </div>
        }
        else
        {
            <div class="pp-table-wrap">
                <table class="pp-table pp-table-cards">
                    <thead>
                        <tr>
                            <th>الاختبار</th>
                            <th>الدورة</th>
                            <th>الدفعات</th>
                            <th>الطلاب</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var exam in Model.Exams)
                        {
                            <tr data-mse-exam="@exam.ExamId">
                                <td data-label="الاختبار">
                                    <strong>@exam.Title</strong>
                                    <span class="pp-badge pp-badge-main">من المعهد</span>
                                </td>
                                <td data-label="الدورة">@exam.CourseName</td>
                                <td data-label="الدفعات">
                                    @if (!exam.Batches.Any() && exam.IndividualCount == 0)
                                    {
                                        <span>—</span>
                                    }
                                    @foreach (var batch in exam.Batches)
                                    {
                                        <div>
                                            <a asp-action="BatchStudents" asp-route-id="@exam.ExamId" asp-route-batchId="@batch.BatchId">@batch.Name</a>
                                            @if (!batch.IsOnline)
                                            {
                                                <span class="pp-muted">· حضوري، الرمز: <span class="pp-code">@batch.ReferenceCode</span></span>
                                            }
                                            @if (batch.VisibleFrom.HasValue)
                                            {
                                                <span class="pp-muted">· يظهر من @batch.VisibleFrom.Value.ToString("yyyy/MM/dd HH:mm")</span>
                                            }
                                        </div>
                                    }
                                    @if (exam.IndividualCount > 0)
                                    {
                                        <div class="pp-muted">@exam.IndividualCount طالب بإسناد فردي</div>
                                    }
                                </td>
                                <td data-label="الطلاب">@exam.CompletedCount من @exam.StudentsCount أكملوا</td>
                                <td data-label="الإجراءات">
                                    <div class="pp-actions">
                                        <a asp-action="BatchStudents" asp-route-id="@exam.ExamId" class="pp-btn pp-btn-sm pp-btn-primary">النتائج</a>
                                        @if (Model.CanManage)
                                        {
                                            <form asp-action="@(Model.ShowHidden ? "Restore" : "Hide")" asp-route-id="@exam.ExamId" method="post">
                                                <button type="submit" class="pp-btn pp-btn-sm pp-btn-light">@(Model.ShowHidden ? "إظهار" : "إخفاء")</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
