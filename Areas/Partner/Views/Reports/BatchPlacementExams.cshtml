@model QdratNew.ViewModels.Partner.PartnerPlacementBatchExamsVm

@{
    ViewData["Title"] = "اختبارات تحديد المستوى في الدفعة";
}

<div class="pp-page">
    <partial name="~/Areas/Partner/Views/PlacementExams/_PlacementAlerts.cshtml" />

    <div class="pp-head">
        <div>
            <h1><i class="fa-solid fa-signal"></i> تحديد المستوى: @Model.BatchName</h1>
            <p>نتائج الاختبارات المرسلة لطلاب هذه الدفعة.</p>
        </div>

        <div class="pp-head-actions">
            <a asp-action="Batch" asp-route-batchId="@Model.BatchId" class="pp-btn pp-btn-light">
                <i class="fa-solid fa-arrow-right"></i>
                تقرير الدفعة
            </a>
        </div>
    </div>

    <div class="pp-card">
        @if (!Model.Exams.Any())
        {
            <div class="pp-empty">
                <i class="fa-solid fa-inbox"></i>
                <h2>لا توجد اختبارات تحديد مستوى مرسلة لهذه الدفعة</h2>
            </div>
        }
        else
        {
            <div class="pp-table-wrap">
                <table class="pp-table pp-table-cards">
                    <thead>
                        <tr>
                            <th>الاختبار</th>
                            <th>تاريخ الإنشاء</th>
                            <th>الأسئلة</th>
                            <th>الطلاب</th>
                            <th>أدّوا الاختبار</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var exam in Model.Exams)
                        {
                            <tr>
                                <td data-label="الاختبار">
                                    @exam.Title
                                    @if (!exam.IsActive)
                                    {
                                        <span class="pp-badge pp-badge-muted"><i class="fa-solid fa-eye-slash"></i> مخفي</span>
                                    }
                                </td>
                                <td data-label="تاريخ الإنشاء">@exam.CreatedAt.ToString("yyyy/MM/dd")</td>
                                <td data-label="الأسئلة">@exam.TotalQuestions</td>
                                <td data-label="الطلاب">@exam.StudentCount</td>
                                <td data-label="أدّوا الاختبار">@exam.TestedCount</td>
                                <td data-label="الإجراءات">
                                    <div class="pp-actions">
                                        <a asp-controller="PlacementExams" asp-action="BatchStudents" asp-route-examId="@exam.ExamId" asp-route-batchId="@Model.BatchId" class="pp-btn pp-btn-light pp-btn-sm">
                                            <i class="fa-solid fa-user-graduate"></i>
                                            النتائج
                                        </a>
                                        <a asp-controller="PlacementExams" asp-action="BatchPerformanceReport" asp-route-examId="@exam.ExamId" asp-route-batchId="@Model.BatchId" class="pp-btn pp-btn-light pp-btn-sm">
                                            <i class="fa-solid fa-chart-column"></i>
                                            أداء الدفعة
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
