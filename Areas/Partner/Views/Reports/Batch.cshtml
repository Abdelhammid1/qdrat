@model QdratNew.ViewModels.Partner.Reports.BatchReportVM

@{
    ViewData["Title"] = "تقرير الدفعة";
}

<div class="container-fluid mt-4">

    <h4 class="mb-4">
        تقرير الدفعة: <strong>@Model.BatchName</strong>
    </h4>

    <div class="row">

        <!-- عدد الطلاب -->
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted">عدد الطلاب</h6>
                    <h3>@Model.TotalStudents</h3>
                </div>
            </div>
        </div>

        <!-- عدد الواجبات -->
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted">عدد الواجبات</h6>
                    <h3>@Model.TotalHomeworkSets</h3>
                </div>
            </div>
        </div>

        <!-- عدد الاختبارات -->
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted">عدد الاختبارات</h6>
                    <h3>@Model.TotalExamAssignments</h3>
                </div>
            </div>
        </div>

        <!-- متوسط الدرجات -->
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted">متوسط الدرجات</h6>
                    <h3>
                        @(Math.Round(
                                                (Model.AverageHomeworkScore + Model.AverageExamScore) / 2,
                                                1))
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <!-- نسب الإنجاز -->
    <div class="row mt-3">

        <div class="col-md-6 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6>نسبة إنجاز الواجبات</h6>
                    <div class="progress">
                        <div class="progress-bar bg-success"
                             style="width:@Model.HomeworkCompletionRate%">
                            @Model.HomeworkCompletionRate.ToString("0.0")%
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6>نسبة المشاركة في الاختبارات</h6>
                    <div class="progress">
                        <div class="progress-bar bg-info"
                             style="width:@Model.ExamParticipationRate%">
                            @Model.ExamParticipationRate.ToString("0.0")%
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- أزرار الانتقال -->
    <div class="mt-4">
        <a asp-action="BatchHomeworks"
           asp-route-batchId="@Model.BatchId"
           class="btn btn-outline-primary me-2">
            تقرير الواجبات
        </a>

        <a asp-action="BatchExams"
           asp-route-batchId="@Model.BatchId"
           class="btn btn-outline-secondary">
            تقرير الاختبارات
        </a>
    </div>

</div>
