@model QdratNew.ViewModels.Partner.Reports.StudentExamDetailVM
@{
    Layout = "~/Views/Shared/_ReportLayout.cshtml";
    ViewData["Title"] = "📊 تقرير اختبار الطالب";
}

<div class="container report-container">

    <!-- ================= Header ================= -->
    <div class="report-header">
        <div>
            <h2>@Model.StudentName</h2>
            <div class="chips">
                <span>@Model.ExamTitle</span>
                <span>@Model.AssignedAt.ToString("yyyy/MM/dd")</span>
                <span>
                    @(Model.SubmittedAt.HasValue ? "تم التسليم" : "لم يسلّم")
                </span>
            </div>
        </div>
        <button class="btn-print no-print" onclick="window.print()">🖨️ طباعة</button>
    </div>

    <!-- ================= KPIs ================= -->
    <div class="stats mb-4">

        <div class="card">
            <div class="stat-title">الدرجة</div>
            <div class="stat-value good">
                @(Model.Score?.ToString() ?? "-")
            </div>
        </div>

        <div class="card">
            <div class="stat-title">مدة الاختبار</div>
            <div class="stat-value">
                @Model.DurationMinutes دقيقة
            </div>
        </div>

        <div class="card">
            <div class="stat-title">حالة الاختبار</div>
            <div class="stat-value @(Model.SubmittedAt.HasValue ? "good" : "weak")">
                @Model.Status
            </div>
        </div>

        <div class="card">
            <div class="stat-title">وقت البدء</div>
            <div class="stat-value">
                @(Model.StartedAt?.ToString("HH:mm") ?? "-")
            </div>
        </div>

    </div>

    <!-- ================= Progress ================= -->
    <div class="analysis-card mb-4">
        <h4>نسبة الإنجاز</h4>

        @{
            var percent =
            Model.Score.HasValue
            ? Math.Min(100, Model.Score.Value)
            : 0;

            string performanceText =
            percent >= 70 ? "أداء جيد" :
            percent >= 40 ? "أداء متوسط" :
            "أداء ضعيف";
        }

        <div class="progress-bar">
            <div class="progress-inner" style="width:@percent%">
                @percent%
            </div>
        </div>

        <p class="mt-3">
            <strong>@performanceText</strong> —
            @(
                        Model.SubmittedAt.HasValue
                        ? "أنهى الطالب الاختبار."
                        : "لم يتم إنهاء الاختبار."
                        )
        </p>
    </div>

    <!-- ================= Timing ================= -->
    <div class="analysis-card">
        <h4>تفاصيل الزمن</h4>

        <div class="row text-center">
            <div class="col-md-4">
                <strong>تاريخ الإسناد</strong>
                <div>@Model.AssignedAt.ToString("yyyy/MM/dd")</div>
            </div>

            <div class="col-md-4">
                <strong>وقت البدء</strong>
                <div>
                    @(Model.StartedAt?.ToString("yyyy/MM/dd HH:mm") ?? "-")
                </div>
            </div>

            <div class="col-md-4">
                <strong>وقت التسليم</strong>
                <div>
                    @(Model.SubmittedAt?.ToString("yyyy/MM/dd HH:mm") ?? "-")
                </div>
            </div>
        </div>
    </div>

    <!-- ================= Actions ================= -->
    <div class="mt-4 no-print">
        <a asp-action="ExamStudents"
           asp-route-examAssignmentId="@Model.ExamAssignmentId"
           class="btn btn-outline-secondary">
            رجوع
        </a>
    </div>

</div>
