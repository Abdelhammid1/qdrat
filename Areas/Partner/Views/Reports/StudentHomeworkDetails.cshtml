@model QdratNew.ViewModels.Partner.Reports.StudentHomeworkDetailVM
@{
    Layout = "~/Views/Shared/_ReportLayout.cshtml";
    ViewData["Title"] = "📘 تقرير واجب الطالب";
}

<div class="container report-container">

    <!-- Header -->
    <div class="report-header">
        <div>
            <h2>@Model.StudentName</h2>
            <div class="chips">
                <span>@Model.HomeworkTitle</span>
                <span>@Model.AssignedAt.ToString("yyyy/MM/dd")</span>
                <span>
                    @(Model.SubmittedAt.HasValue ? "تم التسليم" : "لم يسلّم")
                </span>
            </div>
        </div>
        <button class="btn-print no-print" onclick="window.print()">🖨️ طباعة</button>
    </div>

    <!-- KPIs -->
    <div class="stats mb-4">
        <div class="card">
            <div class="stat-title">عدد المحاولات</div>
            <div class="stat-value">@Model.AttemptCount</div>
        </div>

        <div class="card">
            <div class="stat-title">الدرجة</div>
            <div class="stat-value good">
                @(Model.Score?.ToString("0.0") ?? "-")
            </div>
        </div>

        <div class="card">
            <div class="stat-title">حالة التسليم</div>
            <div class="stat-value @(Model.IsLate ? "weak" : "good")">
                @(Model.IsLate ? "متأخر" : "في الموعد")
            </div>
        </div>
    </div>

    <!-- Progress -->
    <div class="analysis-card">
        <h4>نسبة الإنجاز</h4>
        <div class="progress-bar">
            <div class="progress-inner"
                 style="width:@(Model.Score ?? 0)%">
                @(Model.Score ?? 0)%
            </div>
        </div>

        <p class="mt-2">
            @(
                        Model.SubmittedAt == null
                        ? "لم يتم تسليم الواجب حتى الآن."
                        : Model.IsLate
                        ? "تم تسليم الواجب بعد الموعد المحدد."
                        : "تم تسليم الواجب في الوقت المحدد."
                        )
        </p>
    </div>

    <div class="mt-4 no-print">
        <a asp-action="HomeworkStudents"
           asp-route-homeworkSetId="@Model.HomeworkSetId"
           class="btn btn-outline-secondary">
            رجوع
        </a>
    </div>

</div>
