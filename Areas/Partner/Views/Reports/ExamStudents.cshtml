@model QdratNew.ViewModels.Partner.Reports.ExamStudentsVM

@{
    ViewData["Title"] = "طلاب الاختبار";
}

<link rel="stylesheet"
      href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

<div class="container-fluid mt-4">

    <h4 class="mb-4">
        طلاب الاختبار:
        <strong>@Model.ExamTitle</strong>
    </h4>

    <table id="studentsTable"
           class="table table-bordered table-striped align-middle">

        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>اسم الطالب</th>
                <th>بدأ الاختبار</th>
                <th>تم التسليم</th>
                <th>وقت البدء</th>
                <th>وقت التسليم</th>
                <th>الدرجة</th>
                <th>الحالة</th>
                <th>إجراءات</th>
            </tr>
        </thead>

        <tbody>
            @{
                int i = 1;
            }
            @foreach (var s in Model.Students)
            {
                <tr>
                    <td>@i</td>
                    <td>@s.StudentName</td>
                    <td>@(s.HasStarted ? "نعم" : "لا")</td>
                    <td>@(s.IsSubmitted ? "نعم" : "لا")</td>
                    <td>@(s.StartedAt?.ToString("yyyy/MM/dd HH:mm") ?? "-")</td>
                    <td>@(s.SubmittedAt?.ToString("yyyy/MM/dd HH:mm") ?? "-")</td>
                    <td>@(s.Score?.ToString() ?? "-")</td>
                    <td>@s.Status</td>
                    <td>
                        <a asp-action="StudentExamDetails"
                           asp-route-examAssignmentId="@Model.ExamAssignmentId"
                           asp-route-studentId="@s.StudentId"
                           class="btn btn-sm btn-outline-primary">
                            تقرير الطالب
                        </a>
                    </td>
                </tr>
                i++;
            }
        </tbody>

    </table>

    <div class="mt-3">
        <a asp-action="BatchExams"
           asp-route-batchId="@Context.Request.Query["batchId"]"
           class="btn btn-outline-secondary">
            رجوع
        </a>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
    $(function () {
        $('#studentsTable').DataTable({
            language: {
                url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json'
            },
            pageLength: 10
        });
    });
</script>
