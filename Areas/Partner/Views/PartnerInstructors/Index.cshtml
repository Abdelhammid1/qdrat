@using QdratNew.ViewModels.Partner.Instructor
@model List<PartnerInstructorListVm>

@{
    ViewData["Title"] = "مدربي الشريك";
}

<div class="container mt-4" dir="rtl">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">
            <i class="fas fa-chalkboard-user text-primary ms-2"></i>
            مدربي الشريك
        </h4>

        @if (ViewBag.AvailableSlots == -1 || ViewBag.AvailableSlots > 0)
        {
            <a asp-action="Create"
               class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="fas fa-plus ms-1"></i>
                إضافة مدرب
            </a>
        }
        else
        {
            <button class="btn btn-danger rounded-pill px-4 shadow-sm"
                    disabled
                    data-bs-toggle="tooltip"
                    title="تم استهلاك الحد الأقصى للمدربين حسب العقد">
                <i class="fas fa-lock ms-1"></i>
                الحد الأقصى مستهلك
            </button>
        }
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <!-- إحصائية المدربين -->
            <div class="row mb-4">

                <div class="col-md-4">
                    <div class="card shadow-sm border-0 rounded-4 text-center p-3">
                        <div class="fw-bold text-secondary">المدربين النشطين</div>
                        <h3 class="fw-bold text-success mb-0">
                            @ViewBag.ActiveCount
                        </h3>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card shadow-sm border-0 rounded-4 text-center p-3">
                        <div class="fw-bold text-secondary">الحد الأقصى بالعقد</div>
                        <h3 class="fw-bold text-primary mb-0">
                            @(ViewBag.MaxInstructors == 0 ? "غير محدود" : ViewBag.MaxInstructors)
                        </h3>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card shadow-sm border-0 rounded-4 text-center p-3">

                        <div class="fw-bold text-secondary">المتاح للإضافة</div>

                        @if (ViewBag.AvailableSlots == -1)
                        {
                            <h3 class="fw-bold text-info mb-0">غير محدود</h3>
                        }
                        else if (ViewBag.AvailableSlots > 0)
                        {
                            <h3 class="fw-bold text-success mb-0">
                                @ViewBag.AvailableSlots
                            </h3>
                        }
                        else
                        {
                            <h3 class="fw-bold text-danger mb-0">0</h3>
                            <small class="text-danger">
                                تم استهلاك العدد المسموح
                            </small>
                        }

                    </div>
                </div>

            </div>

            <!-- شريط نسبة الاستهلاك -->
            @if (ViewBag.UsagePercentage != -1)
            {
                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-body">

                        <div class="d-flex justify-content-between mb-2">
                            <span class="fw-bold">نسبة استهلاك عدد المدربين</span>
                            <span class="fw-bold">
                                @ViewBag.UsagePercentage%
                            </span>
                        </div>

                        @{
                            string progressClass = "bg-success";

                            if (ViewBag.UsagePercentage >= 90)
                                progressClass = "bg-danger";
                            else if (ViewBag.UsagePercentage >= 70)
                                progressClass = "bg-warning";
                        }

                        <div class="progress rounded-pill" style="height: 18px;">
                            <div class="progress-bar @progressClass fw-bold"
                                 role="progressbar"
                                 style="width:@ViewBag.UsagePercentage%">
                            </div>
                        </div>

                        @if (ViewBag.UsagePercentage >= 100)
                        {
                            <div class="text-danger mt-2 fw-semibold">
                                تم استهلاك الحد الأقصى بالكامل.
                            </div>
                        }
                        else if (ViewBag.UsagePercentage >= 90)
                        {
                            <div class="text-danger mt-2">
                                اقتربت من الحد الأقصى المسموح به.
                            </div>
                        }

                    </div>
                </div>
            }
            <div class="table-responsive">
                <table class="table align-middle mb-0 text-center">

                    <thead class="table-light">
                        <tr>
                            <th class="text-end">الاسم</th>
                            <th>رقم الهوية</th>
                            <th>البريد الإلكتروني</th>
                            <th>رقم الجوال</th>
                            <th>المناهج المسندة</th>
                            <th>الحالة</th>
                            <th width="180">الإجراءات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="py-4 text-muted">
                                    لا يوجد مدربين مسجلين حالياً
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td class="fw-semibold text-end">
                                        @item.FullName
                                    </td>

                                    <td dir="ltr">
                                        @item.NationalID
                                    </td>

                                    <td dir="ltr">
                                        @item.Email
                                    </td>

                                    <td dir="ltr">
                                        @item.PhoneNumber
                                    </td>

                                    <td>
                                        @if (item.Curriculums != null && item.Curriculums.Any())
                                        {
                                            foreach (var c in item.Curriculums)
                                            {
                                                <span class="badge bg-light text-dark border me-1 mb-1">
                                                    @c
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                غير مسند
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success rounded-pill px-3">
                                                نشط
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger rounded-pill px-3">
                                                موقوف
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-center gap-2">

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-warning rounded-circle"
                                               data-bs-toggle="tooltip"
                                               title="تعديل">
                                                <i class="fas fa-pen"></i>
                                            </a>

                                            <a asp-action="Assign"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-info rounded-circle"
                                               data-bs-toggle="tooltip"
                                               title="ربط دفعات">
                                                <i class="fas fa-link"></i>
                                            </a>

                                            <form asp-action="ToggleStatus"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  class="d-inline">
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-secondary rounded-circle"
                                                        data-bs-toggle="tooltip"
                                                        title="تغيير الحالة">
                                                    <i class="fas fa-power-off"></i>
                                                </button>
                                            </form>
                                            <a asp-action="ResetPassword"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-dark rounded-circle"
                                               data-bs-toggle="tooltip"
                                               title="إعادة تعيين كلمة المرور">
                                                <i class="fas fa-key"></i>
                                            </a>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger rounded-circle"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteModal"
                                                    data-id="@item.Id"
                                                    data-name="@item.FullName"
                                                    title="حذف">
                                                <i class="fas fa-trash"></i>
                                            </button>

                                        </div>
                                    </td>

                                </tr>
                            }
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>
</div>


<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle ms-2"></i>
                    تأكيد الحذف
                </h5>
                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center">
                هل أنت متأكد من حذف المدرب:
                <div class="fw-bold mt-2 text-danger"
                     id="instructorName"></div>
            </div>

            <div class="modal-footer justify-content-center">
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteInstructorId" />

                    <button type="submit"
                            class="btn btn-danger px-4 rounded-pill">
                        تأكيد الحذف
                    </button>
                </form>

                <button type="button"
                        class="btn btn-outline-secondary rounded-pill px-4"
                        data-bs-dismiss="modal">
                    إلغاء
                </button>
            </div>

        </div>
    </div>
</div>


@section Scripts {

    <script>
        // تفعيل Tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // إعداد مودال الحذف
        var deleteModal = document.getElementById('deleteModal');

        deleteModal.addEventListener('show.bs.modal', function (event) {

            var button = event.relatedTarget;

            var instructorId = button.getAttribute('data-id');
            var instructorName = button.getAttribute('data-name');

            document.getElementById('deleteInstructorId').value = instructorId;
            document.getElementById('instructorName').textContent = instructorName;

            document.getElementById('deleteForm').action =
                '/Partner/PartnerInstructors/Delete';
        });
    </script>
}