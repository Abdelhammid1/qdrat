@using QdratNew.ViewModels.Partner.Instructor
@model PartnerInstructorEditVm

@{
    ViewData["Title"] = "تعديل مدرب";
}

<div class="container mt-4" dir="rtl">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">
            <i class="fas fa-user-pen text-warning ms-2"></i>
            تعديل بيانات المدرب
        </h4>

        <a asp-action="Index"
           class="btn btn-outline-secondary rounded-pill px-4">
            رجوع
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="Id" />

                <!-- البيانات الأساسية -->
                <h6 class="fw-bold text-secondary mb-3">
                    البيانات الأساسية
                </h6>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">الاسم بالكامل</label>
                        <input asp-for="FullName"
                               class="form-control rounded-3"
                               placeholder="اكتب الاسم بالكامل باللغة العربية" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">البريد الإلكتروني</label>
                        <input asp-for="Email"
                               class="form-control rounded-3 bg-light"
                               readonly
                               dir="ltr" />
                        <small class="text-muted">
                            لا يمكن تعديل البريد الإلكتروني
                        </small>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">رقم الجوال</label>
                        <input asp-for="PhoneNumber"
                               class="form-control rounded-3"
                               dir="ltr"
                               placeholder="05xxxxxxxx" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">التخصص</label>
                        <input asp-for="Specialization"
                               class="form-control rounded-3"
                               placeholder="مثال: قدرات – تحصيلي – رياضيات" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">النوع</label>
                        <select asp-for="Gender"
                                class="form-select rounded-3"
                                asp-items="Html.GetEnumSelectList<QdratNew.Enums.GenderType>()">
                        </select>
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check form-switch mt-4">
                            <input asp-for="IsActive"
                                   class="form-check-input"
                                   type="checkbox" />
                            <label class="form-check-label fw-semibold">
                                تفعيل المدرب
                            </label>
                        </div>
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-success rounded-pill px-4">
                        <i class="fas fa-save ms-1"></i>
                        تحديث البيانات
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}