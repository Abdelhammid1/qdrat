@{
    ViewData["Title"] = "إعادة تعيين كلمة المرور";
}

<div class="container mt-4" dir="rtl">

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body">

            <h4 class="fw-bold mb-4">
                <i class="fas fa-key text-danger ms-2"></i>
                إعادة تعيين كلمة المرور
            </h4>

            <div class="alert alert-warning">
                سيتم تعيين كلمة مرور جديدة للمدرب:
                <strong>@ViewBag.InstructorName</strong>
            </div>

            <form asp-action="ResetPassword" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" name="instructorId" value="@ViewBag.InstructorId" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">كلمة المرور الجديدة</label>
                    <input type="password"
                           name="newPassword"
                           class="form-control"
                           required />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-danger rounded-pill px-4">
                        تعيين كلمة المرور
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary rounded-pill px-4">
                        رجوع
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>