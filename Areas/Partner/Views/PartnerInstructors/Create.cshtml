@using QdratNew.ViewModels.Partner.Instructor
@model PartnerInstructorCreateVm

@{
    ViewData["Title"] = "إضافة مدرب";
}

<div class="container mt-4" dir="rtl">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">
            <i class="fas fa-user-plus text-primary ms-2"></i>
            إضافة مدرب جديد
        </h4>

        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            رجوع
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                <!-- البيانات الأساسية -->
                <h6 class="fw-bold text-secondary mb-3">
                    البيانات الأساسية
                </h6>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">الاسم بالكامل</label>
                        <input asp-for="FullName"
                               class="form-control rounded-3"
                               placeholder="اكتب الاسم بالكامل باللغة العربية" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">رقم الهوية</label>
                        <input asp-for="NationalID"
                               class="form-control rounded-3"
                               placeholder="أدخل رقم الهوية" />
                        <span asp-validation-for="NationalID" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">البريد الإلكتروني</label>
                        <input asp-for="Email"
                               class="form-control rounded-3"
                               placeholder="example@email.com"
                               dir="ltr" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">رقم الجوال</label>
                        <input asp-for="PhoneNumber"
                               class="form-control rounded-3"
                               placeholder="05xxxxxxxx"
                               dir="ltr" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">النوع</label>
                        <select asp-for="Gender"
                                class="form-select rounded-3"
                                asp-items="Html.GetEnumSelectList<QdratNew.Enums.GenderType>()">
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">التخصص</label>
                        <input asp-for="Specialization"
                               class="form-control rounded-3"
                               placeholder="مثال: قدرات – تحصيلي – رياضيات" />
                    </div>

                </div>

                <hr class="my-4" />

                <!-- بيانات الدخول -->
                <h6 class="fw-bold text-secondary mb-3">
                    بيانات الدخول
                </h6>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">كلمة المرور</label>
                        <div class="input-group">
                            <input asp-for="Password"
                                   type="password"
                                   class="form-control rounded-end-3"
                                   id="passwordInput"
                                   placeholder="أدخل كلمة مرور قوية" />
                            <button type="button"
                                    class="btn btn-outline-secondary rounded-start-3"
                                    onclick="togglePassword()">
                                عرض
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-success rounded-pill px-4">
                        حفظ المدرب
                    </button>

                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function togglePassword() {
            var input = document.getElementById("passwordInput");
            input.type = input.type === "password" ? "text" : "password";
        }
    </script>
}