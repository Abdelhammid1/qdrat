@model QdratNew.ViewModels.Partner.PerformanceIndicator.PartnerPerformanceIndexVm

@{
    ViewData["Title"] = "اختبارات مؤشر الأداء";
}

<div class="pp-page">
    <partial name="_PerformanceAlerts" />

    <div class="pp-head">
        <div>
            <h1><i class="fa-solid fa-chart-line" aria-hidden="true"></i> اختبارات مؤشر الأداء</h1>
            <p>اختبارات أرسلها معهد القدرات لطلابك. تابع هنا حالتهم ونتائجهم وتقارير دفعاتهم.</p>
        </div>
    </div>

    <div class="pp-tabs">
        <a asp-action="Index" class="pp-tab @(!Model.ShowHidden ? "is-active" : "")">الاختبارات</a>
        <a asp-action="Index" asp-route-hidden="true" class="pp-tab @(Model.ShowHidden ? "is-active" : "")">المخفية (@Model.HiddenCount)</a>
    </div>

    <div class="pp-card">
        @if (!Model.Exams.Any())
        {
            <div class="pp-empty">
                <i class="fa-solid fa-inbox" aria-hidden="true"></i>
                <h2>@(Model.ShowHidden ? "لا توجد اختبارات مخفية" : "لم يصلك اختبار مؤشر أداء بعد")</h2>
                @if (!Model.ShowHidden)
                {
                    <p class="pp-muted">تظهر هنا الاختبارات التي يرسلها المعهد لدفعاتك.</p>
                }
            </div>
        }
        else
        {
            <div class="pp-table-wrap">
                <table class="pp-table pp-table-cards">
                    <thead>
                        <tr>
                            <th>الاختبار</th>
                            <th>المنهج</th>
                            <th>الدفعات</th>
                            <th>الموعد</th>
                            <th>الأسئلة</th>
                            <th>الطلاب</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var exam in Model.Exams)
                        {
                            <tr data-performance-exam="@exam.Id">
                                <td data-label="الاختبار">
                                    <strong>@exam.Title</strong>
                                    <span class="pp-badge pp-badge-main">من المعهد</span>
                                    @if (!exam.IsOnline)
                                    {
                                        <div class="pp-muted">حضوري · الرمز المرجعي: <span class="pp-code">@exam.ReferenceCode</span></div>
                                    }
                                </td>
                                <td data-label="المنهج">@exam.CurriculumTitle</td>
                                <td data-label="الدفعات">@(exam.BatchNames.Any() ? string.Join("، ", exam.BatchNames) : "—")</td>
                                <td data-label="الموعد">@exam.StartAt.ToString("yyyy/MM/dd HH:mm") — @exam.EndAt.ToString("yyyy/MM/dd HH:mm")</td>
                                <td data-label="الأسئلة">@exam.QuestionsCount</td>
                                <td data-label="الطلاب">@exam.CompletedCount من @exam.StudentsCount أكملوا</td>
                                <td data-label="الإجراءات">
                                    <div class="pp-actions">
                                        <a asp-action="ExamStudents" asp-route-id="@exam.Id" class="pp-btn pp-btn-sm pp-btn-primary">النتائج</a>
                                        @if (Model.CanManage)
                                        {
                                            <form asp-action="@(Model.ShowHidden ? "Restore" : "Hide")" asp-route-id="@exam.Id" method="post">
                                                <button type="submit" class="pp-btn pp-btn-sm pp-btn-light">@(Model.ShowHidden ? "إظهار" : "إخفاء")</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
