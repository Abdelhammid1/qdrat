@model QdratNew.ViewModels.Partner.PerformanceIndicator.PartnerPerformanceBatchReportVm

@{
    ViewData["Title"] = "تقرير الدفعة";
}

<div class="pp-page">
    <partial name="_PerformanceAlerts" />

    <div class="pp-head">
        <div>
            <h1><i class="fa-solid fa-chart-column" aria-hidden="true"></i> تقرير دفعة: @Model.BatchName</h1>
            <p>@Model.ExamTitle · المنهج: @Model.CurriculumTitle · معيار الاجتياز @Model.PassPercent%</p>
        </div>

        <div class="pp-head-actions no-print">
            <button type="button" class="pp-btn pp-btn-light" onclick="window.print()">
                <i class="fa-solid fa-print" aria-hidden="true"></i>
                طباعة
            </button>
            <a asp-action="ExamStudents" asp-route-id="@Model.ExamId" class="pp-btn pp-btn-light">
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                كل طلاب الاختبار
            </a>
        </div>
    </div>

    @if (Model.Batches.Count > 1)
    {
        <div class="pp-tabs no-print">
            @foreach (var batch in Model.Batches)
            {
                <a asp-action="BatchReport" asp-route-examId="@Model.ExamId" asp-route-batchId="@batch.BatchId" class="pp-tab @(batch.BatchId == Model.BatchId ? "is-active" : "")">@batch.Name</a>
            }
        </div>
    }

    <div class="pp-stats">
        <div class="pp-stat"><b>@Model.TotalStudents</b><span>الطلاب</span></div>
        <div class="pp-stat"><b>@Model.CompletedStudents</b><span>أكملوا</span></div>
        <div class="pp-stat"><b>@Model.InProgressStudents</b><span>بدأوا ولم يكملوا</span></div>
        <div class="pp-stat"><b>@Model.NotStartedStudents</b><span>لم يبدأوا</span></div>
        <div class="pp-stat"><b>@Model.PassedStudents</b><span>اجتازوا</span></div>
        <div class="pp-stat"><b>@Model.NeedPlanStudents</b><span>يحتاجون خطة علاجية</span></div>
        <div class="pp-stat"><b>@Model.AverageScore%</b><span>متوسط من أكملوا</span></div>
    </div>

    @if (Model.CompletedStudents == 0)
    {
        <div class="pp-card">
            <div class="pp-empty">
                <i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>
                <h2>لم يكمل أي طالب في هذه الدفعة الاختبار بعد</h2>
            </div>
        </div>
    }
    else
    {
        <div class="pp-card">
            <h2 class="pp-card-title"><i class="fa-solid fa-layer-group" aria-hidden="true"></i> المحاور، من الأضعف للأقوى</h2>
            <div class="pp-table-wrap">
                <table class="pp-table pp-table-cards">
                    <thead>
                        <tr>
                            <th>المحور</th>
                            <th>متوسط الدرجة</th>
                            <th>طلاب تحت معيار الاجتياز</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var stat in Model.Sections)
                        {
                            <tr>
                                <td data-label="المحور">@stat.SectionTitle</td>
                                <td data-label="متوسط الدرجة">@stat.AverageScore%</td>
                                <td data-label="طلاب تحت معيار الاجتياز">@stat.BelowPassCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="pp-card">
        <h2 class="pp-card-title"><i class="fa-solid fa-table-list" aria-hidden="true"></i> الطلاب</h2>

        @if (!Model.Students.Any())
        {
            <div class="pp-empty">
                <i class="fa-solid fa-inbox" aria-hidden="true"></i>
                <h2>لا يوجد طلاب من هذه الدفعة في الاختبار</h2>
            </div>
        }
        else
        {
            <div class="pp-table-wrap">
                <table class="pp-table pp-table-cards">
                    <thead>
                        <tr>
                            <th>الطالب</th>
                            <th>الحالة</th>
                            <th>الدرجة</th>
                            <th>النتيجة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model.Students)
                        {
                            <tr data-performance-student="@student.StudentId">
                                <td data-label="الطالب">@student.StudentName</td>
                                <td data-label="الحالة">@student.StatusText</td>
                                <td data-label="الدرجة">@(student.IsCompleted ? $"{Math.Round(student.ScorePercent ?? 0, 1)}%" : "—")</td>
                                <td data-label="النتيجة">
                                    @if (student.IsCompleted)
                                    {
                                        <span class="pp-badge @(student.Passed ? "pp-badge-ok" : "pp-badge-bad")">@(student.Passed ? "اجتاز" : "يحتاج خطة علاجية")</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
