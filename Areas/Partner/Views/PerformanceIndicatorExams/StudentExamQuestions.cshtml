@model QdratNew.ViewModels.PerformanceIndicator.StudentPerformanceIndicatorQuestionReportViewModel

@{
    ViewData["Title"] = "مراجعة إجابات الطالب";

    Func<string?, bool, string> show = (text, isQuantitative) =>
    {
        var value = text ?? "—";
        return isQuantitative ? NumberHelper.ToIndicNumbersSafe(value) : value;
    };
}

<div class="pp-page">
    <partial name="_PerformanceAlerts" />

    <div class="pp-head">
        <div>
            <h1><i class="fa-solid fa-file-circle-check" aria-hidden="true"></i> مراجعة إجابات: @Model.StudentName</h1>
            <p>@Model.ExamTitle</p>
        </div>

        <div class="pp-head-actions no-print">
            <a asp-action="ExamStudents" asp-route-id="@Model.ExamId" class="pp-btn pp-btn-light">
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                كل الطلاب
            </a>
        </div>
    </div>

    <div class="pp-stats">
        <div class="pp-stat"><b>@Model.ScorePercent%</b><span>الدرجة</span></div>
        <div class="pp-stat"><b>@Model.CorrectCount</b><span>صحيح</span></div>
        <div class="pp-stat"><b>@(Model.WrongCount - Model.SkippedCount)</b><span>خطأ</span></div>
        <div class="pp-stat"><b>@Model.SkippedCount</b><span>متخطى</span></div>
    </div>

    <div class="pp-card">
        @if (!Model.Questions.Any())
        {
            <div class="pp-empty">
                <i class="fa-solid fa-inbox" aria-hidden="true"></i>
                <h2>لا توجد أسئلة في هذا الاختبار</h2>
            </div>
        }
        else
        {
            <div class="pp-table-wrap">
                <table class="pp-table pp-table-cards">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>السؤال</th>
                            <th>المحور</th>
                            <th>المؤشر</th>
                            <th>إجابة الطالب</th>
                            <th>الإجابة الصحيحة</th>
                            <th>الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var question in Model.Questions)
                        {
                            <tr>
                                <td data-label="#">@question.OrderNumber</td>
                                <td data-label="السؤال">@Html.Raw(show(question.QuestionTitle, question.IsQuantitative))</td>
                                <td data-label="المحور">@question.SectionTitle</td>
                                <td data-label="المؤشر">@question.LessonTitle</td>
                                @* APD-S6.2: إجابة الطالب نص حر من الطالب فتُرمَّز (كما في View الأدمن)؛ عنوان السؤال محتوى المعهد ويبقى HTML *@
                                <td data-label="إجابة الطالب">@show(question.StudentAnswer, question.IsQuantitative)</td>
                                <td data-label="الإجابة الصحيحة">@show(question.CorrectAnswer, question.IsQuantitative)</td>
                                <td data-label="الحالة">
                                    <span class="pp-badge @(question.IsSkipped ? "pp-badge-muted" : question.IsCorrect ? "pp-badge-ok" : "pp-badge-bad")">@question.StatusText</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
