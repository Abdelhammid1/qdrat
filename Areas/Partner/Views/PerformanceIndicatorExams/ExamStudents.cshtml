@model QdratNew.ViewModels.Partner.PerformanceIndicator.PartnerPerformanceStudentsVm

@{
    var report = Model.Report;
    ViewData["Title"] = "نتائج اختبار مؤشر الأداء";
}

<div class="pp-page">
    <partial name="_PerformanceAlerts" />

    <div class="pp-head">
        <div>
            <h1><i class="fa-solid fa-user-graduate" aria-hidden="true"></i> @report.ExamTitle</h1>
            <p>
                المنهج: @report.CurriculumTitle · معيار الاجتياز @report.PassPercent%
                @if (!Model.IsOnline)
                {
                    <span> · حضوري، الرمز المرجعي: <span class="pp-code">@Model.ReferenceCode</span></span>
                }
            </p>
        </div>

        <div class="pp-head-actions">
            <a asp-action="Index" class="pp-btn pp-btn-light">
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                كل الاختبارات
            </a>
        </div>
    </div>

    <div class="pp-stats">
        <div class="pp-stat"><b>@report.TotalStudents</b><span>إجمالي الطلاب</span></div>
        <div class="pp-stat"><b>@report.CompletedStudents</b><span>أكملوا</span></div>
        <div class="pp-stat"><b>@Model.PassedCount</b><span>اجتازوا</span></div>
        <div class="pp-stat"><b>@Model.NeedPlanCount</b><span>يحتاجون خطة علاجية</span></div>
        <div class="pp-stat"><b>@Model.CompletedAverage%</b><span>متوسط من أكملوا</span></div>
    </div>

    @if (Model.Batches.Any())
    {
        <div class="pp-card">
            <h2 class="pp-card-title"><i class="fa-solid fa-chart-column" aria-hidden="true"></i> تقارير الدفعات</h2>
            <div class="pp-actions">
                @foreach (var batch in Model.Batches)
                {
                    <a asp-action="BatchReport" asp-route-examId="@report.ExamId" asp-route-batchId="@batch.BatchId" class="pp-btn pp-btn-sm pp-btn-light">@batch.Name</a>
                }
            </div>
        </div>
    }

    <div class="pp-card">
        <h2 class="pp-card-title"><i class="fa-solid fa-table-list" aria-hidden="true"></i> الطلاب</h2>

        @if (!report.Students.Any())
        {
            <div class="pp-empty">
                <i class="fa-solid fa-inbox" aria-hidden="true"></i>
                <h2>لا يوجد طلاب في هذا الاختبار</h2>
            </div>
        }
        else
        {
            <div class="pp-table-wrap">
                <table class="pp-table pp-table-cards">
                    <thead>
                        <tr>
                            <th>الطالب</th>
                            <th>الحالة</th>
                            <th>الدرجة</th>
                            <th>النتيجة</th>
                            <th>محاور ضعيفة</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in report.Students)
                        {
                            <tr data-performance-student="@student.StudentId">
                                <td data-label="الطالب">
                                    @student.StudentName
                                    @if (student.IsIntegrityBlocked)
                                    {
                                        <span class="pp-badge pp-badge-bad">موقوف (ترجمة المتصفح) · تواصل مع المعهد</span>
                                    }
                                </td>
                                <td data-label="الحالة">
                                    <span class="pp-badge @(student.IsCompleted ? "pp-badge-ok" : student.StatusText == "لم يبدأ" ? "pp-badge-muted" : "pp-badge-warn")">@student.StatusText</span>
                                </td>
                                @if (student.IsCompleted)
                                {
                                    <td data-label="الدرجة">@Math.Round(student.ScorePercent ?? 0, 1)%</td>
                                    <td data-label="النتيجة">
                                        <span class="pp-badge @(student.Passed ? "pp-badge-ok" : "pp-badge-bad")">@(student.Passed ? "اجتاز" : "يحتاج خطة علاجية")</span>
                                    </td>
                                    <td data-label="محاور ضعيفة">
                                        @if (student.WeakSections.Any())
                                        {
                                            @foreach (var weakSection in student.WeakSections)
                                            {
                                                <span class="pp-badge pp-badge-warn">@weakSection.SectionTitle: @weakSection.ScorePercent%</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="pp-muted">لا توجد</span>
                                        }
                                    </td>
                                }
                                else
                                {
                                    <td data-label="الدرجة">—</td>
                                    <td data-label="النتيجة">—</td>
                                    <td data-label="محاور ضعيفة">—</td>
                                }
                                <td data-label="الإجراءات">
                                    <div class="pp-actions">
                                        @if (student.IsCompleted)
                                        {
                                            <a asp-action="StudentExamQuestions" asp-route-examId="@report.ExamId" asp-route-studentId="@student.StudentId" class="pp-btn pp-btn-sm pp-btn-primary">مراجعة الإجابات</a>
                                        }
                                        else if (Model.CanManage && student.StartedAt.HasValue)
                                        {
                                            <form asp-action="ResendToStudent" method="post">
                                                <input type="hidden" name="examId" value="@report.ExamId" />
                                                <input type="hidden" name="studentId" value="@student.StudentId" />
                                                <button type="submit" class="pp-btn pp-btn-sm pp-btn-light">إعادة فتح بوقت كامل</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="pp-muted">—</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (Model.NotAssigned.Any())
    {
        <div class="pp-card">
            <h2 class="pp-card-title"><i class="fa-solid fa-user-plus" aria-hidden="true"></i> طلاب في الدفعات لم يصلهم الاختبار</h2>
            <p class="pp-card-sub">طلاب نشطون التحقوا بعد الإرسال أو لم يكونوا نشطين وقتها.</p>
            <div class="pp-table-wrap">
                <table class="pp-table">
                    <tbody>
                        @foreach (var student in Model.NotAssigned)
                        {
                            <tr data-performance-not-assigned="@student.StudentId">
                                <td>@student.FullName</td>
                                <td>
                                    @if (Model.CanManage)
                                    {
                                        <form asp-action="ResendToStudent" method="post">
                                            <input type="hidden" name="examId" value="@report.ExamId" />
                                            <input type="hidden" name="studentId" value="@student.StudentId" />
                                            <button type="submit" class="pp-btn pp-btn-sm pp-btn-primary">إرسال</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="pp-muted">يتطلب عقدًا نشطًا</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
