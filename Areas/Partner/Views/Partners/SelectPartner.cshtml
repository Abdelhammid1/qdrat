@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "اختيار المدرسة";
}

<div class="container mt-5" dir="rtl" style="max-width:800px">
    <h4 class="fw-bold mb-4 text-center">اختر المدرسة</h4>

    <div class="row g-3">
        @foreach (var p in Model)
        {
            <div class="col-md-4">
                <div class="card shadow-sm h-100 text-center">
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(p.LogoPath))
                        {
                            <img src="@p.LogoPath" style="height:60px" class="mb-2" />
                        }

                        <h6 class="fw-bold">@p.Name</h6>

                        <form method="post"
                              asp-action="ActivatePartner"
                              asp-controller="Partners"
                              asp-area="Partner">
                            <input type="hidden" name="partnerId" value="@p.Id" />
                            <button class="btn btn-success btn-sm mt-2">
                                دخول
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
