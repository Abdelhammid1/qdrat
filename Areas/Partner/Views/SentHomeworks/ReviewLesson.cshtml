@model QdratNew.ViewModels.Homework.HomeworkReviewViewModel
@using QdratNew.Helpers

<div class="container py-4">

    <!-- KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6>إجمالي الأسئلة</h6>
                    <h3>@NumberHelper.ToIndicNumbersSafe(Model.TotalQuestions.ToString())</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card text-center shadow-sm">
                <div class="card-body text-success">
                    <h6>إجابات صحيحة</h6>
                    <h3>@NumberHelper.ToIndicNumbersSafe(Model.CorrectAnswers.ToString())</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card text-center shadow-sm">
                <div class="card-body text-danger">
                    <h6>إجابات خاطئة</h6>
                    <h3>@NumberHelper.ToIndicNumbersSafe(Model.WrongAnswers.ToString())</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6>الوقت المستغرق</h6>
                    <h3>@Model.TimeSpentFormatted</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Questions -->
    <div class="row g-3">
        @foreach (var q in Model.Questions)
        {
            Func<string, string> convert = s => q.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(s) : s;

            <div class="col-md-6">
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-qdrat text-white fw-bold">
                        @Html.Raw(convert(q.QuestionText))
                    </div>
                    <div class="card-body">
                        <!-- باقي الكود كما أرسلته أنت بدون أي تعديل -->
                    </div>
                </div>
            </div>
        }
    </div>
</div>
