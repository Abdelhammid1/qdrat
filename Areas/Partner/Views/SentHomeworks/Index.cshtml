@model List<QdratNew.ViewModels.Partner.Homework.SentHomeworkListVM>

<h2 class="fw-bold mb-4">الواجبات المُرسلة</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success fw-bold">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger fw-bold">
        @TempData["Error"]
    </div>
}

<div class="table-responsive">
<table class="table table-bordered text-center align-middle">
    <thead class="table-light">
        <tr>
            <th>الواجب</th>
            <th>الدورة</th>
            <th>الدُفعة</th>
            <th>الطلاب</th>
            <th>تم الحل</th>
            <th>لم يُحل</th>
            <th style="width:220px;">إجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var h in Model)
        {
            <tr>
                <td>
                    @h.Title
                    @if (h.IsFromModel)
                    {
                        <div>
                            <span class="badge bg-light text-dark border fw-normal">
                                <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
                                من نموذج: @h.SourceModelTitle
                            </span>
                        </div>
                    }
                    @if (h.IsFromInstitute)
                    {
                        <div><span class="badge bg-info text-dark fw-normal" data-apd-from-institute>مرسل من المعهد</span></div>
                    }
                </td>
                <td>@h.CourseName</td>
                <td>@h.BatchName</td>
                <td>@h.TotalStudents</td>
                <td class="text-success">@h.SubmittedStudents</td>
                <td class="text-danger">@h.PendingStudents</td>
                <td>
                    <div class="d-flex justify-content-center gap-2">

                        <a asp-action="Details"
                           asp-route-id="@h.HomeworkSetId"
                           class="btn btn-sm btn-primary">
                            الطلاب
                        </a>

                        @if (h.CanEdit)
                        {
                            <a asp-action="EditSent"
                               asp-route-id="@h.HomeworkSetId"
                               class="btn btn-sm btn-outline-secondary">
                                تعديل
                            </a>
                        }

                        <form asp-action="DeleteSentHomework"
                              method="post"
                              style="display:inline-block;"
                              onsubmit="return confirm('هل أنت متأكد من حذف هذا الواجب بالكامل؟ سيتم حذف جميع محاولات الطلاب.');">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="homeworkSetId"
                                   value="@h.HomeworkSetId" />

                            <button type="submit"
                                    class="btn btn-sm btn-danger">
                                <i class="fa-solid fa-trash"></i>
                                حذف
                            </button>
                        </form>

                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>