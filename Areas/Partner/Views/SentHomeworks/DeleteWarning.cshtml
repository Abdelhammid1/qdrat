@model QdratNew.ViewModels.Homework.DeleteHomeworkWarningVm

@{
    ViewData["Title"] = "تحذير حذف الواجب";
}

<div class="card shadow border-0 mt-4">
    <div class="card-body text-center">

        <h4 class="text-danger fw-bold mb-3">
            ⚠ يوجد نشاط طلابي على هذا الواجب
        </h4>

        <p>
            عدد الطلاب الذين فتحوا أو بدأوا الحل:
            <strong>@Model.StudentsStarted</strong>
        </p>

        <p>
            عدد الطلاب الذين قاموا بالتسليم:
            <strong>@Model.StudentsSubmitted</strong>
        </p>

        <hr />

        <p class="text-danger fw-bold">
            في حال تأكيد الحذف سيتم حذف جميع:
            <br />
            - إجابات الطلاب
            <br />
            - محاولات الحل
            <br />
            - نتائج الواجب
        </p>

        <div class="d-flex justify-content-center gap-3 mt-4">

            <form asp-action="DeleteSentHomework" method="post">
                <input type="hidden" name="homeworkSetId" value="@Model.HomeworkSetId" />
                <input type="hidden" name="forceDelete" value="true" />
                <button type="submit" class="btn btn-danger">
                    حذف جميع البيانات نهائيًا
                </button>
            </form>

            <a asp-action="Index" class="btn btn-secondary">
                تراجع
            </a>

        </div>
    </div>
</div>