@model List<QdratNew.ViewModels.Partner.Homework.SentHomeworkStudentVM>

@{
    ViewData["Title"] = "طلاب الواجب";
}

<h3 class="mb-4 fw-bold">طلاب الواجب</h3>

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle text-center">
        <thead class="table-light">
            <tr>
                <th>الطالب</th>
                <th>الحالة</th>
                <th>تاريخ التسليم</th>
                <th>إجراء إداري</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-muted">
                        لا يوجد طلاب مرتبطون بهذا الواجب.
                    </td>
                </tr>
            }
            else
            {
                foreach (var s in Model)
                {
                    <tr>
                        <!-- اسم الطالب -->
                        <td class="fw-semibold">
                            @s.StudentName
                        </td>

                        <!-- الحالة -->
                        <td>
                            @if (s.IsSubmitted)
                            {
                                <span class="badge bg-success">
                                    تم الحل
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    لم يُحل
                                </span>
                            }
                        </td>

                        <!-- تاريخ التسليم -->
                        <td>
                            @(s.SubmittedAt?.ToString("yyyy/MM/dd") ?? "—")
                        </td>

                        <!-- إجراء إداري -->
                        <td>
                            @if (s.IsSubmitted)
                            {
                                <a asp-area="Partner"
                                   asp-controller="SentHomeworks"
                                   asp-action="HomeworkReportUnified"
                                   asp-route-homeworkSetId="@ViewBag.HomeworkSetId"
                                   asp-route-studentId="@s.StudentId"
                                   class="btn btn-sm btn-outline-primary">
                                    تقرير الواجب
                                </a>




                                <form asp-action="ResetHomework"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="homeworkSetId"
                                           value="@ViewBag.HomeworkSetId" />

                                    <input type="hidden"
                                           name="studentId"
                                           value="@s.StudentId" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-warning"
                                            onclick="return confirm('هل تريد السماح للطالب بإعادة حل الواجب مرة أخرى؟');">
                                        🔁 إعادة الحل
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">
                                    —
                                </span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
