@model QdratNew.ViewModels.Exam.ExamReviewViewModel
@using QdratNew.Helpers

@{
    ViewData["Title"] = "📘 مراجعة اختبار مؤشر الأداء";

    int total = Model.TotalQuestions;
    int correct = Model.CorrectAnswers;
    int wrong = Model.WrongAnswers;
    int skipped = Model.SkippedQuestions;
    double percent = Model.ScorePercentage;

    double correctPercent = total > 0 ? Math.Round(correct * 100.0 / total, 1) : 0;
    double wrongPercent = total > 0 ? Math.Round(wrong * 100.0 / total, 1) : 0;
    double skippedPercent = total > 0 ? Math.Round(skipped * 100.0 / total, 1) : 0;

    string ToIndic(string? value)
    {
        return NumberHelper.ToIndicNumbersSafe(value ?? string.Empty);
    }

    string FormatSeconds(double seconds)
    {
        if (seconds <= 0)
        {
            return "—";
        }

        var minutes = (int)(seconds / 60);
        var remainSeconds = (int)(seconds % 60);

        if (minutes > 0 && remainSeconds > 0)
        {
            return $"{ToIndic(minutes.ToString())} دقيقة {ToIndic(remainSeconds.ToString())} ثانية";
        }

        if (minutes > 0)
        {
            return $"{ToIndic(minutes.ToString())} دقيقة";
        }

        return $"{ToIndic(remainSeconds.ToString())} ثانية";
    }
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<style>
    :root {
        --q-primary: #4f46e5;
        --q-primary-lt: #ede9fe;
        --q-success: #16a34a;
        --q-success-lt: #dcfce7;
