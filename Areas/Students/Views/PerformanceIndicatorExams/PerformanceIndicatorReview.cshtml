<div class="qlb-page">
    <div class="qlb-shell">

        <div class="qlb-hero">
            <div class="qlb-hero-content">
                <div class="qlb-hero-icon">
                    <i class="fa-solid fa-chart-line"></i>
                </div>

                <h1>مراجعة اختبار مؤشر الأداء</h1>

                <p class="qlb-hero-subtitle">
                    @Model.ExamTitle
                </p>

                <div class="qlb-hero-meta">
                    <span class="qlb-hero-pill">
                        <i class="fas fa-chart-pie"></i>
                        النسبة النهائية: @ToIndic(percent.ToString())%
                    </span>

                    <span class="qlb-hero-pill">
                        <i class="fas fa-question-circle"></i>
                        عدد الأسئلة: @ToIndic(total.ToString())
                    </span>

                    <span class="qlb-hero-pill">
                        <i class="fas fa-forward"></i>
                        المتخطاة: @ToIndic(skipped.ToString())
                    </span>
                </div>
            </div>
        </div>

        <div class="qlb-stats">
            <div class="qlb-stat">
                <div class="qlb-stat-ico ico-blue">
                    <i class="fas fa-list-ol"></i>
                </div>
                <div class="qlb-stat-content">
                    <div class="qlb-stat-lbl">إجمالي الأسئلة</div>
                    <div class="qlb-stat-val">@ToIndic(total.ToString())</div>
                </div>
            </div>

            <div class="qlb-stat">
                <div class="qlb-stat-ico ico-green">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="qlb-stat-content">
                    <div class="qlb-stat-lbl">إجابات صحيحة</div>
                    <div class="qlb-stat-val" style="color:var(--q-success)">@ToIndic(correct.ToString())</div>
                    <div class="qlb-stat-bar">
                        <div class="qlb-stat-fill fill-g" style="width:@correctPercent%"></div>
                    </div>
                </div>
            </div>

            <div class="qlb-stat">
                <div class="qlb-stat-ico ico-red">
                    <i class="fas fa-times-circle"></i>
                </div>
                <div class="qlb-stat-content">
                    <div class="qlb-stat-lbl">إجابات خاطئة</div>
                    <div class="qlb-stat-val" style="color:var(--q-danger)">@ToIndic(wrong.ToString())</div>
                    <div class="qlb-stat-bar">
                        <div class="qlb-stat-fill fill-r" style="width:@wrongPercent%"></div>
                    </div>
                </div>
            </div>

            <div class="qlb-stat">
                <div class="qlb-stat-ico ico-amber">
                    <i class="fas fa-forward"></i>
                </div>
                <div class="qlb-stat-content">
                    <div class="qlb-stat-lbl">الأسئلة المتخطاة</div>
                    <div class="qlb-stat-val" style="color:var(--q-warning)">@ToIndic(skipped.ToString())</div>
                    <div class="qlb-stat-bar">
                        <div class="qlb-stat-fill fill-a" style="width:@skippedPercent%"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="qlb-result-panel">
            <div class="qlb-result-title">
                <span>
                    <i class="fas fa-chart-pie"></i>
                    النتيجة النهائية
                </span>

                <span class="qlb-result-percent">
                    @ToIndic(percent.ToString())%
                </span>
            </div>

            <div class="qlb-big-progress">
                <div class="qlb-big-progress-fill" style="width:@Math.Min(percent, 100)%"></div>
            </div>
        </div>

        <div class="qlb-section-head">
            <h2 class="qlb-section-title">
                <i class="fas fa-table-list"></i>
                أسئلة اختبار مؤشر الأداء
            </h2>

            <span class="qlb-section-count">
                <i class="fas fa-question-circle"></i>
                @ToIndic(total.ToString()) سؤال
            </span>
        </div>

        @if (Model.Questions != null && Model.Questions.Any())
        {
            <div class="qlb-grid">
                @foreach (var item in Model.Questions.Select((q, i) => new { q, i }))
                {
                    var q = item.q;
                    var index = item.i + 1;

                    Func<string?, string> convert = s =>
                    {
                        var value = s ?? string.Empty;
                        return q.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(value) : value;
                    };

                    var studentAnswer = q.StudentAnswer ?? string.Empty;
                    var correctAnswer = q.CorrectAnswer ?? string.Empty;

                    var isSkipped = string.IsNullOrWhiteSpace(studentAnswer);
                    var resultClass = isSkipped ? "result-skipped" : q.IsCorrect ? "result-correct" : "result-wrong";
                    var resultIcon = isSkipped ? "fa-forward" : q.IsCorrect ? "fa-check-circle" : "fa-times-circle";
                    var resultText = isSkipped ? "متخطى" : q.IsCorrect ? "صحيح" : "خطأ";

                    <div class="qlb-card">
                        <div class="qlb-card-head">
                            <div class="qlb-qnum">
                                @ToIndic(index.ToString())
                            </div>

                            <span class="qlb-result-badge @resultClass">
                                <i class="fas @resultIcon"></i>
                                @resultText
                            </span>

                            <span class="qlb-time-chip">
                                <i class="fas fa-clock"></i>
                                الوقت: @FormatSeconds(q.TimeTakenSeconds)
                            </span>
                        </div>

                        <div class="qlb-card-body">
                            <div class="qlb-qtitle">
                                <strong>
                                    @Html.Raw(convert(q.QuestionTitle))
                                </strong>
                            </div>

                            @if (q.Options != null && q.Options.Count > 0)
                            {
                                <div class="qlb-options">
                                    @foreach (var optItem in q.Options.Select((opt, optIndex) => new { opt, optIndex }))
                                    {
                                        var opt = optItem.opt;
                                        var optIndex = optItem.optIndex;
                                        var optText = opt.Text ?? string.Empty;

                                        var isSelected = optText.Trim() == studentAnswer.Trim();
                                        var isCorrect = optText.Trim() == correctAnswer.Trim();

                                        var optCls = isCorrect ? "opt-correct"
                                        : isSelected ? "opt-wrong"
                                        : "opt-normal";

                                        var optIcon = isCorrect ? "fa-check-circle"
                                        : isSelected ? "fa-times-circle"
                                        : "fa-circle";

                                        var optionLabel = ((char)('أ' + optIndex)).ToString();

                                        <div class="qlb-opt @optCls">
                                            <div class="qlb-opt-label">@optionLabel</div>

                                            <div class="qlb-opt-content">
                                                @if (!string.IsNullOrWhiteSpace(opt.ImageUrl))
                                                {
                                                    <img src="@Url.Content(opt.ImageUrl)"
                                                         alt="صورة الاختيار"
                                                         class="qlb-opt-img"
                                                         loading="lazy" />
                                                }

                                                @if (!string.IsNullOrWhiteSpace(optText))
                                                {
                                                    <div class="qlb-opt-text">
                                                        @Html.Raw(convert(optText))
                                                    </div>
                                                }

                                                <div class="qlb-opt-tags">
                                                    @if (isSelected)
                                                    {
                                                        <span class="qlb-mini-badge badge-student">
                                                            <i class="fas fa-user-check"></i>
                                                            إجابتك
                                                        </span>
                                                    }

                                                    @if (isCorrect)
                                                    {
                                                        <span class="qlb-mini-badge badge-correct">
                                                            <i class="fas fa-check"></i>
                                                            الإجابة الصحيحة
                                                        </span>
                                                    }
                                                </div>
                                            </div>

                                            <i class="fas @optIcon qlb-opt-icon"></i>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="qlb-empty">
                                    <i class="fas fa-info-circle"></i>
                                    لا توجد اختيارات لهذا السؤال.
                                </div>
                            }

                            <div class="qlb-result-box @(isSkipped ? "is-skipped" : q.IsCorrect ? "is-correct" : "is-wrong")">
                                <div class="qlb-result-box-title">
                                    <i class="fas @(isSkipped ? "fa-forward" : q.IsCorrect ? "fa-check-circle" : "fa-times-circle")"></i>
                                    النتيجة
                                </div>

                                <div class="qlb-result-value @(isSkipped ? "text-skip" : q.IsCorrect ? "text-ok" : "text-bad")">
                                    @if (isSkipped)
                                    {
                                        <span>⏭️ متخطى</span>
                                    }
                                    else if (q.IsCorrect)
                                    {
                                        <span>✔️ صحيح</span>
                                    }
                                    else
                                    {
                                        <span>❌ خطأ</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="qlb-card-foot">
                            <span class="qlb-foot-chip fc-primary">
                                <i class="fas fa-hash"></i>
                                سؤال @ToIndic(index.ToString())
                            </span>

                            @if (isSkipped)
                            {
                                <span class="qlb-foot-chip fc-skip">
                                    <i class="fas fa-forward"></i>
                                    متخطى
                                </span>
                            }
                            else if (q.IsCorrect)
                            {
                                <span class="qlb-foot-chip fc-success">
                                    <i class="fas fa-check"></i>
                                    صحيح
                                </span>
                            }
                            else
                            {
                                <span class="qlb-foot-chip fc-danger">
                                    <i class="fas fa-times"></i>
                                    خطأ
                                </span>
                            }

                            <span class="qlb-foot-chip fc-time">
                                <i class="fas fa-stopwatch"></i>
                                @FormatSeconds(q.TimeTakenSeconds)
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="qlb-empty">
                <i class="fas fa-info-circle"></i>
                لا توجد أسئلة لعرضها.
            </div>
        }

    </div>
</div>
