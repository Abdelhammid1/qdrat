@model QdratNew.ViewModels.PerformanceIndicator.PerformanceIndicatorResultVm

@{
    ViewData["Title"] = "نتيجة اختبار مؤشر الأداء";

    double score = Model.TotalAverage;
    var tone = ResultToneHelper.Build(score, ResultContext.PerformanceIndicator);
    string performanceMessage = tone.Title + " — " + tone.Subtitle;
    string performanceIcon = tone.IconCss;
}

<div class="container py-5">
    <div class="card border-0 shadow-lg p-4 rounded-4 bg-light">

        <!-- 🟦 العنوان -->
        <div class="text-center mb-5">
            <h2 class="fw-bold text-primary mb-2">
                <i class="bi bi-activity"></i> نتيجة اختبار مؤشر الأداء
            </h2>
            <h5 class="text-secondary">تحليل أدائك حسب المحاور الدراسية</h5>
        </div>

        <!-- 🔹 كروت الإحصاءات العامة -->
        <div class="row text-center mb-5">
            <div class="col-md-3 col-6 mb-3">
                <div class="stat-card bg-white shadow-sm p-3 rounded-4">
                    <h6 class="text-muted">عدد الأسئلة</h6>
                    <h3 class="fw-bold text-primary">@Model.TotalQuestions</h3>
                </div>
            </div>
            <div class="col-md-3 col-6 mb-3">
                <div class="stat-card bg-white shadow-sm p-3 rounded-4">
                    <h6 class="text-muted">الإجابات الصحيحة</h6>
                    <h3 class="fw-bold text-success">@Model.CorrectAnswers</h3>
                </div>
            </div>
            <div class="col-md-3 col-6 mb-3">
                <div class="stat-card bg-white shadow-sm p-3 rounded-4">
                    <h6 class="text-muted">الإجابات الخاطئة</h6>
                    <h3 class="fw-bold text-danger">@Model.WrongAnswers</h3>
                </div>
            </div>
            <div class="col-md-3 col-6 mb-3">
                <div class="stat-card bg-white shadow-sm p-3 rounded-4">
                    <h6 class="text-muted">الأسئلة المتخطاة</h6>
                    <h3 class="fw-bold text-warning">@Model.SkippedQuestions</h3>
                </div>
            </div>
        </div>

        <!-- 📊 كارت النتيجة العامة -->
        <div class="text-center mb-4">
            <h5 class="fw-bold mb-3">المتوسط العام</h5>
            <div class="progress mx-auto" style="height: 35px; max-width: 400px;">
                <div class="progress-bar text-white fw-bold"
                     role="progressbar"
                     style="width:@Model.TotalAverage%; background: linear-gradient(90deg, #007bff, #00bcd4);"
                     aria-valuenow="@Model.TotalAverage" aria-valuemin="0" aria-valuemax="100">
                    @Model.TotalAverage.ToString("0.0") %
                </div>
            </div>
        </div>

        <!-- 🧠 الرسالة الذكية -->
        <div class="alert alert-light shadow-sm border-start border-4 border-primary rounded-4 py-3 px-4 text-center mb-5">
            <i class="bi @performanceIcon fs-3 me-2"></i>
            <span class="fw-bold">@performanceMessage</span>
        </div>

        <!-- 🧩 تفاصيل المحاور -->
        <div class="table-responsive">
            <table class="table table-bordered table-hover text-center align-middle bg-white rounded-4 overflow-hidden">
                <thead class="table-primary text-dark">
                    <tr>
                        <th>📘 اسم المحور</th>
                        <th>🎯 نسبة الأداء</th>
                        <th>⏱ متوسط الزمن لكل سؤال (ث)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Sections)
                    {
                        var color = s.ScorePercent >= 90 ? "table-success"
                        : s.ScorePercent >= 75 ? "table-info"
                        : s.ScorePercent >= 60 ? "table-warning"
                        : "table-danger";

                        <tr class="@color">
                            <td class="fw-bold">@s.SectionName</td>
                            <td>@s.ScorePercent.ToString("0.0")%</td>
                            <td>@s.AverageTime.ToString("0.0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- 🔸 المحاور الضعيفة -->
        @if (Model.HasWeakSections)
        {
            <div class="alert alert-warning mt-4 border-3 border-start border-danger rounded-4 shadow-sm p-4">
                <h5 class="fw-bold text-primary mb-3">
                    <i class="bi bi-bullseye me-2"></i>
                    محاور الأولوية — الأعلى أثراً في تقدّمك
                </h5>
                <p class="text-muted mb-2">
                    هذه المحاور ستصنع أكبر فرق في نتيجتك القادمة. سيحدّد لك المدرب أو الإدارة جلسات دعم لها للحضور في مقر المعهد.
                </p>
                <ul class="list-group list-group-flush">
                    @foreach (var w in Model.WeakSections)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>📘 @w.SectionName</span>
                            <span class="badge bg-danger rounded-pill">@w.ScorePercent.ToString("0.0")%</span>
                        </li>
                    }
                </ul>
            </div>
        }

        <!-- 🔹 زر العودة -->
        <div class="text-center mt-4 d-flex justify-content-center gap-3 flex-wrap">

            <!-- زر عرض مراجعة الأسئلة -->
            <a asp-area="Students"
               asp-controller="PerformanceIndicatorExams"
               asp-action="Review"
               asp-route-examId="@Model.ExamId"
               class="btn btn-outline-success btn-lg rounded-pill shadow-sm px-5">
                <i class="fa-solid fa-list-check me-2"></i> عرض تفاصيل الأسئلة
            </a>

            <!-- زر العودة إلى لوحة المؤشرات -->
            <a asp-area="Students"
               asp-controller="PerformanceIndicatorExams"
               asp-action="Dashboard"
               class="btn btn-outline-primary btn-lg rounded-pill shadow-sm px-5">
                <i class="fa-solid fa-arrow-left me-2"></i> العودة إلى لوحة مؤشر الأداء
            </a>

        </div>

    </div>
</div>

<!-- 🎨 CSS -->
<style>
    .table th, .table td {
        vertical-align: middle;
        font-size: 1rem;
    }

    .table thead th {
        font-weight: 700;
        font-size: 1.05rem;
    }

    .progress {
        border-radius: 20px;
        overflow: hidden;
        background-color: #e9ecef;
    }

    .progress-bar {
        transition: width 1s ease-in-out;
        font-size: 1.1rem;
    }

    .alert-light {
        background-color: #f8f9fa;
    }

    .stat-card {
        border-radius: 1rem;
        transition: transform 0.2s ease;
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

    @@media (max-width: 768px) {
        .table th, .table td {
            font-size: 0.9rem;
        }
    }
</style>
