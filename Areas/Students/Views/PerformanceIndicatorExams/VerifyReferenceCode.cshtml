@model int
@{
    ViewData["Title"] = "التحقق من الكود المرجعي";
}

<div class="container py-5 text-center">
    <div class="card shadow-lg border-0 rounded-4 p-4 mx-auto" style="max-width:500px;">
        <h3 class="fw-bold text-primary mb-4">🎯 بدء اختبار مؤشر الأداء</h3>
        <p class="text-muted mb-3">
            الرجاء إدخال الكود المرجعي الذي حصلت عليه من المشرف في المعمل لبدء الاختبار.
        </p>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger text-center fw-bold">@TempData["Error"]</div>
        }

        <form asp-action="VerifyReferenceCode" method="post">
            <input type="hidden" name="id" value="@Model" />
            <div class="mb-3">
                <input type="text" name="referenceCode" class="form-control form-control-lg text-center" placeholder="أدخل الكود المرجعي" required />
            </div>
            <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold">
                تأكيد والدخول للاختبار
            </button>
        </form>
    </div>
</div>
