@model QdratNew.ViewModels.EnhancementSkills.EnhancementSkillSessionResultViewModel
@{
    ViewData["Title"] = "نتيجة المهارات التعزيزية";
}
<div class="container mt-5" dir="rtl">
    <div class="text-center mb-4">
        <h2 class="text-success"><i class="fas fa-check-circle"></i> النتيجة النهائية</h2>
        <p class="text-muted">تم تسجيل إجاباتك بنجاح. إليك ملخص الأداء:</p>
    </div>

    <div class="mb-4">
        <div class="progress">
            <div class="progress-bar bg-success" role="progressbar"
                 style="width: @(Model.CorrectAnswers * 100 / Model.TotalQuestions)%"
                 aria-valuenow="@Model.CorrectAnswers"
                 aria-valuemin="0"
                 aria-valuemax="@Model.TotalQuestions">
                @(Model.CorrectAnswers * 100 / Model.TotalQuestions)% النجاح
            </div>
        </div>
    </div>

    <div class="row text-center mb-4">
        <div class="col-md-4">
            <div class="alert alert-primary">
                <h4>@Model.TotalQuestions</h4>
                <p>إجمالي الأسئلة</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="alert alert-success">
                <h4>@Model.CorrectAnswers</h4>
                <p>إجابات صحيحة</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="alert alert-danger">
                <h4>@(Model.TotalQuestions - Model.CorrectAnswers)</h4>
                <p>إجابات خاطئة</p>
            </div>
        </div>
    </div>

    <div class="text-center mt-5">
        <a href="@Url.Action("Index", "EnhancementSkills")" class="btn btn-outline-primary btn-lg">
            <i class="fas fa-arrow-circle-right"></i> العودة إلى المهارات
        </a>
    </div>
</div>
