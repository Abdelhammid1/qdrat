@model List<QdratNew.ViewModels.Question.QuestionDisplayViewModel>
@using QdratNew.Helpers
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "مهارات تعزيزية";
}

<div class="container mt-4" dir="rtl">
    <h2 class="text-center text-primary mb-4">
        ✍️ حل مهارات تعزيزية
    </h2>

    <div id="questionContainer" class="mb-4"></div>

    <div class="text-center mb-4">
        <button id="prevBtn" class="btn btn-secondary me-2" onclick="prevQuestion()">السابق</button>
        <button id="nextBtn" class="btn btn-primary me-2" onclick="nextQuestion()">التالي</button>
        <button id="reviewBtn" class="btn btn-outline-warning me-2 d-none" onclick="showReview()">مراجعة</button>
    </div>

    <div id="reviewSection" class="mt-5 d-none">
        <h5 class="text-primary text-center">🔎 راجع إجاباتك قبل الإرسال:</h5>
        <div class="d-flex flex-wrap justify-content-center mt-3 mb-3" id="reviewButtonsContainer"></div>
        <div class="text-center mt-3">
            <button id="submitBtn" class="btn btn-success btn-lg" onclick="submitAnswers()">
                <i class="fas fa-paper-plane"></i> إرسال الإجابات النهائية
            </button>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        let questions = @Html.Raw(Json.Serialize(HttpContextAccessor.HttpContext.Session.GetObject<List<QdratNew.ViewModels.Question.QuestionDisplayViewModel>>("EnhancementSessionQuestions")));
        let current = 0;
        let startTime = null;

        function renderQuestion() {
            const container = document.getElementById("questionContainer");
            const question = questions[current];
            startTime = new Date();

            fetch('/Students/EnhancementSkills/RenderQuestion', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(question)
            })
            .then(res => res.text())
            .then(html => {
                container.innerHTML = html;
                updateNavigation();

                // ✅ استرجاع الإجابة السابقة
                const selectedAnswer = questions[current].SelectedAnswer;
                if (selectedAnswer) {
                    const radio = document.querySelector(`input[name='SelectedOption'][value='${selectedAnswer}']`);
                    if (radio) radio.checked = true;
                }
            });
        }

        function saveAnswer() {
            const selected = document.querySelector("input[name='SelectedOption']:checked");
            const endTime = new Date();
            const timeSpent = startTime ? Math.floor((endTime - startTime) / 1000) : null;

            questions[current].SelectedAnswer = selected ? selected.value : null;
            questions[current].AnsweredAt = endTime.toISOString();
            questions[current].TimeSpentSeconds = timeSpent;
        }

        function nextQuestion() {
            saveAnswer();
            if (current < questions.length - 1) {
                current++;
                renderQuestion();
            }
            if (current === questions.length - 1) {
                document.getElementById("reviewBtn").classList.remove("d-none");
            }
        }

        function prevQuestion() {
            saveAnswer();
            if (current > 0) {
                current--;
                renderQuestion();
            }
        }

        function updateNavigation() {
            document.getElementById("prevBtn").disabled = current === 0;
            document.getElementById("nextBtn").disabled = current === questions.length - 1;
        }

        function goToQuestion(index) {
            saveAnswer();
            current = index;
            renderQuestion();
        }

        function showReview() {
            saveAnswer();
            const reviewContainer = document.getElementById("reviewButtonsContainer");
            reviewContainer.innerHTML = "";

            for (let i = 0; i < questions.length; i++) {
                const btn = document.createElement("button");
                btn.className = "btn m-1 " + (questions[i].SelectedAnswer ? "btn-success" : "btn-outline-dark");
                btn.innerText = i + 1;
                btn.onclick = () => goToQuestion(i);
                reviewContainer.appendChild(btn);
            }
            document.getElementById("reviewSection").classList.remove("d-none");
        }

        function submitAnswers() {
            saveAnswer();
            fetch('/Students/EnhancementSkills/SubmitAnswers', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(questions)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    window.location.href = `/Students/EnhancementSkills/Result`;
                } else {
                    alert("❌ حدث خطأ في الإرسال.");
                }
            });
        }

        document.addEventListener("DOMContentLoaded", renderQuestion);
    </script>
}
