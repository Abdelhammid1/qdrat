@model List<QdratNew.ViewModels.EnhancementSkills.EnhancementSkillBatchViewModel>

@foreach (var batch in Model)
{
    <div class="card mb-3 shadow-sm">
        <div class="card-body">
            <h5 class="card-title text-primary">📚 @batch.BatchName</h5>
            <p class="card-text">
                👨‍🏫 المدرّب: <strong>@batch.InstructorName</strong><br />
                📕 القسم: <strong>@batch.CurriculumTitle</strong><br />
                🔢 عدد الأسئلة: <strong>@batch.TotalQuestions</strong>
            </p>

            <button class="btn btn-outline-info btn-sm" data-bs-toggle="modal" data-bs-target="#modal_@batch.BatchId">
                عرض المؤشرات
            </button>

            <a href="@Url.Action("StartSession", "EnhancementSkills", new { area = "Students", batchId = batch.BatchId })" class="btn btn-primary btn-sm">
                🚀 ابدأ الآن
            </a>
        </div>
    </div>

    <div class="modal fade" id="modal_@batch.BatchId" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">المؤشرات المرتبطة بـ @batch.BatchName</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <ul class="list-group">
                        @foreach (var lesson in batch.Lessons)
                        {
                            <li class="list-group-item">@lesson</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
}
