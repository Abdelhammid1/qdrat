@model QdratNew.ViewModels.Question.QuestionDisplayViewModel
@{
    ViewData["Title"] = "بدء مهارة معززة";
}
<h3 class="text-primary">🚀 تدريبك الحالي</h3>

<div id="question-container">
    @await Html.PartialAsync("_QuestionPreviewPartial", Model)
</div>

<div class="mt-3">
    <button id="submit-btn" class="btn btn-success">إرسال</button>
</div>

@section Scripts {
    <script>
        document.getElementById("submit-btn").addEventListener("click", async function () {
            const selected = document.querySelector('input[name="SelectedOption"]:checked');
            if (!selected) {
                alert("برجاء اختيار إجابة.");
                return;
            }

            const questionId = "@Model.Id";
            const selectedAnswer = selected.value;

            const response = await fetch('/Students/EnhancementSkills/Submit', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify({ questionId, selectedAnswer })
            });

            const result = await response.json();
            if (result.success) {
                window.location.href = '/Students/EnhancementSkills/Index';
            }
            else {
                alert("حدث خطأ أثناء الحفظ.");
            }
        });
    </script>
}
