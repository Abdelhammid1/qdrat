@model List<QdratNew.ViewModels.EnhancementSkills.EnhancementSkillSessionResultViewModel>

<h3>نتائج الجلسات السابقة - المهارات المعززة</h3>

@if (!Model.Any())
{
    <div class="alert alert-info">لا توجد جلسات سابقة.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>التاريخ</th>
                <th>عدد الأسئلة</th>
                <th>الإجابات الصحيحة</th>
                <th>النسبة المئوية</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.SubmittedAt.ToString("yyyy/MM/dd HH:mm")</td>
                    <td>@item.TotalQuestions</td>
                    <td>@item.CorrectAnswers</td>
                    <td>@item.Score %</td>
                </tr>
            }
        </tbody>
    </table>
}
