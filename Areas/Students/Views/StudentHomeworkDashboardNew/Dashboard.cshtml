@model QdratNew.ViewModels.Homework.StudentHomeworkDashboardViewModel
@using System.Text.Json

<!-- Course Switcher wrapped in dark bar so white text is readable -->
<div class="hw-switcher-bar">
    @await Component.InvokeAsync("StudentCourseSwitcher")
</div>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>

<style>
/* ── Course Switcher bar ─────────────────────── */
.hw-switcher-bar{
  background:linear-gradient(135deg,#0f1f3d 0%,#1a3a5c 100%);
  border-bottom:1px solid rgba(255,255,255,.08);
  padding:0 4px;
}
/* if the component has no background, the white text will be readable on this dark bar */

:root{
  --c0:#f7f9fc;
  --c1:#ffffff;
  --teal:#2e9e9e;
  --teal2:#1d7b7b;
  --teal-a:rgba(46,158,158,.12);
  --orange:#e07849;
  --orange-a:rgba(224,120,73,.12);
  --green:#22c55e;
  --green-a:rgba(34,197,94,.12);
  --red:#ef4444;
  --red-a:rgba(239,68,68,.12);
  --amber:#f59e0b;
  --amber-a:rgba(245,158,11,.12);
  --ink:#1e293b;
  --ink2:#475569;
  --line:rgba(0,0,0,.07);
  --r:14px;
  --sh:0 2px 16px rgba(0,0,0,.07);
  --sh2:0 8px 32px rgba(0,0,0,.13);
  --ease:.3s cubic-bezier(.4,0,.2,1);
}

*{box-sizing:border-box;margin:0;padding:0}
.hw{font-family:'Cairo',sans-serif;direction:rtl;background:var(--c0);padding:24px 20px 60px;min-height:100vh}

/* ── TOP HERO ROW ─────────────────────────────── */
.hw-top{
  display:grid;
  grid-template-columns:1fr 320px;
  gap:20px;
  margin-bottom:20px;
  align-items:stretch;
}

/* Progress ring card */
.hw-ring-card{
  background:linear-gradient(145deg,#0f1f3d 0%,#1a3a5c 60%,#103545 100%);
  border-radius:20px;
  padding:32px 36px;
  position:relative;
  overflow:hidden;
  display:flex;
  align-items:center;
  gap:36px;
}
.hw-ring-card::before{
  content:'';position:absolute;
  width:400px;height:400px;border-radius:50%;
  background:radial-gradient(circle,rgba(46,158,158,.15) 0%,transparent 65%);
  top:-120px;left:-80px;pointer-events:none;
}
.hw-ring-card::after{
  content:'';position:absolute;
  width:300px;height:300px;border-radius:50%;
  background:radial-gradient(circle,rgba(224,120,73,.1) 0%,transparent 65%);
  bottom:-100px;right:-60px;pointer-events:none;
}
.hw-ring-svg-wrap{position:relative;flex-shrink:0;z-index:1}
.hw-ring-svg{transform:rotate(-90deg);overflow:visible}
.hw-ring-track{fill:none;stroke:rgba(255,255,255,.1);stroke-width:10}
.hw-ring-fill{
  fill:none;stroke:var(--teal);stroke-width:10;
  stroke-linecap:round;
  stroke-dasharray:314;
  stroke-dashoffset:314;
  transition:stroke-dashoffset 1.4s cubic-bezier(.4,0,.2,1);
  filter:drop-shadow(0 0 8px rgba(46,158,158,.6));
}
.hw-ring-center{
  position:absolute;inset:0;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
}
.hw-ring-pct{font-size:2rem;font-weight:900;color:#fff;line-height:1}
.hw-ring-lbl{font-size:.7rem;color:rgba(255,255,255,.55);margin-top:2px;font-weight:600}

.hw-ring-info{flex:1;z-index:1}
.hw-ring-info h2{font-size:1.5rem;font-weight:800;color:#fff;margin-bottom:6px}
.hw-ring-info p{font-size:.85rem;color:rgba(255,255,255,.6);line-height:1.65;max-width:400px;margin-bottom:24px}

.hw-chips{display:flex;flex-wrap:wrap;gap:10px}
.hw-chip{
  display:flex;align-items:center;gap:8px;
  background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);
  border-radius:50px;padding:7px 16px;
  color:rgba(255,255,255,.85);font-size:.8rem;font-weight:700;
  text-decoration:none;
  transition:background var(--ease),border-color var(--ease);
  backdrop-filter:blur(6px);
}
.hw-chip:hover{background:rgba(255,255,255,.16);text-decoration:none;color:#fff}
.hw-chip-dot{width:8px;height:8px;border-radius:50%}

/* Side stats column */
.hw-side-stats{display:flex;flex-direction:column;gap:14px}
.hw-sstat{
  background:var(--c1);border-radius:var(--r);
  border:1px solid var(--line);box-shadow:var(--sh);
  padding:16px 20px;
  display:flex;align-items:center;gap:14px;
  text-decoration:none;
  transition:transform var(--ease),box-shadow var(--ease);
  position:relative;overflow:hidden;
}
.hw-sstat::after{
  content:'';position:absolute;right:0;top:0;bottom:0;width:3px;
  border-radius:0 var(--r) var(--r) 0;
}
.hw-sstat:hover{transform:translateX(-4px);box-shadow:var(--sh2);text-decoration:none}
.hw-sstat.ss-total::after{background:var(--teal)}
.hw-sstat.ss-done::after{background:var(--green)}
.hw-sstat.ss-pending::after{background:var(--amber)}
.hw-sstat.ss-late::after{background:var(--red)}

.hw-sstat-ico{
  width:40px;height:40px;border-radius:11px;
  display:flex;align-items:center;justify-content:center;font-size:1rem;flex-shrink:0;
}
.ss-total .hw-sstat-ico{background:var(--teal-a);color:var(--teal)}
.ss-done  .hw-sstat-ico{background:var(--green-a);color:var(--green)}
.ss-pending .hw-sstat-ico{background:var(--amber-a);color:var(--amber)}
.ss-late .hw-sstat-ico{background:var(--red-a);color:var(--red)}

.hw-sstat-body{flex:1}
.hw-sstat-body strong{display:block;font-size:1.5rem;font-weight:900;line-height:1}
.ss-total .hw-sstat-body strong{color:var(--teal)}
.ss-done  .hw-sstat-body strong{color:var(--green)}
.ss-pending .hw-sstat-body strong{color:var(--amber)}
.ss-late  .hw-sstat-body strong{color:var(--red)}
.hw-sstat-body span{font-size:.78rem;color:var(--ink2);font-weight:600}
.hw-sstat-bar{width:40px;height:40px;flex-shrink:0}

/* ── ANALYTICS PANEL ─────────────────────────── */
.hw-panel{
  background:var(--c1);border-radius:20px;
  border:1px solid var(--line);box-shadow:var(--sh);
  overflow:hidden;margin-bottom:20px;
}
.hw-panel-head{
  display:flex;align-items:stretch;
  border-bottom:1px solid var(--line);
}
.hw-panel-tabs{
  display:flex;flex:1;overflow-x:auto;
  scrollbar-width:none;
}
.hw-panel-tabs::-webkit-scrollbar{display:none}

.hw-ptab{
  display:flex;align-items:center;gap:8px;
  padding:16px 22px;border:none;background:transparent;
  font-family:'Cairo',sans-serif;font-size:.85rem;font-weight:700;
  color:var(--ink2);cursor:pointer;white-space:nowrap;
  border-bottom:2px solid transparent;margin-bottom:-1px;
  transition:color var(--ease),border-color var(--ease);
}
.hw-ptab .ptab-ico{
  width:28px;height:28px;border-radius:8px;
  display:flex;align-items:center;justify-content:center;font-size:.8rem;
  background:var(--line);color:var(--ink2);
  transition:background var(--ease),color var(--ease);
}
.hw-ptab:hover{color:var(--teal)}
.hw-ptab:hover .ptab-ico{background:var(--teal-a);color:var(--teal)}
.hw-ptab.active{color:var(--teal);border-bottom-color:var(--teal)}
.hw-ptab.active .ptab-ico{background:var(--teal-a);color:var(--teal)}

/* Curriculum pill scroller inside panel */
.hw-panel-filter{
  display:flex;align-items:center;gap:8px;
  padding:12px 20px;border-bottom:1px solid var(--line);
  overflow-x:auto;scrollbar-width:none;
  background:#fafbfc;
}
.hw-panel-filter::-webkit-scrollbar{display:none}
.hw-filter-lbl{
  font-size:.72rem;font-weight:800;color:var(--ink2);
  white-space:nowrap;margin-left:4px;
  display:flex;align-items:center;gap:5px;
}
.hw-pill{
  padding:5px 14px;border-radius:50px;border:1.5px solid var(--line);
  background:transparent;font-family:'Cairo',sans-serif;
  font-size:.78rem;font-weight:700;color:var(--ink2);
  cursor:pointer;white-space:nowrap;
  transition:all var(--ease);
}
.hw-pill:hover{border-color:var(--teal);color:var(--teal)}
.hw-pill.active{
  background:var(--teal);border-color:var(--teal);color:#fff;
  box-shadow:0 3px 10px rgba(46,158,158,.35);
}

.hw-panel-body{padding:28px 24px;position:relative;min-height:340px}
.hw-chart-pane{display:none}
.hw-chart-pane.active{display:block;animation:fadeInPane .3s ease}
@@keyframes fadeInPane{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

/* loading spinner */
.hw-panel-body.loading::after{
  content:'';position:absolute;inset:0;
  background:rgba(255,255,255,.75);backdrop-filter:blur(3px);
  border-radius:0 0 20px 20px;z-index:9;
}
.hw-panel-body.loading::before{
  content:'';position:absolute;
  top:50%;left:50%;
  transform:translate(-50%,-50%);
  width:36px;height:36px;
  border:3px solid var(--teal-a);border-top-color:var(--teal);
  border-radius:50%;animation:spin .7s linear infinite;z-index:10;
}
@@keyframes spin{to{transform:translate(-50%,-50%) rotate(360deg)}}

/* ── AI RECOMMENDATIONS ──────────────────────── */
.hw-ai{margin-bottom:20px}
.hw-ai-top{
  display:flex;align-items:center;gap:10px;
  margin-bottom:14px;
}
.hw-ai-top h3{font-size:1rem;font-weight:800;color:var(--ink)}
.hw-ai-badge{
  font-size:.7rem;font-weight:800;padding:3px 10px;
  border-radius:50px;background:linear-gradient(90deg,var(--teal),#1fa8a8);
  color:#fff;
}

.hw-ai-summary-card{
  background:linear-gradient(135deg,#0f1f3d 0%,#173550 100%);
  border-radius:16px;padding:24px 28px;
  margin-bottom:14px;
  display:flex;align-items:flex-start;gap:20px;
}
.hw-ai-sum-left{flex-shrink:0}
.hw-ai-sum-ico{
  width:52px;height:52px;
  background:rgba(46,158,158,.2);border:1.5px solid rgba(46,158,158,.4);
  border-radius:14px;
  display:flex;align-items:center;justify-content:center;font-size:1.4rem;
}
.hw-ai-sum-right p{
  font-size:.9rem;font-weight:600;color:rgba(255,255,255,.85);
  line-height:1.7;margin:0;
}
.hw-ai-speed{
  display:inline-flex;align-items:center;gap:6px;
  background:rgba(46,158,158,.2);border:1px solid rgba(46,158,158,.35);
  border-radius:50px;padding:5px 14px;
  color:var(--teal);font-size:.78rem;font-weight:800;
  margin-bottom:10px;
}
.hw-ai-speed-dot{width:6px;height:6px;border-radius:50%;background:var(--teal);animation:pulse 1.4s ease-in-out infinite}
@@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.7)}}

/* Tips horizontal scroll */
.hw-tips-scroll{
  display:flex;gap:14px;overflow-x:auto;padding-bottom:8px;
  scrollbar-width:thin;scrollbar-color:var(--line) transparent;
}
.hw-tips-scroll::-webkit-scrollbar{height:4px}
.hw-tips-scroll::-webkit-scrollbar-track{background:transparent}
.hw-tips-scroll::-webkit-scrollbar-thumb{background:var(--line);border-radius:99px}

.hw-tip-card{
  flex-shrink:0;width:260px;
  background:var(--c1);border-radius:14px;
  border:1px solid var(--line);box-shadow:var(--sh);
  padding:18px;
  display:flex;flex-direction:column;gap:10px;
  transition:transform var(--ease),box-shadow var(--ease),border-color var(--ease);
}
.hw-tip-card:hover{transform:translateY(-3px);box-shadow:var(--sh2);border-color:rgba(46,158,158,.25)}
.hw-tip-num{
  width:30px;height:30px;border-radius:8px;
  background:var(--teal-a);color:var(--teal);
  font-size:.75rem;font-weight:900;
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.hw-tip-text{font-size:.83rem;color:var(--ink2);line-height:1.65}

.hw-final-advice{
  margin-top:14px;
  background:linear-gradient(135deg,rgba(224,120,73,.08),rgba(224,120,73,.04));
  border:1px solid rgba(224,120,73,.2);border-radius:14px;
  padding:16px 20px;
  display:flex;align-items:flex-start;gap:12px;
}
.hw-final-advice .fa{font-size:1.2rem;flex-shrink:0;margin-top:1px;color:var(--orange)}
.hw-final-advice p{font-size:.87rem;color:#8b4513;font-weight:600;line-height:1.65;margin:0}

.hw-empty{
  text-align:center;padding:48px;color:var(--ink2);
}
.hw-empty .ico{font-size:2.8rem;opacity:.3;margin-bottom:12px}
.hw-empty p{font-size:.9rem}

/* ── ENTRANCE ───────────────────────────────── */
.fu{opacity:0;transform:translateY(20px);animation:fu .5s ease forwards}
@@keyframes fu{to{opacity:1;transform:translateY(0)}}
.d1{animation-delay:.04s}.d2{animation-delay:.1s}.d3{animation-delay:.18s}.d4{animation-delay:.26s}

/* ── RESPONSIVE ─────────────────────────────── */
@@media(max-width:960px){
  .hw-top{grid-template-columns:1fr}
  .hw-side-stats{display:grid;grid-template-columns:1fr 1fr}
}
@@media(max-width:600px){
  .hw{padding:16px 12px 48px}
  .hw-ring-card{flex-direction:column;align-items:flex-start;padding:24px 20px}
  .hw-side-stats{grid-template-columns:1fr 1fr;gap:10px}
  .hw-tip-card{width:230px}
}

/* ── ATTENDANCE SECTION ───────────────────────── */
.hw-att{margin-bottom:20px}
.hw-att-panel{
  background:var(--c1);border-radius:20px;
  border:1px solid var(--line);box-shadow:var(--sh);
  overflow:hidden;
}
.hw-att-head{
  background:linear-gradient(135deg,#0f1f3d 0%,#1a3a5c 100%);
  padding:18px 24px;
  display:flex;align-items:center;gap:14px;
}
.hw-att-head-ico{
  width:42px;height:42px;border-radius:12px;
  background:rgba(46,158,158,.2);border:1.5px solid rgba(46,158,158,.35);
  display:flex;align-items:center;justify-content:center;
  font-size:1.1rem;color:var(--teal);flex-shrink:0;
}
.hw-att-head-text h3{font-size:1rem;font-weight:800;color:#fff;margin:0 0 2px}
.hw-att-head-text p{font-size:.77rem;color:rgba(255,255,255,.55);margin:0}
.hw-att-legend{
  display:flex;align-items:center;gap:16px;margin-right:auto;flex-wrap:wrap;
}
.hw-att-leg-item{
  display:flex;align-items:center;gap:6px;
  font-size:.73rem;font-weight:700;color:rgba(255,255,255,.7);
}
.hw-att-leg-dot{width:10px;height:10px;border-radius:3px}

/* filter strip */
.hw-att-filter{
  display:flex;align-items:center;gap:8px;
  padding:10px 20px;border-bottom:1px solid var(--line);
  background:#fafbfc;overflow-x:auto;scrollbar-width:none;
}
.hw-att-filter::-webkit-scrollbar{display:none}

/* summary chips */
.hw-att-summary{
  display:flex;gap:12px;padding:16px 24px;
  border-bottom:1px solid var(--line);
  overflow-x:auto;scrollbar-width:none;background:#fff;
}
.hw-att-summary::-webkit-scrollbar{display:none}
.hw-att-sum-chip{
  flex-shrink:0;display:flex;align-items:center;gap:8px;
  background:#f8fafc;border:1px solid var(--line);
  border-radius:10px;padding:8px 14px;
}
.hw-att-sum-chip .chip-ico{
  width:28px;height:28px;border-radius:8px;
  display:flex;align-items:center;justify-content:center;font-size:.85rem;flex-shrink:0;
}
.chip-present .chip-ico{background:rgba(34,197,94,.12);color:#22c55e}
.chip-absent  .chip-ico{background:rgba(239,68,68,.12); color:#ef4444}
.chip-late    .chip-ico{background:rgba(245,158,11,.12);color:#f59e0b}
.chip-none    .chip-ico{background:rgba(0,0,0,.05);     color:#94a3b8}
.hw-att-sum-chip .chip-val{
  font-size:1.3rem;font-weight:900;line-height:1;
}
.chip-present .chip-val{color:#22c55e}
.chip-absent  .chip-val{color:#ef4444}
.chip-late    .chip-val{color:#f59e0b}
.chip-none    .chip-val{color:#94a3b8}
.hw-att-sum-chip .chip-lbl{font-size:.72rem;color:var(--ink2);font-weight:600}

/* body */
.hw-att-body{padding:24px;position:relative;min-height:160px}
.hw-att-body.loading::after{
  content:'';position:absolute;inset:0;
  background:rgba(255,255,255,.8);backdrop-filter:blur(3px);
  border-radius:0 0 20px 20px;z-index:9;
}
.hw-att-body.loading::before{
  content:'';position:absolute;top:50%;left:50%;
  transform:translate(-50%,-50%);
  width:32px;height:32px;border:3px solid var(--teal-a);border-top-color:var(--teal);
  border-radius:50%;animation:spin .7s linear infinite;z-index:10;
}

/* section group */
.hw-att-group{margin-bottom:28px}
.hw-att-group:last-child{margin-bottom:0}
.hw-att-group-title{
  font-size:.78rem;font-weight:800;color:var(--ink2);
  margin-bottom:14px;
  display:flex;align-items:center;gap:8px;
  text-transform:uppercase;letter-spacing:.05em;
}
.hw-att-group-title::after{
  content:'';flex:1;height:1px;background:var(--line);
}

/* lecture grid — calendar tile style */
.hw-att-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(72px,1fr));
  gap:10px;
}
.hw-att-tile{
  border-radius:14px;
  padding:10px 6px 8px;
  display:flex;flex-direction:column;align-items:center;gap:4px;
  border:1.5px solid transparent;
  transition:transform var(--ease),box-shadow var(--ease);
  cursor:default;position:relative;
}
.hw-att-tile:hover{transform:translateY(-3px);box-shadow:0 6px 20px rgba(0,0,0,.12)}

/* tile states */
.tile-present{
  background:linear-gradient(145deg,#dcfce7,#bbf7d0);
  border-color:rgba(34,197,94,.3);
}
.tile-absent{
  background:linear-gradient(145deg,#fee2e2,#fecaca);
  border-color:rgba(239,68,68,.3);
}
.tile-late{
  background:linear-gradient(145deg,#fef3c7,#fde68a);
  border-color:rgba(245,158,11,.3);
}
.tile-no-record{
  background:#f1f5f9;
  border-color:rgba(0,0,0,.06);
}

.hw-att-tile-num{
  font-size:.62rem;font-weight:800;
  opacity:.55;line-height:1;
}
.tile-present .hw-att-tile-num{color:#15803d}
.tile-absent  .hw-att-tile-num{color:#b91c1c}
.tile-late    .hw-att-tile-num{color:#92400e}
.tile-no-record .hw-att-tile-num{color:#94a3b8}

.hw-att-tile-ico{font-size:1.3rem;line-height:1}
.hw-att-tile-date{font-size:.58rem;font-weight:600;opacity:.6;line-height:1}
.tile-present .hw-att-tile-date{color:#15803d}
.tile-absent  .hw-att-tile-date{color:#b91c1c}
.tile-late    .hw-att-tile-date{color:#92400e}
.tile-no-record .hw-att-tile-date{color:#94a3b8}

/* tooltip */
.hw-att-tile[data-tooltip]{position:relative}
.hw-att-tile[data-tooltip]::after{
  content:attr(data-tooltip);
  position:absolute;bottom:calc(100% + 6px);left:50%;
  transform:translateX(-50%);
  background:#1e293b;color:#fff;
  font-size:.7rem;font-weight:600;
  padding:4px 10px;border-radius:7px;
  white-space:nowrap;pointer-events:none;
  opacity:0;transition:opacity var(--ease);z-index:20;
}
.hw-att-tile[data-tooltip]:hover::after{opacity:1}

.hw-att-empty{
  text-align:center;padding:40px;color:var(--ink2);
}
.hw-att-empty .ico{font-size:2.5rem;opacity:.25;margin-bottom:10px}
.hw-att-empty p{font-size:.87rem}

@@media(max-width:600px){
  .hw-att-grid{grid-template-columns:repeat(auto-fill,minmax(60px,1fr));gap:8px}
  .hw-att-tile{padding:8px 4px 6px}
  .hw-att-legend{display:none}
  .hw-att-summary{gap:8px}
}
</style>

@{
  var total   = Model.TotalAssigned;
  var done    = Model.Completed;
  var pending = Model.Pending;
  var late    = Model.Late;
  var pct     = total > 0 ? (int)Math.Round((double)done / total * 100) : 0;
  var doneP   = total > 0 ? (int)Math.Round((double)done    / total * 100) : 0;
  var pendP   = total > 0 ? (int)Math.Round((double)pending / total * 100) : 0;
  var lateP   = total > 0 ? (int)Math.Round((double)late    / total * 100) : 0;
  /* SVG ring: circumference = 2π×50 ≈ 314  offset = 314 - (pct/100)*314 */
  var ringOffset = 314 - (pct / 100.0) * 314;
}

<div class="hw">

  <!-- ══════════════════════════════════════════
       TOP ROW: ring hero  +  side stats
  ═══════════════════════════════════════════ -->
  <div class="hw-top fu d1">

    <!-- Progress ring hero -->
    <div class="hw-ring-card">
      <!-- SVG donut -->
      <div class="hw-ring-svg-wrap">
        <svg class="hw-ring-svg" width="120" height="120" viewBox="0 0 120 120">
          <circle class="hw-ring-track" cx="60" cy="60" r="50"/>
          <circle class="hw-ring-fill" cx="60" cy="60" r="50"
                  id="ringFill"
                  style="stroke-dashoffset:@ringOffset.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"/>
        </svg>
        <div class="hw-ring-center">
          <span class="hw-ring-pct" id="ringPct">@pct%</span>
          <span class="hw-ring-lbl">مكتمل</span>
        </div>
      </div>

      <!-- Text + chips -->
      <div class="hw-ring-info">
        <h2>لوحة متابعة الواجبات</h2>
        <p>تابع تقدمك وأداءك في جميع واجباتك المكلّفة. اختر منهجاً من الأسفل لتحليل أداءك بتفصيل.</p>

        <div class="hw-chips">
          <a asp-action="AllHomeworks"      asp-controller="StudentHomeworkList" class="hw-chip">
            <span class="hw-chip-dot" style="background:#2e9e9e"></span> كل الواجبات (@total)
          </a>
          <a asp-action="SolvedHomeworks"   asp-controller="StudentHomeworkList" class="hw-chip">
            <span class="hw-chip-dot" style="background:#22c55e"></span> المحلولة (@done)
          </a>
          <a asp-action="RequiredHomeworks" asp-controller="StudentHomeworkList" class="hw-chip">
            <span class="hw-chip-dot" style="background:#f59e0b"></span> المطلوبة (@pending)
          </a>
          <a asp-action="LateHomeworks"     asp-controller="StudentHomeworkList" class="hw-chip">
            <span class="hw-chip-dot" style="background:#ef4444"></span> المتأخرة (@late)
          </a>
        </div>
      </div>
    </div>

    <!-- Side mini stats -->
    <div class="hw-side-stats">

      <a asp-action="AllHomeworks" asp-controller="StudentHomeworkList" class="hw-sstat ss-total">
        <div class="hw-sstat-ico"><i class="fa-solid fa-book-open"></i></div>
        <div class="hw-sstat-body">
          <strong data-count="@total">0</strong>
          <span>إجمالي الواجبات</span>
        </div>
        <svg class="hw-sstat-bar" viewBox="0 0 40 40">
          <circle cx="20" cy="20" r="16" fill="none" stroke="rgba(0,0,0,.07)" stroke-width="4"/>
          <circle cx="20" cy="20" r="16" fill="none" stroke="var(--teal)" stroke-width="4"
                  stroke-linecap="round" stroke-dasharray="100.5"
                  stroke-dashoffset="0" transform="rotate(-90 20 20)"/>
        </svg>
      </a>

      <a asp-action="SolvedHomeworks" asp-controller="StudentHomeworkList" class="hw-sstat ss-done">
        <div class="hw-sstat-ico"><i class="fa-solid fa-circle-check"></i></div>
        <div class="hw-sstat-body">
          <strong data-count="@done">0</strong>
          <span>@doneP% محلولة</span>
        </div>
        <svg class="hw-sstat-bar" viewBox="0 0 40 40">
          <circle cx="20" cy="20" r="16" fill="none" stroke="rgba(0,0,0,.07)" stroke-width="4"/>
          <circle cx="20" cy="20" r="16" fill="none" stroke="var(--green)" stroke-width="4"
                  stroke-linecap="round" stroke-dasharray="100.5"
                  stroke-dashoffset="@((100.5-(doneP/100.0*100.5)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                  transform="rotate(-90 20 20)"/>
        </svg>
      </a>

      <a asp-action="RequiredHomeworks" asp-controller="StudentHomeworkList" class="hw-sstat ss-pending">
        <div class="hw-sstat-ico"><i class="fa-solid fa-list-check"></i></div>
        <div class="hw-sstat-body">
          <strong data-count="@pending">0</strong>
          <span>@pendP% مطلوبة</span>
        </div>
        <svg class="hw-sstat-bar" viewBox="0 0 40 40">
          <circle cx="20" cy="20" r="16" fill="none" stroke="rgba(0,0,0,.07)" stroke-width="4"/>
          <circle cx="20" cy="20" r="16" fill="none" stroke="var(--amber)" stroke-width="4"
                  stroke-linecap="round" stroke-dasharray="100.5"
                  stroke-dashoffset="@((100.5-(pendP/100.0*100.5)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                  transform="rotate(-90 20 20)"/>
        </svg>
      </a>

      <a asp-action="LateHomeworks" asp-controller="StudentHomeworkList" class="hw-sstat ss-late">
        <div class="hw-sstat-ico"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <div class="hw-sstat-body">
          <strong data-count="@late">0</strong>
          <span>@lateP% متأخرة</span>
        </div>
        <svg class="hw-sstat-bar" viewBox="0 0 40 40">
          <circle cx="20" cy="20" r="16" fill="none" stroke="rgba(0,0,0,.07)" stroke-width="4"/>
          <circle cx="20" cy="20" r="16" fill="none" stroke="var(--red)" stroke-width="4"
                  stroke-linecap="round" stroke-dasharray="100.5"
                  stroke-dashoffset="@((100.5-(lateP/100.0*100.5)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                  transform="rotate(-90 20 20)"/>
        </svg>
      </a>

    </div>
  </div>

  <!-- ══════════════════════════════════════════
       ANALYTICS PANEL  (tabbed + curriculum filter)
  ═══════════════════════════════════════════ -->
  <div class="hw-panel fu d2">

    <!-- Tab bar -->
    <div class="hw-panel-head">
      <div class="hw-panel-tabs">
        <button class="hw-ptab active" onclick="switchTab(this,'tab-radar')">
          <span class="ptab-ico"><i class="fa-solid fa-chart-area"></i></span>
          تحليل المحاور
        </button>
        <button class="hw-ptab" onclick="switchTab(this,'tab-progress')">
          <span class="ptab-ico"><i class="fa-solid fa-arrow-trend-up"></i></span>
          تطور الأداء
        </button>
        <button class="hw-ptab" onclick="switchTab(this,'tab-compare')">
          <span class="ptab-ico"><i class="fa-solid fa-people-arrows"></i></span>
          مقارنة بالدفعة
        </button>
      </div>
    </div>

    <!-- Curriculum pill filter -->
    <div class="hw-panel-filter">
      <span class="hw-filter-lbl"><i class="fa-solid fa-filter" style="font-size:.7rem"></i> منهج:</span>
      <button class="hw-pill active" onclick="selectCurriculum(this,0)">كل المناهج</button>
      @foreach (var c in Model.Curriculums)
      {
        <button class="hw-pill" onclick="selectCurriculum(this,@c.Id)">@c.Title</button>
      }
    </div>

    <!-- Chart panes -->
    <div class="hw-panel-body" id="hw-panel-body">
      <div class="hw-chart-pane active" id="tab-radar">
        <canvas id="radarChart" style="max-height:380px"></canvas>
      </div>
      <div class="hw-chart-pane" id="tab-progress">
        <canvas id="homeworkProgressChart" style="max-height:340px"></canvas>
      </div>
      <div class="hw-chart-pane" id="tab-compare">
        <canvas id="homeworkComparisonChart" style="max-height:340px"></canvas>
      </div>
    </div>

  </div>

  <!-- ══════════════════════════════════════════
       AI RECOMMENDATIONS
  ═══════════════════════════════════════════ -->
  <div class="hw-ai fu d3">
    <div class="hw-ai-top">
      <h3><i class="fa-solid fa-brain" style="color:var(--teal);margin-left:6px"></i> توصيات ذكية</h3>
      <span class="hw-ai-badge">AI</span>
    </div>
        @{
            var tips = new List<string>();
            if (Model.Recommendation?.SectionTips != null) tips.AddRange(Model.Recommendation.SectionTips);
            if (Model.Recommendation?.LessonTips != null) tips.AddRange(Model.Recommendation.LessonTips);
            if (Model.Recommendation?.IndividualTips != null) tips.AddRange(Model.Recommendation.IndividualTips);
        }
    @if (Model.Recommendation != null)
    {
      <!-- Summary banner -->
      <div class="hw-ai-summary-card">
        <div class="hw-ai-sum-left">
          <div class="hw-ai-sum-ico">🧠</div>
        </div>
        <div class="hw-ai-sum-right">
          @if (!string.IsNullOrEmpty(Model.Recommendation.SpeedLabel))
          {
            <div class="hw-ai-speed">
              <span class="hw-ai-speed-dot"></span>@Model.Recommendation.SpeedLabel
            </div>
          }
          @if (!string.IsNullOrEmpty(Model.Recommendation.SpeedNote))
          {
            <p>@Model.Recommendation.SpeedNote</p>
          }
          @if (!string.IsNullOrEmpty(Model.Recommendation.PerformanceSummary))
          {
            <p style="color:rgba(255,255,255,.55);font-size:.83rem;margin-top:6px">@Model.Recommendation.PerformanceSummary</p>
          }
        </div>
      </div>

      <!-- Tips horizontal scroll -->
     
      @if (tips.Any())
      {
        <div class="hw-tips-scroll">
          @for (int i = 0; i < tips.Count; i++)
          {
            <div class="hw-tip-card">
              <div class="hw-tip-num">@(i+1)</div>
              <p class="hw-tip-text">@tips[i]</p>
            </div>
          }
        </div>
      }

      @if (!string.IsNullOrEmpty(Model.Recommendation.FinalAdvice))
      {
        <div class="hw-final-advice">
          <i class="fa fa-lightbulb"></i>
          <p>@Model.Recommendation.FinalAdvice</p>
        </div>
      }
    }
    else
    {
      <div class="hw-empty">
        <div class="ico">🤖</div>
        <p>أكمل بعض الواجبات لتفعيل التحليل الذكي</p>
      </div>
    }
  </div>

  <!-- ══════════════════════════════════════════
       ATTENDANCE SECTION  (lecture tiles grid)
  ═══════════════════════════════════════════ -->
  <div class="hw-att fu d4">

    <!-- section heading -->
    <div class="hw-ai-top" style="margin-bottom:14px">
      <h3><i class="fa-solid fa-calendar-days" style="color:var(--teal);margin-left:6px"></i> سجل الحضور</h3>
      <span class="hw-ai-badge" style="background:linear-gradient(90deg,#1a3a5c,#1d5e5e)">LIVE</span>
    </div>

    <div class="hw-att-panel">

      <!-- dark header -->
      <div class="hw-att-head">
        <div class="hw-att-head-ico"><i class="fa-solid fa-user-check"></i></div>
        <div class="hw-att-head-text">
          <h3>حضورك في المحاضرات</h3>
          <p>حدّد المنهج لعرض تفاصيل حضورك في كل محاضرة</p>
        </div>
        <div class="hw-att-legend">
          <span class="hw-att-leg-item"><span class="hw-att-leg-dot" style="background:#22c55e"></span> حاضر</span>
          <span class="hw-att-leg-item"><span class="hw-att-leg-dot" style="background:#ef4444"></span> غائب</span>
          <span class="hw-att-leg-item"><span class="hw-att-leg-dot" style="background:#f59e0b"></span> تأخير</span>
          <span class="hw-att-leg-item"><span class="hw-att-leg-dot" style="background:#cbd5e1"></span> لم يُسجَّل</span>
        </div>
      </div>

      <!-- curriculum filter -->
      <div class="hw-att-filter">
        <span class="hw-filter-lbl"><i class="fa-solid fa-filter" style="font-size:.7rem"></i> منهج:</span>
        <button class="hw-pill active" onclick="selectAttCurriculum(this,0)">كل المناهج</button>
        @foreach (var c in Model.Curriculums)
        {
          <button class="hw-pill" onclick="selectAttCurriculum(this,@c.Id)">@c.Title</button>
        }
      </div>

      <!-- summary counters (will be updated by JS) -->
      <div class="hw-att-summary" id="hw-att-summary">
        <div class="hw-att-sum-chip chip-present">
          <div class="chip-ico"><i class="fa-solid fa-circle-check"></i></div>
          <div>
            <div class="chip-val" id="att-cnt-present">—</div>
            <div class="chip-lbl">حاضر</div>
          </div>
        </div>
        <div class="hw-att-sum-chip chip-absent">
          <div class="chip-ico"><i class="fa-solid fa-circle-xmark"></i></div>
          <div>
            <div class="chip-val" id="att-cnt-absent">—</div>
            <div class="chip-lbl">غائب</div>
          </div>
        </div>
        <div class="hw-att-sum-chip chip-late">
          <div class="chip-ico"><i class="fa-solid fa-clock-rotate-left"></i></div>
          <div>
            <div class="chip-val" id="att-cnt-late">—</div>
            <div class="chip-lbl">تأخير</div>
          </div>
        </div>
        <div class="hw-att-sum-chip chip-none">
          <div class="chip-ico"><i class="fa-regular fa-circle"></i></div>
          <div>
            <div class="chip-val" id="att-cnt-none">—</div>
            <div class="chip-lbl">لم يُسجَّل</div>
          </div>
        </div>
      </div>

      <!-- tile grid (filled by JS) -->
      <div class="hw-att-body" id="hw-att-body">
        <div id="hw-att-content">
          <div class="hw-att-empty">
            <div class="ico">📅</div>
            <p>جارٍ تحميل بيانات الحضور…</p>
          </div>
        </div>
      </div>

    </div>
  </div>

</div><!-- /hw -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
/* ─── tokens ─── */
const C = {
  teal:'#2e9e9e', tealS:'rgba(46,158,158,.18)', tealSS:'rgba(46,158,158,.07)',
  orange:'#e07849', orangeS:'rgba(224,120,73,.22)',
  green:'#22c55e',  greenS:'rgba(34,197,94,.18)',
  navy:'#1e293b',   gray:'#475569', gridLine:'rgba(0,0,0,.06)'
};

/* ─── animated counters ─── */
document.querySelectorAll('[data-count]').forEach(el=>{
  const t=+el.dataset.count; if(!t){el.textContent='0';return}
  let n=0; const s=Math.ceil(t/40);
  const id=setInterval(()=>{n=Math.min(n+s,t);el.textContent=n;if(n>=t)clearInterval(id)},28);
});

/* ─── ring animation ─── */
(function(){
  const fill=document.getElementById('ringFill');
  if(!fill)return;
  const pct=@pct;
  const target=314-(pct/100)*314;
  fill.style.strokeDashoffset=314;
  requestAnimationFrame(()=>requestAnimationFrame(()=>{
    fill.style.transition='stroke-dashoffset 1.4s cubic-bezier(.4,0,.2,1)';
    fill.style.strokeDashoffset=target;
  }));
})();

/* ─── chart instances ─── */
let charts={radar:null,progress:null,compare:null};

/* ─── tab switcher ─── */
function switchTab(btn,paneId){
  document.querySelectorAll('.hw-ptab').forEach(b=>b.classList.remove('active'));
  document.querySelectorAll('.hw-chart-pane').forEach(p=>p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById(paneId).classList.add('active');
  /* resize chart so it fills the pane correctly */
  const map={
    'tab-radar':charts.radar,
    'tab-progress':charts.progress,
    'tab-compare':charts.compare
  };
  if(map[paneId]) map[paneId].resize();
}

/* ─── curriculum pills ─── */
function selectCurriculum(btn,id){
  document.querySelectorAll('.hw-pill').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  loadData(id);
}

/* ─── loading ─── */
function setLoading(on){
  document.getElementById('hw-panel-body').classList.toggle('loading',on);
}

/* ─── chart renderers ─── */
function mkRadar(labels,student,batch){
  if(charts.radar) charts.radar.destroy();
  charts.radar=new Chart(document.getElementById('radarChart'),{
    type:'radar',
    data:{
      labels,
      datasets:[
        {label:'أداء الطالب',data:student,
          backgroundColor:C.tealS,borderColor:C.teal,borderWidth:2.5,
          pointBackgroundColor:C.teal,pointBorderColor:'#fff',pointRadius:5},
        {label:'متوسط الدفعة',data:batch,
          backgroundColor:C.orangeS,borderColor:C.orange,borderWidth:2.5,
          pointBackgroundColor:C.orange,pointBorderColor:'#fff',pointRadius:5}
      ]
    },
    options:{
      responsive:true,
      plugins:{legend:{position:'bottom',labels:{font:{family:'Cairo',size:12},padding:20}}},
      scales:{r:{
        suggestedMin:0,suggestedMax:100,
        angleLines:{color:'rgba(0,0,0,.08)'},
        grid:{color:'rgba(0,0,0,.07)'},
        ticks:{backdropColor:'transparent',font:{family:'Cairo',size:11},color:C.gray,stepSize:25},
        pointLabels:{font:{family:'Cairo',size:12,weight:'700'},color:C.navy}
      }}
    }
  });
}

function mkProgress(labels,correct,wrong){
  if(charts.progress) charts.progress.destroy();
  charts.progress=new Chart(document.getElementById('homeworkProgressChart'),{
    type:'bar',
    data:{
      labels,
      datasets:[
        {label:'إجابات صحيحة',data:correct,backgroundColor:C.green,borderRadius:7,borderSkipped:false},
        {label:'إجابات خاطئة / متبقية',data:wrong,backgroundColor:C.orangeS,borderRadius:7,borderSkipped:false}
      ]
    },
    options:{
      responsive:true,
      plugins:{legend:{position:'bottom',labels:{font:{family:'Cairo',size:12},padding:16}}},
      scales:{
        y:{beginAtZero:true,grid:{color:C.gridLine},ticks:{font:{family:'Cairo'}}},
        x:{grid:{display:false},ticks:{font:{family:'Cairo',size:11}}}
      }
    }
  });
}

function mkCompare(labels,student,batch){
  if(charts.compare) charts.compare.destroy();
  charts.compare=new Chart(document.getElementById('homeworkComparisonChart'),{
    type:'bar',
    data:{
      labels,
      datasets:[
        {label:'درجة الطالب',data:student,backgroundColor:C.teal,borderRadius:7,borderSkipped:false},
        {label:'متوسط الدفعة',data:batch,backgroundColor:C.orange,borderRadius:7,borderSkipped:false}
      ]
    },
    options:{
      responsive:true,
      plugins:{legend:{position:'bottom',labels:{font:{family:'Cairo',size:12},padding:16}}},
      scales:{
        y:{beginAtZero:true,max:100,grid:{color:C.gridLine},ticks:{font:{family:'Cairo'}}},
        x:{grid:{display:false},ticks:{font:{family:'Cairo',size:11}}}
      }
    }
  });
}

/* ─── fetch ─── */
function loadData(curriculumId){
  setLoading(true);
  fetch(`/Students/StudentHomeworkDashboardNew/GetCurriculumData?curriculumId=${curriculumId}`)
    .then(r=>r.json())
    .then(d=>{
      mkRadar(d.sectionLabels,d.studentScores,d.batchAverages);
      mkProgress(d.homeworkTitles,d.correctAnswers,d.remainingQuestions);
      mkCompare(d.homeworkTitles,d.studentHomeworkScores,d.batchHomeworkAverages);
    })
    .catch(e=>console.error(e))
    .finally(()=>setLoading(false));
}

loadData(0);

/* ════════════════════════════════════════════
   ATTENDANCE MODULE
═══════════════════════════════════════════ */
const ATT_ICONS = {
  present:   { emoji:'✅', cls:'tile-present',    label:'حاضر'     },
  absent:    { emoji:'❌', cls:'tile-absent',     label:'غائب'     },
  late:      { emoji:'⏰', cls:'tile-late',       label:'تأخير'    },
  'no-record':{ emoji:'○', cls:'tile-no-record', label:'لم يُسجَّل'}
};

function selectAttCurriculum(btn, id){
  document.querySelectorAll('.hw-att-filter .hw-pill').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  loadAttendance(id);
}

function setAttLoading(on){
  document.getElementById('hw-att-body').classList.toggle('loading', on);
}

function updateAttSummary(grouped){
  let present=0, absent=0, late=0, none=0;
  grouped.forEach(g=>{
    g.lectures.forEach(l=>{
      if(l.status==='present')    present++;
      else if(l.status==='absent') absent++;
      else if(l.status==='late')   late++;
      else                          none++;
    });
  });
  document.getElementById('att-cnt-present').textContent = present;
  document.getElementById('att-cnt-absent').textContent  = absent;
  document.getElementById('att-cnt-late').textContent    = late;
  document.getElementById('att-cnt-none').textContent    = none;
}

function renderAttendance(grouped){
  updateAttSummary(grouped);
  const container = document.getElementById('hw-att-content');

  if(!grouped || !grouped.length){
    container.innerHTML=`<div class="hw-att-empty"><div class="ico">📅</div><p>لا توجد محاضرات مسجلة لهذا المنهج</p></div>`;
    return;
  }

  let html = '';
  grouped.forEach(g=>{
    const sectionLabel = g.section || 'محاضرات عامة';
    html += `<div class="hw-att-group">
      <div class="hw-att-group-title"><i class="fa-solid fa-layer-group" style="font-size:.75rem;color:var(--teal)"></i>${sectionLabel}</div>
      <div class="hw-att-grid">`;

    g.lectures.forEach(l=>{
      const info = ATT_ICONS[l.status] || ATT_ICONS['no-record'];
      html += `<div class="hw-att-tile ${info.cls}" data-tooltip="${l.title} — ${info.label}">
        <span class="hw-att-tile-num">م${l.index}</span>
        <span class="hw-att-tile-ico">${info.emoji}</span>
        <span class="hw-att-tile-date">${l.date ? l.date.substring(5) : ''}</span>
      </div>`;
    });

    html += `</div></div>`;
  });

  container.innerHTML = html;
}

function loadAttendance(curriculumId){
  setAttLoading(true);
  fetch(`/Students/StudentHomeworkDashboardNew/GetAttendanceSummary?curriculumId=${curriculumId}`)
    .then(r=>r.json())
    .then(d=>renderAttendance(d.grouped))
    .catch(()=>{
      document.getElementById('hw-att-content').innerHTML=
        `<div class="hw-att-empty"><div class="ico">⚠️</div><p>تعذّر تحميل بيانات الحضور</p></div>`;
    })
    .finally(()=>setAttLoading(false));
}

loadAttendance(0);
</script>
