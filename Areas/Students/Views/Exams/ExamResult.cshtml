@model QdratNew.ViewModels.Students.ExamResultViewModel
@using QdratNew.Helpers

@{
    ViewData["Title"] = "نتيجة الاختبار";
    var successRate = Model.ScorePercentage;

    var tone = ResultToneHelper.Build(successRate, ResultContext.Exam);
    string performanceMessage = tone.Title + " — " + tone.Subtitle;
    string performanceIcon = tone.IconCss;
}
@if (TempData["ErrorMessage"] != null)
{
    <script>
        Swal.fire({
            icon: "info",
            title: "تنبيه",
            text: "@TempData["ErrorMessage"]",
            confirmButtonText: "عرض النتيجة"
        });
    </script>
}

<div class="container py-5">
    <!-- 🟦 العنوان -->
    <div class="text-center mb-5">
        <h2 class="fw-bold text-primary mb-2">
            <i class="bi bi-bar-chart-fill"></i> نتيجة اختبارك
        </h2>
        <h5 class="text-secondary">@Model.ExamTitle</h5>
    </div>

    <!-- 📊 كروت الإحصائيات -->
    <div class="row text-center mb-4">
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm rounded-4 bg-light">
                <div class="card-body">
                    <h6 class="text-muted">عدد الأسئلة الكلي</h6>
                    <h3 class="fw-bold text-dark">
                        @NumberHelper.ToIndicNumbersSafe(Model.TotalQuestions.ToString())
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm rounded-4 bg-light">
                <div class="card-body">
                    <h6 class="text-muted">الإجابات الصحيحة</h6>
                    <h3 class="fw-bold text-success">
                        @NumberHelper.ToIndicNumbersSafe(Model.CorrectAnswers.ToString())
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm rounded-4 bg-light">
                <div class="card-body">
                    <h6 class="text-muted">الإجابات الخاطئة</h6>
                    <h3 class="fw-bold text-danger">
                        @NumberHelper.ToIndicNumbersSafe(Model.WrongAnswers.ToString())
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm rounded-4 bg-light">
                <div class="card-body">
                    <h6 class="text-muted">الأسئلة المتخطاة</h6>
                    <h3 class="fw-bold text-warning">
                        @NumberHelper.ToIndicNumbersSafe(Model.SkippedQuestions.ToString())
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <!-- 🔹 شريط التقدم للنتيجة -->
    <div class="text-center mb-4">
        <h5 class="fw-bold mb-3">النتيجة المئوية</h5>
        <div class="progress mx-auto" style="height: 30px; max-width: 400px;">
            <div class="progress-bar text-white fw-bold"
                 role="progressbar"
                 style="width:@Model.ScorePercentage%; background: linear-gradient(90deg, #007bff, #00bcd4);"
                 aria-valuenow="@Model.ScorePercentage"
                 aria-valuemin="0"
                 aria-valuemax="100">
                @Model.ScorePercentage%
            </div>
        </div>
    </div>

    <!-- ⏱ الوقت المستغرق -->
   @*  @if (!string.IsNullOrEmpty(Model.TimeSpentFormatted))
    {
        <div class="text-center mb-5">
            <h5 class="fw-bold text-dark">
                ⏱ الوقت المستغرق:
                <span class="text-primary">@Model.TimeSpentFormatted</span>

            </h5>
        </div>
    } *@

    <!-- 🧠 رسالة ذكية -->
    <div class="alert alert-light shadow-sm border-start border-4 border-primary rounded-4 py-3 px-4 text-center mb-5">
        <i class="bi @performanceIcon fs-3 me-2"></i>
        <span class="fw-bold">@performanceMessage</span>
    </div>








    <div class="text-center mt-4">
        <a asp-action="ExamReview" asp-route-id="@Model.ExamAssignmentId"
           class="btn btn-outline-primary btn-lg rounded-pill px-4 shadow-sm">
            <i class="fa-solid fa-list-check me-2"></i> عرض تفاصيل الأسئلة
        </a>
    </div>

</div>

<!-- 🎨 CSS -->
<style>
    h2, h5 {
        letter-spacing: 0.5px;
    }

    .card-body h3 {
        font-size: 1.8rem;
    }

    .card:hover {
        transform: scale(1.02);
        transition: all 0.3s ease-in-out;
    }

    .progress {
        border-radius: 20px;
        overflow: hidden;
    }

    .progress-bar {
        transition: width 1s ease-in-out;
        font-size: 1.1rem;
    }

    .alert-light {
        background-color: #f8f9fa;
    }

    @@media (max-width: 768px) {
        .card-body h3 {
            font-size: 1.4rem;
        }
    }
</style>
