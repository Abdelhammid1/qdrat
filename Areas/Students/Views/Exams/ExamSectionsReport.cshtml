@model List<QdratNew.ViewModels.Reports.ExamSectionSummaryVm>

<div class="container py-4">
    <h3 class="fw-bold text-primary mb-4">تحليل المحاور داخل الاختبار</h3>

    <table class="table table-bordered text-center align-middle">
        <thead class="table-light">
            <tr>
                <th>المحور</th>
                <th>عدد الأسئلة</th>
                <th>صحيحة</th>
                <th>خاطئة</th>
                <th>متخطاة</th>
                <th>إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.SectionTitle</td>
                    <td>@s.TotalQuestions</td>
                    <td class="text-success">@s.Correct</td>
                    <td class="text-danger">@s.Wrong</td>
                    <td class="text-warning">@s.Skipped</td>
                    <td>
                        <a class="btn btn-outline-primary btn-sm"
                           asp-action="ExamSectionLessonsReport"
                           asp-route-sectionId="@s.SectionId"
                           asp-route-examAssignmentId="@ViewBag.ExamAssignmentId">
                            المؤشرات
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
