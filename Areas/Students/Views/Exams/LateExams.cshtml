@model QdratNew.ViewModels.Exam.LateExamsPageVm
@{
    ViewData["Title"] = "الاختبارات المتأخرة";
    var now = DateTime.UtcNow;
}

<div class="container mt-4" dir="rtl">

    <!-- ======== أعلى الكروت ======== -->
    <div class="row text-center mb-4">

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0 p-4 rounded-4 bg-danger text-white">
                <h5>متأخر</h5>
                <h1 class="fw-bold">@Model.TotalLate</h1>
                <p class="small">اختبارات تجاوزت وقت النهاية</p>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0 p-4 rounded-4 bg-warning">
                <h5>سيتأخر قريبًا</h5>
                <h1 class="fw-bold">@Model.TotalExpiringSoon</h1>
                <p class="small">أقل من 48 ساعة على انتهاء الوقت</p>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0 p-4 rounded-4 bg-info text-white">
                <h5>قادمة</h5>
                <h1 class="fw-bold">@Model.TotalUpcoming</h1>
                <p class="small">اختبارات لم تبدأ بعد</p>
            </div>
        </div>

    </div>


    <!-- ======== جدول الاختبارات المتأخرة ======== -->
    @if (Model.Late.Any())
    {
        <h4 class="fw-bold mt-4 text-danger">🔴 الاختبارات المتأخرة</h4>
        @Html.Partial("_LateExamsTable", Model.Late)
    }

    @if (Model.ExpiringSoon.Any())
    {
        <h4 class="fw-bold mt-5 text-warning">🟡 اختبارات ستتأخر قريبًا</h4>
        @Html.Partial("_LateExamsTable", Model.ExpiringSoon)
    }

    @if (Model.Upcoming.Any())
    {
        <h4 class="fw-bold mt-5 text-info">🔵 اختبارات قادمة</h4>
        @Html.Partial("_LateExamsTable", Model.Upcoming)
    }

</div>
