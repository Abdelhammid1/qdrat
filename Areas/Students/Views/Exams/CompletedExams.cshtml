@model List<QdratNew.ViewModels.Exam.ExamListVm>

@{
    ViewData["Title"] = "الاختبارات المكتملة";

    var completed = Model
        .Where(x => x.IsSubmitted)
        .OrderByDescending(x => x.AssignedAt)
        .ToList();

    var avgScore = completed.Any()
        ? Math.Round(completed.Average(x => x.Score ?? 0), 1)
        : 0;

}

<div class="container mt-4">

    <!-- ====================== -->
    <!-- 🔹 الكروت العلوية -->
    <!-- ====================== -->
    <div class="row g-4 mb-4 text-center">

        <div class="col-md-6">
            <div class="card bg-success text-white border-0 shadow-sm rounded-3 h-100">
                <div class="card-body">
                    <h5 class="fw-bold">📘 عدد الاختبارات المكتملة</h5>
                    <p class="display-5 fw-bold">@completed.Count</p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card bg-primary text-white border-0 shadow-sm rounded-3 h-100">
                <div class="card-body">
                    <h5 class="fw-bold">🎯 متوسط الدرجات</h5>
                    <p class="display-5 fw-bold">@avgScore %</p>
                </div>
            </div>
        </div>

    </div>

    <!-- ======================== -->
    <!-- 🔹 جدول الاختبارات المكتملة -->
    <!-- ======================== -->

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-light fw-bold text-center py-3">
            📝 قائمة الاختبارات المكتملة
        </div>

        <div class="card-body table-responsive">

            @if (!completed.Any())
            {
                <div class="alert alert-info text-center fw-bold py-4 rounded-3">
                    ⚠️ لا توجد اختبارات مكتملة حالياً
                </div>
            }
            else
            {
                <table class="table table-hover align-middle text-center modern-table">
                    <thead class="table-light">
                        <tr>
                            <th>العنوان</th>
                            <th class="d-none d-md-table-cell">تاريخ الإرسال</th>
                            <th>النتيجة</th>
                            <th>النوع</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var exam in completed)
                        {
                            <tr>
                                <td data-label="العنوان" class="fw-bold">@exam.Title</td>

                                <td class="d-none d-md-table-cell" data-label="تاريخ الإرسال">
                                    @exam.AssignedAt.ToString("yyyy/MM/dd")
                                </td>

                                <td data-label="النتيجة">
                                    @{
                                        var color = exam.Score switch
                                        {
                                            >= 85 => "bg-success",
                                            >= 60 => "bg-info",
                                            >= 40 => "bg-warning text-dark",
                                            _ => "bg-danger"
                                        };
                                    }
                                    <span class="badge @color px-3 py-2 fs-6">
                                        @exam.Score %
                                    </span>
                                </td>

                                <td data-label="النوع">
                                    @if (exam.IsIndividual)
                                    {
                                        <span class="badge bg-purple px-3 py-2">فردي</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success px-3 py-2">دفعة</span>
                                    }
                                </td>

                                <td data-label="إجراءات">
                                    <a asp-action="Review"
                                       asp-route-examAssignmentId="@exam.ExamAssignmentId"
                                       class="btn btn-sm btn-outline-success rounded-pill px-3 me-1">
                                        <i class="fa-solid fa-eye me-1"></i> مراجعة
                                    </a>

                                    <a asp-action="ExamReport"
                                       asp-route-examAssignmentId="@exam.ExamAssignmentId"
                                       class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        <i class="fa-solid fa-file-lines me-1"></i> تقرير
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

<!-- =========================== -->
<!-- 🎨 تصميم ريسبونسيف للجوال -->
<!-- =========================== -->
<style>
    .modern-table tbody tr {
        background: #fff;
        border-radius: 12px;
        margin-bottom: 10px;
        display: table-row;
        transition: 0.25s;
    }

        .modern-table tbody tr:hover {
            background: #f6fffc;
        }

    .bg-purple {
        background-color: #6f42c1 !important;
        color: #fff !important;
    }

    @@media (max-width: 768px) {
        table thead

    {
        display: none !important;
    }

    table tbody tr {
        display: block !important;
        border: 1px solid #ececec;
        margin-bottom: 1rem;
        border-radius: 10px;
        padding: 10px;
    }

    table tbody td {
        display: flex !important;
        justify-content: space-between !important;
        padding: 6px 0 !important;
        border: none !important;
    }

        table tbody td::before {
            content: attr(data-label);
            font-weight: bold;
            color: #1ba098;
        }

    /* إخفاء عمود التاريخ على الموبايل */
    .d-none.d-md-table-cell {
        display: none !important;
    }

    }
</style>
