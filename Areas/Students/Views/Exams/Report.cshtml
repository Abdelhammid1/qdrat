@model QdratNew.ViewModels.Homework.HomeworkReportViewModel
@using Newtonsoft.Json

<div class="container-fluid py-4">
    <div class="row align-items-center mb-4">
        <div class="col-md-6 d-flex align-items-center">
            <img src="/images/avatar.png" class="rounded-circle me-3" width="60" height="60" />
            <div>
                <h5 class="mb-1">@Model.StudentName</h5>
                <small class="text-muted">الاختبار: @Model.Title</small>
            </div>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="DownloadReportPdf"
               asp-route-examAssignmentId="@Model.HomeworkSetId"
               class="btn btn-outline-primary">
                <i class="bi bi-file-earmark-pdf"></i> تحميل PDF
            </a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-3 col-6">
            <div class="card text-center shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">درجة الطالب</h6>
                    <h3 class="fw-bold">@Model.Percentage %</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card text-center shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">الوقت المستغرق</h6>
                    <h3 class="fw-bold">@Model.TimeSpentMinutes دقيقة</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card text-center shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">عدد الأسئلة</h6>
                    <h3 class="fw-bold">@Model.Questions.Count()</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card text-center shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">التقييم</h6>
                    <h3>
                        @{
                            int stars = 1;
                            if (Model.Percentage >= 90) stars = 5;
                            else if (Model.Percentage >= 75) stars = 4;
                            else if (Model.Percentage >= 60) stars = 3;
                            else if (Model.Percentage >= 40) stars = 2;

                            for (int s = 0; s < stars; s++)
                            {
                                <text>⭐</text>
                                ;
                            }
                            for (int s = stars; s < 5; s++)
                            {

                                <text>☆</text>
                                ;
                            }
                        }
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4 g-3">
        <div class="col-lg-6 col-12">
            <div class="card shadow-sm">
                <div class="card-header text-center fw-bold">توزيع الإجابات</div>
                <div class="card-body" style="height:300px;">
                    <canvas id="donutChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-6 col-12">
            <div class="card shadow-sm">
                <div class="card-header text-center fw-bold">الأداء حسب المحاور</div>
                <div class="card-body" style="height:300px;">
                    <canvas id="barChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        new Chart(document.getElementById("donutChart"), {
            type: 'doughnut',
            data: {
                labels: ["صحيحة", "خاطئة"],
                datasets: [{
                    data: [@Model.CorrectAnswers, @Model.WrongAnswers],
                    backgroundColor: ["#339999", "#da784d"]
                }]
            }
        });

        new Chart(document.getElementById("barChart"), {
            type: 'bar',
            data: {
                labels: @Html.Raw(JsonConvert.SerializeObject(Model.SectionScores?.Keys.ToList() ?? new List<string>())),
                datasets: [{
                    label: 'النسبة %',
                    data: @Html.Raw(JsonConvert.SerializeObject(Model.SectionScores?.Values.ToList() ?? new List<double>())),
                    backgroundColor: "#339999"
                }]
            },
            options: { scales: { y: { beginAtZero: true, max: 100 } } }
        });
    </script>
}
