@model List<QdratNew.ViewModels.Exam.WeakSectionVm>

<div class="container mt-4">
    <h3 class="fw-bold text-center mb-4">📉 المحاور الأضعف</h3>

    <table class="table table-bordered text-center shadow-sm">
        <thead class="table-light">
            <tr>
                <th>المحور</th>
                <th>نسبة الأداء</th>
                <th>الحالة</th>
                <th>الإجراء</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.SectionName</td>
                    <td>@item.Accuracy.ToString("F2") %</td>
                    <td>
                        @if (item.Trained)
                        {
                            <span class="badge bg-success">✔️ تم التدريب</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">لم يتم التدريب</span>
                        }
                    </td>
                    <td>
                        <a asp-action="StartWeaknessPractice"
                           asp-controller="Practice"
                           asp-route-sectionId="@item.SectionId"
                           class="btn btn-primary btn-sm" target="_blank">
                            🎯 ابدأ التدريب (45 سؤال)
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
