ً@{
    Layout = "~/Views/Shared/_QuestionStudentLayout.cshtml";
    string msg = ViewBag.ErrorMessage ?? "حدث خطأ غير متوقع.";
}

<div class="container text-center py-5" dir="rtl">

    <!-- أيقونة الخطأ -->
    <div class="error-icon-wrapper mx-auto mb-4">
        <div class="error-icon-animation">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
    </div>

    <!-- عنوان -->
    <h2 class="fw-bold text-danger mb-3">
        ⚠️ يوجد مشكلة
    </h2>

    <!-- نص الرسالة -->
    <p class="fs-5 text-secondary mb-4">
        @msg
    </p>

    <!-- زر العودة -->
    <a asp-action="AllExams" asp-controller="StudentExamDashboard" asp-area="Students"
       class="btn btn-lg btn-primary rounded-pill px-4 shadow">
        <i class="fa-solid fa-arrow-right me-2"></i>
        العودة لقائمة الاختبارات
    </a>

</div>

<!-- CSS -->
<style>
    .error-icon-wrapper {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        background: #ffecec;
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        animation: floatIcon 2.5s ease-in-out infinite;
    }

    .error-icon-animation i {
        font-size: 60px;
        color: #d9534f;
        text-shadow: 0 0 8px rgba(217, 83, 79, 0.4);
    }

    @@keyframes floatIcon {
        0%

    {
        transform: translateY(0px);
    }

    50% {
        transform: translateY(-10px);
    }

    100% {
        transform: translateY(0px);
    }

    }

    p {
        line-height: 1.8;
    }

    .btn-primary {
        background-color: #1ba098 !important;
        border-color: #1ba098 !important;
    }
</style>
