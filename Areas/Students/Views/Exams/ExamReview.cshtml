@model QdratNew.ViewModels.Exam.ExamReviewViewModel
@using QdratNew.Entities
@using QdratNew.Helpers
<style>
    .option-box {
        border: 1px solid #ccc;
        border-radius: 5px;
        padding: 10px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .option-correct {
        background-color: #d4edda; /* أخضر فاتح */
        border-color: #28a745; /* أخضر */
    }
    .option-wrong {
        background-color: #f8d7da; /* أحمر فاتح */
        border-color: #dc3545; /* أحمر */
    }
    .option-image {
        max-height: 50px;
        max-width: 50px;
    }
</style>

<div class="container py-4">

    <!-- 📘 العنوان -->
    <div class="text-center mb-4">
        <h3 class="fw-bold text-primary">📘 مراجعة أسئلة الاختبار</h3>
        <h5 class="text-secondary">@Model.ExamTitle</h5>
        <p class="text-muted">
            <i class="bi bi-clock"></i> الوقت المستغرق:
            <strong class="text-dark">@Model.TimeSpentFormatted</strong>
        </p>
    </div>

    <!-- ✅ كروت الإحصائيات -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6>إجمالي الأسئلة</h6>
                    <h3>@NumberHelper.ToIndicNumbersSafe(Model.TotalQuestions.ToString())</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card text-center shadow-sm">
                <div class="card-body text-success">
                    <h6>إجابات صحيحة</h6>
                    <h3>@NumberHelper.ToIndicNumbersSafe(Model.CorrectAnswers.ToString())</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card text-center shadow-sm">
                <div class="card-body text-danger">
                    <h6>إجابات خاطئة</h6>
                    <h3>@NumberHelper.ToIndicNumbersSafe(Model.WrongAnswers.ToString())</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card text-center shadow-sm">
                <div class="card-body text-warning">
                    <h6>أسئلة متخطاة</h6>
                    <h3>@NumberHelper.ToIndicNumbersSafe(Model.SkippedQuestions.ToString())</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- 🔸 الأسئلة -->
    <div class="row g-3">
        @foreach (var q in Model.Questions)
        {
            Func<string, string> convert = s => q.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(s) : s;

            <div class="col-md-6">
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-qdrat-soft text-dark fw-bold">
                        @Html.Raw(convert(q.QuestionTitle))
                    </div>
                    <div class="card-body">

                        <!-- القطعة النصية -->
                        @if (!string.IsNullOrWhiteSpace(q.VerbalPassageContent))
                        {
                            <div class="alert alert-light border mb-3">
                                <strong>📘 @q.VerbalPassageTitle</strong><br />
                                <div class="mt-2">@Html.Raw(convert(q.VerbalPassageContent))</div>
                            </div>
                        }

                        <!-- صورة السؤال -->
                        @if (!string.IsNullOrWhiteSpace(q.ImageUrl))
                        {
                            <div class="text-center mb-3">
                                <img src="@Url.Content(q.ImageUrl)" class="img-fluid" style="max-height: 200px;" />
                            </div>
                        }

                        <!-- عرض القيم المقارنة -->
                        @if (q.DisplayType == QdratNew.Enums.QuestionDisplayType.ComparisonText)
                        {
                            <div class="row mb-3 text-center">
                                <div class="col-md-6 border-end">
                                    <strong>القيمة الأولى:</strong>
                                    <div>@Html.Raw(convert(q.ComparisonValue1))</div>
                                </div>
                                <div class="col-md-6">
                                    <strong>القيمة الثانية:</strong>
                                    <div>@Html.Raw(convert(q.ComparisonValue2))</div>
                                </div>
                            </div>
                        }
                        else if (q.DisplayType == QdratNew.Enums.QuestionDisplayType.ComparisonWithImage)
                        {
                            <div class="row mb-3 text-center align-items-center">
                                <div class="col-md-4">
                                    <img src="@Url.Content(q.ImageUrl)" class="img-fluid" style="max-height: 150px;" />
                                </div>
                                <div class="col-md-4 border-end">
                                    <strong>القيمة الأولى:</strong>
                                    <div>@Html.Raw(convert(q.ComparisonValue1))</div>
                                </div>
                                <div class="col-md-4">
                                    <strong>القيمة الثانية:</strong>
                                    <div>@Html.Raw(convert(q.ComparisonValue2))</div>
                                </div>
                            </div>
                        }

                        <!-- الاختيارات -->
                        <!-- الاختيارات -->
                        @if (q.Options != null && q.Options.Any())
                        {
                            <div class="options-container mb-3">
                                @foreach (var option in q.Options)
                                {
                                    var cssClass = "";

                                    if (option.IsCorrect)
                                    {
                                        cssClass = "option-correct";   // الإجابة الصحيحة
                                    }
                                    else if (option.IsSelectedByStudent)
                                    {
                                        cssClass = "option-wrong";     // اختيار الطالب الخاطئ
                                    }

                                    <div class="option-box @cssClass">

                                        @if (!string.IsNullOrEmpty(option.ImageUrl))
                                        {
                                            <img src="@Url.Content(option.ImageUrl)"
                                                 class="option-image mb-2" />
                                        }

                                        <span>
                                            @Html.Raw(
                                            q.IsQuantitative
                                            ? NumberHelper.ToIndicNumbersSafe(option.Text)
                                                                : option.Text
                                                                )
                            </span>
                        </div>
                                                }
                            </div>
                        }







                        <p>
                            <strong>النتيجة:</strong>
                            <span class="@(q.IsCorrect ? "text-success" : "text-danger") fw-bold">
                                @(q.IsCorrect ? "✔️ صحيح" : "❌ خطأ")
                            </span>
                        </p>

                        <!-- الوقت على السؤال -->
                        @{
                            int qMinutes = (int)(q.TimeTakenSeconds / 60);
                            int qSeconds = (int)(q.TimeTakenSeconds % 60);
                        }
                  @*       <p>
                            <strong>⏱️ الوقت:</strong>
                            @if (qMinutes > 0)
                            {
                                @NumberHelper.ToIndicNumbersSafe(qMinutes.ToString()) <text> دقيقة</text>
                            }
                            @if (qSeconds > 0)
                            {
                                <span class="text-muted">
                                    @NumberHelper.ToIndicNumbersSafe(qSeconds.ToString()) <text> ثانية</text>
                                </span>
                            }
                        </p> *@
                    </div>
                </div>
                <hr />
            </div>
        }
    </div>

    <!-- زر الرجوع -->
    <div class="text-center mt-4">
        <a asp-action="ExamResult" asp-route-id="@Model.ExamAssignmentId" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-2"></i> العودة إلى النتيجة
        </a>
    </div>
</div>
