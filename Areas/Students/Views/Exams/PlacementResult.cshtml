@model QdratNew.ViewModels.Students.PlacementExamResultVm

@{
    ViewData["Title"] = "نتيجة اختبار تحديد المستوى";

    var score = Model.Score;
    var tone = QdratNew.Helpers.ResultToneHelper.Build(score, QdratNew.Helpers.ResultContext.Placement);
    string performanceMessage = tone.Title + " — " + tone.Subtitle;
    string performanceIcon = tone.IconCss;
}

<div class="container py-5">
    <div class="card border-0 shadow-lg p-4 rounded-4 bg-light">
        <!-- 🟦 العنوان -->
        <div class="text-center mb-5">
            <h2 class="fw-bold text-primary mb-2">
                <i class="bi bi-bar-chart-fill"></i> نتيجة اختبار تحديد المستوى
            </h2>
            <h5 class="text-secondary">@Model.ExamTitle</h5>
        </div>

        <!-- 📊 الكروت التحليلية -->
        <div class="row text-center mb-4">
            <div class="col-md-3 mb-3">
                <div class="card border-0 shadow-sm rounded-4 bg-white">
                    <div class="card-body">
                        <h6 class="text-muted">عدد الأسئلة الكلي</h6>
                        <h3 class="fw-bold text-dark">@Model.TotalQuestions</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card border-0 shadow-sm rounded-4 bg-white">
                    <div class="card-body">
                        <h6 class="text-muted">الإجابات الصحيحة</h6>
                        <h3 class="fw-bold text-success">@Model.CorrectAnswers</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card border-0 shadow-sm rounded-4 bg-white">
                    <div class="card-body">
                        <h6 class="text-muted">الأسئلة المجاب عنها</h6>
                        <h3 class="fw-bold text-primary">@Model.AnsweredQuestions</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card border-0 shadow-sm rounded-4 bg-white">
                    <div class="card-body">
                        <h6 class="text-muted">الأسئلة المتخطاة</h6>
                        <h3 class="fw-bold text-danger">@Model.SkippedQuestions</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- 🔹 شريط التقدم للنتيجة -->
        <div class="text-center mb-4">
            <h5 class="fw-bold mb-3">النتيجة المئوية</h5>
            <div class="progress mx-auto" style="height: 30px; max-width: 400px;">
                <div class="progress-bar text-white fw-bold"
                     role="progressbar"
                     style="width:@Model.Score%; background: linear-gradient(90deg, #007bff, #00bcd4);"
                     aria-valuenow="@Model.Score" aria-valuemin="0" aria-valuemax="100">
                    @Model.Score %
                </div>
            </div>
        </div>

        <!-- ⏱ الوقت المستغرق -->
        @if (!string.IsNullOrEmpty(Model.TimeSpentFormatted))
        {
            <div class="text-center mb-4">
                <h5 class="fw-bold text-dark">
                    ⏱ الوقت المستغرق:
                    <span class="text-primary">@Model.TimeSpentFormatted</span>
                </h5>
            </div>
        }

        <!-- 🧠 رسالة ذكية -->
        <div class="alert alert-light shadow-sm border-start border-4 border-primary rounded-4 py-3 px-4 text-center mb-4">
            <i class="bi @performanceIcon fs-3 me-2"></i>
            <span class="fw-bold">@performanceMessage</span>
        </div>

        <!-- 🔹 تفاصيل الوقت -->
        <div class="text-center text-muted">
            <p>
                <b>📅 تاريخ الإرسال:</b> @Model.AssignedAt.ToString("yyyy-MM-dd HH:mm")<br />
                <b>📥 تاريخ التسليم:</b> @(Model.SubmittedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")
            </p>
        </div>

        <!-- 🔹 زر التفاصيل -->
        <div class="text-center mt-4">
            <a asp-action="PlacementReview" asp-route-assignmentId="@Context.Request.Query["assignmentId"]"
               class="btn btn-outline-primary btn-lg rounded-pill shadow-sm px-5">
                عرض تفاصيل الأسئلة
            </a>
        </div>
    </div>
</div>

<!-- 🎨 CSS -->
<style>
    .card-body h3 {
        font-size: 1.8rem;
    }

    .card-body h6 {
        font-weight: 600;
        font-size: 0.9rem;
    }

    .progress {
        border-radius: 20px;
        overflow: hidden;
        background-color: #e9ecef;
    }

    .progress-bar {
        transition: width 1s ease-in-out;
        font-size: 1.1rem;
    }

    .alert-light {
        background-color: #f8f9fa;
    }

    @@media (max-width: 768px) {
        .card-body h3 {
            font-size: 1.4rem;
        }
    }
</style> 