@model QdratNew.ViewModels.Exam.StudentExamDashboardViewModel
@using System.Text.Json

<!-- Course Switcher wrapped in dark bar so white text is readable -->
<div class="ex-switcher-bar">
    @await Component.InvokeAsync("StudentCourseSwitcher")
</div>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    /* ── Course Switcher bar ─────────────────────── */
    .ex-switcher-bar {
        background: linear-gradient(135deg,#0f1f3d 0%,#1a3a5c 100%);
        border-bottom: 1px solid rgba(255,255,255,.08);
        padding: 0 4px;
    }

    :root {
        --ex-bg: #f7f9fc;
        --ex-card: #ffffff;
        --ex-teal: #2e9e9e;
        --ex-teal2: #1d7b7b;
        --ex-teal-a: rgba(46,158,158,.12);
        --ex-orange: #e07849;
        --ex-orange-a: rgba(224,120,73,.12);
        --ex-green: #22c55e;
        --ex-green-a: rgba(34,197,94,.12);
        --ex-red: #ef4444;
        --ex-red-a: rgba(239,68,68,.12);
        --ex-amber: #f59e0b;
        --ex-amber-a: rgba(245,158,11,.12);
        --ex-blue: #3b82f6;
        --ex-blue-a: rgba(59,130,246,.12);
        --ex-ink: #1e293b;
        --ex-muted: #475569;
        --ex-line: rgba(0,0,0,.07);
        --ex-radius: 14px;
        --ex-shadow: 0 2px 16px rgba(0,0,0,.07);
        --ex-shadow-lg: 0 8px 32px rgba(0,0,0,.13);
        --ex-ease: .3s cubic-bezier(.4,0,.2,1);
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .ex {
        font-family: 'Cairo', sans-serif;
        direction: rtl;
        background: var(--ex-bg);
        padding: 24px 20px 60px;
        min-height: 100vh;
    }

    /* ── TOP HERO ROW ─────────────────────────────── */
    .ex-top {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 20px;
        margin-bottom: 20px;
        align-items: stretch;
    }

    .ex-ring-card {
        background: linear-gradient(145deg,#0f1f3d 0%,#1a3a5c 60%,#103545 100%);
        border-radius: 20px;
        padding: 32px 36px;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        gap: 36px;
    }

        .ex-ring-card::before {
            content: '';
            position: absolute;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            background: radial-gradient(circle,rgba(46,158,158,.15) 0%,transparent 65%);
            top: -120px;
            left: -80px;
            pointer-events: none;
        }

        .ex-ring-card::after {
            content: '';
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: radial-gradient(circle,rgba(224,120,73,.1) 0%,transparent 65%);
            bottom: -100px;
            right: -60px;
            pointer-events: none;
        }

    .ex-ring-svg-wrap {
        position: relative;
        flex-shrink: 0;
        z-index: 1;
    }

    .ex-ring-svg {
        transform: rotate(-90deg);
        overflow: visible;
    }

    .ex-ring-track {
        fill: none;
        stroke: rgba(255,255,255,.1);
        stroke-width: 10;
    }

    .ex-ring-fill {
        fill: none;
        stroke: var(--ex-teal);
        stroke-width: 10;
        stroke-linecap: round;
        stroke-dasharray: 314;
        stroke-dashoffset: 314;
        transition: stroke-dashoffset 1.4s cubic-bezier(.4,0,.2,1);
        filter: drop-shadow(0 0 8px rgba(46,158,158,.6));
    }

    .ex-ring-center {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .ex-ring-pct {
        font-size: 2rem;
        font-weight: 900;
        color: #fff;
        line-height: 1;
    }

    .ex-ring-lbl {
        font-size: .7rem;
        color: rgba(255,255,255,.55);
        margin-top: 2px;
        font-weight: 600;
    }

    .ex-ring-info {
        flex: 1;
        z-index: 1;
    }

        .ex-ring-info h2 {
            font-size: 1.5rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: 6px;
        }

        .ex-ring-info p {
            font-size: .85rem;
            color: rgba(255,255,255,.6);
            line-height: 1.65;
            max-width: 540px;
            margin-bottom: 24px;
        }

    .ex-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .ex-chip {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 50px;
        padding: 7px 16px;
        color: rgba(255,255,255,.85);
        font-size: .8rem;
        font-weight: 700;
        text-decoration: none;
        transition: background var(--ex-ease),border-color var(--ex-ease),transform var(--ex-ease);
        backdrop-filter: blur(6px);
    }

        .ex-chip:hover {
            background: rgba(255,255,255,.16);
            text-decoration: none;
            color: #fff;
            transform: translateY(-2px);
        }

    .ex-chip-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    /* Side stats */
    .ex-side-stats {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .ex-sstat {
        background: var(--ex-card);
        border-radius: var(--ex-radius);
        border: 1px solid var(--ex-line);
        box-shadow: var(--ex-shadow);
        padding: 16px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        text-decoration: none;
        transition: transform var(--ex-ease),box-shadow var(--ex-ease);
        position: relative;
        overflow: hidden;
    }

        .ex-sstat::after {
            content: '';
            position: absolute;
            right: 0;
            top: 0;
            bottom: 0;
            width: 3px;
            border-radius: 0 var(--ex-radius) var(--ex-radius) 0;
        }

        .ex-sstat:hover {
            transform: translateX(-4px);
            box-shadow: var(--ex-shadow-lg);
            text-decoration: none;
        }

        .ex-sstat.ss-total::after {
            background: var(--ex-teal);
        }

        .ex-sstat.ss-done::after {
            background: var(--ex-green);
        }

        .ex-sstat.ss-pending::after {
            background: var(--ex-amber);
        }

        .ex-sstat.ss-late::after {
            background: var(--ex-red);
        }

    .ex-sstat-ico {
        width: 40px;
        height: 40px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .ss-total .ex-sstat-ico {
        background: var(--ex-teal-a);
        color: var(--ex-teal);
    }

    .ss-done .ex-sstat-ico {
        background: var(--ex-green-a);
        color: var(--ex-green);
    }

    .ss-pending .ex-sstat-ico {
        background: var(--ex-amber-a);
        color: var(--ex-amber);
    }

    .ss-late .ex-sstat-ico {
        background: var(--ex-red-a);
        color: var(--ex-red);
    }

    .ex-sstat-body {
        flex: 1;
    }

        .ex-sstat-body strong {
            display: block;
            font-size: 1.5rem;
            font-weight: 900;
            line-height: 1;
        }

    .ss-total .ex-sstat-body strong {
        color: var(--ex-teal);
    }

    .ss-done .ex-sstat-body strong {
        color: var(--ex-green);
    }

    .ss-pending .ex-sstat-body strong {
        color: var(--ex-amber);
    }

    .ss-late .ex-sstat-body strong {
        color: var(--ex-red);
    }

    .ex-sstat-body span {
        font-size: .78rem;
        color: var(--ex-muted);
        font-weight: 600;
    }

    .ex-sstat-bar {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
    }

    /* ── Insight Cards ───────────────────────────── */
    .ex-insights {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .ex-insight-card {
        background: var(--ex-card);
        border-radius: 18px;
        border: 1px solid var(--ex-line);
        box-shadow: var(--ex-shadow);
        overflow: hidden;
        transition: transform var(--ex-ease), box-shadow var(--ex-ease), border-color var(--ex-ease);
    }

        .ex-insight-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--ex-shadow-lg);
        }

        .ex-insight-card.weak {
            border-top: 4px solid var(--ex-amber);
        }

        .ex-insight-card.errors {
            border-top: 4px solid var(--ex-red);
        }

    .ex-insight-head {
        padding: 18px 22px;
        display: flex;
        align-items: center;
        gap: 14px;
        border-bottom: 1px solid var(--ex-line);
        background: #fafbfc;
    }

    .ex-insight-ico {
        width: 44px;
        height: 44px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .ex-insight-card.weak .ex-insight-ico {
        background: var(--ex-amber-a);
        color: var(--ex-amber);
    }

    .ex-insight-card.errors .ex-insight-ico {
        background: var(--ex-red-a);
        color: var(--ex-red);
    }

    .ex-insight-head h3 {
        font-size: .95rem;
        font-weight: 900;
        color: var(--ex-ink);
        margin: 0 0 3px;
    }

    .ex-insight-head p {
        font-size: .76rem;
        font-weight: 600;
        color: var(--ex-muted);
        margin: 0;
    }

    .ex-insight-body {
        padding: 18px 22px;
        min-height: 145px;
    }

    .ex-mini-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .ex-mini-row {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #f8fafc;
        border: 1px solid var(--ex-line);
        border-radius: 12px;
        padding: 10px 12px;
    }

    .ex-mini-rank {
        width: 28px;
        height: 28px;
        border-radius: 9px;
        background: rgba(15,31,61,.08);
        color: var(--ex-ink);
        font-size: .75rem;
        font-weight: 900;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .ex-mini-info {
        flex: 1;
        min-width: 0;
    }

    .ex-mini-title {
        display: block;
        font-size: .8rem;
        font-weight: 800;
        color: var(--ex-ink);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ex-mini-sub {
        display: block;
        font-size: .7rem;
        color: var(--ex-muted);
        font-weight: 600;
        margin-top: 2px;
    }

    .ex-mini-score {
        font-size: .85rem;
        font-weight: 900;
        flex-shrink: 0;
    }

    .ex-insight-card.weak .ex-mini-score {
        color: var(--ex-amber);
    }

    .ex-insight-card.errors .ex-mini-score {
        color: var(--ex-red);
    }

    .ex-mini-empty {
        min-height: 105px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: var(--ex-muted);
        font-size: .82rem;
        font-weight: 700;
        text-align: center;
    }

        .ex-mini-empty i {
            font-size: 1.4rem;
            opacity: .45;
        }

    /* ── ANALYTICS PANEL ─────────────────────────── */
    .ex-panel {
        background: var(--ex-card);
        border-radius: 20px;
        border: 1px solid var(--ex-line);
        box-shadow: var(--ex-shadow);
        overflow: hidden;
        margin-bottom: 20px;
    }

    .ex-panel-head {
        display: flex;
        align-items: stretch;
        border-bottom: 1px solid var(--ex-line);
    }

    .ex-panel-tabs {
        display: flex;
        flex: 1;
        overflow-x: auto;
        scrollbar-width: none;
    }

        .ex-panel-tabs::-webkit-scrollbar {
            display: none;
        }

    .ex-ptab {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 16px 22px;
        border: none;
        background: transparent;
        font-family: 'Cairo',sans-serif;
        font-size: .85rem;
        font-weight: 700;
        color: var(--ex-muted);
        cursor: pointer;
        white-space: nowrap;
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
        transition: color var(--ex-ease),border-color var(--ex-ease);
    }

        .ex-ptab .ptab-ico {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .8rem;
            background: var(--ex-line);
            color: var(--ex-muted);
            transition: background var(--ex-ease),color var(--ex-ease);
        }

        .ex-ptab:hover {
            color: var(--ex-teal);
        }

            .ex-ptab:hover .ptab-ico {
                background: var(--ex-teal-a);
                color: var(--ex-teal);
            }

        .ex-ptab.active {
            color: var(--ex-teal);
            border-bottom-color: var(--ex-teal);
        }

            .ex-ptab.active .ptab-ico {
                background: var(--ex-teal-a);
                color: var(--ex-teal);
            }

    .ex-panel-filter {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        border-bottom: 1px solid var(--ex-line);
        overflow-x: auto;
        scrollbar-width: none;
        background: #fafbfc;
    }

        .ex-panel-filter::-webkit-scrollbar {
            display: none;
        }

    .ex-filter-lbl {
        font-size: .72rem;
        font-weight: 800;
        color: var(--ex-muted);
        white-space: nowrap;
        margin-left: 4px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .ex-pill {
        padding: 5px 14px;
        border-radius: 50px;
        border: 1.5px solid var(--ex-line);
        background: transparent;
        font-family: 'Cairo',sans-serif;
        font-size: .78rem;
        font-weight: 700;
        color: var(--ex-muted);
        cursor: pointer;
        white-space: nowrap;
        transition: all var(--ex-ease);
    }

        .ex-pill:hover {
            border-color: var(--ex-teal);
            color: var(--ex-teal);
        }

        .ex-pill.active {
            background: var(--ex-teal);
            border-color: var(--ex-teal);
            color: #fff;
            box-shadow: 0 3px 10px rgba(46,158,158,.35);
        }

    .ex-panel-body {
        padding: 28px 24px;
        position: relative;
        min-height: 360px;
    }

    .ex-chart-pane {
        display: none;
    }

        .ex-chart-pane.active {
            display: block;
            animation: fadeInPane .3s ease;
        }

    @@keyframes fadeInPane {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .ex-panel-body.loading::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(255,255,255,.75);
        backdrop-filter: blur(3px);
        border-radius: 0 0 20px 20px;
        z-index: 9;
    }

    .ex-panel-body.loading::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%);
        width: 36px;
        height: 36px;
        border: 3px solid var(--ex-teal-a);
        border-top-color: var(--ex-teal);
        border-radius: 50%;
        animation: spin .7s linear infinite;
        z-index: 10;
    }

    @@keyframes spin {
        to {
            transform: translate(-50%,-50%) rotate(360deg);
        }
    }

    /* ── AI RECOMMENDATIONS ──────────────────────── */
    .ex-ai {
        margin-bottom: 20px;
    }

    .ex-ai-top {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
    }

        .ex-ai-top h3 {
            font-size: 1rem;
            font-weight: 800;
            color: var(--ex-ink);
            margin: 0;
        }

    .ex-ai-badge {
        font-size: .7rem;
        font-weight: 800;
        padding: 3px 10px;
        border-radius: 50px;
        background: linear-gradient(90deg,var(--ex-teal),#1fa8a8);
        color: #fff;
    }

    .ex-ai-summary-card {
        background: linear-gradient(135deg,#0f1f3d 0%,#173550 100%);
        border-radius: 16px;
        padding: 24px 28px;
        margin-bottom: 14px;
        display: flex;
        align-items: flex-start;
        gap: 20px;
    }

    .ex-ai-sum-left {
        flex-shrink: 0;
    }

    .ex-ai-sum-ico {
        width: 52px;
        height: 52px;
        background: rgba(46,158,158,.2);
        border: 1.5px solid rgba(46,158,158,.4);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
    }

    .ex-ai-sum-right p {
        font-size: .9rem;
        font-weight: 600;
        color: rgba(255,255,255,.85);
        line-height: 1.7;
        margin: 0;
    }

    .ex-ai-speed {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(46,158,158,.2);
        border: 1px solid rgba(46,158,158,.35);
        border-radius: 50px;
        padding: 5px 14px;
        color: var(--ex-teal);
        font-size: .78rem;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .ex-ai-speed-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--ex-teal);
        animation: pulse 1.4s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: .4;
            transform: scale(.7);
        }
    }

    .ex-tips-scroll {
        display: flex;
        gap: 14px;
        overflow-x: auto;
        padding-bottom: 8px;
        scrollbar-width: thin;
        scrollbar-color: var(--ex-line) transparent;
    }

        .ex-tips-scroll::-webkit-scrollbar {
            height: 4px;
        }

        .ex-tips-scroll::-webkit-scrollbar-track {
            background: transparent;
        }

        .ex-tips-scroll::-webkit-scrollbar-thumb {
            background: var(--ex-line);
            border-radius: 99px;
        }

    .ex-tip-card {
        flex-shrink: 0;
        width: 270px;
        background: var(--ex-card);
        border-radius: 14px;
        border: 1px solid var(--ex-line);
        box-shadow: var(--ex-shadow);
        padding: 18px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        transition: transform var(--ex-ease),box-shadow var(--ex-ease),border-color var(--ex-ease);
    }

        .ex-tip-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--ex-shadow-lg);
            border-color: rgba(46,158,158,.25);
        }

    .ex-tip-num {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: var(--ex-teal-a);
        color: var(--ex-teal);
        font-size: .75rem;
        font-weight: 900;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .ex-tip-text {
        font-size: .83rem;
        color: var(--ex-muted);
        line-height: 1.65;
        margin: 0;
    }

    .ex-empty {
        text-align: center;
        padding: 48px;
        color: var(--ex-muted);
        background: var(--ex-card);
        border: 1px solid var(--ex-line);
        box-shadow: var(--ex-shadow);
        border-radius: 16px;
    }

        .ex-empty .ico {
            font-size: 2.8rem;
            opacity: .35;
            margin-bottom: 12px;
        }

        .ex-empty p {
            font-size: .9rem;
            margin: 0;
        }

    /* ── Entrance ───────────────────────────────── */
    .fu {
        opacity: 0;
        transform: translateY(20px);
        animation: fu .5s ease forwards;
    }

    @@keyframes fu {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .d1 {
        animation-delay: .04s;
    }

    .d2 {
        animation-delay: .1s;
    }

    .d3 {
        animation-delay: .18s;
    }

    .d4 {
        animation-delay: .26s;
    }

    @@media(max-width:960px) {
        .ex-top {
            grid-template-columns: 1fr;
        }

        .ex-side-stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media(max-width:800px) {
        .ex-insights {
            grid-template-columns: 1fr;
        }
    }

    @@media(max-width:600px) {
        .ex {
            padding: 16px 12px 48px;
        }

        .ex-ring-card {
            flex-direction: column;
            align-items: flex-start;
            padding: 24px 20px;
        }

        .ex-side-stats {
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .ex-tip-card {
            width: 235px;
        }

        .ex-panel-body {
            padding: 20px 14px;
        }

        .ex-insight-head {
            padding: 16px 18px;
        }

        .ex-insight-body {
            padding: 16px 18px;
        }
    }

    /* ── Active Insight Cards ───────────────────── */
    .ex-insight-card.clickable {
        cursor: pointer;
    }

