            <button type="button" class="ex-pill active" onclick="selectExamCurriculum(this,0)">
                كل المناهج
            </button>

            @if (Model.Curriculumes != null)
            {
                foreach (var curriculum in Model.Curriculumes)
                {
                    <button type="button" class="ex-pill" onclick="selectExamCurriculum(this,@curriculum.Id)">
                        @curriculum.Title
                    </button>
                }
            }
        </div>

        <div class="ex-panel-body" id="ex-panel-body">
            <div class="ex-chart-pane active" id="tab-ex-radar">
                <canvas id="radarChart" style="max-height:380px"></canvas>
            </div>

            <div class="ex-chart-pane" id="tab-ex-progress">
                <canvas id="examProgressChart" style="max-height:340px"></canvas>
            </div>

            <div class="ex-chart-pane" id="tab-ex-compare">
                <canvas id="examComparisonChart" style="max-height:340px"></canvas>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════════
         AI RECOMMENDATIONS
    ═══════════════════════════════════════════ -->
    <div class="ex-ai fu d4">
        <div class="ex-ai-top">
            <h3>
                <i class="fa-solid fa-brain" style="color:var(--ex-teal);margin-left:6px"></i>
                توصيات ذكية للاختبارات
            </h3>
            <span class="ex-ai-badge">AI</span>
        </div>

        <div id="recommendationsContainer">
            @if (initialRecommendations.Any())
            {
                <div class="ex-ai-summary-card">
                    <div class="ex-ai-sum-left">
                        <div class="ex-ai-sum-ico">🧠</div>
                    </div>
                    <div class="ex-ai-sum-right">
                        <div class="ex-ai-speed">
                            <span class="ex-ai-speed-dot"></span>
                            تحليل مبني على نتائج الاختبارات
                        </div>
                        <p>
                            راقب المحاور الأقل أداءً وابدأ بمراجعتها قبل الدخول في الاختبارات التالية.
                        </p>
                    </div>
                </div>

                <div class="ex-tips-scroll">
                    @for (int i = 0; i < initialRecommendations.Count; i++)
                    {
                        <div class="ex-tip-card">
                            <div class="ex-tip-num">@(i + 1)</div>
                            <p class="ex-tip-text">@initialRecommendations[i]</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="ex-empty">
                    <div class="ico">🤖</div>
                    <p>لا توجد توصيات حالياً. أكمل بعض الاختبارات لتفعيل التحليل الذكي.</p>
                </div>
            }
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const EX_C = {
        teal: '#2e9e9e',
        tealS: 'rgba(46,158,158,.18)',
        tealSS: 'rgba(46,158,158,.07)',
        orange: '#e07849',
        orangeS: 'rgba(224,120,73,.22)',
        green: '#22c55e',
        greenS: 'rgba(34,197,94,.18)',
        navy: '#1e293b',
        gray: '#475569',
        gridLine: 'rgba(0,0,0,.06)'
    };

    document.querySelectorAll('[data-count]').forEach(function (el) {
        const target = Number(el.dataset.count || 0);

        if (!target) {
            el.textContent = '0';
            return;
        }

        let current = 0;
        const step = Math.ceil(target / 40);

        const id = setInterval(function () {
            current = Math.min(current + step, target);
            el.textContent = current;

            if (current >= target) {
                clearInterval(id);
            }
        }, 28);
    });

    (function () {
        const fill = document.getElementById('examRingFill');

        if (!fill) {
            return;
        }

        const pct = @pct;
        const target = 314 - (pct / 100) * 314;

        fill.style.strokeDashoffset = 314;

        requestAnimationFrame(function () {
            requestAnimationFrame(function () {
                fill.style.transition = 'stroke-dashoffset 1.4s cubic-bezier(.4,0,.2,1)';
                fill.style.strokeDashoffset = target;
            });
        });
    })();

    let examCharts = {
        radar: null,
        progress: null,
        compare: null
    };

    function switchExamTab(btn, paneId) {
        document.querySelectorAll('.ex-ptab').forEach(function (b) {
            b.classList.remove('active');
        });

        document.querySelectorAll('.ex-chart-pane').forEach(function (pane) {
            pane.classList.remove('active');
        });

        btn.classList.add('active');

        const pane = document.getElementById(paneId);

        if (pane) {
            pane.classList.add('active');
        }

        const map = {
            'tab-ex-radar': examCharts.radar,
            'tab-ex-progress': examCharts.progress,
            'tab-ex-compare': examCharts.compare
        };

        if (map[paneId]) {
            map[paneId].resize();
        }
    }

    function selectExamCurriculum(btn, curriculumId) {
        document.querySelectorAll('.ex-panel-filter .ex-pill').forEach(function (b) {
            b.classList.remove('active');
        });

        btn.classList.add('active');
        loadExamDashboardData(curriculumId);
    }

    function setExamLoading(on) {
        const body = document.getElementById('ex-panel-body');

        if (!body) {
            return;
        }

        body.classList.toggle('loading', on);
    }

    function renderRadarChart(labels, studentScores, batchAverages) {
        const canvas = document.getElementById('radarChart');

        if (!canvas) {
            return;
        }

        if (examCharts.radar) {
            examCharts.radar.destroy();
        }

        examCharts.radar = new Chart(canvas, {
            type: 'radar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'أداء الطالب',
                        data: studentScores,
                        backgroundColor: EX_C.tealS,
                        borderColor: EX_C.teal,
                        borderWidth: 2.5,
                        pointBackgroundColor: EX_C.teal,
                        pointBorderColor: '#fff',
                        pointRadius: 5
                    },
                    {
                        label: 'متوسط الدفعة',
                        data: batchAverages,
                        backgroundColor: EX_C.orangeS,
                        borderColor: EX_C.orange,
                        borderWidth: 2.5,
                        pointBackgroundColor: EX_C.orange,
                        pointBorderColor: '#fff',
                        pointRadius: 5
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            font: {
                                family: 'Cairo',
                                size: 12
                            },
                            padding: 20
                        }
                    }
                },
                scales: {
                    r: {
                        suggestedMin: 0,
                        suggestedMax: 100,
                        angleLines: {
                            color: 'rgba(0,0,0,.08)'
                        },
                        grid: {
                            color: 'rgba(0,0,0,.07)'
                        },
                        ticks: {
                            backdropColor: 'transparent',
                            font: {
                                family: 'Cairo',
                                size: 11
                            },
                            color: EX_C.gray,
                            stepSize: 25
                        },
                        pointLabels: {
                            font: {
                                family: 'Cairo',
                                size: 12,
                                weight: '700'
                            },
                            color: EX_C.navy
                        }
                    }
                }
            }
        });
    }

    function renderExamProgress(labels, correctAnswers, remainingQuestions) {
        const canvas = document.getElementById('examProgressChart');

        if (!canvas) {
            return;
        }

        if (examCharts.progress) {
            examCharts.progress.destroy();
        }

        examCharts.progress = new Chart(canvas, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'إجابات صحيحة',
                        data: correctAnswers,
                        backgroundColor: EX_C.green,
                        borderRadius: 7,
                        borderSkipped: false
                    },
                    {
                        label: 'إجابات خاطئة / متبقية',
                        data: remainingQuestions,
                        backgroundColor: EX_C.orangeS,
                        borderRadius: 7,
                        borderSkipped: false
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            font: {
                                family: 'Cairo',
                                size: 12
                            },
                            padding: 16
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: EX_C.gridLine
                        },
                        ticks: {
                            font: {
                                family: 'Cairo'
                            }
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        },
                        ticks: {
                            font: {
                                family: 'Cairo',
                                size: 11
                            }
                        }
                    }
                }
            }
        });
    }

    function renderExamComparison(labels, studentScores, batchScores) {
        const canvas = document.getElementById('examComparisonChart');

        if (!canvas) {
            return;
        }

        if (examCharts.compare) {
            examCharts.compare.destroy();
        }

        examCharts.compare = new Chart(canvas, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'درجة الطالب',
                        data: studentScores,
                        backgroundColor: EX_C.teal,
                        borderRadius: 7,
                        borderSkipped: false
                    },
                    {
                        label: 'متوسط الدفعة',
                        data: batchScores,
                        backgroundColor: EX_C.orange,
                        borderRadius: 7,
                        borderSkipped: false
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            font: {
                                family: 'Cairo',
                                size: 12
                            },
                            padding: 16
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100,
                        grid: {
                            color: EX_C.gridLine
                        },
                        ticks: {
                            font: {
                                family: 'Cairo'
                            }
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        },
                        ticks: {
                            font: {
                                family: 'Cairo',
                                size: 11
                            }
                        }
                    }
                }
            }
        });
    }

    function renderWeakSections(labels, studentScores) {
        const container = document.getElementById('weakSectionsContainer');

        if (!container) {
            return;
        }

        if (!labels || !studentScores || labels.length === 0 || studentScores.length === 0) {
            container.innerHTML = `
                <div class="ex-mini-empty">
                    <i class="fa-regular fa-face-smile"></i>
                    <span>لا توجد محاور ضعيفة حالياً</span>
                </div>`;
            return;
        }

        const items = labels
            .map(function (label, index) {
                return {
                    title: label,
                    score: Number(studentScores[index] || 0)
                };
            })
            .filter(function (item) {
                return item.score < 60;
            })
            .sort(function (a, b) {
                return a.score - b.score;
            })
            .slice(0, 3);

        if (items.length === 0) {
            container.innerHTML = `
                <div class="ex-mini-empty">
                    <i class="fa-solid fa-circle-check"></i>
                    <span>أداؤك جيد، لا توجد محاور حرجة أقل من 60%</span>
                </div>`;
            return;
        }

        let html = `<div class="ex-mini-list">`;

        items.forEach(function (item, index) {
            html += `
                <div class="ex-mini-row">
                    <div class="ex-mini-rank">${index + 1}</div>
                    <div class="ex-mini-info">
                        <span class="ex-mini-title">${escapeHtml(item.title)}</span>
                        <span class="ex-mini-sub">يحتاج مراجعة قبل الاختبار القادم</span>
                    </div>
                    <div class="ex-mini-score">${item.score}%</div>
                </div>`;
        });

        html += `</div>`;

        container.innerHTML = html;
    }

    function renderPreviousErrors(labels, correctAnswers, remainingQuestions) {
        const container = document.getElementById('previousErrorsContainer');

        if (!container) {
            return;
        }

        if (!labels || labels.length === 0) {
            container.innerHTML = `
                <div class="ex-mini-empty">
                    <i class="fa-regular fa-folder-open"></i>
                    <span>لا توجد أخطاء سابقة مسجلة</span>
                </div>`;
            return;
        }

        const items = labels
            .map(function (label, index) {
                const correct = Number(correctAnswers[index] || 0);
                const wrongOrRemaining = Number(remainingQuestions[index] || 0);

                return {
                    title: label,
                    errors: wrongOrRemaining,
                    correct: correct
                };
            })
            .filter(function (item) {
                return item.errors > 0;
            })
            .sort(function (a, b) {
                return b.errors - a.errors;
            })
            .slice(0, 3);

        if (items.length === 0) {
            container.innerHTML = `
                <div class="ex-mini-empty">
                    <i class="fa-solid fa-circle-check"></i>
                    <span>لا توجد أخطاء واضحة في آخر الاختبارات</span>
                </div>`;
            return;
        }

        let html = `<div class="ex-mini-list">`;

        items.forEach(function (item, index) {
            html += `
                <div class="ex-mini-row">
                    <div class="ex-mini-rank">${index + 1}</div>
                    <div class="ex-mini-info">
                        <span class="ex-mini-title">${escapeHtml(item.title)}</span>
                        <span class="ex-mini-sub">إجابات صحيحة: ${item.correct}</span>
                    </div>
                    <div class="ex-mini-score">${item.errors}</div>
                </div>`;
        });

        html += `</div>`;

        container.innerHTML = html;
    }

    function renderRecommendations(recommendations) {
        const container = document.getElementById('recommendationsContainer');

        if (!container) {
            return;
        }

        if (!recommendations || recommendations.length === 0) {
            container.innerHTML = `
                <div class="ex-empty">
                    <div class="ico">🤖</div>
                    <p>لا توجد توصيات حالياً. أكمل بعض الاختبارات لتفعيل التحليل الذكي.</p>
                </div>`;
            return;
        }

        let html = `
            <div class="ex-ai-summary-card">
                <div class="ex-ai-sum-left">
                    <div class="ex-ai-sum-ico">🧠</div>
                </div>
                <div class="ex-ai-sum-right">
                    <div class="ex-ai-speed">
                        <span class="ex-ai-speed-dot"></span>
                        تحليل مبني على نتائج الاختبارات
                    </div>
                    <p>هذه التوصيات تساعدك على تحديد المحاور التي تحتاج مراجعة قبل الاختبارات القادمة.</p>
                </div>
            </div>
            <div class="ex-tips-scroll">`;

        recommendations.forEach(function (tip, index) {
            html += `
                <div class="ex-tip-card">
                    <div class="ex-tip-num">${index + 1}</div>
                    <p class="ex-tip-text">${escapeHtml(tip)}</p>
                </div>`;
        });

        html += `</div>`;

        container.innerHTML = html;
    }

    function escapeHtml(value) {
        if (value === null || value === undefined) {
            return '';
        }

        return String(value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    // ── Extra Charts ─────────────────────────────

    let extraCharts = { donut: null, line: null, hbar: null };

    function renderDonutOverall(correctAnswers, remainingQuestions) {
        const canvas = document.getElementById('donutOverallChart');
        if (!canvas) return;
        if (extraCharts.donut) extraCharts.donut.destroy();

        const totalCorrect = (correctAnswers || []).reduce(function (s, v) { return s + v; }, 0);
        const totalWrong = (remainingQuestions || []).reduce(function (s, v) { return s + v; }, 0);

        extraCharts.donut = new Chart(canvas, {
            type: 'doughnut',
            data: {
                labels: ['إجابات صحيحة', 'إجابات خاطئة'],
                datasets: [{
                    data: [totalCorrect, totalWrong],
                    backgroundColor: [EX_C.teal, '#ef4444'],
                    borderWidth: 0,
                    hoverOffset: 8
                }]
            },
            options: {
                responsive: true,
                cutout: '68%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { font: { family: 'Cairo', size: 12 }, padding: 14 }
                    },
                    tooltip: {
                        callbacks: {
                            label: function (ctx) {
                                const total = ctx.dataset.data.reduce(function (s, v) { return s + v; }, 0);
                                const pct = total > 0 ? Math.round(ctx.parsed / total * 100) : 0;
                                return ` ${ctx.label}: ${ctx.parsed} (${pct}%)`;
                            }
                        }
                    }
                }
            }
        });
    }

    function renderLineTrend(examTitles, studentExamScores) {
        const canvas = document.getElementById('lineTrendChart');
        if (!canvas) return;
        if (extraCharts.line) extraCharts.line.destroy();

        extraCharts.line = new Chart(canvas, {
            type: 'line',
            data: {
                labels: examTitles || [],
                datasets: [{
                    label: 'درجتي',
                    data: studentExamScores || [],
                    borderColor: '#3b82f6',
                    backgroundColor: 'rgba(59,130,246,.12)',
                    fill: true,
                    tension: 0.4,
                    borderWidth: 2.5,
                    pointBackgroundColor: '#3b82f6',
                    pointBorderColor: '#fff',
                    pointRadius: 5,
                    pointHoverRadius: 7
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function (ctx) { return ` ${ctx.parsed.y}%`; }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100,
                        grid: { color: EX_C.gridLine },
                        ticks: { font: { family: 'Cairo' }, callback: function (v) { return v + '%'; } }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { font: { family: 'Cairo', size: 10 }, maxRotation: 30 }
                    }
                }
            }
        });
    }

    function renderHbarSections(sectionLabels, studentScores, batchAverages) {
        const canvas = document.getElementById('hbarSectionsChart');
        if (!canvas) return;
        if (extraCharts.hbar) extraCharts.hbar.destroy();

        extraCharts.hbar = new Chart(canvas, {
            type: 'bar',
            data: {
                labels: sectionLabels || [],
                datasets: [
                    {
                        label: 'أنا',
                        data: studentScores || [],
                        backgroundColor: EX_C.teal,
                        borderRadius: 6,
                        borderSkipped: false
                    },
                    {
                        label: 'متوسط الدفعة',
                        data: batchAverages || [],
                        backgroundColor: EX_C.orange,
                        borderRadius: 6,
                        borderSkipped: false
                    }
                ]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { font: { family: 'Cairo', size: 11 }, padding: 14 }
                    },
                    tooltip: {
                        callbacks: {
                            label: function (ctx) { return ` ${ctx.dataset.label}: ${ctx.parsed.x}%`; }
                        }
                    }
                },
                scales: {
                    x: {
                        beginAtZero: true,
                        max: 100,
                        grid: { color: EX_C.gridLine },
                        ticks: { font: { family: 'Cairo' }, callback: function (v) { return v + '%'; } }
                    },
                    y: {
                        grid: { display: false },
                        ticks: { font: { family: 'Cairo', size: 11 } }
                    }
                }
            }
        });
    }

    // ── Drawer Logic ──────────────────────────────

    let _dashboardData = null;

    function openDrawer(type) {
        const overlay = document.getElementById('drawerOverlay');
        const drawer = document.getElementById('exDrawer');
        const ico = document.getElementById('drawerHeaderIco');
        const title = document.getElementById('drawerTitle');
        const subtitle = document.getElementById('drawerSubtitle');
        const body = document.getElementById('drawerBody');
        const footer = document.getElementById('drawerFooter');

        if (type === 'weak') {
            ico.className = 'ex-drawer-header-ico amber';
            ico.innerHTML = '<i class="fa-solid fa-chart-line"></i>';
            title.textContent = 'المحاور الضعيفة — تفاصيل كاملة';
            subtitle.textContent = 'اضغط "ابدأ التدريب" لأي محور لتبدأ جلسة تدريب فورية';
            body.innerHTML = buildWeakSectionsDrawer();
            footer.style.display = 'flex';
            footer.innerHTML = `
                <span class="ex-drawer-footer-label">
                    <i class="fa-solid fa-lightbulb" style="color:var(--ex-amber);margin-left:5px"></i>
                    كل جلسة تدريب تحتوي على 45 سؤال مخصص للمحور
                </span>
                <a href="/Students/Practice/WeaknessPractice" class="ex-drawer-action primary">
                    <i class="fa-solid fa-bolt"></i>
                    تدريب شامل على كل المحاور
                </a>`;
        } else {
            ico.className = 'ex-drawer-header-ico red';
            ico.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i>';
            title.textContent = 'الأخطاء السابقة — تفاصيل كاملة';
            subtitle.textContent = 'راجع أخطاءك في كل اختبار وابدأ جلسة مراجعة فورية';
            body.innerHTML = buildErrorsDrawer();
            footer.style.display = 'flex';
            footer.innerHTML = `
                <span class="ex-drawer-footer-label">
                    <i class="fa-solid fa-rotate-right" style="color:var(--ex-red);margin-left:5px"></i>
                    الأسئلة التي راجعتها لن تظهر مرة أخرى
                </span>
                <a href="/Students/Practice/MistakePractice" class="ex-drawer-action danger">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    مراجعة كل الأخطاء السابقة
                </a>`;
        }

        overlay.classList.add('open');
        drawer.classList.add('open');
        document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
        document.getElementById('drawerOverlay').classList.remove('open');
        document.getElementById('exDrawer').classList.remove('open');
        document.body.style.overflow = '';
    }

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeDrawer();
    });

    function buildWeakSectionsDrawer() {
        if (!_dashboardData || !_dashboardData.sectionLabels || _dashboardData.sectionLabels.length === 0) {
            return `<div class="ex-drawer-empty"><i class="fa-solid fa-circle-check"></i>لا توجد بيانات محاور حتى الآن</div>`;
        }

        const items = _dashboardData.sectionLabels
            .map(function (label, i) {
                return {
                    id: Number((_dashboardData.sectionIds && _dashboardData.sectionIds[i]) || 0),
                    title: label,
                    score: Number(_dashboardData.studentScores[i] || 0),
                    avg: Number((_dashboardData.batchAverages && _dashboardData.batchAverages[i]) || 0)
                };
            })
            .sort(function (a, b) { return a.score - b.score; });

        let html = '';

        items.forEach(function (item, index) {
            const color = item.score < 40 ? '#ef4444' : item.score < 70 ? '#f59e0b' : '#22c55e';
            const badgeClass = item.score < 40 ? 'badge-danger' : item.score < 70 ? 'badge-warning' : 'badge-success';
            const badgeLabel = item.score < 40 ? 'ضعيف' : item.score < 70 ? 'متوسط' : 'ممتاز';
            const diff = Math.round(item.score - item.avg);
            const diffLabel = diff >= 0 ? `+${diff}% عن المتوسط` : `${diff}% عن المتوسط`;
            const practiceUrl = item.id > 0
                ? `/Students/Practice/StartWeaknessPractice?sectionId=${item.id}`
                : `/Students/Practice/WeaknessPractice`;
            const btnIcon = item.score < 60
                ? `<i class="fa-solid fa-fire" style="color:#fff"></i>`
                : `<i class="fa-solid fa-dumbbell" style="color:#fff"></i>`;
            const btnStyle = item.score < 40
                ? 'danger'
                : item.score < 70
                    ? 'ghost" style="background:rgba(245,158,11,.12);color:#b45309;border-color:rgba(245,158,11,.3)'
                    : 'ghost';

            html += `
                <div class="ex-drawer-item">
                    <div class="ex-drawer-item-top">
                        <div class="ex-drawer-item-rank">${index + 1}</div>
                        <div class="ex-drawer-item-title">${escapeHtml(item.title)}</div>
                        <span class="ex-drawer-item-badge ${badgeClass}">${badgeLabel}</span>
                    </div>
                    <div class="ex-drawer-progress">
                        <div class="ex-drawer-progress-fill" style="width:${item.score}%;background:${color}"></div>
                    </div>
                    <div class="ex-drawer-item-meta" style="margin-bottom:10px">
                        <span>درجتي: <strong style="color:${color}">${item.score}%</strong></span>
                        <span>متوسط الدفعة: ${item.avg}%</span>
                        <span style="color:${diff >= 0 ? '#22c55e' : '#ef4444'}">${diffLabel}</span>
                    </div>
                    <a href="${practiceUrl}" class="ex-drawer-action ${btnStyle}">
                        ${btnIcon}
                        ابدأ التدريب على هذا المحور
                    </a>
                </div>`;
        });

        return html || `<div class="ex-drawer-empty"><i class="fa-solid fa-circle-check"></i>لا توجد بيانات</div>`;
    }

    function buildErrorsDrawer() {
        if (!_dashboardData || !_dashboardData.examTitles || _dashboardData.examTitles.length === 0) {
            return `<div class="ex-drawer-empty"><i class="fa-regular fa-folder-open"></i>لا توجد أخطاء مسجلة حتى الآن</div>`;
        }

        const items = _dashboardData.examTitles
            .map(function (label, i) {
                const correct = Number(_dashboardData.correctAnswers[i] || 0);
                const wrong = Number(_dashboardData.remainingQuestions[i] || 0);
                const total = correct + wrong;
                const pct = total > 0 ? Math.round(correct / total * 100) : 0;
                return { title: label, correct, wrong, total, pct };
            })
            .sort(function (a, b) { return b.wrong - a.wrong; });

        const hasAnyErrors = items.some(function (item) { return item.wrong > 0; });

        if (!hasAnyErrors) {
            return `
                <div class="ex-drawer-empty">
                    <i class="fa-solid fa-circle-check" style="color:#22c55e;opacity:1"></i>
                    <strong style="color:#22c55e;font-size:.95rem">أداء ممتاز!</strong>
                    <p style="margin-top:6px">لا توجد أخطاء مسجلة في اختباراتك حتى الآن.</p>
                </div>`;
        }

        let html = '';

        items.forEach(function (item, index) {
            const color = item.pct < 40 ? '#ef4444' : item.pct < 70 ? '#f59e0b' : '#22c55e';
            const badgeClass = item.wrong === 0 ? 'badge-success' : item.pct < 60 ? 'badge-danger' : 'badge-warning';
            const badgeLabel = item.wrong === 0 ? 'بلا أخطاء' : `${item.wrong} خطأ`;

            const actionBtn = item.wrong > 0
                ? `<a href="/Students/Practice/MistakePractice" class="ex-drawer-action danger" style="margin-top:10px">
                       <i class="fa-solid fa-rotate-right"></i>
                       راجع أخطاء هذا الاختبار (${item.wrong})
                   </a>`
                : `<span class="ex-drawer-action ghost" style="margin-top:10px;cursor:default;pointer-events:none">
                       <i class="fa-solid fa-circle-check"></i>
                       لا توجد أخطاء في هذا الاختبار
                   </span>`;

            html += `
                <div class="ex-drawer-item">
                    <div class="ex-drawer-item-top">
                        <div class="ex-drawer-item-rank">${index + 1}</div>
                        <div class="ex-drawer-item-title">${escapeHtml(item.title)}</div>
                        <span class="ex-drawer-item-badge ${badgeClass}">${badgeLabel}</span>
                    </div>
                    <div class="ex-drawer-progress">
                        <div class="ex-drawer-progress-fill" style="width:${item.pct}%;background:${color}"></div>
                    </div>
                    <div class="ex-drawer-item-meta" style="margin-bottom:4px">
                        <span>صحيحة: <strong style="color:#22c55e">${item.correct}</strong></span>
                        <span>خاطئة: <strong style="color:#ef4444">${item.wrong}</strong></span>
                        <span>النتيجة: <strong style="color:${color}">${item.pct}%</strong></span>
                    </div>
                    ${actionBtn}
                </div>`;
        });

        return html || `<div class="ex-drawer-empty"><i class="fa-solid fa-circle-check"></i>لا توجد أخطاء</div>`;
    }

    // ── Main Load ─────────────────────────────────

    function loadExamDashboardData(curriculumId) {
        setExamLoading(true);

        fetch(`/Students/StudentExamDashboard/GetDashboardDataByCurriculum?curriculumId=${curriculumId}`)
            .then(function (response) {
                if (!response.ok) {
                    throw new Error('Failed to load exam dashboard data.');
                }

                return response.json();
            })
            .then(function (data) {
                _dashboardData = data;

                renderRadarChart(
                    data.sectionLabels || [],
                    data.studentScores || [],
                    data.batchAverages || []
                );

                renderExamProgress(
                    data.examTitles || [],
                    data.correctAnswers || [],
                    data.remainingQuestions || []
                );

                renderExamComparison(
                    data.examTitles || [],
                    data.studentExamScores || [],
                    data.batchExamScores || []
                );

                renderWeakSections(
                    data.sectionLabels || [],
                    data.studentScores || []
                );

                renderPreviousErrors(
                    data.examTitles || [],
                    data.correctAnswers || [],
                    data.remainingQuestions || []
                );

                renderRecommendations(data.recommendations || []);

                renderDonutOverall(data.correctAnswers || [], data.remainingQuestions || []);
                renderLineTrend(data.examTitles || [], data.studentExamScores || []);
                renderHbarSections(data.sectionLabels || [], data.studentScores || [], data.batchAverages || []);
            })
            .catch(function (error) {
                console.error(error);

                renderRadarChart([], [], []);
                renderExamProgress([], [], []);
                renderExamComparison([], [], []);
                renderWeakSections([], []);
                renderPreviousErrors([], [], []);
            })
            .finally(function () {
                setExamLoading(false);
            });
    }

    loadExamDashboardData(0);
</script>