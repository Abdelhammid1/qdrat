<script>
    const lateExamCards = Array.from(document.querySelectorAll('.late-exams-card'));
    let currentLateExamFilter = 'all';

    function setLateExamFilter(btn) {
        document.querySelectorAll('.late-exams-filter-btn').forEach(function (b) {
            b.classList.remove('active');
        });

        btn.classList.add('active');
        currentLateExamFilter = btn.dataset.filter;
        applyLateExamFilters();
    }

    function applyLateExamFilters() {
        const searchInput = document.getElementById('late-exams-search-input');
        const sortSelect = document.getElementById('late-exams-sort-sel');
        const grid = document.getElementById('late-exams-grid');
        const countShown = document.getElementById('late-exams-count-shown');
        const empty = document.getElementById('late-exams-empty');

        const q = searchInput ? searchInput.value.toLowerCase().trim() : '';
        const sort = sortSelect ? sortSelect.value : 'end-asc';

        let visible = lateExamCards.filter(function (card) {
            const matchFilter = currentLateExamFilter === 'all' || card.dataset.status === currentLateExamFilter;
            const matchSearch = !q || (card.dataset.title || '').indexOf(q) >= 0;

            return matchFilter && matchSearch;
        });

        visible.sort(function (a, b) {
            if (sort === 'end-asc') {
                return (a.dataset.end || '').localeCompare(b.dataset.end || '');
            }

            if (sort === 'end-desc') {
                return (b.dataset.end || '').localeCompare(a.dataset.end || '');
            }

            if (sort === 'start-asc') {
                return (a.dataset.start || '').localeCompare(b.dataset.start || '');
            }

            if (sort === 'start-desc') {
                return (b.dataset.start || '').localeCompare(a.dataset.start || '');
            }

            if (sort === 'title-asc') {
                return (a.dataset.title || '').localeCompare(b.dataset.title || '', 'ar');
            }

            return 0;
        });

        const visibleSet = new Set(visible);

        lateExamCards.forEach(function (card) {
            if (visibleSet.has(card)) {
                card.style.display = '';
                grid.appendChild(card);
            } else {
                card.style.display = 'none';
            }
        });

        if (countShown) {
            countShown.textContent = visible.length;
        }

        if (empty) {
            empty.style.display = visible.length ? 'none' : 'block';
        }
    }

    applyLateExamFilters();
</script>