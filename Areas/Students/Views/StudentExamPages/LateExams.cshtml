@model QdratNew.ViewModels.Exam.LateExamsPageVm

@{
    ViewData["Title"] = "الاختبارات المتأخرة";

    var lateExams = Model?.Late ?? new List<QdratNew.ViewModels.Exam.StudentExamCardViewModel>();
    var expiringSoonExams = Model?.ExpiringSoon ?? new List<QdratNew.ViewModels.Exam.StudentExamCardViewModel>();
    var upcomingExams = Model?.Upcoming ?? new List<QdratNew.ViewModels.Exam.StudentExamCardViewModel>();

    var totalLate = Model?.TotalLate ?? lateExams.Count;
    var totalExpiringSoon = Model?.TotalExpiringSoon ?? expiringSoonExams.Count;
    var totalUpcoming = Model?.TotalUpcoming ?? upcomingExams.Count;
    var totalAll = totalLate + totalExpiringSoon + totalUpcoming;

    var now = DateTime.Now;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --p: #2e9e9e;
        --p-d: #1d7b7b;
        --p-a: rgba(46,158,158,.12);
        --p-glow: rgba(46,158,158,.3);
        --orange: #e07849;
        --ora: rgba(224,120,73,.12);
        --green: #22c55e;
        --grna: rgba(34,197,94,.12);
        --red: #ef4444;
        --red-d: #dc2626;
        --reda: rgba(239,68,68,.12);
        --amber: #f59e0b;
        --ambera: rgba(245,158,11,.12);
        --blue: #3b82f6;
        --bluea: rgba(59,130,246,.12);
        --purple: #8b5cf6;
        --purplea: rgba(139,92,246,.12);
        --ink: #1e293b;
        --ink2: #475569;
        --ink3: #94a3b8;
        --bg: #f0f4f8;
        --card: #ffffff;
        --line: rgba(0,0,0,.07);
        --r: 16px;
        --r-sm: 10px;
        --sh: 0 2px 16px rgba(0,0,0,.07);
        --sh2: 0 8px 32px rgba(0,0,0,.13);
        --ease: .28s cubic-bezier(.4,0,.2,1);
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .late-exams-page {
        font-family: 'Cairo', sans-serif;
        direction: rtl;
        background: var(--bg);
        min-height: 100vh;
        padding: 0 0 60px;
    }

    .late-exams-switcher {
        background: linear-gradient(135deg,#0f1f3d 0%,#1a3a5c 100%);
        border-bottom: 1px solid rgba(255,255,255,.06);
        padding: 0 4px;
    }

    .late-exams-hero {
        background: linear-gradient(145deg,#3d0f18 0%,#5c1a24 42%,#1a3a5c 100%);
        padding: 28px 28px 44px;
        margin-bottom: -20px;
        position: relative;
        overflow: hidden;
    }

        .late-exams-hero::before {
            content: '';
            position: absolute;
            width: 360px;
            height: 360px;
            border-radius: 50%;
            background: radial-gradient(circle,rgba(239,68,68,.18) 0%,transparent 65%);
            top: -100px;
            left: -60px;
            pointer-events: none;
        }

        .late-exams-hero::after {
            content: '';
            position: absolute;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: radial-gradient(circle,rgba(245,158,11,.13) 0%,transparent 65%);
            bottom: -80px;
            right: -40px;
            pointer-events: none;
        }

    .late-exams-hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .late-exams-hero-ico {
        width: 52px;
        height: 52px;
        background: rgba(255,255,255,.1);
        border: 1.5px solid rgba(255,255,255,.18);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: #fff;
        backdrop-filter: blur(8px);
        flex-shrink: 0;
    }

    .late-exams-hero-text h1 {
        color: #fff;
        font-size: 1.4rem;
        font-weight: 800;
        margin: 0 0 3px;
    }

    .late-exams-hero-text p {
        color: rgba(255,255,255,.62);
        font-size: .82rem;
        margin: 0;
    }

    .late-exams-search {
        margin-right: auto;
        display: flex;
        align-items: center;
        gap: 0;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 50px;
        overflow: hidden;
        backdrop-filter: blur(8px);
        flex-shrink: 0;
    }

        .late-exams-search input {
            background: transparent;
            border: none;
            outline: none;
            padding: 9px 16px;
            color: #fff;
            font-family: 'Cairo', sans-serif;
            font-size: .85rem;
            min-width: 220px;
        }

            .late-exams-search input::placeholder {
                color: rgba(255,255,255,.45);
            }

    .late-exams-search-ico {
        padding: 0 14px;
        color: rgba(255,255,255,.5);
        font-size: .85rem;
    }

    .late-exams-hero-stats {
        position: relative;
        z-index: 1;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 16px;
    }

    .late-exams-hstat {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 50px;
        padding: 7px 18px;
        color: rgba(255,255,255,.88);
        font-size: .8rem;
        font-weight: 700;
        backdrop-filter: blur(6px);
    }

    .late-exams-hstat-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .late-exams-toolbar {
        background: var(--card);
        border-radius: 0 0 20px 20px;
        border: 1px solid var(--line);
        border-top: none;
        box-shadow: var(--sh);
        padding: 12px 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }

    .late-exams-filter-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 7px 16px;
        border-radius: 50px;
        border: 1.5px solid var(--line);
        background: transparent;
        font-family: 'Cairo', sans-serif;
        font-size: .8rem;
        font-weight: 700;
        color: var(--ink2);
        cursor: pointer;
        white-space: nowrap;
        transition: all var(--ease);
    }

        .late-exams-filter-btn:hover {
            border-color: var(--red);
            color: var(--red);
        }

        .late-exams-filter-btn.active {
            background: var(--red);
            border-color: var(--red);
            color: #fff;
            box-shadow: 0 3px 10px rgba(239,68,68,.24);
        }

        .late-exams-filter-btn .fbadge {
            background: rgba(255,255,255,.25);
            border-radius: 99px;
            padding: 1px 7px;
            font-size: .72rem;
            font-weight: 800;
        }

        .late-exams-filter-btn:not(.active) .fbadge {
            background: var(--line);
            color: var(--ink2);
        }

    .late-exams-sort {
        margin-right: auto;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .late-exams-sort label {
            font-size: .78rem;
            font-weight: 700;
            color: var(--ink2);
            white-space: nowrap;
        }

        .late-exams-sort select {
            padding: 6px 12px;
            border-radius: 8px;
            border: 1.5px solid var(--line);
            background: var(--card);
            font-family: 'Cairo', sans-serif;
            font-size: .8rem;
            color: var(--ink);
            cursor: pointer;
            outline: none;
            transition: border-color var(--ease);
        }

            .late-exams-sort select:focus {
                border-color: var(--red);
            }

    .late-exams-alert {
        background: linear-gradient(135deg,rgba(239,68,68,.10),rgba(245,158,11,.09));
        border: 1px solid rgba(239,68,68,.16);
        border-radius: var(--r);
        padding: 14px 18px;
        margin: 0 4px 16px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        box-shadow: var(--sh);
    }

    .late-exams-alert-icon {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: var(--reda);
        color: var(--red);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .late-exams-alert-title {
        font-size: .92rem;
        font-weight: 900;
        color: var(--ink);
        margin-bottom: 2px;
    }

    .late-exams-alert-text {
        font-size: .78rem;
        font-weight: 700;
        color: var(--ink2);
        margin: 0;
    }

    .late-exams-results-label {
        font-size: .78rem;
        font-weight: 700;
        color: var(--ink3);
        margin: 0 4px 14px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .late-exams-results-label b {
            color: var(--ink);
        }

    .late-exams-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(350px,1fr));
        gap: 16px;
        padding: 0 4px;
    }

    .late-exams-card {
        background: var(--card);
        border-radius: var(--r);
        border: 1px solid var(--line);
        box-shadow: var(--sh);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform var(--ease), box-shadow var(--ease), border-color var(--ease);
        animation: cardIn .4s ease both;
    }

        .late-exams-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--sh2);
            border-color: rgba(239,68,68,.24);
        }

    @@keyframes cardIn {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .late-exams-card-stripe {
        height: 3px;
        width: 100%;
    }

    .stripe-late {
        background: linear-gradient(90deg,var(--red),#f87171);
    }

    .stripe-soon {
        background: linear-gradient(90deg,var(--amber),#fcd34d);
    }

    .stripe-upcoming {
        background: linear-gradient(90deg,var(--blue),#60a5fa);
    }

    .late-exams-card-body {
        padding: 18px 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .late-exams-card-top {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .late-exams-card-ico {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        margin-top: 2px;
    }

    .ico-late {
        background: var(--reda);
        color: var(--red);
    }

    .ico-soon {
        background: var(--ambera);
        color: var(--amber);
    }

    .ico-upcoming {
        background: var(--bluea);
        color: var(--blue);
    }

    .late-exams-card-title {
        font-size: .97rem;
        font-weight: 800;
        color: var(--ink);
        line-height: 1.35;
        margin-bottom: 4px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .late-exams-card-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .late-exams-tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #f1f5f9;
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 2px 10px;
        font-size: .7rem;
        font-weight: 700;
        color: var(--ink2);
    }

        .late-exams-tag i {
            font-size: .65rem;
            opacity: .6;
        }

    .tag-individual {
        background: var(--purplea);
        color: var(--purple);
        border-color: rgba(139,92,246,.18);
    }

    .tag-batch {
        background: var(--bluea);
        color: var(--blue);
        border-color: rgba(59,130,246,.18);
    }

    .late-exams-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 50px;
        padding: 4px 12px;
        font-size: .73rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .st-late {
        background: var(--reda);
        color: #b91c1c;
    }

    .st-soon {
        background: var(--ambera);
        color: #92400e;
    }

    .st-upcoming {
        background: var(--bluea);
        color: #1d4ed8;
    }

    .late-exams-info-box {
        background: #f8fafc;
        border: 1px solid var(--line);
        border-radius: var(--r-sm);
        padding: 12px 14px;
    }

    .late-exams-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px 12px;
    }

    .late-exams-info-label {
        display: block;
        font-size: .68rem;
        font-weight: 700;
        color: var(--ink3);
        margin-bottom: 2px;
    }

    .late-exams-info-value {
        display: block;
        font-size: .76rem;
        font-weight: 900;
        color: var(--ink);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .late-exams-priority {
        background: #fff7f7;
        border: 1px solid rgba(239,68,68,.14);
        border-radius: var(--r-sm);
        padding: 12px 14px;
    }

        .late-exams-priority.soon {
            background: #fffbeb;
            border-color: rgba(245,158,11,.18);
        }

        .late-exams-priority.upcoming {
            background: #eff6ff;
            border-color: rgba(59,130,246,.18);
        }

    .late-exams-priority-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 8px;
    }

        .late-exams-priority-row:last-child {
            margin-bottom: 0;
        }

    .late-exams-priority-label {
        font-size: .72rem;
        font-weight: 700;
        color: var(--ink2);
    }

    .late-exams-priority-value {
        font-size: .78rem;
        font-weight: 900;
        color: var(--ink);
    }

    .late-exams-progress {
        height: 7px;
        border-radius: 99px;
        background: rgba(0,0,0,.06);
        overflow: hidden;
        margin-top: 8px;
    }

    .late-exams-progress-fill {
        height: 100%;
        width: 100%;
        border-radius: 99px;
    }

    .fill-late {
        background: linear-gradient(90deg,var(--red),#f87171);
    }

    .fill-soon {
        background: linear-gradient(90deg,var(--amber),#fcd34d);
    }

    .fill-upcoming {
        background: linear-gradient(90deg,var(--blue),#60a5fa);
    }

    .late-exams-card-foot {
        padding: 14px 20px;
        border-top: 1px solid var(--line);
        background: #fafbfc;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .late-exams-btn {
        flex: 1;
        min-width: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 9px 14px;
        border-radius: 10px;
        border: none;
        font-family: 'Cairo', sans-serif;
        font-size: .82rem;
        font-weight: 800;
        cursor: pointer;
        text-decoration: none;
        transition: all var(--ease);
    }

        .late-exams-btn:hover {
            text-decoration: none;
            transform: translateY(-1px);
        }

    .btn-start {
        background: var(--p);
        color: #fff;
        box-shadow: 0 3px 10px var(--p-glow);
    }

        .btn-start:hover {
            background: var(--p-d);
            color: #fff;
        }

    .btn-danger-disabled {
        background: #fff1f2;
        color: #b91c1c;
        border: 1px solid rgba(239,68,68,.18);
        cursor: not-allowed;
    }

    .btn-warning-disabled {
        background: #fffbeb;
        color: #92400e;
        border: 1px solid rgba(245,158,11,.18);
        cursor: not-allowed;
    }

    .btn-blue-disabled {
        background: #eff6ff;
        color: #1d4ed8;
        border: 1px solid rgba(59,130,246,.18);
        cursor: not-allowed;
    }

        .btn-danger-disabled:hover,
        .btn-warning-disabled:hover,
        .btn-blue-disabled:hover {
            transform: none;
        }

    .late-exams-empty {
        text-align: center;
        padding: 60px 24px;
        background: var(--card);
        border-radius: var(--r);
        border: 1px solid var(--line);
        box-shadow: var(--sh);
    }

    .late-exams-empty-ico {
        font-size: 3.5rem;
        opacity: .25;
        margin-bottom: 16px;
    }

    .late-exams-empty h3 {
        font-size: 1rem;
        font-weight: 800;
        color: var(--ink);
        margin-bottom: 6px;
    }

    .late-exams-empty p {
        font-size: .85rem;
        color: var(--ink2);
        margin: 0;
    }

    .fu {
        opacity: 0;
        transform: translateY(18px);
        animation: fu .45s ease forwards;
    }

    @@keyframes fu {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .d1 {
        animation-delay: .04s;
    }

    .d2 {
        animation-delay: .1s;
    }

    @@media(max-width:700px) {
        .late-exams-hero {
            padding: 22px 16px 40px;
        }

        .late-exams-hero-text h1 {
            font-size: 1.15rem;
        }

        .late-exams-hero-inner {
            flex-direction: column;
            align-items: flex-start;
        }

        .late-exams-search {
            width: 100%;
            margin-right: 0;
        }

            .late-exams-search input {
                min-width: 0;
                flex: 1;
            }

        .late-exams-grid {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .late-exams-sort {
            margin-right: 0;
            width: 100%;
        }

        .late-exams-toolbar {
            gap: 6px;
        }

        .late-exams-info-grid {
            grid-template-columns: 1fr;
        }

        .late-exams-card-foot {
            padding: 12px 14px;
        }

        .late-exams-alert {
            padding: 12px 14px;
        }
    }
</style>

<div class="late-exams-switcher">
    @await Component.InvokeAsync("StudentCourseSwitcher")
</div>

<div class="late-exams-page">

    <!-- HERO -->
    <div class="late-exams-hero fu">
        <div class="late-exams-hero-inner">
            <div class="late-exams-hero-ico">
                <i class="fa-solid fa-hourglass-end"></i>
            </div>

            <div class="late-exams-hero-text">
                <h1>الاختبارات المتأخرة</h1>
                <p>تابع الاختبارات التي انتهى وقتها، والتي قاربت على الانتهاء، والاختبارات القادمة.</p>
            </div>

            <div class="late-exams-search">
                <span class="late-exams-search-ico">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <input type="text"
                       id="late-exams-search-input"
                       placeholder="ابحث عن اختبار…"
                       oninput="applyLateExamFilters()">
            </div>
        </div>

        <div class="late-exams-hero-stats">
            <span class="late-exams-hstat">
                <span class="late-exams-hstat-dot" style="background:#ef4444"></span>
                متأخر: @totalLate
            </span>

            <span class="late-exams-hstat">
                <span class="late-exams-hstat-dot" style="background:#f59e0b"></span>
                سيتأخر قريبًا: @totalExpiringSoon
            </span>

            <span class="late-exams-hstat">
                <span class="late-exams-hstat-dot" style="background:#3b82f6"></span>
                قادمة: @totalUpcoming
            </span>

            <span class="late-exams-hstat">
                <span class="late-exams-hstat-dot" style="background:#2e9e9e"></span>
                الإجمالي: @totalAll
            </span>
        </div>
    </div>

    <!-- TOOLBAR -->
    <div class="late-exams-toolbar fu d1">
        <button type="button"
                class="late-exams-filter-btn active"
                data-filter="all"
                onclick="setLateExamFilter(this)">
            <i class="fa-solid fa-layer-group" style="font-size:.75rem"></i>
            الكل <span class="fbadge">@totalAll</span>
        </button>

        <button type="button"
                class="late-exams-filter-btn"
                data-filter="late"
                onclick="setLateExamFilter(this)">
            <i class="fa-solid fa-triangle-exclamation" style="font-size:.75rem"></i>
            متأخر <span class="fbadge">@totalLate</span>
        </button>

        <button type="button"
                class="late-exams-filter-btn"
                data-filter="soon"
                onclick="setLateExamFilter(this)">
            <i class="fa-solid fa-clock" style="font-size:.75rem"></i>
            سيتأخر قريبًا <span class="fbadge">@totalExpiringSoon</span>
        </button>

        <button type="button"
                class="late-exams-filter-btn"
                data-filter="upcoming"
                onclick="setLateExamFilter(this)">
            <i class="fa-solid fa-calendar-days" style="font-size:.75rem"></i>
            قادم <span class="fbadge">@totalUpcoming</span>
        </button>

        <div class="late-exams-sort">
            <label for="late-exams-sort-sel">
                <i class="fa-solid fa-arrow-up-wide-short" style="font-size:.75rem"></i>
                ترتيب:
            </label>

            <select id="late-exams-sort-sel" onchange="applyLateExamFilters()">
                <option value="end-asc">الأقرب انتهاءً</option>
                <option value="end-desc">الأبعد انتهاءً</option>
                <option value="start-asc">الأقرب بدءًا</option>
                <option value="start-desc">الأبعد بدءًا</option>
                <option value="title-asc">العنوان تصاعديًا</option>
            </select>
        </div>
    </div>

    <!-- BODY -->
