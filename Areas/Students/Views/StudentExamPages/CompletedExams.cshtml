@model List<QdratNew.ViewModels.Exam.StudentExamCardViewModel>

@{
    ViewData["Title"] = "الاختبارات المكتملة";

    var completed = (Model ?? new List<QdratNew.ViewModels.Exam.StudentExamCardViewModel>())
        .Where(x => x.IsSubmitted)
        .OrderByDescending(x => x.AssignedAt)
        .ToList();

    var total = completed.Count;

    var avgScore = completed.Any()
     ? Math.Round(completed.Average(x => Convert.ToDouble(x.Score ?? 0)), 1)
     : 0d;

    var excellent = completed.Count(x => Convert.ToDouble(x.Score ?? 0) >= 85);
    var good = completed.Count(x => Convert.ToDouble(x.Score ?? 0) >= 60 && Convert.ToDouble(x.Score ?? 0) < 85);
    var weak = completed.Count(x => Convert.ToDouble(x.Score ?? 0) < 60);

    var individual = completed.Count(x => x.IsIndividual);
    var batch = completed.Count(x => !x.IsIndividual);

    var highestScore = completed.Any()
        ? Math.Round(completed.Max(x => Convert.ToDouble(x.Score ?? 0)), 1)
        : 0d;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --p: #2e9e9e;
        --p-d: #1d7b7b;
        --p-a: rgba(46,158,158,.12);
        --p-glow: rgba(46,158,158,.3);
        --orange: #e07849;
        --ora: rgba(224,120,73,.12);
        --green: #22c55e;
        --grna: rgba(34,197,94,.12);
        --red: #ef4444;
        --reda: rgba(239,68,68,.12);
        --amber: #f59e0b;
        --ambera: rgba(245,158,11,.12);
        --purple: #8b5cf6;
        --purplea: rgba(139,92,246,.12);
        --blue: #3b82f6;
        --bluea: rgba(59,130,246,.12);
        --ink: #1e293b;
        --ink2: #475569;
        --ink3: #94a3b8;
        --bg: #f0f4f8;
        --card: #ffffff;
        --line: rgba(0,0,0,.07);
        --r: 16px;
        --r-sm: 10px;
        --sh: 0 2px 16px rgba(0,0,0,.07);
        --sh2: 0 8px 32px rgba(0,0,0,.13);
        --ease: .28s cubic-bezier(.4,0,.2,1);
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .completed-exams-page {
        font-family: 'Cairo', sans-serif;
        direction: rtl;
        background: var(--bg);
        min-height: 100vh;
        padding: 0 0 60px;
    }

    .completed-switcher {
        background: linear-gradient(135deg,#0f1f3d 0%,#1a3a5c 100%);
        border-bottom: 1px solid rgba(255,255,255,.06);
        padding: 0 4px;
    }

    .completed-hero {
        background: linear-gradient(145deg,#0f1f3d 0%,#1a3a5c 55%,#103545 100%);
        padding: 28px 28px 44px;
        margin-bottom: -20px;
        position: relative;
        overflow: hidden;
    }

        .completed-hero::before {
            content: '';
            position: absolute;
            width: 360px;
            height: 360px;
            border-radius: 50%;
            background: radial-gradient(circle,rgba(34,197,94,.16) 0%,transparent 65%);
            top: -100px;
            left: -60px;
            pointer-events: none;
        }

        .completed-hero::after {
            content: '';
            position: absolute;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: radial-gradient(circle,rgba(46,158,158,.12) 0%,transparent 65%);
            bottom: -80px;
            right: -40px;
            pointer-events: none;
        }

    .completed-hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .completed-hero-ico {
        width: 52px;
        height: 52px;
        background: rgba(255,255,255,.1);
        border: 1.5px solid rgba(255,255,255,.18);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: #fff;
        backdrop-filter: blur(8px);
        flex-shrink: 0;
    }

    .completed-hero-text h1 {
        color: #fff;
        font-size: 1.4rem;
        font-weight: 800;
        margin: 0 0 3px;
    }

    .completed-hero-text p {
        color: rgba(255,255,255,.58);
        font-size: .82rem;
        margin: 0;
    }

    .completed-search {
        margin-right: auto;
        display: flex;
        align-items: center;
        gap: 0;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 50px;
        overflow: hidden;
        backdrop-filter: blur(8px);
        flex-shrink: 0;
    }

        .completed-search input {
            background: transparent;
            border: none;
            outline: none;
            padding: 9px 16px;
            color: #fff;
            font-family: 'Cairo', sans-serif;
            font-size: .85rem;
            min-width: 220px;
        }

            .completed-search input::placeholder {
                color: rgba(255,255,255,.45);
            }

    .completed-search-ico {
        padding: 0 14px;
        color: rgba(255,255,255,.5);
        font-size: .85rem;
    }

    .completed-hero-stats {
        position: relative;
        z-index: 1;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 16px;
    }

    .completed-hstat {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 50px;
        padding: 7px 18px;
        color: rgba(255,255,255,.86);
        font-size: .8rem;
        font-weight: 700;
        backdrop-filter: blur(6px);
    }

    .completed-hstat-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .completed-toolbar {
        background: var(--card);
        border-radius: 0 0 20px 20px;
        border: 1px solid var(--line);
        border-top: none;
        box-shadow: var(--sh);
        padding: 12px 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }

    .completed-filter-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 7px 16px;
        border-radius: 50px;
        border: 1.5px solid var(--line);
        background: transparent;
        font-family: 'Cairo', sans-serif;
        font-size: .8rem;
        font-weight: 700;
        color: var(--ink2);
        cursor: pointer;
        white-space: nowrap;
        transition: all var(--ease);
    }

        .completed-filter-btn:hover {
            border-color: var(--p);
            color: var(--p);
        }

        .completed-filter-btn.active {
            background: var(--p);
            border-color: var(--p);
            color: #fff;
            box-shadow: 0 3px 10px var(--p-glow);
        }

        .completed-filter-btn .fbadge {
            background: rgba(255,255,255,.25);
            border-radius: 99px;
            padding: 1px 7px;
            font-size: .72rem;
            font-weight: 800;
        }

        .completed-filter-btn:not(.active) .fbadge {
            background: var(--line);
            color: var(--ink2);
        }

    .completed-sort {
        margin-right: auto;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .completed-sort label {
            font-size: .78rem;
            font-weight: 700;
            color: var(--ink2);
            white-space: nowrap;
        }

        .completed-sort select {
            padding: 6px 12px;
            border-radius: 8px;
            border: 1.5px solid var(--line);
            background: var(--card);
            font-family: 'Cairo', sans-serif;
            font-size: .8rem;
            color: var(--ink);
            cursor: pointer;
            outline: none;
            transition: border-color var(--ease);
        }

            .completed-sort select:focus {
                border-color: var(--p);
            }

    .completed-results-label {
        font-size: .78rem;
        font-weight: 700;
        color: var(--ink3);
        margin: 0 4px 14px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .completed-results-label b {
            color: var(--ink);
        }

    .completed-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(350px,1fr));
        gap: 16px;
        padding: 0 4px;
    }

    .completed-card {
        background: var(--card);
        border-radius: var(--r);
        border: 1px solid var(--line);
        box-shadow: var(--sh);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform var(--ease), box-shadow var(--ease);
        animation: cardIn .4s ease both;
    }

        .completed-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--sh2);
        }

    @@keyframes cardIn {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .completed-card-stripe {
        height: 3px;
        width: 100%;
    }

    .stripe-excellent {
        background: linear-gradient(90deg,var(--green),#4ade80);
    }

    .stripe-good {
        background: linear-gradient(90deg,var(--blue),#60a5fa);
    }

    .stripe-medium {
        background: linear-gradient(90deg,var(--amber),#fcd34d);
    }

    .stripe-weak {
        background: linear-gradient(90deg,var(--red),#f87171);
    }

    .completed-card-body {
        padding: 18px 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .completed-card-top {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .completed-card-ico {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        margin-top: 2px;
    }

    .ico-excellent {
        background: var(--grna);
        color: var(--green);
    }

    .ico-good {
        background: var(--bluea);
        color: var(--blue);
    }

    .ico-medium {
        background: var(--ambera);
        color: var(--amber);
    }

    .ico-weak {
        background: var(--reda);
        color: var(--red);
    }

    .completed-card-title {
        font-size: .97rem;
        font-weight: 800;
        color: var(--ink);
        line-height: 1.35;
        margin-bottom: 4px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .completed-card-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .completed-tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #f1f5f9;
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 2px 10px;
        font-size: .7rem;
        font-weight: 700;
        color: var(--ink2);
    }

        .completed-tag i {
            font-size: .65rem;
            opacity: .6;
        }

    .tag-individual {
        background: var(--purplea);
        color: var(--purple);
        border-color: rgba(139,92,246,.18);
    }

    .tag-batch {
        background: var(--bluea);
        color: var(--blue);
        border-color: rgba(59,130,246,.18);
    }

    .completed-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 50px;
        padding: 4px 12px;
        font-size: .73rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .st-excellent {
        background: var(--grna);
        color: #15803d;
    }

    .st-good {
        background: var(--bluea);
        color: #1d4ed8;
    }

    .st-medium {
        background: var(--ambera);
        color: #92400e;
    }

    .st-weak {
        background: var(--reda);
        color: #b91c1c;
    }

    .completed-info-box {
        background: #f8fafc;
        border: 1px solid var(--line);
        border-radius: var(--r-sm);
        padding: 12px 14px;
    }

    .completed-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px 12px;
    }

    .completed-info-label {
        display: block;
        font-size: .68rem;
        font-weight: 700;
        color: var(--ink3);
        margin-bottom: 2px;
    }

    .completed-info-value {
        display: block;
        font-size: .76rem;
        font-weight: 900;
        color: var(--ink);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .completed-score-box {
        background: #f8fafc;
        border: 1px solid var(--line);
        border-radius: var(--r-sm);
        padding: 12px 14px;
    }

    .completed-score-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 6px;
    }

    .completed-score-lbl {
        font-size: .72rem;
        font-weight: 700;
        color: var(--ink2);
    }

    .completed-score-val {
        font-size: .85rem;
        font-weight: 900;
    }

    .completed-score-bar {
        height: 7px;
        border-radius: 99px;
        background: var(--line);
        overflow: hidden;
        position: relative;
        margin-bottom: 4px;
    }

    .completed-score-fill {
        height: 100%;
        border-radius: 99px;
        transition: width 1s cubic-bezier(.4,0,.2,1);
    }

    .fill-excellent {
        background: linear-gradient(90deg,var(--green),#4ade80);
    }

    .fill-good {
        background: linear-gradient(90deg,var(--blue),#60a5fa);
    }

    .fill-medium {
        background: linear-gradient(90deg,var(--amber),#fcd34d);
    }

    .fill-weak {
        background: linear-gradient(90deg,var(--red),#f87171);
    }

    .completed-card-foot {
        padding: 14px 20px;
        border-top: 1px solid var(--line);
        background: #fafbfc;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .completed-btn {
        flex: 1;
        min-width: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 9px 14px;
        border-radius: 10px;
        border: none;
        font-family: 'Cairo', sans-serif;
        font-size: .82rem;
        font-weight: 800;
        cursor: pointer;
        text-decoration: none;
        transition: all var(--ease);
    }

        .completed-btn:hover {
            text-decoration: none;
            transform: translateY(-1px);
        }

    .btn-review {
        background: var(--grna);
        color: #15803d;
        border: 1px solid rgba(34,197,94,.2);
    }

        .btn-review:hover {
            background: rgba(34,197,94,.2);
            color: #15803d;
        }

    .btn-report {
        background: var(--p-a);
        color: var(--p-d);
        border: 1px solid rgba(46,158,158,.2);
    }

        .btn-report:hover {
            background: rgba(46,158,158,.2);
            color: var(--p-d);
        }

    .completed-empty {
        text-align: center;
        padding: 60px 24px;
        background: var(--card);
        border-radius: var(--r);
        border: 1px solid var(--line);
        box-shadow: var(--sh);
    }

    .completed-empty-ico {
        font-size: 3.5rem;
        opacity: .25;
        margin-bottom: 16px;
    }

    .completed-empty h3 {
        font-size: 1rem;
        font-weight: 800;
        color: var(--ink);
        margin-bottom: 6px;
    }

    .completed-empty p {
        font-size: .85rem;
        color: var(--ink2);
        margin: 0;
    }

    .fu {
        opacity: 0;
        transform: translateY(18px);
        animation: fu .45s ease forwards;
    }

    @@keyframes fu {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .d1 {
        animation-delay: .04s;
    }

    .d2 {
        animation-delay: .1s;
    }

    @@media(max-width:700px) {
        .completed-hero {
            padding: 22px 16px 40px;
        }

        .completed-hero-text h1 {
            font-size: 1.15rem;
        }

        .completed-hero-inner {
            flex-direction: column;
            align-items: flex-start;
        }

        .completed-search {
            width: 100%;
            margin-right: 0;
        }

            .completed-search input {
                min-width: 0;
                flex: 1;
            }

        .completed-grid {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .completed-sort {
            margin-right: 0;
            width: 100%;
        }

        .completed-toolbar {
            gap: 6px;
        }

        .completed-info-grid {
            grid-template-columns: 1fr;
        }

        .completed-card-foot {
            padding: 12px 14px;
        }
    }
</style>

<div class="completed-switcher">
    @await Component.InvokeAsync("StudentCourseSwitcher")
</div>

<div class="completed-exams-page">

    <!-- HERO -->
    <div class="completed-hero fu">
        <div class="completed-hero-inner">
            <div class="completed-hero-ico">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div class="completed-hero-text">
                <h1>الاختبارات المكتملة</h1>
                <p>راجع نتائجك، افتح مراجعة الأسئلة، وتابع تقرير كل اختبار بعد التسليم</p>
            </div>

            <div class="completed-search">
                <span class="completed-search-ico">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <input type="text"
                       id="completed-search-input"
                       placeholder="ابحث عن اختبار مكتمل…"
                       oninput="applyCompletedFilters()">
            </div>
        </div>

        <div class="completed-hero-stats">
            <span class="completed-hstat">
                <span class="completed-hstat-dot" style="background:#2e9e9e"></span>
                الإجمالي: @total
            </span>

            <span class="completed-hstat">
                <span class="completed-hstat-dot" style="background:#22c55e"></span>
                ممتاز: @excellent
            </span>

            <span class="completed-hstat">
                <span class="completed-hstat-dot" style="background:#3b82f6"></span>
                جيد: @good
            </span>

            <span class="completed-hstat">
                <span class="completed-hstat-dot" style="background:#ef4444"></span>
                يحتاج تحسين: @weak
            </span>

            <span class="completed-hstat">
                <span class="completed-hstat-dot" style="background:#8b5cf6"></span>
                فردي: @individual
            </span>

            <span class="completed-hstat">
                <span class="completed-hstat-dot" style="background:#e07849"></span>
                دفعة: @batch
            </span>

            @if (total > 0)
            {
                <span class="completed-hstat">
                    <span class="completed-hstat-dot" style="background:#ffffff"></span>
                    متوسط الدرجات: @avgScore.ToString("F1")%
                </span>

                <span class="completed-hstat">
                    <span class="completed-hstat-dot" style="background:#f59e0b"></span>
                    أعلى درجة: @highestScore.ToString("F1")%
                </span>
            }
        </div>
    </div>

    <!-- TOOLBAR -->
    <div class="completed-toolbar fu d1">
        <button type="button"
                class="completed-filter-btn active"
                data-filter="all"
                onclick="setCompletedFilter(this)">
            <i class="fa-solid fa-layer-group" style="font-size:.75rem"></i>
            الكل <span class="fbadge">@total</span>
        </button>

        <button type="button"
                class="completed-filter-btn"
                data-filter="excellent"
                onclick="setCompletedFilter(this)">
            <i class="fa-solid fa-trophy" style="font-size:.75rem"></i>
            ممتاز <span class="fbadge">@excellent</span>
        </button>

        <button type="button"
                class="completed-filter-btn"
                data-filter="good"
                onclick="setCompletedFilter(this)">
            <i class="fa-solid fa-chart-line" style="font-size:.75rem"></i>
            جيد <span class="fbadge">@good</span>
        </button>

        <button type="button"
                class="completed-filter-btn"
                data-filter="weak"
                onclick="setCompletedFilter(this)">
            <i class="fa-solid fa-arrow-trend-down" style="font-size:.75rem"></i>
            يحتاج تحسين <span class="fbadge">@weak</span>
        </button>

        <div class="completed-sort">
            <label for="completed-sort-sel">
                <i class="fa-solid fa-arrow-up-wide-short" style="font-size:.75rem"></i>
                ترتيب:
            </label>

            <select id="completed-sort-sel" onchange="applyCompletedFilters()">
                <option value="date-desc">الأحدث إرسالًا</option>
                <option value="date-asc">الأقدم إرسالًا</option>
                <option value="score-desc">الأعلى درجة</option>
                <option value="score-asc">الأدنى درجة</option>
                <option value="title-asc">العنوان تصاعديًا</option>
            </select>
        </div>
    </div>

    <!-- BODY -->
    <div style="padding:0 20px">

        <div class="completed-results-label fu d2">
            يُعرض <b id="completed-count-shown">@total</b> من إجمالي @total اختبار مكتمل
        </div>

        <div class="completed-grid" id="completed-grid">

            @foreach (var exam in completed)
            {
                var score = Math.Round(Convert.ToDouble(exam.Score ?? 0), 1);
                var scoreW = (int)Math.Round(score);

                scoreW = scoreW < 0 ? 0 : scoreW > 100 ? 100 : scoreW;

                var level = score >= 85
                ? "excellent"
                : score >= 60
                ? "good"
                : score >= 40
                ? "medium"
                : "weak";

                var filterLevel = score >= 85
                ? "excellent"
                : score >= 60
                ? "good"
                : "weak";

                var levelText = score >= 85
                ? "ممتاز"
                : score >= 60
                ? "جيد"
                : score >= 40
                ? "متوسط"
                : "يحتاج تحسين";

                var stripeClass = $"stripe-{level}";
                var iconClass = $"ico-{level}";
                var statusClass = $"st-{level}";
                var fillClass = $"fill-{level}";

                var scoreColor = score >= 85
                ? "#22c55e"
                : score >= 60
                ? "#3b82f6"
                : score >= 40
                ? "#f59e0b"
                : "#ef4444";

                <div class="completed-card"
                     data-level="@filterLevel"
                     data-title="@((exam.Title ?? string.Empty).ToLower())"
                     data-score="@score"
                     data-date="@exam.AssignedAt.ToString("yyyyMMddHHmm")">

                    <div class="completed-card-stripe @stripeClass"></div>

                    <div class="completed-card-body">

                        <div class="completed-card-top">
                            <div class="completed-card-ico @iconClass">
                                <i class="fa-solid fa-circle-check"></i>
                            </div>

                            <div style="flex:1;min-width:0">
                                <div class="completed-card-title">@exam.Title</div>

                                <div class="completed-card-meta">
                                    <span class="completed-tag">
                                        <i class="fa-regular fa-calendar"></i>
                                        @exam.AssignedAt.ToString("yyyy/MM/dd")
                                    </span>

                                    @if (exam.IsIndividual)
                                    {
                                        <span class="completed-tag tag-individual">
                                            <i class="fa-solid fa-user"></i>
                                            فردي
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="completed-tag tag-batch">
                                            <i class="fa-solid fa-users"></i>
                                            دفعة
                                        </span>
                                    }

                                    <span class="completed-status @statusClass">
                                        @levelText
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="completed-info-box">
                            <div class="completed-info-grid">
                                <div>
                                    <span class="completed-info-label">تاريخ الإرسال</span>
                                    <span class="completed-info-value">@exam.AssignedAt.ToString("yyyy/MM/dd HH:mm")</span>
                                </div>

                                <div>
                                    <span class="completed-info-label">نوع الاختبار</span>
                                    <span class="completed-info-value">@(exam.IsIndividual ? "فردي" : "دفعة")</span>
                                </div>

                                <div>
                                    <span class="completed-info-label">الحالة</span>
                                    <span class="completed-info-value">مكتمل</span>
                                </div>

                                <div>
                                    <span class="completed-info-label">التقييم</span>
                                    <span class="completed-info-value">@levelText</span>
                                </div>
                            </div>
                        </div>

                        <div class="completed-score-box">
                            <div class="completed-score-row">
                                <span class="completed-score-lbl">نتيجتك</span>
                                <span class="completed-score-val" style="color:@scoreColor">@score.ToString("F1")%</span>
                            </div>

                            <div class="completed-score-bar">
                                <div class="completed-score-fill @fillClass" style="width:@scoreW%"></div>
                            </div>
                        </div>

                    </div>

                    <div class="completed-card-foot">
                        <a asp-action="ExamReview"
                           asp-controller="StudentExamResults"
                           asp-route-examAssignmentId="@exam.ExamAssignmentId"
                           class="completed-btn btn-review">
                            <i class="fa-solid fa-eye"></i>
                            مراجعة
                        </a>

                        <a asp-action="ExamReport"
                           asp-controller="StudentExamResults"
                           asp-route-examAssignmentId="@exam.ExamAssignmentId"
                           class="completed-btn btn-report">
                            <i class="fa-solid fa-file-lines"></i>
                            تقرير
                        </a>
                    </div>

                </div>
            }

        </div>

        <div class="completed-empty" id="completed-empty" style="display:@(total == 0 ? "block" : "none")">
            <div class="completed-empty-ico">📭</div>
            <h3>لا توجد اختبارات مكتملة حاليًا</h3>
            <p>بعد إنهاء أي اختبار ستظهر نتيجته ومراجعته هنا مباشرة.</p>
        </div>

    </div>
</div>

<script>
    const completedCards = Array.from(document.querySelectorAll('.completed-card'));
    let currentCompletedFilter = 'all';

    function setCompletedFilter(btn) {
        document.querySelectorAll('.completed-filter-btn').forEach(function (b) {
            b.classList.remove('active');
        });

        btn.classList.add('active');
        currentCompletedFilter = btn.dataset.filter;
        applyCompletedFilters();
    }

    function applyCompletedFilters() {
        const searchInput = document.getElementById('completed-search-input');
        const sortSelect = document.getElementById('completed-sort-sel');
        const grid = document.getElementById('completed-grid');
        const countShown = document.getElementById('completed-count-shown');
        const empty = document.getElementById('completed-empty');

        const q = searchInput ? searchInput.value.toLowerCase().trim() : '';
        const sort = sortSelect ? sortSelect.value : 'date-desc';

        let visible = completedCards.filter(function (card) {
            const matchFilter = currentCompletedFilter === 'all' || card.dataset.level === currentCompletedFilter;
            const matchSearch = !q || (card.dataset.title || '').indexOf(q) >= 0;

            return matchFilter && matchSearch;
        });

        visible.sort(function (a, b) {
            if (sort === 'date-desc') {
                return (b.dataset.date || '').localeCompare(a.dataset.date || '');
            }

            if (sort === 'date-asc') {
                return (a.dataset.date || '').localeCompare(b.dataset.date || '');
            }

            if (sort === 'score-desc') {
                return (+b.dataset.score || 0) - (+a.dataset.score || 0);
            }

            if (sort === 'score-asc') {
                return (+a.dataset.score || 0) - (+b.dataset.score || 0);
            }

            if (sort === 'title-asc') {
                return (a.dataset.title || '').localeCompare(b.dataset.title || '', 'ar');
            }

            return 0;
        });

        const visibleSet = new Set(visible);

        completedCards.forEach(function (card) {
            if (visibleSet.has(card)) {
                card.style.display = '';
                grid.appendChild(card);
            } else {
                card.style.display = 'none';
            }
        });

        if (countShown) {
            countShown.textContent = visible.length;
        }

        if (empty) {
            empty.style.display = visible.length ? 'none' : 'block';
        }
    }

    (function () {
        document.querySelectorAll('.completed-score-fill').forEach(function (el) {
            const target = el.style.width;
            el.style.width = '0';

            requestAnimationFrame(function () {
                requestAnimationFrame(function () {
                    el.style.width = target;
                });
            });
        });

        applyCompletedFilters();
    })();
</script>