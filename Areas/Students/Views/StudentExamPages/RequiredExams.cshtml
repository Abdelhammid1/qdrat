                var start = exam.ScheduledDate ?? exam.AssignedAt;
                var end = exam.EndAt ?? start.AddMinutes(exam.DurationMinutes);

                var assignedSort = exam.AssignedAt.ToString("yyyyMMddHHmm");
                var startSort = start.ToString("yyyyMMddHHmm");
                var endSort = end.ToString("yyyyMMddHHmm");

                var title = exam.Title ?? "اختبار بدون عنوان";

                <div class="required-exams-card"
                     data-status="required"
                     data-title="@title.ToLower()"
                     data-assigned="@assignedSort"
                     data-start="@startSort"
                     data-end="@endSort">

                    <div class="required-exams-card-stripe stripe-required"></div>

                    <div class="required-exams-card-body">

                        <div class="required-exams-card-top">
