@model List<QdratNew.ViewModels.Exam.StudentExamCardViewModel>

@{
    ViewData["Title"] = "الاختبارات المطلوبة";

    var exams = Model ?? new List<QdratNew.ViewModels.Exam.StudentExamCardViewModel>();

    var expiredExams = exams
        .Where(x => x.StatusText == "متأخر" || x.StatusText == "انتهى وقته")
        .OrderBy(x => x.ScheduledDate ?? x.AssignedAt)
        .ThenBy(x => x.ExamAssignmentId)
        .ToList();

    var requiredExams = exams
        .Where(x => x.StatusText != "متأخر" && x.StatusText != "انتهى وقته")
        .OrderBy(x => x.AssignedAt)
        .ThenBy(x => x.ExamAssignmentId)
        .ToList();

    var total = exams.Count;
    var requiredCount = requiredExams.Count;
    var expiredCount = expiredExams.Count;
    var individualCount = exams.Count(x => x.IsIndividual);
    var batchCount = exams.Count(x => !x.IsIndividual);

    var nearestExamDate = requiredExams.Any()
        ? requiredExams.Min(x => x.ScheduledDate ?? x.AssignedAt)
        : (DateTime?)null;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --p: #2e9e9e;
        --p-d: #1d7b7b;
        --p-a: rgba(46,158,158,.12);
        --p-glow: rgba(46,158,158,.3);
        --orange: #e07849;
        --ora: rgba(224,120,73,.12);
        --green: #22c55e;
        --grna: rgba(34,197,94,.12);
        --red: #ef4444;
        --red-d: #dc2626;
        --reda: rgba(239,68,68,.12);
        --amber: #f59e0b;
        --ambera: rgba(245,158,11,.12);
        --blue: #3b82f6;
        --bluea: rgba(59,130,246,.12);
        --purple: #8b5cf6;
        --purplea: rgba(139,92,246,.12);
        --ink: #1e293b;
        --ink2: #475569;
        --ink3: #94a3b8;
        --bg: #f0f4f8;
        --card: #ffffff;
        --line: rgba(0,0,0,.07);
        --r: 16px;
        --r-sm: 10px;
        --sh: 0 2px 16px rgba(0,0,0,.07);
        --sh2: 0 8px 32px rgba(0,0,0,.13);
        --ease: .28s cubic-bezier(.4,0,.2,1);
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .required-exams-page {
        font-family: 'Cairo', sans-serif;
        direction: rtl;
        background: var(--bg);
        min-height: 100vh;
        padding: 0 0 60px;
    }

    .required-exams-switcher {
        background: linear-gradient(135deg,#0f1f3d 0%,#1a3a5c 100%);
        border-bottom: 1px solid rgba(255,255,255,.06);
        padding: 0 4px;
    }

    .required-exams-hero {
        background: linear-gradient(145deg,#0f1f3d 0%,#1a3a5c 55%,#103545 100%);
        padding: 28px 28px 44px;
        margin-bottom: -20px;
        position: relative;
        overflow: hidden;
    }

        .required-exams-hero::before {
            content: '';
            position: absolute;
            width: 360px;
            height: 360px;
            border-radius: 50%;
            background: radial-gradient(circle,rgba(46,158,158,.14) 0%,transparent 65%);
            top: -100px;
            left: -60px;
            pointer-events: none;
        }

        .required-exams-hero::after {
            content: '';
            position: absolute;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: radial-gradient(circle,rgba(245,158,11,.12) 0%,transparent 65%);
            bottom: -80px;
            right: -40px;
            pointer-events: none;
        }

    .required-exams-hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .required-exams-hero-ico {
        width: 52px;
        height: 52px;
        background: rgba(255,255,255,.1);
        border: 1.5px solid rgba(255,255,255,.18);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: #fff;
        backdrop-filter: blur(8px);
        flex-shrink: 0;
    }

    .required-exams-hero-text h1 {
        color: #fff;
        font-size: 1.4rem;
        font-weight: 800;
        margin: 0 0 3px;
    }

    .required-exams-hero-text p {
        color: rgba(255,255,255,.58);
        font-size: .82rem;
        margin: 0;
    }

    .required-exams-search {
        margin-right: auto;
        display: flex;
        align-items: center;
        gap: 0;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 50px;
        overflow: hidden;
        backdrop-filter: blur(8px);
        flex-shrink: 0;
    }

        .required-exams-search input {
            background: transparent;
            border: none;
            outline: none;
            padding: 9px 16px;
            color: #fff;
            font-family: 'Cairo', sans-serif;
            font-size: .85rem;
            min-width: 220px;
        }

            .required-exams-search input::placeholder {
                color: rgba(255,255,255,.45);
            }

    .required-exams-search-ico {
        padding: 0 14px;
        color: rgba(255,255,255,.5);
        font-size: .85rem;
    }

    .required-exams-hero-stats {
        position: relative;
        z-index: 1;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 16px;
    }

    .required-exams-hstat {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 50px;
        padding: 7px 18px;
        color: rgba(255,255,255,.86);
        font-size: .8rem;
        font-weight: 700;
        backdrop-filter: blur(6px);
    }

    .required-exams-hstat-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .required-exams-toolbar {
        background: var(--card);
        border-radius: 0 0 20px 20px;
        border: 1px solid var(--line);
        border-top: none;
        box-shadow: var(--sh);
        padding: 12px 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }

    .required-exams-filter-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 7px 16px;
        border-radius: 50px;
        border: 1.5px solid var(--line);
        background: transparent;
        font-family: 'Cairo', sans-serif;
        font-size: .8rem;
        font-weight: 700;
        color: var(--ink2);
        cursor: pointer;
        white-space: nowrap;
        transition: all var(--ease);
    }

        .required-exams-filter-btn:hover {
            border-color: var(--p);
            color: var(--p);
        }

        .required-exams-filter-btn.active {
            background: var(--p);
            border-color: var(--p);
            color: #fff;
            box-shadow: 0 3px 10px var(--p-glow);
        }

        .required-exams-filter-btn .fbadge {
            background: rgba(255,255,255,.25);
            border-radius: 99px;
            padding: 1px 7px;
            font-size: .72rem;
            font-weight: 800;
        }

        .required-exams-filter-btn:not(.active) .fbadge {
            background: var(--line);
            color: var(--ink2);
        }

    .required-exams-sort {
        margin-right: auto;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .required-exams-sort label {
            font-size: .78rem;
            font-weight: 700;
            color: var(--ink2);
            white-space: nowrap;
        }

        .required-exams-sort select {
            padding: 6px 12px;
            border-radius: 8px;
            border: 1.5px solid var(--line);
            background: var(--card);
            font-family: 'Cairo', sans-serif;
            font-size: .8rem;
            color: var(--ink);
            cursor: pointer;
            outline: none;
            transition: border-color var(--ease);
        }

            .required-exams-sort select:focus {
                border-color: var(--p);
            }

    .required-exams-alert {
        background: linear-gradient(135deg,rgba(46,158,158,.10),rgba(245,158,11,.09));
        border: 1px solid rgba(46,158,158,.16);
        border-radius: var(--r);
        padding: 14px 18px;
        margin: 0 4px 16px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        box-shadow: var(--sh);
    }

    .required-exams-alert-icon {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: var(--p-a);
        color: var(--p);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .required-exams-alert-title {
        font-size: .92rem;
        font-weight: 900;
        color: var(--ink);
        margin-bottom: 2px;
    }

    .required-exams-alert-text {
        font-size: .78rem;
        font-weight: 700;
        color: var(--ink2);
        margin: 0;
    }

    .required-exams-results-label {
        font-size: .78rem;
        font-weight: 700;
        color: var(--ink3);
        margin: 0 4px 14px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .required-exams-results-label b {
            color: var(--ink);
        }

    .required-exams-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(350px,1fr));
        gap: 16px;
        padding: 0 4px;
    }

    .required-exams-card {
        background: var(--card);
        border-radius: var(--r);
        border: 1px solid var(--line);
        box-shadow: var(--sh);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform var(--ease), box-shadow var(--ease), border-color var(--ease);
        animation: cardIn .4s ease both;
    }

        .required-exams-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--sh2);
            border-color: rgba(46,158,158,.22);
        }

    @@keyframes cardIn {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .required-exams-card-stripe {
        height: 3px;
        width: 100%;
    }

    .stripe-required {
        background: linear-gradient(90deg,var(--p),#4ecdc4);
    }

    .stripe-expired {
        background: linear-gradient(90deg,var(--red),#f87171);
    }

    .required-exams-card-body {
        padding: 18px 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .required-exams-card-top {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .required-exams-card-ico {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        margin-top: 2px;
    }

    .ico-required {
        background: var(--p-a);
        color: var(--p);
    }

    .ico-expired {
        background: var(--reda);
        color: var(--red);
    }

    .required-exams-card-title {
        font-size: .97rem;
        font-weight: 800;
        color: var(--ink);
        line-height: 1.35;
        margin-bottom: 4px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .required-exams-card-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .required-exams-tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #f1f5f9;
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 2px 10px;
        font-size: .7rem;
        font-weight: 700;
        color: var(--ink2);
    }

        .required-exams-tag i {
            font-size: .65rem;
            opacity: .6;
        }

    .tag-individual {
        background: var(--purplea);
        color: var(--purple);
        border-color: rgba(139,92,246,.18);
    }

    .tag-batch {
        background: var(--bluea);
        color: var(--blue);
        border-color: rgba(59,130,246,.18);
    }

    .required-exams-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 50px;
        padding: 4px 12px;
        font-size: .73rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .st-required {
        background: var(--p-a);
        color: var(--p-d);
    }

    .st-expired {
        background: var(--reda);
        color: #b91c1c;
    }

    .required-exams-info-box {
        background: #f8fafc;
        border: 1px solid var(--line);
        border-radius: var(--r-sm);
        padding: 12px 14px;
    }

    .required-exams-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px 12px;
    }

    .required-exams-info-label {
        display: block;
        font-size: .68rem;
        font-weight: 700;
        color: var(--ink3);
        margin-bottom: 2px;
    }

    .required-exams-info-value {
        display: block;
        font-size: .76rem;
        font-weight: 900;
        color: var(--ink);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .required-exams-priority {
        background: #f8fafc;
        border: 1px solid var(--line);
        border-radius: var(--r-sm);
        padding: 12px 14px;
    }

        .required-exams-priority.expired {
            background: #fff7f7;
            border-color: rgba(239,68,68,.14);
        }

    .required-exams-priority-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 8px;
    }

        .required-exams-priority-row:last-child {
            margin-bottom: 0;
        }

    .required-exams-priority-label {
        font-size: .72rem;
        font-weight: 700;
        color: var(--ink2);
    }

    .required-exams-priority-value {
        font-size: .78rem;
        font-weight: 900;
        color: var(--ink);
    }

    .required-exams-progress {
        height: 7px;
        border-radius: 99px;
        background: rgba(0,0,0,.06);
        overflow: hidden;
        margin-top: 8px;
    }

    .required-exams-progress-fill {
        height: 100%;
        width: 100%;
        border-radius: 99px;
    }

    .fill-required {
        background: linear-gradient(90deg,var(--p),#4ecdc4);
    }

    .fill-expired {
        background: linear-gradient(90deg,var(--red),#f87171);
    }

    .required-exams-card-foot {
        padding: 14px 20px;
        border-top: 1px solid var(--line);
        background: #fafbfc;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .required-exams-btn {
        flex: 1;
        min-width: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 9px 14px;
        border-radius: 10px;
        border: none;
        font-family: 'Cairo', sans-serif;
        font-size: .82rem;
        font-weight: 800;
        cursor: pointer;
        text-decoration: none;
        transition: all var(--ease);
    }

        .required-exams-btn:hover {
            text-decoration: none;
            transform: translateY(-1px);
        }

    .btn-start {
        background: var(--p);
        color: #fff;
        box-shadow: 0 3px 10px var(--p-glow);
    }

        .btn-start:hover {
            background: var(--p-d);
            color: #fff;
        }

    .btn-disabled {
        background: #f1f5f9;
        color: var(--ink3);
        border: 1px solid var(--line);
        cursor: not-allowed;
    }

        .btn-disabled:hover {
            transform: none;
            color: var(--ink3);
        }

    .required-exams-empty {
        text-align: center;
        padding: 60px 24px;
        background: var(--card);
        border-radius: var(--r);
        border: 1px solid var(--line);
        box-shadow: var(--sh);
    }

    .required-exams-empty-ico {
        font-size: 3.5rem;
        opacity: .25;
        margin-bottom: 16px;
    }

    .required-exams-empty h3 {
        font-size: 1rem;
        font-weight: 800;
        color: var(--ink);
        margin-bottom: 6px;
    }

    .required-exams-empty p {
        font-size: .85rem;
        color: var(--ink2);
        margin: 0;
    }

    .fu {
        opacity: 0;
        transform: translateY(18px);
        animation: fu .45s ease forwards;
    }

    @@keyframes fu {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .d1 {
        animation-delay: .04s;
    }

    .d2 {
        animation-delay: .1s;
    }

    @@media(max-width:700px) {
        .required-exams-hero {
            padding: 22px 16px 40px;
        }

        .required-exams-hero-text h1 {
            font-size: 1.15rem;
        }

        .required-exams-hero-inner {
            flex-direction: column;
            align-items: flex-start;
        }

        .required-exams-search {
            width: 100%;
            margin-right: 0;
        }

            .required-exams-search input {
                min-width: 0;
                flex: 1;
            }

        .required-exams-grid {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .required-exams-sort {
            margin-right: 0;
            width: 100%;
        }

        .required-exams-toolbar {
            gap: 6px;
        }

        .required-exams-info-grid {
            grid-template-columns: 1fr;
        }

        .required-exams-card-foot {
            padding: 12px 14px;
        }

        .required-exams-alert {
            padding: 12px 14px;
        }
    }
</style>

<div class="required-exams-switcher">
    @await Component.InvokeAsync("StudentCourseSwitcher")
</div>

<div class="required-exams-page">

    <!-- HERO -->
    <div class="required-exams-hero fu">
        <div class="required-exams-hero-inner">
            <div class="required-exams-hero-ico">
                <i class="fa-solid fa-list-check"></i>
            </div>

            <div class="required-exams-hero-text">
                <h1>الاختبارات المطلوبة</h1>
                <p>ابدأ الاختبارات المتاحة لك في وقتها، وتابع الاختبارات التي انتهت صلاحيتها.</p>
            </div>

            <div class="required-exams-search">
                <span class="required-exams-search-ico">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <input type="text"
                       id="required-exams-search-input"
                       placeholder="ابحث عن اختبار مطلوب…"
                       oninput="applyRequiredExamFilters()">
            </div>
        </div>

        <div class="required-exams-hero-stats">
            <span class="required-exams-hstat">
                <span class="required-exams-hstat-dot" style="background:#2e9e9e"></span>
                الإجمالي: @total
            </span>

            <span class="required-exams-hstat">
                <span class="required-exams-hstat-dot" style="background:#22c55e"></span>
                مطلوب للحل: @requiredCount
            </span>

            <span class="required-exams-hstat">
                <span class="required-exams-hstat-dot" style="background:#ef4444"></span>
                منتهي: @expiredCount
            </span>

            <span class="required-exams-hstat">
                <span class="required-exams-hstat-dot" style="background:#8b5cf6"></span>
                فردي: @individualCount
            </span>

            <span class="required-exams-hstat">
                <span class="required-exams-hstat-dot" style="background:#3b82f6"></span>
                دفعة: @batchCount
            </span>

            @if (nearestExamDate.HasValue)
            {
                <span class="required-exams-hstat">
                    <span class="required-exams-hstat-dot" style="background:#f59e0b"></span>
                    أقرب اختبار: @nearestExamDate.Value.ToString("yyyy/MM/dd HH:mm")
                </span>
            }
        </div>
    </div>

    <!-- TOOLBAR -->
    <div class="required-exams-toolbar fu d1">
        <button type="button"
                class="required-exams-filter-btn active"
                data-filter="all"
                onclick="setRequiredExamFilter(this)">
            <i class="fa-solid fa-layer-group" style="font-size:.75rem"></i>
            الكل <span class="fbadge">@total</span>
        </button>

        <button type="button"
                class="required-exams-filter-btn"
                data-filter="required"
                onclick="setRequiredExamFilter(this)">
            <i class="fa-solid fa-play" style="font-size:.75rem"></i>
            مطلوب للحل <span class="fbadge">@requiredCount</span>
        </button>

        <button type="button"
                class="required-exams-filter-btn"
                data-filter="expired"
                onclick="setRequiredExamFilter(this)">
            <i class="fa-solid fa-lock" style="font-size:.75rem"></i>
            منتهي <span class="fbadge">@expiredCount</span>
        </button>

        <div class="required-exams-sort">
            <label for="required-exams-sort-sel">
                <i class="fa-solid fa-arrow-up-wide-short" style="font-size:.75rem"></i>
                ترتيب:
            </label>

            <select id="required-exams-sort-sel" onchange="applyRequiredExamFilters()">
                <option value="assigned-desc">الأحدث إرسالًا</option>
                <option value="assigned-asc">الأقدم إرسالًا</option>
                <option value="start-asc">الأقرب بدءًا</option>
                <option value="start-desc">الأبعد بدءًا</option>
                <option value="end-asc">الأقرب انتهاءً</option>
                <option value="end-desc">الأبعد انتهاءً</option>
                <option value="title-asc">العنوان تصاعديًا</option>
            </select>
        </div>
    </div>

    <!-- BODY -->
    <div style="padding:0 20px">

        @if (requiredCount > 0)
        {
            <div class="required-exams-alert fu d2">
                <div class="required-exams-alert-icon">
                    <i class="fa-solid fa-bell"></i>
                </div>
                <div>
