                                    {
                                        <span class="required-exams-tag tag-individual">
                                            <i class="fa-solid fa-user"></i>
                                            فردي
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="required-exams-tag tag-batch">
                                            <i class="fa-solid fa-users"></i>
                                            دفعة
                                        </span>
                                    }

                                    <span class="required-exams-status st-required">
                                        @exam.StatusText
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="required-exams-info-box">
                            <div class="required-exams-info-grid">
                                <div>
                                    <span class="required-exams-info-label">تاريخ الإرسال</span>
                                    <span class="required-exams-info-value">@exam.AssignedAt.ToString("yyyy/MM/dd HH:mm")</span>
                                </div>

                                <div>
                                    <span class="required-exams-info-label">وقت البدء</span>
                                    <span class="required-exams-info-value">@start.ToString("yyyy/MM/dd HH:mm")</span>
                                </div>

                                <div>
                                    <span class="required-exams-info-label">وقت الانتهاء</span>
                                    <span class="required-exams-info-value">@end.ToString("yyyy/MM/dd HH:mm")</span>
                                </div>

                                <div>
                                    <span class="required-exams-info-label">المدة</span>
                                    <span class="required-exams-info-value">@exam.DurationMinutes دقيقة</span>
                                </div>
                            </div>
                        </div>

                        <div class="required-exams-priority">
                            <div class="required-exams-priority-row">
                                <span class="required-exams-priority-label">حالة الاختبار</span>
                                <span class="required-exams-priority-value">@exam.StatusText</span>
                            </div>

                            <div class="required-exams-priority-row">
                                <span class="required-exams-priority-label">الإجراء المطلوب</span>
                                <span class="required-exams-priority-value">بدء الاختبار وتسليمه</span>
                            </div>

                            <div class="required-exams-progress">
                                <div class="required-exams-progress-fill fill-required"></div>
                            </div>
                        </div>

                    </div>

                    <div class="required-exams-card-foot">
                        @if (exam.IsIndividual)
                        {
                            <a asp-action="StartIndividualExam"
                               asp-controller="StudentExamFlow"
                               asp-route-examAssignmentId="@exam.ExamAssignmentId"
                               class="required-exams-btn btn-start">
                                <i class="fa-solid fa-play"></i>
                                بدء الاختبار
                            </a>
                        }
                        else
                        {
                            <a asp-action="StartExam"
                               asp-controller="StudentExamFlow"
                               asp-route-examAssignmentId="@exam.ExamAssignmentId"
                               class="required-exams-btn btn-start">
                                <i class="fa-solid fa-play"></i>
                                بدء الاختبار
                            </a>
                        }
                    </div>

                </div>
            }

            @foreach (var exam in expiredExams)
            {
                var start = exam.ScheduledDate ?? exam.AssignedAt;
                var end = exam.EndAt ?? start.AddMinutes(exam.DurationMinutes);

                var assignedSort = exam.AssignedAt.ToString("yyyyMMddHHmm");
                var startSort = start.ToString("yyyyMMddHHmm");
                var endSort = end.ToString("yyyyMMddHHmm");

                var title = exam.Title ?? "اختبار بدون عنوان";

                <div class="required-exams-card"
                     data-status="expired"
                     data-title="@title.ToLower()"
                     data-assigned="@assignedSort"
                     data-start="@startSort"
                     data-end="@endSort">

                    <div class="required-exams-card-stripe stripe-expired"></div>

                    <div class="required-exams-card-body">

                        <div class="required-exams-card-top">
                            <div class="required-exams-card-ico ico-expired">
                                <i class="fa-solid fa-lock"></i>
                            </div>

                            <div style="flex:1;min-width:0">
                                <div class="required-exams-card-title">@title</div>

                                <div class="required-exams-card-meta">
                                    @if (exam.IsIndividual)
                                    {
                                        <span class="required-exams-tag tag-individual">
                                            <i class="fa-solid fa-user"></i>
                                            فردي
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="required-exams-tag tag-batch">
                                            <i class="fa-solid fa-users"></i>
                                            دفعة
                                        </span>
                                    }

                                    <span class="required-exams-status st-expired">
                                        @exam.StatusText
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="required-exams-info-box">
                            <div class="required-exams-info-grid">
                                <div>
                                    <span class="required-exams-info-label">تاريخ الإرسال</span>
                                    <span class="required-exams-info-value">@exam.AssignedAt.ToString("yyyy/MM/dd HH:mm")</span>
                                </div>

                                <div>
                                    <span class="required-exams-info-label">وقت البدء</span>
                                    <span class="required-exams-info-value">@start.ToString("yyyy/MM/dd HH:mm")</span>
                                </div>

                                <div>
                                    <span class="required-exams-info-label">وقت الانتهاء</span>
                                    <span class="required-exams-info-value">@end.ToString("yyyy/MM/dd HH:mm")</span>
                                </div>

                                <div>
                                    <span class="required-exams-info-label">المدة</span>
                                    <span class="required-exams-info-value">@exam.DurationMinutes دقيقة</span>
                                </div>
                            </div>
                        </div>

                        <div class="required-exams-priority expired">
                            <div class="required-exams-priority-row">
                                <span class="required-exams-priority-label">حالة الاختبار</span>
                                <span class="required-exams-priority-value">متأخر</span>
                            </div>

                            <div class="required-exams-priority-row">
                                <span class="required-exams-priority-label">الإجراء المتاح</span>
                                <span class="required-exams-priority-value">بدء الاختبار وتسليمه</span>
                            </div>

                            <div class="required-exams-progress">
                                <div class="required-exams-progress-fill fill-expired"></div>
                            </div>
                        </div>

                    </div>

                    <div class="required-exams-card-foot">
                        @if (exam.IsIndividual)
                        {
                            <a asp-action="StartIndividualExam"
                               asp-controller="StudentExamFlow"
                               asp-route-examAssignmentId="@exam.ExamAssignmentId"
                               class="required-exams-btn btn-start">
                                <i class="fa-solid fa-play"></i>
                                بدء الاختبار
                            </a>
                        }
                        else
                        {
                            <a asp-action="StartExam"
                               asp-controller="StudentExamFlow"
                               asp-route-examAssignmentId="@exam.ExamAssignmentId"
                               class="required-exams-btn btn-start">
                                <i class="fa-solid fa-play"></i>
                                بدء الاختبار
                            </a>
                        }
                    </div>

                </div>
            }

        </div>

        <div class="required-exams-empty" id="required-exams-empty" style="display:@(total == 0 ? "block" : "none")">
            <div class="required-exams-empty-ico">📭</div>
            <h3>لا توجد اختبارات مطلوبة حاليًا</h3>
            <p>عند إرسال اختبار جديد لك سيظهر هنا مباشرة.</p>
        </div>

    </div>
</div>

<script>
    const requiredExamCards = Array.from(document.querySelectorAll('.required-exams-card'));
    let currentRequiredExamFilter = 'all';

    function setRequiredExamFilter(btn) {
        document.querySelectorAll('.required-exams-filter-btn').forEach(function (b) {
            b.classList.remove('active');
        });

        btn.classList.add('active');
        currentRequiredExamFilter = btn.dataset.filter;
        applyRequiredExamFilters();
    }

    function applyRequiredExamFilters() {
        const searchInput = document.getElementById('required-exams-search-input');
        const sortSelect = document.getElementById('required-exams-sort-sel');
        const grid = document.getElementById('required-exams-grid');
        const countShown = document.getElementById('required-exams-count-shown');
        const empty = document.getElementById('required-exams-empty');

        const q = searchInput ? searchInput.value.toLowerCase().trim() : '';
        const sort = sortSelect ? sortSelect.value : 'assigned-desc';

        let visible = requiredExamCards.filter(function (card) {
            const matchFilter = currentRequiredExamFilter === 'all' || card.dataset.status === currentRequiredExamFilter;
            const matchSearch = !q || (card.dataset.title || '').indexOf(q) >= 0;

            return matchFilter && matchSearch;
        });

        visible.sort(function (a, b) {
            if (sort === 'assigned-desc') {
                return (b.dataset.assigned || '').localeCompare(a.dataset.assigned || '');
            }

            if (sort === 'assigned-asc') {
                return (a.dataset.assigned || '').localeCompare(b.dataset.assigned || '');
            }

            if (sort === 'start-asc') {
                return (a.dataset.start || '').localeCompare(b.dataset.start || '');
            }

            if (sort === 'start-desc') {
                return (b.dataset.start || '').localeCompare(a.dataset.start || '');
            }

            if (sort === 'end-asc') {
                return (a.dataset.end || '').localeCompare(b.dataset.end || '');
            }

            if (sort === 'end-desc') {
                return (b.dataset.end || '').localeCompare(a.dataset.end || '');
            }

            if (sort === 'title-asc') {
                return (a.dataset.title || '').localeCompare(b.dataset.title || '', 'ar');
            }

            return 0;
        });

        const visibleSet = new Set(visible);

        requiredExamCards.forEach(function (card) {
            if (visibleSet.has(card)) {
                card.style.display = '';
                grid.appendChild(card);
            } else {
                card.style.display = 'none';
            }
        });

        if (countShown) {
            countShown.textContent = visible.length;
        }

        if (empty) {
            empty.style.display = visible.length ? 'none' : 'block';
        }
    }

    applyRequiredExamFilters();
</script>