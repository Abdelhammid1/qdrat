@model List<QdratNew.ViewModels.Exam.StudentExamCardViewModel>

@{
    ViewData["Title"] = "كل الاختبارات";
    var exams = Model ?? new List<QdratNew.ViewModels.Exam.StudentExamCardViewModel>();

    var total = exams.Count;
    var submitted = exams.Count(x => x.IsSubmitted);
    var available = exams.Count(x => x.StatusText == "متاح الآن" && !x.IsSubmitted);
    var upcoming = exams.Count(x => x.StatusText == "قادِم" && !x.IsSubmitted);
    var expired = exams.Count(x => x.StatusText == "انتهى وقته" && !x.IsSubmitted);
    var individual = exams.Count(x => x.IsIndividual);
    var batch = exams.Count(x => !x.IsIndividual);

    var avgScore = exams
        .Where(x => x.IsSubmitted && x.Score.HasValue)
        .Select(x => x.Score.Value)
        .DefaultIfEmpty(0)
        .Average();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --p: #2e9e9e;
        --p-d: #1d7b7b;
        --p-a: rgba(46,158,158,.12);
        --p-glow: rgba(46,158,158,.3);
        --orange: #e07849;
        --ora: rgba(224,120,73,.12);
        --green: #22c55e;
        --grna: rgba(34,197,94,.12);
        --red: #ef4444;
        --reda: rgba(239,68,68,.12);
        --amber: #f59e0b;
        --ambera: rgba(245,158,11,.12);
        --purple: #8b5cf6;
        --purplea: rgba(139,92,246,.12);
        --blue: #3b82f6;
        --bluea: rgba(59,130,246,.12);
        --ink: #1e293b;
        --ink2: #475569;
        --ink3: #94a3b8;
        --bg: #f0f4f8;
        --card: #ffffff;
        --line: rgba(0,0,0,.07);
        --r: 16px;
        --r-sm: 10px;
        --sh: 0 2px 16px rgba(0,0,0,.07);
        --sh2: 0 8px 32px rgba(0,0,0,.13);
        --ease: .28s cubic-bezier(.4,0,.2,1);
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .exam-all-page {
        font-family: 'Cairo', sans-serif;
        direction: rtl;
        background: var(--bg);
        min-height: 100vh;
        padding: 0 0 60px;
    }

    .exam-switcher {
        background: linear-gradient(135deg,#0f1f3d 0%,#1a3a5c 100%);
        border-bottom: 1px solid rgba(255,255,255,.06);
        padding: 0 4px;
    }

    .exam-hero {
        background: linear-gradient(145deg,#0f1f3d 0%,#1a3a5c 55%,#103545 100%);
        padding: 28px 28px 44px;
        margin-bottom: -20px;
        position: relative;
        overflow: hidden;
    }

        .exam-hero::before {
            content: '';
            position: absolute;
            width: 360px;
            height: 360px;
            border-radius: 50%;
            background: radial-gradient(circle,rgba(46,158,158,.14) 0%,transparent 65%);
            top: -100px;
            left: -60px;
            pointer-events: none;
        }

        .exam-hero::after {
            content: '';
            position: absolute;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: radial-gradient(circle,rgba(139,92,246,.11) 0%,transparent 65%);
            bottom: -80px;
            right: -40px;
            pointer-events: none;
        }

    .exam-hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .exam-hero-ico {
        width: 52px;
        height: 52px;
        background: rgba(255,255,255,.1);
        border: 1.5px solid rgba(255,255,255,.18);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: #fff;
        backdrop-filter: blur(8px);
        flex-shrink: 0;
    }

    .exam-hero-text h1 {
        color: #fff;
        font-size: 1.4rem;
        font-weight: 800;
        margin: 0 0 3px;
    }

    .exam-hero-text p {
        color: rgba(255,255,255,.58);
        font-size: .82rem;
        margin: 0;
    }

    .exam-hero-actions {
        margin-right: auto;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .exam-search {
        display: flex;
        align-items: center;
        gap: 0;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 50px;
        overflow: hidden;
        backdrop-filter: blur(8px);
        flex-shrink: 0;
    }

        .exam-search input {
            background: transparent;
            border: none;
            outline: none;
            padding: 9px 16px;
            color: #fff;
            font-family: 'Cairo', sans-serif;
            font-size: .85rem;
            min-width: 210px;
        }

            .exam-search input::placeholder {
                color: rgba(255,255,255,.45);
            }

    .exam-search-ico {
        padding: 0 14px;
        color: rgba(255,255,255,.5);
        font-size: .85rem;
    }

    .exam-back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 9px 16px;
        border-radius: 50px;
        border: 1px solid rgba(255,255,255,.18);
        background: rgba(255,255,255,.09);
        color: #fff;
        font-size: .8rem;
        font-weight: 800;
        text-decoration: none;
        transition: all var(--ease);
        backdrop-filter: blur(8px);
    }

        .exam-back-btn:hover {
            color: #fff;
            background: rgba(255,255,255,.15);
            text-decoration: none;
            transform: translateY(-1px);
        }

    .exam-hero-stats {
        position: relative;
        z-index: 1;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 16px;
    }

    .exam-hstat {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 50px;
        padding: 7px 18px;
        color: rgba(255,255,255,.86);
        font-size: .8rem;
        font-weight: 700;
        backdrop-filter: blur(6px);
    }

    .exam-hstat-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .exam-toolbar {
        background: var(--card);
        border-radius: 0 0 20px 20px;
        border: 1px solid var(--line);
        border-top: none;
        box-shadow: var(--sh);
        padding: 12px 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }

    .exam-filter-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 7px 16px;
        border-radius: 50px;
        border: 1.5px solid var(--line);
        background: transparent;
        font-family: 'Cairo', sans-serif;
        font-size: .8rem;
        font-weight: 700;
        color: var(--ink2);
        cursor: pointer;
        white-space: nowrap;
        transition: all var(--ease);
    }

        .exam-filter-btn:hover {
            border-color: var(--p);
            color: var(--p);
        }

        .exam-filter-btn.active {
            background: var(--p);
            border-color: var(--p);
            color: #fff;
            box-shadow: 0 3px 10px var(--p-glow);
        }

        .exam-filter-btn .fbadge {
            background: rgba(255,255,255,.25);
            border-radius: 99px;
            padding: 1px 7px;
            font-size: .72rem;
            font-weight: 800;
        }

        .exam-filter-btn:not(.active) .fbadge {
            background: var(--line);
            color: var(--ink2);
        }

    .exam-sort {
        margin-right: auto;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .exam-sort label {
            font-size: .78rem;
            font-weight: 700;
            color: var(--ink2);
            white-space: nowrap;
        }

        .exam-sort select {
            padding: 6px 12px;
            border-radius: 8px;
            border: 1.5px solid var(--line);
            background: var(--card);
            font-family: 'Cairo', sans-serif;
            font-size: .8rem;
            color: var(--ink);
            cursor: pointer;
            outline: none;
            transition: border-color var(--ease);
        }

            .exam-sort select:focus {
                border-color: var(--p);
            }

    .exam-results-label {
        font-size: .78rem;
        font-weight: 700;
        color: var(--ink3);
        margin: 0 4px 14px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .exam-results-label b {
            color: var(--ink);
        }

    .exam-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(350px,1fr));
        gap: 16px;
        padding: 0 4px;
    }

    .exam-card {
        background: var(--card);
        border-radius: var(--r);
        border: 1px solid var(--line);
        box-shadow: var(--sh);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform var(--ease), box-shadow var(--ease);
        animation: cardIn .4s ease both;
    }

        .exam-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--sh2);
        }

    @@keyframes cardIn {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .exam-card-stripe {
        height: 3px;
        width: 100%;
    }

    .stripe-available {
        background: linear-gradient(90deg,var(--blue),#60a5fa);
    }

    .stripe-submitted {
        background: linear-gradient(90deg,var(--green),#4ade80);
    }

    .stripe-upcoming {
        background: linear-gradient(90deg,var(--amber),#fcd34d);
    }

    .stripe-expired {
        background: linear-gradient(90deg,var(--red),#f87171);
    }

    .stripe-default {
        background: linear-gradient(90deg,var(--p),#4ecdc4);
    }

    .exam-card-body {
        padding: 18px 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .exam-card-top {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .exam-card-ico {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        margin-top: 2px;
    }

    .ico-available {
        background: var(--bluea);
        color: var(--blue);
    }

    .ico-submitted {
        background: var(--grna);
        color: var(--green);
    }

    .ico-upcoming {
        background: var(--ambera);
        color: var(--amber);
    }

    .ico-expired {
        background: var(--reda);
        color: var(--red);
    }

    .ico-default {
        background: var(--p-a);
        color: var(--p);
    }

    .exam-card-title {
        font-size: .97rem;
        font-weight: 800;
        color: var(--ink);
        line-height: 1.35;
        margin-bottom: 4px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .exam-card-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .exam-tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #f1f5f9;
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 2px 10px;
        font-size: .7rem;
        font-weight: 700;
        color: var(--ink2);
    }

        .exam-tag i {
            font-size: .65rem;
            opacity: .6;
        }

    .tag-individual {
        background: var(--purplea);
        color: var(--purple);
        border-color: rgba(139,92,246,.18);
    }

    .tag-batch {
        background: var(--bluea);
        color: var(--blue);
        border-color: rgba(59,130,246,.18);
    }

    .exam-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 50px;
        padding: 4px 12px;
        font-size: .73rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .st-available {
        background: var(--bluea);
        color: #1d4ed8;
    }

    .st-submitted {
        background: var(--grna);
        color: #15803d;
    }

    .st-upcoming {
        background: var(--ambera);
        color: #92400e;
    }

    .st-expired {
        background: var(--reda);
        color: #b91c1c;
    }

    .st-default {
        background: #f1f5f9;
        color: var(--ink2);
    }

    .exam-info-box {
        background: #f8fafc;
        border: 1px solid var(--line);
        border-radius: var(--r-sm);
        padding: 12px 14px;
    }

    .exam-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px 12px;
    }

    .exam-info-item {
        min-width: 0;
    }

    .exam-info-label {
        display: block;
        font-size: .68rem;
        font-weight: 700;
        color: var(--ink3);
        margin-bottom: 2px;
    }

    .exam-info-value {
        display: block;
        font-size: .76rem;
        font-weight: 900;
        color: var(--ink);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .exam-score-box {
        background: #f8fafc;
        border: 1px solid var(--line);
        border-radius: var(--r-sm);
        padding: 12px 14px;
    }

    .exam-score-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 6px;
    }

    .exam-score-lbl {
        font-size: .72rem;
        font-weight: 700;
        color: var(--ink2);
    }

    .exam-score-val {
        font-size: .85rem;
        font-weight: 900;
    }

    .exam-score-bar {
        height: 7px;
        border-radius: 99px;
        background: var(--line);
        overflow: hidden;
        position: relative;
        margin-bottom: 4px;
    }

    .exam-score-fill {
        height: 100%;
        border-radius: 99px;
        background: linear-gradient(90deg,var(--p),#4ecdc4);
        transition: width 1s cubic-bezier(.4,0,.2,1);
    }

    .exam-card-foot {
        padding: 14px 20px;
        border-top: 1px solid var(--line);
        background: #fafbfc;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .exam-btn {
        flex: 1;
        min-width: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 9px 14px;
        border-radius: 10px;
        border: none;
        font-family: 'Cairo', sans-serif;
        font-size: .82rem;
        font-weight: 800;
        cursor: pointer;
        text-decoration: none;
        transition: all var(--ease);
    }

        .exam-btn:hover {
            text-decoration: none;
            transform: translateY(-1px);
        }

    .btn-start {
        background: var(--p);
        color: #fff;
        box-shadow: 0 3px 10px var(--p-glow);
    }

        .btn-start:hover {
            background: var(--p-d);
            color: #fff;
        }

    .btn-result {
        background: var(--grna);
        color: #15803d;
        border: 1px solid rgba(34,197,94,.2);
    }

        .btn-result:hover {
            background: rgba(34,197,94,.2);
            color: #15803d;
        }

    .btn-report {
        background: var(--p-a);
        color: var(--p-d);
        border: 1px solid rgba(46,158,158,.2);
    }

        .btn-report:hover {
            background: rgba(46,158,158,.2);
            color: var(--p-d);
        }

    .btn-disabled {
        background: #f1f5f9;
        color: var(--ink3);
        border: 1px solid var(--line);
        cursor: not-allowed;
    }

        .btn-disabled:hover {
            transform: none;
            color: var(--ink3);
        }

    .exam-empty {
        text-align: center;
        padding: 60px 24px;
        background: var(--card);
        border-radius: var(--r);
        border: 1px solid var(--line);
        box-shadow: var(--sh);
    }

    .exam-empty-ico {
        font-size: 3.5rem;
        opacity: .25;
        margin-bottom: 16px;
    }

    .exam-empty h3 {
        font-size: 1rem;
        font-weight: 800;
        color: var(--ink);
        margin-bottom: 6px;
    }

    .exam-empty p {
        font-size: .85rem;
        color: var(--ink2);
        margin: 0;
    }

    .fu {
        opacity: 0;
        transform: translateY(18px);
        animation: fu .45s ease forwards;
    }

    @@keyframes fu {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .d1 {
        animation-delay: .04s;
    }

    .d2 {
        animation-delay: .1s;
    }

    .d3 {
        animation-delay: .17s;
    }

    @@media(max-width:700px) {
        .exam-hero {
            padding: 22px 16px 40px;
        }

        .exam-hero-text h1 {
            font-size: 1.15rem;
        }

        .exam-hero-inner {
            flex-direction: column;
            align-items: flex-start;
        }

        .exam-hero-actions {
            width: 100%;
            margin-right: 0;
        }

        .exam-search {
            width: 100%;
        }

            .exam-search input {
                min-width: 0;
                flex: 1;
            }

        .exam-back-btn {
            width: 100%;
        }

        .exam-grid {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .exam-sort {
            margin-right: 0;
            width: 100%;
        }

        .exam-toolbar {
            gap: 6px;
        }

        .exam-info-grid {
            grid-template-columns: 1fr;
        }

        .exam-card-foot {
            padding: 12px 14px;
        }
    }
</style>

<div class="exam-switcher">
    @await Component.InvokeAsync("StudentCourseSwitcher")
</div>

<div class="exam-all-page">

    <!-- HERO -->
    <div class="exam-hero fu">
        <div class="exam-hero-inner">
            <div class="exam-hero-ico">
                <i class="fa-solid fa-file-circle-check"></i>
            </div>

            <div class="exam-hero-text">
                <h1>كل الاختبارات</h1>
                <p>جميع اختباراتك في مكان واحد — ابدأ المتاح، راجع المحلول، وتابع مواعيد الاختبارات القادمة</p>
            </div>

            <div class="exam-hero-actions">
                <div class="exam-search">
                    <span class="exam-search-ico">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <input type="text"
                           id="exam-search-input"
                           placeholder="ابحث عن اختبار…"
                           oninput="applyExamFilters()">
                </div>

                <a asp-action="Index"
                   asp-controller="StudentExamDashboard"
                   asp-area="Students"
                   class="exam-back-btn">
                    <i class="fa-solid fa-arrow-right"></i>
                    عودة للوحة الاختبارات
                </a>
            </div>
        </div>

        <div class="exam-hero-stats">
            <span class="exam-hstat">
                <span class="exam-hstat-dot" style="background:#2e9e9e"></span>
                الإجمالي: @total
            </span>

            <span class="exam-hstat">
                <span class="exam-hstat-dot" style="background:#3b82f6"></span>
                متاح الآن: @available
            </span>

            <span class="exam-hstat">
                <span class="exam-hstat-dot" style="background:#22c55e"></span>
                تم الحل: @submitted
            </span>

            <span class="exam-hstat">
                <span class="exam-hstat-dot" style="background:#f59e0b"></span>
                قادم: @upcoming
            </span>

            <span class="exam-hstat">
                <span class="exam-hstat-dot" style="background:#ef4444"></span>
                انتهى وقته: @expired
            </span>

            <span class="exam-hstat">
                <span class="exam-hstat-dot" style="background:#8b5cf6"></span>
                فردي: @individual
            </span>

            <span class="exam-hstat">
                <span class="exam-hstat-dot" style="background:#e07849"></span>
                دفعة: @batch
            </span>

            @if (submitted > 0)
            {
                <span class="exam-hstat">
                    <span class="exam-hstat-dot" style="background:#ffffff"></span>
                    متوسط درجاتك: @avgScore.ToString("F1")%
                </span>
            }
        </div>
    </div>

    <!-- TOOLBAR -->
    <div class="exam-toolbar fu d1">
        <button type="button"
                class="exam-filter-btn active"
                data-filter="all"
                onclick="setExamFilter(this)">
            <i class="fa-solid fa-layer-group" style="font-size:.75rem"></i>
            الكل <span class="fbadge">@total</span>
        </button>

        <button type="button"
                class="exam-filter-btn"
                data-filter="available"
                onclick="setExamFilter(this)">
            <i class="fa-solid fa-play" style="font-size:.75rem"></i>
            متاح الآن <span class="fbadge">@available</span>
        </button>

        <button type="button"
                class="exam-filter-btn"
                data-filter="submitted"
                onclick="setExamFilter(this)">
            <i class="fa-solid fa-circle-check" style="font-size:.75rem"></i>
            تم الحل <span class="fbadge">@submitted</span>
        </button>

        <button type="button"
                class="exam-filter-btn"
                data-filter="upcoming"
                onclick="setExamFilter(this)">
            <i class="fa-solid fa-clock" style="font-size:.75rem"></i>
            قادم <span class="fbadge">@upcoming</span>
        </button>

        <button type="button"
                class="exam-filter-btn"
                data-filter="expired"
                onclick="setExamFilter(this)">
            <i class="fa-solid fa-hourglass-end" style="font-size:.75rem"></i>
            انتهى وقته <span class="fbadge">@expired</span>
        </button>

        <div class="exam-sort">
            <label for="exam-sort-sel">
                <i class="fa-solid fa-arrow-up-wide-short" style="font-size:.75rem"></i>
                ترتيب:
            </label>

            <select id="exam-sort-sel" onchange="applyExamFilters()">
                <option value="assigned-desc">الأحدث إرسالًا</option>
                <option value="assigned-asc">الأقدم إرسالًا</option>
                <option value="scheduled-desc">وقت البدء الأحدث</option>
                <option value="scheduled-asc">وقت البدء الأقدم</option>
                <option value="score-desc">الأعلى درجة</option>
                <option value="score-asc">الأدنى درجة</option>
                <option value="title-asc">العنوان تصاعديًا</option>
            </select>
        </div>
    </div>

    <!-- BODY -->
    <div style="padding:0 20px">

        <div class="exam-results-label fu d2">
            يُعرض <b id="exam-count-shown">@total</b> من إجمالي @total اختبار
        </div>

        <div class="exam-grid" id="exam-grid">

            @foreach (var exam in exams)
            {
                double rawScore = exam.Score ?? 0d;
                var score = Math.Round(rawScore, 1);
                var scoreW = (int)Math.Round(score);

                scoreW = scoreW < 0 ? 0 : scoreW > 100 ? 100 : scoreW;

                var statusKey = "default";
                var icon = "fa-file-circle-question";
                var statusClass = "st-default";
                var stripeClass = "stripe-default";
                var iconClass = "ico-default";

                if (exam.IsSubmitted)
                {
                    statusKey = "submitted";
                    icon = "fa-circle-check";
                    statusClass = "st-submitted";
                    stripeClass = "stripe-submitted";
                    iconClass = "ico-submitted";
                }
                else if (exam.StatusText == "متاح الآن")
                {
                    statusKey = "available";
                    icon = "fa-circle-play";
                    statusClass = "st-available";
                    stripeClass = "stripe-available";
                    iconClass = "ico-available";
                }
                else if (exam.StatusText == "قادِم")
                {
                    statusKey = "upcoming";
                    icon = "fa-clock";
                    statusClass = "st-upcoming";
                    stripeClass = "stripe-upcoming";
                    iconClass = "ico-upcoming";
                }
                else if (exam.StatusText == "انتهى وقته")
                {
                    statusKey = "expired";
                    icon = "fa-hourglass-end";
                    statusClass = "st-expired";
                    stripeClass = "stripe-expired";
                    iconClass = "ico-expired";
                }

                var scheduledSort = exam.ScheduledDate.HasValue
                ? exam.ScheduledDate.Value.ToString("yyyyMMddHHmm")
                : "000000000000";

                var endText = exam.EndAt != null
                ? exam.EndAt.Value.ToString("HH:mm")
                : exam.ScheduledDate != null
                ? exam.ScheduledDate.Value.AddMinutes(exam.DurationMinutes).ToString("HH:mm")
                : "—";

                var scoreColor = score >= 85
                ? "#22c55e"
                : score >= 60
                ? "#3b82f6"
                : score >= 40
                ? "#f59e0b"
                : "#ef4444";

                <div class="exam-card"
                     data-status="@statusKey"
                     data-title="@((exam.Title ?? string.Empty).ToLower())"
                     data-score="@score"
                     data-assigned="@exam.AssignedAt.ToString("yyyyMMddHHmm")"
                     data-scheduled="@scheduledSort">

                    <div class="exam-card-stripe @stripeClass"></div>

                    <div class="exam-card-body">

                        <div class="exam-card-top">
                            <div class="exam-card-ico @iconClass">
                                <i class="fa-solid @icon"></i>
                            </div>

                            <div style="flex:1;min-width:0">
                                <div class="exam-card-title">@exam.Title</div>

                                <div class="exam-card-meta">
                                    @if (exam.IsIndividual)
                                    {
                                        <span class="exam-tag tag-individual">
                                            <i class="fa-solid fa-user"></i>
                                            فردي
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="exam-tag tag-batch">
                                            <i class="fa-solid fa-users"></i>
                                            دفعة
                                        </span>
                                    }

                                    <span class="exam-status @statusClass">
                                        @exam.StatusText
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="exam-info-box">
                            <div class="exam-info-grid">
                                <div class="exam-info-item">
                                    <span class="exam-info-label">تاريخ الإرسال</span>
                                    <span class="exam-info-value">@exam.AssignedAt.ToString("yyyy/MM/dd HH:mm")</span>
                                </div>

                                <div class="exam-info-item">
                                    <span class="exam-info-label">وقت البدء</span>
                                    <span class="exam-info-value">@(exam.ScheduledDate?.ToString("HH:mm") ?? "—")</span>
                                </div>

                                <div class="exam-info-item">
                                    <span class="exam-info-label">وقت الانتهاء</span>
                                    <span class="exam-info-value">@endText</span>
                                </div>

                                <div class="exam-info-item">
                                    <span class="exam-info-label">مدة الاختبار</span>
                                    <span class="exam-info-value">@exam.DurationMinutes دقيقة</span>
                                </div>
                            </div>
                        </div>

                        @if (exam.IsSubmitted)
                        {
                            <div class="exam-score-box">
                                <div class="exam-score-row">
                                    <span class="exam-score-lbl">نتيجتك</span>
                                    <span class="exam-score-val" style="color:@scoreColor">@score.ToString("F1")%</span>
                                </div>

                                <div class="exam-score-bar">
                                    <div class="exam-score-fill" style="width:@scoreW%"></div>
                                </div>
                            </div>
                        }

                    </div>

                    <div class="exam-card-foot">
                        @if (exam.IsSubmitted)
                        {
                            <a asp-action="ExamResult"
                               asp-controller="StudentExamResults"
                               asp-route-id="@exam.ExamAssignmentId"
                               class="exam-btn btn-result">
                                <i class="fa-solid fa-chart-line"></i>
                                النتيجة
                            </a>

                            <a asp-action="ExamReport"
                               asp-controller="StudentExamResults"
                               asp-route-examAssignmentId="@exam.ExamAssignmentId"
                               class="exam-btn btn-report">
                                <i class="fa-solid fa-file-lines"></i>
                                تقرير
                            </a>
                        }
                        else if (exam.StatusText != "قادِم")
                        {
                            if (exam.IsIndividual)
                            {
                                <a asp-action="StartIndividualExam"
                                   asp-controller="StudentExamFlow"
                                   asp-route-examAssignmentId="@exam.ExamAssignmentId"
                                   class="exam-btn btn-start">
                                    <i class="fa-solid fa-play"></i>
                                    ابدأ
                                </a>
                            }
                            else
                            {
                                <a asp-action="StartExam"
                                   asp-controller="StudentExamFlow"
                                   asp-route-examAssignmentId="@exam.ExamAssignmentId"
                                   class="exam-btn btn-start">
                                    <i class="fa-solid fa-play"></i>
                                    ابدأ
                                </a>
                            }
                        }
                        else
                        {
                            <button type="button" class="exam-btn btn-disabled" disabled>
                                <i class="fa-solid fa-hourglass-half"></i>
                                @exam.StatusText
                            </button>
                        }
                    </div>

                </div>
            }

        </div>

        <div class="exam-empty" id="exam-empty" style="display:@(total == 0 ? "block" : "none")">
            <div class="exam-empty-ico">📭</div>
            <h3>لا توجد اختبارات متاحة حاليًا</h3>
            <p>عند إرسال اختبار جديد لك سيظهر هنا مباشرة.</p>
        </div>

    </div>
</div>

<script>
    const examCards = Array.from(document.querySelectorAll('.exam-card'));
    let currentExamFilter = 'all';

    function setExamFilter(btn) {
        document.querySelectorAll('.exam-filter-btn').forEach(function (b) {
            b.classList.remove('active');
        });

        btn.classList.add('active');
        currentExamFilter = btn.dataset.filter;
        applyExamFilters();
    }

    function applyExamFilters() {
        const searchInput = document.getElementById('exam-search-input');
        const sortSelect = document.getElementById('exam-sort-sel');
        const grid = document.getElementById('exam-grid');
        const countShown = document.getElementById('exam-count-shown');
        const empty = document.getElementById('exam-empty');

        const q = searchInput ? searchInput.value.toLowerCase().trim() : '';
        const sort = sortSelect ? sortSelect.value : 'assigned-desc';

        let visible = examCards.filter(function (card) {
            const matchFilter = currentExamFilter === 'all' || card.dataset.status === currentExamFilter;
            const matchSearch = !q || (card.dataset.title || '').indexOf(q) >= 0;

            return matchFilter && matchSearch;
        });

        visible.sort(function (a, b) {
            if (sort === 'assigned-desc') {
                return (b.dataset.assigned || '').localeCompare(a.dataset.assigned || '');
            }

            if (sort === 'assigned-asc') {
                return (a.dataset.assigned || '').localeCompare(b.dataset.assigned || '');
            }

            if (sort === 'scheduled-desc') {
                return (b.dataset.scheduled || '').localeCompare(a.dataset.scheduled || '');
            }

            if (sort === 'scheduled-asc') {
                return (a.dataset.scheduled || '').localeCompare(b.dataset.scheduled || '');
            }

            if (sort === 'score-desc') {
                return (+b.dataset.score || 0) - (+a.dataset.score || 0);
            }

            if (sort === 'score-asc') {
                return (+a.dataset.score || 0) - (+b.dataset.score || 0);
            }

            if (sort === 'title-asc') {
                return (a.dataset.title || '').localeCompare(b.dataset.title || '', 'ar');
            }

            return 0;
        });

        const visibleSet = new Set(visible);

        examCards.forEach(function (card) {
            if (visibleSet.has(card)) {
                card.style.display = '';
                grid.appendChild(card);
            } else {
                card.style.display = 'none';
            }
        });

        if (countShown) {
            countShown.textContent = visible.length;
        }

        if (empty) {
            empty.style.display = visible.length ? 'none' : 'block';
        }
    }

    (function () {
        document.querySelectorAll('.exam-score-fill').forEach(function (el) {
            const target = el.style.width;
            el.style.width = '0';

            requestAnimationFrame(function () {
                requestAnimationFrame(function () {
                    el.style.width = target;
                });
            });
        });

        applyExamFilters();
    })();
</script>