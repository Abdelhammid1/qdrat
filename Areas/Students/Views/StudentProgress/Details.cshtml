@model QdratNew.ViewModels.StudentProgressViewModel
@{
    ViewData["Title"] = "📊 تقدم الطالب";
    var avgScore = Model.PerformanceRecords.Any() ? Model.PerformanceRecords.Average(p => p.Score) : 0;
    var status = avgScore >= 85 ? "متفوق 🔥" : avgScore >= 60 ? "جيد ✨" : "يحتاج دعم 💡";
    var scoreColor = avgScore >= 85 ? "success" : avgScore >= 60 ? "warning" : "danger";
}

<div class="container mt-4">

    <div class="alert alert-info shadow-sm">
        <h4><i class="fas fa-user-graduate"></i> الطالب: @Model.FullName</h4>
        <p class="mb-1"><strong>المدرسة:</strong> @Model.School | <strong>المرحلة:</strong> @Model.Level | <strong>الجنس:</strong> @Model.Gender</p>
        <p class="mb-0"><strong>التقييم العام:</strong> <span class="badge bg-@scoreColor">@status</span></p>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-@scoreColor text-white">
            <i class="fas fa-chart-line"></i> الأداء التفصيلي حسب المحاور
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>📘 القسم</th>
                        <th>📚 المحور</th>
                        <th>📈 الدرجة</th>
                        <th>📅 التاريخ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.PerformanceRecords)
                    {
                        var color = item.Score >= 85 ? "table-success" : item.Score >= 60 ? "table-warning" : "table-danger";
                        <tr class="@color">
                            <td>@item.CurriculumTitle</td>
                            <td>@item.SectionTitle</td>
                            <td><strong>@item.Score</strong></td>
                            <td>@item.Date.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
