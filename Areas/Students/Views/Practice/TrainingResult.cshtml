@model QdratNew.ViewModels.Students.TrainingResultViewModel
@using QdratNew.Helpers

@{
    ViewData["Title"] = "نتيجة التدريب";
    Func<string, string> convert = s => Model.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(s) : s;
}

<div class="container mt-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">📊 نتيجة التدريب</h2>
        <p class="text-muted">لقد أنهيت جلستك التدريبية المكونة من @Model.TotalQuestions سؤال.</p>
    </div>

    <!-- ✅ ملخص النتائج -->
    <div class="row text-center mb-5">
        <div class="col-md-4">
            <div class="card shadow-sm border-success">
                <div class="card-body">
                    <h5 class="text-success fw-bold">✔️ صحيحة</h5>
                    <h3>@Model.CorrectAnswers</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-danger">
                <div class="card-body">
                    <h5 class="text-danger fw-bold">❌ خاطئة</h5>
                    <h3>@(Model.TotalQuestions - Model.CorrectAnswers)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-info">
                <div class="card-body">
                    <h5 class="text-info fw-bold">📈 النسبة</h5>
                    <h3>@Model.ScorePercentage %</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- ✅ رسالة تشجيعية -->
    <div class="alert text-center fw-bold shadow-sm
         @(Model.ScorePercentage >= 80 ? "alert-success"
                    : Model.ScorePercentage >= 50 ? "alert-warning"
                    : "alert-danger")">
        @if (Model.ScorePercentage >= 80)
        {
            <span>🎉 رائع! مستواك ممتاز في هذا التدريب.</span>
        }
        else if (Model.ScorePercentage >= 50)
        {
            <span>💡 أداء جيد، لكن مازال هناك مجال للتحسين.</span>
        }
        else
        {
            <span>🚀 لا تقلق! استمر في التدريب وستحقق نتائج أفضل.</span>
        }
    </div>

    <!-- ✅ عرض الأخطاء -->
    @if (Model.WrongQuestions.Any())
    {
        <h4 class="fw-bold mt-5 mb-3 text-danger">❌ الأسئلة التي أخطأت فيها:</h4>
        <table class="table table-bordered shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>السؤال</th>
                    <th>إجابتك</th>
                    <th>الإجابة الصحيحة</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var w in Model.WrongQuestions)
                {
                    <tr>
                        <td>@Html.Raw(convert(w.QuestionTitle))</td>
                        <td class="text-danger fw-bold">@Html.Raw(convert(w.StudentAnswer ?? "لم يجب"))</td>
                        <td class="text-success fw-bold">@Html.Raw(convert(w.CorrectAnswer ?? "-"))</td>
                    </tr>
                }
            </tbody>

        </table>
    }

    <!-- ✅ أزرار التحكم -->
    <div class="text-center mt-5">
        <a asp-action="StartWeaknessPractice" asp-route-sectionId="@Model.SectionId"
           class="btn btn-warning btn-lg me-3">
            🔄 إعادة التدريب
        </a>
        <a asp-action="ExamDashboard" asp-controller="Exams" asp-area="Students"
           class="btn btn-success btn-lg">
            🏠 العودة للداشبورد
        </a>
    </div>
</div>
