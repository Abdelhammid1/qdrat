<!DOCTYPE html>
<html lang="ar" dir="rtl">
 <!-- ✅ تفعيل دعم اللغة العربية -->
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="لوحة تحكم QdratNew - إدارة الدورات والطلاب بسهولة">
    <meta name="keywords" content="لوحة التحكم, QdratNew, إدارة الدورات, إدارة الطلاب, التعليم">
    <meta name="author" content="QdratNew Team">
    <title>@ViewData["Title"] - لوحة التحكم | QdratNew</title>

    @RenderSection("Styles", required: false)

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Naskh+Arabic&display=swap" rel="stylesheet">

    <!-- ✅ مكتبة DataTables الأساسية -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.3.6/css/buttons.dataTables.min.css">

    <!-- ✅ مكتبة FontAwesome للأيقونات -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">


    <!-- ✅ Mathlive CSS -->
    <link rel="stylesheet" href="https://unpkg.com/mathlive/dist/mathlive.core.css">
    <link rel="stylesheet" href="https://unpkg.com/mathlive/dist/mathlive.css">

    <!-- ✅ Mathlive JS -->
    <script src="https://unpkg.com/mathlive/dist/mathlive.min.js"></script>

	<link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
	<link href="../lib/mathquill/mathquill.min.css" rel="stylesheet" />

    <style>
        body {
            font-family: 'Cairo', 'Tajawal', sans-serif;
            background-color: #f8f9fa;
        }
        .navbar-brand {
            font-weight: bold;
            font-size: 1.2rem;
        }
        .sidebar {
            min-height: 100vh;
            background-color: #343a40;
            color: white;
            padding: 15px;
        }
        .sidebar a {
            color: white;
            text-decoration: none;
            display: block;
            padding: 10px;
            border-radius: 5px;
            transition: 0.3s;
        }
        .sidebar a:hover {
            background-color: #495057;
        }
        .content {
            padding: 20px;
        }

        .dashboard-card {
            min-height: 110px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .dashboard-card h6 {
                font-size: 15px;
            }

            .dashboard-card .card-text {
                font-size: 28px;
                font-weight: bold;
            }

        body {
            font-family: 'Cairo', sans-serif;
            direction: rtl;
        }

        .info-box {
            background: #eef1f8;
            border-radius: 10px;
            padding: 0.75rem;
            flex: 1;
            min-width: 160px;
        }

            .info-box h4 {
                margin: 0 0 0.5rem;
                color: #222;
            }

            .info-box p {
                margin: 0;
                font-size: 1rem;
                color: #333;
            }

        .instructor-info {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
        }

        canvas {
            max-width: 100%;
            height: 240px !important;
        }

       
        .math-editable {
            border: 1px solid #ccc;
            min-height: 60px;
            padding: 10px;
            font-size: 20px;
            background-color: #fff;
            border-radius: 6px;
            direction: rtl;
        }
   


    </style>
 
</head>
<body>
    @await Html.PartialAsync("~/Views/Shared/_ImpersonationBanner.cshtml")
    <div class="container-fluid">
        <div class="row">
            <!-- ✅ الشريط الجانبي -->
            <nav class="col-md-3 col-lg-2 d-md-block sidebar">
                <h4 class="text-center mt-3">🚀 لوحة التحكم</h4>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <i class="fas fa-home"></i> الصفحة الرئيسية
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Students" asp-action="Index">
                            <i class="fas fa-user-graduate"></i> إدارة الطلاب
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Courses" asp-action="Index">
                            <i class="fas fa-book"></i> إدارة الدورات
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Notifications" asp-action="Index">
                            <i class="fas fa-bell"></i> الإشعارات
                        </a>

                    </li>
                   @*  <li class="nav-item">
                        <button id="toggleDarkMode" class="btn btn-secondary">
                            🌙 تفعيل الوضع الداكن
                        </button>


                    </li> *@

                    <li class="nav-item">
                        <form asp-area="Identity" asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-danger w-100 mt-3">
                                <i class="fas fa-sign-out-alt"></i> تسجيل الخروج
                            </button>
                        </form>
                    </li>
                </ul>
            </nav>

            <!-- ✅ المحتوى الرئيسي -->
            <main class="col-md-9 ms-sm-auto col-lg-10 content">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="footer bg-dark text-light text-center py-3 mt-4">
        <div class="container">
            &copy; 2025 - QdratNew - جميع الحقوق محفوظة.
        </div>
    </footer>

    <!-- ✅ تحميل jQuery أولًا -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- ✅ تحميل مكتبة DataTables -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.print.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


    <!-- ✅ تحميل مكتبة FontAwesome للأيقونات -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>

    <!-- ✅ مكتبة Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
   


  

    <!-- ✅ دعم JavaScript الإضافي -->
    @await RenderSectionAsync("Scripts", required: false)


</body>
</html>
