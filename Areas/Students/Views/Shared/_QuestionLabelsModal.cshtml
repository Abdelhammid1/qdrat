@model QdratNew.ViewModels.Question.QuestionLabelModalViewModel

<div class="modal fade" id="labelsModal_@Model.QuestionId" tabindex="-1" aria-labelledby="labelsModalLabel_@Model.QuestionId" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-end">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="labelsModalLabel_@Model.QuestionId">
                    <i class="fas fa-tags me-2"></i> التصنيفات الخاصة بالسؤال
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @if (Model.SelectedLabels.Any())
                {
                    <ul class="list-group" dir="rtl" style="float:right;display:block">
                        @foreach (var label in Model.SelectedLabels)
                        {
                            <li class="list-group-item" style="float:right;display:block">
                                <i class="fas fa-check-circle text-success me-2"></i> @label
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">لا توجد تصنيفات مضافة لهذا السؤال.</p>
                }
            </div>
        </div>
    </div>
</div>
