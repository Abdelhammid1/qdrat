@model int

<div class="container mt-5 text-center" dir="rtl">
    <h3 class="mb-3 text-primary fw-bold">🔐 التحقق من الكود المرجعي</h3>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form method="post" asp-action="VerifyGeneralExamCode" asp-route-id="@Model">
        @Html.AntiForgeryToken()

        <label class="fw-bold mb-2">أدخل الكود المرجعي لفتح الاختبار:</label>

        <input type="text"
               name="code"
               class="form-control text-center mb-3"
               maxlength="6"
               required />

        <button class="btn btn-success w-50">متابعة →</button>
    </form>
</div>
