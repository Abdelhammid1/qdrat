@model QdratNew.ViewModels.Students.ExamSolveViewModel
@{
    ViewData["Title"] = "بدء الاختبار";
    Layout = "~/Views/Shared/_QuestionStudentLayout.cshtml";
}

<!-- منع الرجوع -->
<script>
    history.pushState(null, "", location.href);
    window.onpopstate = function () {
        history.pushState(null, "", location.href);
        location.href = "/Students/StudentExamFlow/ErrorMessage?msg=لقد انتهى الاختبار ولا يمكن الرجوع.";
    };
</script>

<meta http-equiv="Cache-Control" content="no-store, must-revalidate" />
<meta http-equiv="Pragma" content="no-store" />
<meta http-equiv="Expires" content="0" />

<div class="container-fluid mt-3 px-3 px-md-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold text-qdrat">📝 الاختبار: @Model.ExamTitle</h4>
        <div class="fw-bold text-danger">
            الوقت المتبقي: <span id="time-remaining"></span>
        </div>
    </div>

    <!-- Overlay -->
    <div id="loadingOverlay"
         style="display:none; position:fixed; inset:0; background:rgba(255,255,255,.85);
                z-index:9999; align-items:center; justify-content:center; flex-direction:column;">
        <div class="spinner-border text-primary"></div>
        <p class="mt-3 fw-bold">جاري تحميل السؤال...</p>
    </div>

    <div id="question-container">
        @await Html.PartialAsync("_SolveUnifiedExamPartial", Model)
    </div>
</div>

<!-- Fullscreen Lock -->
<div id="examLockOverlay">
    <div class="exam-lock-box text-center">
        <h3 class="fw-bold mb-3">🚫 لا يمكنك الخروج من وضع الاختبار</h3>
        <p class="mb-4">يجب العودة لوضع الشاشة الكاملة لمتابعة الاختبار.</p>
        <button id="returnToExamBtn" class="btn btn-primary btn-lg">العودة للاختبار</button>
    </div>
</div>

<style>
    #examLockOverlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.95);
        display: none;
        z-index: 999999;
        align-items: center;
        justify-content: center;
        color: #fff;
    }

    .exam-lock-box {
        background: rgba(255,255,255,.08);
        border-radius: 16px;
        padding: 40px;
        max-width: 520px;
    }
</style>

@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@section Scripts {

    @Html.AntiForgeryToken()

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            TranslationGuard.init({
                attemptType: 2,
                attemptEntityId: @Model.ExamAssignmentId,
                antiForgeryToken: '@Antiforgery.GetAndStoreTokens(Context).RequestToken'
            });
        });
    </script>

    <script>
        /* =====================================================
           🔒 قفل عام واحد فقط (الحل الجذري)
        ===================================================== */
        window.__EXAM_FINISHED__ = false;

        /* =====================================================
           ⏱ توقيت السؤال
        ===================================================== */
        window.questionStartTime = Date.now();
        let isSubmitting = false;

        function resetQuestionTimer() {
            window.questionStartTime = Date.now();
            if (typeof window.startStopwatch === 'function') window.startStopwatch();
        }

        function getTimeTaken() {
            const sec = Math.floor((Date.now() - window.questionStartTime) / 1000);
            return sec > 0 ? sec : 1;
        }

        /* =====================================================
           ⏰ المؤقت العام
        ===================================================== */
        function initMainTimer() {
            let remaining = parseInt('@Model.RemainingSeconds') || 0;
            const end = Date.now() + remaining * 1000;
            const el = document.getElementById("time-remaining");

            const timer = setInterval(() => {
                const diff = Math.floor((end - Date.now()) / 1000);
                if (diff <= 0) {
                    clearInterval(timer);
                    Swal.fire("انتهى الوقت", "سيتم إنهاء الاختبار", "info")
                        .then(() => submitFinalExam(true));
                    return;
                }
                el.innerText =
                    `${Math.floor(diff/60).toString().padStart(2,'0')}:${(diff%60).toString().padStart(2,'0')}`;
            }, 1000);
        }

        /* =====================================================
           🔒 Fullscreen
        ===================================================== */
        function initFullScreenLock() {
            const overlay = document.getElementById("examLockOverlay");
            const btn = document.getElementById("returnToExamBtn");

            document.addEventListener("fullscreenchange", () => {
                overlay.style.display = document.fullscreenElement ? "none" : "flex";
            });

            btn.onclick = async () => {
                await document.documentElement.requestFullscreen();
                overlay.style.display = "none";
            };

            document.addEventListener("click", function init() {
                if (!document.fullscreenElement)
                    document.documentElement.requestFullscreen();
                document.removeEventListener("click", init);
            });
        }

        /* =====================================================
           🔄 تحميل السؤال
        ===================================================== */
        async function loadNextQuestion(formData) {

            if (isSubmitting || window.__EXAM_FINISHED__) return;
            isSubmitting = true;

            $("#loadingOverlay").fadeIn(150);

            const res = await fetch("/Students/StudentExamFlow/SubmitExamAnswerFetch", {
                method: "POST",
                body: formData,
                credentials: "include"
            });

            const html = await res.text();
            $("#loadingOverlay").fadeOut(150);

            if (html.trim().startsWith("<")) {
                document.getElementById("question-container").innerHTML = html;
                attachNavEvents();
                attachSubmitExamEvent();
                resetQuestionTimer();
                if (typeof window.syncOptionStyles === 'function') window.syncOptionStyles();
                window.scrollTo({ top: 0, behavior: "smooth" });
            }

            isSubmitting = false;
        }

        /* =====================================================
           🔘 التنقل
        ===================================================== */
        function attachNavEvents() {

            document.querySelectorAll(".exam-nav-button, .review-jump")
                .forEach(btn => {

                    btn.onclick = async e => {
                        e.preventDefault();
                        if (window.__EXAM_FINISHED__) return;

                        const form = document.getElementById("exam-question-form");
                        if (!form) return;

                        const fd = new FormData(form);
                        const nav = btn.dataset.nav || "goto";

                        if (nav === "next" || nav === "prev")
                            fd.set("timeTakenSeconds", getTimeTaken());
                        else
                            fd.set("timeTakenSeconds", 0);

                        if (btn.classList.contains("review-jump")) {
                            fd.append("nav", "goto");
                            fd.append("target", btn.dataset.target);
                        } else {
                            fd.append("nav", nav);
                        }

                        await loadNextQuestion(fd);
                    };
                });
        }

        /* =====================================================
           🏁 الإنهاء (المسار الوحيد)
        ===================================================== */
        async function submitFinalExam(force) {

            if (window.__EXAM_FINISHED__) return;
            window.__EXAM_FINISHED__ = true;

            const id = @Model.ExamAssignmentId;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            const res = await fetch(
                `/Students/StudentExamFlow/SubmitFinalExam?id=${id}&forceSubmit=${force ? 'true' : 'false'}`,
                {
                    method: "POST",
                    headers: { "RequestVerificationToken": token },
                    credentials: "include"
                }
            );

            const result = await res.json();

            if (result.success && result.redirectUrl) {
                window.location.replace(result.redirectUrl);
            } else {
                window.__EXAM_FINISHED__ = false;
                Swal.fire("خطأ", result.message || "لم يتم إنهاء الاختبار", "error");
            }
        }

        /* =====================================================
           🚀 Init
        ===================================================== */
        document.addEventListener("DOMContentLoaded", () => {
            attachNavEvents();
            attachSubmitExamEvent();
            initMainTimer();
            initFullScreenLock();
            resetQuestionTimer();
        });

        /* =====================================================
           🔘 زر إنهاء الاختبار
        ===================================================== */
        function attachSubmitExamEvent() {
            const btn = document.getElementById("submitExam");
            if (!btn) return;

            btn.onclick = function () {
                submitFinalExam(false);
            };
        }
    </script>

}
