@model QdratNew.ViewModels.Students.SessionRatingViewModel

@{
    ViewData["Title"] = "تقييم الجلسة";
}

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white text-center fw-bold">
            📝 تقييم الجلسة التدريبية
        </div>
        <div class="card-body">

            <!-- معلومات الجلسة -->
            <div class="alert alert-info text-center">
                <h5 class="mb-3">👋 مرحبًا بك! رقم الطالب الخاص بك هو: <span class="badge bg-dark">@Model.StudentId</span></h5>

                <p><strong>👨‍🏫 المدرب:</strong> @Model.InstructorName</p>
                <p><strong>🏫 الفرع:</strong> @Model.BranchName</p>
                <p><strong>📅 التاريخ:</strong> @Model.SessionDate.ToString("yyyy-MM-dd")</p>
            </div>
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <!-- تمرير SessionId و StudentId -->
                <input type="hidden" asp-for="SessionId" />
                <input type="hidden" asp-for="StudentId" />

                <div class="mb-3">
                    <label asp-for="TrainerClarity">وضوح الشرح</label>
                    <input asp-for="TrainerClarity" class="form-control" min="1" max="5" type="number" />
                </div>

                <div class="mb-3">
                    <label asp-for="TrainerCommitment">الالتزام بالمواعيد</label>
                    <input asp-for="TrainerCommitment" class="form-control" min="1" max="5" type="number" />
                </div>

                <div class="mb-3">
                    <label asp-for="SessionBenefit">مدى الاستفادة</label>
                    <input asp-for="SessionBenefit" class="form-control" min="1" max="5" type="number" />
                </div>

                <div class="mb-3">
                    <label asp-for="Comment">ملاحظات إضافية</label>
                    <textarea asp-for="Comment" class="form-control" rows="3"></textarea>
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="fas fa-paper-plane"></i> إرسال التقييم
                    </button>
                    <a asp-action="Dashboard" asp-controller="StudySessions" class="btn btn-secondary ms-2">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
