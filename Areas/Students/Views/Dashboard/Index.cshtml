@model QdratNew.ViewModels.Students.StudentMainDashboardVm

@section Styles {
    <link href="~/css/student/student-dashboard.css" rel="stylesheet" asp-append-version="true" />
}
@{
    ViewData["Title"] = "أدائي الأكاديمي";
    double overallPct  = Model.OverallProgress;
    double examCircle  = 263.89 * (1 - Model.BestExamScore     / 100.0);
    double hwCircle    = 263.89 * (1 - Model.BestHomeworkScore  / 100.0);
    double exSucc      = 263.89 * (1 - Model.SuccessRateExams    / 100.0);
    double hwSucc      = 263.89 * (1 - Model.SuccessRateHomeworks/ 100.0);
}



<div class="pd-root">

    <!-- ═══════════════ HERO ═══════════════ -->
    <div class="pd-hero pd-in">
        <svg width="0" height="0" style="position:absolute">
            <defs>
                <linearGradient id="heroGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%"   stop-color="#2dd4bf"/>
                    <stop offset="100%" stop-color="#a78bfa"/>
                </linearGradient>
                <linearGradient id="tealGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%"   stop-color="#2dd4bf"/>
                    <stop offset="100%" stop-color="#38bdf8"/>
                </linearGradient>
                <linearGradient id="amberGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%"   stop-color="#fbbf24"/>
                    <stop offset="100%" stop-color="#fb7185"/>
                </linearGradient>
                <linearGradient id="violetGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%"   stop-color="#a78bfa"/>
                    <stop offset="100%" stop-color="#38bdf8"/>
                </linearGradient>
                <linearGradient id="greenGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%"   stop-color="#4ade80"/>
                    <stop offset="100%" stop-color="#2dd4bf"/>
                </linearGradient>
            </defs>
        </svg>

        <div class="pd-hero-inner">
            <div class="pd-hero-text">
                <h1>أدائي الأكاديمي</h1>
                <p>لمحة شاملة عن مستواك — الواجبات، الاختبارات، ومكانتك بين زملائك</p>
                <div class="pd-hero-stats">
                    <div class="pd-hero-stat">
                        <span class="dot" style="background:var(--c-teal)"></span>
                        <span>واجبات: <strong>@Model.TotalHomeworks</strong></span>
                    </div>
                    <div class="pd-hero-stat">
                        <span class="dot" style="background:var(--c-violet)"></span>
                        <span>اختبارات: <strong>@Model.TotalExams</strong></span>
                    </div>
                    @if (Model.StudentRank != null && Model.StudentRank.Rank > 0)
                    {
                        <div class="pd-hero-stat">
                            <span class="dot" style="background:var(--c-amber)"></span>
                            <span>الترتيب: <strong>@Model.StudentRank.Rank / @Model.StudentRank.TotalStudents</strong></span>
                        </div>
                    }
                </div>
            </div>

            <!-- Radial overall progress -->
            <div class="pd-radial">
                <svg viewBox="0 0 160 160">
                    <circle class="pd-radial-track" cx="80" cy="80" r="70"/>
                    <circle class="pd-radial-fill"  cx="80" cy="80" r="70"
                            stroke-dasharray="439.82"
                            stroke-dashoffset="@((439.82 * (1.0 - overallPct / 100.0)).ToString("F2", System.Globalization.CultureInfo.InvariantCulture))"/>
                </svg>
                <div class="pd-radial-label">
                    <span class="num">@Model.OverallProgress.ToString("F0")%</span>
                    <span class="sub">التقدم<br>العام</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════ BATCH BAR ═══════════════ -->
  @*   <div class="pd-batch-bar pd-in pd-in-1">
        <div class="pd-batch-bar-inner">
            <span class="pd-batch-label">الدفعة</span>
            @await Component.InvokeAsync("StudentBatchIcons")
        </div>
    </div> *@

    <!-- ═══════════════ BODY ═══════════════ -->
    <div class="pd-body">

        <!-- ─── METRIC STRIP ─── -->
        <div class="pd-metric-strip pd-in pd-in-2">

            <!-- الواجبات -->
            <a href="/Students/StudentHomeworkDashboardNew/Dashboard" style="text-decoration:none;">
                <div class="pd-metric-tile">
                    <div class="pd-tile-glow" style="background:var(--c-teal-dim)"></div>
                    <div class="pd-tile-accent" style="color:var(--c-teal)">الواجبات</div>
                    <div class="pd-tile-number" style="color:var(--c-teal)">@Model.TotalHomeworks</div>
                    <div class="pd-tile-label">إجمالي الواجبات المُسندة</div>
                    <div class="pd-tile-pills">
                        <span class="pd-chip" style="background:rgba(74,222,128,.15);color:var(--c-green)">✓ @Model.CompletedHomeworks مكتمل</span>
                        <span class="pd-chip" style="background:rgba(56,189,248,.12);color:var(--c-sky)">⏳ @Model.PendingHomeworks مطلوب</span>
                        <span class="pd-chip" style="background:rgba(251,113,133,.12);color:var(--c-rose)">! @Model.LateHomeworks متأخر</span>
                    </div>
                </div>
            </a>

            <!-- الاختبارات -->
            <a href="/Students/StudentExamDashboard/Index" style="text-decoration:none;">
                <div class="pd-metric-tile">
                    <div class="pd-tile-glow" style="background:var(--c-violet-dim)"></div>
                    <div class="pd-tile-accent" style="color:var(--c-violet)">الاختبارات</div>
                    <div class="pd-tile-number" style="color:var(--c-violet)">@Model.TotalExams</div>
                    <div class="pd-tile-label">إجمالي الاختبارات المُسندة</div>
                    <div class="pd-tile-pills">
                        <span class="pd-chip" style="background:rgba(74,222,128,.15);color:var(--c-green)">✓ @Model.CompletedExams مكتمل</span>
                        <span class="pd-chip" style="background:rgba(56,189,248,.12);color:var(--c-sky)">⏳ @Model.PendingExams مطلوب</span>
                        <span class="pd-chip" style="background:rgba(251,113,133,.12);color:var(--c-rose)">! @Model.LateExams متأخر</span>
                    </div>
                </div>
            </a>

            <!-- أفضل نتيجة اختبار -->
            <div class="pd-metric-tile">
                <div class="pd-tile-glow" style="background:var(--c-amber-dim)"></div>
                <div class="pd-tile-accent" style="color:var(--c-amber)">أفضل اختبار</div>
                <div class="pd-tile-number" style="color:var(--c-amber)">@Model.BestExamScore.ToString("F0")%</div>
                <div class="pd-tile-label">أعلى درجة في اختبار واحد</div>
                <div class="pd-tile-pills">
                    <span class="pd-chip" style="background:var(--c-amber-dim);color:var(--c-amber)">
                        معدل النجاح @Model.SuccessRateExams.ToString("F0")%
                    </span>
                </div>
            </div>

            <!-- أفضل نتيجة واجب -->
            <div class="pd-metric-tile">
                <div class="pd-tile-glow" style="background:var(--c-rose-dim)"></div>
                <div class="pd-tile-accent" style="color:var(--c-rose)">أفضل واجب</div>
                <div class="pd-tile-number" style="color:var(--c-rose)">@Model.BestHomeworkScore.ToString("F0")%</div>
                <div class="pd-tile-label">أعلى درجة في واجب واحد</div>
                <div class="pd-tile-pills">
                    <span class="pd-chip" style="background:var(--c-rose-dim);color:var(--c-rose)">
                        معدل النجاح @Model.SuccessRateHomeworks.ToString("F0")%
                    </span>
                </div>
            </div>

        </div>

        <!-- ─── MIDDLE GRID: gauges + insights + ranking ─── -->
        <div class="pd-mid-grid pd-in pd-in-3">

            <!-- LEFT: gauges + insights -->
            <div style="display:flex;flex-direction:column;gap:16px;">

                <!-- 4 gauge rings -->
                <div class="pd-gauges">
                    <div class="pd-gauges-title">مقاييس الأداء التفصيلية</div>
                    <div class="pd-gauges-grid">

                        <div class="pd-gauge-item">
                            <div class="pd-gauge-ring">
                                <svg viewBox="0 0 64 64">
                                    <circle class="pd-gauge-track" cx="32" cy="32" r="26"/>
                                    <circle class="pd-gauge-fill" cx="32" cy="32" r="26"
                                            stroke="url(#tealGrad)"
                                            stroke-dasharray="163.36"
                                            stroke-dashoffset="@(163.36 * (1 - Model.BestExamScore / 100.0))"/>
                                </svg>
                                <div class="pd-gauge-num">@Model.BestExamScore.ToString("F0")</div>
                            </div>
                            <div class="pd-gauge-text">
                                <div class="pd-gauge-val" style="color:var(--c-teal)">@Model.BestExamScore.ToString("F0")%</div>
                                <div class="pd-gauge-lbl">أفضل اختبار</div>
                            </div>
                        </div>

                        <div class="pd-gauge-item">
                            <div class="pd-gauge-ring">
                                <svg viewBox="0 0 64 64">
                                    <circle class="pd-gauge-track" cx="32" cy="32" r="26"/>
                                    <circle class="pd-gauge-fill" cx="32" cy="32" r="26"
                                            stroke="url(#amberGrad)"
                                            stroke-dasharray="163.36"
                                            stroke-dashoffset="@(163.36 * (1 - Model.BestHomeworkScore / 100.0))"/>
                                </svg>
                                <div class="pd-gauge-num">@Model.BestHomeworkScore.ToString("F0")</div>
                            </div>
                            <div class="pd-gauge-text">
                                <div class="pd-gauge-val" style="color:var(--c-amber)">@Model.BestHomeworkScore.ToString("F0")%</div>
                                <div class="pd-gauge-lbl">أفضل واجب</div>
                            </div>
                        </div>

                        <div class="pd-gauge-item">
                            <div class="pd-gauge-ring">
                                <svg viewBox="0 0 64 64">
                                    <circle class="pd-gauge-track" cx="32" cy="32" r="26"/>
                                    <circle class="pd-gauge-fill" cx="32" cy="32" r="26"
                                            stroke="url(#violetGrad)"
                                            stroke-dasharray="163.36"
                                            stroke-dashoffset="@(163.36 * (1 - Model.SuccessRateExams / 100.0))"/>
                                </svg>
                                <div class="pd-gauge-num">@Model.SuccessRateExams.ToString("F0")</div>
                            </div>
                            <div class="pd-gauge-text">
                                <div class="pd-gauge-val" style="color:var(--c-violet)">@Model.SuccessRateExams.ToString("F0")%</div>
                                <div class="pd-gauge-lbl">معدل نجاح الاختبارات</div>
                            </div>
                        </div>

                        <div class="pd-gauge-item">
                            <div class="pd-gauge-ring">
                                <svg viewBox="0 0 64 64">
                                    <circle class="pd-gauge-track" cx="32" cy="32" r="26"/>
                                    <circle class="pd-gauge-fill" cx="32" cy="32" r="26"
                                            stroke="url(#greenGrad)"
                                            stroke-dasharray="163.36"
                                            stroke-dashoffset="@(163.36 * (1 - Model.SuccessRateHomeworks / 100.0))"/>
                                </svg>
                                <div class="pd-gauge-num">@Model.SuccessRateHomeworks.ToString("F0")</div>
                            </div>
                            <div class="pd-gauge-text">
                                <div class="pd-gauge-val" style="color:var(--c-green)">@Model.SuccessRateHomeworks.ToString("F0")%</div>
                                <div class="pd-gauge-lbl">معدل نجاح الواجبات</div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- insights strip -->
                <div class="pd-insight-stack">
                    <div class="pd-insight-card">
                        <div class="pd-ic-head">
                            <div class="pd-ic-dot" style="background:var(--c-rose)"></div>
                            <div class="pd-ic-label" style="color:var(--c-rose)">نقطة تحتاج لتحسين</div>
                        </div>
                        <div class="pd-ic-value">@Model.WeakestSectionTitle</div>
                        <div class="pd-bar-track">
                            <div class="pd-bar-fill" style="width:@(Model.WeakestSectionScore)%;background:var(--c-rose)"></div>
                        </div>
                        <div class="pd-ic-sub">إنجاز @Model.WeakestSectionScore.ToString("F0")%</div>
                    </div>
                    <div class="pd-insight-card">
                        <div class="pd-ic-head">
                            <div class="pd-ic-dot" style="background:var(--c-teal)"></div>
                            <div class="pd-ic-label" style="color:var(--c-teal)">التقدم الكلي</div>
                        </div>
                        <div class="pd-ic-value">@Model.OverallProgress.ToString("F0")%</div>
                        <div class="pd-bar-track">
                            <div class="pd-bar-fill" style="width:@(Model.OverallProgress)%;background:linear-gradient(90deg,var(--c-teal),var(--c-violet))"></div>
                        </div>
                        <div class="pd-ic-sub">استمر — أنت على المسار الصحيح</div>
                    </div>
                </div>

            </div>

            <!-- RIGHT: ranking -->
            @if (Model.StudentRank != null && Model.StudentRank.Rank > 0 && Model.StudentRank.Rank <= 3)
            {
                <div class="pd-rank-card">
                    <div class="pd-rank-hero">
                        <div class="pd-rank-eyebrow">ترتيبك في الدفعة</div>
                        <div class="pd-rank-num" style="color:#fff;font-size:3.4rem;font-weight:900;line-height:1;margin-bottom:2px;">
                            #@Model.StudentRank.Rank
                        </div>
                        <div class="pd-rank-of">من أصل @Model.StudentRank.TotalStudents طالب</div>
                    </div>
                    <div class="pd-rank-medal">
                        <img src="@Model.StudentRank.MedalImageUrl" alt="ميدالية" />
                        <p class="pd-rank-msg">@Model.StudentRank.MotivationalMessage</p>
                    </div>
                    <a href="/Students/Exams/ExamDashboard" class="pd-rank-cta">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                        </svg>
                        واصل التميز
                    </a>
                </div>
            }
            else
            {
                <div class="pd-motivate">
                    <img src="/images/roport.png" alt="تحفيز" />
                    @if (Model.StudentRank != null && Model.StudentRank.Rank > 0)
                    {
                        <p style="color:var(--t-primary);font-weight:800;font-size:1.1rem;">
                            المركز <span style="color:var(--c-violet)">#@Model.StudentRank.Rank</span>
                        </p>
                        <p>من @Model.StudentRank.TotalStudents طالب. حل مزيداً من الاختبارات والواجبات لتتقدم في الترتيب.</p>
                    }
                    else
                    {
                        <p>أنجز المزيد من الواجبات والاختبارات لتظهر ضمن قائمة المتصدرين.</p>
                    }
                    <a href="/Students/Exams/ExamDashboard" class="pd-rank-cta" style="margin:0;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                        </svg>
                        ابدأ التحسين
                    </a>
                </div>
            }

        </div>

        <!-- ─── CHARTS: Performance Trends ─── -->
        <div class="pd-section-head pd-in pd-in-4">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--c-teal)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
            مسار الأداء — تطور إجاباتك عبر الوقت
        </div>

        <div class="pd-charts-row pd-in pd-in-4" id="pd-charts-zone" style="position:relative;">
            <div class="pd-overlay" id="pd-loader"><div class="pd-spin"></div></div>

            <!-- Homework trend -->
            <div class="pd-chart-box">
                <div class="pd-chart-top">
                    <div class="pd-chart-top-left">
                        <h6>مسار الواجبات</h6>
                        <p>صحيحة / خاطئة / متخطاة لكل واجب</p>
                    </div>
                    <span class="pd-chart-badge" style="background:var(--c-teal-dim);color:var(--c-teal)">الواجبات</span>
                </div>
                <div class="pd-chart-canvas">
                    @if (Model.HomeworkProgress != null && Model.HomeworkProgress.Count > 0)
                    {
                        <canvas id="hwChart" height="200"></canvas>
                    }
                    else
                    {
                        <div class="pd-empty">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                            لا توجد بيانات بعد
                        </div>
                    }
                </div>
            </div>

            <!-- Exam trend -->
            <div class="pd-chart-box">
                <div class="pd-chart-top">
                    <div class="pd-chart-top-left">
                        <h6>مسار الاختبارات</h6>
                        <p>صحيحة / خاطئة / متخطاة لكل اختبار</p>
                    </div>
                    <span class="pd-chart-badge" style="background:var(--c-violet-dim);color:var(--c-violet)">الاختبارات</span>
                </div>
                <div class="pd-chart-canvas">
                    @if (Model.ExamProgress != null && Model.ExamProgress.Count > 0)
                    {
                        <canvas id="exChart" height="200"></canvas>
                    }
                    else
                    {
                        <div class="pd-empty">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                            لا توجد بيانات بعد
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ─── CHARTS: Comparison ─── -->
        <div class="pd-section-head pd-in pd-in-5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--c-violet)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/>
                <line x1="6" y1="20" x2="6" y2="14"/><line x1="2" y1="20" x2="22" y2="20"/>
            </svg>
            مقارنة أدائك مع متوسط الدفعة
        </div>

        <div class="pd-charts-row pd-in pd-in-6">

            <!-- HW comparison -->
            <div class="pd-chart-box">
                <div class="pd-chart-top">
                    <div class="pd-chart-top-left">
                        <h6>الواجبات — أنت مقابل الدفعة</h6>
                        <p>درجاتك مقارنةً بمتوسط الدفعة في كل واجب</p>
                    </div>
                    <span class="pd-chart-badge" style="background:var(--c-teal-dim);color:var(--c-teal)">مقارنة</span>
                </div>
                <div class="pd-chart-canvas">
                    @if (Model.HomeworkComparison != null && Model.HomeworkComparison.Count > 0)
                    {
                        <canvas id="hwCmpChart" height="200"></canvas>
                    }
                    else
                    {
                        <div class="pd-empty">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                            لا توجد بيانات بعد
                        </div>
                    }
                </div>
            </div>

            <!-- Exam comparison -->
            <div class="pd-chart-box">
                <div class="pd-chart-top">
                    <div class="pd-chart-top-left">
                        <h6>الاختبارات — أنت مقابل الدفعة</h6>
                        <p>درجاتك مقارنةً بمتوسط الدفعة في كل اختبار</p>
                    </div>
                    <span class="pd-chart-badge" style="background:var(--c-violet-dim);color:var(--c-violet)">مقارنة</span>
                </div>
                <div class="pd-chart-canvas">
                    @if (Model.ExamComparison != null && Model.ExamComparison.Count > 0)
                    {
                        <canvas id="exCmpChart" height="200"></canvas>
                    }
                    else
                    {
                        <div class="pd-empty">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                            لا توجد بيانات بعد
                        </div>
                    }
                </div>
            </div>

        </div>

        <!-- ─── CHART 1: Doughnut — حالة الإنجاز ─── -->
        <div class="pd-section-head pd-in pd-in-5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--c-amber)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
            </svg>
            حالة الإنجاز — واجبات واختبارات
        </div>

        <div class="pd-charts-row pd-in pd-in-5">
            <div class="pd-chart-box">
                <div class="pd-chart-top">
                    <div class="pd-chart-top-left">
                        <h6>حالة الواجبات</h6>
                        <p>توزيع مكتمل / مطلوب / متأخر</p>
                    </div>
                    <span class="pd-chart-badge" style="background:var(--c-teal-dim);color:var(--c-teal)">الواجبات</span>
                </div>
                <div class="pd-chart-canvas" style="display:flex;align-items:center;justify-content:center;padding:24px;">
                    <div style="position:relative;width:220px;height:220px;">
                        <canvas id="hwDonut"></canvas>
                        <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none;">
                            <span style="font-size:1.6rem;font-weight:900;color:var(--t-primary)">@Model.TotalHomeworks</span>
                            <span style="font-size:.72rem;color:var(--t-secondary);font-weight:600">إجمالي</span>
                        </div>
                    </div>
                    <div style="margin-right:24px;display:flex;flex-direction:column;gap:10px;">
                        <div class="pd-donut-legend-item">
                            <span class="pd-donut-dot" style="background:var(--c-teal)"></span>
                            <span>مكتمل</span>
                            <strong>@Model.CompletedHomeworks</strong>
                        </div>
                        <div class="pd-donut-legend-item">
                            <span class="pd-donut-dot" style="background:var(--c-sky)"></span>
                            <span>مطلوب</span>
                            <strong>@Model.PendingHomeworks</strong>
                        </div>
                        <div class="pd-donut-legend-item">
                            <span class="pd-donut-dot" style="background:var(--c-rose)"></span>
                            <span>متأخر</span>
                            <strong>@Model.LateHomeworks</strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pd-chart-box">
                <div class="pd-chart-top">
                    <div class="pd-chart-top-left">
                        <h6>حالة الاختبارات</h6>
                        <p>توزيع مكتمل / مطلوب / متأخر</p>
                    </div>
                    <span class="pd-chart-badge" style="background:var(--c-violet-dim);color:var(--c-violet)">الاختبارات</span>
                </div>
                <div class="pd-chart-canvas" style="display:flex;align-items:center;justify-content:center;padding:24px;">
                    <div style="position:relative;width:220px;height:220px;">
                        <canvas id="exDonut"></canvas>
                        <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none;">
                            <span style="font-size:1.6rem;font-weight:900;color:var(--t-primary)">@Model.TotalExams</span>
                            <span style="font-size:.72rem;color:var(--t-secondary);font-weight:600">إجمالي</span>
                        </div>
                    </div>
                    <div style="margin-right:24px;display:flex;flex-direction:column;gap:10px;">
                        <div class="pd-donut-legend-item">
                            <span class="pd-donut-dot" style="background:var(--c-violet)"></span>
                            <span>مكتمل</span>
                            <strong>@Model.CompletedExams</strong>
                        </div>
                        <div class="pd-donut-legend-item">
                            <span class="pd-donut-dot" style="background:var(--c-sky)"></span>
                            <span>مطلوب</span>
                            <strong>@Model.PendingExams</strong>
                        </div>
                        <div class="pd-donut-legend-item">
                            <span class="pd-donut-dot" style="background:var(--c-rose)"></span>
                            <span>متأخر</span>
                            <strong>@Model.LateExams</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ─── CHART 2: Line — منحنى الدرجات ─── -->
        <div class="pd-section-head pd-in pd-in-6">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--c-green)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>
            </svg>
            منحنى الدرجات — تطور نتائجك عبر الزمن
        </div>

        <div class="pd-charts-row pd-in pd-in-6">
            <div class="pd-chart-box">
                <div class="pd-chart-top">
                    <div class="pd-chart-top-left">
                        <h6>تطور درجات الواجبات</h6>
                        <p>نتيجة كل واجب — هل أنت في تحسن مستمر؟</p>
                    </div>
                    <span class="pd-chart-badge" style="background:var(--c-green-dim);color:var(--c-green)">اتجاه</span>
                </div>
                <div class="pd-chart-canvas">
                    @if (Model.HomeworkProgress != null && Model.HomeworkProgress.Count > 0)
                    {
                        <canvas id="hwTrendChart" height="200"></canvas>
                    }
                    else { <div class="pd-empty"><span>لا توجد بيانات بعد</span></div> }
                </div>
            </div>

            <div class="pd-chart-box">
                <div class="pd-chart-top">
                    <div class="pd-chart-top-left">
                        <h6>تطور درجات الاختبارات</h6>
                        <p>نتيجة كل اختبار — هل أنت في تحسن مستمر؟</p>
                    </div>
                    <span class="pd-chart-badge" style="background:var(--c-amber-dim);color:var(--c-amber)">اتجاه</span>
                </div>
                <div class="pd-chart-canvas">
                    @if (Model.ExamProgress != null && Model.ExamProgress.Count > 0)
                    {
                        <canvas id="exTrendChart" height="200"></canvas>
                    }
                    else { <div class="pd-empty"><span>لا توجد بيانات بعد</span></div> }
                </div>
            </div>
        </div>

        <!-- ─── CHART 3: Radar — نقاط القوة والضعف ─── -->
        <div class="pd-section-head pd-in pd-in-6">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--c-violet)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
            خريطة الأداء الشاملة — نقاط القوة والضعف
        </div>

        <div class="pd-charts-row pd-in pd-in-6" style="grid-template-columns:1fr 1fr;">
            <div class="pd-chart-box" style="grid-column:1/-1;">
                <div class="pd-chart-top">
                    <div class="pd-chart-top-left">
                        <h6>الرادار الأكاديمي</h6>
                        <p>مقارنة 5 أبعاد لأدائك — كلما اتسعت المساحة كلما كان أداؤك أفضل</p>
                    </div>
                    <span class="pd-chart-badge" style="background:var(--c-violet-dim);color:var(--c-violet)">تحليل شامل</span>
                </div>
                <div class="pd-chart-canvas" style="display:flex;justify-content:center;padding:20px 32px;">
                    <div style="width:100%;max-width:500px;">
                        <canvas id="radarChart" height="320"></canvas>
                    </div>
                </div>
            </div>
        </div>

    </div><!-- /pd-body -->
</div><!-- /pd-root -->

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
(function(){
'use strict';

/* ── palette ──────────────────────────────── */
const T = {
    teal:      '#0d9488', tealA:  'rgba(13,148,136,.15)',
    violet:    '#7c3aed', violetA:'rgba(124,58,237,.12)',
    amber:     '#d97706', amberA: 'rgba(217,119,6,.12)',
    rose:      '#e11d48', roseA:  'rgba(225,29,72,.10)',
    sky:       '#0284c7', skyA:   'rgba(2,132,199,.12)',
    green:     '#059669', greenA: 'rgba(5,150,105,.12)',
    grid:      'rgba(0,0,0,.05)',
    tick:      '#94a3b8',
};

/* ── chart defaults ───────────────────────── */
Chart.defaults.font.family  = "'Cairo','Tajawal',system-ui,sans-serif";
Chart.defaults.font.size    = 11;
Chart.defaults.color        = T.tick;
Chart.defaults.animation    = { duration: 900, easing: 'easeOutQuart' };

const LEGEND = { position:'bottom', labels:{ boxWidth:10, padding:14, color:T.tick } };

const SCALE_BASE = {
    grid:   { color: T.grid },
    border: { color:'transparent' },
    ticks:  { color: T.tick }
};

/* ── gradient helper ──────────────────────── */
function grad(ctx, c1, c2) {
    const g = ctx.createLinearGradient(0, 0, 0, 260);
    g.addColorStop(0, c1); g.addColorStop(1, c2); return g;
}

/* ── server data (PascalCase from JsonSerializer.Serialize) ── */
const hwData  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HomeworkProgress));
const exData  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExamProgress));
const hwComp  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HomeworkComparison));
const exComp  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExamComparison));

let hwChart, exChart, hwCmpChart, exCmpChart;

/* ── stacked bar builder ──────────────────── */
function stackedArea(id, items, xLabel) {
    const el = document.getElementById(id);
    if (!el) return null;
    return new Chart(el, {
        type: 'bar',
        data: {
            labels: items.map(i => i.Title),
            datasets: [
                { label:'صحيحة',  data: items.map(i => i.Correct),  backgroundColor: T.teal,   borderWidth:0, borderRadius:3 },
                { label:'خاطئة',  data: items.map(i => i.Wrong),    backgroundColor: T.rose,   borderWidth:0, borderRadius:3 },
                { label:'متخطاة', data: items.map(i => i.Skipped),  backgroundColor: '#cbd5e1', borderWidth:0, borderRadius:3 }
            ]
        },
        options: {
            responsive:true,
            plugins: { legend: LEGEND, tooltip:{ callbacks:{ label: c=>`${c.dataset.label}: ${c.parsed.y}` } } },
            scales: {
                x: { ...SCALE_BASE, stacked:true, title:{ display:!!xLabel, text:xLabel, color:T.tick } },
                y: { ...SCALE_BASE, stacked:true, beginAtZero:true, title:{ display:true, text:'عدد الأسئلة', color:T.tick } }
            }
        }
    });
}

/* ── comparison line builder ──────────────── */
function cmpLine(id, items, xLabel) {
    const el = document.getElementById(id);
    if (!el) return null;
    const ctx = el.getContext('2d');
    return new Chart(el, {
        type: 'line',
        data: {
            labels: items.map(i => i.Title),
            datasets: [
                {
                    label:'أنت',
                    data: items.map(i => i.StudentScore),
                    borderColor: T.teal,
                    backgroundColor: grad(ctx, T.tealA, 'transparent'),
                    fill: true,
                    tension:.35, pointRadius:5, pointBackgroundColor: T.teal,
                    borderWidth:2.5
                },
                {
                    label:'متوسط الدفعة',
                    data: items.map(i => i.BatchAverage),
                    borderColor: T.violet,
                    backgroundColor: grad(ctx, T.violetA, 'transparent'),
                    fill: true,
                    tension:.35, pointRadius:5, pointBackgroundColor: T.violet,
                    borderWidth:2.5, borderDash:[6,3]
                }
            ]
        },
        options: {
            responsive:true,
            plugins: { legend: LEGEND, tooltip:{ callbacks:{ label: c=>`${c.dataset.label}: ${c.parsed.y.toFixed(1)}%` } } },
            scales: {
                x: { ...SCALE_BASE, title:{ display:!!xLabel, text:xLabel, color:T.tick } },
                y: { ...SCALE_BASE, beginAtZero:true, max:100, title:{ display:true, text:'الدرجة %', color:T.tick } }
            }
        }
    });
}

/* ── CHART 1: Doughnut builder ────────────── */
function buildDonut(id, vals, colors) {
    const el = document.getElementById(id);
    if (!el) return;
    new Chart(el, {
        type: 'doughnut',
        data: {
            datasets: [{
                data: vals,
                backgroundColor: colors,
                borderWidth: 3,
                borderColor: '#ffffff',
                hoverOffset: 8
            }]
        },
        options: {
            responsive: true,
            cutout: '72%',
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: c => ` ${c.parsed} عنصر`
                    }
                }
            },
            animation: { animateRotate: true, duration: 1000 }
        }
    });
}

/* ── CHART 2: Score trend line builder ────── */
function buildTrendLine(id, items, color, colorA) {
    const el = document.getElementById(id);
    if (!el) return;
    const ctx = el.getContext('2d');
    const hasScores = items.some(i => i.Score !== undefined && i.Score !== null);
    const yData = hasScores
        ? items.map(i => +(i.Score ?? 0).toFixed(1))
        : items.map((_, idx) => {
            const c = items[idx].Correct ?? 0;
            const t = c + (items[idx].Wrong ?? 0) + (items[idx].Skipped ?? 0);
            return t > 0 ? +((c / t) * 100).toFixed(1) : 0;
        });

    new Chart(el, {
        type: 'line',
        data: {
            labels: items.map(i => i.Title),
            datasets: [{
                label: 'الدرجة %',
                data: yData,
                borderColor: color,
                backgroundColor: grad(ctx, colorA, 'rgba(255,255,255,0)'),
                fill: true,
                tension: .4,
                pointRadius: 5,
                pointBackgroundColor: '#fff',
                pointBorderColor: color,
                pointBorderWidth: 2.5,
                borderWidth: 2.5
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false },
                tooltip: { callbacks: { label: c => ` ${c.parsed.y}%` } }
            },
            scales: {
                x: { ...SCALE_BASE, ticks: { ...SCALE_BASE.ticks, maxRotation: 35 } },
                y: {
                    ...SCALE_BASE,
                    beginAtZero: true,
                    max: 100,
                    title: { display: true, text: 'الدرجة %', color: T.tick },
                    ticks: {
                        ...SCALE_BASE.ticks,
                        callback: v => v + '%'
                    }
                }
            }
        }
    });
}

/* ── CHART 3: Radar ───────────────────────── */
function buildRadar() {
    const el = document.getElementById('radarChart');
    if (!el) return;
    new Chart(el, {
        type: 'radar',
        data: {
            labels: [
                'أفضل اختبار',
                'أفضل واجب',
                'معدل نجاح الاختبارات',
                'معدل نجاح الواجبات',
                'التقدم العام'
            ],
            datasets: [{
                label: 'أدائك',
                data: [
                    @Model.BestExamScore.ToString("F1", System.Globalization.CultureInfo.InvariantCulture),
                    @Model.BestHomeworkScore.ToString("F1", System.Globalization.CultureInfo.InvariantCulture),
                    @Model.SuccessRateExams.ToString("F1", System.Globalization.CultureInfo.InvariantCulture),
                    @Model.SuccessRateHomeworks.ToString("F1", System.Globalization.CultureInfo.InvariantCulture),
                    @Model.OverallProgress.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)
                ],
                backgroundColor: 'rgba(13,148,136,.12)',
                borderColor: T.teal,
                pointBackgroundColor: T.teal,
                pointBorderColor: '#fff',
                pointBorderWidth: 2,
                pointRadius: 5,
                borderWidth: 2.5
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false },
                tooltip: { callbacks: { label: c => ` ${c.raw}%` } }
            },
            scales: {
                r: {
                    min: 0,
                    max: 100,
                    ticks: {
                        stepSize: 25,
                        color: T.tick,
                        backdropColor: 'transparent',
                        callback: v => v + '%'
                    },
                    grid: { color: 'rgba(0,0,0,.07)' },
                    angleLines: { color: 'rgba(0,0,0,.07)' },
                    pointLabels: {
                        color: '#475569',
                        font: { size: 12, weight: '700', family: "'Cairo',system-ui,sans-serif" }
                    }
                }
            },
            animation: { duration: 1200, easing: 'easeOutQuart' }
        }
    });
}

/* ── init ─────────────────────────────────── */
hwChart    = stackedArea('hwChart',    hwData, 'الواجبات');
exChart    = stackedArea('exChart',    exData, 'الاختبارات');
hwCmpChart = cmpLine('hwCmpChart',    hwComp, 'الواجبات');
exCmpChart = cmpLine('exCmpChart',    exComp, 'الاختبارات');

/* new charts */
buildDonut('hwDonut',
    [@Model.CompletedHomeworks, @Model.PendingHomeworks, @Model.LateHomeworks],
    [T.teal, T.sky, T.rose]
);
buildDonut('exDonut',
    [@Model.CompletedExams, @Model.PendingExams, @Model.LateExams],
    [T.violet, T.sky, T.rose]
);
buildTrendLine('hwTrendChart', hwData, T.teal,   'rgba(13,148,136,.15)');
buildTrendLine('exTrendChart', exData, T.amber,  'rgba(217,119,6,.12)');
buildRadar();

/* ── progress bars animate ────────────────── */
document.querySelectorAll('.pd-bar-fill').forEach(el => {
    const w = el.style.width; el.style.width = '0';
    requestAnimationFrame(() => setTimeout(() => el.style.width = w, 400));
});

/* ── batch switch AJAX ────────────────────── */
function loader(on) {
    document.getElementById('pd-loader').classList.toggle('on', on);
}

document.querySelectorAll('.batch-switch-btn').forEach(btn => {
    btn.addEventListener('click', async function() {
        document.querySelectorAll('.batch-switch-btn').forEach(b => b.classList.remove('btn-primary','active'));
        this.classList.add('btn-primary','active');
        loader(true);
        try {
            const r    = await fetch(`/Students/Dashboard/DashboardData?batchId=${this.dataset.batchId}`);
            const data = await r.json();

            const updateStacked = (chart, items) => {
                if(!chart) return;
                chart.data.labels             = items.map(i=>i.title);
                chart.data.datasets[0].data   = items.map(i=>i.correct);
                chart.data.datasets[1].data   = items.map(i=>i.wrong);
                chart.data.datasets[2].data   = items.map(i=>i.skipped);
                chart.update();
            };
            const updateLine = (chart, items) => {
                if(!chart) return;
                chart.data.labels           = items.map(i=>i.title);
                chart.data.datasets[0].data = items.map(i=>i.studentScore);
                chart.data.datasets[1].data = items.map(i=>i.batchAverage);
                chart.update();
            };
            updateStacked(hwChart,    data.homeworkProgress);
            updateStacked(exChart,    data.examProgress);
            updateLine(hwCmpChart,    data.homeworkComparison);
            updateLine(exCmpChart,    data.examComparison);
        } catch(e){ console.error(e); }
        finally   { loader(false); }
    });
});

}());
</script>
}
