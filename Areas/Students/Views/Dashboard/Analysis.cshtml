@model QdratNew.ViewModels.StudentAnalysis.StudentPerformanceReportVM

<div class="container mt-4">

    <h3 class="fw-bold text-primary">📊 التحليل الذكي لأدائك</h3>

    <div class="card shadow-sm p-3 my-4">
        <h5 class="text-info">نتيجة الامتحان الأخيرة: @Model.Raw.LastExamScore</h5>
        <h5 class="text-info">متوسط الدفعة: @Model.Raw.AvgBatchScore</h5>
    </div>

    <div class="card shadow-sm p-3 my-4">
        <h5 class="text-success">نسبة القوة: @Model.Analytics.StrengthPercentage%</h5>
        <h5 class="text-danger">نسبة الضعف: @Model.Analytics.WeaknessPercentage%</h5>
        <h5 class="text-warning">مستوى الخطر: @Model.Analytics.RiskLevel%</h5>
    </div>

    <div class="card shadow-sm p-3 my-4">
        <h5 class="fw-bold">المحاور الضعيفة:</h5>
        <ul>
            @foreach (var s in Model.Analytics.CriticalSections)
            {
                <li>@s</li>
            }
        </ul>
    </div>

    <div class="card shadow-sm p-3 my-4 bg-light">
        <h5 class="fw-bold">🔮 تحليل الذكاء الاصطناعي:</h5>
        <p>@Model.AI.AnalysisText</p>
    </div>

</div>
