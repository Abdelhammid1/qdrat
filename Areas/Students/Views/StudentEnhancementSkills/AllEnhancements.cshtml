@model List<QdratNew.ViewModels.EnhancementSkills.StudentEnhancementCardViewModel>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>

<style>
:root{
  --p:#2e9e9e;--p-d:#1d7b7b;--p-a:rgba(46,158,158,.12);--p-glow:rgba(46,158,158,.3);
  --orange:#e07849;--ora:rgba(224,120,73,.12);
  --green:#22c55e;--grna:rgba(34,197,94,.12);
  --red:#ef4444;--reda:rgba(239,68,68,.12);
  --amber:#f59e0b;--ambera:rgba(245,158,11,.12);
  --ink:#1e293b;--ink2:#475569;--ink3:#94a3b8;
  --bg:#f0f4f8;--card:#ffffff;--line:rgba(0,0,0,.07);
  --r:16px;--r-sm:10px;--sh:0 2px 16px rgba(0,0,0,.07);--sh2:0 8px 32px rgba(0,0,0,.13);
  --ease:.28s cubic-bezier(.4,0,.2,1);
}
*{box-sizing:border-box;margin:0;padding:0}
.al{font-family:'Cairo',sans-serif;direction:rtl;background:var(--bg);min-height:100vh;padding:0 0 60px}

/* HERO */
.al-hero{background:linear-gradient(145deg,#0f1f3d 0%,#1a3a5c 55%,#103545 100%);padding:28px 28px 44px;margin-bottom:-20px;position:relative;overflow:hidden}
.al-hero::before{content:'';position:absolute;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle,rgba(46,158,158,.14) 0%,transparent 65%);top:-100px;left:-60px;pointer-events:none}
.al-hero::after{content:'';position:absolute;width:260px;height:260px;border-radius:50%;background:radial-gradient(circle,rgba(224,120,73,.09) 0%,transparent 65%);bottom:-80px;right:-40px;pointer-events:none}
.al-hero-inner{position:relative;z-index:1;display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.al-hero-ico{width:52px;height:52px;background:rgba(255,255,255,.1);border:1.5px solid rgba(255,255,255,.18);border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;color:#fff;backdrop-filter:blur(8px);flex-shrink:0}
.al-hero-text h1{color:#fff;font-size:1.4rem;font-weight:800;margin:0 0 3px}
.al-hero-text p{color:rgba(255,255,255,.55);font-size:.82rem;margin:0}
.al-search{margin-right:auto;display:flex;align-items:center;gap:0;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);border-radius:50px;overflow:hidden;backdrop-filter:blur(8px);flex-shrink:0}
.al-search input{background:transparent;border:none;outline:none;padding:9px 16px;color:#fff;font-family:'Cairo',sans-serif;font-size:.85rem;min-width:200px}
.al-search input::placeholder{color:rgba(255,255,255,.45)}
.al-search-ico{padding:0 14px;color:rgba(255,255,255,.5);font-size:.85rem}
.al-hero-stats{position:relative;z-index:1;display:flex;gap:12px;flex-wrap:wrap;margin-top:16px}
.al-hstat{display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);border-radius:50px;padding:7px 18px;color:rgba(255,255,255,.85);font-size:.8rem;font-weight:700;backdrop-filter:blur(6px)}
.al-hstat-dot{width:8px;height:8px;border-radius:50%}

/* TOOLBAR */
.al-toolbar{background:var(--card);border-radius:0 0 20px 20px;border:1px solid var(--line);border-top:none;box-shadow:var(--sh);padding:12px 20px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:24px}
.al-filter-btn{display:flex;align-items:center;gap:6px;padding:7px 16px;border-radius:50px;border:1.5px solid var(--line);background:transparent;font-family:'Cairo',sans-serif;font-size:.8rem;font-weight:700;color:var(--ink2);cursor:pointer;white-space:nowrap;transition:all var(--ease)}
.al-filter-btn:hover{border-color:var(--p);color:var(--p)}
.al-filter-btn.active{background:var(--p);border-color:var(--p);color:#fff;box-shadow:0 3px 10px var(--p-glow)}
.al-filter-btn .fbadge{background:rgba(255,255,255,.25);border-radius:99px;padding:1px 7px;font-size:.72rem;font-weight:800}
.al-filter-btn:not(.active) .fbadge{background:var(--line);color:var(--ink2)}
.al-sort{margin-right:auto;display:flex;align-items:center;gap:6px}
.al-sort label{font-size:.78rem;font-weight:700;color:var(--ink2);white-space:nowrap}
.al-sort select{padding:6px 12px;border-radius:8px;border:1.5px solid var(--line);background:var(--card);font-family:'Cairo',sans-serif;font-size:.8rem;color:var(--ink);cursor:pointer;outline:none;transition:border-color var(--ease)}
.al-sort select:focus{border-color:var(--p)}

/* RESULTS LABEL */
.al-results-label{font-size:.78rem;font-weight:700;color:var(--ink3);margin:0 4px 14px;display:flex;align-items:center;gap:6px}
.al-results-label b{color:var(--ink)}

/* CARD GRID */
.al-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:16px;padding:0 4px}

/* CARD */
.al-card{background:var(--card);border-radius:var(--r);border:1px solid var(--line);box-shadow:var(--sh);overflow:hidden;display:flex;flex-direction:column;transition:transform var(--ease),box-shadow var(--ease);animation:cardIn .4s ease both}
.al-card:hover{transform:translateY(-4px);box-shadow:var(--sh2)}
@@keyframes cardIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
.al-card-stripe{height:3px;width:100%}
.stripe-solved{background:linear-gradient(90deg,var(--green),#4ade80)}
.stripe-pending{background:linear-gradient(90deg,var(--amber),#fcd34d)}
.stripe-late{background:linear-gradient(90deg,var(--red),#f87171)}
.al-card-body{padding:18px 20px;flex:1;display:flex;flex-direction:column;gap:12px}
.al-card-top{display:flex;align-items:flex-start;gap:12px}
.al-card-ico{width:44px;height:44px;border-radius:12px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:1.1rem;margin-top:2px}
.ico-solved{background:var(--grna);color:var(--green)}
.ico-pending{background:var(--ambera);color:var(--amber)}
.ico-late{background:var(--reda);color:var(--red)}
.al-card-title{font-size:.97rem;font-weight:800;color:var(--ink);line-height:1.35;margin-bottom:4px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.al-card-meta{display:flex;flex-wrap:wrap;gap:6px}
.al-tag{display:inline-flex;align-items:center;gap:4px;background:#f1f5f9;border:1px solid var(--line);border-radius:6px;padding:2px 10px;font-size:.7rem;font-weight:700;color:var(--ink2)}
.al-tag i{font-size:.65rem;opacity:.6}
.al-status{display:inline-flex;align-items:center;gap:5px;border-radius:50px;padding:4px 12px;font-size:.73rem;font-weight:800;white-space:nowrap}
.st-solved{background:var(--grna);color:#15803d}
.st-pending{background:var(--ambera);color:#92400e}
.st-late{background:var(--reda);color:#b91c1c}

/* score bar */
.al-card-score{background:#f8fafc;border:1px solid var(--line);border-radius:var(--r-sm);padding:12px 14px}
.al-score-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px}
.al-score-lbl{font-size:.72rem;font-weight:700;color:var(--ink2)}
.al-score-val{font-size:.85rem;font-weight:900}
.al-bar{height:7px;border-radius:99px;background:var(--line);overflow:hidden;margin-bottom:4px}
.al-bar-fill{height:100%;border-radius:99px;transition:width 1s cubic-bezier(.4,0,.2,1);background:linear-gradient(90deg,var(--p),#4ecdc4)}

/* actions */
.al-card-foot{padding:14px 20px;border-top:1px solid var(--line);background:#fafbfc;display:flex;gap:8px;flex-wrap:wrap}
.al-btn{flex:1;min-width:100px;display:flex;align-items:center;justify-content:center;gap:6px;padding:9px 14px;border-radius:10px;border:none;font-family:'Cairo',sans-serif;font-size:.82rem;font-weight:700;cursor:pointer;text-decoration:none;transition:all var(--ease)}
.al-btn:hover{text-decoration:none;transform:translateY(-1px)}
.btn-start{background:var(--p);color:#fff;box-shadow:0 3px 10px var(--p-glow)}
.btn-start:hover{background:var(--p-d);color:#fff}
.btn-review{background:var(--grna);color:#15803d;border:1px solid rgba(34,197,94,.2)}
.btn-review:hover{background:rgba(34,197,94,.2)}
.btn-report{background:var(--p-a);color:var(--p-d);border:1px solid rgba(46,158,158,.2)}
.btn-report:hover{background:rgba(46,158,158,.2)}

/* EMPTY */
.al-empty{text-align:center;padding:60px 24px;background:var(--card);border-radius:var(--r);border:1px solid var(--line);box-shadow:var(--sh)}
.al-empty-ico{font-size:3.5rem;opacity:.25;margin-bottom:16px}
.al-empty h3{font-size:1rem;font-weight:800;color:var(--ink);margin-bottom:6px}
.al-empty p{font-size:.85rem;color:var(--ink2)}
.fu{opacity:0;transform:translateY(18px);animation:fu .45s ease forwards}
@@keyframes fu{to{opacity:1;transform:translateY(0)}}
@@media(max-width:700px){.al-hero{padding:22px 16px 40px}.al-grid{grid-template-columns:1fr;gap:12px}.al-sort{margin-right:0;width:100%}}
</style>

@{
  var total   = Model.Count;
  var solved  = Model.Count(x => x.IsSubmitted);
  var pending = Model.Count(x => !x.IsSubmitted && x.DelayLevel != "متأخر");
  var late    = Model.Count(x => x.DelayLevel == "متأخر");
  var avgScore = Model.Where(x => x.IsSubmitted && x.Score > 0).Select(x => x.Score).DefaultIfEmpty(0).Average();
}

<div class="al">

  <!-- HERO -->
  <div class="al-hero fu">
    <div class="al-hero-inner">
      <div class="al-hero-ico"><i class="fa-solid fa-bolt"></i></div>
      <div class="al-hero-text">
        <h1>كل المهارات التعزيزية</h1>
        <p>جميع الجلسات التعزيزية المكلّفة لك — ابحث وصنّف وتابع تقدمك</p>
      </div>
      <div class="al-search">
        <span class="al-search-ico"><i class="fa-solid fa-magnifying-glass"></i></span>
        <input type="text" id="al-search-input" placeholder="ابحث عن جلسة…" oninput="applyFilters()">
      </div>
    </div>
    <div class="al-hero-stats">
      <span class="al-hstat"><span class="al-hstat-dot" style="background:#2e9e9e"></span>الإجمالي: @total</span>
      <span class="al-hstat"><span class="al-hstat-dot" style="background:#22c55e"></span>المحلولة: @solved</span>
      <span class="al-hstat"><span class="al-hstat-dot" style="background:#f59e0b"></span>المطلوبة: @pending</span>
      <span class="al-hstat"><span class="al-hstat-dot" style="background:#ef4444"></span>المتأخرة: @late</span>
      @if (solved > 0)
      {
        <span class="al-hstat"><span class="al-hstat-dot" style="background:#a78bfa"></span>متوسط درجاتك: @avgScore.ToString("F1")%</span>
      }
    </div>
  </div>

  <!-- TOOLBAR -->
  <div class="al-toolbar fu">
    <button class="al-filter-btn active" data-filter="all" onclick="setFilter(this)">
      <i class="fa-solid fa-layer-group" style="font-size:.75rem"></i>
      الكل <span class="fbadge">@total</span>
    </button>
    <button class="al-filter-btn" data-filter="solved" onclick="setFilter(this)">
      <i class="fa-solid fa-circle-check" style="font-size:.75rem"></i>
      المحلولة <span class="fbadge">@solved</span>
    </button>
    <button class="al-filter-btn" data-filter="pending" onclick="setFilter(this)">
      <i class="fa-solid fa-clock" style="font-size:.75rem"></i>
      المطلوبة <span class="fbadge">@pending</span>
    </button>
    <button class="al-filter-btn" data-filter="late" onclick="setFilter(this)">
      <i class="fa-solid fa-triangle-exclamation" style="font-size:.75rem"></i>
      المتأخرة <span class="fbadge">@late</span>
    </button>
    <div class="al-sort">
      <label for="al-sort-sel"><i class="fa-solid fa-arrow-up-wide-short" style="font-size:.75rem"></i> ترتيب:</label>
      <select id="al-sort-sel" onchange="applyFilters()">
        <option value="date-desc">الأحدث أولاً</option>
        <option value="date-asc">الأقدم أولاً</option>
        <option value="score-desc">الأعلى درجة</option>
        <option value="score-asc">الأدنى درجة</option>
      </select>
    </div>
  </div>

  <!-- BODY -->
  <div style="padding:0 20px">
    <div class="al-results-label" id="al-results-label">
      يُعرض <b id="al-count-shown">@total</b> من إجمالي @total جلسة
    </div>

    <div class="al-grid" id="al-grid">

      @foreach (var e in Model)
      {
        var isSolved  = e.IsSubmitted;
        var isLate    = e.DelayLevel == "متأخر";
        var isPending = !isSolved && !isLate;

        var stripeClass = isSolved ? "stripe-solved" : isLate ? "stripe-late" : "stripe-pending";
        var icoClass    = isSolved ? "ico-solved"    : isLate ? "ico-late"    : "ico-pending";
        var ico         = isSolved ? "fa-circle-check" : isLate ? "fa-triangle-exclamation" : "fa-bolt";
        var statusClass = isSolved ? "st-solved"     : isLate ? "st-late"     : "st-pending";
        var statusText  = isSolved ? "محلولة"          : isLate ? "متأخرة"     : "مطلوبة";
        var scoreW      = isSolved ? (int)Math.Round(e.Score) : 0;

        <div class="al-card"
             data-status="@(isSolved ? "solved" : isLate ? "late" : "pending")"
             data-title="@e.Title.ToLower()"
             data-score="@e.Score"
             data-date="@e.CreatedAt.ToString("yyyyMMdd")">

          <div class="al-card-stripe @stripeClass"></div>

          <div class="al-card-body">
            <div class="al-card-top">
              <div class="al-card-ico @icoClass">
                <i class="fa-solid @ico"></i>
              </div>
              <div style="flex:1;min-width:0">
                <div class="al-card-title">@e.Title</div>
                <div class="al-card-meta">
                  <span class="al-tag"><i class="fa-regular fa-calendar"></i> @e.CreatedAt.ToString("yyyy/MM/dd")</span>
                  @if (!string.IsNullOrEmpty(e.LectureTitle))
                  {
                    <span class="al-tag"><i class="fa-solid fa-chalkboard-teacher"></i> @e.LectureTitle</span>
                  }
                  @if (!string.IsNullOrEmpty(e.SectionNames))
                  {
                    <span class="al-tag"><i class="fa-solid fa-folder"></i> @e.SectionNames</span>
                  }
                  <span class="al-tag"><i class="fa-solid fa-circle-question"></i> @e.QuestionsCount سؤال</span>
                  @if (e.EndAt.HasValue)
                  {
                    <span class="al-tag"><i class="fa-solid fa-hourglass-end"></i> ينتهي @e.EndAt.Value.ToString("MM/dd")</span>
                  }
                  <span class="al-status @statusClass">@statusText</span>
                </div>
              </div>
            </div>

            @if (isSolved)
            {
              var scoreColor = e.Score >= 80 ? "#22c55e" : e.Score >= 60 ? "#f59e0b" : "#ef4444";
              <div class="al-card-score">
                <div class="al-score-row">
                  <span class="al-score-lbl">درجتك</span>
                  <span class="al-score-val" style="color:@scoreColor">@e.Score.ToString("F1")%</span>
                </div>
                <div class="al-bar">
                  <div class="al-bar-fill" style="width:@scoreW%"></div>
                </div>
              </div>
            }
          </div>

          <div class="al-card-foot">
            @if (!isSolved)
            {
              <a asp-action="Start" asp-route-setId="@e.SetId" class="al-btn btn-start">
                <i class="fa-solid fa-play"></i> بدء الحل
              </a>
            }
            else
            {
              <a asp-action="Review" asp-route-id="@e.SetId" class="al-btn btn-review">
                <i class="fa-solid fa-eye"></i> مراجعة
              </a>
              <a asp-action="Report" asp-route-setId="@e.SetId" class="al-btn btn-report">
                <i class="fa-solid fa-file-lines"></i> تقرير
              </a>
            }
          </div>

        </div>
      }

    </div>

    <div class="al-empty" id="al-empty" style="display:none">
      <div class="al-empty-ico">🔍</div>
      <h3>لا توجد نتائج</h3>
      <p>جرّب تغيير الفلتر أو كلمة البحث</p>
    </div>

    @if (!Model.Any())
    {
      <div class="al-empty">
        <div class="al-empty-ico">⚡</div>
        <h3>لا توجد مهارات تعزيزية حالياً</h3>
        <p>سيتم إرسال المهارات التعزيزية من قبل المدرب عند الحاجة</p>
      </div>
    }
  </div>

</div>

<script>
const allCards = Array.from(document.querySelectorAll('.al-card'));
let currentFilter = 'all';

function setFilter(btn) {
  document.querySelectorAll('.al-filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  currentFilter = btn.dataset.filter;
  applyFilters();
}

function applyFilters() {
  const q    = document.getElementById('al-search-input').value.toLowerCase().trim();
  const sort = document.getElementById('al-sort-sel').value;

  let visible = allCards.filter(c => {
    const matchFilter = currentFilter === 'all' || c.dataset.status === currentFilter;
    const matchSearch = !q || c.dataset.title.includes(q);
    return matchFilter && matchSearch;
  });

  visible.sort((a, b) => {
    if (sort === 'date-desc') return b.dataset.date.localeCompare(a.dataset.date);
    if (sort === 'date-asc')  return a.dataset.date.localeCompare(b.dataset.date);
    if (sort === 'score-desc') return +b.dataset.score - +a.dataset.score;
    if (sort === 'score-asc')  return +a.dataset.score - +b.dataset.score;
    return 0;
  });

  const grid = document.getElementById('al-grid');
  const visSet = new Set(visible);
  allCards.forEach(c => {
    if (visSet.has(c)) { c.style.display = ''; grid.appendChild(c); }
    else c.style.display = 'none';
  });

  document.getElementById('al-count-shown').textContent = visible.length;
  document.getElementById('al-empty').style.display = visible.length ? 'none' : 'block';
}

/* animate score bars */
(function () {
  document.querySelectorAll('.al-bar-fill').forEach(el => {
    const target = el.style.width;
    el.style.width = '0';
    requestAnimationFrame(() => requestAnimationFrame(() => { el.style.width = target; }));
  });
})();
</script>
