@model QdratNew.ViewModels.EnhancementSkills.StudentEnhancementDashboardViewModel
@using QdratNew.ViewModels.Curriculum

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
:root {
  --c0:#f7f9fc; --c1:#ffffff;
  --teal:#2e9e9e; --teal2:#1d7b7b; --teal-a:rgba(46,158,158,.12);
  --orange:#e07849; --orange-a:rgba(224,120,73,.12);
  --green:#22c55e; --green-a:rgba(34,197,94,.12);
  --red:#ef4444; --red-a:rgba(239,68,68,.12);
  --amber:#f59e0b; --amber-a:rgba(245,158,11,.12);
  --ink:#1e293b; --ink2:#475569; --line:rgba(0,0,0,.07);
  --r:14px; --sh:0 2px 16px rgba(0,0,0,.07); --sh2:0 8px 32px rgba(0,0,0,.13);
  --ease:.3s cubic-bezier(.4,0,.2,1);
}
*{box-sizing:border-box;margin:0;padding:0}
.enh{font-family:'Cairo',sans-serif;direction:rtl;background:var(--c0);padding:24px 20px 60px;min-height:100vh}

/* TOP ROW */
.enh-top{display:grid;grid-template-columns:1fr 320px;gap:20px;margin-bottom:20px;align-items:stretch}

/* Ring card */
.enh-ring-card{
  background:linear-gradient(145deg,#0f1f3d 0%,#1a3a5c 60%,#103545 100%);
  border-radius:20px;padding:32px 36px;position:relative;overflow:hidden;
  display:flex;align-items:center;gap:36px;
}
.enh-ring-card::before{content:'';position:absolute;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(46,158,158,.15) 0%,transparent 65%);top:-120px;left:-80px;pointer-events:none}
.enh-ring-card::after{content:'';position:absolute;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(224,120,73,.1) 0%,transparent 65%);bottom:-100px;right:-60px;pointer-events:none}
.enh-ring-svg-wrap{position:relative;flex-shrink:0;z-index:1}
.enh-ring-svg{transform:rotate(-90deg);overflow:visible}
.enh-ring-track{fill:none;stroke:rgba(255,255,255,.1);stroke-width:10}
.enh-ring-fill{fill:none;stroke:var(--teal);stroke-width:10;stroke-linecap:round;stroke-dasharray:314;stroke-dashoffset:314;transition:stroke-dashoffset 1.4s cubic-bezier(.4,0,.2,1);filter:drop-shadow(0 0 8px rgba(46,158,158,.6))}
.enh-ring-center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
.enh-ring-pct{font-size:2rem;font-weight:900;color:#fff;line-height:1}
.enh-ring-lbl{font-size:.7rem;color:rgba(255,255,255,.55);margin-top:2px;font-weight:600}
.enh-ring-info{flex:1;z-index:1}
.enh-ring-info h2{font-size:1.5rem;font-weight:800;color:#fff;margin-bottom:6px}
.enh-ring-info p{font-size:.85rem;color:rgba(255,255,255,.6);line-height:1.65;max-width:400px;margin-bottom:24px}
.enh-chips{display:flex;flex-wrap:wrap;gap:10px}
.enh-chip{display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);border-radius:50px;padding:7px 16px;color:rgba(255,255,255,.85);font-size:.8rem;font-weight:700;text-decoration:none;transition:background var(--ease),border-color var(--ease);backdrop-filter:blur(6px)}
.enh-chip:hover{background:rgba(255,255,255,.16);text-decoration:none;color:#fff}
.enh-chip-dot{width:8px;height:8px;border-radius:50%}

/* Side stats */
.enh-side{display:flex;flex-direction:column;gap:14px}
.enh-sstat{background:var(--c1);border-radius:var(--r);border:1px solid var(--line);box-shadow:var(--sh);padding:16px 20px;display:flex;align-items:center;gap:14px;text-decoration:none;transition:transform var(--ease),box-shadow var(--ease);position:relative;overflow:hidden}
.enh-sstat::after{content:'';position:absolute;right:0;top:0;bottom:0;width:3px;border-radius:0 var(--r) var(--r) 0}
.enh-sstat:hover{transform:translateX(-4px);box-shadow:var(--sh2);text-decoration:none}
.enh-sstat.ss-total::after{background:var(--teal)}
.enh-sstat.ss-done::after{background:var(--green)}
.enh-sstat.ss-pending::after{background:var(--amber)}
.enh-sstat.ss-late::after{background:var(--red)}
.enh-sstat-ico{width:40px;height:40px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:1rem;flex-shrink:0}
.ss-total .enh-sstat-ico{background:var(--teal-a);color:var(--teal)}
.ss-done  .enh-sstat-ico{background:var(--green-a);color:var(--green)}
.ss-pending .enh-sstat-ico{background:var(--amber-a);color:var(--amber)}
.ss-late  .enh-sstat-ico{background:var(--red-a);color:var(--red)}
.enh-sstat-body{flex:1}
.enh-sstat-body strong{display:block;font-size:1.5rem;font-weight:900;line-height:1}
.ss-total .enh-sstat-body strong{color:var(--teal)}
.ss-done  .enh-sstat-body strong{color:var(--green)}
.ss-pending .enh-sstat-body strong{color:var(--amber)}
.ss-late  .enh-sstat-body strong{color:var(--red)}
.enh-sstat-body span{font-size:.78rem;color:var(--ink2);font-weight:600}
.enh-sstat-bar{width:40px;height:40px;flex-shrink:0}

/* ANALYTICS PANEL */
.enh-panel{background:var(--c1);border-radius:20px;border:1px solid var(--line);box-shadow:var(--sh);overflow:hidden;margin-bottom:20px}
.enh-panel-head{display:flex;align-items:stretch;border-bottom:1px solid var(--line)}
.enh-panel-tabs{display:flex;flex:1;overflow-x:auto;scrollbar-width:none}
.enh-panel-tabs::-webkit-scrollbar{display:none}
.enh-ptab{display:flex;align-items:center;gap:8px;padding:16px 22px;border:none;background:transparent;font-family:'Cairo',sans-serif;font-size:.85rem;font-weight:700;color:var(--ink2);cursor:pointer;white-space:nowrap;border-bottom:2px solid transparent;margin-bottom:-1px;transition:color var(--ease),border-color var(--ease)}
.enh-ptab .ptab-ico{width:28px;height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:.8rem;background:var(--line);color:var(--ink2);transition:background var(--ease),color var(--ease)}
.enh-ptab:hover{color:var(--teal)}
.enh-ptab:hover .ptab-ico{background:var(--teal-a);color:var(--teal)}
.enh-ptab.active{color:var(--teal);border-bottom-color:var(--teal)}
.enh-ptab.active .ptab-ico{background:var(--teal-a);color:var(--teal)}
.enh-panel-filter{display:flex;align-items:center;gap:8px;padding:12px 20px;border-bottom:1px solid var(--line);overflow-x:auto;scrollbar-width:none;background:#fafbfc}
.enh-panel-filter::-webkit-scrollbar{display:none}
.enh-filter-lbl{font-size:.72rem;font-weight:800;color:var(--ink2);white-space:nowrap;margin-left:4px;display:flex;align-items:center;gap:5px}
.enh-pill{padding:5px 14px;border-radius:50px;border:1.5px solid var(--line);background:transparent;font-family:'Cairo',sans-serif;font-size:.78rem;font-weight:700;color:var(--ink2);cursor:pointer;white-space:nowrap;transition:all var(--ease)}
.enh-pill:hover{border-color:var(--teal);color:var(--teal)}
.enh-pill.active{background:var(--teal);border-color:var(--teal);color:#fff;box-shadow:0 3px 10px rgba(46,158,158,.35)}
.enh-panel-body{padding:28px 24px;position:relative;min-height:340px}
.enh-chart-pane{display:none}
.enh-chart-pane.active{display:block;animation:fadeP .3s ease}
@@keyframes fadeP{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.enh-panel-body.loading::after{content:'';position:absolute;inset:0;background:rgba(255,255,255,.75);backdrop-filter:blur(3px);border-radius:0 0 20px 20px;z-index:9}
.enh-panel-body.loading::before{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:36px;height:36px;border:3px solid var(--teal-a);border-top-color:var(--teal);border-radius:50%;animation:spin .7s linear infinite;z-index:10}
@@keyframes spin{to{transform:translate(-50%,-50%) rotate(360deg)}}

/* FU */
.fu{opacity:0;transform:translateY(20px);animation:fu .5s ease forwards}
@@keyframes fu{to{opacity:1;transform:translateY(0)}}
.d1{animation-delay:.04s}.d2{animation-delay:.1s}

/* RESPONSIVE */
@@media(max-width:960px){.enh-top{grid-template-columns:1fr}.enh-side{display:grid;grid-template-columns:1fr 1fr}}
@@media(max-width:600px){.enh{padding:16px 12px 48px}.enh-ring-card{flex-direction:column;align-items:flex-start;padding:24px 20px}.enh-side{grid-template-columns:1fr 1fr;gap:10px}}
</style>

@{
  var total   = Model.TotalAssigned;
  var done    = Model.Completed;
  var pending = Model.Pending;
  var late    = Model.Late;
  var pct     = total > 0 ? (int)Math.Round((double)done / total * 100) : 0;
  var doneP   = total > 0 ? (int)Math.Round((double)done    / total * 100) : 0;
  var pendP   = total > 0 ? (int)Math.Round((double)pending / total * 100) : 0;
  var lateP   = total > 0 ? (int)Math.Round((double)late    / total * 100) : 0;
  var ringOffset = 314 - (pct / 100.0) * 314;
}

<div class="enh">

  <!-- TOP ROW -->
  <div class="enh-top fu d1">

    <!-- Ring hero -->
    <div class="enh-ring-card">
      <div class="enh-ring-svg-wrap">
        <svg class="enh-ring-svg" width="120" height="120" viewBox="0 0 120 120">
          <circle class="enh-ring-track" cx="60" cy="60" r="50"/>
          <circle class="enh-ring-fill" cx="60" cy="60" r="50" id="ringFill"
                  style="stroke-dashoffset:@ringOffset.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"/>
        </svg>
        <div class="enh-ring-center">
          <span class="enh-ring-pct" id="ringPct">@pct%</span>
          <span class="enh-ring-lbl">مكتمل</span>
        </div>
      </div>

      <div class="enh-ring-info">
        <h2>⚡ المهارات التعزيزية</h2>
        <p>تابع تقدمك في المهارات التعزيزية المرتبطة بمحاضراتك. اختر منهجاً لتحليل أدائك بتفصيل.</p>
        <div class="enh-chips">
          <a asp-action="AllEnhancements" class="enh-chip">
            <span class="enh-chip-dot" style="background:#2e9e9e"></span> كل الجلسات (@total)
          </a>
          <a asp-action="SolvedEnhancements" class="enh-chip">
            <span class="enh-chip-dot" style="background:#22c55e"></span> المحلولة (@done)
          </a>
          <a asp-action="RequiredEnhancements" class="enh-chip">
            <span class="enh-chip-dot" style="background:#f59e0b"></span> المطلوبة (@pending)
          </a>
          <a asp-action="LateEnhancements" class="enh-chip">
            <span class="enh-chip-dot" style="background:#ef4444"></span> المتأخرة (@late)
          </a>
        </div>
      </div>
    </div>

    <!-- Side stats -->
    <div class="enh-side">
      <a asp-action="AllEnhancements" class="enh-sstat ss-total">
        <div class="enh-sstat-ico"><i class="fa-solid fa-bolt"></i></div>
        <div class="enh-sstat-body">
          <strong data-count="@total">0</strong>
          <span>إجمالي الجلسات</span>
        </div>
        <svg class="enh-sstat-bar" viewBox="0 0 40 40">
          <circle cx="20" cy="20" r="16" fill="none" stroke="rgba(0,0,0,.07)" stroke-width="4"/>
          <circle cx="20" cy="20" r="16" fill="none" stroke="var(--teal)" stroke-width="4" stroke-linecap="round" stroke-dasharray="100.5" stroke-dashoffset="0" transform="rotate(-90 20 20)"/>
        </svg>
      </a>

      <a asp-action="SolvedEnhancements" class="enh-sstat ss-done">
        <div class="enh-sstat-ico"><i class="fa-solid fa-circle-check"></i></div>
        <div class="enh-sstat-body">
          <strong data-count="@done">0</strong>
          <span>@doneP% محلولة</span>
        </div>
        <svg class="enh-sstat-bar" viewBox="0 0 40 40">
          <circle cx="20" cy="20" r="16" fill="none" stroke="rgba(0,0,0,.07)" stroke-width="4"/>
          <circle cx="20" cy="20" r="16" fill="none" stroke="var(--green)" stroke-width="4" stroke-linecap="round" stroke-dasharray="100.5"
                  stroke-dashoffset="@((100.5-(doneP/100.0*100.5)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                  transform="rotate(-90 20 20)"/>
        </svg>
      </a>

      <a asp-action="RequiredEnhancements" class="enh-sstat ss-pending">
        <div class="enh-sstat-ico"><i class="fa-solid fa-list-check"></i></div>
        <div class="enh-sstat-body">
          <strong data-count="@pending">0</strong>
          <span>@pendP% مطلوبة</span>
        </div>
        <svg class="enh-sstat-bar" viewBox="0 0 40 40">
          <circle cx="20" cy="20" r="16" fill="none" stroke="rgba(0,0,0,.07)" stroke-width="4"/>
          <circle cx="20" cy="20" r="16" fill="none" stroke="var(--amber)" stroke-width="4" stroke-linecap="round" stroke-dasharray="100.5"
                  stroke-dashoffset="@((100.5-(pendP/100.0*100.5)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                  transform="rotate(-90 20 20)"/>
        </svg>
      </a>

      <a asp-action="LateEnhancements" class="enh-sstat ss-late">
        <div class="enh-sstat-ico"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <div class="enh-sstat-body">
          <strong data-count="@late">0</strong>
          <span>@lateP% متأخرة</span>
        </div>
        <svg class="enh-sstat-bar" viewBox="0 0 40 40">
          <circle cx="20" cy="20" r="16" fill="none" stroke="rgba(0,0,0,.07)" stroke-width="4"/>
          <circle cx="20" cy="20" r="16" fill="none" stroke="var(--red)" stroke-width="4" stroke-linecap="round" stroke-dasharray="100.5"
                  stroke-dashoffset="@((100.5-(lateP/100.0*100.5)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                  transform="rotate(-90 20 20)"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- ANALYTICS PANEL -->
  <div class="enh-panel fu d2">

    <div class="enh-panel-head">
      <div class="enh-panel-tabs">
        <button class="enh-ptab active" onclick="switchTab(this,'tab-radar')">
          <span class="ptab-ico"><i class="fa-solid fa-chart-area"></i></span>
          تحليل المحاور
        </button>
        <button class="enh-ptab" onclick="switchTab(this,'tab-progress')">
          <span class="ptab-ico"><i class="fa-solid fa-arrow-trend-up"></i></span>
          تطور الأداء
        </button>
        <button class="enh-ptab" onclick="switchTab(this,'tab-compare')">
          <span class="ptab-ico"><i class="fa-solid fa-people-arrows"></i></span>
          مقارنة بالجلسات
        </button>
      </div>
    </div>

    <div class="enh-panel-filter">
      <span class="enh-filter-lbl"><i class="fa-solid fa-filter" style="font-size:.7rem"></i> منهج:</span>
      <button class="enh-pill active" onclick="selectCurriculum(this,0)">كل المناهج</button>
      @if (Model.Curriculums != null)
      {
        @foreach (var c in Model.Curriculums)
        {
          <button class="enh-pill" onclick="selectCurriculum(this,@c.Id)">@c.Title</button>
        }
      }
    </div>

    <div class="enh-panel-body" id="enh-panel-body">
      <div class="enh-chart-pane active" id="tab-radar">
        <canvas id="radarChart" style="max-height:380px"></canvas>
      </div>
      <div class="enh-chart-pane" id="tab-progress">
        <canvas id="progressChart" style="max-height:340px"></canvas>
      </div>
      <div class="enh-chart-pane" id="tab-compare">
        <canvas id="compareChart" style="max-height:340px"></canvas>
      </div>
    </div>

  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
const C = {
  teal:'#2e9e9e', tealS:'rgba(46,158,158,.18)',
  orange:'#e07849', orangeS:'rgba(224,120,73,.22)',
  green:'#22c55e',  greenS:'rgba(34,197,94,.18)',
  navy:'#1e293b', gray:'#475569', gridLine:'rgba(0,0,0,.06)'
};

/* counters */
document.querySelectorAll('[data-count]').forEach(el => {
  const t = +el.dataset.count; if (!t) { el.textContent = '0'; return; }
  let n = 0; const s = Math.ceil(t / 40);
  const id = setInterval(() => { n = Math.min(n + s, t); el.textContent = n; if (n >= t) clearInterval(id); }, 28);
});

/* ring */
(function(){
  const fill = document.getElementById('ringFill');
  if (!fill) return;
  const pct = @pct;
  const target = 314 - (pct / 100) * 314;
  fill.style.strokeDashoffset = 314;
  requestAnimationFrame(() => requestAnimationFrame(() => {
    fill.style.transition = 'stroke-dashoffset 1.4s cubic-bezier(.4,0,.2,1)';
    fill.style.strokeDashoffset = target;
  }));
})();

let charts = { radar: null, progress: null, compare: null };

function switchTab(btn, paneId) {
  document.querySelectorAll('.enh-ptab').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.enh-chart-pane').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById(paneId).classList.add('active');
  const map = { 'tab-radar': charts.radar, 'tab-progress': charts.progress, 'tab-compare': charts.compare };
  if (map[paneId]) map[paneId].resize();
}

function selectCurriculum(btn, id) {
  document.querySelectorAll('.enh-pill').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  loadData(id);
}

function setLoading(on) {
  document.getElementById('enh-panel-body').classList.toggle('loading', on);
}

function mkRadar(labels, student, batch) {
  if (charts.radar) charts.radar.destroy();
  charts.radar = new Chart(document.getElementById('radarChart'), {
    type: 'radar',
    data: { labels, datasets: [
      { label: 'أداء الطالب', data: student, backgroundColor: C.tealS, borderColor: C.teal, borderWidth: 2.5, pointBackgroundColor: C.teal, pointBorderColor: '#fff', pointRadius: 5 },
      { label: 'متوسط الدفعة', data: batch,   backgroundColor: C.orangeS, borderColor: C.orange, borderWidth: 2.5, pointBackgroundColor: C.orange, pointBorderColor: '#fff', pointRadius: 5 }
    ]},
    options: { responsive: true, plugins: { legend: { position: 'bottom', labels: { font: { family: 'Cairo', size: 12 }, padding: 20 } } }, scales: { r: { suggestedMin: 0, suggestedMax: 100, angleLines: { color: 'rgba(0,0,0,.08)' }, grid: { color: 'rgba(0,0,0,.07)' }, ticks: { backdropColor: 'transparent', font: { family: 'Cairo', size: 11 }, color: C.gray, stepSize: 25 }, pointLabels: { font: { family: 'Cairo', size: 12, weight: '700' }, color: C.navy } } } }
  });
}

function mkProgress(labels, correct, wrong) {
  if (charts.progress) charts.progress.destroy();
  charts.progress = new Chart(document.getElementById('progressChart'), {
    type: 'bar',
    data: { labels, datasets: [
      { label: 'إجابات صحيحة',  data: correct, backgroundColor: C.green,   borderRadius: 7, borderSkipped: false },
      { label: 'إجابات خاطئة',  data: wrong,   backgroundColor: C.orangeS, borderRadius: 7, borderSkipped: false }
    ]},
    options: { responsive: true, plugins: { legend: { position: 'bottom', labels: { font: { family: 'Cairo', size: 12 }, padding: 16 } } }, scales: { y: { beginAtZero: true, grid: { color: C.gridLine }, ticks: { font: { family: 'Cairo' } } }, x: { grid: { display: false }, ticks: { font: { family: 'Cairo', size: 11 } } } } }
  });
}

function mkCompare(labels, student, batch) {
  if (charts.compare) charts.compare.destroy();
  charts.compare = new Chart(document.getElementById('compareChart'), {
    type: 'bar',
    data: { labels, datasets: [
      { label: 'درجتك', data: student, backgroundColor: C.teal,   borderRadius: 7, borderSkipped: false },
      { label: 'متوسط', data: batch,   backgroundColor: C.orange, borderRadius: 7, borderSkipped: false }
    ]},
    options: { responsive: true, plugins: { legend: { position: 'bottom', labels: { font: { family: 'Cairo', size: 12 }, padding: 16 } } }, scales: { y: { beginAtZero: true, max: 100, grid: { color: C.gridLine }, ticks: { font: { family: 'Cairo' } } }, x: { grid: { display: false }, ticks: { font: { family: 'Cairo', size: 11 } } } } }
  });
}

function loadData(curriculumId) {
  setLoading(true);
  fetch(`/Students/StudentEnhancementSkills/GetCurriculumData?curriculumId=${curriculumId}`)
    .then(r => r.json())
    .then(d => {
      mkRadar(d.sectionLabels, d.studentScores, d.batchAverages);
      mkProgress(d.homeworkTitles, d.correctAnswers, d.remainingQuestions);
      mkCompare(d.homeworkTitles, d.studentHomeworkScores, d.batchHomeworkAverages);
    })
    .catch(e => console.error(e))
    .finally(() => setLoading(false));
}

loadData(0);
</script>
