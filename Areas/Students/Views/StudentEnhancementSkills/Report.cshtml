@model QdratNew.ViewModels.EnhancementSkills.EnhancementReportViewModel
@using System.Text.Json
@using System.Net
@using System.Text.RegularExpressions

@{
    ViewData["Title"] = "تقرير المهارة التعزيزية";
    Layout = null;

    string CleanHtml(string? v, int max = 0)
    {
        if (string.IsNullOrWhiteSpace(v)) return "—";
        var s = WebUtility.HtmlDecode(v);
        s = Regex.Replace(s, @"<br\s*/?>",  " ", RegexOptions.IgnoreCase);
        s = Regex.Replace(s, @"</p\s*>",    " ", RegexOptions.IgnoreCase);
        s = Regex.Replace(s, @"<[^>]+>",    "",  RegexOptions.IgnoreCase);
        s = Regex.Replace(s, @"\s+",        " ").Trim();
        if (string.IsNullOrWhiteSpace(s)) return "—";
        if (max > 0 && s.Length > max) return s[..max] + "…";
        return s;
    }

    // مؤشر المستوى
    string perfLevel = Model.ScorePercentage >= 85 ? "ممتاز"
                     : Model.ScorePercentage >= 70 ? "جيد جداً"
                     : Model.ScorePercentage >= 55 ? "جيد"
                     : Model.ScorePercentage >= 40 ? "مقبول"
                     : "يحتاج مراجعة";
    string perfColor = Model.ScorePercentage >= 85 ? "#10B981"
                     : Model.ScorePercentage >= 70 ? "#0EA5E9"
                     : Model.ScorePercentage >= 55 ? "#F59E0B"
                     : "#EF4444";

    // بيانات الرسوم
    var secLabels  = JsonSerializer.Serialize(Model.SectionsPerformance.Select(s => s.SectionTitle).ToList());
    var secScores  = JsonSerializer.Serialize(Model.SectionsPerformance.Select(s => s.Accuracy).ToList());
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <style>
        :root {
            --clr-primary:#4F46E5; --clr-primary-d:#3730A3;
            --clr-success:#10B981; --clr-danger:#EF4444;
            --clr-warning:#F59E0B; --clr-info:#0EA5E9;
            --clr-bg:#F1F5F9; --clr-surface:#FFFFFF;
            --clr-border:#E2E8F0; --clr-text:#1E293B; --clr-muted:#64748B;
            --radius:16px;
            --shadow-sm:0 2px 8px rgba(0,0,0,.06);
            --shadow-md:0 4px 20px rgba(0,0,0,.10);
            --shadow-lg:0 8px 40px rgba(0,0,0,.14);
            --font:'Cairo',sans-serif;
        }
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
        html{scroll-behavior:smooth}
        body{font-family:var(--font);background:var(--clr-bg);color:var(--clr-text);min-height:100vh;direction:rtl}

        /* HERO */
        .hero{background:linear-gradient(135deg,#064E3B 0%,#065F46 40%,#0D9488 100%);color:#fff;padding:32px 0 80px;position:relative;overflow:hidden}
        .hero::before{content:'';position:absolute;inset:0;background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E")}
        .hero-inner{max-width:1200px;margin:0 auto;padding:0 24px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;position:relative;z-index:1}
        .hero-info h1{font-size:clamp(1.5rem,4vw,2.2rem);font-weight:900;letter-spacing:-.5px;margin-bottom:8px}
        .meta-pills{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px}
        .meta-pill{background:rgba(255,255,255,.15);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.25);border-radius:50px;padding:5px 14px;font-size:.82rem;display:inline-flex;align-items:center;gap:6px}

        /* Score Gauge */
        .score-gauge-wrap{display:flex;flex-direction:column;align-items:center;gap:6px}
        .score-gauge{width:140px;height:140px;border-radius:50%;background:conic-gradient(@Html.Raw(perfColor) calc(@Model.ScorePercentage * 1%),rgba(255,255,255,.15) 0);display:flex;align-items:center;justify-content:center;position:relative;box-shadow:0 0 0 6px rgba(255,255,255,.15),0 0 0 12px rgba(255,255,255,.08)}
        .score-gauge::after{content:'';position:absolute;inset:14px;border-radius:50%;background:#064E3B}
        .score-gauge-inner{position:relative;z-index:2;text-align:center}
        .score-gauge-inner .num{font-size:2rem;font-weight:900;line-height:1}
        .score-gauge-inner .lbl{font-size:.72rem;opacity:.8}
        .perf-badge{background:@Html.Raw(perfColor);color:#fff;padding:4px 16px;border-radius:50px;font-size:.82rem;font-weight:700}

        /* CONTENT */
        .content{max-width:1200px;margin:-48px auto 40px;padding:0 24px;position:relative;z-index:2}

        /* CARD */
        .card{background:var(--clr-surface);border-radius:var(--radius);box-shadow:var(--shadow-sm);border:1px solid var(--clr-border);padding:24px;overflow:hidden}
        .card-header{display:flex;align-items:center;gap:10px;margin-bottom:20px;padding-bottom:14px;border-bottom:2px solid var(--clr-bg)}
        .card-header .icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1rem;flex-shrink:0}
        .card-header h2{font-size:1rem;font-weight:700;color:var(--clr-text)}

        /* KPI */
        .kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:16px;margin-bottom:24px}
        .kpi-card{background:var(--clr-surface);border-radius:var(--radius);padding:20px;border:1px solid var(--clr-border);box-shadow:var(--shadow-sm);display:flex;flex-direction:column;gap:8px;position:relative;overflow:hidden;transition:transform .2s,box-shadow .2s}
        .kpi-card:hover{transform:translateY(-2px);box-shadow:var(--shadow-md)}
        .kpi-card::before{content:'';position:absolute;top:0;right:0;width:4px;height:100%;background:var(--accent)}
        .kpi-card .kpi-icon{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.2rem;background:color-mix(in srgb,var(--accent) 12%,transparent);color:var(--accent)}
        .kpi-card .kpi-value{font-size:1.9rem;font-weight:900;color:var(--accent);line-height:1}
        .kpi-card .kpi-label{font-size:.78rem;color:var(--clr-muted);font-weight:500}

        /* CHARTS GRID */
        .charts-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px}
        .charts-grid .full{grid-column:1/-1}
        .chart-canvas-wrap{position:relative;width:100%}
        @@media(max-width:768px){.charts-grid{grid-template-columns:1fr}.charts-grid .full{grid-column:1}}

        /* TABLE */
        .indicators-table-wrap{overflow-x:auto}
        .indicators-table{width:100%;border-collapse:collapse;font-size:.875rem}
        .indicators-table thead tr{background:linear-gradient(135deg,#0D9488,#065F46);color:#fff}
        .indicators-table th{padding:12px 14px;font-weight:600;text-align:center;white-space:nowrap}
        .indicators-table tbody tr{border-bottom:1px solid var(--clr-border);transition:background .15s}
        .indicators-table tbody tr:hover{background:#F0FDF4}
        .indicators-table td{padding:12px 14px;text-align:center;vertical-align:middle}
        .td-title{text-align:right;font-weight:600;color:var(--clr-text)}
        .progress-bar-wrap{background:var(--clr-bg);border-radius:50px;height:8px;overflow:hidden;width:100%;min-width:80px}
        .progress-bar-fill{height:100%;border-radius:50px;transition:width .6s ease}
        .badge-score{display:inline-block;padding:3px 10px;border-radius:50px;font-size:.78rem;font-weight:700}
        .badge-success{background:#D1FAE5;color:#065F46}
        .badge-warning{background:#FEF3C7;color:#92400E}
        .badge-danger{background:#FEE2E2;color:#991B1B}

        /* SECTIONS CARDS */
        .section-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px}
        .section-card{border-radius:12px;padding:16px;border:1px solid}

        /* WRONG Q */
        .rec-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px}
        .rec-item{display:flex;gap:14px;align-items:flex-start;padding:16px;border-radius:12px;border:1px solid #E0E7FF;background:linear-gradient(135deg,#F5F3FF 0%,#EEF2FF 100%);transition:box-shadow .2s}
        .rec-item:hover{box-shadow:var(--shadow-md)}
        .rec-num{width:32px;height:32px;flex-shrink:0;border-radius:50%;background:var(--clr-primary);color:#fff;font-weight:800;font-size:.88rem;display:flex;align-items:center;justify-content:center}
        .rec-text{font-size:.85rem;color:#374151;line-height:1.7}

        /* ACTION BAR */
        .action-bar{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:32px;padding:24px}
        .btn-primary{display:inline-flex;align-items:center;gap:8px;padding:12px 28px;border-radius:10px;font-size:.9rem;font-weight:700;text-decoration:none;border:none;cursor:pointer;transition:all .2s}
        .btn-primary.main{background:#0D9488;color:#fff}
        .btn-primary.main:hover{background:#065F46;transform:translateY(-1px);box-shadow:0 4px 16px rgba(13,148,136,.4)}
        .btn-primary.ghost{background:var(--clr-surface);color:var(--clr-text);border:1.5px solid var(--clr-border)}
        .btn-primary.ghost:hover{border-color:#0D9488;color:#0D9488}

        .section-gap{margin-bottom:24px}

        @@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
        .fade-up{animation:fadeUp .5s ease forwards}
        .delay-1{animation-delay:.1s;opacity:0}
        .delay-2{animation-delay:.2s;opacity:0}
        .delay-3{animation-delay:.3s;opacity:0}

        @@media print{
            .no-print{display:none!important}
            body{background:#fff}
            .hero{-webkit-print-color-adjust:exact;print-color-adjust:exact;padding:18px 0!important}
            .content{margin:0 auto!important;padding:0!important;position:static!important}
            .card{box-shadow:none!important;border:1px solid #ddd!important;break-inside:avoid-page}
            @@page{size:A4 portrait;margin:12mm 10mm}
        }
    </style>
</head>
<body>

<!-- ══════════ HERO ══════════ -->
<div class="hero">
    <div class="hero-inner">
        <div class="hero-info">
            <div style="font-size:.82rem;opacity:.7;margin-bottom:6px;display:flex;align-items:center;gap:6px">
                <i class="fa-solid fa-bolt"></i> تقرير أداء المهارة التعزيزية
            </div>
            <h1>@Model.Title</h1>
            <p style="opacity:.8;font-size:.95rem;margin-bottom:12px">
                @if (!string.IsNullOrEmpty(Model.LectureTitle))
                { <text>محاضرة: @Model.LectureTitle — </text> }
                تاريخ: @Model.CreatedAt.ToString("yyyy/MM/dd")
            </p>
            <div class="meta-pills">
                @if (!string.IsNullOrEmpty(Model.StudentName))
                {
                    <span class="meta-pill"><i class="fa-solid fa-user-graduate"></i> @Model.StudentName</span>
                }
                @if (!string.IsNullOrEmpty(Model.BatchName))
                {
                    <span class="meta-pill"><i class="fa-solid fa-users"></i> @Model.BatchName</span>
                }
                <span class="meta-pill"><i class="fa-solid fa-list-check"></i> @Model.TotalQuestions سؤال</span>
                <span class="meta-pill"><i class="fa-solid fa-layer-group"></i> @Model.SectionsPerformance.Count محور</span>
            </div>
        </div>
        <div class="score-gauge-wrap">
            <div class="score-gauge">
                <div class="score-gauge-inner">
                    <div class="num">@Math.Round(Model.ScorePercentage)%</div>
                    <div class="lbl">النسبة</div>
                </div>
            </div>
            <span class="perf-badge">@perfLevel</span>
        </div>
    </div>
</div>

<!-- ══════════ CONTENT ══════════ -->
<div class="content">

    <!-- KPI Cards -->
    <div class="kpi-grid section-gap fade-up">
        <div class="kpi-card" style="--accent:#10B981">
            <div class="kpi-icon"><i class="fa-solid fa-circle-check"></i></div>
            <div class="kpi-value">@Model.CorrectAnswers</div>
            <div class="kpi-label">إجابات صحيحة</div>
        </div>
        <div class="kpi-card" style="--accent:#EF4444">
            <div class="kpi-icon"><i class="fa-solid fa-circle-xmark"></i></div>
            <div class="kpi-value">@Model.WrongCount</div>
            <div class="kpi-label">إجابات خاطئة</div>
        </div>
        <div class="kpi-card" style="--accent:#F59E0B">
            <div class="kpi-icon"><i class="fa-solid fa-circle-minus"></i></div>
            <div class="kpi-value">@Model.SkippedCount</div>
            <div class="kpi-label">أسئلة متروكة</div>
        </div>
        <div class="kpi-card" style="--accent:#8B5CF6">
            <div class="kpi-icon"><i class="fa-solid fa-gauge-high"></i></div>
            <div class="kpi-value">@Math.Round(Model.ScorePercentage)%</div>
            <div class="kpi-label">النسبة الكلية</div>
        </div>
        <div class="kpi-card" style="--accent:#0EA5E9">
            <div class="kpi-icon"><i class="fa-solid fa-layer-group"></i></div>
            <div class="kpi-value" style="font-size:1.4rem">@Model.SectionsPerformance.Count</div>
            <div class="kpi-label">محاور مُختبَرة</div>
        </div>
        <div class="kpi-card" style="--accent:#EC4899">
            <div class="kpi-icon"><i class="fa-solid fa-star"></i></div>
            <div class="kpi-value" style="font-size:1.3rem">
                @(Model.SectionsPerformance.Any() ? Model.SectionsPerformance.First().SectionTitle : "—")
            </div>
            <div class="kpi-label">أفضل محور</div>
        </div>
    </div>

    <!-- Charts -->
    <div class="charts-grid section-gap">

        <!-- Doughnut: توزيع الإجابات -->
        <div class="card fade-up delay-1">
            <div class="card-header">
                <div class="icon" style="background:#EEF2FF;color:#4F46E5"><i class="fa-solid fa-chart-pie"></i></div>
                <h2>توزيع الإجابات</h2>
            </div>
            <div class="chart-canvas-wrap" style="height:240px">
                <canvas id="pieChart"></canvas>
            </div>
        </div>

        <!-- Horizontal Bar: أداء المحاور -->
        <div class="card fade-up delay-2">
            <div class="card-header">
                <div class="icon" style="background:#ECFDF5;color:#10B981"><i class="fa-solid fa-chart-bar"></i></div>
                <h2>الأداء حسب المحاور</h2>
            </div>
            <div class="chart-canvas-wrap" style="height:240px">
                <canvas id="sectionBar"></canvas>
            </div>
        </div>

        @if (Model.SectionsPerformance.Any())
        {
            <!-- Radar -->
            <div class="card fade-up delay-3">
                <div class="card-header">
                    <div class="icon" style="background:#FDF2F8;color:#EC4899"><i class="fa-solid fa-spider-web"></i></div>
                    <h2>مستوى المحاور (رادار)</h2>
                </div>
                <div class="chart-canvas-wrap" style="height:280px">
                    <canvas id="radarChart"></canvas>
                </div>
            </div>

            <!-- Bar: المحاور الخاطئة -->
            <div class="card fade-up delay-3">
                <div class="card-header">
                    <div class="icon" style="background:#FEF2F2;color:#EF4444"><i class="fa-solid fa-chart-column"></i></div>
                    <h2>الإجابات الصحيحة مقابل الخاطئة لكل محور</h2>
                </div>
                <div class="chart-canvas-wrap" style="height:280px">
                    <canvas id="sectionDetailBar"></canvas>
                </div>
            </div>
        }

    </div>

    <!-- Indicators Table -->
    @if (Model.SectionsPerformance.Any())
    {
        <div class="card section-gap fade-up">
            <div class="card-header">
                <div class="icon" style="background:#EEF2FF;color:#4F46E5"><i class="fa-solid fa-table-list"></i></div>
                <h2>جدول أداء المحاور التفصيلي</h2>
            </div>
            <div class="indicators-table-wrap">
                <table class="indicators-table">
                    <thead>
                        <tr>
                            <th style="text-align:right">المحور</th>
                            <th>الأسئلة</th>
                            <th>صحيح</th>
                            <th>خاطئ</th>
                            <th>متروك</th>
                            <th>نسبة الإتقان</th>
                            <th>المستوى</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.SectionsPerformance)
                        {
                            var sc  = s.Accuracy >= 85 ? "badge-success" : s.Accuracy >= 55 ? "badge-warning" : "badge-danger";
                            var bar = s.Accuracy >= 85 ? "#10B981" : s.Accuracy >= 55 ? "#F59E0B" : "#EF4444";
                            var lev = s.Accuracy >= 85 ? "ممتاز" : s.Accuracy >= 70 ? "جيد جداً" : s.Accuracy >= 55 ? "جيد" : s.Accuracy >= 40 ? "مقبول" : "قيد التطوير";
                            <tr>
                                <td class="td-title">@s.SectionTitle</td>
                                <td>@s.TotalQuestions</td>
                                <td style="color:#10B981;font-weight:700">@s.CorrectCount</td>
                                <td style="color:#EF4444;font-weight:700">@s.WrongCount</td>
                                <td style="color:#F59E0B;font-weight:700">@s.SkippedCount</td>
                                <td>
                                    <div style="display:flex;align-items:center;gap:8px;min-width:120px">
                                        <div class="progress-bar-wrap" style="flex:1">
                                            <div class="progress-bar-fill" style="width:@s.Accuracy%;background:@bar"></div>
                                        </div>
                                        <span class="badge-score @sc">@s.Accuracy%</span>
                                    </div>
                                </td>
                                <td><span class="badge-score @sc">@lev</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Sections Performance Summary -->
    @if (Model.SectionsPerformance.Any())
    {
        <div class="card section-gap fade-up">
            <div class="card-header">
                <div class="icon" style="background:#EDE9FE;color:#7C3AED"><i class="fa-solid fa-layer-group"></i></div>
                <h2>ملخص أداء المحاور</h2>
            </div>
            <div class="section-cards">
                @foreach (var sec in Model.SectionsPerformance)
                {
                    var sColor = sec.Accuracy >= 85 ? "#10B981" : sec.Accuracy >= 55 ? "#F59E0B" : "#EF4444";
                    var sBg    = sec.Accuracy >= 85 ? "#ECFDF5" : sec.Accuracy >= 55 ? "#FFFBEB" : "#FEF2F2";
                    <div class="section-card" style="background:@sBg;border-color:@sColor">
                        <div style="font-weight:700;font-size:.9rem;color:var(--clr-text);margin-bottom:8px">@sec.SectionTitle</div>
                        <div style="font-size:1.8rem;font-weight:900;color:@sColor">@sec.Accuracy%</div>
                        <div class="progress-bar-wrap" style="margin-top:8px">
                            <div class="progress-bar-fill" style="width:@sec.Accuracy%;background:@sColor"></div>
                        </div>
                        <div style="font-size:.75rem;color:var(--clr-muted);margin-top:6px">
                            @sec.CorrectCount صحيح / @sec.TotalQuestions سؤال
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Wrong Questions -->
    @if (Model.Questions.Any(q => !q.IsCorrect))
    {
        <div class="card section-gap fade-up">
            <div class="card-header">
                <div class="icon" style="background:#FEF2F2;color:#DC2626"><i class="fa-solid fa-circle-xmark"></i></div>
                <h2>الأسئلة التي تحتاج مراجعة</h2>
            </div>
            <div class="rec-grid">
                @foreach (var item in Model.Questions.Where(q => !q.IsCorrect).Select((q, i) => new { q, i }))
                {
                    <div class="rec-item" style="border-color:#FCA5A5;background:linear-gradient(135deg,#FFF5F5,#FEF2F2)">
                        <div class="rec-num" style="background:#EF4444">@(item.i + 1)</div>
                        <div class="rec-text">
                            @if (!string.IsNullOrEmpty(item.q.SectionTitle))
                            {
                                <div style="font-size:.75rem;color:#0D9488;font-weight:700;margin-bottom:4px">📂 @item.q.SectionTitle</div>
                            }
                            <div style="font-weight:700;margin-bottom:6px">@CleanHtml(item.q.QuestionTitle, 80)</div>
                            <div style="font-size:.78rem">
                                <span style="color:#EF4444">❌ إجابتك: @CleanHtml(item.q.StudentAnswer ?? "لم يجب")</span><br/>
                                <span style="color:#10B981">✅ الصحيحة: @CleanHtml(item.q.CorrectAnswer)</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card section-gap" style="background:linear-gradient(135deg,#ECFDF5,#F0FDF4);border:1px solid #6EE7B7;text-align:center;padding:40px">
            <div style="font-size:3rem;margin-bottom:12px">🎉</div>
            <h3 style="color:#065F46;font-size:1.2rem;font-weight:900">أحسنت! لقد أجبت على جميع الأسئلة بشكل صحيح</h3>
            <p style="color:#059669;margin-top:8px">استمر في هذا المستوى الرائع!</p>
        </div>
    }

    <!-- Action Bar -->
    <div class="action-bar no-print">
        <button onclick="window.print()" class="btn-primary main">
            <i class="fa-solid fa-print"></i> طباعة / PDF
        </button>
        <a href="/Students/StudentEnhancementSkills/Review/@Model.SetId" class="btn-primary ghost">
            <i class="fa-solid fa-eye"></i> مراجعة الإجابات
        </a>
        <a href="/Students/StudentEnhancementSkills/AllEnhancements" class="btn-primary ghost">
            <i class="fa-solid fa-arrow-right"></i> العودة للقائمة
        </a>
    </div>

</div>

<!-- ══════════ SCRIPTS ══════════ -->
<script>
(function(){
    const palette = {
        green:'#10B981', red:'#EF4444', amber:'#F59E0B',
        blue:'#0EA5E9', teal:'#0D9488', purple:'#7C3AED'
    };

    // 1. Doughnut
    new Chart(document.getElementById('pieChart'),{
        type:'doughnut',
        data:{
            labels:['صحيحة','خاطئة','متروكة'],
            datasets:[{
                data:[@Model.CorrectAnswers,@Model.WrongCount,@Model.SkippedCount],
                backgroundColor:[palette.green,palette.red,palette.amber],
                borderWidth:2,borderColor:'#fff',hoverOffset:8
            }]
        },
        options:{
            responsive:true,maintainAspectRatio:false,
            plugins:{
                legend:{position:'bottom',labels:{font:{family:'Cairo',size:12},padding:16}},
                tooltip:{callbacks:{label:ctx=>` ${ctx.label}: ${ctx.parsed} سؤال`}}
            },
            cutout:'65%'
        }
    });

    // 2. Horizontal Bar: أداء المحاور
    const secLabels = @Html.Raw(secLabels);
    const secScores = @Html.Raw(secScores);
    const secColors = secScores.map(s => s>=85?palette.green:s>=55?palette.amber:palette.red);

    new Chart(document.getElementById('sectionBar'),{
        type:'bar',
        data:{
            labels:secLabels,
            datasets:[{label:'نسبة الإتقان %',data:secScores,backgroundColor:secColors,borderRadius:8,borderSkipped:false}]
        },
        options:{
            responsive:true,maintainAspectRatio:false,
            indexAxis:'y',
            plugins:{legend:{display:false}},
            scales:{
                x:{beginAtZero:true,max:100,ticks:{callback:v=>v+'%'},grid:{color:'#F1F5F9'}},
                y:{ticks:{font:{family:'Cairo',size:11}}}
            }
        }
    });

    @if (Model.SectionsPerformance.Any())
    {
        // 3. Radar
        <text>
    new Chart(document.getElementById('radarChart'),{
        type:'radar',
        data:{
            labels:secLabels,
            datasets:[{
                label:'نسبة الإتقان',data:secScores,
                backgroundColor:'rgba(13,148,136,.15)',borderColor:palette.teal,
                borderWidth:2,pointBackgroundColor:palette.teal,pointRadius:4
            }]
        },
        options:{
            responsive:true,maintainAspectRatio:false,
            scales:{r:{min:0,max:100,ticks:{stepSize:25,font:{family:'Cairo',size:10}},grid:{color:'#E2E8F0'},pointLabels:{font:{family:'Cairo',size:11}}}},
            plugins:{legend:{display:false}}
        }
    });
        </text>

        // 4. Stacked Bar: صحيح/خاطئ/متروك
        var correctCounts  = @Html.Raw(JsonSerializer.Serialize(Model.SectionsPerformance.Select(s => s.CorrectCount).ToList()));
        var wrongCounts    = @Html.Raw(JsonSerializer.Serialize(Model.SectionsPerformance.Select(s => s.WrongCount).ToList()));
        var skippedCounts  = @Html.Raw(JsonSerializer.Serialize(Model.SectionsPerformance.Select(s => s.SkippedCount).ToList()));

        <text>
    new Chart(document.getElementById('sectionDetailBar'),{
        type:'bar',
        data:{
            labels:secLabels,
            datasets:[
                {label:'صحيح',  data:correctCounts, backgroundColor:palette.green, borderRadius:4,borderSkipped:false},
                {label:'خاطئ',  data:wrongCounts,   backgroundColor:palette.red,   borderRadius:4,borderSkipped:false},
                {label:'متروك', data:skippedCounts, backgroundColor:palette.amber,  borderRadius:4,borderSkipped:false}
            ]
        },
        options:{
            responsive:true,maintainAspectRatio:false,
            plugins:{legend:{position:'bottom',labels:{font:{family:'Cairo',size:11},padding:12}}},
            scales:{
                x:{
                    stacked:true,
                    title:{display:true,text:'المحور',color:'#334155',font:{family:'Cairo',size:12,weight:'700'}},
                    grid:{display:true,color:'#E2E8F0',drawTicks:true},
                    border:{display:true,color:'#94A3B8',width:1},
                    ticks:{display:true,color:'#475569',font:{family:'Cairo',size:10},maxRotation:45,minRotation:0}
                },
                y:{
                    stacked:true,
                    beginAtZero:true,
                    suggestedMax:Math.max(1,...correctCounts.map((v,i)=>v+wrongCounts[i]+skippedCounts[i])),
                    title:{display:true,text:'عدد الإجابات',color:'#334155',font:{family:'Cairo',size:12,weight:'700'}},
                    grid:{display:true,color:'#E2E8F0',drawTicks:true},
                    border:{display:true,color:'#94A3B8',width:1},
                    ticks:{display:true,color:'#475569',font:{family:'Cairo'},precision:0,stepSize:1}
                }
            }
        }
    });
        </text>
    }

})();
</script>

</body>
</html>
