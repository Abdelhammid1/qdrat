@model List<QdratNew.ViewModels.EnhancementSkills.StudentEnhancementCardViewModel>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>

<style>
:root{--p:#2e9e9e;--p-d:#1d7b7b;--p-a:rgba(46,158,158,.12);--p-glow:rgba(46,158,158,.3);--amber:#f59e0b;--ambera:rgba(245,158,11,.12);--ink:#1e293b;--ink2:#475569;--bg:#f0f4f8;--card:#ffffff;--line:rgba(0,0,0,.07);--r:16px;--sh:0 2px 16px rgba(0,0,0,.07);--sh2:0 8px 32px rgba(0,0,0,.13);--ease:.28s cubic-bezier(.4,0,.2,1)}
*{box-sizing:border-box;margin:0;padding:0}
.al{font-family:'Cairo',sans-serif;direction:rtl;background:var(--bg);min-height:100vh;padding:0 0 60px}
.al-hero{background:linear-gradient(145deg,#0f1f3d 0%,#1a3a5c 55%,#103545 100%);padding:28px 28px 44px;margin-bottom:-20px;position:relative;overflow:hidden}
.al-hero::before{content:'';position:absolute;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle,rgba(46,158,158,.14) 0%,transparent 65%);top:-100px;left:-60px;pointer-events:none}
.al-hero-inner{position:relative;z-index:1;display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.al-hero-ico{width:52px;height:52px;background:rgba(255,255,255,.1);border:1.5px solid rgba(255,255,255,.18);border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;color:#fff;backdrop-filter:blur(8px);flex-shrink:0}
.al-hero-text h1{color:#fff;font-size:1.4rem;font-weight:800;margin:0 0 3px}
.al-hero-text p{color:rgba(255,255,255,.55);font-size:.82rem;margin:0}
.al-hero-stats{position:relative;z-index:1;display:flex;gap:12px;flex-wrap:wrap;margin-top:16px}
.al-hstat{display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);border-radius:50px;padding:7px 18px;color:rgba(255,255,255,.85);font-size:.8rem;font-weight:700}
.al-hstat-dot{width:8px;height:8px;border-radius:50%}
.al-body{padding:24px 20px}
.al-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:16px}
.al-card{background:var(--card);border-radius:var(--r);border:1px solid var(--line);box-shadow:var(--sh);overflow:hidden;display:flex;flex-direction:column;transition:transform var(--ease),box-shadow var(--ease);animation:cardIn .4s ease both}
.al-card:hover{transform:translateY(-4px);box-shadow:var(--sh2)}
@@keyframes cardIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
.al-card-stripe{height:3px;background:linear-gradient(90deg,var(--amber),#fcd34d)}
.al-card-body{padding:18px 20px;flex:1;display:flex;flex-direction:column;gap:12px}
.al-card-top{display:flex;align-items:flex-start;gap:12px}
.al-card-ico{width:44px;height:44px;border-radius:12px;background:var(--ambera);color:var(--amber);flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:1.1rem}
.al-card-title{font-size:.97rem;font-weight:800;color:var(--ink);line-height:1.35;margin-bottom:4px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.al-card-meta{display:flex;flex-wrap:wrap;gap:6px}
.al-tag{display:inline-flex;align-items:center;gap:4px;background:#f1f5f9;border:1px solid var(--line);border-radius:6px;padding:2px 10px;font-size:.7rem;font-weight:700;color:var(--ink2)}
.al-tag i{font-size:.65rem;opacity:.6}
.al-status-pending{display:inline-flex;align-items:center;gap:5px;border-radius:50px;padding:4px 12px;font-size:.73rem;font-weight:800;background:var(--ambera);color:#92400e}
.al-card-foot{padding:14px 20px;border-top:1px solid var(--line);background:#fafbfc;display:flex;gap:8px}
.al-btn{flex:1;display:flex;align-items:center;justify-content:center;gap:6px;padding:9px 14px;border-radius:10px;border:none;font-family:'Cairo',sans-serif;font-size:.82rem;font-weight:700;cursor:pointer;text-decoration:none;transition:all var(--ease);background:var(--p);color:#fff;box-shadow:0 3px 10px var(--p-glow)}
.al-btn:hover{text-decoration:none;background:var(--p-d);color:#fff;transform:translateY(-1px)}
.al-empty{text-align:center;padding:60px;background:var(--card);border-radius:var(--r);border:1px solid var(--line);box-shadow:var(--sh)}
.al-empty-ico{font-size:3.5rem;opacity:.25;margin-bottom:16px}
.al-empty h3{font-size:1rem;font-weight:800;color:var(--ink);margin-bottom:6px}
.al-empty p{font-size:.85rem;color:var(--ink2)}
</style>

<div class="al">
  <div class="al-hero">
    <div class="al-hero-inner">
      <div class="al-hero-ico"><i class="fa-solid fa-list-check"></i></div>
      <div class="al-hero-text">
        <h1>المهارات التعزيزية المطلوبة</h1>
        <p>الجلسات التي تحتاج إلى الحل — لا تتأخر!</p>
      </div>
    </div>
    <div class="al-hero-stats">
      <span class="al-hstat"><span class="al-hstat-dot" style="background:#f59e0b"></span>مطلوبة: @Model.Count</span>
    </div>
  </div>

  <div class="al-body">
    @if (!Model.Any())
    {
      <div class="al-empty">
        <div class="al-empty-ico">🎉</div>
        <h3>أحسنت! لا توجد جلسات مطلوبة</h3>
        <p>لقد أكملت جميع جلساتك التعزيزية</p>
      </div>
    }
    else
    {
      <div class="al-grid">
        @foreach (var e in Model)
        {
          <div class="al-card">
            <div class="al-card-stripe"></div>
            <div class="al-card-body">
              <div class="al-card-top">
                <div class="al-card-ico"><i class="fa-solid fa-bolt"></i></div>
                <div style="flex:1;min-width:0">
                  <div class="al-card-title">@e.Title</div>
                  <div class="al-card-meta">
                    <span class="al-tag"><i class="fa-regular fa-calendar"></i> @e.CreatedAt.ToString("yyyy/MM/dd")</span>
                    @if (!string.IsNullOrEmpty(e.LectureTitle))
                    {
                      <span class="al-tag"><i class="fa-solid fa-chalkboard-teacher"></i> @e.LectureTitle</span>
                    }
                    <span class="al-tag"><i class="fa-solid fa-circle-question"></i> @e.QuestionsCount سؤال</span>
                    @if (e.EndAt.HasValue)
                    {
                      <span class="al-tag"><i class="fa-solid fa-hourglass-end"></i> ينتهي @e.EndAt.Value.ToString("yyyy/MM/dd")</span>
                    }
                    <span class="al-status-pending">مطلوبة</span>
                  </div>
                </div>
              </div>
            </div>
            <div class="al-card-foot">
              <a asp-action="Start" asp-route-setId="@e.SetId" class="al-btn">
                <i class="fa-solid fa-play"></i> بدء الحل
              </a>
            </div>
          </div>
        }
      </div>
    }
  </div>
</div>
