@using QdratNew.ViewModels.Students
@model IEnumerable<StudentCourseSelectVm>

@{
    ViewData["Title"] = "اختيار الدورة";
    var returnUrl = ViewBag.ReturnUrl as string;
}

<div class="container mt-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">اختيار الدورة والدفعة</h5>
                </div>

                <div class="card-body">

                    <p class="text-muted mb-4">
                        يرجى اختيار الدورة والدفعة النشطة للمتابعة.
                    </p>

                    <div class="list-group">

                        @foreach (var item in Model)
                        {
                            <form asp-action="SetCourse" method="post" class="list-group-item d-flex justify-content-between align-items-center">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="courseId" value="@item.CourseId" />
                                <input type="hidden" name="batchId" value="@item.BatchId" />
                                <input type="hidden" name="courseTitle" value="@item.CourseTitle" />
                                <input type="hidden" name="batchTitle" value="@item.BatchName" />

                                @if (!string.IsNullOrEmpty(returnUrl))
                                {
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                }

                                <div>
                                    <strong>@item.CourseTitle</strong>
                                    <div class="small text-muted">
                                        الدفعة: @item.BatchName
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-outline-primary btn-sm">
                                    اختيار
                                </button>
                            </form>
                        }
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
