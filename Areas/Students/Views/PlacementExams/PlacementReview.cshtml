@model QdratNew.ViewModels.Exam.ExamReviewViewModel
@using QdratNew.Helpers
@using QdratNew.Constants


@{
    ViewData["Title"] = "مراجعة إجابات اختبار تحديد المستوى";

    int total = Model.TotalQuestions;
    int correct = Model.CorrectAnswers;
    int wrong = Model.WrongAnswers;
    int dontKnow = Model.DontKnowAnswers;
    int skipped = Model.SkippedQuestions;
    double percent = Model.ScorePercentage;
    bool isRTL = Model.IsRTL;

    var dict = new Dictionary<string, string>
    {
        ["مراجعة إجابات اختبار تحديد المستوى"] = "Placement Test Review",
        ["إجمالي الأسئلة"] = "Total Questions",
        ["إجابات صحيحة"] = "Correct Answers",
        ["إجابات خاطئة"] = "Wrong Answers",
        ["لا أعرف الإجابة"] = "I don't know",
        ["الأسئلة المتخطاة"] = "Skipped Questions",
        ["النتيجة الإجمالية"] = "Overall Score",
        ["القطعة المرتبطة (انقر للعرض)"] = "Passage (Click to expand)",
        ["القيمة الأولى"] = "Value A",
        ["القيمة الثانية"] = "Value B",
        ["إجابتك"] = "Your Answer",
        ["الإجابة الصحيحة"] = "Correct Answer",
        ["النتيجة"] = "Result",
        ["صحيح"] = "Correct",
        ["خطأ"] = "Wrong",
        ["العودة إلى النتيجة"] = "Back to Result",
        ["سؤال"] = "Question",
        ["شرح السؤال"] = "Explain",
        ["فيديو الشرح"] = "Video",
        ["لا توجد اختيارات لهذا السؤال."] = "No options available for this question.",
        ["الوقت"] = "Time",
        ["ثانية"] = "sec"
    };

    Func<string, string> T = key =>
        isRTL ? key : (dict.ContainsKey(key) ? dict[key] : key);
}



<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<div class="container py-4 @(isRTL ? "rtl-mode" : "ltr-mode")"
     dir="@(isRTL ? "rtl" : "ltr")">

    <!-- 🟦 عنوان الصفحة -->
    <div class="text-center mb-5">
        <h2 class="fw-bold text-primary">
            <i class="fa-solid fa-chart-line me-2"></i> @T("مراجعة إجابات اختبار تحديد المستوى")
        </h2>
        <h4 class="text-secondary">@Model.ExamTitle</h4>
    </div>

    <!-- 🟩 كروت الإحصائيات -->
    <!-- 🟦 كروت الإحصاءات -->
    <div class="container mb-5">
        <div class="row g-3 text-center">
            <!-- 🔹 إجمالي الأسئلة -->
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm rounded-4 stat-card">
                    <div class="card-body py-4">
                        <i class="fa-solid fa-list-ol text-primary fs-2 mb-2"></i>
                        <h6 class="text-muted">@T("إجمالي الأسئلة")</h6>
                        <h3 class="fw-bold text-dark">@total</h3>
                    </div>
                </div>
            </div>

            <!-- ✅ الصحيحة -->
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm rounded-4 stat-card">
                    <div class="card-body py-4">
                        <i class="fa-solid fa-check-circle text-success fs-2 mb-2"></i>
                        <h6 class="text-muted">@T("إجابات صحيحة")</h6>
                        <h3 class="fw-bold text-success">@correct</h3>
                    </div>
                </div>
            </div>

            <!-- ❌ الخاطئة -->
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm rounded-4 stat-card">
                    <div class="card-body py-4">
                        <i class="fa-solid fa-times-circle text-danger fs-2 mb-2"></i>
                        <h6 class="text-muted">@T("إجابات خاطئة")</h6>
                        <h3 class="fw-bold text-danger">@wrong</h3>
                    </div>
                </div>
            </div>

            <!-- ⏭ المتخطاة -->
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm rounded-4 stat-card">
                    <div class="card-body py-4">
                        <i class="fa-solid fa-forward text-warning fs-2 mb-2"></i>
                        <h6 class="text-muted">@T("الأسئلة المتخطاة")</h6>
                        <h3 class="fw-bold text-warning">@skipped</h3>
                    </div>
                </div>
            </div>

            @if (dontKnow > 0)
            {
                <!-- 🤔 لا أعرف الإجابة -->
                <div class="col-md-3 col-6">
                    <div class="card border-0 shadow-sm rounded-4 stat-card">
                        <div class="card-body py-4">
                            <i class="fa-solid fa-circle-question text-secondary fs-2 mb-2"></i>
                            <h6 class="text-muted">@T("لا أعرف الإجابة")</h6>
                            <h3 class="fw-bold text-secondary">@dontKnow</h3>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- شريط النتيجة المئوية -->
        <div class="mt-4 text-center">
            <h5 class="fw-bold mb-3 text-secondary">@T("النتيجة الإجمالية")</h5>
            <div class="progress mx-auto" style="height: 30px; max-width: 400px;">
                <div class="progress-bar fw-bold text-white"
                     style="width:@percent%; background: linear-gradient(90deg, #007bff, #00bcd4);">
                    @percent%
                </div>
            </div>
        </div>
    </div>

    <!-- 🎨 التنسيقات -->
    <style>
        .stat-card {
            transition: transform .2s ease, box-shadow .2s ease;
        }

            .stat-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 6px 14px rgba(0,0,0,0.08);
            }

            .stat-card i {
                display: block;
            }

        .progress {
            border-radius: 20px;
            overflow: hidden;
            background-color: #f0f0f0;
        }

        .progress-bar {
            transition: width 1s ease-in-out;
            font-size: 1.1rem;
        }

        @@media (max-width: 768px) {
            .stat-card .card-body

        {
            padding: 1rem !important;
        }

        .stat-card h3 {
            font-size: 1.4rem;
        }

        }

        .smart-text {
            unicode-bidi: plaintext;
        }
    </style>

    <!-- 🧠 عرض الأسئلة -->
    <div class="row g-3">
        @foreach (var item in Model.Questions.Select((q, i) => new { q, i }))
        {
            var q = item.q;
            var index = item.i + 1;
            Func<string, string> convert = s => q.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(s) : s;

            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-4 mb-3 question-card">
                    <div class="card-header bg-qdrat-soft text-dark fw-bold">
                        <div class="smart-text "
                             dir="@(isRTL ? "rtl" : "ltr")"
                             style="text-align:@(isRTL ? "right" : "left");">
                            @Html.Raw(convert($"{T("سؤال")}: {q.QuestionTitle}"))
                        </div>
                    </div>
                    <div class="card-body">

                        <!-- القطعة النصية إن وجدت -->
                        @if (q.VerbalPassageType == QdratNew.Enums.PassageType.Audio)
                        {
                            <div class="alert alert-light border mb-3 text-center">
                                <strong>🎧 @q.VerbalPassageTitle</strong>

                                <audio controls style="width:100%;">
                                    <source src="@q.VerbalPassageMediaUrl" />
                                </audio>
                            </div>
                        }
                        else if (q.VerbalPassageType == QdratNew.Enums.PassageType.Video)
                        {
                            <div class="alert alert-light border mb-3 text-center">
                                <strong>🎥 @q.VerbalPassageTitle</strong>

                                <video controls style="width:100%; max-height:250px;">
                                    <source src="@q.VerbalPassageMediaUrl" />
                                </video>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(q.VerbalPassageContent))
                        {
                            <details class="mb-3 passage" open>
                                <summary class="fw-semibold">@T("القطعة المرتبطة (انقر للعرض)")</summary>

                                <div class="mt-2 smart-text"
                                     dir="@(isRTL ? "rtl" : "ltr")"
                                     style="text-align:@(isRTL ? "right" : "left");">
                                    @Html.Raw(convert(q.VerbalPassageContent))
                                </div>
                            </details>
                        }

                        <!-- صورة السؤال -->
                        @if (!string.IsNullOrWhiteSpace(q.ImageUrl))
                        {
                            <div class="text-center mb-3">
                                <img src="@Url.Content(q.ImageUrl)" class="img-fluid rounded-3 shadow-sm" style="max-height: 200px;" alt="صورة السؤال" />
                            </div>
                        }

                        <!-- عرض القيم المقارنة -->
                        @if (q.DisplayType == QdratNew.Enums.QuestionDisplayType.ComparisonText)
                        {
                            <div class="row mb-3 text-center">
                                <div class="col-md-6 border-end">
                                    <strong>@T("القيمة الأولى"):</strong>
                                    <div>@Html.Raw(convert(q.ComparisonValue1))</div>
                                </div>
                                <div class="col-md-6">
                                    <strong>@T("القيمة الثانية"):</strong>
                                    <div>@Html.Raw(convert(q.ComparisonValue2))</div>
                                </div>
                            </div>
                        }
                        else if (q.DisplayType == QdratNew.Enums.QuestionDisplayType.ComparisonWithImage)
                        {
                            <div class="row mb-3 text-center align-items-center">
                                <div class="col-md-4">
                                    <img src="@Url.Content(q.ImageUrl)" class="img-fluid" style="max-height: 150px;" />
                                </div>
                                <div class="col-md-4 border-end">
                                    <strong>@T("القيمة الأولى"):</strong>
                                    <div>@Html.Raw(convert(q.ComparisonValue1))</div>
                                </div>
                                <div class="col-md-4">
                                    <strong>@T("القيمة الثانية"):</strong>
                                    <div>@Html.Raw(convert(q.ComparisonValue2))</div>
                                </div>
                            </div>
                        }

                        <!-- عرض الاختيارات -->
                        @if (q.Options != null && q.Options.Count > 0)
                        {
                            <ul class="list-group mb-3 options-list">
                                @foreach (var opt in q.Options)
                                {
                                    var optText = opt.Text ?? "";
                                    var isSelected = optText == q.StudentAnswer;
                                    var isCorrect = optText == q.CorrectAnswer;
                                    var isDontKnowOption = ExamAnswerConstants.IsDontKnowOption(optText);
                                    var liClass = isCorrect ? "list-group-item-success" :
                                    (isSelected && isDontKnowOption ? "list-group-item-secondary" :
                                    (isSelected ? "list-group-item-danger" : ""));

                                    <li class="list-group-item d-flex align-items-center @liClass">
                                        @if (!string.IsNullOrWhiteSpace(opt.ImageUrl))
                                        {
                                            <img src="@Url.Content(opt.ImageUrl)" alt="صورة الاختيار"
                                                 class="img-fluid me-2" style="max-height: 50px;" />
                                        }
                                        else
                                        {
                                            <span class="smart-text"
                                                  dir="@(isRTL ? "rtl" : "ltr")"
                                                  style="text-align:@(isRTL ? "right" : "left");">
                                                @Html.Raw(convert(optText))
                                            </span>
                                        }

                                        @if (isSelected)
                                        {
                                            <span class="badge bg-primary ms-auto">@T("إجابتك")</span>
                                        }
                                        @if (isCorrect)
                                        {
                                            <span class="badge bg-success ms-2">@T("الإجابة الصحيحة")</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="alert alert-light mb-3">@T("لا توجد اختيارات لهذا السؤال.")</div>
                        }

                        <!-- النتيجة -->
                        <p class="fw-bold mb-2 d-flex justify-content-between align-items-center">

                            <!-- الجزء الأساسي (كما هو) -->
                            <span>
                                <strong>@T("النتيجة"):</strong>

                                <span class="@(q.IsCorrect ? "text-success" : (q.IsDontKnowAnswer ? "text-secondary" : "text-danger"))">
                                    @(q.IsCorrect ? "✔️ " + T("صحيح") : (q.IsDontKnowAnswer ? "🤔 " + T("لا أعرف الإجابة") : "❌ " + T("خطأ")))
                                </span>
                            </span>

                            <!-- الأيقونات -->
                            @await Html.PartialAsync("_QuestionExplanationPartial", q)

                        </p>
                   
                        <!-- الوقت المستغرق -->
                        <p class="small text-muted">
                            <strong>⏱️ @T("الوقت"):</strong>
                            @NumberHelper.ToIndicNumbersSafe(Math.Round(q.TimeTakenSeconds).ToString()) @T("ثانية")
                        </p>

                    </div>
                </div>
            </div>
        }
    </div>

    <!-- 🔙 زر الرجوع -->
    <div class="text-center mt-5">
    


        <a asp-action="ResultPlacementExam"
           asp-route-assignmentId="@Context.Request.Query["assignmentId"]"
           class="btn btn-outline-primary btn-lg rounded-pill shadow-sm px-5">
            <i class="fa-solid fa-list-check me-2"></i> @T("العودة إلى النتيجة")
        </a>
    </div>

</div>

@section scripts {


    <style>
        .question-card {
            border-radius: 12px;
            transition: all 0.2s ease;
        }

            .question-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            }

        .options-list .list-group-item {
            border: none;
            border-bottom: 1px solid #eee;
        }

            .options-list .list-group-item:last-child {
                border-bottom: none;
            }

        .list-group-item-success {
            background-color: #e1f8e1 !important;
        }

        .list-group-item-danger {
            background-color: #ffe2e2 !important;
        }

        .passage summary {
            cursor: pointer;
        }

        .passage[open] summary::after {
            content: "▲";
            float: left;
        }

        .passage summary::after {
            content: "▼";
            float: left;
            color: #888;
        }

        .question-card .card-header {
            font-size: 1rem;
            padding: 12px 16px;
        }

        .options-list {
            border-radius: 8px;
            overflow: hidden;
        }

        .smart-text {
            unicode-bidi: plaintext;
            white-space: normal;
            word-break: break-word;
        }

        #extra-content-... {
            transition: all .3s ease;
        }

        .explanation-toggle,
        .video-toggle {
            font-size: 18px;
            transition: 0.2s;
        }

            .explanation-toggle:hover,
            .video-toggle:hover {
                transform: scale(1.2);
            }

        .explanation-content,
        .video-content {
            transition: all .3s ease;
        }

    </style>
}   




