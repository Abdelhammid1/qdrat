@model QdratNew.ViewModels.Students.PlacementExamDashboardViewModel
@using QdratNew.Helpers

@{
    ViewData["Title"] = "لوحة اختبار تحديد المستوى";

    var exams = Model?.PlacementExams?.ToList() ?? new List<QdratNew.ViewModels.Students.PlacementExamVm>();
    var total = exams.Count;
    var submitted = exams.Count(x => x.IsSubmitted);
    var inProgress = exams.Count(x => !x.IsSubmitted && x.IsInProgress);
    var notStarted = exams.Count(x => !x.IsSubmitted && !x.IsInProgress);

    var strengthsCount = Model?.Strengths?.Count() ?? 0;
    var weaknessesCount = Model?.Weaknesses?.Count() ?? 0;

    var improvementStatus = Model.Improvement >= 0 ? "تحسن" : "انخفاض";
    var improvementClass = Model.Improvement >= 0 ? "positive" : "negative";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --p: #2e9e9e;
        --p-d: #1d7b7b;
        --p-a: rgba(46,158,158,.12);
        --p-glow: rgba(46,158,158,.3);
        --orange: #e07849;
        --ora: rgba(224,120,73,.12);
        --green: #22c55e;
        --grna: rgba(34,197,94,.12);
        --red: #ef4444;
        --reda: rgba(239,68,68,.12);
        --amber: #f59e0b;
        --ambera: rgba(245,158,11,.12);
        --blue: #3b82f6;
        --bluea: rgba(59,130,246,.12);
        --purple: #8b5cf6;
        --purplea: rgba(139,92,246,.12);
        --ink: #1e293b;
        --ink2: #475569;
        --ink3: #94a3b8;
        --bg: #f0f4f8;
        --card: #ffffff;
        --line: rgba(0,0,0,.07);
        --r: 16px;
        --r-sm: 10px;
        --sh: 0 2px 16px rgba(0,0,0,.07);
        --sh2: 0 8px 32px rgba(0,0,0,.13);
        --ease: .28s cubic-bezier(.4,0,.2,1);
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .placement-page {
        font-family: 'Cairo', sans-serif;
        direction: rtl;
        background: var(--bg);
        min-height: 100vh;
        padding: 0 0 60px;
    }

    .placement-switcher {
        background: linear-gradient(135deg,#0f1f3d 0%,#1a3a5c 100%);
        border-bottom: 1px solid rgba(255,255,255,.06);
        padding: 0 4px;
    }

    .placement-hero {
        background: linear-gradient(145deg,#0f1f3d 0%,#1a3a5c 55%,#103545 100%);
        padding: 28px 28px 44px;
        margin-bottom: -20px;
        position: relative;
        overflow: hidden;
    }

        .placement-hero::before {
            content: '';
            position: absolute;
            width: 360px;
            height: 360px;
            border-radius: 50%;
            background: radial-gradient(circle,rgba(46,158,158,.14) 0%,transparent 65%);
            top: -100px;
            left: -60px;
            pointer-events: none;
        }

        .placement-hero::after {
            content: '';
            position: absolute;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: radial-gradient(circle,rgba(139,92,246,.11) 0%,transparent 65%);
            bottom: -80px;
            right: -40px;
            pointer-events: none;
        }

    .placement-hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .placement-hero-ico {
        width: 56px;
        height: 56px;
        background: rgba(255,255,255,.1);
        border: 1.5px solid rgba(255,255,255,.18);
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.55rem;
        color: #fff;
        backdrop-filter: blur(8px);
        flex-shrink: 0;
    }

    .placement-hero-text h1 {
        color: #fff;
        font-size: 1.45rem;
        font-weight: 900;
        margin: 0 0 4px;
    }

    .placement-hero-text p {
        color: rgba(255,255,255,.62);
        font-size: .84rem;
        margin: 0;
        line-height: 1.8;
    }

    .placement-student-pill {
        margin-right: auto;
        display: inline-flex;
        align-items: center;
        gap: 9px;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 50px;
        padding: 9px 18px;
        color: #fff;
        font-size: .85rem;
        font-weight: 800;
        backdrop-filter: blur(8px);
    }

    .placement-hero-stats {
        position: relative;
        z-index: 1;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 16px;
    }

    .placement-hstat {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 50px;
        padding: 7px 18px;
        color: rgba(255,255,255,.88);
        font-size: .8rem;
        font-weight: 700;
        backdrop-filter: blur(6px);
    }

    .placement-hstat-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .placement-toolbar {
        background: var(--card);
        border-radius: 0 0 20px 20px;
        border: 1px solid var(--line);
        border-top: none;
        box-shadow: var(--sh);
        padding: 12px 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }

    .placement-filter-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 7px 16px;
        border-radius: 50px;
        border: 1.5px solid var(--line);
        background: transparent;
        font-family: 'Cairo', sans-serif;
        font-size: .8rem;
        font-weight: 700;
        color: var(--ink2);
        cursor: pointer;
        white-space: nowrap;
        transition: all var(--ease);
    }

        .placement-filter-btn:hover {
            border-color: var(--p);
            color: var(--p);
        }

        .placement-filter-btn.active {
            background: var(--p);
            border-color: var(--p);
            color: #fff;
            box-shadow: 0 3px 10px var(--p-glow);
        }

        .placement-filter-btn .fbadge {
            background: rgba(255,255,255,.25);
            border-radius: 99px;
            padding: 1px 7px;
            font-size: .72rem;
            font-weight: 800;
        }

        .placement-filter-btn:not(.active) .fbadge {
            background: var(--line);
            color: var(--ink2);
        }

    .placement-search {
        margin-right: auto;
        display: flex;
        align-items: center;
        background: #f8fafc;
        border: 1px solid var(--line);
        border-radius: 50px;
        overflow: hidden;
    }

        .placement-search input {
            border: none;
            outline: none;
            background: transparent;
            padding: 8px 14px;
            min-width: 220px;
            font-family: 'Cairo', sans-serif;
            font-size: .82rem;
            color: var(--ink);
        }

    .placement-search-ico {
        color: var(--ink3);
        padding: 0 13px;
        font-size: .82rem;
    }

    .placement-shell {
        padding: 0 20px;
    }

    .placement-score-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(230px,1fr));
        gap: 16px;
        margin-bottom: 20px;
    }

    .placement-score-card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: var(--r);
        box-shadow: var(--sh);
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        transition: transform var(--ease), box-shadow var(--ease);
    }

        .placement-score-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--sh2);
        }

    .placement-score-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .score-initial {
        background: var(--bluea);
        color: var(--blue);
    }

    .score-latest {
        background: var(--grna);
        color: var(--green);
    }

    .score-improve {
        background: var(--ambera);
        color: var(--amber);
    }

        .score-improve.negative {
            background: var(--reda);
            color: var(--red);
        }

    .placement-score-title {
        font-size: .78rem;
        font-weight: 800;
        color: var(--ink2);
        margin-bottom: 3px;
    }

    .placement-score-value {
        font-size: 1.4rem;
        font-weight: 900;
        color: var(--ink);
        line-height: 1;
    }

    .placement-score-note {
        font-size: .7rem;
        font-weight: 700;
        color: var(--ink3);
        margin-top: 5px;
    }

    .placement-section-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin: 8px 4px 14px;
        flex-wrap: wrap;
    }

        .placement-section-title h2 {
            font-size: 1rem;
            font-weight: 900;
            color: var(--ink);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .placement-section-title span {
            font-size: .78rem;
            font-weight: 700;
            color: var(--ink3);
        }

    .placement-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(350px,1fr));
        gap: 16px;
        padding: 0 4px;
        margin-bottom: 24px;
    }

    .placement-card {
        background: var(--card);
        border-radius: var(--r);
        border: 1px solid var(--line);
        box-shadow: var(--sh);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform var(--ease), box-shadow var(--ease), border-color var(--ease);
        animation: cardIn .4s ease both;
    }

        .placement-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--sh2);
            border-color: rgba(46,158,158,.22);
        }

    @@keyframes cardIn {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .placement-card-stripe {
        height: 3px;
        width: 100%;
    }

    .stripe-submitted {
        background: linear-gradient(90deg,var(--green),#4ade80);
    }

    .stripe-progress {
        background: linear-gradient(90deg,var(--blue),#60a5fa);
    }

    .stripe-pending {
        background: linear-gradient(90deg,var(--amber),#fcd34d);
    }

    .placement-card-body {
        padding: 18px 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .placement-card-top {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .placement-card-ico {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        margin-top: 2px;
    }

    .ico-submitted {
        background: var(--grna);
        color: var(--green);
    }

    .ico-progress {
        background: var(--bluea);
        color: var(--blue);
    }

    .ico-pending {
        background: var(--ambera);
        color: var(--amber);
    }

    .placement-card-title {
        font-size: .97rem;
        font-weight: 900;
        color: var(--ink);
        line-height: 1.35;
        margin-bottom: 4px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .placement-card-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .placement-tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #f1f5f9;
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 2px 10px;
        font-size: .7rem;
        font-weight: 700;
        color: var(--ink2);
    }

        .placement-tag i {
            font-size: .65rem;
            opacity: .6;
        }

    .placement-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 50px;
        padding: 4px 12px;
        font-size: .73rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .st-submitted {
        background: var(--grna);
        color: #15803d;
    }

    .st-progress {
        background: var(--bluea);
        color: #1d4ed8;
    }

    .st-pending {
        background: var(--ambera);
        color: #92400e;
    }

    .placement-info-box {
        background: #f8fafc;
        border: 1px solid var(--line);
        border-radius: var(--r-sm);
        padding: 12px 14px;
    }

    .placement-info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

    .placement-info-label {
        font-size: .72rem;
        font-weight: 700;
        color: var(--ink2);
    }

    .placement-info-value {
        font-size: .78rem;
        font-weight: 900;
        color: var(--ink);
    }

    .placement-progress {
        height: 7px;
        border-radius: 99px;
        background: var(--line);
        overflow: hidden;
        margin-top: 10px;
    }

    .placement-progress-fill {
        height: 100%;
        width: 100%;
        border-radius: 99px;
    }

    .fill-submitted {
        background: linear-gradient(90deg,var(--green),#4ade80);
    }

    .fill-progress {
        background: linear-gradient(90deg,var(--blue),#60a5fa);
    }

    .fill-pending {
        background: linear-gradient(90deg,var(--amber),#fcd34d);
    }

    .placement-card-foot {
        padding: 14px 20px;
        border-top: 1px solid var(--line);
        background: #fafbfc;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .placement-btn {
        flex: 1;
        min-width: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 9px 14px;
        border-radius: 10px;
        border: none;
        font-family: 'Cairo', sans-serif;
        font-size: .82rem;
        font-weight: 800;
        cursor: pointer;
        text-decoration: none;
        transition: all var(--ease);
    }

        .placement-btn:hover {
            text-decoration: none;
            transform: translateY(-1px);
        }

    .btn-start {
        background: var(--p);
        color: #fff;
        box-shadow: 0 3px 10px var(--p-glow);
    }

        .btn-start:hover {
            background: var(--p-d);
            color: #fff;
        }

    .btn-result {
        background: var(--grna);
        color: #15803d;
        border: 1px solid rgba(34,197,94,.2);
    }

        .btn-result:hover {
            background: rgba(34,197,94,.2);
            color: #15803d;
        }

    .btn-report {
        background: var(--p-a);
        color: var(--p-d);
        border: 1px solid rgba(46,158,158,.2);
    }

        .btn-report:hover {
            background: rgba(46,158,158,.2);
            color: var(--p-d);
        }

    .placement-analysis-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(280px,1fr));
        gap: 16px;
        margin-top: 20px;
    }

    .analysis-card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: var(--r);
        box-shadow: var(--sh);
        overflow: hidden;
    }

    .analysis-head {
        padding: 14px 18px;
        font-size: .9rem;
        font-weight: 900;
        display: flex;
        align-items: center;
        gap: 8px;
        border-bottom: 1px solid var(--line);
    }

        .analysis-head.green {
            background: #f0fdf4;
            color: #15803d;
        }

        .analysis-head.amber {
            background: #fffbeb;
            color: #92400e;
        }

    .analysis-body {
        padding: 16px 18px;
    }

    .analysis-item {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 9px 0;
        font-size: .84rem;
        font-weight: 700;
        color: var(--ink2);
        border-bottom: 1px dashed rgba(0,0,0,.06);
    }

        .analysis-item:last-child {
            border-bottom: none;
        }

        .analysis-item i {
            width: 24px;
            height: 24px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: .75rem;
        }

        .analysis-item.strength i {
            background: var(--grna);
            color: var(--green);
        }

        .analysis-item.weak i {
            background: var(--ambera);
            color: var(--amber);
        }

    .recommendation-card {
        margin-top: 18px;
        background: linear-gradient(135deg,#ffffff 0%,#f8fafc 100%);
        border: 1px solid rgba(46,158,158,.16);
        border-radius: var(--r);
        box-shadow: var(--sh);
        padding: 18px 20px;
        display: flex;
        align-items: flex-start;
        gap: 13px;
    }

    .recommendation-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: var(--p-a);
        color: var(--p);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 1.1rem;
    }

    .recommendation-card h3 {
        font-size: .94rem;
        font-weight: 900;
        color: var(--ink);
        margin-bottom: 5px;
    }

    .recommendation-card p {
        font-size: .84rem;
        font-weight: 700;
        color: var(--ink2);
        line-height: 1.8;
        margin: 0;
    }

    .placement-empty {
        text-align: center;
        padding: 54px 24px;
        background: var(--card);
        border-radius: var(--r);
        border: 1px solid var(--line);
        box-shadow: var(--sh);
    }

    .placement-empty-ico {
        font-size: 3.2rem;
        opacity: .25;
        margin-bottom: 16px;
    }

    .placement-empty h3 {
        font-size: 1rem;
        font-weight: 900;
        color: var(--ink);
        margin-bottom: 6px;
    }

    .placement-empty p {
        font-size: .85rem;
        color: var(--ink2);
        margin: 0;
    }

    .fu {
        opacity: 0;
        transform: translateY(18px);
        animation: fu .45s ease forwards;
    }

    @@keyframes fu {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .d1 {
        animation-delay: .04s;
    }

    .d2 {
        animation-delay: .1s;
    }

    @@media(max-width:700px) {
        .placement-hero {
            padding: 22px 16px 40px;
        }

        .placement-hero-text h1 {
            font-size: 1.15rem;
        }

        .placement-hero-inner {
            flex-direction: column;
            align-items: flex-start;
        }

        .placement-student-pill {
            width: 100%;
            margin-right: 0;
        }

        .placement-search {
            width: 100%;
            margin-right: 0;
        }

            .placement-search input {
                min-width: 0;
                flex: 1;
            }

        .placement-grid {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .placement-toolbar {
            gap: 6px;
        }

        .placement-card-foot {
            padding: 12px 14px;
        }

        .recommendation-card {
            flex-direction: row;
        }
    }
</style>

<div class="placement-switcher">
    @await Component.InvokeAsync("StudentCourseSwitcher")
</div>

<div class="placement-page">

    <!-- HERO -->
    <div class="placement-hero fu">
        <div class="placement-hero-inner">
            <div class="placement-hero-ico">
                <i class="fa-solid fa-user-graduate"></i>
            </div>

            <div class="placement-hero-text">
                <h1>لوحة اختبار تحديد المستوى</h1>
                <p>
                    متابعة اختبارات تحديد المستوى، تحليل نقاط القوة والضعف، وقياس تطور مستواك قبل بداية الدورة.
                </p>
            </div>

            <div class="placement-student-pill">
                <i class="fa-solid fa-user"></i>
                مرحباً، @Model.StudentName
            </div>
        </div>

        <div class="placement-hero-stats">
            <span class="placement-hstat">
                <span class="placement-hstat-dot" style="background:#2e9e9e"></span>
                إجمالي الاختبارات: @total
            </span>

            <span class="placement-hstat">
                <span class="placement-hstat-dot" style="background:#22c55e"></span>
                منجزة: @submitted
            </span>

            <span class="placement-hstat">
                <span class="placement-hstat-dot" style="background:#3b82f6"></span>
                جاري الحل: @inProgress
            </span>

            <span class="placement-hstat">
                <span class="placement-hstat-dot" style="background:#f59e0b"></span>
                لم يبدأ: @notStarted
            </span>

            <span class="placement-hstat">
                <span class="placement-hstat-dot" style="background:#8b5cf6"></span>
                نقاط القوة: @strengthsCount
            </span>

            <span class="placement-hstat">
                <span class="placement-hstat-dot" style="background:#ef4444"></span>
                نقاط الضعف: @weaknessesCount
            </span>
        </div>
    </div>

    <!-- TOOLBAR -->
    <div class="placement-toolbar fu d1">
        <button type="button"
                class="placement-filter-btn active"
                data-filter="all"
                onclick="setPlacementFilter(this)">
            <i class="fa-solid fa-layer-group" style="font-size:.75rem"></i>
            الكل <span class="fbadge">@total</span>
        </button>

        <button type="button"
                class="placement-filter-btn"
                data-filter="submitted"
                onclick="setPlacementFilter(this)">
            <i class="fa-solid fa-circle-check" style="font-size:.75rem"></i>
            منجزة <span class="fbadge">@submitted</span>
        </button>

        <button type="button"
                class="placement-filter-btn"
                data-filter="progress"
                onclick="setPlacementFilter(this)">
            <i class="fa-solid fa-spinner" style="font-size:.75rem"></i>
            جاري الحل <span class="fbadge">@inProgress</span>
        </button>

        <button type="button"
                class="placement-filter-btn"
                data-filter="pending"
                onclick="setPlacementFilter(this)">
            <i class="fa-solid fa-clock" style="font-size:.75rem"></i>
            لم يبدأ <span class="fbadge">@notStarted</span>
        </button>

        <div class="placement-search">
            <span class="placement-search-ico">
                <i class="fa-solid fa-magnifying-glass"></i>
            </span>
            <input type="text"
                   id="placement-search-input"
                   placeholder="ابحث عن اختبار تحديد مستوى…"
                   oninput="applyPlacementFilters()">
        </div>
    </div>

    <div class="placement-shell">

        <!-- SCORE CARDS -->
        <div class="placement-score-grid fu d2">
            <div class="placement-score-card">
                <div class="placement-score-icon score-initial">
                    <i class="fa-solid fa-flag-checkered"></i>
                </div>
                <div>
                    <div class="placement-score-title">الدرجة الأولى</div>
                    <div class="placement-score-value">@Model.InitialScore.ToString("F2")%</div>
                    <div class="placement-score-note">نقطة البداية في تحديد المستوى</div>
                </div>
            </div>

            <div class="placement-score-card">
                <div class="placement-score-icon score-latest">
                    <i class="fa-solid fa-chart-line"></i>
                </div>
                <div>
                    <div class="placement-score-title">آخر درجة</div>
                    <div class="placement-score-value">@Model.LatestScore.ToString("F2")%</div>
                    <div class="placement-score-note">آخر نتيجة مسجلة للطالب</div>
                </div>
            </div>

            <div class="placement-score-card">
                <div class="placement-score-icon score-improve @improvementClass">
                    <i class="fa-solid @(Model.Improvement >= 0 ? "fa-arrow-trend-up" : "fa-arrow-trend-down")"></i>
                </div>
                <div>
                    <div class="placement-score-title">نسبة التحسن</div>
                    <div class="placement-score-value">
                        @(Model.Improvement >= 0 ? "+" : "")@Model.Improvement.ToString("F2")%
                    </div>
                    <div class="placement-score-note">@improvementStatus مقارنة بالبداية</div>
                </div>
            </div>
        </div>

        <!-- EXAMS -->
        <div class="placement-section-title">
            <h2>
                <i class="fa-solid fa-clipboard-list"></i>
                سجل اختبارات تحديد المستوى
            </h2>
            <span>يُعرض <b id="placement-count-shown">@total</b> من إجمالي @total اختبار</span>
        </div>

        <div class="placement-grid" id="placement-grid">
            @if (Model.PlacementExams != null && Model.PlacementExams.Any())
            {
                foreach (var exam in Model.PlacementExams)
                {
                    var statusKey = exam.IsSubmitted
                    ? "submitted"
                    : exam.IsInProgress
                    ? "progress"
                    : "pending";

                    var statusText = exam.IsSubmitted
                    ? "مُنجز"
                    : exam.IsInProgress
                    ? "جاري الحل"
                    : "لم يبدأ";

                    var statusIcon = exam.IsSubmitted
                    ? "fa-circle-check"
                    : exam.IsInProgress
                    ? "fa-spinner"
                    : "fa-clock";

                    var stripeClass = $"stripe-{statusKey}";
                    var iconClass = $"ico-{statusKey}";
                    var statusClass = $"st-{statusKey}";
                    var fillClass = $"fill-{statusKey}";

                    var actionText = exam.IsSubmitted
                    ? "استعراض النتيجة والتقرير"
                    : exam.IsInProgress
                    ? "استكمال الاختبار"
                    : "بدء اختبار تحديد المستوى";

                    <div class="placement-card"
                         data-status="@statusKey"
                         data-title="@((exam.Title ?? string.Empty).ToLower())"
                         data-date="@exam.AssignedAt.ToString("yyyyMMdd")">

                        <div class="placement-card-stripe @stripeClass"></div>

                        <div class="placement-card-body">

                            <div class="placement-card-top">
                                <div class="placement-card-ico @iconClass">
                                    <i class="fa-solid @statusIcon"></i>
                                </div>

                                <div style="flex:1;min-width:0">
                                    <div class="placement-card-title">@exam.Title</div>

                                    <div class="placement-card-meta">
                                        <span class="placement-tag">
                                            <i class="fa-regular fa-calendar"></i>
                                            @exam.AssignedAt.ToString("yyyy/MM/dd")
                                        </span>

                                        <span class="placement-tag">
                                            <i class="fa-solid fa-bullseye"></i>
                                            تحديد مستوى
                                        </span>

                                        <span class="placement-status @statusClass">
                                            @statusText
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="placement-info-box">
                                <div class="placement-info-row">
                                    <span class="placement-info-label">حالة الاختبار</span>
                                    <span class="placement-info-value">@statusText</span>
                                </div>

                                <div class="placement-progress">
                                    <div class="placement-progress-fill @fillClass"></div>
                                </div>
                            </div>

                            <div class="placement-info-box">
                                <div class="placement-info-row">
                                    <span class="placement-info-label">الإجراء المتاح</span>
                                    <span class="placement-info-value">@actionText</span>
                                </div>
                            </div>

                        </div>

                        <div class="placement-card-foot">
                            @if (!exam.IsSubmitted)
                            {
                                <a class="placement-btn btn-start"
                                   asp-action="StartPlacementExam"
                                   asp-route-assignmentId="@exam.ExamAssignmentId">
                                    <i class="fa-solid fa-play"></i>
                                    @(exam.IsInProgress ? "استكمال الاختبار" : "بدء الاختبار")
                                </a>
                            }
                            else
                            {
                                <a class="placement-btn btn-result"
                                   asp-action="ResultPlacementExam"
                                   asp-route-assignmentId="@exam.ExamAssignmentId">
                                    <i class="fa-solid fa-chart-line"></i>
                                    عرض النتيجة
                                </a>

                                <a class="placement-btn btn-report"
                                   asp-action="PlacementReport"
                                   asp-route-assignmentId="@exam.ExamAssignmentId">
                                    <i class="fa-solid fa-file-lines"></i>
                                    التقرير التفصيلي
                                </a>
                            }
                        </div>

                    </div>
                }
            }
        </div>

        <div class="placement-empty" id="placement-empty" style="display:@(total == 0 ? "block" : "none")">
            <div class="placement-empty-ico">📭</div>
            <h3>لا توجد اختبارات تحديد مستوى حتى الآن</h3>
            <p>عند إضافة اختبار تحديد مستوى جديد سيظهر هنا مباشرة.</p>
        </div>

        <!-- STRENGTHS / WEAKNESSES -->
        <div class="placement-analysis-grid">
            <div class="analysis-card">
                <div class="analysis-head green">
                    <i class="fa-solid fa-shield-check"></i>
                    نقاط القوة
                </div>

                <div class="analysis-body">
                    @if (Model.Strengths != null && Model.Strengths.Any())
                    {
                        foreach (var s in Model.Strengths)
                        {
                            <div class="analysis-item strength">
                                <i class="fa-solid fa-check"></i>
                                <span>@s</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="analysis-item strength">
                            <i class="fa-solid fa-info"></i>
                            <span>لم يتم تحديد نقاط قوة بعد.</span>
                        </div>
                    }
                </div>
            </div>

            <div class="analysis-card">
                <div class="analysis-head amber">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    نقاط الضعف
                </div>

                <div class="analysis-body">
                    @if (Model.Weaknesses != null && Model.Weaknesses.Any())
                    {
                        foreach (var w in Model.Weaknesses)
                        {
                            <div class="analysis-item weak">
                                <i class="fa-solid fa-warning"></i>
                                <span>@w.SectionName — الدقة: @w.Accuracy%</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="analysis-item weak">
                            <i class="fa-solid fa-info"></i>
                            <span>لا توجد نقاط ضعف مسجلة حتى الآن.</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- RECOMMENDATION -->
        <div class="recommendation-card">
            <div class="recommendation-icon">
                <i class="fa-solid fa-lightbulb"></i>
            </div>

            <div>
                <h3>توصية ذكية</h3>
                <p>@Model.Recommendation</p>
            </div>
        </div>

    </div>
</div>

<script>
    const placementCards = Array.from(document.querySelectorAll('.placement-card'));
    let currentPlacementFilter = 'all';

    function setPlacementFilter(btn) {
        document.querySelectorAll('.placement-filter-btn').forEach(function (b) {
            b.classList.remove('active');
        });

        btn.classList.add('active');
        currentPlacementFilter = btn.dataset.filter;
        applyPlacementFilters();
    }

    function applyPlacementFilters() {
        const searchInput = document.getElementById('placement-search-input');
        const grid = document.getElementById('placement-grid');
        const countShown = document.getElementById('placement-count-shown');
        const empty = document.getElementById('placement-empty');

        const q = searchInput ? searchInput.value.toLowerCase().trim() : '';

        let visible = placementCards.filter(function (card) {
            const matchFilter = currentPlacementFilter === 'all' || card.dataset.status === currentPlacementFilter;
            const matchSearch = !q || (card.dataset.title || '').indexOf(q) >= 0;

            return matchFilter && matchSearch;
        });

        visible.sort(function (a, b) {
            return (b.dataset.date || '').localeCompare(a.dataset.date || '');
        });

        const visibleSet = new Set(visible);

        placementCards.forEach(function (card) {
            if (visibleSet.has(card)) {
                card.style.display = '';
                grid.appendChild(card);
            } else {
                card.style.display = 'none';
            }
        });

        if (countShown) {
            countShown.textContent = visible.length;
        }

        if (empty) {
            empty.style.display = visible.length ? 'none' : 'block';
        }
    }

    applyPlacementFilters();
</script>