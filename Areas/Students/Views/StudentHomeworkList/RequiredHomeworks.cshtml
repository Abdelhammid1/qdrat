@model List<QdratNew.ViewModels.Homework.HomeworkListVm>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    /* ══ TOKENS ════════════════════════════════════ */
    :root {
        --p: #2e9e9e;
        --p-d: #1d7b7b;
        --p-a: rgba(46,158,158,.12);
        --p-glow: rgba(46,158,158,.3);
        --orange: #e07849;
        --ora: rgba(224,120,73,.12);
        --green: #22c55e;
        --grna: rgba(34,197,94,.12);
        --red: #ef4444;
        --reda: rgba(239,68,68,.12);
        --amber: #f59e0b;
        --ambera: rgba(245,158,11,.12);
        --purple: #8b5cf6;
        --purplea: rgba(139,92,246,.12);
        --ink: #1e293b;
        --ink2: #475569;
        --ink3: #94a3b8;
        --bg: #f0f4f8;
        --card: #ffffff;
        --line: rgba(0,0,0,.07);
        --r: 16px;
        --r-sm: 10px;
        --sh: 0 2px 16px rgba(0,0,0,.07);
        --sh2: 0 8px 32px rgba(0,0,0,.13);
        --ease: .28s cubic-bezier(.4,0,.2,1);
    }

    * {
        box-sizing: border-box;
    }

    .required-page {
        font-family: 'Cairo', sans-serif;
        direction: rtl;
        background: var(--bg);
        min-height: 100vh;
        padding: 0 0 60px;
    }

    /* ══ TOPBAR ════════════════════════════════════ */
    .required-switcher {
        background: linear-gradient(135deg,#0f1f3d 0%,#1a3a5c 100%);
        border-bottom: 1px solid rgba(255,255,255,.06);
        padding: 0 4px;
    }

    /* ══ HERO ══════════════════════════════════════ */
    .required-hero {
        background: linear-gradient(145deg,#0f1f3d 0%,#1a3a5c 55%,#103545 100%);
        padding: 28px 28px 44px;
        margin-bottom: -20px;
        position: relative;
        overflow: hidden;
    }

        .required-hero::before {
            content: '';
            position: absolute;
            width: 360px;
            height: 360px;
            border-radius: 50%;
            background: radial-gradient(circle,rgba(46,158,158,.14) 0%,transparent 65%);
            top: -100px;
            left: -60px;
            pointer-events: none;
        }

        .required-hero::after {
            content: '';
            position: absolute;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: radial-gradient(circle,rgba(224,120,73,.09) 0%,transparent 65%);
            bottom: -80px;
            right: -40px;
            pointer-events: none;
        }

    .required-hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .required-hero-ico {
        width: 52px;
        height: 52px;
        background: rgba(255,255,255,.1);
        border: 1.5px solid rgba(255,255,255,.18);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: #fff;
        backdrop-filter: blur(8px);
        flex-shrink: 0;
    }

    .required-hero-text h1 {
        color: #fff;
        font-size: 1.4rem;
        font-weight: 800;
        margin: 0 0 3px;
    }

    .required-hero-text p {
        color: rgba(255,255,255,.55);
        font-size: .82rem;
        margin: 0;
    }

    .required-search {
        margin-right: auto;
        display: flex;
        align-items: center;
        gap: 0;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 50px;
        overflow: hidden;
        backdrop-filter: blur(8px);
        flex-shrink: 0;
    }

        .required-search input {
            background: transparent;
            border: none;
            outline: none;
            padding: 9px 16px;
            color: #fff;
            font-family: 'Cairo', sans-serif;
            font-size: .85rem;
            min-width: 220px;
        }

            .required-search input::placeholder {
                color: rgba(255,255,255,.45);
            }

    .required-search-ico {
        padding: 0 14px;
        color: rgba(255,255,255,.5);
        font-size: .85rem;
    }

    .required-hero-stats {
        position: relative;
        z-index: 1;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 16px;
    }

    .required-hstat {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 50px;
        padding: 7px 18px;
        color: rgba(255,255,255,.85);
        font-size: .8rem;
        font-weight: 700;
        backdrop-filter: blur(6px);
    }

    .required-hstat-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    /* ══ TOOLBAR ════════════════════════════════════ */
    .required-toolbar {
        background: var(--card);
        border-radius: 0 0 20px 20px;
        border: 1px solid var(--line);
        border-top: none;
        box-shadow: var(--sh);
        padding: 12px 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }

    .required-filter-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 7px 16px;
        border-radius: 50px;
        border: 1.5px solid var(--line);
        background: transparent;
        font-family: 'Cairo', sans-serif;
        font-size: .8rem;
        font-weight: 700;
        color: var(--ink2);
        cursor: pointer;
        white-space: nowrap;
        transition: all var(--ease);
    }

        .required-filter-btn:hover {
            border-color: var(--p);
            color: var(--p);
        }

        .required-filter-btn.active {
            background: var(--p);
            border-color: var(--p);
            color: #fff;
            box-shadow: 0 3px 10px var(--p-glow);
        }

        .required-filter-btn .fbadge {
            background: rgba(255,255,255,.25);
            border-radius: 99px;
            padding: 1px 7px;
            font-size: .72rem;
            font-weight: 800;
        }

        .required-filter-btn:not(.active) .fbadge {
            background: var(--line);
            color: var(--ink2);
        }

    .required-sort {
        margin-right: auto;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .required-sort label {
            font-size: .78rem;
            font-weight: 700;
            color: var(--ink2);
            white-space: nowrap;
        }

        .required-sort select {
            padding: 6px 12px;
            border-radius: 8px;
            border: 1.5px solid var(--line);
            background: var(--card);
            font-family: 'Cairo', sans-serif;
            font-size: .8rem;
            color: var(--ink);
            cursor: pointer;
            outline: none;
            transition: border-color var(--ease);
        }

            .required-sort select:focus {
                border-color: var(--p);
            }

    /* ══ RESULTS LABEL ══════════════════════════════ */
    .required-results-label {
        font-size: .78rem;
        font-weight: 700;
        color: var(--ink3);
        margin: 0 4px 14px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .required-results-label b {
            color: var(--ink);
        }

    /* ══ GRID ═══════════════════════════════════════ */
    .required-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(340px,1fr));
        gap: 16px;
        padding: 0 4px;
    }

    .required-card {
        background: var(--card);
        border-radius: var(--r);
        border: 1px solid var(--line);
        box-shadow: var(--sh);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform var(--ease), box-shadow var(--ease);
        animation: cardIn .4s ease both;
    }

        .required-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--sh2);
        }

    @@keyframes cardIn {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .required-card-stripe {
        height: 3px;
        width: 100%;
    }

    .stripe-pending {
        background: linear-gradient(90deg,var(--amber),#fcd34d);
    }

    .stripe-late {
        background: linear-gradient(90deg,var(--red),#f87171);
    }

    .required-card-body {
        padding: 18px 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .required-card-top {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .required-card-ico {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        margin-top: 2px;
    }

    .ico-pending {
        background: var(--ambera);
        color: var(--amber);
    }

    .ico-late {
        background: var(--reda);
        color: var(--red);
    }

    .required-card-title {
        font-size: .97rem;
        font-weight: 800;
        color: var(--ink);
        line-height: 1.35;
        margin-bottom: 4px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .required-card-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .required-tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #f1f5f9;
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 2px 10px;
        font-size: .7rem;
        font-weight: 700;
        color: var(--ink2);
    }

        .required-tag i {
            font-size: .65rem;
            opacity: .6;
        }

    .required-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 50px;
        padding: 4px 12px;
        font-size: .73rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .st-pending {
        background: var(--ambera);
        color: #92400e;
    }

    .st-late {
        background: var(--reda);
        color: #b91c1c;
    }

    .required-info-box {
        background: #f8fafc;
        border: 1px solid var(--line);
        border-radius: var(--r-sm);
        padding: 12px 14px;
    }

    .required-info-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 8px;
    }

        .required-info-row:last-child {
            margin-bottom: 0;
        }

    .required-info-label {
        font-size: .72rem;
        font-weight: 700;
        color: var(--ink2);
    }

    .required-info-value {
        font-size: .78rem;
        font-weight: 900;
        color: var(--ink);
    }

    .required-progress {
        height: 7px;
        border-radius: 99px;
        background: var(--line);
        overflow: hidden;
        margin-top: 8px;
    }

    .required-progress-fill {
        height: 100%;
        width: 100%;
        border-radius: 99px;
        background: linear-gradient(90deg,var(--amber),#fcd34d);
        opacity: .75;
    }

        .required-progress-fill.late {
            background: linear-gradient(90deg,var(--red),#f87171);
        }

    /* actions */
    .required-card-foot {
        padding: 14px 20px;
        border-top: 1px solid var(--line);
        background: #fafbfc;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .required-btn {
        flex: 1;
        min-width: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 9px 14px;
        border-radius: 10px;
        border: none;
        font-family: 'Cairo', sans-serif;
        font-size: .82rem;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        transition: all var(--ease);
    }

        .required-btn:hover {
            text-decoration: none;
            transform: translateY(-1px);
        }

    .btn-start {
        background: var(--p);
        color: #fff;
        box-shadow: 0 3px 10px var(--p-glow);
    }

        .btn-start:hover {
            background: var(--p-d);
            color: #fff;
        }

    .btn-late {
        background: var(--red);
        color: #fff;
        box-shadow: 0 3px 10px rgba(239,68,68,.24);
    }

        .btn-late:hover {
            background: #dc2626;
            color: #fff;
        }

    /* ══ EMPTY STATE ════════════════════════════════ */
    .required-empty {
        text-align: center;
        padding: 60px 24px;
        background: var(--card);
        border-radius: var(--r);
        border: 1px solid var(--line);
        box-shadow: var(--sh);
    }

    .required-empty-ico {
        font-size: 3.5rem;
        opacity: .25;
        margin-bottom: 16px;
    }

    .required-empty h3 {
        font-size: 1rem;
        font-weight: 800;
        color: var(--ink);
        margin-bottom: 6px;
    }

    .required-empty p {
        font-size: .85rem;
        color: var(--ink2);
    }

    /* ══ ENTRANCE ═══════════════════════════════════ */
    .fu {
        opacity: 0;
        transform: translateY(18px);
        animation: fu .45s ease forwards;
    }

    @@keyframes fu {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .d1 {
        animation-delay: .04s;
    }

    .d2 {
        animation-delay: .1s;
    }

    .d3 {
        animation-delay: .17s;
    }

    /* ══ RESPONSIVE ═════════════════════════════════ */
    @@media(max-width:700px) {
        .required-hero {
            padding: 22px 16px 40px;
        }

        .required-hero-text h1 {
            font-size: 1.15rem;
        }

        .required-search {
            width: 100%;
            margin-right: 0;
        }

            .required-search input {
                min-width: 0;
                flex: 1;
            }

        .required-hero-inner {
            flex-direction: column;
            align-items: flex-start;
        }

        .required-grid {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .required-sort {
            margin-right: 0;
            width: 100%;
        }

        .required-toolbar {
            gap: 6px;
        }

        .required-card-foot {
            padding: 12px 14px;
        }
    }
</style>

@{
    var total = Model?.Count ?? 0;
    var late = Model?.Count(x => x.DelayLevel == "متأخر") ?? 0;
    var pending = Model?.Count(x => x.DelayLevel != "متأخر") ?? 0;

    var todayCount = Model?.Count(x => x.CreatedAt.Date == DateTime.Today) ?? 0;

    var newestDate = Model != null && Model.Any()
        ? Model.Max(x => x.CreatedAt)
        : (DateTime?)null;
}

<div class="required-switcher">
    @await Component.InvokeAsync("StudentCourseSwitcher")
</div>

<div class="required-page">

    <!-- ══ HERO ══ -->
    <div class="required-hero fu">
        <div class="required-hero-inner">
            <div class="required-hero-ico">
                <i class="fa-solid fa-list-check"></i>
            </div>

            <div class="required-hero-text">
                <h1>الواجبات المطلوبة</h1>
                <p>ابدأ حل الواجبات المتاحة لك الآن وتابع التزاماتك أولًا بأول</p>
            </div>

            <div class="required-search">
                <span class="required-search-ico">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <input type="text"
                       id="required-search-input"
                       placeholder="ابحث عن واجب مطلوب…"
                       oninput="applyRequiredFilters()">
            </div>
        </div>

        <div class="required-hero-stats">
            <span class="required-hstat">
                <span class="required-hstat-dot" style="background:#2e9e9e"></span>
                الإجمالي: @total
            </span>

            <span class="required-hstat">
                <span class="required-hstat-dot" style="background:#f59e0b"></span>
                المطلوب حلها: @pending
            </span>

            <span class="required-hstat">
                <span class="required-hstat-dot" style="background:#ef4444"></span>
                المتأخرة: @late
            </span>

            <span class="required-hstat">
                <span class="required-hstat-dot" style="background:#8b5cf6"></span>
                مضافة اليوم: @todayCount
            </span>

            @if (newestDate.HasValue)
            {
                <span class="required-hstat">
                    <span class="required-hstat-dot" style="background:#e07849"></span>
                    آخر واجب: @newestDate.Value.ToString("yyyy/MM/dd")
                </span>
            }
        </div>
    </div>

    <!-- ══ TOOLBAR ══ -->
    <div class="required-toolbar fu d1">
        <button type="button"
                class="required-filter-btn active"
                data-filter="all"
                onclick="setRequiredFilter(this)">
            <i class="fa-solid fa-layer-group" style="font-size:.75rem"></i>
            الكل <span class="fbadge">@total</span>
        </button>

        <button type="button"
                class="required-filter-btn"
                data-filter="pending"
                onclick="setRequiredFilter(this)">
            <i class="fa-solid fa-clock" style="font-size:.75rem"></i>
            مطلوب <span class="fbadge">@pending</span>
        </button>

        <button type="button"
                class="required-filter-btn"
                data-filter="late"
                onclick="setRequiredFilter(this)">
            <i class="fa-solid fa-triangle-exclamation" style="font-size:.75rem"></i>
            متأخر <span class="fbadge">@late</span>
        </button>

        <div class="required-sort">
            <label for="required-sort-sel">
                <i class="fa-solid fa-arrow-up-wide-short" style="font-size:.75rem"></i>
                ترتيب:
            </label>

            <select id="required-sort-sel" onchange="applyRequiredFilters()">
                <option value="date-desc">الأحدث أولاً</option>
                <option value="date-asc">الأقدم أولاً</option>
                <option value="status-late">المتأخر أولاً</option>
                <option value="title-asc">الاسم تصاعديًا</option>
            </select>
        </div>
    </div>

    <!-- ══ BODY ══ -->
    <div style="padding:0 20px">

        <div class="required-results-label fu d2" id="required-results-label">
            يُعرض <b id="required-count-shown">@total</b> من إجمالي @total واجب مطلوب
        </div>

        <div class="required-grid" id="required-grid">

            @if (Model != null && Model.Any())
            {
                foreach (var hw in Model)
                {
                    var isLate = hw.DelayLevel == "متأخر";
                    var status = isLate ? "late" : "pending";

                    var stripeClass = isLate ? "stripe-late" : "stripe-pending";
                    var icoClass = isLate ? "ico-late" : "ico-pending";
                    var icon = isLate ? "fa-triangle-exclamation" : "fa-list-check";
                    var statusClass = isLate ? "st-late" : "st-pending";
                    var statusText = isLate ? "متأخر" : "مطلوب";
                    var buttonClass = isLate ? "btn-late" : "btn-start";

                    <div class="required-card"
                         data-status="@status"
                         data-title="@((hw.Title ?? string.Empty).ToLower())"
                         data-date="@hw.CreatedAt.ToString("yyyyMMdd")">

                        <div class="required-card-stripe @stripeClass"></div>

                        <div class="required-card-body">

                            <div class="required-card-top">
                                <div class="required-card-ico @icoClass">
                                    <i class="fa-solid @icon"></i>
                                </div>

                                <div style="flex:1;min-width:0">
                                    <div class="required-card-title">@hw.Title</div>

                                    <div class="required-card-meta">
                                        <span class="required-tag">
                                            <i class="fa-regular fa-calendar"></i>
                                            @hw.CreatedAt.ToString("yyyy/MM/dd")
                                        </span>

                                        @if (!string.IsNullOrWhiteSpace(hw.SectionName))
                                        {
                                            <span class="required-tag">
                                                <i class="fa-solid fa-folder"></i>
                                                @hw.SectionName
                                            </span>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(hw.SectionNames))
                                        {
                                            <span class="required-tag">
                                                <i class="fa-solid fa-folder"></i>
                                                @hw.SectionNames
                                            </span>
                                        }

                                        <span class="required-status @statusClass">
                                            @statusText
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="required-info-box">
                                <div class="required-info-row">
                                    <span class="required-info-label">حالة الواجب</span>
                                    <span class="required-info-value">@statusText</span>
                                </div>

                                <div class="required-info-row">
                                    <span class="required-info-label">الإجراء المطلوب</span>
                                    <span class="required-info-value">بدء الحل وتسليم الواجب</span>
                                </div>

                                <div class="required-progress">
                                    <div class="required-progress-fill @(isLate ? "late" : "")"></div>
                                </div>
                            </div>

                        </div>

                        <div class="required-card-foot">
                            <a asp-action="Start"
                               asp-controller="StudentHomeworkFlow"
                               asp-route-homeworkSetId="@hw.HomeworkSetId"
                               class="required-btn @buttonClass">
                                <i class="fa-solid fa-play"></i>
                                بدء الحل
                            </a>
                        </div>

                    </div>
                }
            }

        </div>

        <div class="required-empty" id="required-empty" style="display:@(total == 0 ? "block" : "none")">
            <div class="required-empty-ico">🎉</div>
            <h3>لا توجد واجبات مطلوبة حاليًا</h3>
            <p>أنت لا تملك واجبات معلقة الآن. عند إرسال واجب جديد سيظهر هنا مباشرة.</p>
        </div>

    </div>
</div>

<script>
    /* ═══ DATA ═══════════════════════════════════════ */
    const requiredCards = Array.from(document.querySelectorAll('.required-card'));
    let currentRequiredFilter = 'all';

    /* ═══ FILTER BUTTONS ════════════════════════════ */
    function setRequiredFilter(btn) {
        document.querySelectorAll('.required-filter-btn').forEach(function (b) {
            b.classList.remove('active');
        });

        btn.classList.add('active');
        currentRequiredFilter = btn.dataset.filter;
        applyRequiredFilters();
    }

    /* ═══ SEARCH + SORT + FILTER ═══════════════════ */
    function applyRequiredFilters() {
        const searchInput = document.getElementById('required-search-input');
        const sortSelect = document.getElementById('required-sort-sel');
        const grid = document.getElementById('required-grid');
        const countShown = document.getElementById('required-count-shown');
        const empty = document.getElementById('required-empty');

        const q = searchInput ? searchInput.value.toLowerCase().trim() : '';
        const sort = sortSelect ? sortSelect.value : 'date-desc';

        let visible = requiredCards.filter(function (card) {
            const matchFilter = currentRequiredFilter === 'all' || card.dataset.status === currentRequiredFilter;
            const matchSearch = !q || (card.dataset.title || '').includes(q);

            return matchFilter && matchSearch;
        });

        visible.sort(function (a, b) {
            if (sort === 'date-desc') {
                return (b.dataset.date || '').localeCompare(a.dataset.date || '');
            }

            if (sort === 'date-asc') {
                return (a.dataset.date || '').localeCompare(b.dataset.date || '');
            }

            if (sort === 'status-late') {
                const aLate = a.dataset.status === 'late' ? 1 : 0;
                const bLate = b.dataset.status === 'late' ? 1 : 0;

                if (bLate !== aLate) {
                    return bLate - aLate;
                }

                return (b.dataset.date || '').localeCompare(a.dataset.date || '');
            }

            if (sort === 'title-asc') {
                return (a.dataset.title || '').localeCompare(b.dataset.title || '', 'ar');
            }

            return 0;
        });

        const visibleSet = new Set(visible);

        requiredCards.forEach(function (card) {
            if (visibleSet.has(card)) {
                card.style.display = '';
                grid.appendChild(card);
            } else {
                card.style.display = 'none';
            }
        });

        if (countShown) {
            countShown.textContent = visible.length;
        }

        if (empty) {
            empty.style.display = visible.length ? 'none' : 'block';
        }
    }

    /* ═══ INIT ══════════════════════════════════════ */
    applyRequiredFilters();
</script>