@model List<QdratNew.ViewModels.Homework.HomeworkListVm>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    /* ══ TOKENS ════════════════════════════════════ */
    :root {
        --p: #2e9e9e;
        --p-d: #1d7b7b;
        --p-a: rgba(46,158,158,.12);
        --p-glow: rgba(46,158,158,.3);
        --orange: #e07849;
        --ora: rgba(224,120,73,.12);
        --green: #22c55e;
        --grna: rgba(34,197,94,.12);
        --red: #ef4444;
        --reda: rgba(239,68,68,.12);
        --amber: #f59e0b;
        --ambera: rgba(245,158,11,.12);
        --purple: #8b5cf6;
        --purplea: rgba(139,92,246,.12);
        --ink: #1e293b;
        --ink2: #475569;
        --ink3: #94a3b8;
        --bg: #f0f4f8;
        --card: #ffffff;
        --line: rgba(0,0,0,.07);
        --r: 16px;
        --r-sm: 10px;
        --sh: 0 2px 16px rgba(0,0,0,.07);
        --sh2: 0 8px 32px rgba(0,0,0,.13);
        --ease: .28s cubic-bezier(.4,0,.2,1);
    }

    * {
        box-sizing: border-box;
    }

    .solved-page {
        font-family: 'Cairo', sans-serif;
        direction: rtl;
        background: var(--bg);
        min-height: 100vh;
        padding: 0 0 60px;
    }

    /* ══ TOPBAR ════════════════════════════════════ */
    .solved-switcher {
        background: linear-gradient(135deg,#0f1f3d 0%,#1a3a5c 100%);
        border-bottom: 1px solid rgba(255,255,255,.06);
        padding: 0 4px;
    }

    /* ══ HERO ══════════════════════════════════════ */
    .solved-hero {
        background: linear-gradient(145deg,#0f1f3d 0%,#1a3a5c 55%,#103545 100%);
        padding: 28px 28px 44px;
        margin-bottom: -20px;
        position: relative;
        overflow: hidden;
    }

        .solved-hero::before {
            content: '';
            position: absolute;
            width: 360px;
            height: 360px;
            border-radius: 50%;
            background: radial-gradient(circle,rgba(46,158,158,.14) 0%,transparent 65%);
            top: -100px;
            left: -60px;
            pointer-events: none;
        }

        .solved-hero::after {
            content: '';
            position: absolute;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: radial-gradient(circle,rgba(224,120,73,.09) 0%,transparent 65%);
            bottom: -80px;
            right: -40px;
            pointer-events: none;
        }

    .solved-hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .solved-hero-ico {
        width: 52px;
        height: 52px;
        background: rgba(255,255,255,.1);
        border: 1.5px solid rgba(255,255,255,.18);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: #fff;
        backdrop-filter: blur(8px);
        flex-shrink: 0;
    }

    .solved-hero-text h1 {
        color: #fff;
        font-size: 1.4rem;
        font-weight: 800;
        margin: 0 0 3px;
    }

    .solved-hero-text p {
        color: rgba(255,255,255,.55);
        font-size: .82rem;
        margin: 0;
    }

    .solved-search {
        margin-right: auto;
        display: flex;
        align-items: center;
        gap: 0;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 50px;
        overflow: hidden;
        backdrop-filter: blur(8px);
        flex-shrink: 0;
    }

        .solved-search input {
            background: transparent;
            border: none;
            outline: none;
            padding: 9px 16px;
            color: #fff;
            font-family: 'Cairo', sans-serif;
            font-size: .85rem;
            min-width: 220px;
        }

            .solved-search input::placeholder {
                color: rgba(255,255,255,.45);
            }

    .solved-search-ico {
        padding: 0 14px;
        color: rgba(255,255,255,.5);
        font-size: .85rem;
    }

    .solved-hero-stats {
        position: relative;
        z-index: 1;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 16px;
    }

    .solved-hstat {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 50px;
        padding: 7px 18px;
        color: rgba(255,255,255,.85);
        font-size: .8rem;
        font-weight: 700;
        backdrop-filter: blur(6px);
    }

    .solved-hstat-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    /* ══ TOOLBAR ════════════════════════════════════ */
    .solved-toolbar {
        background: var(--card);
        border-radius: 0 0 20px 20px;
        border: 1px solid var(--line);
        border-top: none;
        box-shadow: var(--sh);
        padding: 12px 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }

    .solved-filter-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 7px 16px;
        border-radius: 50px;
        border: 1.5px solid var(--line);
        background: transparent;
        font-family: 'Cairo', sans-serif;
        font-size: .8rem;
        font-weight: 700;
        color: var(--ink2);
        cursor: pointer;
        white-space: nowrap;
        transition: all var(--ease);
    }

        .solved-filter-btn:hover {
            border-color: var(--p);
            color: var(--p);
        }

        .solved-filter-btn.active {
            background: var(--p);
            border-color: var(--p);
            color: #fff;
            box-shadow: 0 3px 10px var(--p-glow);
        }

        .solved-filter-btn .fbadge {
            background: rgba(255,255,255,.25);
            border-radius: 99px;
            padding: 1px 7px;
            font-size: .72rem;
            font-weight: 800;
        }

        .solved-filter-btn:not(.active) .fbadge {
            background: var(--line);
            color: var(--ink2);
        }

    .solved-sort {
        margin-right: auto;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .solved-sort label {
            font-size: .78rem;
            font-weight: 700;
            color: var(--ink2);
            white-space: nowrap;
        }

        .solved-sort select {
            padding: 6px 12px;
            border-radius: 8px;
            border: 1.5px solid var(--line);
            background: var(--card);
            font-family: 'Cairo', sans-serif;
            font-size: .8rem;
            color: var(--ink);
            cursor: pointer;
            outline: none;
            transition: border-color var(--ease);
        }

            .solved-sort select:focus {
                border-color: var(--p);
            }

    /* ══ RESULTS LABEL ══════════════════════════════ */
    .solved-results-label {
        font-size: .78rem;
        font-weight: 700;
        color: var(--ink3);
        margin: 0 4px 14px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .solved-results-label b {
            color: var(--ink);
        }

    /* ══ CARD GRID ══════════════════════════════════ */
    .solved-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(340px,1fr));
        gap: 16px;
        padding: 0 4px;
    }

    .solved-card {
        background: var(--card);
        border-radius: var(--r);
        border: 1px solid var(--line);
        box-shadow: var(--sh);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform var(--ease), box-shadow var(--ease);
        animation: cardIn .4s ease both;
    }

        .solved-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--sh2);
        }

    @@keyframes cardIn {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .solved-card-stripe {
        height: 3px;
        width: 100%;
    }

    .stripe-excellent {
        background: linear-gradient(90deg,var(--green),#4ade80);
    }

    .stripe-good {
        background: linear-gradient(90deg,var(--amber),#fcd34d);
    }

    .stripe-weak {
        background: linear-gradient(90deg,var(--red),#f87171);
    }

    .solved-card-body {
        padding: 18px 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .solved-card-top {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .solved-card-ico {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        margin-top: 2px;
    }

    .ico-excellent {
        background: var(--grna);
        color: var(--green);
    }

    .ico-good {
        background: var(--ambera);
        color: var(--amber);
    }

    .ico-weak {
        background: var(--reda);
        color: var(--red);
    }

    .solved-card-title {
        font-size: .97rem;
        font-weight: 800;
        color: var(--ink);
        line-height: 1.35;
        margin-bottom: 4px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .solved-card-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .solved-tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #f1f5f9;
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 2px 10px;
        font-size: .7rem;
        font-weight: 700;
        color: var(--ink2);
    }

        .solved-tag i {
            font-size: .65rem;
            opacity: .6;
        }

    .solved-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 50px;
        padding: 4px 12px;
        font-size: .73rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .st-excellent {
        background: var(--grna);
        color: #15803d;
    }

    .st-good {
        background: var(--ambera);
        color: #92400e;
    }

    .st-weak {
        background: var(--reda);
        color: #b91c1c;
    }

    /* score section */
    .solved-card-score {
        background: #f8fafc;
        border: 1px solid var(--line);
        border-radius: var(--r-sm);
        padding: 12px 14px;
    }

    .solved-score-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 6px;
    }

    .solved-score-lbl {
        font-size: .72rem;
        font-weight: 700;
        color: var(--ink2);
    }

    .solved-score-val {
        font-size: .85rem;
        font-weight: 900;
    }

    .solved-dual-bar {
        height: 7px;
        border-radius: 99px;
        background: var(--line);
        overflow: hidden;
        position: relative;
        margin-bottom: 4px;
    }

    .solved-dual-bar-fill {
        height: 100%;
        border-radius: 99px;
        transition: width 1s cubic-bezier(.4,0,.2,1);
    }

    .fill-student {
        background: linear-gradient(90deg,var(--p),#4ecdc4);
    }

    .fill-batch {
        background: linear-gradient(90deg,var(--orange),#f0a07a);
    }

    .solved-score-legend {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .solved-score-leg {
        font-size: .65rem;
        font-weight: 700;
        color: var(--ink3);
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .solved-score-leg-dot {
        width: 8px;
        height: 8px;
        border-radius: 2px;
    }

    /* actions */
    .solved-card-foot {
        padding: 14px 20px;
        border-top: 1px solid var(--line);
        background: #fafbfc;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .solved-btn {
        flex: 1;
        min-width: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 9px 14px;
        border-radius: 10px;
        border: none;
        font-family: 'Cairo', sans-serif;
        font-size: .82rem;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        transition: all var(--ease);
    }

        .solved-btn:hover {
            text-decoration: none;
            transform: translateY(-1px);
        }

    .btn-review {
        background: var(--grna);
        color: #15803d;
        border: 1px solid rgba(34,197,94,.2);
    }

        .btn-review:hover {
            background: rgba(34,197,94,.2);
            color: #15803d;
        }

    .btn-report {
        background: var(--p-a);
        color: var(--p-d);
        border: 1px solid rgba(46,158,158,.2);
    }

        .btn-report:hover {
            background: rgba(46,158,158,.2);
            color: var(--p-d);
        }

    /* ══ EMPTY STATE ════════════════════════════════ */
    .solved-empty {
        text-align: center;
        padding: 60px 24px;
        background: var(--card);
        border-radius: var(--r);
        border: 1px solid var(--line);
        box-shadow: var(--sh);
    }

    .solved-empty-ico {
        font-size: 3.5rem;
        opacity: .25;
        margin-bottom: 16px;
    }

    .solved-empty h3 {
        font-size: 1rem;
        font-weight: 800;
        color: var(--ink);
        margin-bottom: 6px;
    }

    .solved-empty p {
        font-size: .85rem;
        color: var(--ink2);
    }

    /* ══ ENTRANCE ═══════════════════════════════════ */
    .fu {
        opacity: 0;
        transform: translateY(18px);
        animation: fu .45s ease forwards;
    }

    @@keyframes fu {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .d1 {
        animation-delay: .04s;
    }

    .d2 {
        animation-delay: .1s;
    }

    .d3 {
        animation-delay: .17s;
    }

    /* ══ RESPONSIVE ═════════════════════════════════ */
    @@media(max-width:700px) {
        .solved-hero {
            padding: 22px 16px 40px;
        }

        .solved-hero-text h1 {
            font-size: 1.15rem;
        }

        .solved-search {
            width: 100%;
            margin-right: 0;
        }

            .solved-search input {
                min-width: 0;
                flex: 1;
            }

        .solved-hero-inner {
            flex-direction: column;
            align-items: flex-start;
        }

        .solved-grid {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .solved-sort {
            margin-right: 0;
            width: 100%;
        }

        .solved-toolbar {
            gap: 6px;
        }
    }
</style>

@{
    var total = Model?.Count ?? 0;

    var excellent = Model?.Count(x => x.Score >= 80) ?? 0;
    var good = Model?.Count(x => x.Score >= 60 && x.Score < 80) ?? 0;
    var weak = Model?.Count(x => x.Score < 60) ?? 0;

    var averageScore = Model != null && Model.Any()
        ? Model.Select(x => x.Score).DefaultIfEmpty(0).Average()
        : 0;

    var highestScore = Model != null && Model.Any()
        ? Model.Select(x => x.Score).DefaultIfEmpty(0).Max()
        : 0;
}

<div class="solved-switcher">
    @await Component.InvokeAsync("StudentCourseSwitcher")
</div>

<div class="solved-page">

    <!-- ══ HERO ══ -->
    <div class="solved-hero fu">
        <div class="solved-hero-inner">
            <div class="solved-hero-ico">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div class="solved-hero-text">
                <h1>الواجبات المحلولة</h1>
                <p>راجع واجباتك السابقة، قارن درجتك بمتوسط الدفعة، وتابع تطور أدائك</p>
            </div>

            <div class="solved-search">
                <span class="solved-search-ico">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <input type="text"
                       id="solved-search-input"
                       placeholder="ابحث عن واجب محلول…"
                       oninput="applySolvedFilters()">
            </div>
        </div>

        <div class="solved-hero-stats">
            <span class="solved-hstat">
                <span class="solved-hstat-dot" style="background:#2e9e9e"></span>
                الإجمالي: @total
            </span>

            <span class="solved-hstat">
                <span class="solved-hstat-dot" style="background:#22c55e"></span>
                ممتاز: @excellent
            </span>

            <span class="solved-hstat">
                <span class="solved-hstat-dot" style="background:#f59e0b"></span>
                جيد / متوسط: @good
            </span>

            <span class="solved-hstat">
                <span class="solved-hstat-dot" style="background:#ef4444"></span>
                يحتاج تحسين: @weak
            </span>

            @if (total > 0)
            {
                <span class="solved-hstat">
                    <span class="solved-hstat-dot" style="background:#8b5cf6"></span>
                    متوسط درجاتك: @averageScore.ToString("F1")%
                </span>

                <span class="solved-hstat">
                    <span class="solved-hstat-dot" style="background:#e07849"></span>
                    أعلى درجة: @highestScore.ToString("F1")%
                </span>
            }
        </div>
    </div>

    <!-- ══ TOOLBAR ══ -->
    <div class="solved-toolbar fu d1">
        <button type="button"
                class="solved-filter-btn active"
                data-filter="all"
                onclick="setSolvedFilter(this)">
            <i class="fa-solid fa-layer-group" style="font-size:.75rem"></i>
            الكل <span class="fbadge">@total</span>
        </button>

        <button type="button"
                class="solved-filter-btn"
                data-filter="excellent"
                onclick="setSolvedFilter(this)">
            <i class="fa-solid fa-trophy" style="font-size:.75rem"></i>
            ممتاز <span class="fbadge">@excellent</span>
        </button>

        <button type="button"
                class="solved-filter-btn"
                data-filter="good"
                onclick="setSolvedFilter(this)">
            <i class="fa-solid fa-chart-line" style="font-size:.75rem"></i>
            جيد / متوسط <span class="fbadge">@good</span>
        </button>

        <button type="button"
                class="solved-filter-btn"
                data-filter="weak"
                onclick="setSolvedFilter(this)">
            <i class="fa-solid fa-arrow-trend-down" style="font-size:.75rem"></i>
            يحتاج تحسين <span class="fbadge">@weak</span>
        </button>

        <div class="solved-sort">
            <label for="solved-sort-sel">
                <i class="fa-solid fa-arrow-up-wide-short" style="font-size:.75rem"></i>
                ترتيب:
            </label>

            <select id="solved-sort-sel" onchange="applySolvedFilters()">
                <option value="date-desc">الأحدث أولاً</option>
                <option value="date-asc">الأقدم أولاً</option>
                <option value="score-desc">الأعلى درجة</option>
                <option value="score-asc">الأدنى درجة</option>
                <option value="title-asc">الاسم تصاعديًا</option>
            </select>
        </div>
    </div>

    <!-- ══ BODY ══ -->
    <div style="padding:0 20px">

        <div class="solved-results-label fu d2" id="solved-results-label">
            يُعرض <b id="solved-count-shown">@total</b> من إجمالي @total واجب محلول
        </div>

        <div class="solved-grid" id="solved-grid">

            @if (Model != null && Model.Any())
            {
                foreach (var hw in Model)
                {
                    var score = hw.Score;
                    var batchScore = hw.BatchAverageScore;

                    var scoreW = (int)Math.Round(score);
                    var batchW = (int)Math.Round(batchScore);

                    scoreW = scoreW < 0 ? 0 : scoreW > 100 ? 100 : scoreW;
                    batchW = batchW < 0 ? 0 : batchW > 100 ? 100 : batchW;

                    var level = score >= 80 ? "excellent" : score >= 60 ? "good" : "weak";

                    var stripeClass = level == "excellent"
                    ? "stripe-excellent"
                    : level == "good"
                    ? "stripe-good"
                    : "stripe-weak";

                    var icoClass = level == "excellent"
                    ? "ico-excellent"
                    : level == "good"
                    ? "ico-good"
                    : "ico-weak";

                    var statusClass = level == "excellent"
                    ? "st-excellent"
                    : level == "good"
                    ? "st-good"
                    : "st-weak";

                    var statusText = level == "excellent"
                    ? "ممتاز"
                    : level == "good"
                    ? "جيد / متوسط"
                    : "يحتاج تحسين";

                    var scoreColor = score >= 80
                    ? "#22c55e"
                    : score >= 60
                    ? "#f59e0b"
                    : "#ef4444";

                    <div class="solved-card"
                         data-level="@level"
                         data-title="@((hw.Title ?? string.Empty).ToLower())"
                         data-score="@score"
                         data-date="@hw.CreatedAt.ToString("yyyyMMdd")">

                        <div class="solved-card-stripe @stripeClass"></div>

                        <div class="solved-card-body">

                            <div class="solved-card-top">
                                <div class="solved-card-ico @icoClass">
                                    <i class="fa-solid fa-circle-check"></i>
                                </div>

                                <div style="flex:1;min-width:0">
                                    <div class="solved-card-title">@hw.Title</div>

                                    <div class="solved-card-meta">
                                        <span class="solved-tag">
                                            <i class="fa-regular fa-calendar"></i>
                                            @hw.CreatedAt.ToString("yyyy/MM/dd")
                                        </span>

                                        @if (!string.IsNullOrWhiteSpace(hw.SectionName))
                                        {
                                            <span class="solved-tag">
                                                <i class="fa-solid fa-folder"></i>
                                                @hw.SectionName
                                            </span>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(hw.SectionNames))
                                        {
                                            <span class="solved-tag">
                                                <i class="fa-solid fa-folder"></i>
                                                @hw.SectionNames
                                            </span>
                                        }

                                        <span class="solved-status @statusClass">
                                            @statusText
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="solved-card-score">
                                <div class="solved-score-row">
                                    <span class="solved-score-lbl">درجتك</span>
                                    <span class="solved-score-val" style="color:@scoreColor">
                                        @score.ToString("F1")%
                                    </span>
                                </div>

                                <div class="solved-dual-bar">
                                    <div class="solved-dual-bar-fill fill-student" style="width:@scoreW%"></div>
                                </div>

                                <div class="solved-score-row" style="margin-top:6px">
                                    <span class="solved-score-lbl">متوسط الدفعة</span>
                                    <span class="solved-score-val" style="color:var(--orange)">
                                        @batchScore.ToString("F1")%
                                    </span>
                                </div>

                                <div class="solved-dual-bar">
                                    <div class="solved-dual-bar-fill fill-batch" style="width:@batchW%"></div>
                                </div>

                                <div class="solved-score-legend">
                                    <span class="solved-score-leg">
                                        <span class="solved-score-leg-dot" style="background:var(--p)"></span>
                                        درجتك
                                    </span>

                                    <span class="solved-score-leg">
                                        <span class="solved-score-leg-dot" style="background:var(--orange)"></span>
                                        متوسط الدفعة
                                    </span>
                                </div>
                            </div>

                        </div>

                        <div class="solved-card-foot">
                            <a asp-action="Review"
                               asp-controller="StudentHomeworkResults"
                               asp-route-homeworkSetId="@hw.HomeworkSetId"
                               class="solved-btn btn-review">
                                <i class="fa-solid fa-eye"></i>
                                مراجعة
                            </a>

                            <a asp-action="HomeworkReportUnified"
                               asp-controller="StudentHomeworkResults"
                               asp-route-homeworkSetId="@hw.HomeworkSetId"
                               class="solved-btn btn-report">
                                <i class="fa-solid fa-file-lines"></i>
                                تقرير
                            </a>
                        </div>

                    </div>
                }
            }

        </div>

        <div class="solved-empty" id="solved-empty" style="display:@(total == 0 ? "block" : "none")">
            <div class="solved-empty-ico">✅</div>
            <h3>لا توجد واجبات محلولة حتى الآن</h3>
            <p>بعد تسليم الواجبات ستظهر هنا للمراجعة وفتح التقرير التفصيلي.</p>
        </div>

    </div>
</div>

<script>
    /* ═══ DATA ═══════════════════════════════════════ */
    const solvedCards = Array.from(document.querySelectorAll('.solved-card'));
    let currentSolvedFilter = 'all';

    /* ═══ FILTER BUTTONS ════════════════════════════ */
    function setSolvedFilter(btn) {
        document.querySelectorAll('.solved-filter-btn').forEach(function (b) {
            b.classList.remove('active');
        });

        btn.classList.add('active');
        currentSolvedFilter = btn.dataset.filter;
        applySolvedFilters();
    }

    /* ═══ SEARCH + SORT + FILTER ═══════════════════ */
    function applySolvedFilters() {
        const searchInput = document.getElementById('solved-search-input');
        const sortSelect = document.getElementById('solved-sort-sel');
        const grid = document.getElementById('solved-grid');
        const countShown = document.getElementById('solved-count-shown');
        const empty = document.getElementById('solved-empty');

        const q = searchInput ? searchInput.value.toLowerCase().trim() : '';
        const sort = sortSelect ? sortSelect.value : 'date-desc';

        let visible = solvedCards.filter(function (card) {
            const matchFilter = currentSolvedFilter === 'all' || card.dataset.level === currentSolvedFilter;
            const matchSearch = !q || (card.dataset.title || '').includes(q);

            return matchFilter && matchSearch;
        });

        visible.sort(function (a, b) {
            if (sort === 'date-desc') {
                return (b.dataset.date || '').localeCompare(a.dataset.date || '');
            }

            if (sort === 'date-asc') {
                return (a.dataset.date || '').localeCompare(b.dataset.date || '');
            }

            if (sort === 'score-desc') {
                return (+b.dataset.score || 0) - (+a.dataset.score || 0);
            }

            if (sort === 'score-asc') {
                return (+a.dataset.score || 0) - (+b.dataset.score || 0);
            }

            if (sort === 'title-asc') {
                return (a.dataset.title || '').localeCompare(b.dataset.title || '', 'ar');
            }

            return 0;
        });

        const visibleSet = new Set(visible);

        solvedCards.forEach(function (card) {
            if (visibleSet.has(card)) {
                card.style.display = '';
                grid.appendChild(card);
            } else {
                card.style.display = 'none';
            }
        });

        if (countShown) {
            countShown.textContent = visible.length;
        }

        if (empty) {
            empty.style.display = visible.length ? 'none' : 'block';
        }
    }

    /* ═══ ANIMATE bars on load ══════════════════════ */
    (function () {
        document.querySelectorAll('.solved-dual-bar-fill').forEach(function (el) {
            const target = el.style.width;
            el.style.width = '0';

            requestAnimationFrame(function () {
                requestAnimationFrame(function () {
                    el.style.width = target;
                });
            });
        });
    })();
</script>