@model List<QdratNew.ViewModels.Homework.HomeworkListVm>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    /* ══ TOKENS ════════════════════════════════════ */
    :root {
        --p: #2e9e9e;
        --p-d: #1d7b7b;
        --p-a: rgba(46,158,158,.12);
        --p-glow: rgba(46,158,158,.3);
        --orange: #e07849;
        --ora: rgba(224,120,73,.12);
        --green: #22c55e;
        --grna: rgba(34,197,94,.12);
        --red: #ef4444;
        --red-d: #dc2626;
        --reda: rgba(239,68,68,.12);
        --amber: #f59e0b;
        --ambera: rgba(245,158,11,.12);
        --purple: #8b5cf6;
        --purplea: rgba(139,92,246,.12);
        --ink: #1e293b;
        --ink2: #475569;
        --ink3: #94a3b8;
        --bg: #f0f4f8;
        --card: #ffffff;
        --line: rgba(0,0,0,.07);
        --r: 16px;
        --r-sm: 10px;
        --sh: 0 2px 16px rgba(0,0,0,.07);
        --sh2: 0 8px 32px rgba(0,0,0,.13);
        --ease: .28s cubic-bezier(.4,0,.2,1);
    }

    * {
        box-sizing: border-box;
    }

    .late-page {
        font-family: 'Cairo', sans-serif;
        direction: rtl;
        background: var(--bg);
        min-height: 100vh;
        padding: 0 0 60px;
    }

    /* ══ TOPBAR ════════════════════════════════════ */
    .late-switcher {
        background: linear-gradient(135deg,#0f1f3d 0%,#1a3a5c 100%);
        border-bottom: 1px solid rgba(255,255,255,.06);
        padding: 0 4px;
    }

    /* ══ HERO ══════════════════════════════════════ */
    .late-hero {
        background: linear-gradient(145deg,#3d0f18 0%,#5c1a24 48%,#1a3a5c 100%);
        padding: 28px 28px 44px;
        margin-bottom: -20px;
        position: relative;
        overflow: hidden;
    }

        .late-hero::before {
            content: '';
            position: absolute;
            width: 360px;
            height: 360px;
            border-radius: 50%;
            background: radial-gradient(circle,rgba(239,68,68,.18) 0%,transparent 65%);
            top: -100px;
            left: -60px;
            pointer-events: none;
        }

        .late-hero::after {
            content: '';
            position: absolute;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: radial-gradient(circle,rgba(245,158,11,.13) 0%,transparent 65%);
            bottom: -80px;
            right: -40px;
            pointer-events: none;
        }

    .late-hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .late-hero-ico {
        width: 52px;
        height: 52px;
        background: rgba(255,255,255,.1);
        border: 1.5px solid rgba(255,255,255,.18);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: #fff;
        backdrop-filter: blur(8px);
        flex-shrink: 0;
    }

    .late-hero-text h1 {
        color: #fff;
        font-size: 1.4rem;
        font-weight: 800;
        margin: 0 0 3px;
    }

    .late-hero-text p {
        color: rgba(255,255,255,.6);
        font-size: .82rem;
        margin: 0;
    }

    .late-search {
        margin-right: auto;
        display: flex;
        align-items: center;
        gap: 0;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 50px;
        overflow: hidden;
        backdrop-filter: blur(8px);
        flex-shrink: 0;
    }

        .late-search input {
            background: transparent;
            border: none;
            outline: none;
            padding: 9px 16px;
            color: #fff;
            font-family: 'Cairo', sans-serif;
            font-size: .85rem;
            min-width: 220px;
        }

            .late-search input::placeholder {
                color: rgba(255,255,255,.45);
            }

    .late-search-ico {
        padding: 0 14px;
        color: rgba(255,255,255,.5);
        font-size: .85rem;
    }

    .late-hero-stats {
        position: relative;
        z-index: 1;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 16px;
    }

    .late-hstat {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 50px;
        padding: 7px 18px;
        color: rgba(255,255,255,.88);
        font-size: .8rem;
        font-weight: 700;
        backdrop-filter: blur(6px);
    }

    .late-hstat-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    /* ══ TOOLBAR ════════════════════════════════════ */
    .late-toolbar {
        background: var(--card);
        border-radius: 0 0 20px 20px;
        border: 1px solid var(--line);
        border-top: none;
        box-shadow: var(--sh);
        padding: 12px 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }

    .late-filter-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 7px 16px;
        border-radius: 50px;
        border: 1.5px solid var(--line);
        background: transparent;
        font-family: 'Cairo', sans-serif;
        font-size: .8rem;
        font-weight: 700;
        color: var(--ink2);
        cursor: pointer;
        white-space: nowrap;
        transition: all var(--ease);
    }

        .late-filter-btn:hover {
            border-color: var(--red);
            color: var(--red);
        }

        .late-filter-btn.active {
            background: var(--red);
            border-color: var(--red);
            color: #fff;
            box-shadow: 0 3px 10px rgba(239,68,68,.24);
        }

        .late-filter-btn .fbadge {
            background: rgba(255,255,255,.25);
            border-radius: 99px;
            padding: 1px 7px;
            font-size: .72rem;
            font-weight: 800;
        }

        .late-filter-btn:not(.active) .fbadge {
            background: var(--line);
            color: var(--ink2);
        }

    .late-sort {
        margin-right: auto;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .late-sort label {
            font-size: .78rem;
            font-weight: 700;
            color: var(--ink2);
            white-space: nowrap;
        }

        .late-sort select {
            padding: 6px 12px;
            border-radius: 8px;
            border: 1.5px solid var(--line);
            background: var(--card);
            font-family: 'Cairo', sans-serif;
            font-size: .8rem;
            color: var(--ink);
            cursor: pointer;
            outline: none;
            transition: border-color var(--ease);
        }

            .late-sort select:focus {
                border-color: var(--red);
            }

    /* ══ ALERT ══════════════════════════════════════ */
    .late-alert {
        background: linear-gradient(135deg,rgba(239,68,68,.10),rgba(245,158,11,.09));
        border: 1px solid rgba(239,68,68,.16);
        border-radius: var(--r);
        padding: 14px 18px;
        margin: 0 4px 16px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        box-shadow: var(--sh);
    }

    .late-alert-icon {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: var(--reda);
        color: var(--red);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .late-alert-title {
        font-size: .92rem;
        font-weight: 900;
        color: var(--ink);
        margin-bottom: 2px;
    }

    .late-alert-text {
        font-size: .78rem;
        font-weight: 700;
        color: var(--ink2);
        margin: 0;
    }

    /* ══ RESULTS LABEL ══════════════════════════════ */
    .late-results-label {
        font-size: .78rem;
        font-weight: 700;
        color: var(--ink3);
        margin: 0 4px 14px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .late-results-label b {
            color: var(--ink);
        }

    /* ══ GRID ═══════════════════════════════════════ */
    .late-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(340px,1fr));
        gap: 16px;
        padding: 0 4px;
    }

    .late-card {
        background: var(--card);
        border-radius: var(--r);
        border: 1px solid rgba(239,68,68,.12);
        box-shadow: var(--sh);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform var(--ease), box-shadow var(--ease), border-color var(--ease);
        animation: cardIn .4s ease both;
    }

        .late-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--sh2);
            border-color: rgba(239,68,68,.24);
        }

    @@keyframes cardIn {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .late-card-stripe {
        height: 3px;
        width: 100%;
        background: linear-gradient(90deg,var(--red),#f87171);
    }

    .late-card-body {
        padding: 18px 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .late-card-top {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .late-card-ico {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        margin-top: 2px;
        background: var(--reda);
        color: var(--red);
    }

    .late-card-title {
        font-size: .97rem;
        font-weight: 800;
        color: var(--ink);
        line-height: 1.35;
        margin-bottom: 4px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .late-card-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .late-tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #f1f5f9;
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 2px 10px;
        font-size: .7rem;
        font-weight: 700;
        color: var(--ink2);
    }

        .late-tag i {
            font-size: .65rem;
            opacity: .6;
        }

    .late-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 50px;
        padding: 4px 12px;
        font-size: .73rem;
        font-weight: 800;
        white-space: nowrap;
        background: var(--reda);
        color: #b91c1c;
    }

    .late-info-box {
        background: #fff7f7;
        border: 1px solid rgba(239,68,68,.14);
        border-radius: var(--r-sm);
        padding: 12px 14px;
    }

    .late-info-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 8px;
    }

        .late-info-row:last-child {
            margin-bottom: 0;
        }

    .late-info-label {
        font-size: .72rem;
        font-weight: 700;
        color: var(--ink2);
    }

    .late-info-value {
        font-size: .78rem;
        font-weight: 900;
        color: var(--ink);
    }

    .late-progress {
        height: 7px;
        border-radius: 99px;
        background: rgba(239,68,68,.10);
        overflow: hidden;
        margin-top: 8px;
    }

    .late-progress-fill {
        height: 100%;
        width: 100%;
        border-radius: 99px;
        background: linear-gradient(90deg,var(--red),#f87171);
        opacity: .82;
    }

    /* actions */
    .late-card-foot {
        padding: 14px 20px;
        border-top: 1px solid rgba(239,68,68,.10);
        background: #fffafa;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .late-btn {
        flex: 1;
        min-width: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 9px 14px;
        border-radius: 10px;
        border: none;
        font-family: 'Cairo', sans-serif;
        font-size: .82rem;
        font-weight: 800;
        cursor: pointer;
        text-decoration: none;
        transition: all var(--ease);
    }

        .late-btn:hover {
            text-decoration: none;
            transform: translateY(-1px);
        }

    .btn-late-start {
        background: var(--red);
        color: #fff;
        box-shadow: 0 3px 10px rgba(239,68,68,.24);
    }

        .btn-late-start:hover {
            background: var(--red-d);
            color: #fff;
        }

    /* ══ EMPTY STATE ════════════════════════════════ */
    .late-empty {
        text-align: center;
        padding: 60px 24px;
        background: var(--card);
        border-radius: var(--r);
        border: 1px solid var(--line);
        box-shadow: var(--sh);
    }

    .late-empty-ico {
        font-size: 3.5rem;
        opacity: .25;
        margin-bottom: 16px;
    }

    .late-empty h3 {
        font-size: 1rem;
        font-weight: 800;
        color: var(--ink);
        margin-bottom: 6px;
    }

    .late-empty p {
        font-size: .85rem;
        color: var(--ink2);
    }

    /* ══ ENTRANCE ═══════════════════════════════════ */
    .fu {
        opacity: 0;
        transform: translateY(18px);
        animation: fu .45s ease forwards;
    }

    @@keyframes fu {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .d1 {
        animation-delay: .04s;
    }

    .d2 {
        animation-delay: .1s;
    }

    .d3 {
        animation-delay: .17s;
    }

    /* ══ RESPONSIVE ═════════════════════════════════ */
    @@media(max-width:700px) {
        .late-hero {
            padding: 22px 16px 40px;
        }

        .late-hero-text h1 {
            font-size: 1.15rem;
        }

        .late-search {
            width: 100%;
            margin-right: 0;
        }

            .late-search input {
                min-width: 0;
                flex: 1;
            }

        .late-hero-inner {
            flex-direction: column;
            align-items: flex-start;
        }

        .late-grid {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .late-sort {
            margin-right: 0;
            width: 100%;
        }

        .late-toolbar {
            gap: 6px;
        }

        .late-card-foot {
            padding: 12px 14px;
        }

        .late-alert {
            flex-direction: row;
            padding: 12px 14px;
        }
    }
</style>

@{
    var total = Model?.Count ?? 0;

    var currentAverage = 0.0;

    if (ViewBag.CurrentAverage != null)
    {
        double.TryParse(ViewBag.CurrentAverage.ToString(), out currentAverage);
    }

    var todayLateCount = Model?.Count(x => x.CreatedAt.Date == DateTime.Today) ?? 0;

    var oldestLateDate = Model != null && Model.Any()
        ? Model.Min(x => x.CreatedAt)
        : (DateTime?)null;

    var newestLateDate = Model != null && Model.Any()
        ? Model.Max(x => x.CreatedAt)
        : (DateTime?)null;
}

<div class="late-switcher">
    @await Component.InvokeAsync("StudentCourseSwitcher")
</div>

<div class="late-page">

    <!-- ══ HERO ══ -->
    <div class="late-hero fu">
        <div class="late-hero-inner">
            <div class="late-hero-ico">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <div class="late-hero-text">
                <h1>الواجبات المتأخرة</h1>
                <p>هذه الواجبات تحتاج حلًا سريعًا حتى لا تؤثر على تقدمك وظهور الواجبات التالية</p>
            </div>

            <div class="late-search">
                <span class="late-search-ico">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <input type="text"
                       id="late-search-input"
                       placeholder="ابحث عن واجب متأخر…"
                       oninput="applyLateFilters()">
            </div>
        </div>

        <div class="late-hero-stats">
            <span class="late-hstat">
                <span class="late-hstat-dot" style="background:#ef4444"></span>
                المتأخرة: @total
            </span>

            <span class="late-hstat">
                <span class="late-hstat-dot" style="background:#f59e0b"></span>
                المعدل الحالي: @currentAverage.ToString("F1")%
            </span>

            <span class="late-hstat">
                <span class="late-hstat-dot" style="background:#8b5cf6"></span>
                مضافة اليوم: @todayLateCount
            </span>

            @if (oldestLateDate.HasValue)
            {
                <span class="late-hstat">
                    <span class="late-hstat-dot" style="background:#ffffff"></span>
                    أقدم واجب: @oldestLateDate.Value.ToString("yyyy/MM/dd")
                </span>
            }

            @if (newestLateDate.HasValue)
            {
                <span class="late-hstat">
                    <span class="late-hstat-dot" style="background:#2e9e9e"></span>
                    آخر واجب: @newestLateDate.Value.ToString("yyyy/MM/dd")
                </span>
            }
        </div>
    </div>

    <!-- ══ TOOLBAR ══ -->
    <div class="late-toolbar fu d1">
        <button type="button"
                class="late-filter-btn active"
                data-filter="all"
                onclick="setLateFilter(this)">
            <i class="fa-solid fa-layer-group" style="font-size:.75rem"></i>
            الكل <span class="fbadge">@total</span>
        </button>

        <button type="button"
                class="late-filter-btn"
                data-filter="today"
                onclick="setLateFilter(this)">
            <i class="fa-solid fa-calendar-day" style="font-size:.75rem"></i>
            مضافة اليوم <span class="fbadge">@todayLateCount</span>
        </button>

        <button type="button"
                class="late-filter-btn"
                data-filter="older"
                onclick="setLateFilter(this)">
            <i class="fa-solid fa-clock-rotate-left" style="font-size:.75rem"></i>
            أقدم من اليوم <span class="fbadge">@(total - todayLateCount)</span>
        </button>

        <div class="late-sort">
            <label for="late-sort-sel">
                <i class="fa-solid fa-arrow-up-wide-short" style="font-size:.75rem"></i>
                ترتيب:
            </label>

            <select id="late-sort-sel" onchange="applyLateFilters()">
                <option value="date-asc">الأقدم أولاً</option>
                <option value="date-desc">الأحدث أولاً</option>
                <option value="title-asc">الاسم تصاعديًا</option>
            </select>
        </div>
    </div>

    <!-- ══ BODY ══ -->
    <div style="padding:0 20px">

        @if (total > 0)
        {
            <div class="late-alert fu d2">
                <div class="late-alert-icon">
                    <i class="fa-solid fa-bell"></i>
                </div>
                <div>
                    <div class="late-alert-title">تنبيه مهم</div>
                    <p class="late-alert-text">
                        حل الواجبات المتأخرة أولًا يساعدك على فتح الواجبات التالية ويحافظ على دقة تحليل أدائك.
                    </p>
                </div>
            </div>
        }

        <div class="late-results-label fu d2" id="late-results-label">
            يُعرض <b id="late-count-shown">@total</b> من إجمالي @total واجب متأخر
        </div>

        <div class="late-grid" id="late-grid">

            @if (Model != null && Model.Any())
            {
                foreach (var hw in Model)
                {
                    var isToday = hw.CreatedAt.Date == DateTime.Today;

                    <div class="late-card"
                         data-filter-date="@(isToday ? "today" : "older")"
                         data-title="@((hw.Title ?? string.Empty).ToLower())"
                         data-date="@hw.CreatedAt.ToString("yyyyMMdd")">

                        <div class="late-card-stripe"></div>

                        <div class="late-card-body">

                            <div class="late-card-top">
                                <div class="late-card-ico">
                                    <i class="fa-solid fa-triangle-exclamation"></i>
                                </div>

                                <div style="flex:1;min-width:0">
                                    <div class="late-card-title">@hw.Title</div>

                                    <div class="late-card-meta">
                                        <span class="late-tag">
                                            <i class="fa-regular fa-calendar"></i>
                                            @hw.CreatedAt.ToString("yyyy/MM/dd")
                                        </span>

                                        @if (!string.IsNullOrWhiteSpace(hw.SectionName))
                                        {
                                            <span class="late-tag">
                                                <i class="fa-solid fa-folder"></i>
                                                @hw.SectionName
                                            </span>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(hw.SectionNames))
                                        {
                                            <span class="late-tag">
                                                <i class="fa-solid fa-folder"></i>
                                                @hw.SectionNames
                                            </span>
                                        }

                                        <span class="late-status">
                                            متأخر
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="late-info-box">
                                <div class="late-info-row">
                                    <span class="late-info-label">حالة الواجب</span>
                                    <span class="late-info-value">متأخر</span>
                                </div>

                                <div class="late-info-row">
                                    <span class="late-info-label">الأولوية</span>
                                    <span class="late-info-value">عاجل</span>
                                </div>

                                <div class="late-info-row">
                                    <span class="late-info-label">الإجراء المطلوب</span>
                                    <span class="late-info-value">حل الواجب الآن</span>
                                </div>

                                <div class="late-progress">
                                    <div class="late-progress-fill"></div>
                                </div>
                            </div>

                        </div>

                        <div class="late-card-foot">
                            <a asp-action="Start"
                               asp-controller="StudentHomeworkFlow"
                               asp-route-homeworkSetId="@hw.HomeworkSetId"
                               class="late-btn btn-late-start">
                                <i class="fa-solid fa-play"></i>
                                حل الآن
                            </a>
                        </div>

                    </div>
                }
            }

        </div>

        <div class="late-empty" id="late-empty" style="display:@(total == 0 ? "block" : "none")">
            <div class="late-empty-ico">🎉</div>
            <h3>لا توجد واجبات متأخرة</h3>
            <p>ممتاز. لا يوجد لديك أي واجبات متأخرة حاليًا.</p>
        </div>

    </div>
</div>

<script>
    /* ═══ DATA ═══════════════════════════════════════ */
    const lateCards = Array.from(document.querySelectorAll('.late-card'));
    let currentLateFilter = 'all';

    /* ═══ FILTER BUTTONS ════════════════════════════ */
    function setLateFilter(btn) {
        document.querySelectorAll('.late-filter-btn').forEach(function (b) {
            b.classList.remove('active');
        });

        btn.classList.add('active');
        currentLateFilter = btn.dataset.filter;
        applyLateFilters();
    }

    /* ═══ SEARCH + SORT + FILTER ═══════════════════ */
    function applyLateFilters() {
        const searchInput = document.getElementById('late-search-input');
        const sortSelect = document.getElementById('late-sort-sel');
        const grid = document.getElementById('late-grid');
        const countShown = document.getElementById('late-count-shown');
        const empty = document.getElementById('late-empty');

        const q = searchInput ? searchInput.value.toLowerCase().trim() : '';
        const sort = sortSelect ? sortSelect.value : 'date-asc';

        let visible = lateCards.filter(function (card) {
            const matchFilter = currentLateFilter === 'all' || card.dataset.filterDate === currentLateFilter;
            const matchSearch = !q || (card.dataset.title || '').includes(q);

            return matchFilter && matchSearch;
        });

        visible.sort(function (a, b) {
            if (sort === 'date-desc') {
                return (b.dataset.date || '').localeCompare(a.dataset.date || '');
            }

            if (sort === 'date-asc') {
                return (a.dataset.date || '').localeCompare(b.dataset.date || '');
            }

            if (sort === 'title-asc') {
                return (a.dataset.title || '').localeCompare(b.dataset.title || '', 'ar');
            }

            return 0;
        });

        const visibleSet = new Set(visible);

        lateCards.forEach(function (card) {
            if (visibleSet.has(card)) {
                card.style.display = '';
                grid.appendChild(card);
            } else {
                card.style.display = 'none';
            }
        });

        if (countShown) {
            countShown.textContent = visible.length;
        }

        if (empty) {
            empty.style.display = visible.length ? 'none' : 'block';
        }
    }

    /* ═══ INIT ══════════════════════════════════════ */
    applyLateFilters();
</script>