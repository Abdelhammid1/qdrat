@model QdratNew.ViewModels.Students.StudySessionReservationViewModel

@{
    ViewData["Title"] = "تعديل جلسة المذاكرة";
}

<h2 class="text-center mt-4 mb-4">📝 تعديل جلسة المذاكرة</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="BranchId" class="form-label">الفرع</label>
            <select asp-for="BranchId" asp-items="Model.BranchList" class="form-select"></select>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="InstructorId" class="form-label">المدرب</label>
            <select asp-for="InstructorId" asp-items="Model.InstructorList" class="form-select">
                <option value="">بدون</option>
            </select>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="RequestedDate" class="form-label">تاريخ الجلسة</label>
            <input asp-for="RequestedDate" class="form-control" type="date" />
        </div>

        <div class="col-md-3 mb-3">
            <label asp-for="StartTime" class="form-label">وقت البدء</label>
            <input asp-for="StartTime" class="form-control" type="time" />
        </div>

        <div class="col-md-3 mb-3">
            <label asp-for="EndTime" class="form-label">وقت الانتهاء</label>
            <input asp-for="EndTime" class="form-control" type="time" />
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="TotalSeats" class="form-label">عدد المقاعد</label>
            <input asp-for="TotalSeats" class="form-control" />
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="Fee" class="form-label">الرسوم</label>
            <input asp-for="Fee" class="form-control" />
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="RoomName" class="form-label">اسم القاعة</label>
            <input asp-for="RoomName" class="form-control" />
        </div>

        <div class="col-12 mb-3">
            <label asp-for="AdditionalServices" class="form-label">الخدمات الإضافية</label>
            <textarea asp-for="AdditionalServices" class="form-control" rows="2"></textarea>
        </div>

        <div class="col-12 mb-3">
            <label asp-for="Notes" class="form-label">ملاحظات</label>
            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
        </div>

        <div class="col-12 text-end">
            <button type="submit" class="btn btn-success">💾 حفظ التعديلات</button>
            <a asp-action="Index" class="btn btn-secondary">⬅️ العودة</a>
        </div>
    </div>
</form>
