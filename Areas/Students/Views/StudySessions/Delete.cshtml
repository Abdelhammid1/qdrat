@model QdratNew.ViewModels.Students.StudentSessionReservationListViewModel

@{
    ViewData["Title"] = "حذف جلسة مذاكرة";

}

<h2 class="text-center mt-4 mb-4 text-danger">⚠️ تأكيد حذف الجلسة</h2>

<div class="card border-danger shadow">
    <div class="card-body">
        <h5 class="mb-3">هل أنت متأكد أنك تريد حذف الجلسة التالية؟</h5>

        <dl class="row fs-5">
            <dt class="col-sm-4">الفرع:</dt>
            <dd class="col-sm-8">@Model.BranchName</dd>

            <dt class="col-sm-4">المدرب:</dt>
            <dd class="col-sm-8">@Model.InstructorName</dd>

            <dt class="col-sm-4">التاريخ:</dt>
            <dd class="col-sm-8">@Model.RequestedDate.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-4">الوقت:</dt>
            <dd class="col-sm-8">@Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">🗑️ نعم، احذف</button>
            <a asp-action="Index" class="btn btn-secondary">⬅️ لا، إلغاء</a>
        </form>
    </div>
</div>
