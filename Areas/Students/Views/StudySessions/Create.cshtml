@model QdratNew.ViewModels.Students.StudySessionReservationViewModel

@{
    ViewData["Title"] = "طلب جلسة مذاكرة";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white fw-bold text-center">
            <i class="fas fa-book-reader"></i> طلب جلسة مذاكرة داخل المعهد
        </div>
        <div class="card-body p-4">
            @if (Model.SuggestedSectionId.HasValue)
            {
                <div class="alert alert-info shadow-sm text-center mb-3">
                    <i class="fas fa-lightbulb"></i> تم اقتراح هذه الجلسة بناءً على أدائك في المحور رقم <strong>@Model.SuggestedSectionId</strong>.
                </div>
            }

            <form asp-area="Students" asp-controller="StudySessions" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <partial name="_ValidationScriptsPartial" />
                <div asp-validation-summary="All" class="alert alert-danger"></div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="BranchId" class="form-label"></label>
                        <select asp-for="BranchId" asp-items="Model.BranchList" class="form-select"></select>
                        <span asp-validation-for="BranchId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="InstructorId" class="form-label"></label>
                        <select asp-for="InstructorId" asp-items="Model.InstructorList" class="form-select">
                            <option value="">بدون مدرب</option>
                        </select>
                        <span asp-validation-for="InstructorId" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label asp-for="RequestedDate" class="form-label"></label>
                        <input asp-for="RequestedDate" class="form-control" type="date" />
                        <span asp-validation-for="RequestedDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="StartTime" class="form-label"></label>
                        <input asp-for="StartTime" class="form-control" type="time" />
                        <span asp-validation-for="StartTime" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EndTime" class="form-label"></label>
                        <input asp-for="EndTime" class="form-control" type="time" />
                        <span asp-validation-for="EndTime" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="TotalSeats" class="form-label"></label>
                    <input asp-for="TotalSeats" class="form-control" type="number" min="1" max="100" />
                    <span asp-validation-for="TotalSeats" class="text-danger"></span>
                </div>


                <div class="mb-3">
                    <label asp-for="AdditionalServices" class="form-label"></label>
                    <textarea asp-for="AdditionalServices" class="form-control" rows="2" placeholder="مثل: مشروبات، طابعة..."></textarea>
                    <span asp-validation-for="AdditionalServices" class="text-danger"></span>
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-primary">إرسال</button>
                   
                </div>
            </form>
            <a asp-action="Index" class="btn btn-secondary ms-2">عودة</a>
        </div>
    </div>
</div>

@section Scripts {
 
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.3/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>

        document.querySelector("form").addEventListener("submit", () => {
            console.log("✅ النموذج بيتم إرساله فعليًا");
        });
    </script>
}

