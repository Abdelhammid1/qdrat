@model QdratNew.ViewModels.Homework.CurriculumReportViewModel
@using Azure.Core
@using Newtonsoft.Json

<form method="get" asp-action="CurriculumReport" class="mb-4">
    <div class="row g-2">
        <!-- اختيار المنهج -->
        <!-- اختيار المنهج -->
        <div class="col-md-4">
            <select name="curriculumId" class="form-select">
                <option value="">اختر المنهج</option>
                @foreach (var cur in Model.Curriculums)
                {
                    if (Context.Request.Query["curriculumId"] == cur.Id.ToString())
                    {
                        <option value="@cur.Id" selected="selected">@cur.Title</option>
                    }
                    else
                    {
                        <option value="@cur.Id">@cur.Title</option>
                    }
                }
            </select>
        </div>

        <!-- اختيار المحور -->
        <div class="col-md-4">
            <select name="sectionId" class="form-select">
                <option value="">اختر المحور (اختياري)</option>
                @foreach (var sec in Model.AvailableSections)
                {
                    if (Context.Request.Query["sectionId"] == sec)
                    {
                        <option value="@sec" selected="selected">@sec</option>
                    }
                    else
                    {
                        <option value="@sec">@sec</option>
                    }
                }
            </select>
        </div>

        <!-- اختيار المؤشر -->
        <div class="col-md-4">
            <select name="lessonId" class="form-select">
                <option value="">اختر المؤشر (اختياري)</option>
                @foreach (var lesson in Model.AvailableLessons)
                {
                    if (Context.Request.Query["lessonId"] == lesson)
                    {
                        <option value="@lesson" selected="selected">@lesson</option>
                    }
                    else
                    {
                        <option value="@lesson">@lesson</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-12 mt-2">
            <button type="submit" class="btn btn-primary w-100">عرض التقرير</button>
        </div>
    </div>
</form>

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row align-items-center mb-4">
        <div class="col-md-6 d-flex align-items-center">
            <img src="/images/avatar.png" class="rounded-circle me-3" width="60" height="60" />
            <div>
                <h5 class="mb-1">@Model.StudentName</h5>
                <small class="text-muted">الدفعة: @Model.BatchName</small>
            </div>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="DownloadReportPdf"
               asp-route-homeworkSetId="@Model.HomeworkSetId"
               class="btn btn-outline-primary">
                <i class="bi bi-file-earmark-pdf"></i> تحميل PDF
            </a>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="row g-3">
        <div class="col-md-3 col-6">
            <div class="card text-center shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">درجة الطالب</h6>
                    <h3 class="fw-bold">@Model.Percentage %</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card text-center shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">الوقت المستغرق</h6>
                    <h3 class="fw-bold">@Model.TimeSpentMinutes دقيقة</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card text-center shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">الترتيب</h6>
                    <h3 class="fw-bold">@Model.Rank / @Model.TotalStudents</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card text-center shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">التقييم</h6>
                    <h3>
                        @{
                            int stars = 1;
                            if (Model.Percentage >= 90) stars = 5;
                            else if (Model.Percentage >= 75) stars = 4;
                            else if (Model.Percentage >= 60) stars = 3;
                            else if (Model.Percentage >= 40) stars = 2;

                            for (int s = 0; s < stars; s++) { <text>⭐</text>; }
                            for (int s = stars; s < 5; s++) { <text>☆</text>; }
                        }
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts -->
    <div class="row mt-4 g-3">
        <!-- Donut Chart -->
        <div class="col-lg-6 col-12">
            <div class="card shadow-sm">
                <div class="card-header text-center fw-bold">توزيع الإجابات</div>
                <div class="card-body" style="height:300px;">
                    @if (Context.Request.Headers["User-Agent"].ToString().Contains("wkhtmltopdf"))
                    {
                        <img src="@Model.DonutChartUrl" alt="توزيع الإجابات" class="img-fluid" />
                    }
                    else
                    {
                        <canvas id="donutChart"></canvas>
                    }
                </div>
                <div class="card-footer">
                    <div class="d-flex justify-content-around text-center">
                        <div>📋 إجمالي الأسئلة<br /><strong>@Model.Questions.Count()</strong></div>
                        <div>✅ صحيحة<br /><strong>@Model.CorrectAnswers</strong></div>
                        <div>❌ خاطئة<br /><strong>@Model.WrongAnswers</strong></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bar Chart -->
        <div class="col-lg-6 col-12">
            <div class="card shadow-sm">
                <div class="card-header text-center fw-bold">الأداء حسب المحاور</div>
                <div class="card-body" style="height:300px;">
                    @if (Context.Request.Headers["User-Agent"].ToString().Contains("wkhtmltopdf"))
                    {
                        <img src="@Model.BarChartUrl" alt="الأداء حسب المحاور" class="img-fluid" />
                    }
                    else
                    {
                        <canvas id="barChart"></canvas>
                    }
                </div>
                <div class="card-footer">
                    <div class="d-flex justify-content-around text-center">
                        <div>📚 عدد المحاور<br /><strong>@Model.SectionScores.Count</strong></div>
                        <div>🔝 أعلى دقة<br /><strong>@(Model.SectionScores.Any() ? Model.SectionScores.Max(s => s.Value) : 0)%</strong></div>
                        <div>🔻 أقل دقة<br /><strong>@(Model.SectionScores.Any() ? Model.SectionScores.Min(s => s.Value) : 0)%</strong></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    @if (!Context.Request.Headers["User-Agent"].ToString().Contains("wkhtmltopdf"))
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            // Doughnut Chart
            new Chart(document.getElementById("donutChart"), {
                type: 'doughnut',
                data: {
                    labels: ["صحيحة", "خاطئة"],
                    datasets: [{
                        data: [@Model.CorrectAnswers, @Model.WrongAnswers],
                        backgroundColor: ["#339999", "#da784d"]
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });

            // Bar Chart
            new Chart(document.getElementById("barChart"), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(JsonConvert.SerializeObject(Model.SectionScores?.Keys.ToList() ?? new List<string>())),
                    datasets: [{
                        label: 'النسبة %',
                        data: @Html.Raw(JsonConvert.SerializeObject(Model.SectionScores?.Values.ToList() ?? new List<double>())),
                        backgroundColor: "#339999"
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { y: { beginAtZero: true, max: 100 } }
                }
            });
        </script>


        <script>
            document.querySelector("select[name='sectionId']").addEventListener("change", function () {
                var sectionId = this.value;
                var studentId = "@Model.StudentId"; // لازم تمرره من الموديل
                var lessonDropdown = document.getElementById("lessonId");

                // فضي القائمة
                lessonDropdown.innerHTML = '<option value="">اختر المؤشر (اختياري)</option>';

                if (sectionId) {
                    fetch(`/Students/StudentHomeworkDashboard/GetLessonsBySection?sectionId=${sectionId}&studentId=${studentId}`)
                        .then(res => res.json())
                        .then(data => {
                            data.forEach(function (lesson) {
                                var opt = document.createElement("option");
                                opt.value = lesson;
                                opt.text = lesson;
                                lessonDropdown.appendChild(opt);
                            });
                        });
                }
            });
        </script>

    }
}
