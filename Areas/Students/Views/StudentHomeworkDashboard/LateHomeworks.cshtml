@model List<QdratNew.ViewModels.Homework.HomeworkListVm>

<div class="container mt-4">

    <!-- 🔹 الكروت -->
    <div class="row g-4 mb-4 text-center">
        <div class="col-md-6 col-12">
            <div class="card bg-qdrat-light shadow-sm border-0 rounded-3 h-100">
                <div class="card-body">
                    <h6 class="text-muted">عدد الواجبات المتأخرة</h6>
                    <h3 class="fw-bold text-danger">@ViewBag.TotalLate</h3>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-12">
            <div class="card bg-qdrat-light shadow-sm border-0 rounded-3 h-100">
                <div class="card-body">
                    <h6 class="text-muted">المعدل الحالي للمتأخرة</h6>
                    <h3 class="fw-bold text-warning">@ViewBag.AverageLateScore %</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- 🔹 الجدول -->
    <div class="card shadow-sm rounded-3">
        <div class="card-header bg-danger text-white fw-bold text-center">
            ⚠️ قائمة الواجبات المتأخرة
        </div>
        <div class="card-body p-0">
            <table id="lateHomeworksTable" class="table table-bordered table-hover align-middle text-center mb-0 modern-table">
                <thead class="table-light">
                    <tr>
                        <th>اسم الواجب</th>
                        <th class="d-none d-md-table-cell">تاريخ الإنشاء</th>
                        <th class="d-none d-md-table-cell">الحالة</th>
                        <th>الإجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var hw in Model)
                    {
                        <tr>
                            <!-- ✅ العنوان -->
                            <td class="fw-bold">@hw.Title</td>

                            <!-- الأعمدة الثانوية -->
                            <td data-label="تاريخ الإنشاء" class="d-none d-md-table-cell">@hw.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td data-label="الحالة" class="d-none d-md-table-cell">
                                <span class="badge bg-danger">متأخر</span>
                            </td>

                            <!-- ✅ زر الإجراء -->
                            <td>
                                <a asp-action="Start" asp-route-homeworkSetId="@hw.HomeworkSetId"
                                   class="btn btn-sm btn-outline-danger w-100 rounded-pill">
                                    <i class="fa-solid fa-exclamation-triangle me-1"></i> حل الآن
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ✅ سكربت DataTable -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
    $(document).ready(function () {
        $('#lateHomeworksTable').DataTable({
            language: {
                url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json"
            },
            pageLength: 10,
            lengthMenu: [5, 10, 20, 50],
            order: [[2, "desc"]],
            responsive: true
        });
    });
</script>

<!-- 🎨 CSS -->
<style>
    .bg-qdrat-light {
        background-color: #f1fafa !important;
    }

    .table-hover tbody tr:hover {
        background-color: #f9fbff;
        transition: 0.3s ease;
    }

    .btn-sm {
        padding: 6px 14px;
        font-size: 0.85rem;
        transition: 0.3s ease;
    }

        .btn-sm:hover {
            transform: scale(1.05);
        }

    /* 📱 تصميم الموبايل الذكي */
    @@media (max-width: 767px) {
        table thead

    {
        display: none;
    }

    table, tbody, tr, td {
        display: block;
        width: 100%;
        text-align: right;
    }

    tr {
        margin-bottom: 1rem;
        background: #fff;
        border-radius: 1rem;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
        padding: 0.8rem;
    }

    td {
        padding: 0.6rem 1rem;
        position: relative;
        border: none;
    }

        /* ✅ الأعمدة الثانوية فقط يظهر لها عنوان */
        td[data-label]::before {
            content: attr(data-label);
            position: absolute;
            left: 0.8rem;
            top: 0.6rem;
            font-weight: 600;
            color: #d9534f;
            font-size: 0.9rem;
        }

    /* 🔹 أول خلية (اسم الواجب) */
    tr td:first-child {
        font-weight: 700;
        font-size: 1rem;
        color: #d9534f;
        margin-bottom: 0.4rem;
    }

    /* 🔹 خلية الأزرار */
    tr td:last-child {
        margin-top: 0.6rem;
        display: flex;
        flex-direction: column;
    }

    .btn-sm {
        font-size: 0.9rem;
        padding: 0.6rem;
    }

    }
</style>
