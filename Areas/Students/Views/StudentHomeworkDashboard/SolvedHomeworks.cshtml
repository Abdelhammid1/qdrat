@model List<QdratNew.ViewModels.Homework.HomeworkListVm>

<div class="container mt-4">

    <!-- 🔹 الكروت -->
    <div class="row g-4 mb-4 text-center">
        <div class="col-md-6">
            <div class="card bg-qdrat-light shadow-sm border-0 rounded-3 h-100">
                <div class="card-body">
                    <h6 class="text-muted">عدد الواجبات المحلولة</h6>
                    <h3 class="fw-bold text-primary">@ViewBag.TotalSolved</h3>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card bg-qdrat-light shadow-sm border-0 rounded-3 h-100">
                <div class="card-body">
                    <h6 class="text-muted">متوسط درجاتي</h6>
                    <h3 class="fw-bold text-success">@ViewBag.AverageScore %</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- 🔹 الجدول -->
    <div class="card shadow-sm rounded-3">
        <div class="card-header bg-qdrat text-white fw-bold text-center">
            ✅ قائمة الواجبات المحلولة
        </div>
        <div class="card-body">
            <table id="solvedHomeworksTable" class="table table-bordered table-hover align-middle text-center">
                <thead class="table-light">
                    <tr>
                        <th>اسم الواجب</th>
                        <th>تاريخ التسليم</th>
                        <th>الدرجة المئوية</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var hw in Model)
                    {
                        <tr>
                            <td class="fw-bold">@hw.Title</td>
                            <td>@hw.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="badge text-center bg-qdrat">@hw.Score %</span>
                            </td>
                            <td>
                                <a asp-action="Review" asp-route-homeworkSetId="@hw.HomeworkSetId"
                                   class="btn btn-sm btn-outline-dark me-1">
                                    <i class="fa-solid fa-eye me-1"></i> مراجعة
                                </a>
                                <a asp-action="HomeworkReportUnified" asp-route-homeworkSetId="@hw.HomeworkSetId"
                                   class="btn btn-sm btn-outline-secondary">
                                    <i class="fa-solid fa-file-alt me-1"></i> تقرير
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ✅ سكربت DataTable -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
    $(document).ready(function () {
        $('#solvedHomeworksTable').DataTable({
            language: {
                url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json"
            },
            pageLength: 10,
            lengthMenu: [5, 10, 20, 50],
            order: [[2, "desc"]] // ترتيب حسب تاريخ التسليم
        });
    });
</script>
