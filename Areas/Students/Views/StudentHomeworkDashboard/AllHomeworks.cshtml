@model List<QdratNew.ViewModels.Homework.HomeworkListVm>

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

<div class="container mt-4">

    <!-- 🔹 الكروت -->
    <div class="row g-4 mb-4 text-center">
        <div class="col-md-4 col-12">
            <div class="card bg-qdrat-light shadow-sm border-0 rounded-3 h-100">
                <div class="card-body">
                    <h6 class="text-muted">عدد الواجبات</h6>
                    <h3 class="fw-bold text-primary">@Model.Count</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-12">
            <div class="card bg-qdrat-light shadow-sm border-0 rounded-3 h-100">
                <div class="card-body">
                    <h6 class="text-muted">المعدل العام</h6>
                    <h3 class="fw-bold text-success">
                        @(Model.Any() ? $"{Model.Average(x => x.Score):F1} %" : "0 %")
                    </h3>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-12">
            <div class="card bg-qdrat-light shadow-sm border-0 rounded-3 h-100">
                <div class="card-body">
                    <h6 class="text-muted">الدرجة الوزنية (مقارنة الدفعة)</h6>
                    <h3 class="fw-bold text-info">
                        @(Model.Any() ? $"{Model.Average(x => x.BatchAverageScore):F1} %" : "0 %")
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <!-- 🔹 الجدول -->
    <div class="card shadow-sm rounded-3">
        <div class="card-header bg-qdrat text-white fw-bold text-center">
            📘 قائمة الواجبات
        </div>
        <div class="card-body p-0">
            <table id="homeworksTable" class="table table-bordered table-hover align-middle text-center mb-0 modern-table">
                <thead class="table-light">
                    <tr>
                        <th>اسم الواجب</th>
                        <th class="d-none d-md-table-cell">تاريخ التسليم</th>
                        <th class="d-none d-md-table-cell">الدرجة المئوية</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var hw in Model)
                    {
                        <tr>
                            <!-- 🔹 بدون data-label للعنوان -->
                            <td class="fw-bold">@hw.Title</td>

                            <!-- 🔹 الأعمدة الثانوية -->
                            <td data-label="تاريخ التسليم" class="d-none d-md-table-cell">@hw.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td data-label="الدرجة المئوية" class="d-none d-md-table-cell">
                                @if (hw.IsSubmitted)
                                {
                                    <span class="badge text-center bg-qdrat">@hw.Score %</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">لم يُحل بعد</span>
                                }
                            </td>

                            <!-- 🔹 الإجراءات بدون data-label -->
                            <td>
                                @if (!hw.IsSubmitted)
                                {
                                    <a asp-action="Start" asp-route-homeworkSetId="@hw.HomeworkSetId"
                                       class="btn btn-sm btn-primary w-100 rounded-pill">
                                        <i class="fa-solid fa-play me-1"></i> بدء الحل
                                    </a>
                                }
                                else
                                {
                                    <div class="d-flex flex-column flex-md-row justify-content-center gap-2">
                                        <a asp-action="Review" asp-route-homeworkSetId="@hw.HomeworkSetId"
                                           class="btn btn-sm btn-outline-success rounded-pill w-100">
                                            <i class="fa-solid fa-eye me-1"></i> مراجعة
                                        </a>
                                        <a asp-action="HomeworkReportUnified" asp-route-homeworkSetId="@hw.HomeworkSetId"
                                           class="btn btn-sm btn-outline-primary rounded-pill w-100">
                                            <i class="fa-solid fa-file-alt me-1"></i> تقرير
                                        </a>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ✅ سكربت DataTable -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
    $(document).ready(function () {
        $('#homeworksTable').DataTable({
            language: {
                url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json"
            },
            pageLength: 10,
            lengthMenu: [5, 10, 20, 50],
            order: [[2, "desc"]],
            responsive: true
        });
    });
</script>

<!-- 🎨 CSS -->
<style>
    .bg-qdrat {
        background-color: #1ba098 !important;
    }

    .bg-qdrat-light {
        background-color: #f1fafa !important;
    }

    table th, table td {
        vertical-align: middle !important;
    }

    .table-hover tbody tr:hover {
        background-color: #f9fbff;
        transition: 0.3s ease;
    }

    .btn-sm {
        padding: 6px 14px;
        font-size: 0.85rem;
        transition: 0.3s ease;
    }

        .btn-sm:hover {
            transform: scale(1.05);
        }

    /* 📱 تصميم الموبايل الذكي */
    @@media (max-width: 767px) {
        table thead

    {
        display: none;
    }

    table, tbody, tr, td {
        display: block;
        width: 100%;
        text-align: right;
    }

    tr {
        margin-bottom: 1rem;
        background: #fff;
        border-radius: 1rem;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
        padding: 0.8rem;
    }

    td {
        padding: 0.6rem 1rem;
        position: relative;
        border: none;
    }

        /* ✅ فقط الأعمدة الثانوية يظهر عنوانها */
        td[data-label]::before {
            content: attr(data-label);
            position: absolute;
            left: 0.8rem;
            top: 0.6rem;
            font-weight: 600;
            color: #1ba098;
            font-size: 0.9rem;
        }

    /* 🔹 العنوان */
    tr td:first-child {
        font-weight: 700;
        font-size: 1rem;
        color: #1ba098;
        margin-bottom: 0.4rem;
    }

    /* 🔹 زر الإجراءات */
    tr td:last-child {
        margin-top: 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .btn-sm {
        font-size: 0.9rem;
        padding: 0.6rem;
    }

    }
</style>
