@model QdratNew.ViewModels.Homework.HomeworkResultViewModel

@{
    ViewData["Title"] = "نتيجة الواجب";

    var successRate = Model.TotalQuestions > 0
        ? (Model.CorrectAnswers * 100 / Model.TotalQuestions)
        : 0;
}

@functions {
    string ToIndic(object input)
    {
        var str = Convert.ToString(input);
        return Model.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(str) : str;
    }
}

<div class="container mt-4">
    <h2 class="text-center mb-4">📊 نتيجة الواجب</h2>

    <div class="text-center mb-4">
        <h4 class="fw-bold text-success">
            ✅ الإجابات الصحيحة: @Html.Raw(ToIndic(Model.CorrectAnswers)) من @Html.Raw(ToIndic(Model.TotalQuestions))
        </h4>
        <h5 class="text-info">
            نسبة النجاح: @Html.Raw(ToIndic(successRate))%
        </h5>
    </div>

    @if (Model.Questions.Any(q => q.IsCorrect != true))
    {
        <h5 class="mb-3 text-danger fw-bold">❌ الأسئلة التي أجبت عليها بشكل خاطئ:</h5>

        @foreach (var item in Model.Questions.Where(q => q.IsCorrect != true))
        {
            <div class="card mb-4 shadow-sm border-0" style="background-color:#f9f9f9;">
                <div class="card-body bg-qdrat-light">
                    <div class="p-1 mb-3 rounded">
                        <strong class="text-dark">📌 السؤال:</strong>
                        <div class="mt-2 bg-qdrat text-white p-md-2 rounded-2">
                            @Html.Raw(Model.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(item.QuestionTitle) : item.QuestionTitle)
                        </div>
                    </div>

                    <p>
                        <span class="text-danger">❌ إجابتك:</span>
                        <strong>@Html.Raw(Model.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(item.StudentAnswer) : item.StudentAnswer)</strong>
                    </p>
                    <p>
                        <span class="text-success">✅ الإجابة الصحيحة:</span>
                        <strong>@Html.Raw(Model.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(item.CorrectAnswer) : item.CorrectAnswer)</strong>
                    </p>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-success text-center mt-4">
            🎉 أحسنت! لقد أجبت على جميع الأسئلة بشكل صحيح.
        </div>
    }
</div>

@if (successRate >= 90)
{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        Swal.fire({
            title: '🎉 ممتاز!',
            text: 'أنت من الأوائل في هذا الواجب. واصل التألق!',
            icon: 'success',
            confirmButtonText: 'شكرًا',
            confirmButtonColor: '#3085d6'
        });
    </script>
}
