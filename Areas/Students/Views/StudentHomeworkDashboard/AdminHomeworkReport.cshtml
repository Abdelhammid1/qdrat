@model QdratNew.ViewModels.Reports.PlacementReportViewModel
@using QdratNew.Helpers
@{
    ViewData["Title"] = "تقرير اداء الواجب ";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        body {
            background: #f6f7fb;
            font-family: 'Cairo', sans-serif;
        }

        .card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 8px 24px rgba(0,0,0,.06);
            padding: 18px;
        }

        .label {
            color: #64748b;
            font-size: .85rem;
        }

        .value {
            color: #0f172a;
            font-weight: 800;
        }

        .chart-title {
            font-weight: 700;
            color: #334155;
            margin-bottom: 10px;
        }

        @@media print {
            .no-print {
                display: none !important
            }

            body {
                background: #fff !important
            }
        }
    </style>
</head>
<body class="min-h-screen">
    <div class="max-w-6xl mx-auto px-4 py-6 space-y-6">

        <!-- 🟦 عنوان الصفحة -->
        <section class="card">
            <div class="flex items-start justify-between gap-6">
                <div>
                    <h1 class="text-3xl font-extrabold text-slate-900">تقرير أداء الواجب</h1>
                    <p class="text-slate-600">تحليل شامل لأداء الطالب في الواجب</p>

                </div>

                <div class="flex-shrink-0">
                    <img src="~/images/160×100.png" alt="شعار معهد القدرات"
                         style="width:160px;height:100px;" />
                </div>


            </div>

            <!-- 🧾 معلومات الطالب -->
            <div class="mt-4 grid sm:grid-cols-2 gap-4">
                <div class="grid grid-cols-3 gap-x-2 gap-y-2">
                    <div class="label">اسم الطالب:</div><div class="col-span-2 value">@Model.Student.FullName</div>
                    <div class="label">رقم الطالب:</div><div class="col-span-2 value">@Model.Student.StudentID</div>
                    <div class="label">المستوى:</div><div class="col-span-2 value">@Model.Student.Level</div>
                    <div class="label">تاريخ الواجب:</div><div class="col-span-2 value">@Model.ExamDate</div>
                </div>

                <div class="grid grid-cols-3 gap-x-2 gap-y-2">
                    <div class="label">زمن الحل:</div><div class="col-span-2 value">@NumberHelper.ToIndicNumbersSafe(Model.SolveMinutes.ToString()) دقيقة</div>
                    <div class="label">عدد الأسئلة:</div><div class="col-span-2 value">@NumberHelper.ToIndicNumbersSafe(Model.TotalQuestions.ToString())</div>
                    <div class="label">الإجابات الصحيحة:</div><div class="col-span-2 value">@NumberHelper.ToIndicNumbersSafe(Model.CorrectAnswers.ToString())</div>
                </div>
            </div>
        </section>


        <!-- 🕒 التحليل الزمني -->
        <section class="card">
            <h2 class="chart-title">التحليل الزمني لحل الواجب</h2>

            <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
                <div>
                    <div class="label">الوقت الكلي:</div>
                    <div class="value">@Model.TimeSpentFormatted</div>
                    <div class="text-gray-500 text-sm">@Model.TimeExplanation</div>
                </div>

                <div>
                    <div class="label">متوسط الزمن لكل سؤال:</div>
                    <div class="value">@NumberHelper.ToIndicNumbersSafe(Model.AverageSecondsPerQuestion.ToString()) ثانية</div>
                </div>

                <div>
                    <div class="label">أسرع سؤال:</div>
                    <div class="value">@Model.FastestQuestion</div>
                    <div class="text-gray-500 text-sm">
                        @NumberHelper.ToIndicNumbersSafe(Math.Round(Model.FastestTimeSeconds).ToString()) ثانية
                    </div>
                </div>

                <div>
                    <div class="label">أبطأ سؤال:</div>
                    <div class="value">@Model.SlowestQuestion</div>
                    <div class="text-gray-500 text-sm">
                        @NumberHelper.ToIndicNumbersSafe(Math.Round(Model.SlowestTimeSeconds).ToString()) ثانية
                    </div>
                </div>
            </div>
        </section>





        <!-- 🟩 كروت الأداء العام -->
        <section class="grid sm:grid-cols-3 gap-4">
            <div class="card text-center">
                <div class="label">النسبة العامة</div>
                <div class="text-3xl font-bold text-slate-900">@Model.OverallPercent%</div>
                <div class="text-gray-500 text-xs">
                    تقدير: @(Model.OverallPercent >= 80 ? "جيد جدًا" : (Model.OverallPercent >= 60 ? "متوسط" : "قيد التطوير"))
                </div>
            </div>
            <div class="card text-center">
                <div class="label">إجابات صحيحة</div>
                <div class="text-3xl font-bold text-emerald-600">@Model.CorrectAnswers</div>
                <div class="text-gray-500 text-xs">من أصل @Model.TotalQuestions سؤال</div>
            </div>
            <div class="card text-center">
                <div class="label">الأسئلة غير المجابة</div>
                <div class="text-3xl font-bold text-amber-600">@Model.SkippedQuestions</div>
                <div class="text-gray-500 text-xs">يُنصح بإكمال التدريب</div>
            </div>
        </section>

        <!-- 🧮 الرسم البياني العام -->


        <div class="row">
            <div class="col-md-12 p-3">
                <section class="card">
                    <h2 class="chart-title">توزيع الأداء العام</h2>
                    <canvas id="overallChart" height="160"></canvas>
                </section>
            </div>

            <div class="col-md-6 p-3">
                <!-- 🔹 تحليل الكمي -->
                @if (Model.QuantLabels?.Any() == true)
                {
                    <section class="card">
                        <h2 class="chart-title">تحليل الأداء في المحاور الكمية</h2>
                        <canvas id="quantChart" height="180"></canvas>
                    </section>
                }

            </div>
            <div class="col-md-6 p-3">

                <!-- 🗣️ تحليل اللفظي -->
                @if (Model.VerbalLabels?.Any() == true)
                {
                    <section class="card">
                        <h2 class="chart-title">تحليل الأداء في المحاور اللفظية</h2>
                        <canvas id="verbalChart" height="180"></canvas>
                    </section>
                }
            </div>

        </div>




        <!-- 🧠 التوصيات -->
        <section class="card">
            <h2 class="chart-title">توصيات الذكاء الاصطناعي</h2>
            @if (Model.Recommendation != null)
            {
                <p class="text-gray-700 mb-3">@Model.Recommendation.PerformanceSummary</p>

                <div class="grid sm:grid-cols-2 gap-3">
                    <div class="p-4 rounded-xl bg-emerald-50">
                        <h4 class="font-semibold text-emerald-700 mb-1">@Model.Recommendation.TrackCard1</h4>
                        <p class="text-gray-700 text-sm">@Model.Recommendation.TrackCard1Desc</p>
                    </div>
                    <div class="p-4 rounded-xl bg-sky-50">
                        <h4 class="font-semibold text-sky-700 mb-1">@Model.Recommendation.TrackCard2</h4>
                        <p class="text-gray-700 text-sm">@Model.Recommendation.TrackCard2Desc</p>
                    </div>
                </div>

                <ul class="list-disc pr-6 mt-4 space-y-1 text-gray-800 text-sm">
                    @foreach (var tip in Model.Recommendation.IndividualTips)
                    {
                        <li>@tip</li>
                    }
                </ul>
            }
            else
            {
                <p class="text-gray-600">لا توجد توصيات حالياً.</p>
            }
        </section>

        <!-- زر الطباعة -->
        <div class="text-center no-print">
            <button onclick="window.print()" class="px-6 py-2 mt-4 rounded-xl bg-teal-600 text-white hover:bg-teal-700">
                <i class="bi bi-printer"></i> طباعة / حفظ PDF
            </button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // 🧩 الرسم البياني العام
        const overallCtx = document.getElementById('overallChart');
        new Chart(overallCtx, {
            type: 'bar',
            data: {
                labels: ['صحيحة','خاطئة','غير مجابة'],
                datasets: [{
                    data: [@Model.CorrectAnswers, @(Model.TotalQuestions - Model.CorrectAnswers - Model.SkippedQuestions), @Model.SkippedQuestions],
                    backgroundColor: ['#10b981','#ef4444','#f59e0b'],
                    borderRadius: 10
                }]
            },
            options: { plugins:{legend:{display:false}}, scales:{y:{beginAtZero:true,max:@Model.TotalQuestions}} }
        });

        // 🧮 الكمي
        @if (Model.QuantLabels?.Any() == true)
        {
                    <text>
                    const quantCtx = document.getElementById('quantChart');
                    new Chart(quantCtx, {
                        type: 'bar',
                        data: {
                            labels: @Html.Raw(Json.Serialize(Model.QuantLabels)),
                            datasets: [{
                                data: @Html.Raw(Json.Serialize(Model.QuantScores)),
                                backgroundColor: '#0ea5e9',
                                borderRadius: 8
                            }]
                        },
                        options: {
                            plugins:{legend:{display:false}},
                            scales:{y:{beginAtZero:true,max:100}}
                        }
                    });
                    </text>
        }

        // 🗣️ اللفظي
        @if (Model.VerbalLabels?.Any() == true)
        {
                    <text>
                    const verbalCtx = document.getElementById('verbalChart');
                    new Chart(verbalCtx, {
                        type: 'bar',
                        data: {
                            labels: @Html.Raw(Json.Serialize(Model.VerbalLabels)),
                            datasets: [{
                                data: @Html.Raw(Json.Serialize(Model.VerbalScores)),
                                backgroundColor: '#f97316',
                                borderRadius: 8
                            }]
                        },
                        options: {
                            plugins:{legend:{display:false}},
                            scales:{y:{beginAtZero:true,max:100}}
                        }
                    });
                    </text>
        }
    </script>
</body>
</html>
