@using QdratNew.ViewModels.Students.Exams
@model List<StudentExamListItemVm>

@{
    ViewData["Title"] = "الاختبارات الفردية";

    var exams = Model ?? new List<StudentExamListItemVm>();

    int total = exams.Count;
    int completed = exams.Count(x => x.IsCompleted);
    int pending = total - completed;

    var today = DateTime.Today;

    int endingToday = exams.Count(x =>
        !x.IsCompleted &&
        x.EndAt.HasValue &&
        x.EndAt.Value.Date == today);

}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --p: #2e9e9e;
        --p-d: #1d7b7b;
        --p-a: rgba(46,158,158,.12);
        --p-glow: rgba(46,158,158,.3);
        --orange: #e07849;
        --ora: rgba(224,120,73,.12);
        --green: #22c55e;
        --grna: rgba(34,197,94,.12);
        --red: #ef4444;
        --reda: rgba(239,68,68,.12);
        --amber: #f59e0b;
        --ambera: rgba(245,158,11,.12);
        --blue: #3b82f6;
        --bluea: rgba(59,130,246,.12);
        --purple: #8b5cf6;
        --purplea: rgba(139,92,246,.12);
        --ink: #1e293b;
        --ink2: #475569;
        --ink3: #94a3b8;
        --bg: #f0f4f8;
        --card: #ffffff;
        --line: rgba(0,0,0,.07);
        --r: 16px;
        --r-sm: 10px;
        --sh: 0 2px 16px rgba(0,0,0,.07);
        --sh2: 0 8px 32px rgba(0,0,0,.13);
        --ease: .28s cubic-bezier(.4,0,.2,1);
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .individual-exams-page {
        font-family: 'Cairo', sans-serif;
        direction: rtl;
        background: var(--bg);
        min-height: 100vh;
        padding: 0 0 60px;
    }

    .individual-switcher {
        background: linear-gradient(135deg,#0f1f3d 0%,#1a3a5c 100%);
        border-bottom: 1px solid rgba(255,255,255,.06);
        padding: 0 4px;
    }

    .individual-hero {
        background: linear-gradient(145deg,#0f1f3d 0%,#1a3a5c 55%,#103545 100%);
        padding: 28px 28px 44px;
        margin-bottom: -20px;
        position: relative;
        overflow: hidden;
    }

        .individual-hero::before {
            content: '';
            position: absolute;
            width: 360px;
            height: 360px;
            border-radius: 50%;
            background: radial-gradient(circle,rgba(46,158,158,.14) 0%,transparent 65%);
            top: -100px;
            left: -60px;
            pointer-events: none;
        }

        .individual-hero::after {
            content: '';
            position: absolute;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: radial-gradient(circle,rgba(139,92,246,.12) 0%,transparent 65%);
            bottom: -80px;
            right: -40px;
            pointer-events: none;
        }

    .individual-hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .individual-hero-ico {
        width: 52px;
        height: 52px;
        background: rgba(255,255,255,.1);
        border: 1.5px solid rgba(255,255,255,.18);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: #fff;
        backdrop-filter: blur(8px);
        flex-shrink: 0;
    }

    .individual-hero-text h1 {
        color: #fff;
        font-size: 1.4rem;
        font-weight: 800;
        margin: 0 0 3px;
    }

    .individual-hero-text p {
        color: rgba(255,255,255,.58);
        font-size: .82rem;
        margin: 0;
    }

    .individual-search {
        margin-right: auto;
        display: flex;
        align-items: center;
        gap: 0;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 50px;
        overflow: hidden;
        backdrop-filter: blur(8px);
        flex-shrink: 0;
    }

        .individual-search input {
            background: transparent;
            border: none;
            outline: none;
            padding: 9px 16px;
            color: #fff;
            font-family: 'Cairo', sans-serif;
            font-size: .85rem;
            min-width: 220px;
        }

            .individual-search input::placeholder {
                color: rgba(255,255,255,.45);
            }

    .individual-search-ico {
        padding: 0 14px;
        color: rgba(255,255,255,.5);
        font-size: .85rem;
    }

    .individual-hero-stats {
        position: relative;
        z-index: 1;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 16px;
    }

    .individual-hstat {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 50px;
        padding: 7px 18px;
        color: rgba(255,255,255,.86);
        font-size: .8rem;
        font-weight: 700;
        backdrop-filter: blur(6px);
    }

    .individual-hstat-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .individual-toolbar {
        background: var(--card);
        border-radius: 0 0 20px 20px;
        border: 1px solid var(--line);
        border-top: none;
        box-shadow: var(--sh);
        padding: 12px 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }

    .individual-filter-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 7px 16px;
        border-radius: 50px;
        border: 1.5px solid var(--line);
        background: transparent;
        font-family: 'Cairo', sans-serif;
        font-size: .8rem;
        font-weight: 700;
        color: var(--ink2);
        cursor: pointer;
        white-space: nowrap;
        transition: all var(--ease);
    }

        .individual-filter-btn:hover {
            border-color: var(--p);
            color: var(--p);
        }

        .individual-filter-btn.active {
            background: var(--p);
            border-color: var(--p);
            color: #fff;
            box-shadow: 0 3px 10px var(--p-glow);
        }

        .individual-filter-btn .fbadge {
            background: rgba(255,255,255,.25);
            border-radius: 99px;
            padding: 1px 7px;
            font-size: .72rem;
            font-weight: 800;
        }

        .individual-filter-btn:not(.active) .fbadge {
            background: var(--line);
            color: var(--ink2);
        }

    .individual-sort {
        margin-right: auto;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .individual-sort label {
            font-size: .78rem;
            font-weight: 700;
            color: var(--ink2);
            white-space: nowrap;
        }

        .individual-sort select {
            padding: 6px 12px;
            border-radius: 8px;
            border: 1.5px solid var(--line);
            background: var(--card);
            font-family: 'Cairo', sans-serif;
            font-size: .8rem;
            color: var(--ink);
            cursor: pointer;
            outline: none;
            transition: border-color var(--ease);
        }

            .individual-sort select:focus {
                border-color: var(--p);
            }

    .individual-alert {
        background: linear-gradient(135deg,rgba(46,158,158,.10),rgba(139,92,246,.08));
        border: 1px solid rgba(46,158,158,.16);
        border-radius: var(--r);
        padding: 14px 18px;
        margin: 0 4px 16px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        box-shadow: var(--sh);
    }

    .individual-alert-icon {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: var(--p-a);
        color: var(--p);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .individual-alert-title {
        font-size: .92rem;
        font-weight: 900;
        color: var(--ink);
        margin-bottom: 2px;
    }

    .individual-alert-text {
        font-size: .78rem;
        font-weight: 700;
        color: var(--ink2);
        margin: 0;
    }

    .individual-results-label {
        font-size: .78rem;
        font-weight: 700;
        color: var(--ink3);
        margin: 0 4px 14px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .individual-results-label b {
            color: var(--ink);
        }

    .individual-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(350px,1fr));
        gap: 16px;
        padding: 0 4px;
    }

    .individual-card {
        background: var(--card);
        border-radius: var(--r);
        border: 1px solid var(--line);
        box-shadow: var(--sh);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform var(--ease), box-shadow var(--ease), border-color var(--ease);
        animation: cardIn .4s ease both;
    }

        .individual-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--sh2);
            border-color: rgba(46,158,158,.22);
        }

    @@keyframes cardIn {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .individual-card-stripe {
        height: 3px;
        width: 100%;
    }

    .stripe-pending {
        background: linear-gradient(90deg,var(--p),#4ecdc4);
    }

    .stripe-completed {
        background: linear-gradient(90deg,var(--green),#4ade80);
    }

    .stripe-expired {
        background: linear-gradient(90deg,var(--red),#f87171);
    }

    .stripe-today {
        background: linear-gradient(90deg,var(--amber),#fcd34d);
    }

    .individual-card-body {
        padding: 18px 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .individual-card-top {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .individual-card-ico {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        margin-top: 2px;
    }

    .ico-pending {
        background: var(--p-a);
        color: var(--p);
    }

    .ico-completed {
        background: var(--grna);
        color: var(--green);
    }

    .ico-expired {
        background: var(--reda);
        color: var(--red);
    }

    .ico-today {
        background: var(--ambera);
        color: var(--amber);
    }

    .individual-card-title {
        font-size: .97rem;
        font-weight: 800;
        color: var(--ink);
        line-height: 1.35;
        margin-bottom: 4px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .individual-card-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .individual-tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #f1f5f9;
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 2px 10px;
        font-size: .7rem;
        font-weight: 700;
        color: var(--ink2);
    }

        .individual-tag i {
            font-size: .65rem;
            opacity: .6;
        }

    .tag-individual {
        background: var(--purplea);
        color: var(--purple);
        border-color: rgba(139,92,246,.18);
    }

    .individual-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 50px;
        padding: 4px 12px;
        font-size: .73rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .st-pending {
        background: var(--p-a);
        color: var(--p-d);
    }

    .st-completed {
        background: var(--grna);
        color: #15803d;
    }

    .st-expired {
        background: var(--reda);
        color: #b91c1c;
    }

    .st-today {
        background: var(--ambera);
        color: #92400e;
    }

    .individual-info-box {
        background: #f8fafc;
        border: 1px solid var(--line);
        border-radius: var(--r-sm);
        padding: 12px 14px;
    }

    .individual-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px 12px;
    }

    .individual-info-label {
        display: block;
        font-size: .68rem;
        font-weight: 700;
        color: var(--ink3);
        margin-bottom: 2px;
    }

    .individual-info-value {
        display: block;
        font-size: .76rem;
        font-weight: 900;
        color: var(--ink);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .individual-priority {
        background: #f8fafc;
        border: 1px solid var(--line);
        border-radius: var(--r-sm);
        padding: 12px 14px;
    }

        .individual-priority.completed {
            background: #f0fdf4;
            border-color: rgba(34,197,94,.16);
        }

        .individual-priority.expired {
            background: #fff7f7;
            border-color: rgba(239,68,68,.14);
        }

        .individual-priority.today {
            background: #fffbeb;
            border-color: rgba(245,158,11,.18);
        }

    .individual-priority-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 8px;
    }

        .individual-priority-row:last-child {
            margin-bottom: 0;
        }

    .individual-priority-label {
        font-size: .72rem;
        font-weight: 700;
        color: var(--ink2);
    }

    .individual-priority-value {
        font-size: .78rem;
        font-weight: 900;
        color: var(--ink);
    }

    .individual-progress {
        height: 7px;
        border-radius: 99px;
        background: rgba(0,0,0,.06);
        overflow: hidden;
        margin-top: 8px;
    }

    .individual-progress-fill {
        height: 100%;
        width: 100%;
        border-radius: 99px;
    }

    .fill-pending {
        background: linear-gradient(90deg,var(--p),#4ecdc4);
    }

    .fill-completed {
        background: linear-gradient(90deg,var(--green),#4ade80);
    }

    .fill-expired {
        background: linear-gradient(90deg,var(--red),#f87171);
    }

    .fill-today {
        background: linear-gradient(90deg,var(--amber),#fcd34d);
    }

    .individual-card-foot {
        padding: 14px 20px;
        border-top: 1px solid var(--line);
        background: #fafbfc;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .individual-btn {
        flex: 1;
        min-width: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 9px 14px;
        border-radius: 10px;
        border: none;
        font-family: 'Cairo', sans-serif;
        font-size: .82rem;
        font-weight: 800;
        cursor: pointer;
        text-decoration: none;
        transition: all var(--ease);
    }

        .individual-btn:hover {
            text-decoration: none;
            transform: translateY(-1px);
        }

    .btn-start {
        background: var(--p);
        color: #fff;
        box-shadow: 0 3px 10px var(--p-glow);
    }

        .btn-start:hover {
            background: var(--p-d);
            color: #fff;
        }

    .btn-result {
        background: var(--grna);
        color: #15803d;
        border: 1px solid rgba(34,197,94,.2);
    }

        .btn-result:hover {
            background: rgba(34,197,94,.2);
            color: #15803d;
        }

    .btn-report {
        background: var(--p-a);
        color: var(--p-d);
        border: 1px solid rgba(46,158,158,.2);
    }

        .btn-report:hover {
            background: rgba(46,158,158,.2);
            color: var(--p-d);
        }

    .btn-disabled {
        background: #f1f5f9;
        color: var(--ink3);
        border: 1px solid var(--line);
        cursor: not-allowed;
    }

        .btn-disabled:hover {
            transform: none;
            color: var(--ink3);
        }

    .individual-empty {
        text-align: center;
        padding: 60px 24px;
        background: var(--card);
        border-radius: var(--r);
        border: 1px solid var(--line);
        box-shadow: var(--sh);
    }

    .individual-empty-ico {
        font-size: 3.5rem;
        opacity: .25;
        margin-bottom: 16px;
    }

    .individual-empty h3 {
        font-size: 1rem;
        font-weight: 800;
        color: var(--ink);
        margin-bottom: 6px;
    }

    .individual-empty p {
        font-size: .85rem;
        color: var(--ink2);
        margin: 0;
    }

    .fu {
        opacity: 0;
        transform: translateY(18px);
        animation: fu .45s ease forwards;
    }

    @@keyframes fu {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .d1 {
        animation-delay: .04s;
    }

    .d2 {
        animation-delay: .1s;
    }

    @@media(max-width:700px) {
        .individual-hero {
            padding: 22px 16px 40px;
        }

        .individual-hero-text h1 {
            font-size: 1.15rem;
        }

        .individual-hero-inner {
            flex-direction: column;
            align-items: flex-start;
        }

        .individual-search {
            width: 100%;
            margin-right: 0;
        }

            .individual-search input {
                min-width: 0;
                flex: 1;
            }

        .individual-grid {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .individual-sort {
            margin-right: 0;
            width: 100%;
        }

        .individual-toolbar {
            gap: 6px;
        }

        .individual-info-grid {
            grid-template-columns: 1fr;
        }

        .individual-card-foot {
            padding: 12px 14px;
        }

        .individual-alert {
            padding: 12px 14px;
        }
    }
</style>

<div class="individual-switcher">
    @await Component.InvokeAsync("StudentCourseSwitcher")
</div>

<div class="individual-exams-page">

    <!-- HERO -->
    <div class="individual-hero fu">
        <div class="individual-hero-inner">
            <div class="individual-hero-ico">
                <i class="fa-solid fa-user-check"></i>
            </div>

            <div class="individual-hero-text">
                <h1>الاختبارات الفردية</h1>
                <p>اختبارات مخصصة لك فقط — ابدأ الاختبار المتاح، وراجع النتائج والتقارير بعد التسليم.</p>
            </div>

            <div class="individual-search">
                <span class="individual-search-ico">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <input type="text"
                       id="individual-search-input"
                       placeholder="ابحث عن اختبار فردي…"
                       oninput="applyIndividualFilters()">
            </div>
        </div>

        <div class="individual-hero-stats">
            <span class="individual-hstat">
                <span class="individual-hstat-dot" style="background:#2e9e9e"></span>
                الإجمالي: @total
            </span>

            <span class="individual-hstat">
                <span class="individual-hstat-dot" style="background:#22c55e"></span>
                المنتهية: @completed
            </span>

            <span class="individual-hstat">
                <span class="individual-hstat-dot" style="background:#f59e0b"></span>
                المتبقية: @pending
            </span>

            <span class="individual-hstat">
                <span class="individual-hstat-dot" style="background:#8b5cf6"></span>
                تنتهي اليوم: @endingToday
            </span>
        </div>
    </div>

    <!-- TOOLBAR -->
    <div class="individual-toolbar fu d1">
        <button type="button"
                class="individual-filter-btn active"
                data-filter="all"
                onclick="setIndividualFilter(this)">
            <i class="fa-solid fa-layer-group" style="font-size:.75rem"></i>
            الكل <span class="fbadge">@total</span>
        </button>

        <button type="button"
                class="individual-filter-btn"
                data-filter="pending"
                onclick="setIndividualFilter(this)">
            <i class="fa-solid fa-play" style="font-size:.75rem"></i>
            لم يُحل <span class="fbadge">@pending</span>
        </button>

        <button type="button"
                class="individual-filter-btn"
                data-filter="completed"
                onclick="setIndividualFilter(this)">
            <i class="fa-solid fa-circle-check" style="font-size:.75rem"></i>
            منتهي <span class="fbadge">@completed</span>
        </button>

        <button type="button"
                class="individual-filter-btn"
                data-filter="today"
                onclick="setIndividualFilter(this)">
            <i class="fa-solid fa-calendar-day" style="font-size:.75rem"></i>
            تنتهي اليوم <span class="fbadge">@endingToday</span>
        </button>

        <div class="individual-sort">
            <label for="individual-sort-sel">
                <i class="fa-solid fa-arrow-up-wide-short" style="font-size:.75rem"></i>
                ترتيب:
            </label>

            <select id="individual-sort-sel" onchange="applyIndividualFilters()">
                <option value="end-asc">الأقرب انتهاءً</option>
                <option value="end-desc">الأبعد انتهاءً</option>
                <option value="duration-desc">الأطول مدة</option>
                <option value="duration-asc">الأقصر مدة</option>
                <option value="title-asc">العنوان تصاعديًا</option>
            </select>
        </div>
    </div>

    <!-- BODY -->
    <div style="padding:0 20px">

        @if (pending > 0)
        {
            <div class="individual-alert fu d2">
                <div class="individual-alert-icon">
                    <i class="fa-solid fa-bell"></i>
                </div>
                <div>
                    <div class="individual-alert-title">تنبيه مهم</div>
                    <p class="individual-alert-text">
                        هذه الصفحة تعرض الاختبارات الفردية المخصصة لك فقط. يمكنك بدء الاختبار في أي وقت تشاء.
                    </p>
                </div>
            </div>
        }

        <div class="individual-results-label fu d2">
            يُعرض <b id="individual-count-shown">@total</b> من إجمالي @total اختبار فردي
        </div>

        <div class="individual-grid" id="individual-grid">

            @if (exams.Any())
            {
                foreach (var exam in exams)
                {
                    var title = exam.Title ?? "اختبار بدون عنوان";
                    var endAt = exam.EndAt;
                    var isEndingToday = !exam.IsCompleted && endAt.HasValue && endAt.Value.Date == today;

                    var statusKey = exam.IsCompleted
                    ? "completed"
                    : isEndingToday
                    ? "today"
                    : "pending";

                    var statusText = exam.IsCompleted
                    ? "منتهي"
                    : isEndingToday
                    ? "ينتهي اليوم"
                    : "لم يُحل";

                    var icon = exam.IsCompleted
                    ? "fa-circle-check"
                    : isEndingToday
                    ? "fa-clock"
                    : "fa-circle-play";

                    var stripeClass = $"stripe-{statusKey}";
                    var iconClass = $"ico-{statusKey}";
                    var statusClass = $"st-{statusKey}";
                    var priorityClass = statusKey;
                    var fillClass = $"fill-{statusKey}";

                    var endSort = endAt.HasValue
                    ? endAt.Value.ToString("yyyyMMddHHmm")
                    : "999999999999";

                    var actionText = exam.IsCompleted
                    ? "متاح للمراجعة"
                    : "بدء الاختبار وتسليمه";

                    <div class="individual-card"
                         data-status="@statusKey"
                         data-title="@title.ToLower()"
                         data-end="@endSort"
                         data-duration="@exam.DurationMinutes">

                        <div class="individual-card-stripe @stripeClass"></div>

                        <div class="individual-card-body">

                            <div class="individual-card-top">
                                <div class="individual-card-ico @iconClass">
                                    <i class="fa-solid @icon"></i>
                                </div>

                                <div style="flex:1;min-width:0">
                                    <div class="individual-card-title">@title</div>

                                    <div class="individual-card-meta">
                                        <span class="individual-tag tag-individual">
                                            <i class="fa-solid fa-user"></i>
                                            فردي
                                        </span>

                                        @if (exam.IsParentRequest)
                                        {
                                            <span class="individual-tag" style="background:#fff4e6;color:#c05621;border-color:rgba(192,86,33,.2);">
                                                <i class="fa-solid fa-heart"></i>
                                                من ولي أمرك
                                            </span>
                                        }

                                        <span class="individual-status @statusClass">
                                            @statusText
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="individual-info-box">
                                <div class="individual-info-grid">
                                    <div>
                                        <span class="individual-info-label">مدة الاختبار</span>
                                        <span class="individual-info-value">@exam.DurationMinutes دقيقة</span>
                                    </div>

                                    <div>
                                        <span class="individual-info-label">ينتهي في</span>
                                        <span class="individual-info-value">
                                            @(endAt.HasValue? endAt.Value.ToString("yyyy/MM/dd HH:mm") : "غير محدد")
                                        </span>
                                    </div>

                                    <div>
                                        <span class="individual-info-label">نوع الاختبار</span>
                                        <span class="individual-info-value">فردي</span>
                                    </div>

                                    <div>
                                        <span class="individual-info-label">الحالة</span>
                                        <span class="individual-info-value">@statusText</span>
                                    </div>
                                </div>
                            </div>

                            <div class="individual-priority @priorityClass">
                                <div class="individual-priority-row">
                                    <span class="individual-priority-label">الإجراء</span>
                                    <span class="individual-priority-value">@actionText</span>
                                </div>

                                <div class="individual-priority-row">
                                    <span class="individual-priority-label">الأولوية</span>
                                    <span class="individual-priority-value">
                                        @(isEndingToday ? "عاجل" : exam.IsCompleted ? "مكتمل" : "متاح")
                                    </span>
                                </div>

                                <div class="individual-progress">
                                    <div class="individual-progress-fill @fillClass"></div>
                                </div>
                            </div>

                        </div>

                        <div class="individual-card-foot">
                            @if (!exam.IsCompleted)
                            {
                                <a asp-area="Students"
                                   asp-controller="StudentExamFlow"
                                   asp-action="StartIndividualExam"
                                   asp-route-examAssignmentId="@exam.ExamAssignmentId"
                                   class="individual-btn btn-start">
                                    <i class="fa-solid fa-play"></i>
                                    بدء
                                </a>
                            }
                            else
                            {
                                <a asp-area="Students"
                                   asp-controller="StudentExamResults"
                                   asp-action="ExamResult"
                                   asp-route-id="@exam.ExamAssignmentId"
                                   asp-route-source="individual"
                                   class="individual-btn btn-result">
                                    <i class="fa-solid fa-chart-line"></i>
                                    نتيجة
                                </a>

                                <a asp-area="Students"
                                   asp-controller="StudentExamResults"
                                   asp-action="ExamReport"
                                   asp-route-examAssignmentId="@exam.ExamAssignmentId"
                                   class="individual-btn btn-report">
                                    <i class="fa-solid fa-file-lines"></i>
                                    تقرير
                                </a>

                                <a asp-area="Students"
                                   asp-controller="StudentExamFlow"
                                   asp-action="RetakeIndividualExam"
                                   asp-route-examAssignmentId="@exam.ExamAssignmentId"
                                   class="individual-btn btn-start">
                                    <i class="fa-solid fa-rotate-right"></i>
                                    إعادة المحاولة
                                </a>
                            }
                        </div>

                    </div>
                }
            }

        </div>

        <div class="individual-empty" id="individual-empty" style="display:@(total == 0 ? "block" : "none")">
            <div class="individual-empty-ico">📭</div>
            <h3>لا توجد اختبارات فردية حاليًا</h3>
            <p>عند تخصيص اختبار فردي لك سيظهر هنا مباشرة.</p>
        </div>

    </div>
</div>

<script>
    const individualCards = Array.from(document.querySelectorAll('.individual-card'));
    let currentIndividualFilter = 'all';

    function setIndividualFilter(btn) {
        document.querySelectorAll('.individual-filter-btn').forEach(function (b) {
            b.classList.remove('active');
        });

        btn.classList.add('active');
        currentIndividualFilter = btn.dataset.filter;
        applyIndividualFilters();
    }

    function applyIndividualFilters() {
        const searchInput = document.getElementById('individual-search-input');
        const sortSelect = document.getElementById('individual-sort-sel');
        const grid = document.getElementById('individual-grid');
        const countShown = document.getElementById('individual-count-shown');
        const empty = document.getElementById('individual-empty');

        const q = searchInput ? searchInput.value.toLowerCase().trim() : '';
        const sort = sortSelect ? sortSelect.value : 'end-asc';

        let visible = individualCards.filter(function (card) {
            let matchFilter = false;

            if (currentIndividualFilter === 'all') {
                matchFilter = true;
            } else if (currentIndividualFilter === 'pending') {
                matchFilter = card.dataset.status === 'pending' || card.dataset.status === 'today';
            } else {
                matchFilter = card.dataset.status === currentIndividualFilter;
            }

            const matchSearch = !q || (card.dataset.title || '').indexOf(q) >= 0;

            return matchFilter && matchSearch;
        });

        visible.sort(function (a, b) {
            if (sort === 'end-asc') {
                return (a.dataset.end || '').localeCompare(b.dataset.end || '');
            }

            if (sort === 'end-desc') {
                return (b.dataset.end || '').localeCompare(a.dataset.end || '');
            }

            if (sort === 'duration-desc') {
                return (+b.dataset.duration || 0) - (+a.dataset.duration || 0);
            }

            if (sort === 'duration-asc') {
                return (+a.dataset.duration || 0) - (+b.dataset.duration || 0);
            }

            if (sort === 'title-asc') {
                return (a.dataset.title || '').localeCompare(b.dataset.title || '', 'ar');
            }

            return 0;
        });

        const visibleSet = new Set(visible);

        individualCards.forEach(function (card) {
            if (visibleSet.has(card)) {
                card.style.display = '';
                grid.appendChild(card);
            } else {
                card.style.display = 'none';
            }
        });

        if (countShown) {
            countShown.textContent = visible.length;
        }

        if (empty) {
            empty.style.display = visible.length ? 'none' : 'block';
        }
    }

    applyIndividualFilters();
</script>