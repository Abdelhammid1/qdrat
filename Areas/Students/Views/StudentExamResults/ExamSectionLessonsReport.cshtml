@model List<QdratNew.ViewModels.Reports.ExamLessonSummaryVm>

<div class="container py-4">
    <h3 class="fw-bold text-primary mb-4">المؤشرات داخل المحور: @ViewBag.SectionTitle</h3>

    <table class="table table-hover text-center align-middle">
        <thead class="table-light">
            <tr>
                <th>المؤشر (الدرس)</th>
                <th>عدد الأسئلة</th>
                <th>صحيحة</th>
                <th>خاطئة</th>
                <th>متخطاة</th>
                <th>عرض الأسئلة</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in Model)
            {
                <tr>
                    <td>@l.LessonTitle</td>
                    <td>@l.TotalQuestions</td>
                    <td class="text-success">@l.Correct</td>
                    <td class="text-danger">@l.Wrong</td>
                    <td class="text-warning">@l.Skipped</td>
                    <td>
                        <a class="btn btn-outline-primary btn-sm"
                           asp-action="LessonQuestions"
                           asp-route-lessonId="@l.LessonId"
                           asp-route-examAssignmentId="@ViewBag.ExamAssignmentId">
                            عرض الأسئلة
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
