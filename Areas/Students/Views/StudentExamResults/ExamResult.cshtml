@model QdratNew.ViewModels.Students.ExamResultViewModel
@using QdratNew.Helpers

@{
    ViewData["Title"] = "نتيجة الاختبار";
    var pct = Model.ScorePercentage;

    var tone = ResultToneHelper.Build(pct, ResultContext.Exam);

    string themeCss      = tone.ThemeCss;
    string heroTitle     = tone.Title;
    string heroSubtitle  = tone.Subtitle;
    string motivationMsg = tone.MotivationMsg;
}

@if (TempData["ErrorMessage"] != null)
{
    <script>
        Swal.fire({
            icon: "info",
            title: "تنبيه",
            text: "@TempData["ErrorMessage"]",
            confirmButtonText: "عرض النتيجة"
        });
    </script>
}

<!-- ============================================================
     EXAM RESULT PAGE — Complete Redesign
     ============================================================ -->

<div class="er-root @themeCss" dir="rtl">

    <!-- ─── Hero Banner ─── -->
    <div class="er-hero">
        <div class="er-hero__bg-shapes">
            <span class="shape s1"></span>
            <span class="shape s2"></span>
            <span class="shape s3"></span>
        </div>

        @if (tone.ShowCelebration)
        {
            <div class="er-fireworks" id="fireworks" aria-hidden="true"></div>
        }

        <div class="er-hero__content">

            <!-- Score Ring -->
            <div class="er-score-ring" role="img" aria-label="النتيجة @pct بالمئة">
                <svg viewBox="0 0 120 120" class="er-ring-svg" aria-hidden="true">
                    <circle class="er-ring-bg" cx="60" cy="60" r="52" />
                    <circle class="er-ring-fill" cx="60" cy="60" r="52"
                            data-pct="@pct"
                            style="--dash-target:@(Math.Round(pct / 100.0 * 326.7, 1))" />
                </svg>
                <div class="er-ring-inner">
                    <span class="er-ring-pct">
                        @NumberHelper.ToIndicNumbersSafe(((int)Math.Round(pct)).ToString())%
                    </span>
                    <span class="er-ring-label">النتيجة</span>
                </div>
            </div>

            <!-- Headline -->
            <div class="er-hero__text">
                <p class="er-hero__exam-name">@Model.ExamTitle</p>
                <h1 class="er-hero__title">@heroTitle</h1>
                <p class="er-hero__subtitle">@heroSubtitle</p>
                <span class="er-badge @tone.BadgeCss">@tone.BadgeText</span>
            </div>

        </div>
    </div>

    <!-- ─── Stats Grid ─── -->
    <div class="er-stats">
        <div class="er-stat er-stat--total">
            <div class="er-stat__icon">📋</div>
            <div class="er-stat__num">
                @NumberHelper.ToIndicNumbersSafe(Model.TotalQuestions.ToString())
            </div>
            <div class="er-stat__label">إجمالي الأسئلة</div>
        </div>

        <div class="er-stat er-stat--correct">
            <div class="er-stat__icon">✅</div>
            <div class="er-stat__num">
                @NumberHelper.ToIndicNumbersSafe(Model.CorrectAnswers.ToString())
            </div>
            <div class="er-stat__label">إجابات صحيحة</div>
        </div>

        <div class="er-stat er-stat--wrong">
            <div class="er-stat__icon">❌</div>
            <div class="er-stat__num">
                @NumberHelper.ToIndicNumbersSafe(Model.WrongAnswers.ToString())
            </div>
            <div class="er-stat__label">إجابات خاطئة</div>
        </div>

        <div class="er-stat er-stat--skipped">
            <div class="er-stat__icon">⏭️</div>
            <div class="er-stat__num">
                @NumberHelper.ToIndicNumbersSafe(Model.SkippedQuestions.ToString())
            </div>
            <div class="er-stat__label">متخطاة</div>
        </div>
    </div>

    <!-- ─── Progress Bar ─── -->
    <div class="er-progress-wrap">
        <div class="er-progress-bar-track">
            <div class="er-progress-bar-fill" data-width="@pct" style="--bar-width:@(pct)%">
                <span class="er-progress-bar-glow"></span>
            </div>
        </div>
        <div class="er-progress-labels">
            <span>٠٪</span>
            <span>٥٠٪</span>
            <span>١٠٠٪</span>
        </div>
    </div>

    <!-- ─── Motivation Card ─── -->
    <div class="er-motivation er-motivation--cheer">
        <div class="er-motivation__icon">
            @(tone.Tier == "excellent" ? "🏆" : tone.Tier == "strong" ? "🌟" : tone.Tier == "onTrack" ? "📈" : "🧭")
        </div>
        <div class="er-motivation__body">
            <h3 class="er-motivation__heading">@tone.MotivationHeading</h3>
            <p class="er-motivation__msg">@motivationMsg</p>
        </div>
        @if (tone.IsLowTier)
        {
            <div class="er-motivation__quotes">
                <blockquote>التقدّم وليس الكمال — ابدأ بمحور واحد اليوم.</blockquote>
            </div>
        }
    </div>

    <!-- ─── Actions ─── -->
    <div class="er-actions">
        <a asp-area="Students"
           asp-controller="StudentExamResults"
           asp-action="ExamReview"
           asp-route-examAssignmentId="@Model.ExamAssignmentId"
           class="er-btn er-btn--primary">
            <i class="fa-solid fa-list-check"></i>
            مراجعة الأسئلة
        </a>
        <a asp-area="Students"
           asp-controller="StudentExamPages"
           asp-action="AllExams"
           class="er-btn er-btn--secondary">
            <i class="fa-solid fa-arrow-right"></i>
            العودة للاختبارات
        </a>
    </div>

</div>

<!-- ============================================================
     STYLES
     ============================================================ -->
<style>
    /* ── Custom Properties ── */
    :root {
        --er-font: 'Cairo', 'Tajawal', system-ui, sans-serif;
        --er-radius-lg: 24px;
        --er-radius-md: 16px;
        --er-radius-sm: 10px;
        --er-shadow-md: 0 8px 32px rgba(0,0,0,.12);
        --er-shadow-lg: 0 16px 56px rgba(0,0,0,.18);
        --er-transition: .35s cubic-bezier(.4,0,.2,1);
    }

    /* Themes */
    .theme-excellent {
        --er-primary:   #f5a623;
        --er-secondary: #e67e22;
        --er-accent:    #f39c12;
        --er-hero-from: #1a1a2e;
        --er-hero-to:   #16213e;
        --er-ring-color:#f5a623;
        --er-bar-color: linear-gradient(90deg,#f39c12,#f5a623,#ffef00);
    }
    .theme-good {
        --er-primary:   #27ae60;
        --er-secondary: #2ecc71;
        --er-accent:    #1abc9c;
        --er-hero-from: #0d3321;
        --er-hero-to:   #0a2e20;
        --er-ring-color:#27ae60;
        --er-bar-color: linear-gradient(90deg,#1abc9c,#27ae60,#2ecc71);
    }
    .theme-acceptable {
        --er-primary:   #2980b9;
        --er-secondary: #3498db;
        --er-accent:    #1abc9c;
        --er-hero-from: #0b2340;
        --er-hero-to:   #0d1f3c;
        --er-ring-color:#3498db;
        --er-bar-color: linear-gradient(90deg,#2980b9,#3498db,#5dade2);
    }
    .theme-failed {
        --er-primary:   #c0392b;
        --er-secondary: #e74c3c;
        --er-accent:    #e67e22;
        --er-hero-from: #2c0b0e;
        --er-hero-to:   #3b0f0f;
        --er-ring-color:#e74c3c;
        --er-bar-color: linear-gradient(90deg,#c0392b,#e74c3c,#f1948a);
    }
    /* الشريحة الأدنى: ثيم "نمو" هادئ بدل الإنذار الأحمر */
    .theme-growth {
        --er-primary:   #7c3aed;
        --er-secondary: #8b5cf6;
        --er-accent:    #6366f1;
        --er-hero-from: #1e1b4b;
        --er-hero-to:   #172554;
        --er-ring-color:#8b5cf6;
        --er-bar-color: linear-gradient(90deg,#6366f1,#8b5cf6,#a78bfa);
    }

    /* ── Root ── */
    .er-root {
        font-family: var(--er-font);
        direction: rtl;
        max-width: 860px;
        margin: 0 auto;
        padding: 0 0 56px;
    }

    /* ── Hero ── */
    .er-hero {
        position: relative;
        background: linear-gradient(135deg, var(--er-hero-from), var(--er-hero-to));
        border-radius: 0 0 var(--er-radius-lg) var(--er-radius-lg);
        padding: 60px 32px 48px;
        overflow: hidden;
        color: #fff;
    }
    .er-hero__bg-shapes { position: absolute; inset: 0; pointer-events: none; }
    .er-hero__bg-shapes .shape {
        position: absolute;
        border-radius: 50%;
        opacity: .07;
        background: var(--er-primary);
    }
    .shape.s1 { width: 320px; height: 320px; top: -80px; left: -80px; }
    .shape.s2 { width: 200px; height: 200px; bottom: -60px; right: -40px; }
    .shape.s3 { width: 120px; height: 120px; top: 40%; left: 50%; }

    .er-hero__content {
        position: relative;
        z-index: 1;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 32px;
    }

    /* ── Ring ── */
    .er-score-ring {
        position: relative;
        width: 160px;
        height: 160px;
        flex-shrink: 0;
        margin: 0 auto;
        filter: drop-shadow(0 0 18px color-mix(in srgb, var(--er-ring-color) 60%, transparent));
    }
    .er-ring-svg { width: 100%; height: 100%; transform: rotate(-90deg); }
    .er-ring-bg {
        fill: none;
        stroke: rgba(255,255,255,.1);
        stroke-width: 8;
    }
    .er-ring-fill {
        fill: none;
        stroke: var(--er-ring-color);
        stroke-width: 8;
        stroke-linecap: round;
        stroke-dasharray: 326.7;
        stroke-dashoffset: 326.7;
        transition: stroke-dashoffset 1.6s cubic-bezier(.4,0,.2,1) .4s;
    }
    .er-ring-inner {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2px;
    }
    .er-ring-pct {
        font-size: 2.1rem;
        font-weight: 800;
        color: #fff;
        letter-spacing: -1px;
        line-height: 1;
    }
    .er-ring-label {
        font-size: .8rem;
        color: rgba(255,255,255,.6);
        font-weight: 500;
    }

    /* ── Hero Text ── */
    .er-hero__text { flex: 1; min-width: 220px; }
    .er-hero__exam-name {
        font-size: .9rem;
        color: rgba(255,255,255,.55);
        margin: 0 0 8px;
        font-weight: 500;
    }
    .er-hero__title {
        font-size: clamp(1.6rem, 4vw, 2.4rem);
        font-weight: 800;
        margin: 0 0 10px;
        line-height: 1.2;
    }
    .er-hero__subtitle {
        font-size: 1rem;
        color: rgba(255,255,255,.75);
        margin: 0 0 16px;
        line-height: 1.7;
    }
    .er-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 18px;
        border-radius: 100px;
        font-weight: 700;
        font-size: .9rem;
        letter-spacing: .5px;
    }
    .er-badge--pass { background: rgba(46,204,113,.2); color: #2ecc71; border: 1px solid rgba(46,204,113,.4); }
    .er-badge--fail { background: rgba(231,76,60,.2);  color: #e74c3c; border: 1px solid rgba(231,76,60,.4); }
    .er-badge--progress { background: rgba(139,92,246,.18); color: #a78bfa; border: 1px solid rgba(139,92,246,.4); }

    /* ── Stats ── */
    .er-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin: 28px 24px 0;
    }
    .er-stat {
        background: #fff;
        border-radius: var(--er-radius-md);
        padding: 22px 12px 18px;
        text-align: center;
        box-shadow: var(--er-shadow-md);
        transition: transform var(--er-transition), box-shadow var(--er-transition);
        position: relative;
        overflow: hidden;
    }
    .er-stat::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 4px;
        border-radius: var(--er-radius-md) var(--er-radius-md) 0 0;
    }
    .er-stat:hover { transform: translateY(-4px); box-shadow: var(--er-shadow-lg); }
    .er-stat--total::before  { background: #8e44ad; }
    .er-stat--correct::before { background: #27ae60; }
    .er-stat--wrong::before   { background: #e74c3c; }
    .er-stat--skipped::before { background: #f39c12; }

    .er-stat__icon { font-size: 1.6rem; margin-bottom: 8px; line-height: 1; }
    .er-stat__num  { font-size: 2rem; font-weight: 800; color: #1a1a2e; line-height: 1; margin-bottom: 4px; }
    .er-stat__label { font-size: .8rem; color: #6b7280; font-weight: 500; }

    /* ── Progress Bar ── */
    .er-progress-wrap {
        margin: 28px 24px 0;
        background: #fff;
        border-radius: var(--er-radius-md);
        padding: 24px 28px;
        box-shadow: var(--er-shadow-md);
    }
    .er-progress-bar-track {
        height: 14px;
        background: #f1f3f4;
        border-radius: 100px;
        overflow: hidden;
        position: relative;
    }
    .er-progress-bar-fill {
        height: 100%;
        border-radius: 100px;
        background: var(--er-bar-color);
        width: 0;
        transition: width 1.8s cubic-bezier(.4,0,.2,1) .6s;
        position: relative;
    }
    .er-progress-bar-glow {
        position: absolute;
        top: 0; right: 0; bottom: 0;
        width: 40px;
        background: linear-gradient(90deg,transparent,rgba(255,255,255,.5));
        animation: barGlow 2s ease-in-out infinite;
    }
    @@keyframes barGlow {
        0%,100% { opacity:0; }
        50%      { opacity:1; }
    }
    .er-progress-labels {
        display: flex;
        justify-content: space-between;
        margin-top: 8px;
        font-size: .78rem;
        color: #9ca3af;
        font-weight: 600;
    }

    /* ── Motivation ── */
    .er-motivation {
        margin: 20px 24px 0;
        border-radius: var(--er-radius-md);
        padding: 28px 24px;
        box-shadow: var(--er-shadow-md);
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        align-items: flex-start;
    }
    .er-motivation--cheer {
        background: linear-gradient(135deg, #f0fdf4, #ecfdf5);
        border: 1px solid #a7f3d0;
    }
    .er-motivation--shock {
        background: linear-gradient(135deg, #fff7f0, #fff1f0);
        border: 1px solid #fca5a5;
    }
    .er-motivation__icon { font-size: 3rem; flex-shrink: 0; filter: drop-shadow(0 2px 6px rgba(0,0,0,.15)); }
    .er-motivation__body { flex: 1; min-width: 220px; }
    .er-motivation__heading {
        font-size: 1.2rem;
        font-weight: 800;
        color: #1a1a2e;
        margin: 0 0 8px;
    }
    .er-motivation__msg {
        font-size: 1rem;
        color: #374151;
        margin: 0;
        line-height: 1.7;
    }
    .er-motivation__quotes {
        width: 100%;
        border-top: 1px dashed #fca5a5;
        padding-top: 16px;
        margin-top: 4px;
    }
    .er-motivation__quotes blockquote {
        font-size: .95rem;
        color: #6b7280;
        font-style: italic;
        margin: 0 0 4px;
        padding-right: 12px;
        border-right: 3px solid #e74c3c;
    }
    .er-motivation__quotes cite { font-size: .82rem; color: #9ca3af; }

    /* ── Actions ── */
    .er-actions {
        display: flex;
        gap: 14px;
        justify-content: center;
        flex-wrap: wrap;
        margin: 32px 24px 0;
    }
    .er-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 32px;
        border-radius: 100px;
        font-family: var(--er-font);
        font-size: 1rem;
        font-weight: 700;
        text-decoration: none;
        transition: transform var(--er-transition), box-shadow var(--er-transition);
        cursor: pointer;
        border: none;
    }
    .er-btn:hover { transform: translateY(-2px); }
    .er-btn--primary {
        background: var(--er-primary);
        color: #fff;
        box-shadow: 0 6px 24px color-mix(in srgb, var(--er-primary) 40%, transparent);
    }
    .er-btn--primary:hover { box-shadow: 0 10px 32px color-mix(in srgb, var(--er-primary) 55%, transparent); color: #fff; }
    .er-btn--secondary {
        background: #fff;
        color: #374151;
        box-shadow: 0 4px 16px rgba(0,0,0,.1);
        border: 1px solid #e5e7eb;
    }
    .er-btn--secondary:hover { color: #374151; box-shadow: 0 8px 24px rgba(0,0,0,.15); }

    /* ── Fireworks (Excellent) ── */
    .er-fireworks {
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
    }
    .fw-particle {
        position: absolute;
        width: 8px; height: 8px;
        border-radius: 50%;
        animation: fwFly 1.4s ease-out forwards;
    }
    @@keyframes fwFly {
        0%   { transform: translate(0,0) scale(1); opacity: 1; }
        100% { transform: translate(var(--dx), var(--dy)) scale(0); opacity: 0; }
    }

    /* ── Rain (Failed) ── */
    .er-rain {
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
    }
    .rain-drop {
        position: absolute;
        width: 2px;
        background: linear-gradient(to bottom, transparent, rgba(231,76,60,.4));
        animation: rainFall linear infinite;
        top: -60px;
        border-radius: 2px;
    }
    @@keyframes rainFall {
        to { transform: translateY(300px); opacity: 0; }
    }

    /* ── Responsive ── */
    @@media (max-width: 640px) {
        .er-hero { padding: 40px 16px 36px; }
        .er-hero__content { flex-direction: column; align-items: center; text-align: center; }
        .er-score-ring { width: 130px; height: 130px; }
        .er-stats { grid-template-columns: repeat(2, 1fr); margin: 20px 12px 0; }
        .er-progress-wrap, .er-motivation { margin-left: 12px; margin-right: 12px; }
        .er-actions { margin-left: 12px; margin-right: 12px; }
        .er-ring-pct { font-size: 1.7rem; }
    }

    /* ── Dark Mode ── */
    @@media (prefers-color-scheme: dark) {
        .er-stat { background: #1e2433; }
        .er-stat__num { color: #f9fafb; }
        .er-progress-wrap { background: #1e2433; }
        .er-progress-bar-track { background: #2d3748; }
        .er-motivation--cheer { background: #0d2318; border-color: #134e2a; }
        .er-motivation--shock  { background: #2c1010; border-color: #7f1d1d; }
        .er-motivation__heading { color: #f9fafb; }
        .er-motivation__msg { color: #d1d5db; }
        .er-btn--secondary { background: #1e2433; color: #d1d5db; border-color: #374151; }
        .er-btn--secondary:hover { color: #f9fafb; }
    }
</style>

<!-- ============================================================
     SCRIPTS
     ============================================================ -->
<script>
(function () {
    'use strict';

    // ── Animate ring ──────────────────────────────────────────
    const ring = document.querySelector('.er-ring-fill');
    if (ring) {
        const pct = parseFloat(ring.dataset.pct) || 0;
        const circumference = 326.7;
        const offset = circumference - (pct / 100) * circumference;
        requestAnimationFrame(() => {
            ring.style.strokeDashoffset = offset;
        });
    }

    // ── Animate progress bar ──────────────────────────────────
    const bar = document.querySelector('.er-progress-bar-fill');
    if (bar) {
        requestAnimationFrame(() => {
            bar.style.width = bar.dataset.width + '%';
        });
    }

    // ── Animate stat numbers (count-up) ──────────────────────
    document.querySelectorAll('.er-stat__num').forEach(el => {
        const target = parseInt(el.textContent.replace(/[^\d]/g, '')) || 0;
        if (target === 0) return;
        let current = 0;
        const step = Math.max(1, Math.floor(target / 40));
        const timer = setInterval(() => {
            current = Math.min(current + step, target);
            el.textContent = current.toLocaleString('ar-SA');
            if (current >= target) clearInterval(timer);
        }, 30);
    });

    // ── Fireworks for excellent ───────────────────────────────
    const fireworksEl = document.getElementById('fireworks');
    if (fireworksEl) {
        const colors = ['#f5a623','#e74c3c','#3498db','#2ecc71','#9b59b6','#ffef00','#1abc9c'];
        function burst(x, y) {
            for (let i = 0; i < 22; i++) {
                const p = document.createElement('span');
                p.className = 'fw-particle';
                const angle = (i / 22) * 2 * Math.PI;
                const dist = 60 + Math.random() * 80;
                p.style.cssText = `
                    left:${x}px; top:${y}px;
                    background:${colors[i % colors.length]};
                    --dx:${Math.cos(angle) * dist}px;
                    --dy:${Math.sin(angle) * dist}px;
                    animation-duration:${1.1 + Math.random() * .6}s;
                    animation-delay:${Math.random() * .2}s;
                `;
                fireworksEl.appendChild(p);
                p.addEventListener('animationend', () => p.remove());
            }
        }
        let runs = 0;
        function fireLoop() {
            if (runs >= 8) return;
            runs++;
            const w = fireworksEl.offsetWidth;
            const h = fireworksEl.offsetHeight;
            burst(Math.random() * w, Math.random() * h * .8);
            setTimeout(fireLoop, 300 + Math.random() * 400);
        }
        setTimeout(fireLoop, 600);
    }

    // ── Rain for failed ───────────────────────────────────────
    const rainEl = document.getElementById('rain');
    if (rainEl) {
        for (let i = 0; i < 28; i++) {
            const drop = document.createElement('span');
            drop.className = 'rain-drop';
            drop.style.cssText = `
                left:${Math.random() * 100}%;
                height:${18 + Math.random() * 30}px;
                animation-duration:${.7 + Math.random() * .8}s;
                animation-delay:${Math.random() * 1.5}s;
                opacity:${.3 + Math.random() * .4};
            `;
            rainEl.appendChild(drop);
        }
    }

    // ── Entrance animation on stats cards ────────────────────
    if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(entries => {
            entries.forEach((e, idx) => {
                if (e.isIntersecting) {
                    setTimeout(() => e.target.style.opacity = '1', idx * 90);
                    io.unobserve(e.target);
                }
            });
        }, { threshold: .15 });
        document.querySelectorAll('.er-stat').forEach(el => {
            el.style.opacity = '0';
            el.style.transition = 'opacity .4s ease, transform .35s cubic-bezier(.4,0,.2,1)';
            io.observe(el);
        });
    }
})();
</script>
