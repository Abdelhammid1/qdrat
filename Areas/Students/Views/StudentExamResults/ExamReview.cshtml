        border: 1px solid var(--q-border);
    }

    .fc-time {
        background: var(--q-warning-lt);
        color: var(--q-warning);
        margin-right: auto;
    }

    .ltr-mode .fc-time {
        margin-right: 0;
        margin-left: auto;
    }

    .qlb-empty {
        border: 1px dashed var(--q-border);
        background: var(--q-skip-lt);
        color: var(--q-muted);
        border-radius: 14px;
        padding: 1.5rem;
        text-align: center;
        font-size: .9rem;
        font-weight: 900;
    }

    .qlb-back-wrap {
        display: flex;
        justify-content: center;
        margin-top: 2rem;
    }

    .qlb-back-link {
        background: #ffffff;
        border: 1px solid var(--q-border);
        color: var(--q-text);
        border-radius: 12px;
        padding: .75rem 1.1rem;
        font-weight: 900;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        box-shadow: var(--q-shadow);
        transition: transform .2s, box-shadow .2s, background .2s;
    }

        .qlb-back-link:hover {
            color: var(--q-primary);
            background: var(--q-primary-lt);
            transform: translateY(-1px);
            box-shadow: var(--q-shadow-lg);
            text-decoration: none;
        }

    @@media (max-width: 992px) {
        .qlb-stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .qlb-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 576px) {
        .qlb-page {
            padding: 1rem .7rem 3rem;
        }

        .qlb-hero {
            padding: 1.5rem 1.1rem;
        }

        .qlb-stats {
            grid-template-columns: 1fr;
        }

        .qlb-card-foot {
            align-items: stretch;
        }

        .qlb-foot-chip {
            width: 100%;
            justify-content: center;
        }

        .qlb-time-chip {
            width: 100%;
            margin-right: 0;
            margin-left: 0;
        }

        .fc-time {
            margin-right: 0;
            margin-left: 0;
        }

        .qlb-compare {
            grid-template-columns: 1fr;
        }

        .qlb-cmp-vs {
            display: none;
        }
    }
</style>

<div class="@(isRTL ? "rtl-mode" : "ltr-mode")">
    <div class="qlb-page" dir="@(isRTL ? "rtl" : "ltr")">
        <div class="qlb-shell">

            <!-- Hero -->
            <div class="qlb-hero">
                <div class="qlb-hero-content">
                    <div class="qlb-hero-icon">
                        <i class="fas fa-file-circle-check"></i>
                    </div>

                    <h1>@T("مراجعة أسئلة الاختبار")</h1>

                    <p class="qlb-hero-subtitle">
                        @T("مراجعة إجاباتك داخل الاختبار مع عرض الإجابة الصحيحة وشرح السؤال عند توفره.")
                    </p>

                    <div class="qlb-hero-meta">
                        <span class="qlb-hero-pill">
                            <i class="fas fa-clipboard-list"></i>
                            @Model.ExamTitle
                        </span>

                        <span class="qlb-hero-pill">
                            <i class="fas fa-question-circle"></i>
                            @T("إجمالي الأسئلة"): @ConvertGeneralNumber(totalQuestions.ToString())
                        </span>

                        <span class="qlb-hero-pill">
                            <i class="fas fa-clock"></i>
                            @T("الوقت المستغرق"): @Model.TimeSpentFormatted
                        </span>
                    </div>
                </div>
            </div>

            <!-- Stats -->
            <div class="qlb-stats">
                <div class="qlb-stat">
                    <div class="qlb-stat-ico ico-blue">
                        <i class="fas fa-question-circle"></i>
                    </div>

                    <div class="qlb-stat-content">
                        <div class="qlb-stat-lbl">@T("إجمالي الأسئلة")</div>
                        <div class="qlb-stat-val">@ConvertGeneralNumber(totalQuestions.ToString())</div>
                    </div>
                </div>

                <div class="qlb-stat">
                    <div class="qlb-stat-ico ico-green">
                        <i class="fas fa-check-circle"></i>
                    </div>

                    <div class="qlb-stat-content">
                        <div class="qlb-stat-lbl">@T("إجابات صحيحة")</div>
                        <div class="qlb-stat-val" style="color:var(--q-success)">
                            @ConvertGeneralNumber(correctAnswers.ToString())
                        </div>

                        <div class="qlb-stat-bar">
                            <div class="qlb-stat-fill fill-g" style="width:@correctPercent%"></div>
                        </div>
                    </div>
                </div>

                <div class="qlb-stat">
                    <div class="qlb-stat-ico ico-red">
                        <i class="fas fa-times-circle"></i>
                    </div>

                    <div class="qlb-stat-content">
                        <div class="qlb-stat-lbl">@T("إجابات خاطئة")</div>
                        <div class="qlb-stat-val" style="color:var(--q-danger)">
                            @ConvertGeneralNumber(wrongAnswers.ToString())
                        </div>

                        <div class="qlb-stat-bar">
                            <div class="qlb-stat-fill fill-r" style="width:@wrongPercent%"></div>
                        </div>
                    </div>
                </div>

                <div class="qlb-stat">
                    <div class="qlb-stat-ico ico-amber">
                        <i class="fas fa-forward"></i>
                    </div>

                    <div class="qlb-stat-content">
                        <div class="qlb-stat-lbl">@T("أسئلة متخطاة")</div>
                        <div class="qlb-stat-val" style="color:var(--q-warning)">
                            @ConvertGeneralNumber(skippedQuestions.ToString())
                        </div>

                        <div class="qlb-stat-bar">
                            <div class="qlb-stat-fill fill-a" style="width:@skippedPercent%"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section Header -->
            <div class="qlb-section-head">
                <h2 class="qlb-section-title">
                    <i class="fas fa-table-list"></i>
                    @T("أسئلة الاختبار")
                </h2>

                <span class="qlb-section-count">
                    <i class="fas fa-question-circle"></i>
                    @ConvertGeneralNumber(totalQuestions.ToString()) @T("سؤال")
                </span>
            </div>

            <!-- Questions -->
            @if (Model.Questions != null && Model.Questions.Any())
            {
                <div class="qlb-grid">
                    @foreach (var item in Model.Questions.Select((q, index) => new { q, index }))
                    {
                        var q = item.q;
                        var questionIndex = item.index + 1;

                        Func<string?, string> convert = s =>
                        {
                            var value = s ?? string.Empty;
                            return q.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(value) : value;
                        };

                        var safeTitle = PrepareQuestionHtml(q.QuestionTitle, q.IsQuantitative);
                        var hasQuestionTitle = HasVisibleText(safeTitle);

                        var rawCmp1 = System.Net.WebUtility.HtmlDecode(convert(q.ComparisonValue1));
                        var rawCmp2 = System.Net.WebUtility.HtmlDecode(convert(q.ComparisonValue2));

                        var isSkipped = q.IsSkipped;
                        var resultClass = isSkipped ? "result-skipped" : q.IsCorrect ? "result-correct" : "result-wrong";
                        var resultIcon = isSkipped ? "fa-forward" : q.IsCorrect ? "fa-check-circle" : "fa-times-circle";
                        var resultText = isSkipped ? T("متخطى") : q.IsCorrect ? T("صحيح") : T("خطأ");

                        <div class="qlb-card">

                            <!-- Card Header -->
                            <div class="qlb-card-head">
                                <div class="qlb-qnum">
                                    @ConvertGeneralNumber(questionIndex.ToString())
                                </div>

                                <span class="qlb-result-badge @resultClass">
                                    <i class="fas @resultIcon"></i>
                                    @resultText
                                </span>

                                <span class="qlb-time-chip">
                                    <i class="fas fa-clock"></i>
                                    @T("الوقت"): @FormatQuestionTime(q.TimeTakenSeconds)
                                </span>
                            </div>

                            <!-- Card Body -->
                            <div class="qlb-card-body">

                                <!-- Verbal Passage -->
                                @if (q.VerbalPassageType == QdratNew.Enums.PassageType.Audio)
                                {
                                    <div class="qlb-media-wrap">
                                        <div class="qlb-media-label">
                                            <i class="fas fa-headphones"></i>
                                            @(string.IsNullOrWhiteSpace(q.VerbalPassageTitle) ? T("قطعة صوتية") : q.VerbalPassageTitle)
                                        </div>

                                        <audio controls preload="none">
                                            <source src="@q.VerbalPassageMediaUrl" />
                                        </audio>
                                    </div>
                                }
                                else if (q.VerbalPassageType == QdratNew.Enums.PassageType.Video)
                                {
                                    <div class="qlb-media-wrap">
                                        <div class="qlb-media-label">
                                            <i class="fas fa-video"></i>
                                            @(string.IsNullOrWhiteSpace(q.VerbalPassageTitle) ? T("قطعة مرئية") : q.VerbalPassageTitle)
                                        </div>

                                        <video controls preload="metadata">
                                            <source src="@q.VerbalPassageMediaUrl" />
                                        </video>
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(q.VerbalPassageContent))
                                {
                                    <div class="qlb-passage">
                                        <div class="qlb-passage-title">
                                            <i class="fas fa-book-open"></i>
                                            @(string.IsNullOrWhiteSpace(q.VerbalPassageTitle) ? T("قطعة نصية") : q.VerbalPassageTitle)
                                        </div>

                                        <div class="qlb-passage-text">
                                            @Html.Raw(convert(q.VerbalPassageContent))
                                        </div>
                                    </div>
                                }

                                <!-- Question Image -->
                                @if (!string.IsNullOrWhiteSpace(q.ImageUrl))
                                {
                                    <div class="qlb-qimg">
                                        <img src="@Url.Content(q.ImageUrl)" alt="صورة السؤال" loading="lazy" />
                                    </div>
                                }

                                <!-- Comparison -->
                                @if (q.DisplayType == QdratNew.Enums.QuestionDisplayType.ComparisonText ||
                                                        q.DisplayType == QdratNew.Enums.QuestionDisplayType.ComparisonWithImage)
                                {
                                    <div class="qlb-compare">
                                        <div class="qlb-cmp-box">
                                            <div>
                                                <div style="font-size:.72rem;color:var(--q-muted);margin-bottom:.25rem;">
                                                    @T("القيمة الأولى")
                                                </div>
                                                @Html.Raw(rawCmp1)
                                            </div>
                                        </div>

                                        <span class="qlb-cmp-vs">@T("مقارنة")</span>

                                        <div class="qlb-cmp-box">
                                            <div>
                                                <div style="font-size:.72rem;color:var(--q-muted);margin-bottom:.25rem;">
                                                    @T("القيمة الثانية")
                                                </div>
                                                @Html.Raw(rawCmp2)
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- Question Text -->
                                <div class="qlb-qtitle">
                                    @if (hasQuestionTitle)
                                    {
                                        @Html.Raw(safeTitle)
                                    }
                                    else
                                    {
                                        <span class="qlb-qtitle-empty">
                                            @T("نص السؤال غير متوفر.")
                                        </span>
                                    }
                                </div>

                                <!-- Options -->
                                @if (q.Options != null && q.Options.Any())
                                {
                                    <div class="qlb-options">
                                        @foreach (var optItem in q.Options.Select((option, optIndex) => new { option, optIndex }))
                                        {
                                            var option = optItem.option;
                                            var optIndex = optItem.optIndex;

                                            var isSelected = option.IsSelectedByStudent;
                                            var isCorrect = option.IsCorrect;

                                            var optCls = isCorrect ? "opt-correct"
                                            : isSelected ? "opt-wrong"
                                            : "opt-normal";

                                            var optIcon = isCorrect ? "fa-check-circle"
                                            : isSelected ? "fa-times-circle"
                                            : "fa-circle";

                                            var optionLabel = isRTL
                                            ? ((char)('أ' + optIndex)).ToString()
                                            : ((char)('A' + optIndex)).ToString();

                                            <div class="qlb-opt @optCls">

                                                <div class="qlb-opt-content">
                                                    @if (!string.IsNullOrWhiteSpace(option.ImageUrl))
                                                    {
                                                        <img src="@Url.Content(option.ImageUrl)"
                                                             alt="صورة الاختيار"
                                                             class="qlb-opt-img"
                                                             loading="lazy" />
                                                    }

                                                    @if (!string.IsNullOrWhiteSpace(option.Text))
                                                    {
                                                        <div class="qlb-opt-text">
                                                            @Html.Raw(convert(option.Text))
                                                        </div>
                                                    }

                                                    <div class="qlb-opt-tags">
                                                        @if (isSelected)
                                                        {
                                                            <span class="qlb-mini-badge badge-student">
                                                                <i class="fas fa-user-check"></i>
                                                                @T("إجابتك")
                                                            </span>
                                                        }

                                                        @if (isCorrect)
                                                        {
                                                            <span class="qlb-mini-badge badge-correct">
                                                                <i class="fas fa-check"></i>
                                                                @T("الإجابة الصحيحة")
                                                            </span>
                                                        }
                                                    </div>
                                                </div>

                                                <i class="fas @optIcon qlb-opt-icon"></i>
                                            </div>
                                        }
                                    </div>
                                }

                                <!-- Result -->
                                <div class="qlb-result-box @(isSkipped ? "is-skipped" : q.IsCorrect ? "is-correct" : "is-wrong")">
                                    <div class="qlb-result-title">
                                        <i class="fas @(isSkipped ? "fa-forward" : q.IsCorrect ? "fa-check-circle" : "fa-times-circle")"></i>
                                        @T("النتيجة")
                                    </div>

                                    <div class="qlb-result-value @(isSkipped ? "text-skip" : q.IsCorrect ? "text-ok" : "text-bad")">
                                        @if (isSkipped)
                                        {
                                            <span>⏭️ @T("متخطى")</span>
                                        }
                                        else if (q.IsCorrect)
                                        {
                                            <span>✔️ @T("صحيح")</span>
                                        }
                                        else
                                        {
                                            <span>❌ @T("خطأ")</span>
                                        }
                                    </div>
                                </div>

                                <!-- Explanation Partial -->
                                <div class="qlb-explanation-wrap">
                                    @await Html.PartialAsync("_QuestionExplanationPartial", q)
                                </div>

                            </div>

                            <!-- Card Footer -->
                            <div class="qlb-card-foot">
                                <span class="qlb-foot-chip fc-primary">
                                    <i class="fas fa-hash"></i>
                                    @T("سؤال") @ConvertGeneralNumber(questionIndex.ToString())
                                </span>

                                @if (isSkipped)
                                {
                                    <span class="qlb-foot-chip fc-skip">
                                        <i class="fas fa-forward"></i>
                                        @T("متخطى")
                                    </span>
                                }
                                else if (q.IsCorrect)
                                {
                                    <span class="qlb-foot-chip fc-success">
                                        <i class="fas fa-check"></i>
                                        @T("صحيح")
                                    </span>
                                }
                                else
                                {
                                    <span class="qlb-foot-chip fc-danger">
                                        <i class="fas fa-times"></i>
                                        @T("خطأ")
                                    </span>
                                }

                                <span class="qlb-foot-chip fc-time">
                                    <i class="fas fa-stopwatch"></i>
                                    @FormatQuestionTime(q.TimeTakenSeconds)
                                </span>
                            </div>

                        </div>
                    }
                </div>
            }
            else
            {
                <div class="qlb-empty">
                    <i class="fas fa-info-circle"></i>
                    @T("لا توجد أسئلة لعرضها.")
                </div>
            }

            <!-- Back Button -->
            <div class="qlb-back-wrap">
                <a asp-action="ExamResult"
                   asp-controller="StudentExamResults"
                   asp-route-id="@Model.ExamAssignmentId"
                   class="qlb-back-link">
                    <i class="fa-solid fa-arrow-left"></i>
                    @T("العودة إلى النتيجة")
                </a>
            </div>

        </div>
    </div>
</div>
