@model QdratNew.ViewModels.Exam.ExamReviewViewModel
@using QdratNew.Entities
@using QdratNew.Helpers

@{
    bool isRTL = Model.IsRTL;

    Func<string, string> ConvertGeneralNumber = s =>
    {
        return Model.Questions != null && Model.Questions.Any(q => q.IsQuantitative)
            ? NumberHelper.ToIndicNumbersSafe(s)
            : s;
    };

    Func<string, string> T = key =>
    {
        if (isRTL) return key;

        return key switch
        {
            "مراجعة أسئلة الاختبار" => "Exam Review",
            "مراجعة إجاباتك داخل الاختبار مع عرض الإجابة الصحيحة وشرح السؤال عند توفره." => "Review your exam answers with the correct answer and explanation when available.",
            "الوقت المستغرق" => "Time Spent",
            "إجمالي الأسئلة" => "Total Questions",
            "إجابات صحيحة" => "Correct Answers",
            "إجابات خاطئة" => "Wrong Answers",
            "أسئلة متخطاة" => "Skipped Questions",
            "أسئلة الاختبار" => "Exam Questions",
            "سؤال" => "Question",
            "النتيجة" => "Result",
            "القيمة الأولى" => "Value A",
            "القيمة الثانية" => "Value B",
            "مقارنة" => "Comparison",
            "إجابتك" => "Your Answer",
            "الإجابة الصحيحة" => "Correct Answer",
            "صحيح" => "Correct",
            "خطأ" => "Wrong",
            "متخطى" => "Skipped",
            "الوقت" => "Time",
            "دقيقة" => "min",
            "ثانية" => "sec",
            "قطعة صوتية" => "Audio Passage",
            "قطعة مرئية" => "Video Passage",
            "قطعة نصية" => "Text Passage",
            "لا توجد أسئلة لعرضها." => "No questions to display.",
            "العودة إلى النتيجة" => "Back to Result",
            _ => key
        };
    };

    var totalQuestions = Model.TotalQuestions;
    var correctAnswers = Model.CorrectAnswers;
    var wrongAnswers = Model.WrongAnswers;
    var skippedQuestions = Model.SkippedQuestions;

    var correctPercent = totalQuestions > 0
        ? Math.Round(correctAnswers * 100.0 / totalQuestions, 1)
        : 0;

    var wrongPercent = totalQuestions > 0
        ? Math.Round(wrongAnswers * 100.0 / totalQuestions, 1)
        : 0;

    var skippedPercent = totalQuestions > 0
        ? Math.Round(skippedQuestions * 100.0 / totalQuestions, 1)
        : 0;

    string FormatQuestionTime(double seconds)
    {
        if (seconds <= 0)
        {
            return "—";
        }

        var minutes = (int)(seconds / 60);
        var remainSeconds = (int)(seconds % 60);

        if (minutes > 0 && remainSeconds > 0)
        {
            return $"{NumberHelper.ToIndicNumbersSafe(minutes.ToString())} {T("دقيقة")} {NumberHelper.ToIndicNumbersSafe(remainSeconds.ToString())} {T("ثانية")}";
        }

        if (minutes > 0)
        {
            return $"{NumberHelper.ToIndicNumbersSafe(minutes.ToString())} {T("دقيقة")}";
        }

        return $"{NumberHelper.ToIndicNumbersSafe(remainSeconds.ToString())} {T("ثانية")}";
    }

    string PrepareQuestionHtml(string? value, bool convertNumbers)
    {
        var html = System.Net.WebUtility.HtmlDecode(value ?? string.Empty);

        html = System.Text.RegularExpressions.Regex.Replace(
            html,
            @"<\s*(script|style)\b[^>]*>[\s\S]*?<\s*/\s*\1\s*>",
            string.Empty,
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        html = System.Text.RegularExpressions.Regex.Replace(
            html,
            @"<\s*/?\s*(script|style)\b[^>]*>",
            string.Empty,
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        return convertNumbers ? NumberHelper.ToIndicNumbersSafe(html) : html;
    }

    bool HasVisibleText(string? html)
    {
        var decoded = System.Net.WebUtility.HtmlDecode(html ?? string.Empty)
            .Replace("&nbsp;", " ")
            .Replace("\u00A0", " ");

        var textOnly = System.Text.RegularExpressions.Regex.Replace(decoded, "<[^>]+>", " ");
        return !string.IsNullOrWhiteSpace(textOnly);
    }
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

