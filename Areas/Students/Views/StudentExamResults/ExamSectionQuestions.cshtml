@model QdratNew.ViewModels.Exam.ExamReviewViewModel
@using QdratNew.Helpers

@{
    ViewData["Title"] = "مراجعة إجابات الاختبار";
    int totalQ = Model.TotalQuestions;
    int correctCount = Model.Questions.Count(q => q.IsCorrect);
    int wrongCount = totalQ - correctCount;
    double percent = totalQ > 0 ? Math.Round(correctCount * 100.0 / totalQ, 1) : 0;
}
@{
    bool isRTL = Model.IsRTL;

    Func<string, string> T = key =>
    {
        if (isRTL) return key;

        return key switch
        {
            "مراجعة إجابات الاختبار" => "Exam Answers Review",
            "أسئلة المحور" => "Section Questions",
            "إجمالي الأسئلة" => "Total Questions",
            "إجابات صحيحة" => "Correct Answers",
            "إجابات خاطئة" => "Wrong Answers",
            "الوقت المستغرق" => "Time Spent",
            "سؤال" => "Question",
            "القيمة الأولى" => "Value A",
            "القيمة الثانية" => "Value B",
            "إجابتك" => "Your Answer",
            "الإجابة الصحيحة" => "Correct Answer",
            "النتيجة" => "Result",
            "صحيح" => "Correct",
            "خطأ" => "Wrong",
            "الوقت" => "Time",
            "ثانية" => "Second",
            "القطعة اللفظية" => "Passage",
            "دقيقة" => "Minute",
            "لا توجد اختيارات لهذا السؤال" => "No options available",
            _ => key
        };
    };

    Func<string, string> ConvertNumber = s =>
    {
        return Model.Questions.Any(q => q.IsQuantitative)
            ? NumberHelper.ToIndicNumbersSafe(s)
            : s;
    };
}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<div class="container py-4 @(isRTL ? "rtl-mode" : "ltr-mode")"
     dir="@(isRTL ? "rtl" : "ltr")">
    <!-- 🟦 عنوان الصفحة -->
    <div class="text-center mb-5">
        <h2 class="fw-bold text-primary">
            <i class="fa-solid fa-file-circle-check me-2"></i> @T("مراجعة إجابات الاختبار")

        </h2>
        <h2 class="fw-bold text-primary">@T("أسئلة المحور"): @Model.SectionTitle</h2>
    </div>

    <!-- 🟩 كروت الإحصائيات -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6>@T("إجمالي الأسئلة")</h6>
                    <h3>@ConvertNumber(Model.TotalQuestions.ToString())</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card text-center shadow-sm text-success">
                <div class="card-body">
                    <h6>@T("إجابات صحيحة")</h6>
                    <h3>@ConvertNumber(correctCount.ToString())</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card text-center shadow-sm text-danger">
                <div class="card-body">
                    <h6>@T("إجابات خاطئة")</h6>
                    <h3>@ConvertNumber(wrongCount.ToString())</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6>@T("الوقت المستغرق")</h6>
                    <h3>@ConvertNumber(Model.TimeSpentMinutes.ToString()) @T("دقيقة")</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- 🧠 عرض الأسئلة -->
    <div class="row g-3">
        @foreach (var item in Model.Questions.Select((q, i) => new { q, i }))
        {
            var q = item.q;
            var index = item.i + 1;
            Func<string, string> convert = s => q.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(s) : s;

            <div class="col-md-6">
                <div class="card shadow-sm mb-3 question-card">
                    <div class="card-header bg-qdrat text-white fw-bold">
                        @Html.Raw(convert($"{T("سؤال")} {ConvertNumber(index.ToString())}: {q.QuestionTitle}"))
                    </div>
                    <div class="card-body">

                        <!-- القطعة النصية إن وجدت -->
                        @if (q.VerbalPassageType == QdratNew.Enums.PassageType.Audio)
                        {
                            <div class="alert alert-light border mb-3 text-center">
                                <strong>🎧 @q.VerbalPassageTitle</strong>
                                <audio controls style="width:100%;">
                                    <source src="@q.VerbalPassageMediaUrl" />
                                </audio>
                            </div>
                        }
                        else if (q.VerbalPassageType == QdratNew.Enums.PassageType.Video)
                        {
                            <div class="alert alert-light border mb-3 text-center">
                                <strong>🎧 @q.VerbalPassageTitle</strong>
                                <video controls style="width:100%; max-height:250px;">
                                    <source src="@q.VerbalPassageMediaUrl" />
                                </video>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(q.VerbalPassageContent))
                        {
                            <details class="mb-3 passage" open>
                                <summary class="fw-semibold">📘 @q.VerbalPassageTitle</summary>
                                <div class="mt-2">
                                    @Html.Raw(convert(q.VerbalPassageContent))
                                </div>
                            </details>
                        }
                        <!-- صورة السؤال -->
                        @if (!string.IsNullOrWhiteSpace(q.ImageUrl))
                        {
                            <div class="text-center mb-3">
                                <img src="@Url.Content(q.ImageUrl)" class="img-fluid rounded-3 shadow-sm" style="max-height: 200px;" alt="صورة السؤال" />
                            </div>
                        }

                        <!-- عرض القيم المقارنة -->
                        @if (q.DisplayType == QdratNew.Enums.QuestionDisplayType.ComparisonText)
                        {
                            <div class="row mb-3 text-center">
                                <div class="col-md-6 border-end">
                                    <strong>@T("القيمة الأولى"):</strong>
                                    <div>@Html.Raw(convert(q.ComparisonValue1))</div>
                                </div>
                                <div class="col-md-6">
                                    <strong>@T("القيمة الثانية"):</strong>
                                    <div>@Html.Raw(convert(q.ComparisonValue2))</div>
                                </div>
                            </div>
                        }
                        else if (q.DisplayType == QdratNew.Enums.QuestionDisplayType.ComparisonWithImage)
                        {
                            <div class="row mb-3 text-center align-items-center">
                                <div class="col-md-4">
                                    <img src="@Url.Content(q.ImageUrl)" class="img-fluid" style="max-height: 150px;" />
                                </div>
                                <div class="col-md-4 border-end">
                                    <strong>@T("القيمة الأولى"):</strong>
                                    <div>@Html.Raw(convert(q.ComparisonValue1))</div>
                                </div>
                                <div class="col-md-4">
                                    <strong>@T("القيمة الثانية"):</strong>
                                    <div>@Html.Raw(convert(q.ComparisonValue2))</div>
                                </div>
                            </div>
                        }

                        <!-- عرض الاختيارات -->
                        @if (q.Options != null && q.Options.Count > 0)
                        {
                            <ul class="list-group mb-3 options-list">
                                @foreach (var opt in q.Options)
                                {
                                    var optText = opt.Text ?? "";
                                    var isSelected = optText == q.StudentAnswer;
                                    var isCorrect = optText == q.CorrectAnswer;
                                    var liClass = isCorrect ? "list-group-item-success" :
                                    (isSelected ? "list-group-item-danger" : "");

                                    <li class="list-group-item d-flex align-items-center @liClass">
                                        @if (!string.IsNullOrWhiteSpace(opt.ImageUrl))
                                        {
                                            <img src="@Url.Content(opt.ImageUrl)" alt="صورة الاختيار"
                                                 class="img-fluid me-2" style="max-height: 50px;" />
                                        }
                                        else
                                        {
                                            <span>@Html.Raw(convert(optText))</span>
                                        }

                                        @if (isSelected)
                                        {
                                            <span class="badge bg-primary ms-auto">@T("إجابتك")</span>
                                        }
                                        @if (isCorrect)
                                        {
                                            <span class="badge bg-success ms-2">@T("الإجابة الصحيحة")</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="alert alert-light mb-3">@T("لا توجد اختيارات لهذا السؤال")</div>
                        }

                        <!-- النتيجة -->
                        <p class="fw-bold mb-2">
                            <strong>@T("النتيجة"):</strong>
                            <span class="@(q.IsCorrect ? "text-success" : "text-danger")">
                                @(q.IsCorrect ? "✔️ " + T("صحيح") : "❌ " + T("خطأ"))
                            </span>

                            @await Html.PartialAsync("_QuestionExplanationPartial", q)
                        </p>

                        <!-- الوقت المستغرق -->
                        <p class="small text-muted">
                            <strong>⏱️ @T("الوقت"):</strong>
                            @ConvertNumber(Math.Round(q.TimeTakenSeconds).ToString()) @T("ثانية")
                        </p>

                    </div>
                </div>
            </div>
        }
    </div>

    <!-- 🔙 زر الرجوع -->
    @*    <div class="text-center mt-5">
        <a asp-action="ExamResult" asp-route-id="@Model.ExamAssignmentId"
           class="btn btn-outline-primary btn-lg rounded-pill px-4 shadow-sm">
            <i class="fa-solid fa-arrow-left me-2"></i> العودة إلى نتيجة الاختبار
        </a>
    </div> *@

</div>

<style>
    .question-card {
        border-radius: 12px;
        transition: all 0.2s ease;
    }

        .question-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

    .options-list .list-group-item {
        border: none;
        border-bottom: 1px solid #eee;
    }

        .options-list .list-group-item:last-child {
            border-bottom: none;
        }

    .list-group-item-success {
        background-color: #e1f8e1 !important;
    }

    .list-group-item-danger {
        background-color: #ffe2e2 !important;
    }

    .passage summary {
        cursor: pointer;
    }

    .passage[open] summary::after {
        content: "▲";
        float: left;
    }

    .passage summary::after {
        content: "▼";
        float: left;
        color: #888;
    }

</style>
<style>
    .rtl-mode {
        direction: rtl;
        text-align: right;
    }

    .ltr-mode {
        direction: ltr;
        text-align: left;
    }
</style>
