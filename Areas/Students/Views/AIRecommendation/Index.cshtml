@model List<QdratNew.Services.AI.CurriculumRecommendation>

<h2>📚 توصيات الاقسام الذكية</h2>

@if (Model.Any())
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>📖 القسم</th>
                <th>🔍 مستوى التوصية</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var recommendation in Model)
            {
                <tr>
                    <td>@recommendation.CurriculumTitle</td>
                    <td>@recommendation.RecommendedLevel</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>⚠️ لا توجد بيانات كافية لتقديم توصيات.</p>
}
