@model QdratNew.ViewModels.Exam.MinistrySimExamEnterCodeVm
@{
    ViewData["Title"] = "التحقق من الكود المرجعي - اختبار معمل القياس";
}

<div class="container my-4" style="max-width:560px;">
    <div class="card shadow-sm border-0" style="border-top:5px solid #4f46e5 !important;">
        <div class="card-body p-4 p-md-5 text-center">
            <div class="display-4 mb-3">🔑</div>
            <h3 class="fw-bold mb-2" style="color:#4f46e5;">اختبار حضوري — التحقق من الكود المرجعي</h3>
            <p class="text-muted mb-4">@Model.ExamTitle</p>
            <p class="text-muted mb-4">
                هذا الاختبار يُعقد حضوريًا في المعمل. الرجاء إدخال الكود المرجعي المكوّن من 6 أرقام الذي أعلنه المشرف قبل البدء.
            </p>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger text-center fw-bold">@TempData["Error"]</div>
            }

            <form method="post" asp-action="EnterReferenceCode">
                @Html.AntiForgeryToken()
                <input type="hidden" name="examId" value="@Model.MinistrySimExamId" />
                <div class="mb-3">
                    <input type="text" name="referenceCode" class="form-control form-control-lg text-center"
                           style="letter-spacing:6px; font-family:monospace; font-size:26px;"
                           maxlength="6" inputmode="numeric" pattern="[0-9]*"
                           placeholder="------" required autofocus />
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100 px-5">
                    تأكيد والدخول للاختبار
                </button>
            </form>
        </div>
    </div>
</div>
