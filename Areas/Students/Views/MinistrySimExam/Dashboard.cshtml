@model List<QdratNew.ViewModels.Students.MinistrySimExamDashboardItemVm>
@using QdratNew.Helpers
@using System.Linq
@{
    ViewData["Title"] = "اختبار معمل القياس";

    var total = Model.Count;
    var completed = Model.Count(e => e.IsCompleted);
    var inProgress = Model.Count(e => e.IsStarted && !e.IsCompleted);
    var notStarted = total - completed - inProgress;
    var completedScores = Model.Where(e => e.IsCompleted && e.TotalScorePercent.HasValue).Select(e => e.TotalScorePercent.Value).ToList();
    var avgScore = completedScores.Any() ? completedScores.Average() : (double?)null;

    string Ind(object n) => NumberHelper.ToIndicNumbersSafe(n.ToString());
}

<style>
    .mse-dash-wrap {
        font-family: 'Cairo', sans-serif;
        background: linear-gradient(135deg, #f8fafc, #eef2ff);
        border-radius: 1.5rem;
        padding: 1.75rem;
    }

    .mse-card {
        background: rgba(255,255,255,.9);
        backdrop-filter: blur(10px);
        border-radius: 1.2rem;
        box-shadow: 0 6px 20px rgba(0,0,0,.06);
        border: 1px solid rgba(255,255,255,.5);
    }

    .mse-hero {
        border-top: 6px solid #4f46e5 !important;
    }

    .mse-hero .mse-hero-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: rgba(79,70,229,.1);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto .75rem;
        font-size: 1.7rem;
        color: #4f46e5;
    }

    .mse-kpi {
        border-radius: 1rem;
        padding: 1.1rem .75rem;
        text-align: center;
        background: #fff;
        box-shadow: 0 3px 10px rgba(0,0,0,.05);
        height: 100%;
    }

    .mse-kpi .num {
        font-weight: 800;
        font-size: 1.6rem;
    }

    .mse-kpi .lbl {
        font-size: .85rem;
        color: #64748b;
        font-weight: 600;
    }

    .mse-exam-card {
        border-radius: 1.1rem;
        background: #fff;
        border: 1px solid #eef1f6;
        border-right: 5px solid var(--exam-tone, #94a3b8);
        transition: transform .2s ease, box-shadow .2s ease;
    }

    .mse-exam-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 24px rgba(0,0,0,.08);
    }

    .mse-exam-icon {
        width: 46px;
        height: 46px;
        border-radius: .8rem;
        background: color-mix(in srgb, var(--exam-tone, #94a3b8) 14%, #fff);
        color: var(--exam-tone, #94a3b8);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        flex-shrink: 0;
    }

    .mse-empty-icon {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: rgba(79,70,229,.08);
        color: #4f46e5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.4rem;
        margin: 0 auto 1rem;
    }

    @@media (max-width: 576px) {
        .mse-dash-wrap {
            padding: 1rem;
        }
    }
</style>

<div class="container my-4 mse-dash-wrap" style="max-width:900px;" dir="rtl">

    <!-- 🎯 البطاقة الرئيسية -->
    <div class="mse-card mse-hero mb-4">
        <div class="p-4 p-md-5 text-center">
            <div class="mse-hero-icon"><i class="bi bi-diagram-3"></i></div>
            <h3 class="fw-bold mb-1" style="color:#4f46e5;">اختبار معمل القياس</h3>
            <p class="text-muted mb-0">اختبار معمل القياس — 5 مراحل متتالية (كمي + لفظي)، قفل أحادي الاتجاه بين المراحل.</p>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-info text-center fw-bold">@TempData["ErrorMessage"]</div>
    }

    @if (!Model.Any())
    {
        <div class="mse-card">
            <div class="p-5 text-center text-muted">
                <div class="mse-empty-icon"><i class="bi bi-inbox"></i></div>
                لا يوجد لديك اختبار "معمل القياس" مُسنَد حاليًا. تابع مع إدارة المعهد لمعرفة موعد إسناده.
            </div>
        </div>
    }
    else
    {
        <!-- 📊 ملخّص سريع -->
        <div class="row g-3 mb-4 text-center">
            <div class="col-6 col-md-3">
                <div class="mse-kpi">
                    <div class="lbl"><i class="bi bi-collection"></i> إجمالي الاختبارات</div>
                    <div class="num text-dark">@Ind(total)</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="mse-kpi">
                    <div class="lbl"><i class="bi bi-check-circle-fill text-success"></i> مكتملة</div>
                    <div class="num text-success">@Ind(completed)</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="mse-kpi">
                    <div class="lbl"><i class="bi bi-hourglass-split text-warning"></i> قيد التقدّم</div>
                    <div class="num text-warning">@Ind(inProgress)</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="mse-kpi">
                    <div class="lbl"><i class="bi bi-graph-up-arrow text-primary"></i> متوسط النتائج</div>
                    <div class="num text-primary">
                        @(avgScore.HasValue ? Ind((int)Math.Round(avgScore.Value)) + "%" : "—")
                    </div>
                </div>
            </div>
        </div>

        @* 🧾 قائمة الاختبارات *@
        foreach (var exam in Model)
        {
            string toneColor = "#94a3b8";
            string statusIcon = "bi-flag";
            string statusText = "لم يبدأ بعد";
            string statusTextColor = "text-primary";

            if (exam.IsCompleted)
            {
                var tone = ResultToneHelper.Build(exam.TotalScorePercent ?? 0, ResultContext.Exam);
                toneColor = tone.ThemeCss switch
                {
                    "theme-excellent" => "#f5a623",
                    "theme-good" => "#27ae60",
                    "theme-acceptable" => "#2980b9",
                    _ => "#7c3aed"
                };
                statusIcon = "bi-check-circle-fill";
                statusText = "مكتمل — النتيجة " + Ind((int)Math.Round(exam.TotalScorePercent ?? 0)) + "%";
                statusTextColor = "text-success";
            }
            else if (exam.IsStarted)
            {
                toneColor = "#f59e0b";
                statusIcon = "bi-hourglass-split";
                statusText = "قيد التقدّم";
                statusTextColor = "text-warning";
            }

            <div class="mse-exam-card p-4 mb-3" style="--exam-tone:@toneColor;">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="mse-exam-icon"><i class="bi bi-journal-bookmark-fill"></i></div>
                        <div>
                            <div class="fw-bold fs-5 mb-1">@exam.Title</div>
                            <div class="text-muted small mb-2">@exam.CourseName</div>
                            <span class="badge bg-light @statusTextColor border">
                                <i class="bi @statusIcon ms-1"></i> @statusText
                            </span>
                        </div>
                    </div>
                    <div>
                        @if (exam.IsCompleted)
                        {
                            <a asp-action="Result" asp-route-examId="@exam.MinistrySimExamId" class="btn btn-outline-primary">
                                عرض النتيجة
                            </a>
                        }
                        else
                        {
                            <a asp-action="Welcome" asp-route-examId="@exam.MinistrySimExamId" class="btn text-white" style="background-color:@toneColor;">
                                @(exam.IsStarted ? "متابعة الاختبار" : "ابدأ الاختبار")
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    }

</div>
