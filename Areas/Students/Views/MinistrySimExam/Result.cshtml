@model QdratNew.ViewModels.Students.MinistrySimExamResultVm
@using QdratNew.Helpers
@using System.Linq
@{
    ViewData["Title"] = "نتيجة اختبار معمل القياس";
    var pct = Model.TotalScorePercent;
    var tone = ResultToneHelper.Build(pct, ResultContext.Exam);
    var hasQuantVerbal = Model.QuantTotal > 0 && Model.VerbalTotal > 0;
    string Ind(object n) => NumberHelper.ToIndicNumbersSafe(n.ToString());
}

<style>
    .mse-result-wrap {
        font-family: 'Cairo', sans-serif;
        background: linear-gradient(135deg, #f8fafc, #eef2ff);
        border-radius: 1.5rem;
        padding: 1.75rem;
    }

    .mse-card {
        background: rgba(255,255,255,.9);
        backdrop-filter: blur(10px);
        border-radius: 1.2rem;
        box-shadow: 0 6px 20px rgba(0,0,0,.06);
        border: 1px solid rgba(255,255,255,.5);
    }

    .mse-hero {
        border-top: 6px solid var(--mse-tone-color, #7c3aed) !important;
        overflow: hidden;
        position: relative;
    }

    .mse-gauge-box {
        position: relative;
        width: 230px;
        height: 150px;
        margin: 0 auto;
    }

    .mse-gauge-canvas {
        width: 100% !important;
        height: 100% !important;
    }

    .mse-gauge-value {
        position: absolute;
        inset: auto 0 4px 0;
        text-align: center;
        font-weight: 800;
        font-size: 2.4rem;
        color: var(--mse-tone-color, #7c3aed);
    }

    .mse-kpi {
        border-radius: 1rem;
        padding: 1.1rem .75rem;
        text-align: center;
        background: #fff;
        box-shadow: 0 3px 10px rgba(0,0,0,.05);
        height: 100%;
    }

    .mse-kpi .num {
        font-weight: 800;
        font-size: 1.6rem;
    }

    .mse-kpi .lbl {
        font-size: .85rem;
        color: #64748b;
        font-weight: 600;
    }

    .mse-section-title {
        font-weight: 700;
        color: #334155;
        border-right: 5px solid var(--mse-tone-color, #7c3aed);
        padding-right: 10px;
        margin-bottom: 1rem;
    }

    .mse-stage-row {
        border-radius: .9rem;
        padding: .8rem 1rem;
        background: #fff;
        border: 1px solid #eef1f6;
    }

    .mse-stage-row + .mse-stage-row {
        margin-top: .6rem;
    }

    .mse-chart-card canvas {
        max-height: 260px;
    }

    @@media (max-width: 576px) {
        .mse-result-wrap {
            padding: 1rem;
        }

        .mse-gauge-box {
            width: 190px;
            height: 130px;
        }

        .mse-gauge-value {
            font-size: 1.9rem;
        }
    }

    .theme-excellent { --mse-tone-color: #f5a623; }
    .theme-good { --mse-tone-color: #27ae60; }
    .theme-acceptable { --mse-tone-color: #2980b9; }
    .theme-growth { --mse-tone-color: #7c3aed; }
    .er-badge--pass { background: #e6f7ee; color: #2fa86a; }
    .er-badge--progress { background: #f3eeff; color: #7c3aed; }

    .mse-review-stat {
        display: block;
        border-radius: .9rem;
        padding: .9rem .8rem;
        background: #fff;
        border: 1px solid #eef1f6;
        text-decoration: none;
        color: inherit;
        transition: transform .15s, box-shadow .15s;
        height: 100%;
    }

    .mse-review-stat:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0,0,0,.08);
        color: inherit;
    }

    .mse-review-stat .mse-review-ico {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: var(--mse-tone-color, #7c3aed);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        margin-bottom: .5rem;
    }

    .mse-review-stat .mse-review-mini {
        font-size: .74rem;
        color: #64748b;
        display: flex;
        flex-wrap: wrap;
        gap: .4rem;
        margin-top: .4rem;
    }
</style>

<div class="container my-4 @tone.ThemeCss mse-result-wrap" style="max-width:900px;" dir="rtl">

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-info text-center fw-bold">@TempData["ErrorMessage"]</div>
    }

    <!-- 🎯 البطاقة الرئيسية: القياس العام -->
    <div class="mse-card mse-hero mb-4">
        <div class="p-4 p-md-5">
            <div class="row align-items-center g-4">
                <div class="col-md-5 text-center">
                    <div class="text-muted fw-semibold mb-2">@Model.ExamTitle</div>
                    <div class="mse-gauge-box">
                        <canvas id="gaugeChart" class="mse-gauge-canvas"></canvas>
                        <div class="mse-gauge-value">@Ind((int)Math.Round(pct))%</div>
                    </div>
                    <div class="small text-muted mt-1">النتيجة الإجمالية</div>
                </div>
                <div class="col-md-7 text-center text-md-start">
                    <h4 class="fw-bold mb-2">@tone.Title</h4>
                    <p class="text-muted mb-3">@tone.Subtitle</p>
                    <span class="badge @tone.BadgeCss px-3 py-2 fs-6">@tone.BadgeText</span>

                    @if (Model.CompletedAt.HasValue)
                    {
                        <div class="small text-muted mt-3">
                            <i class="bi bi-clock-history"></i>
                            تم إنهاء الاختبار في @Model.CompletedAt.Value.ToString("yyyy/MM/dd hh:mm tt")
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- 📊 كروت الإحصاءات -->
    <div class="row g-3 mb-4 text-center">
        <div class="col-6 col-md-3">
            <div class="mse-kpi">
                <div class="lbl"><i class="bi bi-list-numeric"></i> عدد الأسئلة</div>
                <div class="num text-dark">@Ind(Model.TotalQuestions)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="mse-kpi">
                <div class="lbl"><i class="bi bi-check-circle-fill text-success"></i> صحيحة</div>
                <div class="num text-success">@Ind(Model.TotalCorrect)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="mse-kpi">
                <div class="lbl"><i class="bi bi-x-circle-fill text-danger"></i> خاطئة</div>
                <div class="num text-danger">@Ind(Model.TotalWrong)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="mse-kpi">
                <div class="lbl"><i class="bi bi-dash-circle-fill text-warning"></i> بلا إجابة</div>
                <div class="num text-warning">@Ind(Model.TotalUnanswered)</div>
            </div>
        </div>
    </div>

    <!-- 📈 الرسوم البيانية -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="mse-card mse-chart-card p-3 p-md-4 h-100">
                <h6 class="mse-section-title mb-3">توزيع الإجابات</h6>
                <canvas id="answersDonutChart"></canvas>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mse-card mse-chart-card p-3 p-md-4 h-100">
                <h6 class="mse-section-title mb-3">نتيجة كل مرحلة</h6>
                <canvas id="stagesBarChart"></canvas>
            </div>
        </div>
    </div>

    @if (hasQuantVerbal)
    {
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="mse-card mse-chart-card p-3 p-md-4 h-100">
                    <h6 class="mse-section-title mb-3">المحور الكمي (@Ind((int)Math.Round(Model.QuantPercent))%)</h6>
                    <canvas id="quantDonutChart"></canvas>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mse-card mse-chart-card p-3 p-md-4 h-100">
                    <h6 class="mse-section-title mb-3">المحور اللفظي (@Ind((int)Math.Round(Model.VerbalPercent))%)</h6>
                    <canvas id="verbalDonutChart"></canvas>
                </div>
            </div>
        </div>
    }

    <!-- 🧩 تفاصيل المراحل -->
    <div class="mse-card p-3 p-md-4 mb-4">
        <h6 class="mse-section-title mb-3">تفاصيل المراحل</h6>
        @foreach (var stage in Model.Stages)
        {
            <div class="mse-stage-row">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div class="fw-semibold">
                        المرحلة @Ind(stage.StageNumber)
                    </div>
                    <span class="fw-bold" style="color:var(--mse-tone-color, #7c3aed);">
                        @Ind((int)Math.Round(stage.StagePercentScore))%
                    </span>
                </div>
                <div class="progress mt-2" style="height:8px;">
                    <div class="progress-bar" role="progressbar"
                         style="width:@(stage.StagePercentScore)%; background-color:var(--mse-tone-color, #7c3aed);"
                         aria-valuenow="@stage.StagePercentScore" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <div class="small text-muted mt-2 d-flex flex-wrap gap-3">
                    <span><i class="bi bi-check-circle text-success"></i> @Ind(stage.CorrectCount) صحيحة</span>
                    <span><i class="bi bi-x-circle text-danger"></i> @Ind(stage.WrongCount) خاطئة</span>
                    <span><i class="bi bi-dash-circle text-warning"></i> @Ind(stage.UnansweredCount) بلا إجابة</span>
                </div>
                <div class="small mt-2">
                    @if (stage.TimeExpired)
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                            <i class="bi bi-alarm"></i> تجاوز الزمن المحدد (@Ind(stage.DurationMinutes) دقيقة)
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                            <i class="bi bi-check-circle"></i> تم الحل ضمن الزمن المحدد (@Ind(stage.DurationMinutes) دقيقة)
                        </span>
                    }
                </div>
            </div>
        }
    </div>

    <!-- 🔎 مراجعة الأسئلة والإجابات -->
    <div class="mse-card p-3 p-md-4 mb-4">
        <h6 class="mse-section-title mb-3">مراجعة الأسئلة والإجابات</h6>
        <div class="row g-3">
            @foreach (var stage in Model.Stages)
            {
                <div class="col-6 col-md-4 col-lg-auto" style="min-width:150px;">
                    <a asp-area="Students" asp-controller="MinistrySimExam" asp-action="QuestionReview"
                       asp-route-examId="@Model.MinistrySimExamId" asp-route-stageNumber="@stage.StageNumber"
                       class="mse-review-stat">
                        <div class="mse-review-ico">
                            <i class="bi bi-diagram-3"></i> @Ind(stage.StageNumber)
                        </div>
                        <div class="fw-semibold">المرحلة @Ind(stage.StageNumber)</div>
                        <div class="mse-review-mini">
                            <span class="text-success"><i class="bi bi-check-circle"></i> @Ind(stage.CorrectCount)</span>
                            <span class="text-danger"><i class="bi bi-x-circle"></i> @Ind(stage.WrongCount)</span>
                            <span class="text-warning"><i class="bi bi-dash-circle"></i> @Ind(stage.UnansweredCount)</span>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- 💬 رسالة تحفيزية -->
    <div class="mse-card mb-4">
        <div class="p-4 text-center">
            <div class="fs-3 mb-2">
                <i class="bi @(tone.Tier == "excellent" ? "bi-trophy-fill" : tone.Tier == "strong" ? "bi-stars" : tone.Tier == "onTrack" ? "bi-graph-up-arrow" : "bi-compass")"
                   style="color:var(--mse-tone-color, #7c3aed);"></i>
            </div>
            <h6 class="fw-bold mb-1">@tone.MotivationHeading</h6>
            <p class="text-muted mb-0">@tone.MotivationMsg</p>
        </div>
    </div>

    <div class="text-center">
        <a asp-area="Students" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary px-4">
            العودة للرئيسية
        </a>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function () {
            const toneColor = getComputedStyle(document.querySelector('.mse-result-wrap'))
                .getPropertyValue('--mse-tone-color').trim() || '#7c3aed';
            const trackColor = '#eef1f6';

            // 🎯 مقياس نصف دائري للنتيجة الإجمالية
            const pct = @Model.TotalScorePercent.ToString(System.Globalization.CultureInfo.InvariantCulture);
            new Chart(document.getElementById('gaugeChart'), {
                type: 'doughnut',
                data: {
                    datasets: [{
                        data: [pct, 100 - pct],
                        backgroundColor: [toneColor, trackColor],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    circumference: 180,
                    rotation: -90,
                    cutout: '75%',
                    plugins: { legend: { display: false }, tooltip: { enabled: false } }
                }
            });

            // 📊 توزيع الإجابات
            new Chart(document.getElementById('answersDonutChart'), {
                type: 'doughnut',
                data: {
                    labels: ['صحيحة', 'خاطئة', 'بلا إجابة'],
                    datasets: [{
                        data: [@Model.TotalCorrect, @Model.TotalWrong, @Model.TotalUnanswered],
                        backgroundColor: ['#22c55e', '#ef4444', '#f59e0b'],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: { legend: { position: 'bottom' } }
                }
            });

            // 📶 نتيجة كل مرحلة
            const stageLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Stages.Select(s => "المرحلة " + s.StageNumber)));
            const stageScores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Stages.Select(s => s.StagePercentScore)));
            new Chart(document.getElementById('stagesBarChart'), {
                type: 'bar',
                data: {
                    labels: stageLabels,
                    datasets: [{
                        label: 'النتيجة %',
                        data: stageScores,
                        backgroundColor: toneColor,
                        borderRadius: 8,
                        maxBarThickness: 42
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, max: 100, ticks: { stepSize: 20 } } }
                }
            });

            const hasQuantVerbal = @(hasQuantVerbal ? "true" : "false");
            if (hasQuantVerbal) {
                new Chart(document.getElementById('quantDonutChart'), {
                    type: 'doughnut',
                    data: {
                        labels: ['صحيحة', 'خاطئة', 'بلا إجابة'],
                        datasets: [{
                            data: [@Model.QuantCorrect, @Model.QuantWrong, @Model.QuantUnanswered],
                            backgroundColor: ['#22c55e', '#ef4444', '#f59e0b'],
                            borderWidth: 2,
                            borderColor: '#fff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        plugins: { legend: { position: 'bottom' } }
                    }
                });

                new Chart(document.getElementById('verbalDonutChart'), {
                    type: 'doughnut',
                    data: {
                        labels: ['صحيحة', 'خاطئة', 'بلا إجابة'],
                        datasets: [{
                            data: [@Model.VerbalCorrect, @Model.VerbalWrong, @Model.VerbalUnanswered],
                            backgroundColor: ['#22c55e', '#ef4444', '#f59e0b'],
                            borderWidth: 2,
                            borderColor: '#fff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        plugins: { legend: { position: 'bottom' } }
                    }
                });
            }
        })();
    </script>
}
