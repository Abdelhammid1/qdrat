@model QdratNew.ViewModels.Students.MinistrySimExamQuestionReviewVm
@using QdratNew.Helpers
@{
    ViewData["Title"] = "مراجعة أسئلة المرحلة — اختبار معمل القياس";
    var isRTL = Model.IsRTL;

    var totalQuestions = Model.TotalQuestions;
    var correctAnswers = Model.CorrectAnswers;
    var wrongAnswers = Model.WrongAnswers;
    var skippedAnswers = Model.SkippedAnswers;
    var successPercent = totalQuestions > 0 ? Math.Round(correctAnswers * 100.0 / totalQuestions, 1) : 0;
    var wrongPercent = totalQuestions > 0 ? Math.Round(wrongAnswers * 100.0 / totalQuestions, 1) : 0;
    var skippedPercent = totalQuestions > 0 ? Math.Round(skippedAnswers * 100.0 / totalQuestions, 1) : 0;
}

@await Html.PartialAsync("_QlbReviewStyles")

<div class="@(isRTL ? "rtl-mode" : "ltr-mode")">
    <div class="qlb-page">
        <div class="qlb-shell">

            <!-- Hero -->
            <div class="qlb-hero">
                <div class="qlb-hero-content">
                    <div class="qlb-hero-icon">
                        <i class="fas fa-diagram-project"></i>
                    </div>

                    <h1>مراجعة أسئلة المرحلة @NumberHelper.ToIndicNumbersSafe(Model.StageNumber.ToString())</h1>

                    <p class="qlb-hero-subtitle">
                        @Model.StageAxisSummary
                    </p>

                    <div class="qlb-hero-meta">
                        <span class="qlb-hero-pill">
                            <i class="fas fa-question-circle"></i>
                            إجمالي الأسئلة: @NumberHelper.ToIndicNumbersSafe(totalQuestions.ToString())
                        </span>

                        <span class="qlb-hero-pill">
                            <i class="fas fa-check-circle"></i>
                            إجابات صحيحة: @NumberHelper.ToIndicNumbersSafe(correctAnswers.ToString())
                        </span>

                        <span class="qlb-hero-pill">
                            <i class="fas @(Model.TimeExpired ? "fa-hourglass-end" : "fa-hourglass-half")"></i>
                            @(Model.TimeExpired ? "تجاوز الزمن المحدد" : "تم الحل ضمن الزمن المحدد")
                        </span>
                    </div>
                </div>
            </div>

            <!-- KPI Cards -->
            <div class="qlb-stats">
                <div class="qlb-stat">
                    <div class="qlb-stat-ico ico-blue">
                        <i class="fas fa-question-circle"></i>
                    </div>
                    <div class="qlb-stat-content">
                        <div class="qlb-stat-lbl">إجمالي الأسئلة</div>
                        <div class="qlb-stat-val">@NumberHelper.ToIndicNumbersSafe(totalQuestions.ToString())</div>
                    </div>
                </div>

                <div class="qlb-stat">
                    <div class="qlb-stat-ico ico-green">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="qlb-stat-content">
                        <div class="qlb-stat-lbl">إجابات صحيحة</div>
                        <div class="qlb-stat-val" style="color:var(--q-success)">
                            @NumberHelper.ToIndicNumbersSafe(correctAnswers.ToString())
                        </div>
                        <div class="qlb-stat-bar">
                            <div class="qlb-stat-fill fill-g" style="width:@successPercent%"></div>
                        </div>
                    </div>
                </div>

                <div class="qlb-stat">
                    <div class="qlb-stat-ico ico-red">
                        <i class="fas fa-times-circle"></i>
                    </div>
                    <div class="qlb-stat-content">
                        <div class="qlb-stat-lbl">إجابات خاطئة</div>
                        <div class="qlb-stat-val" style="color:var(--q-danger)">
                            @NumberHelper.ToIndicNumbersSafe(wrongAnswers.ToString())
                        </div>
                        <div class="qlb-stat-bar">
                            <div class="qlb-stat-fill fill-r" style="width:@wrongPercent%"></div>
                        </div>
                    </div>
                </div>

                <div class="qlb-stat">
                    <div class="qlb-stat-ico ico-amber">
                        <i class="fas fa-circle-question"></i>
                    </div>
                    <div class="qlb-stat-content">
                        <div class="qlb-stat-lbl">بلا إجابة</div>
                        <div class="qlb-stat-val" style="color:var(--q-skip)">
                            @NumberHelper.ToIndicNumbersSafe(skippedAnswers.ToString())
                        </div>
                        <div class="qlb-stat-bar">
                            <div class="qlb-stat-fill fill-s" style="width:@skippedPercent%"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section Header -->
            <div class="qlb-section-head">
                <h2 class="qlb-section-title">
                    <i class="fas fa-table-list"></i>
                    أسئلة المرحلة
                </h2>

                <span class="qlb-section-count">
                    <i class="fas fa-question-circle"></i>
                    @NumberHelper.ToIndicNumbersSafe(totalQuestions.ToString()) سؤال
                </span>
            </div>

            <!-- Questions -->
            @if (Model.Questions != null && Model.Questions.Any())
            {
                <div class="qlb-grid">
                    @foreach (var q in Model.Questions)
                    {
                        Func<string?, string> convert = s =>
                        {
                            var value = s ?? string.Empty;
                            return q.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(value) : value;
                        };

                        var resultClass = q.IsCorrect == true ? "result-correct" : q.IsCorrect == false ? "result-wrong" : "result-skip";
                        var resultIcon = q.IsCorrect == true ? "fa-check-circle" : q.IsCorrect == false ? "fa-times-circle" : "fa-circle-question";
                        var resultText = q.IsCorrect == true ? "صحيح" : q.IsCorrect == false ? "خطأ" : "بلا إجابة";

                        <div class="qlb-card">

                            <!-- Card Header -->
                            <div class="qlb-card-head">
                                <div class="qlb-qnum">
                                    @NumberHelper.ToIndicNumbersSafe(q.GlobalOrder.ToString())
                                </div>

                                <span class="qlb-result-badge @resultClass">
                                    <i class="fas @resultIcon"></i>
                                    @resultText
                                </span>

                                <span class="qlb-time-chip">
                                    <i class="fas @(q.IsQuant ? "fa-calculator" : "fa-book")"></i>
                                    @(q.IsQuant ? "المحور الكمي" : "المحور اللفظي")
                                </span>
                            </div>

                            <!-- Card Body -->
                            <div class="qlb-card-body">

                                <!-- Verbal Passage -->
                                @if (q.VerbalPassageType == QdratNew.Enums.PassageType.Audio)
                                {
                                    <div class="qlb-media-wrap">
                                        <div class="qlb-media-label">
                                            <i class="fas fa-headphones"></i>
                                            @(string.IsNullOrWhiteSpace(q.VerbalPassageTitle) ? "قطعة صوتية" : q.VerbalPassageTitle)
                                        </div>

                                        <audio controls preload="none">
                                            <source src="@q.VerbalPassageMediaUrl" />
                                        </audio>
                                    </div>
                                }
                                else if (q.VerbalPassageType == QdratNew.Enums.PassageType.Video)
                                {
                                    <div class="qlb-media-wrap">
                                        <div class="qlb-media-label">
                                            <i class="fas fa-video"></i>
                                            @(string.IsNullOrWhiteSpace(q.VerbalPassageTitle) ? "قطعة مرئية" : q.VerbalPassageTitle)
                                        </div>

                                        <video controls preload="metadata">
                                            <source src="@q.VerbalPassageMediaUrl" />
                                        </video>
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(q.VerbalPassageContent))
                                {
                                    <div class="qlb-passage">
                                        <div class="qlb-passage-title">
                                            <i class="fas fa-book-open"></i>
                                            @(string.IsNullOrWhiteSpace(q.VerbalPassageTitle) ? "قطعة نصية" : q.VerbalPassageTitle)
                                        </div>

                                        <div class="qlb-passage-text">
                                            @Html.Raw(convert(q.VerbalPassageContent))
                                        </div>
                                    </div>
                                }

                                <!-- Question Image -->
                                @if (!string.IsNullOrWhiteSpace(q.ImageUrl))
                                {
                                    <div class="qlb-qimg">
                                        <img src="@Url.Content(q.ImageUrl)" alt="صورة السؤال" loading="lazy" />
                                    </div>
                                }

                                <!-- Comparison Values -->
                                @if (q.DisplayType == QdratNew.Enums.QuestionDisplayType.ComparisonText || q.DisplayType == QdratNew.Enums.QuestionDisplayType.ComparisonWithImage)
                                {
                                    <div class="qlb-compare">
                                        <div class="qlb-cmp-box">
                                            <div>
                                                <div style="font-size:.72rem;color:var(--q-muted);margin-bottom:.25rem;">
                                                    القيمة الأولى
                                                </div>
                                                @Html.Raw(convert(q.ComparisonValue1))
                                            </div>
                                        </div>

                                        <span class="qlb-cmp-vs">مقارنة</span>

                                        <div class="qlb-cmp-box">
                                            <div>
                                                <div style="font-size:.72rem;color:var(--q-muted);margin-bottom:.25rem;">
                                                    القيمة الثانية
                                                </div>
                                                @Html.Raw(convert(q.ComparisonValue2))
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- Question Text -->
                                <div class="qlb-qtitle">
                                    <strong>
                                        @Html.Raw(convert(q.QuestionText))
                                    </strong>
                                </div>

                                <!-- Options -->
                                @if (q.Options != null && q.Options.Count > 0)
                                {
                                    <div class="qlb-options">
                                        @foreach (var opt in q.Options)
                                        {
                                            var isSelected = q.StudentAnswer != null && opt.Text == q.StudentAnswer;
                                            var isCorrect = opt.Text == q.CorrectAnswer;

                                            var optCls = isCorrect ? "opt-correct"
                                            : isSelected ? "opt-wrong"
                                            : "opt-normal";

                                            var optIcon = isCorrect ? "fa-check-circle"
                                            : isSelected ? "fa-times-circle"
                                            : "fa-circle";

                                            <div class="qlb-opt @optCls">
                                                <div class="qlb-opt-content">
                                                    @if (!string.IsNullOrWhiteSpace(opt.ImageUrl))
                                                    {
                                                        <img src="@Url.Content(opt.ImageUrl)"
                                                             alt="صورة الاختيار"
                                                             class="qlb-opt-img"
                                                             loading="lazy" />
                                                    }

                                                    @if (!string.IsNullOrWhiteSpace(opt.Text))
                                                    {
                                                        <div class="qlb-opt-text">
                                                            @Html.Raw(convert(opt.Text))
                                                        </div>
                                                    }

                                                    <div class="qlb-opt-tags">
                                                        @if (isSelected)
                                                        {
                                                            <span class="qlb-mini-badge badge-student">
                                                                <i class="fas fa-user-check"></i>
                                                                إجابتك
                                                            </span>
                                                        }

                                                        @if (isCorrect)
                                                        {
                                                            <span class="qlb-mini-badge badge-correct">
                                                                <i class="fas fa-check"></i>
                                                                الإجابة الصحيحة
                                                            </span>
                                                        }
                                                    </div>
                                                </div>

                                                <i class="fas @optIcon qlb-opt-icon"></i>
                                            </div>
                                        }
                                    </div>
                                }

                                <!-- Result -->
                                <div class="qlb-result-box @(q.IsCorrect == true ? "is-correct" : q.IsCorrect == false ? "is-wrong" : "is-skip")">
                                    <div class="qlb-result-title">
                                        <i class="fas @resultIcon"></i>
                                        النتيجة
                                    </div>

                                    <div class="qlb-result-value @(q.IsCorrect == true ? "text-ok" : q.IsCorrect == false ? "text-bad" : "text-skip")">
                                        @(q.IsCorrect == true ? "✔️ صحيح" : q.IsCorrect == false ? "❌ خطأ" : "➖ بلا إجابة")
                                    </div>
                                </div>

                                <!-- Explanation Partial -->
                                <div class="qlb-explanation-wrap">
                                    @await Html.PartialAsync("_QuestionExplanationPartial", q)
                                </div>

                            </div>

                            <!-- Card Footer -->
                            <div class="qlb-card-foot">
                                <span class="qlb-foot-chip fc-primary">
                                    <i class="fas fa-hash"></i>
                                    سؤال @NumberHelper.ToIndicNumbersSafe(q.GlobalOrder.ToString())
                                </span>

                                @if (q.IsCorrect == true)
                                {
                                    <span class="qlb-foot-chip fc-success">
                                        <i class="fas fa-check"></i>
                                        صحيح
                                    </span>
                                }
                                else if (q.IsCorrect == false)
                                {
                                    <span class="qlb-foot-chip fc-danger">
                                        <i class="fas fa-times"></i>
                                        خطأ
                                    </span>
                                }
                                else
                                {
                                    <span class="qlb-foot-chip fc-skip">
                                        <i class="fas fa-circle-question"></i>
                                        بلا إجابة
                                    </span>
                                }
                            </div>

                        </div>
                    }
                </div>
            }
            else
            {
                <div class="qlb-empty">
                    <i class="fas fa-info-circle"></i>
                    لا توجد أسئلة لعرضها.
                </div>
            }

            <div class="text-center mt-4">
                <a asp-area="Students" asp-controller="MinistrySimExam" asp-action="Result" asp-route-examId="@Model.MinistrySimExamId"
                   class="btn btn-outline-secondary px-4">
                    العودة لنتيجة الاختبار
                </a>
            </div>

        </div>
    </div>
</div>
