@using QdratNew.Enums
@using QdratNew.ViewModels.RemedialTracks
@model QdratNew.ViewModels.RemedialTracks.RemedialTrackEnrollmentReportVm
@inject QdratNew.Services.Interfaces.ITimeZoneService Tz
@functions {
    static string OutcomeText(RemedialTrackReportAxisOutcome o) => o switch
    {
        RemedialTrackReportAxisOutcome.Passed => "اجتزت المحور",
        RemedialTrackReportAxisOutcome.NeedsFollowUp => "يحتاج متابعة مع المعهد",
        RemedialTrackReportAxisOutcome.MovedByAdmin => "انتقلت للمحور التالي بقرار الإدارة",
        RemedialTrackReportAxisOutcome.InProgress => "قيد التنفيذ",
        _ => "لم تصل إليه بعد"
    };
    static string OutcomeClass(RemedialTrackReportAxisOutcome o) => o switch
    {
        RemedialTrackReportAxisOutcome.Passed => "rtk-badge-ok",
        RemedialTrackReportAxisOutcome.NeedsFollowUp or RemedialTrackReportAxisOutcome.MovedByAdmin => "rtk-badge-info",
        RemedialTrackReportAxisOutcome.InProgress => "rtk-badge-progress",
        _ => "rtk-badge-muted"
    };
    string Date(DateTime? utc) => utc.HasValue ? Tz.ConvertToSaudi(utc.Value).ToString("yyyy/MM/dd") : "—";
}
@{
    ViewData["Title"] = "تقريري — " + Model.TrackTitle;
}
@section Styles {
    <link href="~/css/student-rtk.css" rel="stylesheet" asp-append-version="true" />
}

<div class="rtk-page">
    <div class="rtk-hero">
        <h1><i class="fas fa-flag-checkered"></i> تقريري في الخطة العلاجية</h1>
        <p>@Model.TrackTitle — @Model.CurriculumTitle</p>
    </div>

    <div class="rtk-card mb-3">
        <h2>الملخص</h2>
        <ul class="rtk-meta">
            <li><i class="fas fa-check"></i> محاور اجتزتها: <strong>@Model.PassedAxes</strong> من @Model.TotalAxes</li>
            @if (Model.FollowUpAxes > 0)
            {
                <li><i class="fas fa-handshake-angle"></i> محاور تحتاج متابعة مع المعهد: <strong>@Model.FollowUpAxes</strong></li>
            }
            @if (Model.AverageScorePercent.HasValue)
            {
                <li><i class="fas fa-chart-line"></i> متوسط نتائجك: <strong>@Model.AverageScorePercent.Value.ToString("0.#")%</strong></li>
            }
        </ul>
        <div class="rtk-progress" role="progressbar" aria-valuenow="@Model.PassedPercent" aria-valuemin="0" aria-valuemax="100"><span style="width:@(Model.PassedPercent)%"></span></div>
        @if (!Model.IsFinished)
        {
            <div class="small text-muted mt-2">الخطة لم تنتهِ بعد؛ يتحدّث التقرير مع تقدّمك.</div>
        }
    </div>

    @if (Model.Axes.Count == 0)
    {
        <div class="rtk-card rtk-empty"><i class="fas fa-layer-group"></i><p class="mb-0">لا توجد محاور في هذه الخطة.</p></div>
    }
    else
    {
        <ol class="rtk-axes" aria-label="المراحل">
            @foreach (var a in Model.Axes)
            {
                <li class="rtk-axis @(a.Outcome == RemedialTrackReportAxisOutcome.Passed ? "is-passed" : a.Outcome == RemedialTrackReportAxisOutcome.NotReached ? "is-locked" : "")">
                    <span class="rtk-axis-num">@a.Order</span>
                    <div class="rtk-axis-body">
                        <strong>@a.Title</strong>
                        <div class="mt-1"><span class="rtk-badge @OutcomeClass(a.Outcome)">@OutcomeText(a.Outcome)</span></div>
                        @if (a.Outcome == RemedialTrackReportAxisOutcome.MovedByAdmin)
                        {
                            <div class="rtk-alert rtk-alert-info mt-2 mb-0" role="note">
                                <i class="fas fa-circle-info" aria-hidden="true"></i>
                                انتقلت من هذا المحور إلى التالي بقرار الإدارة (@Date(a.AdminOpenedAtUtc)) دون اجتيازه؛ ننصحك بمراجعته مع معلمك.
                            </div>
                        }
                        else if (a.Outcome == RemedialTrackReportAxisOutcome.NeedsFollowUp)
                        {
                            <div class="rtk-alert rtk-alert-info mt-2 mb-0" role="note">
                                <i class="fas fa-circle-info" aria-hidden="true"></i>
                                هذا المحور يحتاج متابعة مع المعهد، وستتواصل معك الإدارة.
                            </div>
                        }
                        @if (a.Outcome != RemedialTrackReportAxisOutcome.NotReached)
                        {
                            <ul class="rtk-meta mt-2">
                                <li><i class="fas fa-video"></i> الفيديوهات (الجولة الأولى): @a.VideosDoneRound1 من @a.VideoTotal</li>
                                @if (a.HasRound2)
                                {
                                    <li><i class="fas fa-rotate-right"></i> الفيديوهات (إعادة المشاهدة): @a.VideosDoneRound2 من @a.VideoTotal</li>
                                }
                                <li><i class="fas fa-pen"></i> اختبار 101:
                                    @if (a.Exam101Percent.HasValue) { <text><strong>@a.Exam101Percent.Value.ToString("0.#")%</strong> — @Date(a.Exam101SubmittedAtUtc)</text> }
                                    else { <text>لم يُجرَ بعد</text> }
                                </li>
                                @if (a.Exam102Percent.HasValue)
                                {
                                    <li><i class="fas fa-pen"></i> اختبار 102: <strong>@a.Exam102Percent.Value.ToString("0.#")%</strong> — @Date(a.Exam102SubmittedAtUtc)</li>
                                }
                            </ul>
                        }
                    </div>
                </li>
            }
        </ol>
    }

    <div class="mt-3 d-flex gap-3 flex-wrap">
        <a asp-action="Open" asp-route-enrollmentId="@Model.EnrollmentId" class="rtk-btn rtk-btn-outline">العودة إلى الخطة</a>
        <a asp-action="Index" class="small align-self-center">خطتي العلاجية</a>
    </div>
</div>
