@using QdratNew.Enums
@using QdratNew.ViewModels.RemedialTracks
@model QdratNew.ViewModels.RemedialTracks.RemedialTrackEnrollmentReportVm
@inject QdratNew.Services.Interfaces.ITimeZoneService Tz
@functions {
    static string OutcomeText(RemedialTrackReportAxisOutcome o) => o switch
    {
        RemedialTrackReportAxisOutcome.Passed => "اجتزت المحور",
        RemedialTrackReportAxisOutcome.NeedsFollowUp => "يحتاج متابعة مع المعهد",
        RemedialTrackReportAxisOutcome.MovedByAdmin => "انتقلت للمحور التالي بقرار الإدارة",
        RemedialTrackReportAxisOutcome.InProgress => "قيد التنفيذ",
        _ => "لم تصل إليه بعد"
    };
    static string OutcomePill(RemedialTrackReportAxisOutcome o) => o switch
    {
        RemedialTrackReportAxisOutcome.Passed => "rp-pill-ok",
        RemedialTrackReportAxisOutcome.NeedsFollowUp or RemedialTrackReportAxisOutcome.MovedByAdmin => "rp-pill-warm",
        RemedialTrackReportAxisOutcome.InProgress => "rp-pill-progress",
        _ => "rp-pill-muted"
    };
    static string OutcomeIcon(RemedialTrackReportAxisOutcome o) => o switch
    {
        RemedialTrackReportAxisOutcome.Passed => "fa-circle-check",
        RemedialTrackReportAxisOutcome.NeedsFollowUp or RemedialTrackReportAxisOutcome.MovedByAdmin => "fa-handshake-angle",
        RemedialTrackReportAxisOutcome.InProgress => "fa-spinner",
        _ => "fa-lock"
    };
    static string AxisCls(RemedialTrackReportAxisOutcome o) => o switch
    {
        RemedialTrackReportAxisOutcome.Passed => "is-passed",
        RemedialTrackReportAxisOutcome.NeedsFollowUp => "is-followup",
        RemedialTrackReportAxisOutcome.MovedByAdmin => "is-moved",
        RemedialTrackReportAxisOutcome.InProgress => "is-progress",
        _ => "is-locked"
    };
    static int Pct(int done, int total) => total <= 0 ? 0 : Math.Clamp((int)Math.Round(done * 100.0 / total), 0, 100);
    string Date(DateTime? utc) => utc.HasValue ? Tz.ConvertToSaudi(utc.Value).ToString("yyyy/MM/dd") : "—";
}
@{
    ViewData["Title"] = "تقريري — " + Model.TrackTitle;
    const double ringLen = 226.19; // 2π × 36
    var ringOffset = (ringLen * (1 - Model.PassedPercent / 100.0)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
@section Styles {
    <link href="~/css/student-rtk.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/student-rtk-report.css" rel="stylesheet" asp-append-version="true" />
}

<div class="rtk-page rtk-report-page">
    <header class="rp-hero">
        <a class="rp-back" asp-action="Open" asp-route-enrollmentId="@Model.EnrollmentId">
            <i class="fas fa-arrow-right" aria-hidden="true"></i> العودة إلى الخطة
        </a>
        <div class="rp-hero-row">
            <div class="rp-hero-text">
                <span class="rp-eyebrow"><i class="fas fa-flag-checkered" aria-hidden="true"></i> تقريري في الخطة العلاجية</span>
                <h1>@Model.TrackTitle</h1>
                <p class="rp-hero-sub">@Model.CurriculumTitle</p>
                @if (!Model.IsFinished)
                {
                    <p class="rp-pending"><i class="fas fa-circle-info" aria-hidden="true"></i> الخطة لم تنتهِ بعد؛ يتحدّث التقرير مع تقدّمك.</p>
                }
            </div>
            <div class="rp-ring" role="img" aria-label="اجتزت @Model.PassedAxes من @Model.TotalAxes محور (@Model.PassedPercent%)">
                <svg viewBox="0 0 80 80" aria-hidden="true">
                    <circle class="rp-ring-bg" cx="40" cy="40" r="36"></circle>
                    <circle class="rp-ring-fg" cx="40" cy="40" r="36" stroke-dasharray="226.19" stroke-dashoffset="@ringOffset"></circle>
                </svg>
                <div class="rp-ring-label"><strong>@Model.PassedPercent%</strong><small>إنجاز المحاور</small></div>
            </div>
        </div>

        <ul class="rp-stats">
            <li class="rp-stat">
                <span class="rp-stat-ic"><i class="fas fa-check" aria-hidden="true"></i></span>
                <div><strong>@Model.PassedAxes من @Model.TotalAxes</strong><small>محاور اجتزتها</small></div>
            </li>
            @if (Model.AverageScorePercent.HasValue)
            {
                <li class="rp-stat">
                    <span class="rp-stat-ic"><i class="fas fa-chart-line" aria-hidden="true"></i></span>
                    <div><strong>@Model.AverageScorePercent.Value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%</strong><small>متوسط نتائجك</small></div>
                </li>
            }
            @if (Model.FollowUpAxes > 0)
            {
                <li class="rp-stat">
                    <span class="rp-stat-ic"><i class="fas fa-handshake-angle" aria-hidden="true"></i></span>
                    <div><strong>@Model.FollowUpAxes</strong><small>محاور تحتاج متابعة مع المعهد</small></div>
                </li>
            }
            @if (Model.AddendaTotal > 0)
            {
                <li class="rp-stat">
                    <span class="rp-stat-ic"><i class="fas fa-circle-plus" aria-hidden="true"></i></span>
                    <div><strong>ملاحق مطلوبة: @Model.AddendaCompleted من @Model.AddendaTotal مكتملة</strong><small>مطلوب إضافي — لا يدخل في نسبة المحاور</small></div>
                </li>
            }
        </ul>
    </header>

    <h2 class="rp-section-title"><i class="fas fa-route" aria-hidden="true"></i> رحلتك عبر المحاور</h2>

    @if (Model.Axes.Count == 0)
    {
        <div class="rp-card rp-empty"><i class="fas fa-layer-group" aria-hidden="true"></i><p class="mb-0">لا توجد محاور في هذه الخطة.</p></div>
    }
    else
    {
        <ol class="rp-timeline" aria-label="المراحل">
            @foreach (var a in Model.Axes)
            {
                <li class="rp-axis @AxisCls(a.Outcome)">
                    <span class="rp-node" aria-hidden="true">@a.Order</span>
                    <div class="rp-card rp-axis-card">
                        <div class="rp-axis-head">
                            <h3>@a.Title</h3>
                            <span class="rp-pill @OutcomePill(a.Outcome)"><i class="fas @OutcomeIcon(a.Outcome)" aria-hidden="true"></i> @OutcomeText(a.Outcome)</span>
                        </div>

                        @if (a.Outcome == RemedialTrackReportAxisOutcome.MovedByAdmin)
                        {
                            <div class="rp-note" role="note">
                                <i class="fas fa-circle-info" aria-hidden="true"></i>
                                <span>انتقلت من هذا المحور إلى التالي بقرار الإدارة (@Date(a.AdminOpenedAtUtc)) دون اجتيازه؛ ننصحك بمراجعته مع معلمك.</span>
                            </div>
                        }
                        else if (a.Outcome == RemedialTrackReportAxisOutcome.NeedsFollowUp)
                        {
                            <div class="rp-note" role="note">
                                <i class="fas fa-circle-info" aria-hidden="true"></i>
                                <span>هذا المحور يحتاج متابعة مع المعهد، وستتواصل معك الإدارة.</span>
                            </div>
                        }

                        @if (a.Outcome != RemedialTrackReportAxisOutcome.NotReached)
                        {
                            <div class="rp-details">
                                <div class="rp-box">
                                    <div class="rp-box-label"><span><i class="fas fa-video" aria-hidden="true"></i>الفيديوهات (الجولة الأولى)</span><span class="rp-box-val">@a.VideosDoneRound1 من @a.VideoTotal</span></div>
                                    <div class="rp-bar" aria-hidden="true"><span style="width:@(Pct(a.VideosDoneRound1, a.VideoTotal))%"></span></div>
                                </div>
                                @if (a.HasRound2)
                                {
                                    <div class="rp-box">
                                        <div class="rp-box-label"><span><i class="fas fa-rotate-right" aria-hidden="true"></i>الفيديوهات (إعادة المشاهدة)</span><span class="rp-box-val">@a.VideosDoneRound2 من @a.VideoTotal</span></div>
                                        <div class="rp-bar" aria-hidden="true"><span style="width:@(Pct(a.VideosDoneRound2, a.VideoTotal))%"></span></div>
                                    </div>
                                }
                                <div class="rp-box">
                                    <div class="rp-box-label"><span><i class="fas fa-pen" aria-hidden="true"></i>الاختبار الأول</span></div>
                                    @if (a.Exam101Percent.HasValue)
                                    {
                                        <div class="rp-score"><strong>@a.Exam101Percent.Value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%</strong><small>@Date(a.Exam101SubmittedAtUtc)</small></div>
                                    }
                                    else
                                    {
                                        <div class="rp-todo">لم يُجرَ بعد</div>
                                    }
                                </div>
                                @if (a.Exam102Percent.HasValue)
                                {
                                    <div class="rp-box">
                                        <div class="rp-box-label"><span><i class="fas fa-pen" aria-hidden="true"></i>الاختبار الثاني</span></div>
                                        <div class="rp-score"><strong>@a.Exam102Percent.Value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%</strong><small>@Date(a.Exam102SubmittedAtUtc)</small></div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </li>
            }
        </ol>
    }

    <div class="rp-actions">
        <a asp-action="Open" asp-route-enrollmentId="@Model.EnrollmentId" class="rtk-btn rtk-btn-outline"><i class="fas fa-arrow-right" aria-hidden="true"></i> العودة إلى الخطة</a>
        <a asp-action="Index" class="rp-link">خطتي العلاجية</a>
    </div>
</div>
