@using QdratNew.Enums
@model QdratNew.ViewModels.RemedialTracks.StudentRemedialTrackPlanVm
@{
    ViewData["Title"] = Model.TrackTitle;
}
@section Styles {
    <link href="~/css/student-rtk.css" rel="stylesheet" asp-append-version="true" />
}

<div class="rtk-page">
    <div class="rtk-hero">
        <h1>@Model.TrackTitle</h1>
        <p>@Model.CurriculumName — @(Model.Mode == RemedialTrackDeliveryMode.InPerson ? "حضوري" : "أونلاين")</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.TrackDescription))
    {
        <div class="rtk-card mb-3">@Model.TrackDescription</div>
    }

    @if (Model.Status == RemedialTrackEnrollmentStatus.Completed)
    {
        <div class="rtk-alert rtk-alert-ok">أحسنت! أنهيت جميع محاور الخطة.</div>
    }
    else if (Model.Status == RemedialTrackEnrollmentStatus.CompletedWithFailures)
    {
        <div class="rtk-alert rtk-alert-info">انتهت الخطة. بعض المحاور تحتاج مراجعة مع المعهد.</div>
    }

    @if (!Model.Axes.Any())
    {
        <div class="rtk-card rtk-empty"><i class="fas fa-layer-group"></i><p class="mb-0">لا توجد محاور في هذه الخطة.</p></div>
    }
    else
    {
        <ol class="rtk-axes">
            @foreach (var axis in Model.Axes)
            {
                var cls = axis.IsCurrent ? "is-current" : axis.IsLocked ? "is-locked" : axis.IsPassed ? "is-passed" : axis.IsNotPassed ? "is-notpassed" : "";
                <li class="rtk-axis @cls">
                    <span class="rtk-axis-num">
                        @if (axis.IsLocked) { <i class="fas fa-lock" aria-hidden="true"></i> }
                        else if (axis.IsPassed) { <i class="fas fa-check" aria-hidden="true"></i> }
                        else { @axis.Order }
                    </span>
                    <div class="rtk-axis-body">
                        <strong>@axis.Title</strong>
                        <small>
                            @axis.VideoCount فيديو
                            @switch (axis.Status)
                            {
                                case RemedialTrackAxisStatus.Locked:
                                    <text>— يُفتح بعد اجتياز المحور السابق</text>
                                    break;
                                case RemedialTrackAxisStatus.Videos: <text>— شاهد الفيديوهات بالترتيب</text> break;
                                case RemedialTrackAxisStatus.AwaitingExam101: <text>— أنهيت الفيديوهات، بانتظار الاختبار الأول</text> break;
                                case RemedialTrackAxisStatus.Rewatch: <text>— أعد مشاهدة فيديوهات المحور</text> break;
                                case RemedialTrackAxisStatus.AwaitingExam102: <text>— بانتظار الاختبار الثاني</text> break;
                                case RemedialTrackAxisStatus.Passed: <text>— اجتزت هذا المحور</text> break;
                                default: <text>— يحتاج متابعة مع المعهد</text> break;
                            }
                        </small>
                    </div>
                    @if (!axis.IsLocked)
                    {
                        <a class="rtk-btn @(axis.IsCurrent ? "" : "rtk-btn-outline")" asp-action="Axis"
                           asp-route-enrollmentId="@Model.EnrollmentId" asp-route-axisProgressId="@axis.AxisProgressId">
                            @(axis.IsCurrent ? "متابعة" : "عرض")
                        </a>
                    }
                </li>
            }
        </ol>
    }

    <div class="mt-3 d-flex gap-3 flex-wrap">
        <a asp-action="Report" asp-route-enrollmentId="@Model.EnrollmentId" class="rtk-btn rtk-btn-outline">
            <i class="fas fa-flag-checkered" aria-hidden="true"></i> تقريري
        </a>
        <a asp-action="Index" class="small align-self-center">العودة إلى خطتي العلاجية</a>
    </div>
</div>
