@model QdratNew.ViewModels.RemedialTracks.StudentRemedialTrackTermsVm
@{
    ViewData["Title"] = "شروط وآلية الخطة العلاجية";
}
@section Styles {
    <link href="~/css/student-rtk.css" rel="stylesheet" asp-append-version="true" />
    <style>
        .rtk-terms { max-width: 680px; margin: 1.25rem auto; padding: 0; overflow: hidden; text-align: right; font-size: .86rem; line-height: 1.85; color: #374151; }
        .rtk-terms-head { padding: 1rem 1.4rem; background: linear-gradient(135deg, #146a5b, #1a7f6e); color: #fff; }
        .rtk-terms-head h2 { margin: 0; font-size: 1rem; font-weight: 700; color: #fff; display: flex; align-items: center; gap: .5rem; }
        .rtk-terms-head p { margin: .25rem 0 0; font-size: .78rem; opacity: .85; }
        .rtk-terms-body { padding: 1.1rem 1.4rem 1.3rem; }
        .rtk-terms-body p { margin: 0 0 .6rem; }
        .rtk-terms-sec { margin-top: 1rem; padding-top: .9rem; border-top: 1px solid #eef0f3; }
        .rtk-terms-sec h3 { margin: 0 0 .4rem; font-size: .9rem; font-weight: 700; color: #146a5b; display: flex; align-items: center; gap: .4rem; }
        .rtk-terms-sec ul { margin: 0; padding-inline-start: 1.1rem; }
        .rtk-terms-sec li { margin-bottom: .25rem; }
        .rtk-terms-sec li::marker { color: #1a7f6e; }
        .rtk-terms-warn { margin-top: 1rem; padding: .7rem .9rem; background: #fffbeb; border-inline-start: 3px solid #f59e0b; border-radius: 8px; color: #78350f; font-size: .84rem; }
        .rtk-terms-final { margin: 1rem 0 0; text-align: center; font-size: .82rem; color: #146a5b; font-weight: 600; }
        .rtk-terms-accept { display: flex; gap: .6rem; align-items: flex-start; margin: 1.1rem 0 .8rem; padding: .7rem .9rem; background: #f8fafb; border: 1px solid #e5e7eb; border-radius: 10px; cursor: pointer; font-size: .84rem; color: #1f2937; }
        .rtk-terms-accept input { width: 18px; height: 18px; margin-top: .3rem; flex: 0 0 auto; accent-color: #1a7f6e; }
        .rtk-terms .rtk-btn { font-size: .9rem; }
        @@media (max-width: 576px) { .rtk-terms-head, .rtk-terms-body { padding-inline: 1rem; } }
    </style>
}

<div class="rtk-page">
    <div class="rtk-card rtk-terms">
        <div class="rtk-terms-head">
            <h2><i class="fas fa-file-signature" aria-hidden="true"></i> شروط وآلية الخطة العلاجية</h2>
            @if (!string.IsNullOrWhiteSpace(Model.TrackTitle))
            {
                <p>@Model.TrackTitle</p>
            }
        </div>
        <div class="rtk-terms-body">
        <p>نرجو من جميع الطلاب والطالبات <strong>قراءة التنبيه كاملًا قبل البدء في الخطة العلاجية</strong>، حيث يُعد الدخول في الخطة موافقة على الالتزام بما ورد فيها.</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="rtk-alert rtk-alert-error" role="alert">@Model.ErrorMessage</div>
        }

        <div class="rtk-terms-sec">
            <h3><i class="fas fa-route" aria-hidden="true"></i> آلية الخطة العلاجية</h3>
            <ul>
                <li>الخطة العلاجية تتم <strong>أونلاين عبر منصة المعهد</strong>.</li>
                <li>مدة الخطة <strong>أسبوعان</strong>، وتكون وفق خطة محددة من المعهد.</li>
                <li>يتم تخصيص <strong>محور تدريبي لكل يوم</strong>، ولا يمكن الانتقال إلى المحور التالي إلا بعد <strong>اجتياز اختبار المحور السابق</strong>.</li>
                <li>لا توجد إمكانية لتجاوز المحاور أو الانتقال بينها بشكل عشوائي، ويجب الالتزام بالتسلسل المحدد في الخطة.</li>
                <li>يلتزم الطالب بالمواعيد وآلية التدريب والاختبارات المحددة من قبل المعهد.</li>
            </ul>
            <div class="rtk-terms-warn">
                <strong>مهم جدًا:</strong> الخطة العلاجية <strong>لها مسار محدد ولا يوجد لها إعادة</strong>، لذلك نؤكد على أهمية الالتزام بالخطة واجتياز الاختبارات أولًا بأول، وعدم تأجيل أو تجاوز أي محور.
            </div>
        </div>

        <div class="rtk-terms-sec">
            <h3><i class="fas fa-lock" aria-hidden="true"></i> حقوق المحتوى محفوظة للمعهد</h3>
            <p>جميع المواد والمحتويات التدريبية الموجودة في المنصة <strong>مملوكة لمعهد القدرات للتدريب</strong>، ويُمنع نسخها أو تصويرها أو مشاركتها أو إعادة نشرها أو تداولها بأي وسيلة أو استخدامها خارج الغرض المخصص لها.</p>
            <p class="mb-0">وفي حال تم التصرف بالمحتوى الخاص بالمعهد بأي طريقة كانت، فإن <strong>حقوق المعهد محفوظة، ويحق له اتخاذ الإجراءات النظامية اللازمة</strong> حيال ذلك.</p>
        </div>

        <p class="rtk-terms-final">حرصك على الالتزام بالخطة هو مفتاح الاستفادة منها وتحقيق أفضل نتيجة ممكنة.</p>

        <form asp-action="AcceptTerms" method="post" id="rtkTermsForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="EnrollmentId" value="@Model.EnrollmentId" />
            <label class="rtk-terms-accept">
                <input type="checkbox" name="Accepted" value="true" id="rtkTermsCheck" />
                <span>قرأت الشروط والأحكام أعلاه وأوافق عليها، وأقرّ بالالتزام بها قبل بدء الخطة العلاجية.</span>
            </label>
            <button type="submit" class="rtk-btn" id="rtkTermsSubmit" disabled><i class="fas fa-check" aria-hidden="true"></i> أوافق وابدأ الخطة</button>
        </form>

        <div class="mt-3 text-center"><a asp-action="Index" class="small">العودة إلى خطتي العلاجية</a></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('rtkTermsForm');
            var check = document.getElementById('rtkTermsCheck');
            var btn = document.getElementById('rtkTermsSubmit');
            if (!form || !check || !btn) return;
            check.addEventListener('change', function () { btn.disabled = !check.checked; });
            form.addEventListener('submit', function (e) {
                if (!check.checked) { e.preventDefault(); return; }
                btn.disabled = true;
                btn.innerHTML = '<span class="rtk-spinner"></span> جارٍ التسجيل...';
            });
        })();
    </script>
}
