@using QdratNew.Enums
@model QdratNew.ViewModels.RemedialTracks.StudentRemedialTrackSolveVm
@{
    ViewData["Title"] = $"{Model.ExamNumber.DisplayName()} — {Model.AxisTitle}";
    var total = Model.Questions.Count;
    var answeredCount = Model.AnsweredCount;
    var pct = total > 0 ? (int)Math.Round((double)answeredCount / total * 100) : 0;
    Layout = "~/Views/Shared/_QuestionStudentLayout.cshtml";
}
@section Styles {
    <link href="~/css/student-rtk.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/student-rtk-solve.css" rel="stylesheet" asp-append-version="true" />
}

@await Html.PartialAsync("_ExamBackGuard")

<div class="rtk-page rtk-exam rtk-solve-focus">
    @* شاشة اختبار مركّزة: لا قائمة ولا ترويسة — السؤال والخيارات وأزرار التنقل والوقت فقط *@
    <div class="rtk-exam-bar" id="rtkExamBar">
        <span class="rtk-exam-timer" id="rtkTimer" role="timer" aria-label="الوقت المتبقي">--:--</span>
        <span class="rtk-save-state" id="rtkSaveState" role="status" aria-live="polite"></span>
        <span class="visually-hidden" aria-live="polite">أجبت عن <b id="rtkAnsweredCount">@answeredCount</b> من @total</span>
        <button type="button" class="rtk-fs-btn" id="rtkFsBtn" aria-label="ملء الشاشة" title="ملء الشاشة"><i class="fas fa-expand" aria-hidden="true"></i></button>
    </div>

    @if (total == 0)
    {
        <div class="rtk-card rtk-empty"><i class="fas fa-circle-question"></i><p class="mb-0">لا توجد أسئلة في هذا الاختبار.</p></div>
    }
    else
    {
        <form id="rtkExamForm" asp-action="Submit" asp-area="Students" method="post"
              data-attempt-id="@Model.AttemptId"
              data-remaining="@Model.RemainingSeconds"
              data-total="@total"
              data-save-url="@Url.Action("SaveAnswer", "RemedialTrack", new { area = "Students" })">
            @Html.AntiForgeryToken()
            <input type="hidden" name="attemptId" value="@Model.AttemptId" />

            <div class="qx-shell qx-rtl" id="rtkShell" dir="rtl">

                @* ─── سؤال واحد في كل مرة (نفس أسلوب الاختبارات العامة) ─── *@
                @foreach (var q in Model.Questions)
                {
                    <section class="rtk-q" data-question-id="@q.QuestionId" data-index="@q.Index"
                             data-saved="@(string.IsNullOrWhiteSpace(q.SelectedAnswer) ? "0" : "1")"
                             @(q.Index == 1 ? "" : "hidden")>
                        <div class="qx-header">
                            <div class="qx-header__meta">
                                <div class="qx-question-badge">
                                    <span class="qx-question-badge__label">السؤال</span>
                                    <span class="qx-question-badge__num">@q.Index</span>
                                    <span class="qx-question-badge__sep">/</span>
                                    <span class="qx-question-badge__total">@total</span>
                                </div>
                                <span class="rtk-q-saved" data-role="saved" hidden><i class="fas fa-check" aria-hidden="true"></i> تم الحفظ</span>
                            </div>
                        </div>
                        @await Html.PartialAsync("_ExamQuestionContent", new QdratNew.ViewModels.Students.ExamQuestionContentVm
                        {
                            Question = q.Question,
                            OptionFieldName = "ans_" + q.Index,
                            SelectedAnswer = q.SelectedAnswer
                        })
                    </section>
                }

                @* ─── شريط التنقل السفلي ─── *@
                <div class="exam-nav-fixed qx-nav-bar" id="rtkNavBar">
                    <button type="button" class="qx-nav-btn qx-nav-btn--prev" data-rtk-nav="prev" disabled>
                        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                            <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/>
                        </svg>
                        <span>السابق</span>
                    </button>

                    <button type="button" class="qx-nav-btn qx-nav-btn--flag" data-rtk-nav="flag" aria-pressed="false">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                            <path d="M14.778.085A.5.5 0 0 1 15 .5V8a.5.5 0 0 1-.314.464L14.5 8l.186.464-.003.001-.006.003-.023.009a12.435 12.435 0 0 1-.397.15c-.264.095-.631.223-1.047.35-.816.252-1.879.523-2.71.523-.847 0-1.548-.28-2.158-.525l-.028-.01C7.68 8.71 7.14 8.5 6.5 8.5c-.7 0-1.638.23-2.437.477A19.626 19.626 0 0 0 3 9.342V15.5a.5.5 0 0 1-1 0V.5a.5.5 0 0 1 1 0v.282c.226-.079.496-.17.79-.26C4.606.272 5.67 0 6.5 0c.84 0 1.524.277 2.121.519l.043.018C9.286.788 9.828 1 10.5 1c.7 0 1.638-.23 2.437-.477a19.587 19.587 0 0 0 1.5-.554.5.5 0 0 1 .34-.884z"/>
                        </svg>
                        <span data-role="flag-label">ضع علامة للمراجعة</span>
                    </button>

                    <button type="button" class="qx-nav-btn qx-nav-btn--next" data-rtk-nav="next">
                        <span>التالي</span>
                        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                            <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 0-.708 0l-6 6a.5.5 0 0 0 0 .708l6 6a.5.5 0 0 0 .708-.708L6.707 8l4.647-4.646a.5.5 0 0 0 0-.708z"/>
                        </svg>
                    </button>
                </div>

                @* ─── زر «مراجعة الأسئلة» عند آخر سؤال ─── *@
                <div class="exam-show-review-wrap qx-review-trigger-wrap" id="rtkReviewTrigger" hidden>
                    <button type="button" class="qx-review-trigger-btn" data-rtk-nav="showReview">
                        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                            <path d="M5 10.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5z"/>
                            <path d="M3 0h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2zm0 1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H3z"/>
                        </svg>
                        مراجعة الأسئلة
                    </button>
                </div>

                @* ─── لوحة المراجعة (تفتح عند آخر سؤال أو بزر المراجعة) ─── *@
                <div id="rtkReviewPanel" class="review-panel-container qx-review-panel rtl-mode" dir="rtl" hidden>
                    <div class="qx-review-head">
                        <div class="qx-review-head__icon">
                            <svg width="22" height="22" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                                <path d="M2.5 3a.5.5 0 0 0 0 1h11a.5.5 0 0 0 0-1h-11zm5 3a.5.5 0 0 0 0 1h6a.5.5 0 0 0 0-1h-6zm0 3a.5.5 0 0 0 0 1h6a.5.5 0 0 0 0-1h-6zm-5 3a.5.5 0 0 0 0 1h11a.5.5 0 0 0 0-1h-11z"/>
                            </svg>
                        </div>
                        <div>
                            <h5 class="qx-review-head__title">مراجعة سريعة</h5>
                            <p class="qx-review-head__sub">من أصل <strong>@total</strong> سؤال</p>
                        </div>
                    </div>

                    <div class="qx-progress-track">
                        <div class="qx-progress-fill" id="rtkProgressFill" style="width:@pct%"></div>
                    </div>
                    <div class="qx-progress-label">
                        <span>أُجيب عليه</span>
                        <span id="rtkProgressLabel">@answeredCount / @total</span>
                    </div>

                    <div class="qx-review-stats">
                        <div class="qx-rstat qx-rstat--answered">
                            <span class="qx-rstat__num" id="rtkStatAnswered">0</span>
                            <span class="qx-rstat__lbl">مجاب</span>
                        </div>
                        <div class="qx-rstat qx-rstat--flagged">
                            <span class="qx-rstat__num" id="rtkStatFlagged">0</span>
                            <span class="qx-rstat__lbl">علامة مراجعة</span>
                        </div>
                        <div class="qx-rstat qx-rstat--unanswered">
                            <span class="qx-rstat__num" id="rtkStatUnanswered">0</span>
                            <span class="qx-rstat__lbl">غير مجاب</span>
                        </div>
                    </div>

                    <div class="qx-q-grid review-grid" id="rtkReviewGrid" role="list">
                        @foreach (var q in Model.Questions)
                        {
                            <button type="button"
                                    class="btn btn-outline-secondary review-btn-circle review-jump qx-qbtn qx-qbtn--unanswered"
                                    data-rtk-goto="@q.Index"
                                    aria-label="السؤال @q.Index"
                                    role="listitem">@q.Index</button>
                        }
                    </div>

                    <div class="qx-legend">
                        <span class="qx-legend__item qx-legend__item--answered"><span class="qx-legend__dot"></span>مجاب</span>
                        <span class="qx-legend__item qx-legend__item--flagged"><span class="qx-legend__dot"></span>علامة مراجعة</span>
                        <span class="qx-legend__item qx-legend__item--unanswered"><span class="qx-legend__dot"></span>غير مجاب</span>
                    </div>

                    <div class="review-submit-wrap qx-submit-wrap">
                        <button type="submit" class="btn btn-danger btn-lg review-submit-btn qx-submit-btn" id="rtkSubmitBtn">
                            <i class="fas fa-paper-plane" aria-hidden="true"></i> تسليم الاختبار
                        </button>
                        <p class="rtk-hint mt-2 mb-0">يُحفظ كل اختيار تلقائيًا. عند انتهاء الوقت يُسلَّم الاختبار تلقائيًا.</p>
                    </div>
                </div>
            </div>
        </form>
    }
</div>

@await Html.PartialAsync("_UnifiedExamStyles")

@section Scripts {
    @if (total > 0)
    {
        <script>
            (function () {
                var b = document.getElementById('rtkFsBtn');
                if (!b) return;
                var root = document.documentElement;
                if (!root.requestFullscreen) { b.hidden = true; return; }
                // أول نقرة داخل الاختبار (على السؤال/الخيارات) تُدخل ملء الشاشة مرة واحدة؛ بعدها يتحكم الطالب بالزر
                var form = document.getElementById('rtkExamForm');
                if (form) {
                    form.addEventListener('click', function auto() {
                        form.removeEventListener('click', auto);
                        if (!document.fullscreenElement) root.requestFullscreen().catch(function () { });
                    });
                }
                b.addEventListener('click', function () {
                    if (document.fullscreenElement) { document.exitFullscreen(); } else { root.requestFullscreen().catch(function () { }); }
                });
                document.addEventListener('fullscreenchange', function () {
                    var i = b.querySelector('i');
                    if (i) i.className = 'fas ' + (document.fullscreenElement ? 'fa-compress' : 'fa-expand');
                });
            })();
        </script>
        @await Html.PartialAsync("_ExamOptionSelectionScript")
        <script src="~/js/remedial-track-exam.js" asp-append-version="true"></script>
    }
}
