@using QdratNew.Enums
@using QdratNew.ViewModels.RemedialTracks
@model StudentRemedialTrackResultVm
@{
    ViewData["Title"] = $"نتيجة اختبار {(int)Model.ExamNumber}";
    var pct = Model.ScorePercent.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    var tone = Model.Tone;
    var cardCls = Model.IsPassed ? "is-pass" : "is-growth";
}
@section Styles {
    <link href="~/css/student-rtk.css" rel="stylesheet" asp-append-version="true" />
}

<div class="rtk-page">
    <div class="rtk-hero">
        <h1>نتيجة اختبار @((int)Model.ExamNumber)</h1>
        <p>@Model.TrackTitle — @Model.AxisTitle</p>
    </div>

    <div class="rtk-card rtk-result @cardCls">
        <div class="rtk-result-score" aria-label="النسبة">@pct<span>%</span></div>
        <h2 class="rtk-result-title">@tone.Title</h2>
        <p class="rtk-result-sub">@tone.Subtitle</p>

        <ul class="rtk-meta rtk-result-meta">
            <li><i class="fas fa-circle-check" aria-hidden="true"></i> الإجابات الصحيحة: @Model.CorrectCount من @Model.TotalQuestions</li>
            <li><i class="fas fa-bullseye" aria-hidden="true"></i> نسبة الاجتياز المطلوبة: @Model.PassPercent%</li>
            @if (Model.TimedOut)
            {
                <li><i class="fas fa-hourglass-end" aria-hidden="true"></i> انتهى الوقت فصُحّحت الإجابات المحفوظة.</li>
            }
        </ul>
    </div>

    <div class="rtk-card mt-3">
        <h3>الخطوة التالية</h3>
        @switch (Model.Next)
        {
            case RemedialTrackResultNext.NextAxis:
                <p>أحسنت! فُتح لك المحور التالي: <strong>@Model.NextAxisTitle</strong>.</p>
                <a class="rtk-btn" asp-action="Axis" asp-route-enrollmentId="@Model.EnrollmentId" asp-route-axisProgressId="@Model.NextAxisProgressId">
                    <i class="fas fa-play" aria-hidden="true"></i> الانتقال إلى المحور التالي
                </a>
                break;

            case RemedialTrackResultNext.FinalReport:
                <p>أنهيت آخر محور في الخطة. أحسنت!</p>
                <a class="rtk-btn" asp-action="Report" asp-route-enrollmentId="@Model.EnrollmentId">
                    <i class="fas fa-flag-checkered" aria-hidden="true"></i> عرض تقريري النهائي
                </a>
                break;

            case RemedialTrackResultNext.RewatchThenExam102:
                <p>أعد مشاهدة فيديوهات هذا المحور من جديد، وبعد آخرها سيظهر لك اختبار 102.</p>
                <a class="rtk-btn" asp-action="Axis" asp-route-enrollmentId="@Model.EnrollmentId" asp-route-axisProgressId="@Model.AxisProgressId">
                    <i class="fas fa-rotate-right" aria-hidden="true"></i> إعادة مشاهدة الفيديوهات
                </a>
                break;

            case RemedialTrackResultNext.AwaitAdmin:
                <p>هذا المحور يحتاج متابعة مع المعهد. ستتواصل معك الإدارة لفتح المحور التالي.</p>
                <a class="rtk-btn rtk-btn-outline" asp-action="Open" asp-route-enrollmentId="@Model.EnrollmentId">العودة إلى الخطة</a>
                <a class="rtk-btn rtk-btn-outline" asp-action="Report" asp-route-enrollmentId="@Model.EnrollmentId">تقريري</a>
                break;

            default:
                <p>انتهت الخطة، وهذا المحور يحتاج متابعة مع المعهد. ستتواصل معك الإدارة.</p>
                <a class="rtk-btn rtk-btn-outline" asp-action="Report" asp-route-enrollmentId="@Model.EnrollmentId">عرض تقريري النهائي</a>
                break;
        }
    </div>
</div>
