@using QdratNew.Enums
@model QdratNew.ViewModels.RemedialTracks.StudentRemedialTrackAxisVm
@{
    ViewData["Title"] = Model.AxisTitle;
    var hasVideos = Model.Videos.Any();
}
@section Styles {
    <link href="~/css/student-rtk.css" rel="stylesheet" asp-append-version="true" />
}

<div class="rtk-page">
    <div class="rtk-hero">
        <h1>@Model.AxisTitle</h1>
        <p>@Model.TrackTitle — المحور @Model.AxisOrder@(Model.Round == 2 ? " (إعادة المشاهدة)" : "")</p>
    </div>

    @switch (Model.Status)
    {
        case RemedialTrackAxisStatus.Rewatch:
            <div class="rtk-alert rtk-alert-info">لم تصل إلى النسبة المطلوبة في الاختبار الأول. أعد مشاهدة فيديوهات المحور من جديد، وبعد آخرها سيظهر الاختبار الثاني.</div>
            break;
        case RemedialTrackAxisStatus.Passed:
            <div class="rtk-alert rtk-alert-ok">اجتزت هذا المحور.</div>
            break;
        case RemedialTrackAxisStatus.FailedBlocked:
        case RemedialTrackAxisStatus.FailedOpenedByAdmin:
            <div class="rtk-alert rtk-alert-info">هذا المحور يحتاج متابعة مع المعهد.</div>
            break;
    }

    @if (!hasVideos)
    {
        <div class="rtk-card rtk-empty"><i class="fas fa-video-slash"></i><p class="mb-0">لا توجد فيديوهات في هذا المحور.</p></div>
    }
    else
    {
        <div id="rtkRoot"
             data-enrollment-id="@Model.EnrollmentId"
             data-can-watch="@(Model.CanWatch ? "1" : "0")"
             data-open-url="@Url.Action("Open", "RemedialTrack", new { area = "Students", enrollmentId = Model.EnrollmentId })"
             data-ping-url="@Url.Action("VideoPing", "RemedialTrack", new { area = "Students" })">

            @Html.AntiForgeryToken()

            @if (Model.CanWatch)
            {
                <div class="rtk-card mb-3">
                    <h3 id="rtkNowTitle" class="mb-2"></h3>
                    <div class="rtk-player-wrap" id="rtkPlayerWrap" hidden>
                        <div id="rtkPlayerHost" class="rtk-player-host"></div>
                        @* طبقة حماية: تمنع النقر على عناصر المنصة (الشعار/العنوان/مشاهدة على…) وتمنع قائمة الكليك يمين *@
                        <div class="rtk-player-shield" id="rtkPlayerShield" aria-hidden="true"></div>
                        @* علامة مائية: تكشف مصدر أي تسريب/تسجيل للشاشة *@
                        <div class="rtk-watermark rtk-watermark-a" aria-hidden="true"><span class="rtk-wm-name">@Model.WatermarkText</span>@if (!string.IsNullOrEmpty(Model.WatermarkIdText)){<span class="rtk-wm-id">@Model.WatermarkIdText</span>}</div>
                        <div class="rtk-watermark rtk-watermark-b" aria-hidden="true"><span class="rtk-wm-name">@Model.WatermarkText</span>@if (!string.IsNullOrEmpty(Model.WatermarkIdText)){<span class="rtk-wm-id">@Model.WatermarkIdText</span>}</div>
                        <div class="rtk-player-controls" id="rtkPlayerControls" dir="ltr">
                            <button type="button" id="rtkBtnPlay" class="rtk-ctl-btn" aria-label="تشغيل / إيقاف مؤقت"><i class="fas fa-play" aria-hidden="true"></i></button>
                            <button type="button" id="rtkBtnMute" class="rtk-ctl-btn" aria-label="كتم / تشغيل الصوت"><i class="fas fa-volume-up" aria-hidden="true"></i></button>
                            <span class="rtk-ctl-time" id="rtkTime">0:00 / 0:00</span>
                            <input type="range" id="rtkSeek" class="rtk-seek" min="0" max="1000" value="0" step="1" aria-label="موضع الفيديو (يمكنك الرجوع فقط داخل ما شاهدته)" />
                            <button type="button" id="rtkBtnFull" class="rtk-ctl-btn" aria-label="ملء الشاشة"><i class="fas fa-expand" aria-hidden="true"></i></button>
                        </div>
                    </div>
                    <div id="rtkOtherBox" hidden>
                        <p class="small mb-2">هذا الفيديو على منصة خارجية. افتحه في نافذة جديدة وأبقِ هذه الصفحة مفتوحة أثناء المشاهدة.</p>
                        <a id="rtkOtherLink" class="rtk-btn rtk-btn-outline mb-2" target="_blank" rel="noopener noreferrer"><i class="fas fa-up-right-from-square"></i> فتح الفيديو</a>
                        <button type="button" id="rtkManualDone" class="rtk-btn" disabled><i class="fas fa-check"></i> أنهيت المشاهدة</button>
                    </div>
                    <div class="rtk-player-state" id="rtkState" role="status" aria-live="polite"></div>
                </div>
            }

            <ol class="rtk-videos" id="rtkVideoList">
                @* لا نطبع معرّف/رابط الفيديو في HTML إلا للمتاح حاليًا والتالي مباشرة (يُفتح من JS بعد الإتمام) *@
                @{ var revealedNextLocked = false; }
                @foreach (var v in Model.Videos)
                {
                    var active = Model.CanWatch && v.IsUnlocked && !v.IsCompleted;
                    var exposeSource = v.IsUnlocked;
                    if (!v.IsUnlocked && !revealedNextLocked) { exposeSource = true; revealedNextLocked = true; }
                    <li class="rtk-video-item @(v.IsCompleted ? "is-done" : "") @(Model.CanWatch && !v.IsUnlocked ? "is-locked" : "")"
                        data-vp-id="@v.VideoProgressId"
                        data-order="@v.Order"
                        data-title="@v.Title"
                        data-provider="@v.Provider"
                        data-external-id="@(exposeSource ? v.ExternalId : null)"
                        data-embed-url="@(exposeSource ? v.EmbedUrl : null)"
                        data-url="@(exposeSource ? v.Url : null)"
                        data-duration="@(v.DurationSeconds?.ToString() ?? "")"
                        data-required="@v.RequiredSeconds"
                        data-completed="@(v.IsCompleted ? "1" : "0")"
                        data-unlocked="@(v.IsUnlocked ? "1" : "0")">
                        <i class="rtk-video-icon fas @(v.IsCompleted ? "fa-circle-check" : (Model.CanWatch && !v.IsUnlocked) ? "fa-lock" : "fa-circle-play")" aria-hidden="true"></i>
                        <span class="rtk-video-title">@v.Order. @v.Title</span>
                        @if (Model.CanWatch && v.IsUnlocked && !v.IsCompleted)
                        {
                            <button type="button" class="rtk-btn rtk-btn-outline rtk-select-video">@(active ? "تشغيل" : "مشاهدة")</button>
                        }
                    </li>
                }
            </ol>
        </div>
    }

    @if (TempData["RtkMessage"] is string rtkMessage)
    {
        <div class="rtk-alert rtk-alert-info" role="alert">@rtkMessage</div>
    }

    @* منطقة تُحدَّث من الخادم بعد إتمام الفيديو بلا إعادة تحميل (بطاقة بدء الاختبار + النتائج) *@
    <div id="rtkExamArea">
    @if (Model.ExamReady)
    {
        var examName = Model.PendingExam!.Value.DisplayName();
        <div class="rtk-card rtk-exam-start mt-3">
            <h3>@examName</h3>
            <p class="mb-2">
                أنهيت جميع فيديوهات المحور. مدة الاختبار @Model.ExamDurationMinutes دقيقة، ويبدأ العدّ التنازلي لحظة الضغط على الزر.
            </p>
            @if (Model.InProgressAttemptId.HasValue)
            {
                <a class="rtk-btn" asp-action="Solve" asp-route-attemptId="@Model.InProgressAttemptId">
                    <i class="fas fa-play" aria-hidden="true"></i> متابعة @examName
                </a>
            }
            else
            {
                <form asp-action="StartExam" asp-route-enrollmentId="@Model.EnrollmentId" asp-route-axisProgressId="@Model.AxisProgressId" method="post">
                    <button type="submit" class="rtk-btn"><i class="fas fa-pen" aria-hidden="true"></i> ابدأ @examName</button>
                </form>
            }
        </div>
    }

    @if (Model.Attempts.Any(a => a.IsClosed))
    {
        <div class="rtk-card mt-3">
            <h3>نتائج اختبارات هذا المحور</h3>
            <ul class="rtk-meta mb-0">
                @foreach (var a in Model.Attempts.Where(a => a.IsClosed))
                {
                    <li>
                        @a.ExamNumber.DisplayName(): @a.ScorePercent.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%
                        — <a asp-action="Result" asp-route-attemptId="@a.AttemptId">عرض النتيجة</a>
                    </li>
                }
            </ul>
        </div>
    }

    </div>

    <div class="mt-3"><a asp-action="Open" asp-route-enrollmentId="@Model.EnrollmentId">العودة إلى الخطة</a></div>
</div>

@section Scripts {
    @if (Model.CanWatch && hasVideos)
    {
        <script src="~/js/remedial-track-player.js" asp-append-version="true"></script>
    }
}
