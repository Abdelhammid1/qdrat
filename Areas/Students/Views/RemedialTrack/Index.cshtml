@using QdratNew.Enums
@model QdratNew.ViewModels.RemedialTracks.StudentRemedialTrackIndexVm
@{
    ViewData["Title"] = "خطتي العلاجية";
    var totalPlans = Model.Items.Count();
    var activePlans = Model.Items.Count(i => i.Status == RemedialTrackEnrollmentStatus.InProgress);
    var donePlans = Model.Items.Count(i => i.Status is RemedialTrackEnrollmentStatus.Completed or RemedialTrackEnrollmentStatus.CompletedWithFailures);
}
@section Styles {
    <link href="~/css/student-rtk.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/student-rtk-index.css" rel="stylesheet" asp-append-version="true" />
}

<div class="rtk-page rtk-index-page">
    <header class="ix-hero">
        <div class="ix-hero-row">
            <div class="ix-hero-ic" aria-hidden="true"><i class="fas fa-route"></i></div>
            <div class="ix-hero-text">
                <h1>خطتي العلاجية</h1>
                <p>الخطط التي أرسلها لك المعهد. أكمل المحاور بالترتيب: فيديوهات ثم اختبار.</p>
            </div>
        </div>
        @if (totalPlans > 0)
        {
            <ul class="ix-stats" aria-label="ملخص الخطط">
                <li class="ix-stat"><i class="fas fa-layer-group" aria-hidden="true"></i> الخطط <strong>@totalPlans</strong></li>
                <li class="ix-stat"><i class="fas fa-spinner" aria-hidden="true"></i> قيد التنفيذ <strong>@activePlans</strong></li>
                <li class="ix-stat"><i class="fas fa-circle-check" aria-hidden="true"></i> منتهية <strong>@donePlans</strong></li>
            </ul>
        }
    </header>

    @if (!Model.Items.Any())
    {
        <div class="ix-empty">
            <div class="ix-empty-ic" aria-hidden="true"><i class="fas fa-folder-open"></i></div>
            <h2>لا توجد خطة علاجية متاحة لك حاليًا</h2>
            <p>عندما يرسل لك المعهد خطة جديدة ستظهر هنا.</p>
        </div>
    }
    else
    {
        <div class="ix-grid">
            @foreach (var item in Model.Items)
            {
                var inPerson = item.Mode == RemedialTrackDeliveryMode.InPerson;
                var done = item.Status is RemedialTrackEnrollmentStatus.Completed or RemedialTrackEnrollmentStatus.CompletedWithFailures;
                var stateCls = item.Status switch
                {
                    RemedialTrackEnrollmentStatus.InProgress => "is-progress",
                    RemedialTrackEnrollmentStatus.NotStarted => "is-new",
                    _ => "is-done"
                };
                <article class="ix-card @stateCls">
                    <div class="ix-body">
                        <div class="ix-top">
                            <h2 class="ix-title">@item.TrackTitle</h2>
                            <div class="ix-chips">
                                <span class="ix-pill @(inPerson ? "ix-pill-inperson" : "ix-pill-online")"><i class="fas @(inPerson ? "fa-chalkboard-user" : "fa-wifi")" aria-hidden="true"></i> @(inPerson ? "حضوري" : "أونلاين")</span>
                                @switch (item.Status)
                                {
                                    case RemedialTrackEnrollmentStatus.NotStarted:
                                        <span class="ix-pill ix-pill-muted">لم تبدأ</span>
                                        break;
                                    case RemedialTrackEnrollmentStatus.InProgress:
                                        <span class="ix-pill ix-pill-progress">قيد التنفيذ</span>
                                        break;
                                    case RemedialTrackEnrollmentStatus.Completed:
                                        <span class="ix-pill ix-pill-ok">مكتملة</span>
                                        break;
                                    default:
                                        <span class="ix-pill ix-pill-muted">انتهت</span>
                                        break;
                                }
                            </div>
                        </div>

                        <ul class="ix-meta">
                            <li><i class="fas fa-book" aria-hidden="true"></i><span>المنهج: <b>@item.CurriculumName</b></span></li>
                            <li><i class="fas fa-calendar-plus" aria-hidden="true"></i><span>تاريخ إنشاء الخطة: <b>@item.TrackCreatedAtLocal.ToString("yyyy/MM/dd")</b></span></li>
                            <li><i class="fas fa-paper-plane" aria-hidden="true"></i><span>وقت النشر: <b>@item.PublishAtLocal.ToString("yyyy/MM/dd hh:mm tt")</b></span></li>
                        </ul>

                        <div class="ix-progress">
                            <div class="ix-progress-head"><span>المحاور المجتازة: @item.PassedAxes من @item.TotalAxes</span><strong>@(item.ProgressPercent)%</strong></div>
                            <div class="ix-bar" role="progressbar" aria-valuenow="@item.ProgressPercent" aria-valuemin="0" aria-valuemax="100" aria-label="تقدم الخطة"><span style="width:@(item.ProgressPercent)%"></span></div>
                        </div>

                        <a class="ix-cta @(done ? "is-secondary" : "")" asp-action="Open" asp-route-enrollmentId="@item.EnrollmentId">
                            <i class="fas @(done ? "fa-eye" : "fa-play")" aria-hidden="true"></i> @(done ? "عرض الخطة" : "فتح الخطة")
                        </a>
                    </div>
                </article>
            }
        </div>
    }
</div>
