@using QdratNew.Enums
@model QdratNew.ViewModels.RemedialTracks.StudentRemedialTrackIndexVm
@{
    ViewData["Title"] = "خطتي العلاجية";
}
@section Styles {
    <link href="~/css/student-rtk.css" rel="stylesheet" asp-append-version="true" />
}

<div class="rtk-page">
    <div class="rtk-hero">
        <h1><i class="fas fa-route"></i> خطتي العلاجية</h1>
        <p>الخطط التي أرسلها لك المعهد. أكمل المحاور بالترتيب: فيديوهات ثم اختبار.</p>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="rtk-card rtk-empty">
            <i class="fas fa-folder-open"></i>
            <p class="mb-0">لا توجد خطة علاجية متاحة لك حاليًا.</p>
        </div>
    }
    else
    {
        <div class="rtk-grid">
            @foreach (var item in Model.Items)
            {
                var inPerson = item.Mode == RemedialTrackDeliveryMode.InPerson;
                var done = item.Status is RemedialTrackEnrollmentStatus.Completed or RemedialTrackEnrollmentStatus.CompletedWithFailures;
                <div class="rtk-card">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <h2>@item.TrackTitle</h2>
                        <span class="rtk-badge @(inPerson ? "rtk-badge-inperson" : "rtk-badge-online")">@(inPerson ? "حضوري" : "أونلاين")</span>
                    </div>
                    <ul class="rtk-meta">
                        <li><i class="fas fa-book"></i> المنهج: @item.CurriculumName</li>
                        <li><i class="fas fa-calendar-plus"></i> تاريخ إنشاء الخطة: @item.TrackCreatedAtLocal.ToString("yyyy/MM/dd")</li>
                        <li><i class="fas fa-paper-plane"></i> وقت النشر: @item.PublishAtLocal.ToString("yyyy/MM/dd hh:mm tt")</li>
                        <li>
                            <i class="fas fa-flag"></i>
                            @switch (item.Status)
                            {
                                case RemedialTrackEnrollmentStatus.NotStarted:
                                    <span class="rtk-badge rtk-badge-muted">لم تبدأ</span>
                                    break;
                                case RemedialTrackEnrollmentStatus.InProgress:
                                    <span class="rtk-badge rtk-badge-progress">قيد التنفيذ</span>
                                    break;
                                case RemedialTrackEnrollmentStatus.Completed:
                                    <span class="rtk-badge rtk-badge-ok">مكتملة</span>
                                    break;
                                default:
                                    <span class="rtk-badge rtk-badge-muted">انتهت</span>
                                    break;
                            }
                        </li>
                    </ul>
                    <div class="small text-muted">المحاور المجتازة: @item.PassedAxes من @item.TotalAxes</div>
                    <div class="rtk-progress" role="progressbar" aria-valuenow="@item.ProgressPercent" aria-valuemin="0" aria-valuemax="100"><span style="width:@(item.ProgressPercent)%"></span></div>
                    <a class="rtk-btn" asp-action="Open" asp-route-enrollmentId="@item.EnrollmentId">
                        <i class="fas fa-play"></i> @(done ? "عرض الخطة" : "فتح الخطة")
                    </a>
                </div>
            }
        </div>
    }
</div>
