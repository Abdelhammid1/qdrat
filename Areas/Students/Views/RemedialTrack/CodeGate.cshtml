@model QdratNew.ViewModels.RemedialTracks.StudentRemedialTrackCodeGateVm
@{
    ViewData["Title"] = "الرقم المرجعي للخطة العلاجية";
    var locked = Model.LockedUntilLocal.HasValue;
}
@section Styles {
    <link href="~/css/student-rtk.css" rel="stylesheet" asp-append-version="true" />
}

<div class="rtk-page">
    <div class="rtk-card rtk-gate">
        <h2><i class="fas fa-lock"></i> الرقم المرجعي</h2>
        @if (!string.IsNullOrWhiteSpace(Model.TrackTitle))
        {
            <p class="text-muted mb-2">@Model.TrackTitle</p>
        }
        <p class="small">هذه الخطة حضورية. أدخل الرقم المكوّن من 6 أرقام الذي أعطاك إياه المعهد.</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="rtk-alert rtk-alert-error" role="alert">@Model.ErrorMessage</div>
        }

        @if (locked)
        {
            <div class="rtk-alert rtk-alert-error" role="alert">
                تم إيقاف إدخال الرقم مؤقتًا بسبب محاولات خاطئة متكررة. حاول مرة أخرى بعد @Model.LockedUntilLocal!.Value.ToString("hh:mm tt")
            </div>
        }
        else
        {
            <form asp-action="VerifyCode" method="post" autocomplete="off" id="rtkCodeForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="EnrollmentId" value="@Model.EnrollmentId" />
                <input type="text" name="Code" class="rtk-code-input" inputmode="numeric" maxlength="6"
                       pattern="[0-9٠-٩]{6}" autocomplete="one-time-code" required autofocus
                       aria-label="الرقم المرجعي" />
                <button type="submit" class="rtk-btn mt-3" id="rtkCodeSubmit"><i class="fas fa-unlock"></i> تحقق وفتح الخطة</button>
            </form>
        }

        <div class="mt-3"><a asp-action="Index" class="small">العودة إلى خطتي العلاجية</a></div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('rtkCodeForm');
            if (!form) return;
            form.addEventListener('submit', function () {
                var b = document.getElementById('rtkCodeSubmit');
                if (b) { b.disabled = true; b.innerHTML = '<span class="rtk-spinner"></span> جارٍ التحقق...'; }
            });
        })();
    </script>
}
