@model QdratNew.ViewModels.Students.RemedialPlanMiniViewModel

<div class="card border-info mb-3">
    <div class="card-header bg-info text-white">
        تفاصيل خطتك العلاجية الحالية
    </div>
    <div class="card-body">
        <p><strong>العنوان:</strong> @Model.Title</p>
        <p><strong>الفترة:</strong> @Model.StartDate:dd MMM - @Model.EndDate:dd MMM</p>
        <p><strong>مستوى الأداء:</strong> @Model.PerformanceLevel</p>
        <p><strong>نسبة الإنجاز:</strong> @Model.CompletionPercentage%</p>
        <p><strong>توصيات:</strong> @Model.Recommendations</p>
    </div>
</div>
