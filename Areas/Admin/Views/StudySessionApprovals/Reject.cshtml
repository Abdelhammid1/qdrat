@model QdratNew.ViewModels.RejectSessionViewModel

@{
    ViewData["Title"] = "رفض جلسة مذاكرة";
}

<div class="qdrat-page" dir="rtl">

    <div class="qdrat-hero qdrat-hero-danger mb-4">
        <div>
            <div class="qdrat-kicker">
                <i class="bi bi-x-circle"></i>
                رفض الجلسة
            </div>

            <h2 class="qdrat-title">رفض جلسة مذاكرة</h2>

            <p class="qdrat-subtitle">
                اكتب سبب الرفض بشكل واضح حتى يتم حفظ القرار وإظهاره حسب منطق النظام الحالي.
            </p>
        </div>

        <div class="qdrat-hero-icon">
            <i class="bi bi-calendar-x"></i>
        </div>
    </div>

    <div class="qdrat-card">
        <div class="qdrat-card-header">
            <div>
                <h5>
                    <i class="bi bi-chat-left-text"></i>
                    سبب الرفض
                </h5>
                <p>هذا الحقل مطلوب لإكمال إجراء رفض الجلسة.</p>
            </div>
        </div>

        <div class="qdrat-card-body">
            <form asp-action="Reject" method="post" autocomplete="off">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="alert qdrat-alert qdrat-alert-danger mb-4"></div>

                <div class="qdrat-field">
                    <label asp-for="RejectionReason" class="form-label">سبب الرفض</label>
                    <div class="qdrat-textarea-wrap">
                        <i class="bi bi-pencil-square"></i>
                        <textarea asp-for="RejectionReason" class="form-control" rows="5" placeholder="اكتب سبب رفض الجلسة..."></textarea>
                    </div>
                    <span asp-validation-for="RejectionReason" class="text-danger small"></span>
                </div>

                <div class="qdrat-actions">
                    <a asp-action="Index" class="btn qdrat-btn qdrat-btn-light">
                        <i class="bi bi-arrow-right"></i>
                        إلغاء
                    </a>

                    <button type="submit" class="btn qdrat-btn qdrat-btn-danger">
                        <i class="bi bi-x-circle"></i>
                        رفض الجلسة
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

<style>
    .qdrat-page {
        padding: 24px;
        background: #f5f7fb;
        min-height: calc(100vh - 80px);
        font-family: inherit;
    }

    .qdrat-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 26px;
        border-radius: 24px;
        background: linear-gradient(135deg, #102a43 0%, #1d4ed8 58%, #38bdf8 100%);
        color: #fff;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
    }

    .qdrat-hero-danger {
        background: linear-gradient(135deg, #450a0a 0%, #dc2626 62%, #fb7185 100%);
    }

    .qdrat-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .qdrat-title {
        margin: 0;
        font-size: 28px;
        font-weight: 900;
        letter-spacing: -0.5px;
    }

    .qdrat-subtitle {
        margin: 10px 0 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 15px;
        line-height: 1.8;
        max-width: 850px;
    }

    .qdrat-hero-icon {
        width: 74px;
        height: 74px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.16);
        font-size: 34px;
        flex: 0 0 auto;
    }

    .qdrat-card {
        border: 1px solid #e5e7eb;
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    .qdrat-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #edf0f5;
        background: #fff;
    }

        .qdrat-card-header h5 {
            margin: 0;
            color: #0f172a;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .qdrat-card-header h5 i {
                color: #dc2626;
            }

        .qdrat-card-header p {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 14px;
        }

    .qdrat-card-body {
        padding: 24px;
    }

    .qdrat-field .form-label {
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 9px;
    }

    .qdrat-textarea-wrap {
        position: relative;
    }

        .qdrat-textarea-wrap > i {
            position: absolute;
            right: 15px;
            top: 18px;
            color: #64748b;
            z-index: 3;
            pointer-events: none;
        }

        .qdrat-textarea-wrap .form-control {
            border-radius: 15px;
            border-color: #dbe3ef;
            padding-right: 42px;
            padding-top: 14px;
            font-weight: 700;
            line-height: 1.9;
            resize: vertical;
        }

            .qdrat-textarea-wrap .form-control:focus {
                border-color: #dc2626;
                box-shadow: 0 0 0 0.22rem rgba(220, 38, 38, 0.12);
            }

    .qdrat-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 26px;
        margin-top: 28px;
        border-top: 1px solid #edf0f5;
    }

    .qdrat-btn {
        min-height: 46px;
        border-radius: 14px;
        padding: 10px 24px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .qdrat-btn-danger {
        background: #dc2626;
        border-color: #dc2626;
        color: #fff;
    }

        .qdrat-btn-danger:hover {
            background: #b91c1c;
            border-color: #b91c1c;
            color: #fff;
        }

    .qdrat-btn-light {
        background: #f8fafc;
        border-color: #dbe3ef;
        color: #334155;
    }

        .qdrat-btn-light:hover {
            background: #eef2f7;
            border-color: #cbd5e1;
            color: #0f172a;
        }

    .qdrat-alert {
        border: 0;
        border-radius: 18px;
        padding: 15px 18px;
        font-weight: 800;
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.07);
    }

        .qdrat-alert:empty {
            display: none;
        }

    .qdrat-alert-danger {
        color: #991b1b;
        background: #fee2e2;
    }

    @@media (max-width: 768px) {
        .qdrat-page {
            padding: 14px;
        }

        .qdrat-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 20px;
        }

        .qdrat-title {
            font-size: 23px;
        }

        .qdrat-hero-icon {
            width: 58px;
            height: 58px;
            font-size: 26px;
        }

        .qdrat-card-body,
        .qdrat-card-header {
            padding: 18px;
        }

        .qdrat-actions {
            flex-direction: column-reverse;
        }

        .qdrat-btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
