@model IReadOnlyList<QdratNew.ViewModels.Admin.ProfessionalCertificates.ProfessionalCertificateCourseListItemViewModel>
@{
    ViewData["Title"] = "الدورات المهنية";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0 fw-bold"><i class="fas fa-certificate me-2 text-success"></i>الدورات الدولية الاحترافية</h4>
            <small class="text-muted">إدارة دورات الشهادات المهنية</small>
        </div>
        <a asp-area="Admin" asp-controller="ProfessionalCertificates" asp-action="Create"
           class="btn btn-success rounded-3">
            <i class="fas fa-plus me-1"></i> دورة جديدة
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-3 mb-4">
            <i class="fas fa-circle-check me-1"></i> @TempData["Success"]
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>اللوجو</th>
                            <th>اسم الدورة</th>
                            <th>الكود الدولي</th>
                            <th class="text-center">نشط</th>
                            <th class="text-center">الصفحة الرئيسية</th>
                            <th class="text-center">التسجيل</th>
                            <th class="text-center">عدد الطلبات</th>
                            <th class="text-center">ترتيب</th>
                            <th class="text-center">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model)
                        {
                            <tr>
                                <td class="text-muted small">@course.Id</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(course.LogoPath))
                                    {
                                        <img src="@course.LogoPath" alt="لوجو"
                                             style="width:40px;height:40px;object-fit:contain;border-radius:6px;border:1px solid #e2e8f0;" />
                                    }
                                    else
                                    {
                                        <div style="width:40px;height:40px;background:#f1f5f9;border-radius:6px;display:flex;align-items:center;justify-content:center;">
                                            <i class="@(string.IsNullOrEmpty(course.TitleAr) ? "fas fa-certificate" : "fas fa-certificate") text-muted small"></i>
                                        </div>
                                    }
                                </td>
                                <td class="fw-600">@course.TitleAr</td>
                                <td><code class="small">@course.StandardCode</code></td>
                                <td class="text-center">
                                    <form asp-area="Admin" asp-controller="ProfessionalCertificates"
                                          asp-action="ToggleActive" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@course.Id" />
                                        <button type="submit" class="btn btn-sm rounded-pill px-3 @(course.IsActive ? "btn-success" : "btn-outline-secondary")">
                                            @(course.IsActive ? "نشط" : "معطّل")
                                        </button>
                                    </form>
                                </td>
                                <td class="text-center">
                                    <form asp-area="Admin" asp-controller="ProfessionalCertificates"
                                          asp-action="ToggleHomeVisibility" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@course.Id" />
                                        <button type="submit" class="btn btn-sm rounded-pill px-3 @(course.ShowOnHomePage ? "btn-primary" : "btn-outline-secondary")">
                                            @(course.ShowOnHomePage ? "ظاهر" : "مخفي")
                                        </button>
                                    </form>
                                </td>
                                <td class="text-center">
                                    <form asp-area="Admin" asp-controller="ProfessionalCertificates"
                                          asp-action="ToggleRegistration" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@course.Id" />
                                        <button type="submit" class="btn btn-sm rounded-pill px-3 @(course.IsRegistrationOpen ? "btn-success" : "btn-outline-danger")">
                                            @(course.IsRegistrationOpen ? "مفتوح" : "مغلق")
                                        </button>
                                    </form>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@course.RegistrationCount</span>
                                </td>
                                <td class="text-center text-muted small">@course.DisplayOrder</td>
                                <td class="text-center">
                                    <a asp-area="Admin" asp-controller="ProfessionalCertificates"
                                       asp-action="Edit" asp-route-id="@course.Id"
                                       class="btn btn-sm btn-outline-primary rounded-3">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-5">
                                    <i class="fas fa-inbox fa-2x mb-2 d-block opacity-30"></i>
                                    لا توجد دورات بعد
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
