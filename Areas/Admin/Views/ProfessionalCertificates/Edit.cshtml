@model QdratNew.ViewModels.Admin.ProfessionalCertificates.ProfessionalCertificateCourseFormViewModel
@{
    ViewData["Title"] = "تعديل الدورة";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center gap-2 mb-4">
        <a asp-area="Admin" asp-controller="ProfessionalCertificates" asp-action="Index"
           class="btn btn-sm btn-outline-secondary rounded-3">
            <i class="fas fa-arrow-right"></i>
        </a>
        <h4 class="mb-0 fw-bold">تعديل الدورة: @Model.TitleAr</h4>
    </div>

    <div class="card border-0 shadow-sm rounded-4" style="max-width:760px">
        <div class="card-body p-4">
            <form asp-area="Admin" asp-controller="ProfessionalCertificates" asp-action="Edit"
                  method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                @await Html.PartialAsync("_CourseForm", Model)
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary rounded-3 px-4">
                        <i class="fas fa-save me-1"></i> حفظ التعديلات
                    </button>
                    <a asp-area="Admin" asp-controller="ProfessionalCertificates" asp-action="Index"
                       class="btn btn-outline-secondary rounded-3 ms-2">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>
