@model QdratNew.ViewModels.Admin.ProfessionalCertificates.ProfessionalCertificateCourseFormViewModel

<div class="row g-3">
    <div class="col-12">
        <label asp-for="TitleAr" class="form-label fw-600">اسم الدورة <span class="text-danger">*</span></label>
        <input asp-for="TitleAr" class="form-control" placeholder="مثال: إدارة السلامة والصحة المهنية..." />
        <span asp-validation-for="TitleAr" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="StandardCode" class="form-label fw-600">الكود الدولي <span class="text-danger">*</span></label>
        <input asp-for="StandardCode" class="form-control" placeholder="مثال: OSHA-CFR-1910" />
        <span asp-validation-for="StandardCode" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="Slug" class="form-label fw-600">Slug <span class="text-danger">*</span></label>
        <input asp-for="Slug" class="form-control" placeholder="مثال: osha-cfr-1910" dir="ltr" />
        <span asp-validation-for="Slug" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="ShortDescription" class="form-label fw-600">وصف مختصر</label>
        <textarea asp-for="ShortDescription" class="form-control" rows="2" maxlength="500"></textarea>
        <span asp-validation-for="ShortDescription" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="FullDescription" class="form-label fw-600">وصف تفصيلي</label>
        <textarea asp-for="FullDescription" class="form-control" rows="4"></textarea>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="IconClass" class="form-label fw-600">كلاس الأيقونة</label>
        <input asp-for="IconClass" class="form-control" placeholder="fas fa-shield-halved" dir="ltr" />
        <small class="text-muted">Font Awesome 6 — مثال: fas fa-certificate</small>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="BadgeText" class="form-label fw-600">نص الـ Badge</label>
        <input asp-for="BadgeText" class="form-control" placeholder="اعتماد دولي" />
    </div>

    @* {{!-- ─── قسم اللوجو ─── --}} *@
    <div class="col-12">
        <hr class="my-1" />
        <label class="form-label fw-600 mb-2">
            <i class="fas fa-image me-1 text-primary"></i> لوجو الدورة
        </label>

        @if (!string.IsNullOrEmpty(Model.ExistingLogoPath))
        {
            <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 mb-2" id="existingLogoBox">
                <img src="@Model.ExistingLogoPath" alt="لوجو الدورة"
                     style="width:80px;height:80px;object-fit:contain;border-radius:10px;border:1px solid #e2e8f0;background:#fff;" />
                <div>
                    <div class="text-muted small mb-2">اللوجو الحالي</div>
                    <div class="form-check">
                        <input asp-for="RemoveLogo" class="form-check-input" type="checkbox" id="removeLogoCheck"
                               onchange="toggleLogoRemoval(this)" />
                        <label class="form-check-label text-danger small fw-600" for="removeLogoCheck">
                            حذف اللوجو الحالي
                        </label>
                    </div>
                </div>
            </div>
        }
        else
        {
            <input type="hidden" asp-for="RemoveLogo" value="false" />
        }

        <div id="logoUploadArea" @(Model.RemoveLogo ? "" : "")>
            <input asp-for="LogoFile" type="file" class="form-control" accept="image/*"
                   onchange="previewLogo(this)" id="logoFileInput" />
            <small class="text-muted">صيغ مقبولة: JPG, PNG, WebP — الحجم الأقصى المنصح: 600px عرض — سيُحوَّل تلقائياً لـ WebP</small>

            <div id="logoPreview" class="mt-2" style="display:none;">
                <img id="logoPreviewImg" src="" alt="معاينة"
                     style="max-width:120px;max-height:120px;object-fit:contain;border-radius:10px;border:1px solid #e2e8f0;" />
                <div class="text-muted small mt-1">معاينة اللوجو الجديد</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <label asp-for="DisplayOrder" class="form-label fw-600">ترتيب العرض</label>
        <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
    </div>

    <div class="col-12 col-md-4">
        <label asp-for="MaxRequests" class="form-label fw-600">الحد الأقصى</label>
        <input asp-for="MaxRequests" class="form-control" type="number" min="1" placeholder="بلا حد" />
        <small class="text-muted">اتركه فارغاً للسماح بطلبات غير محدودة</small>
    </div>

    <div class="col-12 col-md-4 d-flex flex-column justify-content-end gap-2 pb-1">
        <div class="form-check form-switch">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
            <label asp-for="IsActive" class="form-check-label">نشط</label>
        </div>
        <div class="form-check form-switch">
            <input asp-for="ShowOnHomePage" class="form-check-input" type="checkbox" role="switch" />
            <label asp-for="ShowOnHomePage" class="form-check-label">يظهر في الصفحة الرئيسية</label>
        </div>
        <div class="form-check form-switch">
            <input asp-for="IsRegistrationOpen" class="form-check-input" type="checkbox" role="switch" />
            <label asp-for="IsRegistrationOpen" class="form-check-label">التسجيل مفتوح</label>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function previewLogo(input) {
            const preview = document.getElementById('logoPreview');
            const img = document.getElementById('logoPreviewImg');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    img.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
            } else {
                preview.style.display = 'none';
            }
        }

        function toggleLogoRemoval(checkbox) {
            const uploadArea = document.getElementById('logoUploadArea');
            const existingBox = document.getElementById('existingLogoBox');
            if (checkbox.checked) {
                uploadArea.style.opacity = '1';
                if (existingBox) existingBox.style.opacity = '0.4';
            } else {
                uploadArea.style.opacity = '1';
                if (existingBox) existingBox.style.opacity = '1';
            }
        }
    </script>
}
