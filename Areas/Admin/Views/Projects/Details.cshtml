@model QdratNew.Entities.Project
@{
    ViewData["Title"] = "تفاصيل البرنامج";
}

<div class="card shadow rounded-3 p-4">
    <h4 class="mb-4 text-center text-info">📖 تفاصيل البرنامج</h4>

    <dl class="row">
        <dt class="col-sm-3 text-end">اسم البرنامج:</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3 text-end">الوصف:</dt>
        <dd class="col-sm-9">@Model.Description</dd>

        <dt class="col-sm-3 text-end">الفرع:</dt>
        <dd class="col-sm-9">@Model.Branch?.Name</dd>

        <dt class="col-sm-3 text-end">تاريخ البدء:</dt>
        <dd class="col-sm-9">@Model.StartDate?.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3 text-end">الانتهاء المتوقع:</dt>
        <dd class="col-sm-9">@Model.ExpectedEndDate?.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3 text-end">الانتهاء الفعلي:</dt>
        <dd class="col-sm-9">@Model.EndDate?.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3 text-end">نشط؟</dt>
        <dd class="col-sm-9">
            @if (Model.IsActive)
            {
                <span class="badge bg-success">نعم</span>
            }
            else
            {
                <span class="badge bg-danger">لا</span>
            }
        </dd>
    </dl>

    <div class="text-center mt-4">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4">تعديل</a>
        <a asp-action="Index" class="btn btn-secondary px-4 ms-2">العودة للقائمة</a>
    </div>
</div>
