@model QdratNew.ViewModels.Project.ProjectViewModel
@{
    ViewData["Title"] = "إضافة برنامج جديد";
}

<div class="qdrat-page" dir="rtl">

    <div class="qdrat-hero mb-4">
        <div>
            <div class="qdrat-kicker">
                <i class="fa-solid fa-diagram-project"></i>
                إدارة البرامج
            </div>

            <h2 class="qdrat-title">إضافة برنامج جديد</h2>

            <p class="qdrat-subtitle">
                أنشئ برنامجًا جديدًا داخل المنصة واربطه بالفرع المناسب مع تحديد المدة الزمنية وحالة التفعيل.
            </p>
        </div>

        <div class="qdrat-hero-icon">
            <i class="fa-solid fa-plus"></i>
        </div>
    </div>

    <div class="qdrat-card">
        <div class="qdrat-card-header">
            <div>
                <h5>
                    <i class="fa-solid fa-clipboard-list"></i>
                    بيانات البرنامج
                </h5>
                <p>أدخل البيانات الأساسية للبرنامج كما ستظهر داخل لوحة الإدارة.</p>
            </div>
        </div>

        <div class="qdrat-card-body">
            <form asp-action="Create" method="post" autocomplete="off">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert qdrat-alert qdrat-alert-danger mb-4"></div>

                <div class="row g-4">

                    <div class="col-lg-6 col-md-6">
                        <div class="qdrat-field">
                            <label asp-for="Name" class="form-label">اسم البرنامج</label>
                            <div class="qdrat-input-wrap">
                                <i class="fa-solid fa-signature"></i>
                                <input asp-for="Name" class="form-control" placeholder="مثال: برنامج القدرات الكمي" />
                            </div>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6">
                        <div class="qdrat-field">
                            <label asp-for="BranchId" class="form-label">الفرع التابع</label>
                            <div class="qdrat-input-wrap">
                                <i class="fa-solid fa-code-branch"></i>
                                <select asp-for="BranchId" class="form-select" asp-items="Model.Branches">
                                    <option value="">اختر الفرع</option>
                                </select>
                            </div>
                            <span asp-validation-for="BranchId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="qdrat-field">
                            <label asp-for="Description" class="form-label">وصف البرنامج</label>
                            <div class="qdrat-textarea-wrap">
                                <i class="fa-solid fa-align-right"></i>
                                <textarea asp-for="Description" class="form-control" rows="4" placeholder="اكتب وصفًا مختصرًا وواضحًا للبرنامج..."></textarea>
                            </div>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <div class="qdrat-field">
                            <label asp-for="StartDate" class="form-label">تاريخ البدء</label>
                            <div class="qdrat-input-wrap">
                                <i class="fa-solid fa-calendar-plus"></i>
                                <input asp-for="StartDate" class="form-control" type="date" />
                            </div>
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <div class="qdrat-field">
                            <label asp-for="ExpectedEndDate" class="form-label">تاريخ الانتهاء المتوقع</label>
                            <div class="qdrat-input-wrap">
                                <i class="fa-solid fa-calendar-days"></i>
                                <input asp-for="ExpectedEndDate" class="form-control" type="date" />
                            </div>
                            <span asp-validation-for="ExpectedEndDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <div class="qdrat-field">
                            <label asp-for="EndDate" class="form-label">تاريخ الانتهاء الفعلي</label>
                            <div class="qdrat-input-wrap">
                                <i class="fa-solid fa-calendar-check"></i>
                                <input asp-for="EndDate" class="form-control" type="date" />
                            </div>
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-status-box">
                            <div class="form-check form-switch qdrat-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                <label asp-for="IsActive" class="form-check-label">نشط</label>
                            </div>
                            <small>عند التفعيل سيكون البرنامج متاحًا للاستخدام داخل النظام حسب الصلاحيات والربط الحالي.</small>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="rl-visibility-card">
                            <div class="rl-visibility-head">
                                <div>
                                    <h6><i class="fa-solid fa-bullhorn"></i> الظهور في صفحة التسجيل</h6>
                                    <p>تحكّم في ظهور هذا البرنامج للزوار في صفحة «سجل معنا». لا يظهر إلا إذا كان نشطًا وله دورة ظاهرة واحدة على الأقل.</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input asp-for="ShowOnRegisterPage" class="form-check-input" type="checkbox" role="switch" />
                                    <label asp-for="ShowOnRegisterPage" class="form-check-label">يظهر في التسجيل</label>
                                </div>
                            </div>

                            <div class="row g-3 mt-1">
                                <div class="col-lg-3 col-md-6">
                                    <label asp-for="RegisterDisplayOrder" class="form-label">ترتيب العرض</label>
                                    <input asp-for="RegisterDisplayOrder" type="text" inputmode="numeric" class="form-control" />
                                    <small class="text-muted">الأصغر يظهر أولًا.</small>
                                    <span asp-validation-for="RegisterDisplayOrder" class="text-danger small d-block"></span>
                                </div>

                                <div class="col-lg-3 col-md-6">
                                    <label asp-for="RegisterIcon" class="form-label">الأيقونة (Font Awesome)</label>
                                    <input asp-for="RegisterIcon" class="form-control" dir="ltr" placeholder="fa-brain" maxlength="50" />
                                    <span asp-validation-for="RegisterIcon" class="text-danger small d-block"></span>
                                </div>

                                <div class="col-lg-3 col-md-6">
                                    <label asp-for="RegisterAccentColor" class="form-label">لون الكرت</label>
                                    <div class="d-flex align-items-center gap-2">
                                        <input type="color" id="rlAccentPicker" class="form-control form-control-color" value="@(string.IsNullOrEmpty(Model.RegisterAccentColor) ? "#1B5EAE" : Model.RegisterAccentColor)" title="اختر اللون" />
                                        <input asp-for="RegisterAccentColor" id="rlAccentText" class="form-control" dir="ltr" placeholder="#1B5EAE" maxlength="7" />
                                    </div>
                                    <span asp-validation-for="RegisterAccentColor" class="text-danger small d-block"></span>
                                </div>

                                <div class="col-12">
                                    <label asp-for="PublicDescription" class="form-label">الوصف العام (يراه الزائر)</label>
                                    <textarea asp-for="PublicDescription" class="form-control" rows="2" maxlength="500" placeholder="جملة قصيرة تشجّع الزائر على اختيار دورات هذا البرنامج"></textarea>
                                    <span asp-validation-for="PublicDescription" class="text-danger small d-block"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="qdrat-actions">
                    <a asp-action="Index" class="btn qdrat-btn qdrat-btn-light">
                        <i class="fa-solid fa-arrow-right"></i>
                        العودة للقائمة
                    </a>

                    <button type="submit" class="btn qdrat-btn qdrat-btn-primary">
                        <i class="fa-solid fa-check-circle"></i>
                        حفظ البرنامج
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

<style>
    .qdrat-page {
        padding: 24px;
        background: #f5f7fb;
        min-height: calc(100vh - 80px);
        font-family: inherit;
    }

    .qdrat-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 26px;
        border-radius: 24px;
        background: linear-gradient(135deg, #102a43 0%, #1d4ed8 58%, #38bdf8 100%);
        color: #fff;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
    }

    .qdrat-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .qdrat-title {
        margin: 0;
        font-size: 28px;
        font-weight: 900;
        letter-spacing: -0.5px;
    }

    .qdrat-subtitle {
        margin: 10px 0 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 15px;
        line-height: 1.8;
        max-width: 850px;
    }

    .qdrat-hero-icon {
        width: 74px;
        height: 74px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.16);
        font-size: 34px;
        flex: 0 0 auto;
    }

    .qdrat-card {
        border: 1px solid #e5e7eb;
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    .qdrat-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #edf0f5;
        background: #fff;
    }

        .qdrat-card-header h5 {
            margin: 0;
            color: #0f172a;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .qdrat-card-header h5 i {
                color: #2563eb;
            }

        .qdrat-card-header p {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 14px;
        }

    .qdrat-card-body {
        padding: 24px;
    }

    .qdrat-field .form-label {
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 9px;
    }

    .qdrat-input-wrap,
    .qdrat-textarea-wrap {
        position: relative;
    }

        .qdrat-input-wrap > i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 3;
            pointer-events: none;
        }

        .qdrat-textarea-wrap > i {
            position: absolute;
            right: 15px;
            top: 18px;
            color: #64748b;
            z-index: 3;
            pointer-events: none;
        }

        .qdrat-input-wrap .form-control,
        .qdrat-input-wrap .form-select {
            min-height: 48px;
            border-radius: 15px;
            border-color: #dbe3ef;
            padding-right: 42px;
            font-weight: 700;
        }

        .qdrat-textarea-wrap .form-control {
            border-radius: 15px;
            border-color: #dbe3ef;
            padding-right: 42px;
            padding-top: 14px;
            font-weight: 700;
            line-height: 1.9;
            resize: vertical;
        }

            .qdrat-input-wrap .form-control:focus,
            .qdrat-input-wrap .form-select:focus,
            .qdrat-textarea-wrap .form-control:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 0.22rem rgba(37, 99, 235, 0.12);
            }

    .qdrat-status-box {
        height: 100%;
        min-height: 112px;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 18px;
        background: #f8fafc;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 10px;
    }

    .qdrat-switch {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-right: 0;
        margin-bottom: 0;
    }

        .qdrat-switch .form-check-input {
            float: none;
            margin: 0;
            width: 46px;
            height: 24px;
            cursor: pointer;
        }

        .qdrat-switch .form-check-label {
            font-weight: 900;
            color: #1e293b;
            cursor: pointer;
        }

    .qdrat-status-box small {
        color: #64748b;
        line-height: 1.8;
        font-weight: 700;
    }

    .qdrat-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 26px;
        margin-top: 28px;
        border-top: 1px solid #edf0f5;
    }

    .qdrat-btn {
        min-height: 46px;
        border-radius: 14px;
        padding: 10px 24px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .qdrat-btn-primary {
        background: #16a34a;
        border-color: #16a34a;
        color: #fff;
    }

        .qdrat-btn-primary:hover {
            background: #15803d;
            border-color: #15803d;
            color: #fff;
        }

    .qdrat-btn-light {
        background: #f8fafc;
        border-color: #dbe3ef;
        color: #334155;
    }

        .qdrat-btn-light:hover {
            background: #eef2f7;
            border-color: #cbd5e1;
            color: #0f172a;
        }

    .qdrat-alert {
        border: 0;
        border-radius: 18px;
        padding: 15px 18px;
        font-weight: 800;
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.07);
    }

        .qdrat-alert:empty {
            display: none;
        }

    .qdrat-alert-danger {
        color: #991b1b;
        background: #fee2e2;
    }

    @@media (max-width: 768px) {
        .qdrat-page {
            padding: 14px;
        }

        .qdrat-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 20px;
        }

        .qdrat-title {
            font-size: 23px;
        }

        .qdrat-hero-icon {
            width: 58px;
            height: 58px;
            font-size: 26px;
        }

        .qdrat-card-body,
        .qdrat-card-header {
            padding: 18px;
        }

        .qdrat-actions {
            flex-direction: column-reverse;
        }

        .qdrat-btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <style>
        .rl-visibility-card {
            border: 1px solid #dbe3ef;
            border-radius: 18px;
            padding: 18px;
            background: #f8fafc;
        }

        .rl-visibility-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 16px;
        }

        .rl-visibility-head h6 {
            margin: 0 0 6px;
            font-weight: 900;
            color: #0f172a;
        }

        .rl-visibility-head h6 i { color: #2563eb; }

        .rl-visibility-head p {
            margin: 0;
            color: #64748b;
            font-size: 13px;
            line-height: 1.8;
            font-weight: 700;
        }

        .rl-visibility-card .form-label {
            font-weight: 800;
            color: #1e293b;
        }

        .rl-visibility-card .form-switch .form-check-input {
            width: 46px;
            height: 24px;
            cursor: pointer;
        }

        .rl-visibility-card .form-switch .form-check-label {
            font-weight: 900;
            cursor: pointer;
        }

        @@media (max-width: 768px) {
            .rl-visibility-head { flex-direction: column; }
        }
    </style>
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var picker = document.getElementById('rlAccentPicker');
            var text = document.getElementById('rlAccentText');
            if (!picker || !text) return;
            picker.addEventListener('input', function () { text.value = picker.value.toUpperCase(); });
            text.addEventListener('input', function () {
                if (/^#[0-9A-Fa-f]{6}$/.test(text.value)) picker.value = text.value;
            });
        })();
    </script>
}
