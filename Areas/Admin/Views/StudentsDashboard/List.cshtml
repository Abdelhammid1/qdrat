@model List<QdratNew.ViewModels.StudentViewModel>
@{
    ViewData["Title"] = ViewBag.StatusTitle;
}

<div class="container-fluid" dir="rtl">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <a href="@Url.Action("Index", "StudentsDashboard")" class="btn btn-secondary mb-3">🔙 العودة إلى لوحة التحكم</a>

    <table class="table table-bordered table-striped text-center" id="studentsTable">
        <thead class="table-dark">
            <tr>
                <th>الاسم</th>
                <th>الجنس</th>
                <th>المرحلة</th>
                <th>الهاتف</th>
                <th>الفرع</th>
                <th>الدفعة</th>
                <th>الحالة</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.FullName</td>
                    <td>@s.Gender</td>
                    <td>@s.Level</td>
                    <td>@s.PhoneNumber</td>
                    <td>@s.BranchId</td>
                    <td>@s.BatchId</td>
                    <td>@s.EnrollmentStatus</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#studentsTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/ar.json'
                }
            });
        });
    </script>
}
