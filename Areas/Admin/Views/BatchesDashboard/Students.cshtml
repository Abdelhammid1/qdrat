@model List<QdratNew.ViewModels.StudentViewModel>

@{
    ViewData["Title"] = "👨‍🎓 طلاب الدفعة";
}

<h2 class="text-primary"><i class="fas fa-users"></i> الطلاب في الدفعة</h2>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>👤 الاسم الكامل</th>
            <th>📧 البريد الإلكتروني</th>
            <th>📞 رقم الهاتف</th>
            <th>🏫 المدرسة</th>
            <th>🎓 المرحلة</th>
            <th>⚠️ الحالة</th>
            <th>🧠 الأداء الفردي</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.FullName</td>
                <td>@(student.Email ?? "—")</td>
                <td>@(student.PhoneNumber ?? "—")</td>
                <td>@student.School</td>
                <td>@student.Level</td>
                <td>
                    @switch (student.EnrollmentStatus)
                    {
                        case "نشط":
                            <span class="badge bg-success">نشط</span>
                            break;
                        case "منسحب":
                            <span class="badge bg-danger">منسحب</span>
                            break;
                        case "متخرج":
                            <span class="badge bg-primary">متخرج</span>
                            break;
                        default:
                            <span class="badge bg-secondary">@student.EnrollmentStatus</span>
                            break;
                    }
                </td>
                <td>
                    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("Owner") || User.IsInRole("Developer"))
                    {
                        <a asp-area="Students"
                           asp-controller="StudentProgress"
                           asp-action="AIAnalysis"
                           asp-route-id="@student.StudentID"
                           class="btn btn-sm btn-outline-primary fw-bold shadow-sm">
                            <i class="fas fa-brain me-1"></i> تحليل ذكي
                        </a>
                    }


                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="BatchesDashboard" asp-action="Index" class="btn btn-secondary mt-3">
    <i class="fas fa-arrow-left"></i> الرجوع إلى لوحة تحكم الدفعات
</a>


@section Scripts {
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.print.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#studentsTable').DataTable({
                language: {
                    search: "🔍 بحث:",
                    lengthMenu: "عرض _MENU_ طالب لكل صفحة",
                    zeroRecords: "لا توجد نتائج",
                    info: "عرض _START_ إلى _END_ من أصل _TOTAL_ طالب",
                    infoEmpty: "لا توجد بيانات",
                    paginate: {
                        first: "الأول",
                        last: "الأخير",
                        next: "التالي",
                        previous: "السابق"
                    }
                },
                dom: 'Bfrtip',
                buttons: [
                    { extend: 'copy', text: '<i class="fas fa-copy"></i> نسخ', className: 'btn btn-secondary' },
                    { extend: 'excel', text: '<i class="fas fa-file-excel"></i> Excel', className: 'btn btn-success' },
                    { extend: 'print', text: '<i class="fas fa-print"></i> طباعة', className: 'btn btn-primary' }
                ]
            });
        });
    </script>
}
