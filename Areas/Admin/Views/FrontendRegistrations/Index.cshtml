@model IEnumerable<QdratNew.Entities.Frontend.FrontendCourseRegistration>
@{
    ViewData["Title"] = "📋 تسجيلات الدورات";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<!-- ✅ روابط CSS و JS الخاصة بـ DataTables -->
<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<link href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css" rel="stylesheet" />

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>

<div class="container mt-4" dir="rtl">
    <div class="card shadow border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4">
            <h4 class="fw-bold mb-0">📋 إدارة التسجيلات</h4>
        </div>

        <div class="card-body">
            <table id="registrationsTable" class="table table-striped table-bordered align-middle text-center w-100">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>الاسم الكامل</th>
                        <th>رقم الهوية</th>
                        <th>الدورة</th>
                        <th>الجوال</th>
                        <th>تاريخ التسجيل</th>
                        <th>التواصل</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int index = 1;
                    }
                    @foreach (var r in Model)
                    {
                        <tr class="@(r.IsContacted ? "table-success" : "table-warning")">
                            <td>@index</td>
                            <td>@r.FullName</td>
                            <td>@r.NationalId</td>
                            <td>@r.SubCourse?.Title</td>
                            <td>@r.Phone</td>
                            <td>@r.CreatedAt.ToString("yyyy/MM/dd hh:mm tt")</td>
                            <td>
                                @if (r.IsContacted)
                                {
                                    <span class="badge bg-success px-3 py-2">تم التواصل ✅</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2">لم يتم التواصل ⏳</span>
                                }
                            </td>
                            <td>
                                <form asp-action="ToggleContactStatus" asp-route-id="@r.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm @(r.IsContacted ? "btn-outline-secondary" : "btn-outline-success") rounded-pill">
                                        @(r.IsContacted ? "إلغاء التواصل" : "تم التواصل")
                                    </button>
                                </form>

                                <button type="button"
                                        class="btn btn-sm btn-success rounded-pill approve-btn"
                                        data-id="@r.Id"
                                        data-name="@r.FullName"
                                        data-course="@r.SubCourse?.FrontendCourse?.Title">
                                    🎓 اعتماد كطالب
                                </button>


                                <a asp-action="Details" asp-route-id="@r.Id"
                                   class="btn btn-outline-primary btn-sm rounded-pill">📄 التفاصيل</a>

                                <a asp-action="Edit" asp-route-id="@r.Id"
                                   class="btn btn-outline-info btn-sm rounded-pill">
                                    ✏️ تعديل
                                </a>

                                <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill"
                                            onclick="return confirm('هل أنت متأكد من الحذف؟');">
                                        🗑️ حذف
                                    </button>
                                </form>
                            </td>
                        </tr>
                        index++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>



<script>
    $(document).ready(function () {
        $('#registrationsTable').DataTable({
            language: {
                url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json"
            },
            order: [[5, "desc"]], // 🔽 الترتيب حسب الأحدث
            pageLength: 10,
            dom: 'Bfrtip',
            buttons: [
                { extend: 'copyHtml5', text: '📋 نسخ', className: 'btn btn-outline-secondary btn-sm rounded-pill' },
                { extend: 'excelHtml5', text: '📊 Excel', className: 'btn btn-success btn-sm rounded-pill' },
                { extend: 'pdfHtml5', text: '📄 PDF', className: 'btn btn-danger btn-sm rounded-pill' },
                { extend: 'print', text: '🖨️ طباعة', className: 'btn btn-primary btn-sm rounded-pill' }
            ]
        });
    });
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    $(document).ready(function () {
        // ✅ DataTable setup
        var table = $('#registrationsTable').DataTable({
            language: { url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json" },
            order: [[5, "desc"]],
            pageLength: 10,
            dom: 'Bfrtip',
            buttons: [
                { extend: 'copyHtml5', text: '📋 نسخ', className: 'btn btn-outline-secondary btn-sm rounded-pill' },
                { extend: 'excelHtml5', text: '📊 Excel', className: 'btn btn-success btn-sm rounded-pill' },
                { extend: 'pdfHtml5', text: '📄 PDF', className: 'btn btn-danger btn-sm rounded-pill' },
                { extend: 'print', text: '🖨️ طباعة', className: 'btn btn-primary btn-sm rounded-pill' }
            ]
        });

        // ✅ عند الضغط على زر الاعتماد
        $(document).on("click", ".approve-btn", function () {
            var id = $(this).data("id");
            var name = $(this).data("name");
            var course = $(this).data("course");
            var row = $(this).closest("tr");

            Swal.fire({
                title: 'هل أنت متأكد؟',
                html: `سيتم اعتماد <b>${name}</b> كطالب في دورة <b>${course}</b>.<br>هل تريد المتابعة؟`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'نعم، اعتماد الآن',
                cancelButtonText: 'إلغاء',
                confirmButtonColor: '#28a745'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post(`/Admin/FrontendRegistrations/Approve/${id}`, function (res) {
                        if (res.success) {
                            Swal.fire({
                                title: 'تم الاعتماد ✅',
                                html: `<b>${res.name}</b> تم تحويله إلى طالب.<br>الرجاء تسجيله في دفعة مناسبة.`,
                                icon: 'success',
                                confirmButtonText: 'حسناً'
                            });

                            // ✅ إزالة الصف من الجدول
                            table.row(row).remove().draw();
                        } else {
                            Swal.fire('خطأ', res.message || 'حدث خطأ غير متوقع', 'error');
                        }
                    }).fail(() => {
                        Swal.fire('❌ خطأ', 'فشل الاتصال بالخادم.', 'error');
                    });
                }
            });
        });
    });
</script>

<style>
    .dt-buttons {
        margin-bottom: 15px;
        text-align: center;
    }

        .dt-buttons .btn {
            margin: 0 5px;
        }

    table.dataTable thead th {
        background-color: #f8f9fa;
        color: #333;
        font-weight: 700;
    }

    .dataTables_filter input {
        border-radius: 20px;
        border: 1px solid #ccc;
        padding: 4px 10px;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button {
        border-radius: 50px !important;
    }
</style>
