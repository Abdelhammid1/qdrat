@model QdratNew.Entities.Frontend.FrontendCourseRegistration

@{
    ViewData["Title"] = "تعديل بيانات المتقدم";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var subCourseTitle = Model.SubCourse != null && !string.IsNullOrWhiteSpace(Model.SubCourse.Title)
        ? Model.SubCourse.Title
        : "غير محدد";
}

<div class="qdrat-page-wrapper" dir="rtl">
    <div class="qdrat-page-header">
        <div>
            <h1 class="qdrat-page-title">
                <i class="fas fa-user-edit"></i>
                تعديل بيانات المتقدم
            </h1>
            <p class="qdrat-page-subtitle">
                تحديث بيانات المتقدم المسجل في الدورات المعروضة على الواجهة العامة.
            </p>
        </div>

        <a asp-action="Index" class="qdrat-back-btn">
            <i class="fas fa-arrow-right"></i>
            العودة للقائمة
        </a>
    </div>

    <form asp-action="Edit" method="post" class="qdrat-form-card">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div class="qdrat-card-header">
            <div class="qdrat-card-icon">
                <i class="fas fa-id-card"></i>
            </div>
            <div>
                <h2>بيانات المتقدم</h2>
                <p>راجع البيانات الأساسية وعدّل المطلوب فقط.</p>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="qdrat-validation-summary"></div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-user"></i>
                البيانات الشخصية
            </div>

            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="FullName" class="qdrat-label">
                            الاسم الكامل
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-user"></i>
                            <input asp-for="FullName"
                                   class="form-control qdrat-input"
                                   placeholder="أدخل الاسم الكامل" />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="NationalId" class="qdrat-label">
                            رقم الهوية الوطنية
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-address-card"></i>
                            <input asp-for="NationalId"
                                   class="form-control qdrat-input"
                                   maxlength="14"
                                   inputmode="numeric"
                                   placeholder="أدخل رقم الهوية" />
                        </div>
                        <span asp-validation-for="NationalId" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-phone-alt"></i>
                بيانات التواصل
            </div>

            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="Email" class="qdrat-label">
                            البريد الإلكتروني
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-envelope"></i>
                            <input asp-for="Email"
                                   class="form-control qdrat-input"
                                   placeholder="example@email.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="Phone" class="qdrat-label">
                            رقم الجوال
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-mobile-alt"></i>
                            <input asp-for="Phone"
                                   class="form-control qdrat-input"
                                   inputmode="tel"
                                   placeholder="05xxxxxxxx" />
                        </div>
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-graduation-cap"></i>
                بيانات الدورة
            </div>

            <div class="qdrat-readonly-course">
                <div class="qdrat-readonly-icon">
                    <i class="fas fa-book-open"></i>
                </div>
                <div class="qdrat-readonly-content">
                    <span>الدورة المسجل فيها</span>
                    <strong>@subCourseTitle</strong>
                </div>
            </div>
        </div>

        <div class="qdrat-actions">
            <button type="submit" class="qdrat-save-btn">
                <i class="fas fa-save"></i>
                حفظ التعديلات
            </button>

            <a asp-action="Index" class="qdrat-cancel-btn">
                <i class="fas fa-times"></i>
                إلغاء
            </a>
        </div>
    </form>
</div>

<style>
    .qdrat-page-wrapper {
        max-width: 1180px;
        margin: 0 auto;
        padding: 24px 16px 40px;
        font-family: 'Cairo', 'Tajawal', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .qdrat-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 22px;
        padding: 22px 24px;
        border-radius: 24px;
        background: linear-gradient(135deg, #0f766e 0%, #0891b2 55%, #2563eb 100%);
        color: #fff;
        box-shadow: 0 18px 45px rgba(15, 118, 110, 0.22);
    }

    .qdrat-page-title {
        margin: 0;
        font-size: 26px;
        font-weight: 900;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .qdrat-page-subtitle {
        margin: 8px 0 0;
        color: rgba(255, 255, 255, 0.88);
        font-size: 14px;
        line-height: 1.8;
    }

    .qdrat-back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 150px;
        padding: 11px 18px;
        border-radius: 999px;
        color: #fff;
        text-decoration: none;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.32);
        font-size: 14px;
        font-weight: 800;
        transition: all 0.2s ease-in-out;
    }

        .qdrat-back-btn:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.24);
            transform: translateY(-1px);
        }

    .qdrat-form-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 26px;
        box-shadow: 0 20px 55px rgba(15, 23, 42, 0.08);
        padding: 26px;
        overflow: hidden;
    }

    .qdrat-card-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding-bottom: 22px;
        border-bottom: 1px solid #eef2f7;
        margin-bottom: 24px;
    }

    .qdrat-card-icon {
        width: 54px;
        height: 54px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #ecfeff 0%, #dbeafe 100%);
        color: #0f766e;
        font-size: 22px;
        flex-shrink: 0;
    }

    .qdrat-card-header h2 {
        margin: 0;
        font-size: 20px;
        font-weight: 900;
        color: #111827;
    }

    .qdrat-card-header p {
        margin: 6px 0 0;
        color: #6b7280;
        font-size: 13px;
    }

    .qdrat-section {
        padding: 20px;
        border: 1px solid #eef2f7;
        background: #fbfdff;
        border-radius: 22px;
        margin-bottom: 20px;
    }

    .qdrat-section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 18px;
        color: #0f172a;
        font-size: 16px;
        font-weight: 900;
    }

        .qdrat-section-title i {
            color: #0f766e;
        }

    .qdrat-form-group {
        margin-bottom: 2px;
    }

    .qdrat-label {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 9px;
        color: #1f2937;
        font-size: 14px;
        font-weight: 900;
    }

    .qdrat-required {
        color: #dc2626;
        font-weight: 900;
    }

    .qdrat-input-wrapper {
        position: relative;
    }

        .qdrat-input-wrapper i {
            position: absolute;
            top: 50%;
            right: 15px;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 15px;
            z-index: 2;
        }

    .qdrat-input {
        height: 48px;
        border-radius: 16px;
        border: 1px solid #dbe3ef;
        background: #fff;
        padding: 10px 44px 10px 14px;
        color: #111827;
        font-size: 14px;
        font-weight: 700;
        transition: all 0.18s ease-in-out;
    }

        .qdrat-input:focus {
            border-color: #0f766e;
            box-shadow: 0 0 0 4px rgba(15, 118, 110, 0.10);
        }

    .qdrat-validation-summary {
        color: #b91c1c;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 16px;
        padding: 12px 16px;
        margin-bottom: 20px;
        font-size: 14px;
        font-weight: 700;
    }

        .qdrat-validation-summary:empty {
            display: none;
        }

    .qdrat-readonly-course {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px;
        border-radius: 18px;
        background: linear-gradient(135deg, #f8fafc 0%, #eef6ff 100%);
        border: 1px dashed #bfdbfe;
    }

    .qdrat-readonly-icon {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        color: #2563eb;
        font-size: 20px;
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.08);
        flex-shrink: 0;
    }

    .qdrat-readonly-content {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .qdrat-readonly-content span {
            color: #64748b;
            font-size: 13px;
            font-weight: 800;
        }

        .qdrat-readonly-content strong {
            color: #0f172a;
            font-size: 16px;
            font-weight: 900;
        }

    .qdrat-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding-top: 8px;
        flex-wrap: wrap;
    }

    .qdrat-save-btn,
    .qdrat-cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-width: 170px;
        min-height: 48px;
        border-radius: 999px;
        font-size: 15px;
        font-weight: 900;
        text-decoration: none;
        border: none;
        transition: all 0.2s ease-in-out;
    }

    .qdrat-save-btn {
        color: #fff;
        background: linear-gradient(135deg, #16a34a 0%, #0f766e 100%);
        box-shadow: 0 14px 30px rgba(22, 163, 74, 0.22);
    }

        .qdrat-save-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 18px 34px rgba(22, 163, 74, 0.28);
        }

    .qdrat-cancel-btn {
        color: #334155;
        background: #fff;
        border: 1px solid #cbd5e1;
    }

        .qdrat-cancel-btn:hover {
            color: #0f172a;
            background: #f8fafc;
            transform: translateY(-1px);
        }

    @@media (max-width: 768px) {
        .qdrat-page-header {
            flex-direction: column;
            align-items: stretch;
            padding: 20px;
        }

        .qdrat-page-title {
            font-size: 21px;
        }

        .qdrat-back-btn {
            width: 100%;
        }

        .qdrat-form-card {
            padding: 18px;
            border-radius: 22px;
        }

        .qdrat-section {
            padding: 16px;
        }

        .qdrat-actions {
            flex-direction: column;
        }

        .qdrat-save-btn,
        .qdrat-cancel-btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}