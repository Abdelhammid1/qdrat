@model QdratNew.Entities.Frontend.FrontendCourseRegistration
@{
    ViewData["Title"] = "📋 تفاصيل التسجيل";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4" dir="rtl">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4 d-flex justify-content-between align-items-center">
            <h4 class="fw-bold mb-0">📋 تفاصيل التسجيل في الدورة</h4>
            <a asp-action="Index" class="btn btn-light btn-sm rounded-pill fw-bold">
                ⬅️ رجوع إلى القائمة
            </a>
        </div>

        <div class="card-body bg-light p-4">
            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="p-3 bg-white rounded-4 shadow-sm h-100">
                        <h6 class="fw-bold text-secondary mb-2">الدورة المسجل بها</h6>
                        <p class="mb-1 text-dark">
                            <strong>@(Model.SubCourse?.Title ?? "—")</strong>
                        </p>
                        <small class="text-muted">
                            البرنامج: @Model.SubCourse?.FrontendCourse?.Title
                        </small>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-white rounded-4 shadow-sm h-100">
                        <h6 class="fw-bold text-secondary mb-2">حالة التواصل</h6>
                        @if (Model.IsContacted)
                        {
                            <span class="badge bg-success px-3 py-2">✅ تم التواصل</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark px-3 py-2">⏳ لم يتم التواصل</span>
                        }
                    </div>
                </div>
            </div>

            <div class="p-3 bg-white rounded-4 shadow-sm mb-3">
                <h5 class="fw-bold text-primary mb-3">👤 بيانات المتقدم</h5>
                <dl class="row mb-0">
                    <dt class="col-sm-3 fw-bold text-secondary">الاسم الكامل</dt>
                    <dd class="col-sm-9">@Model.FullName</dd>

                    <dt class="col-sm-3 fw-bold text-secondary">رقم الهوية الوطنية</dt>
                    <dd class="col-sm-9">@Model.NationalId</dd>

                    <dt class="col-sm-3 fw-bold text-secondary">البريد الإلكتروني</dt>
                    <dd class="col-sm-9">@Model.Email</dd>

                    <dt class="col-sm-3 fw-bold text-secondary">رقم الجوال</dt>
                    <dd class="col-sm-9">@Model.Phone</dd>
                </dl>
            </div>

            <div class="p-3 bg-white rounded-4 shadow-sm mb-3">
                <h5 class="fw-bold text-primary mb-3">🕓 معلومات التسجيل</h5>
                <dl class="row mb-0">
                    <dt class="col-sm-3 fw-bold text-secondary">تاريخ التسجيل</dt>
                    <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy/MM/dd hh:mm tt")</dd>

                    <dt class="col-sm-3 fw-bold text-secondary">آخر تعديل</dt>
                    <dd class="col-sm-9">
                        @if (Model.UpdatedAt != null)
                        {
                            <span>@Model.UpdatedAt.Value.ToString("yyyy/MM/dd hh:mm tt")</span>
                            <small class="text-muted d-block">بواسطة: @Model.UpdatedBy</small>
                        }
                        else
                        {
                            <span class="text-muted">لم يتم تعديل البيانات بعد</span>
                        }
                    </dd>
                </dl>
            </div>

            <div class="text-center mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id"
                   class="btn btn-outline-info rounded-pill mx-1 px-4">✏️ تعديل البيانات</a>

                @if (!Model.IsContacted)
                {
                    <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-success rounded-pill mx-1 px-4"
                                onclick="return confirm('هل تريد اعتماد هذا المتقدم كطالب رسمي؟');">
                            🎓 اعتماد كطالب
                        </button>
                    </form>
                }

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-danger rounded-pill mx-1 px-4"
                            onclick="return confirm('هل أنت متأكد من حذف هذا السجل؟');">
                        🗑️ حذف التسجيل
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    dt {
        color: #555;
        margin-bottom: 6px;
    }

    dd {
        color: #000;
        margin-bottom: 10px;
    }

    .card-body section {
        margin-bottom: 1.5rem;
    }

    .badge {
        font-size: 0.9rem;
    }

    .card-header h4 {
        font-size: 1.2rem;
    }

    .p-3 {
        background-color: #fff;
    }
</style>
