                        </div>
                        <div class="pr-cur-stat-item">
                            <span class="pr-cur-stat-dot" style="background:#3b82f6;"></span>
                            <span>كمي: @item.QuantitativeCount</span>
                        </div>
                        <div class="pr-cur-stat-item">
                            <span class="pr-cur-stat-dot" style="background:#a855f7;"></span>
                            <span>لفظي: @item.VerbalCount</span>
                        </div>
                    </div>
                    <div class="pr-cur-date">
                        <i class="fas fa-clock" style="font-size:10px;"></i>
                        أقدم سؤال: @(item.OldestCreatedAt?.ToString("yyyy/MM/dd") ?? "—")
                    </div>
                </a>
            }
        </div>
    }

    @* ─── Filter Panel ─── *@
    <div class="pr-section-label">الفلاتر</div>
    <div class="pr-filter-panel mb-4">
        <form method="get" asp-action="PendingReview" class="row g-3 align-items-end">
