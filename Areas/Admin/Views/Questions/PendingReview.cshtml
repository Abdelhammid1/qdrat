        </form>
    </div>

    @* ─── Bulk Actions Toolbar ─── *@
    <div class="pr-toolbar">
        <div class="d-flex align-items-center gap-12 flex-wrap" style="gap:12px;">
            <div class="fw-semibold" style="font-size:14px;color:#fff;">جدول الاعتماد</div>
            <span class="pr-selected-badge empty" id="selectedBadge">
                <i class="fas fa-square-check" style="font-size:11px;"></i>
                <span id="selectedCount">0</span> سؤال محدد
            </span>
            <select id="assignmentFilter" class="qrt-assign-filter" aria-label="فلتر الإسناد">
                <option value="">الكل (مُسند وغير مُسند)</option>
                <option value="unassigned">غير مُسند</option>
                <option value="assigned">مُسند لمهمة مراجعة</option>
