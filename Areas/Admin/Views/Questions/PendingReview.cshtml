                    <div class="pr-cur-card-head">
                        <div>
                            <div class="pr-cur-card-title">@item.CurriculumTitle</div>
                            <div class="pr-cur-card-sub">
                                <i class="fas fa-layer-group" style="font-size:10px;"></i>
                                @item.SectionsCount محور
                            </div>
                        </div>
                        <span class="pr-badge-count">@item.PendingCount</span>
                    </div>
                    <div class="pr-cur-stats">
                        <div class="pr-cur-stat-item">
                            <span class="pr-cur-stat-dot" style="background:#22c55e;"></span>
                            <span style="color:#86efac;">مؤكد: @item.ConfirmedAnswersCount</span>
                        </div>
                        <div class="pr-cur-stat-item">
                            <span class="pr-cur-stat-dot" style="background:#ef4444;"></span>
