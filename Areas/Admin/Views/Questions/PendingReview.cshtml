        }

        /* ═══ QRT-S2: إسناد كمهمة مراجعة — ألوان الأدوار: الإدارة Slate-indigo، المدرب Terracotta، النجاح أخضر ═══ */
        :root {
            --qrt-admin: #434a63;
            --qrt-admin-dark: #343a50;
            --qrt-instructor: #da784d;
            --qrt-success: #198754;
            --qrt-danger: #c94141;
            --qrt-ink: #161b26;
            --qrt-muted: #4c5566;
            --qrt-line: #dde1e7;
            --qrt-soft: #f7f8fa;
        }

        .btn-qrt-assign {
            background: var(--qrt-admin);
            border: 1px solid var(--qrt-admin);
            color: #fff;
            font-size: 13px;
            font-weight: 700;
            border-radius: var(--pr-radius-sm);
            padding: 8px 18px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            transition: var(--pr-transition);
        }

            .btn-qrt-assign:hover:not(:disabled) {
                background: var(--qrt-admin-dark);
                color: #fff;
                box-shadow: 0 4px 14px rgba(67,74,99,.35);
            }

            .btn-qrt-assign:disabled {
                opacity: .45;
                cursor: not-allowed;
            }

            .btn-qrt-assign .qrt-count {
                background: rgba(255,255,255,.2);
                border-radius: 999px;
                padding: 0 8px;
                font-size: 12px;
            }

        .qrt-assign-filter {
            background: #fff;
            color: var(--qrt-ink);
            border: 1px solid var(--qrt-line);
            border-radius: var(--pr-radius-sm);
            font-size: 13px;
            font-weight: 600;
            height: 38px;
            padding: 0 12px;
        }

        .qrt-tag {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: #fdf0ea;
            color: #b4552d !important;
            border: 1px solid #f3c9b6;
            border-radius: 999px;
            padding: 2px 10px;
            font-size: 11px;
            font-weight: 800;
            white-space: nowrap;
        }

        .qrt-tag-code {
            font-family: monospace;
            color: var(--qrt-admin) !important;
            font-size: 11px;
            margin-top: 3px;
            display: block;
        }

        .qrt-none {
            color: #8a93a3 !important;
            font-size: 12px;
        }

        /* المودال: سطح فاتح بألوان صريحة (مستقل عن ثيم الصفحة) */
        #assignTaskModal .modal-content {
            background: #fff !important;
            color: var(--qrt-ink) !important;
            border: 1px solid var(--qrt-line) !important;
            border-radius: 14px;
            overflow: hidden;
        }

        #assignTaskModal .modal-header {
            background: var(--qrt-admin) !important;
            color: #fff !important;
            border-bottom: 0 !important;
        }

        #assignTaskModal .modal-title {
            color: #fff !important;
            font-weight: 800 !important;
            font-size: 16px;
        }

        #assignTaskModal .btn-close {
            filter: invert(1) brightness(2) !important;
            opacity: .9 !important;
        }

        #assignTaskModal .modal-body {
            padding: 20px;
        }

        #assignTaskModal .form-label {
            font-size: 12px;
            font-weight: 800;
            color: var(--qrt-muted);
            margin-bottom: 4px;
        }

        #assignTaskModal .form-control,
        #assignTaskModal .form-select {
            background: #fff;
            color: var(--qrt-ink);
            border: 1px solid #b8c0cc;
            border-radius: 8px;
            font-size: 13px;
        }

            #assignTaskModal .form-control:focus,
            #assignTaskModal .form-select:focus {
                border-color: var(--qrt-admin);
                box-shadow: 0 0 0 3px rgba(67,74,99,.15);
            }

        .qrt-tabs {
            display: flex;
            gap: 6px;
            background: var(--qrt-soft);
            border: 1px solid var(--qrt-line);
            border-radius: 10px;
            padding: 4px;
        }

        .qrt-tab {
            flex: 1;
            background: transparent;
            border: 0;
            border-radius: 8px;
            padding: 8px 10px;
            font-size: 13px;
            font-weight: 800;
            color: var(--qrt-muted);
            cursor: pointer;
        }

            .qrt-tab.active {
                background: var(--qrt-admin);
                color: #fff;
            }

        .qrt-mode-box {
            background: var(--qrt-soft);
            border: 1px dashed #b8c0cc;
            border-radius: 10px;
            padding: 12px 14px;
            font-size: 13px;
            color: var(--qrt-ink);
        }

            .qrt-mode-box strong {
                color: var(--qrt-admin);
            }

        .qrt-instructors {
            display: grid;
            gap: 8px;
            max-height: 240px;
            overflow-y: auto;
        }

        .qrt-instructor {
            display: flex;
            align-items: center;
            gap: 10px;
            border: 1px solid var(--qrt-line);
            border-radius: 10px;
            padding: 9px 12px;
            cursor: pointer;
            background: #fff;
        }

            .qrt-instructor:hover {
                border-color: var(--qrt-admin);
            }

            .qrt-instructor input {
                margin: 0;
                flex-shrink: 0;
            }

            .qrt-instructor.selected {
                border-color: var(--qrt-instructor);
                background: #fdf0ea;
            }

        .qrt-instructor-name {
            font-weight: 800;
            font-size: 13px;
            color: var(--qrt-ink);
        }

        .qrt-load {
            margin-inline-start: auto;
            background: #fdf0ea;
            color: #b4552d;
            border: 1px solid #f3c9b6;
            border-radius: 999px;
            padding: 1px 10px;
            font-size: 11px;
            font-weight: 800;
            white-space: nowrap;
        }

        .qrt-state {
            text-align: center;
            padding: 16px 10px;
            font-size: 13px;
            color: var(--qrt-muted);
            border: 1px dashed #b8c0cc;
            border-radius: 10px;
        }

        .qrt-alert {
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 13px;
            font-weight: 700;
        }

        .qrt-alert-danger {
            background: #fbeaea;
            color: #9b2c2c;
            border: 1px solid #f0c2c2;
        }

        .qrt-alert-info {
            background: #eef0f6;
            color: var(--qrt-admin);
            border: 1px solid #d3d8e6;
        }

        #assignTaskModal .modal-footer {
            border-top: 1px solid var(--qrt-line);
            background: var(--qrt-soft);
        }

        .btn-qrt-cancel {
            background: #fff;
            border: 1px solid #b8c0cc;
            color: var(--qrt-ink);
            font-size: 13px;
            font-weight: 700;
            border-radius: 8px;
            padding: 8px 18px;
        }

        .btn-qrt-submit {
            background: var(--qrt-success);
            border: 1px solid var(--qrt-success);
            color: #fff;
            font-size: 13px;
            font-weight: 800;
            border-radius: 8px;
            padding: 8px 20px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .btn-qrt-submit:disabled {
                opacity: .55;
                cursor: not-allowed;
            }

        @@media (max-width: 576px) {
            #assignTaskModal .modal-body {
                padding: 14px;
            }

            .qrt-instructor {
                flex-wrap: wrap;
            }
        }

    </style>
}

<div class="pr-page container-fluid px-4" dir="rtl">

    @* ─── Alerts ─── *@
    @if (TempData["Message"] != null)
    {
        <div class="pr-alert pr-alert-success d-flex align-items-center gap-2">
            <i class="fas fa-check-circle"></i> @TempData["Message"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="pr-alert pr-alert-danger d-flex align-items-center gap-2">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        </div>
    }

    @* ─── Page Header ─── *@
    <div class="pr-header">
        <div>
            <h1 class="pr-header-title">
                <i class="fas fa-shield-check me-2" style="color:var(--pr-accent);font-size:18px;"></i>
                مركز اعتماد الأسئلة
            </h1>
            <div class="pr-header-sub">مراجعة الأسئلة الجاهزة، تحليل المناهج، واعتماد فردي أو جماعي من مكان واحد.</div>
        </div>
        <div class="pr-header-actions">
            <a asp-action="Dashboard" class="btn-pr-ghost">
                <i class="fas fa-chart-line"></i> لوحة بنك الأسئلة
            </a>
            @if (canViewReviewTasks)
            {
                <a asp-controller="QuestionReviewTasks" asp-action="Index" class="btn-pr-ghost">
                    <i class="fas fa-clipboard-check"></i> متابعة مهام المراجعة
                </a>
            }
            <a asp-action="Index" class="btn-pr-outline">
                <i class="fas fa-database"></i> بنك الأسئلة
            </a>
            <a asp-action="Create" class="btn-pr-primary">
                <i class="fas fa-plus"></i> إضافة سؤال
            </a>
        </div>
    </div>

    @* ─── Hero Banner ─── *@
    <div class="pr-hero mb-4">
        <div class="row g-4 align-items-center">
            <div class="col-lg-4">
                <div class="pr-hero-label">إجمالي الأسئلة المنتظرة</div>
                <div class="pr-hero-number">@totalPending</div>
                <div class="pr-hero-filtered">
                    <i class="fas fa-filter" style="font-size:10px;"></i>
                    بعد الفلاتر: @filteredPending سؤال
                </div>
            </div>
            <div class="col-lg-8">
                <div class="pr-chips">
                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#86efac;">@Model.PendingReviewConfirmedAnswersCount</div>
                        <div class="pr-chip-lbl">إجابة مؤكدة</div>
                    </div>
                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#fca5a5;">@Model.PendingReviewUnconfirmedAnswersCount</div>
                        <div class="pr-chip-lbl">غير مؤكدة</div>
                    </div>
                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#93c5fd;">@Model.PendingReviewQuantitativeCount</div>
                        <div class="pr-chip-lbl">كمي</div>
                    </div>
                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#d8b4fe;">@Model.PendingReviewVerbalCount</div>
                        <div class="pr-chip-lbl">لفظي</div>
                    </div>
                </div>
                <div class="pr-progress-wrap">
                    <div class="pr-progress-fill" style="width:@confirmedPercent%;"></div>
                </div>
                <div class="pr-progress-meta">
                    <span>الإجابات المؤكدة @confirmedPercent%</span>
                    <span>غير المؤكدة @unconfirmedPercent%</span>
                </div>
            </div>
        </div>
    </div>

    @* ─── Curriculum Cards ─── *@
    @if (Model.PendingReviewCurriculumStats.Any())
    {
        <div class="pr-section-label">توزيع الأسئلة على المناهج</div>
        <div class="pr-cur-grid">
            @foreach (var item in Model.PendingReviewCurriculumStats)
