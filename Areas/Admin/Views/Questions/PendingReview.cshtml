        <div class="d-flex flex-wrap gap-2">
            @if (canAssignReviewTask)
            {
                <button type="button" class="btn-qrt-assign" id="openAssignTaskBtn">
                    <i class="fa-solid fa-user-check"></i> إسناد كمهمة مراجعة
                    <span class="qrt-count" id="selCount">0</span>
                </button>
            }
            <form method="post" asp-action="ApproveQuestions" id="bulkApproveForm">
                @Html.AntiForgeryToken()
                <div id="selectedInputs"></div>
                <button type="button" class="btn-pr-primary" id="bulkApproveBtn" disabled>
                    <i class="fas fa-check-double"></i> اعتماد المحدد
                </button>
            </form>

            <form method="post" asp-action="ApprovePendingReviewFiltered" id="approveFilteredForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="curriculumId" value="@Model.CurriculumId" />
                <input type="hidden" name="sectionId" value="@Model.SectionId" />
                <input type="hidden" name="lessonId" value="@Model.LessonId" />
                <input type="hidden" name="searchTitle" value="@Model.SearchTitle" />
                <button type="button" class="btn-pr-outline" id="approveFilteredBtn" @(filteredPending == 0 ? "disabled" : "")>
                    <i class="fas fa-list-check"></i> اعتماد كل الفلتر (@filteredPending)
                </button>
            </form>
        </div>
    </div>

    @* ─── Questions Table ─── *@
    <div class="pr-table-panel">
        <div class="table-responsive">
            <table class="table table-hover w-100" id="questionsTable">
                <thead>
                    <tr>
                        <th style="width:40px;">
                            <input type="checkbox" class="form-check-input pr-check" id="selectAllVisible" />
                        </th>
                        <th style="width:90px;"># مرجع</th>
                        <th>السؤال</th>
                        <th>القسم</th>
                        <th>المحور</th>
                        <th>المؤشر</th>
                        <th>الإجابة</th>
                        <th>مسند إلى</th>
                        <th>التاريخ</th>
                        <th style="width:100px;">اعتماد</th>
                        <th style="width:130px;">إجراءات</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

</div>

