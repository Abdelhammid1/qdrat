            #questionPreviewModalBody .card p,
            #questionPreviewModalBody .card span,
            #questionPreviewModalBody .card div,
            #questionPreviewModalBody .card label,
            #questionPreviewModalBody .question-card p,
            #questionPreviewModalBody .question-card span,
            #questionPreviewModalBody .question-card div,
            #questionPreviewModalBody .question-card label,
            #questionPreviewModalBody .question-preview-card p,
            #questionPreviewModalBody .question-preview-card span,
            #questionPreviewModalBody .question-preview-card div,
            #questionPreviewModalBody .question-preview-card label {
                color: #0f172a !important;
            }

            /* نص السؤال نفسه */
            #questionPreviewModalBody .question-text,
            #questionPreviewModalBody .q-text,
            #questionPreviewModalBody .question-content,
            #questionPreviewModalBody .preview-question-text {
