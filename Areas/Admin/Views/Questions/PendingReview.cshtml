}

/* التشيك بوكس - مهم جدًا */
.form-check-input.pr-check,
.pr-table-panel input[type="checkbox"].pr-check,
#selectAllVisible,
.row-select {
    width: 20px !important;
    height: 20px !important;
    min-width: 20px !important;
    min-height: 20px !important;
    background-color: #ffffff !important;
    border: 2px solid #2563eb !important;
    border-radius: 6px !important;
    cursor: pointer !important;
    opacity: 1 !important;
    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.12) !important;
    appearance: auto !important;
    -webkit-appearance: checkbox !important;
}

/* عند الاختيار */
.form-check-input.pr-check:checked,
.pr-table-panel input[type="checkbox"].pr-check:checked,
#selectAllVisible:checked,
.row-select:checked {
    background-color: #2563eb !important;
    border-color: #1d4ed8 !important;
}

/* تحسين محاذاة أول عمود */
.pr-table-panel table.dataTable tbody td:first-child,
.pr-table-panel table.dataTable thead th:first-child {
    text-align: center !important;
