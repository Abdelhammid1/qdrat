@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        /* ─── State ─── */
        const selectedQuestions = new Set();

        function rowId(row) {
            return row.id || row.Id;
        }

        /* ─── Selected badge update ─── */
        function updateBulkState() {
            const count = selectedQuestions.size;
            const badge = document.getElementById('selectedBadge');
            document.getElementById('selectedCount').textContent = count;
            const selCountEl = document.getElementById('selCount'); // زر الإسناد (قد لا يظهر حسب الصلاحية)
            if (selCountEl) selCountEl.textContent = count;
            document.getElementById('bulkApproveBtn').disabled = count === 0;

            if (count > 0) {
                badge.classList.remove('empty');
            } else {
                badge.classList.add('empty');
            }

            const container = document.getElementById('selectedInputs');
            container.innerHTML = '';
            selectedQuestions.forEach(id => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'selectedIds';
                input.value = id;
                container.appendChild(input);
            });
        }

        /* ─── DataTable Init ─── */
        function antiForgeryToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        const questionsTable = $('#questionsTable').DataTable({
            serverSide: true,   // QRT-S2.2: Paging خادمي (≤100 في الخادم)
            order: [[8, 'desc']], // الترتيب ينفَّذ في الخادم (الأحدث أولًا افتراضيًا)
            ajax: {
                url: '/Admin/Questions/LoadPendingReviewQuestionsData',
                type: 'POST',
                headers: { 'RequestVerificationToken': antiForgeryToken() },
                data: function (d) {
                    d.curriculumId = $('#CurriculumId').val();
                    d.sectionId    = $('#SectionId').val();
                    d.lessonId     = $('#LessonId').val();
                    d.searchTitle  = $('#SearchTitle').val();
                    d.assignment   = $('#assignmentFilter').val();
                },
                dataSrc: 'data'
            },
            pageLength: 25,
            columns: [
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function (_, __, row) {
                        const id = rowId(row);
                        // السؤال المحجوز لا يُحدَّد للإسناد (الاعتماد المباشر للأدمن يبقى متاحًا)
                        if (row.isLocked) {
                            return `<input type="checkbox" class="form-check-input pr-check row-select" disabled title="محجوز ضمن مهمة مراجعة" />`;
                        }
                        const checked = selectedQuestions.has(String(id)) ? 'checked' : '';
                        return `<input type="checkbox" class="form-check-input pr-check row-select" value="${id}" ${checked} />`;
                    }
                },
                {
                    data: 'referenceNumber',
                    render: function (data) {
                        return `<span class="pr-q-ref">${data ?? '—'}</span>`;
                    }
                },
                {
                    data: null,
                    className: 'dt-body-right',
                    render: function (_, __, row) {
                        const id = rowId(row);
                        const type = row.isQuantitative
                            ? `<span class="pr-badge pr-badge-quant ms-1">كمي</span>`
                            : `<span class="pr-badge pr-badge-verbal ms-1">لفظي</span>`;

                        const labels = (row.labels && row.labels.length > 0)
                            ? row.labels.map(l => `<span class="pr-badge pr-badge-tag">${l}</span>`).join(' ')
                            : '';

                        return `
                            <div class="pr-q-title">
                                <button class="pr-action-btn preview flex-shrink-0" type="button" onclick="showQuestionPreview('${id}')" title="معاينة">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <div>
                                    <div class="pr-q-title-text">${row.titlePreview ?? row.title ?? ''}</div>
                                    <div class="d-flex flex-wrap gap-1 mt-1">${type}${labels}</div>
                                </div>
                            </div>`;
                    }
                },
                {
                    data: 'curriculum',
                    render: function (data) {
                        return `<span style="font-size:12px;color:var(--pr-muted);">${data ?? '—'}</span>`;
                    }
                },
                {
                    data: 'section',
                    render: function (data) {
                        return `<span style="font-size:12px;color:var(--pr-muted);">${data ?? '—'}</span>`;
                    }
                },
                {
                    data: 'lesson',
                    render: function (data) {
                        return `<span style="font-size:12px;color:var(--pr-muted);">${data ?? '—'}</span>`;
                    }
                },
                {
                    data: 'isAnswerConfirmed',
                    render: function (data) {
                        return data
                            ? `<span class="pr-badge pr-badge-confirmed"><i class="fas fa-check" style="font-size:9px;"></i> مؤكدة</span>`
                            : `<span class="pr-badge pr-badge-unconfirmed"><i class="fas fa-xmark" style="font-size:9px;"></i> غير مؤكدة</span>`;
                    }
                },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function (_, __, row) {
                        if (!row.isLocked) return '<span class="qrt-none">—</span>';
                        return `<span class="qrt-tag"><i class="fa-solid fa-lock" style="font-size:9px;"></i> ${escapeHtml(row.assignedTo)}</span>` +
                               `<span class="qrt-tag-code">${escapeHtml(row.taskCode)}</span>`;
                    }
                },
                {
                    data: 'createdAt',
                    render: function (data) {
                        return `<span style="font-size:12px;color:var(--pr-muted);">${data ?? '—'}</span>`;
                    }
                },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function (_, __, row) {
                        const id = rowId(row);
                        return `<button type="button" class="btn-pr-success" onclick="approveSingle('${id}')">
                                    <i class="fas fa-check-circle"></i> اعتماد
                                </button>`;
                    }
                },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function (_, __, row) {
                        const id = rowId(row);
                        return `
                            <div class="pr-action-group">
                                <a href="/Admin/Questions/Edit/${id}" target="_blank" class="pr-action-btn edit" title="تعديل">
                                    <i class="fas fa-pen"></i>
                                </a>
                                <a href="/Admin/Questions/Details/${id}" class="pr-action-btn detail" title="التفاصيل">
                                    <i class="fas fa-info-circle"></i>
                                </a>
                                <button type="button" class="pr-action-btn audit" onclick="openAuditModal('${id}')" title="آخر التعديلات">
                                    <i class="fas fa-history"></i>
                                </button>
                                <button type="button" class="pr-action-btn similar" onclick="checkSimilar('${id}')" title="فحص التشابه">
                                    <i class="fas fa-copy"></i>
                                </button>
                            </div>`;
                    }
                }
            ],
            language: {
                url: "//cdn.datatables.net/plug-ins/1.13.5/i18n/ar.json"
            },
            drawCallback: function () {
                $('#selectAllVisible').prop('checked', false);
            }
        });

        /* ─── Row Checkbox ─── */
        $('#questionsTable').on('change', '.row-select', function () {
            const id = String(this.value);
            if (this.checked) {
                selectedQuestions.add(id);
            } else {
                selectedQuestions.delete(id);
            }
            updateBulkState();
        });

        /* ─── Select All Visible ─── */
        $('#selectAllVisible').on('change', function () {
            const checked = this.checked;
            $('#questionsTable .row-select:not(:disabled)').each(function () {
                this.checked = checked;
                const id = String(this.value);
                if (checked) {
                    selectedQuestions.add(id);
                } else {
                    selectedQuestions.delete(id);
                }
            });
            updateBulkState();
        });

        /* ─── Bulk Approve ─── */
        $('#bulkApproveBtn').on('click', function () {
            Swal.fire({
                icon: 'question',
                title: 'اعتماد الأسئلة المحددة؟',
                text: `سيتم اعتماد ${selectedQuestions.size} سؤال بعد التحقق من صلاحيتها.`,
                showCancelButton: true,
                confirmButtonText: 'اعتماد',
                cancelButtonText: 'إلغاء'
            }).then(result => {
                if (result.isConfirmed) {
                    document.getElementById('bulkApproveForm').submit();
                }
            });
        });

        /* ─── Approve Filtered ─── */
        $('#approveFilteredBtn').on('click', function () {
            Swal.fire({
                icon: 'warning',
                title: 'اعتماد كل نتائج الفلتر؟',
                text: 'سيتم اعتماد كل الأسئلة الصالحة المطابقة للفلاتر الحالية، وليس الصفحة المعروضة فقط.',
                showCancelButton: true,
                confirmButtonText: 'اعتماد الكل',
                cancelButtonText: 'إلغاء'
            }).then(result => {
                if (result.isConfirmed) {
                    document.getElementById('approveFilteredForm').submit();
                }
            });
        });

        /* ─── Approve Single (Fetch) ─── */
        async function approveSingle(questionId) {
            const result = await Swal.fire({
                icon: 'question',
                title: 'اعتماد هذا السؤال؟',
                showCancelButton: true,
                confirmButtonText: 'اعتماد',
                cancelButtonText: 'إلغاء'
            });

            if (!result.isConfirmed) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            try {
                const response = await fetch('/Admin/Questions/ApproveSingleQuestion', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    body: new URLSearchParams({
                        selectedId: questionId,
                        __RequestVerificationToken: token
                    })
                });

                if (!response.ok) throw new Error('فشل الاتصال بالخادم');

                const data = await response.json();
                if (data.success) {
                    selectedQuestions.delete(String(questionId));
                    updateBulkState();
                    questionsTable.ajax.reload(null, false);
                    Swal.fire('تم الاعتماد', data.message, 'success');
                } else {
                    Swal.fire('تنبيه', data.message, 'warning');
                }
            } catch {
                Swal.fire('خطأ', 'حدث خطأ غير متوقع، يرجى المحاولة مجدداً.', 'error');
            }
        }

        /* ─── Preview Modal ─── */
        function showQuestionPreview(id) {
            const body = document.getElementById('questionPreviewModalBody');
            body.innerHTML = '<div class="pr-empty"><i class="fas fa-spinner fa-spin fa-2x"></i><p class="mt-2">جارٍ التحميل…</p></div>';
            const modal = new bootstrap.Modal(document.getElementById('questionPreviewModal'));
            modal.show();

            fetch(`/Admin/Questions/Preview/${id}`)
                .then(r => r.text())
                .then(html => { body.innerHTML = html; })
                .catch(() => {
                    body.innerHTML = '<div class="pr-empty"><i class="fas fa-exclamation-triangle"></i><p>حدث خطأ أثناء تحميل السؤال.</p></div>';
                });
        }

        /* ─── Audit Modal ─── */
        function openAuditModal(id) {
            const body = document.getElementById('auditModalBody');
            body.innerHTML = '<div class="pr-empty"><i class="fas fa-spinner fa-spin fa-2x"></i><p class="mt-2">جارٍ التحميل…</p></div>';
            new bootstrap.Modal(document.getElementById('auditModal')).show();

            fetch(`/Admin/Questions/Audit/${id}`)
                .then(r => r.text())
                .then(html => { body.innerHTML = html; })
                .catch(() => {
                    body.innerHTML = '<div class="pr-empty"><i class="fas fa-exclamation-triangle"></i><p>حدث خطأ في تحميل السجل.</p></div>';
                });
        }

        /* ─── Similar Check ─── */
        function checkSimilar(questionId) {
            const container = document.getElementById('similarResults');
            container.innerHTML = '<div class="text-center py-4" style="color:var(--pr-muted);"><i class="fas fa-spinner fa-spin fa-2x"></i></div>';
            new bootstrap.Modal(document.getElementById('similarModal')).show();

            fetch(`/Admin/Questions/CheckSimilarQuestions?id=${questionId}`)
                .then(res => res.json())
                .then(data => {
                    container.innerHTML = '';
                    if (data.length === 0) {
                        container.innerHTML = '<div class="text-center py-4" style="color:var(--pr-muted);"><i class="fas fa-check-circle fa-2x mb-2 d-block" style="color:#22c55e;"></i>لا يوجد أسئلة متشابهة بنسبة 80% أو أكثر.</div>';
                    } else {
                        data.forEach(q => {
                            const title = $('<div>').text(q.title || '').html();
                            const meta = [q.referenceNumber, q.lesson, q.matchType].filter(Boolean).map(x => $('<div>').text(x).html()).join(' · ');
                            container.innerHTML += `
                                <a href="/Admin/Questions/Details/${q.id}" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-start gap-2">
                                    <span>
                                        <span class="d-block fw-bold">${title}</span>
                                        <small class="text-muted">${meta}</small>
                                    </span>
                                    <span class="pr-badge pr-badge-quant">${(q.similarity * 100).toFixed(1)}%</span>
                                </a>`;
                        });
                    }
                })
                .catch(() => {
                    container.innerHTML = '<div class="text-center py-4" style="color:#fca5a5;"><i class="fas fa-exclamation-triangle"></i> فشل في تحميل الأسئلة المتشابهة.</div>';
                });
        }

        /* ─── QRT-S2.2: فلتر الإسناد ─── */
        $('#assignmentFilter').on('change', function () {
            questionsTable.ajax.reload();
        });

        /* ─── QRT-S2.3: إسناد كمهمة مراجعة ─── */
        (function () {
            const openBtn = document.getElementById('openAssignTaskBtn');
            const modalEl = document.getElementById('assignTaskModal');
            if (!openBtn || !modalEl) return; // المستخدم بلا صلاحية الإسناد

            const MAX_QUESTIONS = 500;
            const els = {
                error: document.getElementById('qrtFormError'),
                tabSelected: document.getElementById('qrtTabSelected'),
                tabFilter: document.getElementById('qrtTabFilter'),
                boxSelected: document.getElementById('qrtModeSelected'),
                boxFilter: document.getElementById('qrtModeFilter'),
                selectedInfo: document.getElementById('qrtSelectedInfo'),
                filterInfo: document.getElementById('qrtFilterInfo'),
                take: document.getElementById('qrtTakeCount'),
                title: document.getElementById('qrtTitle'),
                priority: document.getElementById('qrtPriority'),
                due: document.getElementById('qrtDue'),
                note: document.getElementById('qrtNote'),
                list: document.getElementById('qrtInstructors'),
                state: document.getElementById('qrtInstructorState'),
                reload: document.getElementById('qrtReloadInstructors'),
                submit: document.getElementById('qrtSubmit'),
                submitLabel: document.getElementById('qrtSubmitLabel')
            };
            const modal = new bootstrap.Modal(modalEl);

            let mode = 'selected';          // selected | filter
            let selectedInstructorId = null;
            let loadSeq = 0;                // لتجاهل ردود قديمة
            let submitting = false;
            let takeTimer = null;

            function showError(msg) {
                els.error.textContent = msg;
                els.error.classList.remove('d-none');
            }
            function clearError() {
                els.error.classList.add('d-none');
                els.error.textContent = '';
            }

            function selectOptionText(id) {
                const sel = document.getElementById(id);
                return sel && sel.value ? sel.options[sel.selectedIndex].text : '';
            }

            function filterSummary() {
                const parts = [selectOptionText('CurriculumId'), selectOptionText('SectionId'), selectOptionText('LessonId')].filter(Boolean);
                return parts.length ? parts.join(' ‹ ') : 'كل الأقسام (بدون تقييد)';
            }

            function takeCountValue() {
                const n = parseInt(els.take.value, 10);
                return Number.isInteger(n) ? n : null;
            }

            function updateSubmitState() {
                els.submit.disabled = submitting || !selectedInstructorId;
            }

            function setMode(next) {
                mode = next;
                els.tabSelected.classList.toggle('active', next === 'selected');
                els.tabFilter.classList.toggle('active', next === 'filter');
                els.boxSelected.classList.toggle('d-none', next !== 'selected');
                els.boxFilter.classList.toggle('d-none', next !== 'filter');
                els.selectedInfo.textContent = selectedQuestions.size;
                els.filterInfo.textContent = filterSummary();
                loadInstructors();
            }

            function buildSelectionFormData() {
                const fd = new FormData();
                if (mode === 'selected') {
                    selectedQuestions.forEach(id => fd.append('SelectedQuestionIds', id));
                } else {
                    const c = $('#CurriculumId').val(), s = $('#SectionId').val(), l = $('#LessonId').val();
                    if (c) fd.append('CurriculumId', c);
                    if (s) fd.append('SectionId', s);
                    if (l) fd.append('LessonId', l);
                    const n = takeCountValue();
                    if (n !== null) fd.append('TakeCount', n);
                }
                return fd;
            }

            function selectionProblem() {
                if (mode === 'selected') {
                    if (selectedQuestions.size === 0) return 'حدّد سؤالًا واحدًا على الأقل من الجدول، أو انتقل إلى تبويب «أول N حسب الفلتر».';
                    if (selectedQuestions.size > MAX_QUESTIONS) return `الحد الأقصى ${MAX_QUESTIONS} سؤال للمهمة الواحدة (المحدد ${selectedQuestions.size}).`;
                    return null;
                }
                const n = takeCountValue();
                if (n === null || n < 1 || n > MAX_QUESTIONS) return `أدخل عدد الأسئلة بين 1 و${MAX_QUESTIONS}.`;
                return null;
            }

            function renderState(text, icon) {
                els.list.replaceChildren();
                els.state.classList.remove('d-none');
                els.state.replaceChildren();
                if (icon) {
                    const i = document.createElement('i');
                    i.className = icon + ' me-1';
                    els.state.appendChild(i);
                }
                els.state.appendChild(document.createTextNode(text));
            }

            function renderInstructors(items) {
                els.state.classList.add('d-none');
                els.list.replaceChildren();
                items.forEach(item => {
                    const label = document.createElement('label');
                    label.className = 'qrt-instructor';
                    const radio = document.createElement('input');
                    radio.type = 'radio';
                    radio.name = 'qrtInstructor';
                    radio.value = item.id;
                    const name = document.createElement('span');
                    name.className = 'qrt-instructor-name';
                    name.textContent = item.fullName;
                    const load = document.createElement('span');
                    load.className = 'qrt-load';
                    load.textContent = item.activeLockedItems + ' سؤال بانتظار مراجعته';
                    label.append(radio, name, load);
                    radio.addEventListener('change', function () {
                        selectedInstructorId = item.id;
                        els.list.querySelectorAll('.qrt-instructor').forEach(x => x.classList.remove('selected'));
                        label.classList.add('selected');
                        updateSubmitState();
                    });
                    els.list.appendChild(label);
                });
            }

            async function loadInstructors() {
                const seq = ++loadSeq;
                selectedInstructorId = null;
                updateSubmitState();
                clearError();

                const problem = selectionProblem();
                if (problem) {
                    renderState(problem, 'fa-solid fa-circle-info');
                    return;
                }

                renderState('جارٍ تحميل المدربين المؤهلين…', 'fa-solid fa-spinner fa-spin');
                try {
                    const response = await fetch('/Admin/QuestionReviewTasks/EligibleInstructors', {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': antiForgeryToken() },
                        body: buildSelectionFormData()
                    });
                    if (!response.ok) throw new Error('http ' + response.status);
                    const data = await response.json();
                    if (seq !== loadSeq) return;

                    if (!data.success) {
                        renderState(data.message || 'تعذّر تحميل المدربين.', 'fa-solid fa-triangle-exclamation');
                        return;
                    }
                    const instructors = (data.data && data.data.instructors) || [];
                    if (instructors.length === 0) {
                        renderState(data.message || 'لا يوجد مدرب مؤهل لهذه الأسئلة.', 'fa-solid fa-user-slash');
                        return;
                    }
                    renderInstructors(instructors);
                } catch (e) {
                    if (seq !== loadSeq) return;
                    renderState('تعذّر الاتصال بالخادم. حاول تحديث القائمة.', 'fa-solid fa-plug-circle-exclamation');
                }
            }

            function setSubmitting(value) {
                submitting = value;
                els.submitLabel.textContent = value ? 'جارٍ الإنشاء…' : 'إنشاء المهمة وإسنادها';
                updateSubmitState();
            }

            async function submitTask() {
                if (submitting) return;
                clearError();

                const title = els.title.value.trim();
                if (title.length < 3) { showError('عنوان المهمة مطلوب (3 أحرف على الأقل).'); els.title.focus(); return; }
                const problem = selectionProblem();
                if (problem) { showError(problem); return; }
                if (!selectedInstructorId) { showError('اختر المدرب المسؤول.'); return; }
                if (els.due.value && new Date(els.due.value).getTime() <= Date.now()) {
                    showError('موعد التسليم يجب أن يكون في المستقبل.'); els.due.focus(); return;
                }

                const fd = buildSelectionFormData();
                fd.append('Title', title);
                fd.append('InstructorId', selectedInstructorId);
                fd.append('Priority', els.priority.value);
                if (els.note.value.trim()) fd.append('AdminNote', els.note.value.trim());
                if (els.due.value) fd.append('DueAtLocal', els.due.value);

                setSubmitting(true);
                try {
                    const response = await fetch('/Admin/QuestionReviewTasks/Create', {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': antiForgeryToken() },
                        body: fd
                    });
                    if (!response.ok) throw new Error('http ' + response.status);
                    const data = await response.json();

                    if (data.success) {
                        modal.hide();
                        selectedQuestions.clear();
                        updateBulkState();
                        questionsTable.ajax.reload(null, false);
                        Swal.fire('تم الإسناد', data.message, 'success');
                    } else {
                        showError(data.message || 'تعذّر إنشاء المهمة.');
                        loadInstructors(); // قد يكون التحديد تغيّر (حجز متزامن)
                    }
                } catch (e) {
                    showError('تعذّر الاتصال بالخادم. لم يتم إنشاء المهمة، حاول مرة أخرى.');
                } finally {
                    setSubmitting(false);
                }
            }

            openBtn.addEventListener('click', function () {
                els.title.value = '';
                els.note.value = '';
                els.due.value = '';
                els.priority.value = '0';
                els.take.value = '';
                clearError();
                setMode(selectedQuestions.size > 0 ? 'selected' : 'filter');
                modal.show();
            });

            els.tabSelected.addEventListener('click', () => setMode('selected'));
            els.tabFilter.addEventListener('click', () => setMode('filter'));
            els.reload.addEventListener('click', loadInstructors);
            els.take.addEventListener('input', function () {
                els.take.value = els.take.value.replace(/[^0-9]/g, '');
                clearTimeout(takeTimer);
                takeTimer = setTimeout(loadInstructors, 500);
            });
            els.submit.addEventListener('click', submitTask);
        })();
    </script>
}
