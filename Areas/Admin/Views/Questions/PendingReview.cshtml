        /* زر إغلاق المودال */
        #questionPreviewModal .btn-close {
            filter: invert(1) brightness(1.8) !important;
            opacity: 1 !important;
        }

        .pr-header {
            background: #ffffff !important;
            border: 1px solid #dbe4ef !important;
            border-radius: 14px !important;
            padding: 18px 22px !important;
            box-shadow: 0 8px 22px rgba(15, 23, 42, 0.06) !important;
        }

        .pr-header-title {
            color: #0f172a !important;
            font-size: 22px !important;
            font-weight: 900 !important;
            opacity: 1 !important;
        }

            .pr-header-title i {
                color: #2563eb !important;
                opacity: 1 !important;
            }

        .pr-header-sub {
            color: #475569 !important;
            font-size: 13px !important;
            font-weight: 600 !important;
            opacity: 1 !important;
        }

    </style>
}

<div class="pr-page container-fluid px-4" dir="rtl">

    @* ─── Alerts ─── *@
    @if (TempData["Message"] != null)
    {
        <div class="pr-alert pr-alert-success d-flex align-items-center gap-2">
            <i class="fas fa-check-circle"></i> @TempData["Message"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="pr-alert pr-alert-danger d-flex align-items-center gap-2">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        </div>
    }

    @* ─── Page Header ─── *@
    <div class="pr-header">
        <div>
            <h1 class="pr-header-title">
                <i class="fas fa-shield-check me-2" style="color:var(--pr-accent);font-size:18px;"></i>
                مركز اعتماد الأسئلة
            </h1>
            <div class="pr-header-sub">مراجعة الأسئلة الجاهزة، تحليل المناهج، واعتماد فردي أو جماعي من مكان واحد.</div>
        </div>
        <div class="pr-header-actions">
            <a asp-action="Dashboard" class="btn-pr-ghost">
                <i class="fas fa-chart-line"></i> لوحة بنك الأسئلة
            </a>
            <a asp-action="Index" class="btn-pr-outline">
                <i class="fas fa-database"></i> بنك الأسئلة
            </a>
            <a asp-action="Create" class="btn-pr-primary">
                <i class="fas fa-plus"></i> إضافة سؤال
            </a>
        </div>
    </div>

    @* ─── Hero Banner ─── *@
    <div class="pr-hero mb-4">
        <div class="row g-4 align-items-center">
            <div class="col-lg-4">
                <div class="pr-hero-label">إجمالي الأسئلة المنتظرة</div>
                <div class="pr-hero-number">@totalPending</div>
                <div class="pr-hero-filtered">
                    <i class="fas fa-filter" style="font-size:10px;"></i>
                    بعد الفلاتر: @filteredPending سؤال
                </div>
            </div>
            <div class="col-lg-8">
                <div class="pr-chips">
                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#86efac;">@Model.PendingReviewConfirmedAnswersCount</div>
                        <div class="pr-chip-lbl">إجابة مؤكدة</div>
                    </div>
                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#fca5a5;">@Model.PendingReviewUnconfirmedAnswersCount</div>
                        <div class="pr-chip-lbl">غير مؤكدة</div>
                    </div>
                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#93c5fd;">@Model.PendingReviewQuantitativeCount</div>
                        <div class="pr-chip-lbl">كمي</div>
                    </div>
                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#d8b4fe;">@Model.PendingReviewVerbalCount</div>
                        <div class="pr-chip-lbl">لفظي</div>
                    </div>
                </div>
                <div class="pr-progress-wrap">
                    <div class="pr-progress-fill" style="width:@confirmedPercent%;"></div>
                </div>
                <div class="pr-progress-meta">
                    <span>الإجابات المؤكدة @confirmedPercent%</span>
                    <span>غير المؤكدة @unconfirmedPercent%</span>
                </div>
            </div>
        </div>
    </div>

    @* ─── Curriculum Cards ─── *@
    @if (Model.PendingReviewCurriculumStats.Any())
    {
        <div class="pr-section-label">توزيع الأسئلة على المناهج</div>
        <div class="pr-cur-grid">
            @foreach (var item in Model.PendingReviewCurriculumStats)
            {
                <a class="pr-cur-card" asp-action="PendingReview" asp-route-curriculumId="@item.CurriculumId">
                    <div class="pr-cur-card-head">
                        <div>
                            <div class="pr-cur-card-title">@item.CurriculumTitle</div>
                            <div class="pr-cur-card-sub">
                                <i class="fas fa-layer-group" style="font-size:10px;"></i>
                                @item.SectionsCount محور
                            </div>
                        </div>
                        <span class="pr-badge-count">@item.PendingCount</span>
                    </div>
                    <div class="pr-cur-stats">
                        <div class="pr-cur-stat-item">
                            <span class="pr-cur-stat-dot" style="background:#22c55e;"></span>
                            <span style="color:#86efac;">مؤكد: @item.ConfirmedAnswersCount</span>
                        </div>
                        <div class="pr-cur-stat-item">
                            <span class="pr-cur-stat-dot" style="background:#ef4444;"></span>
                            <span style="color:#fca5a5;">غير مؤكد: @item.UnconfirmedAnswersCount</span>
                        </div>
                        <div class="pr-cur-stat-item">
                            <span class="pr-cur-stat-dot" style="background:#3b82f6;"></span>
                            <span>كمي: @item.QuantitativeCount</span>
                        </div>
                        <div class="pr-cur-stat-item">
                            <span class="pr-cur-stat-dot" style="background:#a855f7;"></span>
                            <span>لفظي: @item.VerbalCount</span>
                        </div>
                    </div>
                    <div class="pr-cur-date">
                        <i class="fas fa-clock" style="font-size:10px;"></i>
                        أقدم سؤال: @(item.OldestCreatedAt?.ToString("yyyy/MM/dd") ?? "—")
                    </div>
                </a>
            }
        </div>
    }

    @* ─── Filter Panel ─── *@
    <div class="pr-section-label">الفلاتر</div>
    <div class="pr-filter-panel mb-4">
        <form method="get" asp-action="PendingReview" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">القسم</label>
                <select asp-for="CurriculumId" class="form-select" asp-items="Model.Curriculums" id="CurriculumId">
                    <option value="">كل الأقسام</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">المحور</label>
                <select asp-for="SectionId" class="form-select" asp-items="Model.Sections" id="SectionId">
                    <option value="">كل المحاور</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">المؤشر</label>
                <select asp-for="LessonId" class="form-select" asp-items="Model.Lessons" id="LessonId">
                    <option value="">كل المؤشرات</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">بحث سريع</label>
                <div class="input-group">
                    <input asp-for="SearchTitle" class="form-control" id="SearchTitle" placeholder="كلمة من السؤال…" />
                </div>
            </div>
            <div class="col-12 d-flex flex-wrap gap-2 align-items-center">
                <button type="submit" class="btn-pr-primary">
                    <i class="fas fa-filter"></i> تطبيق الفلاتر
                </button>
                <a asp-action="PendingReview" class="btn-pr-outline">
                    <i class="fas fa-rotate-right"></i> إعادة تعيين
                </a>
            </div>
        </form>
    </div>

    @* ─── Bulk Actions Toolbar ─── *@
    <div class="pr-toolbar">
        <div class="d-flex align-items-center gap-12 flex-wrap" style="gap:12px;">
            <div class="fw-semibold" style="font-size:14px;color:#fff;">جدول الاعتماد</div>
            <span class="pr-selected-badge empty" id="selectedBadge">
                <i class="fas fa-square-check" style="font-size:11px;"></i>
                <span id="selectedCount">0</span> سؤال محدد
            </span>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <form method="post" asp-action="ApproveQuestions" id="bulkApproveForm">
                @Html.AntiForgeryToken()
                <div id="selectedInputs"></div>
                <button type="button" class="btn-pr-primary" id="bulkApproveBtn" disabled>
                    <i class="fas fa-check-double"></i> اعتماد المحدد
                </button>
            </form>

            <form method="post" asp-action="ApprovePendingReviewFiltered" id="approveFilteredForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="curriculumId" value="@Model.CurriculumId" />
                <input type="hidden" name="sectionId" value="@Model.SectionId" />
                <input type="hidden" name="lessonId" value="@Model.LessonId" />
                <input type="hidden" name="searchTitle" value="@Model.SearchTitle" />
                <button type="button" class="btn-pr-outline" id="approveFilteredBtn" @(filteredPending == 0 ? "disabled" : "")>
                    <i class="fas fa-list-check"></i> اعتماد كل الفلتر (@filteredPending)
                </button>
            </form>
        </div>
    </div>

    @* ─── Questions Table ─── *@
    <div class="pr-table-panel">
        <div class="table-responsive">
            <table class="table table-hover w-100" id="questionsTable">
                <thead>
                    <tr>
                        <th style="width:40px;">
                            <input type="checkbox" class="form-check-input pr-check" id="selectAllVisible" />
                        </th>
                        <th style="width:90px;"># مرجع</th>
                        <th>السؤال</th>
                        <th>القسم</th>
                        <th>المحور</th>
                        <th>المؤشر</th>
                        <th>الإجابة</th>
                        <th>التاريخ</th>
                        <th style="width:100px;">اعتماد</th>
                        <th style="width:130px;">إجراءات</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

</div>

@* ─── Modals ─── *@

@* Preview Modal *@
<div class="modal fade pr-modal" id="questionPreviewModal" tabindex="-1" dir="rtl">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-eye" style="color:var(--pr-accent);"></i>
                    معاينة السؤال
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="questionPreviewModalBody">
                <div class="pr-empty"><i class="fas fa-spinner fa-spin"></i><p>جارٍ التحميل…</p></div>
            </div>
        </div>
    </div>
</div>

@* Labels Modal *@
<div class="modal fade pr-modal" id="labelsModal" tabindex="-1" dir="rtl">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-tags" style="color:var(--pr-warning);"></i>
                    تصنيفات السؤال
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="labelsModalBody"></div>
        </div>
    </div>
</div>

@* Audit Modal *@
<div class="modal fade pr-modal" id="auditModal" tabindex="-1" dir="rtl">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-history" style="color:#d8b4fe;"></i>
                    آخر التعديلات
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="auditModalBody">
                <div class="pr-empty"><i class="fas fa-spinner fa-spin"></i><p>جارٍ التحميل…</p></div>
            </div>
        </div>
    </div>
</div>

@* Similar Modal *@
<div class="modal fade pr-modal" id="similarModal" tabindex="-1" dir="rtl">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-copy" style="color:#fca5a5;"></i>
                    نتائج فحص التشابه
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="list-group" id="similarResults"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        /* ─── State ─── */
        const selectedQuestions = new Set();

        function rowId(row) {
            return row.id || row.Id;
        }

        /* ─── Selected badge update ─── */
        function updateBulkState() {
            const count = selectedQuestions.size;
            const badge = document.getElementById('selectedBadge');
            document.getElementById('selectedCount').textContent = count;
            document.getElementById('bulkApproveBtn').disabled = count === 0;

            if (count > 0) {
                badge.classList.remove('empty');
            } else {
                badge.classList.add('empty');
            }

            const container = document.getElementById('selectedInputs');
            container.innerHTML = '';
            selectedQuestions.forEach(id => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'selectedIds';
                input.value = id;
                container.appendChild(input);
            });
        }

        /* ─── DataTable Init ─── */
        const questionsTable = $('#questionsTable').DataTable({
            ajax: {
                url: '/Admin/Questions/LoadPendingReviewQuestionsData',
                type: 'POST',
                data: function (d) {
                    d.curriculumId = $('#CurriculumId').val();
                    d.sectionId    = $('#SectionId').val();
                    d.lessonId     = $('#LessonId').val();
                    d.searchTitle  = $('#SearchTitle').val();
                },
                dataSrc: 'data'
            },
            order: [[7, 'desc']],
            pageLength: 25,
            columns: [
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function (_, __, row) {
                        const id = rowId(row);
                        const checked = selectedQuestions.has(String(id)) ? 'checked' : '';
                        return `<input type="checkbox" class="form-check-input pr-check row-select" value="${id}" ${checked} />`;
                    }
                },
                {
                    data: 'referenceNumber',
                    render: function (data) {
                        return `<span class="pr-q-ref">${data ?? '—'}</span>`;
                    }
                },
                {
                    data: null,
                    className: 'dt-body-right',
                    render: function (_, __, row) {
                        const id = rowId(row);
                        const type = row.isQuantitative
                            ? `<span class="pr-badge pr-badge-quant ms-1">كمي</span>`
                            : `<span class="pr-badge pr-badge-verbal ms-1">لفظي</span>`;

                        const labels = (row.labels && row.labels.length > 0)
                            ? row.labels.map(l => `<span class="pr-badge pr-badge-tag">${l}</span>`).join(' ')
                            : '';

                        return `
                            <div class="pr-q-title">
                                <button class="pr-action-btn preview flex-shrink-0" type="button" onclick="showQuestionPreview('${id}')" title="معاينة">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <div>
                                    <div class="pr-q-title-text">${row.titlePreview ?? row.title ?? ''}</div>
                                    <div class="d-flex flex-wrap gap-1 mt-1">${type}${labels}</div>
                                </div>
                            </div>`;
                    }
                },
                {
                    data: 'curriculum',
                    render: function (data) {
                        return `<span style="font-size:12px;color:var(--pr-muted);">${data ?? '—'}</span>`;
                    }
                },
                {
                    data: 'section',
                    render: function (data) {
                        return `<span style="font-size:12px;color:var(--pr-muted);">${data ?? '—'}</span>`;
                    }
                },
                {
                    data: 'lesson',
                    render: function (data) {
                        return `<span style="font-size:12px;color:var(--pr-muted);">${data ?? '—'}</span>`;
                    }
                },
                {
                    data: 'isAnswerConfirmed',
                    render: function (data) {
                        return data
                            ? `<span class="pr-badge pr-badge-confirmed"><i class="fas fa-check" style="font-size:9px;"></i> مؤكدة</span>`
                            : `<span class="pr-badge pr-badge-unconfirmed"><i class="fas fa-xmark" style="font-size:9px;"></i> غير مؤكدة</span>`;
                    }
                },
                {
                    data: 'createdAt',
                    render: function (data) {
                        return `<span style="font-size:12px;color:var(--pr-muted);">${data ?? '—'}</span>`;
                    }
                },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function (_, __, row) {
                        const id = rowId(row);
                        return `<button type="button" class="btn-pr-success" onclick="approveSingle('${id}')">
                                    <i class="fas fa-check-circle"></i> اعتماد
                                </button>`;
                    }
                },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function (_, __, row) {
                        const id = rowId(row);
                        return `
                            <div class="pr-action-group">
                                <a href="/Admin/Questions/Edit/${id}" target="_blank" class="pr-action-btn edit" title="تعديل">
                                    <i class="fas fa-pen"></i>
                                </a>
                                <a href="/Admin/Questions/Details/${id}" class="pr-action-btn detail" title="التفاصيل">
                                    <i class="fas fa-info-circle"></i>
                                </a>
                                <button type="button" class="pr-action-btn audit" onclick="openAuditModal('${id}')" title="آخر التعديلات">
                                    <i class="fas fa-history"></i>
                                </button>
                                <button type="button" class="pr-action-btn similar" onclick="checkSimilar('${id}')" title="فحص التشابه">
                                    <i class="fas fa-copy"></i>
                                </button>
                            </div>`;
                    }
                }
            ],
            language: {
                url: "//cdn.datatables.net/plug-ins/1.13.5/i18n/ar.json"
            },
            drawCallback: function () {
                $('#selectAllVisible').prop('checked', false);
            }
        });

        /* ─── Row Checkbox ─── */
        $('#questionsTable').on('change', '.row-select', function () {
            const id = String(this.value);
            if (this.checked) {
                selectedQuestions.add(id);
            } else {
                selectedQuestions.delete(id);
            }
            updateBulkState();
        });

        /* ─── Select All Visible ─── */
        $('#selectAllVisible').on('change', function () {
            const checked = this.checked;
            $('#questionsTable .row-select').each(function () {
                this.checked = checked;
                const id = String(this.value);
                if (checked) {
                    selectedQuestions.add(id);
                } else {
                    selectedQuestions.delete(id);
                }
            });
            updateBulkState();
        });

        /* ─── Bulk Approve ─── */
        $('#bulkApproveBtn').on('click', function () {
            Swal.fire({
                icon: 'question',
                title: 'اعتماد الأسئلة المحددة؟',
                text: `سيتم اعتماد ${selectedQuestions.size} سؤال بعد التحقق من صلاحيتها.`,
                showCancelButton: true,
                confirmButtonText: 'اعتماد',
                cancelButtonText: 'إلغاء'
            }).then(result => {
                if (result.isConfirmed) {
                    document.getElementById('bulkApproveForm').submit();
                }
            });
        });

        /* ─── Approve Filtered ─── */
        $('#approveFilteredBtn').on('click', function () {
            Swal.fire({
                icon: 'warning',
                title: 'اعتماد كل نتائج الفلتر؟',
                text: 'سيتم اعتماد كل الأسئلة الصالحة المطابقة للفلاتر الحالية، وليس الصفحة المعروضة فقط.',
                showCancelButton: true,
                confirmButtonText: 'اعتماد الكل',
                cancelButtonText: 'إلغاء'
            }).then(result => {
                if (result.isConfirmed) {
                    document.getElementById('approveFilteredForm').submit();
                }
            });
        });

        /* ─── Approve Single (Fetch) ─── */
        async function approveSingle(questionId) {
            const result = await Swal.fire({
                icon: 'question',
                title: 'اعتماد هذا السؤال؟',
                showCancelButton: true,
                confirmButtonText: 'اعتماد',
                cancelButtonText: 'إلغاء'
            });

            if (!result.isConfirmed) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            try {
                const response = await fetch('/Admin/Questions/ApproveSingleQuestion', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    body: new URLSearchParams({
                        selectedId: questionId,
                        __RequestVerificationToken: token
                    })
                });

                if (!response.ok) throw new Error('فشل الاتصال بالخادم');

                const data = await response.json();
                if (data.success) {
                    selectedQuestions.delete(String(questionId));
                    updateBulkState();
                    questionsTable.ajax.reload(null, false);
                    Swal.fire('تم الاعتماد', data.message, 'success');
                } else {
                    Swal.fire('تنبيه', data.message, 'warning');
                }
            } catch {
                Swal.fire('خطأ', 'حدث خطأ غير متوقع، يرجى المحاولة مجدداً.', 'error');
            }
        }

        /* ─── Preview Modal ─── */
        function showQuestionPreview(id) {
            const body = document.getElementById('questionPreviewModalBody');
            body.innerHTML = '<div class="pr-empty"><i class="fas fa-spinner fa-spin fa-2x"></i><p class="mt-2">جارٍ التحميل…</p></div>';
            const modal = new bootstrap.Modal(document.getElementById('questionPreviewModal'));
            modal.show();

            fetch(`/Admin/Questions/Preview/${id}`)
                .then(r => r.text())
                .then(html => { body.innerHTML = html; })
                .catch(() => {
                    body.innerHTML = '<div class="pr-empty"><i class="fas fa-exclamation-triangle"></i><p>حدث خطأ أثناء تحميل السؤال.</p></div>';
                });
        }

        /* ─── Audit Modal ─── */
        function openAuditModal(id) {
            const body = document.getElementById('auditModalBody');
            body.innerHTML = '<div class="pr-empty"><i class="fas fa-spinner fa-spin fa-2x"></i><p class="mt-2">جارٍ التحميل…</p></div>';
            new bootstrap.Modal(document.getElementById('auditModal')).show();

            fetch(`/Admin/Questions/Audit/${id}`)
                .then(r => r.text())
                .then(html => { body.innerHTML = html; })
                .catch(() => {
                    body.innerHTML = '<div class="pr-empty"><i class="fas fa-exclamation-triangle"></i><p>حدث خطأ في تحميل السجل.</p></div>';
                });
        }

        /* ─── Similar Check ─── */
        function checkSimilar(questionId) {
            const container = document.getElementById('similarResults');
            container.innerHTML = '<div class="text-center py-4" style="color:var(--pr-muted);"><i class="fas fa-spinner fa-spin fa-2x"></i></div>';
            new bootstrap.Modal(document.getElementById('similarModal')).show();

            fetch(`/Admin/Questions/CheckSimilarQuestions?id=${questionId}`)
                .then(res => res.json())
                .then(data => {
                    container.innerHTML = '';
                    if (data.length === 0) {
                        container.innerHTML = '<div class="text-center py-4" style="color:var(--pr-muted);"><i class="fas fa-check-circle fa-2x mb-2 d-block" style="color:#22c55e;"></i>لا يوجد أسئلة متشابهة بنسبة 80% أو أكثر.</div>';
                    } else {
                        data.forEach(q => {
                            const title = $('<div>').text(q.title || '').html();
                            const meta = [q.referenceNumber, q.lesson, q.matchType].filter(Boolean).map(x => $('<div>').text(x).html()).join(' · ');
                            container.innerHTML += `
                                <a href="/Admin/Questions/Details/${q.id}" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-start gap-2">
                                    <span>
                                        <span class="d-block fw-bold">${title}</span>
                                        <small class="text-muted">${meta}</small>
                                    </span>
                                    <span class="pr-badge pr-badge-quant">${(q.similarity * 100).toFixed(1)}%</span>
                                </a>`;
                        });
                    }
                })
                .catch(() => {
                    container.innerHTML = '<div class="text-center py-4" style="color:#fca5a5;"><i class="fas fa-exclamation-triangle"></i> فشل في تحميل الأسئلة المتشابهة.</div>';
                });
        }
    </script>
}
