@model QdratNew.ViewModels.Question.QuestionIndexViewModel
@using Microsoft.AspNetCore.Authorization
@using QdratNew.Security.AdminPermissions
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "مركز اعتماد الأسئلة";
    var canAssignReviewTask = (await AuthorizationService.AuthorizeAsync(User, AdminPermissionPolicies.QuestionReviewTasks_Create)).Succeeded;
    var canViewReviewTasks = (await AuthorizationService.AuthorizeAsync(User, AdminPermissionPolicies.QuestionReviewTasks_Read)).Succeeded;
    var totalPending = Model.PendingReviewCount;
    var filteredPending = Model.PendingReviewFilteredCount;
    var confirmedPercent = filteredPending == 0 ? 0 : (int)Math.Round((double)Model.PendingReviewConfirmedAnswersCount / filteredPending * 100);
    var unconfirmedPercent = 100 - confirmedPercent;
}
@Html.AntiForgeryToken()

@section Styles {
    <style>
        /* ─── Design Tokens ─── */
        :root {
            --pr-bg: #0f1623;
            --pr-surface: #161e2e;
            --pr-card: #1c2538;
            --pr-border: rgba(255,255,255,.07);
            --pr-accent: #3b82f6;
            --pr-accent-glow: rgba(59,130,246,.25);
            --pr-success: #22c55e;
            --pr-danger: #ef4444;
            --pr-warning: #f59e0b;
            --pr-text: #e2e8f0;
            --pr-muted: #64748b;
            --pr-radius: 12px;
            --pr-radius-sm: 8px;
            --pr-font: 'Cairo', sans-serif;
            --pr-transition: .2s cubic-bezier(.4,0,.2,1);
        }

        /* ─── Page Base ─── */
        body {
            background: var(--pr-bg);
        }

        .pr-page {
            font-family: var(--pr-font);
            color: var(--pr-text);
            min-height: 100vh;
            padding: 28px 0 60px;
            direction: rtl;
        }

        /* ─── Page Header ─── */
        .pr-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 32px;
        }

        .pr-header-title {
            font-size: 22px;
            font-weight: 700;
            letter-spacing: -.3px;
            color: #fff;
            margin: 0;
            line-height: 1.2;
        }

        .pr-header-sub {
            font-size: 13px;
            color: var(--pr-muted);
            margin-top: 4px;
        }

        .pr-header-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        /* ─── Alert Overrides ─── */
        .pr-alert {
            border-radius: var(--pr-radius-sm);
            border: none;
            font-size: 14px;
            margin-bottom: 20px;
            padding: 12px 18px;
        }

        .pr-alert-success {
            background: rgba(34,197,94,.12);
            color: #86efac;
            border-right: 3px solid var(--pr-success);
        }

        .pr-alert-danger {
            background: rgba(239,68,68,.12);
            color: #fca5a5;
            border-right: 3px solid var(--pr-danger);
        }

        /* ─── Hero Stats Banner ─── */
        .pr-hero {
            background: linear-gradient(135deg, #1a2540 0%, #1c3052 60%, #162440 100%);
            border: 1px solid var(--pr-border);
            border-radius: var(--pr-radius);
            padding: 28px 32px;
            margin-bottom: 28px;
            position: relative;
            overflow: hidden;
        }

            .pr-hero::before {
                content: '';
                position: absolute;
                top: -60px;
                left: -60px;
                width: 220px;
                height: 220px;
                background: radial-gradient(circle, rgba(59,130,246,.18) 0%, transparent 70%);
                pointer-events: none;
            }

        .pr-hero-number {
            font-size: 52px;
            font-weight: 800;
            line-height: 1;
            color: #fff;
            letter-spacing: -2px;
        }

        .pr-hero-label {
            font-size: 13px;
            color: var(--pr-muted);
            margin-top: 4px;
        }

        .pr-hero-filtered {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            background: rgba(59,130,246,.12);
            color: #93c5fd;
            border: 1px solid rgba(59,130,246,.25);
            border-radius: 20px;
            padding: 4px 12px;
            margin-top: 10px;
        }

        /* ─── Mini Stat Chips ─── */
        .pr-chips {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
            margin-bottom: 16px;
        }

        @@media (max-width: 768px) {
            .pr-chips

        {
            grid-template-columns: repeat(2, 1fr);
        }

        }

        .pr-chip {
            background: rgba(255,255,255,.05);
            border: 1px solid var(--pr-border);
            border-radius: var(--pr-radius-sm);
            padding: 12px 14px;
            text-align: center;
        }

        .pr-chip-val {
            font-size: 22px;
            font-weight: 700;
            color: #fff;
            line-height: 1;
        }

        .pr-chip-lbl {
            font-size: 11px;
            color: var(--pr-muted);
            margin-top: 3px;
        }

        /* ─── Progress Bar ─── */
        .pr-progress-wrap {
            background: rgba(255,255,255,.08);
            border-radius: 20px;
            height: 7px;
            overflow: hidden;
        }

        .pr-progress-fill {
            height: 100%;
            border-radius: 20px;
            background: linear-gradient(90deg, var(--pr-success), #4ade80);
            transition: width .6s ease;
        }

        .pr-progress-meta {
            display: flex;
            justify-content: space-between;
            font-size: 11px;
            color: var(--pr-muted);
            margin-top: 5px;
        }

        /* ─── Curriculum Cards ─── */
        .pr-cur-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 14px;
            margin-bottom: 28px;
        }

        .pr-cur-card {
            background: var(--pr-card);
            border: 1px solid var(--pr-border);
            border-radius: var(--pr-radius);
            padding: 18px;
            text-decoration: none;
            color: var(--pr-text);
            display: block;
            transition: var(--pr-transition);
            position: relative;
            overflow: hidden;
        }

            .pr-cur-card::after {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(135deg, transparent 60%, rgba(59,130,246,.04));
                pointer-events: none;
            }

            .pr-cur-card:hover {
                border-color: rgba(59,130,246,.4);
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(0,0,0,.3), 0 0 0 1px rgba(59,130,246,.2);
                color: var(--pr-text);
                text-decoration: none;
            }

        .pr-cur-card-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 8px;
            margin-bottom: 12px;
        }

        .pr-cur-card-title {
            font-size: 14px;
            font-weight: 700;
            color: #fff;
            line-height: 1.35;
        }

        .pr-cur-card-sub {
            font-size: 12px;
            color: var(--pr-muted);
            margin-top: 2px;
        }

        .pr-badge-count {
            background: rgba(245,158,11,.15);
            color: #fcd34d;
            border: 1px solid rgba(245,158,11,.3);
            border-radius: 20px;
            padding: 2px 10px;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        .pr-cur-stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
            font-size: 12px;
        }

        .pr-cur-stat-item {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .pr-cur-stat-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .pr-cur-date {
            font-size: 11px;
            color: var(--pr-muted);
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px solid var(--pr-border);
            display: flex;
            align-items: center;
            gap: 5px;
        }

        /* ─── Section Label ─── */
        .pr-section-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: var(--pr-muted);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .pr-section-label::after {
                content: '';
                flex: 1;
                height: 1px;
                background: var(--pr-border);
            }

        /* ─── Filter Panel ─── */
        .pr-filter-panel {
            background: var(--pr-card);
            border: 1px solid var(--pr-border);
            border-radius: var(--pr-radius);
            padding: 20px 24px;
            margin-bottom: 20px;
        }

            .pr-filter-panel .form-label {
                font-size: 12px;
                font-weight: 600;
                color: var(--pr-muted);
                margin-bottom: 6px;
                text-transform: uppercase;
                letter-spacing: .5px;
            }

            .pr-filter-panel .form-select,
            .pr-filter-panel .form-control {
                background: rgba(255,255,255,.04);
                border: 1px solid var(--pr-border);
                color: var(--pr-text);
                border-radius: var(--pr-radius-sm);
                font-size: 13px;
                height: 38px;
                transition: var(--pr-transition);
            }

                .pr-filter-panel .form-select:focus,
                .pr-filter-panel .form-control:focus {
                    background: rgba(255,255,255,.07);
                    border-color: rgba(59,130,246,.5);
                    box-shadow: 0 0 0 3px rgba(59,130,246,.12);
                    color: var(--pr-text);
                }

                .pr-filter-panel .form-select option {
                    background: #1c2538;
                    color: var(--pr-text);
                }

                .pr-filter-panel .form-control::placeholder {
                    color: var(--pr-muted);
                }

        /* ─── Toolbar ─── */
        .pr-toolbar {
            background: var(--pr-card);
            border: 1px solid var(--pr-border);
            border-radius: var(--pr-radius);
            padding: 14px 20px;
            margin-bottom: 16px;
            position: sticky;
            top: 8px;
            z-index: 30;
            backdrop-filter: blur(12px);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
        }

        .pr-selected-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 600;
            color: var(--pr-accent);
            background: var(--pr-accent-glow);
            border: 1px solid rgba(59,130,246,.3);
            border-radius: 20px;
            padding: 4px 14px;
            transition: var(--pr-transition);
        }

            .pr-selected-badge.empty {
                color: var(--pr-muted);
                background: rgba(255,255,255,.04);
                border-color: var(--pr-border);
            }

        /* ─── Buttons ─── */
        .btn-pr-primary {
            background: var(--pr-accent);
            border: none;
            color: #fff;
            font-size: 13px;
            font-weight: 600;
            border-radius: var(--pr-radius-sm);
            padding: 8px 18px;
            transition: var(--pr-transition);
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .btn-pr-primary:hover:not(:disabled) {
                background: #2563eb;
                transform: translateY(-1px);
                box-shadow: 0 4px 16px rgba(59,130,246,.4);
                color: #fff;
            }

            .btn-pr-primary:disabled {
                opacity: .35;
                cursor: not-allowed;
            }

        .btn-pr-outline {
            background: transparent;
            border: 1px solid var(--pr-border);
            color: var(--pr-text);
            font-size: 13px;
            font-weight: 600;
            border-radius: var(--pr-radius-sm);
            padding: 8px 18px;
            transition: var(--pr-transition);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
        }

            .btn-pr-outline:hover:not(:disabled) {
                border-color: rgba(255,255,255,.2);
                background: rgba(255,255,255,.06);
                color: #fff;
            }

            .btn-pr-outline:disabled {
                opacity: .35;
                cursor: not-allowed;
            }

        .btn-pr-ghost {
            background: transparent;
            border: none;
            color: var(--pr-muted);
            font-size: 13px;
            font-weight: 500;
            border-radius: var(--pr-radius-sm);
            padding: 8px 14px;
            transition: var(--pr-transition);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .btn-pr-ghost:hover {
                color: var(--pr-text);
                background: rgba(255,255,255,.05);
            }

        .btn-pr-success {
            background: rgba(34,197,94,.15);
            border: 1px solid rgba(34,197,94,.3);
            color: #86efac;
            font-size: 12px;
            font-weight: 600;
            border-radius: 6px;
            padding: 5px 12px;
            transition: var(--pr-transition);
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

            .btn-pr-success:hover {
                background: rgba(34,197,94,.25);
                border-color: rgba(34,197,94,.5);
                color: #bbf7d0;
            }

        .btn-pr-nav {
            background: transparent;
            border: 1px solid var(--pr-border);
            color: var(--pr-muted);
            font-size: 11px;
            border-radius: 6px;
            padding: 4px 8px;
            transition: var(--pr-transition);
            display: inline-flex;
            align-items: center;
            gap: 4px;
            text-decoration: none;
        }

            .btn-pr-nav:hover {
                border-color: rgba(255,255,255,.15);
                color: var(--pr-text);
                text-decoration: none;
            }

        /* ─── Table Panel ─── */
        .pr-table-panel {
            background: var(--pr-card);
            border: 1px solid var(--pr-border);
            border-radius: var(--pr-radius);
            overflow: hidden;
        }

            .pr-table-panel .table {
                margin: 0;
                color: var(--pr-text);
                font-size: 13px;
            }

                .pr-table-panel .table thead th {
                    background: rgba(255,255,255,.04);
                    border-color: var(--pr-border);
                    color: var(--pr-muted);
                    font-size: 11px;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: .7px;
                    padding: 12px 14px;
                    white-space: nowrap;
                    vertical-align: middle;
                }

                .pr-table-panel .table tbody td {
                    border-color: var(--pr-border);
                    padding: 12px 14px;
                    vertical-align: middle;
                    background: transparent;
                    transition: background var(--pr-transition);
                }

                .pr-table-panel .table tbody tr:hover td {
                    background: rgba(255,255,255,.025);
                }

                .pr-table-panel .table tbody tr:last-child td {
                    border-bottom: none;
                }

        /* ─── Question Title Cell ─── */
        .pr-q-title {
            display: flex;
            align-items: flex-start;
            gap: 8px;
        }

        .pr-q-title-text {
            font-size: 13px;
            color: var(--pr-text);
            line-height: 1.5;
            max-width: 360px;
            white-space: normal;
        }

        .pr-q-ref {
            font-size: 11px;
            color: var(--pr-muted);
            background: rgba(255,255,255,.05);
            border-radius: 4px;
            padding: 1px 6px;
            white-space: nowrap;
            font-family: monospace;
            letter-spacing: .3px;
        }

        /* ─── Badges ─── */
        .pr-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 11px;
            font-weight: 600;
            border-radius: 20px;
            padding: 3px 10px;
            border: 1px solid transparent;
        }

        .pr-badge-confirmed {
            background: rgba(34,197,94,.1);
            color: #86efac;
            border-color: rgba(34,197,94,.25);
        }

        .pr-badge-unconfirmed {
            background: rgba(239,68,68,.1);
            color: #fca5a5;
            border-color: rgba(239,68,68,.25);
        }

        .pr-badge-quant {
            background: rgba(59,130,246,.1);
            color: #93c5fd;
            border-color: rgba(59,130,246,.25);
        }

        .pr-badge-verbal {
            background: rgba(168,85,247,.1);
            color: #d8b4fe;
            border-color: rgba(168,85,247,.25);
        }

        .pr-badge-tag {
            background: rgba(255,255,255,.06);
            color: var(--pr-muted);
            border-color: var(--pr-border);
            font-size: 10px;
            padding: 2px 7px;
        }

        /* ─── Action Buttons in Table ─── */
        .pr-action-group {
            display: flex;
            gap: 5px;
            align-items: center;
            flex-wrap: nowrap;
        }

        .pr-action-btn {
            background: rgba(255,255,255,.04);
            border: 1px solid var(--pr-border);
            color: var(--pr-muted);
            border-radius: 6px;
            width: 30px;
            height: 30px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            transition: var(--pr-transition);
            text-decoration: none;
            cursor: pointer;
        }

            .pr-action-btn:hover {
                background: rgba(255,255,255,.1);
                border-color: rgba(255,255,255,.15);
                color: var(--pr-text);
                text-decoration: none;
            }

            .pr-action-btn.edit:hover {
                border-color: rgba(245,158,11,.4);
                color: #fcd34d;
                background: rgba(245,158,11,.08);
            }

            .pr-action-btn.detail:hover {
                border-color: rgba(59,130,246,.4);
                color: #93c5fd;
                background: rgba(59,130,246,.08);
            }

            .pr-action-btn.audit:hover {
                border-color: rgba(168,85,247,.4);
                color: #d8b4fe;
                background: rgba(168,85,247,.08);
            }

            .pr-action-btn.similar:hover {
                border-color: rgba(239,68,68,.4);
                color: #fca5a5;
                background: rgba(239,68,68,.08);
            }

            .pr-action-btn.preview:hover {
                border-color: rgba(34,197,94,.4);
                color: #86efac;
                background: rgba(34,197,94,.08);
            }

        /* ─── Checkbox ─── */
        .form-check-input.pr-check {
            width: 16px;
            height: 16px;
            background-color: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.2);
            border-radius: 4px;
            cursor: pointer;
            margin: 0;
            flex-shrink: 0;
        }

            .form-check-input.pr-check:checked {
                background-color: var(--pr-accent);
                border-color: var(--pr-accent);
            }

        /* ─── DataTable Overrides ─── */
        .dataTables_wrapper .dataTables_length select,
        .dataTables_wrapper .dataTables_filter input {
            background: rgba(255,255,255,.05);
            border: 1px solid var(--pr-border);
            color: var(--pr-text);
            border-radius: 6px;
            padding: 5px 10px;
            font-size: 13px;
        }

            .dataTables_wrapper .dataTables_filter input:focus {
                outline: none;
                border-color: rgba(59,130,246,.5);
                box-shadow: 0 0 0 3px rgba(59,130,246,.1);
            }

        .dataTables_wrapper .dataTables_length label,
        .dataTables_wrapper .dataTables_filter label,
        .dataTables_wrapper .dataTables_info {
            color: var(--pr-muted);
            font-size: 12px;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button {
            background: rgba(255,255,255,.04) !important;
            border: 1px solid var(--pr-border) !important;
            border-radius: 6px !important;
            color: var(--pr-muted) !important;
            margin: 0 2px;
            font-size: 12px;
            padding: 4px 10px !important;
            min-width: 34px;
            text-align: center;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button.current,
            .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
                background: var(--pr-accent) !important;
                border-color: var(--pr-accent) !important;
                color: #fff !important;
            }

        .dataTables_wrapper .dataTables_processing {
            background: var(--pr-card);
            color: var(--pr-text);
            border: 1px solid var(--pr-border);
            border-radius: var(--pr-radius-sm);
        }

        /* ─── Modals ─── */
        .pr-modal .modal-content {
            background: var(--pr-surface);
            border: 1px solid var(--pr-border);
            border-radius: var(--pr-radius);
            color: var(--pr-text);
        }

        .pr-modal .modal-header {
            background: rgba(255,255,255,.03);
            border-bottom: 1px solid var(--pr-border);
            padding: 16px 22px;
        }

        .pr-modal .modal-title {
            font-size: 15px;
            font-weight: 700;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .pr-modal .modal-body {
            padding: 24px 22px;
        }

        .pr-modal .btn-close {
            filter: invert(1) brightness(.6);
        }

        .pr-modal .list-group-item {
            background: rgba(255,255,255,.04);
            border-color: var(--pr-border);
            color: var(--pr-text);
            font-size: 13px;
            transition: var(--pr-transition);
        }

            .pr-modal .list-group-item:hover {
                background: rgba(255,255,255,.08);
                color: #fff;
            }

        /* ─── Empty State ─── */
        .pr-empty {
            text-align: center;
            padding: 60px 20px;
            color: var(--pr-muted);
        }

            .pr-empty i {
                font-size: 40px;
                margin-bottom: 14px;
                opacity: .4;
            }

            .pr-empty p {
                font-size: 14px;
                margin: 0;
            }

        /* ─── Responsive ─── */
        @@media (max-width: 768px) {
            .pr-hero

        {
            padding: 20px;
        }

        .pr-hero-number {
            font-size: 36px;
        }

        .pr-toolbar {
            top: 0;
            border-radius: 0;
        }

        }

        /* ─── Swal Dark Theme Override ─── */
        .swal2-popup {
            background: var(--pr-surface) !important;
            border: 1px solid var(--pr-border) !important;
            color: var(--pr-text) !important;
            font-family: var(--pr-font) !important;
            border-radius: var(--pr-radius) !important;
        }

        .swal2-title, .swal2-html-container {
            color: var(--pr-text) !important;
        }

        .swal2-confirm {
            background: var(--pr-accent) !important;
            border-radius: 8px !important;
            font-family: var(--pr-font) !important;
        }

        .swal2-cancel {
            background: rgba(255,255,255,.08) !important;
            color: var(--pr-text) !important;
            border-radius: 8px !important;
            font-family: var(--pr-font) !important;
        }




.pr-table-panel {
