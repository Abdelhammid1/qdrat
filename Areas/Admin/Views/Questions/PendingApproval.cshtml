@model QdratNew.ViewModels.Question.QuestionIndexViewModel
@{
    ViewData["Title"] = "الأسئلة الغير مكتملة أو المرفوضة";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.5/css/jquery.dataTables.min.css" />
    <style>
        #pendingQuestionsTable {
            width: 100% !important;
        }

        table.dataTable td {
            white-space: nowrap;
            font-size: 14px !important;
            vertical-align: middle;
        }

        table.dataTable th {
            white-space: nowrap;
            font-size: 14px !important;
        }
    </style>
}

<h2 class="mb-4"><i class="fas fa-tools"></i> قائمة الأسئلة الغير مكتملة أو المرفوضة</h2>
<a asp-action="Dashboard" class="btn btn-outline-primary" style="float:left;">
    <i class="fas fa-eye"></i> لوحة تحكم بنك الاسئلة
</a>
<a asp-action="Index" class="btn btn-outline-primary" style="float:left;">
    <i class="fas fa-eye"></i>  بنك الاسئلة
</a>
<div class="alert alert-warning">
    هذه القائمة تعرض جميع الأسئلة التي لم تكتمل بياناتها أو تم رفضها. يمكنك تعديلها أو حذفها أو إكمالها لاحقًا.
</div>

<table id="pendingQuestionsTable" class="table table-bordered text-center table-sm">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>السؤال</th>
            <th>القسم</th>
            <th>المحور</th>
            <th>المؤشر</th>
            <th>تاريخ الإنشاء</th>
            <th>إجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Questions)
        {
            <tr>
                <td>@item.ReferenceNumber</td>
                <td>@(item.Title.Length > 25 ? item.Title.Substring(0, 25) + "..." : item.Title)</td>
                <td>@item.CurriculumTitle</td>
                <td>@item.SectionTitle</td>
                <td>@item.LessonTitle</td>
                <td>@item.CreatedAt.ToString("yyyy/MM/dd")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                        <i class="fas fa-edit"></i> تعديل
                    </a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                        <i class="fas fa-info-circle"></i> تفاصيل
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                        <i class="fas fa-trash-alt"></i> حذف
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.5/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#pendingQuestionsTable').DataTable({
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.5/i18n/ar.json"
                },
                pageLength: 20,
                order: [[5, 'desc']]
            });
        });
    </script>
}
