@model QdratNew.ViewModels.Question.SimilarQuestionGroupsViewModel
@using System.Globalization

@{
    ViewData["Title"] = "مجموعات الأسئلة المتشابهة";
}

@section Styles {
    <style>
        .similar-page {
            background: #f5f7fb;
            min-height: calc(100vh - 120px);
            font-family: 'Cairo', sans-serif;
        }

        .similar-header,
        .similar-card,
        .similar-filter {
            background: #fff;
            border: 1px solid #e4e9f2;
            border-radius: 8px;
            box-shadow: 0 8px 20px rgba(15, 23, 42, .05);
        }

        .similar-stat {
            border: 1px solid #e8edf5;
            border-radius: 8px;
            padding: 12px;
            background: #f8fafc;
        }

        .similar-stat .value {
            font-size: 24px;
            font-weight: 900;
            color: #172033;
            line-height: 1;
        }

        .similar-stat .label {
            color: #64748b;
            font-size: 12px;
            margin-top: 5px;
            font-weight: 700;
        }

        .similar-group-head {
            border-bottom: 1px solid #edf1f7;
            padding: 16px;
        }

        .similar-question {
            padding: 14px 16px;
            border-bottom: 1px solid #edf1f7;
        }

        .similar-question:last-child {
            border-bottom: 0;
        }

        .similar-title {
            color: #0f172a;
            font-weight: 800;
            line-height: 1.8;
        }

        .similar-meta {
            color: #64748b;
            font-size: 12px;
        }

        .similar-badge {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 5px 10px;
            font-size: 12px;
            font-weight: 900;
            background: #eef2ff;
            color: #4338ca;
            border: 1px solid #c7d2fe;
            white-space: nowrap;
        }

        .similar-reference {
            background: #ecfdf5;
            color: #166534;
            border-color: #bbf7d0;
        }

        .similar-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 10px;
        }

        .similar-action {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            border: 1px solid #dbe4ef;
            background: #fff;
            color: #334155;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: background .15s ease, color .15s ease, border-color .15s ease;
        }

        .similar-action:hover {
            background: #f1f5f9;
            color: #0f172a;
            border-color: #cbd5e1;
        }

        .similar-action.edit {
            color: #2563eb;
        }

        .similar-action.audit {
            color: #7c3aed;
        }

        .similar-action.delete {
            color: #dc2626;
        }

        .similar-empty {
            padding: 46px 20px;
            text-align: center;
            color: #64748b;
        }

        .similar-empty i {
            color: #16a34a;
            font-size: 34px;
            margin-bottom: 12px;
        }
    </style>
}

<div class="similar-page container-fluid py-4" dir="rtl">
    <div class="similar-header p-3 mb-3">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <h1 class="h4 fw-bold mb-1">
                    <i class="fas fa-code-compare text-primary me-1"></i>
                    مجموعات الأسئلة المتشابهة
                </h1>
                <div class="text-muted small">
                    @Model.ScopeDescription
                    @if (Model.IsLimitedBySample)
                    {
                        <span class="text-warning fw-bold"> · الفحص محدود بعينة. اختر محورًا أو مؤشرًا لفحص النطاق كاملًا.</span>
                    }
                </div>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Dashboard" class="btn btn-outline-secondary">
                    <i class="fas fa-chart-line me-1"></i>
                    لوحة البنك
                </a>
                <a asp-action="Index" class="btn btn-primary">
                    <i class="fas fa-database me-1"></i>
                    بنك الأسئلة
                </a>
            </div>
        </div>
    </div>

    <form asp-action="SimilarGroups" method="get" class="similar-filter p-3 mb-3" id="similarFilterForm">
        <input type="hidden" name="run" value="true" />
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold">المنهج</label>
                <select name="curriculumId" class="form-select" id="similarCurriculumId">
                    <option value="">كل المناهج</option>
                    @foreach (var item in Model.Curriculums)
                    {
                        if (item.Selected)
                        {
                            <option value="@item.Value" selected>@item.Text</option>
                        }
                        else
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">المحور</label>
                <select name="sectionId" class="form-select" id="similarSectionId">
                    <option value="">كل المحاور</option>
                    @foreach (var item in Model.Sections)
                    {
                        if (item.Selected)
                        {
                            <option value="@item.Value" selected>@item.Text</option>
                        }
                        else
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">المؤشر</label>
                <select name="lessonId" class="form-select" id="similarLessonId">
                    <option value="">كل المؤشرات</option>
                    @foreach (var item in Model.Lessons)
                    {
                        if (item.Selected)
                        {
                            <option value="@item.Value" selected>@item.Text</option>
                        }
                        else
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">بحث داخل السؤال</label>
                <input type="text" name="searchTitle" class="form-control" value="@Model.SearchTitle" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">نسبة التشابه الدنيا</label>
                <input type="number" name="threshold" class="form-control" min="0.60" max="0.98" step="0.01" value="@Model.Threshold.ToString("0.00", CultureInfo.InvariantCulture)" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">حد العينة عند عدم اختيار محور</label>
                <input type="number" name="scanLimit" class="form-control" min="200" max="5000" step="100" value="@(Model.ScanLimit ?? 1200)" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-dark w-100">
                    <i class="fas fa-magnifying-glass me-1"></i>
                    إعادة الفحص
                </button>
            </div>
            <div class="col-md-3 text-md-end text-muted small">
                آخر تحديث: @Model.GeneratedAt.ToString("yyyy/MM/dd HH:mm")
            </div>
        </div>
    </form>

    <div class="row g-3 mb-3">
        <div class="col-6 col-xl-3">
            <div class="similar-stat">
                <div class="value">@Model.ScannedQuestionsCount</div>
                <div class="label">سؤال تم فحصه</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="similar-stat">
                <div class="value">@Model.GroupsCount</div>
                <div class="label">مجموعة متشابهة</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="similar-stat">
                <div class="value">@Model.SimilarPairsCount</div>
                <div class="label">زوج سؤال متشابه</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="similar-stat">
                <div class="value">@((Model.Threshold * 100).ToString("0"))%</div>
                <div class="label">حد التشابه المستخدم</div>
            </div>
        </div>
    </div>

    @if (!Model.HasRun)
    {
        <div class="similar-card similar-empty">
            <i class="fas fa-filter d-block"></i>
            اختر نطاق الفحص من الفلاتر ثم اضغط إعادة الفحص.
        </div>
    }
    else if (!Model.Groups.Any())
    {
        <div class="similar-card similar-empty">
            <i class="fas fa-circle-check d-block"></i>
            لا توجد مجموعات متشابهة ضمن نطاق الفحص الحالي.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var group in Model.Groups)
            {
                <div class="col-12 col-xl-6">
                    <div class="similar-card h-100">
                        <div class="similar-group-head">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                                <div>
                                    <div class="fw-bold text-dark">
                                        <i class="fas fa-layer-group text-primary me-1"></i>
                                        مجموعة #@group.GroupNumber
                                    </div>
                                    <div class="similar-meta">
                                        @group.CurriculumTitle · @group.SectionTitle · @group.LessonTitle
                                    </div>
                                </div>
                                <span class="similar-badge">أعلى تشابه @group.MaxSimilarity.ToString("0.0")%</span>
                            </div>

                            <div class="row g-2">
                                <div class="col-4">
                                    <div class="similar-stat py-2">
                                        <div class="value h5 mb-0">@group.QuestionsCount</div>
                                        <div class="label">أسئلة</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="similar-stat py-2">
                                        <div class="value h5 mb-0">@group.PairsCount</div>
                                        <div class="label">أزواج</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="similar-stat py-2">
                                        <div class="value h5 mb-0">@group.AverageSimilarity.ToString("0.0")%</div>
                                        <div class="label">متوسط</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @foreach (var question in group.Questions)
                        {
                            <div class="similar-question">
                                <div class="d-flex justify-content-between align-items-start gap-3">
                                    <div>
                                        <a asp-action="Details" asp-route-id="@question.Id" target="_blank" class="similar-title text-decoration-none">
                                            @Html.Raw(question.Title)
                                        </a>
                                        <div class="similar-meta mt-1">
                                            @question.ReferenceNumber · @question.LessonTitle · @question.CreatedAt.ToString("yyyy/MM/dd")
                                        </div>
                                        <div class="similar-actions">
                                            <a asp-action="Details" asp-route-id="@question.Id" target="_blank" class="similar-action" title="التفاصيل">
                                                <i class="fas fa-info-circle"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@question.Id" target="_blank" class="similar-action edit" title="تعديل">
                                                <i class="fas fa-pen"></i>
                                            </a>
                                            <a asp-action="Display" asp-route-id="@question.Id" target="_blank" class="similar-action" title="كارت السؤال">
                                                <i class="fas fa-id-card"></i>
                                            </a>
                                            <button type="button" class="similar-action audit" onclick="openAuditModal('@question.Id')" title="آخر التعديلات">
                                                <i class="fas fa-history"></i>
                                            </button>
                                            <a asp-action="Delete" asp-route-id="@question.Id" target="_blank" class="similar-action delete" title="حذف">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </div>
                                    <div class="text-nowrap">
                                        @if (question.IsRepresentative)
                                        {
                                            <span class="similar-badge similar-reference">@question.MatchType</span>
                                        }
                                        else
                                        {
                                            <span class="similar-badge">@question.SimilarityToRepresentative.ToString("0.0")%</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="modal fade" id="auditModal" tabindex="-1" aria-hidden="true" dir="rtl">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">
                    <i class="fas fa-history me-1"></i>
                    آخر التعديلات
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="auditModalBody">
                <div class="text-center text-muted py-4">
                    <i class="fas fa-spinner fa-spin"></i>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const selectedSectionId = '@Model.SectionId';
        const selectedLessonId = '@Model.LessonId';

        function setOptions(select, items, placeholder) {
            select.innerHTML = `<option value="">${placeholder}</option>`;
            items.forEach(item => {
                const option = document.createElement('option');
                option.value = item.id;
                option.textContent = item.title;
                select.appendChild(option);
            });
        }

        async function loadSimilaritySections(curriculumId, selectedValue = '') {
            const sectionSelect = document.getElementById('similarSectionId');
            const lessonSelect = document.getElementById('similarLessonId');
            setOptions(sectionSelect, [], 'كل المحاور');
            setOptions(lessonSelect, [], 'كل المؤشرات');

            if (!curriculumId) {
                return;
            }

            const response = await fetch(`/Admin/Questions/GetSectionsByCurriculum?curriculumId=${curriculumId}`);
            const sections = response.ok ? await response.json() : [];
            setOptions(sectionSelect, sections, 'كل المحاور');

            if (selectedValue) {
                sectionSelect.value = selectedValue;
            }
        }

        async function loadSimilarityLessons(curriculumId, sectionId, selectedValue = '') {
            const lessonSelect = document.getElementById('similarLessonId');
            setOptions(lessonSelect, [], 'كل المؤشرات');

            if (!curriculumId && !sectionId) {
                return;
            }

            const params = new URLSearchParams();
            if (curriculumId) params.append('curriculumId', curriculumId);
            if (sectionId) params.append('sectionId', sectionId);

            const response = await fetch(`/Admin/Questions/GetActiveLessonsForSimilarity?${params.toString()}`);
            const lessons = response.ok ? await response.json() : [];
            setOptions(lessonSelect, lessons, 'كل المؤشرات');

            if (selectedValue) {
                lessonSelect.value = selectedValue;
            }
        }

        document.getElementById('similarCurriculumId')?.addEventListener('change', async function () {
            await loadSimilaritySections(this.value);
            await loadSimilarityLessons(this.value, '');
        });

        document.getElementById('similarSectionId')?.addEventListener('change', async function () {
            const curriculumId = document.getElementById('similarCurriculumId')?.value || '';
            await loadSimilarityLessons(curriculumId, this.value);
        });

        document.addEventListener('DOMContentLoaded', async function () {
            const curriculumId = document.getElementById('similarCurriculumId')?.value || '';
            if (curriculumId && document.getElementById('similarSectionId')?.options.length <= 1) {
                await loadSimilaritySections(curriculumId, selectedSectionId);
            }

            const sectionId = document.getElementById('similarSectionId')?.value || selectedSectionId;
            if ((curriculumId || sectionId) && document.getElementById('similarLessonId')?.options.length <= 1) {
                await loadSimilarityLessons(curriculumId, sectionId, selectedLessonId);
            }
        });

        function openAuditModal(id) {
            const body = document.getElementById('auditModalBody');
            body.innerHTML = '<div class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin"></i></div>';

            new bootstrap.Modal(document.getElementById('auditModal')).show();

            fetch(`/Admin/Questions/Audit/${id}`)
                .then(response => response.text())
                .then(html => {
                    body.innerHTML = html;
                })
                .catch(() => {
                    body.innerHTML = '<div class="alert alert-danger text-center fw-bold">فشل تحميل سجل التعديلات.</div>';
                });
        }
    </script>
}
