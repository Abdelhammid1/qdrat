@model List<QdratNew.Entities.QuestionAuditLog>
@{
    ViewData["Title"] = "سجل التعديلات";
}

<div class="container mt-4" dir="rtl">

    <!-- العنوان -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="text-primary mb-0">
            🕓 سجل التعديلات للسؤال
        </h3>
        <a asp-action="Details" asp-route-id="@ViewBag.QuestionId" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> رجوع لتفاصيل السؤال
        </a>
    </div>

    <!-- جدول السجل -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-bordered table-hover text-center align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 10%">العملية</th>
                        <th style="width: 20%">منفذ العملية</th>
                        <th style="width: 15%">الدور</th>
                        <th style="width: 20%">وقت التنفيذ</th>
                        <th>التعديلات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-danger fw-bold py-3">
                                <i class="fas fa-info-circle me-2"></i>
                                لا يوجد سجل تعديلات لهذا السؤال.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var log in Model)
                        {
                            <tr>
                                <td class="fw-bold">@log.Action</td>
                                <td>@log.PerformedByName</td>
                                <td>@log.PerformedByRole</td>
                                <td>@log.PerformedAt.ToString("yyyy/MM/dd - hh:mm tt")</td>
                                <td class="text-start">@log.ChangedFieldsSummary</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
