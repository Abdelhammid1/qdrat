                case 'arc':
                    html = `<span style="border-top: 2px solid; padding-top: 2px;">أ ب</span>`;
                    break;
                case 'angle':
                    html = `<span style="font-family:'Arial'; font-weight:bold; font-size:16px; position:relative;">
