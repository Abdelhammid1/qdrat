        function setupSearchableVerbalPassageSelect() {
            document.querySelectorAll(".verbal-passage-search").forEach(searchInput => {
                const selectId = searchInput.dataset.targetSelect;
                const select = document.getElementById(selectId);
                const countLabel = document.querySelector(`[data-count-for="${selectId}"]`);

                if (!select) return;

                const allOptions = Array.from(select.options).map(option => ({
                    value: option.value,
                    text: option.text,
                    selected: option.selected
                }));

                const normalize = value => (value || "")
                    .toString()
                    .trim()
                    .toLowerCase()
                    .replace(/[أإآ]/g, "ا")
                    .replace(/ة/g, "ه")
                    .replace(/ى/g, "ي");

                const updateCount = visibleCount => {
                    if (!countLabel) return;
                    const totalCount = allOptions.filter(option => option.value).length;
                    countLabel.textContent = searchInput.value.trim()
                        ? `تم العثور على ${visibleCount} من ${totalCount} قطعة`
                        : `إجمالي القطع المتاحة: ${totalCount}`;
                };

                const renderOptions = () => {
                    const selectedValue = select.value;
                    const query = normalize(searchInput.value);
                    const fragment = document.createDocumentFragment();
                    let visibleCount = 0;

                    allOptions.forEach(optionData => {
                        const isEmptyOption = optionData.value === "";
                        const isMatch = !query || normalize(optionData.text).includes(query);
                        const isSelected = optionData.value === selectedValue;

                        if (isEmptyOption || isMatch || isSelected) {
                            const option = new Option(optionData.text, optionData.value);
                            option.selected = isSelected;
                            fragment.appendChild(option);
                            if (!isEmptyOption && (isMatch || isSelected)) visibleCount++;
                        }
                    });

                    select.innerHTML = "";
                    select.appendChild(fragment);
                    select.value = selectedValue;
                    updateCount(visibleCount);
                };

                searchInput.addEventListener("input", renderOptions);
                renderOptions();
            });
        }

        document.addEventListener("DOMContentLoaded", setupSearchableVerbalPassageSelect);



        document.getElementById("curriculumSelect")?.addEventListener("change", async function () {
            const curriculumId = this.value;
            if (!curriculumId) return;

            const response = await fetch(`/Admin/Curriculums/GetCurriculumType?curriculumId=${curriculumId}`);
            const data = await response.json();

            isRTL = data.isRTL === true;

            const textarea = document.getElementById("questionText");

            if (isRTL) {
                textarea.style.direction = "rtl";
            } else {
                textarea.style.direction = "ltr";
            }
        });

    </script>


