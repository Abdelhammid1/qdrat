                            </span>`;
                    break;
            }

            const start = input.selectionStart;
            const end = input.selectionEnd;
            input.value = input.value.substring(0, start) + html + input.value.substring(end);
            input.dispatchEvent(new Event('input'));

            bootstrap.Modal.getInstance(document.getElementById('mathSymbolModal')).hide();
        }



