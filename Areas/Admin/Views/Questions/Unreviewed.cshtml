@model List<QdratNew.ViewModels.Question.QuestionViewModel>
@using QdratNew.Helpers

@{
    ViewData["Title"] = "الأسئلة غير المراجعة";
}

<div class="container mt-4" dir="rtl">
    <h2 class="text-center mb-4 text-danger">
        <i class="fas fa-exclamation-circle"></i> قائمة الأسئلة غير المُراجعة
    </h2>

    <div class="alert alert-warning text-center">
        هذه الأسئلة لا تحتوي على إجابة صحيحة ولن تظهر في أي اختبار. يُرجى مراجعتها وتعديلها.
    </div>

    <table class="table table-bordered table-striped text-center" style="font-size: 0.9rem;">
        <thead class="table-dark">
            <tr>
                <th>السؤال</th>
                <th>المنهج</th>
@*                 <th>المحور</th>
 *@                <th>الدرس</th>
                <th>التاريخ</th>
                <th>الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var q in Model)
            {
                <tr>
                    <td>@Html.Raw(q.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(q.TitlePreview) : q.TitlePreview)</td>
                    <td>@q.CurriculumTitle</td>
                    // <td>@q.SectionTitle</td>
                    <td>@q.LessonTitle</td>
                    <td>@q.CreatedAt.ToString("yyyy/MM/dd")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@q.Id" class="btn btn-sm btn-primary">
                            <i class="fas fa-edit"></i> مراجعة
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
