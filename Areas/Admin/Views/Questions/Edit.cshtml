@* مودالات الكسر والجذر المشتركة *@
<partial name="_QuestionFractionAndRootModals" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://unpkg.com/mathlive/dist/mathlive.min.js"></script>

    <script>
        // ══════════════════════════════════════════════════
        // QdratCore — Question Edit Page Scripts v2.0
        // ══════════════════════════════════════════════════
        let isRTL = true;
        let isQuantitative = false;

        document.addEventListener("DOMContentLoaded", function () {

            // ── ١. Cascade: القسم → المحور → المؤشر ──────────
            const curriculumSelect = document.getElementById("curriculumSelect");
            const sectionSelect    = document.getElementById("sectionSelect");
            const lessonSelect     = document.getElementById("lessonSelect");
            const initialSectionId = "@Model.SectionId";
            const initialLessonId  = "@Model.LessonId";

            curriculumSelect?.addEventListener("change", async function () {
                const curriculumId = this.value;
                sectionSelect.innerHTML = '<option value="">جاري التحميل...</option>';
                lessonSelect.innerHTML  = '<option value="">اختر المؤشر</option>';

                if (!curriculumId) return;

                // تحديث اتجاه النص ونوع الأرقام حسب المنهج
                const typeRes = await fetch(`/Admin/Questions/GetCurriculumType?curriculumId=${curriculumId}`);
                const typeData = await typeRes.json();
                applyCurriculumPresentation(typeData);

                const res  = await fetch(`/Admin/Questions/GetSectionsByCurriculum?curriculumId=${curriculumId}`);
                const data = await res.json();
                sectionSelect.innerHTML = '<option value="">— اختر المحور —</option>';
                data.forEach(s => {
                    const o = document.createElement('option');
                    o.value = s.id; o.textContent = s.title;
                    sectionSelect.appendChild(o);
                });
            });

            async function loadLessonsBySection(sectionId, selectedLessonId) {
                lessonSelect.innerHTML = '<option value="">جاري التحميل...</option>';
                if (!sectionId) {
                    lessonSelect.innerHTML = '<option value="">— اختر المؤشر —</option>';
                    return;
                }

                const res  = await fetch(`/Admin/Questions/GetLessonsBySection?sectionId=${sectionId}`);
                const data = await res.json();
                lessonSelect.innerHTML = '<option value="">— اختر المؤشر —</option>';
                data.forEach(item => {
                    const o = document.createElement('option');
                    o.value = item.id;
                    o.textContent = item.title;
                    if (selectedLessonId && item.id.toString() === selectedLessonId.toString()) {
                        o.selected = true;
                    }
                    lessonSelect.appendChild(o);
                });
            }

            sectionSelect?.addEventListener("change", async function () {
                await loadLessonsBySection(this.value, null);
            });

            if (initialSectionId && initialLessonId && lessonSelect && lessonSelect.options.length <= 1) {
                loadLessonsBySection(initialSectionId, initialLessonId);
            }

            // ── ٢. نوع القالب → إظهار/إخفاء حقول ─────────────
            document.querySelectorAll('.template-selector').forEach(radio => {
                radio.addEventListener('change', handleTemplateChange);
            });
            handleTemplateChange(); // تطبيق الحالة الأولى

            // ── ٣. معاينة نص السؤال ────────────────────────────
            const questionText = document.getElementById("questionText");
            const questionPreview = document.getElementById("questionPreview");
            if (questionText) {
                questionText.addEventListener("input", function () {
                    normalizeIndicInput(this);
                    updateQuestionLivePreview();
                });
                updateQuestionLivePreview();
            }

            document.querySelectorAll(".option-text-input").forEach(input => {
                input.addEventListener("input", function () {
                    normalizeIndicInput(this);
                    updateOptionPreview(this);
                });
                updateOptionPreview(input);
            });

            updateAllTextDirections();

            async function loadInitialCurriculumPresentation() {
                const curriculumId = curriculumSelect?.value;
                if (!curriculumId) return;
                try {
                    const typeRes = await fetch(`/Admin/Questions/GetCurriculumType?curriculumId=${curriculumId}`);
                    const typeData = await typeRes.json();
                    applyCurriculumPresentation(typeData);
                } catch (error) {
                    console.error("فشل في تحميل خصائص المنهج:", error);
                }
            }
            loadInitialCurriculumPresentation();

            function updateQuestionLivePreview() {
                const val = questionText.value.trim();
                if (questionPreview) {
                    questionPreview.innerHTML = val
                        ? '<span class="preview-label">معاينة فورية</span>' + getDisplayValue(val)
                        : '<span class="preview-label">معاينة فورية</span><span style="color:var(--q-text-light);font-size:15px;font-weight:400;">سيظهر نص السؤال هنا بعد الكتابة...</span>';
                    questionPreview.style.direction = isRTL ? "rtl" : "ltr";
                    questionPreview.style.textAlign = isRTL ? "right" : "left";
                }
            }

            // ── ٤. Dropzone صورة السؤال ───────────────────────
            const dropzone  = document.getElementById("question-dropzone");
            const fileInput = document.getElementById("question-image-input");
            const imgPrev   = document.getElementById("question-image-preview");
            const noPreview = document.getElementById("no-preview-placeholder");
            const existingImageInput = document.getElementById("question-existing-image-url");
            const removeImageInput = document.getElementById("question-remove-image");

            if (dropzone && fileInput) {
                dropzone.addEventListener("click",      () => fileInput.click());
                dropzone.addEventListener("dragover",  e => { e.preventDefault(); dropzone.classList.add("drag-over"); });
                dropzone.addEventListener("dragleave", () => dropzone.classList.remove("drag-over"));
                dropzone.addEventListener("drop",      e => { e.preventDefault(); dropzone.classList.remove("drag-over"); handleImageFile(e.dataTransfer.files[0]); });
                fileInput.addEventListener("change",   () => handleImageFile(fileInput.files[0]));
            }

            function handleImageFile(file) {
                if (!file) return;
                const reader = new FileReader();
                reader.onload = e => {
                    imgPrev.src = e.target.result;
                    imgPrev.classList.remove("d-none");
                    noPreview.style.display = "none";
                    if (removeImageInput) removeImageInput.value = "false";
                    dropzone.innerHTML = `<div class="dropzone-text" style="color:var(--q-success);"><i class="fas fa-check-circle me-1"></i>${file.name}</div>`;
                };
                reader.readAsDataURL(file);
                const dt = new DataTransfer(); dt.items.add(file);
                fileInput.files = dt.files;
            }

            window.removeQuestionImage = function () {
                if (fileInput) fileInput.value = "";
                if (existingImageInput) existingImageInput.value = "";
                if (removeImageInput) removeImageInput.value = "true";
                if (imgPrev) {
                    imgPrev.src = "#";
                    imgPrev.classList.add("d-none");
                }
                if (noPreview) noPreview.style.display = "block";
                if (dropzone) {
                    dropzone.innerHTML = `
                        <div class="dropzone-icon">📁</div>
                        <div class="dropzone-text">اسحب الصورة هنا أو انقر للاختيار</div>
                        <div class="dropzone-hint">PNG, JPG, WEBP — حتى ٥ ميجابايت</div>`;
                }
                const removeBtn = document.getElementById("remove-question-image-btn");
                if (removeBtn) removeBtn.remove();
            };

            // ── ٥. صور الخيارات ──────────────────────────────
            document.querySelectorAll(".option-image-input").forEach(input => {
                input.addEventListener("change", function () {
                    const indexMatch = (this.name || "").match(/Options\[(\d+)\]/);
                    if (indexMatch) {
                        const removeInput = document.getElementById(`option-remove-image-${indexMatch[1]}`);
                        if (removeInput) removeInput.value = "false";
                    }
                    const previewId = this.dataset.preview;
                    const preview = document.getElementById(previewId);
                    if (!preview || !this.files[0]) return;
                    const reader = new FileReader();
                    reader.onload = e => { preview.src = e.target.result; preview.classList.remove("d-none"); };
                    reader.readAsDataURL(this.files[0]);
                });
            });

            window.removeOptionImage = function (index) {
                const input = document.querySelector(`[name="Options[${index}].ImageFile"]`);
                const existingInput = document.getElementById(`option-existing-image-${index}`);
                const removeInput = document.getElementById(`option-remove-image-${index}`);
                const preview = document.getElementById(`option-image-preview-${index}`);

                if (input) input.value = "";
                if (existingInput) existingInput.value = "";
                if (removeInput) removeInput.value = "true";
                if (preview) {
                    preview.src = "";
                    preview.classList.add("d-none");
                }
            };

            // ── ٦. البحث في القطعة اللفظية ──────────────────
            setupSearchableVerbalPassageSelect();

            // ── ٧. شريط التقدم: تمييز القسم النشط ──────────
            setupProgressStepper();

            ensureOptionTextInputsEditable();
        });

        function ensureOptionTextInputsEditable() {
            document.querySelectorAll(".option-text-input").forEach(input => {
                input.disabled = false;
                input.readOnly = false;
                input.removeAttribute("disabled");
                input.removeAttribute("readonly");
                input.style.pointerEvents = "";
                input.style.userSelect = "";
            });
        }

        function applyCurriculumPresentation(data) {
            isRTL = data?.isRTL !== false;
            isQuantitative = data?.isQuantitative === true;
            updateAllTextDirections();
            document.querySelectorAll("#questionText, .option-text-input, #ValueA, #ValueB").forEach(input => {
                normalizeIndicInput(input);
            });
            refreshAllLivePreviews();
        }

        function updateAllTextDirections() {
            document.querySelectorAll("#questionText, .option-text-input, #ValueA, #ValueB").forEach(input => {
                input.style.direction = isRTL ? "rtl" : "ltr";
                input.style.textAlign = isRTL ? "right" : "left";
            });
            document.querySelectorAll(".option-live-preview, #questionPreview").forEach(preview => {
                preview.style.direction = isRTL ? "rtl" : "ltr";
                preview.style.textAlign = isRTL ? "right" : "left";
            });
        }

        function refreshAllLivePreviews() {
            const questionText = document.getElementById("questionText");
            if (questionText) questionText.dispatchEvent(new Event("input"));
            document.querySelectorAll(".option-text-input").forEach(input => updateOptionPreview(input));
        }

        function getDisplayValue(value) {
            return isQuantitative ? toIndicDigitsSafe(value) : value;
        }

        function toIndicDigitsSafe(input) {
            const map = { '0': '٠', '1': '١', '2': '٢', '3': '٣', '4': '٤', '5': '٥', '6': '٦', '7': '٧', '8': '٨', '9': '٩' };
            let result = '';
            let insideTag = false;

            for (let i = 0; i < (input || '').length; i++) {
                const char = input[i];
                if (char === '<') insideTag = true;
                result += !insideTag && map[char] ? map[char] : char;
                if (char === '>') insideTag = false;
            }

            return result;
        }

        function normalizeIndicInput(input) {
            if (!isQuantitative || !input) return;
            const current = input.value;
            const converted = toIndicDigitsSafe(current);
            if (current === converted) return;

            const start = input.selectionStart;
            const end = input.selectionEnd;
            input.value = converted;
            if (typeof start === "number" && typeof end === "number") {
                input.setSelectionRange(start, end);
            }
        }

        function updateOptionPreview(input) {
            const target = document.getElementById(input.dataset.previewTarget);
            if (!target) return;
            const value = input.value.trim();
            target.innerHTML = value
                ? getDisplayValue(value)
                : '<span class="preview-empty">ستظهر الإجابة هنا كما ستعرض للطالب</span>';
            target.style.direction = isRTL ? "rtl" : "ltr";
            target.style.textAlign = isRTL ? "right" : "left";
        }

        // ══ دالة تغيير نوع القالب ══
        const COMPARISON_DEFAULT_OPTIONS = [
            "القيمة الأولى أكبر",
            "القيمة الثانية أكبر",
            "القيمتان متساويتان",
            "المعطيات غير كافية"
        ];

        function isUsingComparisonDefaultOptions() {
            return COMPARISON_DEFAULT_OPTIONS.every((text, i) => {
                const inp = document.getElementById(`optionText_${i}`);
                return inp && inp.value.trim() === text;
            });
        }

        function applyComparisonDefaultOptions() {
            const allEmpty = [0, 1, 2, 3].every(i => {
                const inp = document.getElementById(`optionText_${i}`);
                return inp && inp.value.trim() === "";
            });
            if (!allEmpty) return;

            COMPARISON_DEFAULT_OPTIONS.forEach((text, i) => {
                const inp = document.getElementById(`optionText_${i}`);
                if (!inp) return;
                inp.value = text;
                updateOptionPreview(inp);
            });
        }

        function clearComparisonDefaultOptions() {
            if (!isUsingComparisonDefaultOptions()) return;
            for (let i = 0; i < 4; i++) {
                const inp = document.getElementById(`optionText_${i}`);
                if (!inp) continue;
                inp.value = "";
                updateOptionPreview(inp);
            }
        }

        function handleTemplateChange() {
            const selected = document.querySelector('.template-selector:checked');
            if (!selected) return;
            const val = parseInt(selected.value);
            // 0=TextOnly, 1=CompareValues, 2=WithImage, 3=CompareWithImage, 4=ImageOptions
            const showImage   = [2,3,4].includes(val);
            const showCompare = [1,3].includes(val);
            document.getElementById("imageField").style.display   = showImage   ? "" : "none";
            document.getElementById("valueFields").style.display  = showCompare ? "" : "none";

            if (showCompare) {
                applyComparisonDefaultOptions();
            } else {
                clearComparisonDefaultOptions();
            }
        }

        // ══ تمييز الإجابة الصحيحة ══
        function markCorrect(index) {
            document.querySelectorAll('.option-card').forEach((card, i) => {
                card.classList.toggle('is-correct', i === index);
                const badge  = card.querySelector('.option-badge');
                const toggle = card.querySelector('.correct-toggle');
                if (badge)  badge.innerHTML  = i === index ? '<i class="fas fa-check"></i>' : badge.textContent.trim();
                if (toggle) toggle.classList.toggle('is-active', i === index);
            });
        }

        // ══ إظهار/إخفاء حقل صورة الخيار ══
        function toggleOptionImg(index) {
            const field = document.getElementById(`imgField_${index}`);
            if (!field) return;
            field.style.display = field.style.display === "none" ? "" : "none";
        }

        // ══ Scroll to section ══
        function scrollToSection(id) {
            const el = document.getElementById(id);
            if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        // ══ شريط التقدم ══
        function setupProgressStepper() {
            const sections = ['sec-curriculum','sec-type','sec-text','sec-options','sec-meta'];
            const steps = document.querySelectorAll('.step-item');
            const obs = new IntersectionObserver(entries => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const idx = sections.indexOf(entry.target.id);
                        if (idx >= 0) {
                            steps.forEach((s, i) => {
                                s.classList.toggle('active', i === idx);
                            });
                        }
                    }
                });
            }, { threshold: 0.5 });
            sections.forEach(id => { const el = document.getElementById(id); if (el) obs.observe(el); });
        }

        // ══ إخفاء الخيارات في السؤال (مفردة شاذة) ══
        function appendOptionsToTitle() {
            const texts = [];
            for (let i = 0; i < 4; i++) {
                const inp = document.getElementById(`optionText_${i}`);
                if (inp && inp.value.trim()) texts.push(inp.value.trim());
            }
            if (!texts.length) return alert("❗ أدخل نص الاختيارات أولاً.");
            const hidden = texts.join(" - ");
            const q = document.getElementById('questionText');
            if (q) {
                q.value += ` <span style="display:none;">${hidden}</span>`;
                q.dispatchEvent(new Event('input'));
                alert("✅ تم إخفاء الخيارات داخل نص السؤال.");
            }
        }

        // ══ البحث في القطعة اللفظية ══
        function setupSearchableVerbalPassageSelect() {
            document.querySelectorAll(".verbal-passage-search, .verbal-search-input").forEach(searchInput => {
                const selectId   = searchInput.dataset.targetSelect;
                const select     = document.getElementById(selectId);
                const countLabel = document.querySelector(`[data-count-for="${selectId}"] span`);
                if (!select) return;

                const allOptions = Array.from(select.options).map(o => ({ value: o.value, text: o.text }));
                const normalize  = v => (v||"").toString().trim().toLowerCase()
                                        .replace(/[أإآ]/g,"ا").replace(/ة/g,"ه").replace(/ى/g,"ي");

                const render = () => {
                    const currentVal = select.value;
                    const q = normalize(searchInput.value);
                    const frag = document.createDocumentFragment();
                    let cnt = 0;
                    allOptions.forEach(od => {
                        const empty = od.value === "";
                        const match = !q || normalize(od.text).includes(q);
                        if (empty || match) {
                            frag.appendChild(new Option(od.text, od.value));
                            if (!empty && match) cnt++;
                        }
                    });
                    select.innerHTML = ""; select.appendChild(frag);
                    select.value = currentVal;
                    if (countLabel) countLabel.textContent = searchInput.value.trim()
                        ? `${cnt} من ${allOptions.filter(o=>o.value).length} قطعة`
                        : `${allOptions.filter(o=>o.value).length} قطعة متاحة`;
                };
                searchInput.addEventListener("input", render);
                render();
            });
        }

        // ══ العلامات الكمية المتقدمة ══
        let advancedMathSymbolTargetId = null;
        function openAdvancedMathSymbolModal(inputId) {
            advancedMathSymbolTargetId = inputId;
            bootstrap.Modal.getOrCreateInstance(document.getElementById('advancedMathSymbolModal')).show();
        }
        function insertAdvancedMathSymbol() {
            const input = document.getElementById(advancedMathSymbolTargetId);
            if (!input) return;
            const type = document.getElementById('mathSymbolType').value;
            const text = document.getElementById('mathSymbolText').value.trim();
            if (!text) return alert('❗ يرجى كتابة الحروف أو النص أولاً.');
            let html = '';
            switch (type) {
                case 'overline': html = `<span style="text-decoration:overline;">${text}</span>`; break;
                case 'arc': html = `<span style="position:relative;display:inline-block;"><svg width="40" height="15" style="position:absolute;top:-0.4em;left:50%;transform:translateX(-50%);"><path d="M5,10 Q20,0 35,10" stroke="black" fill="transparent" stroke-width="1.5"/></svg><span style="font-size:18px;">${text}</span></span>`; break;
                case 'angle': html = `<span style="position:relative;display:inline-block;"><svg width="40" height="15" style="position:absolute;top:-0.4em;left:50%;transform:translateX(-50%);"><path d="M10,10 L20,2 L30,10" stroke="black" fill="transparent" stroke-width="1.5"/></svg><span style="font-size:18px;">${text}</span></span>`; break;
            }
            const s = input.selectionStart, e = input.selectionEnd;
            input.value = input.value.substring(0, s) + html + input.value.substring(e);
            input.dispatchEvent(new Event('input'));
            bootstrap.Modal.getInstance(document.getElementById('advancedMathSymbolModal')).hide();
        }

        // ══ الكلمات المميزة (اللفظي) ══
        let selectedWords = [];
        function processVerbalWords() {
            const text = document.getElementById('verbalFullText').value.trim();
            if (!text) return alert("❗ الصق نص السؤال أولاً.");
            selectedWords = [];
            const words = text.split(/\s+/);
            const area  = document.getElementById('verbalWordSelectorArea');
            area.innerHTML = '';
            words.forEach((word, idx) => {
                if (!word) return;
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.textContent = word;
                btn.style.cssText = 'margin:3px;padding:5px 12px;border:1.5px solid var(--q-border);border-radius:20px;background:#fff;cursor:pointer;font-family:Cairo,sans-serif;font-size:14px;transition:.2s;';
                btn.addEventListener('click', function () {
                    const i = selectedWords.indexOf(word);
                    if (i >= 0) {
                        selectedWords.splice(i, 1);
                        this.style.background = '#fff';
                        this.style.borderColor = 'var(--q-border)';
                        this.style.color = 'inherit';
                    } else {
                        selectedWords.push(word);
                        this.style.background = 'var(--q-danger-light)';
                        this.style.borderColor = 'var(--q-danger)';
                        this.style.color = 'var(--q-danger)';
                    }
                    document.getElementById('selectedWordsPreview').textContent = selectedWords.join(' / ');
                });
                area.appendChild(btn);
            });
        }
        function insertVerbalToQuestionText() {
            const text = document.getElementById('verbalFullText').value.trim();
            if (!text) return;
            let result = text;
            selectedWords.forEach(word => {
                result = result.replaceAll(word, `<span class="highlight-word">${word}</span>`);
            });
            document.getElementById('questionText').value = result;
            document.getElementById('questionText').dispatchEvent(new Event('input'));
            bootstrap.Modal.getInstance(document.getElementById('verbalWordsModal'))?.hide();
        }
        function fillOptionsFromSelectedWords() {
            selectedWords.forEach((word, index) => {
                const input = document.getElementById(`optionText_${index}`);
                if (input) {
                    input.value = word;
                    input.dispatchEvent(new Event('input'));
                }
            });
        }

        // ══ معاينة قبل الحفظ ══
        function readFileAsDataUrl(file) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = () => resolve(reader.result);
                reader.onerror = () => reject(reader.error);
                reader.readAsDataURL(file);
            });
        }

        function getInputValue(id) {
            return document.getElementById(id)?.value?.trim() || "";
        }

        function getHiddenBoolean(id) {
            return (document.getElementById(id)?.value || "").toLowerCase() === "true";
        }

        async function getPreviewImageUrl(fileInputId, existingInputId, removeInputId) {
            if (getHiddenBoolean(removeInputId)) {
                return "";
            }

            const fileInput = document.getElementById(fileInputId);
            if (fileInput?.files?.length > 0) {
                return await readFileAsDataUrl(fileInput.files[0]);
            }

            return getInputValue(existingInputId);
        }

        async function buildQuestionPreviewPayload() {
            const passageId = getInputValue("VerbalPassageId");
            const selectedCorrect = document.querySelector("input[name='SelectedCorrectIndex']:checked")?.value;
            const questionImageUrl = await getPreviewImageUrl(
                "question-image-input",
                "question-existing-image-url",
                "question-remove-image"
            );

            const payload = {
                Title: getInputValue("questionText"),
                CurriculumId: parseInt(getInputValue("curriculumSelect") || "0", 10),
                VerbalPassageId: passageId ? parseInt(passageId, 10) : null,
                ValueA: isQuantitative ? toIndicDigitsSafe(getInputValue("ValueA")) : getInputValue("ValueA"),
                ValueB: isQuantitative ? toIndicDigitsSafe(getInputValue("ValueB")) : getInputValue("ValueB"),
                Template: parseInt(document.querySelector("input[name='Template']:checked")?.value || "0", 10),
                IsQuantitative: isQuantitative,
                ImageUrl: questionImageUrl,
                ExistingImageUrl: getInputValue("question-existing-image-url"),
                RemoveImage: getHiddenBoolean("question-remove-image"),
                SelectedCorrectIndex: selectedCorrect !== undefined ? parseInt(selectedCorrect, 10) : null,
                CorrectAnswer: "",
                Explanation: getInputValue("Explanation"),
                VideoUrl: getInputValue("VideoUrl"),
                Options: []
            };

            const optionInputs = Array.from(document.querySelectorAll("[id^='optionText_']"));
            for (const optionInput of optionInputs) {
                const index = optionInput.id.replace("optionText_", "");
                const optionImageUrl = await getPreviewImageUrl(
                    `Options_${index}__ImageFile`,
                    `option-existing-image-${index}`,
                    `option-remove-image-${index}`
                );

                const optionModel = {
                    Text: optionInput.value.trim(),
                    ImageUrl: optionImageUrl,
                    ExistingImageUrl: getInputValue(`option-existing-image-${index}`),
                    RemoveImage: getHiddenBoolean(`option-remove-image-${index}`)
                };

                if (optionModel.Text || optionModel.ImageUrl || optionModel.ExistingImageUrl) {
                    payload.Options.push(optionModel);
                }
            }

            return payload;
        }

        async function loadQuestionPreview() {
            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById("questionPreviewModal"));
            const container = document.getElementById("questionPreviewContainer");

            container.innerHTML = `
                <div style="text-align:center;padding:30px;color:var(--q-text-muted);">
                    <i class="fas fa-spinner fa-spin" style="font-size:24px;margin-bottom:10px;display:block;"></i>
                    جاري تحميل المعاينة...
                </div>`;
            modal.show();

            try {
                const payload = await buildQuestionPreviewPayload();
                const res = await fetch("/Admin/Questions/PreviewFromCreate", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
                });

                if (!res.ok) {
                    throw new Error(`Preview request failed with status ${res.status}`);
                }

                container.innerHTML = await res.text();
            } catch (err) {
                console.error("فشل في تحميل معاينة السؤال:", err);
                container.innerHTML = "<div class='text-danger text-center p-4'>فشل في تحميل المعاينة الحالية للسؤال.</div>";
            }
        }

        // ══ أدوات الكسر والجذر والأس ══
        let activeInputId = null;
        let rootTargetFieldId = null;
        let nestedRootInputTarget = null;
        let nestedRootLevel = 1;
        let exponentTargetInput = null;
        let rootWithExponentTarget = null;

        document.addEventListener("DOMContentLoaded", function () {
            document.getElementById('numeratorInput')?.addEventListener('input', updateFractionPreview);
            document.getElementById('denominatorInput')?.addEventListener('input', updateFractionPreview);
            document.getElementById('rootValue')?.addEventListener('input', updateRootPreview);
            document.getElementById('rootType')?.addEventListener('change', updateRootPreview);
            document.getElementById('baseInput')?.addEventListener('input', updateExponentPreview);
            document.getElementById('exponentInput')?.addEventListener('input', updateExponentPreview);
            document.getElementById('rootBaseValue')?.addEventListener('input', updateRootWithExponentPreview);
            document.getElementById('rootExponentValue')?.addEventListener('input', updateRootWithExponentPreview);
        });

        function insertHtmlAtCursor(input, html) {
            if (!input) return;
            const start = input.selectionStart ?? input.value.length;
            const end = input.selectionEnd ?? input.value.length;
            input.value = input.value.substring(0, start) + html + input.value.substring(end);
            input.dispatchEvent(new Event('input'));
        }

        function getRootSymbolBasedOnLength(value) {
            const clean = (value || '').replace(/<[^>]*>?/gm, '').trim();
            if (clean.length <= 4) return '*';
            if (clean.length <= 5) return '+';
            if (clean.length <= 8) return '-';
            return '.';
        }

        function openFractionModal(id) {
            activeInputId = id;
            document.getElementById('numeratorInput').value = '';
            document.getElementById('denominatorInput').value = '';
            document.getElementById('fractionPreview').innerHTML = '';
            bootstrap.Modal.getOrCreateInstance(document.getElementById('fractionModal')).show();
        }

        function updateFractionPreview() {
            const num = document.getElementById('numeratorInput')?.value.trim();
            const den = document.getElementById('denominatorInput')?.value.trim();
            document.getElementById('fractionPreview').innerHTML = (num && den) ? buildFractionHtml(num, den) : '';
        }

        function buildFractionHtml(num, den) {
            return `<span style="display:inline-block;text-align:center;direction:rtl;vertical-align:middle;">
                        <span style="display:block;border-bottom:2px solid #000;">${num}</span>
                        <span>${den}</span>
                    </span>`;
        }

        function insertStyledFraction() {
            const num = document.getElementById('numeratorInput')?.value.trim();
            const den = document.getElementById('denominatorInput')?.value.trim();
            const input = document.getElementById(activeInputId);
            if (!input || !num || !den) return alert("يرجى إدخال البسط والمقام.");
            insertHtmlAtCursor(input, buildFractionHtml(num, den));
            bootstrap.Modal.getInstance(document.getElementById('fractionModal'))?.hide();
        }

        function openRootModal(id) {
            rootTargetFieldId = id;
            document.getElementById('rootValue').value = '';
            document.getElementById('rootType').value = '2';
            document.getElementById('rootPreview').innerHTML = '';
            bootstrap.Modal.getOrCreateInstance(document.getElementById('rootModal')).show();
        }

        function buildRootHtml(value, type) {
            const rootChar = getRootSymbolBasedOnLength(value);
            const cubeRootSup = type === '3'
                ? `<span style="font-size:13px;position:absolute;right:-4px;top:-8px;">٣</span>`
                : '';
            return `<span style="display:inline-flex;direction:rtl;align-items:flex-start;position:relative;">
                        ${cubeRootSup}
                        <span style="font-family:'ZA-roots';font-size:34px;">${rootChar}</span>
                        <span style="font-size:22px;padding-top:10px;padding-right:6px;text-align:center;min-width:40px;">${value}</span>
                    </span>`;
        }

        function updateRootPreview() {
            const value = document.getElementById('rootValue')?.value.trim();
            const type = document.getElementById('rootType')?.value;
            document.getElementById('rootPreview').innerHTML = value ? buildRootHtml(value, type) : '';
        }

        function insertRoot() {
            const value = document.getElementById('rootValue')?.value.trim();
            const type = document.getElementById('rootType')?.value;
            const input = document.getElementById(rootTargetFieldId);
            if (!value || !input) return alert("يرجى إدخال قيمة الجذر.");
            insertHtmlAtCursor(input, buildRootHtml(value, type));
            bootstrap.Modal.getInstance(document.getElementById('rootModal'))?.hide();
        }

        function getRootCharByLevel(level) {
            if (level === 1) return '/';
            if (level === 2) return '*';
            if (level === 3) return '-';
            if (level === 4) return '+';
            return '.';
        }

        function openNestedRootModal(id) {
            nestedRootInputTarget = id;
            nestedRootLevel = 1;
            document.getElementById('nestedRootsContainer').innerHTML = `
                <div class="nested-root-level mb-3">
                    <label class="q-label">قيمة الجذر المستوى 1</label>
                    <input type="text" class="q-input root-level-input" placeholder="مثال: ٣ أو ٢٥" />
                </div>`;
            document.getElementById('nestedRootPreview').innerHTML = '';
            bootstrap.Modal.getOrCreateInstance(document.getElementById('nestedRootModal')).show();
        }

        function addRootLevel() {
            const container = document.getElementById("nestedRootsContainer");
            nestedRootLevel++;
            const div = document.createElement("div");
            div.className = "nested-root-level mb-3 row g-3";
            div.innerHTML = `
                <div class="col-md-3">
                    <label class="q-label">درجة الجذر</label>
                    <input type="number" min="2" value="2" class="q-input root-degree-input" />
                </div>
                <div class="col-md-9">
                    <label class="q-label">قيمة الجذر المستوى ${nestedRootLevel}</label>
                    <input type="text" class="q-input root-level-input" placeholder="مثال: ٢٥ أو جذر آخر" />
                </div>`;
            container.appendChild(div);
        }

        function generateNestedRootPreview() {
            const degrees = Array.from(document.querySelectorAll('.root-degree-input')).map(x => x.value.trim());
            const values = Array.from(document.querySelectorAll('.root-level-input')).map(x => x.value.trim()).filter(Boolean);
            let inner = '';
            for (let i = values.length - 1; i >= 0; i--) {
                const degree = degrees[i] || '';
                const rootChar = getRootCharByLevel(values.length - i);
                const supDegree = degree ? `<span style="font-size:12px;position:absolute;right:1px;top:3px;">${degree}</span>` : '';
                inner = `<span style="display:inline-flex;direction:rtl;align-items:flex-start;position:relative;">
                            ${supDegree}
                            <span style="font-family:'ZA-roots';position:absolute;font-size:${36 + (values.length - i) * 2}px;">${rootChar}</span>
                            <span style="font-size:22px;min-width:40px;padding-top:10px;padding-right:25px;text-align:center;">
                                ${values[i]}${inner}
                            </span>
                        </span>`;
            }
            document.getElementById('nestedRootPreview').innerHTML = inner;
        }

        function insertNestedRoot() {
            generateNestedRootPreview();
            const preview = document.getElementById('nestedRootPreview').innerHTML;
            const input = document.getElementById(nestedRootInputTarget);
            if (!input || !preview) return alert("يرجى إدخال قيمة جذر واحدة على الأقل.");
            insertHtmlAtCursor(input, preview);
            bootstrap.Modal.getInstance(document.getElementById('nestedRootModal'))?.hide();
        }

        function openExponentModal(id) {
            exponentTargetInput = document.getElementById(id);
            document.getElementById('baseInput').value = '';
            document.getElementById('exponentInput').value = '';
            document.getElementById('exponentPreview').innerHTML = '';
            bootstrap.Modal.getOrCreateInstance(document.getElementById('exponentModal')).show();
        }

        function updateExponentPreview() {
            const base = document.getElementById('baseInput')?.value.trim();
            const exponent = document.getElementById('exponentInput')?.value.trim();
            document.getElementById('exponentPreview').innerHTML = (base && exponent) ? buildExponentHtml(base, exponent) : '';
        }

        function buildExponentHtml(base, exponent) {
            const hasBrackets = base.startsWith('(') && base.endsWith(')');
            const cleanBase = base.replace(/\(/g, '').replace(/\)/g, '');
            const formattedBase = hasBrackets
                ? `<span style="font-size:26px;">﹙</span>${cleanBase}<span style="font-size:26px;">﹚</span>`
                : cleanBase;
            return `<span style="display:inline-flex;direction:rtl;align-items:flex-start;">
                        <span dir="rtl" style="unicode-bidi:bidi-override;">${formattedBase}<sup style="font-size:14px;">${exponent}</sup></span>
                    </span>`;
        }

        function insertExponent() {
            const base = document.getElementById('baseInput')?.value.trim();
            const exponent = document.getElementById('exponentInput')?.value.trim();
            if (!base || !exponent || !exponentTargetInput) return alert("يرجى إدخال الأساس والأُس.");
            insertHtmlAtCursor(exponentTargetInput, buildExponentHtml(base, exponent));
            bootstrap.Modal.getInstance(document.getElementById('exponentModal'))?.hide();
        }

        function convertBrackets(value) {
            return (value || '').replace(/\(/g, '').replace(/\)/g, '');
        }

        function openRootWithExponentModal(id) {
            rootWithExponentTarget = document.getElementById(id);
            document.getElementById('rootBaseValue').value = '';
            document.getElementById('rootExponentValue').value = '';
            document.getElementById('rootWithExponentPreview').innerHTML = '';
            bootstrap.Modal.getOrCreateInstance(document.getElementById('rootWithExponentModal')).show();
        }

        function buildRootWithExponentHtml(base, exponent) {
            const safeBase = convertBrackets(base);
            return `<span style="display:inline-flex;direction:rtl;align-items:flex-start;">
                        <span style="font-family:'ZA-roots';font-size:34px;">*</span>
                        <span style="font-size:22px;padding-top:10px;padding-right:6px;">
                            <span dir="rtl" style="unicode-bidi:bidi-override;">
                                <span style="font-size:26px;">﹙</span>${safeBase}<span style="font-size:26px;">﹚</span><sup style="font-size:14px;">${exponent}</sup>
                            </span>
                        </span>
                    </span>`;
        }

        function updateRootWithExponentPreview() {
            const base = document.getElementById('rootBaseValue')?.value.trim();
            const exponent = document.getElementById('rootExponentValue')?.value.trim();
            document.getElementById('rootWithExponentPreview').innerHTML = (base && exponent) ? buildRootWithExponentHtml(base, exponent) : '';
        }

        function insertRootWithExponent() {
            const base = document.getElementById('rootBaseValue')?.value.trim();
            const exponent = document.getElementById('rootExponentValue')?.value.trim();
            if (!base || !exponent || !rootWithExponentTarget) return alert("يرجى إدخال قيمة الجذر والأُس.");
            insertHtmlAtCursor(rootWithExponentTarget, buildRootWithExponentHtml(base, exponent));
            bootstrap.Modal.getInstance(document.getElementById('rootWithExponentModal'))?.hide();
        }
    </script>
}
