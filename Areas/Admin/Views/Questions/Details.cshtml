@model QdratNew.ViewModels.Question.QuestionDetailsViewModel
@using QdratNew.Helpers
@using QdratNew.Enums

@{
    ViewData["Title"] = "تفاصيل السؤال الذكي";

    var displayModel = Model.ToDisplayModel(); // ✅ تأكد أنك تضيف هذا التابع في الكلاس لتحويل QuestionDetailsViewModel إلى QuestionDisplayViewModel
}

<div class="container mt-4" dir="rtl">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h4 class="text-primary mb-0"><i class="fas fa-question-circle"></i> تفاصيل السؤال الذكي</h4>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-info btn-sm me-2">
                    <i class="fas fa-edit"></i> تعديل
                </a>
                <a asp-action="AuditLog" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm me-2">
                    🕓 سجل التعديلات
                </a>
                <a asp-action="Index" class="btn btn-outline-dark btn-sm me-2">
                    <i class="fas fa-arrow-left"></i> العودة
                </a>
                <form asp-action="Reject" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-danger btn-sm">
                        ❌ رفض السؤال
                    </button>
                </form>
            </div>
        </div>

        <div class="card-body">

            <!-- ✅ استخدام البارشال لعرض السؤال والاختيارات -->
            @await Html.PartialAsync("_QuestionPreviewPartial", displayModel)

            <!-- ✅ معلومات إضافية بتنسيق UX/UI -->
            <div class="row text-center mt-4">
                @* المنهج *@
                <div class="col-md-4 mb-3">
                    <div class="border rounded bg-white p-3 shadow-sm">
                        <small class="text-muted fw-bold">المنهج</small><br />
                        <span class="text-primary">@Model.CurriculumTitle</span>
                    </div>
                </div>

                @* المحور *@
                <div class="col-md-4 mb-3">
                    <div class="border rounded bg-white p-3 shadow-sm">
                        <small class="text-muted fw-bold">المحور</small><br />
                        <span class="text-primary">@Model.SectionTitle</span>
                    </div>
                </div>

                @* المؤشر *@
                <div class="col-md-4 mb-3">
                    <div class="border rounded bg-white p-3 shadow-sm">
                        <small class="text-muted fw-bold">المؤشر</small><br />
                        <span class="text-primary">@Model.LessonTitle</span>
                    </div>
                </div>

                @* الصعوبة *@
                <div class="col-md-4 mb-3">
                    <div class="border rounded bg-white p-3 shadow-sm">
                        <small class="text-muted fw-bold">درجة الصعوبة</small><br />
                        <span class="text-dark">@Model.Difficulty.GetDisplayName()</span>
                    </div>
                </div>

                @* نوع العرض *@
                <div class="col-md-4 mb-3">
                    <div class="border rounded bg-white p-3 shadow-sm">
                        <small class="text-muted fw-bold">نوع السؤال</small><br />
                        <span class="text-dark">@Model.Template.GetDisplayName()</span>
                    </div>
                </div>

                @* تاريخ الإضافة *@
                <div class="col-md-4 mb-3">
                    <div class="border rounded bg-white p-3 shadow-sm">
                        <small class="text-muted fw-bold">تاريخ الإضافة</small><br />
                        <span class="text-dark">@Model.CreatedAt.ToString("yyyy/MM/dd")</span>
                    </div>
                </div>
            </div>

            <!-- ✅ الشرح -->
            @if (!string.IsNullOrWhiteSpace(Model.Explanation))
            {
                <div class="mt-4">
                    <label class="fw-bold text-secondary">📌 الشرح الإضافي:</label>
                    <div class="bg-light border rounded p-3">@Model.Explanation</div>
                </div>
            }

            <!-- ✅ رابط الفيديو -->
            @if (!string.IsNullOrWhiteSpace(Model.VideoUrl))
            {
                <div class="mt-3">
                    <label class="fw-bold text-secondary">🎥 الفيديو التوضيحي:</label><br />
                    <a href="@Model.VideoUrl" target="_blank" class="btn btn-outline-primary btn-sm mt-2">
                        <i class="fas fa-play-circle"></i> مشاهدة الفيديو
                    </a>
                </div>
            }
        </div>
    </div>
</div>
