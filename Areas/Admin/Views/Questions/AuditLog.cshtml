@model List<QdratNew.Entities.QuestionAuditLog>
@{
    ViewData["Title"] = "سجل التعديلات";
}

<div class="container mt-4" dir="rtl">
    <h3 class="text-primary mb-4">🕓 سجل التعديلات للسؤال</h3>

    <a class="btn btn-outline-primary mb-3" asp-action="Details" asp-route-id="@ViewBag.QuestionId">
        ← العودة لتفاصيل السؤال
    </a>

    <table class="table table-bordered table-striped text-center shadow">
        <thead class="table-light">
            <tr>
                <th>العملية</th>
                <th>منفذ العملية</th>
                <th>وقت التنفيذ</th>
                <th>التعديلات التي تمت</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-danger fw-bold">لا يوجد سجل تعديلات لهذا السؤال</td>
                </tr>
            }
            else
            {
                @foreach (var log in Model)
                {
                    <tr>
                        <td>@log.Action</td>
                        <td>@log.PerformedByName</td>
                        <td>@log.PerformedAt.ToString("yyyy/MM/dd - hh:mm tt")</td>
                        <td>@log.ChangedFieldsSummary</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
