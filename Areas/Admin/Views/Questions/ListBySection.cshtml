                عرض وإدارة أسئلة المحور:
                <strong style="color:#2563eb;">@Model.SectionTitle</strong>
                مع إمكانية المعاينة، التعديل، مراجعة التصنيفات، السجل، وفحص التشابه من فوتر الإجراءات.
            </div>
        </div>

        <div class="pr-header-actions">
            <a asp-action="Index" class="btn-pr-outline">
                <i class="fas fa-database"></i>
                بنك الأسئلة
            </a>

            <a asp-action="PendingReview" asp-route-sectionId="@Model.SectionId" class="btn-pr-outline">
                <i class="fas fa-shield-check"></i>
                مركز الاعتماد
            </a>

            <a asp-action="Create" class="btn-pr-primary">
                <i class="fas fa-plus"></i>
                إضافة سؤال
            </a>
        </div>
    </div>

    <div class="pr-hero">
        <div class="row g-4 align-items-center">
            <div class="col-lg-4">
                <div class="pr-hero-label">إجمالي أسئلة هذا المحور</div>
                <div class="pr-hero-number">@totalQuestions</div>
                <div class="pr-hero-note">
                    <i class="fas fa-layer-group" style="font-size:11px;"></i>
                    @Model.SectionTitle
                </div>
            </div>

            <div class="col-lg-8">
                <div class="pr-chips">
                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#bfdbfe;">@totalQuestions</div>
                        <div class="pr-chip-lbl">إجمالي الأسئلة</div>
                    </div>

                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#fde68a;">@pendingReviewCount</div>
                        <div class="pr-chip-lbl">غير معتمدة</div>
                    </div>

                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#86efac;">
                            @(totalQuestions - pendingReviewCount < 0 ? 0 : totalQuestions - pendingReviewCount)
                        </div>
                        <div class="pr-chip-lbl">معتمدة أو جاهزة</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.PendingReviewCount > 0)
    {
        <div class="pr-alert-warning d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <i class="fas fa-eye me-2"></i>
                يوجد <strong>@Model.PendingReviewCount</strong> سؤال غير معتمد في هذا المحور.
            </div>

            <a asp-action="PendingReview" asp-route-sectionId="@Model.SectionId" class="btn-pr-outline">
                <i class="fas fa-check-circle"></i>
                مراجعة الآن
            </a>
        </div>
    }

    @if (Model.Questions == null || !Model.Questions.Any())
    {
        <div class="pr-alert-info">
            <i class="fas fa-circle-info me-2"></i>
            لا توجد أسئلة في هذا المحور.
        </div>
    }
    else
    {
        <div class="pr-toolbar">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <div class="pr-toolbar-title">
                    <i class="fas fa-table"></i>
                    جدول أسئلة المحور
                </div>

                <span class="pr-selected-badge">
                    <i class="fas fa-hand-pointer"></i>
                    حدد سؤالًا من الجدول لإظهار الإجراءات أسفل الصفحة
                </span>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Index" class="btn-pr-outline" style="background:transparent;color:#e2e8f0;border-color:#334155;">
                    <i class="fas fa-arrow-right"></i>
                    رجوع لبنك الأسئلة
                </a>

                <a asp-action="Create" class="btn-pr-primary">
                    <i class="fas fa-plus-circle"></i>
                    سؤال جديد
                </a>
            </div>
        </div>

        <div class="pr-table-panel">
            <div class="table-responsive">
                <table id="questionsTable" class="table table-hover text-center w-100">
                    <thead>
                        <tr>
                            <th class="pr-select-col">
                                <input type="checkbox"
                                       id="questionsSelectAll"
                                       aria-label="تحديد كل الأسئلة في الصفحة الحالية" />
                            </th>
                            <th style="width:90px;"># مرجع</th>
                            <th style="min-width:420px;">السؤال</th>
                            <th>المؤشر</th>
                            <th>الإجابة</th>
                            <th>تاريخ الإضافة</th>
                            <th>ملحوظة داخلية</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var q in Model.Questions.OrderByDescending(x => x.CreatedAt))
                        {
                            var safeTitle = CleanQuestionTitle(q.CleanTitle, 100);
                            var noteText = ShortText(q.InternalNote, 35);
                            var answerStatus = q.IsAnswerConfirmed ? "مؤكدة" : "غير مؤكدة";

                            <tr>
                                <td class="pr-select-col">
                                    <input type="checkbox"
                                           class="pr-row-checkbox"
                                           value="@q.Id"
                                           data-reference="@(q.ReferenceNumber ?? "")"
                                           data-title="@safeTitle"
                                           data-lesson="@(q.LessonTitle ?? "")"
                                           data-answer-status="@answerStatus"
                                           data-created-at="@q.CreatedAt.ToString("yyyy/MM/dd")"
                                           data-note="@noteText"
                                           aria-label="تحديد السؤال @(q.ReferenceNumber ?? "")" />
                                </td>

                                <td>
                                    <span class="pr-q-ref">
                                        @(q.ReferenceNumber ?? "—")
                                    </span>
                                </td>

                                <td class="text-end">
                                    <div class="pr-q-title-wrap">
                                        <span class="pr-q-title-text">
                                            @safeTitle
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    <span class="pr-cell-text">
                                        @(q.LessonTitle ?? "—")
                                    </span>
                                </td>

                                <td>
                                    @if (q.IsAnswerConfirmed)
                                    {
                                        <span class="pr-badge pr-badge-confirmed">
                                            <i class="fas fa-check"></i>
                                            مؤكدة
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="pr-badge pr-badge-unconfirmed">
                                            <i class="fas fa-xmark"></i>
                                            غير مؤكدة
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="pr-cell-text">
                                        @q.CreatedAt.ToString("yyyy/MM/dd")
                                    </span>
                                </td>

                                <td>
                                    @if (string.IsNullOrWhiteSpace(q.InternalNote))
                                    {
                                        <span class="pr-badge pr-badge-empty">—</span>
                                    }
                                    else
                                    {
                                        <span class="pr-badge pr-badge-note" title="@q.InternalNote">
                                            @noteText
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="pr-bulk-footer is-hidden" id="questionsBulkFooter">
            <div class="pr-bulk-summary">
                <span class="pr-bulk-count" id="questionsSelectedCount">0</span>
                <span>سؤال محدد</span>
            </div>

            <button type="button"
                    class="pr-bulk-btn pr-bulk-btn-primary pr-bulk-single-only"
                    onclick="previewSelectedQuestion()">
                <i class="fas fa-eye"></i>
                معاينة
            </button>

            <button type="button"
                    class="pr-bulk-btn pr-bulk-btn-warning pr-bulk-single-only"
                    onclick="editSelectedQuestion()">
                <i class="fas fa-pen"></i>
                تعديل
            </button>

            <button type="button"
                    class="pr-bulk-btn pr-bulk-single-only"
                    onclick="detailsSelectedQuestion()">
                <i class="fas fa-info-circle"></i>
                التفاصيل
            </button>

            <button type="button"
                    class="pr-bulk-btn pr-bulk-btn-info pr-bulk-single-only"
                    onclick="labelsSelectedQuestion()">
                <i class="fas fa-tags"></i>
                التصنيفات
            </button>

            <button type="button"
                    class="pr-bulk-btn pr-bulk-btn-purple pr-bulk-single-only"
                    onclick="auditSelectedQuestion()">
                <i class="fas fa-history"></i>
                آخر التعديلات
            </button>

            <button type="button"
                    class="pr-bulk-btn pr-bulk-btn-danger pr-bulk-single-only"
                    onclick="similarSelectedQuestion()">
                <i class="fas fa-copy"></i>
                فحص التشابه
            </button>

            <button type="button"
                    class="pr-bulk-btn pr-bulk-btn-danger pr-bulk-single-only"
                    onclick="deleteSelectedQuestion()">
                <i class="fas fa-trash"></i>
                حذف
            </button>

            <button type="button"
                    class="pr-bulk-btn"
                    onclick="exportSelectedQuestions()">
                <i class="fas fa-download"></i>
                تصدير المحدد
            </button>

            <button type="button"
                    class="pr-bulk-clear"
                    onclick="clearQuestionsSelection()"
                    aria-label="إلغاء التحديد">
                <i class="fas fa-xmark"></i>
            </button>
        </div>
    }
</div>

<div class="modal fade pr-modal" id="questionPreviewModal" tabindex="-1" aria-hidden="true" dir="rtl">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content text-end">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-eye" style="color:#60a5fa;"></i>
                    معاينة السؤال
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="questionPreviewModalBody">
                <div class="pr-empty">
                    <i class="fas fa-spinner fa-spin"></i>
                    <p>جارٍ التحميل...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade pr-modal" id="labelsModal" tabindex="-1" dir="rtl">
    <div class="modal-dialog modal-md modal-dialog-scrollable">
        <div class="modal-content text-end">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-tags" style="color:#22d3ee;"></i>
                    التصنيفات
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="labelsModalBody">
                <div class="pr-empty">
                    <i class="fas fa-spinner fa-spin"></i>
                    <p>جارٍ التحميل...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade pr-modal" id="auditModal" tabindex="-1" dir="rtl">
    <div class="modal-dialog modal-md modal-dialog-scrollable">
        <div class="modal-content text-end">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-history" style="color:#d8b4fe;"></i>
                    آخر التعديلات
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="auditModalBody">
                <div class="pr-empty">
                    <i class="fas fa-spinner fa-spin"></i>
                    <p>جارٍ التحميل...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade pr-modal" id="similarModal" tabindex="-1" dir="rtl">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content text-end">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-copy" style="color:#fca5a5;"></i>
                    الأسئلة المتشابهة
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div id="similarResults" class="list-group"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const selectedQuestionsMap = new Map();

        function getSelectedQuestionsArray() {
            return Array.from(selectedQuestionsMap.values());
        }

        function escapeHtml(value) {
            return $('<div>').text(value || '').html();
        }

        function updateQuestionsBulkFooter() {
            const selected = getSelectedQuestionsArray();
            const footer = document.getElementById('questionsBulkFooter');
            const count = document.getElementById('questionsSelectedCount');
            const selectAll = document.getElementById('questionsSelectAll');
            const singleOnlyButtons = document.querySelectorAll('.pr-bulk-single-only');

            if (footer) {
                footer.classList.toggle('is-hidden', selected.length === 0);
            }

            if (count) {
                count.textContent = selected.length;
            }

            singleOnlyButtons.forEach(function (btn) {
                btn.classList.toggle('d-none', selected.length !== 1);
            });

            const pageCheckboxes = Array.from(document.querySelectorAll('.pr-row-checkbox'));

            if (selectAll) {
                const checkedOnPage = pageCheckboxes.filter(function (cb) {
                    return cb.checked;
                }).length;

                selectAll.checked = pageCheckboxes.length > 0 && checkedOnPage === pageCheckboxes.length;
                selectAll.indeterminate = checkedOnPage > 0 && checkedOnPage < pageCheckboxes.length;
            }
        }

        function syncQuestionRowSelectionStyles() {
            document.querySelectorAll('#questionsTable tbody tr').forEach(function (tr) {
                const cb = tr.querySelector('.pr-row-checkbox');
                tr.classList.toggle('pr-row-selected', !!cb && cb.checked);
            });
        }

        function setQuestionSelectedFromCheckbox(cb) {
            if (!cb) {
                return;
            }

            const questionId = cb.value;

            if (!questionId) {
                return;
            }

            if (cb.checked) {
                selectedQuestionsMap.set(questionId, {
                    id: questionId,
                    referenceNumber: cb.dataset.reference || '',
                    title: cb.dataset.title || '',
                    lesson: cb.dataset.lesson || '',
                    answerStatus: cb.dataset.answerStatus || '',
                    createdAt: cb.dataset.createdAt || '',
                    note: cb.dataset.note || ''
                });
            } else {
                selectedQuestionsMap.delete(questionId);
            }

            syncQuestionRowSelectionStyles();
            updateQuestionsBulkFooter();
        }

        function clearQuestionsSelection() {
            selectedQuestionsMap.clear();

            document.querySelectorAll('.pr-row-checkbox').forEach(function (cb) {
                cb.checked = false;
            });

            const selectAll = document.getElementById('questionsSelectAll');
            if (selectAll) {
                selectAll.checked = false;
                selectAll.indeterminate = false;
            }

            syncQuestionRowSelectionStyles();
            updateQuestionsBulkFooter();
        }

        function getSingleSelectedQuestion() {
            const selected = getSelectedQuestionsArray();

            if (selected.length !== 1) {
                alert('اختر سؤالًا واحدًا فقط لتنفيذ هذا الإجراء.');
                return null;
            }

            return selected[0];
        }

        function previewSelectedQuestion() {
            const selected = getSingleSelectedQuestion();

            if (!selected) {
                return;
            }

            showQuestionPreview(selected.id);
        }

        function editSelectedQuestion() {
            const selected = getSingleSelectedQuestion();

            if (!selected) {
                return;
            }

            window.open(`/Admin/Questions/Edit/${selected.id}`, '_blank');
        }

        function detailsSelectedQuestion() {
            const selected = getSingleSelectedQuestion();

            if (!selected) {
                return;
            }

            window.location.href = `/Admin/Questions/Details/${selected.id}`;
        }

        function labelsSelectedQuestion() {
            const selected = getSingleSelectedQuestion();

            if (!selected) {
                return;
            }

            openLabelsModal(selected.id);
        }

        function auditSelectedQuestion() {
            const selected = getSingleSelectedQuestion();

            if (!selected) {
                return;
            }

            openAuditModal(selected.id);
        }

        function similarSelectedQuestion() {
            const selected = getSingleSelectedQuestion();

            if (!selected) {
                return;
            }

            checkSimilar(selected.id);
        }

        function deleteSelectedQuestion() {
            const selected = getSingleSelectedQuestion();

            if (!selected) {
                return;
            }

            window.location.href = `/Admin/Questions/Delete/${selected.id}`;
        }

        function exportSelectedQuestions() {
            const selected = getSelectedQuestionsArray();

            if (!selected.length) {
                alert('اختر سؤالًا واحدًا على الأقل للتصدير.');
                return;
            }

            const csvRows = [[
                'المرجع',
                'السؤال',
                'المؤشر',
                'حالة الإجابة',
                'تاريخ الإضافة',
                'ملحوظة داخلية'
            ]];

            selected.forEach(function (item) {
                csvRows.push([
                    item.referenceNumber || '',
                    item.title || '',
                    item.lesson || '',
                    item.answerStatus || '',
                    item.createdAt || '',
                    item.note || ''
                ]);
            });

            const csv = '\uFEFF' + csvRows.map(function (items) {
                return items.map(function (item) {
                    return '"' + String(item || '').replace(/"/g, '""') + '"';
                }).join(',');
            }).join('\r\n');

            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');

            link.href = url;
            link.download = 'section_questions.csv';
            link.click();

            URL.revokeObjectURL(url);
        }

        $(document).ready(function () {
            const table = $('#questionsTable').DataTable({
                order: [[5, 'desc']],
                pageLength: 50,
                columnDefs: [
                    {
                        targets: 0,
                        orderable: false,
                        searchable: false
                    }
                ],
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.5/i18n/ar.json"
                },
                drawCallback: function () {
                    document.querySelectorAll('.pr-row-checkbox').forEach(function (cb) {
                        cb.checked = selectedQuestionsMap.has(cb.value);
                    });

                    syncQuestionRowSelectionStyles();
                    updateQuestionsBulkFooter();
                }
            });

            $('#questionsTable').on('change', '.pr-row-checkbox', function () {
                setQuestionSelectedFromCheckbox(this);
            });

            $('#questionsTable tbody').on('click', 'tr', function (event) {
                const ignoredSelectors = 'a, button, input, i';

                if ($(event.target).closest(ignoredSelectors).length) {
                    return;
                }

                const cb = this.querySelector('.pr-row-checkbox');

                if (!cb) {
                    return;
                }

                cb.checked = !cb.checked;
                setQuestionSelectedFromCheckbox(cb);
            });

            $('#questionsSelectAll').on('change', function () {
                const isChecked = this.checked;

                document.querySelectorAll('.pr-row-checkbox').forEach(function (cb) {
                    cb.checked = isChecked;
                    setQuestionSelectedFromCheckbox(cb);
                });

                syncQuestionRowSelectionStyles();
                updateQuestionsBulkFooter();
            });
        });

        function showQuestionPreview(id) {
            const body = document.getElementById('questionPreviewModalBody');
            body.innerHTML = '<div class="pr-empty"><i class="fas fa-spinner fa-spin"></i><p>جارٍ التحميل...</p></div>';

            const modal = new bootstrap.Modal(document.getElementById('questionPreviewModal'));
            modal.show();

            fetch(`/Admin/Questions/Preview/${id}`)
                .then(r => r.text())
                .then(html => {
                    body.innerHTML = html;
                })
                .catch(() => {
                    body.innerHTML = '<div class="pr-empty"><i class="fas fa-exclamation-triangle"></i><p>حدث خطأ أثناء تحميل السؤال.</p></div>';
                });
        }

        function openLabelsModal(id) {
            const body = document.getElementById('labelsModalBody');
            body.innerHTML = '<div class="pr-empty"><i class="fas fa-spinner fa-spin"></i><p>جارٍ التحميل...</p></div>';

            const modal = new bootstrap.Modal(document.getElementById('labelsModal'));
            modal.show();

            fetch(`/Admin/Questions/Labels/${id}`)
                .then(r => r.text())
                .then(html => {
                    body.innerHTML = html;
                })
                .catch(() => {
                    body.innerHTML = '<div class="pr-empty"><i class="fas fa-exclamation-triangle"></i><p>حدث خطأ أثناء تحميل التصنيفات.</p></div>';
                });
        }

        function openAuditModal(id) {
            const body = document.getElementById('auditModalBody');
            body.innerHTML = '<div class="pr-empty"><i class="fas fa-spinner fa-spin"></i><p>جارٍ التحميل...</p></div>';

            const modal = new bootstrap.Modal(document.getElementById('auditModal'));
            modal.show();

            fetch(`/Admin/Questions/Audit/${id}`)
                .then(r => r.text())
                .then(html => {
                    body.innerHTML = html;
                })
                .catch(() => {
                    body.innerHTML = '<div class="pr-empty"><i class="fas fa-exclamation-triangle"></i><p>حدث خطأ أثناء تحميل السجل.</p></div>';
                });
        }

        function checkSimilar(id) {
            const container = document.getElementById('similarResults');
            container.innerHTML = '<div class="pr-empty"><i class="fas fa-spinner fa-spin"></i><p>جارٍ فحص التشابه...</p></div>';

            const modal = new bootstrap.Modal(document.getElementById('similarModal'));
            modal.show();

            fetch(`/Admin/Questions/CheckSimilarQuestions?id=${id}`)
                .then(r => r.json())
                .then(data => {
                    container.innerHTML = '';

                    if (!data || data.length === 0) {
                        container.innerHTML = '<div class="alert alert-info text-center fw-bold">لا يوجد أسئلة متشابهة.</div>';
                        return;
                    }

                    data.forEach(q => {
                        const title = $('<div>').text(q.title || '').html();
                        const meta = [q.referenceNumber, q.lesson, q.matchType].filter(Boolean).map(x => $('<div>').text(x).html()).join(' · ');

                        container.innerHTML += `
                            <a href="/Admin/Questions/Details/${q.id}" target="_blank"
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-start gap-2">
                                <span>
                                    <span class="d-block fw-bold">${title}</span>
                                    <small class="text-muted">${meta}</small>
                                </span>
                                <span class="pr-badge pr-badge-unconfirmed">${(q.similarity * 100).toFixed(1)}%</span>
                            </a>`;
                    });
                })
                .catch(() => {
                    container.innerHTML = '<div class="alert alert-danger text-center fw-bold">فشل في تحميل الأسئلة المتشابهة.</div>';
                });
        }
    </script>
}