            }

            .pr-bulk-footer {
                bottom: 12px;
                align-items: stretch;
            }

            .pr-bulk-btn {
                flex: 1 1 auto;
                justify-content: center;
            }
        }
    </style>
}

<div class="pr-page container-fluid px-4" dir="rtl">

    <div class="pr-header">
        <div>
            <h1 class="pr-header-title">
                <i class="fas fa-question-circle me-2" style="font-size:18px;"></i>
                قائمة الأسئلة بدون إجابات مؤكدة
            </h1>
            <div class="pr-header-sub">
                هذه الصفحة تعرض الأسئلة المكتملة ظاهريًا ولكن تحتاج إلى تحديد أو تأكيد الإجابة الصحيحة قبل الاعتماد.
            </div>
        </div>

        <div class="pr-header-actions">
            <a asp-action="Dashboard" class="btn-pr-outline">
                <i class="fas fa-chart-line"></i>
                لوحة تحكم بنك الأسئلة
            </a>

            <a asp-action="Index" class="btn-pr-outline">
                <i class="fas fa-database"></i>
                بنك الأسئلة
            </a>

            <a asp-action="PendingReview" class="btn-pr-outline">
                <i class="fas fa-shield-check"></i>
                مركز الاعتماد
            </a>

            <a asp-action="Create" class="btn-pr-primary">
                <i class="fas fa-plus"></i>
                إضافة سؤال
            </a>
        </div>
    </div>

    <div class="pr-hero">
        <div class="row g-4 align-items-center">
            <div class="col-lg-5">
                <div class="pr-hero-label">إجمالي الأسئلة بدون إجابات مؤكدة</div>
                <div class="pr-hero-number">@totalMissing</div>
                <div class="pr-hero-note">
                    <i class="fas fa-triangle-exclamation" style="font-size:11px;"></i>
                    تحتاج إلى تأكيد الإجابة الصحيحة
                </div>
            </div>

            <div class="col-lg-7">
                <div class="pr-alert-warning m-0">
                    <i class="fas fa-circle-info me-2"></i>
                    لا تعتمد أي سؤال هنا قبل فتحه والتأكد من وجود اختيارات صحيحة ومطابقة لنص السؤال.
                </div>
            </div>
        </div>
    </div>

    @if (Model.Questions != null && Model.Questions.Any())
    {
        <div class="pr-alert-warning">
            <i class="fas fa-triangle-exclamation me-2"></i>
            هذه القائمة تعرض جميع الأسئلة التي لا تحتوي على إجابة صحيحة مؤكدة.
        </div>
    }
    else
    {
        <div class="pr-alert-info">
            <i class="fas fa-check-circle me-2"></i>
            لا يوجد أسئلة بدون إجابات مؤكدة حاليًا.
        </div>
    }

    <div class="pr-toolbar">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="pr-toolbar-title">
                <i class="fas fa-table"></i>
                جدول الأسئلة بدون إجابة
            </div>

            <span class="pr-selected-badge">
                <i class="fas fa-hand-pointer"></i>
                حدد سؤالًا من الجدول لإظهار الإجراءات أسفل الصفحة
            </span>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index" class="btn-pr-outline" style="background:transparent;color:#e2e8f0;border-color:#334155;">
                <i class="fas fa-arrow-right"></i>
                رجوع لبنك الأسئلة
            </a>

            <a asp-action="Create" class="btn-pr-primary">
                <i class="fas fa-plus-circle"></i>
                سؤال جديد
            </a>
        </div>
    </div>

    <div class="pr-table-panel">
        <div class="table-responsive">
            <table id="questionsTable" class="table table-hover text-center w-100">
                <thead>
                    <tr>
                        <th class="pr-select-col">
                            <input type="checkbox"
                                   id="questionsSelectAll"
                                   aria-label="تحديد كل الأسئلة في الصفحة الحالية" />
                        </th>
                        <th style="width:90px;"># مرجع</th>
                        <th style="min-width:420px;">السؤال</th>
                        <th>القسم</th>
                        <th>المحور</th>
                        <th>المؤشر</th>
                        <th>تاريخ الإنشاء</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Questions != null && Model.Questions.Any())
                    {
                        foreach (var question in Model.Questions)
                        {
                            var safeTitle = CleanQuestionTitle(question.Title, 100);

                            <tr>
                                <td class="pr-select-col">
                                    <input type="checkbox"
                                           class="pr-row-checkbox"
                                           value="@question.Id"
                                           data-reference="@(question.ReferenceNumber ?? "")"
                                           data-title="@safeTitle"
                                           data-curriculum="@(question.CurriculumTitle ?? "")"
                                           data-section="@(question.SectionTitle ?? "")"
                                           data-lesson="@(question.LessonTitle ?? "")"
                                           data-created-at="@question.CreatedAt.ToString("yyyy/MM/dd")"
                                           aria-label="تحديد السؤال @(question.ReferenceNumber ?? "")" />
                                </td>

                                <td>
                                    <span class="pr-q-ref">
                                        @NumberHelper.ToIndicNumbersSafe(question.ReferenceNumber)
                                    </span>
                                </td>

                                <td class="text-end">
                                    <span class="pr-q-title-text">
                                        @safeTitle
                                    </span>
                                </td>

                                <td>
                                    <span class="pr-cell-text">
                                        @(question.CurriculumTitle ?? "—")
                                    </span>
                                </td>

                                <td>
                                    <span class="pr-cell-text">
                                        @(question.SectionTitle ?? "—")
                                    </span>
                                </td>

                                <td>
                                    <span class="pr-cell-text">
                                        @(question.LessonTitle ?? "—")
                                    </span>
                                </td>

                                <td>
                                    <span class="pr-cell-text">
                                        @question.CreatedAt.ToString("yyyy/MM/dd")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="pr-bulk-footer is-hidden" id="questionsBulkFooter">
        <div class="pr-bulk-summary">
            <span class="pr-bulk-count" id="questionsSelectedCount">0</span>
            <span>سؤال محدد</span>
        </div>

        <button type="button"
                class="pr-bulk-btn pr-bulk-btn-warning pr-bulk-single-only"
                onclick="editSelectedQuestion()">
            <i class="fas fa-edit"></i>
            استكمال
        </button>

        <button type="button"
                class="pr-bulk-btn pr-bulk-btn-info pr-bulk-single-only"
                onclick="detailsSelectedQuestion()">
            <i class="fas fa-eye"></i>
            معاينة
        </button>

        <button type="button"
                class="pr-bulk-btn pr-bulk-btn-primary"
                onclick="exportSelectedQuestions()">
            <i class="fas fa-download"></i>
            تصدير المحدد
        </button>

        <button type="button"
                class="pr-bulk-clear"
                onclick="clearQuestionsSelection()"
                aria-label="إلغاء التحديد">
            <i class="fas fa-xmark"></i>
        </button>
    </div>
</div>

@section Scripts {
    <script>
        const selectedQuestionsMap = new Map();

        function getSelectedQuestionsArray() {
            return Array.from(selectedQuestionsMap.values());
        }

        function updateQuestionsBulkFooter() {
            const selected = getSelectedQuestionsArray();
            const footer = document.getElementById('questionsBulkFooter');
            const count = document.getElementById('questionsSelectedCount');
            const selectAll = document.getElementById('questionsSelectAll');
            const singleOnlyButtons = document.querySelectorAll('.pr-bulk-single-only');

            if (footer) {
                footer.classList.toggle('is-hidden', selected.length === 0);
            }

            if (count) {
                count.textContent = selected.length;
            }

            singleOnlyButtons.forEach(function (btn) {
                btn.classList.toggle('d-none', selected.length !== 1);
            });

            const pageCheckboxes = Array.from(document.querySelectorAll('.pr-row-checkbox'));

            if (selectAll) {
                const checkedOnPage = pageCheckboxes.filter(function (cb) {
                    return cb.checked;
                }).length;

                selectAll.checked = pageCheckboxes.length > 0 && checkedOnPage === pageCheckboxes.length;
                selectAll.indeterminate = checkedOnPage > 0 && checkedOnPage < pageCheckboxes.length;
            }
        }

        function syncQuestionRowSelectionStyles() {
            document.querySelectorAll('#questionsTable tbody tr').forEach(function (tr) {
                const cb = tr.querySelector('.pr-row-checkbox');
                tr.classList.toggle('pr-row-selected', !!cb && cb.checked);
            });
        }

        function setQuestionSelectedFromCheckbox(cb) {
            if (!cb) {
                return;
            }

            const questionId = cb.value;

            if (!questionId) {
                return;
            }

            if (cb.checked) {
                selectedQuestionsMap.set(questionId, {
                    id: questionId,
                    referenceNumber: cb.dataset.reference || '',
                    title: cb.dataset.title || '',
                    curriculum: cb.dataset.curriculum || '',
                    section: cb.dataset.section || '',
                    lesson: cb.dataset.lesson || '',
                    createdAt: cb.dataset.createdAt || ''
                });
            } else {
                selectedQuestionsMap.delete(questionId);
            }

            syncQuestionRowSelectionStyles();
            updateQuestionsBulkFooter();
        }

        function clearQuestionsSelection() {
            selectedQuestionsMap.clear();

            document.querySelectorAll('.pr-row-checkbox').forEach(function (cb) {
                cb.checked = false;
            });

            const selectAll = document.getElementById('questionsSelectAll');

            if (selectAll) {
                selectAll.checked = false;
                selectAll.indeterminate = false;
            }

            syncQuestionRowSelectionStyles();
            updateQuestionsBulkFooter();
        }

        function getSingleSelectedQuestion() {
            const selected = getSelectedQuestionsArray();

            if (selected.length !== 1) {
                alert('اختر سؤالًا واحدًا فقط لتنفيذ هذا الإجراء.');
                return null;
            }

            return selected[0];
        }

        function editSelectedQuestion() {
            const selected = getSingleSelectedQuestion();

            if (!selected) {
                return;
            }

            window.location.href = `/Admin/Questions/Edit/${selected.id}`;
        }

        function detailsSelectedQuestion() {
            const selected = getSingleSelectedQuestion();

            if (!selected) {
                return;
            }

            window.location.href = `/Admin/Questions/Details/${selected.id}`;
        }

        function exportSelectedQuestions() {
            const selected = getSelectedQuestionsArray();

            if (!selected.length) {
                alert('اختر سؤالًا واحدًا على الأقل للتصدير.');
                return;
            }

            const csvRows = [[
                'المرجع',
                'السؤال',
                'القسم',
                'المحور',
                'المؤشر',
                'تاريخ الإنشاء'
            ]];

            selected.forEach(function (item) {
                csvRows.push([
                    item.referenceNumber || '',
                    item.title || '',
                    item.curriculum || '',
                    item.section || '',
                    item.lesson || '',
                    item.createdAt || ''
                ]);
            });

            const csv = '\uFEFF' + csvRows.map(function (items) {
                return items.map(function (item) {
                    return '"' + String(item || '').replace(/"/g, '""') + '"';
                }).join(',');
            }).join('\r\n');

            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');

            link.href = url;
            link.download = 'missing_confirmed_answers_questions.csv';
            link.click();

            URL.revokeObjectURL(url);
        }

        $(document).ready(function () {
            $('#questionsTable').DataTable({
                pageLength: 25,
                order: [[6, 'desc']],
                columnDefs: [
                    {
                        targets: 0,
                        orderable: false,
                        searchable: false
                    }
                ],
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.5/i18n/ar.json"
                },
                drawCallback: function () {
                    document.querySelectorAll('.pr-row-checkbox').forEach(function (cb) {
                        cb.checked = selectedQuestionsMap.has(cb.value);
                    });

                    syncQuestionRowSelectionStyles();
                    updateQuestionsBulkFooter();
                }
            });

            $('#questionsTable').on('change', '.pr-row-checkbox', function () {
                setQuestionSelectedFromCheckbox(this);
            });

            $('#questionsTable tbody').on('click', 'tr', function (event) {
                const ignoredSelectors = 'a, button, input, i';

                if ($(event.target).closest(ignoredSelectors).length) {
                    return;
                }

                const cb = this.querySelector('.pr-row-checkbox');

                if (!cb) {
                    return;
                }

                cb.checked = !cb.checked;
                setQuestionSelectedFromCheckbox(cb);
            });

            $('#questionsSelectAll').on('change', function () {
                const isChecked = this.checked;

                document.querySelectorAll('.pr-row-checkbox').forEach(function (cb) {
                    cb.checked = isChecked;
                    setQuestionSelectedFromCheckbox(cb);
                });

                syncQuestionRowSelectionStyles();
                updateQuestionsBulkFooter();
            });
        });
    </script>
}