@model QdratNew.ViewModels.ConfirmDeleteViewModel
@{
    ViewData["Title"] = "تأكيد الحذف";
}


<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-danger text-white">
            <h5><i class="fas fa-exclamation-triangle"></i> @Model.Title</h5>
        </div>
        <div class="card-body text-end">
            <p>@Model.Message</p>
            <form asp-action="DeleteConfirmed" method="post" class="mt-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.ItemId" />
                <button type="submit" class="btn btn-danger"><i class="fas fa-trash-alt me-1"></i> @Model.ConfirmButtonText</button>
                <a asp-action="Index" class="btn btn-secondary">رجوع</a>
            </form>
        </div>
    </div>
</div>
