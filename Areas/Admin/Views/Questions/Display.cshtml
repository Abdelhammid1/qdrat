@model QdratNew.ViewModels.Question.QuestionDisplayViewModel
@{
    Layout = null; // 🚫 تعطيل الـ Layout بالكامل
}
@using QdratNew.Helpers

@{
    var q = Model;
    Func<string, string> convert = q.IsQuantitative
        ? s => NumberHelper.ToIndicNumbersSafe(s)
        : s => s;

    string questionText = q.Title ?? q.QuestionText ?? q.Title ?? "";
    bool hasPassage = !string.IsNullOrWhiteSpace(q.VerbalPassageContent);
    bool hasImage = !string.IsNullOrWhiteSpace(q.ImageUrl);
    bool isComparison = q.DisplayType.ToString().Contains("Comparison");
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>عرض السؤال - معهد القدرات</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/qdrat.css" rel="stylesheet" asp-append-version="true" />
    <style>
        body {
            background: #fff;
            font-family: 'Cairo', sans-serif;
            direction: rtl;
            text-align: right;
        }

        .page-wrapper {
            max-width: 1000px;
            margin: 40px auto;
            padding: 40px;
            background: #fff;
            box-shadow: 0 0 15px rgba(0,0,0,0.1);
            border-radius: 12px;
        }

        h4 {
            color: #0077b6;
            font-weight: 700;
        }

        .whiteboard-space {
            height: 100px;
            background: #fff;
            border-top: 1px dashed #ccc;
            margin-top: 25px;
        }

        .table th, .table td {
            vertical-align: middle !important;
            text-align: right !important;
        }

        .btn-return {
            position: fixed;
            top: 15px;
            left: 20px;
            z-index: 1000;
        }

        h4, h5, td, th, div, p {
            text-align: right !important;
        }
    </style>
</head>

<body>

    <!-- 🔙 زر الرجوع -->
    <a href="/Admin/Questions/Index" class="btn btn-outline-primary btn-return">
        <i class="fa-solid fa-arrow-right"></i> الرجوع إلى بنك الأسئلة
    </a>

    <div class="page-wrapper">
        <div class="mb-4 text-end">

            <!-- 🔹 عرض المحور والمؤشر -->
            @if (!string.IsNullOrWhiteSpace(q.SectionTitle) || !string.IsNullOrWhiteSpace(q.LessonTitle))
            {
                <div class="d-flex justify-content-between align-items-center mb-3 fs-6">

                    <!-- 🔹 المحور والمؤشر -->
                    <div class="text-secondary">
                        <i class="fa-solid fa-book-open text-primary"></i>
                        <span class="fw-bold text-dark">@q.SectionTitle</span>

                        @if (!string.IsNullOrWhiteSpace(q.LessonTitle))
                        {
                            <span class="mx-2 text-muted">➤</span>
                            <span class="fw-bold text-success">@q.LessonTitle</span>
                        }
                    </div>

                    <!-- 🔹 شعار المنصة -->
                    <div>
                        <img src="~/images/160×100.png"
                             alt="شعار معهد القدرات"
                             class="img-fluid"
                             style="max-height:60px; border-radius:8px;" />
                    </div>
                </div>
            }
            <!-- 🧠 نص السؤال -->
            <h4 class="fw-bold mb-3">🧠 السؤال</h4>
            <div class="fs-5 lh-lg text-start">
                @Html.Raw(convert(questionText))
            </div>
        </div>


        @if (hasPassage)
        {
            <div class="border rounded-3 p-3 mb-4 bg-light-subtle text-secondary fs-6 lh-lg text-end">
                @Html.Raw(convert(q.VerbalPassageContent))
            </div>
        }

        @if (hasImage)
        {
            <div class="text-center mb-4">
                <img src="@Url.Content(q.ImageUrl)"
                     class="img-fluid rounded shadow-sm"
                     alt="صورة السؤال"
                     style="max-height:220px; object-fit:contain;" />
            </div>
        }

        @if (isComparison)
        {
            <div class="text-center mb-4">
                <table class="table table-bordered table-striped w-75 mx-auto shadow-sm text-end">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center">القيمة الأولى</th>
                            <th class="text-center">القيمة الثانية</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="fs-6 text-end">@Html.Raw(convert(q.ComparisonValue1))</td>
                            <td class="fs-6 text-end">@Html.Raw(convert(q.ComparisonValue2))</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }

        @if (q.Options != null && q.Options.Any())
        {
            <div class="table-responsive mb-4">
                <table class="table table-bordered align-middle shadow-sm fs-6 text-end">
                    <thead class="table-light">
                        <tr>
                            <th style="width:70px;" class="text-center">#</th>
                            <th class="text-end">النص / الصورة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < q.Options.Count; i++)
                        {
                            var opt = q.Options[i];
                            <tr>
                                <td class="fw-bold text-center">@NumberHelper.ToIndicNumbersSafe((i + 1).ToString())</td>
                                <td class="text-end">
                                    @if (!string.IsNullOrWhiteSpace(opt.ImageUrl))
                                    {
                                        <img src="@Url.Content(opt.ImageUrl)"
                                             class="img-fluid rounded shadow-sm"
                                             style="max-height:100px; object-fit:contain;" />
                                    }
                                    else
                                    {
                                        <div class="lh-lg">@Html.Raw(convert(opt.Text))</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-light text-end fs-6">❌ لا توجد اختيارات لهذا السؤال.</div>
        }

        <!-- ✏️ مساحة فارغة للشرح -->
        <div class="whiteboard-space mt-5"></div>
        <div class="whiteboard-space"></div>
        <div class="whiteboard-space"></div>
        <div class="whiteboard-space"></div>
        <div class="whiteboard-space"></div>
        <div class="whiteboard-space"></div>
        <div class="whiteboard-space"></div>
    </div>

    <script>
        // ✅ تفعيل ملء الشاشة التلقائي عند تحميل الصفحة
        document.addEventListener("DOMContentLoaded", function () {
            function requestFullScreen() {
                let docEl = document.documentElement;
                if (docEl.requestFullscreen) docEl.requestFullscreen();
                else if (docEl.mozRequestFullScreen) docEl.mozRequestFullScreen();
                else if (docEl.webkitRequestFullScreen) docEl.webkitRequestFullScreen();
                else if (docEl.msRequestFullscreen) docEl.msRequestFullscreen();
            }

            // تأخير بسيط لتجنب حظر المتصفح
            setTimeout(requestFullScreen, 600);
        });
    </script>

</body>
</html>
