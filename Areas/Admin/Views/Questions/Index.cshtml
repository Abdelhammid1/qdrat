}

<div class="pr-page container-fluid px-4" dir="rtl">

    @if (TempData["Message"] != null)
    {
        <div class="pr-alert pr-alert-success d-flex align-items-center gap-2">
            <i class="fas fa-check-circle"></i>
            @TempData["Message"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="pr-alert pr-alert-danger d-flex align-items-center gap-2">
            <i class="fas fa-exclamation-circle"></i>
            @TempData["Error"]
        </div>
    }

    <div class="pr-header">
        <div>
            <h1 class="pr-header-title">
                <i class="fas fa-list-ol me-2" style="font-size:18px;"></i>
                بنك الأسئلة الذكي
            </h1>
            <div class="pr-header-sub">
                إدارة بنك الأسئلة، مراجعة الإجابات، الفلاتر التعليمية، المعاينة، والتحقق من التشابه من واجهة واحدة.
            </div>
        </div>

        <div class="pr-header-actions">
            <a asp-action="PendingReview" class="btn-pr-ghost">
                <i class="fas fa-shield-check"></i>
                مركز اعتماد الأسئلة
            </a>

            <a asp-action="MissingAnswers" class="btn-pr-outline">
                <i class="fas fa-circle-question"></i>
                مراجعة بدون إجابة
            </a>

            <a asp-action="IncompleteQuestions" class="btn-pr-outline">
                <i class="fas fa-triangle-exclamation"></i>
                الأسئلة غير المكتملة
            </a>

            <a asp-action="SimilarGroups"
               asp-route-curriculumId="@Model.CurriculumId"
               asp-route-sectionId="@Model.SectionId"
               asp-route-lessonId="@Model.LessonId"
               asp-route-searchTitle="@Model.SearchTitle"
               class="btn-pr-outline">
                <i class="fas fa-code-compare"></i>
                مجموعات التشابه
            </a>

            <a asp-action="Create" class="btn-pr-primary">
                <i class="fas fa-plus"></i>
                إضافة سؤال
            </a>
        </div>
    </div>

    <div class="pr-hero">
        <div class="row g-4 align-items-center">
            <div class="col-lg-4">
                <div class="pr-hero-label">إدارة بنك الأسئلة</div>
                <div class="pr-hero-number">@totalQuestions</div>
                <div class="pr-hero-filtered">
                    <i class="fas fa-database" style="font-size:11px;"></i>
                    إجمالي الأسئلة المطابقة للفلاتر الحالية
                </div>
            </div>

            <div class="col-lg-8">
                <div class="pr-chips">
                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#bfdbfe;">@pendingReviewCount</div>
                        <div class="pr-chip-lbl">جاهزة للاعتماد</div>
                    </div>

                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#fde68a;">@unreviewedCount</div>
                        <div class="pr-chip-lbl">غير مراجعة</div>
                    </div>

                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#fca5a5;">@unansweredCount</div>
                        <div class="pr-chip-lbl">بدون إجابة مؤكدة</div>
                    </div>

                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#86efac;">
                            @(totalQuestions - unansweredCount < 0 ? 0 : totalQuestions - unansweredCount)
                        </div>
                        <div class="pr-chip-lbl">مكتملة ظاهريًا</div>
                    </div>

                    <a asp-action="SimilarGroups"
                       asp-route-curriculumId="@Model.CurriculumId"
                       asp-route-sectionId="@Model.SectionId"
                       asp-route-lessonId="@Model.LessonId"
                       asp-route-searchTitle="@Model.SearchTitle"
                       class="pr-chip pr-chip-link">
                        <div class="pr-chip-val" style="color:#c4b5fd;font-size:22px;">فحص</div>
                        <div class="pr-chip-lbl">مجموعات متشابهة</div>
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (Model.UnreviewedCount > 0 || Model.UnansweredCount > 0 || Model.PendingReviewCount > 0)
    {
        <div class="pr-alert-warning px-4 py-3 mb-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex flex-column gap-2">
                    @if (Model.PendingReviewCount > 0)
                    {
                        <div>
                            <i class="fas fa-eye text-warning me-2"></i>
                            يوجد <strong>@Model.PendingReviewCount</strong> سؤال جاهز للاعتماد.
                        </div>
                    }

                    @if (Model.UnansweredCount > 0)
                    {
                        <div>
                            <i class="fas fa-check-circle text-info me-2"></i>
                            يوجد <strong>@Model.UnansweredCount</strong> سؤال مكتمل ولكن بدون إجابة مؤكدة.
                        </div>
                    }

                    @if (Model.UnreviewedCount > 0)
                    {
                        <div>
                            <i class="fas fa-triangle-exclamation text-danger me-2"></i>
                            يوجد أسئلة غير مكتملة وتحتاج إلى مراجعة قبل اعتمادها.
                        </div>
                    }
                </div>

                <div class="d-flex flex-wrap gap-2">
                    @if (Model.PendingReviewCount > 0)
                    {
                        <a asp-action="PendingReview" class="btn-pr-primary">
                            <i class="fas fa-shield-check"></i>
                            مراجعة الآن
                        </a>
                    }

                    @if (Model.UnansweredCount > 0)
                    {
                        <a asp-action="MissingAnswers" class="btn-pr-outline">
                            <i class="fas fa-circle-question"></i>
                            مراجعة بدون إجابة
                        </a>
                    }

                    @if (Model.UnreviewedCount > 0)
                    {
                        <a asp-action="IncompleteQuestions" class="btn-pr-outline">
                            <i class="fas fa-list-check"></i>
                            الأسئلة غير المكتملة
                        </a>
                    }
                </div>
            </div>
        </div>
    }

