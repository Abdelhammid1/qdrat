@section Scripts {
    <script src="~/libs/datatables/js/jquery.datatables.min.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/libs/datatables/js/buttons.html5.min.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/libs/datatables/js/datatables.buttons.min.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/libs/datatables/js/buttons.print.min.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/libs/datatables/js/jszip.min.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/libs/datatables/js/pdfmake.min.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/libs/datatables/js/vfs_fonts.js?v=@DateTime.Now.Ticks"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const selectedQuestionsMap = new Map();

        function escapeHtml(value) {
            return $('<div>').text(value || '').html();
        }

        function cleanQuestionTitle(rawTitle) {
            if (!rawTitle) {
                return '';
            }

            return rawTitle.replace(/<span[^>]*display:none[^>]*>(.*?)<\/span>/gi, '$1');
        }

        function shortenText(text, maxLength) {
            if (!text) {
                return '';
            }

            return text.length > maxLength ? text.substring(0, maxLength) + '...' : text;
        }

        function getQuestionRowId(row) {
            return row.id || row.Id || '';
        }

        function getSelectedQuestionsArray() {
            return Array.from(selectedQuestionsMap.values());
        }

        function updateQuestionsBulkFooter() {
            const selected = getSelectedQuestionsArray();
            const footer = document.getElementById('questionsBulkFooter');
            const count = document.getElementById('questionsSelectedCount');
            const selectAll = document.getElementById('questionsSelectAll');
            const singleOnlyButtons = document.querySelectorAll('.pr-bulk-single-only');

            if (footer) {
                footer.classList.toggle('is-hidden', selected.length === 0);
            }

            if (count) {
                count.textContent = selected.length;
            }

            singleOnlyButtons.forEach(function (btn) {
                btn.classList.toggle('d-none', selected.length !== 1);
            });

            const pageCheckboxes = Array.from(document.querySelectorAll('.pr-row-checkbox'));

            if (selectAll) {
                const checkedOnPage = pageCheckboxes.filter(function (cb) {
                    return cb.checked;
                }).length;

                selectAll.checked = pageCheckboxes.length > 0 && checkedOnPage === pageCheckboxes.length;
                selectAll.indeterminate = checkedOnPage > 0 && checkedOnPage < pageCheckboxes.length;
            }
        }

        function syncQuestionRowSelectionStyles() {
            document.querySelectorAll('#questionsTable tbody tr').forEach(function (tr) {
                const cb = tr.querySelector('.pr-row-checkbox');
                tr.classList.toggle('pr-row-selected', !!cb && cb.checked);
            });
        }

        function setQuestionSelectedFromCheckbox(cb) {
            if (!cb) {
                return;
            }

            const questionId = cb.value;

            if (!questionId) {
                return;
            }

            if (cb.checked) {
                selectedQuestionsMap.set(questionId, {
                    id: questionId,
                    referenceNumber: cb.dataset.reference || '',
                    title: cb.dataset.title || '',
                    curriculum: cb.dataset.curriculum || '',
                    section: cb.dataset.section || '',
                    lesson: cb.dataset.lesson || '',
                    answerStatus: cb.dataset.answerStatus || '',
                    createdAt: cb.dataset.createdAt || ''
                });
            } else {
                selectedQuestionsMap.delete(questionId);
            }

            syncQuestionRowSelectionStyles();
            updateQuestionsBulkFooter();
        }

        function clearQuestionsSelection() {
            selectedQuestionsMap.clear();

            document.querySelectorAll('.pr-row-checkbox').forEach(function (cb) {
                cb.checked = false;
            });

            const selectAll = document.getElementById('questionsSelectAll');
            if (selectAll) {
                selectAll.checked = false;
                selectAll.indeterminate = false;
            }

            syncQuestionRowSelectionStyles();
            updateQuestionsBulkFooter();
        }

        function getSingleSelectedQuestion() {
            const selected = getSelectedQuestionsArray();

            if (selected.length !== 1) {
                Swal.fire('تنبيه', 'اختر سؤالًا واحدًا فقط لتنفيذ هذا الإجراء.', 'warning');
                return null;
            }

            return selected[0];
        }

        function previewSelectedQuestion() {
            const selected = getSingleSelectedQuestion();
            if (!selected) {
                return;
            }

            showQuestionPreview(selected.id);
        }

        function editSelectedQuestion() {
            const selected = getSingleSelectedQuestion();
            if (!selected) {
                return;
            }

            window.open(`/Admin/Questions/Edit/${selected.id}`, '_blank');
        }

        function displaySelectedQuestion() {
            const selected = getSingleSelectedQuestion();
            if (!selected) {
                return;
            }

            window.open(`/Admin/Questions/Display/${selected.id}`, '_blank');
        }

        function detailsSelectedQuestion() {
            const selected = getSingleSelectedQuestion();
            if (!selected) {
                return;
            }

            window.location.href = `/Admin/Questions/Details/${selected.id}`;
        }

        function labelsSelectedQuestion() {
            const selected = getSingleSelectedQuestion();
            if (!selected) {
                return;
            }

            openLabelsModal(selected.id);
        }

        function auditSelectedQuestion() {
            const selected = getSingleSelectedQuestion();
            if (!selected) {
                return;
            }

            openAuditModal(selected.id);
        }

        function similarSelectedQuestion() {
            const selected = getSingleSelectedQuestion();
            if (!selected) {
                return;
            }

            checkSimilar(selected.id);
        }

        function deleteSelectedQuestion() {
            const selected = getSingleSelectedQuestion();
            if (!selected) {
                return;
            }

            openConfirmDelete(selected.id, selected.title || selected.referenceNumber || 'هذا السؤال');
        }

        function exportSelectedQuestions() {
            const selected = getSelectedQuestionsArray();

            if (!selected.length) {
                Swal.fire('تنبيه', 'اختر سؤالًا واحدًا على الأقل للتصدير.', 'warning');
                return;
            }

            const csvRows = [[
                'المرجع',
                'السؤال',
                'القسم',
                'المحور',
                'المؤشر',
                'حالة الإجابة',
                'التاريخ'
            ]];

            selected.forEach(function (item) {
                csvRows.push([
                    item.referenceNumber || '',
                    item.title || '',
                    item.curriculum || '',
                    item.section || '',
                    item.lesson || '',
                    item.answerStatus || '',
                    item.createdAt || ''
                ]);
            });

            const csv = '\uFEFF' + csvRows.map(function (items) {
                return items.map(function (item) {
                    return '"' + String(item || '').replace(/"/g, '""') + '"';
                }).join(',');
            }).join('\r\n');

            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');

            link.href = url;
            link.download = 'selected_questions.csv';
            link.click();

            URL.revokeObjectURL(url);
        }

        const questionsTable = $('#questionsTable').DataTable({
            processing: true,
            serverSide: true,
            deferRender: true,
            ajax: {
                url: '/Admin/Questions/LoadQuestionsData',
                type: 'POST',
                data: function (d) {
                    d.curriculumId = $('#CurriculumId').val();
                    d.sectionId = $('#SectionId').val();
                    d.unitId = $('#UnitId').val();
                    d.lessonId = $('#LessonId').val();
                    d.onlyUnanswered = $('#OnlyUnanswered').is(':checked');
                    d.searchTitle = $('#SearchTitle').val();
                },
                dataSrc: 'data'
            },
            order: [[8, 'desc']],
            pageLength: 50,
            lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "الكل"]],
            columns: [
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    className: 'pr-select-col',
                    render: function (_, __, row) {
                        const id = getQuestionRowId(row);
                        const cleanTitle = cleanQuestionTitle(row.title || '');
                        const isSelected = selectedQuestionsMap.has(String(id));
                        const answerStatus = row.isAnswerConfirmed ? 'مؤكدة' : 'غير مؤكدة';

                        return `
                            <input type="checkbox"
                                   class="pr-row-checkbox"
                                   value="${escapeHtml(id)}"
                                   data-reference="${escapeHtml(row.referenceNumber || '')}"
                                   data-title="${escapeHtml(cleanTitle || '')}"
                                   data-curriculum="${escapeHtml(row.curriculum || '')}"
                                   data-section="${escapeHtml(row.section || '')}"
                                   data-lesson="${escapeHtml(row.lesson || '')}"
                                   data-answer-status="${escapeHtml(answerStatus)}"
                                   data-created-at="${escapeHtml(row.createdAt || '')}"
                                   ${isSelected ? 'checked' : ''}
                                   aria-label="تحديد السؤال ${escapeHtml(row.referenceNumber || '')}" />`;
                    }
                },
                {
                    data: 'referenceNumber',
                    render: function (data) {
                        return `<span class="pr-q-ref">${escapeHtml(data || '—')}</span>`;
                    }
                },
                {
                    data: null,
                    className: 'dt-body-right',
                    render: function (_, __, row) {
                        const cleanTitle = cleanQuestionTitle(row.title || '');
                        const shortTitle = shortenText(cleanTitle, 120);

                        return `
                            <div class="pr-q-title">
                                <div class="pr-q-title-text">${escapeHtml(shortTitle || '—')}</div>
                            </div>`;
                    }
                },
                {
                    data: 'curriculum',
                    render: function (data) {
                        return `<span style="color:#334155;font-weight:800;">${escapeHtml(data || '—')}</span>`;
                    }
                },
                {
                    data: 'section',
                    render: function (data) {
                        return `<span style="color:#334155;font-weight:800;">${escapeHtml(data || '—')}</span>`;
                    }
                },
                {
                    data: 'lesson',
                    render: function (data) {
                        return `<span style="color:#334155;font-weight:800;">${escapeHtml(data || '—')}</span>`;
                    }
                },
                {
                    data: 'isAnswerConfirmed',
                    render: function (data) {
                        return data
                            ? `<span class="pr-badge pr-badge-confirmed"><i class="fas fa-check"></i> مؤكدة</span>`
                            : `<span class="pr-badge pr-badge-unconfirmed"><i class="fas fa-xmark"></i> غير مؤكدة</span>`;
                    }
                },
                {
                    data: 'internalNote',
                    render: function (data) {
                        if (!data || data.trim() === '') {
                            return `<span class="pr-badge pr-badge-empty">—</span>`;
                        }

                        const shortNote = data.length > 36 ? data.substring(0, 36) + '...' : data;
                        return `<span class="pr-badge pr-badge-note" title="${escapeHtml(data)}">${escapeHtml(shortNote)}</span>`;
                    }
                },
                {
                    data: 'createdAt',
                    render: function (data) {
                        return `<span style="color:#334155;font-weight:800;">${escapeHtml(data || '—')}</span>`;
                    }
                }
            ],
            language: {
                url: "//cdn.datatables.net/plug-ins/1.13.5/i18n/ar.json"
            },
            drawCallback: function () {
                document.querySelectorAll('.pr-row-checkbox').forEach(function (cb) {
                    cb.checked = selectedQuestionsMap.has(cb.value);
                });

                syncQuestionRowSelectionStyles();
                updateQuestionsBulkFooter();
            }
        });

        $('#questionsTable').on('change', '.pr-row-checkbox', function () {
            setQuestionSelectedFromCheckbox(this);
        });

        $('#questionsTable tbody').on('click', 'tr', function (event) {
            const ignoredSelectors = 'a, button, input, .pr-bulk-btn, i';

            if ($(event.target).closest(ignoredSelectors).length) {
                return;
            }

            const cb = this.querySelector('.pr-row-checkbox');

            if (!cb) {
                return;
            }

            cb.checked = !cb.checked;
            setQuestionSelectedFromCheckbox(cb);
        });

        $('#questionsSelectAll').on('change', function () {
            const isChecked = this.checked;

            document.querySelectorAll('.pr-row-checkbox').forEach(function (cb) {
                cb.checked = isChecked;
                setQuestionSelectedFromCheckbox(cb);
            });

            syncQuestionRowSelectionStyles();
            updateQuestionsBulkFooter();
        });

        $('#indexFilterForm').on('submit', function (e) {
            e.preventDefault();
            clearQuestionsSelection();
            questionsTable.ajax.reload();
        });

        $('#OnlyUnanswered').on('change', function () {
            clearQuestionsSelection();
            questionsTable.ajax.reload();
        });

        function showQuestionPreview(id) {
            const body = document.getElementById('questionPreviewModalBody');
            body.innerHTML = '<div class="pr-empty"><i class="fas fa-spinner fa-spin"></i><p>جارٍ التحميل...</p></div>';

            const modal = new bootstrap.Modal(document.getElementById('questionPreviewModal'));
            modal.show();

            fetch(`/Admin/Questions/Preview/${id}`)
                .then(response => response.text())
                .then(html => {
                    body.innerHTML = html;
                })
                .catch(() => {
                    body.innerHTML = '<div class="pr-empty"><i class="fas fa-exclamation-triangle"></i><p>حدث خطأ أثناء تحميل السؤال.</p></div>';
                });
        }

