        function checkSimilar(questionId) {
            const container = document.getElementById('similarResults');
            container.innerHTML = '<div class="pr-empty"><i class="fas fa-spinner fa-spin"></i><p>جارٍ فحص التشابه...</p></div>';

            const modal = new bootstrap.Modal(document.getElementById('similarModal'));
            modal.show();

            fetch(`/Admin/Questions/CheckSimilarQuestions?id=${questionId}`)
                .then(res => res.json())
                .then(data => {
                    container.innerHTML = '';

                    if (!data || data.length === 0) {
                        container.innerHTML = `
                            <div class="alert alert-info text-center fw-bold">
                                لا يوجد أسئلة متشابهة بنسبة 80% أو أكثر.
                            </div>`;
                        return;
                    }

                    data.forEach(q => {
                        const title = $('<div>').text(q.title || '').html();
                        const meta = [q.referenceNumber, q.lesson, q.matchType].filter(Boolean).map(x => $('<div>').text(x).html()).join(' · ');
                        container.innerHTML += `
                            <a href="/Admin/Questions/Details/${q.id}" target="_blank"
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-start gap-2">
                                <span>
                                    <span class="d-block fw-bold">${title}</span>
                                    <small class="text-muted">${meta}</small>
                                </span>
                                <span class="pr-badge pr-badge-unconfirmed">${(q.similarity * 100).toFixed(1)}%</span>
                            </a>`;
                    });
                })
                .catch(() => {
                    container.innerHTML = `
                        <div class="alert alert-danger text-center fw-bold">
                            فشل في تحميل الأسئلة المتشابهة.
                        </div>`;
                });
        }

        function openConfirmDelete(id, title) {
            const modalElement = document.getElementById('confirmDeleteModal');

            if (!modalElement) {
                Swal.fire('خطأ', 'مودال الحذف غير موجود في الصفحة.', 'error');
                return;
            }

            const titleElement = document.getElementById('questionToDeleteTitle');
            if (titleElement) {
                titleElement.textContent = title || 'هذا السؤال';
            }

            const modal = new bootstrap.Modal(modalElement);
            const btn = document.getElementById('confirmDeleteBtn');

            if (!btn) {
                Swal.fire('خطأ', 'زر تأكيد الحذف غير موجود داخل المودال.', 'error');
                return;
            }

            btn.replaceWith(btn.cloneNode(true));

            const btnNew = document.getElementById('confirmDeleteBtn');
            btnNew.onclick = async function () {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const formData = new FormData();
                formData.append('id', id);
                formData.append('__RequestVerificationToken', token);

                try {
                    const response = await fetch('/Admin/Questions/DeleteConfirmed', {
                        method: 'POST',
                        body: formData
                    });

                    const data = await response.json();
                    modal.hide();

                    if (data.success) {
                        selectedQuestionsMap.delete(id);
                        questionsTable.ajax.reload(null, false);
                        updateQuestionsBulkFooter();
                        Swal.fire('تم الحذف', data.message, 'success');
                    } else {
                        Swal.fire('خطأ', data.message, 'error');
                    }
                } catch {
                    modal.hide();
                    Swal.fire('خطأ', 'حدث خطأ أثناء حذف السؤال.', 'error');
                }
            };

            modal.show();
        }

        document.addEventListener('DOMContentLoaded', function () {
            const curriculumSelect = document.getElementById('CurriculumId');
            const sectionSelect = document.getElementById('SectionId');
            const unitSelect = document.getElementById('UnitId');
            const lessonSelect = document.getElementById('LessonId');

            curriculumSelect?.addEventListener('change', async function () {
                const curriculumId = this.value;

                clearQuestionsSelection();

                sectionSelect.innerHTML = `<option value="">تحميل المحاور...</option>`;
                unitSelect.innerHTML = `<option value="">اختر المحور أولًا</option>`;
                lessonSelect.innerHTML = `<option value="">اختر الوحدة أولًا</option>`;

                if (!curriculumId) {
                    sectionSelect.innerHTML = `<option value="">كل المحاور</option>`;
                    unitSelect.innerHTML = `<option value="">كل الوحدات</option>`;
                    lessonSelect.innerHTML = `<option value="">كل المؤشرات</option>`;
                    questionsTable.ajax.reload();
                    return;
                }

                const res = await fetch(`/Admin/Questions/GetSectionsByCurriculum?curriculumId=${curriculumId}`);
                const data = await res.json();

                sectionSelect.innerHTML = `<option value="">كل المحاور</option>`;
                data.forEach(item => {
                    sectionSelect.innerHTML += `<option value="${item.id}">${item.title}</option>`;
                });

                questionsTable.ajax.reload();
            });

            sectionSelect?.addEventListener('change', async function () {
                const sectionId = this.value;

                clearQuestionsSelection();

                unitSelect.innerHTML = `<option value="">تحميل الوحدات...</option>`;
                lessonSelect.innerHTML = `<option value="">اختر الوحدة أولًا</option>`;

                if (!sectionId) {
                    unitSelect.innerHTML = `<option value="">كل الوحدات</option>`;
                    lessonSelect.innerHTML = `<option value="">كل المؤشرات</option>`;
                    questionsTable.ajax.reload();
                    return;
                }

                const res = await fetch(`/Admin/Questions/GetUnitsBySection?sectionId=${sectionId}`);
                const data = await res.json();

                unitSelect.innerHTML = `<option value="">كل الوحدات</option>`;
                data.forEach(item => {
                    unitSelect.innerHTML += `<option value="${item.id}">${item.title}</option>`;
                });

                questionsTable.ajax.reload();
            });

            unitSelect?.addEventListener('change', async function () {
                const unitId = this.value;
                const sectionId = sectionSelect?.value;

                clearQuestionsSelection();

                lessonSelect.innerHTML = `<option value="">تحميل المؤشرات...</option>`;

                if (!unitId || !sectionId) {
                    lessonSelect.innerHTML = `<option value="">كل المؤشرات</option>`;
                    questionsTable.ajax.reload();
                    return;
                }

                const res = await fetch(`/Admin/Questions/GetLessonsByUnit?unitId=${unitId}&sectionId=${sectionId}`);
                const data = await res.json();

                lessonSelect.innerHTML = `<option value="">كل المؤشرات</option>`;
                data.forEach(item => {
                    lessonSelect.innerHTML += `<option value="${item.id}">${item.title}</option>`;
                });

                questionsTable.ajax.reload();
            });

            lessonSelect?.addEventListener('change', function () {
                clearQuestionsSelection();
                questionsTable.ajax.reload();
            });
        });
    </script>
}
