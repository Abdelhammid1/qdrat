                    color: #14532d !important;
                    border: 2px solid #16a34a !important;
                    font-weight: 900 !important;
                }

            #questionPreviewModalBody .badge,
            #questionPreviewModalBody .badge-success,
            #questionPreviewModalBody .bg-success,
            #questionPreviewModalBody .correct-badge {
                background: #16a34a !important;
                color: #ffffff !important;
                border: 1px solid #15803d !important;
                font-weight: 900 !important;
                opacity: 1 !important;
            }

            #questionPreviewModalBody img {
                opacity: 1 !important;
                max-width: 100% !important;
            }

        .swal2-popup {
            font-family: var(--pr-font) !important;
            border-radius: var(--pr-radius) !important;
        }

        @@media (max-width: 1200px) {
            .pr-bulk-footer {
                width: min(980px, calc(100% - 24px));
            }

            .pr-bulk-summary {
                width: 100%;
                margin-left: 0;
                justify-content: center;
            }
        }

        @@media (max-width: 768px) {
            .pr-page {
                padding-bottom: 190px;
            }

            .pr-hero {
                padding: 22px;
            }

            .pr-hero-number {
                font-size: 36px;
            }

            .pr-chips {
                grid-template-columns: repeat(2, 1fr);
            }

            .pr-q-title {
                min-width: 320px;
            }

            .pr-toolbar {
