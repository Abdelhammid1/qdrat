@model QdratNew.ViewModels.Question.QuestionIndexViewModel

<!-- ✅ زر تشغيل المودال -->
<button class="btn btn-warning mb-3" data-bs-toggle="modal" data-bs-target="#pendingReviewModal">
    <i class="fas fa-clipboard-check"></i> مراجعة جماعية للأسئلة الجاهزة
</button>

<!-- ✅ المودال نفسه -->
<div class="modal fade" id="pendingReviewModal" tabindex="-1" aria-labelledby="pendingReviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <form asp-action="ApproveQuestions" method="post">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title" id="pendingReviewModalLabel">
                        <i class="fas fa-eye"></i> مراجعة واعتماد الأسئلة الجاهزة
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    @if (!Model.Questions.Any())
                    {
                        <div class="alert alert-info">لا توجد أسئلة جاهزة حاليًا.</div>
                    }
                    else
                    {
                        <table class="table table-bordered text-center table-sm">
                            <thead class="table-light">
                                <tr>
                                    <th><input type="checkbox" id="selectAllModal" /></th>
                                    <th>#</th>
                                    <th>السؤال</th>
                                    <th>القسم</th>
                                    <th>المحور</th>
                                    <th>المؤشر</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var q in Model.Questions)
                                {
                                    <tr>
                                        <td><input type="checkbox" name="selectedIds" value="@q.Id" class="question-checkbox-modal" /></td>
                                        <td>@q.ReferenceNumber</td>
                                        <td>
                                            <span title="@q.Title">
                                                @Html.Raw(q.IsQuantitative ? QdratNew.Helpers.NumberHelper.ToIndicNumbersSafe(q.TitlePreview) : q.TitlePreview)
                                            </span>
                                        </td>
                                        <td>@q.CurriculumTitle</td>
                                        <td>@q.SectionTitle</td>
                                        <td>@q.LessonTitle</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-check-circle"></i> اعتماد المحدد
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("selectAllModal")?.addEventListener("change", function () {
            const isChecked = this.checked;
            document.querySelectorAll(".question-checkbox-modal").forEach(cb => cb.checked = isChecked);
        });
    </script>
}
