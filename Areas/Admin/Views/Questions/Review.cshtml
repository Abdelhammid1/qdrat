@model QdratNew.ViewModels.Question.QuestionDetailsViewModel
@using QdratNew.Helpers

@{
    ViewData["Title"] = "مراجعة السؤال";
    var labels = new[] { "أ", "ب", "ج", "د" };
}

<style>
    .question-box {
        border: 1px solid #339999;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        margin-top: 20px;
    }

    .question-title-header {
        background-color: rgba(51, 153, 153, 0.1);
        color: #004d4d;
        font-weight: bold;
        font-size: 18px;
        padding: 10px 20px;
        text-align: right;
    }

    .option-cell {
        border: 1px solid #339999;
        padding: 15px 10px;
        text-align: center;
        font-weight: bold;
        font-size: 16px;
        min-height: 70px;
    }

    .correct-option {
        background-color: rgba(40, 167, 69, 0.2) !important;
    }
</style>

<div class="container mt-4" dir="rtl">
    <h3 class="text-primary mb-4"><i class="fas fa-check-double"></i> مراجعة السؤال</h3>

    <form asp-action="Approve" asp-route-id="@Model.Id" method="post">
        <input type="hidden" name="CorrectAnswer" id="CorrectAnswerInput" />

        <!-- ✅ مربع السؤال -->
        <div class="question-box">

            <!-- ✅ عنوان السؤال -->
            <div class="question-title-header">
                @Html.Raw(Model.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(Model.Title) : Model.Title)
            </div>

            <!-- ✅ حالة المراجعة -->
            <div class="p-2">
                @if (!Model.IsAnswerConfirmed)
                {
                    <span class="badge bg-warning text-dark"><i class="fas fa-exclamation-triangle"></i> غير مُراجع</span>
                }
                else
                {
                    <span class="badge bg-success"><i class="fas fa-check-circle"></i> تمت المراجعة</span>
                }
            </div>

            <!-- ✅ جدول الاختيارات -->
            <table class="table text-center" style="border: 1px solid #339999;">
                <tr>
                    @for (int i = 0; i < Model.Options.Count; i++)
                    {
                        var option = Model.Options[i];
                        var isCorrect = option.Text == Model.CorrectAnswer;

                        <td class="fw-bold text-white align-middle"
                            style="background-color:#339999; border: 1px solid #339999; width: 5%;">
                            <label class="w-100 h-100 d-block">@labels[i]</label>
                        </td>

                        <td class="option-cell align-middle @(isCorrect ? "correct-option" : "")"
                            style="border: 1px solid #339999; width: 20%;">
                            <label class="w-100 h-100 d-block">
                                @if (!string.IsNullOrEmpty(option.ImageUrl))
                                {
                                    <img src="@option.ImageUrl" alt="اختيار @(labels[i])" class="img-fluid mb-1" style="max-height: 80px;" />
                                }

                                <div class="fw-bold">
                                    @Html.Raw(Model.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(option.Text ?? "") : option.Text)

                                    <input type="radio"
                                           name="SelectedOption"
                                           value="@option.Text"
                                           class="form-check-input me-1 mt-2"
                                           onclick="document.getElementById('CorrectAnswerInput').value = this.value;"
                                    @(isCorrect ? "checked" : "") />
                                </div>

                                @if (isCorrect)
                                {
                                    <div class="mt-1 small text-success">
                                        <i class="fas fa-check-circle me-1"></i> هذه هي الإجابة الصحيحة
                                    </div>
                                }
                            </label>
                        </td>
                    }
                </tr>
            </table>
        </div>

        <div class="text-center mt-4">
            <button type="submit" class="btn btn-success px-4">
                ✅ اعتماد السؤال
            </button>

            <a asp-action="Reject" asp-route-id="@Model.Id" class="btn btn-outline-danger px-4 ms-3">
                ❌ رفض السؤال
            </a>

            <a asp-action="ReviewQueue" class="btn btn-secondary px-4 ms-2">
                <i class="fas fa-arrow-right"></i> الرجوع لقائمة المراجعة
            </a>
        </div>
    </form>
</div>
