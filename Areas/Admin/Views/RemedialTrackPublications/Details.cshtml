@model QdratNew.ViewModels.RemedialTracks.RemedialTrackPublicationDetailsVm
@using QdratNew.Enums
@inject QdratNew.Services.Interfaces.ITimeZoneService Tz
@functions {
    static string StatusLabel(RemedialTrackPublicationStatus s) => s switch
    {
        RemedialTrackPublicationStatus.Active => "نشط",
        RemedialTrackPublicationStatus.Cancelled => "ملغى",
        _ => "مغلق"
    };
    static string StatusKey(RemedialTrackEnrollmentStatus s) => s switch
    {
        RemedialTrackEnrollmentStatus.NotStarted => "idle",
        RemedialTrackEnrollmentStatus.InProgress => "info",
        RemedialTrackEnrollmentStatus.Completed => "ok",
        RemedialTrackEnrollmentStatus.CompletedWithFailures => "warn",
        _ => "off"
    };
    static string Pct(double? v) => v.HasValue ? v.Value.ToString("0.#") + "%" : "—";
    static string EnrollmentLabel(RemedialTrackEnrollmentStatus s) => s switch
    {
        RemedialTrackEnrollmentStatus.NotStarted => "لم تبدأ",
        RemedialTrackEnrollmentStatus.InProgress => "قيد التنفيذ",
        RemedialTrackEnrollmentStatus.Completed => "مكتملة",
        RemedialTrackEnrollmentStatus.CompletedWithFailures => "مكتملة مع تعثّر",
        _ => "ملغاة"
    };
}
@{
    ViewData["Title"] = "أمر نشر — " + Model.TrackCode;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-rtk.css" asp-append-version="true" />
}

@Html.AntiForgeryToken()

<div class="rtk-page container-fluid mt-4" dir="rtl" id="rtkPubDetails" data-id="@Model.Id">

    <header class="rtk-hero rtk-hero--pro">
        <div class="rtk-hero__top">
            <div class="rtk-hero__main">
                <div class="rtk-hero__label"><i class="fas fa-paper-plane ms-1"></i> أمر نشر · <span class="rtk-code" style="color:#fff">@Model.TrackCode</span></div>
                <h1>@Model.TrackTitle</h1>
                <p><i class="fas fa-book-open ms-1"></i>@Model.CurriculumTitle <span class="rtk-hero__sep">•</span> <i class="fas fa-users ms-1"></i>@Model.BatchName</p>
                <div class="mt-2 d-flex gap-2 flex-wrap">
                    <span class="rtk-badge hero-badge"><i class="fas fa-circle-dot ms-1"></i>@StatusLabel(Model.Status)</span>
                    <span class="rtk-badge hero-badge"><i class="fas @(Model.IsInPerson ? "fa-chalkboard-user" : "fa-laptop") ms-1"></i>@(Model.IsInPerson ? "حضوري" : "أونلاين")</span>
                    <span class="rtk-badge hero-badge"><i class="fas fa-bullseye ms-1"></i>@(Model.Scope == RemedialTrackPublicationScope.WholeBatch ? "الدفعة كاملة" : "طلاب محددون")</span>
                </div>
            </div>
            <div class="rtk-hero__actions">
                <a class="rtk-btn rtk-btn--light" asp-area="Admin" asp-controller="RemedialTrackPublications" asp-action="Index">
                    <i class="fas fa-arrow-right"></i> أوامر النشر
                </a>
                @if (Model.CanCancel && Model.IsActive)
                {
                    <button type="button" class="rtk-btn rtk-btn--light" data-rtk-act="cancel-open">
                        <i class="fas fa-ban"></i> إلغاء أمر النشر
                    </button>
                }
                @if (Model.CanDelete && !Model.IsDeleted)
                {
                    <button type="button" class="rtk-btn rtk-btn--light" data-rtk-act="delete-open">
                        <i class="fas fa-trash-can"></i> حذف أمر النشر
                    </button>
                }
                @if (Model.CanRestore && Model.IsDeleted)
                {
                    <button type="button" class="rtk-btn rtk-btn--light" data-rtk-act="restore">
                        <i class="fas fa-rotate-left"></i> استرجاع أمر النشر
                    </button>
                }
            </div>
        </div>
        <dl class="rtk-meta">
            <div class="rtk-meta__item"><i class="fas fa-clock"></i><div><dt>وقت النشر</dt><dd>@Tz.ConvertToSaudi(Model.PublishAtUtc).ToString("yyyy-MM-dd HH:mm")</dd></div></div>
            <div class="rtk-meta__item"><i class="fas fa-calendar-plus"></i><div><dt>أُنشئ بتاريخ</dt><dd>@Tz.ConvertToSaudi(Model.CreatedAtUtc).ToString("yyyy-MM-dd HH:mm")</dd></div></div>
            <div class="rtk-meta__item"><i class="fas fa-user-pen"></i><div><dt>أنشأه</dt><dd>@(Model.CreatedByName ?? "—")</dd></div></div>
            <div class="rtk-meta__item"><i class="fas fa-user-graduate"></i><div><dt>عدد الطلاب</dt><dd>@Model.TotalStudents</dd></div></div>
        </dl>
        @if (!string.IsNullOrWhiteSpace(Model.AdminNote))
        {
            <div class="rtk-hero__note"><i class="fas fa-note-sticky ms-1"></i> @Model.AdminNote</div>
        }
    </header>

    @if (Model.IsDeleted)
    {
        <div class="rtk-alert rtk-alert--warn" role="status">
            أمر النشر محذوف (حذف ناعم) ومخفي عن الطلاب@(Model.DeletedAtUtc.HasValue ? " منذ " + Tz.ConvertToSaudi(Model.DeletedAtUtc.Value).ToString("yyyy-MM-dd HH:mm") : "")
            @if (!string.IsNullOrWhiteSpace(Model.DeletedByName)) { <text>بواسطة @Model.DeletedByName</text> }
            @if (!string.IsNullOrWhiteSpace(Model.DeleteReason)) { <text>— السبب: @Model.DeleteReason</text> }
        </div>
    }

    @if (Model.Status == RemedialTrackPublicationStatus.Cancelled)
    {
        <div class="rtk-alert rtk-alert--warn" role="status">
            أُلغي أمر النشر @(Model.CancelledAtUtc.HasValue ? "بتاريخ " + Tz.ConvertToSaudi(Model.CancelledAtUtc.Value).ToString("yyyy-MM-dd HH:mm") : "")
            @if (!string.IsNullOrWhiteSpace(Model.CancelReason)) { <text>— السبب: @Model.CancelReason</text> }
        </div>
    }

    @if (Model.IsInPerson && Model.CanManageCode)
    {
        <section class="rtk-panel" aria-label="الرقم المرجعي">
            <h2>الرقم المرجعي (حضوري)</h2>
            @if (Model.IsActive && !string.IsNullOrEmpty(Model.AccessCode))
            {
                <div class="rtk-codebox" id="rtkCodeBox">
                    <span id="rtkCodeValue" dir="ltr">@Model.AccessCode</span>
                </div>
                <div class="rtk-hint">
                    النسخة @Model.CodeVersion
                    @if (Model.CodeGeneratedAtUtc.HasValue) { <text>· وُلِّد @Tz.ConvertToSaudi(Model.CodeGeneratedAtUtc.Value).ToString("yyyy-MM-dd HH:mm")</text> }
                </div>
                <div class="rtk-form-actions">
                    <button type="button" class="rtk-btn rtk-btn--outline" data-rtk-act="regen">
                        <i class="fas fa-rotate"></i> تجديد الرقم
                    </button>
                </div>
                <div class="rtk-hint">لا يُرسَل الرقم في الإشعارات؛ سلّمه للطلاب حضوريًا.</div>
            }
            else
            {
                <div class="rtk-empty">الرقم المرجعي غير متاح (الأمر غير نشط).</div>
            }
        </section>
    }

    <section class="rtk-panel" id="rtkRecentChanges" aria-label="آخر التعديلات">
        <h2><i class="fas fa-clock-rotate-left ms-1"></i> آخر التعديلات <span class="rtk-count">@Model.RecentChanges.Count</span></h2>
        @if (Model.RecentChanges.Count == 0)
        {
            <div class="rtk-empty"><i class="fas fa-clock-rotate-left"></i> لا توجد تعديلات مسجَّلة على هذا الأمر بعد.</div>
        }
        else
        {
            <div class="rtk-table-wrap">
                <table class="rtk-table rtk-table--zebra">
                    <thead><tr><th>الإجراء</th><th>التفاصيل</th><th>المنفّذ</th><th>الوقت</th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.RecentChanges)
                        {
                            <tr>
                                <td><span class="rtk-badge">@c.ActionLabel</span></td>
                                <td>@c.Description</td>
                                <td>@c.AdminName</td>
                                <td>@Tz.ConvertToSaudi(c.Timestamp).ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (Model.Dashboard is { } dash)
    {
        var k = dash.Kpis;
        var chartData = new
        {
            status = new[] { k.NotStarted, k.InProgress, k.Completed, k.CompletedWithFailures, k.Cancelled },
            axes = dash.AxisChart.Select(r => new { title = r.Order + ". " + r.Title, first = r.PassedFirstTime, rewatch = r.PassedAfterRewatch, notPassed = r.NotPassed })
        };

        <section class="rtk-panel" aria-label="مؤشرات المتابعة">
            <h2>متابعة الطلاب</h2>
            @{
                var f = dash.Filter;
                var noFilter = f.Status is null && !f.BlockedOnly && string.IsNullOrEmpty(f.Q);
            }
            <p class="rtk-hint mb-2">اضغط على أي بطاقة لعرض أسماء الطلاب في هذه الحالة بالجدول أدناه.</p>
            <div class="rtk-kpis">
                <a class="rtk-kpi rtk-kpi--total @(noFilter ? "is-active" : "")" asp-action="Details" asp-route-id="@Model.Id" asp-fragment="rtkStudents"><i class="fas fa-users"></i><span>@k.Total</span>إجمالي الطلاب</a>
                <a class="rtk-kpi rtk-kpi--idle @(f.Status == RemedialTrackEnrollmentStatus.NotStarted && !f.BlockedOnly ? "is-active" : "")" asp-action="Details" asp-route-id="@Model.Id" asp-route-status="@((int)RemedialTrackEnrollmentStatus.NotStarted)" asp-fragment="rtkStudents"><i class="fas fa-hourglass-start"></i><span>@k.NotStarted</span>لم يبدأ</a>
                <a class="rtk-kpi rtk-kpi--info @(f.Status == RemedialTrackEnrollmentStatus.InProgress && !f.BlockedOnly ? "is-active" : "")" asp-action="Details" asp-route-id="@Model.Id" asp-route-status="@((int)RemedialTrackEnrollmentStatus.InProgress)" asp-fragment="rtkStudents"><i class="fas fa-spinner"></i><span>@k.InProgress</span>قيد التنفيذ</a>
                <a class="rtk-kpi rtk-kpi--ok @(f.Status == RemedialTrackEnrollmentStatus.Completed && !f.BlockedOnly ? "is-active" : "")" asp-action="Details" asp-route-id="@Model.Id" asp-route-status="@((int)RemedialTrackEnrollmentStatus.Completed)" asp-fragment="rtkStudents"><i class="fas fa-circle-check"></i><span>@k.Completed</span>مكتمل</a>
                <a class="rtk-kpi rtk-kpi--warn @(f.Status == RemedialTrackEnrollmentStatus.CompletedWithFailures && !f.BlockedOnly ? "is-active" : "")" asp-action="Details" asp-route-id="@Model.Id" asp-route-status="@((int)RemedialTrackEnrollmentStatus.CompletedWithFailures)" asp-fragment="rtkStudents"><i class="fas fa-triangle-exclamation"></i><span>@k.CompletedWithFailures</span>مكتمل مع تعثّر</a>
                <a class="rtk-kpi rtk-kpi--danger @(k.BlockedAwaitingAdmin > 0 ? "rtk-kpi--alert" : "") @(f.BlockedOnly ? "is-active" : "")" asp-action="Details" asp-route-id="@Model.Id" asp-route-blockedOnly="true" asp-fragment="rtkStudents"><i class="fas fa-lock"></i><span>@k.BlockedAwaitingAdmin</span>محجوب بانتظار الإدارة</a>
            </div>
        </section>

        @if (k.Total > 0)
        {
            <section class="rtk-panel" aria-label="الرسوم البيانية">
                <div class="rtk-charts" id="rtkCharts" data-chart="@System.Text.Json.JsonSerializer.Serialize(chartData)">
                    <div class="rtk-chart-box"><h3>توزيع حالات التسجيل</h3><div class="rtk-chart-canvas"><canvas id="rtkStatusChart" role="img" aria-label="دونات توزيع حالات التسجيل"></canvas></div></div>
                    <div class="rtk-chart-box"><h3>نتائج المحاور</h3><div class="rtk-chart-canvas"><canvas id="rtkAxisChart" role="img" aria-label="أعمدة نتائج كل محور"></canvas></div></div>
                </div>
                <div class="rtk-hint" id="rtkChartFallback" hidden>تعذّر تحميل الرسوم البيانية؛ الأرقام متاحة في المؤشرات والجدول.</div>
            </section>
        }

        <section class="rtk-panel" aria-label="جدول الطلاب" id="rtkStudents">
            <h2>الطلاب <span class="rtk-count">@dash.Total</span>
                @if (dash.Filter.Status.HasValue || dash.Filter.BlockedOnly || !string.IsNullOrEmpty(dash.Filter.Q))
                {
                    <span class="rtk-chip-filter"><i class="fas fa-filter"></i> تصفية مفعّلة</span>
                }
            </h2>
            <form method="get" class="rtk-filters">
                <div class="rtk-field">
                    <label for="rtkFilterQ">بحث بالاسم</label>
                    <input id="rtkFilterQ" type="search" name="q" value="@dash.Filter.Q" maxlength="@QdratNew.ViewModels.RemedialTracks.RemedialTrackDashboardFilter.MaxSearchLength" />
                </div>
                <div class="rtk-field">
                    <label for="rtkFilterStatus">الحالة</label>
                    <select id="rtkFilterStatus" name="status">
                        <option value="">الكل</option>
                        @foreach (var st in new[] { RemedialTrackEnrollmentStatus.NotStarted, RemedialTrackEnrollmentStatus.InProgress, RemedialTrackEnrollmentStatus.Completed, RemedialTrackEnrollmentStatus.CompletedWithFailures, RemedialTrackEnrollmentStatus.Cancelled })
                        {
                            <option value="@((int)st)" selected="@(dash.Filter.Status == st)">@EnrollmentLabel(st)</option>
                        }
                    </select>
                </div>
                <label class="rtk-choice__item"><input type="checkbox" name="blockedOnly" value="true" checked="@dash.Filter.BlockedOnly" /> المحجوبون فقط</label>
                <button type="submit" class="rtk-btn rtk-btn--outline"><i class="fas fa-filter"></i> تصفية</button>
                <a class="rtk-btn rtk-btn--outline" asp-action="Details" asp-route-id="@Model.Id">مسح</a>
                @if (dash.CanReadReports)
                {
                    <a class="rtk-btn rtk-btn--outline" asp-area="Admin" asp-controller="RemedialTrackReports" asp-action="Batch" asp-route-publicationId="@Model.Id" target="_blank" rel="noopener">
                        <i class="fas fa-print"></i> تقرير الدفعة
                    </a>
                }
            </form>

            @if (dash.Students.Count == 0)
            {
                <div class="rtk-empty"><i class="fas fa-users"></i> @(dash.Total == 0 && dash.Filter.Q is null && dash.Filter.Status is null && !dash.Filter.BlockedOnly ? "لا يوجد طلاب مسجَّلون في هذا الأمر." : "لا توجد نتائج مطابقة للتصفية.")</div>
            }
            else
            {
                <div class="rtk-table-wrap">
                    <table class="rtk-table rtk-table--zebra">
                        <thead><tr><th>الطالب</th><th>الحالة</th><th>المحور الحالي</th><th>آخر نتيجة</th><th>آخر نشاط</th><th>إجراءات</th></tr></thead>
                        <tbody>
                            @foreach (var s in dash.Students)
                            {
                                <tr class="rtk-row rtk-row--@StatusKey(s.Status) @(s.IsBlocked ? "rtk-row--blocked" : "")">
                                    <td class="rtk-name">@s.StudentName</td>
                                    <td><span class="rtk-pill rtk-pill--@StatusKey(s.Status)">@EnrollmentLabel(s.Status)</span>@if (s.IsBlocked) { <text> </text><span class="rtk-badge rtk-badge--lock"><i class="fas fa-lock"></i> محجوب</span> }</td>
                                    <td>@(s.CurrentAxisTitle is null ? "—" : $"{s.CurrentAxisOrder}. {s.CurrentAxisTitle} (الجولة {s.CurrentRound})")</td>
                                    <td>@(s.LastScorePercent.HasValue && s.LastExamNumber.HasValue ? $"{s.LastScorePercent.Value:0.#}% ({s.LastExamNumber.Value.DisplayName()})" : "—")</td>
                                    <td>@(s.LastActivityUtc.HasValue ? Tz.ConvertToSaudi(s.LastActivityUtc.Value).ToString("yyyy-MM-dd HH:mm") : "—")</td>
                                    <td>
                                        <div class="d-flex gap-1 flex-wrap">
                                            @if (dash.CanReadReports)
                                            {
                                                <a class="rtk-btn rtk-btn--sm rtk-btn--outline" asp-area="Admin" asp-controller="RemedialTrackReports" asp-action="Student" asp-route-enrollmentId="@s.EnrollmentId" target="_blank" rel="noopener">تقرير ولي الأمر</a>
                                            }
                                            @if (dash.CanUnlock && s.IsBlocked && Model.IsActive)
                                            {
                                                <button type="button" class="rtk-btn rtk-btn--sm rtk-btn--danger" data-rtk-act="unlock-open"
                                                        data-enrollment="@s.EnrollmentId" data-axis="@s.BlockedAxisProgressId"
                                                        data-student="@s.StudentName" data-title="@s.BlockedAxisTitle">فتح المحور التالي</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (dash.TotalPages > 1)
                {
                    <nav class="rtk-pager" aria-label="الصفحات">
                        @for (var pg = 1; pg <= dash.TotalPages; pg++)
                        {
                            if (pg == dash.Page) { <span class="is-current" aria-current="page">@pg</span> }
                            else
                            {
                                <a asp-action="Details" asp-route-id="@Model.Id" asp-route-page="@pg" asp-route-q="@dash.Filter.Q"
                                   asp-route-status="@(dash.Filter.Status.HasValue ? (int?)dash.Filter.Status.Value : null)"
                                   asp-route-blockedOnly="@(dash.Filter.BlockedOnly ? "true" : null)">@pg</a>
                            }
                        }
                    </nav>
                }
            }
        </section>

        <section class="rtk-panel rtk-np" id="rtkNotPassed" aria-label="من لم يجتز">
            <div class="rtk-np__head">
                <h2>من لم يجتز محورًا — قرار الإدارة <span class="rtk-count">@dash.NotPassed.Count</span></h2>
                @if (dash.NotPassed.Count > 0)
                {
                    <button type="button" class="rtk-btn rtk-btn--outline rtk-noprint" data-rtk-act="print-np"><i class="fas fa-print"></i> طباعة الجدول</button>
                }
            </div>
            <div class="rtk-print-only rtk-np__printhead">
                <strong>@Model.TrackTitle</strong> — @Model.CurriculumTitle · @Model.BatchName<br />
                <span>الطلاب الذين لم يجتازوا الخطة العلاجية — طُبع في @Tz.ConvertToSaudi(DateTime.UtcNow).ToString("yyyy-MM-dd HH:mm")</span>
            </div>
            @if (dash.NotPassed.Count == 0)
            {
                <div class="rtk-empty"><i class="fas fa-circle-check"></i> لا يوجد طلاب لم يجتازوا أي محور.</div>
            }
            else
            {
                <div class="rtk-table-wrap">
                    <table class="rtk-table rtk-table--zebra rtk-table--np">
                        <thead><tr>
                            <th>#</th><th>الطالب</th><th>المحور</th><th>الجولة</th><th>الاختبار الأول</th><th>الاختبار الثاني</th>
                            <th>المحاولات</th><th>وقت التعثّر</th><th>ما تم في الجلسة</th><th class="rtk-noprint">إجراء</th>
                        </tr></thead>
                        <tbody>
                            @{ var rowNo = 0; }
                            @foreach (var n in dash.NotPassed)
                            {
                                rowNo++;
                                <tr class="rtk-row @(n.Status == RemedialTrackAxisStatus.FailedBlocked ? "rtk-row--blocked" : "rtk-row--moved")">
                                    <td>@rowNo</td>
                                    <td class="rtk-name">@n.StudentName</td>
                                    <td>@n.AxisOrder. @n.AxisTitle</td>
                                    <td>@n.Round</td>
                                    <td>@Pct(n.Exam101Percent)</td>
                                    <td>@Pct(n.Exam102Percent)</td>
                                    <td>@n.AttemptsCount</td>
                                    <td>@(n.FailedAtUtc.HasValue ? Tz.ConvertToSaudi(n.FailedAtUtc.Value).ToString("yyyy-MM-dd HH:mm") : "—")</td>
                                    <td class="rtk-np__details">
                                        @if (n.Status == RemedialTrackAxisStatus.FailedOpenedByAdmin)
                                        {
                                            <span class="rtk-badge">نُقل بقرار الإدارة</span>
                                            <div class="rtk-hint">
                                                @(n.AdminOpenedByName ?? "—")@(n.AdminOpenedAtUtc.HasValue ? " · " + Tz.ConvertToSaudi(n.AdminOpenedAtUtc.Value).ToString("yyyy-MM-dd HH:mm") : "")
                                                @if (!string.IsNullOrWhiteSpace(n.AdminOpenReason)) { <text><br />السبب: @n.AdminOpenReason</text> }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="rtk-badge rtk-badge--lock">بانتظار الإدارة</span>
                                            <div class="rtk-hint">لم يجتز الاختبارين ولم يُفتح له المحور التالي بعد.</div>
                                        }
                                    </td>
                                    <td class="rtk-noprint">
                                        <div class="d-flex gap-1 flex-wrap">
                                            @if (dash.CanUnlock && n.CanUnlockNext && Model.IsActive)
                                            {
                                                <button type="button" class="rtk-btn rtk-btn--sm" data-rtk-act="unlock-open"
                                                        data-enrollment="@n.EnrollmentId" data-axis="@n.AxisProgressId"
                                                        data-student="@n.StudentName" data-title="@n.AxisTitle"><i class="fas fa-lock-open"></i> تمرير للمحور التالي</button>
                                            }
                                            @if (dash.CanReadReports)
                                            {
                                                <a class="rtk-btn rtk-btn--sm rtk-btn--outline" asp-area="Admin" asp-controller="RemedialTrackReports" asp-action="Student" asp-route-enrollmentId="@n.EnrollmentId" target="_blank" rel="noopener">التقرير</a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (dash.NotPassedTruncated)
                {
                    <div class="rtk-hint mt-2">عُرض أول @QdratNew.ViewModels.RemedialTracks.RemedialTrackDashboardVm.MaxNotPassedListed صفًّا فقط.</div>
                }
            }
        </section>

        @if (dash.CanUnlock && Model.IsActive)
        {
            <section class="rtk-panel" id="rtkUnlockBox" hidden aria-label="فتح المحور التالي">
                <h2>فتح المحور التالي</h2>
                <p class="rtk-alert rtk-alert--warn" id="rtkUnlockWarn"></p>
                <div class="rtk-field">
                    <label for="rtkUnlockReason">السبب (إلزامي، 10–300 حرف)</label>
                    <textarea id="rtkUnlockReason" maxlength="300"></textarea>
                </div>
                <div class="rtk-form-actions">
                    <button type="button" class="rtk-btn rtk-btn--danger" data-rtk-act="unlock-confirm"><i class="fas fa-lock-open"></i> تأكيد الفتح</button>
                    <button type="button" class="rtk-btn rtk-btn--outline" data-rtk-act="unlock-close">تراجع</button>
                </div>
            </section>
        }
    }
    else
    {
    <section class="rtk-panel" aria-label="الطلاب">
        <h2>الطلاب</h2>
        @if (Model.StatusCounts.Count > 0)
        {
            <div class="d-flex gap-2 flex-wrap mb-3">
                @foreach (var c in Model.StatusCounts.OrderBy(c => c.Status))
                {
                    <span class="rtk-badge">@EnrollmentLabel(c.Status): @c.Count</span>
                }
            </div>
        }
        @if (Model.Students.Count == 0)
        {
            <div class="rtk-empty"><i class="fas fa-users"></i> لا يوجد طلاب مسجَّلون في هذا الأمر.</div>
        }
        else
        {
            <div class="rtk-table-wrap">
                <table class="rtk-table">
                    <thead><tr><th>الطالب</th><th>الحالة</th></tr></thead>
                    <tbody>
                        @foreach (var s in Model.Students)
                        {
                            <tr><td>@s.StudentName</td><td>@EnrollmentLabel(s.Status)</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.StudentsTruncated)
            {
                <div class="rtk-hint mt-2">عُرض أول @QdratNew.ViewModels.RemedialTracks.RemedialTrackPublicationDetailsVm.MaxStudentsListed طالب فقط.</div>
            }
        }
    </section>
    }

    @if (Model.CanCancel && Model.IsActive)
    {
        <section class="rtk-panel" id="rtkCancelBox" hidden>
            <h2>إلغاء أمر النشر</h2>
            <p class="rtk-hint">سيتوقف تقدّم الطلاب غير المنتهين ويُحرَّر الرقم المرجعي. لا يُحذف أي سجل.</p>
            <div class="rtk-field">
                <label for="rtkCancelReason">سبب الإلغاء (5–300 حرف)</label>
                <textarea id="rtkCancelReason" maxlength="300"></textarea>
            </div>
            <div class="rtk-form-actions">
                <button type="button" class="rtk-btn rtk-btn--danger" data-rtk-act="cancel-confirm"><i class="fas fa-ban"></i> تأكيد الإلغاء</button>
                <button type="button" class="rtk-btn rtk-btn--outline" data-rtk-act="cancel-close">تراجع</button>
            </div>
        </section>
    }

    @if (Model.CanDelete && !Model.IsDeleted)
    {
        <section class="rtk-panel" id="rtkDeleteBox" hidden>
            <h2>حذف أمر النشر</h2>
            <p class="rtk-hint">سيختفي الأمر عن الطلاب وتبقى بياناته ويمكن استرجاعه من تبويب «المحذوفة». هذا القرار يُسجَّل باسمك.</p>
            <div class="rtk-field">
                <label for="rtkDeleteReason">سبب الحذف (5–300 حرف)</label>
                <textarea id="rtkDeleteReason" maxlength="300"></textarea>
            </div>
            <div class="rtk-form-actions">
                <button type="button" class="rtk-btn rtk-btn--danger" data-rtk-act="delete-confirm"><i class="fas fa-trash-can"></i> تأكيد الحذف</button>
                <button type="button" class="rtk-btn rtk-btn--outline" data-rtk-act="delete-close">تراجع</button>
            </div>
        </section>
    }

    <div class="rtk-toast" id="rtkToast" role="status" aria-live="polite"></div>
</div>

@section Scripts {
    @if (Model.Dashboard is { Kpis.Total: > 0 })
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
        <script>
        (function () {
            'use strict';
            var host = document.getElementById('rtkCharts');
            if (!host || host.dataset.bound === '1') return;
            host.dataset.bound = '1';
            if (typeof Chart === 'undefined') { var fb = document.getElementById('rtkChartFallback'); if (fb) fb.hidden = false; return; }
            var data = JSON.parse(host.getAttribute('data-chart'));
            var css = getComputedStyle(document.getElementById('rtkPubDetails'));
            function v(n) { return css.getPropertyValue(n).trim(); }
            var brand = v('--rtk-brand'), ok = v('--rtk-ok'), warn = v('--rtk-warn'), danger = v('--rtk-danger'), muted = v('--rtk-muted');
            new Chart(document.getElementById('rtkStatusChart'), {
                type: 'doughnut',
                data: { labels: ['لم تبدأ', 'قيد التنفيذ', 'مكتملة', 'مكتملة مع تعثّر', 'ملغاة'],
                        datasets: [{ data: data.status, backgroundColor: [muted, brand, ok, warn, danger], borderWidth: 1 }] },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
            });
            new Chart(document.getElementById('rtkAxisChart'), {
                type: 'bar',
                data: { labels: data.axes.map(function (a) { return a.title; }),
                        datasets: [
                            { label: 'اجتاز من أول مرة (الاختبار الأول)', data: data.axes.map(function (a) { return a.first; }), backgroundColor: ok },
                            { label: 'اجتاز بعد إعادة (الاختبار الثاني)', data: data.axes.map(function (a) { return a.rewatch; }), backgroundColor: brand },
                            { label: 'لم يجتز', data: data.axes.map(function (a) { return a.notPassed; }), backgroundColor: danger }
                        ] },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } },
                           scales: { x: { stacked: true }, y: { stacked: true, beginAtZero: true, ticks: { precision: 0 } } } }
            });
        })();
        </script>
    }
    <script>
    (function () {
        'use strict';
        var root = document.getElementById('rtkPubDetails');
        if (!root || root.dataset.bound === '1') return;   // منع تكرار الربط
        root.dataset.bound = '1';

        var id = root.getAttribute('data-id');
        var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        var urls = {
            regen: '@Url.Action("RegenerateCode", "RemedialTrackPublications", new { area = "Admin" })',
            cancel: '@Url.Action("Cancel", "RemedialTrackPublications", new { area = "Admin" })',
            del: '@Url.Action("Delete", "RemedialTrackPublications", new { area = "Admin" })',
            restore: '@Url.Action("Restore", "RemedialTrackPublications", new { area = "Admin" })',
            unlock: '@Url.Action("Unlock", "RemedialTrackPublications", new { area = "Admin" })'
        };
        var unlockTarget = null;
        var toast = document.getElementById('rtkToast');
        var busy = false;

        function esc(t) { var d = document.createElement('div'); d.textContent = t == null ? '' : String(t); return d.innerHTML; }
        function showToast(msg, ok) {
            toast.innerHTML = '<div class="rtk-alert ' + (ok ? 'rtk-alert--ok' : 'rtk-alert--error') + '">' + esc(msg) + '</div>';
            clearTimeout(showToast._t);
            showToast._t = setTimeout(function () { toast.innerHTML = ''; }, ok ? 3000 : 7000);
        }

        function post(url, fd, btn, onOk) {
            if (busy) return;
            busy = true; btn.disabled = true; btn.classList.add('is-busy');
            fd.set('__RequestVerificationToken', token);
            if (!fd.has('id')) fd.set('id', id);
            fetch(url, { method: 'POST', body: fd, credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
                .then(function (res) {
                    if (!res.success) { showToast(res.message || 'تعذّر تنفيذ العملية.', false); return; }
                    showToast(res.message || 'تم.', true);
                    onOk(res);
                })
                .catch(function () { showToast('تعذّر الاتصال بالخادم. تحقق من الشبكة وأعد المحاولة.', false); })
                .finally(function () { busy = false; btn.disabled = false; btn.classList.remove('is-busy'); });
        }

        root.addEventListener('click', function (e) {
            var btn = e.target.closest('[data-rtk-act]');
            if (!btn || !root.contains(btn)) return;
            var act = btn.getAttribute('data-rtk-act');
            var cancelBox = document.getElementById('rtkCancelBox');

            if (act === 'regen') {
                if (!window.confirm('سيُطلب من الطلاب إدخال الرقم الجديد عند فتح محور أو فيديو أو بدء اختبار. هل تريد تجديد الرقم؟')) return;
                post(urls.regen, new FormData(), btn, function (res) {
                    var v = document.getElementById('rtkCodeValue');
                    if (v && res.data) v.textContent = res.data;
                    setTimeout(function () { window.location.reload(); }, 900);
                });
            } else if (act === 'print-np') {
                root.classList.add('rtk-printing-np');
                window.addEventListener('afterprint', function () { root.classList.remove('rtk-printing-np'); }, { once: true });
                window.print();
            } else if (act === 'unlock-open') {
                var box = document.getElementById('rtkUnlockBox');
                if (!box) return;
                unlockTarget = { enrollment: btn.getAttribute('data-enrollment'), axis: btn.getAttribute('data-axis') };
                document.getElementById('rtkUnlockWarn').textContent = 'سيُسجَّل على الطالب «' + btn.getAttribute('data-student') +
                    '» أنه لم يجتز المحور «' + btn.getAttribute('data-title') + '» وسيُفتح له المحور التالي. هذا القرار يُسجَّل باسمك.';
                document.getElementById('rtkUnlockReason').value = '';
                box.hidden = false; box.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } else if (act === 'unlock-close') {
                var ub = document.getElementById('rtkUnlockBox'); if (ub) ub.hidden = true; unlockTarget = null;
            } else if (act === 'unlock-confirm') {
                if (!unlockTarget) return;
                var why = document.getElementById('rtkUnlockReason').value.trim();
                if (why.length < 10 || why.length > 300) { showToast('⚠️ السبب إلزامي (10–300 حرف).', false); return; }
                var ufd = new FormData();
                ufd.set('enrollmentId', unlockTarget.enrollment); ufd.set('axisProgressId', unlockTarget.axis); ufd.set('reason', why);
                post(urls.unlock, ufd, btn, function () { setTimeout(function () { window.location.reload(); }, 900); });
            } else if (act === 'cancel-open') {
                if (cancelBox) { cancelBox.hidden = false; cancelBox.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
            } else if (act === 'cancel-close') {
                if (cancelBox) cancelBox.hidden = true;
            } else if (act === 'delete-open') {
                var delBox = document.getElementById('rtkDeleteBox');
                if (delBox) { delBox.hidden = false; delBox.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
            } else if (act === 'delete-close') {
                var delBox2 = document.getElementById('rtkDeleteBox'); if (delBox2) delBox2.hidden = true;
            } else if (act === 'delete-confirm') {
                var delReason = document.getElementById('rtkDeleteReason').value.trim();
                if (delReason.length < 5 || delReason.length > 300) { showToast('⚠️ سبب الحذف إلزامي (5–300 حرف).', false); return; }
                var dfd = new FormData(); dfd.set('reason', delReason);
                post(urls.del, dfd, btn, function () { setTimeout(function () { window.location.href = '@Url.Action("Index", "RemedialTrackPublications", new { area = "Admin" })'; }, 900); });
            } else if (act === 'restore') {
                if (!window.confirm('سيعود أمر النشر ظاهرًا للطلاب بتقدّمهم كما كان. هل تريد الاسترجاع؟')) return;
                post(urls.restore, new FormData(), btn, function () { setTimeout(function () { window.location.reload(); }, 900); });
            } else if (act === 'cancel-confirm') {
                var reason = document.getElementById('rtkCancelReason').value.trim();
                if (reason.length < 5 || reason.length > 300) { showToast('⚠️ سبب الإلغاء إلزامي (5–300 حرف).', false); return; }
                var fd = new FormData(); fd.set('reason', reason);
                post(urls.cancel, fd, btn, function () { setTimeout(function () { window.location.reload(); }, 900); });
            }
        });
    })();
    </script>
}
