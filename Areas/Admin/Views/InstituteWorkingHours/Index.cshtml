@model List<QdratNew.ViewModels.Instructor.InstituteWorkingHoursViewModel>
@using QdratNew.Helpers
@{
    ViewData["Title"] = "🕒 أوقات العمل الرسمية";
}
@* @functions {
    public static string FormatTimeArabic(TimeSpan time)
    {
        var dateTime = DateTime.Today.Add(time);
        var formatted = dateTime.ToString("hh:mm tt", new System.Globalization.CultureInfo("en-US"));
        return formatted.Replace("AM", "ص").Replace("PM", "م");
    }
} *@

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold"><i class="fas fa-business-time"></i> إدارة أوقات العمل الرسمية</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus-circle"></i> إضافة وقت عمل جديد
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <table class="table table-bordered table-striped table-hover text-center shadow-sm" id="workingHoursTable">
            <thead class="table-dark">
                <tr>
                    <th>📅 اليوم</th>
                    <th>🕘 وقت البدء</th>
                    <th>🕔 وقت الانتهاء</th>
                    <th>☕ بداية الراحة</th>
                    <th>☕ نهاية الراحة</th>
                    <th>⚙️ الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@DayNameHelper.GetArabicDay(item.DayOfWeek)</td>

                        <td>@TimeHelper.FormatTimeWithAmPm(item.StartTime)</td>
                        <td>@TimeHelper.FormatTimeWithAmPm(item.EndTime)</td>
                        <td>@(item.BreakStart.HasValue ? TimeHelper.FormatTimeWithAmPm(item.BreakStart.Value) : "—")</td>
                        <td>@(item.BreakEnd.HasValue ? TimeHelper.FormatTimeWithAmPm(item.BreakEnd.Value) : "—")</td>


                        <td>
                            <div class="d-flex justify-content-center gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark" title="تعديل">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark" title="تفاصيل">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark" title="حذف">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-warning text-center shadow-sm">
            <i class="fas fa-exclamation-circle"></i> لا توجد أوقات عمل مسجلة حالياً.
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#workingHoursTable').DataTable({
                language: {
                    "decimal": "",
                    "emptyTable": "لا توجد بيانات متاحة",
                    "info": "عرض _START_ إلى _END_ من أصل _TOTAL_ يوم",
                    "infoEmpty": "عرض 0 إلى 0 من 0 يوم",
                    "infoFiltered": "(تمت التصفية من إجمالي _MAX_ يوم)",
                    "lengthMenu": "عرض _MENU_ أيام",
                    "loadingRecords": "جارٍ التحميل...",
                    "processing": "جارٍ المعالجة...",
                    "search": "🔍 بحث:",
                    "zeroRecords": "لا توجد نتائج مطابقة",
                    "paginate": {
                        "first": "الأول",
                        "last": "الأخير",
                        "next": "التالي",
                        "previous": "السابق"
                    },
                    "buttons": {
                        "copy": "📋 نسخ",
                        "excel": "📊 Excel",
                        "print": "🖨️ طباعة"
                    }
                },
                dom: 'Bfrtip',
                buttons: [
                    { extend: 'copy', text: '<i class="fas fa-copy"></i> نسخ', className: 'btn btn-secondary' },
                    { extend: 'excel', text: '<i class="fas fa-file-excel"></i> Excel', className: 'btn btn-success' },
                    { extend: 'print', text: '<i class="fas fa-print"></i> طباعة', className: 'btn btn-primary' }
                ],
                responsive: true
            });
        });
    </script>
}
