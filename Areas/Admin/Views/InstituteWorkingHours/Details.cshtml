@model QdratNew.ViewModels.Instructor.InstituteWorkingHoursViewModel
@{
    ViewData["Title"] = "تفاصيل وقت العمل";
}

<div class="container mt-4">
    <h2 class="text-primary mb-4"><i class="fas fa-info-circle"></i> تفاصيل وقت العمل</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">📅 اليوم</dt>
                <dd class="col-sm-8">@QdratNew.Helpers.DayNameHelper.GetArabicDay(Model.DayOfWeek)</dd>

                <dt class="col-sm-4">🕘 وقت البدء</dt>
                <dd class="col-sm-8">@Model.StartTime.ToString(@"hh\:mm") @(Model.StartTime.Hours < 12 ? "صباحًا" : "مساءً")</dd>

                <dt class="col-sm-4">🕔 وقت الانتهاء</dt>
                <dd class="col-sm-8">@Model.EndTime.ToString(@"hh\:mm") @(Model.EndTime.Hours < 12 ? "صباحًا" : "مساءً")</dd>

                <dt class="col-sm-4">☕ بداية الراحة</dt>
                <dd class="col-sm-8">@Model.BreakStart?.ToString(@"hh\:mm") ?? "—"</dd>

                <dt class="col-sm-4">☕ نهاية الراحة</dt>
                <dd class="col-sm-8">@Model.BreakEnd?.ToString(@"hh\:mm") ?? "—"</dd>
            </dl>

            <div class="text-end mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary me-2"><i class="fas fa-edit"></i> تعديل</a>
                <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> العودة</a>
            </div>
        </div>
    </div>
</div>
