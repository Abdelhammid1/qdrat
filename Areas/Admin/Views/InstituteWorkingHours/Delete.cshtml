@model QdratNew.ViewModels.Instructor.InstituteWorkingHoursViewModel
@{
    ViewData["Title"] = "حذف وقت العمل";
}

<div class="container mt-4">
    <h2 class="text-danger"><i class="fas fa-trash-alt"></i> تأكيد حذف وقت العمل</h2>

    <div class="alert alert-warning mt-3">
        <strong>⚠️ هل أنت متأكد أنك تريد حذف هذا الوقت؟</strong>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">📅 اليوم</dt>
                <dd class="col-sm-8">@QdratNew.Helpers.DayNameHelper.GetArabicDay(Model.DayOfWeek)</dd>

                <dt class="col-sm-4">🕘 وقت البدء</dt>
                <dd class="col-sm-8">@Model.StartTime.ToString(@"hh\:mm") @(Model.StartTime.Hours < 12 ? "صباحًا" : "مساءً")</dd>

                <dt class="col-sm-4">🕔 وقت الانتهاء</dt>
                <dd class="col-sm-8">@Model.EndTime.ToString(@"hh\:mm") @(Model.EndTime.Hours < 12 ? "صباحًا" : "مساءً")</dd>
            </dl>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="text-end">
                    <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> تأكيد الحذف</button>
                    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-times"></i> إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>
