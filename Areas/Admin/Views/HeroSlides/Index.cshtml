@model IEnumerable<QdratNew.Entities.HeroSlide>
@{
    ViewData["Title"] = "إدارة السلايدر الرئيسي";
}

<div class="container mt-4">
    <h3 class="fw-bold mb-3">🎞️ السلايدر الرئيسي</h3>
    <a asp-action="Create" class="btn btn-success mb-3">➕ إضافة شريحة جديدة</a>

    <table class="table table-bordered align-middle text-center">
        <thead class="table-light">
            <tr>
                <th>الصورة</th>
                <th>العنوان</th>
                <th>زر العرض</th>
                <th>الحالة</th>
                <th>الترتيب</th>
                <th>الخيارات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td><img src="@s.ImagePath" style="width:120px;border-radius:10px;" /></td>
                    <td>@s.Title</td>
                    <td>@(s.ShowButton? s.ButtonText: "—")</td>
                    <td>@(s.IsActive ? "✅ مفعل" : "⛔ معطل")</td>
                    <td>@s.DisplayOrder</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-primary">✏️ تعديل</a>
                        <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-danger" onclick="return confirm('حذف الشريحة؟')">🗑️ حذف</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
