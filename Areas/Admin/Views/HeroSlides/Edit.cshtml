@model QdratNew.Entities.HeroSlide

@{
    ViewData["Title"] = "تعديل الشريحة";
}

<div class="qdrat-page-wrapper" dir="rtl">
    <div class="qdrat-page-header">
        <div>
            <h1 class="qdrat-page-title">
                <i class="fas fa-pen-to-square"></i>
                تعديل بيانات الشريحة
            </h1>
            <p class="qdrat-page-subtitle">
                تحديث محتوى الشريحة الحالية مع الحفاظ على ترتيبها وحالة ظهورها في السلايدر.
            </p>
        </div>

        <a asp-action="Index" class="qdrat-back-btn">
            <i class="fas fa-arrow-right"></i>
            العودة للقائمة
        </a>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="qdrat-form-card">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="qdrat-card-header">
            <div class="qdrat-card-icon">
                <i class="fas fa-photo-film"></i>
            </div>
            <div>
                <h2>بيانات الشريحة</h2>
                <p>عدّل البيانات المطلوبة فقط ثم احفظ التغييرات.</p>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="qdrat-validation-summary"></div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-pen-nib"></i>
                المحتوى النصي
            </div>

            <div class="row g-4">
                <div class="col-lg-12">
                    <div class="qdrat-form-group">
                        <label asp-for="Title" class="qdrat-label">
                            عنوان الشريحة
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-heading"></i>
                            <input asp-for="Title" class="form-control qdrat-input" placeholder="أدخل عنوان الشريحة" />
                        </div>
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-12">
                    <div class="qdrat-form-group">
                        <label asp-for="Description" class="qdrat-label">الوصف</label>
                        <div class="qdrat-textarea-wrapper">
                            <textarea asp-for="Description" class="form-control qdrat-textarea" rows="4" placeholder="أدخل وصفًا مختصرًا يظهر داخل الشريحة"></textarea>
                        </div>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-hand-pointer"></i>
                إعدادات الزر
            </div>

            <div class="row g-4 align-items-end">
                <div class="col-lg-5">
                    <div class="qdrat-form-group">
                        <label asp-for="ButtonText" class="qdrat-label">نص الزر</label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-keyboard"></i>
                            <input asp-for="ButtonText" class="form-control qdrat-input" placeholder="مثال: سجل الآن" />
                        </div>
                        <span asp-validation-for="ButtonText" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="qdrat-form-group">
                        <label asp-for="ButtonUrl" class="qdrat-label">رابط الزر</label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-link"></i>
                            <input asp-for="ButtonUrl" class="form-control qdrat-input" placeholder="/Courses أو رابط خارجي" />
                        </div>
                        <span asp-validation-for="ButtonUrl" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-2">
                    <label class="qdrat-toggle-card">
                        <input asp-for="ShowButton" type="checkbox" />
                        <span class="qdrat-toggle-ui"></span>
                        <span class="qdrat-toggle-text">إظهار الزر</span>
                    </label>
                </div>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-image"></i>
                صورة الشريحة
            </div>

            <div class="row g-4 align-items-center">
                <div class="col-lg-5">
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <div class="qdrat-image-preview">
                            <img src="@Url.Content(Model.ImagePath)" alt="صورة الشريحة" />
                            <span>الصورة الحالية</span>
                        </div>
                    }
                    else
                    {
                        <div class="qdrat-empty-preview">
                            <i class="fas fa-image"></i>
                            <span>لا توجد صورة حالية</span>
                        </div>
                    }
                </div>

                <div class="col-lg-7">
                    <div class="qdrat-form-group">
                        <label class="qdrat-label">تغيير الصورة</label>
                        <div class="qdrat-file-box">
                            <i class="fas fa-cloud-arrow-up"></i>
                            <div>
                                <strong>اختر صورة جديدة للشريحة</strong>
                                <span>اترك الحقل فارغًا إذا كنت تريد الاحتفاظ بالصورة الحالية.</span>
                            </div>
                            <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-sliders"></i>
                إعدادات العرض
            </div>

            <div class="row g-4 align-items-end">
                <div class="col-lg-5">
                    <div class="qdrat-form-group">
                        <label class="qdrat-label">موضع النص</label>
                        <div class="qdrat-select-wrapper">
                            <i class="fas fa-align-center"></i>
                            @Html.DropDownListFor(m => m.Alignment, new List<SelectListItem>
                            {
                                new SelectListItem { Text = "يمين", Value = "align-right" },
                                                        new SelectListItem { Text = "يسار", Value = "align-left" },
                                                        new SelectListItem { Text = "أسفل", Value = "align-bottom" },
                                                        new SelectListItem { Text = "منتصف", Value = "align-center" }
                                                        }, "اختر الموضع", new { @class = "form-select qdrat-select" })
                        </div>
                        <span asp-validation-for="Alignment" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="qdrat-form-group">
                        <label asp-for="DisplayOrder" class="qdrat-label">ترتيب العرض</label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-arrow-down-1-9"></i>
                            <input asp-for="DisplayOrder" type="number" class="form-control qdrat-input" placeholder="0" />
                        </div>
                        <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-3">
                    <label class="qdrat-toggle-card qdrat-toggle-card-active">
                        <input asp-for="IsActive" type="checkbox" />
                        <span class="qdrat-toggle-ui"></span>
                        <span class="qdrat-toggle-text">نشط</span>
                    </label>
                </div>
            </div>
        </div>

        <div class="qdrat-actions">
            <button type="submit" class="qdrat-save-btn">
                <i class="fas fa-save"></i>
                حفظ التعديلات
            </button>

            <a asp-action="Index" class="qdrat-cancel-btn">
                <i class="fas fa-arrow-right"></i>
                عودة للقائمة
            </a>
        </div>
    </form>
</div>

<style>
    .qdrat-page-wrapper {
        max-width: 1180px;
        margin: 0 auto;
        padding: 24px 16px 40px;
        font-family: 'Cairo', 'Tajawal', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .qdrat-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 22px;
        padding: 22px 24px;
        border-radius: 24px;
        background: linear-gradient(135deg, #0f766e 0%, #0891b2 55%, #2563eb 100%);
        color: #fff;
        box-shadow: 0 18px 45px rgba(15, 118, 110, 0.22);
    }

    .qdrat-page-title {
        margin: 0;
        font-size: 26px;
        font-weight: 900;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .qdrat-page-subtitle {
        margin: 8px 0 0;
        color: rgba(255, 255, 255, 0.88);
        font-size: 14px;
        line-height: 1.8;
    }

    .qdrat-back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 150px;
        padding: 11px 18px;
        border-radius: 999px;
        color: #fff;
        text-decoration: none;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.32);
        font-size: 14px;
        font-weight: 800;
        transition: all 0.2s ease-in-out;
    }

        .qdrat-back-btn:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.24);
            transform: translateY(-1px);
        }

    .qdrat-form-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 26px;
        box-shadow: 0 20px 55px rgba(15, 23, 42, 0.08);
        padding: 26px;
        overflow: hidden;
    }

    .qdrat-card-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding-bottom: 22px;
        border-bottom: 1px solid #eef2f7;
        margin-bottom: 24px;
    }

    .qdrat-card-icon {
        width: 54px;
        height: 54px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #ecfeff 0%, #dbeafe 100%);
        color: #0f766e;
        font-size: 22px;
        flex-shrink: 0;
    }

    .qdrat-card-header h2 {
        margin: 0;
        font-size: 20px;
        font-weight: 900;
        color: #111827;
    }

    .qdrat-card-header p {
        margin: 6px 0 0;
        color: #6b7280;
        font-size: 13px;
    }

    .qdrat-section {
        padding: 20px;
        border: 1px solid #eef2f7;
        background: #fbfdff;
        border-radius: 22px;
        margin-bottom: 20px;
    }

    .qdrat-section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 18px;
        color: #0f172a;
        font-size: 16px;
        font-weight: 900;
    }

        .qdrat-section-title i {
            color: #0f766e;
        }

    .qdrat-label {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 9px;
        color: #1f2937;
        font-size: 14px;
        font-weight: 900;
    }

    .qdrat-required {
        color: #dc2626;
        font-weight: 900;
    }

    .qdrat-input-wrapper,
    .qdrat-select-wrapper {
        position: relative;
    }

        .qdrat-input-wrapper i,
        .qdrat-select-wrapper i {
            position: absolute;
            top: 50%;
            right: 15px;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 15px;
            z-index: 2;
        }

    .qdrat-input,
    .qdrat-select {
        height: 48px;
        border-radius: 16px;
        border: 1px solid #dbe3ef;
        background-color: #fff;
        padding: 10px 44px 10px 14px;
        color: #111827;
        font-size: 14px;
        font-weight: 700;
        transition: all 0.18s ease-in-out;
    }

        .qdrat-input:focus,
        .qdrat-select:focus,
        .qdrat-textarea:focus {
            border-color: #0f766e;
            box-shadow: 0 0 0 4px rgba(15, 118, 110, 0.10);
        }

    .qdrat-textarea {
        border-radius: 18px;
        border: 1px solid #dbe3ef;
        background: #fff;
        padding: 14px 16px;
        color: #111827;
        font-size: 14px;
        font-weight: 700;
        resize: vertical;
        transition: all 0.18s ease-in-out;
    }

    .qdrat-validation-summary {
        color: #b91c1c;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 16px;
        padding: 12px 16px;
        margin-bottom: 20px;
        font-size: 14px;
        font-weight: 700;
    }

        .qdrat-validation-summary:empty {
            display: none;
        }

    .qdrat-file-box {
        position: relative;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px;
        border-radius: 20px;
        border: 1px dashed #93c5fd;
        background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
        overflow: hidden;
    }

        .qdrat-file-box > i {
            width: 46px;
            height: 46px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff;
            color: #2563eb;
            font-size: 21px;
            flex-shrink: 0;
        }

        .qdrat-file-box strong {
            display: block;
            color: #0f172a;
            font-size: 15px;
            font-weight: 900;
        }

        .qdrat-file-box span {
            display: block;
            margin-top: 4px;
            color: #64748b;
            font-size: 12px;
            font-weight: 700;
        }

        .qdrat-file-box input[type="file"] {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer;
        }

    .qdrat-image-preview,
    .qdrat-empty-preview {
        min-height: 150px;
        border-radius: 22px;
        border: 1px solid #e5e7eb;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 10px;
        overflow: hidden;
    }

        .qdrat-image-preview img {
            width: 100%;
            max-height: 180px;
            object-fit: cover;
            display: block;
        }

        .qdrat-image-preview span,
        .qdrat-empty-preview span {
            color: #64748b;
            font-size: 13px;
            font-weight: 800;
            padding-bottom: 10px;
        }

        .qdrat-empty-preview i {
            color: #94a3b8;
            font-size: 38px;
        }

    .qdrat-toggle-card {
        min-height: 48px;
        width: 100%;
        border-radius: 18px;
        border: 1px solid #dbe3ef;
        background: #fff;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        cursor: pointer;
        user-select: none;
    }

        .qdrat-toggle-card input {
            display: none;
        }

    .qdrat-toggle-ui {
        width: 42px;
        height: 24px;
        border-radius: 999px;
        background: #cbd5e1;
        position: relative;
        flex-shrink: 0;
        transition: all 0.18s ease-in-out;
    }

        .qdrat-toggle-ui::after {
            content: "";
            position: absolute;
            top: 3px;
            right: 3px;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: #fff;
            transition: all 0.18s ease-in-out;
            box-shadow: 0 2px 6px rgba(15, 23, 42, 0.18);
        }

    .qdrat-toggle-card input:checked + .qdrat-toggle-ui {
        background: #0f766e;
    }

        .qdrat-toggle-card input:checked + .qdrat-toggle-ui::after {
            right: 21px;
        }

    .qdrat-toggle-text {
        color: #1f2937;
        font-size: 14px;
        font-weight: 900;
    }

    .qdrat-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding-top: 8px;
        flex-wrap: wrap;
    }

    .qdrat-save-btn,
    .qdrat-cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-width: 170px;
        min-height: 48px;
        border-radius: 999px;
        font-size: 15px;
        font-weight: 900;
        text-decoration: none;
        border: none;
        transition: all 0.2s ease-in-out;
    }

    .qdrat-save-btn {
        color: #fff;
        background: linear-gradient(135deg, #16a34a 0%, #0f766e 100%);
        box-shadow: 0 14px 30px rgba(22, 163, 74, 0.22);
    }

        .qdrat-save-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 18px 34px rgba(22, 163, 74, 0.28);
        }

    .qdrat-cancel-btn {
        color: #334155;
        background: #fff;
        border: 1px solid #cbd5e1;
    }

        .qdrat-cancel-btn:hover {
            color: #0f172a;
            background: #f8fafc;
            transform: translateY(-1px);
        }

    @@media (max-width: 768px) {
        .qdrat-page-header {
            flex-direction: column;
            align-items: stretch;
            padding: 20px;
        }

        .qdrat-page-title {
            font-size: 21px;
        }

        .qdrat-back-btn {
            width: 100%;
        }

        .qdrat-form-card {
            padding: 18px;
            border-radius: 22px;
        }

        .qdrat-section {
            padding: 16px;
        }

        .qdrat-actions {
            flex-direction: column;
        }

        .qdrat-save-btn,
        .qdrat-cancel-btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
