@model QdratNew.ViewModels.Section.ManageSectionUnitViewModel

@{
    ViewData["Title"] = "🔗 إدارة ربط الوحدة بالمحاور";
}

<div class="container mt-4" dir="rtl">
    <h2 class="text-center mb-4 text-primary">
        🔗 إدارة الربط بالمحاور للوحدة: <span class="fw-bold">@Model.UnitTitle</span>
    </h2>

    <form asp-action="Manage" method="post">
        <input type="hidden" asp-for="UnitId" />
        <div class="d-flex justify-content-end mb-3">
            <button type="button" id="selectAllBtn" class="btn btn-outline-primary btn-sm">
                <i class="fas fa-check-double"></i> تحديد الكل
            </button>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                    @foreach (var item in Model.Sections) 
                    {
                        <div class="col">
                            <div class="form-check bg-light p-3 rounded shadow-sm h-100">
                                <input type="checkbox"
                                       class="form-check-input"
                                       id="section_@item.SectionId"
                                       name="SelectedSectionIds"
                                       value="@item.SectionId"
                                       @(item.IsLinked ? "checked" : "") />
                                <label class="form-check-label fw-bold d-block mt-2" for="section_@item.SectionId">
                                    <i class="fas fa-book-open me-1 text-primary"></i> @item.Title
                                </label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> حفظ الربط
            </button>
            <a asp-controller="Units" asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> رجوع
            </a>
        </div>
    </form>
</div>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const selectAllBtn = document.getElementById('selectAllBtn');
            const checkboxes = document.querySelectorAll('input[name="SelectedSectionIds"]');

            let allSelected = false;

            selectAllBtn.addEventListener('click', function () {
                allSelected = !allSelected;
                checkboxes.forEach(cb => {
                    cb.checked = allSelected;
                    animateCheckbox(cb);
                });

                this.innerHTML = allSelected
                    ? '<i class="fas fa-times-circle"></i> إلغاء التحديد'
                    : '<i class="fas fa-check-double"></i> تحديد الكل';
            });

            function animateCheckbox(checkbox) {
                checkbox.parentElement.classList.add('animated-checkbox');
                setTimeout(() => {
                    checkbox.parentElement.classList.remove('animated-checkbox');
                }, 500);
            }
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // ✅ إذا كانت هناك رسالة نجاح من TempData
            var successMessage = '@TempData["SuccessMessage"]';
            if (successMessage) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: successMessage,
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true,
                    background: '#d4edda',
                    color: '#155724'
                });
            }
        });
    </script>
    
}
