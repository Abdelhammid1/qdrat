@model QdratNew.ViewModels.Section.SectionUnitsViewModel

@{
    ViewData["Title"] = "تفاصيل المحور والوحدات المرتبطة";
}

<h2 class="mb-4"><i class="fas fa-eye"></i> تفاصيل المحور</h2>

<div class="card">
    <div class="card-body">
        <h4><i class="fas fa-book"></i> @Model.SectionTitle</h4>
        <hr />
        <h5>📋 الوحدات المرتبطة:</h5>
        <ul class="list-group">
            @if (Model.UnitTitles.Any())
            {
                @foreach (var unit in Model.UnitTitles)
                {
                    <li class="list-group-item"><i class="fas fa-check-circle text-success"></i> @unit</li>
                }
            }
            else
            {
                <li class="list-group-item text-muted">لا توجد وحدات مرتبطة.</li>
            }
        </ul>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> رجوع للقائمة</a>
</div>
