@model IEnumerable<QdratNew.ViewModels.Section.SectionUnitsViewModel>

@{
    ViewData["Title"] = "عرض المحاور والوحدات المرتبطة";
}

<h2 class="mb-4 text-dark"><i class="fas fa-book-open"></i> المحاور والوحدات المرتبطة</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
<div class="d-flex justify-content-end mb-3">
    <a asp-action="Create" class="btn btn-success btn-sm">
        <i class="fas fa-plus"></i> ربط وحدات بمحور
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table id="sectionsTable" class="table table-hover table-striped align-middle text-center" style="width:100%">
            <thead class="table-primary">
                <tr>
                    <th style="width: 30%;">📚 المحور</th>
                    <th>📋 الوحدات المرتبطة</th>
                    <th style="width: 15%;">⚙️ العمليات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.SectionTitle</td>
                        <td>
                            @if (item.UnitTitles.Any())
                            {
                                <span class="text-success">يوجد عدد @item.UnitTitles.Count وحدة</span>
                                <button type="button" class="btn btn-link btn-sm text-primary" data-bs-toggle="modal" data-bs-target="#unitsModal_@item.SectionId">
                                    عرض
                                </button>

                                <!-- ✅ Modal للوحدات -->
                                <div class="modal fade" id="unitsModal_@item.SectionId" tabindex="-1" aria-labelledby="unitsModalLabel_@item.SectionId" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="unitsModalLabel_@item.SectionId">الوحدات المرتبطة بمحور: @item.SectionTitle</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="d-flex flex-wrap justify-content-center gap-2">
                                                    @foreach (var unit in item.UnitTitles)
                                                    {
                                                        <span class="badge bg-light text-dark border p-2">@unit</span>
                                                    }
                                                </div>

                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">إغلاق</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">لا توجد وحدات مرتبطة</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex justify-content-center gap-2">
                                <a asp-action="Edit" asp-route-id="@item.SectionId" class="btn btn-light btn-sm" title="تعديل">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.SectionId" class="btn btn-light btn-sm" title="تفاصيل">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.SectionId" class="btn btn-light btn-sm" title="حذف" onclick="return confirm('هل أنت متأكد من حذف الوحدات المرتبطة؟');">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <script>
        $(document).ready(function () {
            $('#sectionsTable').DataTable({
                paging: true,
                searching: true,
                ordering: true,
                responsive: true,
                dom: 'Bfrtip',
                buttons: [
                    { extend: 'copy', className: 'btn btn-secondary btn-sm', text: '<i class="fas fa-copy"></i>' },
                    { extend: 'excel', className: 'btn btn-success btn-sm', text: '<i class="fas fa-file-excel"></i>' },
                    { extend: 'print', className: 'btn btn-primary btn-sm', text: '<i class="fas fa-print"></i>' }
                ],
                language: {
                    search: "بحث:",
                    lengthMenu: "عرض _MENU_ محاور",
                    info: "عرض _START_ إلى _END_ من _TOTAL_ محور",
                    paginate: {
                        previous: "السابق",
                        next: "التالي"
                    }
                }
            });
        });
    </script>
}
