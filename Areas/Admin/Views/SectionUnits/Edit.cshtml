@model QdratNew.ViewModels.Section.SectionUnitAssignmentViewModel

@{
    ViewData["Title"] = "تعديل ربط الوحدات بالمحور";
}

<div class="qdrat-page" dir="rtl">

    <div class="qdrat-hero mb-4">
        <div>
            <div class="qdrat-kicker">
                <i class="fas fa-edit"></i>
                تعديل ربط الوحدات
            </div>

            <h2 class="qdrat-title">تعديل ربط الوحدات بمحور</h2>

            <p class="qdrat-subtitle">
                راجع الوحدات المرتبطة بهذا المحور، ثم حدّث الاختيارات بما يتوافق مع هيكلة المنهج الحالية.
            </p>
        </div>

        <div class="qdrat-hero-icon">
            <i class="fas fa-sitemap"></i>
        </div>
    </div>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="SectionId" />

        <div class="qdrat-card mb-4">
            <div class="qdrat-card-header">
                <div>
                    <h5>
                        <i class="fas fa-layer-group"></i>
                        بيانات المحور
                    </h5>
                    <p>المحور ثابت في وضع التعديل، ويمكنك فقط تحديث الوحدات المرتبطة به.</p>
                </div>
            </div>

            <div class="qdrat-card-body">
                <div class="qdrat-field">
                    <label asp-for="SectionId" class="form-label">اسم المحور</label>

                    <div class="qdrat-input-wrap qdrat-input-disabled">
                        <i class="fas fa-diagram-project"></i>
                        <select asp-for="SectionId" class="form-select" asp-items="Model.Sections" disabled>
                            <option value="">-- اختر محورا --</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-card">
            <div class="qdrat-card-header">
                <div>
                    <h5>
                        <i class="fas fa-cubes"></i>
                        الوحدات المرتبطة
                    </h5>
                    <p>فعّل أو ألغِ تفعيل الوحدات المرتبطة بالمحور الحالي.</p>
                </div>
            </div>

            <div class="qdrat-card-body">

                <div class="qdrat-units-panel">
                    @if (Model.Units != null && Model.Units.Any())
                    {
                        <div class="row g-3">
                            @foreach (var unit in Model.Units)
                            {
                                var unitId = int.Parse(unit.Value);
                                var isSelected = Model.SelectedUnitIds != null && Model.SelectedUnitIds.Any(selectedUnitId => selectedUnitId == unitId);

                                <div class="col-xl-4 col-lg-4 col-md-6">
                                    <div class="qdrat-check-card">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="SelectedUnitIds"
                                               value="@unit.Value"
                                               id="unit_@unit.Value"
                                               @(isSelected ? "checked" : "") />

                                        <label class="form-check-label" for="unit_@unit.Value">
                                            <span class="qdrat-check-icon">
                                                <i class="fas fa-book"></i>
                                            </span>
                                            <span>@unit.Text</span>
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="qdrat-empty-state">
                            <i class="fas fa-folder-open"></i>
                            <h6>لا توجد وحدات متاحة</h6>
                            <p>لا توجد وحدات يمكن ربطها حاليًا.</p>
                        </div>
                    }
                </div>

                <div class="qdrat-actions">
                    <a asp-action="Index" class="btn qdrat-btn qdrat-btn-light">
                        <i class="fas fa-arrow-right"></i>
                        رجوع
                    </a>

                    <button type="submit" class="btn qdrat-btn qdrat-btn-primary">
                        <i class="fas fa-save"></i>
                        حفظ التعديلات
                    </button>
                </div>

            </div>
        </div>
    </form>
</div>

<style>
    .qdrat-page {
        padding: 24px;
        background: #f5f7fb;
        min-height: calc(100vh - 80px);
        font-family: inherit;
    }

    .qdrat-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 26px;
        border-radius: 24px;
        background: linear-gradient(135deg, #102a43 0%, #1d4ed8 58%, #38bdf8 100%);
        color: #fff;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
    }

    .qdrat-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .qdrat-title {
        margin: 0;
        font-size: 28px;
        font-weight: 900;
        letter-spacing: -0.5px;
    }

    .qdrat-subtitle {
        margin: 10px 0 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 15px;
        line-height: 1.8;
        max-width: 850px;
    }

    .qdrat-hero-icon {
        width: 74px;
        height: 74px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.16);
        font-size: 34px;
        flex: 0 0 auto;
    }

    .qdrat-card {
        border: 1px solid #e5e7eb;
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    .qdrat-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #edf0f5;
        background: #fff;
    }

        .qdrat-card-header h5 {
            margin: 0;
            color: #0f172a;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .qdrat-card-header h5 i {
                color: #2563eb;
            }

        .qdrat-card-header p {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 14px;
        }

    .qdrat-card-body {
        padding: 24px;
    }

    .qdrat-field .form-label {
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 9px;
    }

    .qdrat-input-wrap {
        position: relative;
    }

        .qdrat-input-wrap > i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 3;
            pointer-events: none;
        }

        .qdrat-input-wrap .form-select {
            min-height: 48px;
            border-radius: 15px;
            border-color: #dbe3ef;
            padding-right: 42px;
            font-weight: 700;
        }

            .qdrat-input-wrap .form-select:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 0.22rem rgba(37, 99, 235, 0.12);
            }

    .qdrat-input-disabled .form-select:disabled {
        background-color: #f1f5f9;
        color: #475569;
        opacity: 1;
        cursor: not-allowed;
    }

    .qdrat-units-panel {
        max-height: 430px;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 4px 4px 8px;
    }

    .qdrat-check-card {
        position: relative;
        height: 100%;
    }

        .qdrat-check-card .form-check-input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .qdrat-check-card .form-check-label {
            width: 100%;
            min-height: 70px;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px;
            border: 1px solid #e5e7eb;
            border-radius: 18px;
            background: #f8fafc;
            color: #334155;
            font-weight: 900;
            line-height: 1.7;
            cursor: pointer;
            transition: 0.18s ease;
        }

            .qdrat-check-card .form-check-label:hover {
                border-color: #bfdbfe;
                background: #eff6ff;
                transform: translateY(-2px);
            }

        .qdrat-check-card .form-check-input:checked + .form-check-label {
            border-color: #16a34a;
            background: #ecfdf5;
            color: #166534;
            box-shadow: 0 10px 26px rgba(22, 163, 74, 0.12);
        }

    .qdrat-check-icon {
        width: 38px;
        height: 38px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e0f2fe;
        color: #0284c7;
        flex: 0 0 auto;
    }

    .qdrat-check-card .form-check-input:checked + .form-check-label .qdrat-check-icon {
        background: #dcfce7;
        color: #16a34a;
    }

    .qdrat-empty-state {
        border: 1px dashed #cbd5e1;
        border-radius: 22px;
        background: #f8fafc;
        text-align: center;
        padding: 38px 20px;
        color: #64748b;
    }

        .qdrat-empty-state > i {
            font-size: 38px;
            color: #94a3b8;
            margin-bottom: 12px;
        }

        .qdrat-empty-state h6 {
            margin: 0;
            font-weight: 900;
            color: #334155;
        }

        .qdrat-empty-state p {
            margin: 8px 0 0;
            font-weight: 700;
        }

    .qdrat-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 26px;
        margin-top: 28px;
        border-top: 1px solid #edf0f5;
    }

    .qdrat-btn {
        min-height: 46px;
        border-radius: 14px;
        padding: 10px 24px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .qdrat-btn-primary {
        background: #16a34a;
        border-color: #16a34a;
        color: #fff;
    }

        .qdrat-btn-primary:hover {
            background: #15803d;
            border-color: #15803d;
            color: #fff;
        }

    .qdrat-btn-light {
        background: #f8fafc;
        border-color: #dbe3ef;
        color: #334155;
    }

        .qdrat-btn-light:hover {
            background: #eef2f7;
            border-color: #cbd5e1;
            color: #0f172a;
        }

    @@media (max-width: 768px) {
        .qdrat-page {
            padding: 14px;
        }

        .qdrat-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 20px;
        }

        .qdrat-title {
            font-size: 23px;
        }

        .qdrat-hero-icon {
            width: 58px;
            height: 58px;
            font-size: 26px;
        }

        .qdrat-card-body,
        .qdrat-card-header {
            padding: 18px;
        }

        .qdrat-actions {
            flex-direction: column-reverse;
        }

        .qdrat-btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
