@model QdratNew.ViewModels.PartnerSubscriptionPeriods.PartnerSubscriptionPeriodCreateViewModel

@{
    ViewData["Title"] = "إضافة فترة اشتراك";
}

<div class="qdrat-page-wrapper" dir="rtl">
    <div class="qdrat-page-header">
        <div>
            <h1 class="qdrat-page-title">
                <i class="fas fa-calendar-plus"></i>
                إضافة فترة اشتراك جديدة
            </h1>
            <p class="qdrat-page-subtitle">
                إنشاء فترة تسجيل جديدة للمدرسة مع تحديد المدة وحد الطلاب المسموح لهم بالتسجيل.
            </p>
        </div>

        <a asp-action="Index"
           asp-route-subscriptionId="@Model.PartnerSubscriptionId"
           class="qdrat-back-btn">
            <i class="fas fa-arrow-right"></i>
            رجوع للفترات
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="qdrat-alert qdrat-alert-danger">
            <i class="fas fa-circle-exclamation"></i>
            <div>
                <strong>تعذر الحفظ</strong>
                <span>@TempData["Error"]</span>
            </div>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="qdrat-alert qdrat-alert-danger">
            <i class="fas fa-triangle-exclamation"></i>
            <div>
                <strong>لم يتم حفظ البيانات بسبب الأخطاء التالية:</strong>
                <ul class="mb-0 mt-2">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        </div>
    }

    <form asp-action="Create" method="post" class="qdrat-form-card">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="PartnerSubscriptionId" />
        <input type="hidden" asp-for="PartnerName" />

        <div class="qdrat-card-header">
            <div class="qdrat-card-icon">
                <i class="fas fa-school"></i>
            </div>
            <div>
                <h2>بيانات فترة الاشتراك</h2>
                <p>
                    المدرسة:
                    <strong>@Model.PartnerName</strong>
                </p>
            </div>
        </div>

        <div class="qdrat-info-box">
            <div class="qdrat-info-icon">
                <i class="fas fa-info"></i>
            </div>
            <div>
                <strong>تنبيه تنظيمي</strong>
                <p>
                    هذه الفترة تحدد <strong>مجموعة طلاب جديدة</strong> سيتم تسجيلهم خلال هذه المدة، ولا تؤثر على الطلاب المسجلين في فترات سابقة.
                </p>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-calendar-days"></i>
                مدة الفترة
            </div>

            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="StartDate" class="qdrat-label">
                            تاريخ بداية الفترة
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-calendar-check"></i>
                            <input asp-for="StartDate" type="date" class="form-control qdrat-input" />
                        </div>
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="EndDate" class="qdrat-label">
                            تاريخ نهاية الفترة
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-calendar-xmark"></i>
                            <input asp-for="EndDate" type="date" class="form-control qdrat-input" />
                        </div>
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-users"></i>
                حد الطلاب
            </div>

            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="MaxStudents" class="qdrat-label">
                            الحد الأقصى للطلاب في هذه الفترة
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-user-group"></i>
                            <input asp-for="MaxStudents"
                                   class="form-control qdrat-input"
                                   inputmode="numeric"
                                   placeholder="مثال: 300" />
                        </div>
                        <small class="qdrat-help-text">
                            اتركه فارغًا إذا كان العدد غير محدود.
                        </small>
                        <span asp-validation-for="MaxStudents" class="text-danger small d-block"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-actions">
            <button type="submit" class="qdrat-save-btn">
                <i class="fas fa-save"></i>
                حفظ الفترة
            </button>

            <a asp-action="Index"
               asp-route-subscriptionId="@Model.PartnerSubscriptionId"
               class="qdrat-cancel-btn">
                <i class="fas fa-arrow-right"></i>
                رجوع
            </a>
        </div>
    </form>
</div>

<style>
    .qdrat-page-wrapper {
        max-width: 1180px;
        margin: 0 auto;
        padding: 24px 16px 40px;
        font-family: 'Cairo', 'Tajawal', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .qdrat-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 22px;
        padding: 22px 24px;
        border-radius: 24px;
        background: linear-gradient(135deg, #0f766e 0%, #0891b2 55%, #2563eb 100%);
        color: #fff;
        box-shadow: 0 18px 45px rgba(15, 118, 110, 0.22);
    }

    .qdrat-page-title {
        margin: 0;
        font-size: 26px;
        font-weight: 900;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .qdrat-page-subtitle {
        margin: 8px 0 0;
        color: rgba(255, 255, 255, 0.88);
        font-size: 14px;
        line-height: 1.8;
    }

    .qdrat-back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 150px;
        padding: 11px 18px;
        border-radius: 999px;
        color: #fff;
        text-decoration: none;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.32);
        font-size: 14px;
        font-weight: 800;
        transition: all 0.2s ease-in-out;
    }

        .qdrat-back-btn:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.24);
            transform: translateY(-1px);
        }

    .qdrat-form-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 26px;
        box-shadow: 0 20px 55px rgba(15, 23, 42, 0.08);
        padding: 26px;
        overflow: hidden;
    }

    .qdrat-card-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding-bottom: 22px;
        border-bottom: 1px solid #eef2f7;
        margin-bottom: 20px;
    }

    .qdrat-card-icon {
        width: 54px;
        height: 54px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #ecfeff 0%, #dbeafe 100%);
        color: #0f766e;
        font-size: 22px;
        flex-shrink: 0;
    }

    .qdrat-card-header h2 {
        margin: 0;
        font-size: 20px;
        font-weight: 900;
        color: #111827;
    }

    .qdrat-card-header p {
        margin: 6px 0 0;
        color: #6b7280;
        font-size: 13px;
    }

    .qdrat-card-header strong {
        color: #0f766e;
        font-weight: 900;
    }

    .qdrat-alert {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 18px;
        padding: 14px 16px;
        border-radius: 18px;
        font-size: 14px;
        font-weight: 700;
    }

        .qdrat-alert i {
            margin-top: 3px;
            font-size: 18px;
        }

        .qdrat-alert strong {
            display: block;
            margin-bottom: 4px;
            font-weight: 900;
        }

    .qdrat-alert-danger {
        color: #991b1b;
        background: #fef2f2;
        border: 1px solid #fecaca;
    }

    .qdrat-info-box {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 18px;
        border-radius: 20px;
        background: linear-gradient(135deg, #ecfeff 0%, #eff6ff 100%);
        border: 1px solid #bae6fd;
        margin-bottom: 20px;
    }

    .qdrat-info-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        color: #0284c7;
        flex-shrink: 0;
    }

    .qdrat-info-box strong {
        display: block;
        color: #0f172a;
        font-size: 15px;
        font-weight: 900;
        margin-bottom: 5px;
    }

    .qdrat-info-box p {
        margin: 0;
        color: #475569;
        line-height: 1.9;
        font-size: 14px;
    }

    .qdrat-section {
        padding: 20px;
        border: 1px solid #eef2f7;
        background: #fbfdff;
        border-radius: 22px;
        margin-bottom: 20px;
    }

    .qdrat-section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 18px;
        color: #0f172a;
        font-size: 16px;
        font-weight: 900;
    }

        .qdrat-section-title i {
            color: #0f766e;
        }

    .qdrat-form-group {
        margin-bottom: 2px;
    }

    .qdrat-label {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 9px;
        color: #1f2937;
        font-size: 14px;
        font-weight: 900;
    }

    .qdrat-required {
        color: #dc2626;
        font-weight: 900;
    }

    .qdrat-input-wrapper {
        position: relative;
    }

        .qdrat-input-wrapper i {
            position: absolute;
            top: 50%;
            right: 15px;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 15px;
            z-index: 2;
        }

    .qdrat-input {
        height: 48px;
        border-radius: 16px;
        border: 1px solid #dbe3ef;
        background: #fff;
        padding: 10px 44px 10px 14px;
        color: #111827;
        font-size: 14px;
        font-weight: 700;
        transition: all 0.18s ease-in-out;
    }

        .qdrat-input:focus {
            border-color: #0f766e;
            box-shadow: 0 0 0 4px rgba(15, 118, 110, 0.10);
        }

    .qdrat-help-text {
        display: block;
        margin-top: 8px;
        color: #64748b;
        font-size: 12px;
        font-weight: 700;
    }

    .qdrat-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding-top: 8px;
        flex-wrap: wrap;
    }

    .qdrat-save-btn,
    .qdrat-cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-width: 170px;
        min-height: 48px;
        border-radius: 999px;
        font-size: 15px;
        font-weight: 900;
        text-decoration: none;
        border: none;
        transition: all 0.2s ease-in-out;
    }

    .qdrat-save-btn {
        color: #fff;
        background: linear-gradient(135deg, #16a34a 0%, #0f766e 100%);
        box-shadow: 0 14px 30px rgba(22, 163, 74, 0.22);
    }

        .qdrat-save-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 18px 34px rgba(22, 163, 74, 0.28);
        }

    .qdrat-cancel-btn {
        color: #334155;
        background: #fff;
        border: 1px solid #cbd5e1;
    }

        .qdrat-cancel-btn:hover {
            color: #0f172a;
            background: #f8fafc;
            transform: translateY(-1px);
        }

    @@media (max-width: 768px) {
        .qdrat-page-header {
            flex-direction: column;
            align-items: stretch;
            padding: 20px;
        }

        .qdrat-page-title {
            font-size: 21px;
        }

        .qdrat-back-btn {
            width: 100%;
        }

        .qdrat-form-card {
            padding: 18px;
            border-radius: 22px;
        }

        .qdrat-section {
            padding: 16px;
        }

        .qdrat-actions {
            flex-direction: column;
        }

        .qdrat-save-btn,
        .qdrat-cancel-btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
