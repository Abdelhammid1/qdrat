@model QdratNew.ViewModels.PartnerSubscriptionPeriods.PartnerSubscriptionPeriodDetailsViewModel

@{
    ViewData["Title"] = "تفاصيل فترة الاشتراك";

    var studentsList = Model.Students != null
        ? Model.Students.ToList()
        : new List<QdratNew.ViewModels.PartnerSubscriptionPeriods.StudentInPeriodItem>();

    var totalStudents = studentsList.Count;
    var activeStudents = studentsList.Count(x => x.IsActiveForLearning);
    var readOnlyStudents = totalStudents - activeStudents;

    var maxStudentsText = Model.MaxStudents.HasValue
        ? Model.MaxStudents.Value.ToString()
        : "غير محدود";

    var usagePercentage = Model.MaxStudents.HasValue && Model.MaxStudents.Value > 0
        ? Math.Round((Model.CurrentStudentsCount * 100.0) / Model.MaxStudents.Value, 1)
        : 0;
}

@section Styles {
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        :root {
            --ink: #0D1B2A;
            --ink-2: #2C3E50;
            --ink-3: #5A6A7A;
            --ink-4: #8FA0B0;
            --ink-5: #C8D5E0;
            --canvas: #F3F6FA;
            --surface: #FFFFFF;
            --surface-2: #F8FAFC;
            --surface-3: #EEF2F7;
            --border: #DDE4EC;
            --blue: #1B5EAE;
            --blue-2: #2471D0;
            --blue-bg: #E8F1FB;
            --blue-dark: #103E7A;
            --emerald: #0D7A5B;
            --emerald-bg: #E4F5EE;
            --amber: #985D09;
            --amber-bg: #FDF0D8;
            --rose: #BF1030;
            --rose-bg: #FDEAEE;
            --violet: #5535B5;
            --violet-bg: #EDE8F9;
            --r-sm: 6px;
            --r-md: 10px;
            --r-lg: 14px;
            --r-xl: 20px;
            --sh-xs: 0 1px 3px rgba(13,27,42,.06);
            --sh-sm: 0 2px 8px rgba(13,27,42,.08);
            --sh-md: 0 4px 18px rgba(13,27,42,.10);
            --ease: cubic-bezier(.25,.46,.45,.94);
        }

        .period-details-page {
            background: var(--canvas);
            min-height: 100vh;
            padding: 32px 28px 64px;
            direction: rtl;
            font-family: 'Cairo';
            color: var(--ink-2);
        }

        .period-details-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 14px;
            margin-bottom: 28px;
        }

        .period-details-brand {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .period-details-brand-icon {
            width: 46px;
            height: 46px;
            background: var(--blue);
            border-radius: var(--r-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 20px;
            box-shadow: 0 4px 14px rgba(27,94,174,.28);
        }

        .period-details-brand-title {
            font-size: 20px;
            font-weight: 700;
            color: var(--ink);
            line-height: 1.15;
        }

        .period-details-brand-sub {
            font-size: 16px;
            color: var(--ink-4);
            margin-top: 2px;
        }

        .partner-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--violet-bg);
            color: var(--violet);
            padding: 5px 12px;
            border-radius: 30px;
            font-size: 16px;
            font-weight: 800;
            margin-top: 8px;
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn-secondary-action {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: var(--surface);
            color: var(--blue);
            border: 1px solid #B6D3F4;
            border-radius: var(--r-md);
            padding: 10px 20px;
            font-size: 18px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: background .16s var(--ease), transform .14s, box-shadow .16s;
        }

            .btn-secondary-action:hover {
                background: var(--blue-bg);
                color: var(--blue-dark);
                transform: translateY(-2px);
                box-shadow: var(--sh-sm);
            }

        .period-kpis {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 13px;
            margin-bottom: 24px;
        }

        @@media (max-width: 960px) {
            .period-kpis {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 480px) {
            .period-kpis {
                grid-template-columns: 1fr;
            }
        }

        .kpi-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            padding: 18px 19px;
            display: flex;
            align-items: center;
            gap: 13px;
            box-shadow: var(--sh-xs);
            transition: transform .2s var(--ease), box-shadow .2s;
            position: relative;
            overflow: hidden;
        }

            .kpi-card::after {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 4px;
                height: 100%;
                border-radius: 0 var(--r-xl) var(--r-xl) 0;
            }

            .kpi-card:hover {
                transform: translateY(-3px);
                box-shadow: var(--sh-sm);
            }

        .kpi-blue::after {
            background: var(--blue);
        }

        .kpi-emerald::after {
            background: var(--emerald);
        }

        .kpi-amber::after {
            background: var(--amber);
        }

        .kpi-violet::after {
            background: var(--violet);
        }

        .kpi-ico {
            width: 42px;
            height: 42px;
            border-radius: var(--r-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .ico-blue {
            background: var(--blue-bg);
            color: var(--blue);
        }

        .ico-emerald {
            background: var(--emerald-bg);
            color: var(--emerald);
        }

        .ico-amber {
            background: var(--amber-bg);
            color: var(--amber);
        }

        .ico-violet {
            background: var(--violet-bg);
            color: var(--violet);
        }

        .kpi-label {
            font-size: 15px;
            font-weight: 700;
            color: var(--ink-4);
            letter-spacing: .04em;
            text-transform: uppercase;
            margin-bottom: 3px;
        }

        .kpi-val {
            font-size: 20px;
            font-weight: 700;
            color: var(--ink);
            line-height: 1;
        }

        .details-section-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            overflow: hidden;
            box-shadow: var(--sh-sm);
            margin-bottom: 24px;
        }

        .details-section-header {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 15px 18px;
            border-bottom: 1px solid var(--surface-3);
            font-size: 18px;
            font-weight: 800;
            color: var(--ink);
        }

            .details-section-header i {
                color: var(--blue);
            }

        .details-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 13px;
            padding: 18px;
        }

        @@media (max-width: 1100px) {
            .details-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 576px) {
            .details-grid {
                grid-template-columns: 1fr;
            }
        }

        .detail-card {
            background: var(--surface-2);
            border: 1px solid var(--surface-3);
            border-radius: var(--r-lg);
            padding: 16px 17px;
            min-height: 92px;
            transition: border-color .15s, transform .15s, box-shadow .15s;
        }

            .detail-card:hover {
                border-color: #B6D3F4;
                transform: translateY(-2px);
                box-shadow: var(--sh-xs);
            }

        .detail-label {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--ink-4);
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 7px;
        }

        .detail-value {
            color: var(--ink);
            font-size: 20px;
            font-weight: 800;
            line-height: 1.5;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 6px 13px;
            border-radius: 30px;
            font-size: 16px;
            font-weight: 800;
            white-space: nowrap;
        }

        .sp-active {
            background: var(--emerald-bg);
            color: var(--emerald);
        }

        .sp-expired {
            background: var(--surface-3);
            color: var(--ink-4);
        }

        .usage-card {
            padding: 18px;
            border-top: 1px solid var(--surface-3);
            background: var(--surface-2);
        }

        .usage-meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 8px;
            font-size: 16px;
            color: var(--ink-4);
            font-weight: 700;
        }

            .usage-meta strong {
                color: var(--ink);
            }

        .usage-progress {
            width: 100%;
            height: 11px;
            background: var(--surface-3);
            border-radius: 30px;
            overflow: hidden;
        }

        .usage-progress-bar {
            height: 100%;
            background: var(--blue);
            border-radius: 30px;
            transition: width .3s ease;
        }

        .students-table-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            overflow: visible;
            box-shadow: var(--sh-sm);
            margin-bottom: 24px;
        }

        .students-table-topbar {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 11px 16px;
            border-bottom: 1px solid var(--surface-3);
            flex-wrap: wrap;
        }

        .table-section-title {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 18px;
            font-weight: 800;
            color: var(--ink);
            margin-left: 10px;
        }

            .table-section-title i {
                color: var(--blue);
            }

        .students-table-search-wrap {
            position: relative;
            flex: 1;
            min-width: 220px;
            max-width: 390px;
        }

            .students-table-search-wrap i {
                position: absolute;
                right: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--ink-4);
                font-size: 17px;
                pointer-events: none;
            }

            .students-table-search-wrap input {
                width: 100%;
                padding: 7px 32px 7px 12px;
                border: 1px solid var(--border);
                border-radius: var(--r-md);
                font-size: 18px;
                background: var(--surface-2);
                color: var(--ink);
                transition: border-color .15s, box-shadow .15s;
            }

                .students-table-search-wrap input:focus {
                    outline: none;
                    border-color: var(--blue-2);
                    box-shadow: 0 0 0 3px rgba(36,113,208,.1);
                    background: var(--surface);
                }

        .students-count-badge {
            margin-right: auto;
            font-size: 16px;
            color: var(--ink-4);
        }

            .students-count-badge strong {
                color: var(--blue);
                font-weight: 700;
            }

        .table-responsive-safe {
            width: 100%;
            overflow-x: auto;
            overflow-y: visible;
        }

        #periodStudentsTable {
            width: 100% !important;
            border-collapse: collapse;
        }

            #periodStudentsTable thead th {
                background: var(--surface-2) !important;
                padding: 11px 15px !important;
                font-size: 15px !important;
                font-weight: 700 !important;
                color: var(--ink-4) !important;
                text-transform: uppercase;
                letter-spacing: .05em;
                white-space: nowrap;
                border: none !important;
                text-align: center;
            }

            #periodStudentsTable tbody tr {
                border-bottom: 1px solid var(--surface-3);
                transition: background .1s;
            }

                #periodStudentsTable tbody tr:last-child {
                    border-bottom: none;
                }

                #periodStudentsTable tbody tr:hover {
                    background: #F5F8FD;
                }

            #periodStudentsTable td {
                padding: 11px 15px !important;
                vertical-align: middle !important;
                font-size: 18px !important;
                color: var(--ink-2);
                border: none !important;
                text-align: center;
            }

        .student-title-cell {
            display: flex;
            align-items: center;
            gap: 10px;
            text-align: right;
        }

        .student-avatar {
            width: 33px;
            height: 33px;
            border-radius: 50%;
            background: var(--blue-bg);
            color: var(--blue);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }

        .student-item-name {
            font-weight: 600;
            color: var(--ink);
            font-size: 18px;
        }

        .national-id-wrap {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            direction: ltr;
        }

        .copy-national-id-btn {
            width: 30px;
            height: 30px;
            min-width: 30px;
            border-radius: 8px;
            border: 1px solid #B6D3F4;
            background: var(--blue-bg);
            color: var(--blue);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            cursor: pointer;
            transition: all .15s ease;
        }

            .copy-national-id-btn:hover {
                background: var(--blue);
                color: #fff;
                border-color: var(--blue);
                transform: translateY(-1px);
            }

            .copy-national-id-btn.copied {
                background: var(--emerald);
                color: #fff;
                border-color: var(--emerald);
            }

        .id-chip,
        .date-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 11px;
            border-radius: 30px;
            font-size: 16px;
            font-weight: 700;
            white-space: nowrap;
        }

        .id-chip {
            background: var(--surface-3);
            color: var(--ink-3);
            direction: ltr;
        }

        .date-chip {
            background: var(--blue-bg);
            color: var(--blue);
            direction: ltr;
        }

        .learning-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 11px;
            border-radius: 30px;
            font-size: 16px;
            font-weight: 700;
            white-space: nowrap;
        }

        .lp-active {
            background: var(--emerald-bg);
            color: var(--emerald);
        }

        .lp-readonly {
            background: var(--amber-bg);
            color: var(--amber);
        }

        .dataTables_wrapper {
            direction: rtl;
            overflow: visible;
        }

            .dataTables_wrapper .dataTables_filter {
                display: none;
            }

            .dataTables_wrapper .dataTables_length,
            .dataTables_wrapper .dataTables_info {
                padding: 9px 16px;
                font-size: 16px;
                color: var(--ink-4);
            }

            .dataTables_wrapper .dataTables_paginate {
                padding: 9px 16px;
            }

                .dataTables_wrapper .dataTables_paginate .paginate_button {
                    border-radius: var(--r-sm) !important;
                    font-size: 16px !important;
                    padding: 4px 10px !important;
                    border: 1px solid var(--border) !important;
                    margin: 0 2px !important;
                    color: var(--ink-3) !important;
                }

                    .dataTables_wrapper .dataTables_paginate .paginate_button.current,
                    .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
                        background: var(--blue) !important;
                        border-color: var(--blue) !important;
                        color: #fff !important;
                    }

                    .dataTables_wrapper .dataTables_paginate .paginate_button:hover:not(.current):not(.disabled) {
                        background: var(--blue-bg) !important;
                        border-color: #B6D3F4 !important;
                        color: var(--blue) !important;
                    }

            .dataTables_wrapper .dataTables_length select {
                border: 1px solid var(--border);
                border-radius: var(--r-sm);
                padding: 3px 8px;
                font-size: 16px;
                color: var(--ink);
            }

        div.dataTables_wrapper div.dataTables_paginate,
        div.dataTables_wrapper div.dataTables_info,
        div.dataTables_wrapper div.dataTables_length {
            border-top: 1px solid var(--surface-3);
            background: var(--surface-2);
        }

        .students-empty {
            text-align: center;
            padding: 56px 16px;
            color: var(--ink-4);
        }

            .students-empty i {
                font-size: 20px;
                display: block;
                margin-bottom: 12px;
                color: var(--ink-5);
            }

        .students-empty-title {
            font-size: 18px;
            font-weight: 600;
            color: var(--ink-3);
        }

        .students-empty-sub {
            font-size: 16px;
            margin-top: 4px;
        }

        @@media (max-width: 768px) {
            .period-details-page {
                padding: 22px 14px 48px;
            }

            .top-actions {
                width: 100%;
            }

            .btn-secondary-action {
                width: 100%;
                justify-content: center;
            }

            .students-table-topbar {
                align-items: stretch;
            }

            .students-table-search-wrap {
                max-width: 100%;
                width: 100%;
            }

            .students-count-badge {
                margin-right: 0;
            }
        }
    </style>
}

<div class="period-details-page">

    <div class="period-details-topbar">
        <div class="period-details-brand">
            <div class="period-details-brand-icon">
                <i class="bi bi-calendar2-range-fill"></i>
            </div>

            <div>
                <div class="period-details-brand-title">تفاصيل فترة الاشتراك</div>
                <div class="period-details-brand-sub">
                    عرض بيانات الفترة والطلاب المسجلين داخلها.
                </div>
                <div class="partner-pill">
                    <i class="bi bi-building"></i>
                    @Model.PartnerName
                </div>
            </div>
        </div>

        <div class="top-actions">
            <a asp-action="Index"
               asp-route-subscriptionId="@Model.PeriodId"
               class="btn-secondary-action">
                <i class="bi bi-arrow-left"></i>
                رجوع لفترات الاشتراك
            </a>
        </div>
    </div>

    <div class="period-kpis">

        <div class="kpi-card kpi-blue">
            <div class="kpi-ico ico-blue">
                <i class="bi bi-calendar-event"></i>
            </div>
            <div>
                <div class="kpi-label">بداية الفترة</div>
                <div class="kpi-val">@Model.StartDate.ToString("yyyy/MM/dd")</div>
            </div>
        </div>

        <div class="kpi-card kpi-amber">
            <div class="kpi-ico ico-amber">
                <i class="bi bi-calendar-check"></i>
            </div>
            <div>
                <div class="kpi-label">نهاية الفترة</div>
                <div class="kpi-val">@Model.EndDate.ToString("yyyy/MM/dd")</div>
            </div>
        </div>

        <div class="kpi-card kpi-emerald">
            <div class="kpi-ico ico-emerald">
                <i class="bi bi-person-check"></i>
            </div>
            <div>
                <div class="kpi-label">تعلم مفعل</div>
                <div class="kpi-val">@activeStudents</div>
            </div>
        </div>

        <div class="kpi-card kpi-violet">
            <div class="kpi-ico ico-violet">
                <i class="bi bi-people"></i>
            </div>
            <div>
                <div class="kpi-label">الطلاب المسجلون</div>
                <div class="kpi-val">@Model.CurrentStudentsCount</div>
            </div>
        </div>

    </div>

    <div class="details-section-card">
        <div class="details-section-header">
            <i class="bi bi-info-circle"></i>
            بيانات الفترة
        </div>

        <div class="details-grid">

            <div class="detail-card">
                <div class="detail-label">
                    <i class="bi bi-calendar-event"></i>
                    البداية
                </div>
                <div class="detail-value">@Model.StartDate.ToString("yyyy/MM/dd")</div>
            </div>

            <div class="detail-card">
                <div class="detail-label">
                    <i class="bi bi-calendar-check"></i>
                    النهاية
                </div>
                <div class="detail-value">@Model.EndDate.ToString("yyyy/MM/dd")</div>
            </div>

            <div class="detail-card">
                <div class="detail-label">
                    <i class="bi bi-activity"></i>
                    الحالة
                </div>
                <div class="detail-value">
                    @if (Model.IsActive)
                    {
                        <span class="status-pill sp-active">
                            <i class="bi bi-check-circle"></i>
                            نشطة
                        </span>
                    }
                    else
                    {
                        <span class="status-pill sp-expired">
                            <i class="bi bi-x-circle"></i>
                            منتهية
                        </span>
                    }
                </div>
            </div>

            <div class="detail-card">
                <div class="detail-label">
                    <i class="bi bi-people"></i>
                    الحد الأقصى للطلاب
                </div>
                <div class="detail-value">@maxStudentsText</div>
            </div>

        </div>

        <div class="usage-card">
            <div class="usage-meta">
                <span>استخدام الفترة</span>
                <strong>
                    @Model.CurrentStudentsCount
                    @if (Model.MaxStudents.HasValue)
                    {
                        <span>/ @Model.MaxStudents.Value</span>
                    }
                    else
                    {
                        <span>/ غير محدود</span>
                    }
                </strong>
            </div>

            <div class="usage-progress">
                <div class="usage-progress-bar"
                     style="width:@(Model.MaxStudents.HasValue? Math.Min(usagePercentage, 100) : 100)%;">
                </div>
            </div>
        </div>
    </div>

    <div class="students-table-card">

        <div class="students-table-topbar">
            <div class="table-section-title">
                <i class="bi bi-table"></i>
                الطلاب المسجلون في هذه الفترة
            </div>

            <div class="students-table-search-wrap">
                <i class="bi bi-search"></i>
                <input type="text"
                       id="periodStudentsSearch"
                       placeholder="ابحث في الاسم أو الرقم القومي أو الحالة..." />
            </div>

            <div class="students-count-badge">
                إجمالي: <strong>@totalStudents</strong> طالب
            </div>
        </div>

        @if (!studentsList.Any())
        {
            <div class="students-empty">
                <i class="bi bi-inbox"></i>
                <div class="students-empty-title">لا يوجد طلاب مسجلون في هذه الفترة حتى الآن</div>
                <div class="students-empty-sub">ستظهر بيانات الطلاب هنا بعد التسجيل داخل الفترة</div>
            </div>
        }
        else
        {
            <div class="table-responsive-safe">
                <table id="periodStudentsTable">
                    <thead>
                        <tr>
                            <th style="text-align:right; width:34%">الاسم</th>
                            <th style="width:22%">الرقم القومي</th>
                            <th style="width:22%">تاريخ التسجيل</th>
                            <th style="width:22%">الحالة التعليمية</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var s in studentsList)
                        {
                            <tr>
                                <td style="text-align:right">
                                    <div class="student-title-cell">
                                        <div class="student-avatar">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        <span class="student-item-name">@s.FullName</span>
                                    </div>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(s.NationalId))
                                    {
                                        <div class="national-id-wrap">
                                            <button type="button"
                                                    class="copy-national-id-btn"
                                                    data-national-id="@s.NationalId"
                                                    title="نسخ الرقم القومي"
                                                    aria-label="نسخ الرقم القومي">
                                                <i class="bi bi-copy"></i>
                                            </button>

                                            <span class="id-chip">
                                                <i class="bi bi-credit-card-2-front"></i>
                                                @s.NationalId
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="id-chip">
                                            <i class="bi bi-credit-card-2-front"></i>
                                            —
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="date-chip">
                                        <i class="bi bi-calendar-event"></i>
                                        @s.RegistrationDate.ToString("yyyy/MM/dd")
                                    </span>
                                </td>

                                <td>
                                    @if (s.IsActiveForLearning)
                                    {
                                        <span class="learning-pill lp-active">
                                            <i class="bi bi-check-circle"></i>
                                            مفعّل
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="learning-pill lp-readonly">
                                            <i class="bi bi-eye"></i>
                                            قراءة فقط
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>

</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var tableElement = document.getElementById('periodStudentsTable');

            if (tableElement) {
                var table = $('#periodStudentsTable').DataTable({
                    language: {
                        url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json"
                    },
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "الكل"]],
                    order: [[0, "asc"]],
                    responsive: true,
                    stateSave: true,
                    dom: 'Brtip'
                });

                $('#periodStudentsSearch').on('input', function () {
                    table.search(this.value).draw();
                });
            }

            document.querySelectorAll(".copy-national-id-btn").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    var nationalId = this.getAttribute("data-national-id");

                    if (!nationalId) {
                        return;
                    }

                    if (navigator.clipboard && window.isSecureContext) {
                        navigator.clipboard.writeText(nationalId).then(() => {
                            markCopied(btn);
                        });
                    } else {
                        var tempInput = document.createElement("input");
                        tempInput.value = nationalId;
                        document.body.appendChild(tempInput);
                        tempInput.select();
                        document.execCommand("copy");
                        document.body.removeChild(tempInput);
                        markCopied(btn);
                    }
                });
            });

            function markCopied(btn) {
                var oldHtml = btn.innerHTML;

                btn.classList.add("copied");
                btn.innerHTML = '<i class="bi bi-check2"></i>';

                setTimeout(function () {
                    btn.classList.remove("copied");
                    btn.innerHTML = oldHtml;
                }, 1200);
            }
        });
    </script>
}