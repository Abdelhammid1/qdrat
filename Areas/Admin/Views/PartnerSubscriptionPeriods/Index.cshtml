@model QdratNew.ViewModels.PartnerSubscriptionPeriods.PartnerSubscriptionPeriodIndexViewModel

@{
    ViewData["Title"] = "فترات الاشتراك";

    var hasPeriods = Model.Periods != null && Model.Periods.Any();

    var totalPeriods = Model.Periods != null ? Model.Periods.Count() : 0;

    var totalMaxStudents = Model.Periods != null
        ? Model.Periods.Where(x => x.MaxStudents.HasValue).Sum(x => x.MaxStudents.Value)
        : 0;

    var activePeriods = Model.Periods != null
        ? Model.Periods.Count(x => !string.IsNullOrWhiteSpace(x.Status) && x.Status.Contains("نشط"))
        : 0;

    var inactivePeriods = totalPeriods - activePeriods;
}

@section Styles {
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        :root {
            --ink: #0D1B2A;
            --ink-2: #2C3E50;
            --ink-3: #5A6A7A;
            --ink-4: #8FA0B0;
            --ink-5: #C8D5E0;
            --canvas: #F3F6FA;
            --surface: #FFFFFF;
            --surface-2: #F8FAFC;
            --surface-3: #EEF2F7;
            --border: #DDE4EC;
            --blue: #1B5EAE;
            --blue-2: #2471D0;
            --blue-bg: #E8F1FB;
            --blue-dark: #103E7A;
            --emerald: #0D7A5B;
            --emerald-bg: #E4F5EE;
            --amber: #985D09;
            --amber-bg: #FDF0D8;
            --rose: #BF1030;
            --rose-bg: #FDEAEE;
            --violet: #5535B5;
            --violet-bg: #EDE8F9;
            --r-sm: 6px;
            --r-md: 10px;
            --r-lg: 14px;
            --r-xl: 20px;
            --sh-xs: 0 1px 3px rgba(13,27,42,.06);
            --sh-sm: 0 2px 8px rgba(13,27,42,.08);
            --sh-md: 0 4px 18px rgba(13,27,42,.10);
            --ease: cubic-bezier(.25,.46,.45,.94);
        }

        .periods-page {
            background: var(--canvas);
            min-height: 100vh;
            padding: 32px 28px 64px;
            direction: rtl;
            font-family: 'Cairo';
            color: var(--ink-2);
        }

        .periods-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 14px;
            margin-bottom: 28px;
        }

        .periods-brand {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .periods-brand-icon {
            width: 46px;
            height: 46px;
            background: var(--blue);
            border-radius: var(--r-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 18px;
            box-shadow: 0 4px 14px rgba(27,94,174,.28);
        }

        .periods-brand-title {
            font-size: 18px;
            font-weight: 700;
            color: var(--ink);
            line-height: 1.15;
        }

        .periods-brand-sub {
            font-size: 14px;
            color: var(--ink-4);
            margin-top: 2px;
        }

        .partner-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--violet-bg);
            color: var(--violet);
            padding: 5px 12px;
            border-radius: 30px;
            font-size: 14px;
            font-weight: 800;
            margin-top: 8px;
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn-main-action {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: var(--blue);
            color: #fff;
            border: none;
            border-radius: var(--r-md);
            padding: 10px 20px;
            font-size: 16px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            box-shadow: 0 3px 10px rgba(27,94,174,.28);
            transition: background .16s var(--ease), transform .14s, box-shadow .16s;
        }

            .btn-main-action:hover {
                background: var(--blue-dark);
                color: #fff;
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(27,94,174,.32);
            }

        .periods-alert {
            border: none;
            border-radius: var(--r-lg);
            padding: 14px 18px;
            font-size: 15px;
            font-weight: 700;
            box-shadow: var(--sh-xs);
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .periods-alert-success {
            background: var(--emerald-bg);
            color: var(--emerald);
        }

        .periods-alert-danger {
            background: var(--rose-bg);
            color: var(--rose);
        }

        .periods-alert-warning {
            background: var(--amber-bg);
            color: var(--amber);
            border: 1px solid #F3D494;
        }

        .periods-kpis {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 13px;
            margin-bottom: 24px;
        }

        @@media (max-width: 960px) {
            .periods-kpis {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 480px) {
            .periods-kpis {
                grid-template-columns: 1fr;
            }
        }

        .kpi-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            padding: 18px 19px;
            display: flex;
            align-items: center;
            gap: 13px;
            box-shadow: var(--sh-xs);
            transition: transform .2s var(--ease), box-shadow .2s;
            position: relative;
            overflow: hidden;
        }

            .kpi-card::after {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 4px;
                height: 100%;
                border-radius: 0 var(--r-xl) var(--r-xl) 0;
            }

            .kpi-card:hover {
                transform: translateY(-3px);
                box-shadow: var(--sh-sm);
            }

        .kpi-blue::after {
            background: var(--blue);
        }

        .kpi-emerald::after {
            background: var(--emerald);
        }

        .kpi-amber::after {
            background: var(--amber);
        }

        .kpi-rose::after {
            background: var(--rose);
        }

        .kpi-ico {
            width: 42px;
            height: 42px;
            border-radius: var(--r-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }

        .ico-blue {
            background: var(--blue-bg);
            color: var(--blue);
        }

        .ico-emerald {
            background: var(--emerald-bg);
            color: var(--emerald);
        }

        .ico-amber {
            background: var(--amber-bg);
            color: var(--amber);
        }

        .ico-rose {
            background: var(--rose-bg);
            color: var(--rose);
        }

        .kpi-label {
            font-size: 13px;
            font-weight: 700;
            color: var(--ink-4);
            letter-spacing: .04em;
            text-transform: uppercase;
            margin-bottom: 3px;
        }

        .kpi-val {
            font-size: 18px;
            font-weight: 700;
            color: var(--ink);
            line-height: 1;
        }

        .periods-table-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            overflow: visible;
            box-shadow: var(--sh-sm);
            margin-bottom: 24px;
        }

        .periods-table-topbar {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 11px 16px;
            border-bottom: 1px solid var(--surface-3);
            flex-wrap: wrap;
        }

        .table-section-title {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 16px;
            font-weight: 800;
            color: var(--ink);
            margin-left: 10px;
        }

            .table-section-title i {
                color: var(--blue);
            }

        .periods-table-search-wrap {
            position: relative;
            flex: 1;
            min-width: 220px;
            max-width: 390px;
        }

            .periods-table-search-wrap i {
                position: absolute;
                right: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--ink-4);
                font-size: 15px;
                pointer-events: none;
            }

            .periods-table-search-wrap input {
                width: 100%;
                padding: 7px 32px 7px 12px;
                border: 1px solid var(--border);
                border-radius: var(--r-md);
                font-size: 16px;
                background: var(--surface-2);
                color: var(--ink);
                transition: border-color .15s, box-shadow .15s;
            }

                .periods-table-search-wrap input:focus {
                    outline: none;
                    border-color: var(--blue-2);
                    box-shadow: 0 0 0 3px rgba(36,113,208,.1);
                    background: var(--surface);
                }

        .periods-count-badge {
            margin-right: auto;
            font-size: 14px;
            color: var(--ink-4);
        }

            .periods-count-badge strong {
                color: var(--blue);
                font-weight: 700;
            }

        .table-responsive-safe {
            width: 100%;
            overflow-x: auto;
            overflow-y: visible;
        }

        #periodsTable {
            width: 100% !important;
            border-collapse: collapse;
        }

            #periodsTable thead th {
                background: var(--surface-2) !important;
                padding: 11px 15px !important;
                font-size: 13px !important;
                font-weight: 700 !important;
                color: var(--ink-4) !important;
                text-transform: uppercase;
                letter-spacing: .05em;
                white-space: nowrap;
                border: none !important;
                text-align: center;
            }

            #periodsTable tbody tr {
                border-bottom: 1px solid var(--surface-3);
                transition: background .1s;
            }

                #periodsTable tbody tr:last-child {
                    border-bottom: none;
                }

                #periodsTable tbody tr:hover {
                    background: #F5F8FD;
                }

            #periodsTable td {
                padding: 11px 15px !important;
                vertical-align: middle !important;
                font-size: 16px !important;
                color: var(--ink-2);
                border: none !important;
                text-align: center;
            }

        .date-chip,
        .students-limit-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 11px;
            border-radius: 30px;
            font-size: 14px;
            font-weight: 700;
            white-space: nowrap;
        }

        .date-chip {
            background: var(--surface-3);
            color: var(--ink-3);
            direction: ltr;
        }

        .students-limit-chip {
            background: var(--blue-bg);
            color: var(--blue);
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 11px;
            border-radius: 30px;
            font-size: 14px;
            font-weight: 700;
            white-space: nowrap;
        }

        .sp-active {
            background: var(--emerald-bg);
            color: var(--emerald);
        }

        .sp-pending {
            background: var(--amber-bg);
            color: var(--amber);
        }

        .sp-expired {
            background: var(--surface-3);
            color: var(--ink-4);
        }

        .periods-act-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            flex-wrap: nowrap;
            position: relative;
            overflow: visible;
        }

        .act-btn {
            position: relative;
            width: 34px;
            height: 34px;
            min-width: 34px;
            padding: 0;
            border-radius: var(--r-sm);
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            border: 1.5px solid transparent;
            cursor: pointer;
            background: transparent;
            transition: all .15s;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            overflow: visible;
        }

            .act-btn i {
                margin: 0;
                font-size: 13px;
                line-height: 1;
            }

            .act-btn .act-text {
                position: absolute;
                bottom: calc(100% + 8px);
                right: 50%;
                transform: translateX(50%) translateY(4px);
                background: var(--ink);
                color: #fff;
                font-size: 11px;
                font-weight: 600;
                padding: 5px 9px;
                border-radius: 6px;
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
                transition: opacity .15s ease, transform .15s ease, visibility .15s ease;
                z-index: 9999;
                box-shadow: 0 4px 12px rgba(13,27,42,.18);
                min-width: max-content;
            }

                .act-btn .act-text::after {
                    content: "";
                    position: absolute;
                    top: 100%;
                    right: 50%;
                    transform: translateX(50%);
                    border-width: 5px;
                    border-style: solid;
                    border-color: var(--ink) transparent transparent transparent;
                }

            .act-btn:hover .act-text {
                opacity: 1;
                visibility: visible;
                transform: translateX(50%) translateY(0);
            }

        .act-view {
            background: var(--blue-bg);
            color: var(--blue);
            border-color: #B6D3F4;
        }

            .act-view:hover {
                background: var(--blue);
                color: #fff;
                border-color: var(--blue);
            }

        .act-students {
            background: var(--emerald-bg);
            color: var(--emerald);
            border-color: #B8E8D3;
        }

            .act-students:hover {
                background: var(--emerald);
                color: #fff;
                border-color: var(--emerald);
            }

        .act-edit {
            background: var(--surface-3);
            color: var(--ink-3);
            border-color: var(--border);
        }

            .act-edit:hover {
                background: var(--ink-3);
                color: #fff;
                border-color: var(--ink-3);
            }

        .dataTables_wrapper {
            direction: rtl;
            overflow: visible;
        }

            .dataTables_wrapper .dataTables_filter {
                display: none;
            }

            .dataTables_wrapper .dataTables_length,
            .dataTables_wrapper .dataTables_info {
                padding: 9px 16px;
                font-size: 14px;
                color: var(--ink-4);
            }

            .dataTables_wrapper .dataTables_paginate {
                padding: 9px 16px;
            }

                .dataTables_wrapper .dataTables_paginate .paginate_button {
                    border-radius: var(--r-sm) !important;
                    font-size: 14px !important;
                    padding: 4px 10px !important;
                    border: 1px solid var(--border) !important;
                    margin: 0 2px !important;
                    color: var(--ink-3) !important;
                }

                    .dataTables_wrapper .dataTables_paginate .paginate_button.current,
                    .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
                        background: var(--blue) !important;
                        border-color: var(--blue) !important;
                        color: #fff !important;
                    }

                    .dataTables_wrapper .dataTables_paginate .paginate_button:hover:not(.current):not(.disabled) {
                        background: var(--blue-bg) !important;
                        border-color: #B6D3F4 !important;
                        color: var(--blue) !important;
                    }

            .dataTables_wrapper .dataTables_length select {
                border: 1px solid var(--border);
                border-radius: var(--r-sm);
                padding: 3px 8px;
                font-size: 14px;
                color: var(--ink);
            }

        div.dataTables_wrapper div.dataTables_paginate,
        div.dataTables_wrapper div.dataTables_info,
        div.dataTables_wrapper div.dataTables_length {
            border-top: 1px solid var(--surface-3);
            background: var(--surface-2);
        }

        .periods-empty {
            text-align: center;
            padding: 56px 16px;
            color: var(--ink-4);
        }

            .periods-empty i {
                font-size: 18px;
                display: block;
                margin-bottom: 12px;
                color: var(--ink-5);
            }

        .periods-empty-title {
            font-size: 16px;
            font-weight: 600;
            color: var(--ink-3);
        }

        .periods-empty-sub {
            font-size: 14px;
            margin-top: 4px;
        }

        @@media (max-width: 768px) {
            .periods-page {
                padding: 22px 14px 48px;
            }

            .top-actions {
                width: 100%;
            }

            .btn-main-action {
                width: 100%;
                justify-content: center;
            }

            .periods-table-topbar {
                align-items: stretch;
            }

            .periods-table-search-wrap {
                max-width: 100%;
                width: 100%;
            }

            .periods-count-badge {
                margin-right: 0;
            }
        }
    </style>
}

<div class="periods-page">

    @if (TempData["Success"] != null)
    {
        <div class="periods-alert periods-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="periods-alert periods-alert-danger">
            <i class="bi bi-exclamation-circle-fill"></i>
            @TempData["Error"]
        </div>
    }

    <div class="periods-topbar">
        <div class="periods-brand">
            <div class="periods-brand-icon">
                <i class="bi bi-calendar2-range-fill"></i>
            </div>
            <div>
                <div class="periods-brand-title">فترات الاشتراك</div>
                <div class="periods-brand-sub">
                    إدارة الفترات الزمنية وحد الطلاب داخل عقد الشراكة.
                </div>
                <div class="partner-pill">
                    <i class="bi bi-building"></i>
                    @Model.PartnerName
                </div>
            </div>
        </div>

        <div class="top-actions">
            <a asp-action="Create"
               asp-route-subscriptionId="@Model.SubscriptionId"
               class="btn-main-action">
                <i class="bi bi-plus-circle"></i>
                إضافة فترة جديدة
            </a>
        </div>
    </div>

    <div class="periods-kpis">

        <div class="kpi-card kpi-blue">
            <div class="kpi-ico ico-blue">
                <i class="bi bi-calendar2-range"></i>
            </div>
            <div>
                <div class="kpi-label">إجمالي الفترات</div>
                <div class="kpi-val">@totalPeriods</div>
            </div>
        </div>

        <div class="kpi-card kpi-emerald">
            <div class="kpi-ico ico-emerald">
                <i class="bi bi-check-circle"></i>
            </div>
            <div>
                <div class="kpi-label">فترات نشطة</div>
                <div class="kpi-val">@activePeriods</div>
            </div>
        </div>

        <div class="kpi-card kpi-amber">
            <div class="kpi-ico ico-amber">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div>
                <div class="kpi-label">غير نشطة</div>
                <div class="kpi-val">@inactivePeriods</div>
            </div>
        </div>

        <div class="kpi-card kpi-rose">
            <div class="kpi-ico ico-rose">
                <i class="bi bi-people"></i>
            </div>
            <div>
                <div class="kpi-label">حد الطلاب</div>
                <div class="kpi-val">@(totalMaxStudents > 0 ? totalMaxStudents.ToString() : "غير محدد")</div>
            </div>
        </div>

    </div>

    @if (!hasPeriods)
    {
        <div class="periods-alert periods-alert-warning">
            <i class="bi bi-exclamation-triangle-fill"></i>
            لا توجد فترات اشتراك مسجلة لهذا العقد.
        </div>

        <div class="periods-table-card">
            <div class="periods-empty">
                <i class="bi bi-inbox"></i>
                <div class="periods-empty-title">لا توجد فترات اشتراك</div>
                <div class="periods-empty-sub">يمكنك إضافة فترة جديدة من أعلى الصفحة</div>
            </div>
        </div>
    }
    else
    {
        <div class="periods-table-card">

            <div class="periods-table-topbar">
                <div class="table-section-title">
                    <i class="bi bi-table"></i>
                    قائمة فترات الاشتراك
                </div>

                <div class="periods-table-search-wrap">
                    <i class="bi bi-search"></i>
                    <input type="text"
                           id="periodsSearch"
                           placeholder="ابحث في التاريخ أو الحالة أو حد الطلاب..." />
                </div>

                <div class="periods-count-badge">
                    إجمالي: <strong>@totalPeriods</strong> فترة
                </div>
            </div>

            <div class="table-responsive-safe">
                <table id="periodsTable">
                    <thead>
                        <tr>
                            <th style="width:18%">من</th>
                            <th style="width:18%">إلى</th>
                            <th style="width:18%">حد الطلاب</th>
                            <th style="width:22%">الحالة</th>
                            <th style="width:24%">الإجراءات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var p in Model.Periods)
                        {
                            var isActive = !string.IsNullOrWhiteSpace(p.Status) && p.Status.Contains("نشط");
                            var isExpired = !string.IsNullOrWhiteSpace(p.Status) && (p.Status.Contains("منتهي") || p.Status.Contains("منتهية"));

                            <tr>
                                <td>
                                    <span class="date-chip">
                                        <i class="bi bi-calendar-event"></i>
                                        @p.StartDate.ToString("yyyy/MM/dd")
                                    </span>
                                </td>

                                <td>
                                    <span class="date-chip">
                                        <i class="bi bi-calendar-check"></i>
                                        @p.EndDate.ToString("yyyy/MM/dd")
                                    </span>
                                </td>

                                <td>
                                    <span class="students-limit-chip">
                                        <i class="bi bi-people"></i>
                                        @(p.MaxStudents.HasValue? p.MaxStudents.Value.ToString() : "غير محدد")
                                    </span>
                                </td>

                                <td>
                                    @if (isActive)
                                    {
                                        <span class="status-pill sp-active">
                                            <i class="bi bi-check-circle"></i>
                                            @p.Status
                                        </span>
                                    }
                                    else if (isExpired)
                                    {
                                        <span class="status-pill sp-expired">
                                            <i class="bi bi-x-circle"></i>
                                            @p.Status
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill sp-pending">
                                            <i class="bi bi-hourglass-split"></i>
                                            @p.Status
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="periods-act-row">

                                        <a asp-action="Details"
                                           asp-route-id="@p.Id"
                                           class="act-btn act-view"
                                           aria-label="تفاصيل">
                                            <i class="bi bi-eye"></i>
                                            <span class="act-text">تفاصيل</span>
                                        </a>

                                        <a asp-action="Students"
                                           asp-route-periodId="@p.Id"
                                           class="act-btn act-students"
                                           aria-label="الطلاب">
                                            <i class="bi bi-people"></i>
                                            <span class="act-text">الطلاب</span>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@p.Id"
                                           class="act-btn act-edit"
                                           aria-label="تعديل">
                                            <i class="bi bi-pencil-square"></i>
                                            <span class="act-text">تعديل</span>
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    }

</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var tableElement = document.getElementById('periodsTable');

            if (tableElement) {
                var table = $('#periodsTable').DataTable({
                    language: {
                        url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json"
                    },
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "الكل"]],
                    order: [[1, "desc"]],
                    responsive: true,
                    stateSave: true,
                    dom: 'Brtip',
                    columnDefs: [
                        { orderable: false, targets: [4] }
                    ]
                });

                $('#periodsSearch').on('input', function () {
                    table.search(this.value).draw();
                });
            }
        });
    </script>
}