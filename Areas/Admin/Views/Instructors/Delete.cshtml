@model QdratNew.ViewModels.Instructor.InstructorViewModel

@{
    ViewData["Title"] = "تأكيد حذف المدرب";
}

<div class="container" dir="rtl">
    <h2 class="text-danger mb-4"><i class="fas fa-trash-alt"></i> حذف المدرب</h2>

    <div class="alert alert-danger">
        <i class="fas fa-exclamation-triangle me-2"></i>
        هل أنت متأكد أنك تريد حذف المدرب التالي؟
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label">الاسم الكامل:</label>
            <p class="form-control-plaintext">@Model.FullName</p>
        </div>
        <div class="col-md-6">
            <label class="form-label">البريد الإلكتروني:</label>
            <p class="form-control-plaintext">@Model.Email</p>
        </div>
    </div>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger"><i class="fas fa-trash-alt"></i> تأكيد الحذف</button>
        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> إلغاء</a>
    </form>
</div>
