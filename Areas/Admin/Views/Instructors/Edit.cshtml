@model QdratNew.ViewModels.Instructor.InstructorViewModel

@{
    ViewData["Title"] = "تعديل بيانات مدرب";
}

<div class="qdrat-page-wrapper" dir="rtl">
    <div class="qdrat-page-header">
        <div>
            <h1 class="qdrat-page-title">
                <i class="fas fa-user-edit"></i>
                تعديل بيانات مدرب
            </h1>
            <p class="qdrat-page-subtitle">
                تحديث بيانات المدرب وربطه بحساب المستخدم الصحيح دون تغيير سلوك الحفظ الحالي.
            </p>
        </div>

        <a asp-action="Index" class="qdrat-back-btn">
            <i class="fas fa-arrow-right"></i>
            العودة للقائمة
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="qdrat-error-panel">
            <strong>
                <i class="fas fa-exclamation-triangle"></i>
                يوجد أخطاء في الحقول:
            </strong>
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="Edit" method="post" class="qdrat-form-card">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div class="qdrat-card-header">
            <div class="qdrat-card-icon">
                <i class="fas fa-chalkboard-teacher"></i>
            </div>
            <div>
                <h2>بيانات المدرب</h2>
                <p>راجع البيانات الحالية وعدّل المطلوب فقط.</p>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="qdrat-validation-summary"></div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-id-card"></i>
                البيانات الأساسية
            </div>

            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="FullName" class="qdrat-label">
                            الاسم الكامل
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-user"></i>
                            <input asp-for="FullName" class="form-control qdrat-input" placeholder="أدخل الاسم الكامل للمدرب" />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="NationalID" class="qdrat-label">
                            رقم الهوية الوطنية
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-address-card"></i>
                            <input asp-for="NationalID" class="form-control qdrat-input" inputmode="numeric" placeholder="أدخل رقم الهوية الوطنية" />
                        </div>
                        <span asp-validation-for="NationalID" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="UserId" class="qdrat-label">
                            المستخدم المرتبط بحساب المدرب
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper qdrat-select-wrapper">
                            <i class="fas fa-user-shield"></i>
                            <select asp-for="UserId" asp-items="Model.Users" class="form-control qdrat-input qdrat-select"></select>
                        </div>
                        <span asp-validation-for="UserId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="Gender" class="qdrat-label">
                            الجنس
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper qdrat-select-wrapper">
                            <i class="fas fa-venus-mars"></i>
                            <select asp-for="Gender" class="form-control qdrat-input qdrat-select" asp-items="Model.Genders">
                                <option value="">-- اختر الجنس --</option>
                            </select>
                        </div>
                        <span asp-validation-for="Gender" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-phone-alt"></i>
                بيانات التواصل
            </div>

            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="qdrat-form-group">
                        <label asp-for="Email" class="qdrat-label">البريد الإلكتروني</label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-envelope"></i>
                            <input asp-for="Email" class="form-control qdrat-input" placeholder="example@email.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="qdrat-form-group">
                        <label asp-for="PhoneNumber" class="qdrat-label">رقم الهاتف</label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-phone"></i>
                            <input asp-for="PhoneNumber" class="form-control qdrat-input" inputmode="tel" placeholder="05xxxxxxxx" />
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="qdrat-form-group">
                        <label asp-for="WhatsAppNumber" class="qdrat-label">رقم الواتساب</label>
                        <div class="qdrat-input-wrapper">
                            <i class="fab fa-whatsapp"></i>
                            <input asp-for="WhatsAppNumber" class="form-control qdrat-input" inputmode="tel" placeholder="05xxxxxxxx" />
                        </div>
                        <span asp-validation-for="WhatsAppNumber" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-briefcase"></i>
                بيانات العمل
            </div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="qdrat-form-group">
                        <label asp-for="Specialization" class="qdrat-label">
                            التخصص
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-layer-group"></i>
                            <input asp-for="Specialization" class="form-control qdrat-input" placeholder="مثال: كمي، لفظي، رياضيات..." />
                        </div>
                        <span asp-validation-for="Specialization" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="qdrat-status-card">
                        <div class="qdrat-switch-content">
                            <span class="qdrat-switch-title">حالة المدرب</span>
                            <small>عند التفعيل يظهر المدرب ضمن القوائم التشغيلية.</small>
                        </div>
                        <div class="form-check form-switch qdrat-switch">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">نشط</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-actions">
            <button type="submit" class="qdrat-save-btn">
                <i class="fas fa-save"></i>
                حفظ التعديلات
            </button>

            <a asp-action="Index" class="qdrat-cancel-btn">
                <i class="fas fa-times"></i>
                عودة للقائمة
            </a>
        </div>
    </form>
</div>

<style>
    .qdrat-page-wrapper {
        max-width: 1180px;
        margin: 0 auto;
        padding: 24px 16px 40px;
        font-family: 'Cairo', 'Tajawal', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .qdrat-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 22px;
        padding: 22px 24px;
        border-radius: 24px;
        background: linear-gradient(135deg, #0f766e 0%, #0891b2 55%, #2563eb 100%);
        color: #fff;
        box-shadow: 0 18px 45px rgba(15, 118, 110, 0.22);
    }

    .qdrat-page-title {
        margin: 0;
        font-size: 26px;
        font-weight: 900;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .qdrat-page-subtitle {
        margin: 8px 0 0;
        color: rgba(255, 255, 255, 0.88);
        font-size: 14px;
        line-height: 1.8;
    }

    .qdrat-back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 150px;
        padding: 11px 18px;
        border-radius: 999px;
        color: #fff;
        text-decoration: none;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.32);
        font-size: 14px;
        font-weight: 800;
        transition: all 0.2s ease-in-out;
    }

        .qdrat-back-btn:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.24);
            transform: translateY(-1px);
        }

    .qdrat-error-panel {
        margin-bottom: 20px;
        padding: 16px 18px;
        border-radius: 18px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
        font-size: 14px;
        font-weight: 800;
    }

        .qdrat-error-panel strong {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
        }

        .qdrat-error-panel ul {
            margin: 0;
            padding-right: 22px;
            line-height: 1.9;
        }

    .qdrat-form-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 26px;
        box-shadow: 0 20px 55px rgba(15, 23, 42, 0.08);
        padding: 26px;
        overflow: hidden;
    }

    .qdrat-card-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding-bottom: 22px;
        border-bottom: 1px solid #eef2f7;
        margin-bottom: 24px;
    }

    .qdrat-card-icon {
        width: 54px;
        height: 54px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #ecfeff 0%, #dbeafe 100%);
        color: #0f766e;
        font-size: 22px;
        flex-shrink: 0;
    }

    .qdrat-card-header h2 {
        margin: 0;
        font-size: 20px;
        font-weight: 900;
        color: #111827;
    }

    .qdrat-card-header p {
        margin: 6px 0 0;
        color: #6b7280;
        font-size: 13px;
    }

    .qdrat-section {
        padding: 20px;
        border: 1px solid #eef2f7;
        background: #fbfdff;
        border-radius: 22px;
        margin-bottom: 20px;
    }

    .qdrat-section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 18px;
        color: #0f172a;
        font-size: 16px;
        font-weight: 900;
    }

        .qdrat-section-title i {
            color: #0f766e;
        }

    .qdrat-label {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 9px;
        color: #1f2937;
        font-size: 14px;
        font-weight: 900;
    }

    .qdrat-required {
        color: #dc2626;
        font-weight: 900;
    }

    .qdrat-input-wrapper {
        position: relative;
    }

        .qdrat-input-wrapper i {
            position: absolute;
            top: 50%;
            right: 15px;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 15px;
            z-index: 2;
            pointer-events: none;
        }

    .qdrat-input {
        height: 48px;
        border-radius: 16px;
        border: 1px solid #dbe3ef;
        background: #fff;
        padding: 10px 44px 10px 14px;
        color: #111827;
        font-size: 14px;
        font-weight: 700;
        transition: all 0.18s ease-in-out;
    }

    .qdrat-select {
        cursor: pointer;
        appearance: auto;
    }

    .qdrat-input:focus {
        border-color: #0f766e;
        box-shadow: 0 0 0 4px rgba(15, 118, 110, 0.10);
    }

    .qdrat-validation-summary {
        color: #b91c1c;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 16px;
        padding: 12px 16px;
        margin-bottom: 20px;
        font-size: 14px;
        font-weight: 700;
    }

        .qdrat-validation-summary:empty {
            display: none;
        }

    .qdrat-status-card {
        min-height: 92px;
        height: 100%;
        padding: 16px;
        border-radius: 18px;
        background: linear-gradient(135deg, #f8fafc 0%, #eef6ff 100%);
        border: 1px dashed #bfdbfe;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
    }

    .qdrat-switch-content {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .qdrat-switch-title {
        color: #0f172a;
        font-size: 14px;
        font-weight: 900;
    }

    .qdrat-switch-content small {
        color: #64748b;
        font-size: 12px;
        line-height: 1.7;
    }

    .qdrat-switch {
        display: flex;
        align-items: center;
        gap: 8px;
        padding-right: 0;
        margin: 0;
        white-space: nowrap;
    }

        .qdrat-switch .form-check-input {
            width: 48px;
            height: 24px;
            margin: 0;
            cursor: pointer;
        }

        .qdrat-switch .form-check-label {
            color: #0f766e;
            font-size: 13px;
            font-weight: 900;
        }

    .qdrat-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding-top: 8px;
        flex-wrap: wrap;
    }

    .qdrat-save-btn,
    .qdrat-cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-width: 170px;
        min-height: 48px;
        border-radius: 999px;
        font-size: 15px;
        font-weight: 900;
        text-decoration: none;
        border: none;
        transition: all 0.2s ease-in-out;
    }

    .qdrat-save-btn {
        color: #fff;
        background: linear-gradient(135deg, #2563eb 0%, #0f766e 100%);
        box-shadow: 0 14px 30px rgba(37, 99, 235, 0.22);
    }

        .qdrat-save-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 18px 34px rgba(37, 99, 235, 0.28);
        }

    .qdrat-cancel-btn {
        color: #334155;
        background: #fff;
        border: 1px solid #cbd5e1;
    }

        .qdrat-cancel-btn:hover {
            color: #0f172a;
            background: #f8fafc;
            transform: translateY(-1px);
        }

    @@media (max-width: 768px) {
        .qdrat-page-header {
            flex-direction: column;
            align-items: stretch;
            padding: 20px;
        }

        .qdrat-page-title {
            font-size: 21px;
        }

        .qdrat-back-btn {
            width: 100%;
        }

        .qdrat-form-card {
            padding: 18px;
            border-radius: 22px;
        }

        .qdrat-section {
            padding: 16px;
        }

        .qdrat-status-card {
            flex-direction: column;
            align-items: flex-start;
        }

        .qdrat-actions {
            flex-direction: column;
        }

        .qdrat-save-btn,
        .qdrat-cancel-btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
