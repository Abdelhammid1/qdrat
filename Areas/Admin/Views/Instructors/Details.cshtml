@model QdratNew.ViewModels.Instructor.InstructorDetailsDashboardViewModel

@{
    ViewData["Title"] = "تفاصيل المدرب";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var ringCircumference = 251.2;
    var safeActivityScore = Model.ActivityScore < 0 ? 0 : Model.ActivityScore > 100 ? 100 : Model.ActivityScore;
    var ringOffset = ringCircumference * (1 - (safeActivityScore / 100.0));
}

<div class="instructor-details-page" dir="rtl">

    <nav class="instructor-topnav">
        <div class="nav-brand">
            <span class="nav-logo">قدرات</span>
            <div class="nav-sep"></div>
            <div class="nav-breadcrumb">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index">لوحة التحكم</a>
                <span>›</span>
                <a asp-area="Admin" asp-controller="Instructors" asp-action="Index">المدربون</a>
                <span>›</span>
                <span class="current">@Model.FullName</span>
            </div>
        </div>

        <div class="nav-actions">
            <a class="nav-btn" asp-area="Admin" asp-controller="Instructors" asp-action="Index">↩ رجوع</a>
            <button type="button" class="nav-btn">⬇ تصدير PDF</button>
            <button type="button" class="nav-btn">✉ إرسال تقرير</button>
            <a class="nav-btn primary" asp-area="Admin" asp-controller="Instructors" asp-action="Edit" asp-route-id="@Model.Id">⚙ تعديل المدرب</a>
        </div>
    </nav>

    <div class="instructor-page">

        <section class="instructor-hero instructor-fade d1">
            <div class="hero-content">
                <div class="hero-left">
                    <div class="hero-avatar">@Model.AvatarText</div>

                    <div class="hero-info">
                        <h1>@Model.FullName</h1>

                        <div class="hero-meta">
                            <span class="hero-tag @(Model.IsActive ? "active" : "danger")">● @Model.StatusText</span>
                            <span class="hero-tag info">@Model.Specialization</span>
                            <span class="hero-tag info">@Model.GenderText</span>
                            <span class="hero-tag neutral">@Model.BatchesCount دفعات</span>
                            <span class="hero-tag neutral">@Model.StudentsCount طالب</span>
                            <span class="hero-tag neutral">@Model.LecturesThisMonth محاضرة هذا الشهر</span>
                        </div>

                        <p class="hero-desc">
                            ملف تشغيلي وتحليلي للمدرب يعرض أثره داخل الدفعات، انتظام المحاضرات، حضور الطلاب، نتائج الاختبارات، الواجبات، والطلاب الذين يحتاجون متابعة.
                        </p>

                        <div class="contact-grid">
                            <div class="contact-item">
                                <span>البريد</span>
                                <strong>@(string.IsNullOrWhiteSpace(Model.Email) ? "غير محدد" : Model.Email)</strong>
                            </div>

                            <div class="contact-item">
                                <span>الجوال</span>
                                <strong>@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "غير محدد" : Model.PhoneNumber)</strong>
                            </div>

                            <div class="contact-item">
                                <span>واتساب</span>
                                <strong>@(string.IsNullOrWhiteSpace(Model.WhatsAppNumber) ? "غير محدد" : Model.WhatsAppNumber)</strong>
                            </div>

                            <div class="contact-item">
                                <span>الهوية</span>
                                <strong>@(string.IsNullOrWhiteSpace(Model.NationalID) ? "غير محدد" : Model.NationalID)</strong>
                            </div>
                        </div>

                        <div class="hero-actions">
                            <button type="button" class="hbtn outline">📊 تقرير مفصل</button>
                            <button type="button" class="hbtn solid-blue">✉ مراسلة المدرب</button>
                            <button type="button" class="hbtn solid-amber">⚠ متابعة تشغيلية</button>
                            <button type="button" class="hbtn solid-red">🚨 إجراء عاجل</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="activity-ring-wrap">
                <div class="activity-ring">
                    <svg viewBox="0 0 100 100" aria-hidden="true">
                        <circle class="ring-bg" cx="50" cy="50" r="40"></circle>
                        <circle class="ring-fill"
                                cx="50"
                                cy="50"
                                r="40"
                                stroke="@(safeActivityScore >= 85 ? "#059669" : safeActivityScore >= 70 ? "#2563eb" : safeActivityScore >= 55 ? "#d97706" : "#dc2626")"
                                stroke-dasharray="251.2"
                                stroke-dashoffset="@ringOffset.ToString("0.##")"></circle>
                    </svg>
                    <div class="ring-val">
                        @safeActivityScore.ToString("0")
                        <small>%</small>
                    </div>
                </div>

                <div class="activity-label">
                    مؤشر نشاط المدرب
                    <span class="@Model.ActivityCssClass">@Model.ActivityLabel</span>
                </div>
            </div>
        </section>

        <section class="kpi-strip">
            <article class="kpi-card b instructor-fade d1">
                <div class="kpi-icon b">🏫</div>
                <div class="kpi-val">@Model.BatchesCount</div>
                <div class="kpi-label">دفعات مرتبطة</div>
                <div class="kpi-delta eq">من خلال محاضرات المدرب</div>
            </article>

            <article class="kpi-card t instructor-fade d2">
                <div class="kpi-icon t">👥</div>
                <div class="kpi-val">@Model.StudentsCount</div>
                <div class="kpi-label">طلاب ضمن نطاقه</div>
                <div class="kpi-delta eq">طلاب دفعاته الحالية</div>
            </article>

            <article class="kpi-card g instructor-fade d3">
                <div class="kpi-icon g">✅</div>
                <div class="kpi-val">@Model.AttendancePercent.ToString("0")<sup>%</sup></div>
                <div class="kpi-label">حضور الطلاب</div>
                <div class="kpi-delta @(Model.AttendancePercent >= 85 ? "up" : "dn")">@Model.AttendanceDeltaText</div>
            </article>

            <article class="kpi-card p instructor-fade d4">
                <div class="kpi-icon p">🧪</div>
                <div class="kpi-val">@Model.ExamAverageScore.ToString("0")<sup>%</sup></div>
                <div class="kpi-label">متوسط الاختبارات</div>
                <div class="kpi-delta @(Model.ExamAverageScore >= 80 ? "up" : "dn")">@Model.ExamDeltaText</div>
            </article>

            <article class="kpi-card a instructor-fade d5">
                <div class="kpi-icon a">📝</div>
                <div class="kpi-val">@Model.HomeworkSubmissionPercent.ToString("0")<sup>%</sup></div>
                <div class="kpi-label">تسليم الواجبات</div>
                <div class="kpi-delta @(Model.HomeworkSubmissionPercent >= 90 ? "up" : "dn")">@Model.HomeworkDeltaText</div>
            </article>

            <article class="kpi-card r instructor-fade d6">
                <div class="kpi-icon r">📅</div>
                <div class="kpi-val">@Model.LecturesThisWeek</div>
                <div class="kpi-label">محاضرات هذا الأسبوع</div>
                <div class="kpi-delta eq">@Model.LecturesThisMonth محاضرة هذا الشهر</div>
            </article>
        </section>

        <section class="main-grid">

            <div class="left-stack">

                <section class="dash-card instructor-fade d2">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent blue"></div>
                            <div>
                                <div class="ch-title">أداء الدفعات المرتبطة بالمدرب</div>
                                <div class="ch-sub">@Model.Batches.Count دفعات لها محاضرات مع هذا المدرب</div>
                            </div>
                        </div>
                        <a class="card-link" asp-area="Admin" asp-controller="Batches" asp-action="Index">إدارة الدفعات ←</a>
                    </div>

                    <div class="batch-grid">
                        @if (Model.Batches.Any())
                        {
                            foreach (var batch in Model.Batches)
                            {
                                var safeHealth = batch.HealthScore < 0 ? 0 : batch.HealthScore > 100 ? 100 : batch.HealthScore;
                                var safeAttendance = batch.AttendancePercent < 0 ? 0 : batch.AttendancePercent > 100 ? 100 : batch.AttendancePercent;

                                <a class="batch-card @batch.HealthCssClass" asp-area="Admin" asp-controller="Batches" asp-action="Details" asp-route-id="@batch.BatchId">
                                    <div class="batch-top">
                                        <strong>@batch.BatchName</strong>
                                        <span>@safeHealth.ToString("0")%</span>
                                    </div>

                                    <div class="mini-meter">
                                        <div class="mini-meter-fill" style="width:@safeHealth.ToString("0")%"></div>
                                    </div>

                                    <div class="batch-metrics">
                                        <span>طلاب: @batch.StudentsCount</span>
                                        <span>محاضرات: @batch.LecturesCount</span>
                                        <span>حضور: @safeAttendance.ToString("0")%</span>
                                        <span>اختبارات: @batch.ExamAverageScore.ToString("0")%</span>
                                    </div>

                                    <p>@batch.DecisionHint</p>
                                </a>
                            }
                        }
                        else
                        {
                            <div class="empty full">لا توجد دفعات مرتبطة بمحاضرات هذا المدرب.</div>
                        }
                    </div>
                </section>

                <section class="dash-card instructor-fade d3">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent teal"></div>
                            <div>
                                <div class="ch-title">آخر المحاضرات</div>
                                <div class="ch-sub">@Model.RecentLectures.Count محاضرات حديثة مع نسب الحضور</div>
                            </div>
                        </div>
                        <button type="button" class="card-link">عرض كل المحاضرات ←</button>
                    </div>

                    <div class="lecture-list">
                        @if (Model.RecentLectures.Any())
                        {
                            foreach (var lecture in Model.RecentLectures)
                            {
                                var safeAttendance = lecture.AttendancePercent < 0 ? 0 : lecture.AttendancePercent > 100 ? 100 : lecture.AttendancePercent;

                                <div class="lecture-row @lecture.StatusCssClass">
                                    <div class="lecture-date">
                                        <strong>@lecture.Date.ToString("dd")</strong>
                                        <span>@lecture.Date.ToString("MM/yyyy")</span>
                                    </div>

                                    <div class="lecture-main">
                                        <strong>@lecture.Title</strong>
                                        <span>@lecture.BatchName • @lecture.Date.ToString("hh:mm tt")</span>
                                    </div>

                                    <div class="lecture-attendance">
                                        <span>@lecture.PresentCount / @lecture.TotalCount</span>
                                        <div class="lecture-meter">
                                            <div style="width:@safeAttendance.ToString("0")%"></div>
                                        </div>
                                    </div>

                                    <span class="lecture-status @lecture.StatusCssClass">@lecture.StatusText</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty">لا توجد محاضرات سابقة لهذا المدرب.</div>
                        }
                    </div>
                </section>

                <section class="dash-card instructor-fade d4">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent purple"></div>
                            <div>
                                <div class="ch-title">أثر الاختبارات</div>
                                <div class="ch-sub">@Model.Exams.Count اختبارات أنشأها المدرب ظاهرة في التقرير</div>
                            </div>
                        </div>
                        <a class="card-link" asp-area="Admin" asp-controller="ExamAssignments" asp-action="Index">إدارة الاختبارات ←</a>
                    </div>

                    <div class="table-wrap">
                        <table class="impact-table">
                            <thead>
                                <tr>
                                    <th style="width:32%">الاختبار</th>
                                    <th>الدفعة</th>
                                    <th>المشاركة</th>
                                    <th>المتوسط</th>
                                    <th>الحالة</th>
                                    <th>التاريخ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Exams.Any())
                                {
                                    foreach (var exam in Model.Exams)
                                    {
                                        var safeSubmission = exam.SubmissionPercent < 0 ? 0 : exam.SubmissionPercent > 100 ? 100 : exam.SubmissionPercent;
                                        var submissionColor = safeSubmission >= 80 ? "var(--green)" : safeSubmission >= 50 ? "var(--amber)" : "var(--red)";

                                        <tr>
                                            <td>
                                                <div class="item-title">@exam.Title</div>
                                                <div class="item-sub">إنشاء: @exam.CreatedAt.ToString("yyyy/MM/dd")</div>
                                            </td>
                                            <td>@exam.BatchName</td>
                                            <td>
                                                <div class="table-prog">
                                                    <div class="table-prog-bar">
                                                        <div class="table-prog-fill" style="width:@safeSubmission.ToString("0")%;background:@submissionColor"></div>
                                                    </div>
                                                    <span>@exam.SubmittedCount / @exam.AssignedCount</span>
                                                </div>
                                            </td>
                                            <td class="fw8">@exam.AverageScore.ToString("0")<span class="txt-blue">/100</span></td>
                                            <td><span class="impact-status @exam.StatusCssClass">@exam.StatusText</span></td>
                                            <td>@(exam.ScheduledDate.HasValue? exam.ScheduledDate.Value.ToString("yyyy/MM/dd") : "غير مجدول")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="empty">لا توجد اختبارات أنشأها هذا المدرب.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>

                <section class="dash-card instructor-fade d5">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent amber"></div>
                            <div>
                                <div class="ch-title">أثر الواجبات</div>
                                <div class="ch-sub">@Model.Homeworks.Count واجبات مرتبطة بحساب المدرب</div>
                            </div>
                        </div>
                        <a class="card-link" asp-area="Admin" asp-controller="HomeworkManagement" asp-action="Index">إدارة الواجبات ←</a>
                    </div>

                    <div class="table-wrap">
                        <table class="impact-table">
                            <thead>
                                <tr>
                                    <th style="width:32%">الواجب</th>
                                    <th>الدفعة</th>
                                    <th>التسليم</th>
                                    <th>المتوسط</th>
                                    <th>الحالة</th>
                                    <th>الإغلاق</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Homeworks.Any())
                                {
                                    foreach (var homework in Model.Homeworks)
                                    {
                                        var safeSubmission = homework.SubmissionPercent < 0 ? 0 : homework.SubmissionPercent > 100 ? 100 : homework.SubmissionPercent;
                                        var submissionColor = safeSubmission >= 80 ? "var(--green)" : safeSubmission >= 50 ? "var(--amber)" : "var(--red)";

                                        <tr>
                                            <td>
                                                <div class="item-title">@homework.Title</div>
                                                <div class="item-sub">إنشاء: @homework.CreatedAt.ToString("yyyy/MM/dd")</div>
                                            </td>
                                            <td>@homework.BatchName</td>
                                            <td>
                                                <div class="table-prog">
                                                    <div class="table-prog-bar">
                                                        <div class="table-prog-fill" style="width:@safeSubmission.ToString("0")%;background:@submissionColor"></div>
                                                    </div>
                                                    <span>@homework.SubmittedCount / @homework.AssignedCount</span>
                                                </div>
                                            </td>
                                            <td class="fw8">@homework.AverageScore.ToString("0")<span class="txt-blue">/100</span></td>
                                            <td><span class="impact-status @homework.StatusCssClass">@homework.StatusText</span></td>
                                            <td>@(homework.EndAt.HasValue? homework.EndAt.Value.ToString("yyyy/MM/dd") : "غير محدد")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="empty">
                                            لا توجد واجبات مرتبطة بحساب هذا المدرب.
                                            <br />
                                            يتم الربط من خلال AssignedByUserId في HomeworkSet.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>

            </div>

            <aside class="right-stack">

                <section class="dash-card instructor-fade d2">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent ink"></div>
                            <div>
                                <div class="ch-title">التشخيص الذكي للمدرب</div>
                                <div class="ch-sub">قوة، ضعف، خطر، فرصة تدخل</div>
                            </div>
                        </div>
                        <span class="ch-badge neutral">@Model.DiagnosisItems.Count عناصر</span>
                    </div>

                    <div class="diag-section">
                        @if (Model.DiagnosisItems.Any())
                        {
                            foreach (var item in Model.DiagnosisItems)
                            {
                                <div class="diag-item">
                                    <div class="diag-icon @item.CssClass">@item.Icon</div>
                                    <div>
                                        <div class="diag-title">@item.Title</div>
                                        <div class="diag-body">@item.Body</div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty">لا توجد عناصر تشخيصية حالياً.</div>
                        }
                    </div>
                </section>

                <section class="dash-card instructor-fade d3">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent green"></div>
                            <div>
                                <div class="ch-title">مؤشرات الأداء الإجمالية</div>
                                <div class="ch-sub">مقارنة بالأهداف التشغيلية</div>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        @if (Model.ProgressBars.Any())
                        {
                            foreach (var item in Model.ProgressBars)
                            {
                                var safeValue = item.Value < 0 ? 0 : item.Value > 100 ? 100 : item.Value;

                                <div class="prog-item">
                                    <div class="prog-head">
                                        <span>@item.Label</span>
                                        <b>@safeValue.ToString("0")% <span>/ هدف @item.Target.ToString("0")%</span></b>
                                    </div>
                                    <div class="prog-track">
                                        <div class="prog-fill" style="width:@safeValue.ToString("0")%;background:@item.CssColor"></div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty">لا توجد مؤشرات أداء كافية.</div>
                        }
                    </div>
                </section>

                <section class="dash-card instructor-fade d4">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent blue"></div>
                            <div>
                                <div class="ch-title">محاضرات قادمة</div>
                                <div class="ch-sub">@Model.UpcomingLectures.Count محاضرات مجدولة</div>
                            </div>
                        </div>
                    </div>

                    <div class="upcoming-list">
                        @if (Model.UpcomingLectures.Any())
                        {
                            foreach (var lecture in Model.UpcomingLectures)
                            {
                                <div class="upcoming-item">
                                    <div class="upcoming-date">
                                        <strong>@lecture.Date.ToString("dd")</strong>
                                        <span>@lecture.Date.ToString("MM")</span>
                                    </div>
                                    <div>
                                        <strong>@lecture.Title</strong>
                                        <span>@lecture.BatchName • @lecture.Date.ToString("hh:mm tt")</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty">لا توجد محاضرات قادمة مسجلة لهذا المدرب.</div>
                        }
                    </div>
                </section>

                <section class="dash-card instructor-fade d5">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent teal"></div>
                            <div>
                                <div class="ch-title">كثافة النشاط الأسبوعي</div>
                                <div class="ch-sub">محاضرات + اختبارات + واجبات</div>
                            </div>
                        </div>
                    </div>

                    <div class="heatmap-wrap">
                        <div class="hm-days">
                            <div class="hm-day">أح</div>
                            <div class="hm-day">إث</div>
                            <div class="hm-day">ثل</div>
                            <div class="hm-day">أر</div>
                            <div class="hm-day">خم</div>
                            <div class="hm-day">جم</div>
                            <div class="hm-day">سب</div>
                        </div>

                        @if (Model.HeatmapWeeks.Any())
                        {
                            foreach (var week in Model.HeatmapWeeks)
                            {
                                <div class="hm-row">
                                    @foreach (var day in week.Days)
                                    {
                                        <div class="hm-cell" style="@day.CssStyle">@day.ActivityCount</div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty">لا توجد بيانات نشاط أسبوعية.</div>
                        }
                    </div>
                </section>

            </aside>
        </section>

        <section class="full-section instructor-fade d6">
            <div class="sec-label">
                <div class="sec-label-line"></div>
                <div>
                    <h2>تحليل الطلاب داخل نطاق المدرب</h2>
                    <p>أعلى 5 طلاب — أدنى 5 طلاب يحتاجون متابعة</p>
                </div>
            </div>

            <div class="students-split">

                <section class="student-card top">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent green"></div>
                            <div>
                                <div class="ch-title">⭐ الطلاب الأعلى أداءً</div>
                                <div class="ch-sub">حسب الحضور والاختبارات والواجبات</div>
                            </div>
                        </div>
                    </div>

                    @if (Model.TopStudents.Any())
                    {
                        foreach (var student in Model.TopStudents)
                        {
                            <div class="student-row">
                                <div class="st-rank">@student.Rank</div>
                                <div class="st-avatar top-avatar">@student.AvatarText</div>
                                <div class="st-info">
                                    <div class="st-name">@student.FullName</div>
                                    <div class="st-detail">@student.BatchName • حضور @student.AttendancePercent.ToString("0")% • اختبار @student.ExamAverageScore.ToString("0")%</div>
                                </div>
                                <span class="st-trend @student.TrendCssClass">@student.TrendText</span>
                                <div class="st-score">@student.FinalScore.ToString("0")<small>متوسط</small></div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty">لا توجد بيانات كافية.</div>
                    }
                </section>

                <section class="student-card bottom">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent red"></div>
                            <div>
                                <div class="ch-title">🚨 طلاب يحتاجون متابعة</div>
                                <div class="ch-sub">الأضعف أداءً داخل نطاق هذا المدرب</div>
                            </div>
                        </div>
                        <span class="ch-badge danger">تدخل عاجل</span>
                    </div>

                    @if (Model.RiskStudents.Any())
                    {
                        foreach (var student in Model.RiskStudents)
                        {
                            <div class="student-row @(student.FinalScore < 60 ? "risk-row" : "")">
                                <div class="st-rank">⚠</div>
                                <div class="st-avatar risk-avatar">@student.AvatarText</div>
                                <div class="st-info">
                                    <div class="st-name">@student.FullName</div>
                                    <div class="st-detail">@student.BatchName</div>
                                    <div class="problem-flags">
                                        @if (student.Flags.Any())
                                        {
                                            foreach (var flag in student.Flags)
                                            {
                                                <span class="pflag">@flag</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="pflag neutral">لا توجد تفاصيل كافية</span>
                                        }
                                    </div>
                                </div>
                                <span class="st-trend @student.TrendCssClass">@student.TrendText</span>
                                <div class="st-score">@student.FinalScore.ToString("0")<small>متوسط</small></div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty">لا توجد بيانات كافية.</div>
                    }
                </section>
            </div>
        </section>
    </div>
</div>

