@model QdratNew.ViewModels.Remedial.RemedialResourceSelectionVm
@{
    ViewData["Title"] = "🎥 إعداد الفيديوهات والأسئلة العلاجية";
}

<div class="container py-4">
    <h3 class="fw-bold text-primary mb-4">
        🎥 إعداد جلسة علاجية للمؤشر: @Model.LessonTitle
        <small class="text-secondary d-block">المحور: @Model.SectionTitle</small>
    </h3>

    <form asp-action="SelectRemedialResources" method="post" id="remedialForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="StudentId" />
        <input type="hidden" asp-for="SectionId" />
        <input type="hidden" asp-for="LessonId" />

        <div class="row g-4">
            <div class="col-md-6">
                <div class="card shadow-sm border-primary">
                    <div class="card-header bg-primary text-white fw-bold">
                        📚 الأسئلة التي أخطأ فيها الطالب
                    </div>
                    <div class="card-body">
                        @if (Model.WrongQuestions.Any())
                        {
                            foreach (var q in Model.WrongQuestions)
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" name="SelectedQuestionIds" value="@q.QuestionId" id="q_@q.QuestionId" />
                                    <label class="form-check-label" for="q_@q.QuestionId">@q.QuestionText</label>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">لا توجد أسئلة خاطئة في هذا المؤشر.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm border-success">
                    <div class="card-header bg-success text-white fw-bold">
                        🎞️ مكتبة الفيديوهات العلاجية
                    </div>
                    <div class="card-body">
                        @if (Model.AvailableVideos.Any())
                        {
                            foreach (var v in Model.AvailableVideos)
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" name="SelectedVideoIds" value="@v.VideoId" id="v_@v.VideoId" />
                                    <label class="form-check-label" for="v_@v.VideoId">
                                        @v.VideoTitle
                                        <a href="@v.VideoUrl" target="_blank" class="text-primary ms-2">(مشاهدة)</a>
                                    </label>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">لا توجد فيديوهات علاجية مسجلة لهذا المؤشر.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <button type="submit" class="btn btn-primary px-4 fw-bold">💾 توليد الجلسة العلاجية</button>
            <a href="javascript:history.back()" class="btn btn-outline-secondary px-4">الرجوع</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $("#remedialForm").on("submit", function (e) {
            e.preventDefault();
            const form = $(this);
            fetch(form.attr("action"), {
                method: "POST",
                body: new FormData(form[0])
            })
            .then(r => r.json())
            .then(data => {
                alert(data.message);
                if (data.success && data.redirect)
                    window.location = data.redirect;
            });
        });
    </script>
}
