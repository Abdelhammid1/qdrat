@model QdratNew.ViewModels.Remedial.RemedialPlanSectionsAnalysisVm
@{
    ViewData["Title"] = "تحليل المحاور الضعيفة";
}

<h2 class="text-center mt-3 text-primary fw-bold">
    🔍 تحليل المحاور الضعيفة – @Model.StudentName
</h2>

<div class="table-responsive mt-4 shadow-sm bg-white p-3 rounded">
    <table class="table table-bordered text-center align-middle">
        <thead class="table-success">
            <tr>
                <th>📍 المحور</th>
                <th>🔢 نسبة الإتقان (%)</th>
                <th> التوصية</th>
                <th>📊 الاجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sec in Model.Sections)
            {
                <tr>
                    <td>@sec.SectionTitle</td>
                    <td>@sec.Score%</td>
                    <td>@sec.Recommendation</td>
                    <td>
                    <a class="btn btn-sm btn-outline-secondary"
                       href="@Url.Action("AnalyzeSectionIndicators", "RemedialAnalysis",
                                                  new { area = "Admin", studentId = ViewBag.StudentId, sectionId = sec.SectionId })">
                        <i class="bi bi-search"></i> تحليل المؤشرات
                </a>
                    </td>


                </tr>
            }
        </tbody>
    </table>
</div>
