@model IEnumerable<QdratNew.ViewModels.Remedial.StudentPerformanceComparisonVm>
@{
    ViewData["Title"] = "📊 تحليل أداء الطالب في المحور";
    var first = Model.FirstOrDefault();
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<style>
    body {
        font-family: 'Cairo', sans-serif;
        background: #f8fafc;
    }

    .section-header {
        background: linear-gradient(90deg, #007bff, #00bcd4);
        color: #fff;
        padding: 15px 25px;
        border-radius: 8px;
        margin-bottom: 25px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .progress {
        height: 16px;
        border-radius: 10px;
    }

    .table thead {
        background-color: #e3f2fd;
        color: #003366;
        font-weight: 700;
    }

    .badge {
        font-size: 0.85rem;
        padding: 5px 8px;
        border-radius: 8px;
    }

    .recommendation {
        font-weight: bold;
        text-align: center;
    }
</style>

<div class="container py-4">

    <div class="section-header text-center">
        <h3 class="fw-bold">
            <i class="bi bi-graph-up-arrow"></i>
            تحليل أداء الطالب <span class="text-warning">@first?.StudentName</span>
        </h3>
        <h5 class="mt-2">
            المنهج: <span class="text-light">@first?.CurriculumTitle</span> |
            المحور: <span class="text-light">@first?.SectionTitle</span>
        </h5>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center fw-bold">
            ⚠️ لا توجد بيانات أداء متاحة لهذا الطالب في هذا المحور بعد.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded bg-white p-3">
            <table id="performanceTable" class="table table-hover align-middle text-center">
                <thead>
                    <tr>
                        <th>📘 المؤشر (الدرس)</th>
                        <th>📗 متوسط الواجبات</th>
                        <th>🧩 متوسط الاختبارات</th>
                        <th>📊 مؤشر الأداء</th>
                        <th>📈 الاتجاه</th>
                        <th>🧠 التوصية</th>
                        <th>🎯 التقدم العام</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        string color = "bg-success";
                        if (item.AverageIndicatorScore < 40)
                        {
                            color = "bg-danger";
                        }
                        else if (item.AverageIndicatorScore < 60)
                        {
                            color = "bg-warning text-dark";
                        }
                        else if (item.AverageIndicatorScore < 75)
                        {
                            color = "bg-info text-dark";
                        }

                        <tr>
                            <td class="fw-bold text-primary">@item.LessonTitle</td>

                            <td>
                                <div class="progress">
                                    <div class="progress-bar bg-success" role="progressbar"
                                         style="width:@item.AverageHomeworkScore%;">
                                        @item.AverageHomeworkScore%
                                    </div>
                                </div>
                            </td>

                            <td>
                                <div class="progress">
                                    <div class="progress-bar bg-info" role="progressbar"
                                         style="width:@item.AverageExamScore%;">
                                        @item.AverageExamScore%
                                    </div>
                                </div>
                            </td>

                            <td>
                                <div class="progress">
                                    <div class="progress-bar @color" role="progressbar"
                                         style="width:@item.AverageIndicatorScore%;">
                                        @item.AverageIndicatorScore%
                                    </div>
                                </div>
                            </td>

                            <td>
                                @if (item.AverageIndicatorScore >= 70)
                                {
                                    <span class="badge bg-success"><i class="bi bi-arrow-up-right"></i> تحسّن</span>
                                }
                                else if (item.AverageIndicatorScore >= 50)
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-arrow-right"></i> مستقر</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="bi bi-arrow-down"></i> تراجع</span>
                                }
                            </td>

                            <td class="recommendation">@item.Recommendation</td>

                            <td>
                                @{
                                    var progress = (item.AverageHomeworkScore + item.AverageExamScore + item.AverageIndicatorScore) / 3;
                                }
                                <div class="progress">
                                    <div class="progress-bar bg-primary" role="progressbar"
                                         style="width:@progress%;">
                                        @progress%
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#performanceTable').DataTable({
                language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json' },
                order: [[3, 'desc']],
                pageLength: 10
            });
        });
    </script>
}
