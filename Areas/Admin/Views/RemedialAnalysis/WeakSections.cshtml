@model QdratNew.ViewModels.Remedial.WeakSectionsListVm
@{
    ViewData["Title"] = "📉 المحاور الضعيفة للطالب";
}

<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

<div class="container py-4">
    <h3 class="fw-bold text-primary mb-4">
        <i class="bi bi-exclamation-triangle"></i> المحاور الضعيفة للطالب: <span class="text-dark">@Model.StudentName</span>
    </h3>

    <div class="table-responsive shadow-sm p-3 bg-white rounded">
        <table id="weakSectionsTable" class="table table-hover align-middle text-center">
            <thead class="table-danger text-dark">
                <tr>
                    <th>📘 المحور</th>
                    <th>📊 درجة المؤشر</th>
                    <th>🎯 حالة الخطة</th>
                    <th>⚙️ خيارات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sec in Model.WeakSections)
                {
                    <tr>
                        <td class="fw-bold text-start">@sec.SectionTitle</td>
                        <td>
                            <div class="progress" style="height:20px;">
                                <div class="progress-bar bg-danger fw-bold" role="progressbar"
                                     style="width:@sec.ScorePercent%;"
                                     aria-valuenow="@sec.ScorePercent" aria-valuemin="0" aria-valuemax="100">
                                    @sec.ScorePercent%
                                </div>
                            </div>
                        </td>
                        <td>
                            @if (sec.HasRemedialPlan)
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle"></i> خطة علاجية موجودة</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-circle"></i> لا توجد خطة</span>
                            }
                        </td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary"
                               href="@Url.Action("CompareStudentSectionPerformance", "RemedialAnalysis", new { area = "Admin", studentId = Model.StudentId, sectionId = sec.SectionId })"
                               title="مقارنة الأداء في هذا المحور">
                                <i class="bi bi-bar-chart-line"></i> تحليل الأداء
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#weakSectionsTable').DataTable({
                language: { url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json" },
                order: [[1, "asc"]],
                pageLength: 10
            });
        });
    </script>
}
