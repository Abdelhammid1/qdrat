@model QdratNew.ViewModels.Remedial.SectionIndicatorsAnalysisVm
@{
    ViewData["Title"] = "📊 تحليل أداء الطالب في المحور: " + Model.SectionTitle;
 
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Cairo', sans-serif;
        background-color: #f9fbfd;
    }

    .analysis-card {
        background: #fff;
        border-radius: 1rem;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        padding: 1.5rem;
        margin-bottom: 1.2rem;
        transition: 0.3s;
    }

        .analysis-card:hover {
            transform: translateY(-3px);
        }

    .badge-score {
        font-size: 0.9rem;
        padding: 0.45rem 0.75rem;
    }

    .score-low {
        background: #f8d7da;
        color: #842029;
    }

    .score-mid {
        background: #fff3cd;
        color: #664d03;
    }

    .score-good {
        background: #d1e7dd;
        color: #0f5132;
    }

    .btn-remedial {
        background: #005f73;
        color: #fff;
        border-radius: 8px;
    }

        .btn-remedial:hover {
            background: #0a9396;
            color: #fff;
        }
</style>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-bar-chart-line me-2"></i> تحليل أداء الطالب في المحور:
                <span class="text-dark">@Model.SectionTitle</span>
            </h2>
            <h5 class="text-secondary">لكل مؤشر (درس) داخل هذا المحور</h5>
        </div>

        <a href="@Url.Action("Index", "RemedialPlans", new { area = "Admin" })" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> العودة للخطط العلاجية
        </a>
    </div>

    <table class="table table-bordered align-middle text-center shadow-sm">
        <thead class="table-light">
            <tr>
                <th style="width:25%">📘 اسم المؤشر</th>
                <th>📊 متوسط الواجبات</th>
                <th>🧮 متوسط الاختبارات</th>
                <th>🧠 اختبار مؤشر الأداء</th>
                <th>❌ أخطاء الواجبات</th>
                <th>⚠️ أخطاء الاختبارات</th>
                <th>📈 التوصية الذكية</th>
                <th style="width: 15%">🎥 الموارد العلاجية</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in Model.Lessons)
            {
                var badgeClass = l.IndicatorScore < 50 ? "score-low" :
                l.IndicatorScore < 70 ? "score-mid" : "score-good";

                <tr>
                    <td class="fw-bold text-start">@l.LessonTitle</td>
                    <td><span class="badge bg-info text-dark">@l.HomeworkAverage %</span></td>
                    <td><span class="badge bg-secondary">@l.ExamAverage %</span></td>
                    <td><span class="badge badge-score @badgeClass">@l.IndicatorScore %</span></td>
                    <td><span class="text-danger fw-bold">@l.HomeworkErrors</span></td>
                    <td><span class="text-warning fw-bold">@l.ExamErrors</span></td>
                    <td class="fw-semibold">@l.Recommendation</td>

                    <td>
                        @if (l.IndicatorScore < 60)
                        {
                            <a href="@Url.Action("SelectRemedialResources", "RemedialAnalysis", new { area = "Admin", studentId = ViewBag.StudentId, sectionId = Model.SectionId, lessonId = l.LessonId })"
                               class="btn btn-remedial btn-sm">
                                <i class="bi bi-lightbulb"></i> اختيار موارد علاجية
                            </a>
                        }
                        else
                        {
                            <span class="text-success"><i class="bi bi-check-circle"></i> لا حاجة لتدخل</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-center mt-4">
        <a href="@Url.Action("AnalyzeStudent", "RemedialAnalysis", new { area = "Admin" })"
           class="btn btn-outline-primary px-4">
            <i class="bi bi-person-lines-fill"></i> العودة لتحليل الطالب الكامل
        </a>
    </div>

</div>
