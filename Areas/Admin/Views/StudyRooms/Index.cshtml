@model List<QdratNew.ViewModels.StudyRoomViewModel>

@{
    ViewData["Title"] = "📚 إدارة الغرف الدراسية";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="text-primary fw-bold"><i class="fas fa-door-open"></i> إدارة الغرف الدراسية</h3>
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus-circle"></i> إضافة غرفة جديدة
        </a>
    </div>

    @if (Model.Any())
    {
        <table class="table table-bordered table-striped text-center shadow-sm" id="studyRoomsTable">
            <thead class="table-dark">
                <tr>
                    <th>اسم الغرفة</th>
                    <th>السعة</th>
                    <th>عدد الأجهزة</th>
                    <th>كمبيوترات؟</th>
                    <th>الموقع</th>
                    <th>نشطة؟</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var room in Model)
                {
                    <tr>
                        <td>@room.RoomName</td>
                        <td>@room.Capacity</td>
                        <td>@room.DeviceCount</td>
                        <td>@(room.HasComputers ? "نعم" : "لا")</td>
                        <td>@room.Location</td>
                        <td>
                            @if (room.IsActive)
                            {
                                <span class="badge bg-success">نشطة</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">غير نشطة</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@room.Id" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
                                <a asp-action="Details" asp-route-id="@room.Id" class="btn btn-sm btn-outline-info"><i class="fas fa-eye"></i></a>
                                <a asp-action="Delete" asp-route-id="@room.Id" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash-alt"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-warning text-center">لا توجد غرف دراسية حالياً.</div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#studyRoomsTable').DataTable({
                pageLength: 10,
                language: {
                    search: "🔍 بحث:",
                    lengthMenu: "عرض _MENU_ صف",
                    info: "عرض _START_ إلى _END_ من أصل _TOTAL_",
                    paginate: {
                        previous: "السابق",
                        next: "التالي"
                    },
                    emptyTable: "لا توجد بيانات"
                }
            });
        });
    </script>
}
