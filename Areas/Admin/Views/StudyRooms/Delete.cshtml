@model QdratNew.ViewModels.StudyRoomViewModel

@{
    ViewData["Title"] = "🗑️ حذف الغرفة الدراسية";
}

<div class="container mt-4">
    <div class="alert alert-danger shadow-sm p-4">
        <h4 class="fw-bold text-danger"><i class="fas fa-exclamation-triangle"></i> تأكيد الحذف</h4>
        <p>هل أنت متأكد أنك تريد حذف الغرفة التالية؟ لا يمكن التراجع عن هذا الإجراء.</p>

        <div class="row g-4 mt-3">
            <div class="col-md-6">
                <div class="card border-secondary shadow-sm">
                    <div class="card-header bg-secondary text-white">
                        🏷️ تفاصيل الغرفة
                    </div>
                    <div class="card-body">
                        <p><strong>اسم الغرفة:</strong> @Model.RoomName</p>
                        <p><strong>الموقع:</strong> @Model.Location</p>
                        <p><strong>السعة:</strong> @Model.Capacity طالب</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card border-dark shadow-sm">
                    <div class="card-header bg-dark text-white">
                        🧮 المعدات
                    </div>
                    <div class="card-body">
                        <p><strong>تحتوي على كمبيوترات؟</strong> @(Model.HasComputers ? "نعم" : "لا")</p>
                        <p><strong>عدد الأجهزة:</strong> @(Model.DeviceCount ?? 0)</p>
                        <p><strong>الحالة:</strong> @(Model.IsActive ? "مفعّلة" : "غير مفعّلة")</p>
                    </div>
                </div>
            </div>
        </div>

        <form asp-action="DeleteConfirmed" method="post" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger"><i class="fas fa-trash-alt"></i> حذف نهائي</button>
            <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
        </form>
    </div>
</div>
