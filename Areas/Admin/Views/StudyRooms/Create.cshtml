@model QdratNew.ViewModels.StudyRoomViewModel

@{
    ViewData["Title"] = "إضافة غرفة دراسية";
}

<div class="qdrat-page" dir="rtl">

    <div class="qdrat-hero mb-4">
        <div>
            <div class="qdrat-kicker">
                <i class="fas fa-plus-circle"></i>
                إضافة غرفة دراسية
            </div>

            <h2 class="qdrat-title">إضافة غرفة دراسية جديدة</h2>

            <p class="qdrat-subtitle">
                أضف بيانات الغرفة الدراسية مع تحديد السعة وعدد الأجهزة والموقع وحالة التفعيل.
            </p>
        </div>

        <div class="qdrat-hero-icon">
            <i class="fas fa-door-open"></i>
        </div>
    </div>

    <div class="qdrat-card">
        <div class="qdrat-card-header">
            <div>
                <h5>
                    <i class="fas fa-chalkboard-teacher"></i>
                    بيانات الغرفة
                </h5>
                <p>
                    أدخل بيانات الغرفة كما ستظهر في إدارة الغرف الدراسية داخل النظام.
                </p>
            </div>
        </div>

        <div class="qdrat-card-body">
            <form asp-action="Create" method="post" autocomplete="off">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert qdrat-alert qdrat-alert-danger mb-4"></div>

                <div class="row g-4">

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="RoomName" class="form-label">اسم الغرفة</label>
                            <div class="qdrat-input-wrap">
                                <i class="fas fa-door-closed"></i>
                                <input asp-for="RoomName" class="form-control" placeholder="مثال: قاعة التدريب 1" />
                            </div>
                            <span asp-validation-for="RoomName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <div class="qdrat-field">
                            <label asp-for="Capacity" class="form-label">السعة الكلية</label>
                            <div class="qdrat-input-wrap">
                                <i class="fas fa-users"></i>
                                <input asp-for="Capacity" type="number" min="0" class="form-control" placeholder="مثال: 25" />
                            </div>
                            <span asp-validation-for="Capacity" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <div class="qdrat-field">
                            <label asp-for="DeviceCount" class="form-label">عدد الأجهزة</label>
                            <div class="qdrat-input-wrap">
                                <i class="fas fa-desktop"></i>
                                <input asp-for="DeviceCount" type="number" min="0" class="form-control" placeholder="مثال: 20" />
                            </div>
                            <span asp-validation-for="DeviceCount" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="Location" class="form-label">الموقع</label>
                            <div class="qdrat-input-wrap">
                                <i class="fas fa-location-dot"></i>
                                <input asp-for="Location" class="form-control" placeholder="مثال: الدور الأول - بجوار الاستقبال" />
                            </div>
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <div class="qdrat-status-box">
                            <div class="form-check form-switch qdrat-switch">
                                <input asp-for="HasComputers" class="form-check-input" type="checkbox" />
                                <label asp-for="HasComputers" class="form-check-label">يوجد كمبيوترات</label>
                            </div>
                            <small>فعّل هذا الخيار إذا كانت الغرفة مجهزة بأجهزة للطلاب.</small>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <div class="qdrat-status-box">
                            <div class="form-check form-switch qdrat-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                <label asp-for="IsActive" class="form-check-label">مفعّلة</label>
                            </div>
                            <small>الغرف المفعّلة فقط تكون متاحة للاستخدام داخل النظام.</small>
                        </div>
                    </div>

                </div>

                <div class="qdrat-actions">
                    <a asp-action="Index" class="btn qdrat-btn qdrat-btn-light">
                        <i class="fas fa-arrow-right"></i>
                        رجوع
                    </a>

                    <button type="submit" class="btn qdrat-btn qdrat-btn-primary">
                        <i class="fas fa-save"></i>
                        حفظ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .qdrat-page {
        padding: 24px;
        background: #f5f7fb;
        min-height: calc(100vh - 80px);
        font-family: inherit;
    }

    .qdrat-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 26px;
        border-radius: 24px;
        background: linear-gradient(135deg, #102a43 0%, #1d4ed8 58%, #38bdf8 100%);
        color: #fff;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
    }

    .qdrat-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .qdrat-title {
        margin: 0;
        font-size: 28px;
        font-weight: 900;
        letter-spacing: -0.5px;
    }

    .qdrat-subtitle {
        margin: 10px 0 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 15px;
        line-height: 1.8;
        max-width: 850px;
    }

    .qdrat-hero-icon {
        width: 74px;
        height: 74px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.16);
        font-size: 34px;
        flex: 0 0 auto;
    }

    .qdrat-card {
        border: 1px solid #e5e7eb;
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    .qdrat-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #edf0f5;
        background: #fff;
    }

        .qdrat-card-header h5 {
            margin: 0;
            color: #0f172a;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .qdrat-card-header h5 i {
                color: #2563eb;
            }

        .qdrat-card-header p {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 14px;
        }

    .qdrat-card-body {
        padding: 24px;
    }

    .qdrat-field .form-label {
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 9px;
    }

    .qdrat-input-wrap {
        position: relative;
    }

        .qdrat-input-wrap > i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 3;
            pointer-events: none;
        }

        .qdrat-input-wrap .form-control {
            min-height: 48px;
            border-radius: 15px;
            border-color: #dbe3ef;
            padding-right: 42px;
            font-weight: 700;
        }

            .qdrat-input-wrap .form-control:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 0.22rem rgba(37, 99, 235, 0.12);
            }

    .qdrat-status-box {
        height: 100%;
        min-height: 118px;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 18px;
        background: #f8fafc;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 10px;
    }

    .qdrat-switch {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-right: 0;
        margin-bottom: 0;
    }

        .qdrat-switch .form-check-input {
            float: none;
            margin: 0;
            width: 46px;
            height: 24px;
            cursor: pointer;
        }

        .qdrat-switch .form-check-label {
            font-weight: 900;
            color: #1e293b;
            cursor: pointer;
        }

    .qdrat-status-box small {
        color: #64748b;
        line-height: 1.8;
        font-weight: 700;
    }

    .qdrat-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 26px;
        margin-top: 28px;
        border-top: 1px solid #edf0f5;
    }

    .qdrat-btn {
        min-height: 46px;
        border-radius: 14px;
        padding: 10px 24px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .qdrat-btn-primary {
        background: #16a34a;
        border-color: #16a34a;
        color: #fff;
    }

        .qdrat-btn-primary:hover {
            background: #15803d;
            border-color: #15803d;
            color: #fff;
        }

    .qdrat-btn-light {
        background: #f8fafc;
        border-color: #dbe3ef;
        color: #334155;
    }

        .qdrat-btn-light:hover {
            background: #eef2f7;
            border-color: #cbd5e1;
            color: #0f172a;
        }

    .qdrat-alert {
        border: 0;
        border-radius: 18px;
        padding: 15px 18px;
        font-weight: 800;
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.07);
    }

        .qdrat-alert:empty {
            display: none;
        }

    .qdrat-alert-danger {
        color: #991b1b;
        background: #fee2e2;
    }

    @@media (max-width: 768px) {
        .qdrat-page {
            padding: 14px;
        }

        .qdrat-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 20px;
        }

        .qdrat-title {
            font-size: 23px;
        }

        .qdrat-hero-icon {
            width: 58px;
            height: 58px;
            font-size: 26px;
        }

        .qdrat-card-body,
        .qdrat-card-header {
            padding: 18px;
        }

        .qdrat-actions {
            flex-direction: column-reverse;
        }

        .qdrat-btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
