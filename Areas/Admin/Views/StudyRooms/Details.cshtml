@model QdratNew.ViewModels.StudyRoomViewModel

@{
    ViewData["Title"] = "📋 تفاصيل الغرفة الدراسية";
}

<div class="container mt-4">
    <h3 class="text-primary fw-bold mb-4"><i class="fas fa-info-circle"></i> تفاصيل الغرفة الدراسية</h3>

    <div class="row g-4">
        <!-- الكارت الأول -->
        <div class="col-md-6">
            <div class="card border-primary shadow-sm">
                <div class="card-header bg-primary text-white fw-bold">
                    🏷️ بيانات أساسية
                </div>
                <div class="card-body">
                    <p><strong>اسم الغرفة:</strong> @Model.RoomName</p>
                    <p><strong>الموقع:</strong> @Model.Location</p>
                    <p><strong>مفعّلة؟</strong> @(Model.IsActive ? "نعم" : "لا")</p>
                </div>
            </div>
        </div>

        <!-- الكارت الثاني -->
        <div class="col-md-6">
            <div class="card border-success shadow-sm">
                <div class="card-header bg-success text-white fw-bold">
                    🧮 السعة والمعدات
                </div>
                <div class="card-body">
                    <p><strong>السعة الكلية:</strong> @Model.Capacity طالب</p>
                    <p><strong>عدد الأجهزة:</strong> @(Model.DeviceCount ?? 0)</p>
                    <p><strong>تحتوي على كمبيوترات؟</strong> @(Model.HasComputers ? "نعم" : "لا")</p>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 text-end">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-edit"></i> تعديل</a>
        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> رجوع</a>
    </div>
</div>
