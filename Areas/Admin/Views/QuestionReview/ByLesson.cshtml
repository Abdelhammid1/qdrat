@model QdratNew.ViewModels.Lesson.LessonQuestionReviewViewModel

@{
    ViewData["Title"] = "مراجعة الأسئلة";
}

<div class="container mt-4" dir="rtl">
    <h3 class="text-primary mb-2">مراجعة الأسئلة للمؤشر: @Model.LessonTitle</h3>
    <h6 class="text-muted">المحور: @Model.SectionTitle - المنهج: @Model.CurriculumTitle</h6>

    <table class="table table-bordered table-striped text-center mt-4">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>نص السؤال</th>
                <th>المراجعة</th>
                <th>الإجراء</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var q in Model.Questions)
            {
                <tr>
                    <td>@q.ReferenceNumber</td>
                    <td>@Html.Raw(q.Title)</td>
                    <td>
                        @if (q.IsReviewed)
                        {
                            <span class="badge bg-success">مُراجع</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">لم يُراجع</span>
                        }
                    </td>
                    <td>
                        <a asp-area="Admin" asp-controller="Questions" asp-action="Edit" asp-route-id="@q.Id"
                           class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-edit"></i> تعديل
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
