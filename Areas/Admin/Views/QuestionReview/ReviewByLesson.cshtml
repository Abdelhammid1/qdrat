@model QdratNew.ViewModels.Question.ManualQuestionSelectionViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "تحديد الأسئلة يدوياً";
    var questions    = Model.Questions ?? new List<QdratNew.ViewModels.Question.QuestionListViewModel>();
    var totalQ       = questions.Count;
    var confirmedQ   = questions.Count(q => q.IsAnswerConfirmed);
    var quantQ       = questions.Count(q => q.IsQuantitative);
    var verbalQ      = totalQ - quantQ;
    int idx          = 0;
}

@section Styles {
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root {
    --c-primary: #2563EB; --c-primary-dark: #1D4ED8; --c-primary-light: #EFF6FF; --c-primary-mid: #BFDBFE;
    --c-success: #059669; --c-success-dark: #047857; --c-success-light: #F0FDF4; --c-success-mid: #A7F3D0;
    --c-amber: #D97706; --c-amber-light: #FFFBEB; --c-amber-mid: #FDE68A;
    --c-violet: #7C3AED; --c-violet-light: #F5F3FF; --c-violet-mid: #DDD6FE;
    --c-rose: #E11D48; --c-rose-light: #FFF1F2;
    --c-bg: #F3F6FA; --c-surface: #FFF; --c-surface-2: #F8FAFC;
    --c-border: #DDE4EC; --c-border-2: #E8EEF5;
    --c-ink: #0F172A; --c-ink-2: #1E293B; --c-ink-3: #334155; --c-ink-4: #64748B; --c-ink-5: #94A3B8; --c-ink-6: #CBD5E1;
    --r-sm:6px; --r-md:10px; --r-lg:14px; --r-xl:20px; --r-2xl:28px;
    --sh-xs:0 1px 3px rgba(15,23,42,.06); --sh-sm:0 2px 8px rgba(15,23,42,.08); --sh-md:0 4px 18px rgba(15,23,42,.10);
    --ease:cubic-bezier(.25,.46,.45,.94); --spring:cubic-bezier(.34,1.56,.64,1);
    --font:'Cairo',sans-serif; --toolbar-h:64px; --bottom-bar-h:76px;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
.qsel-page { font-family: var(--font); background: var(--c-bg); min-height: 100vh; direction: rtl; color: var(--c-ink-2); padding-bottom: calc(var(--bottom-bar-h) + 24px); }
.qsel-hero { background: linear-gradient(135deg,#0F172A 0%,#1E3A6E 50%,#1D4ED8 100%); padding: 28px 0 0; position: relative; overflow: hidden; }
.qsel-hero::before { content:''; position:absolute; inset:0; background: radial-gradient(ellipse 60% 80% at 80% -20%,rgba(99,179,237,.18) 0%,transparent 70%), radial-gradient(ellipse 40% 60% at -10% 110%,rgba(167,139,250,.12) 0%,transparent 70%); pointer-events:none; }
.qsel-hero-inner { max-width:1200px; margin:0 auto; padding:0 24px 24px; position:relative; z-index:1; }
.qsel-breadcrumb { display:flex; align-items:center; gap:6px; flex-wrap:wrap; margin-bottom:18px; }
.qsel-bc-item { display:inline-flex; align-items:center; gap:5px; font-size:12px; font-weight:600; color:rgba(255,255,255,.55); text-decoration:none; transition:color .15s; }
.qsel-bc-item:hover { color:rgba(255,255,255,.9); }
.qsel-bc-item.active { color:rgba(255,255,255,.9); font-weight:700; }
.qsel-bc-sep { color:rgba(255,255,255,.25); font-size:11px; }
.qsel-hero-title-row { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; flex-wrap:wrap; }
.qsel-hero-badge { display:inline-flex; align-items:center; gap:6px; padding:4px 12px; background:rgba(255,255,255,.12); border:1px solid rgba(255,255,255,.18); border-radius:30px; font-size:12px; font-weight:700; color:rgba(255,255,255,.85); margin-bottom:10px; }
.qsel-hero-title { font-size:clamp(20px,3vw,26px); font-weight:900; color:#FFF; line-height:1.25; letter-spacing:-.3px; }
.qsel-hero-sub { margin-top:6px; font-size:14px; color:rgba(255,255,255,.6); font-weight:600; }
.qsel-hero-right { display:flex; align-items:center; gap:8px; flex-shrink:0; }
.btn-hero-back { display:inline-flex; align-items:center; gap:7px; padding:9px 18px; background:rgba(255,255,255,.1); border:1.5px solid rgba(255,255,255,.22); border-radius:var(--r-md); color:rgba(255,255,255,.88); font-family:var(--font); font-size:13px; font-weight:700; text-decoration:none; cursor:pointer; transition:all .18s var(--ease); }
.btn-hero-back:hover { background:rgba(255,255,255,.18); border-color:rgba(255,255,255,.4); color:#fff; }
.qsel-stats-strip { display:grid; grid-template-columns:repeat(4,1fr); gap:1px; background:rgba(255,255,255,.08); overflow:hidden; border-top:1px solid rgba(255,255,255,.1); margin-top:24px; }
.qsel-stat { padding:14px 20px; background:rgba(15,23,42,.35); backdrop-filter:blur(6px); display:flex; align-items:center; gap:12px; }
.qsel-stat-icon { width:36px; height:36px; border-radius:9px; display:flex; align-items:center; justify-content:center; font-size:16px; flex-shrink:0; }
.qsel-stat-val { font-size:20px; font-weight:800; color:#fff; line-height:1; }
.qsel-stat-lbl { font-size:11px; color:rgba(255,255,255,.5); font-weight:600; margin-top:2px; }
@@media (max-width:680px) { .qsel-stats-strip { grid-template-columns:repeat(2,1fr); } }

.qsel-toolbar { position:sticky; top:0; z-index:100; background:rgba(255,255,255,.92); backdrop-filter:blur(14px); border-bottom:1px solid var(--c-border); box-shadow:0 2px 12px rgba(15,23,42,.07); }
.qsel-toolbar-inner { max-width:1200px; margin:0 auto; padding:0 24px; height:var(--toolbar-h); display:flex; align-items:center; justify-content:space-between; gap:14px; }
.qsel-toolbar-left { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
.qsel-sel-counter { display:inline-flex; align-items:center; gap:8px; padding:7px 14px; border-radius:var(--r-md); font-size:14px; font-weight:700; border:1.5px solid var(--c-border); background:var(--c-surface-2); color:var(--c-ink-4); transition:all .2s var(--ease); white-space:nowrap; }
.qsel-sel-counter.has-selection { background:var(--c-success-light); border-color:var(--c-success-mid); color:var(--c-success-dark); }
.qsel-sel-counter-num { font-size:18px; font-weight:900; line-height:1; min-width:20px; text-align:center; transition:transform .25s var(--spring); }
.qsel-sel-counter.has-selection .qsel-sel-counter-num { color:var(--c-success); }
.tb-btn { display:inline-flex; align-items:center; gap:6px; padding:8px 16px; border-radius:var(--r-md); font-family:var(--font); font-size:13px; font-weight:700; cursor:pointer; border:1.5px solid; transition:all .18s var(--ease); white-space:nowrap; }
.tb-btn-select-all { background:var(--c-primary-light); border-color:var(--c-primary-mid); color:var(--c-primary); }
.tb-btn-select-all:hover { background:var(--c-primary); color:#fff; border-color:var(--c-primary); }
.tb-btn-clear { background:var(--c-surface-2); border-color:var(--c-border); color:var(--c-ink-4); }
.tb-btn-clear:hover { background:var(--c-rose-light); border-color:#FECDD3; color:var(--c-rose); }
.tb-btn-clear:disabled { opacity:.4; cursor:not-allowed; pointer-events:none; }
.btn-confirm-main { display:inline-flex; align-items:center; gap:8px; padding:10px 24px; background:var(--c-success); border:none; border-radius:var(--r-md); color:#fff; font-family:var(--font); font-size:14px; font-weight:800; cursor:pointer; box-shadow:0 4px 14px rgba(5,150,105,.32); transition:all .2s var(--ease); white-space:nowrap; }
.btn-confirm-main:hover:not(:disabled) { background:var(--c-success-dark); transform:translateY(-1px); box-shadow:0 6px 20px rgba(5,150,105,.4); }
.btn-confirm-main:disabled { background:var(--c-ink-6); box-shadow:none; cursor:not-allowed; opacity:.65; }

.qsel-content { max-width:1200px; margin:0 auto; padding:28px 24px; }
.qsel-section-label { display:flex; align-items:center; gap:10px; margin-bottom:18px; }
.qsel-section-label-text { font-size:13px; font-weight:800; color:var(--c-ink-4); text-transform:uppercase; letter-spacing:.8px; white-space:nowrap; }
.qsel-section-label-line { flex:1; height:1px; background:var(--c-border); }

.qsel-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:14px; }
@@media (max-width:768px) { .qsel-grid { grid-template-columns:1fr; } }

.qcard { background:var(--c-surface); border:2px solid var(--c-border); border-radius:var(--r-xl); padding:20px; cursor:pointer; position:relative; transition:border-color .22s var(--ease),background .22s var(--ease),transform .2s var(--ease),box-shadow .22s var(--ease); box-shadow:var(--sh-xs); user-select:none; overflow:hidden; }
.qcard::before { content:''; position:absolute; top:0; right:0; width:4px; height:100%; background:var(--c-primary); border-radius:0 var(--r-xl) var(--r-xl) 0; opacity:0; transition:opacity .22s; }
.qcard:hover { border-color:#B8CAF7; box-shadow:var(--sh-md); transform:translateY(-2px); }
.qcard.is-selected { border-color:var(--c-success); background:var(--c-success-light); box-shadow:0 0 0 1px var(--c-success-mid),var(--sh-sm); }
.qcard.is-selected::before { opacity:1; background:var(--c-success); }
.qcard-checkbox-area { position:absolute; top:16px; left:16px; }
.qcard-checkbox { appearance:none; -webkit-appearance:none; width:22px; height:22px; border:2px solid var(--c-ink-6); border-radius:6px; background:var(--c-surface); cursor:pointer; display:grid; place-items:center; transition:all .2s var(--spring); flex-shrink:0; }
.qcard-checkbox::after { content:''; width:6px; height:10px; border-right:2.5px solid #fff; border-bottom:2.5px solid #fff; transform:rotate(45deg) scale(0) translateY(-1px); transition:transform .22s var(--spring); }
.qcard-checkbox:checked { background:var(--c-success); border-color:var(--c-success); }
.qcard-checkbox:checked::after { transform:rotate(45deg) scale(1) translateY(-1px); }
.qcard-header { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; margin-bottom:13px; padding-left:32px; }
.qcard-ref { display:inline-flex; align-items:center; gap:4px; padding:3px 9px; background:var(--c-primary-light); border:1px solid var(--c-primary-mid); border-radius:20px; font-size:11px; font-weight:800; color:var(--c-primary); letter-spacing:.3px; white-space:nowrap; }
.qcard.is-selected .qcard-ref { background:var(--c-success-light); border-color:var(--c-success-mid); color:var(--c-success-dark); }
.qcard-num { width:28px; height:28px; border-radius:8px; background:var(--c-surface-2); border:1px solid var(--c-border); display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:800; color:var(--c-ink-4); flex-shrink:0; }
.qcard.is-selected .qcard-num { background:var(--c-success); border-color:var(--c-success); color:#fff; }
.qcard-text { font-size:15px; font-weight:700; color:var(--c-ink); line-height:1.65; margin-bottom:14px; padding-left:32px; }
.qcard-footer { display:flex; align-items:center; justify-content:space-between; gap:8px; flex-wrap:wrap; padding-top:12px; border-top:1px solid var(--c-border-2); }
.qcard.is-selected .qcard-footer { border-top-color:var(--c-success-mid); }
.qcard-badges { display:flex; align-items:center; gap:5px; flex-wrap:wrap; }
.qbadge { display:inline-flex; align-items:center; gap:4px; padding:3px 8px; border-radius:20px; font-size:11px; font-weight:700; border:1px solid transparent; white-space:nowrap; }
.qbadge-quant { background:#EFF6FF; color:#1D4ED8; border-color:#BFDBFE; }
.qbadge-verbal { background:#F5F3FF; color:#6D28D9; border-color:#DDD6FE; }
.qbadge-answer { background:#F0FDF4; color:#065F46; border-color:#A7F3D0; font-size:12px; font-weight:800; }
.qbadge-answer-missing { background:#FFF1F2; color:#9F1239; border-color:#FECDD3; }
.qbadge-confirmed { background:#F0FDF4; color:#059669; border-color:#A7F3D0; }
.qbadge-unconfirmed { background:#FFFBEB; color:#92400E; border-color:#FDE68A; }
.qbadge-label { background:var(--c-surface-2); color:var(--c-ink-4); border-color:var(--c-border); font-size:10px; }
.qcard-edit-btn { display:inline-flex; align-items:center; gap:5px; padding:5px 11px; border-radius:var(--r-sm); background:var(--c-surface-2); border:1px solid var(--c-border); color:var(--c-ink-4); font-family:var(--font); font-size:12px; font-weight:700; text-decoration:none; cursor:pointer; transition:all .15s; flex-shrink:0; }
.qcard-edit-btn:hover { background:var(--c-amber-light); border-color:var(--c-amber-mid); color:var(--c-amber); }
.qcard-check-overlay { position:absolute; top:12px; right:12px; width:32px; height:32px; background:var(--c-success); border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff; font-size:14px; opacity:0; transform:scale(.5) rotate(-10deg); transition:opacity .22s var(--spring),transform .25s var(--spring); pointer-events:none; box-shadow:0 3px 10px rgba(5,150,105,.4); }
.qcard.is-selected .qcard-check-overlay { opacity:1; transform:scale(1) rotate(0deg); }

.qsel-empty { text-align:center; padding:72px 24px; background:var(--c-surface); border:2px dashed var(--c-border); border-radius:var(--r-2xl); }
.qsel-empty-icon { width:80px; height:80px; margin:0 auto 20px; background:var(--c-surface-2); border:2px solid var(--c-border); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:34px; color:var(--c-ink-6); }
.qsel-empty-title { font-size:18px; font-weight:800; color:var(--c-ink-3); margin-bottom:8px; }
.qsel-empty-sub { font-size:14px; color:var(--c-ink-5); font-weight:600; max-width:380px; margin:0 auto; line-height:1.75; }

.qsel-bottom-bar { position:fixed; bottom:0; right:0; left:0; z-index:200; background:rgba(15,23,42,.97); backdrop-filter:blur(16px); border-top:1px solid rgba(255,255,255,.1); height:var(--bottom-bar-h); display:flex; align-items:center; box-shadow:0 -8px 32px rgba(15,23,42,.25); transform:translateY(100%); transition:transform .3s var(--ease); }
.qsel-bottom-bar.visible { transform:translateY(0); }
.qsel-bottom-bar-inner { max-width:1200px; margin:0 auto; padding:0 24px; width:100%; display:flex; align-items:center; justify-content:space-between; gap:16px; }
.qsel-bottom-count { display:inline-flex; align-items:center; gap:8px; padding:6px 14px; background:rgba(5,150,105,.18); border:1px solid rgba(5,150,105,.35); border-radius:30px; font-size:14px; font-weight:700; color:#6EE7B7; }
.qsel-bottom-count-num { font-size:20px; font-weight:900; color:#34D399; }
.qsel-bottom-text { font-size:14px; color:rgba(255,255,255,.6); font-weight:600; }
.btn-bottom-confirm { display:inline-flex; align-items:center; gap:9px; padding:12px 32px; background:linear-gradient(135deg,var(--c-success) 0%,#10B981 100%); border:none; border-radius:var(--r-lg); color:#fff; font-family:var(--font); font-size:15px; font-weight:800; cursor:pointer; box-shadow:0 4px 20px rgba(5,150,105,.45); transition:all .2s var(--ease); white-space:nowrap; position:relative; }
.btn-bottom-confirm:hover { transform:translateY(-2px) scale(1.02); box-shadow:0 8px 28px rgba(5,150,105,.55); }

@@media (max-width:600px) {
    .qsel-hero-inner,.qsel-content,.qsel-bottom-bar-inner,.qsel-toolbar-inner { padding-left:16px; padding-right:16px; }
    .qsel-bottom-text { display:none; }
}
</style>
}

<div class="qsel-page">

    {{-- Hero Header --}}
    <div class="qsel-hero">
        <div class="qsel-hero-inner">
            <nav class="qsel-breadcrumb">
                <span class="qsel-bc-item"><i class="fa fa-book" style="font-size:10px"></i> المنهج</span>
                <span class="qsel-bc-sep"><i class="fa fa-chevron-left"></i></span>
                <span class="qsel-bc-item">المحور</span>
                <span class="qsel-bc-sep"><i class="fa fa-chevron-left"></i></span>
                <span class="qsel-bc-item active">@Model.LessonTitle</span>
            </nav>

            <div class="qsel-hero-title-row">
                <div>
                    <div class="qsel-hero-badge">
                        <i class="fa fa-list-check" style="font-size:11px"></i>
                        تحديد الأسئلة يدوياً
                    </div>
                    <h1 class="qsel-hero-title">@Model.LessonTitle</h1>
                    <p class="qsel-hero-sub">اختر الأسئلة التي تريد تضمينها في الواجب ثم اضغط تأكيد</p>
                </div>
                <div class="qsel-hero-right">
                    <a onclick="history.back()" class="btn-hero-back" style="cursor:pointer">
                        <i class="fa fa-arrow-right"></i> رجوع
                    </a>
                </div>
            </div>

            <div class="qsel-stats-strip">
                <div class="qsel-stat">
                    <div class="qsel-stat-icon" style="background:rgba(37,99,235,.22);color:#93C5FD"><i class="fa fa-circle-question"></i></div>
                    <div>
                        <div class="qsel-stat-val" id="statTotal">@totalQ</div>
                        <div class="qsel-stat-lbl">إجمالي الأسئلة</div>
                    </div>
                </div>
                <div class="qsel-stat">
                    <div class="qsel-stat-icon" style="background:rgba(5,150,105,.22);color:#6EE7B7"><i class="fa fa-square-check"></i></div>
                    <div>
                        <div class="qsel-stat-val" id="statSelected">0</div>
                        <div class="qsel-stat-lbl">المحدّد</div>
                    </div>
                </div>
                <div class="qsel-stat">
                    <div class="qsel-stat-icon" style="background:rgba(217,119,6,.2);color:#FCD34D"><i class="fa fa-check-circle"></i></div>
                    <div>
                        <div class="qsel-stat-val">@confirmedQ</div>
                        <div class="qsel-stat-lbl">إجابة مؤكدة</div>
                    </div>
                </div>
                <div class="qsel-stat">
                    <div class="qsel-stat-icon" style="background:rgba(124,58,237,.2);color:#C4B5FD"><i class="fa fa-layer-group"></i></div>
                    <div>
                        <div class="qsel-stat-val">@quantQ كمي / @verbalQ لفظي</div>
                        <div class="qsel-stat-lbl">توزيع النوع</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{-- Sticky Toolbar --}}
    <div class="qsel-toolbar">
        <div class="qsel-toolbar-inner">
            <div class="qsel-toolbar-left">
                <div class="qsel-sel-counter" id="selCounterBadge">
                    <i class="fa fa-square-check" style="font-size:13px"></i>
                    <span class="qsel-sel-counter-num" id="toolbarCount">0</span>
                    <span>من</span>
                    <span>@totalQ</span>
                    <span>محدد</span>
                </div>
                <button type="button" class="tb-btn tb-btn-select-all" id="selectAllBtn" onclick="qselSelectAll()">
                    <i class="fa fa-check-double"></i> تحديد الكل
                </button>
                <button type="button" class="tb-btn tb-btn-clear" id="clearBtn" disabled onclick="qselClearAll()">
                    <i class="fa fa-xmark"></i> تفريغ
                </button>
            </div>
            <div>
                <button type="submit" form="selectionForm" class="btn-confirm-main" id="toolbarConfirmBtn" disabled>
                    <i class="fa fa-check-circle"></i>
                    تأكيد المحدد
                    <span id="toolbarConfirmCount" style="font-size:13px;background:rgba(255,255,255,.2);padding:1px 7px;border-radius:20px;font-weight:900">0</span>
                </button>
            </div>
        </div>
    </div>

    {{-- Content --}}
    <div class="qsel-content">

        <div class="qsel-section-label">
            <span class="qsel-section-label-text">الأسئلة المتاحة</span>
            <div class="qsel-section-label-line"></div>
        </div>

        <form id="selectionForm" method="post" asp-area="Admin" asp-controller="QuestionReview" asp-action="ConfirmManualSelection">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="LessonId" />
            <input type="hidden" asp-for="SectionId" />
            <input type="hidden" asp-for="CurriculumId" />
            <input type="hidden" asp-for="BatchId" />

            @if (questions.Any())
            {
                <div class="qsel-grid" id="cardsGrid">
                    @foreach (var q in questions)
                    {
                        idx++;
                        var cardId = $"card-{q.Id}";
                        <div class="qcard" onclick="qselToggleCard(this)" data-id="@q.Id" id="@cardId">
                            <div class="qcard-check-overlay"><i class="fa fa-check"></i></div>
                            <div class="qcard-checkbox-area">
                                <input type="checkbox"
                                       class="qcard-checkbox"
                                       name="SelectedQuestionIds"
                                       value="@q.Id"
                                       onchange="qselOnCheckboxChange(event)"
                                       onclick="event.stopPropagation()"
                                       @(Model.SelectedQuestionIds.Contains(q.Id) ? "checked" : "") />
                            </div>
                            <div class="qcard-header">
                                <span class="qcard-ref">
                                    <i class="fa fa-hashtag" style="font-size:9px"></i>
                                    @(string.IsNullOrWhiteSpace(q.ReferenceNumber) ? $"Q-{idx:D4}" : q.ReferenceNumber)
                                </span>
                                <span class="qcard-num">@idx</span>
                            </div>
                            <div class="qcard-text">
                                @Html.Raw(q.TitlePreview ?? q.Title ?? "—")
                            </div>
                            <div class="qcard-footer">
                                <div class="qcard-badges">
                                    @if (q.IsQuantitative)
                                    {
                                        <span class="qbadge qbadge-quant"><i class="fa fa-chart-bar" style="font-size:9px"></i> كمي</span>
                                    }
                                    else
                                    {
                                        <span class="qbadge qbadge-verbal"><i class="fa fa-font" style="font-size:9px"></i> لفظي</span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(q.CorrectAnswer))
                                    {
                                        <span class="qbadge qbadge-answer"><i class="fa fa-check" style="font-size:9px"></i> @q.CorrectAnswer</span>
                                    }
                                    else
                                    {
                                        <span class="qbadge qbadge-answer-missing"><i class="fa fa-xmark" style="font-size:9px"></i> غير محدد</span>
                                    }

                                    @if (q.IsAnswerConfirmed)
                                    {
                                        <span class="qbadge qbadge-confirmed"><i class="fa fa-shield-check" style="font-size:9px"></i> مؤكدة</span>
                                    }
                                    else
                                    {
                                        <span class="qbadge qbadge-unconfirmed"><i class="fa fa-clock" style="font-size:9px"></i> غير مؤكدة</span>
                                    }

                                    @foreach (var label in q.SelectedLabels.Take(2))
                                    {
                                        <span class="qbadge qbadge-label">@label</span>
                                    }
                                </div>
                                <a asp-area="Admin" asp-controller="Questions" asp-action="Edit" asp-route-id="@q.Id"
                                   class="qcard-edit-btn" target="_blank" onclick="event.stopPropagation()">
                                    <i class="fa fa-pen-to-square"></i> تعديل
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="qsel-empty">
                    <div class="qsel-empty-icon"><i class="fa fa-inbox"></i></div>
                    <div class="qsel-empty-title">لا توجد أسئلة متاحة</div>
                    <div class="qsel-empty-sub">لم يتم العثور على أسئلة مراجعة ومعتمدة لهذا المؤشر. تحقق من بنك الأسئلة أو عد لاحقاً.</div>
                </div>
            }

        </form>

    </div>

    {{-- Sticky Bottom Bar --}}
    <div class="qsel-bottom-bar" id="bottomBar">
        <div class="qsel-bottom-bar-inner">
            <div style="display:flex;align-items:center;gap:12px">
                <div class="qsel-bottom-count">
                    <i class="fa fa-check-double" style="font-size:13px"></i>
                    <span class="qsel-bottom-count-num" id="bottomCount">0</span>
                    سؤال محدد
                </div>
                <div class="qsel-bottom-text">جاهز للإدراج في الواجب</div>
            </div>
            <button type="submit" form="selectionForm" class="btn-bottom-confirm">
                <i class="fa fa-paper-plane"></i>
                تأكيد وإدراج الأسئلة
            </button>
        </div>
    </div>

</div>

@section Scripts {
<script>
(function () {
    'use strict';
    var selected = new Set();
    var total    = parseInt(document.getElementById('statTotal')?.textContent || '0', 10);

    // pre-select any already checked
    document.querySelectorAll('.qcard-checkbox:checked').forEach(function (cb) {
        var card = cb.closest('.qcard');
        if (card) { card.classList.add('is-selected'); selected.add(card.getAttribute('data-id')); }
    });

    function updateUI() {
        var n = selected.size;
        var badge = document.getElementById('selCounterBadge');
        badge.classList.toggle('has-selection', n > 0);
        document.getElementById('toolbarCount').textContent = n;
        document.getElementById('toolbarConfirmCount').textContent = n;
        document.getElementById('statSelected').textContent = n;
        document.getElementById('bottomCount').textContent = n;

        var confirmBtn = document.getElementById('toolbarConfirmBtn');
        var clearBtn   = document.getElementById('clearBtn');
        var saBtn      = document.getElementById('selectAllBtn');
        var bottomBar  = document.getElementById('bottomBar');

        confirmBtn.disabled = n === 0;
        clearBtn.disabled   = n === 0;
        bottomBar.classList.toggle('visible', n > 0);

        saBtn.innerHTML = n === total
            ? '<i class="fa fa-xmark-circle"></i> إلغاء تحديد الكل'
            : '<i class="fa fa-check-double"></i> تحديد الكل';

        var num = document.getElementById('toolbarCount');
        num.style.transform = 'scale(1.35)';
        setTimeout(function () { num.style.transform = 'scale(1)'; }, 180);
    }

    window.qselToggleCard = function (card) {
        var cb  = card.querySelector('.qcard-checkbox');
        var now = !cb.checked;
        cb.checked = now;
        card.classList.toggle('is-selected', now);
        if (now) selected.add(card.getAttribute('data-id'));
        else      selected.delete(card.getAttribute('data-id'));
        updateUI();
    };

    window.qselOnCheckboxChange = function (e) {
        var cb   = e.target;
        var card = cb.closest('.qcard');
        var id   = card.getAttribute('data-id');
        card.classList.toggle('is-selected', cb.checked);
        if (cb.checked) selected.add(id);
        else             selected.delete(id);
        updateUI();
    };

    window.qselSelectAll = function () {
        var allSel = selected.size === total;
        document.querySelectorAll('.qcard').forEach(function (card) {
            var cb = card.querySelector('.qcard-checkbox');
            var id = card.getAttribute('data-id');
            cb.checked = !allSel;
            card.classList.toggle('is-selected', !allSel);
            if (!allSel) selected.add(id);
            else          selected.delete(id);
        });
        updateUI();
    };

    window.qselClearAll = function () {
        document.querySelectorAll('.qcard').forEach(function (card) {
            card.querySelector('.qcard-checkbox').checked = false;
            card.classList.remove('is-selected');
        });
        selected.clear();
        updateUI();
    };

    updateUI();
})();
</script>
}
