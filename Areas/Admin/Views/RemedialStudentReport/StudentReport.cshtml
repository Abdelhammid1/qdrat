@model QdratNew.ViewModels.Remedial.RemedialStudentReportVm
@{
    ViewData["Title"] = "📋 تقرير الطالب العلاجي";
}

<div class="container py-4">
    <h3 class="fw-bold text-primary mb-3">📋 التقرير العلاجي للطالب @Model.StudentName</h3>

    <div class="row g-3 text-center">
        <div class="col-md-3">
            <div class="card border-info shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold text-info">🎥 عدد الفيديوهات</h6>
                    <h4>@Model.TotalVideos</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold text-success">✅ المكتملة</h6>
                    <h4>@Model.CompletedVideos</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold text-warning">⏱️ إجمالي المشاهدة</h6>
                    <h4>@Model.TotalWatchMinutes دقيقة</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-primary shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold text-primary">📊 متوسط الاختبارات</h6>
                    <h4>@Model.AverageQuizScore %</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <h5 class="fw-bold">نسبة التقدم:</h5>
        <div class="progress" style="height: 24px;">
            <div class="progress-bar @Model.ProgressColor fw-bold"
                 style="width:@Model.ProgressPercent%">
                @Model.ProgressPercent %
            </div>
        </div>
    </div>

    <div class="row g-3 mt-4 text-center">
        <div class="col-md-6">
            <div class="card border-success shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold text-success">🟢 حضر الجلسة</h6>
                    <h4>@Model.AttendedSessions</h4>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-danger shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold text-danger">🔴 تغيب</h6>
                    <h4>@Model.MissedSessions</h4>
                </div>
            </div>
        </div>
    </div>
</div>
