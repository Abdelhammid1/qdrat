@model QdratNew.Services.AI.CurriculumAnalysisReport

<h2>تقرير الذكاء الاصطناعي للقسم: @Model.CurriculumTitle</h2>

<table class="table table-bordered">
    <tr>
        <th>إجمالي الطلاب</th>
        <td>@Model.TotalStudents</td>
    </tr>
    <tr>
        <th>المتوسط العام للدرجات</th>
        <td>@Model.AverageScore</td>
    </tr>
    <tr>
        <th>مستوى الصعوبة</th>
        <td>@Model.DifficultyLevel</td>
    </tr>
</table>

<a asp-action="Index" class="btn btn-secondary">العودة إلى قائمة الأقسام</a>
