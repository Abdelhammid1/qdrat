@model QdratNew.ViewModels.Curriculum.CurriculumViewModel

<h2>حذف القسم</h2>

<p>هل أنت متأكد أنك تريد حذف القسم التالي؟</p>

<div class="form-group">
    <label>اسم المنهج:</label>
    <p>@Model.Title</p>
</div>

<div class="form-group">
    <label>الدورات التدريبية المرتبطة:</label>
    <ul>
        @foreach (var course in Model.Courses.Where(c => Model.CourseIds.Contains(int.Parse(c.Value))))
        {
            <li>@course.Text</li>
        }
    </ul>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">حذف</button>
    <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
</form>
