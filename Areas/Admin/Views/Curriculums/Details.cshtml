@model QdratNew.ViewModels.Curriculum.CurriculumViewModel

<h2>تفاصيل القسم</h2>

<div class="form-group">
    <label>اسم القسم:</label>
    <p>@Model.Title</p>
</div>

<div class="form-group">
    <label>الوصف:</label>
    <p>@Model.Description</p>
</div>

<div class="form-group">
    <label>الدورات التدريبية المرتبطة:</label>
    <ul>
        @foreach (var course in Model.Courses.Where(c => Model.CourseIds.Contains(int.Parse(c.Value))))
        {
            <li>@course.Text</li>
        }
    </ul>
</div>

<h3>الوحدات التعليمية</h3>
<table class="table">
    <thead>
        <tr>
            <th>اسم الوحدة</th>
            <th>محتوى الوحدة</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var module in Model.Modules)
        {
            <tr>
                <td>@module.Title</td>
                <td>@module.Content</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">العودة</a>
