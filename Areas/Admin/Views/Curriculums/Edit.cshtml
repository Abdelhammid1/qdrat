@model QdratNew.ViewModels.Curriculum.CurriculumViewModel

@{
    ViewData["Title"] = "تعديل القسم";
}

<div class="container-fluid py-4" dir="rtl">
    <div class="qdrat-page-header mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <div class="qdrat-breadcrumb mb-2">
                    <span>الإدارة</span>
                    <i class="fas fa-chevron-left"></i>
                    <span>الأقسام / المناهج</span>
                    <i class="fas fa-chevron-left"></i>
                    <strong>تعديل قسم</strong>
                </div>
                <h2 class="qdrat-page-title mb-1">
                    <i class="fas fa-pen-to-square"></i>
                    تعديل القسم
                </h2>
                <p class="qdrat-page-subtitle mb-0">
                    عدّل بيانات القسم والدورات المرتبطة به مع الحفاظ على نفس آلية الحفظ الحالية.
                </p>
            </div>

            <div class="qdrat-header-actions">
                <a asp-action="Index" class="btn btn-light qdrat-btn-back">
                    <i class="fas fa-arrow-right"></i>
                    الرجوع إلى القائمة
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-xl-8">
            <div class="qdrat-card">
                <div class="qdrat-card-header">
                    <div>
                        <h5 class="mb-1">
                            <i class="fas fa-clipboard-check"></i>
                            بيانات القسم الحالية
                        </h5>
                        <p class="mb-0">يمكنك تعديل العنوان والوصف ونوع القسم وخيارات العرض والدورات المرتبطة.</p>
                    </div>
                </div>

                <form asp-action="Edit" method="post" class="qdrat-form">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger qdrat-validation-summary"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <div class="qdrat-field">
                                <label asp-for="Title" class="form-label">
                                    <i class="fas fa-heading"></i>
                                    عنوان القسم
                                </label>
                                <input asp-for="Title" class="form-control qdrat-input" placeholder="أدخل عنوان القسم" autocomplete="off" />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="qdrat-field">
                                <label asp-for="Description" class="form-label">
                                    <i class="fas fa-align-right"></i>
                                    الوصف
                                </label>
                                <textarea asp-for="Description" class="form-control qdrat-input qdrat-textarea" rows="4" placeholder="أدخل وصفًا مختصرًا يوضح محتوى القسم"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="qdrat-field">
                                <label class="form-label" asp-for="CourseIds">
                                    <i class="fas fa-layer-group"></i>
                                    الدورات المرتبطة
                                </label>
                                <select asp-for="CourseIds" class="form-select qdrat-input qdrat-multi-select" asp-items="Model.Courses" multiple="multiple"></select>
                                <span asp-validation-for="CourseIds" class="text-danger small"></span>
                                <div class="qdrat-help-text">
                                    يمكنك اختيار أكثر من دورة لربط هذا القسم بها.
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6">
                            <div class="qdrat-field">
                                <label asp-for="CurriculumTypeName" class="form-label">
                                    <i class="fas fa-tags"></i>
                                    نوع القسم
                                </label>
                                <select asp-for="CurriculumTypeName" asp-items="Model.CurriculumTypeOptions" class="form-select qdrat-input">
                                    <option value="">اختر نوع القسم...</option>
                                </select>
                                <span asp-validation-for="CurriculumTypeName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6">
                            <div class="qdrat-check-card h-100">
                                <div class="form-check form-switch m-0">
                                    <input asp-for="IsRTL" class="form-check-input" type="checkbox" role="switch" id="isRtlCheck" />
                                    <label class="form-check-label" for="isRtlCheck">
                                        <span class="qdrat-check-title">
                                            <i class="fas fa-align-right"></i>
                                            هل المنهج باللغة العربية (RTL)؟
                                        </span>
                                        <span class="qdrat-check-text">يفيد هذا الخيار في ضبط اتجاه العرض داخل صفحات الطالب ولوحات الإدارة.</span>
                                    </label>
                                </div>
                                <span asp-validation-for="IsRTL" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6">
                            <div class="qdrat-check-card h-100">
                                <div class="form-check form-switch m-0">
                                    <input asp-for="IsQuantitative" class="form-check-input" type="checkbox" role="switch" id="isQuantitativeCheck" />
                                    <label class="form-check-label" for="isQuantitativeCheck">
                                        <span class="qdrat-check-title">
                                            <i class="fas fa-square-root-variable"></i>
                                            هل القسم يحتوي على أرقام هندي؟
                                        </span>
                                        <span class="qdrat-check-text">يستخدم عند عرض الأرقام بصيغة مناسبة للأسئلة الكمية.</span>
                                    </label>
                                </div>
                                <span asp-validation-for="IsQuantitative" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="qdrat-actions mt-4">
                        <button type="submit" class="btn btn-success qdrat-btn-primary">
                            <i class="fas fa-save"></i>
                            حفظ
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary qdrat-btn-outline">
                            <i class="fas fa-times"></i>
                            إلغاء
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="qdrat-side-card mb-4">
                <div class="qdrat-side-icon">
                    <i class="fas fa-sitemap"></i>
                </div>
                <h5>تعديل منظم وآمن</h5>
                <p>
                    تم إبقاء نفس أسماء الحقول والـ Action حتى تستمر عملية الحفظ بنفس منطق الكنترولر الحالي.
                </p>
            </div>

            <div class="qdrat-tips-card">
                <h6>
                    <i class="fas fa-lightbulb"></i>
                    ملاحظات تعديل
                </h6>
                <ul class="mb-0">
                    <li>تغيير الدورات المرتبطة يؤثر على ظهور القسم داخل قوائم التشغيل.</li>
                    <li>تأكد من نوع القسم قبل الحفظ حتى لا تتأثر الفلاتر المرتبطة به.</li>
                    <li>خيارات RTL والأرقام الهندية تؤثر على العرض فقط حسب منطق المشروع الحالي.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
    .qdrat-page-header {
        background: linear-gradient(135deg, #f8fafc 0%, #eef4ff 100%);
        border: 1px solid #e5edf8;
        border-radius: 22px;
        padding: 24px;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.06);
    }

    .qdrat-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #64748b;
        font-size: 13px;
        flex-wrap: wrap;
    }

        .qdrat-breadcrumb i {
            font-size: 10px;
            color: #94a3b8;
        }

    .qdrat-page-title {
        color: #1e293b;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .qdrat-page-title i {
            color: #2563eb;
        }

    .qdrat-page-subtitle {
        color: #64748b;
        font-size: 15px;
    }

    .qdrat-btn-back {
        border-radius: 14px;
        padding: 10px 16px;
        color: #334155;
        border: 1px solid #e2e8f0;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.06);
    }

    .qdrat-card,
    .qdrat-side-card,
    .qdrat-tips-card {
        background: #ffffff;
        border: 1px solid #e5edf8;
        border-radius: 22px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
    }

    .qdrat-card {
        overflow: hidden;
    }

    .qdrat-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #edf2f7;
        background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
    }

        .qdrat-card-header h5 {
            color: #1e293b;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .qdrat-card-header h5 i {
                color: #2563eb;
            }

        .qdrat-card-header p,
        .qdrat-help-text {
            color: #64748b;
            font-size: 14px;
        }

    .qdrat-form {
        padding: 24px;
    }

    .qdrat-field .form-label {
        color: #334155;
        font-weight: 700;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .qdrat-field .form-label i {
            color: #2563eb;
            font-size: 13px;
        }

    .qdrat-input {
        border-radius: 14px;
        border: 1px solid #dbe4f0;
        min-height: 46px;
        color: #1e293b;
        background-color: #ffffff;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

        .qdrat-input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .12);
        }

    .qdrat-textarea {
        min-height: 120px;
        resize: vertical;
    }

    .qdrat-multi-select {
        min-height: 140px;
        padding: 10px;
    }

    .qdrat-help-text {
        margin-top: 8px;
    }

    .qdrat-check-card {
        border: 1px solid #e5edf8;
        border-radius: 18px;
        padding: 18px;
        background: #f8fafc;
    }

        .qdrat-check-card .form-check-input {
            float: right;
            margin-left: 12px;
            margin-right: 0;
            width: 3rem;
            height: 1.5rem;
            cursor: pointer;
        }

        .qdrat-check-card .form-check-label {
            cursor: pointer;
            display: block;
            padding-right: 58px;
        }

    .qdrat-check-title {
        color: #1e293b;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
    }

        .qdrat-check-title i {
            color: #2563eb;
        }

    .qdrat-check-text {
        display: block;
        color: #64748b;
        font-size: 13px;
        line-height: 1.7;
    }

    .qdrat-validation-summary {
        border-radius: 16px;
        border: 1px solid #fecaca;
        background: #fff1f2;
    }

    .qdrat-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        border-top: 1px solid #edf2f7;
        padding-top: 20px;
    }

    .qdrat-btn-primary,
    .qdrat-btn-outline {
        border-radius: 14px;
        padding: 10px 18px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .qdrat-side-card {
        padding: 24px;
        text-align: center;
    }

    .qdrat-side-icon {
        width: 64px;
        height: 64px;
        border-radius: 20px;
        background: #eff6ff;
        color: #2563eb;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin-bottom: 16px;
    }

    .qdrat-side-card h5 {
        color: #1e293b;
        font-weight: 800;
    }

    .qdrat-side-card p {
        color: #64748b;
        line-height: 1.8;
        margin-bottom: 0;
    }

    .qdrat-tips-card {
        padding: 22px;
    }

        .qdrat-tips-card h6 {
            color: #1e293b;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 14px;
        }

            .qdrat-tips-card h6 i {
                color: #f59e0b;
            }

        .qdrat-tips-card ul {
            padding-right: 18px;
            color: #64748b;
            line-height: 1.9;
        }

    @@media (max-width: 767.98px) {
        .qdrat-page-header,
        .qdrat-form,
        .qdrat-card-header,
        .qdrat-side-card,
        .qdrat-tips-card {
            padding: 18px;
        }

        .qdrat-page-title {
            font-size: 22px;
        }

        .qdrat-actions .btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
