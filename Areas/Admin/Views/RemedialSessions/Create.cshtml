@model QdratNew.ViewModels.Remedial.RemedialSessionCreateVm
@{
    ViewData["Title"] = "إنشاء جلسة علاجية جديدة";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

<div class="qdrat-page" dir="rtl">

    <div class="qdrat-hero mb-4">
        <div>
            <div class="qdrat-kicker">
                <i class="bi bi-heart-pulse"></i>
                جلسة علاجية
            </div>
            <h2 class="qdrat-title">إنشاء جلسة علاجية جديدة</h2>
            <p class="qdrat-subtitle">
                اختر الطالب والخطة العلاجية، ثم حدد موعد الجلسة. سيتم عرض المحاور الضعيفة المرتبطة بالخطة لمساعدة الإدارة في تنظيم الجلسة بدقة.
            </p>
        </div>

        <div class="qdrat-hero-icon">
            <i class="bi bi-calendar2-plus"></i>
        </div>
    </div>

    <div class="qdrat-card">
        <div class="qdrat-card-header">
            <div>
                <h5>
                    <i class="bi bi-ui-checks-grid"></i>
                    بيانات الجلسة
                </h5>
                <p>حدد الطالب أولًا ليتم تحميل الخطط العلاجية المرتبطة به ثم اختر موعد الجلسة.</p>
            </div>
        </div>

        <div class="qdrat-card-body">
            <form asp-action="Create" method="post" autocomplete="off">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert qdrat-alert qdrat-alert-danger mb-4"></div>

                <div class="row g-4">
                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="StudentId" class="form-label">الطالب</label>
                            <div class="qdrat-input-wrap">
                                <i class="bi bi-person-badge"></i>
                                <select asp-for="StudentId" asp-items="Model.Students" class="form-select" id="StudentSelect">
                                    <option value="">-- اختر الطالب --</option>
                                </select>
                            </div>
                            <span asp-validation-for="StudentId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="RemedialPlanId" class="form-label">الخطة العلاجية</label>
                            <div class="qdrat-input-wrap">
                                <i class="bi bi-clipboard2-pulse"></i>
                                <select asp-for="RemedialPlanId" asp-items="Model.Plans" class="form-select" id="PlanSelect">
                                    <option value="">-- اختر الخطة العلاجية --</option>
                                </select>
                            </div>
                            <span asp-validation-for="RemedialPlanId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-12">
                        <div id="WeakSectionsContainer" class="qdrat-weak-box" style="display:none;">
                            <div class="qdrat-weak-title">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                المحاور الضعيفة في الخطة
                            </div>
                            <ul id="WeakSectionsList" class="list-group qdrat-weak-list"></ul>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="ScheduledAt" class="form-label"></label>
                            <div class="qdrat-input-wrap">
                                <i class="bi bi-calendar-event"></i>
                                <input asp-for="ScheduledAt" type="datetime-local" class="form-control" />
                            </div>
                            <span asp-validation-for="ScheduledAt" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="qdrat-note mt-4">
                    <i class="bi bi-info-circle"></i>
                    <span>اختيار الخطة يعرض المحاور الضعيفة فقط للمعاونة في التنظيم ولا يغيّر من بيانات الحفظ الأساسية.</span>
                </div>

                <div class="qdrat-actions">
                    <a href="@Url.Action("Index")" class="btn qdrat-btn qdrat-btn-light">
                        <i class="bi bi-arrow-right"></i>
                        إلغاء
                    </a>

                    <button type="submit" class="btn qdrat-btn qdrat-btn-primary">
                        <i class="bi bi-check-circle"></i>
                        حفظ الجلسة
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .qdrat-page {
        padding: 24px;
        background: #f5f7fb;
        min-height: calc(100vh - 80px);
        font-family: inherit;
    }

    .qdrat-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 26px;
        border-radius: 24px;
        background: linear-gradient(135deg, #102a43 0%, #1d4ed8 58%, #38bdf8 100%);
        color: #fff;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
    }

    .qdrat-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .qdrat-title {
        margin: 0;
        font-size: 28px;
        font-weight: 900;
        letter-spacing: -0.5px;
    }

    .qdrat-subtitle {
        margin: 10px 0 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 15px;
        line-height: 1.8;
        max-width: 850px;
    }

    .qdrat-hero-icon {
        width: 74px;
        height: 74px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.16);
        font-size: 34px;
        flex: 0 0 auto;
    }

    .qdrat-card {
        border: 1px solid #e5e7eb;
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    .qdrat-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #edf0f5;
        background: #fff;
    }

        .qdrat-card-header h5 {
            margin: 0;
            color: #0f172a;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .qdrat-card-header h5 i {
                color: #2563eb;
            }

        .qdrat-card-header p {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 14px;
        }

    .qdrat-card-body {
        padding: 24px;
    }

    .qdrat-field .form-label {
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 9px;
    }

    .qdrat-input-wrap {
        position: relative;
    }

        .qdrat-input-wrap > i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 3;
            pointer-events: none;
        }

        .qdrat-input-wrap .form-select,
        .qdrat-input-wrap .form-control {
            min-height: 48px;
            border-radius: 15px;
            border-color: #dbe3ef;
            padding-right: 42px;
            font-weight: 700;
        }

            .qdrat-input-wrap .form-select:focus,
            .qdrat-input-wrap .form-control:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 0.22rem rgba(37, 99, 235, 0.12);
            }

    .qdrat-weak-box {
        border: 1px solid #fde68a;
        border-radius: 18px;
        background: #fffbeb;
        padding: 16px;
    }

    .qdrat-weak-title {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #92400e;
        font-weight: 900;
        margin-bottom: 12px;
    }

    .qdrat-weak-list {
        border-radius: 14px;
        overflow: hidden;
    }

        .qdrat-weak-list .list-group-item {
            border-color: #fde68a;
            color: #78350f;
            font-weight: 800;
            background: #fffdf5;
        }

    .qdrat-note {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 13px 15px;
        border-radius: 16px;
        background: #eff6ff;
        color: #1e40af;
        font-weight: 800;
        font-size: 13px;
        line-height: 1.8;
    }

    .qdrat-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 26px;
        margin-top: 28px;
        border-top: 1px solid #edf0f5;
    }

    .qdrat-btn {
        min-height: 46px;
        border-radius: 14px;
        padding: 10px 24px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .qdrat-btn-primary {
        background: #16a34a;
        border-color: #16a34a;
        color: #fff;
    }

        .qdrat-btn-primary:hover {
            background: #15803d;
            border-color: #15803d;
            color: #fff;
        }

    .qdrat-btn-light {
        background: #f8fafc;
        border-color: #dbe3ef;
        color: #334155;
    }

        .qdrat-btn-light:hover {
            background: #eef2f7;
            border-color: #cbd5e1;
            color: #0f172a;
        }

    .qdrat-alert {
        border: 0;
        border-radius: 18px;
        padding: 15px 18px;
        font-weight: 800;
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.07);
    }

        .qdrat-alert:empty {
            display: none;
        }

    .qdrat-alert-danger {
        color: #991b1b;
        background: #fee2e2;
    }

    @@media (max-width: 768px) {
        .qdrat-page {
            padding: 14px;
        }

        .qdrat-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 20px;
        }

        .qdrat-title {
            font-size: 23px;
        }

        .qdrat-hero-icon {
            width: 58px;
            height: 58px;
            font-size: 26px;
        }

        .qdrat-card-body,
        .qdrat-card-header {
            padding: 18px;
        }

        .qdrat-actions {
            flex-direction: column-reverse;
        }

        .qdrat-btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const studentSelect = $('#StudentSelect');
            const planSelect = $('#PlanSelect');
            const weakSectionsContainer = $('#WeakSectionsContainer');
            const sectionsList = $('#WeakSectionsList');

            studentSelect.on('change', function () {
                var studentId = $(this).val();
                weakSectionsContainer.hide();
                sectionsList.empty();

                if (!studentId) {
                    planSelect.html('<option value="">-- اختر الخطة العلاجية --</option>');
                    return;
                }

                planSelect.html('<option value="">جاري تحميل الخطط...</option>');

                $.getJSON('/Admin/RemedialSessions/GetPlansByStudent', { studentId: studentId }, function (plans) {
                    planSelect.empty();
                    planSelect.append('<option value="">-- اختر الخطة العلاجية --</option>');

                    if (!plans || plans.length === 0) {
                        planSelect.append('<option disabled>لا توجد خطط علاجية لهذا الطالب</option>');
                        return;
                    }

                    plans.forEach(function (p) {
                        planSelect.append('<option value="' + escapeHtmlAttribute(p.id) + '">' + escapeHtml(p.title) + '</option>');
                    });
                });
            });

            planSelect.on('change', function () {
                var planId = $(this).val();
                sectionsList.empty();

                if (!planId) {
                    weakSectionsContainer.hide();
                    return;
                }

                $.getJSON('/Admin/RemedialSessions/GetWeakSectionsByPlan', { planId: planId }, function (sections) {
                    if (sections && sections.length > 0) {
                        weakSectionsContainer.show();

                        sections.forEach(function (s) {
                            sectionsList.append(
                                '<li class="list-group-item d-flex justify-content-between align-items-center">' +
                                '<span><i class="bi bi-exclamation-triangle-fill text-warning ms-2"></i>' + escapeHtml(s.title) + '</span>' +
                                '</li>'
                            );
                        });
                    } else {
                        weakSectionsContainer.hide();
                    }
                });
            });

            function escapeHtml(value) {
                if (value === null || value === undefined) {
                    return '';
                }

                return String(value)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            function escapeHtmlAttribute(value) {
                return escapeHtml(value);
            }
        })();
    </script>
}
