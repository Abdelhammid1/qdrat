@model QdratNew.ViewModels.Remedial.RemedialSessionDetailsVm
@{
    ViewData["Title"] = "📊 تفاصيل الجلسة العلاجية";
}

<div class="container py-4">
    <h3 class="fw-bold text-primary mb-3">📊 تفاصيل الجلسة العلاجية</h3>

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <p><strong>الطالب:</strong> @Model.StudentName</p>
            <p><strong>الخطة:</strong> @Model.PlanTitle</p>
            <p><strong>الكود المرجعي:</strong> <span class="fw-bold text-danger">@Model.AccessCode</span></p>
            <p><strong>تاريخ الإنشاء:</strong> @Model.CreatedAt.ToShortDateString()</p>
        </div>
    </div>

    <div class="row g-3 text-center">
        <div class="col-md-4">
            <div class="card border-info shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold text-info">⏱️ مدة المشاهدة</h6>
                    <h4>@Model.TotalWatchedSeconds ثانية</h4>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-success shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold text-success">📚 عدد التدريبات التطبيقية</h6>
                    <h4>@Model.TotalQuizAttempts</h4>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-warning shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold text-warning">📈 متوسط الدرجات</h6>
                    <h4>@Model.AverageScore%</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 text-center">
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">العودة</a>
    </div>
</div>
