@model QdratNew.ViewModels.RemedialSessionViewModel

@{
    ViewData["Title"] = "🗑️ تأكيد حذف الجلسة";
}

<div class="container mt-4">
    <h2 class="text-danger fw-bold mb-4"><i class="fas fa-trash-alt"></i> تأكيد حذف الجلسة</h2>

    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle"></i>
        هل أنت متأكد أنك تريد حذف هذه الجلسة؟ لا يمكن التراجع عن هذا الإجراء.
    </div>

    <div class="card border-danger mb-3">
        <div class="card-body">
            <h5 class="card-title text-danger"><i class="fas fa-calendar"></i> الجلسة بتاريخ: @Model.ScheduledDate.ToString("yyyy-MM-dd")</h5>
            <p class="card-text">
                <strong>الوقت:</strong> @Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm") <br />
                <strong>المحور:</strong> @Model.SectionTitle <br />
                <strong>القاعات:</strong> @Model.RoomName <br />
                <strong>الموارد:</strong> @Model.Resources <br />
                <strong>عدد المقاعد:</strong> @Model.TotalSeats <br />
                <strong>الرسوم:</strong> @(Model.Fee.HasValue ? Model.Fee.Value.ToString("C0") : "—") <br />
                <strong>إلزامية:</strong> @(Model.IsMandatory ? "نعم" : "لا")
            </p>
        </div>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> حذف نهائي</button>
        <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
    </form>
</div>
