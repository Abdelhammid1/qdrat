@model QdratNew.ViewModels.RemedialSessionViewModel

@{
    ViewData["Title"] = "تعديل جلسة علاجية";
}

<div class="qdrat-page" dir="rtl">

    <div class="qdrat-hero mb-4">
        <div>
            <div class="qdrat-kicker">
                <i class="fas fa-edit"></i>
                تعديل جلسة علاجية
            </div>
            <h2 class="qdrat-title">تعديل الجلسة العلاجية</h2>
            <p class="qdrat-subtitle">
                عدّل بيانات الجلسة العلاجية من حيث المحور، التاريخ، الوقت، القاعة، الموارد، المقاعد والرسوم بدون تغيير مسار الحفظ الحالي.
            </p>
        </div>

        <div class="qdrat-hero-icon">
            <i class="fas fa-calendar-check"></i>
        </div>
    </div>

    <div class="qdrat-card">
        <div class="qdrat-card-header">
            <div>
                <h5>
                    <i class="fas fa-sliders-h"></i>
                    بيانات الجلسة
                </h5>
                <p>راجع البيانات الحالية ثم احفظ التعديلات.</p>
            </div>
        </div>

        <div class="qdrat-card-body">
            <form asp-action="Edit" method="post" autocomplete="off">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="alert qdrat-alert qdrat-alert-danger mb-4"></div>

                <div class="row g-4">
                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="SectionId" class="form-label">المحور / القسم</label>
                            <div class="qdrat-input-wrap">
                                <i class="fas fa-layer-group"></i>
                                <select asp-for="SectionId" class="form-select" asp-items="Model.SectionList">
                                    <option value="">-- اختر المحور --</option>
                                </select>
                            </div>
                            <span asp-validation-for="SectionId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="ScheduledDate" class="form-label">التاريخ</label>
                            <div class="qdrat-input-wrap">
                                <i class="fas fa-calendar-alt"></i>
                                <input asp-for="ScheduledDate" class="form-control" type="date" />
                            </div>
                            <span asp-validation-for="ScheduledDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="StartTime" class="form-label">وقت البدء</label>
                            <div class="qdrat-input-wrap">
                                <i class="fas fa-clock"></i>
                                <input asp-for="StartTime" class="form-control" type="time" />
                            </div>
                            <span asp-validation-for="StartTime" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="EndTime" class="form-label">وقت الانتهاء</label>
                            <div class="qdrat-input-wrap">
                                <i class="fas fa-hourglass-end"></i>
                                <input asp-for="EndTime" class="form-control" type="time" />
                            </div>
                            <span asp-validation-for="EndTime" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="RoomName" class="form-label">اسم القاعة</label>
                            <div class="qdrat-input-wrap">
                                <i class="fas fa-school"></i>
                                <input asp-for="RoomName" class="form-control" placeholder="مثال: قاعة 1" />
                            </div>
                            <span asp-validation-for="RoomName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="Resources" class="form-label">الموارد</label>
                            <div class="qdrat-input-wrap">
                                <i class="fas fa-box-open"></i>
                                <input asp-for="Resources" class="form-control" placeholder="كمبيوتر - سماعة - مذكرة..." />
                            </div>
                            <span asp-validation-for="Resources" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="TotalSeats" class="form-label">عدد المقاعد</label>
                            <div class="qdrat-input-wrap">
                                <i class="fas fa-users"></i>
                                <input asp-for="TotalSeats" class="form-control" type="number" min="0" />
                            </div>
                            <span asp-validation-for="TotalSeats" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="Fee" class="form-label">الرسوم</label>
                            <div class="qdrat-input-wrap">
                                <i class="fas fa-money-bill-wave"></i>
                                <input asp-for="Fee" class="form-control" />
                            </div>
                            <span asp-validation-for="Fee" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-12">
                        <div class="qdrat-status-box">
                            <div class="form-check form-switch qdrat-switch">
                                <input asp-for="IsMandatory" class="form-check-input" type="checkbox" />
                                <label asp-for="IsMandatory" class="form-check-label">جلسة إلزامية</label>
                            </div>
                            <small>عند التفعيل تظهر الجلسة كجلسة إلزامية ضمن متابعة الطالب العلاجية.</small>
                        </div>
                    </div>
                </div>

                <div class="qdrat-actions">
                    <a asp-action="Index" class="btn qdrat-btn qdrat-btn-light">
                        <i class="fas fa-arrow-right"></i>
                        رجوع
                    </a>

                    <button type="submit" class="btn qdrat-btn qdrat-btn-warning">
                        <i class="fas fa-save"></i>
                        حفظ التعديلات
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .qdrat-page {
        padding: 24px;
        background: #f5f7fb;
        min-height: calc(100vh - 80px);
        font-family: inherit;
    }

    .qdrat-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 26px;
        border-radius: 24px;
        background: linear-gradient(135deg, #102a43 0%, #1d4ed8 58%, #38bdf8 100%);
        color: #fff;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
    }

    .qdrat-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .qdrat-title {
        margin: 0;
        font-size: 28px;
        font-weight: 900;
        letter-spacing: -0.5px;
    }

    .qdrat-subtitle {
        margin: 10px 0 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 15px;
        line-height: 1.8;
        max-width: 850px;
    }

    .qdrat-hero-icon {
        width: 74px;
        height: 74px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.16);
        font-size: 34px;
        flex: 0 0 auto;
    }

    .qdrat-card {
        border: 1px solid #e5e7eb;
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    .qdrat-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #edf0f5;
        background: #fff;
    }

        .qdrat-card-header h5 {
            margin: 0;
            color: #0f172a;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .qdrat-card-header h5 i {
                color: #2563eb;
            }

        .qdrat-card-header p {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 14px;
        }

    .qdrat-card-body {
        padding: 24px;
    }

    .qdrat-field .form-label {
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 9px;
    }

    .qdrat-input-wrap {
        position: relative;
    }

        .qdrat-input-wrap > i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 3;
            pointer-events: none;
        }

        .qdrat-input-wrap .form-select,
        .qdrat-input-wrap .form-control {
            min-height: 48px;
            border-radius: 15px;
            border-color: #dbe3ef;
            padding-right: 42px;
            font-weight: 700;
        }

            .qdrat-input-wrap .form-select:focus,
            .qdrat-input-wrap .form-control:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 0.22rem rgba(37, 99, 235, 0.12);
            }

    .qdrat-status-box {
        height: 100%;
        min-height: 110px;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 18px;
        background: #f8fafc;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 10px;
    }

    .qdrat-switch {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-right: 0;
        margin-bottom: 0;
    }

        .qdrat-switch .form-check-input {
            float: none;
            margin: 0;
            width: 46px;
            height: 24px;
            cursor: pointer;
        }

        .qdrat-switch .form-check-label {
            font-weight: 900;
            color: #1e293b;
            cursor: pointer;
        }

    .qdrat-status-box small {
        color: #64748b;
        line-height: 1.8;
        font-weight: 700;
    }

    .qdrat-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 26px;
        margin-top: 28px;
        border-top: 1px solid #edf0f5;
    }

    .qdrat-btn {
        min-height: 46px;
        border-radius: 14px;
        padding: 10px 24px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .qdrat-btn-warning {
        background: #f59e0b;
        border-color: #f59e0b;
        color: #fff;
    }

        .qdrat-btn-warning:hover {
            background: #d97706;
            border-color: #d97706;
            color: #fff;
        }

    .qdrat-btn-light {
        background: #f8fafc;
        border-color: #dbe3ef;
        color: #334155;
    }

        .qdrat-btn-light:hover {
            background: #eef2f7;
            border-color: #cbd5e1;
            color: #0f172a;
        }

    .qdrat-alert {
        border: 0;
        border-radius: 18px;
        padding: 15px 18px;
        font-weight: 800;
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.07);
    }

        .qdrat-alert:empty {
            display: none;
        }

    .qdrat-alert-danger {
        color: #991b1b;
        background: #fee2e2;
    }

    @@media (max-width: 768px) {
        .qdrat-page {
            padding: 14px;
        }

        .qdrat-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 20px;
        }

        .qdrat-title {
            font-size: 23px;
        }

        .qdrat-hero-icon {
            width: 58px;
            height: 58px;
            font-size: 26px;
        }

        .qdrat-card-body,
        .qdrat-card-header {
            padding: 18px;
        }

        .qdrat-actions {
            flex-direction: column-reverse;
        }

        .qdrat-btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
