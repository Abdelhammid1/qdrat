@model QdratNew.ViewModels.Promo.PromoReportRequestViewModel
<div class="container py-5" dir="rtl">
    <h3 class="text-center mb-4">📊 اطلب تقريرك الذكي</h3>

    <div class="alert alert-warning text-center mt-3">
        ⚠️ نذكّرك أن بيانات اختبارك لن تُحفَظ إلا بعد إرسال هذا النموذج.
        بمجرد مغادرتك الصفحة دون إدخال بياناتك، سيتم حذف محاولتك تلقائيًا.
    </div>

    <form asp-action="RequestReport" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="SessionId" value="@Model.SessionId" />

        <div class="mb-3">
            <label class="form-label">الاسم الكامل</label>
            <input asp-for="FullName" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">رقم الجوال</label>
            <input asp-for="PhoneNumber" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">رقم الواتساب</label>
            <input asp-for="WhatsAppNumber" class="form-control" />
        </div>

        <button type="submit" class="btn btn-success w-100 py-2">
            📥 إرسال التقرير
        </button>
    </form>
</div>
