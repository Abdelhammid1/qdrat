@model QdratNew.Entities.ContactMessage
@{
    ViewData["Title"] = "تفاصيل الرسالة";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center gap-2 mb-4">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-3">
            <i class="fas fa-arrow-right"></i>
        </a>
        <h4 class="mb-0 fw-bold">
            <i class="fas fa-envelope-open me-2 text-primary"></i>
            تفاصيل الرسالة
        </h4>
        @if (!Model.IsRead)
        {
            <span class="badge bg-danger rounded-pill">جديدة</span>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-3 mb-4">
            <i class="fas fa-circle-check me-1"></i> @TempData["Success"]
        </div>
    }

    <div class="row g-4" style="max-width:960px;">

        <!-- Message details -->
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">

                    <!-- Sender info -->
                    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                        <div style="width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,#0f766e,#065f46);display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.3rem;font-weight:800;flex-shrink:0;">
                            @Model.FullName.Substring(0, 1)
                        </div>
                        <div>
                            <div class="fw-bold fs-6">@Model.FullName</div>
                            <div class="text-muted small">@Model.Email</div>
                            @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                            {
                                <div class="small mt-1">
                                    <i class="fas fa-mobile-screen text-success me-1"></i>
                                    <span style="font-family:monospace;">@Model.PhoneNumber</span>
                                </div>
                            }
                        </div>
                        <div class="ms-auto text-muted small text-end">
                            <i class="fas fa-clock me-1"></i>
                            @Model.SentAt.ToLocalTime().ToString("yyyy/MM/dd")
                            <br />@Model.SentAt.ToLocalTime().ToString("HH:mm")
                        </div>
                    </div>

                    <!-- Message body -->
                    <div class="mb-3">
                        <label class="form-label fw-600 text-muted small text-uppercase letter-spacing-1">نص الرسالة</label>
                        <div class="p-3 rounded-3" style="background:#f8fafc;border:1px solid #e2e8f0;line-height:1.8;font-size:0.92rem;">
                            @Model.Message
                        </div>
                    </div>

                    <!-- Meta -->
                    <div class="d-flex gap-3 flex-wrap mt-3">
                        <small class="text-muted">
                            <i class="fas fa-globe me-1"></i> IP: @(Model.IPAddress ?? "—")
                        </small>
                        @if (Model.LastUpdated.HasValue)
                        {
                            <small class="text-muted">
                                <i class="fas fa-pencil me-1"></i>
                                آخر تحديث: @Model.LastUpdated.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                            </small>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Admin actions -->
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-bottom py-3 px-4">
                    <h6 class="mb-0 fw-bold"><i class="fas fa-sliders me-2 text-primary"></i>إجراءات الأدمن</h6>
                </div>
                <div class="card-body p-4">
                    <form asp-action="UpdateStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label fw-600 small">الحالة</label>
                            <select name="status" class="form-select rounded-3">
                                <option value="جديدة" selected="@(Model.Status == "جديدة")">🆕 جديدة</option>
                                <option value="تم التواصل" selected="@(Model.Status == "تم التواصل")">✅ تم التواصل</option>
                                <option value="قيد المتابعة" selected="@(Model.Status == "قيد المتابعة")">🔄 قيد المتابعة</option>
                                <option value="مرفوضة" selected="@(Model.Status == "مرفوضة")">❌ مرفوضة</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-600 small">ملاحظات</label>
                            <textarea name="adminNotes" class="form-control rounded-3" rows="5"
                                      placeholder="أضف ملاحظاتك هنا...">@Model.AdminNotes</textarea>
                        </div>

                        <button type="submit" class="btn btn-primary rounded-3 w-100">
                            <i class="fas fa-save me-1"></i> حفظ التغييرات
                        </button>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>
