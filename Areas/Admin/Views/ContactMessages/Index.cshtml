@model IEnumerable<QdratNew.Entities.ContactMessage>
@{
    ViewData["Title"] = "رسائل التواصل";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var unreadCount = Model.Count(m => !m.IsRead);
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0 fw-bold">
                <i class="fas fa-envelope me-2 text-primary"></i>رسائل التواصل
                @if (unreadCount > 0)
                {
                    <span class="badge bg-danger ms-2 rounded-pill" style="font-size:0.7rem;">@unreadCount غير مقروءة</span>
                }
            </h4>
            <small class="text-muted">رسائل الزوار الواردة من صفحة التواصل</small>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-3 mb-4">
            <i class="fas fa-circle-check me-1"></i> @TempData["Success"]
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:36px;">#</th>
                            <th>المرسل</th>
                            <th>رقم الجوال</th>
                            <th>البريد</th>
                            <th>الرسالة</th>
                            <th class="text-center">الحالة</th>
                            <th class="text-center">التاريخ</th>
                            <th class="text-center">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var msg in Model)
                        {
                            <tr class="@(!msg.IsRead ? "table-warning" : "")">
                                <td class="text-muted small">
                                    @if (!msg.IsRead)
                                    {
                                        <span class="d-inline-block bg-danger rounded-circle" style="width:8px;height:8px;" title="غير مقروءة"></span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">@msg.Id</span>
                                    }
                                </td>
                                <td class="fw-600">@msg.FullName</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(msg.PhoneNumber))
                                    {
                                        <span class="badge bg-light text-dark border" style="font-family:monospace;font-size:0.78rem;">@msg.PhoneNumber</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="small text-muted">@msg.Email</td>
                                <td class="small">
                                    @(msg.Message.Length > 60 ? msg.Message.Substring(0, 60) + "..." : msg.Message)
                                </td>
                                <td class="text-center">
                                    @{
                                        var statusClass = msg.Status switch
                                        {
                                            "تم التواصل"   => "bg-success",
                                            "قيد المتابعة" => "bg-info text-dark",
                                            "مرفوضة"       => "bg-danger",
                                            _               => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @statusClass rounded-pill px-3">@msg.Status</span>
                                </td>
                                <td class="text-center text-muted small" style="white-space:nowrap;">
                                    @msg.SentAt.ToLocalTime().ToString("yyyy/MM/dd")
                                    <br /><small class="opacity-60">@msg.SentAt.ToLocalTime().ToString("HH:mm")</small>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@msg.Id"
                                       class="btn btn-sm btn-outline-primary rounded-3">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-5">
                                    <i class="fas fa-inbox fa-2x mb-2 d-block opacity-30"></i>
                                    لا توجد رسائل بعد
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
