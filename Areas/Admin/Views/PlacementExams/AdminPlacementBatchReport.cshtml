@model QdratNew.ViewModels.Reports.PlacementBatchReportViewModel
@{
    ViewData["Title"] = "تقرير أداء الدفعة في اختبار تحديد المستوى";
}

<div class="container py-4" dir="rtl">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">
            🧭 تقرير أداء الدفعة: @Model.BatchName
        </h2>
        <h5 class="text-secondary">الدورة: @Model.CourseTitle</h5>
    </div>

    <!-- كروت إحصائية -->
    <div class="row g-3 mb-4 text-center">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3">
                <h6 class="text-muted">إجمالي الطلاب</h6>
                <h3 class="fw-bold text-dark">@Model.TotalStudents</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3">
                <h6 class="text-muted">أنهوا الاختبار</h6>
                <h3 class="fw-bold text-success">@Model.CompletedCount</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3">
                <h6 class="text-muted">متوسط النسبة العامة</h6>
                <h3 class="fw-bold text-primary">@Model.AverageScore%</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3">
                <h6 class="text-muted">مؤشر الجدية</h6>
                <h3 class="fw-bold text-danger">@Model.EngagementIndex</h3>
            </div>
        </div>
    </div>

    <!-- تحليل المناهج -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white fw-bold">
            تحليل الأداء حسب المنهج
        </div>
        <div class="card-body p-0">
            <table class="table table-bordered text-center m-0">
                <thead class="table-light">
                    <tr>
                        <th>المنهج</th>
                        <th>متوسط النسبة</th>
                        <th>متوسط الوقت (د)</th>
                        <th>مؤشر الجدية</th>
                        <th>نقطة الانطلاق</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.CurriculumReports)
                    {
                        <tr>
                            <td>@c.CurriculumTitle</td>
                            <td>@c.AverageScore%</td>
                            <td>@c.AverageTime</td>
                            <td>@c.EngagementIndex</td>
                            <td><span class="badge bg-info text-dark">@c.StartingLevel</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- جدول الطلاب -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-dark text-white fw-bold">
            أداء الطلاب في الاختبار
        </div>
        <div class="card-body p-0">
            <table class="table table-striped text-center align-middle">
                <thead class="table-light">
                    <tr>
                        <th>الطالب</th>
                        <th>الدرجة (%)</th>
                        <th>الأسئلة الصحيحة</th>
                        <th>الزمن (د)</th>
                        <th>مؤشر الجدية</th>
                        <th>المستوى</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.StudentReports.OrderByDescending(x => x.TotalScore))
                    {
                        <tr>
                            <td>@s.StudentName</td>
                            <td>@s.TotalScore%</td>
                            <td>@s.CorrectAnswers / @s.TotalQuestions</td>
                            <td>@s.TimeTakenMinutes</td>
                            <td>@s.EngagementIndex</td>
                            <td>
                                <span class="badge
                                        @(s.PerformanceLevel == "متميز" ? "bg-success" :
                                                                            s.PerformanceLevel == "جيد جدًا" ? "bg-primary" :
                                                                            s.PerformanceLevel == "متوسط" ? "bg-warning text-dark" : "bg-danger")">
                                @s.PerformanceLevel
                            </span>
                        </td>
                    </tr>
                                        }
                </tbody>
            </table>
        </div>
    </div>
</div>
