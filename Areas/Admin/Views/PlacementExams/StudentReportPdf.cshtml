@model QdratNew.ViewModels.Reports.AdminPlacementReportViewModel
@{
    Layout = null;

    // 🔹 إنشاء روابط الرسوم البيانية مع ترميز JSON
    string doughnutChartUrl = "https://quickchart.io/chart?c=" +
        Uri.EscapeDataString("{type:'doughnut',data:{datasets:[{data:[" +
        Model.OverallPercent + "," + (100 - Model.OverallPercent) +
        "],backgroundColor:['#3b82f6','#e5e7eb'],borderWidth:0}]},options:{rotation:-90,circumference:180,cutout:'75%',plugins:{legend:{display:false}}}}");

    string quantChartUrl = "https://quickchart.io/chart?c=" +
        Uri.EscapeDataString("{type:'bar',data:{labels:" +
        System.Text.Json.JsonSerializer.Serialize(Model.QuantLabels ?? new List<string>()) +
        ",datasets:[{label:'نسبة الإجابات الصحيحة %',data:" +
        System.Text.Json.JsonSerializer.Serialize(Model.QuantScores ?? new List<double>()) +
        ",backgroundColor:'#60a5fa'}]},options:{scales:{y:{beginAtZero:true,max:100}},plugins:{legend:{display:false}}}}");

    string verbalChartUrl = "https://quickchart.io/chart?c=" +
        Uri.EscapeDataString("{type:'bar',data:{labels:" +
        System.Text.Json.JsonSerializer.Serialize(Model.VerbalLabels ?? new List<string>()) +
        ",datasets:[{label:'نسبة الإجابات الصحيحة %',data:" +
        System.Text.Json.JsonSerializer.Serialize(Model.VerbalScores ?? new List<double>()) +
        ",backgroundColor:'#a5b4fc'}]},options:{scales:{y:{beginAtZero:true,max:100}},plugins:{legend:{display:false}}}}");
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>تقرير تحديد المستوى</title>
    <style>
        @@font-face {
            font-family: 'ZA-Roots';
            src: url('/fonts/ZA-roots.woff2') format('woff2'),
                 url('/fonts/ZA-roots.woff') format('woff'),
                 url('/fonts/ZA-roots.TTF') format('truetype');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }
        @@font-face {
            font-family: 'ZA-roots';
            src: url('/fonts/ZA-roots.woff2') format('woff2'),
                 url('/fonts/ZA-roots.woff') format('woff'),
                 url('/fonts/ZA-roots.TTF') format('truetype');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f3f4f6;
            margin: 0;
            padding: 30px;
            direction: rtl;
            color: #111827;
        }

        .container {
            width: 850px;
            margin: auto;
            background: #fff;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        h2 {
            text-align: center;
            color: #2563eb;
            margin-bottom: 5px;
        }

        .sub {
            text-align: center;
            color: #6b7280;
            font-size: 14px;
            margin-bottom: 25px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            background: #f8fafc;
            padding: 20px;
            border-radius: 10px;
            font-size: 15px;
            margin-bottom: 25px;
        }

        .info-item span {
            font-weight: bold;
            color: #2563eb;
        }

        .cards {
            display: flex;
            gap: 12px;
            margin: 25px 0;
            flex-wrap: wrap;
            justify-content: space-between;
        }

        .card {
            flex: 1 1 30%;
            border-radius: 12px;
            padding: 20px;
            min-width: 250px;
            text-align: center;
            font-size: 14px;
        }

        .blue {
            background: #dbeafe;
        }

        .yellow {
            background: #fef9c3;
        }

        .pink {
            background: #fce7f3;
        }

        .green {
            background: #dcfce7;
        }

        .card h4 {
            margin-bottom: 8px;
            font-size: 14px;
        }

        .chart {
            text-align: center;
            margin: 40px 0;
        }

            .chart img {
                width: 260px;
            }

        .footer {
            text-align: center;
            font-size: 12px;
            color: #6b7280;
            margin-top: 40px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>تقرير تحديد المستوى</h2>
        <div class="sub">الذكاء الكمي واللفظي</div>

        <div class="info-grid">
            <div class="info-item"><span>اسم الطالب:</span> @Model.ExamTitle</div>
            <div class="info-item"><span>تاريخ الاختبار:</span> @Model.ExamDate.ToString("yyyy/MM/dd")</div>
            <div class="info-item"><span>النسبة الكلية:</span> @Model.OverallPercent%</div>
            <div class="info-item"><span>مدة الحل:</span> @Model.AverageSolveMinutes دقيقة</div>
        </div>

        <div class="cards">
            <div class="card blue">
                <h4>المستوى العام داخل الاختبار</h4>
                <div style="font-size:22px; font-weight:bold; color:#14532d;">@Model.OverallPercent%</div>
                <div style="margin-top:8px;">@(Model.OverallPercent >= 80 ? "ممتاز" : Model.OverallPercent >= 60 ? "متوسط" : "قيد التطوير")</div>
            </div>
            <div class="card yellow">
                <h4>توصية المسار</h4>
                <p>@Model.RecommendationText</p>
            </div>
            <div class="card pink">
                <h4>القرار الإداري</h4>
                <p>@Model.AdminDecisionTip</p>
            </div>
        </div>

        <div class="chart">
            <img src="@doughnutChartUrl" alt="المستوى العام" />
            <div style="margin-top:10px; font-weight:bold;">المستوى العام للطالب</div>
        </div>

        <div class="cards">
            <div class="card green">
                <h4>تحليل المحاور الكمية</h4>
                <img src="@quantChartUrl" alt="تحليل كمي" width="380" />
            </div>
            <div class="card green">
                <h4>تحليل المحاور اللفظية</h4>
                <img src="@verbalChartUrl" alt="تحليل لفظي" width="380" />
            </div>
        </div>

        <div class="card green" style="margin-top:25px;">
            <h4>التوصيات الإدارية</h4>
            <p><strong>📘 التوصية:</strong> @Model.RecommendationText</p>
            <p><strong>🧩 القرار المقترح:</strong> @Model.AdminDecisionTip</p>
        </div>

        <div class="footer">
            تم توليد التقرير بتاريخ @DateTime.Now.ToString("yyyy/MM/dd HH:mm")
        </div>
    </div>
</body>
</html>
