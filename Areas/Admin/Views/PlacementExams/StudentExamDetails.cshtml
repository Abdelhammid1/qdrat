@model QdratNew.ViewModels.Exam.StudentExamDetailsVm
@{
    ViewData["Title"] = "تفاصيل اختبار " + Model.ExamTitle;
}

<h3 class="fw-bold text-primary mb-3">
    <i class="bi bi-person-check"></i> تفاصيل الطالب: @Model.StudentName
</h3>

<div class="alert alert-info fw-bold">
    🧾 الاختبار: <strong>@Model.ExamTitle</strong><br />
    ✅ الإجابات الصحيحة: <strong class="text-success">@Model.CorrectCount</strong> /
    ❌ الخاطئة: <strong class="text-danger">@Model.WrongCount</strong> /
    المجموع: <strong>@Model.TotalQuestions</strong>
</div>
<div class="d-flex justify-content-between mb-3">
    <h3 class="fw-bold text-primary"><i class="bi bi-person-lines-fill"></i> تفاصيل اختبار الطالب</h3>

    <a asp-action="DownloadStudentReport"
       asp-route-examId="@ViewBag.ExamId"
       asp-route-studentId="@Model.StudentId"
       class="btn btn-danger">
        <i class="bi bi-file-earmark-pdf"></i> تحميل تقرير PDF
    </a>

</div>

<table class="table table-bordered table-hover text-center align-middle">
    <thead class="table-light">
        <tr>
            <th>السؤال</th>
            <th>إجابتك</th>
            <th>الإجابة الصحيحة</th>
            <th>النتيجة</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var q in Model.Answers)
        {
            <tr>
                <td class="text-start">@Html.Raw(q.QuestionTitle)</td>
                <td class="@(q.IsCorrect ? "text-success fw-bold" : "text-danger fw-bold")">@Html.Raw(q.SelectedAnswer)</td>
                <td class="text-success fw-bold">@Html.Raw(q.CorrectAnswer)</td>
                <td>
                    @if (q.IsCorrect)
                    {
                        <span class="badge bg-success">صحيح</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">خطأ</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="text-end mt-3">
    <a href="javascript:history.back()" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> عودة
    </a>
</div>
