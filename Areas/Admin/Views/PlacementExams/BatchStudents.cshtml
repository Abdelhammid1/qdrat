@model IEnumerable<QdratNew.ViewModels.Exam.PlacementExamStudentVm>
@using Microsoft.AspNetCore.Authorization
@using QdratNew.Security.AdminPermissions
@using QdratNew.Enums
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "طلاب الدفعة " + ViewBag.BatchName;

    var studentsList = Model?.ToList() ?? new List<QdratNew.ViewModels.Exam.PlacementExamStudentVm>();

    bool isExamHidden = ViewBag.IsExamHidden != null && (bool)ViewBag.IsExamHidden;

    var total = studentsList.Count;
    var completed = studentsList.Count(s => s.IsSubmitted);
    var notStarted = studentsList.Count(s => !s.IsSubmitted);

    var avgScore = studentsList.Any(s => s.Score > 0)
        ? Math.Round(studentsList.Where(s => s.Score > 0).Average(s => s.Score), 1)
        : 0;

    var canDelete      = (await AuthorizationService.AuthorizeAsync(User, AdminPermissionPolicies.PlacementExams_Delete)).Succeeded;
    var canViewResults = (await AuthorizationService.AuthorizeAsync(User, AdminPermissionPolicies.PlacementExams_Results)).Succeeded;
    var canResend      = (await AuthorizationService.AuthorizeAsync(User, AdminPermissionPolicies.PlacementExams_Create)).Succeeded;
    var canResolveIntegrity = (await AuthorizationService.AuthorizeAsync(User, AdminPermissionPolicies.IntegrityViolations_Resolve)).Succeeded;
}

@section Styles {
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        :root {
            --ink: #0D1B2A;
            --ink-2: #2C3E50;
            --ink-3: #5A6A7A;
            --ink-4: #8FA0B0;
            --ink-5: #C8D5E0;
            --canvas: #F3F6FA;
            --surface: #FFFFFF;
            --surface-2: #F8FAFC;
            --surface-3: #EEF2F7;
            --border: #DDE4EC;
            --blue: #1B5EAE;
            --blue-2: #2471D0;
            --blue-bg: #E8F1FB;
            --blue-dark: #103E7A;
            --emerald: #0D7A5B;
            --emerald-bg: #E4F5EE;
            --amber: #985D09;
            --amber-bg: #FDF0D8;
            --rose: #BF1030;
            --rose-bg: #FDEAEE;
            --violet: #5535B5;
            --violet-bg: #EDE8F9;
            --r-sm: 6px;
            --r-md: 10px;
            --r-lg: 14px;
            --r-xl: 20px;
            --sh-xs: 0 1px 3px rgba(13,27,42,.06);
            --sh-sm: 0 2px 8px rgba(13,27,42,.08);
            --sh-md: 0 4px 18px rgba(13,27,42,.10);
            --ease: cubic-bezier(.25,.46,.45,.94);
        }

        .placement-page {
            background: var(--canvas);
            min-height: 100vh;
            padding: 32px 28px 64px;
            direction: rtl;
            font-family: 'Cairo';
            color: var(--ink-2);
        }

        .placement-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 14px;
            margin-bottom: 28px;
        }

        .placement-brand {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .placement-brand-icon {
            width: 46px;
            height: 46px;
            background: var(--blue);
            border-radius: var(--r-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 20px;
            box-shadow: 0 4px 14px rgba(27,94,174,.28);
        }

        .placement-brand-title {
            font-size: 20px;
            font-weight: 700;
            color: var(--ink);
            line-height: 1.15;
        }

        .placement-brand-sub {
            font-size: 16px;
            color: var(--ink-4);
            margin-top: 2px;
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn-secondary-action {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: var(--surface);
            color: var(--blue);
            border: 1px solid #B6D3F4;
            border-radius: var(--r-md);
            padding: 10px 20px;
            font-size: 18px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: background .16s var(--ease), transform .14s, box-shadow .16s;
        }

            .btn-secondary-action:hover {
                background: var(--blue-bg);
                color: var(--blue-dark);
                transform: translateY(-2px);
                box-shadow: var(--sh-sm);
            }

        .hidden-alert {
            background: var(--amber-bg);
            border: 1px solid #F3D494;
            color: var(--amber);
            border-radius: var(--r-xl);
            padding: 16px 18px;
            box-shadow: var(--sh-xs);
            font-size: 17px;
            font-weight: 700;
            margin-bottom: 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .hidden-alert-text {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-restore-exam {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--emerald-bg);
            color: var(--emerald);
            border: 1px solid #B8E8D3;
            border-radius: var(--r-md);
            padding: 8px 14px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: all .15s;
        }

            .btn-restore-exam:hover {
                background: var(--emerald);
                color: #fff;
                border-color: var(--emerald);
            }

        .placement-kpis {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 13px;
            margin-bottom: 24px;
        }

        @@media (max-width: 960px) {
            .placement-kpis {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 480px) {
            .placement-kpis {
                grid-template-columns: 1fr;
            }
        }

        .kpi-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            padding: 18px 19px;
            display: flex;
            align-items: center;
            gap: 13px;
            box-shadow: var(--sh-xs);
            transition: transform .2s var(--ease), box-shadow .2s;
            position: relative;
            overflow: hidden;
        }

            .kpi-card::after {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 4px;
                height: 100%;
                border-radius: 0 var(--r-xl) var(--r-xl) 0;
            }

            .kpi-card:hover {
                transform: translateY(-3px);
                box-shadow: var(--sh-sm);
            }

        .kpi-blue::after {
            background: var(--blue);
        }

        .kpi-emerald::after {
            background: var(--emerald);
        }

        .kpi-amber::after {
            background: var(--amber);
        }

        .kpi-violet::after {
            background: var(--violet);
        }

        .kpi-ico {
            width: 42px;
            height: 42px;
            border-radius: var(--r-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .ico-blue {
            background: var(--blue-bg);
            color: var(--blue);
        }

        .ico-emerald {
            background: var(--emerald-bg);
            color: var(--emerald);
        }

        .ico-amber {
            background: var(--amber-bg);
            color: var(--amber);
        }

        .ico-violet {
            background: var(--violet-bg);
            color: var(--violet);
        }

        .kpi-label {
            font-size: 15px;
            font-weight: 700;
            color: var(--ink-4);
            letter-spacing: .04em;
            text-transform: uppercase;
            margin-bottom: 3px;
        }

        .kpi-val {
            font-size: 20px;
            font-weight: 700;
            color: var(--ink);
            line-height: 1;
        }

        .placement-table-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            overflow: visible;
            box-shadow: var(--sh-sm);
            margin-bottom: 24px;
        }

        .placement-table-topbar {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 11px 16px;
            border-bottom: 1px solid var(--surface-3);
            flex-wrap: wrap;
        }

        .table-section-title {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 18px;
            font-weight: 800;
            color: var(--ink);
            margin-left: 10px;
        }

            .table-section-title i {
                color: var(--blue);
            }

        .placement-table-search-wrap {
            position: relative;
            flex: 1;
            min-width: 200px;
            max-width: 360px;
        }

            .placement-table-search-wrap i {
                position: absolute;
                right: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--ink-4);
                font-size: 17px;
                pointer-events: none;
            }

            .placement-table-search-wrap input {
                width: 100%;
                padding: 7px 32px 7px 12px;
                border: 1px solid var(--border);
                border-radius: var(--r-md);
                font-size: 18px;
                background: var(--surface-2);
                color: var(--ink);
                transition: border-color .15s, box-shadow .15s;
            }

                .placement-table-search-wrap input:focus {
                    outline: none;
                    border-color: var(--blue-2);
                    box-shadow: 0 0 0 3px rgba(36,113,208,.1);
                    background: var(--surface);
                }

        .placement-count-badge {
            margin-right: auto;
            font-size: 16px;
            color: var(--ink-4);
        }

            .placement-count-badge strong {
                color: var(--blue);
                font-weight: 700;
            }

        .table-responsive-safe {
            width: 100%;
            overflow-x: auto;
            overflow-y: visible;
        }

        #studentsTable {
            width: 100% !important;
            border-collapse: collapse;
        }

            #studentsTable thead th {
                background: var(--surface-2) !important;
                padding: 11px 15px !important;
                font-size: 15px !important;
                font-weight: 700 !important;
                color: var(--ink-4) !important;
                text-transform: uppercase;
                letter-spacing: .05em;
                white-space: nowrap;
                border: none !important;
                text-align: center;
            }

            #studentsTable tbody tr {
                border-bottom: 1px solid var(--surface-3);
                transition: background .1s;
            }

                #studentsTable tbody tr:last-child {
                    border-bottom: none;
                }

                #studentsTable tbody tr:hover {
                    background: #F5F8FD;
                }

            #studentsTable td {
                padding: 11px 15px !important;
                vertical-align: middle !important;
                font-size: 18px !important;
                color: var(--ink-2);
                border: none !important;
                text-align: center;
            }

        .student-title-cell {
            display: flex;
            align-items: center;
            gap: 10px;
            text-align: right;
        }

        .student-avatar {
            width: 33px;
            height: 33px;
            border-radius: 50%;
            background: var(--blue-bg);
            color: var(--blue);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }

        .student-item-name {
            font-weight: 600;
            color: var(--ink);
            font-size: 18px;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 11px;
            border-radius: 30px;
            font-size: 16px;
            font-weight: 700;
            white-space: nowrap;
        }

        .sp-submitted {
            background: var(--emerald-bg);
            color: var(--emerald);
        }

        .sp-pending {
            background: var(--amber-bg);
            color: var(--amber);
        }

        .score-wrap {
            min-width: 160px;
        }

        .score-progress {
            width: 100%;
            height: 24px;
            border-radius: 30px;
            background: var(--surface-3);
            overflow: hidden;
            position: relative;
        }

        .score-bar {
            height: 100%;
            border-radius: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 14px;
            font-weight: 800;
            transition: width .8s ease;
            min-width: 34px;
        }

        .score-high {
            background: var(--emerald);
        }

        .score-mid {
            background: var(--blue-2);
        }

        .score-low {
            background: var(--rose);
        }

        .score-empty {
            color: var(--ink-4);
            font-size: 18px;
            font-weight: 700;
        }

        .placement-act-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            flex-wrap: nowrap;
            position: relative;
            overflow: visible;
        }

        .act-form {
            display: inline-flex;
            margin: 0;
            padding: 0;
        }

        .act-btn {
            position: relative;
            width: 34px;
            height: 34px;
            min-width: 34px;
            padding: 0;
            border-radius: var(--r-sm);
            font-size: 16px;
            font-weight: 600;
            text-decoration: none;
            border: 1.5px solid transparent;
            cursor: pointer;
            background: transparent;
            transition: all .15s;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            overflow: visible;
        }

            .act-btn i {
                margin: 0;
                font-size: 15px;
                line-height: 1;
            }

            .act-btn .act-text {
                position: absolute;
                bottom: calc(100% + 8px);
                right: 50%;
                transform: translateX(50%) translateY(4px);
                background: var(--ink);
                color: #fff;
                font-size: 13px;
                font-weight: 600;
                padding: 5px 9px;
                border-radius: 6px;
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
                transition: opacity .15s ease, transform .15s ease, visibility .15s ease;
                z-index: 9999;
                box-shadow: 0 4px 12px rgba(13,27,42,.18);
                min-width: max-content;
            }

                .act-btn .act-text::after {
                    content: "";
                    position: absolute;
                    top: 100%;
                    right: 50%;
                    transform: translateX(50%);
                    border-width: 5px;
                    border-style: solid;
                    border-color: var(--ink) transparent transparent transparent;
                }

            .act-btn:hover .act-text {
                opacity: 1;
                visibility: visible;
                transform: translateX(50%) translateY(0);
            }

        .act-report {
            background: var(--blue-bg);
            color: var(--blue);
            border-color: #B6D3F4;
        }

            .act-report:hover {
                background: var(--blue);
                color: #fff;
                border-color: var(--blue);
            }

        .act-resend {
            background: var(--rose-bg);
            color: var(--rose);
            border-color: #F5B8C2;
        }

            .act-resend:hover {
                background: var(--rose);
                color: #fff;
                border-color: var(--rose);
            }

        .act-sections {
            background: var(--violet-bg);
            color: var(--violet);
            border-color: #D7CDF8;
        }

            .act-sections:hover {
                background: var(--violet);
                color: #fff;
                border-color: var(--violet);
            }

        .dataTables_wrapper {
            direction: rtl;
            overflow: visible;
        }

            .dataTables_wrapper .dataTables_filter {
                display: none;
            }

            .dataTables_wrapper .dataTables_length,
            .dataTables_wrapper .dataTables_info {
                padding: 9px 16px;
                font-size: 16px;
                color: var(--ink-4);
            }

            .dataTables_wrapper .dataTables_paginate {
                padding: 9px 16px;
            }

                .dataTables_wrapper .dataTables_paginate .paginate_button {
                    border-radius: var(--r-sm) !important;
                    font-size: 16px !important;
                    padding: 4px 10px !important;
                    border: 1px solid var(--border) !important;
                    margin: 0 2px !important;
                    color: var(--ink-3) !important;
                }

                    .dataTables_wrapper .dataTables_paginate .paginate_button.current,
                    .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
                        background: var(--blue) !important;
                        border-color: var(--blue) !important;
                        color: #fff !important;
                    }

                    .dataTables_wrapper .dataTables_paginate .paginate_button:hover:not(.current):not(.disabled) {
                        background: var(--blue-bg) !important;
                        border-color: #B6D3F4 !important;
                        color: var(--blue) !important;
                    }

            .dataTables_wrapper .dataTables_length select {
                border: 1px solid var(--border);
                border-radius: var(--r-sm);
                padding: 3px 8px;
                font-size: 16px;
                color: var(--ink);
            }

        div.dataTables_wrapper div.dataTables_paginate,
        div.dataTables_wrapper div.dataTables_info,
        div.dataTables_wrapper div.dataTables_length {
            border-top: 1px solid var(--surface-3);
            background: var(--surface-2);
        }

        .placement-empty {
            text-align: center;
            padding: 56px 16px;
            color: var(--ink-4);
        }

            .placement-empty i {
                font-size: 20px;
                display: block;
                margin-bottom: 12px;
                color: var(--ink-5);
            }

        .placement-empty-title {
            font-size: 18px;
            font-weight: 600;
            color: var(--ink-3);
        }

        .placement-empty-sub {
            font-size: 16px;
            margin-top: 4px;
        }

        @@media (max-width: 768px) {
            .placement-page {
                padding: 22px 14px 48px;
            }

            .top-actions {
                width: 100%;
            }

            .btn-secondary-action {
                width: 100%;
                justify-content: center;
            }

            .hidden-alert {
                align-items: stretch;
            }

                .hidden-alert form,
                .hidden-alert button {
                    width: 100%;
                    justify-content: center;
                }

            .placement-table-topbar {
                align-items: stretch;
            }

            .placement-table-search-wrap {
                max-width: 100%;
                width: 100%;
            }

            .placement-count-badge {
                margin-right: 0;
            }
        }
    </style>
}

<div class="placement-page">

    <div class="placement-topbar">
        <div class="placement-brand">
            <div class="placement-brand-icon">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <div class="placement-brand-title">
                    طلاب الدفعة: @ViewBag.BatchName
                </div>
                <div class="placement-brand-sub">
                    اختبار: <strong>@ViewBag.ExamTitle</strong>
                </div>
            </div>
        </div>

        <div class="top-actions">
            @if (canResend)
            {
                <form asp-action="SendExamToNewStudents" method="post" class="m-0"
                      onsubmit="return confirm('سيتم إرسال الاختبار لأي طالب انضم للدفعة بعد الإرسال الأول فقط. متابعة؟')">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="examId" value="@ViewBag.ExamId" />
                    <input type="hidden" name="batchId" value="@ViewBag.BatchId" />
                    <button type="submit" class="btn-secondary-action">
                        <i class="bi bi-person-plus"></i>
                        إرسال للطلاب الجدد
                    </button>
                </form>

                <form asp-action="BackfillMissingAssignments" method="post" class="m-0"
                      onsubmit="return confirm('سيتم إصلاح بيانات أي طالب أنهى الاختبار فعليًا لكن بلا سجل تعيين، حتى تظهر وتُطبع تقاريره. متابعة؟')">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="examId" value="@ViewBag.ExamId" />
                    <input type="hidden" name="batchId" value="@ViewBag.BatchId" />
                    <button type="submit" class="btn-secondary-action">
                        <i class="bi bi-tools"></i>
                        إصلاح بيانات الطلاب المتأثرين
                    </button>
                </form>
            }
            <a href="javascript:history.back()" class="btn-secondary-action">
                <i class="bi bi-arrow-left"></i>
                عودة
            </a>
        </div>
    </div>

    @if (isExamHidden)
    {
        <div class="hidden-alert">
            <div class="hidden-alert-text">
                <i class="bi bi-eye-slash-fill"></i>
                <span>
                    هذا الاختبار <strong>مخفي حاليًا</strong> ولن يظهر للطلاب.
                </span>
            </div>

            @if (canDelete)
            {
                <form asp-action="RestoreExam" method="post" class="m-0">
                    <input type="hidden" name="id" value="@ViewBag.ExamId" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-restore-exam">
                        <i class="bi bi-eye"></i>
                        استرجاع الاختبار
                    </button>
                </form>
            }
        </div>
    }

    <div class="placement-kpis">

        <div class="kpi-card kpi-blue">
            <div class="kpi-ico ico-blue">
                <i class="bi bi-people"></i>
            </div>
            <div>
                <div class="kpi-label">إجمالي الطلاب</div>
                <div class="kpi-val">@total</div>
            </div>
        </div>

        <div class="kpi-card kpi-emerald">
            <div class="kpi-ico ico-emerald">
                <i class="bi bi-check-circle"></i>
            </div>
            <div>
                <div class="kpi-label">أكملوا الاختبار</div>
                <div class="kpi-val">@completed</div>
            </div>
        </div>

        <div class="kpi-card kpi-amber">
            <div class="kpi-ico ico-amber">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div>
                <div class="kpi-label">لم يبدأوا بعد</div>
                <div class="kpi-val">@notStarted</div>
            </div>
        </div>

        <div class="kpi-card kpi-violet">
            <div class="kpi-ico ico-violet">
                <i class="bi bi-bar-chart-fill"></i>
            </div>
            <div>
                <div class="kpi-label">المتوسط العام</div>
                <div class="kpi-val">@avgScore%</div>
            </div>
        </div>

    </div>

    <div class="placement-table-card">

        <div class="placement-table-topbar">
            <div class="table-section-title">
                <i class="bi bi-list-ul"></i>
                قائمة الطلاب في هذا الاختبار
            </div>

            <div class="placement-table-search-wrap">
                <i class="bi bi-search"></i>
                <input type="text"
                       id="studentsSearch"
                       placeholder="ابحث في أسماء الطلاب أو الحالة أو النسبة..." />
            </div>

            <div class="placement-count-badge">
                إجمالي: <strong>@total</strong> طالب
            </div>
        </div>

        <div class="table-responsive-safe">
            <table id="studentsTable">
                <thead>
                    <tr>
                        <th style="text-align:right; width:32%">الطالب</th>
                        <th style="width:16%">الحالة</th>
                        <th style="width:22%">النسبة</th>
                        <th style="width:30%">الإجراء</th>
                    </tr>
                </thead>

                <tbody>
                    @if (studentsList.Any())
                    {
                        foreach (var s in studentsList)
                        {
                            var scoreClass = s.Score >= 85
                            ? "score-high"
                            : s.Score >= 60
                            ? "score-mid"
                            : "score-low";

                            <tr>
                                <td style="text-align:right">
                                    <div class="student-title-cell">
                                        <div class="student-avatar">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        <span class="student-item-name">@s.StudentName</span>
                                        @if (s.IsIntegrityBlocked)
                                        {
                                            <span class="badge bg-danger ms-1">موقوف (ترجمة المتصفح)</span>
                                        }
                                    </div>
                                </td>

                                <td>
                                    @if (s.IsSubmitted)
                                    {
                                        <span class="status-pill sp-submitted">
                                            <i class="bi bi-check-circle"></i>
                                            تم الحل
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill sp-pending">
                                            <i class="bi bi-hourglass-split"></i>
                                            لم يبدأ بعد
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (s.Score > 0)
                                    {
                                        <div class="score-wrap">
                                            <div class="score-progress">
                                                <div class="score-bar @scoreClass"
                                                     style="width:@s.Score%;"
                                                     aria-valuenow="@s.Score"
                                                     aria-valuemin="0"
                                                     aria-valuemax="100">
                                                    @s.Score.ToString("0.0")%
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="score-empty">—</span>
                                    }
                                </td>

                                <td>
                                    <div class="placement-act-row">

                                        @if (canViewResults)
                                        {
                                            <a asp-area="Admin"
                                               asp-controller="PlacementExams"
                                               asp-action="AdminPlacementReport"
                                               asp-route-studentId="@s.StudentId"
                                               asp-route-assignmentId="@s.AssignmentId"
                                               asp-route-examId="@ViewBag.ExamId"
                                               asp-route-batchId="@ViewBag.BatchId"
                                               class="act-btn act-report"
                                               aria-label="تقرير الطالب">
                                                <i class="bi bi-bar-chart-line"></i>
                                                <span class="act-text">تقرير الطالب</span>
                                            </a>
                                        }

                                        @if (canResend)
                                        {
                                            <form asp-action="ResendExamToStudent"
                                                  method="post"
                                                  class="act-form"
                                                  onsubmit="return confirm('هل تريد إعادة إرسال الاختبار لهذا الطالب؟')">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="examId" value="@ViewBag.ExamId" />
                                                <input type="hidden" name="studentId" value="@s.StudentId" />

                                                <button type="submit"
                                                        class="act-btn act-resend"
                                                        aria-label="إعادة الإرسال">
                                                    <i class="bi bi-arrow-clockwise"></i>
                                                    <span class="act-text">إعادة الإرسال</span>
                                                </button>
                                            </form>
                                        }

                                        @if (canViewResults)
                                        {
                                            <a asp-area="Admin"
                                               asp-controller="PlacementExams"
                                               asp-action="ExamSectionAnalysis"
                                               asp-route-assignmentId="@s.AssignmentId"
                                               asp-route-studentId="@s.StudentId"
                                               class="act-btn act-sections"
                                               aria-label="تقرير المحاور">
                                                <i class="bi bi-diagram-3"></i>
                                                <span class="act-text">تقرير المحاور</span>
                                            </a>
                                        }

                                        @if (s.IsIntegrityBlocked && canResolveIntegrity)
                                        {
                                            <form asp-area="Admin"
                                                  asp-controller="IntegrityViolations"
                                                  asp-action="ResolveByAttempt"
                                                  method="post"
                                                  class="act-form"
                                                  onsubmit="return confirm('تأكيد إعادة فتح المحاولة لهذا الطالب؟');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="studentId" value="@s.StudentId" />
                                                <input type="hidden" name="attemptType" value="@((int)IntegrityAttemptType.Placement)" />
                                                <input type="hidden" name="attemptEntityId" value="@s.AssignmentId" />
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                <button type="submit" class="act-btn act-resend" aria-label="إعادة فتح المحاولة">
                                                    <i class="bi bi-unlock"></i>
                                                    <span class="act-text">إعادة فتح المحاولة</span>
                                                </button>
                                            </form>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (!studentsList.Any())
        {
            <div class="placement-empty">
                <i class="bi bi-inbox"></i>
                <div class="placement-empty-title">لا توجد بيانات طلاب لهذا الاختبار</div>
                <div class="placement-empty-sub">تأكد من إرسال الاختبار للدفعة أو من وجود طلاب مسجلين</div>
            </div>
        }

    </div>

</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            var table = $('#studentsTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json'
                },
                pageLength: 10,
                lengthMenu: [[10, 20, 30, 50, 100, -1], [10, 20, 30, 50, 100, "الكل"]],
                order: [[0, 'asc']],
                responsive: true,
                dom: 'Brtip',
                columnDefs: [
                    { orderable: false, targets: [3] }
                ]
            });

            $('#studentsSearch').on('input', function () {
                table.search($(this).val()).draw();
            });

        });
    </script>
}
