@model QdratNew.ViewModels.Exam.PlacementExamBatchArchiveAccessVM

@{
    ViewData["Title"] = "موافقات الوصول لأرشيف اختبارات تحديد المستوى";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --ink: #0D1B2A; --ink-2: #2C3E50; --ink-4: #8FA0B0;
            --canvas: #F3F6FA; --surface: #FFFFFF; --border: #DDE4EC;
            --blue: #1B5EAE; --blue-bg: #E8F1FB;
            --amber: #985D09; --amber-bg: #FDF0D8;
            --emerald: #0D7A5B; --emerald-bg: #E4F5EE;
            --violet: #5535B5; --violet-bg: #EDE8F9;
            --r-md: 10px; --r-lg: 14px; --r-xl: 20px;
            --sh-xs: 0 1px 3px rgba(13,27,42,.06);
            --sh-sm: 0 2px 8px rgba(13,27,42,.08);
        }

        .manage-page {
            background: var(--canvas); min-height: 100vh;
            padding: 32px 28px 64px; direction: rtl;
            font-family: 'Cairo', sans-serif; color: var(--ink-2);
        }
        .page-topbar {
            display: flex; align-items: center; justify-content: space-between;
            flex-wrap: wrap; gap: 14px; margin-bottom: 28px;
        }
        .page-brand { display: flex; align-items: center; gap: 13px; }
        .page-brand-icon {
            width: 46px; height: 46px; background: var(--violet);
            border-radius: var(--r-lg); display: flex; align-items: center;
            justify-content: center; color: #fff; font-size: 20px;
            box-shadow: 0 4px 14px rgba(85,53,181,.25);
        }
        .page-brand-title { font-size: 19px; font-weight: 800; color: var(--ink); }
        .page-brand-sub   { font-size: 14px; color: var(--ink-4); margin-top: 2px; }

        .top-btns { display: flex; gap: 10px; flex-wrap: wrap; }
        .btn-back {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 9px 18px; background: var(--surface); color: var(--blue);
            border: 1px solid var(--border); border-radius: var(--r-md);
            font-size: 14px; font-weight: 800; text-decoration: none;
            transition: background .15s, color .15s;
        }
        .btn-back:hover { background: var(--blue); color: #fff; }

        .att-alert {
            border: none; border-radius: var(--r-lg); padding: 13px 16px;
            font-size: 14px; font-weight: 700; box-shadow: var(--sh-xs);
            margin-bottom: 16px; display: flex; align-items: center; gap: 8px;
        }
        .att-alert.success { background: var(--emerald-bg); color: var(--emerald); }
        .att-alert.error   { background: #FDEAEE; color: #BF1030; }

        .access-card {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: var(--r-xl); box-shadow: var(--sh-sm); overflow: hidden;
        }
        .access-card-header {
            padding: 14px 18px; border-bottom: 1px solid #EEF2F7;
            display: flex; align-items: center; gap: 10px; background: #F8FAFC;
        }
        .access-note {
            font-size: 13px; color: var(--ink-4); display: flex; align-items: center; gap: 6px;
        }
        .access-note i { color: var(--blue); }

        .users-table { width: 100%; border-collapse: collapse; }
        .users-table thead th {
            background: #EEF2F7; padding: 10px 14px; font-size: 13px;
            font-weight: 700; color: var(--ink-4); text-transform: uppercase;
            letter-spacing: .04em; border: none; white-space: nowrap;
        }
        .users-table tbody tr { border-bottom: 1px solid #EEF2F7; transition: background .1s; }
        .users-table tbody tr:last-child { border-bottom: none; }
        .users-table tbody tr:hover { background: #F8FAFC; }
        .users-table td { padding: 12px 14px; font-size: 14px; color: var(--ink-2); border: none; vertical-align: middle; }

        .user-info { display: flex; align-items: center; gap: 10px; }
        .user-avatar {
            width: 34px; height: 34px; border-radius: 50%;
            background: var(--violet-bg); color: var(--violet);
            display: flex; align-items: center; justify-content: center; font-size: 15px; flex-shrink: 0;
        }
        .user-name  { font-weight: 700; color: var(--ink); }
        .user-email { font-size: 13px; color: var(--ink-4); }

        .role-pill {
            display: inline-flex; align-items: center; gap: 4px;
            padding: 3px 9px; border-radius: 20px; font-size: 12px; font-weight: 700;
            background: var(--blue-bg); color: var(--blue);
        }

        .toggle-wrap { display: flex; justify-content: center; }
        .toggle-switch { position: relative; display: inline-block; width: 44px; height: 24px; }
        .toggle-switch input { opacity: 0; width: 0; height: 0; }
        .toggle-slider {
            position: absolute; cursor: pointer; inset: 0;
            background: #D1D9E0; border-radius: 34px; transition: .2s;
        }
        .toggle-slider:before {
            content: ""; position: absolute;
            height: 18px; width: 18px; right: 3px; bottom: 3px;
            background: #fff; border-radius: 50%; transition: .2s;
        }
        input:checked + .toggle-slider { background: var(--emerald); }
        input:checked + .toggle-slider:before { transform: translateX(-20px); }

        .save-bar {
            padding: 16px 18px; border-top: 1px solid #EEF2F7; background: #F8FAFC;
            display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
        }
        .save-note { font-size: 13px; color: var(--ink-4); display: flex; align-items: center; gap: 6px; }
        .save-note i { color: var(--amber); }
        .btn-save {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 10px 22px; background: var(--violet); color: #fff;
            border: none; border-radius: var(--r-md); font-size: 15px; font-weight: 800;
            cursor: pointer; box-shadow: 0 3px 10px rgba(85,53,181,.22);
            transition: background .15s, transform .13s;
        }
        .btn-save:hover { background: #3f2690; transform: translateY(-1px); }

        @@media (max-width: 768px) {
            .manage-page { padding: 20px 14px 48px; }
            .users-table thead th:nth-child(3),
            .users-table td:nth-child(3) { display: none; }
        }
    </style>
}

<div class="manage-page">

    @if (TempData["Success"] != null)
    {
        <div class="att-alert success">
            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="att-alert error">
            <i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]
        </div>
    }

    <div class="page-topbar">
        <div class="page-brand">
            <div class="page-brand-icon"><i class="bi bi-shield-check"></i></div>
            <div>
                <div class="page-brand-title">إدارة صلاحيات الأرشيف</div>
                <div class="page-brand-sub">الدفعة: @Model.BatchName</div>
            </div>
        </div>
        <div class="top-btns">
            <a asp-area="Admin"
               asp-controller="PlacementExams"
               asp-action="ArchiveHistory"
               asp-route-batchId="@Model.BatchId"
               class="btn-back">
                <i class="bi bi-clock-history"></i>
                سجل الأرشيف
            </a>
            <a asp-area="Admin"
               asp-controller="PlacementExams"
               asp-action="ArchivedPlacementExams"
               class="btn-back">
                <i class="bi bi-arrow-right-circle"></i>
                رجوع للأرشيف
            </a>
        </div>
    </div>

    <form asp-area="Admin" asp-controller="PlacementExams" asp-action="UpdateArchiveAccess" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="batchId" value="@Model.BatchId" />

        <div class="access-card">
            <div class="access-card-header">
                <div class="access-note">
                    <i class="bi bi-info-circle-fill"></i>
                    حدد المستخدمين المصرح لهم بعرض اختبارات هذه الدفعة المؤرشفة. التعديل غير متاح لأي أحد.
                </div>
            </div>

            <div style="overflow-x:auto">
                <table class="users-table">
                    <thead>
                        <tr>
                            <th style="width:80px; text-align:center">السماح</th>
                            <th>المستخدم</th>
                            <th>البريد الإلكتروني</th>
                            <th>الصلاحية</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Users.Any())
                        {
                            <tr>
                                <td colspan="4" style="text-align:center; padding:32px; color:var(--ink-4)">
                                    لا يوجد مستخدمون مؤهلون لمنح الصلاحية.
                                </td>
                            </tr>
                        }
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>
                                    <div class="toggle-wrap">
                                        <label class="toggle-switch">
                                            <input type="checkbox"
                                                   name="allowedUserIds"
                                                   value="@user.UserId"
                                                   @(user.IsAllowed ? "checked" : "") />
                                            <span class="toggle-slider"></span>
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <div class="user-info">
                                        <div class="user-avatar"><i class="bi bi-person-fill"></i></div>
                                        <div>
                                            <div class="user-name">@user.DisplayName</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="user-email">@user.Email</span>
                                </td>
                                <td>
                                    <span class="role-pill">@user.Roles</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="save-bar">
                <div class="save-note">
                    <i class="bi bi-shield-lock-fill"></i>
                    هذه الصلاحيات مستقلة عن صلاحيات الحضور ومخصصة للأرشيف فقط.
                </div>
                <button type="submit" class="btn-save">
                    <i class="bi bi-floppy2-fill"></i>
                    حفظ الصلاحيات
                </button>
            </div>
        </div>
    </form>

</div>
