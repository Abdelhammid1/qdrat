@model QdratNew.ViewModels.Reports.AdminExamSectionAnalysisViewModel
@{
    ViewData["Title"] = "📈 تقرير أداء الدفعة - " + Model.ExamTitle;
}

<div class="container py-4">
    <h2 class="fw-bold text-primary mb-3">
        📊 تقرير أداء الدفعة: @Model.ExamTitle
    </h2>
    <p class="text-muted mb-4">
        <i class="bi bi-people"></i> جميع طلاب: <strong>@Model.StudentName</strong>
    </p>

    @foreach (var sec in Model.SectionReports)
    {
        <div class="card mb-4 shadow-sm border-0 rounded-4">
            <div class="card-header bg-qdrat-light fw-bold text-primary">
                🧩 المحور: @sec.SectionTitle
            </div>
            <div class="card-body">
                <table class="table table-bordered text-center align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>المؤشر</th>
                            <th>عدد الأسئلة</th>
                            <th>إجابات صحيحة</th>
                            <th>إجابات خاطئة</th>
                            <th>النسبة العامة</th>
                            <th>الإجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lesson in sec.LessonBreakdown)
                        {
                            <tr>
                                <td class="text-start">@lesson.LessonTitle</td>
                                <td>@lesson.TotalQuestions</td>
                                <td class="text-success fw-bold">@lesson.Correct</td>
                                <td class="text-danger fw-bold">@lesson.Wrong</td>
                                <td class="fw-bold">@lesson.Score%</td>
                                <td>
                                    <a asp-area="Admin"
                                       asp-controller="PlacementExams"
                                       asp-action="ReviewLessonQuestionsBatch"
                                       asp-route-examId="@Model.ExamId"
                                       asp-route-lessonId="@lesson.LessonId"
                                       class="btn btn-outline-info btn-sm">
                                        <i class="bi bi-bar-chart"></i> تقرير الأسئلة
                                    </a>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="text-end mt-2">
                    <span class="badge bg-primary text-white">
                        المجموع الكلي: @sec.TotalQuestions سؤال - النسبة العامة: @sec.Score%
                    </span>
                </div>
            </div>
        </div>
    }
</div>
