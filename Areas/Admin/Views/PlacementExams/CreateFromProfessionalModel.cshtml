@using QdratNew.ViewModels.Exam
@model PlacementExamFromModelVm

@{
    ViewData["Title"] = "إنشاء اختبار تحديد مستوى من نموذج احترافي";
}

<div class="qdrat-page" dir="rtl">

    <div class="qdrat-hero mb-4">
        <div>
            <div class="qdrat-kicker">
                <i class="fa-solid fa-award"></i>
                نموذج احترافي
            </div>
            <h2 class="qdrat-title">إنشاء اختبار تحديد المستوى من نموذج احترافي</h2>
            <p class="qdrat-subtitle">
                اختر النموذج الاحترافي ثم حدد الدفعة والكورس وإعدادات الوقت لإنشاء اختبار جاهز للطلاب.
            </p>
        </div>

        <div class="qdrat-hero-icon">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert qdrat-alert qdrat-alert-danger alert-dismissible fade show">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>@TempData["Error"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert qdrat-alert qdrat-alert-success alert-dismissible fade show">
            <i class="fa-solid fa-circle-check"></i>
            <span>@TempData["Success"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="CreateFromProfessionalModel" method="post">
        @Html.AntiForgeryToken()

        <div class="qdrat-card mb-4">
            <div class="qdrat-card-header">
                <div>
                    <h5>
                        <i class="fa-solid fa-diagram-project"></i>
                        بيانات النموذج والربط
                    </h5>
                    <p>اختيار النموذج يعرض معاينة تفصيلية قبل إنشاء الاختبار.</p>
                </div>
            </div>

            <div class="qdrat-card-body">
                <div class="row g-4">

                    <div class="col-lg-4 col-md-6">
                        <div class="qdrat-field">
                            <label class="form-label">اختيار النموذج</label>
                            <div class="qdrat-input-wrap">
                                <i class="fa-solid fa-file-lines"></i>
                                <select asp-for="SelectedModelId" class="form-select" id="modelSelect">
                                    <option value="">-- اختر نموذج --</option>
                                    @foreach (var item in Model.AvailableModels)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                            </div>
                            <span asp-validation-for="SelectedModelId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <div class="qdrat-field">
                            <label class="form-label">اختيار الدفعة</label>
                            <div class="qdrat-input-wrap">
                                <i class="fa-solid fa-users"></i>
                                <select asp-for="SelectedBatchId" class="form-select">
                                    <option value="">-- اختر دفعة --</option>
                                    @foreach (var item in Model.AvailableBatches)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                            </div>
                            <span asp-validation-for="SelectedBatchId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <div class="qdrat-field">
                            <label class="form-label">اختيار الكورس</label>
                            <div class="qdrat-input-wrap">
                                <i class="fa-solid fa-book-open"></i>
                                <select asp-for="SelectedCourseId" class="form-select">
                                    <option value="">-- اختر كورس --</option>
                                    @foreach (var item in Model.AvailableCourses)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                            </div>
                            <span asp-validation-for="SelectedCourseId" class="text-danger small"></span>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="qdrat-card mb-4">
            <div class="qdrat-card-header">
                <div>
                    <h5>
                        <i class="fa-solid fa-clock"></i>
                        إعدادات الاختبار
                    </h5>
                    <p>حدد مدة الاختبار ووقت البداية والنهاية.</p>
                </div>
            </div>

            <div class="qdrat-card-body">
                <div class="row g-4 align-items-end">

                    <div class="col-lg-3 col-md-6">
                        <div class="qdrat-field">
                            <label class="form-label">المدة (دقيقة)</label>
                            <div class="qdrat-input-wrap">
                                <i class="fa-solid fa-stopwatch"></i>
                                <input asp-for="DurationMinutes" class="form-control" type="number" min="1" />
                            </div>
                            <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <div class="qdrat-field">
                            <label class="form-label">تاريخ البداية</label>
                            <div class="qdrat-input-wrap">
                                <i class="fa-solid fa-calendar-plus"></i>
                                <input asp-for="StartAt" type="datetime-local" class="form-control" />
                            </div>
                            <span asp-validation-for="StartAt" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <div class="qdrat-field">
                            <label class="form-label">تاريخ النهاية</label>
                            <div class="qdrat-input-wrap">
                                <i class="fa-solid fa-calendar-check"></i>
                                <input asp-for="EndAt" type="datetime-local" class="form-control" />
                            </div>
                            <span asp-validation-for="EndAt" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <button type="submit" class="btn qdrat-btn qdrat-btn-primary w-100">
                            <i class="fa-solid fa-rocket"></i>
                            إنشاء الاختبار
                        </button>
                    </div>

                </div>
            </div>
        </div>

        <div class="qdrat-card">
            <div class="qdrat-card-header">
                <div>
                    <h5>
                        <i class="fa-solid fa-eye"></i>
                        معاينة النموذج
                    </h5>
                    <p>تظهر تفاصيل النموذج هنا بعد اختياره.</p>
                </div>
            </div>

            <div class="qdrat-card-body">
                <div id="modelPreview" class="row g-4">
                    <div class="col-12">
                        <div class="qdrat-empty-state">
                            <i class="fa-solid fa-file-circle-question"></i>
                            <h6>لم يتم اختيار نموذج بعد</h6>
                            <p>اختر نموذجًا احترافيًا من القائمة بالأعلى لعرض تفاصيله.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </form>

</div>

<div class="modal fade" id="previewModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content qdrat-modal">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fa-solid fa-magnifying-glass-chart"></i>
                    معاينة النموذج
                </h5>
                <button type="button" class="btn-close ms-0" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="modalContent">
                جاري التحميل...
            </div>

        </div>
    </div>
</div>

<style>
    .qdrat-page {
        padding: 24px;
        background: #f5f7fb;
        min-height: calc(100vh - 80px);
        font-family: inherit;
    }

    .qdrat-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 26px;
        border-radius: 24px;
        background: linear-gradient(135deg, #102a43 0%, #1d4ed8 58%, #38bdf8 100%);
        color: #fff;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
    }

    .qdrat-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .qdrat-title {
        margin: 0;
        font-size: 28px;
        font-weight: 900;
        letter-spacing: -0.5px;
    }

    .qdrat-subtitle {
        margin: 10px 0 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 15px;
        line-height: 1.8;
        max-width: 850px;
    }

    .qdrat-hero-icon {
        width: 74px;
        height: 74px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.16);
        font-size: 34px;
        flex: 0 0 auto;
    }

    .qdrat-card {
        border: 1px solid #e5e7eb;
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    .qdrat-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
        background: #fff;
    }

        .qdrat-card-header h5 {
            margin: 0;
            color: #0f172a;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .qdrat-card-header h5 i {
                color: #2563eb;
            }

        .qdrat-card-header p {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 14px;
        }

    .qdrat-card-body {
        padding: 24px;
    }

    .qdrat-field .form-label {
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 9px;
    }

    .qdrat-input-wrap {
        position: relative;
    }

        .qdrat-input-wrap > i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 3;
            pointer-events: none;
        }

        .qdrat-input-wrap .form-select,
        .qdrat-input-wrap .form-control {
            min-height: 48px;
            border-radius: 15px;
            border-color: #dbe3ef;
            padding-right: 42px;
            font-weight: 700;
        }

            .qdrat-input-wrap .form-select:focus,
            .qdrat-input-wrap .form-control:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 0.22rem rgba(37, 99, 235, 0.12);
            }

    .qdrat-btn {
        min-height: 48px;
        border-radius: 15px;
        padding: 10px 22px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .qdrat-btn-primary {
        background: #16a34a;
        border-color: #16a34a;
        color: #fff;
    }

        .qdrat-btn-primary:hover {
            background: #15803d;
            border-color: #15803d;
            color: #fff;
        }

    .qdrat-model-card {
        height: 100%;
        border: 1px solid #e5e7eb;
        border-radius: 22px;
        background: #fff;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.07);
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
        overflow: hidden;
    }

        .qdrat-model-card:hover {
            transform: translateY(-3px);
            border-color: #bfdbfe;
            box-shadow: 0 18px 40px rgba(37, 99, 235, 0.14);
        }

    .qdrat-model-card-body {
        padding: 20px;
    }

    .qdrat-model-icon {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        margin-bottom: 14px;
    }

    .qdrat-model-title {
        font-size: 17px;
        font-weight: 900;
        color: #0f172a;
        margin: 0 0 10px;
        line-height: 1.7;
    }

    .qdrat-model-meta {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #64748b;
        font-size: 14px;
        font-weight: 800;
        margin-bottom: 16px;
    }

    .qdrat-preview-btn {
        min-height: 42px;
        border-radius: 13px;
        font-weight: 900;
    }

    .qdrat-empty-state {
        border: 1px dashed #cbd5e1;
        border-radius: 22px;
        background: #f8fafc;
        text-align: center;
        padding: 38px 20px;
        color: #64748b;
    }

        .qdrat-empty-state > i {
            font-size: 38px;
            color: #94a3b8;
            margin-bottom: 12px;
        }

        .qdrat-empty-state h6 {
            margin: 0;
            font-weight: 900;
            color: #334155;
        }

        .qdrat-empty-state p {
            margin: 8px 0 0;
            font-weight: 700;
        }

    .qdrat-alert {
        border: 0;
        border-radius: 18px;
        padding: 15px 18px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 800;
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.07);
    }

        .qdrat-alert .btn-close {
            margin-right: auto;
            margin-left: 0;
        }

    .qdrat-alert-danger {
        color: #991b1b;
        background: #fee2e2;
    }

    .qdrat-alert-success {
        color: #166534;
        background: #dcfce7;
    }

    .qdrat-modal {
        border: 0;
        border-radius: 22px;
        overflow: hidden;
    }

        .qdrat-modal .modal-header {
            background: #f8fafc;
            border-bottom: 1px solid #e5e7eb;
            padding: 18px 22px;
        }

        .qdrat-modal .modal-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 900;
            color: #0f172a;
        }

            .qdrat-modal .modal-title i {
                color: #2563eb;
            }

    .qdrat-loading-box,
    .qdrat-error-box {
        border-radius: 18px;
        padding: 24px;
        text-align: center;
        font-weight: 900;
    }

    .qdrat-loading-box {
        background: #eff6ff;
        color: #1d4ed8;
    }

    .qdrat-error-box {
        background: #fee2e2;
        color: #991b1b;
    }

    @@media (max-width: 768px) {
        .qdrat-page {
            padding: 14px;
        }

        .qdrat-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 20px;
        }

        .qdrat-title {
            font-size: 23px;
        }

        .qdrat-hero-icon {
            width: 58px;
            height: 58px;
            font-size: 26px;
        }

        .qdrat-card-body,
        .qdrat-card-header {
            padding: 18px;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const modelSelect = document.getElementById("modelSelect");
            const previewContainer = document.getElementById("modelPreview");

            if (!modelSelect || !previewContainer) {
                return;
            }

            modelSelect.addEventListener("change", async function () {
                const modelId = this.value;

                if (!modelId) {
                    renderEmptyState();
                    return;
                }

                previewContainer.innerHTML = `
                    <div class="col-12">
                        <div class="qdrat-loading-box">
                            <i class="fa fa-spinner fa-spin"></i>
                            جاري تحميل النموذج...
                        </div>
                    </div>`;

                try {
                    const response = await fetch(`/Admin/ProfessionalModels/GetModelPreview?modelId=${encodeURIComponent(modelId)}`, {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        }
                    });

                    if (!response.ok) {
                        throw new Error("Failed to load model preview.");
                    }

                    const data = await response.json();
                    renderModelCards(data);
                } catch {
                    previewContainer.innerHTML = `
                        <div class="col-12">
                            <div class="qdrat-error-box">
                                <i class="fa-solid fa-circle-exclamation"></i>
                                حدث خطأ أثناء تحميل النموذج.
                            </div>
                        </div>`;
                }
            });

            function renderEmptyState() {
                previewContainer.innerHTML = `
                    <div class="col-12">
                        <div class="qdrat-empty-state">
                            <i class="fa-solid fa-file-circle-question"></i>
                            <h6>لم يتم اختيار نموذج بعد</h6>
                            <p>اختر نموذجًا احترافيًا من القائمة بالأعلى لعرض تفاصيله.</p>
                        </div>
                    </div>`;
            }

            function renderModelCards(data) {
                previewContainer.innerHTML = "";

                if (!Array.isArray(data) || data.length === 0) {
                    previewContainer.innerHTML = `
                        <div class="col-12">
                            <div class="qdrat-empty-state">
                                <i class="fa-solid fa-folder-open"></i>
                                <h6>لا توجد بيانات للعرض</h6>
                                <p>النموذج المحدد لا يحتوي على عناصر معاينة متاحة.</p>
                            </div>
                        </div>`;
                    return;
                }

                data.forEach(function (item) {
                    const card = document.createElement("div");
                    card.className = "col-xl-4 col-lg-4 col-md-6";

                    card.innerHTML = `
                        <div class="qdrat-model-card">
                            <div class="qdrat-model-card-body">
                                <div class="qdrat-model-icon">
                                    <i class="fa-solid fa-file-lines"></i>
                                </div>

                                <h5 class="qdrat-model-title">${escapeHtml(item.title)}</h5>

                                <div class="qdrat-model-meta">
                                    <i class="fa-solid fa-circle-question"></i>
                                    <span>عدد الأسئلة: ${escapeHtml(item.questionsCount)}</span>
                                </div>

                                <button type="button"
                                        class="btn btn-outline-primary qdrat-preview-btn w-100"
                                        onclick="openPreview(${Number(item.id)})">
                                    <i class="fa-solid fa-eye"></i>
                                    معاينة
                                </button>
                            </div>
                        </div>`;

                    previewContainer.appendChild(card);
                });
            }

            function escapeHtml(value) {
                if (value === null || value === undefined) {
                    return "";
                }

                return String(value)
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }
        })();

        async function openPreview(modelId) {
            const modalElement = document.getElementById("previewModal");
            const content = document.getElementById("modalContent");

            if (!modalElement || !content || !modelId) {
                return;
            }

            const modal = new bootstrap.Modal(modalElement);

            content.innerHTML = `
                <div class="qdrat-loading-box">
                    <i class="fa fa-spinner fa-spin"></i>
                    جاري التحميل...
                </div>`;

            try {
                const response = await fetch(`/Admin/ProfessionalModels/PreviewPartial?modelId=${encodeURIComponent(modelId)}`, {
                    method: "GET",
                    headers: {
                        "Accept": "text/html"
                    }
                });

                if (!response.ok) {
                    throw new Error("Failed to load preview partial.");
                }

                const html = await response.text();
                content.innerHTML = html;
            } catch {
                content.innerHTML = `
                    <div class="qdrat-error-box">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        حدث خطأ أثناء تحميل المعاينة.
                    </div>`;
            }

            modal.show();
        }
    </script>
}