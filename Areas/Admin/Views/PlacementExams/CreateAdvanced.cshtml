@model QdratNew.ViewModels.Exam.PlacementExamCreateAdvancedViewModel
@{
    ViewData["Title"] = "إنشاء اختبار تحديد المستوى (متقدم)";
}

<div class="qdrat-page" dir="rtl">

    <div class="qdrat-hero mb-4">
        <div>
            <div class="qdrat-kicker">
                <i class="fa-solid fa-layer-group"></i>
                إنشاء متقدم
            </div>
            <h2 class="qdrat-title">إنشاء اختبار تحديد المستوى (متقدم)</h2>
            <p class="qdrat-subtitle">
                اربط الاختبار بالدورة والدفعة أو الطالب، ثم حدد المحاور وعدد الأسئلة وإعدادات الوقت.
            </p>
        </div>

        <div class="qdrat-hero-icon">
            <i class="fa-solid fa-sliders"></i>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert qdrat-alert qdrat-alert-danger">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>@Html.Raw(TempData["Error"])</span>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert qdrat-alert qdrat-alert-success">
            <i class="fa-solid fa-circle-check"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    <form asp-action="CreateAdvancedPost" method="post" id="mainForm">

        <div class="qdrat-card mb-4">
            <div class="qdrat-card-header">
                <div>
                    <h5>
                        <i class="fa-solid fa-link"></i>
                        بيانات الربط
                    </h5>
                    <p>حدد الدورة أولًا ليتم تحميل المحاور المرتبطة بها.</p>
                </div>
            </div>

            <div class="qdrat-card-body">
                <div class="row g-4">

                    <div class="col-lg-4 col-md-6">
                        <div class="qdrat-field">
                            <label asp-for="CourseId" class="form-label"></label>
                            <div class="qdrat-input-wrap">
                                <i class="fa-solid fa-book-open"></i>
                                <select asp-for="CourseId" asp-items="Model.Courses" class="form-select" id="courseSelect">
                                    <option value="">-- اختر الدورة --</option>
                                </select>
                            </div>
                            <span asp-validation-for="CourseId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <div class="qdrat-field">
                            <label asp-for="BatchId" class="form-label"></label>
                            <div class="qdrat-input-wrap">
                                <i class="fa-solid fa-users"></i>
                                <select asp-for="BatchId" asp-items="Model.Batches" class="form-select">
                                    <option value="">-- اختر الدفعة (اختياري) --</option>
                                </select>
                            </div>
                            <span asp-validation-for="BatchId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <div class="qdrat-field">
                            <label asp-for="StudentId" class="form-label"></label>
                            <div class="qdrat-input-wrap">
                                <i class="fa-solid fa-user-graduate"></i>
                                <select asp-for="StudentId" asp-items="Model.Students" class="form-select">
                                    <option value="">-- اختر الطالب (اختياري) --</option>
                                </select>
                            </div>
                            <span asp-validation-for="StudentId" class="text-danger small"></span>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="qdrat-card mb-4">
            <div class="qdrat-card-header">
                <div>
                    <h5>
                        <i class="fa-solid fa-list-check"></i>
                        اختيار المحاور وعدد الأسئلة
                    </h5>
                    <p>المحاور التي عدد أسئلتها 0 لن يتم استخدامها أثناء إنشاء الاختبار.</p>
                </div>
            </div>

            <div class="qdrat-card-body">
                <div class="qdrat-table-wrap">
                    <table class="table qdrat-table align-middle text-center" id="sectionsTable">
                        <thead>
                            <tr>
                                <th>المنهج</th>
                                <th>المحور</th>
                                <th style="width: 190px;">عدد الأسئلة</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="3">
                                    <div class="qdrat-empty">
                                        <i class="fa-solid fa-circle-info"></i>
                                        يرجى اختيار دورة لعرض المحاور
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="qdrat-note mt-3">
                    <i class="fa-solid fa-lightbulb"></i>
                    يفضل توزيع عدد الأسئلة حسب أهمية كل محور ومستوى تغطيته داخل الدورة.
                </div>
            </div>
        </div>

        <div class="qdrat-card mb-4">
            <div class="qdrat-card-header">
                <div>
                    <h5>
                        <i class="fa-solid fa-clock"></i>
                        إعدادات الوقت
                    </h5>
                    <p>حدد نافذة إتاحة الاختبار للطالب أو الدفعة.</p>
                </div>
            </div>

            <div class="qdrat-card-body">
                <div class="row g-4">
                    <div class="col-lg-6 col-md-6">
                        <div class="qdrat-field">
                            <label asp-for="StartDate" class="form-label"></label>
                            <div class="qdrat-input-wrap">
                                <i class="fa-solid fa-calendar-plus"></i>
                                <input asp-for="StartDate" type="datetime-local" class="form-control" />
                            </div>
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6">
                        <div class="qdrat-field">
                            <label asp-for="EndDate" class="form-label"></label>
                            <div class="qdrat-input-wrap">
                                <i class="fa-solid fa-calendar-check"></i>
                                <input asp-for="EndDate" type="datetime-local" class="form-control" />
                            </div>
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-card mb-4">
            <div class="qdrat-card-header">
                <div>
                    <h5>
                        <i class="fa-solid fa-gear"></i>
                        إعدادات عامة
                    </h5>
                    <p>حدد عدد الأسئلة والمدة ودرجة الاجتياز وطريقة عرض الأسئلة.</p>
                </div>
            </div>

            <div class="qdrat-card-body">
                <div class="row g-4">

                    <div class="col-xl-3 col-lg-6 col-md-6">
                        <div class="qdrat-field">
                            <label asp-for="TotalQuestions" class="form-label"></label>
                            <div class="qdrat-input-wrap">
                                <i class="fa-solid fa-hashtag"></i>
                                <input asp-for="TotalQuestions" class="form-control" type="number" min="1" />
                            </div>
                            <span asp-validation-for="TotalQuestions" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-xl-3 col-lg-6 col-md-6">
                        <div class="qdrat-field">
                            <label asp-for="DurationMinutes" class="form-label"></label>
                            <div class="qdrat-input-wrap">
                                <i class="fa-solid fa-stopwatch"></i>
                                <input asp-for="DurationMinutes" class="form-control" type="number" min="5" />
                            </div>
                            <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-xl-3 col-lg-6 col-md-6">
                        <div class="qdrat-field">
                            <label asp-for="PassingScore" class="form-label"></label>
                            <div class="qdrat-input-wrap">
                                <i class="fa-solid fa-percent"></i>
                                <input asp-for="PassingScore" class="form-control" type="number" min="0" max="100" />
                            </div>
                            <span asp-validation-for="PassingScore" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-xl-3 col-lg-6 col-md-6">
                        <div class="qdrat-switch-box h-100">
                            <div class="form-check form-switch">
                                <input asp-for="IsRandomized" class="form-check-input" type="checkbox" />
                                <label asp-for="IsRandomized" class="form-check-label"></label>
                            </div>
                            <small>تفعيل العشوائية يساعد في تقليل تشابه ترتيب الأسئلة بين الطلاب.</small>
                        </div>
                    </div>

                </div>

                <div class="qdrat-warning-card mt-4">
                    <div class="form-check form-switch">
                        <input asp-for="IsInLab" class="form-check-input" type="checkbox" />
                        <label asp-for="IsInLab" class="form-check-label fw-bold"></label>
                    </div>

                    <small>
                        عند اختيار حضوري سيتم توليد كود مرجعي من 6 أرقام يظهر في تفاصيل الاختبار ويُستخدم لفتح الاختبار للطلاب.
                    </small>
                </div>
            </div>
        </div>

        <div class="qdrat-sticky-actions">
            <a asp-action="Index" class="btn qdrat-btn qdrat-btn-light">
                <i class="fa-solid fa-arrow-right"></i>
                عودة للقائمة
            </a>

            <button type="submit" class="btn qdrat-btn qdrat-btn-primary">
                <i class="fa-solid fa-check-circle"></i>
                إنشاء الاختبار
            </button>
        </div>

    </form>
</div>

<style>
    .qdrat-page {
        padding: 24px;
        background: #f5f7fb;
        min-height: calc(100vh - 80px);
        font-family: inherit;
    }

    .qdrat-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 26px;
        border-radius: 24px;
        background: linear-gradient(135deg, #102a43 0%, #1d4ed8 58%, #38bdf8 100%);
        color: #fff;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
    }

    .qdrat-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .qdrat-title {
        margin: 0;
        font-size: 28px;
        font-weight: 900;
        letter-spacing: -0.5px;
    }

    .qdrat-subtitle {
        margin: 10px 0 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 15px;
        line-height: 1.8;
        max-width: 820px;
    }

    .qdrat-hero-icon {
        width: 74px;
        height: 74px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.16);
        font-size: 34px;
        flex: 0 0 auto;
    }

    .qdrat-card {
        border: 1px solid #e5e7eb;
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    .qdrat-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
        background: #fff;
    }

        .qdrat-card-header h5 {
            margin: 0;
            color: #0f172a;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .qdrat-card-header h5 i {
                color: #2563eb;
            }

        .qdrat-card-header p {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 14px;
        }

    .qdrat-card-body {
        padding: 24px;
    }

    .qdrat-field .form-label {
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 9px;
    }

    .qdrat-input-wrap {
        position: relative;
    }

        .qdrat-input-wrap > i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 3;
            pointer-events: none;
        }

        .qdrat-input-wrap .form-select,
        .qdrat-input-wrap .form-control {
            min-height: 48px;
            border-radius: 15px;
            border-color: #dbe3ef;
            padding-right: 42px;
            font-weight: 700;
        }

            .qdrat-input-wrap .form-select:focus,
            .qdrat-input-wrap .form-control:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 0.22rem rgba(37, 99, 235, 0.12);
            }

    .qdrat-table-wrap {
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        overflow: hidden;
        background: #fff;
    }

    .qdrat-table {
        margin: 0;
    }

        .qdrat-table thead th {
            background: #f8fafc;
            color: #334155;
            font-weight: 900;
            border-bottom: 1px solid #e5e7eb;
            padding: 14px;
        }

        .qdrat-table tbody td {
            padding: 14px;
            color: #334155;
            font-weight: 700;
            border-color: #edf0f5;
        }

        .qdrat-table input[type="number"] {
            border-radius: 13px;
            min-height: 42px;
            font-weight: 900;
        }

    .qdrat-empty {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #64748b;
        font-weight: 800;
        padding: 10px;
    }

    .qdrat-loading,
    .qdrat-error {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-weight: 900;
        padding: 10px;
    }

    .qdrat-loading {
        color: #2563eb;
    }

    .qdrat-error {
        color: #dc2626;
    }

    .qdrat-note {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 13px 15px;
        border-radius: 16px;
        background: #eff6ff;
        color: #1e40af;
        font-weight: 800;
        font-size: 13px;
    }

    .qdrat-switch-box {
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 16px;
        background: #f8fafc;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 8px;
    }

        .qdrat-switch-box .form-check-label {
            font-weight: 900;
            color: #1e293b;
        }

        .qdrat-switch-box small {
            color: #64748b;
            font-weight: 700;
            line-height: 1.7;
        }

    .qdrat-warning-card {
        border: 1px solid #facc15;
        background: #fffbeb;
        border-radius: 18px;
        padding: 16px;
    }

        .qdrat-warning-card small {
            display: block;
            color: #854d0e;
            margin-top: 7px;
            line-height: 1.8;
            font-weight: 700;
        }

    .qdrat-sticky-actions {
        position: sticky;
        bottom: 16px;
        z-index: 20;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding: 14px;
        margin-top: 8px;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(10px);
        box-shadow: 0 16px 35px rgba(15, 23, 42, 0.12);
    }

    .qdrat-btn {
        min-height: 46px;
        border-radius: 14px;
        padding: 10px 24px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .qdrat-btn-primary {
        background: #16a34a;
        border-color: #16a34a;
        color: #fff;
    }

        .qdrat-btn-primary:hover {
            background: #15803d;
            border-color: #15803d;
            color: #fff;
        }

    .qdrat-btn-light {
        background: #f8fafc;
        border-color: #dbe3ef;
        color: #334155;
    }

        .qdrat-btn-light:hover {
            background: #eef2f7;
            border-color: #cbd5e1;
            color: #0f172a;
        }

    .qdrat-alert {
        border: 0;
        border-radius: 18px;
        padding: 15px 18px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 800;
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.07);
    }

    .qdrat-alert-danger {
        color: #991b1b;
        background: #fee2e2;
    }

    .qdrat-alert-success {
        color: #166534;
        background: #dcfce7;
    }

    @@media (max-width: 768px) {
        .qdrat-page {
            padding: 14px;
        }

        .qdrat-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 20px;
        }

        .qdrat-title {
            font-size: 23px;
        }

        .qdrat-hero-icon {
            width: 58px;
            height: 58px;
            font-size: 26px;
        }

        .qdrat-card-body,
        .qdrat-card-header {
            padding: 18px;
        }

        .qdrat-sticky-actions {
            flex-direction: column-reverse;
        }

        .qdrat-btn {
            width: 100%;
        }

        .qdrat-table {
            min-width: 680px;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const courseSelect = document.getElementById("courseSelect");
            const tbody = document.querySelector("#sectionsTable tbody");

            if (!courseSelect || !tbody) {
                return;
            }

            courseSelect.addEventListener("change", function () {
                const courseId = this.value;

                if (!courseId) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="3">
                                <div class="qdrat-empty">
                                    <i class="fa-solid fa-circle-info"></i>
                                    يرجى اختيار دورة لعرض المحاور
                                </div>
                            </td>
                        </tr>`;
                    return;
                }

                tbody.innerHTML = `
                    <tr>
                        <td colspan="3">
                            <div class="qdrat-loading">
                                <i class="fa fa-spinner fa-spin"></i>
                                جاري تحميل المحاور...
                            </div>
                        </td>
                    </tr>`;

                fetch(`/Admin/PlacementExams/GetSectionsByCourse?courseId=${encodeURIComponent(courseId)}`, {
                    method: "GET",
                    headers: {
                        "Accept": "application/json"
                    }
                })
                    .then(function (response) {
                        if (!response.ok) {
                            throw new Error("Failed to load sections.");
                        }

                        return response.json();
                    })
                    .then(function (data) {
                        if (!Array.isArray(data) || data.length === 0) {
                            tbody.innerHTML = `
                                <tr>
                                    <td colspan="3">
                                        <div class="qdrat-error">
                                            <i class="fa-solid fa-triangle-exclamation"></i>
                                            لا توجد محاور لهذه الدورة.
                                        </div>
                                    </td>
                                </tr>`;
                            return;
                        }

                        let rows = "";

                        data.forEach(function (item, index) {
                            rows += `
                                <tr>
                                    <input type="hidden" name="SectionSelections.Index" value="${index}" />

                                    <input type="hidden" name="SectionSelections[${index}].SectionId" value="${escapeHtmlAttribute(item.sectionId)}" />
                                    <input type="hidden" name="SectionSelections[${index}].CurriculumId" value="${escapeHtmlAttribute(item.curriculumId)}" />
                                    <input type="hidden" name="SectionSelections[${index}].SectionTitle" value="${escapeHtmlAttribute(item.sectionTitle)}" />
                                    <input type="hidden" name="SectionSelections[${index}].CurriculumTitle" value="${escapeHtmlAttribute(item.curriculumTitle)}" />

                                    <td>${escapeHtml(item.curriculumTitle)}</td>
                                    <td>${escapeHtml(item.sectionTitle)}</td>
                                    <td>
                                        <input type="number"
                                               class="form-control text-center"
                                               name="SectionSelections[${index}].QuestionCount"
                                               min="0"
                                               value="0" />
                                    </td>
                                </tr>`;
                        });

                        tbody.innerHTML = rows;
                    })
                    .catch(function () {
                        tbody.innerHTML = `
                            <tr>
                                <td colspan="3">
                                    <div class="qdrat-error">
                                        <i class="fa-solid fa-circle-exclamation"></i>
                                        حدث خطأ أثناء تحميل المحاور.
                                    </div>
                                </td>
                            </tr>`;
                    });
            });

            function escapeHtml(value) {
                if (value === null || value === undefined) {
                    return "";
                }

                return String(value)
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            function escapeHtmlAttribute(value) {
                return escapeHtml(value);
            }
        })();
    </script>
}