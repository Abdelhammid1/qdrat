@model QdratNew.ViewModels.Exam.PlacementExamBatchArchiveHistoryVM

@{
    ViewData["Title"] = "سجل أرشيف اختبارات تحديد المستوى";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --ink: #0D1B2A; --ink-2: #2C3E50; --ink-3: #5A6A7A; --ink-4: #8FA0B0; --ink-5: #C8D5E0;
            --canvas: #F3F6FA; --surface: #FFFFFF; --surface-2: #F8FAFC; --surface-3: #EEF2F7; --border: #DDE4EC;
            --blue: #1B5EAE; --blue-bg: #E8F1FB; --blue-dark: #103E7A;
            --emerald: #0D7A5B; --emerald-bg: #E4F5EE;
            --amber: #985D09; --amber-bg: #FDF0D8;
            --rose: #BF1030; --rose-bg: #FDEAEE;
            --violet: #5535B5; --violet-bg: #EDE8F9;
            --r-md: 10px; --r-lg: 14px; --r-xl: 20px;
            --sh-xs: 0 1px 3px rgba(13,27,42,.06);
            --sh-sm: 0 2px 8px rgba(13,27,42,.08);
        }

        .history-page {
            background: var(--canvas); min-height: 100vh;
            padding: 32px 28px 64px; direction: rtl;
            font-family: 'Cairo', sans-serif; color: var(--ink-2);
        }
        .page-topbar {
            display: flex; align-items: center; justify-content: space-between;
            flex-wrap: wrap; gap: 14px; margin-bottom: 28px;
        }
        .page-brand { display: flex; align-items: center; gap: 13px; }
        .page-brand-icon {
            width: 46px; height: 46px; background: var(--amber);
            border-radius: var(--r-lg); display: flex; align-items: center;
            justify-content: center; color: #fff; font-size: 20px;
            box-shadow: 0 4px 14px rgba(152,93,9,.25);
        }
        .page-brand-title { font-size: 19px; font-weight: 800; color: var(--ink); }
        .page-brand-sub   { font-size: 14px; color: var(--ink-4); margin-top: 2px; }

        .top-btns { display: flex; gap: 10px; flex-wrap: wrap; }
        .btn-back {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 9px 18px; background: var(--surface); color: var(--blue);
            border: 1px solid var(--border); border-radius: var(--r-md);
            font-size: 14px; font-weight: 800; text-decoration: none;
            transition: background .15s, color .15s;
        }
        .btn-back:hover { background: var(--blue); color: #fff; }

        /* Timeline */
        .history-card {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: var(--r-xl); box-shadow: var(--sh-sm); overflow: hidden;
        }
        .history-card-header {
            display: flex; align-items: center; gap: 10px;
            padding: 14px 18px; border-bottom: 1px solid var(--surface-3); background: var(--surface-2);
        }
        .history-title { font-size: 17px; font-weight: 800; color: var(--ink); }
        .history-count {
            margin-right: auto; font-size: 13px; color: var(--ink-4);
        }
        .history-count strong { color: var(--amber); }

        .timeline { padding: 20px 20px 8px; list-style: none; margin: 0; position: relative; }
        .timeline::before {
            content: ''; position: absolute; right: 38px; top: 20px; bottom: 8px;
            width: 2px; background: var(--surface-3);
        }
        .timeline-item {
            display: flex; gap: 16px; margin-bottom: 20px; position: relative;
        }
        .tl-dot {
            width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
            font-size: 15px; z-index: 1;
        }
        .tl-dot.archived   { background: var(--amber-bg);   color: var(--amber); }
        .tl-dot.restored   { background: var(--emerald-bg); color: var(--emerald); }
        .tl-dot.access     { background: var(--violet-bg);  color: var(--violet); }
        .tl-dot.view       { background: var(--blue-bg);    color: var(--blue); }
        .tl-dot.other      { background: var(--surface-3);  color: var(--ink-4); }

        .tl-body {
            flex: 1; background: var(--surface-2); border: 1px solid var(--border);
            border-radius: var(--r-lg); padding: 12px 14px;
        }
        .tl-header {
            display: flex; align-items: center; justify-content: space-between;
            gap: 10px; flex-wrap: wrap; margin-bottom: 6px;
        }
        .tl-action {
            font-size: 14px; font-weight: 800; color: var(--ink);
            display: flex; align-items: center; gap: 6px;
        }
        .tl-badge {
            display: inline-flex; align-items: center; gap: 4px;
            padding: 2px 8px; border-radius: 20px; font-size: 12px; font-weight: 700;
        }
        .badge-archived { background: var(--amber-bg); color: var(--amber); }
        .badge-restored { background: var(--emerald-bg); color: var(--emerald); }
        .badge-access   { background: var(--violet-bg); color: var(--violet); }
        .badge-view     { background: var(--blue-bg); color: var(--blue); }
        .badge-other    { background: var(--surface-3); color: var(--ink-4); }

        .tl-time { font-size: 12px; color: var(--ink-4); white-space: nowrap; }
        .tl-desc { font-size: 13px; color: var(--ink-3); line-height: 1.6; }
        .tl-admin {
            display: inline-flex; align-items: center; gap: 4px;
            font-size: 12px; color: var(--ink-4); margin-top: 4px;
        }

        .history-empty {
            text-align: center; padding: 56px 16px; color: var(--ink-4);
        }
        .history-empty i { font-size: 24px; display: block; margin-bottom: 12px; color: var(--ink-5); }
        .history-empty-title { font-size: 17px; font-weight: 800; color: var(--ink-3); }
        .history-empty-sub   { font-size: 14px; margin-top: 4px; }

        @@media (max-width: 768px) {
            .history-page { padding: 20px 14px 48px; }
            .timeline::before { right: 30px; }
            .tl-dot { width: 28px; height: 28px; font-size: 13px; }
        }
    </style>
}

<div class="history-page">

    <div class="page-topbar">
        <div class="page-brand">
            <div class="page-brand-icon"><i class="bi bi-clock-history"></i></div>
            <div>
                <div class="page-brand-title">سجل أرشيف اختبارات تحديد المستوى</div>
                <div class="page-brand-sub">الدفعة: @Model.BatchName</div>
            </div>
        </div>
        <div class="top-btns">
            @if (User.IsInRole("Owner") || User.IsInRole("Developer"))
            {
                <a asp-area="Admin"
                   asp-controller="PlacementExams"
                   asp-action="ManageArchiveAccess"
                   asp-route-batchId="@Model.BatchId"
                   class="btn-back">
                    <i class="bi bi-shield-check"></i>
                    إدارة الصلاحيات
                </a>
            }
            <a asp-area="Admin"
               asp-controller="PlacementExams"
               asp-action="ArchivedPlacementExams"
               class="btn-back">
                <i class="bi bi-arrow-right-circle"></i>
                رجوع للأرشيف
            </a>
        </div>
    </div>

    <div class="history-card">
        <div class="history-card-header">
            <i class="bi bi-journal-text" style="color:var(--amber);font-size:18px"></i>
            <span class="history-title">سجل العمليات</span>
            <span class="history-count">إجمالي: <strong>@Model.Items.Count</strong> عملية</span>
        </div>

        @if (!Model.Items.Any())
        {
            <div class="history-empty">
                <i class="bi bi-journal-x"></i>
                <div class="history-empty-title">لا توجد سجلات بعد</div>
                <div class="history-empty-sub">ستظهر هنا عمليات الأرشفة والاسترجاع وتعديل الصلاحيات</div>
            </div>
        }
        else
        {
            <ul class="timeline">
                @foreach (var item in Model.Items)
                {
                    var (dotClass, badgeClass, badgeLabel, icon) = item.ActionType switch
                    {
                        var a when a.Contains("Archived")      => ("archived", "badge-archived", "أرشفة",       "bi-box-arrow-in-down"),
                        var a when a.Contains("Restored")      => ("restored", "badge-restored", "استرجاع",     "bi-arrow-counterclockwise"),
                        var a when a.Contains("AccessUpdated") => ("access",   "badge-access",   "تعديل صلاحية","bi-shield-check"),
                        var a when a.Contains("View")          => ("view",     "badge-view",     "عرض",         "bi-eye-fill"),
                        _                                       => ("other",    "badge-other",    "أخرى",        "bi-activity")
                    };

                    <li class="timeline-item">
                        <div class="tl-dot @dotClass">
                            <i class="bi @icon"></i>
                        </div>
                        <div class="tl-body">
                            <div class="tl-header">
                                <div class="tl-action">
                                    <span class="tl-badge @badgeClass">@badgeLabel</span>
                                    @item.ActionType
                                </div>
                                <span class="tl-time">
                                    <i class="bi bi-clock"></i>
                                    @item.Timestamp.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                                </span>
                            </div>
                            <div class="tl-desc">@item.Description</div>
                            <div class="tl-admin">
                                <i class="bi bi-person-fill"></i>
                                @item.AdminName
                            </div>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>

</div>
