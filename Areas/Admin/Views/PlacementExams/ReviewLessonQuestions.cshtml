        gap: .6rem;
        flex-wrap: wrap;
    }

    .qlb-qnum {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: var(--q-primary);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .85rem;
        font-weight: 800;
        flex-shrink: 0;
    }

    .qlb-result-badge {
        font-size: .78rem;
        font-weight: 800;
        padding: .24rem .7rem;
        border-radius: 99px;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
    }

    .result-correct {
        background: var(--q-success-lt);
