        }

    .qlb-qtitle {
        font-size: .98rem;
        color: var(--q-text);
        line-height: 1.8;
        font-weight: 800;
        background: #ffffff;
        border: 1px solid var(--q-border);
        border-right: 4px solid var(--q-primary);
