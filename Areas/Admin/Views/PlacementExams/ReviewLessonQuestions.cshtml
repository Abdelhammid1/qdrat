    }

    .qlb-qimg {
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid var(--q-border);
        text-align: center;
        background: #fff;
        padding: .5rem;
    }

        .qlb-qimg img {
            max-width: 100%;
            max-height: 220px;
            object-fit: contain;
            display: block;
            margin: 0 auto;
