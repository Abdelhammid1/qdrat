            box-shadow: var(--q-shadow-lg);
            transform: translateY(-2px);
        }

    .qlb-card-head {
        background: linear-gradient(90deg, var(--q-primary-lt), #f5f3ff);
        border-bottom: 1px solid var(--q-border);
