    }

        .qlb-opt.opt-correct {
            border-color: var(--q-success);
            background: var(--q-success-lt);
        }

        .qlb-opt.opt-wrong {
            border-color: var(--q-danger);
            background: var(--q-danger-lt);
        }

        .qlb-opt.opt-normal {
            border-color: var(--q-border);
            background: #fff;
        }

    .qlb-opt-label {
        width: 28px;
        height: 28px;
        border-radius: 7px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .78rem;
        font-weight: 800;
        background: #d1d5db;
        color: #fff;
    }

    .opt-correct .qlb-opt-label {
        background: var(--q-success);
        color: #fff;
    }

    .opt-wrong .qlb-opt-label {
        background: var(--q-danger);
        color: #fff;
    }

    .qlb-opt-content {
        flex: 1;
        min-width: 0;
    }

    .qlb-opt-text {
        line-height: 1.5;
        color: var(--q-text);
        font-weight: 600;
    }

        .qlb-opt-text img {
            max-height: 55px;
            border-radius: 6px;
            vertical-align: middle;
        }

        .qlb-opt-text p {
            margin: 0;
        }

    .qlb-opt-img {
        max-height: 58px;
        max-width: 160px;
        object-fit: contain;
        border-radius: 7px;
        border: 1px solid var(--q-border);
        background: #fff;
        padding: .15rem;
        margin-bottom: .35rem;
        display: block;
    }

    .qlb-opt-tags {
        display: flex;
        align-items: center;
        gap: .35rem;
        flex-wrap: wrap;
        margin-top: .35rem;
    }

    .qlb-mini-badge {
        border-radius: 99px;
        padding: .16rem .55rem;
        font-size: .7rem;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        gap: .25rem;
    }

    .badge-student {
        background: var(--q-info-lt);
        color: var(--q-info);
    }

    .badge-correct {
        background: var(--q-success);
        color: #fff;
    }

    .qlb-opt-icon {
        font-size: .9rem;
        flex-shrink: 0;
        margin-right: auto;
    }

    .opt-correct .qlb-opt-icon {
        color: var(--q-success);
    }

    .opt-wrong .qlb-opt-icon {
        color: var(--q-danger);
    }

    .opt-normal .qlb-opt-icon {
        color: #9ca3af;
    }

    .qlb-empty {
        border: 1px dashed var(--q-border);
        background: var(--q-skip-lt);
        color: var(--q-muted);
        border-radius: 10px;
        padding: .9rem 1rem;
        text-align: center;
        font-size: .86rem;
        font-weight: 700;
    }

    .qlb-card-foot {
        background: #fafafa;
        border-top: 1px solid var(--q-border);
        padding: .7rem 1.1rem;
        display: flex;
        align-items: center;
        gap: .5rem;
        flex-wrap: wrap;
    }

    .qlb-foot-chip {
        display: inline-flex;
        align-items: center;
        gap: .32rem;
        font-size: .76rem;
        font-weight: 800;
        padding: .2rem .65rem;
        border-radius: 99px;
    }

    .fc-g {
        background: var(--q-success-lt);
        color: var(--q-success);
    }

    .fc-r {
        background: var(--q-danger-lt);
        color: var(--q-danger);
    }

    .fc-t {
        background: var(--q-info-lt);
        color: var(--q-info);
    }

    .fc-tm {
        background: var(--q-warning-lt);
        color: var(--q-warning);
        margin-right: auto;
    }

    @@media (max-width: 900px) {
        .qlb-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 767px) {
        .qlb-stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .qlb-hero {
            padding: 1.6rem 1.2rem;
        }
    }

    @@media (max-width: 480px) {
        .qlb-page {
            padding: 1rem .7rem 3rem;
        }

        .qlb-stats {
            grid-template-columns: 1fr;
        }

        .qlb-stat {
            min-height: auto;
        }

        .qlb-compare {
            grid-template-columns: 1fr;
            gap: .4rem;
        }

        .qlb-cmp-vs {
            display: none;
        }

        .qlb-time-chip {
            width: 100%;
            margin-right: 0;
        }

        .qlb-card-foot {
            align-items: stretch;
        }

        .qlb-foot-chip {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="qlb-page" dir="rtl">

    <!-- Hero -->
    <div class="qlb-hero">
        <div class="qlb-hero-icon">
            <i class="fas fa-file-circle-check"></i>
        </div>

        <h1>مراجعة إجابات الاختبار</h1>

        <p class="qlb-hero-subtitle">
            @Model.ExamTitle
        </p>

        <div class="qlb-hero-meta">
            <span class="qlb-hero-pill">
                <i class="fas fa-question-circle"></i>
                إجمالي الأسئلة: @FmtNumber(Model.TotalQuestions.ToString())
            </span>

            <span class="qlb-hero-pill">
                <i class="fas fa-chart-pie"></i>
                النسبة العامة: @FmtNumber(percent.ToString())%
            </span>

            <span class="qlb-hero-pill">
                <i class="fas fa-clock"></i>
                الوقت: @FmtNumber(Model.TimeSpentMinutes.ToString()) دقيقة
            </span>
        </div>
    </div>

    <!-- Stats -->
    <div class="qlb-stats">
        <div class="qlb-stat">
            <div class="qlb-stat-ico ico-blue">
                <i class="fas fa-question-circle"></i>
            </div>
            <div class="qlb-stat-content">
                <div class="qlb-stat-lbl">إجمالي الأسئلة</div>
                <div class="qlb-stat-val">@FmtNumber(Model.TotalQuestions.ToString())</div>
            </div>
        </div>

        <div class="qlb-stat">
            <div class="qlb-stat-ico ico-green">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="qlb-stat-content">
                <div class="qlb-stat-lbl">إجابات صحيحة</div>
                <div class="qlb-stat-val" style="color:var(--q-success)">
                    @FmtNumber(correctCount.ToString())
                </div>
                <div class="qlb-stat-bar">
                    <div class="qlb-stat-fill fill-g" style="width:@(totalQ > 0 ? Math.Round(correctCount * 100.0 / totalQ, 0) : 0)%"></div>
                </div>
            </div>
        </div>

        <div class="qlb-stat">
            <div class="qlb-stat-ico ico-red">
                <i class="fas fa-times-circle"></i>
            </div>
            <div class="qlb-stat-content">
                <div class="qlb-stat-lbl">إجابات خاطئة</div>
                <div class="qlb-stat-val" style="color:var(--q-danger)">
                    @FmtNumber(wrongCount.ToString())
                </div>
                <div class="qlb-stat-bar">
                    <div class="qlb-stat-fill fill-r" style="width:@(totalQ > 0 ? Math.Round(wrongCount * 100.0 / totalQ, 0) : 0)%"></div>
                </div>
            </div>
        </div>

        <div class="qlb-stat">
            <div class="qlb-stat-ico ico-amber">
                <i class="fas fa-chart-pie"></i>
            </div>
            <div class="qlb-stat-content">
                <div class="qlb-stat-lbl">النسبة العامة</div>
                <div class="qlb-stat-val" style="color:var(--q-warning)">
                    @FmtNumber(percent.ToString())%
                </div>
                <div class="qlb-stat-bar">
                    <div class="qlb-stat-fill fill-a" style="width:@(Math.Min(percent, 100))%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Questions Grid -->
    <div class="qlb-grid">
        @foreach (var item in Model.Questions.Select((q, i) => new { q, i }))
        {
            var q = item.q;
            var index = item.i + 1;

            Func<string?, string> convert = s =>
            {
                var value = s ?? string.Empty;
                return q.IsQuantitative ? NumberHelper.ToIndicNumbersSafe(value) : value;
            };

            var resultClass = q.IsCorrect ? "result-correct" : "result-wrong";
            var resultIcon = q.IsCorrect ? "fa-check-circle" : "fa-times-circle";
            var resultText = q.IsCorrect ? "صحيح" : "خطأ";

            <div class="qlb-card">

                <!-- Card Header -->
                <div class="qlb-card-head">
                    <div class="qlb-qnum">
                        @FmtNumber(index.ToString())
                    </div>

                    <span class="qlb-result-badge @resultClass">
                        <i class="fas @resultIcon"></i>
                        @resultText
                    </span>

                    <span class="qlb-time-chip">
                        <i class="fas fa-clock"></i>
                        الوقت: @FmtSeconds(q.TimeTakenSeconds)
                    </span>
                </div>

                <!-- Card Body -->
                <div class="qlb-card-body">

                    <!-- Verbal Passage -->
                    @if (!string.IsNullOrWhiteSpace(q.VerbalPassageContent))
                    {
                        <div class="qlb-passage">
                            <div class="qlb-passage-title">
                                <i class="fas fa-book-open"></i>
                                القطعة المرتبطة
                            </div>

                            <div class="qlb-passage-text">
                                @Html.Raw(convert(q.VerbalPassageContent))
                            </div>
                        </div>
                    }

                    <!-- Comparison Values -->
                    @if (!string.IsNullOrWhiteSpace(q.ComparisonValue1) || !string.IsNullOrWhiteSpace(q.ComparisonValue2))
                    {
                        <div class="qlb-compare">
                            <div class="qlb-cmp-box">
                                @Html.Raw(convert(q.ComparisonValue1 ?? "—"))
                            </div>

                            <span class="qlb-cmp-vs">مقارنة</span>

                            <div class="qlb-cmp-box">
                                @Html.Raw(convert(q.ComparisonValue2 ?? "—"))
                            </div>
                        </div>
                    }

                    <!-- Question Image -->
                    @if (!string.IsNullOrWhiteSpace(q.ImageUrl))
                    {
                        <div class="qlb-qimg">
                            <img src="@Url.Content(q.ImageUrl)" alt="صورة السؤال" loading="lazy" />
                        </div>
                    }

                    <!-- Question Text - Bold -->
                    @if (!string.IsNullOrWhiteSpace(q.QuestionTitle))
                    {
                        <div class="qlb-qtitle">
                            @Html.Raw(convert(q.QuestionTitle))
                        </div>
                    }

                    <!-- Options -->
                    @if (q.Options != null && q.Options.Count > 0)
                    {
                        <div class="qlb-options">
                            @foreach (var optItem in q.Options.Select((opt, optIndex) => new { opt, optIndex }))
                            {
                                var opt = optItem.opt;
                                var optIndex = optItem.optIndex;

                                var optText = opt.Text ?? string.Empty;
                                var isSelected = optText == q.StudentAnswer;
                                var isCorrect = optText == q.CorrectAnswer;

                                var optCls = isCorrect ? "opt-correct"
                                : isSelected ? "opt-wrong"
                                : "opt-normal";

                                var optIcon = isCorrect ? "fa-check-circle"
                                : isSelected ? "fa-times-circle"
                                : "fa-circle";

                                var optionLabel = ((char)('أ' + optIndex)).ToString();

                                <div class="qlb-opt @optCls">
                                    <div class="qlb-opt-label">
                                        @optionLabel
                                    </div>

                                    <div class="qlb-opt-content">
                                        @if (!string.IsNullOrWhiteSpace(opt.ImageUrl))
                                        {
                                            <img src="@Url.Content(opt.ImageUrl)"
                                                 alt="صورة الاختيار"
                                                 class="qlb-opt-img"
                                                 loading="lazy" />
                                        }

                                        @if (!string.IsNullOrWhiteSpace(optText))
                                        {
                                            <div class="qlb-opt-text">
                                                @Html.Raw(convert(optText))
                                            </div>
                                        }

                                        <div class="qlb-opt-tags">
                                            @if (isSelected)
                                            {
                                                <span class="qlb-mini-badge badge-student">
                                                    <i class="fas fa-user-check"></i>
                                                    إجابتك
                                                </span>
                                            }

                                            @if (isCorrect)
                                            {
                                                <span class="qlb-mini-badge badge-correct">
                                                    <i class="fas fa-check"></i>
                                                    الإجابة الصحيحة
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    <i class="fas @optIcon qlb-opt-icon"></i>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="qlb-empty">
                            <i class="fas fa-info-circle"></i>
                            لا توجد اختيارات لهذا السؤال.
                        </div>
                    }

                </div>

                <!-- Card Footer -->
                <div class="qlb-card-foot">
                    @if (q.IsCorrect)
                    {
                        <span class="qlb-foot-chip fc-g">
                            <i class="fas fa-check"></i>
                            النتيجة: صحيح
                        </span>
                    }
                    else
                    {
                        <span class="qlb-foot-chip fc-r">
                            <i class="fas fa-times"></i>
                            النتيجة: خطأ
                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(q.StudentAnswer))
                    {
                        <span class="qlb-foot-chip fc-t">
                            <i class="fas fa-user-edit"></i>
                            تمت الإجابة
                        </span>
                    }
                    else
                    {
                        <span class="qlb-foot-chip fc-r">
                            <i class="fas fa-forward"></i>
                            لم تتم الإجابة
                        </span>
                    }

                    <span class="qlb-foot-chip fc-tm">
                        <i class="fas fa-stopwatch"></i>
                        @FmtSeconds(q.TimeTakenSeconds)
                    </span>
                </div>

            </div>
        }
    </div>

</div>