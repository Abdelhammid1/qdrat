    .qlb-time-chip {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        font-size: .75rem;
        color: var(--q-muted);
        font-weight: 700;
        margin-right: auto;
    }

    .qlb-card-body {
        padding: 1.1rem;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: .9rem;
    }

    .qlb-passage {
        background: #fafaf5;
        border: 1px solid #e8e4cf;
        border-radius: 10px;
        padding: .85rem 1rem;
        border-right: 4px solid var(--q-warning);
    }

    .qlb-passage-title {
        font-size: .78rem;
        font-weight: 800;
        color: var(--q-warning);
        margin-bottom: .5rem;
        display: flex;
        align-items: center;
