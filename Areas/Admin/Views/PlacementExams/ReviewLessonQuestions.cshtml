@model QdratNew.ViewModels.Exam.ExamReviewViewModel
@using QdratNew.Helpers

@{
    ViewData["Title"] = "مراجعة إجابات المحاور في الاختبار";

    int totalQ = Model.TotalQuestions;
    int correctCount = Model.Questions.Count(q => q.IsCorrect);
    int wrongCount = totalQ - correctCount;
    double percent = totalQ > 0 ? Math.Round(correctCount * 100.0 / totalQ, 1) : 0;

    string FmtSeconds(double seconds)
    {
        if (seconds <= 0) return "—";
        if (seconds < 60) return $"{NumberHelper.ToIndicNumbersSafe(Math.Round(seconds).ToString())} ث";
        var minutes = (int)(seconds / 60);
        var remainSeconds = (int)(seconds % 60);
        return $"{NumberHelper.ToIndicNumbersSafe(minutes.ToString())}:{NumberHelper.ToIndicNumbersSafe(remainSeconds.ToString("D2"))} د";
    }

    string FmtNumber(string value)
    {
        return NumberHelper.ToIndicNumbersSafe(value);
    }

    var totalTimeSeconds = Model.Questions.Sum(q => q.TimeTakenSeconds);
    var avgTimeSeconds = Model.Questions.Count > 0 ? Model.Questions.Average(q => q.TimeTakenSeconds) : 0;
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<style>
    :root {
        --q-primary: #4f46e5;
        --q-primary-lt: #ede9fe;
        --q-success: #16a34a;
        --q-success-lt: #dcfce7;
        --q-danger: #dc2626;
        --q-danger-lt: #fee2e2;
        --q-warning: #d97706;
        --q-warning-lt: #fef3c7;
        --q-info: #0891b2;
        --q-info-lt: #cffafe;
        --q-skip: #6b7280;
        --q-skip-lt: #f3f4f6;
        --q-surface: #ffffff;
        --q-bg: #f5f3ff;
        --q-border: #e5e7eb;
        --q-text: #1e1b4b;
        --q-muted: #6b7280;
        --q-radius: 16px;
        --q-shadow: 0 2px 12px rgba(79,70,229,.08);
        --q-shadow-lg: 0 6px 32px rgba(79,70,229,.13);
    }

    .qlb-page {
        direction: rtl;
        font-family: 'Cairo', 'Tajawal', 'Segoe UI', sans-serif;
        background: var(--q-bg);
        padding: 2rem 1rem 4rem;
        min-height: 100vh;
    }

    .qlb-hero {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 55%, #a855f7 100%);
        border-radius: var(--q-radius);
        padding: 2.2rem 2rem;
        color: #fff;
        margin-bottom: 2rem;
        box-shadow: var(--q-shadow-lg);
        position: relative;
        overflow: hidden;
    }

        .qlb-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 85% 50%, rgba(255,255,255,.10) 0%, transparent 60%);
            pointer-events: none;
        }

    .qlb-hero-icon {
        width: 56px;
        height: 56px;
        background: rgba(255,255,255,.18);
        border: 1px solid rgba(255,255,255,.25);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        margin-bottom: .8rem;
        position: relative;
        z-index: 1;
    }

    .qlb-hero h1 {
        font-size: clamp(1.25rem, 2.8vw, 1.85rem);
        font-weight: 800;
        margin: 0 0 .45rem;
        line-height: 1.4;
        position: relative;
        z-index: 1;
    }

    .qlb-hero-subtitle {
        font-size: .95rem;
        opacity: .9;
        margin: 0;
        position: relative;
        z-index: 1;
    }

    .qlb-hero-meta {
        display: flex;
        flex-wrap: wrap;
        gap: .6rem;
        margin-top: .9rem;
        position: relative;
        z-index: 1;
    }

    .qlb-hero-pill {
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.22);
        border-radius: 8px;
        padding: .3rem .85rem;
        font-size: .82rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
    }

    .qlb-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .qlb-stat {
        background: var(--q-surface);
        border-radius: var(--q-radius);
        padding: 1.2rem 1rem;
        box-shadow: var(--q-shadow);
        border: 1px solid var(--q-border);
        display: flex;
        align-items: center;
        gap: .9rem;
        transition: transform .2s, box-shadow .2s;
        min-height: 102px;
    }

        .qlb-stat:hover {
            transform: translateY(-2px);
            box-shadow: var(--q-shadow-lg);
        }

    .qlb-stat-ico {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
    }

    .ico-blue {
        background: var(--q-primary-lt);
        color: var(--q-primary);
    }

    .ico-green {
        background: var(--q-success-lt);
        color: var(--q-success);
    }

    .ico-red {
        background: var(--q-danger-lt);
        color: var(--q-danger);
    }

    .ico-amber {
        background: var(--q-warning-lt);
        color: var(--q-warning);
    }

    .qlb-stat-content {
        flex: 1;
        min-width: 0;
    }

    .qlb-stat-lbl {
        font-size: .75rem;
        color: var(--q-muted);
        font-weight: 700;
        margin-bottom: .25rem;
    }

    .qlb-stat-val {
        font-size: 1.75rem;
        font-weight: 800;
        color: var(--q-text);
        line-height: 1;
    }

    .qlb-stat-bar {
        height: 4px;
        background: var(--q-border);
        border-radius: 99px;
        margin-top: .55rem;
        overflow: hidden;
    }

    .qlb-stat-fill {
        height: 100%;
        border-radius: 99px;
        transition: width .8s ease;
    }

    .fill-g {
        background: var(--q-success);
    }

    .fill-r {
        background: var(--q-danger);
    }

    .fill-a {
        background: var(--q-warning);
    }

    .qlb-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    .qlb-card {
        background: var(--q-surface);
        border-radius: var(--q-radius);
        box-shadow: var(--q-shadow);
        border: 1px solid var(--q-border);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: box-shadow .2s, transform .2s;
