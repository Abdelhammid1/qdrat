            width: 4px;
        }

        .qlb-passage-text::-webkit-scrollbar-thumb {
            background: #d1c89a;
            border-radius: 99px;
        }

    .qlb-compare {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: .5rem;
        align-items: center;
    }

    .qlb-cmp-box {
        background: var(--q-primary-lt);
        border: 1px solid #c4b5fd;
        border-radius: 10px;
        padding: .75rem .85rem;
        text-align: center;
        font-size: .9rem;
        font-weight: 700;
        color: var(--q-primary);
        min-height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1.6;
    }

    .qlb-cmp-vs {
        font-size: .72rem;
        font-weight: 800;
        color: var(--q-muted);
        background: var(--q-border);
        border-radius: 99px;
        padding: .18rem .55rem;
