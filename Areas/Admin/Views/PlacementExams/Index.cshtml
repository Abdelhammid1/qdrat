@model QdratNew.ViewModels.Exam.PlacementExamsIndexVM
@using Microsoft.AspNetCore.Authorization
@using QdratNew.Security.AdminPermissions
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "إدارة اختبارات تحديد المستوى";

    var batchesList = Model?.ActiveBatches ?? new List<QdratNew.ViewModels.Exam.PlacementBatchExamVm>();
    var archivedCount = Model?.ArchivedBatchCount ?? 0;

    var canArchive = (await AuthorizationService.AuthorizeAsync(User, AdminPermissionPolicies.PlacementExams_Archive)).Succeeded;

    var totalBatches = batchesList.Count;
    var totalExams = batchesList.Sum(x => x.ExamsCount);
    var activeBatches = batchesList.Count(x => x.ExamsCount > 0);
    var emptyBatches = batchesList.Count(x => x.ExamsCount == 0);

    var lastExamDate = batchesList.Any()
        ? batchesList.Max(x => x.LastExamDate)
        : (DateTime?)null;
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        :root {
            --ink: #0D1B2A;
            --ink-2: #2C3E50;
            --ink-3: #5A6A7A;
            --ink-4: #8FA0B0;
            --ink-5: #C8D5E0;
            --canvas: #F3F6FA;
            --surface: #FFFFFF;
            --surface-2: #F8FAFC;
            --surface-3: #EEF2F7;
            --border: #DDE4EC;
            --blue: #1B5EAE;
            --blue-2: #2471D0;
            --blue-bg: #E8F1FB;
            --blue-dark: #103E7A;
            --emerald: #0D7A5B;
            --emerald-bg: #E4F5EE;
            --amber: #985D09;
            --amber-bg: #FDF0D8;
            --rose: #BF1030;
            --rose-bg: #FDEAEE;
            --violet: #5535B5;
            --violet-bg: #EDE8F9;
            --r-sm: 6px;
            --r-md: 10px;
            --r-lg: 14px;
            --r-xl: 20px;
            --sh-xs: 0 1px 3px rgba(13,27,42,.06);
            --sh-sm: 0 2px 8px rgba(13,27,42,.08);
            --sh-md: 0 4px 18px rgba(13,27,42,.10);
            --ease: cubic-bezier(.25,.46,.45,.94);
        }

        .placement-page {
            background: var(--canvas);
            min-height: 100vh;
            padding: 32px 28px 64px;
            direction: rtl;
            font-family: 'Cairo';
            color: var(--ink-2);
        }

        .placement-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 14px;
            margin-bottom: 28px;
        }

        .placement-brand {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .placement-brand-icon {
            width: 46px;
            height: 46px;
            background: var(--blue);
            border-radius: var(--r-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 20px;
            box-shadow: 0 4px 14px rgba(27,94,174,.28);
            flex-shrink: 0;
        }

        .placement-brand-title {
            font-size: 20px;
            font-weight: 700;
            color: var(--ink);
            line-height: 1.15;
        }

        .placement-brand-sub {
            font-size: 16px;
            color: var(--ink-4);
            margin-top: 2px;
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn-main-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            background: var(--blue);
            color: #fff;
            border: none;
            border-radius: var(--r-md);
            padding: 10px 20px;
            font-size: 18px;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            box-shadow: 0 3px 10px rgba(27,94,174,.24);
            transition: background .16s var(--ease), transform .14s, box-shadow .16s;
            white-space: nowrap;
        }

            .btn-main-action:hover {
                background: var(--blue-dark);
                color: #fff;
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(27,94,174,.30);
            }

            .btn-main-action.model-action {
                background: var(--violet);
                box-shadow: 0 3px 10px rgba(85,53,181,.22);
            }

                .btn-main-action.model-action:hover {
                    background: #3f2690;
                    color: #fff;
                    box-shadow: 0 6px 18px rgba(85,53,181,.28);
                }

        .placement-alert {
            border: none;
            border-radius: var(--r-lg);
            padding: 14px 18px;
            font-size: 17px;
            font-weight: 700;
            box-shadow: var(--sh-xs);
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .placement-alert-success {
            background: var(--emerald-bg);
            color: var(--emerald);
        }

        .placement-alert-danger {
            background: var(--rose-bg);
            color: var(--rose);
        }

        .placement-kpis {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 13px;
            margin-bottom: 24px;
        }

        @@media (max-width: 1200px) {
            .placement-kpis {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @@media (max-width: 960px) {
            .placement-kpis {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 480px) {
            .placement-kpis {
                grid-template-columns: 1fr;
            }
        }

        .kpi-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            padding: 18px 19px;
            display: flex;
            align-items: center;
            gap: 13px;
            box-shadow: var(--sh-xs);
            transition: transform .2s var(--ease), box-shadow .2s;
            position: relative;
            overflow: hidden;
        }

            .kpi-card::after {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 4px;
                height: 100%;
                border-radius: 0 var(--r-xl) var(--r-xl) 0;
            }

            .kpi-card:hover {
                transform: translateY(-3px);
                box-shadow: var(--sh-sm);
            }

        .kpi-blue::after {
            background: var(--blue);
        }

        .kpi-emerald::after {
            background: var(--emerald);
        }

        .kpi-amber::after {
            background: var(--amber);
        }

        .kpi-rose::after {
            background: var(--rose);
        }

        .kpi-violet::after {
            background: var(--violet);
        }

        .kpi-ico {
            width: 42px;
            height: 42px;
            border-radius: var(--r-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .ico-blue {
            background: var(--blue-bg);
            color: var(--blue);
        }

        .ico-emerald {
            background: var(--emerald-bg);
            color: var(--emerald);
        }

        .ico-amber {
            background: var(--amber-bg);
            color: var(--amber);
        }

        .ico-rose {
            background: var(--rose-bg);
            color: var(--rose);
        }

        .ico-violet {
            background: var(--violet-bg);
            color: var(--violet);
        }

        .kpi-label {
            font-size: 15px;
            font-weight: 700;
            color: var(--ink-4);
            letter-spacing: .04em;
            text-transform: uppercase;
            margin-bottom: 3px;
        }

        .kpi-val {
            font-size: 20px;
            font-weight: 700;
            color: var(--ink);
            line-height: 1;
        }

        .archive-portal-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            box-shadow: var(--sh-sm);
            margin-bottom: 22px;
            overflow: hidden;
            display: grid;
            grid-template-columns: 1fr auto;
            align-items: center;
            gap: 14px;
            padding: 20px;
            text-decoration: none;
            color: inherit;
            transition: transform .18s var(--ease), box-shadow .18s, border-color .18s;
        }

            .archive-portal-card:hover {
                color: inherit;
                transform: translateY(-3px);
                box-shadow: var(--sh-md);
                border-color: #E0B463;
            }

        .archive-portal-main {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
        }

        .archive-portal-icon {
            width: 52px;
            height: 52px;
            border-radius: var(--r-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--amber-bg);
            color: var(--amber);
            font-size: 23px;
            flex-shrink: 0;
        }

        .archive-portal-title {
            font-size: 18px;
            font-weight: 800;
            color: var(--ink);
            margin-bottom: 3px;
        }

        .archive-portal-sub {
            font-size: 14px;
            color: var(--ink-4);
            line-height: 1.55;
        }

        .archive-portal-meta {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .archive-portal-count {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 30px;
            background: var(--amber-bg);
            color: var(--amber);
            padding: 7px 12px;
            font-size: 14px;
            font-weight: 800;
        }

        .archive-portal-open {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border-radius: var(--r-md);
            background: var(--ink);
            color: #fff;
            padding: 10px 14px;
            font-size: 14px;
            font-weight: 800;
        }

        .archive-manager {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            margin-bottom: 22px;
            box-shadow: var(--sh-xs);
            padding: 0 !important;
            overflow: hidden;
        }

        .archive-manager-toggle {
            width: 100%;
            border: none;
            background: var(--surface);
            padding: 18px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            text-align: right;
            transition: background .15s var(--ease);
        }

            .archive-manager-toggle:hover {
                background: var(--surface-2);
            }

        .archive-manager-toggle-main {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .archive-manager-toggle-icon {
            width: 38px;
            height: 38px;
            border-radius: var(--r-md);
            background: var(--amber-bg);
            color: var(--amber);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }

        .archive-manager-toggle-text {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .archive-manager-title {
            font-size: 16px;
            font-weight: 800;
            color: var(--ink);
        }

        .archive-manager-subtitle {
            font-size: 13px;
            font-weight: 600;
            color: var(--ink-4);
        }

        .archive-manager-toggle-left {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .archive-manager-chevron {
            width: 34px;
            height: 34px;
            border-radius: var(--r-sm);
            background: var(--surface-3);
            color: var(--ink-3);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: transform .2s var(--ease), background .15s;
        }

        .archive-manager.is-open .archive-manager-chevron {
            transform: rotate(180deg);
            background: var(--amber-bg);
            color: var(--amber);
        }

        .archive-manager-body {
            display: none;
            padding: 0 18px 18px;
            border-top: 1px solid var(--surface-3);
        }

        .archive-manager.is-open .archive-manager-body {
            display: block;
        }

        .archive-manager-body-inner {
            padding-top: 16px;
        }

        .archive-manager-grid {
            display: grid;
            grid-template-columns: minmax(240px,1fr) auto;
            gap: 14px;
            align-items: end;
        }

        .archive-batches {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px,1fr));
            gap: 8px;
            max-height: 170px;
            overflow-y: auto;
            padding: 10px;
            background: var(--surface-2);
            border: 1px solid var(--border);
            border-radius: var(--r-md);
        }

        .archive-batch-check {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 14px;
            color: var(--ink-2);
        }

            .archive-batch-check input {
                accent-color: var(--amber);
            }

        .archive-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .archive-submit {
            border: none;
            border-radius: var(--r-md);
            padding: 10px 16px;
            font-size: 15px;
            font-weight: 700;
            color: #fff;
            background: var(--ink);
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            white-space: nowrap;
        }

        .att-count-badge {
            font-size: 14px;
            color: var(--ink-4);
        }

            .att-count-badge strong {
                color: var(--amber);
                font-weight: 700;
            }

        .placement-batches-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            overflow: visible;
            box-shadow: var(--sh-sm);
            margin-bottom: 24px;
        }

        .placement-batches-topbar {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 14px 18px;
            border-bottom: 1px solid var(--surface-3);
            flex-wrap: wrap;
        }

        .table-section-title {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 18px;
            font-weight: 800;
            color: var(--ink);
            margin-left: 10px;
        }

            .table-section-title i {
                color: var(--blue);
            }

        .placement-search-wrap {
            position: relative;
            flex: 1;
            min-width: 220px;
            max-width: 390px;
        }

            .placement-search-wrap i {
                position: absolute;
                right: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--ink-4);
                font-size: 17px;
                pointer-events: none;
            }

            .placement-search-wrap input {
                width: 100%;
                padding: 7px 32px 7px 12px;
                border: 1px solid var(--border);
                border-radius: var(--r-md);
                font-size: 18px;
                background: var(--surface-2);
                color: var(--ink);
                transition: border-color .15s, box-shadow .15s;
            }

                .placement-search-wrap input:focus {
                    outline: none;
                    border-color: var(--blue-2);
                    box-shadow: 0 0 0 3px rgba(36,113,208,.1);
                    background: var(--surface);
                }

        .placement-count-badge {
            margin-right: auto;
            font-size: 16px;
            color: var(--ink-4);
        }

            .placement-count-badge strong {
                color: var(--blue);
                font-weight: 700;
            }

        .batches-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
            padding: 18px;
        }

        @@media (max-width: 1200px) {
            .batches-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 768px) {
            .batches-grid {
                grid-template-columns: 1fr;
                padding: 14px;
            }
        }

        .batch-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            box-shadow: var(--sh-xs);
            transition: transform .18s var(--ease), box-shadow .18s, border-color .18s;
            overflow: hidden;
            position: relative;
        }

            .batch-card::before {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 5px;
                height: 100%;
                background: var(--blue);
            }

            .batch-card:hover {
                transform: translateY(-4px);
                box-shadow: var(--sh-md);
                border-color: #B6D3F4;
            }

            .batch-card.no-exams::before {
                background: var(--rose);
            }

        .batch-card-body {
            padding: 18px 18px 16px;
        }

        .batch-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 16px;
        }

        .batch-title-wrap {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            min-width: 0;
        }

        .batch-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: var(--blue-bg);
            color: var(--blue);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
            flex-shrink: 0;
        }

        .batch-title {
            font-size: 18px;
            font-weight: 800;
            color: var(--ink);
            margin-bottom: 3px;
            line-height: 1.45;
        }

        .batch-sub {
            font-size: 15px;
            color: var(--ink-4);
            line-height: 1.5;
        }

        .exam-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 11px;
            border-radius: 30px;
            font-size: 16px;
            font-weight: 700;
            white-space: nowrap;
            background: var(--blue-bg);
            color: var(--blue);
        }

            .exam-pill.zero {
                background: var(--rose-bg);
                color: var(--rose);
            }

        .batch-mini-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-bottom: 16px;
        }

        .batch-mini-stat {
            background: var(--surface-2);
            border: 1px solid var(--surface-3);
            border-radius: var(--r-md);
            padding: 10px 8px;
            text-align: center;
        }

        .mini-val {
            display: block;
            font-size: 19px;
            font-weight: 800;
            color: var(--ink);
            line-height: 1.1;
        }

        .mini-label {
            display: block;
            font-size: 14px;
            color: var(--ink-4);
            margin-top: 3px;
        }

        .text-emerald {
            color: var(--emerald) !important;
        }

        .text-rose {
            color: var(--rose) !important;
        }

        .text-violet {
            color: var(--violet) !important;
        }

        .placement-progress-wrap {
            margin-bottom: 14px;
        }

        .placement-progress-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            font-size: 15px;
            color: var(--ink-4);
            margin-bottom: 6px;
        }

            .placement-progress-meta strong {
                color: var(--ink);
                font-size: 16px;
            }

        .placement-progress {
            width: 100%;
            height: 9px;
            border-radius: 30px;
            background: var(--surface-3);
            overflow: hidden;
        }

        .placement-progress-bar {
            height: 100%;
            background: var(--blue);
            border-radius: 30px;
            transition: width .3s ease;
        }

        .batch-foot-stats {
            display: flex;
            justify-content: space-between;
            gap: 8px;
            color: var(--ink-4);
            font-size: 15px;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }

            .batch-foot-stats span {
                display: inline-flex;
                align-items: center;
                gap: 5px;
            }

        .batch-open-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            width: 100%;
            background: var(--blue);
            color: #fff;
            border: none;
            border-radius: var(--r-md);
            padding: 10px 14px;
            font-size: 18px;
            font-weight: 700;
            text-decoration: none;
            transition: background .16s var(--ease), transform .14s, box-shadow .16s;
            box-shadow: 0 3px 10px rgba(27,94,174,.20);
        }

            .batch-open-btn:hover {
                color: #fff;
                background: var(--blue-dark);
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(27,94,174,.28);
            }

            .batch-open-btn.empty {
                background: var(--violet);
                box-shadow: 0 3px 10px rgba(85,53,181,.20);
            }

                .batch-open-btn.empty:hover {
                    background: #3f2690;
                    color: #fff;
                }

        .placement-empty {
            text-align: center;
            padding: 56px 16px;
            color: var(--ink-4);
        }

            .placement-empty i {
                font-size: 20px;
                display: block;
                margin-bottom: 12px;
                color: var(--ink-5);
            }

        .placement-empty-title {
            font-size: 18px;
            font-weight: 600;
            color: var(--ink-3);
        }

        .placement-empty-sub {
            font-size: 16px;
            margin-top: 4px;
        }

        @@media (max-width: 768px) {
            .placement-page {
                padding: 22px 14px 48px;
            }

            .placement-topbar {
                align-items: stretch;
            }

            .top-actions {
                width: 100%;
            }

            .btn-main-action {
                width: 100%;
            }

            .archive-portal-card {
                grid-template-columns: 1fr;
            }

            .archive-portal-meta {
                justify-content: flex-start;
            }

            .archive-manager-grid {
                grid-template-columns: 1fr;
            }

            .archive-manager-toggle {
                align-items: flex-start;
            }

            .archive-manager-toggle-left {
                width: 100%;
                justify-content: space-between;
            }

            .placement-batches-topbar {
                align-items: stretch;
            }

            .placement-search-wrap {
                max-width: 100%;
                width: 100%;
            }

            .placement-count-badge {
                margin-right: 0;
            }
        }
    </style>
}

<div class="placement-page">

    @if (TempData["Success"] != null)
    {
        <div class="placement-alert placement-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="placement-alert placement-alert-danger">
            <i class="bi bi-exclamation-circle-fill"></i>
            @TempData["Error"]
        </div>
    }

    <div class="placement-topbar">
        <div class="placement-brand">
            <div class="placement-brand-icon">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <div>
                <div class="placement-brand-title">إدارة اختبارات تحديد المستوى</div>
                <div class="placement-brand-sub">
                    اختر الدفعة أولًا، ثم انتقل إلى اختباراتها لمراجعة الإرسال والمتابعة.
                </div>
            </div>
        </div>

        <div class="top-actions">
            <a asp-action="CreateAdvanced" class="btn-main-action">
                <i class="bi bi-plus-circle"></i>
                إنشاء اختبار جديد
            </a>

            <a asp-action="CreateFromProfessionalModel" class="btn-main-action model-action">
                <i class="bi bi-layers"></i>
                إنشاء اختبار من نموذج
            </a>
        </div>
    </div>

    <div class="placement-kpis">

        <div class="kpi-card kpi-blue">
            <div class="kpi-ico ico-blue">
                <i class="bi bi-collection"></i>
            </div>
            <div>
                <div class="kpi-label">الدفعات</div>
                <div class="kpi-val">@totalBatches</div>
            </div>
        </div>

        <div class="kpi-card kpi-emerald">
            <div class="kpi-ico ico-emerald">
                <i class="bi bi-ui-checks-grid"></i>
            </div>
            <div>
                <div class="kpi-label">إجمالي الاختبارات</div>
                <div class="kpi-val">@totalExams</div>
            </div>
        </div>

        <div class="kpi-card kpi-amber">
            <div class="kpi-ico ico-amber">
                <i class="bi bi-activity"></i>
            </div>
            <div>
                <div class="kpi-label">دفعات نشطة</div>
                <div class="kpi-val">@activeBatches</div>
            </div>
        </div>

        <div class="kpi-card kpi-rose">
            <div class="kpi-ico ico-rose">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <div>
                <div class="kpi-label">بدون اختبارات</div>
                <div class="kpi-val">@emptyBatches</div>
            </div>
        </div>

        <div class="kpi-card kpi-violet">
            <div class="kpi-ico ico-violet">
                <i class="bi bi-clock-history"></i>
            </div>
            <div>
                <div class="kpi-label">آخر إرسال</div>
                <div class="kpi-val">@(lastExamDate.HasValue? lastExamDate.Value.ToString("yyyy/MM/dd") : "—")</div>
            </div>
        </div>

    </div>

    @if (canArchive)
    {
        <a asp-area="Admin" asp-controller="PlacementExams" asp-action="ArchivedPlacementExams" class="archive-portal-card">
            <div class="archive-portal-main">
                <div class="archive-portal-icon">
                    <i class="bi bi-archive-fill"></i>
                </div>
                <div>
                    <div class="archive-portal-title">أرشيف اختبارات تحديد المستوى</div>
                    <div class="archive-portal-sub">
                        عرض الدفعات المؤرشفة والاطلاع على اختباراتها كبيانات قراءة فقط دون تعديل على الإرسال.
                    </div>
                </div>
            </div>

            <div class="archive-portal-meta">
                <span class="archive-portal-count">
                    <i class="bi bi-folder2"></i>
                    @archivedCount دفعة
                </span>
                <span class="archive-portal-open">
                    عرض الأرشيف
                    <i class="bi bi-arrow-left"></i>
                </span>
            </div>
        </a>
    }

    @if (canArchive)
    {
    <div class="archive-manager" id="archiveManagerSection">
        <button type="button"
                class="archive-manager-toggle"
                id="archiveManagerToggle"
                aria-expanded="false"
                aria-controls="archiveManagerBody">

            <div class="archive-manager-toggle-main">
                <span class="archive-manager-toggle-icon">
                    <i class="bi bi-archive-fill"></i>
                </span>

                <span class="archive-manager-toggle-text">
                    <span class="archive-manager-title">إدارة الأرشيف حسب الدفعات</span>
                    <span class="archive-manager-subtitle">اضغط لعرض الدفعات وخيارات أرشفة اختبارات تحديد المستوى</span>
                </span>
            </div>

            <div class="archive-manager-toggle-left">
                <span class="att-count-badge">
                    في الأرشيف:
                    <strong>@archivedCount</strong>
                    دفعة
                </span>

                <span class="archive-manager-chevron">
                    <i class="bi bi-chevron-down"></i>
                </span>
            </div>
        </button>

        <div class="archive-manager-body" id="archiveManagerBody">
            <div class="archive-manager-body-inner">
                <form asp-area="Admin" asp-controller="PlacementExams" asp-action="ArchiveBatches" method="post">
                    @Html.AntiForgeryToken()

                    <div class="archive-manager-grid">
                        <div class="archive-batches">
                            @if (Model?.AllBatchesForArchive?.Any() == true)
                            {
                                foreach (var batch in Model.AllBatchesForArchive)
                                {
                                    <label class="archive-batch-check">
                                        <input type="checkbox" name="selectedBatchIds" value="@batch.Value" />
                                        <span>@batch.Text</span>
                                    </label>
                                }
                            }
                            else
                            {
                                <span style="color:var(--ink-4);font-size:14px">
                                    لا توجد دفعات متاحة للأرشفة حاليًا.
                                </span>
                            }
                        </div>

                        <div class="archive-actions">
                            <button type="submit"
                                    class="archive-submit"
                                    onclick="return confirm('سيتم أرشفة اختبارات تحديد المستوى للدفعات المحددة. هل تريد المتابعة؟')">
                                <i class="bi bi-box-arrow-in-down"></i>
                                أرشفة المحدد
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    }

    <div class="placement-batches-card">

        <div class="placement-batches-topbar">
            <div class="table-section-title">
                <i class="bi bi-grid-3x3-gap-fill"></i>
                دفعات اختبارات تحديد المستوى
            </div>

            <div class="placement-search-wrap">
                <i class="bi bi-search"></i>
                <input type="text"
                       id="placementBatchSearch"
                       placeholder="ابحث في اسم الدفعة أو عدد الاختبارات أو آخر إرسال..." />
            </div>

            <div class="placement-count-badge">
                إجمالي:
                <strong>@totalBatches</strong>
                دفعة
            </div>
        </div>

        @if (!batchesList.Any())
        {
            <div class="placement-empty">
                <i class="bi bi-inbox"></i>
                <div class="placement-empty-title">لا توجد دفعات لديها اختبارات تحديد مستوى</div>
                <div class="placement-empty-sub">يمكنك إنشاء اختبار جديد من أعلى الصفحة، وستظهر الدفعات هنا بعد الإرسال.</div>
            </div>
        }
        else
        {
            <div class="batches-grid" id="placementBatchesGrid">
                @foreach (var b in batchesList)
                {
                    var hasExams = b.ExamsCount > 0;
                    var examPercent = totalExams > 0
                    ? Math.Round((b.ExamsCount / (double)totalExams) * 100, 0)
                    : 0;

                    var lastExamText = b.LastExamDate.ToString("yyyy/MM/dd HH:mm");
                    var cardSearch = $"{b.BatchName} {b.ExamsCount} {lastExamText}".ToLower();

                    <div class="batch-card @(hasExams ? "" : "no-exams")"
                         data-search="@cardSearch">

                        <div class="batch-card-body">

                            <div class="batch-head">
                                <div class="batch-title-wrap">
                                    <div class="batch-avatar">
                                        <i class="bi bi-people-fill"></i>
                                    </div>

                                    <div>
                                        <div class="batch-title">@b.BatchName</div>
                                        <div class="batch-sub">
                                            آخر إرسال:
                                            @lastExamText
                                        </div>
                                    </div>
                                </div>

                                <span class="exam-pill @(hasExams ? "" : "zero")">
                                    <i class="bi bi-ui-checks"></i>
                                    @b.ExamsCount اختبار
                                </span>
                            </div>

                            <div class="batch-mini-grid">
                                <div class="batch-mini-stat">
                                    <span class="mini-val">@b.ExamsCount</span>
                                    <span class="mini-label">اختبار</span>
                                </div>

                                <div class="batch-mini-stat">
                                    <span class="mini-val @(hasExams ? "text-emerald" : "text-rose")">
                                        @(hasExams ? "نشطة" : "فارغة")
                                    </span>
                                    <span class="mini-label">الحالة</span>
                                </div>

                                <div class="batch-mini-stat">
                                    <span class="mini-val text-violet">@examPercent%</span>
                                    <span class="mini-label">من الإجمالي</span>
                                </div>
                            </div>

                            <div class="placement-progress-wrap">
                                <div class="placement-progress-meta">
                                    <span>نسبة اختبارات الدفعة من الإجمالي</span>
                                    <strong>@examPercent%</strong>
                                </div>

                                <div class="placement-progress">
                                    <div class="placement-progress-bar" style="width:@examPercent%;"></div>
                                </div>
                            </div>

                            <div class="batch-foot-stats">
                                <span>
                                    <i class="bi bi-calendar-event"></i>
                                    @lastExamText
                                </span>

                                <span>
                                    <i class="bi bi-bar-chart"></i>
                                    @b.ExamsCount اختبار مسجل
                                </span>
                            </div>

                            <a asp-action="BatchExams"
                               asp-route-batchId="@b.BatchId"
                               class="batch-open-btn @(hasExams ? "" : "empty")">
                                <i class="bi bi-list-task"></i>
                                فتح اختبارات الدفعة
                            </a>

                        </div>
                    </div>
                }
            </div>
        }

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const archiveSection = document.getElementById("archiveManagerSection");
            const archiveToggle = document.getElementById("archiveManagerToggle");

            if (archiveSection && archiveToggle) {
                archiveToggle.addEventListener("click", function () {
                    const isOpen = archiveSection.classList.contains("is-open");

                    archiveSection.classList.toggle("is-open", !isOpen);
                    archiveToggle.setAttribute("aria-expanded", (!isOpen).toString());
                });
            }

            const searchInput = document.getElementById("placementBatchSearch");
            const cards = Array.from(document.querySelectorAll("#placementBatchesGrid .batch-card"));

            if (searchInput) {
                searchInput.addEventListener("input", function () {
                    const value = (this.value || "").toLowerCase().trim();

                    cards.forEach(function (card) {
                        const text = card.getAttribute("data-search") || "";
                        card.style.display = text.includes(value) ? "" : "none";
                    });
                });
            }

        });
    </script>
}