@model QdratNew.ViewModels.Reports.BatchLessonQuestionsReportViewModel
@using QdratNew.Enums
@{
    ViewData["Title"] = "تقرير أسئلة المؤشر";
    var overallPct = Math.Round(Model.OverallPercent, 1);

    string FmtTime(double s)
    {
        if (s <= 0) return "—";
        if (s < 60) return $"{(int)s} ث";
        return $"{(int)s / 60}:{(int)s % 60:D2} د";
    }
}

<style>
    :root {
        --q-primary:    #4f46e5;
        --q-primary-lt: #ede9fe;
        --q-success:    #16a34a;
        --q-success-lt: #dcfce7;
        --q-danger:     #dc2626;
        --q-danger-lt:  #fee2e2;
        --q-warning:    #d97706;
        --q-warning-lt: #fef3c7;
        --q-info:       #0891b2;
        --q-info-lt:    #cffafe;
        --q-skip:       #6b7280;
        --q-skip-lt:    #f3f4f6;
        --q-surface:    #ffffff;
        --q-bg:         #f5f3ff;
        --q-border:     #e5e7eb;
        --q-text:       #1e1b4b;
        --q-muted:      #6b7280;
        --q-radius:     16px;
        --q-shadow:     0 2px 12px rgba(79,70,229,.08);
        --q-shadow-lg:  0 6px 32px rgba(79,70,229,.13);
    }

    /* ── Page ── */
    .qlb-page {
        direction: rtl;
        font-family: 'Cairo', 'Tajawal', 'Segoe UI', sans-serif;
        background: var(--q-bg);
        padding: 2rem 1rem 4rem;
    }

    /* ── Hero ── */
    .qlb-hero {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 55%, #a855f7 100%);
        border-radius: var(--q-radius);
        padding: 2.2rem 2rem;
        color: #fff;
        margin-bottom: 2rem;
        box-shadow: var(--q-shadow-lg);
        position: relative;
        overflow: hidden;
    }
    .qlb-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 85% 50%, rgba(255,255,255,.08) 0%, transparent 60%);
        pointer-events: none;
    }
    .qlb-hero-icon {
        width: 56px; height: 56px;
        background: rgba(255,255,255,.18);
        border: 1px solid rgba(255,255,255,.25);
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.6rem;
        margin-bottom: .8rem;
    }
    .qlb-hero h1 {
        font-size: clamp(1.2rem, 2.8vw, 1.75rem);
        font-weight: 800; margin: 0 0 .4rem; line-height: 1.3;
    }
    .qlb-hero-meta {
        display: flex; flex-wrap: wrap; gap: .6rem; margin-top: .8rem;
    }
    .qlb-hero-pill {
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.22);
        border-radius: 8px;
        padding: .28rem .85rem; font-size: .82rem;
    }
    .qlb-hero-pill i { margin-left: .4rem; opacity: .8; }

    /* ── Stats Row ── */
    .qlb-stats {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 1rem; margin-bottom: 2rem;
    }
    @@media (max-width:767px) { .qlb-stats { grid-template-columns: repeat(2,1fr); } }

    .qlb-stat {
        background: var(--q-surface);
        border-radius: var(--q-radius);
        padding: 1.2rem 1rem;
        box-shadow: var(--q-shadow);
        border: 1px solid var(--q-border);
        display: flex; align-items: center; gap: .9rem;
        transition: transform .2s, box-shadow .2s;
    }
    .qlb-stat:hover { transform: translateY(-2px); box-shadow: var(--q-shadow-lg); }
    .qlb-stat-ico {
        width: 48px; height: 48px; border-radius: 12px; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center; font-size: 1.3rem;
    }
    .ico-blue   { background: var(--q-primary-lt); color: var(--q-primary); }
    .ico-green  { background: var(--q-success-lt); color: var(--q-success); }
    .ico-red    { background: var(--q-danger-lt);  color: var(--q-danger);  }
    .ico-amber  { background: var(--q-warning-lt); color: var(--q-warning); }
    .qlb-stat-lbl { font-size: .75rem; color: var(--q-muted); font-weight: 600; margin-bottom: .2rem; }
    .qlb-stat-val { font-size: 1.75rem; font-weight: 800; color: var(--q-text); line-height: 1; }
    .qlb-stat-bar { height: 4px; background: var(--q-border); border-radius: 99px; margin-top: .5rem; overflow: hidden; }
    .qlb-stat-fill { height: 100%; border-radius: 99px; transition: width .8s ease; }
    .fill-g { background: var(--q-success); }
    .fill-r { background: var(--q-danger);  }
    .fill-a { background: var(--q-warning); }

    /* ── Questions Grid ── */
    .qlb-grid {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 1.5rem;
    }
    @@media (max-width: 900px) { .qlb-grid { grid-template-columns: 1fr; } }

    /* ── Question Card ── */
    .qlb-card {
        background: var(--q-surface);
        border-radius: var(--q-radius);
        box-shadow: var(--q-shadow);
        border: 1px solid var(--q-border);
        overflow: hidden;
        display: flex; flex-direction: column;
        transition: box-shadow .2s;
    }
    .qlb-card:hover { box-shadow: var(--q-shadow-lg); }

    /* Card Header */
    .qlb-card-head {
        background: linear-gradient(90deg, var(--q-primary-lt), #f5f3ff);
        border-bottom: 1px solid var(--q-border);
        padding: .85rem 1.1rem;
        display: flex; align-items: center; gap: .6rem; flex-wrap: wrap;
    }
    .qlb-qnum {
        width: 32px; height: 32px; border-radius: 8px;
        background: var(--q-primary); color: #fff;
        display: flex; align-items: center; justify-content: center;
        font-size: .8rem; font-weight: 800; flex-shrink: 0;
    }
    .qlb-pct-badge {
        font-size: .78rem; font-weight: 700;
        padding: .2rem .65rem; border-radius: 99px;
    }
    .pct-good  { background: var(--q-success-lt); color: var(--q-success); }
    .pct-mid   { background: var(--q-warning-lt); color: var(--q-warning); }
    .pct-bad   { background: var(--q-danger-lt);  color: var(--q-danger);  }
    .qlb-time-chip {
        display: inline-flex; align-items: center; gap: .3rem;
        font-size: .75rem; color: var(--q-muted); font-weight: 600;
        margin-right: auto;
    }
    .qlb-time-chip i { font-size: .7rem; }

    /* Card Body */
    .qlb-card-body { padding: 1.1rem; flex: 1; display: flex; flex-direction: column; gap: .9rem; }

    /* Passage Block */
    .qlb-passage {
        background: #fafaf5;
        border: 1px solid #e8e4cf;
        border-radius: 10px;
        padding: .85rem 1rem;
        border-right: 4px solid var(--q-warning);
    }
    .qlb-passage-title {
        font-size: .78rem; font-weight: 700; color: var(--q-warning);
        margin-bottom: .5rem; display: flex; align-items: center; gap: .4rem;
    }
    .qlb-passage-text {
        font-size: .85rem; color: #374151; line-height: 1.7;
        max-height: 120px; overflow-y: auto;
    }
    .qlb-passage-text::-webkit-scrollbar { width: 4px; }
    .qlb-passage-text::-webkit-scrollbar-thumb { background: #d1c89a; border-radius: 99px; }

    /* Audio Player */
    .qlb-audio-wrap {
        background: #f0f9ff;
        border: 1px solid #bae6fd;
        border-radius: 10px;
        padding: .7rem 1rem;
        border-right: 4px solid var(--q-info);
    }
    .qlb-audio-label {
        font-size: .75rem; font-weight: 700; color: var(--q-info);
        margin-bottom: .4rem; display: flex; align-items: center; gap: .35rem;
    }
    .qlb-audio-wrap audio {
        width: 100%; height: 36px; border-radius: 8px; outline: none;
    }

    /* Comparison */
    .qlb-compare {
        display: grid; grid-template-columns: 1fr auto 1fr; gap: .5rem;
        align-items: center;
    }
    .qlb-cmp-box {
        background: var(--q-primary-lt);
        border: 1px solid #c4b5fd;
        border-radius: 10px;
        padding: .65rem .85rem;
        text-align: center; font-size: .88rem;
        font-weight: 600; color: var(--q-primary);
        min-height: 52px; display: flex; align-items: center; justify-content: center;
    }
    .qlb-cmp-vs {
        font-size: .72rem; font-weight: 800; color: var(--q-muted);
        background: var(--q-border); border-radius: 99px;
        padding: .15rem .5rem; white-space: nowrap;
    }

    /* Question Image */
    .qlb-qimg {
        border-radius: 10px; overflow: hidden;
        border: 1px solid var(--q-border); text-align: center;
    }
    .qlb-qimg img {
        max-width: 100%; max-height: 180px; object-fit: contain;
        display: block; margin: 0 auto;
    }

    /* Question Text */
    .qlb-qtitle {
        font-size: .92rem; color: var(--q-text); line-height: 1.65;
        font-weight: 500;
    }
    .qlb-qtitle img { max-height: 60px; border-radius: 6px; vertical-align: middle; }
    .qlb-qtitle p { margin: 0; }

    /* Options Grid */
    .qlb-options { display: flex; flex-direction: column; gap: .5rem; }

    .qlb-opt {
        border-radius: 10px;
        border: 1.5px solid var(--q-border);
        padding: .6rem .85rem;
        display: flex; align-items: center; gap: .6rem;
        font-size: .85rem;
        transition: border-color .15s, background .15s;
        background: #fff;
    }
    /* Correct answer */
    .qlb-opt.opt-correct {
        border-color: var(--q-success);
        background: var(--q-success-lt);
    }
    /* Wrong (has selections but not correct) */
    .qlb-opt.opt-wrong {
        border-color: var(--q-danger);
        background: var(--q-danger-lt);
    }
    /* Skipped / not chosen */
    .qlb-opt.opt-skip {
        border-color: var(--q-border);
        background: var(--q-skip-lt);
        opacity: .75;
    }

    .qlb-opt-label {
        width: 26px; height: 26px; border-radius: 6px; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        font-size: .78rem; font-weight: 800;
    }
    .opt-correct .qlb-opt-label { background: var(--q-success); color: #fff; }
    .opt-wrong   .qlb-opt-label { background: var(--q-danger);  color: #fff; }
    .opt-skip    .qlb-opt-label { background: #d1d5db; color: #fff; }

    .qlb-opt-icon {
        font-size: .8rem; flex-shrink: 0; margin-right: auto;
    }
    .opt-correct .qlb-opt-icon { color: var(--q-success); }
    .opt-wrong   .qlb-opt-icon { color: var(--q-danger);  }
    .opt-skip    .qlb-opt-icon { color: #9ca3af; }

    .qlb-opt-content { flex: 1; min-width: 0; }
    .qlb-opt-text { line-height: 1.4; color: var(--q-text); }
    .qlb-opt-text img { max-height: 50px; border-radius: 6px; vertical-align: middle; }
    .qlb-opt-text p { margin: 0; }

    .qlb-opt-bar-wrap { margin-top: .3rem; display: flex; align-items: center; gap: .4rem; }
    .qlb-opt-bar { flex: 1; height: 4px; background: rgba(0,0,0,.08); border-radius: 99px; overflow: hidden; }
    .qlb-opt-bar-fill { height: 100%; border-radius: 99px; }
    .opt-correct .qlb-opt-bar-fill { background: var(--q-success); }
    .opt-wrong   .qlb-opt-bar-fill { background: var(--q-danger); }
    .opt-skip    .qlb-opt-bar-fill { background: #9ca3af; }
    .qlb-opt-cnt { font-size: .72rem; color: var(--q-muted); font-weight: 600; white-space: nowrap; }

    /* Card Footer */
    .qlb-card-foot {
        background: #fafafa;
        border-top: 1px solid var(--q-border);
        padding: .65rem 1.1rem;
        display: flex; align-items: center; gap: .5rem; flex-wrap: wrap;
    }
    .qlb-foot-chip {
        display: inline-flex; align-items: center; gap: .3rem;
        font-size: .76rem; font-weight: 700;
        padding: .18rem .6rem; border-radius: 99px;
    }
    .fc-g { background: var(--q-success-lt); color: var(--q-success); }
    .fc-r { background: var(--q-danger-lt);  color: var(--q-danger);  }
    .fc-s { background: var(--q-skip-lt);    color: var(--q-skip);    border: 1px solid var(--q-border); }
    .fc-t { background: var(--q-info-lt);    color: var(--q-info);    }
    .fc-tm { background: var(--q-warning-lt); color: var(--q-warning); margin-right: auto; }

    /* Dark mode */
    @@media (prefers-color-scheme: dark) {
        :root {
            --q-surface: #1e1b2e; --q-bg: #13111f;
            --q-border: #2e2a45; --q-text: #e9e5ff;
            --q-muted: #9492a8; --q-skip-lt: #1f1d30;
        }
        .qlb-card-head  { background: linear-gradient(90deg, #1a1730, #1e1b2e); }
        .qlb-card-foot  { background: #1a1730; }
        .qlb-opt        { background: #1e1b2e; }
        .qlb-opt.opt-correct { background: #052e16; }
        .qlb-opt.opt-wrong   { background: #450a0a; }
        .qlb-opt.opt-skip    { background: #1f1d30; }
        .qlb-passage    { background: #1c1a10; border-color: #3b2d10; }
        .qlb-audio-wrap { background: #0a1929; border-color: #1e3a5f; }
        .qlb-qimg       { background: #1a1730; }
        #questionPreviewModal .modal-body { background: #1a1730; }
    }

    @@media (max-width: 480px) {
        .qlb-compare { grid-template-columns: 1fr; gap: .3rem; }
        .qlb-cmp-vs  { display: none; }
    }
</style>

<div class="qlb-page" dir="rtl">

    <!-- ══ Hero ══ -->
    <div class="qlb-hero">
        <div class="qlb-hero-icon"><i class="fas fa-puzzle-piece"></i></div>
        <h1>تقرير أسئلة المؤشر: @Model.LessonTitle</h1>
        <div class="qlb-hero-meta">
            <span class="qlb-hero-pill"><i class="fas fa-layer-group"></i>@Model.SectionTitle</span>
            <span class="qlb-hero-pill"><i class="fas fa-clipboard-list"></i>@Model.ExamTitle</span>
        </div>
    </div>

    <!-- ══ Stats ══ -->
    <div class="qlb-stats">
        <div class="qlb-stat">
            <div class="qlb-stat-ico ico-blue"><i class="fas fa-question-circle"></i></div>
            <div>
                <div class="qlb-stat-lbl">إجمالي الأسئلة</div>
                <div class="qlb-stat-val">@Model.TotalQuestions</div>
            </div>
        </div>
        <div class="qlb-stat">
            <div class="qlb-stat-ico ico-green"><i class="fas fa-check-circle"></i></div>
            <div style="flex:1">
                <div class="qlb-stat-lbl">إجابات صحيحة</div>
                <div class="qlb-stat-val" style="color:var(--q-success)">@Model.TotalCorrect</div>
                @{ var cp = Model.TotalCorrect + Model.TotalWrong > 0 ? Math.Round(Model.TotalCorrect * 100.0 / (Model.TotalCorrect + Model.TotalWrong), 0) : 0; }
                <div class="qlb-stat-bar"><div class="qlb-stat-fill fill-g" style="width:@cp%"></div></div>
            </div>
        </div>
        <div class="qlb-stat">
            <div class="qlb-stat-ico ico-red"><i class="fas fa-times-circle"></i></div>
            <div style="flex:1">
                <div class="qlb-stat-lbl">إجابات خاطئة</div>
                <div class="qlb-stat-val" style="color:var(--q-danger)">@Model.TotalWrong</div>
                @{ var wp = Model.TotalCorrect + Model.TotalWrong > 0 ? Math.Round(Model.TotalWrong * 100.0 / (Model.TotalCorrect + Model.TotalWrong), 0) : 0; }
                <div class="qlb-stat-bar"><div class="qlb-stat-fill fill-r" style="width:@wp%"></div></div>
            </div>
        </div>
        <div class="qlb-stat">
            <div class="qlb-stat-ico ico-amber"><i class="fas fa-chart-pie"></i></div>
            <div style="flex:1">
                <div class="qlb-stat-lbl">النسبة العامة</div>
                <div class="qlb-stat-val" style="color:var(--q-warning)">@overallPct%</div>
                <div class="qlb-stat-bar"><div class="qlb-stat-fill fill-a" style="width:@(Math.Min(overallPct,100))%"></div></div>
            </div>
        </div>
    </div>

    <!-- ══ Questions Grid ══ -->
    <div class="qlb-grid">
        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];
            var qPct   = Math.Round(q.Percent, 1);
            var pctCls = qPct >= 70 ? "pct-good" : qPct >= 40 ? "pct-mid" : "pct-bad";
            var isCompare = q.Template == QuestionTemplate.CompareValues || q.Template == QuestionTemplate.CompareWithImage;
            var hasImg = !string.IsNullOrWhiteSpace(q.ImageUrl);

            <div class="qlb-card">

                <!-- Card Header -->
                <div class="qlb-card-head">
                    <div class="qlb-qnum">@(i + 1)</div>
                    <span class="qlb-pct-badge @pctCls">
                        <i class="fas fa-chart-bar"></i> @qPct%
                    </span>
                    @if (q.TotalAnswers > 0)
                    {
                        <span class="qlb-time-chip">
                            <i class="fas fa-clock"></i>
                            متوسط: @FmtTime(q.AvgTimeTakenSeconds)
                        </span>
                    }
                </div>

                <!-- Card Body -->
                <div class="qlb-card-body">

                    <!-- Verbal Passage -->
                    @if (q.HasVerbalPassage)
                    {
                        if (q.VerbalPassageType == PassageType.Audio && !string.IsNullOrWhiteSpace(q.VerbalPassageMediaUrl))
                        {
                            <div class="qlb-audio-wrap">
                                <div class="qlb-audio-label">
                                    <i class="fas fa-headphones"></i>
                                    @(q.VerbalPassageTitle ?? "قطعة صوتية")
                                </div>
                                <audio controls preload="none">
                                    <source src="@q.VerbalPassageMediaUrl" />
                                    متصفحك لا يدعم تشغيل الصوت.
                                </audio>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(q.VerbalPassageContent))
                        {
                            <div class="qlb-passage">
                                <div class="qlb-passage-title">
                                    <i class="fas fa-book-open"></i>
                                    @(q.VerbalPassageTitle ?? "قطعة لفظية")
                                </div>
                                <div class="qlb-passage-text">
                                    @Html.Raw(q.VerbalPassageContent)
                                </div>
                            </div>
                        }
                    }

                    <!-- Comparison Values -->
                    @if (isCompare && (!string.IsNullOrWhiteSpace(q.ValueA) || !string.IsNullOrWhiteSpace(q.ValueB)))
                    {
                        <div class="qlb-compare">
                            <div class="qlb-cmp-box">@Html.Raw(q.ValueA ?? "—")</div>
                            <span class="qlb-cmp-vs">مقارنة</span>
                            <div class="qlb-cmp-box">@Html.Raw(q.ValueB ?? "—")</div>
                        </div>
                    }

                    <!-- Question Image -->
                    @if (hasImg)
                    {
                        <div class="qlb-qimg">
                            <img src="@q.ImageUrl" alt="صورة السؤال" loading="lazy" />
                        </div>
                    }

                    <!-- Question Text -->
                    @if (!string.IsNullOrWhiteSpace(q.QuestionTitle))
                    {
                        <div class="qlb-qtitle">@Html.Raw(q.QuestionTitle)</div>
                    }

                    <!-- Options -->
                    @if (q.Options.Any())
                    {
                        <div class="qlb-options">
                            @foreach (var opt in q.Options)
                            {
                                var optCls = opt.IsCorrect ? "opt-correct"
                                           : opt.SelectedCount > 0 ? "opt-wrong"
                                           : "opt-skip";
                                var optIcon = opt.IsCorrect ? "fa-check-circle"
                                            : opt.SelectedCount > 0 ? "fa-times-circle"
                                            : "fa-minus-circle";
                                var barPct = Math.Min(opt.SelectionPercent, 100);
                                var hasOptImg = !string.IsNullOrWhiteSpace(opt.ImageUrl);

                                <div class="qlb-opt @optCls">
                                    <div class="qlb-opt-label">@opt.Label</div>
                                    <div class="qlb-opt-content">
                                        @if (hasOptImg)
                                        {
                                            <img src="@opt.ImageUrl" alt="اختيار" style="max-height:50px;border-radius:6px;margin-bottom:.3rem" loading="lazy" />
                                        }
                                        @if (!string.IsNullOrWhiteSpace(opt.Text))
                                        {
                                            <div class="qlb-opt-text">@Html.Raw(opt.Text)</div>
                                        }
                                        <div class="qlb-opt-bar-wrap">
                                            <div class="qlb-opt-bar">
                                                <div class="qlb-opt-bar-fill" style="width:@barPct%"></div>
                                            </div>
                                            <span class="qlb-opt-cnt">@opt.SelectedCount (@opt.SelectionPercent%)</span>
                                        </div>
                                    </div>
                                    <i class="fas @optIcon qlb-opt-icon"></i>
                                </div>
                            }
                        </div>
                    }

                </div><!-- /card-body -->

                <!-- Card Footer -->
                <div class="qlb-card-foot">
                    <span class="qlb-foot-chip fc-g">
                        <i class="fas fa-check"></i> @q.CorrectAnswers صح
                    </span>
                    <span class="qlb-foot-chip fc-r">
                        <i class="fas fa-times"></i> @q.WrongAnswers خطأ
                    </span>
                    <span class="qlb-foot-chip fc-s">
                        <i class="fas fa-forward"></i> @q.SkippedCount تخطى
                    </span>
                    <span class="qlb-foot-chip fc-t">
                        <i class="fas fa-users"></i> @q.TotalAnswers أجاب
                    </span>
                    @if (q.AvgTimeTakenSeconds > 0)
                    {
                        <span class="qlb-foot-chip fc-tm">
                            <i class="fas fa-stopwatch"></i> @FmtTime(q.AvgTimeTakenSeconds)
                        </span>
                    }
                </div>

            </div><!-- /qlb-card -->
        }
    </div><!-- /qlb-grid -->

</div><!-- /qlb-page -->

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}
