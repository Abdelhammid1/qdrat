@model IEnumerable<QdratNew.ViewModels.Exam.PlacementExamListVm>
@using Microsoft.AspNetCore.Authorization
@using QdratNew.Security.AdminPermissions
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "اختبارات الدفعة " + ViewBag.BatchName;

    var examsList = Model?.ToList() ?? new List<QdratNew.ViewModels.Exam.PlacementExamListVm>();

    var totalExams = examsList.Count;
    var activeExams = examsList.Count(x => x.IsActive);
    var hiddenExams = totalExams - activeExams;
    var totalQuestions = examsList.Sum(x => x.TotalQuestions);
    var totalStudents = examsList.Sum(x => x.StudentCount);

    var canCreate      = (await AuthorizationService.AuthorizeAsync(User, AdminPermissionPolicies.PlacementExams_Create)).Succeeded;
    var canViewResults = (await AuthorizationService.AuthorizeAsync(User, AdminPermissionPolicies.PlacementExams_Results)).Succeeded;
    var canDelete      = (await AuthorizationService.AuthorizeAsync(User, AdminPermissionPolicies.PlacementExams_Delete)).Succeeded;
}

@section Styles {
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <style>
        :root {
            --ink: #0D1B2A;
            --ink-2: #2C3E50;
            --ink-3: #5A6A7A;
            --ink-4: #8FA0B0;
            --ink-5: #C8D5E0;
            --canvas: #F3F6FA;
            --surface: #FFFFFF;
            --surface-2: #F8FAFC;
            --surface-3: #EEF2F7;
            --border: #DDE4EC;
            --blue: #1B5EAE;
            --blue-2: #2471D0;
            --blue-bg: #E8F1FB;
            --blue-dark: #103E7A;
            --emerald: #0D7A5B;
            --emerald-bg: #E4F5EE;
            --amber: #985D09;
            --amber-bg: #FDF0D8;
            --rose: #BF1030;
            --rose-bg: #FDEAEE;
            --violet: #5535B5;
            --violet-bg: #EDE8F9;
            --r-sm: 6px;
            --r-md: 10px;
            --r-lg: 14px;
            --r-xl: 20px;
            --sh-xs: 0 1px 3px rgba(13,27,42,.06);
            --sh-sm: 0 2px 8px rgba(13,27,42,.08);
            --sh-md: 0 4px 18px rgba(13,27,42,.10);
            --ease: cubic-bezier(.25,.46,.45,.94);
        }

        .placement-page {
            background: var(--canvas);
            min-height: 100vh;
            padding: 32px 28px 64px;
            direction: rtl;
            font-family: 'Cairo';
            color: var(--ink-2);
        }

        .placement-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 14px;
            margin-bottom: 28px;
        }

        .placement-brand {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .placement-brand-icon {
            width: 46px;
            height: 46px;
            background: var(--blue);
            border-radius: var(--r-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 20px;
            box-shadow: 0 4px 14px rgba(27,94,174,.28);
        }

        .placement-brand-title {
            font-size: 20px;
            font-weight: 700;
            color: var(--ink);
            line-height: 1.15;
        }

        .placement-brand-sub {
            font-size: 16px;
            color: var(--ink-4);
            margin-top: 2px;
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn-main-action {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: var(--blue);
            color: #fff;
            border: none;
            border-radius: var(--r-md);
            padding: 10px 20px;
            font-size: 18px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            box-shadow: 0 3px 10px rgba(27,94,174,.28);
            transition: background .16s var(--ease), transform .14s, box-shadow .16s;
        }

            .btn-main-action:hover {
                background: var(--blue-dark);
                color: #fff;
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(27,94,174,.32);
            }

        .btn-secondary-action {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: var(--surface);
            color: var(--blue);
            border: 1px solid #B6D3F4;
            border-radius: var(--r-md);
            padding: 10px 20px;
            font-size: 18px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: background .16s var(--ease), transform .14s, box-shadow .16s;
        }

            .btn-secondary-action:hover {
                background: var(--blue-bg);
                color: var(--blue-dark);
                transform: translateY(-2px);
                box-shadow: var(--sh-sm);
            }

        .placement-kpis {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 13px;
            margin-bottom: 24px;
        }

        @@media (max-width: 960px) {
            .placement-kpis {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 480px) {
            .placement-kpis {
                grid-template-columns: 1fr;
            }
        }

        .kpi-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            padding: 18px 19px;
            display: flex;
            align-items: center;
            gap: 13px;
            box-shadow: var(--sh-xs);
            transition: transform .2s var(--ease), box-shadow .2s;
            position: relative;
            overflow: hidden;
        }

            .kpi-card::after {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 4px;
                height: 100%;
                border-radius: 0 var(--r-xl) var(--r-xl) 0;
            }

            .kpi-card:hover {
                transform: translateY(-3px);
                box-shadow: var(--sh-sm);
            }

        .kpi-blue::after {
            background: var(--blue);
        }

        .kpi-emerald::after {
            background: var(--emerald);
        }

        .kpi-amber::after {
            background: var(--amber);
        }

        .kpi-violet::after {
            background: var(--violet);
        }

        .kpi-ico {
            width: 42px;
            height: 42px;
            border-radius: var(--r-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .ico-blue {
            background: var(--blue-bg);
            color: var(--blue);
        }

        .ico-emerald {
            background: var(--emerald-bg);
            color: var(--emerald);
        }

        .ico-amber {
            background: var(--amber-bg);
            color: var(--amber);
        }

        .ico-violet {
            background: var(--violet-bg);
            color: var(--violet);
        }

        .kpi-label {
            font-size: 15px;
            font-weight: 700;
            color: var(--ink-4);
            letter-spacing: .04em;
            text-transform: uppercase;
            margin-bottom: 3px;
        }

        .kpi-val {
            font-size: 20px;
            font-weight: 700;
            color: var(--ink);
            line-height: 1;
        }

        .placement-table-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            overflow: visible;
            box-shadow: var(--sh-sm);
            margin-bottom: 24px;
        }

        .placement-table-topbar {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 11px 16px;
            border-bottom: 1px solid var(--surface-3);
            flex-wrap: wrap;
        }

        .table-section-title {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 18px;
            font-weight: 800;
            color: var(--ink);
            margin-left: 10px;
        }

            .table-section-title i {
                color: var(--blue);
            }

        .placement-table-search-wrap {
            position: relative;
            flex: 1;
            min-width: 200px;
            max-width: 360px;
        }

            .placement-table-search-wrap i {
                position: absolute;
                right: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--ink-4);
                font-size: 17px;
                pointer-events: none;
            }

            .placement-table-search-wrap input {
                width: 100%;
                padding: 7px 32px 7px 12px;
                border: 1px solid var(--border);
                border-radius: var(--r-md);
                font-size: 18px;
                background: var(--surface-2);
                color: var(--ink);
                transition: border-color .15s, box-shadow .15s;
            }

                .placement-table-search-wrap input:focus {
                    outline: none;
                    border-color: var(--blue-2);
                    box-shadow: 0 0 0 3px rgba(36,113,208,.1);
                    background: var(--surface);
                }

        .placement-count-badge {
            margin-right: auto;
            font-size: 16px;
            color: var(--ink-4);
        }

            .placement-count-badge strong {
                color: var(--blue);
                font-weight: 700;
            }

        .table-responsive-safe {
            width: 100%;
            overflow-x: auto;
            overflow-y: visible;
        }

        #batchExamsTable {
            width: 100% !important;
            border-collapse: collapse;
        }

            #batchExamsTable thead th {
                background: var(--surface-2) !important;
                padding: 11px 15px !important;
                font-size: 15px !important;
                font-weight: 700 !important;
                color: var(--ink-4) !important;
                text-transform: uppercase;
                letter-spacing: .05em;
                white-space: nowrap;
                border: none !important;
                text-align: center;
            }

            #batchExamsTable tbody tr {
                border-bottom: 1px solid var(--surface-3);
                transition: background .1s;
            }

                #batchExamsTable tbody tr:last-child {
                    border-bottom: none;
                }

                #batchExamsTable tbody tr:hover {
                    background: #F5F8FD;
                }

            #batchExamsTable td {
                padding: 11px 15px !important;
                vertical-align: middle !important;
                font-size: 18px !important;
                color: var(--ink-2);
                border: none !important;
                text-align: center;
            }

        .exam-title-cell {
            display: flex;
            align-items: center;
            gap: 10px;
            text-align: right;
        }

        .exam-avatar {
            width: 33px;
            height: 33px;
            border-radius: 50%;
            background: var(--blue-bg);
            color: var(--blue);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }

        .exam-item-name {
            font-weight: 600;
            color: var(--ink);
            font-size: 18px;
        }

        .num-val {
            font-weight: 700;
            color: var(--ink);
            font-size: 19px;
        }

        .num-unit {
            font-size: 15px;
            color: var(--ink-4);
            display: block;
            margin-top: 1px;
        }

        .students-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 11px;
            border-radius: 30px;
            font-size: 16px;
            font-weight: 700;
            white-space: nowrap;
            background: var(--violet-bg);
            color: var(--violet);
        }

        .date-chip {
            font-size: 16px;
            color: var(--ink-3);
            white-space: nowrap;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 11px;
            border-radius: 30px;
            font-size: 16px;
            font-weight: 700;
            white-space: nowrap;
        }

        .sp-active {
            background: var(--emerald-bg);
            color: var(--emerald);
        }

        .sp-hidden {
            background: var(--rose-bg);
            color: var(--rose);
        }

        .placement-act-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            flex-wrap: nowrap;
            position: relative;
            overflow: visible;
        }

        .act-btn {
            position: relative;
            width: 34px;
            height: 34px;
            min-width: 34px;
            padding: 0;
            border-radius: var(--r-sm);
            font-size: 16px;
            font-weight: 600;
            text-decoration: none;
            border: 1.5px solid transparent;
            cursor: pointer;
            background: transparent;
            transition: all .15s;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            overflow: visible;
        }

            .act-btn i {
                margin: 0;
                font-size: 15px;
                line-height: 1;
            }

            .act-btn .act-text {
                position: absolute;
                bottom: calc(100% + 8px);
                right: 50%;
                transform: translateX(50%) translateY(4px);
                background: var(--ink);
                color: #fff;
                font-size: 13px;
                font-weight: 600;
                padding: 5px 9px;
                border-radius: 6px;
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
                transition: opacity .15s ease, transform .15s ease, visibility .15s ease;
                z-index: 9999;
                box-shadow: 0 4px 12px rgba(13,27,42,.18);
                min-width: max-content;
            }

                .act-btn .act-text::after {
                    content: "";
                    position: absolute;
                    top: 100%;
                    right: 50%;
                    transform: translateX(50%);
                    border-width: 5px;
                    border-style: solid;
                    border-color: var(--ink) transparent transparent transparent;
                }

            .act-btn:hover .act-text {
                opacity: 1;
                visibility: visible;
                transform: translateX(50%) translateY(0);
            }

        .act-students {
            background: var(--blue-bg);
            color: var(--blue);
            border-color: #B6D3F4;
        }

            .act-students:hover {
                background: var(--blue);
                color: #fff;
                border-color: var(--blue);
            }

        .act-details {
            background: var(--violet-bg);
            color: var(--violet);
            border-color: #CEC2F0;
        }

            .act-details:hover {
                background: var(--violet);
                color: #fff;
                border-color: var(--violet);
            }

        .act-report {
            background: var(--emerald-bg);
            color: var(--emerald);
            border-color: #B8E8D3;
        }

            .act-report:hover {
                background: var(--emerald);
                color: #fff;
                border-color: var(--emerald);
            }

        .act-hide {
            background: var(--rose-bg);
            color: var(--rose);
            border-color: #F5B8C2;
        }

            .act-hide:hover {
                background: var(--rose);
                color: #fff;
                border-color: var(--rose);
            }

        .act-restore {
            background: var(--amber-bg);
            color: var(--amber);
            border-color: #F3D494;
        }

            .act-restore:hover {
                background: var(--amber);
                color: #fff;
                border-color: var(--amber);
            }

        .dataTables_wrapper {
            direction: rtl;
            overflow: visible;
        }

            .dataTables_wrapper .dataTables_filter {
                display: none;
            }

            .dataTables_wrapper .dataTables_length,
            .dataTables_wrapper .dataTables_info {
                padding: 9px 16px;
                font-size: 16px;
                color: var(--ink-4);
            }

            .dataTables_wrapper .dataTables_paginate {
                padding: 9px 16px;
            }

                .dataTables_wrapper .dataTables_paginate .paginate_button {
                    border-radius: var(--r-sm) !important;
                    font-size: 16px !important;
                    padding: 4px 10px !important;
                    border: 1px solid var(--border) !important;
                    margin: 0 2px !important;
                    color: var(--ink-3) !important;
                }

                    .dataTables_wrapper .dataTables_paginate .paginate_button.current,
                    .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
                        background: var(--blue) !important;
                        border-color: var(--blue) !important;
                        color: #fff !important;
                    }

                    .dataTables_wrapper .dataTables_paginate .paginate_button:hover:not(.current):not(.disabled) {
                        background: var(--blue-bg) !important;
                        border-color: #B6D3F4 !important;
                        color: var(--blue) !important;
                    }

            .dataTables_wrapper .dataTables_length select {
                border: 1px solid var(--border);
                border-radius: var(--r-sm);
                padding: 3px 8px;
                font-size: 16px;
                color: var(--ink);
            }

        div.dataTables_wrapper div.dataTables_paginate,
        div.dataTables_wrapper div.dataTables_info,
        div.dataTables_wrapper div.dataTables_length {
            border-top: 1px solid var(--surface-3);
            background: var(--surface-2);
        }

        .placement-empty {
            text-align: center;
            padding: 56px 16px;
            color: var(--ink-4);
        }

            .placement-empty i {
                font-size: 20px;
                display: block;
                margin-bottom: 12px;
                color: var(--ink-5);
            }

        .placement-empty-title {
            font-size: 18px;
            font-weight: 600;
            color: var(--ink-3);
        }

        .placement-empty-sub {
            font-size: 16px;
            margin-top: 4px;
        }

        @@media (max-width: 768px) {
            .placement-page {
                padding: 22px 14px 48px;
            }

            .top-actions {
                width: 100%;
            }

            .btn-main-action,
            .btn-secondary-action {
                width: 100%;
                justify-content: center;
            }

            .placement-table-topbar {
                align-items: stretch;
            }

            .placement-table-search-wrap {
                max-width: 100%;
                width: 100%;
            }

            .placement-count-badge {
                margin-right: 0;
            }
        }
    </style>
}

<div class="placement-page">

    @Html.AntiForgeryToken()

    <div class="placement-topbar">
        <div class="placement-brand">
            <div class="placement-brand-icon">
                <i class="bi bi-clipboard-data"></i>
            </div>
            <div>
                <div class="placement-brand-title">
                    اختبارات الدفعة: @ViewBag.BatchName
                </div>
                <div class="placement-brand-sub">
                    متابعة اختبارات تحديد المستوى الخاصة بهذه الدفعة، وإدارة الطلاب والتقارير وحالة الظهور
                </div>
            </div>
        </div>

        <div class="top-actions">
            <a href="javascript:history.back()" class="btn-secondary-action">
                <i class="bi bi-arrow-left"></i>
                عودة إلى قائمة الدفعات
            </a>

            @if (canCreate)
            {
                <a asp-action="CreateAdvanced" class="btn-main-action">
                    <i class="bi bi-plus-circle"></i>
                    إنشاء اختبار جديد
                </a>
            }
        </div>
    </div>

    <div class="placement-kpis">

        <div class="kpi-card kpi-blue">
            <div class="kpi-ico ico-blue">
                <i class="bi bi-ui-checks-grid"></i>
            </div>
            <div>
                <div class="kpi-label">إجمالي الاختبارات</div>
                <div class="kpi-val">@totalExams</div>
            </div>
        </div>

        <div class="kpi-card kpi-emerald">
            <div class="kpi-ico ico-emerald">
                <i class="bi bi-eye"></i>
            </div>
            <div>
                <div class="kpi-label">اختبارات نشطة</div>
                <div class="kpi-val">@activeExams</div>
            </div>
        </div>

        <div class="kpi-card kpi-amber">
            <div class="kpi-ico ico-amber">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <div class="kpi-label">إجمالي الطلاب</div>
                <div class="kpi-val">@totalStudents</div>
            </div>
        </div>

        <div class="kpi-card kpi-violet">
            <div class="kpi-ico ico-violet">
                <i class="bi bi-question-circle"></i>
            </div>
            <div>
                <div class="kpi-label">إجمالي الأسئلة</div>
                <div class="kpi-val">@totalQuestions</div>
            </div>
        </div>

    </div>

    <div class="placement-table-card">

        <div class="placement-table-topbar">
            <div class="table-section-title">
                <i class="bi bi-table"></i>
                اختبارات الدفعة
            </div>

            <div class="placement-table-search-wrap">
                <i class="bi bi-search"></i>
                <input type="text"
                       id="batchExamSearch"
                       placeholder="ابحث في العنوان أو الحالة أو التاريخ..." />
            </div>

            <div class="placement-count-badge">
                إجمالي: <strong>@totalExams</strong> اختبار
            </div>
        </div>

        <div class="table-responsive-safe">
            <table id="batchExamsTable">
                <thead>
                    <tr>
                        <th style="text-align:right; width:26%">العنوان</th>
                        <th style="width:12%">عدد الأسئلة</th>
                        <th style="width:12%">عدد الطلاب</th>
                        <th style="width:18%">تاريخ الإنشاء</th>
                        <th style="width:12%">الحالة</th>
                        <th style="width:20%">الإجراء</th>
                    </tr>
                </thead>

                <tbody>
                    @if (examsList.Any())
                    {
                        foreach (var e in examsList)
                        {
                            <tr id="row-@e.ExamId">
                                <td style="text-align:right">
                                    <div class="exam-title-cell">
                                        <div class="exam-avatar">
                                            <i class="bi bi-file-earmark-text"></i>
                                        </div>
                                        <span class="exam-item-name">@e.Title</span>
                                    </div>
                                </td>

                                <td>
                                    <span class="num-val">@e.TotalQuestions</span>
                                    <span class="num-unit">سؤال</span>
                                </td>

                                <td>
                                    <span class="students-pill">
                                        <i class="bi bi-people"></i>
                                        @e.StudentCount طالب
                                    </span>
                                </td>

                                <td>
                                    <span class="date-chip">
                                        <i class="bi bi-calendar-event" style="margin-left:4px;color:var(--ink-4)"></i>
                                        @e.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                                    </span>
                                </td>

                                <td>
                                    @if (e.IsActive)
                                    {
                                        <span class="status-pill sp-active">
                                            <i class="bi bi-check-circle"></i>
                                            نشط
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill sp-hidden">
                                            <i class="bi bi-eye-slash"></i>
                                            مخفي
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="placement-act-row">
                                        <a asp-action="PlacementDetails"
                                           asp-route-id="@e.ExamId"
                                           class="act-btn act-details"
                                           aria-label="تفاصيل الاختبار">
                                            <i class="bi bi-info-circle"></i>
                                            <span class="act-text">تفاصيل الاختبار</span>
                                        </a>

                                        <a asp-action="BatchStudents"
                                           asp-route-examId="@e.ExamId"
                                           asp-route-batchId="@e.BatchId"
                                           class="act-btn act-students"
                                           aria-label="الطلاب">
                                            <i class="bi bi-people"></i>
                                            <span class="act-text">الطلاب</span>
                                        </a>

                                        @if (canViewResults)
                                        {
                                            <a asp-action="BatchPerformanceReport"
                                               asp-route-examId="@e.ExamId"
                                               asp-route-batchId="@e.BatchId"
                                               class="act-btn act-report"
                                               aria-label="أداء الدفعة">
                                                <i class="bi bi-graph-up"></i>
                                                <span class="act-text">أداء الدفعة</span>
                                            </a>
                                        }

                                        @if (canDelete)
                                        {
                                            @if (e.IsActive)
                                            {
                                                <button type="button"
                                                        class="act-btn act-hide hide-btn"
                                                        data-id="@e.ExamId"
                                                        data-title="@e.Title"
                                                        data-tested="@e.TestedCount"
                                                        aria-label="إخفاء">
                                                    <i class="bi bi-eye-slash"></i>
                                                    <span class="act-text">إخفاء</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="act-btn act-restore restore-btn"
                                                        data-id="@e.ExamId"
                                                        aria-label="استرجاع">
                                                    <i class="bi bi-arrow-clockwise"></i>
                                                    <span class="act-text">استرجاع</span>
                                                </button>
                                            }

                                            <button type="button"
                                                    class="act-btn act-delete delete-btn"
                                                    data-id="@e.ExamId"
                                                    data-batch="@e.BatchId"
                                                    data-title="@e.Title"
                                                    data-tested="@e.TestedCount"
                                                    aria-label="حذف نهائي">
                                                <i class="bi bi-trash"></i>
                                                <span class="act-text">حذف نهائي</span>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (!examsList.Any())
        {
            <div class="placement-empty">
                <i class="bi bi-inbox"></i>
                <div class="placement-empty-title">لا توجد اختبارات لهذه الدفعة</div>
                <div class="placement-empty-sub">يمكنك إنشاء اختبار جديد من أعلى الصفحة</div>
            </div>
        }

    </div>

</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            var table = $('#batchExamsTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json'
                },
                pageLength: 10,
                lengthMenu: [[10, 20, 30, 50, 100, -1], [10, 20, 30, 50, 100, "الكل"]],
                order: [[3, "desc"]],
                dom: 'Brtip',
                columnDefs: [
                    { orderable: false, targets: [5] }
                ]
            });

            $('#batchExamSearch').on('input', function () {
                table.search($(this).val()).draw();
            });

            $('.hide-btn').on('click', function () {
                const examId = $(this).data('id');
                const examTitle = $(this).data('title');
                const testedCount = parseInt($(this).data('tested')) || 0;

                let warningHtml = `سيتم إخفاء اختبار <b>"${examTitle}"</b>، ولن يظهر للطلاب بعد الآن (يمكن استرجاعه لاحقاً).`;
                if (testedCount > 0) {
                    warningHtml += `<br><br><span style="color:#b45309;font-weight:600;">
                        تنبيه: يوجد ${testedCount} طالب قام باختبار هذا الاختبار بالفعل، وسيتم إخفاؤه عنهم جميعاً أيضاً.
                    </span>`;
                }

                Swal.fire({
                    title: 'تأكيد إخفاء الاختبار',
                    html: warningHtml,
                    icon: 'warning',
                    showCancelButton: true,
                    cancelButtonText: 'إلغاء',
                    confirmButtonText: 'نعم، إخفاء الاختبار',
                    confirmButtonColor: '#2563eb',
                    cancelButtonColor: '#6b7280'
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    $.post('/Admin/PlacementExams/HideExam', {
                        id: examId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    })
                    .done(function () {
                        Swal.fire({
                            icon: 'success',
                            title: 'تم الإخفاء',
                            text: 'تم إخفاء الاختبار بنجاح.',
                            confirmButtonText: 'حسنًا'
                        }).then(function () {
                            location.reload();
                        });
                    })
                    .fail(function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'خطأ',
                            text: 'حدث خطأ أثناء إخفاء الاختبار!',
                            confirmButtonText: 'حسنًا'
                        });
                    });
                });
            });

            $('.restore-btn').on('click', function () {
                const examId = $(this).data('id');

                if (!confirm('هل ترغب في استرجاع هذا الاختبار؟')) {
                    return;
                }

                $.post('/Admin/PlacementExams/RestoreExam', {
                    id: examId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                })
                .done(function () {
                    location.reload();
                })
                .fail(function () {
                    alert('حدث خطأ أثناء الاسترجاع!');
                });
            });

            $('.delete-btn').on('click', function () {
                const examId = $(this).data('id');
                const batchId = $(this).data('batch');
                const examTitle = $(this).data('title');
                const testedCount = parseInt($(this).data('tested')) || 0;

                let warningHtml = `سيتم حذف اختبار <b>"${examTitle}"</b> نهائياً من قاعدة البيانات، بكل أسئلته ونتائجه، ولا يمكن التراجع عن هذه العملية.`;
                if (testedCount > 0) {
                    warningHtml += `<br><br><span style="color:#dc2626;font-weight:700;">
                        تنبيه: يوجد ${testedCount} طالب قام باختبار هذا الاختبار بالفعل، وسيتم حذف نتائجهم نهائياً أيضاً.
                    </span>`;
                }

                Swal.fire({
                    title: 'تأكيد الحذف النهائي',
                    html: warningHtml,
                    icon: 'warning',
                    showCancelButton: true,
                    cancelButtonText: 'إلغاء',
                    confirmButtonText: 'نعم، احذف نهائياً',
                    confirmButtonColor: '#dc2626',
                    cancelButtonColor: '#6b7280'
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    $.post('/Admin/PlacementExams/DeleteExamPermanently', {
                        examId: examId,
                        batchId: batchId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    })
                    .done(function () {
                        Swal.fire({
                            icon: 'success',
                            title: 'تم الحذف',
                            text: 'تم حذف الاختبار نهائياً من قاعدة البيانات.',
                            confirmButtonText: 'حسنًا'
                        }).then(function () {
                            location.reload();
                        });
                    })
                    .fail(function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'خطأ',
                            text: 'حدث خطأ أثناء حذف الاختبار!',
                            confirmButtonText: 'حسنًا'
                        });
                    });
                });
            });

        });
    </script>
}
