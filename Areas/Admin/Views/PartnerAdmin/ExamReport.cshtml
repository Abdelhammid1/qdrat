@using QdratNew.ViewModels.Admin
@model PartnerAdminExamReportVM

@{
    ViewData["Title"] = "تقرير اختبار – " + Model.ExamTitle;
    var attempted = Model.Students.Count(s => s.IsSubmitted);
    var total     = Model.Students.Count;
    var pct       = total > 0 ? (int)Math.Round(attempted * 100.0 / total) : 0;
    var avgScore  = attempted > 0 ? Model.Students.Where(s => s.IsSubmitted && s.Score.HasValue).Select(s => s.Score!.Value).DefaultIfEmpty(0).Average() : 0;
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --ink: #0D1B2A; --ink-2: #2C3E50; --ink-3: #5A6A7A; --ink-4: #8FA0B0;
            --canvas: #F3F6FA; --surface: #FFFFFF; --surface-2: #F8FAFC;
            --border: #DDE4EC; --blue: #1B5EAE; --blue-bg: #E8F1FB;
            --emerald: #0D7A5B; --emerald-bg: #E4F5EE;
            --amber: #985D09; --amber-bg: #FDF0D8;
            --rose: #BF1030; --rose-bg: #FDEAEE;
            --green: #2E7D32; --green-bg: #E8F5E9;
            --radius: 12px; --shadow: 0 2px 10px rgba(0,0,0,.07);
        }
        body { background: var(--canvas); font-family: 'Cairo', sans-serif; direction: rtl; }
        .page-wrap { padding: 1.75rem 1.5rem 60px; }

        .page-header { display: flex; align-items: center; gap: 14px; margin-bottom: 1.5rem; flex-wrap: wrap; }
        .page-title { font-size: 1.15rem; font-weight: 700; color: var(--ink); }
        .breadcrumb-row { font-size: .8rem; color: var(--ink-3); margin-top: 2px; }
        .breadcrumb-row a { color: var(--blue); text-decoration: none; }
        .breadcrumb-row a:hover { text-decoration: underline; }

        .stats-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.5rem; }
        .stat-card {
            background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
            padding: .9rem 1.1rem; box-shadow: var(--shadow);
            display: flex; align-items: center; gap: 10px;
        }
        .stat-icon { width: 38px; height: 38px; border-radius: 9px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0; }
        .stat-num { font-size: 1.35rem; font-weight: 700; line-height: 1; }
        .stat-lbl { font-size: .73rem; color: var(--ink-3); margin-top: 2px; }

        .progress-bar { height: 8px; background: var(--border); border-radius: 10px; overflow: hidden; margin-top: .25rem; }
        .progress-fill { height: 100%; border-radius: 10px; transition: width .5s ease; }

        .table-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden; }
        .table-card-head {
            padding: .85rem 1.25rem; display: flex; align-items: center; gap: 8px;
            border-bottom: 1px solid var(--border); font-size: .9rem; font-weight: 700; color: var(--ink);
        }
        .table-wrap { overflow-x: auto; }
        table.styled { width: 100%; border-collapse: collapse; font-size: .85rem; }
        table.styled thead tr { background: var(--surface-2); }
        table.styled th { padding: .65rem 1rem; font-weight: 600; color: var(--ink-3); border-bottom: 1px solid var(--border); text-align: right; white-space: nowrap; }
        table.styled td { padding: .65rem 1rem; border-bottom: 1px solid var(--border); color: var(--ink-2); vertical-align: middle; }
        table.styled tbody tr:hover { background: var(--surface-2); }
        table.styled tbody tr:last-child td { border-bottom: none; }
        .empty-row td { text-align: center; color: var(--ink-4); padding: 2rem !important; }

        .status-pill { display: inline-flex; align-items: center; gap: 4px; padding: 2px 10px; border-radius: 20px; font-size: .73rem; font-weight: 600; }
        .s-done    { background: var(--green-bg);   color: var(--green); }
        .s-pending { background: var(--amber-bg);   color: var(--amber); }
        .s-missed  { background: var(--rose-bg);    color: var(--rose); }
        .s-inprog  { background: var(--blue-bg);    color: var(--blue); }

        .search-input { border: 1px solid var(--border); border-radius: 8px; padding: .4rem .85rem; font-size: .84rem; width: 220px; outline: none; font-family: 'Cairo', sans-serif; }
        .search-input:focus { border-color: var(--blue); }
    </style>
}

<div class="page-wrap">

    <!-- Header -->
    <div class="page-header">
        <div style="flex:1">
            <div class="page-title">
                <i class="bi bi-clipboard2-check" style="color:var(--green);margin-left:6px"></i>
                تقرير اختبار: @Model.ExamTitle
            </div>
            <div class="breadcrumb-row">
                <a asp-area="Admin" asp-controller="Users" asp-action="PartnersList">الشركاء</a>
                <i class="bi bi-chevron-left" style="font-size:.65rem;margin:0 4px"></i>
                <a asp-area="Admin" asp-controller="Users" asp-action="PartnerUserDetails" asp-route-partnerId="@Model.PartnerId">@Model.PartnerName</a>
                <i class="bi bi-chevron-left" style="font-size:.65rem;margin:0 4px"></i>
                تقرير الاختبار
            </div>
        </div>
        <a asp-area="Admin" asp-controller="Users" asp-action="PartnerUserDetails"
           asp-route-partnerId="@Model.PartnerId" asp-fragment="tab-exams"
           class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-right"></i> رجوع
        </a>
    </div>

    <!-- Info strip -->
    <div style="background:var(--green-bg);border:1px solid #A5D6A7;border-radius:10px;padding:.75rem 1.1rem;margin-bottom:1.25rem;font-size:.85rem;display:flex;flex-wrap:wrap;gap:1.25rem;color:var(--green)">
        <span><i class="bi bi-people-fill"></i> الدفعة: <strong>@Model.BatchName</strong></span>
        <span><i class="bi bi-calendar-event"></i> تاريخ الإرسال: <strong>@Model.AssignedAt.ToString("yyyy/MM/dd HH:mm")</strong></span>
        <span><i class="bi bi-percent"></i> نسبة المشاركة: <strong>@pct%</strong></span>
        @if (attempted > 0)
        {
            <span><i class="bi bi-bar-chart-line"></i> متوسط الدرجة: <strong>@avgScore.ToString("0.#")</strong></span>
        }
    </div>

    <!-- Stats -->
    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon" style="background:var(--blue-bg);color:var(--blue)"><i class="bi bi-people-fill"></i></div>
            <div>
                <div class="stat-num" style="color:var(--blue)">@total</div>
                <div class="stat-lbl">إجمالي الطلاب</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:var(--green-bg);color:var(--green)"><i class="bi bi-check-circle-fill"></i></div>
            <div>
                <div class="stat-num" style="color:var(--green)">@attempted</div>
                <div class="stat-lbl">أدّوا الاختبار</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:var(--amber-bg);color:var(--amber)"><i class="bi bi-clock-history"></i></div>
            <div>
                <div class="stat-num" style="color:var(--amber)">@(total - attempted)</div>
                <div class="stat-lbl">لم يؤدّوا بعد</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:var(--green-bg);color:var(--green)"><i class="bi bi-award-fill"></i></div>
            <div>
                <div class="stat-num" style="color:var(--green)">@(attempted > 0 ? avgScore.ToString("0.#") : "—")</div>
                <div class="stat-lbl">متوسط الدرجات</div>
                @if (attempted > 0)
                {
                    <div class="progress-bar" style="width:80px">
                        <div class="progress-fill" style="width:@((int)Math.Min(avgScore, 100))%;background:var(--green)"></div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Students Table -->
    <div class="table-card">
        <div class="table-card-head" style="justify-content:space-between">
            <span><i class="bi bi-list-check" style="color:var(--green)"></i> نتائج الطلاب</span>
            <input type="text" id="search-students" class="search-input" placeholder="بحث بالاسم أو الهوية ..." />
        </div>
        <div class="table-wrap">
            <table class="styled" id="tbl-students">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>الطالب</th>
                        <th>رقم الهوية</th>
                        <th>الحالة</th>
                        <th>الدرجة</th>
                        <th>وقت البدء</th>
                        <th>وقت التسليم</th>
                        <th>التقرير</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Students.Any())
                    {
                        <tr class="empty-row">
                            <td colspan="8"><i class="bi bi-inbox" style="font-size:1.4rem;display:block;margin-bottom:6px"></i>لا يوجد طلاب في هذا الاختبار</td>
                        </tr>
                    }
                    else
                    {
                        int i = 1;
                        foreach (var s in Model.Students)
                        {
                            string pillClass, pillIcon, pillLabel;
                            if (s.IsSubmitted) {
                                pillClass = "s-done"; pillIcon = "bi-check-circle-fill"; pillLabel = "أدّى الاختبار";
                            } else if (s.Status == "InProgress") {
                                pillClass = "s-inprog"; pillIcon = "bi-play-circle"; pillLabel = "جارٍ";
                            } else if (s.Status == "Missed") {
                                pillClass = "s-missed"; pillIcon = "bi-x-circle"; pillLabel = "لم يحضر";
                            } else {
                                pillClass = "s-pending"; pillIcon = "bi-clock"; pillLabel = "لم يبدأ";
                            }
                            <tr>
                                <td>@(i++)</td>
                                <td>
                                    <div style="display:flex;align-items:center;gap:8px">
                                        <div style="width:32px;height:32px;border-radius:50%;background:var(--green-bg);color:var(--green);display:inline-flex;align-items:center;justify-content:center;font-weight:700;font-size:.78rem;flex-shrink:0">
                                            @(s.FullName.Length > 0 ? s.FullName[0].ToString() : "?")
                                        </div>
                                        <span style="font-weight:600">@s.FullName</span>
                                    </div>
                                </td>
                                <td style="color:var(--ink-3)">@(s.NationalID ?? "—")</td>
                                <td>
                                    <span class="status-pill @pillClass">
                                        <i class="bi @pillIcon"></i> @pillLabel
                                    </span>
                                </td>
                                <td>
                                    @if (s.Score.HasValue)
                                    {
                                        var sc = s.Score.Value;
                                        var color = sc >= 70 ? "var(--green)" : sc >= 50 ? "var(--amber)" : "var(--rose)";
                                        <span style="font-weight:700;color:@color">@sc.ToString("0.##")</span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--ink-4)">—</span>
                                    }
                                </td>
                                <td style="font-size:.8rem;color:var(--ink-3)">
                                    @(s.StartedAt.HasValue ? s.StartedAt.Value.ToString("yyyy/MM/dd HH:mm") : "—")
                                </td>
                                <td style="font-size:.8rem;color:var(--ink-3)">
                                    @(s.SubmittedAt.HasValue ? s.SubmittedAt.Value.ToString("yyyy/MM/dd HH:mm") : "—")
                                </td>
                                <td>
                                    @if (s.IsSubmitted)
                                    {
                                        <a asp-area="Admin"
                                           asp-controller="PartnerAdmin"
                                           asp-action="StudentExamDetail"
                                           asp-route-assignmentId="@Model.AssignmentId"
                                           asp-route-studentId="@s.StudentId"
                                           asp-route-partnerId="@Model.PartnerId"
                                           target="_blank"
                                           style="display:inline-flex;align-items:center;gap:5px;padding:4px 12px;border-radius:8px;font-size:.76rem;font-weight:600;text-decoration:none;border:1.5px solid var(--green);color:var(--green);background:transparent;transition:all .2s"
                                           onmouseover="this.style.background='var(--green)';this.style.color='#fff'"
                                           onmouseout="this.style.background='transparent';this.style.color='var(--green)'">
                                            <i class="bi bi-bar-chart-line"></i> تقرير مفصل
                                        </a>
                                    }
                                    else
                                    {
                                        <span style="color:var(--ink-4);font-size:.78rem">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <script>
    const input = document.getElementById('search-students');
    const tbody = document.querySelector('#tbl-students tbody');
    input?.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        tbody?.querySelectorAll('tr:not(.empty-row)').forEach(row => {
            row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
    });
    </script>
}
