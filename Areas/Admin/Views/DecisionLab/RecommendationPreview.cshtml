<script>
    (function () {
        const canvas = document.getElementById('impactGaugeChart');
        if (!canvas || typeof Chart === 'undefined') return;
        const score = @score;
        const color = '@gaugeColor';
        new Chart(canvas, {
            type: 'doughnut',
            data: {
                datasets: [{
                    data: [score, 100 - score],
                    backgroundColor: [color, '#f3f4f6'],
                    borderWidth: 0,
                    circumference: 180,
                    rotation: 270
                }]
            },
            options: {
                responsive: false,
                cutout: '72%',
                plugins: {
                    legend: { display: false },
                    tooltip: { enabled: false }
                },
                animation: { duration: 900, easing: 'easeInOutQuart' }
            }
        });
    })();

    // ── Risk Signals Chart ──
    (function () {
        const canvas2 = document.getElementById('riskSignalsChart');
        if (!canvas2 || typeof Chart === 'undefined') return;
        const interventionType = "@Model.InterventionType";
        const impactScore = @Model.ImpactScore;
        const priorityMap = { "عاجل": 1.0, "مرتفع": 0.8, "متوسط": 0.55, "منخفض": 0.3 };
        const base = priorityMap["@Model.Priority"] ?? 0.5;
        const isMixed = interventionType === "MixedIntervention";
        const signals = [
            interventionType.includes("Attendance") || isMixed ? Math.round(impactScore * base) : Math.round(impactScore * base * 0.3),
            interventionType.includes("Homework")   || isMixed ? Math.round(impactScore * base) : Math.round(impactScore * base * 0.3),
            interventionType.includes("Exam")       || isMixed ? Math.round(impactScore * base) : Math.round(impactScore * base * 0.3),
            interventionType.includes("Instructor") || isMixed ? Math.round(impactScore * base) : Math.round(impactScore * base * 0.3),
        ];
        new Chart(canvas2, {
            type: 'polarArea',
            data: {
                labels: ['الحضور', 'الواجبات', 'الاختبارات', 'المحتوى'],
                datasets: [{
                    data: signals,
                    backgroundColor: ['rgba(59,130,246,0.7)', 'rgba(245,158,11,0.7)', 'rgba(16,185,129,0.7)', 'rgba(139,92,246,0.7)'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: false,
                plugins: {
                    legend: { position: 'bottom', labels: { font: { family: 'Cairo', size: 11 }, boxWidth: 12, padding: 8 } },
                    tooltip: { enabled: true }
                },
                scales: { r: { ticks: { display: false }, grid: { color: '#f3f4f6' } } },
                animation: { duration: 900, easing: 'easeInOutQuart' }
            }
        });
    })();

    // ── Tab switching ──
    document.querySelectorAll('[data-tab]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.querySelectorAll('[data-tab]').forEach(function (b) { b.classList.remove('active'); });
            document.querySelectorAll('.rp-tab-panel').forEach(function (p) { p.classList.remove('active'); });
            btn.classList.add('active');
            var panel = document.getElementById('panel-' + btn.dataset.tab);
            if (panel) panel.classList.add('active');
        });
    });
    document.querySelector('[data-tab="diagnosis"]')?.click();

    // ── Routing card selection ──
    document.querySelectorAll('.rp-route-card').forEach(function (card) {
        card.addEventListener('click', function () {
            document.querySelectorAll('.rp-route-card').forEach(function (c) { c.classList.remove('rp-route-selected'); });
            card.classList.add('rp-route-selected');
            var val = card.dataset.route;
            var input = document.getElementById('routingChoiceInput');
            if (input) input.value = val;
            var btn = document.getElementById('applyRoutingBtn');
            if (btn) btn.disabled = false;
            var target = document.getElementById('routingTarget');
            if (target) {
                target.textContent = val === 'student' ? 'الطالب' : val === 'instructor' ? 'المدرب' : 'المدرب والطالب';
            }
            document.querySelectorAll('.rp-matrix').forEach(function (m) { m.style.display = 'none'; });
            var matrix = document.getElementById('matrix-' + val);
            if (matrix) matrix.style.display = 'block';
        });
    });
