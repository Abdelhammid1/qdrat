@model QdratNew.ViewModels.Admin.DecisionLab.DecisionLabRecommendationPreviewViewModel?
<link rel="stylesheet" href="~/css/decision-analytics-ui.css" asp-append-version="true" />

@{
    var safeReturnUrl = (!string.IsNullOrWhiteSpace(Model?.SourceContext.ReturnUrl) && Url.IsLocalUrl(Model.SourceContext.ReturnUrl))
        ? Model.SourceContext.ReturnUrl
        : Url.Action("Index", "DecisionLab", new { area = "Admin" })!;

    var priority = Model?.Priority ?? "";
    var priorityColor = priority == "عاجل" ? "#dc2626" : priority == "مرتفع" ? "#d97706" : priority == "متوسط" ? "#ca8a04" : "#16a34a";
    var priorityBg   = priority == "عاجل" ? "#fee2e2" : priority == "مرتفع" ? "#fef3c7" : priority == "متوسط" ? "#fef9c3" : "#dcfce7";
    var priorityLevel = priority == "عاجل" ? 4 : priority == "مرتفع" ? 3 : priority == "متوسط" ? 2 : 1;

    var itType = Model?.InterventionType ?? "";
    var intIcon  = itType == "DataReview"         ? "fa-database"         :
                   itType == "AttendanceFollowUp"  ? "fa-user-clock"       :
                   itType == "HomeworkSupport"     ? "fa-clipboard-list"   :
                   itType == "ShortRemedialExam"   ? "fa-file-pen"         :
                   itType == "InstructorGuidance"  ? "fa-chalkboard-user"  :
                   itType == "MixedIntervention"   ? "fa-layer-group"      :
                   itType == "MonitorOnly"         ? "fa-eye"              : "fa-circle-info";
    var intColor = itType == "DataReview"         ? "#0891b2" :
                   itType == "AttendanceFollowUp"  ? "#d97706" :
                   itType == "HomeworkSupport"     ? "#1e40af" :
                   itType == "ShortRemedialExam"   ? "#7c3aed" :
                   itType == "InstructorGuidance"  ? "#16a34a" :
                   itType == "MixedIntervention"   ? "#dc2626" : "#6b7280";
    var intLabel = itType == "DataReview"         ? "مراجعة البيانات"   :
                   itType == "AttendanceFollowUp"  ? "متابعة الحضور"     :
                   itType == "HomeworkSupport"     ? "دعم الواجبات"      :
                   itType == "ShortRemedialExam"   ? "اختبار تشخيصي"    :
                   itType == "InstructorGuidance"  ? "توجيه المعلم"      :
                   itType == "MixedIntervention"   ? "تدخل مختلط"        :
                   itType == "MonitorOnly"         ? "مراقبة فقط"        : itType;

    var score      = Model?.ImpactScore ?? 0;
    var gaugeColor = score >= 75 ? "#dc2626" : score >= 50 ? "#d97706" : score >= 25 ? "#ca8a04" : "#16a34a";
    var scoreDesc  = score >= 75 ? "تأثير حرج — تدخل فوري"         :
                     score >= 50 ? "تأثير مرتفع — أولوية عالية"    :
                     score >= 25 ? "تأثير متوسط — مراجعة مطلوبة"   : "تأثير منخفض — متابعة مستمرة";

    var isSaved = Model?.SavedRecommendationId.HasValue == true;
}

<div class="qd-page" dir="rtl">

    <!-- ═══════════ BREADCRUMB ═══════════ -->
    <nav aria-label="breadcrumb" class="rp-breadcrumb mb-2">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-home me-1"></i>الرئيسية
                </a>
            </li>
            <li class="breadcrumb-item">
                <a asp-area="Admin" asp-controller="Analytics" asp-action="AdvancedDashboard">Analytics</a>
            </li>
            @if (Model?.BatchId.HasValue == true)
            {
                <li class="breadcrumb-item">
                    <a asp-area="Admin" asp-controller="Analytics" asp-action="BatchPerformanceDetails"
                       asp-route-batchId="@Model.BatchId" asp-route-curriculumId="@Model.CurriculumId">
                        دفعة @Model.BatchId
                    </a>
                </li>
            }
            <li class="breadcrumb-item">
                <a asp-area="Admin" asp-controller="DecisionLab" asp-action="Index">مختبر القرار</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">معاينة التوصية</li>
        </ol>
    </nav>

    <!-- ═══════════ SOURCE CONTEXT BAR ═══════════ -->
    @if (!string.IsNullOrWhiteSpace(Model?.SourceContext.SourceMetric))
    {
        <div class="source-context-bar mb-2">
            <i class="fas fa-location-arrow me-1"></i>
            <span>قادم من: <strong>@Model.SourceContext.SourcePage</strong></span>
            <span class="source-context-sep">|</span>
            <span>المقياس: <strong>@Model.SourceContext.SourceMetric</strong></span>
        </div>
    }

    <!-- ═══════════ ANALYTICS CONTEXT BANNER ═══════════ -->
    @if (Model?.SourceContext != null &&
         Model.SourceContext.SourceController == "Analytics" &&
         Model.SourceContext.SourceAction == "MetricDecisionDetails")
    {
        <div class="alert d-flex align-items-center gap-3 mb-4"
             style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:.85rem;padding:1rem 1.25rem;">
            <i class="bi bi-bar-chart-fill text-primary fs-5"></i>
            <div class="flex-grow-1 small">
                <strong class="d-block" style="color:#1e40af;">أتيت من لوحة تحليل المؤشرات</strong>
                <span style="color:#3b82f6;">
                    المؤشر: @(!string.IsNullOrWhiteSpace(Model.SourceContext.SourceMetric)
                        ? Model.SourceContext.SourceMetric
                        : "عام")
                </span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.SourceContext.ReturnUrl))
            {
                <a href="@Model.SourceContext.ReturnUrl"
                   class="btn btn-sm btn-outline-primary"
                   style="border-radius:.65rem;white-space:nowrap;">
                    <i class="bi bi-arrow-right me-1"></i>
                    العودة للمؤشر
                </a>
            }
        </div>
    }

    <!-- ═══════════ HEADER ═══════════ -->
    <section class="dl-header">
        <div class="d-flex align-items-start justify-content-between flex-wrap gap-3" style="position:relative;z-index:1">
            <div>
                <div class="dl-eyebrow mb-1">
                    <i class="fas fa-brain me-1"></i>DecisionLab · معاينة التوصية
                </div>
                <h1 class="mb-1">@(Model?.Title ?? "معاينة التوصية")</h1>
                <p class="mb-0">قراءة تشغيلية للتوصية المقترحة — راجع التفاصيل قبل الحفظ والاعتماد</p>
            </div>
            <div class="d-flex gap-2 flex-wrap align-items-center">
                @if (Model?.BatchId.HasValue == true)
                {
                    <a class="btn btn-light btn-sm"
                       asp-area="Admin" asp-controller="DecisionLab" asp-action="BatchAnalysis"
                       asp-route-batchId="@Model.BatchId" asp-route-curriculumId="@Model.CurriculumId">
                        <i class="fas fa-chart-bar me-1"></i>تحليل DecisionLab
                    </a>
                    <a class="btn btn-outline-light btn-sm"
                       asp-area="Admin" asp-controller="Analytics" asp-action="BatchPerformanceDetails"
                       asp-route-batchId="@Model.BatchId" asp-route-curriculumId="@Model.CurriculumId">
                        <i class="fas fa-chart-line me-1"></i>تحليل Analytics
                    </a>
                }
                <a class="btn btn-outline-light btn-sm" href="@safeReturnUrl">
                    <i class="fas fa-arrow-right me-1"></i>رجوع
                </a>
            </div>
        </div>
    </section>



    @* ═══════ خطة العلاج التفصيلية ═══════ *@
    <div class="dl-recommendation mb-3">
        <div class="rp-multiview-header">
            <i class="fas fa-layer-group me-2"></i>خطة العلاج التفصيلية
            <span class="rp-multiview-subtitle">اختر الفيو المناسب لفهم المسار التنفيذي الكامل</span>
        </div>

        <div class="rp-tabs d-flex gap-2 flex-wrap mb-4">
            <button type="button" class="rp-tab-btn" data-tab="diagnosis">🔍 تشخيص الضعف</button>
            <button type="button" class="rp-tab-btn" data-tab="proposal">💡 المقترح والأسباب</button>
            <button type="button" class="rp-tab-btn" data-tab="execution">⚙️ آلية التنفيذ</button>
            <button type="button" class="rp-tab-btn" data-tab="routing">📤 التوجيه والإرسال</button>
        </div>

        @* ── TAB 1: تشخيص الضعف ── *@
        <div id="panel-diagnosis" class="rp-tab-panel">
            <div class="row g-3">
                <div class="col-md-5">
                    <div class="rp-sub-panel">
                        <div class="rp-block-label mb-2"><i class="fas fa-magnifying-glass me-1"></i>نقاط الضعف المكتشفة</div>
                        <ul class="rp-weakness-list">
                            @if (itType == "MixedIntervention")
                            {
                                <li><i class="fas fa-user-clock text-warning"></i><span>انخفاض نسبة الحضور عن 70%</span></li>
                                <li><i class="fas fa-clipboard-list text-primary"></i><span>تدني معدل تسليم الواجبات أو انخفاض الدرجات</span></li>
                                <li><i class="fas fa-file-pen" style="color:#7c3aed"></i><span>وجود دروس ضعيفة وأسئلة عالية الخطر</span></li>
                                <li><i class="fas fa-chalkboard-user text-success"></i><span>انخفاض مشاركة الاختبارات أو تدني درجاتها</span></li>
                            }
                            else if (itType == "AttendanceFollowUp")
                            {
                                <li><i class="fas fa-user-clock text-warning"></i><span>انخفاض نسبة الحضور عن 70%</span></li>
                            }
                            else if (itType == "HomeworkSupport")
                            {
                                <li><i class="fas fa-clipboard-list text-primary"></i><span>تدني معدل تسليم الواجبات أو انخفاض الدرجات</span></li>
                            }
                            else if (itType == "ShortRemedialExam")
                            {
                                <li><i class="fas fa-file-pen" style="color:#7c3aed"></i><span>وجود دروس ضعيفة وأسئلة عالية الخطر</span></li>
                            }
                            else if (itType == "InstructorGuidance")
                            {
                                <li><i class="fas fa-chalkboard-user text-success"></i><span>انخفاض مشاركة الاختبارات أو تدني درجاتها</span></li>
                            }
                            else if (itType == "DataReview")
                            {
                                <li><i class="fas fa-database" style="color:#0891b2"></i><span>بيانات غير مكتملة أو غير كافية للتحليل</span></li>
                            }
                            else
                            {
                                <li><i class="fas fa-eye text-secondary"></i><span>لا توجد إشارات خطر واضحة — مراقبة مستمرة</span></li>
                            }
                        </ul>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="rp-sub-panel">
                        <div class="rp-block-label mb-2"><i class="fas fa-gauge-high me-1"></i>حدة التأثير</div>
                        <div class="rp-impact-bar-wrap">
                            <div class="rp-impact-bar" style="width:@Model.ImpactScore%;background:@gaugeColor"></div>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <small class="text-muted fw-bold">0%</small>
                            <small class="fw-bold" style="color:@gaugeColor">@Model.ImpactScore%</small>
                            <small class="text-muted fw-bold">100%</small>
                        </div>
                        <div class="rp-block-label mt-3 mb-2"><i class="fas fa-bell me-1"></i>مستوى الاستعجال</div>
                        <span class="rp-urgency-badge" style="background:@priorityBg;color:@priorityColor;border:1.5px solid @priorityColor">
                            <i class="fas fa-circle-dot me-1"></i>@Model.Priority
                        </span>
                    </div>
                </div>
            </div>
        </div>

        @* ── TAB 2: المقترح والأسباب ── *@
        <div id="panel-proposal" class="rp-tab-panel">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="rp-sub-panel h-100">
                        <div class="rp-block-label mb-3"><i class="fas fa-sitemap me-1"></i>الأسباب الجذرية</div>
                        <ol class="rp-causes-list">
                            @if (itType == "MixedIntervention")
                            {
                                <li>
                                    <i class="fas fa-calendar-xmark text-danger"></i>
                                    <div><strong>ضعف الالتزام الأكاديمي</strong><br><small class="text-muted">تراكم الغياب مع تأخر تسليم الواجبات</small></div>
                                </li>
                                <li>
                                    <i class="fas fa-book me-1" style="color:#7c3aed"></i>
                                    <div><strong>فجوات في المحتوى</strong><br><small class="text-muted">دروس لم تُستوعب بالشكل الكافي</small></div>
                                </li>
                                <li>
                                    <i class="fas fa-arrow-trend-down text-warning"></i>
                                    <div><strong>ضعف الأداء في الاختبارات</strong><br><small class="text-muted">انعكاس مباشر للفجوات المعرفية</small></div>
                                </li>
                            }
                            else if (itType == "AttendanceFollowUp")
                            {
                                <li>
                                    <i class="fas fa-calendar-xmark text-danger"></i>
                                    <div><strong>الانقطاع المتكرر</strong><br><small class="text-muted">يؤثر على استيعاب المحتوى والأداء العام</small></div>
                                </li>
                            }
                            else if (itType == "HomeworkSupport")
                            {
                                <li>
                                    <i class="fas fa-clipboard-list text-primary"></i>
                                    <div><strong>إهمال الممارسة</strong><br><small class="text-muted">الواجبات أساس تثبيت المهارات</small></div>
                                </li>
                            }
                            else if (itType == "ShortRemedialExam")
                            {
                                <li>
                                    <i class="fas fa-file-pen" style="color:#7c3aed"></i>
                                    <div><strong>فجوات معرفية محددة</strong><br><small class="text-muted">دروس بعينها لم تُفهم جيداً</small></div>
                                </li>
                            }
                            else if (itType == "InstructorGuidance")
                            {
                                <li>
                                    <i class="fas fa-chalkboard-user text-success"></i>
                                    <div><strong>ضعف المخرجات التقييمية</strong><br><small class="text-muted">انخفاض عام في نتائج الاختبارات</small></div>
                                </li>
                            }
                            else if (itType == "DataReview")
                            {
                                <li>
                                    <i class="fas fa-database" style="color:#0891b2"></i>
                                    <div><strong>نقص البيانات</strong><br><small class="text-muted">لا يمكن اتخاذ قرار بدون بيانات كافية</small></div>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <i class="fas fa-eye text-secondary"></i>
                                    <div><strong>لا توجد مشكلة حالية</strong><br><small class="text-muted">المتابعة وقائية</small></div>
                                </li>
                            }
                        </ol>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="rp-sub-panel h-100">
                        <div class="rp-block-label mb-2"><i class="fas fa-lightbulb me-1"></i>المقترح</div>
                        <div class="rp-proposal-box">
                            <i class="fas fa-lightbulb text-warning me-2"></i>@Model.SuggestedAction
                        </div>
                        <div class="rp-block-label mt-3 mb-1">درجة الثقة في المقترح</div>
                        <div class="rp-confidence-bar-wrap">
                            <div class="rp-confidence-bar" style="width:@Model.ImpactScore%"></div>
                        </div>
                        <small class="fw-bold text-muted">الثقة: @Model.ImpactScore%</small>
                    </div>
                </div>
            </div>
        </div>

        @* ── TAB 3: آلية التنفيذ ── *@
        <div id="panel-execution" class="rp-tab-panel">
            <div class="rp-exec-timeline">
                @if (itType == "MixedIntervention")
                {
                    <div class="rp-exec-step">
                        <div class="rp-exec-num">1</div>
                        <div class="rp-exec-body">
                            <div class="rp-exec-title">مراجعة بيانات الدفعة</div>
                            <div class="rp-exec-desc">التحقق من اكتمال بيانات الحضور والواجبات والاختبارات</div>
                            <span class="rp-exec-time">⏱ 15 دقيقة</span>
                        </div>
                    </div>
                    <div class="rp-exec-step">
                        <div class="rp-exec-num">2</div>
                        <div class="rp-exec-body">
                            <div class="rp-exec-title">تحديد الطلاب المتأثرين</div>
                            <div class="rp-exec-desc">تصفية الطلاب بناءً على مؤشرات الخطر</div>
                            <span class="rp-exec-time">⏱ 10 دقيقة</span>
                        </div>
                    </div>
                    <div class="rp-exec-step">
                        <div class="rp-exec-num">3</div>
                        <div class="rp-exec-body">
                            <div class="rp-exec-title">إعداد خطة التدخل</div>
                            <div class="rp-exec-desc">تخصيص التدخل لكل طالب حسب نوع إشارة الخطر لديه</div>
                            <span class="rp-exec-time">⏱ 30 دقيقة</span>
                        </div>
                    </div>
                    <div class="rp-exec-step">
                        <div class="rp-exec-num">4</div>
                        <div class="rp-exec-body">
                            <div class="rp-exec-title">إشعار الأطراف المعنية</div>
                            <div class="rp-exec-desc">إرسال الإشعارات للمدرب والطلاب المستهدفين</div>
                            <span class="rp-exec-time">⏱ 5 دقيقة</span>
                        </div>
                    </div>
                    <div class="rp-exec-step rp-exec-last">
                        <div class="rp-exec-num">5</div>
                        <div class="rp-exec-body">
                            <div class="rp-exec-title">متابعة الاستجابة</div>
                            <div class="rp-exec-desc">مراقبة التغيير في الأداء خلال 2-4 أسابيع</div>
                            <span class="rp-exec-time">⏱ أسبوعياً</span>
                        </div>
                    </div>
                }
                else if (itType == "AttendanceFollowUp")
                {
                    <div class="rp-exec-step">
                        <div class="rp-exec-num">1</div>
                        <div class="rp-exec-body">
                            <div class="rp-exec-title">مراجعة سجل الحضور</div>
                            <div class="rp-exec-desc">التحقق من سجل غياب الطلاب وتحديد المتأثرين</div>
                            <span class="rp-exec-time">⏱ 15 دقيقة</span>
                        </div>
                    </div>
                    <div class="rp-exec-step">
                        <div class="rp-exec-num">2</div>
                        <div class="rp-exec-body">
                            <div class="rp-exec-title">التواصل مع الطلاب الغائبين</div>
                            <div class="rp-exec-desc">إرسال إشعارات للطلاب وأولياء أمورهم</div>
                            <span class="rp-exec-time">⏱ 10 دقيقة</span>
                        </div>
                    </div>
                    <div class="rp-exec-step rp-exec-last">
                        <div class="rp-exec-num">3</div>
                        <div class="rp-exec-body">
                            <div class="rp-exec-title">متابعة الاستجابة</div>
                            <div class="rp-exec-desc">مراقبة تحسن نسبة الحضور أسبوعياً</div>
                            <span class="rp-exec-time">⏱ أسبوعياً</span>
                        </div>
                    </div>
                }
                else if (itType == "HomeworkSupport")
                {
                    <div class="rp-exec-step">
                        <div class="rp-exec-num">1</div>
                        <div class="rp-exec-body">
                            <div class="rp-exec-title">مراجعة سجل تسليم الواجبات</div>
                            <div class="rp-exec-desc">تحديد الطلاب ذوي معدل التسليم المنخفض</div>
                            <span class="rp-exec-time">⏱ 10 دقيقة</span>
                        </div>
                    </div>
                    <div class="rp-exec-step">
                        <div class="rp-exec-num">2</div>
                        <div class="rp-exec-body">
                            <div class="rp-exec-title">إرسال واجبات تعويضية</div>
                            <div class="rp-exec-desc">تخصيص واجبات مناسبة للطلاب المتأثرين</div>
                            <span class="rp-exec-time">⏱ 20 دقيقة</span>
                        </div>
                    </div>
                    <div class="rp-exec-step rp-exec-last">
                        <div class="rp-exec-num">3</div>
                        <div class="rp-exec-body">
                            <div class="rp-exec-title">متابعة التسليم</div>
                            <div class="rp-exec-desc">مراقبة تحسن نسبة التسليم</div>
                            <span class="rp-exec-time">⏱ أسبوعياً</span>
                        </div>
                    </div>
                }
                else if (itType == "ShortRemedialExam")
                {
                    <div class="rp-exec-step">
                        <div class="rp-exec-num">1</div>
                        <div class="rp-exec-body">
                            <div class="rp-exec-title">تحديد الدروس الضعيفة</div>
                            <div class="rp-exec-desc">مراجعة نتائج الاختبارات لتحديد الدروس عالية الخطر</div>
                            <span class="rp-exec-time">⏱ 20 دقيقة</span>
                        </div>
                    </div>
                    <div class="rp-exec-step">
                        <div class="rp-exec-num">2</div>
                        <div class="rp-exec-body">
                            <div class="rp-exec-title">إعداد الاختبار التشخيصي</div>
                            <div class="rp-exec-desc">بناء أسئلة مستهدفة للدروس الضعيفة</div>
                            <span class="rp-exec-time">⏱ 30 دقيقة</span>
                        </div>
                    </div>
                    <div class="rp-exec-step">
                        <div class="rp-exec-num">3</div>
                        <div class="rp-exec-body">
                            <div class="rp-exec-title">إجراء الاختبار</div>
                            <div class="rp-exec-desc">تطبيق الاختبار على الطلاب المستهدفين</div>
                            <span class="rp-exec-time">⏱ 45 دقيقة</span>
                        </div>
                    </div>
                    <div class="rp-exec-step rp-exec-last">
                        <div class="rp-exec-num">4</div>
                        <div class="rp-exec-body">
                            <div class="rp-exec-title">تحليل النتائج</div>
                            <div class="rp-exec-desc">قراءة نتائج الاختبار وتحديد الخطوة التالية</div>
