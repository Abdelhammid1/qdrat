@model QdratNew.ViewModels.Admin.DecisionLab.CreateInterventionTaskViewModel
@using System.Text.Json

@functions {
    private static double Dbl(JsonElement el, string key)
    {
        try { return el.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetDouble() : 0; }
        catch { return 0; }
    }
    private static int Int(JsonElement el, string key)
    {
        try { return el.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetInt32() : 0; }
        catch { return 0; }
    }
    private static string Str(JsonElement el, string key)
    {
        try { return el.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : ""; }
        catch { return ""; }
    }
}

@{
    // ── parse snapshot ──────────────────────────────────────────────
    bool hasSnap = false;
    double sExam = 0, sHw = 0, sAtt = 0, sHwSub = 0, sExamPart = 0, sRisk = 0;
    int sStudents = 0, sWeakLessons = 0, sHighRiskQ = 0;
    string sRiskLevel = "Low";
    double sbAtt = 0, sbHw = 0, sbExam = 0, sbWeak = 0, sbQ = 0;

    if (!string.IsNullOrWhiteSpace(Model.BeforeSnapshotJson))
    {
        try
        {
            using var doc = JsonDocument.Parse(Model.BeforeSnapshotJson);
            var r = doc.RootElement;
            hasSnap      = true;
            sExam        = Dbl(r, "AverageExamScore");
            sHw          = Dbl(r, "AverageHomeworkScore");
            sAtt         = Dbl(r, "AttendancePercent");
            sHwSub       = Dbl(r, "HomeworkSubmissionPercent");
            sExamPart    = Dbl(r, "ExamParticipationPercent");
            sRisk        = Dbl(r, "RiskScore");
            sStudents    = Int(r, "ActiveStudentsCount");
            sWeakLessons = Int(r, "WeakLessonsCount");
            sHighRiskQ   = Int(r, "HighRiskQuestionsCount");
            sRiskLevel   = Str(r, "RiskLevel");
            if (r.TryGetProperty("RiskBreakdown", out var rb))
            {
                sbAtt  = Dbl(rb, "AttendanceRiskScore");
                sbHw   = Dbl(rb, "HomeworkRiskScore");
                sbExam = Dbl(rb, "ExamRiskScore");
                sbWeak = Dbl(rb, "WeakLessonRiskScore");
                sbQ    = Dbl(rb, "QuestionRiskScore");
            }
        }
        catch { hasSnap = false; }
    }

    // colour helpers
    string ScoreColor(double v) => v >= 70 ? "#16a34a" : v >= 50 ? "#d97706" : "#dc2626";
    string ScoreBg(double v)   => v >= 70 ? "#dcfce7"  : v >= 50 ? "#fef3c7" : "#fee2e2";
    string RiskColor(double v) => v >= 70 ? "#dc2626"  : v >= 50 ? "#d97706" : "#16a34a";

    string riskBadgeColor = sRiskLevel == "High" ? "#dc2626" : sRiskLevel == "Medium" ? "#d97706" : "#16a34a";
    string riskBadgeBg    = sRiskLevel == "High" ? "#fee2e2" : sRiskLevel == "Medium" ? "#fef3c7" : "#dcfce7";
    string riskBadgeLabel = sRiskLevel == "High" ? "خطر عالي" : sRiskLevel == "Medium" ? "متوسط" : "مستقر";
}

<link rel="stylesheet" href="~/css/decision-analytics-ui.css" asp-append-version="true" />

@* ══════════════════════════════════════════════════════════════════
   PAGE
══════════════════════════════════════════════════════════════════ *@
<div class="cit-root" dir="rtl">

    @* ── HEADER ─────────────────────────────────────────────────── *@
    <header class="cit-header">
        <div class="cit-header-inner">
            <div>
                <nav class="cit-breadcrumb">
                    <a asp-area="Admin" asp-controller="DecisionLab" asp-action="Index">
                        <i class="fas fa-brain me-1"></i>DecisionLab
                    </a>
                    <span>/</span>
                    <a asp-area="Admin" asp-controller="DecisionLab" asp-action="RecommendationDetails"
                       asp-route-id="@Model.DecisionRecommendationId">التوصية #@Model.DecisionRecommendationId</a>
                    <span>/</span>
                    <span>إنشاء مهمة التدخل</span>
                </nav>
                <h1 class="cit-header-title">
                    <span class="cit-header-icon"><i class="fas fa-bolt"></i></span>
                    إنشاء مهمة تدخل تعليمية
                </h1>
                <p class="cit-header-sub">
                    بناءً على التوصية المعتمدة — راجع سياق القرار أدناه ثم حدّد تفاصيل التدخل
                </p>
            </div>
            <div class="cit-header-actions">
                <a class="cit-btn cit-btn-ghost"
                   asp-area="Admin" asp-controller="Analytics" asp-action="BatchPerformanceDetails"
                   asp-route-batchId="@Model.BatchId" asp-route-curriculumId="@Model.CurriculumId">
                    <i class="fas fa-chart-line me-1"></i>تحليل الدفعة
                </a>
                <a class="cit-btn cit-btn-ghost"
                   asp-area="Admin" asp-controller="DecisionLab" asp-action="RecommendationDetails"
                   asp-route-id="@Model.DecisionRecommendationId">
                    <i class="fas fa-arrow-right me-1"></i>رجوع
                </a>
            </div>
        </div>
    </header>

    @* ── CONTEXT STRIP ──────────────────────────────────────────── *@
    <div class="cit-context-strip">

        @* Recommendation Card *@
        <div class="cit-rec-card">
            <div class="cit-rec-card-eye">
                <i class="fas fa-brain me-1"></i>التوصية المرتبطة
                <span class="cit-status-pill cit-status-approved">
                    <i class="fas fa-circle-check me-1"></i>@Model.RecommendationStatus
                </span>
            </div>
            <div class="cit-rec-type-row">
                <span class="cit-type-badge">@Model.RecommendationType</span>
                <span class="cit-meta-chip"><i class="fas fa-users me-1"></i>@Model.BatchName</span>
                @if (!string.IsNullOrWhiteSpace(Model.CourseName))
                {
                    <span class="cit-meta-chip"><i class="fas fa-book me-1"></i>@Model.CourseName</span>
                }
            </div>
            <p class="cit-rec-summary">@Model.RecommendationSummary</p>
            @if (!string.IsNullOrWhiteSpace(Model.RecommendationReason))
            {
                <div class="cit-rec-reason">
                    <i class="fas fa-clipboard-question me-1 text-muted"></i>@Model.RecommendationReason
                </div>
            }
        </div>

        @* Snapshot Metrics *@
        @if (hasSnap)
        {
            <div class="cit-snap-metrics">
                <div class="cit-snap-header">
                    <span><i class="fas fa-camera me-1"></i>بيانات الدفعة وقت القرار</span>
                    <span class="cit-risk-badge" style="background:@riskBadgeBg;color:@riskBadgeColor">
                        @riskBadgeLabel
                    </span>
                </div>
                <div class="cit-snap-bars">
                    <div class="cit-snap-bar-item">
                        <div class="cit-snap-bar-label">
                            <span>متوسط الاختبارات</span>
                            <strong style="color:@ScoreColor(sExam)">@sExam.ToString("0.0")%</strong>
                        </div>
                        <div class="cit-bar-track">
                            <div class="cit-bar-fill" style="width:@sExam%;background:@ScoreColor(sExam)"></div>
                        </div>
                    </div>
                    <div class="cit-snap-bar-item">
                        <div class="cit-snap-bar-label">
                            <span>متوسط الواجبات</span>
                            <strong style="color:@ScoreColor(sHw)">@sHw.ToString("0.0")%</strong>
                        </div>
                        <div class="cit-bar-track">
                            <div class="cit-bar-fill" style="width:@sHw%;background:@ScoreColor(sHw)"></div>
                        </div>
                    </div>
                    <div class="cit-snap-bar-item">
                        <div class="cit-snap-bar-label">
                            <span>معدل الحضور</span>
                            <strong style="color:@ScoreColor(sAtt)">@sAtt.ToString("0.0")%</strong>
                        </div>
                        <div class="cit-bar-track">
                            <div class="cit-bar-fill" style="width:@sAtt%;background:@ScoreColor(sAtt)"></div>
                        </div>
                    </div>
                    <div class="cit-snap-bar-item">
                        <div class="cit-snap-bar-label">
                            <span>مشاركة الاختبارات</span>
                            <strong style="color:@ScoreColor(sExamPart)">@sExamPart.ToString("0.0")%</strong>
                        </div>
                        <div class="cit-bar-track">
                            <div class="cit-bar-fill" style="width:@sExamPart%;background:@ScoreColor(sExamPart)"></div>
                        </div>
                    </div>
                </div>
                <div class="cit-snap-counters">
                    <div class="cit-counter" style="--cc:@RiskColor(sWeakLessons * 10)">
                        <div class="cit-counter-val">@sWeakLessons</div>
                        <div class="cit-counter-lbl">درس ضعيف</div>
                    </div>
                    <div class="cit-counter" style="--cc:@RiskColor(sHighRiskQ * 5)">
                        <div class="cit-counter-val">@sHighRiskQ</div>
                        <div class="cit-counter-lbl">سؤال حرج</div>
                    </div>
                    <div class="cit-counter" style="--cc:#1e40af">
                        <div class="cit-counter-val">@sStudents</div>
                        <div class="cit-counter-lbl">طالب نشط</div>
                    </div>
                </div>
            </div>

            @* Risk Radar Chart *@
            <div class="cit-chart-panel">
                <div class="cit-chart-title">
                    <i class="fas fa-radar me-1 text-muted"></i>تحليل مخاطر الدفعة
                </div>
                <div class="cit-radar-wrap">
                    <canvas id="citRiskRadar"
                            data-att="@sbAtt" data-hw="@sbHw" data-exam="@sbExam"
                            data-weak="@sbWeak" data-q="@sbQ"></canvas>
                </div>
                <div class="cit-risk-score-row">
                    <span>مؤشر الخطر الكلي</span>
                    <span class="cit-risk-score" style="color:@RiskColor(sRisk)">
                        @sRisk.ToString("0.0")%
                    </span>
                </div>
            </div>
        }
    </div>

    @* ── MAIN FORM ───────────────────────────────────────────────── *@
    <form method="post"
          asp-area="Admin" asp-controller="DecisionLab" asp-action="CreateInterventionTask"
          id="citForm" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="DecisionRecommendationId" />
        <input type="hidden" asp-for="BatchId" />
        <input type="hidden" asp-for="CourseId" />
        <input type="hidden" asp-for="CurriculumId" />
        <input type="hidden" asp-for="RecommendedNextLectureId" />
        <input type="hidden" asp-for="TargetLessonsJson" />
        <input type="hidden" asp-for="TargetQuestionsJson" />
        <input type="hidden" asp-for="BeforeSnapshotJson" />

        <div asp-validation-summary="ModelOnly" class="cit-validation-summary"></div>

        <div class="cit-form-body">

            @* ─── Section 1: هوية المهمة ─────────────────────────────── *@
            <section class="cit-section">
                <div class="cit-section-head">
                    <span class="cit-section-num">١</span>
                    <div>
                        <h2 class="cit-section-title">هوية المهمة</h2>
                        <p class="cit-section-sub">العنوان الرسمي والوصف التنفيذي للمهمة</p>
                    </div>
                </div>
                <div class="cit-form-grid">
                    <div class="cit-field cit-field-full">
                        <label asp-for="Title" class="cit-label">
                            عنوان المهمة <span class="cit-required">*</span>
                        </label>
                        <input asp-for="Title" class="cit-input" placeholder="مثال: إعادة شرح درس التفاضل للدفعة ب" />
                        <span asp-validation-for="Title" class="cit-error"></span>
                    </div>
                    <div class="cit-field cit-field-full">
                        <label asp-for="Description" class="cit-label">وصف المهمة</label>
                        <textarea asp-for="Description" class="cit-textarea" rows="3"
                                  placeholder="شرح موجز لما يجب على المدرب تنفيذه بالضبط..."></textarea>
                        <span asp-validation-for="Description" class="cit-error"></span>
                    </div>
                </div>
            </section>

            @* ─── Section 2: إعدادات التنفيذ ────────────────────────── *@
            <section class="cit-section">
                <div class="cit-section-head">
                    <span class="cit-section-num">٢</span>
                    <div>
                        <h2 class="cit-section-title">إعدادات التنفيذ</h2>
                        <p class="cit-section-sub">نوع التدخل وطريقة التسليم والجهة المستهدفة</p>
                    </div>
                </div>
                <div class="cit-form-grid">
                    <div class="cit-field">
                        <label asp-for="TaskType" class="cit-label">
                            نوع المهمة <span class="cit-required">*</span>
                        </label>
                        <select asp-for="TaskType" asp-items="Model.TaskTypeOptions" class="cit-select"></select>
                        <span asp-validation-for="TaskType" class="cit-error"></span>
                    </div>
                    <div class="cit-field">
                        <label asp-for="DeliveryMode" class="cit-label">
                            طريقة التنفيذ <span class="cit-required">*</span>
                        </label>
                        <select asp-for="DeliveryMode" asp-items="Model.DeliveryModeOptions" class="cit-select"></select>
                        <span asp-validation-for="DeliveryMode" class="cit-error"></span>
                    </div>
                    <div class="cit-field">
                        <label asp-for="TargetType" class="cit-label">
                            الجهة المستهدفة <span class="cit-required">*</span>
                        </label>
                        <select asp-for="TargetType" asp-items="Model.TargetTypeOptions" class="cit-select"></select>
                        <span asp-validation-for="TargetType" class="cit-error"></span>
                    </div>
                    <div class="cit-field">
                        <label asp-for="Priority" class="cit-label">
                            الأولوية <span class="cit-required">*</span>
                        </label>
                        <div class="cit-priority-group" id="priorityGroup">
                            @foreach (var opt in Model.PriorityOptions)
                            {
                                var isSelected = opt.Value == Model.Priority;
                                var pIcon = opt.Value == "Critical" ? "fa-fire" : opt.Value == "High" ? "fa-arrow-up" : opt.Value == "Normal" ? "fa-minus" : "fa-arrow-down";
                                var pColor = opt.Value == "Critical" ? "cit-pri-critical" : opt.Value == "High" ? "cit-pri-high" : opt.Value == "Normal" ? "cit-pri-normal" : "cit-pri-low";
                                <label class="cit-pri-btn @pColor @(isSelected ? "cit-pri-active" : "")">
                                    <input type="radio" asp-for="Priority" value="@opt.Value" class="cit-pri-radio" />
                                    <i class="fas @pIcon me-1"></i>@opt.Text
                                </label>
                            }
                        </div>
                        <span asp-validation-for="Priority" class="cit-error"></span>
                    </div>
                    <div class="cit-field">
                        <label asp-for="DueDate" class="cit-label">تاريخ الاستحقاق</label>
                        <input asp-for="DueDate" type="date" class="cit-input" />
                        <span asp-validation-for="DueDate" class="cit-error"></span>
                    </div>
                </div>
            </section>

            @* ─── Section 3: المدرب ──────────────────────────────────── *@
            <section class="cit-section">
                <div class="cit-section-head">
                    <span class="cit-section-num">٣</span>
                    <div>
                        <h2 class="cit-section-title">المدرب المسؤول</h2>
                        <p class="cit-section-sub">اختر المدرب الذي سيتولى تنفيذ هذا التدخل</p>
                    </div>
                </div>
                <div class="cit-form-grid">
                    <div class="cit-field cit-field-half">
                        <label asp-for="InstructorId" class="cit-label">المدرب</label>
                        <select asp-for="InstructorId" asp-items="Model.InstructorOptions" class="cit-select">
                            <option value="">— بدون تحديد —</option>
                        </select>
                        <span asp-validation-for="InstructorId" class="cit-error"></span>
                    </div>
                </div>
            </section>

            @* ─── Section 4: خريطة المحاضرات ────────────────────────── *@
            <section class="cit-section">
                <div class="cit-section-head">
                    <span class="cit-section-num">٤</span>
                    <div>
                        <h2 class="cit-section-title">محاضرة التنفيذ</h2>
                        <p class="cit-section-sub">اختر المحاضرة المناسبة — التوصية تُفضّل أول محاضرة قادمة</p>
                    </div>
                    @if (Model.RecommendedNextLectureId.HasValue)
                    {
                        <span class="cit-rec-note">
                            <i class="fas fa-wand-magic-sparkles me-1"></i>تم تحديد المحاضرة القادمة تلقائياً
                        </span>
                    }
                </div>

                @if (!Model.LectureMap.Any())
                {
                    <div class="cit-empty-lectures">
                        <i class="fas fa-calendar-xmark fa-2x mb-2 d-block" style="color:#d1d5db"></i>
                        لا توجد محاضرات مجدولة لهذه الدفعة حالياً
                        <small class="d-block mt-1">يمكن إنشاء المهمة بدون ربطها بمحاضرة</small>
                    </div>
                }
                else
                {
                    <div class="cit-lecture-grid">

                        @* No lecture option *@
                        <label class="cit-lec-card cit-lec-none @(Model.LectureId == null ? "cit-lec-selected" : "")">
                            <input type="radio" asp-for="LectureId" value="" class="cit-lec-radio" />
                            <div class="cit-lec-icon cit-lec-icon-none">
                                <i class="fas fa-ban"></i>
                            </div>
                            <div class="cit-lec-body">
                                <div class="cit-lec-title">بدون ربط بمحاضرة</div>
                                <div class="cit-lec-meta">يمكن تحديد المحاضرة لاحقاً</div>
                            </div>
                        </label>

                        @foreach (var lec in Model.LectureMap)
                        {
                            var isSelected = Model.LectureId == lec.LectureId;
                            var statusCss = lec.StatusText == "اليوم" ? "cit-lec-today"
                                          : lec.StatusText == "قادمة" ? "cit-lec-upcoming"
                                          : "cit-lec-past";
                            var iconCss = lec.StatusText == "اليوم" ? "cit-lec-icon-today"
                                        : lec.StatusText == "قادمة" ? "cit-lec-icon-upcoming"
                                        : "cit-lec-icon-past";
                            var faIcon  = lec.StatusText == "اليوم" ? "fa-star"
                                        : lec.StatusText == "قادمة" ? "fa-calendar-plus"
                                        : "fa-calendar-check";
                            <label class="cit-lec-card @statusCss @(isSelected ? "cit-lec-selected" : "") @(lec.IsRecommendedNextLecture ? "cit-lec-recommended" : "")">
                                <input type="radio" asp-for="LectureId" value="@lec.LectureId" class="cit-lec-radio" />
                                <div class="cit-lec-icon @iconCss">
                                    <i class="fas @faIcon"></i>
                                </div>
                                <div class="cit-lec-body">
                                    <div class="cit-lec-title">
                                        @(string.IsNullOrWhiteSpace(lec.Title) ? $"محاضرة #{lec.LectureId}" : lec.Title)
                                    </div>
                                    <div class="cit-lec-meta">
                                        <i class="fas fa-calendar me-1"></i>@lec.Date.ToString("yyyy/MM/dd — HH:mm")
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(lec.InstructorName))
                                    {
                                        <div class="cit-lec-meta">
                                            <i class="fas fa-user-tie me-1"></i>@lec.InstructorName
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(lec.CurriculumTitle))
                                    {
                                        <div class="cit-lec-meta">
                                            <i class="fas fa-book me-1"></i>@lec.CurriculumTitle
                                        </div>
                                    }
                                    <div class="cit-lec-badges">
                                        <span class="cit-lec-status-badge cit-lec-sb-@(lec.StatusText == "اليوم" ? "today" : lec.StatusText == "قادمة" ? "upcoming" : "past")">
                                            @lec.StatusText
                                        </span>
                                        @if (lec.IsRecommendedNextLecture)
                                        {
                                            <span class="cit-lec-status-badge cit-lec-sb-rec">
                                                <i class="fas fa-wand-magic-sparkles me-1"></i>مقترحة
                                            </span>
                                        }
                                    </div>
                                </div>
                            </label>
                        }
                    </div>
                }
                <span asp-validation-for="LectureId" class="cit-error mt-2 d-block"></span>
            </section>

            @* ─── Section 5: تعليمات المالك ──────────────────────────── *@
            <section class="cit-section">
                <div class="cit-section-head">
                    <span class="cit-section-num">٥</span>
                    <div>
                        <h2 class="cit-section-title">تعليمات المالك</h2>
                        <p class="cit-section-sub">التوجيهات التفصيلية للمدرب — ما الذي تتوقع منه بالضبط؟</p>
                    </div>
                </div>
                <div class="cit-form-grid">
                    <div class="cit-field cit-field-full">
                        <label asp-for="OwnerInstructions" class="cit-label">
                            التعليمات <span class="cit-required">*</span>
                        </label>
                        <textarea asp-for="OwnerInstructions" class="cit-textarea cit-textarea-lg"
                                  rows="6"
                                  placeholder="اكتب تعليماتك للمدرب... مثال: أعد شرح درس التفاضل مع التركيز على الأسئلة من نوع التطبيق، وراجع الأخطاء الشائعة في الاختبار السابق."></textarea>
                        <span asp-validation-for="OwnerInstructions" class="cit-error"></span>
                    </div>
                </div>
            </section>

        </div>@* /cit-form-body *@

        @* ── STICKY ACTION BAR ─────────────────────────────────────── *@
        <div class="cit-action-bar">
            <div class="cit-action-inner">
                <div class="cit-action-left">
                    <a class="cit-btn cit-btn-ghost"
                       asp-area="Admin" asp-controller="DecisionLab" asp-action="RecommendationDetails"
                       asp-route-id="@Model.DecisionRecommendationId">
                        <i class="fas fa-arrow-right me-1"></i>إلغاء
                    </a>
                </div>
                <div class="cit-action-right">
                    <span class="cit-action-hint">
                        <i class="fas fa-shield-check me-1"></i>المهمة لن تُنفَّذ تلقائياً — تحتاج قبولاً من المدرب
                    </span>
                    <button type="submit" class="cit-btn cit-btn-primary" id="citSubmitBtn">
                        <i class="fas fa-paper-plane me-2"></i>إنشاء مهمة التدخل
                        <i class="fas fa-arrow-left ms-1"></i>
                    </button>
                </div>
            </div>
        </div>

    </form>
</div>

@* ══════════════════════════════════════════════════════════════════
   CHART
══════════════════════════════════════════════════════════════════ *@
@if (hasSnap)
{
    <script>
    (function () {
        if (typeof Chart === 'undefined') return;

        const canvas = document.getElementById('citRiskRadar');
        if (!canvas) return;

        const att  = +canvas.dataset.att  || 0;
        const hw   = +canvas.dataset.hw   || 0;
        const exam = +canvas.dataset.exam || 0;
        const weak = +canvas.dataset.weak || 0;
        const q    = +canvas.dataset.q    || 0;

        new Chart(canvas, {
            type: 'radar',
            data: {
                labels: ['الحضور', 'الواجبات', 'الاختبارات', 'الدروس الضعيفة', 'الأسئلة الحرجة'],
                datasets: [{
                    label: 'درجة الخطر',
                    data: [att, hw, exam, weak, q],
                    backgroundColor: 'rgba(220,38,38,.12)',
                    borderColor: '#dc2626',
                    borderWidth: 2,
                    pointBackgroundColor: '#dc2626',
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        rtl: true,
                        callbacks: { label: ctx => ` ${ctx.raw.toFixed(0)}% خطر` }
                    }
                },
                scales: {
                    r: {
                        beginAtZero: true,
                        max: 100,
                        ticks: { display: false, stepSize: 25 },
                        grid: { color: 'rgba(0,0,0,.08)' },
                        pointLabels: {
                            font: { family: 'Cairo', size: 11, weight: '700' },
                            color: '#374151'
                        }
                    }
                },
                animation: { duration: 900, easing: 'easeInOutQuart' }
            }
        });
    })();
    </script>
}

@* ── Priority radio interaction ──────────────────────────────── *@
<script>
(function () {
    const radios = document.querySelectorAll('.cit-pri-radio');
    radios.forEach(r => {
        r.addEventListener('change', () => {
            document.querySelectorAll('.cit-pri-btn').forEach(b => b.classList.remove('cit-pri-active'));
            r.closest('.cit-pri-btn')?.classList.add('cit-pri-active');
        });
    });

    // Lecture card selection highlight
    document.querySelectorAll('.cit-lec-radio').forEach(r => {
        r.addEventListener('change', () => {
            document.querySelectorAll('.cit-lec-card').forEach(c => c.classList.remove('cit-lec-selected'));
            r.closest('.cit-lec-card')?.classList.add('cit-lec-selected');
        });
    });

    // Submit loading state
    const form = document.getElementById('citForm');
    const btn  = document.getElementById('citSubmitBtn');
    if (form && btn) {
        form.addEventListener('submit', () => {
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>جاري الحفظ...';
        });
    }
})();
</script>

@* ══════════════════════════════════════════════════════════════════
