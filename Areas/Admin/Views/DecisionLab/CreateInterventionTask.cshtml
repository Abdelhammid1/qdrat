    .cit-lec-icon-upcoming { background: #dbeafe; color: #1e40af; }
    .cit-lec-icon-past     { background: #f3f4f6; color: #9ca3af; }

    .cit-lec-radio { display: none; }
    .cit-lec-body { min-width: 0; flex: 1; }
    .cit-lec-title {
        font-size: 13px;
        font-weight: 900;
        color: var(--cit-text);
        margin-bottom: 4px;
        white-space: nowrap;
