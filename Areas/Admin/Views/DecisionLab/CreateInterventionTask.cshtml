        border-radius: 999px;
        font-size: 11px;
        font-weight: 900;
        padding: 2px 8px;
    }
    .cit-lec-sb-today    { background: #fef3c7; color: #92400e; }
    .cit-lec-sb-upcoming { background: #dbeafe; color: #1e3a8a; }
    .cit-lec-sb-past     { background: #f3f4f6; color: #6b7280; }
    .cit-lec-sb-rec      { background: #dcfce7; color: #166534; }

    /* ── Sticky action bar ───────────────────────────────────────── */
    .cit-action-bar {
        position: fixed;
        bottom: 0; left: 0; right: 0;
        background: rgba(255,255,255,.95);
        backdrop-filter: blur(12px);
        border-top: 1px solid var(--cit-border);
        box-shadow: 0 -4px 24px rgba(0,0,0,.08);
        padding: 14px 32px;
        z-index: 100;
    }
    .cit-action-inner {
        max-width: 1400px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }
    .cit-action-right {
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .cit-btn-ghost.cit-action-cancel {
        background: #f3f4f6;
        color: #374151;
        border: 1.5px solid var(--cit-border);
    }
    .cit-btn-ghost.cit-action-cancel:hover { background: #e5e7eb; }
    .cit-action-hint {
        font-size: 13px;
        font-weight: 700;
        color: var(--cit-muted);
    }

    /* ── Responsive ──────────────────────────────────────────────── */
    @@media (max-width: 1100px) {
        .cit-context-strip {
            grid-template-columns: 1fr 1fr;
        }
        .cit-chart-panel { grid-column: 1 / -1; flex-direction: row; gap: 24px; }
        .cit-radar-wrap  { width: 160px; height: 160px; }
    }
    @@media (max-width: 900px) {
        .cit-context-strip { grid-template-columns: 1fr; padding: 16px 20px; }
        .cit-form-body     { padding: 0 20px; }
        .cit-validation-summary { padding: 0 20px; }
        .cit-form-grid { grid-template-columns: 1fr 1fr; }
        .cit-field-half { grid-column: span 2; }
        .cit-lecture-grid { grid-template-columns: 1fr 1fr; }
        .cit-action-bar { padding: 12px 20px; }
        .cit-header { padding: 20px 20px 18px; }
    }
    @@media (max-width: 600px) {
        .cit-form-grid { grid-template-columns: 1fr; }
        .cit-field-half { grid-column: 1 / -1; }
        .cit-lecture-grid { grid-template-columns: 1fr; }
        .cit-action-inner { flex-direction: column; align-items: stretch; gap: 10px; }
        .cit-action-right { flex-direction: column; gap: 8px; }
        .cit-btn-primary { justify-content: center; }
        .cit-header-inner { flex-direction: column; }
        .cit-header-title { font-size: 20px; }
        .cit-section { padding: 18px 16px; }
    }

    /* ── Dark mode ───────────────────────────────────────────────── */
    @@media (prefers-color-scheme: dark) {
        :root {
            --cit-bg:      #0f172a;
