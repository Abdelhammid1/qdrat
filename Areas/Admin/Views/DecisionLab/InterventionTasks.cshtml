@model QdratNew.ViewModels.Admin.DecisionLab.InterventionTaskListViewModel
<link rel="stylesheet" href="~/css/decision-analytics-ui.css" asp-append-version="true" />

@{
    ViewData["Title"] = "متابعة مهام التدخل";
}

<div class="decision-lab-page qd-page" dir="rtl">
    <section class="dl-header">
        <div>
            <span class="dl-eyebrow">DecisionLab</span>
            <h1>متابعة مهام التدخل</h1>
            <p>عرض مهام التدخل التعليمية المسندة من توصيات DecisionLab ومتابعة حالتها التشغيلية.</p>
        </div>
        <div class="dl-header-actions">
            <a class="btn btn-outline-primary"
               asp-area="Admin"
               asp-controller="Analytics"
               asp-action="AdvancedDashboard">
                مراجعة Analytics
            </a>
            <a class="btn btn-outline-secondary"
               asp-area="Admin"
               asp-controller="DecisionLab"
               asp-action="Index">
                رجوع
            </a>
            <a class="btn btn-outline-primary"
               asp-area="Admin"
               asp-controller="DecisionLab"
               asp-action="SavedRecommendations">
                التوصيات المحفوظة
            </a>
        </div>
    </section>

    <section class="dl-kpis">
        <div class="dl-kpi qd-kpi">
            <span>إجمالي المهام</span>
            <strong>@Model.TotalTasks</strong>
            <small>كل مهام التدخل</small>
        </div>
        <div class="dl-kpi qd-kpi">
            <span>المهام المسندة</span>
            <strong>@Model.AssignedTasks</strong>
            <small>Assigned</small>
        </div>
        <div class="dl-kpi qd-kpi">
            <span>قيد التنفيذ</span>
            <strong>@Model.InProgressTasks</strong>
            <small>InProgress</small>
        </div>
        <div class="dl-kpi qd-kpi">
            <span>المكتملة</span>
            <strong>@Model.CompletedByInstructorTasks</strong>
            <small>CompletedByInstructor</small>
        </div>
        <div class="dl-kpi qd-kpi">
            <span>المتأخرة</span>
            <strong>@Model.OverdueTasks</strong>
            <small>حسب تاريخ الاستحقاق</small>
        </div>
    </section>

    <section class="dl-panel">
        <div class="dl-section-title">
            <h2>قائمة مهام التدخل</h2>
            <span>@Model.Tasks.Count مهمة</span>
        </div>

        @if (!Model.Tasks.Any())
        {
            <div class="dl-empty qd-empty">لا توجد مهام تدخل تعليمية حتى الآن.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle qd-table">
                    <thead>
                        <tr>
                            <th>عنوان المهمة</th>
                            <th>الدفعة</th>
                            <th>المدرب</th>
                            <th>المحاضرة المستهدفة</th>
                            <th>نوع المهمة</th>
                            <th>طريقة التنفيذ</th>
                            <th>الأولوية</th>
                            <th>الحالة</th>
                            <th>تاريخ الاستحقاق</th>
                            <th>تاريخ الإنشاء</th>
                            <th>الإجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in Model.Tasks)
                        {
                            <tr class="@(task.IsOverdue ? "dl-overdue-row" : string.Empty)">
                                <td class="dl-task-title">@task.Title</td>
                                <td>
                                    <a asp-area="Admin"
                                       asp-controller="Analytics"
                                       asp-action="BatchPerformanceDetails"
                                       asp-route-batchId="@task.BatchId"
                                       asp-route-curriculumId="@task.CurriculumId"
                                       class="text-decoration-none fw-bold">
                                        @task.BatchName
                                    </a>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(task.InstructorName) ? "-" : task.InstructorName)</td>
                                <td>@(string.IsNullOrWhiteSpace(task.LectureTitle) ? "-" : task.LectureTitle)</td>
                                <td>@task.TaskType</td>
                                <td>@task.DeliveryMode</td>
                                <td>@task.Priority</td>
                                <td>
                                    <span class="dl-status qd-badge">@task.Status</span>
                                </td>
                                <td>
                                    @if (task.DueDate.HasValue)
                                    {
                                        <span class="@(task.IsOverdue ? "dl-date-danger" : string.Empty)">
                                            @task.DueDate.Value.ToString("yyyy/MM/dd")
                                        </span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td>@task.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-area="Admin"
                                       asp-controller="DecisionLab"
                                       asp-action="InterventionTaskDetails"
                                       asp-route-id="@task.Id">
                                        عرض التفاصيل
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

<style>
    .decision-lab-page {
        background: #f5f7fb;
        color: #111827;
        font-family: 'Cairo', Tahoma, Arial, sans-serif;
        padding: 24px;
    }

    .dl-header,
    .dl-panel,
    .dl-kpi {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 20px;
    }

    .dl-header {
        align-items: center;
        display: flex;
        gap: 16px;
        justify-content: space-between;
        margin-bottom: 16px;
    }

    .dl-header h1 {
        font-size: 24px;
        font-weight: 800;
        margin: 4px 0 6px;
    }

    .dl-header p,
    .dl-eyebrow,
    .dl-section-title span,
    .dl-kpi small {
        color: #6b7280;
    }

    .dl-header-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .dl-eyebrow {
        font-size: 13px;
        font-weight: 800;
    }

    .dl-kpis {
        display: grid;
        gap: 12px;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        margin-bottom: 16px;
    }

    .dl-kpi span,
    .dl-kpi small {
        display: block;
    }

    .dl-kpi strong {
        display: block;
        font-size: 26px;
        margin: 6px 0;
    }

    .dl-section-title {
        align-items: center;
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
    }

    .dl-section-title h2 {
        font-size: 18px;
        font-weight: 800;
        margin: 0;
    }

    .dl-task-title {
        font-weight: 800;
        min-width: 220px;
    }

    .dl-overdue-row {
        background: #fff7ed;
    }

    .dl-date-danger {
        color: #b91c1c;
        font-weight: 900;
    }

    @@media (max-width: 1200px) {
        .dl-kpis {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .decision-lab-page {
            padding: 12px;
        }

        .dl-header {
            display: block;
        }

        .dl-header-actions {
            margin-top: 12px;
        }

        .dl-kpis {
            grid-template-columns: 1fr;
        }
    }
</style>
