@model QdratNew.ViewModels.Admin.DecisionLab.DecisionLabIndexViewModel
<link rel="stylesheet" href="~/css/decision-analytics-ui.css" asp-append-version="true" />

@{
    ViewData["Title"] = "DecisionLab";
}

<div class="decision-lab-page qd-page" dir="rtl">
    <section class="dl-header">
        <div>
            <span class="dl-eyebrow">DecisionLab</span>
            <h1>مرحلة تشغيل تحليل قرارات الدفعات</h1>
            <p>اختر الدفعة، ويمكن تمرير رقم المنهج عند توفره، ثم افتح التحليل أو معاينة التوصية.</p>
        </div>
        <div class="dl-header-actions">
            <a class="btn btn-outline-secondary"
               asp-area="Admin"
               asp-controller="DecisionLab"
               asp-action="SavedRecommendations">
                التوصيات المحفوظة
            </a>
            <a class="btn btn-outline-primary"
               asp-area="Admin"
               asp-controller="DecisionLab"
               asp-action="InterventionTasks">
                متابعة مهام التدخل
            </a>
            <small>آخر توليد: @Model.GeneratedAt.ToString("yyyy/MM/dd HH:mm")</small>
        </div>
    </section>

    <section class="dl-panel">
        <form method="get" asp-area="Admin" asp-controller="DecisionLab" asp-action="Index" class="dl-filter-form">
            <div>
                <label for="batchId">الدفعة</label>
                <select id="batchId" name="batchId" class="form-select">
                    <option value="">اختر الدفعة</option>
                    @foreach (var batch in Model.Batches)
                    {
                        <option value="@batch.BatchId" selected="@(Model.SelectedBatchId == batch.BatchId)">
                            @batch.BatchName - @batch.CourseName
                        </option>
                    }
                </select>
            </div>

            <div>
                <label for="curriculumId">المنهج</label>
                <input id="curriculumId"
                       name="curriculumId"
                       class="form-control"
                       type="number"
                       min="1"
                       value="@Model.SelectedCurriculumId"
                       placeholder="اختياري" />
            </div>

            <div class="dl-actions">
                <button type="submit" class="btn btn-primary">عرض الاختيار</button>
                @if (Model.SelectedBatchId.HasValue)
                {
                    <a class="btn btn-outline-primary"
                       asp-area="Admin"
                       asp-controller="DecisionLab"
                       asp-action="BatchAnalysis"
                       asp-route-batchId="@Model.SelectedBatchId"
                       asp-route-curriculumId="@Model.SelectedCurriculumId">
                        تحليل الدفعة
                    </a>
                    <a class="btn btn-outline-secondary"
                       asp-area="Admin"
                       asp-controller="DecisionLab"
                       asp-action="RecommendationPreview"
                       asp-route-batchId="@Model.SelectedBatchId"
                       asp-route-curriculumId="@Model.SelectedCurriculumId">
                        معاينة التوصية
                    </a>
                }
            </div>
        </form>
    </section>

    @if (!Model.Batches.Any())
    {
        <section class="dl-empty qd-empty">لا توجد دفعات متاحة للعرض حاليًا.</section>
    }
    else
    {
        <section class="dl-panel">
            <div class="dl-section-title">
                <h2>الدفعات المتاحة</h2>
                <span>@Model.Batches.Count دفعة</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle qd-table">
                    <thead>
                        <tr>
                            <th>الدفعة</th>
                            <th>المقرر</th>
                            <th>الطلاب النشطون</th>
                            <th>الإجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var batch in Model.Batches)
                        {
                            <tr>
                                <td>@batch.BatchName</td>
                                <td>@batch.CourseName</td>
                                <td>@batch.ActiveStudentsCount</td>
                                <td>
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-area="Admin"
                                       asp-controller="DecisionLab"
                                       asp-action="BatchAnalysis"
                                       asp-route-batchId="@batch.BatchId"
                                       asp-route-curriculumId="@Model.SelectedCurriculumId">
                                        فتح التحليل
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

<style>
    .decision-lab-page {
        background: #f5f7fb;
        color: #111827;
        font-family: 'Cairo', Tahoma, Arial, sans-serif;
        padding: 24px;
    }

    .dl-header,
    .dl-panel,
    .dl-empty {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        margin-bottom: 16px;
        padding: 20px;
    }

    .dl-header {
        align-items: center;
        display: flex;
        justify-content: space-between;
        gap: 16px;
    }

    .dl-header h1 {
        font-size: 24px;
        font-weight: 800;
        margin: 4px 0 6px;
    }

    .dl-header p,
    .dl-header small,
    .dl-eyebrow,
    .dl-section-title span {
        color: #6b7280;
    }

    .dl-eyebrow {
        font-size: 13px;
        font-weight: 800;
    }

    .dl-filter-form {
        align-items: end;
        display: grid;
        gap: 14px;
        grid-template-columns: minmax(220px, 1fr) minmax(160px, 220px) auto;
    }

    .dl-filter-form label {
        display: block;
        font-weight: 800;
        margin-bottom: 6px;
    }

    .dl-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .dl-header-actions {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: flex-end;
    }

    .dl-section-title {
        align-items: center;
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
    }

    .dl-section-title h2 {
        font-size: 18px;
        font-weight: 800;
        margin: 0;
    }

    .dl-empty {
        color: #6b7280;
        font-weight: 700;
        text-align: center;
    }

    @@media (max-width: 768px) {
        .decision-lab-page {
            padding: 12px;
        }

        .dl-header,
        .dl-filter-form {
            display: block;
        }

        .dl-filter-form > div {
            margin-bottom: 12px;
        }
    }
</style>
