@model QdratNew.ViewModels.Course.CourseStatisticsViewModel

@{
    ViewData["Title"] = "لوحة تحكم الدورات";
}

<h2 class="text-black"><i class="fas fa-chart-line"></i> لوحة تحكم الدورات</h2>

<div class="row">
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <h5 class="card-title">📌 عدد الدورات</h5>
                <p class="card-text display-4">@Model.TotalCourses</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <h5 class="card-title">✅ الدورات النشطة</h5>
                <p class="card-text display-4">@Model.ActiveCourses</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-danger mb-3">
            <div class="card-body">
                <h5 class="card-title">❌ الدورات غير النشطة</h5>
                <p class="card-text display-4">@Model.InactiveCourses</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-warning mb-3">
            <div class="card-body">
                <h5 class="card-title">🔥 الدورة الأكثر تسجيلًا</h5>
                <p class="card-text display-4">@Model.MostPopularCourse</p>
            </div>
        </div>
    </div>
</div>

<h3 class="mt-5"><i class="fas fa-chart-bar"></i> تحليل الاتجاهات المستقبلية</h3>
<table class="table table-bordered">
    <thead class="table-dark">
        <tr>
            <th>📌 ID الدورة</th>
            <th>📅 الشهر</th>
            <th>📈 عدد المسجلين</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var trend in Model.CourseTrends)
        {
            <tr>
                <td>@trend.CourseId</td>
                <td>@trend.Month</td>
                <td>@trend.Registrations</td>
            </tr>
        }
    </tbody>
</table>
<h3 class="mt-5"><i class="fas fa-chart-line"></i> توقعات الإقبال على الدورات</h3>
<table class="table table-bordered">
    <thead class="table-dark">
        <tr>
            <th>📅 الشهر</th>
            <th>📈 التوقعات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var prediction in Model.CoursePredictions)
        {
            <tr>
                <td>@prediction.Key</td>
                <td>@prediction.Value</td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="Courses" asp-action="Index" class="btn btn-dark mt-3">
    <i class="fas fa-arrow-left"></i> الرجوع إلى الدورات
</a>
