@model QdratNew.ViewModels.Lesson.CompletedLessonsDetailsViewModel

@{
    ViewData["Title"] = "تفاصيل المؤشرات المنتهية";
}

<div class="container mt-4">
    <h3 class="text-center mb-4">
        📋 تفاصيل المؤشرات المنتهية:
        <span class="text-info">@Model.CompletionTitle</span>
    </h3>

    <table class="table table-bordered table-striped">
        <thead class="thead-dark">
            <tr>
                <th>الطالب</th>
                <th>عدد الأسئلة</th>
                <th>تمت الإجابة</th>
                <th>الصحيحة</th>
                <th>النسبة</th>
                <th>الحالة</th>
                <th>عرض التفاصيل</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Students != null && Model.Students.Any())
            {
                foreach (var student in Model.Students)
                {
                    <tr>
                        <td>@student.StudentName</td>
                        <td>@student.QuestionCount</td>
                        <td>@student.AnsweredCount</td>
                        <td>@student.CorrectCount</td>
                        <td>@student.Percentage %</td>
                        <td>@student.Status</td>
                        <td>
                            <a class="btn btn-sm btn-info"
                               href="/Admin/BatchLessonCompletions/HomeworkDetails?studentId=@student.StudentId&batchId=@Model.BatchId&completionTitle=@Model.CompletionTitle">
                                📋 تفاصيل
                            </a>

                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-danger">لا توجد بيانات.</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-center mt-3">
        <a href="/Admin/BatchLessonCompletions/CompletedLessonsReport" class="btn btn-secondary">
            🔙 العودة للتقارير
        </a>
    </div>
</div>
