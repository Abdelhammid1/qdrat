@model QdratNew.ViewModels.Lesson.CompletedLessonsDetailsViewModel

@{
    ViewData["Title"] = "تفاصيل إجابات الطالب";
}

<link href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" rel="stylesheet" />
<link href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css" rel="stylesheet" />

<div class="container mt-4">
    <h4 class="mb-4 text-center">📘 تفاصيل الأسئلة التي تم حلها</h4>
    <div class="row text-center mb-4">
        <div class="col-md-4 mb-4">
            <div class="card border-primary shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">👤 الطالب</h6>
                    <h5 class="fw-bold">@Model.StudentName</h5>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card border-secondary shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">🎓 الدفعة</h6>
                    <h5 class="fw-bold">@Model.BatchName</h5>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card border-dark shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">📋 الأسئلة</h6>
                    <h5 class="fw-bold">@Model.QuestionCount</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card border-warning shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">✍️ المجابة</h6>
                    <h5 class="fw-bold">@Model.AnsweredCount</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card border-success shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">✅ الصحيحة</h6>
                    <h5 class="fw-bold">@Model.CorrectCount</h5>
                </div>
            </div>
        </div>

        <div class="col-md-3 md-4">
            <div class="card border-info shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">📊 النسبة</h6>
                    <h5 class="fw-bold">@Model.Percentage %</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card border-@(Model.Status.Contains("✅") ? "success" : Model.Status.Contains("⚠️") ? "warning" : "danger") shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">🧭 الحالة</h6>
                    <h5 class="fw-bold">@Model.Status</h5>
                </div>
            </div>
        </div>
    </div>

  

    <table id="detailsTable" class="display nowrap table table-bordered text-center" style="width:100%">
        <thead class="thead-dark">
            <tr>
                <th>#</th>
                <th>السؤال</th>
                <th>إجابة الطالب</th>
                <th>الإجابة الصحيحة</th>
                <th>الحالة</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.HomeworkDetails.Count; i++)
            {
                var item = Model.HomeworkDetails[i];
                <tr class="@(item.IsCorrect ? "table-success" : "table-danger")">
                    <td>@(i + 1)</td>
                    <td>
                        <button class="btn btn-sm btn-outline-info" onclick="showQuestionPreview('@item.QuestionId')">
                            <i class="fas fa-eye"></i>
                        </button>
                        <span class="ms-2">@((item.QuestionText?.Length > 15) ? item.QuestionText.Substring(0, 15) + "..." : item.QuestionText)</span>
                    </td>

                    <td>@item.StudentAnswer</td>
                    <td>@Html.Raw(item.CorrectAnswer)</td>
                    <td>@(item.IsCorrect ? "✅ صحيحة" : "❌ خاطئة")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-center mt-4">
        <a href="javascript:history.back()" class="btn btn-secondary">🔙 العودة</a>
    </div>
</div>

<!-- ✅ Modal Preview -->
<div class="modal fade" id="questionPreviewModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content text-end">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title"><i class="fas fa-eye me-2"></i> معاينة السؤال</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="questionPreviewModalBody">
                <div class="text-center p-4">جارٍ تحميل السؤال...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.colVis.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>

    <script>
        $(document).ready(function () {
            $('#detailsTable').DataTable({
                dom: 'Bfrtip',
                buttons: ['copy', 'excel', 'print'],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/ar.json'
                }
            });
        });

        function showQuestionPreview(id) {
            fetch(`/Admin/Questions/Preview/${id}`)
                .then(res => res.text())
                .then(html => {
                    document.getElementById('questionPreviewModalBody').innerHTML = html;
                    new bootstrap.Modal(document.getElementById('questionPreviewModal')).show();
                })
                .catch(() => {
                    document.getElementById('questionPreviewModalBody').innerHTML = '<div class="text-danger text-center p-3">حدث خطأ أثناء تحميل السؤال.</div>';
                    new bootstrap.Modal(document.getElementById('questionPreviewModal')).show();
                });
        }
    </script>
}
