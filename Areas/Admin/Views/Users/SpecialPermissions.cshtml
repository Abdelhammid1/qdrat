@model QdratNew.ViewModels.Users.UserSpecialPermissionsVM

@{
    ViewData["Title"] = "الصلاحيات المتخصصة — " + Model.UserName;
}

<style>
    .sp-page { max-width: 680px; margin: 32px auto; padding: 0 16px; font-family: var(--font, 'Cairo', sans-serif); direction: rtl; }

    .sp-header { display: flex; align-items: center; gap: 14px; margin-bottom: 28px; }
    .sp-avatar {
        width: 52px; height: 52px; border-radius: 50%;
        background: linear-gradient(135deg,#f59e0b,#d97706);
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: 1.3rem; font-weight: 700; flex-shrink: 0;
    }
    .sp-user-name  { font-size: 1.1rem; font-weight: 700; color: #0D1B2A; }
    .sp-user-meta  { font-size: .82rem; color: #6b7280; margin-top: 2px; }
    .sp-role-badge {
        display: inline-block; padding: 2px 10px; border-radius: 20px;
        font-size: .75rem; font-weight: 600;
        background: #fef3c7; color: #92400e; margin-top: 4px;
    }

    .sp-section { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; margin-bottom: 20px; overflow: hidden; }
    .sp-section-head {
        padding: 14px 18px; border-bottom: 1px solid #f3f4f6;
        font-weight: 700; font-size: .9rem; color: #374151;
        display: flex; align-items: center; gap: 8px;
    }
    .sp-section-head i { color: #f59e0b; font-size: 1rem; }

    .sp-perm-row {
        display: flex; align-items: flex-start; justify-content: space-between;
        padding: 16px 18px; gap: 16px;
        border-bottom: 1px solid #f9fafb;
    }
    .sp-perm-row:last-child { border-bottom: none; }

    .sp-perm-info { flex: 1; }
    .sp-perm-label { font-weight: 600; font-size: .9rem; color: #111827; }
    .sp-perm-desc  { font-size: .8rem; color: #6b7280; margin-top: 3px; line-height: 1.5; }

    /* Toggle switch */
    .sp-toggle { position: relative; display: inline-block; width: 46px; height: 26px; flex-shrink: 0; }
    .sp-toggle input { opacity: 0; width: 0; height: 0; }
    .sp-slider {
        position: absolute; cursor: pointer; inset: 0;
        background: #d1d5db; border-radius: 26px; transition: .25s;
    }
    .sp-slider::before {
        content: ''; position: absolute;
        width: 20px; height: 20px; left: 3px; bottom: 3px;
        background: #fff; border-radius: 50%; transition: .25s;
        box-shadow: 0 1px 4px rgba(0,0,0,.15);
    }
    .sp-toggle input:checked + .sp-slider { background: #059669; }
    .sp-toggle input:checked + .sp-slider::before { transform: translateX(20px); }

    .sp-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 8px; }
    .btn-sp-save {
        padding: 9px 28px; background: #059669; color: #fff;
        border: none; border-radius: 10px; font-weight: 700;
        font-size: .9rem; cursor: pointer; transition: background .2s;
    }
    .btn-sp-save:hover { background: #047857; }
    .btn-sp-back {
        padding: 9px 20px; background: #f3f4f6; color: #374151;
        border: none; border-radius: 10px; font-weight: 600;
        font-size: .9rem; cursor: pointer; text-decoration: none;
        display: inline-flex; align-items: center; gap: 6px;
    }
    .btn-sp-back:hover { background: #e5e7eb; color: #111827; }

    .sp-alert { padding: 12px 16px; border-radius: 10px; margin-bottom: 20px; font-size: .88rem; }
    .sp-alert-success { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
    .sp-warn-note {
        background: #fffbeb; border: 1px solid #fcd34d; border-radius: 10px;
        padding: 10px 14px; font-size: .8rem; color: #92400e;
        display: flex; gap: 8px; align-items: flex-start; margin-bottom: 20px;
    }
</style>

<div class="sp-page">

    <div class="sp-header">
        <div class="sp-avatar">
            @(string.IsNullOrEmpty(Model.UserName) ? "?" : Model.UserName.Trim()[0].ToString().ToUpper())
        </div>
        <div>
            <div class="sp-user-name">@Model.UserName</div>
            <div class="sp-user-meta">@Model.UserEmail</div>
            @if (!string.IsNullOrEmpty(Model.UserRole))
            {
                <span class="sp-role-badge">@Model.UserRole</span>
            }
        </div>
        <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn-sp-back me-auto ms-0">
            <i class="bi bi-arrow-right"></i> رجوع
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="sp-alert sp-alert-success">
            <i class="bi bi-check-circle-fill me-1"></i>
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="sp-warn-note">
        <i class="bi bi-exclamation-triangle-fill" style="color:#f59e0b;flex-shrink:0;margin-top:1px"></i>
        <span>هذه الصلاحيات استثنائية وتُمنح بقرار من المالك أو المبرمج. تأكد قبل تفعيل أي منها.</span>
    </div>

    <form asp-area="Admin" asp-controller="Users" asp-action="SpecialPermissions" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="UserId" value="@Model.UserId" />
        <input type="hidden" name="UserName" value="@Model.UserName" />
        <input type="hidden" name="UserEmail" value="@Model.UserEmail" />
        <input type="hidden" name="UserRole" value="@Model.UserRole" />

        <div class="sp-section">
            <div class="sp-section-head">
                <i class="bi bi-stars"></i>
                صلاحيات الوصول الاستثنائي
            </div>

            <div class="sp-perm-row">
                <div class="sp-perm-info">
                    <div class="sp-perm-label">الدخول كمستخدم (Impersonation)</div>
                    <div class="sp-perm-desc">
                        يمكّن هذا المستخدم من الدخول بحساب أي مستخدم آخر عبر زر "الدخول كمستخدم" في صفحة التفاصيل.
                        خاصية حساسة — لا تُمنح إلا لمن تثق به تماماً.
                    </div>
                </div>
                <label class="sp-toggle">
                    <input type="checkbox" name="CanImpersonate" value="true"
                           @(Model.CanImpersonate ? "checked" : "") />
                    <span class="sp-slider"></span>
                </label>
            </div>

            @* مساحة للصلاحيات الإضافية مستقبلاً *@
        </div>

        <div class="sp-actions">
            <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn-sp-back">
                <i class="bi bi-x"></i> إلغاء
            </a>
            <button type="submit" class="btn-sp-save">
                <i class="bi bi-floppy me-1"></i> حفظ الصلاحيات
            </button>
        </div>
    </form>

</div>
