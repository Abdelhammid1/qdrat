@model QdratNew.ViewModels.Users.EditUserViewModel
@using QdratNew.Enums
@{
    ViewData["Title"] = "تعديل مستخدم";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <style>
        :root {
            --ink: #0D1B2A; --ink-2: #2C3E50; --ink-3: #5A6A7A; --ink-4: #8FA0B0;
            --canvas: #F3F6FA; --surface: #fff; --surface-2: #F8FAFC; --surface-3: #EEF2F7;
            --border: #DDE4EC;
            --blue: #1B5EAE; --blue-2: #2471D0; --blue-dark: #103E7A; --blue-bg: #E8F1FB;
            --emerald: #0D7A5B; --emerald-bg: #E4F5EE;
            --amber: #985D09;  --amber-bg: #FDF0D8;
            --rose: #BF1030;   --rose-bg: #FDEAEE;
            --r-md: 10px; --r-lg: 14px; --r-xl: 20px;
            --sh-xs: 0 1px 3px rgba(13,27,42,.06);
            --sh-sm: 0 2px 8px rgba(13,27,42,.08);
            --sh-md: 0 4px 18px rgba(13,27,42,.10);
            --ease: cubic-bezier(.25,.46,.45,.94);
        }

        body { background: var(--canvas); font-family: 'Cairo', sans-serif; direction: rtl; color: var(--ink-2); }

        /* ── Page wrap ── */
        .edit-page { padding: 1.75rem 1.5rem; }

        /* ── Header ── */
        .pg-header {
            display: flex; align-items: center; gap: 14px;
            margin-bottom: 1.75rem; flex-wrap: wrap;
        }
        .pg-icon {
            width: 52px; height: 52px; border-radius: 14px;
            background: var(--blue-bg); color: var(--blue);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.4rem; flex-shrink: 0;
        }
        .pg-title { font-size: 1.15rem; font-weight: 700; color: var(--ink); }
        .pg-sub   { font-size: .8rem; color: var(--ink-3); margin-top: 2px; }
        .pg-sub a { color: var(--blue); text-decoration: none; }
        .pg-sub a:hover { text-decoration: underline; }

        /* ── Section card ── */
        .sec-card {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: var(--r-xl); box-shadow: var(--sh-xs);
            overflow: hidden; margin-bottom: 1.25rem;
        }
        .sec-head {
            display: flex; align-items: center; justify-content: space-between;
            padding: .9rem 1.25rem; border-bottom: 1px solid var(--border);
            flex-wrap: wrap; gap: 8px;
        }
        .sec-head-left { display: flex; align-items: center; gap: 9px; }
        .sec-icon {
            width: 34px; height: 34px; border-radius: 9px;
            display: flex; align-items: center; justify-content: center;
            font-size: .95rem; flex-shrink: 0;
        }
        .si-blue    { background: var(--blue-bg);    color: var(--blue); }
        .si-emerald { background: var(--emerald-bg); color: var(--emerald); }
        .si-amber   { background: var(--amber-bg);   color: var(--amber); }
        .si-rose    { background: var(--rose-bg);    color: var(--rose); }

        .sec-title { font-size: .92rem; font-weight: 700; color: var(--ink); margin: 0; }
        .sec-sub   { font-size: .75rem; color: var(--ink-4); margin-top: 1px; }

        .sec-badge {
            display: inline-flex; align-items: center;
            padding: 3px 10px; border-radius: 20px; font-size: .72rem; font-weight: 700;
            background: var(--blue-bg); color: var(--blue);
        }

        .sec-body { padding: 1.25rem; }

        /* ── Fields ── */
        .fld-label {
            font-size: .83rem; font-weight: 700; color: var(--ink-2);
            display: block; margin-bottom: .4rem;
        }
        .fld-wrap { position: relative; }
        .fld-wrap i.fld-ico {
            position: absolute; right: 11px; top: 50%;
            transform: translateY(-50%); color: var(--ink-4);
            font-size: .85rem; pointer-events: none; z-index: 3;
        }
        .fld-wrap .fld-ctrl {
            width: 100%; min-height: 42px; padding: .5rem .9rem .5rem 2.4rem;
            border: 1px solid var(--border); border-radius: var(--r-md);
            font-size: .85rem; font-family: 'Cairo', sans-serif;
            background: var(--surface); color: var(--ink);
            transition: border-color .15s, box-shadow .15s;
        }
        .fld-wrap .fld-ctrl:focus {
            outline: none; border-color: var(--blue-2);
            box-shadow: 0 0 0 3px rgba(36,113,208,.1);
        }
        .fld-wrap select.fld-ctrl { appearance: none; cursor: pointer; }
        .fld-hint { font-size: .74rem; color: var(--ink-4); margin-top: .3rem; }
        .fld-err  { font-size: .75rem; color: var(--rose);  margin-top: .3rem; }

        /* Validation summary */
        .val-summary {
            background: var(--rose-bg); border: 1px solid #f4b8c4;
            border-radius: var(--r-lg); padding: .85rem 1rem;
            font-size: .83rem; color: var(--rose); margin-bottom: 1.25rem;
        }
        .val-summary:empty { display: none; }
        .val-summary ul { margin: .35rem 0 0 0; padding-right: 1.2rem; }

        /* ── Avatar box ── */
        .avatar-panel {
            border: 1px solid var(--border); border-radius: var(--r-lg);
            padding: 1rem; background: var(--surface-2); text-align: center;
        }
        .avatar-preview {
            width: 130px; height: 130px; border-radius: var(--r-xl);
            object-fit: cover; border: 3px solid var(--surface);
            box-shadow: var(--sh-md); display: block; margin: 0 auto .75rem;
        }

        /* ── Switch panel ── */
        .switch-panel {
            background: var(--surface-2); border: 1px solid var(--border);
            border-radius: var(--r-lg); padding: 1rem 1.1rem;
            display: flex; align-items: center; gap: 12px; margin-bottom: 1.25rem;
        }
        .switch-panel .form-check-input {
            width: 44px; height: 23px; cursor: pointer; flex-shrink: 0; margin: 0;
        }
        .switch-panel .form-check-label {
            font-size: .88rem; font-weight: 700; color: var(--ink); cursor: pointer;
        }
        .switch-panel small { font-size: .75rem; color: var(--ink-4); display: block; margin-top: 2px; }

        /* ── Multi-select ── */
        .multi-select {
            border: 1px solid var(--border); border-radius: var(--r-md);
            font-size: .84rem; font-family: 'Cairo', sans-serif;
            padding: .4rem; width: 100%; color: var(--ink);
        }
        .multi-select:focus { outline: none; border-color: var(--blue-2); box-shadow: 0 0 0 3px rgba(36,113,208,.1); }
        .count-badge {
            display: inline-flex; align-items: center; justify-content: center;
            min-width: 24px; height: 20px; padding: 0 6px;
            background: var(--blue); color: #fff;
            border-radius: 20px; font-size: .7rem; font-weight: 700;
        }

        /* ── Note box ── */
        .note-box {
            display: flex; align-items: flex-start; gap: 8px;
            padding: .75rem 1rem; border-radius: var(--r-md);
            font-size: .8rem; font-weight: 600;
        }
        .note-warning { background: var(--amber-bg); color: var(--amber); border: 1px solid #f3c46b; }

        /* ── Sticky footer actions ── */
        .sticky-actions {
            position: sticky; bottom: 14px; z-index: 20;
            display: flex; justify-content: flex-end; gap: .75rem; flex-wrap: wrap;
            padding: .85rem 1.1rem; margin-top: .5rem;
            background: rgba(255,255,255,.92); backdrop-filter: blur(10px);
            border: 1px solid var(--border); border-radius: var(--r-xl);
            box-shadow: var(--sh-md);
        }

        .btn-save {
            display: inline-flex; align-items: center; gap: 6px;
            background: var(--emerald); color: #fff; border: none;
            padding: .55rem 1.4rem; border-radius: var(--r-md);
            font-size: .88rem; font-weight: 700; font-family: 'Cairo', sans-serif;
            cursor: pointer; min-height: 42px;
            transition: background .15s var(--ease), transform .12s;
        }
        .btn-save:hover { background: #0a6349; transform: translateY(-1px); }

        .btn-back {
            display: inline-flex; align-items: center; gap: 6px;
            background: var(--surface); color: var(--ink-3);
            border: 1px solid var(--border); padding: .55rem 1.1rem;
            border-radius: var(--r-md); font-size: .85rem; font-weight: 600;
            font-family: 'Cairo', sans-serif; text-decoration: none; min-height: 42px;
            transition: background .15s;
        }
        .btn-back:hover { background: var(--surface-2); color: var(--ink); }

        @@media (max-width: 768px) {
            .edit-page  { padding: 1rem; }
            .sec-body   { padding: 1rem; }
            .sticky-actions { flex-direction: column-reverse; }
            .btn-save, .btn-back { width: 100%; justify-content: center; }
        }
    </style>
}

<div class="edit-page">

    <!-- Page Header -->
    <div class="pg-header">
        <div class="pg-icon"><i class="bi bi-person-gear"></i></div>
        <div>
            <div class="pg-title">تعديل بيانات المستخدم</div>
            <div class="pg-sub">
                <a asp-action="Index">مستخدمو المنصة</a>
                <i class="bi bi-chevron-left" style="font-size:.6rem;margin:0 4px"></i>
                تعديل
            </div>
        </div>
        <a asp-action="Index" class="btn-back ms-auto">
            <i class="bi bi-arrow-right"></i> رجوع
        </a>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" autocomplete="off">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <!-- Validation summary -->
        <div asp-validation-summary="ModelOnly" class="val-summary" role="alert"></div>

        <!-- ── Section 1: Account Info ── -->
        <div class="sec-card">
            <div class="sec-head">
                <div class="sec-head-left">
                    <div class="sec-icon si-blue"><i class="bi bi-person-vcard"></i></div>
                    <div>
                        <div class="sec-title">معلومات الحساب</div>
                        <div class="sec-sub">البيانات الأساسية المستخدمة في الدخول والتعريف</div>
                    </div>
                </div>
                <span class="sec-badge">حساب النظام</span>
            </div>
            <div class="sec-body">
                <div class="row g-3">
                    <div class="col-lg-6 col-md-6">
                        <label asp-for="FullName" class="fld-label">الاسم الكامل</label>
                        <div class="fld-wrap">
                            <i class="bi bi-person fld-ico"></i>
                            <input asp-for="FullName" class="fld-ctrl" placeholder="اكتب الاسم الكامل" />
                        </div>
                        <span asp-validation-for="FullName" class="fld-err"></span>
                    </div>
                    <div class="col-lg-6 col-md-6">
                        <label asp-for="UserName" class="fld-label">اسم المستخدم</label>
                        <div class="fld-wrap">
                            <i class="bi bi-at fld-ico"></i>
                            <input asp-for="UserName" class="fld-ctrl" placeholder="اسم المستخدم" />
                        </div>
                        <span asp-validation-for="UserName" class="fld-err"></span>
                    </div>
                    <div class="col-lg-6 col-md-6">
                        <label asp-for="Email" class="fld-label">البريد الإلكتروني</label>
                        <div class="fld-wrap">
                            <i class="bi bi-envelope fld-ico"></i>
                            <input asp-for="Email" class="fld-ctrl" placeholder="example@email.com" />
                        </div>
                        <span asp-validation-for="Email" class="fld-err"></span>
                    </div>
                    <div class="col-lg-6 col-md-6">
                        <label asp-for="NationalID" class="fld-label">الرقم القومي / الهوية</label>
                        <div class="fld-wrap">
                            <i class="bi bi-credit-card fld-ico"></i>
                            <input asp-for="NationalID" class="fld-ctrl" placeholder="رقم الهوية" />
                        </div>
                        <span asp-validation-for="NationalID" class="fld-err"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Section 2: Contact ── -->
        <div class="sec-card">
            <div class="sec-head">
                <div class="sec-head-left">
                    <div class="sec-icon si-emerald"><i class="bi bi-telephone"></i></div>
                    <div>
                        <div class="sec-title">بيانات الاتصال</div>
                        <div class="sec-sub">أرقام التواصل المباشر مع المستخدم</div>
                    </div>
                </div>
            </div>
            <div class="sec-body">
                <div class="row g-3">
                    <div class="col-lg-6 col-md-6">
                        <label asp-for="PhoneNumber" class="fld-label">رقم الجوال</label>
                        <div class="fld-wrap">
                            <i class="bi bi-phone fld-ico"></i>
                            <input asp-for="PhoneNumber" class="fld-ctrl" placeholder="05xxxxxxxx" />
                        </div>
                        <span asp-validation-for="PhoneNumber" class="fld-err"></span>
                    </div>
                    <div class="col-lg-6 col-md-6">
                        <label asp-for="WhatsAppNumber" class="fld-label">رقم الواتساب</label>
                        <div class="fld-wrap">
                            <i class="bi bi-whatsapp fld-ico"></i>
                            <input asp-for="WhatsAppNumber" class="fld-ctrl" placeholder="05xxxxxxxx" />
                        </div>
                        <span asp-validation-for="WhatsAppNumber" class="fld-err"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Section 3: Options ── -->
        <div class="sec-card">
            <div class="sec-head">
                <div class="sec-head-left">
                    <div class="sec-icon si-amber"><i class="bi bi-sliders"></i></div>
                    <div>
                        <div class="sec-title">الخيارات الإضافية</div>
                        <div class="sec-sub">الجنس وحالة تفعيل الحساب</div>
                    </div>
                </div>
            </div>
            <div class="sec-body">
                <div class="row g-3">
                    <div class="col-lg-6 col-md-6">
                        <label asp-for="Gender" class="fld-label">الجنس</label>
                        <div class="fld-wrap">
                            <i class="bi bi-gender-ambiguous fld-ico"></i>
                            <select asp-for="Gender" class="fld-ctrl" asp-items="Html.GetEnumSelectList<GenderType>()"></select>
                        </div>
                        <span asp-validation-for="Gender" class="fld-err"></span>
                    </div>
                    <div class="col-lg-6 col-md-6">
                        <label asp-for="IsActive" class="fld-label">حالة الحساب</label>
                        <div class="fld-wrap">
                            <i class="bi bi-toggle-on fld-ico"></i>
                            <select asp-for="IsActive" class="fld-ctrl">
                                <option value="true">نشط</option>
                                <option value="false">غير نشط</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Section 4: Profile Image ── -->
        <div class="sec-card">
            <div class="sec-head">
                <div class="sec-head-left">
                    <div class="sec-icon si-blue"><i class="bi bi-image"></i></div>
                    <div>
                        <div class="sec-title">الصورة الشخصية</div>
                        <div class="sec-sub">أبقِ الحالية أو ارفع صورة جديدة</div>
                    </div>
                </div>
            </div>
            <div class="sec-body">
                <div class="row g-3 align-items-center">
                    <div class="col-lg-3 col-md-4">
                        <div class="avatar-panel">
                            <img id="previewImg"
                                 src="@(!string.IsNullOrEmpty(Model.ExistingImagePath) ? Model.ExistingImagePath : Url.Content("~/images/avatar-male.png"))"
                                 alt="الصورة الحالية"
                                 class="avatar-preview" />
                            <div style="font-size:.75rem;color:var(--ink-4)">الصورة الحالية</div>
                        </div>
                    </div>
                    <div class="col-lg-9 col-md-8">
                        <label class="fld-label">رفع صورة جديدة</label>
                        <div class="fld-wrap">
                            <i class="bi bi-upload fld-ico" style="top:13px;transform:none"></i>
                            <input type="file" name="ProfileImage" id="ProfileImage"
                                   class="fld-ctrl" accept="image/*"
                                   style="padding-top:.5rem" />
                        </div>
                        <div class="fld-hint" style="margin-top:.5rem">
                            <i class="bi bi-info-circle me-1" style="color:var(--blue)"></i>
                            الحد الأقصى المقترح 1MB — صيغ JPG / PNG
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Section 5: Student ── -->
        <div class="sec-card">
            <div class="sec-head">
                <div class="sec-head-left">
                    <div class="sec-icon si-emerald"><i class="bi bi-mortarboard"></i></div>
                    <div>
                        <div class="sec-title">تفعيل المستخدم كطالب</div>
                        <div class="sec-sub">فعّل هذا القسم إذا كان المستخدم مرتبطاً بكيان طالب</div>
                    </div>
                </div>
                <span class="sec-badge" style="background:var(--emerald-bg);color:var(--emerald)">البيانات الأكاديمية</span>
            </div>
            <div class="sec-body">

                <div class="switch-panel">
                    <div class="form-check form-switch p-0 m-0">
                        <input class="form-check-input" type="checkbox" asp-for="IsStudent" id="IsStudentSwitch" />
                    </div>
                    <label for="IsStudentSwitch" class="form-check-label" style="cursor:pointer;font-weight:700;color:var(--ink)">
                        تفعيل هذا المستخدم كطالب
                        <small>عند التفعيل تظهر حقول الفرع، ولي الأمر، الدفعات، المدرسة والمستوى</small>
                    </label>
                </div>

                <div id="studentSection" style="display:@(Model.IsStudent ? "block" : "none")">
                    <div class="row g-3">

                        <div class="col-lg-4 col-md-6">
                            <label asp-for="BranchId" class="fld-label">الفرع</label>
                            <div class="fld-wrap">
                                <i class="bi bi-building fld-ico"></i>
                                <select asp-for="BranchId" asp-items="Model.Branches" class="fld-ctrl"></select>
                            </div>
                            <span asp-validation-for="BranchId" class="fld-err"></span>
                        </div>

                        <div class="col-lg-4 col-md-6">
                            <label asp-for="ParentId" class="fld-label">ولي الأمر <span style="color:var(--ink-4);font-weight:500">(اختياري)</span></label>
                            <div class="fld-wrap">
                                <i class="bi bi-person-hearts fld-ico"></i>
                                <select asp-for="ParentId" asp-items="Model.Parents" class="fld-ctrl">
                                    <option value="">— بدون —</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-lg-4 col-md-6">
                            <label asp-for="Age" class="fld-label">العمر</label>
                            <div class="fld-wrap">
                                <i class="bi bi-calendar2 fld-ico"></i>
                                <input asp-for="Age" class="fld-ctrl" placeholder="السن" type="number" min="5" max="99" />
                            </div>
                            <span asp-validation-for="Age" class="fld-err"></span>
                        </div>

                        <div class="col-12">
                            <label class="fld-label">
                                الدفعات
                                <span class="count-badge" id="batchCountBadge" style="margin-right:6px">0</span>
                            </label>
                            <select asp-for="SelectedBatchIds" asp-items="Model.Batches"
                                    class="multi-select" multiple size="7"></select>
                            <div class="fld-hint">
                                <i class="bi bi-info-circle me-1" style="color:var(--blue)"></i>
                                يمكنك اختيار عدة دفعات بالضغط على Ctrl + Click
                            </div>
                        </div>

                        <div class="col-lg-6 col-md-6">
                            <label asp-for="School" class="fld-label">المدرسة</label>
                            <div class="fld-wrap">
                                <i class="bi bi-building-fill fld-ico"></i>
                                <input asp-for="School" class="fld-ctrl" placeholder="اسم المدرسة" />
                            </div>
                            <span asp-validation-for="School" class="fld-err"></span>
                        </div>

                        <div class="col-lg-6 col-md-6">
                            <label asp-for="Level" class="fld-label">المستوى الدراسي</label>
                            <div class="fld-wrap">
                                <i class="bi bi-layers fld-ico"></i>
                                <input asp-for="Level" class="fld-ctrl" placeholder="المستوى الدراسي" />
                            </div>
                            <span asp-validation-for="Level" class="fld-err"></span>
                        </div>

                        <div class="col-12">
                            <div class="note-box note-warning">
                                <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1"></i>
                                <span>حقول العمر، المدرسة، والمستوى مطلوبة فقط عند تفعيل المستخدم كطالب.</span>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>

        <!-- ── Sticky Actions ── -->
        <div class="sticky-actions">
            <a asp-action="Index" class="btn-back">
                <i class="bi bi-arrow-right"></i> رجوع
            </a>
            <button type="submit" class="btn-save">
                <i class="bi bi-floppy"></i> حفظ التعديلات
            </button>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var sw  = document.getElementById('IsStudentSwitch');
            var sec = document.getElementById('studentSection');
            if (sw && sec) {
                sw.addEventListener('change', function () {
                    sec.style.display = sw.checked ? 'block' : 'none';
                });
            }
        })();

        (function () {
            var fileInput = document.getElementById('ProfileImage');
            var preview   = document.getElementById('previewImg');
            if (fileInput && preview) {
                fileInput.addEventListener('change', function (e) {
                    var file = e.target.files && e.target.files[0];
                    if (!file) return;
                    var reader = new FileReader();
                    reader.onload = function (ev) { preview.src = ev.target.result; };
                    reader.readAsDataURL(file);
                });
            }
        })();

        (function () {
            var multi = document.getElementById('SelectedBatchIds');
            var badge = document.getElementById('batchCountBadge');
            function updateCount() {
                if (!multi || !badge) return;
                badge.textContent = Array.from(multi.options).filter(function (o) { return o.selected; }).length;
            }
            if (multi) { multi.addEventListener('change', updateCount); updateCount(); }
        })();
    </script>
}
