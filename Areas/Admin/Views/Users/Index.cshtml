@model QdratNew.ViewModels.Users.UsersListViewModel
@using QdratNew.ViewModels.Users
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "مستخدمو المنصة";
}

<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

<style>
/* ╔══════════════════════════════════════════════════════════╗
   ║  DESIGN SYSTEM — Users Index (Fresh Build)               ║
   ╚══════════════════════════════════════════════════════════╝ */
:root {
    --c-brand:        #2563EB;
    --c-brand-d:      #1D4ED8;
    --c-brand-l:      #EFF6FF;
    --c-brand-xl:     #DBEAFE;

    --c-emerald:      #059669;
    --c-emerald-l:    #ECFDF5;
    --c-rose:         #DC2626;
    --c-rose-l:       #FEF2F2;
    --c-amber:        #D97706;
    --c-amber-l:      #FFFBEB;
    --c-violet:       #7C3AED;
    --c-violet-l:     #F5F3FF;
    --c-sky:          #0284C7;
    --c-sky-l:        #F0F9FF;

    --c-bg:           #F1F5F9;
    --c-surface:      #FFFFFF;
    --c-surface-2:    #F8FAFC;
    --c-border:       #E2E8F0;
    --c-border-2:     #CBD5E1;

    --c-ink-1:        #0F172A;
    --c-ink-2:        #1E293B;
    --c-ink-3:        #475569;
    --c-ink-4:        #94A3B8;
    --c-ink-5:        #CBD5E1;

    --r-xs:  4px;
    --r-sm:  8px;
    --r-md: 12px;
    --r-lg: 16px;
    --r-xl: 22px;
    --r-2xl:28px;
    --r-full:9999px;

    --sh-card: 0 1px 3px rgba(15,23,42,.06), 0 1px 2px rgba(15,23,42,.04);
    --sh-lift: 0 4px 12px rgba(15,23,42,.10), 0 2px 4px rgba(15,23,42,.06);
    --sh-pop:  0 12px 28px rgba(15,23,42,.14), 0 4px 8px rgba(15,23,42,.08);

    --ease:        cubic-bezier(.25,.46,.45,.94);
    --ease-spring: cubic-bezier(.34,1.56,.64,1);
    --t-fast:  150ms;
    --t-base:  220ms;
    --t-slow:  350ms;

    --font: 'Cairo', 'Segoe UI', system-ui, sans-serif;
}

/* ── Reset & Base ── */
*, *::before, *::after { box-sizing: border-box; }
body {
    margin: 0;
    font-family: var(--font);
    background: var(--c-bg);
    color: var(--c-ink-2);
    direction: rtl;
    -webkit-font-smoothing: antialiased;
}

/* ╔══════════════════════════════════════════════════════════╗
   ║  PAGE SHELL                                              ║
   ╚══════════════════════════════════════════════════════════╝ */
.um {
    max-width: 1440px;
    margin: 0 auto;
    padding: 28px 24px 100px;  /* bottom pad for action bar */
}

/* ╔══════════════════════════════════════════════════════════╗
   ║  PAGE HEADER                                             ║
   ╚══════════════════════════════════════════════════════════╝ */
.um-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
    flex-wrap: wrap;
}

.um-head__brand {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: 1;
}

.um-head__badge {
    width: 52px;
    height: 52px;
    border-radius: var(--r-lg);
    background: linear-gradient(135deg, var(--c-brand) 0%, #60A5FA 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 1.4rem;
    flex-shrink: 0;
    box-shadow: 0 4px 14px rgba(37,99,235,.35);
}

.um-head__title {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--c-ink-1);
    letter-spacing: -.3px;
    margin: 0;
    line-height: 1.2;
}

.um-head__crumb {
    font-size: .75rem;
    color: var(--c-ink-4);
    margin-top: 3px;
    display: flex;
    align-items: center;
    gap: 5px;
    flex-wrap: wrap;
}

.um-head__crumb a {
    color: var(--c-brand);
    text-decoration: none;
    font-weight: 600;
}

.um-head__crumb a:hover { text-decoration: underline; }

.um-head__actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }

/* Buttons */
.btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 18px;
    border-radius: var(--r-md);
    font-size: .84rem;
    font-weight: 700;
    font-family: var(--font);
    cursor: pointer;
    border: none;
    text-decoration: none;
    transition: background var(--t-fast) var(--ease),
                transform var(--t-fast),
                box-shadow var(--t-fast);
    white-space: nowrap;
}

.btn--primary {
    background: var(--c-brand);
    color: #fff;
    box-shadow: 0 2px 8px rgba(37,99,235,.28);
}
.btn--primary:hover {
    background: var(--c-brand-d);
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(37,99,235,.36);
}

.btn--ghost {
    background: var(--c-surface);
    color: var(--c-ink-3);
    border: 1px solid var(--c-border);
    box-shadow: var(--sh-card);
}
.btn--ghost:hover {
    background: var(--c-surface-2);
    color: var(--c-ink-2);
    border-color: var(--c-border-2);
}

/* ╔══════════════════════════════════════════════════════════╗
   ║  METRICS STRIP                                           ║
   ╚══════════════════════════════════════════════════════════╝ */
.um-metrics {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
    margin-bottom: 24px;
}

.metric {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    padding: 16px 18px;
    display: flex;
    align-items: center;
    gap: 14px;
    cursor: pointer;
    transition: transform var(--t-base) var(--ease-spring),
                box-shadow var(--t-base) var(--ease),
                border-color var(--t-fast);
    box-shadow: var(--sh-card);
    position: relative;
    overflow: hidden;
    font-family: var(--font);
    border-top: 0;
    text-align: right;
}

.metric::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    border-radius: 0;
    background: transparent;
    transition: background var(--t-fast);
}

.metric:hover {
    transform: translateY(-3px);
    box-shadow: var(--sh-lift);
}

.metric.is-active { box-shadow: var(--sh-lift); border-color: var(--c-border-2); }

.metric--blue.is-active::before   { background: var(--c-brand); }
.metric--green.is-active::before  { background: var(--c-emerald); }
.metric--red.is-active::before    { background: var(--c-rose); }
.metric--sky.is-active::before    { background: var(--c-sky); }
.metric--amber.is-active::before  { background: var(--c-amber); }

.metric__icon {
    width: 44px;
    height: 44px;
    border-radius: var(--r-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    flex-shrink: 0;
    transition: transform var(--t-base) var(--ease-spring);
}
.metric:hover .metric__icon { transform: scale(1.1); }

.metric--blue  .metric__icon { background: var(--c-brand-xl);  color: var(--c-brand); }
.metric--green .metric__icon { background: var(--c-emerald-l); color: var(--c-emerald); }
.metric--red   .metric__icon { background: var(--c-rose-l);    color: var(--c-rose); }
.metric--sky   .metric__icon { background: var(--c-sky-l);     color: var(--c-sky); }
.metric--amber .metric__icon { background: var(--c-amber-l);   color: var(--c-amber); }

.metric__body {}
.metric__label { font-size: .71rem; font-weight: 600; color: var(--c-ink-4); margin-bottom: 4px; text-transform: uppercase; letter-spacing: .04em; }
.metric__value { font-size: 1.55rem; font-weight: 900; line-height: 1; color: var(--c-ink-1); }
.metric__hint  { font-size: .68rem;  font-weight: 500; color: var(--c-ink-5); margin-top: 3px; }

/* ╔══════════════════════════════════════════════════════════╗
   ║  CONTROLS BAR                                            ║
   ╚══════════════════════════════════════════════════════════╝ */
.um-controls {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    flex-wrap: wrap;
}

.search-wrap {
    position: relative;
    flex: 1;
    min-width: 280px;
}

.search-wrap__icon {
    position: absolute;
    right: 13px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--c-ink-4);
    font-size: .9rem;
    pointer-events: none;
    transition: color var(--t-fast);
}

.search-input {
    width: 100%;
    height: 42px;
    padding: 0 40px 0 14px;
    background: var(--c-surface);
    border: 1.5px solid var(--c-border);
    border-radius: var(--r-md);
    font-family: var(--font);
    font-size: .85rem;
    color: var(--c-ink-2);
    transition: border-color var(--t-fast), box-shadow var(--t-fast);
    outline: none;
}

.search-input:focus {
    border-color: var(--c-brand);
    box-shadow: 0 0 0 3px rgba(37,99,235,.12);
}

.search-input:focus + .search-wrap__icon { color: var(--c-brand); }

.filter-pills {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    align-items: center;
}

.batch-filter-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
}
.batch-filter-wrap__icon {
    position: absolute;
    right: 10px;
    color: var(--c-brand);
    font-size: .85rem;
    pointer-events: none;
}
.batch-filter-select {
    padding: 6px 32px 6px 14px;
    border-radius: var(--r-full);
    border: 1.5px solid var(--c-border);
    background: var(--c-surface);
    color: var(--c-ink-2);
    font-size: .78rem;
    font-weight: 700;
    font-family: var(--font);
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    transition: border-color var(--t-fast) var(--ease), box-shadow var(--t-fast) var(--ease);
    min-width: 160px;
}
.batch-filter-select:focus {
    outline: none;
    border-color: var(--c-brand);
    box-shadow: 0 0 0 3px rgba(37,99,235,.12);
}
.batch-filter-select.has-value {
    border-color: var(--c-brand);
    background: var(--c-brand-l);
    color: var(--c-brand-d);
}

.pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 14px;
    border-radius: var(--r-full);
    font-size: .78rem;
    font-weight: 700;
    font-family: var(--font);
    cursor: pointer;
    border: 1.5px solid var(--c-border);
    background: var(--c-surface);
    color: var(--c-ink-3);
    transition: all var(--t-fast) var(--ease);
    white-space: nowrap;
}

.pill:hover { border-color: var(--c-border-2); color: var(--c-ink-2); background: var(--c-surface-2); }

.pill.is-active {
    background: var(--c-brand);
    border-color: var(--c-brand);
    color: #fff;
    box-shadow: 0 2px 8px rgba(37,99,235,.28);
}

/* ╔══════════════════════════════════════════════════════════╗
   ║  TABLE — FLOATING CARD ROWS                              ║
   ╚══════════════════════════════════════════════════════════╝ */
.um-table-card {
    background: transparent;
    border: none;
    box-shadow: none;
    border-radius: 0;
    overflow: visible;
}

.um-table-card table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 7px;
    font-size: .855rem;
}

/* ── Header ── */
.um-table-card thead { background: transparent; border-bottom: none; }
.um-table-card thead tr { background: transparent; }
.um-table-card thead th {
    padding: 6px 16px 18px;
    text-align: right;
    font-size: .64rem;
    font-weight: 800;
    color: var(--c-ink-4);
    text-transform: uppercase;
    letter-spacing: .09em;
    white-space: nowrap;
    user-select: none;
    background: transparent;
    border: none;
    border-bottom: 2px solid var(--c-border);
}

/* ── Floating Card Rows ── */
.um-table-card tbody tr {
    background: var(--c-surface);
    box-shadow: 0 1px 4px rgba(15,23,42,.06), 0 1px 2px rgba(15,23,42,.04);
    cursor: pointer;
    transition: transform var(--t-base) var(--ease-spring),
                box-shadow var(--t-base) var(--ease);
}
.um-table-card tbody tr:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(15,23,42,.10), 0 3px 8px rgba(15,23,42,.05);
}
.um-table-card tbody tr.is-selected {
    box-shadow: 0 0 0 2px var(--c-brand), 0 6px 22px rgba(37,99,235,.16);
    transform: translateY(-1px);
}
.um-table-card tbody tr.is-selected:hover {
    box-shadow: 0 0 0 2px var(--c-brand), 0 12px 32px rgba(37,99,235,.22);
    transform: translateY(-3px);
}

.um-table-card tbody td {
    padding: 15px 16px;
    vertical-align: middle;
    color: var(--c-ink-3);
    background: inherit;
    border-top: 1px solid var(--c-border);
    border-bottom: 1px solid var(--c-border);
    transition: background var(--t-fast);
}

/* RTL: td:first-child = rightmost → right-side radius */
.um-table-card tbody td:first-child {
    border-right: 1px solid var(--c-border);
    border-radius: 0 var(--r-lg) var(--r-lg) 0;
}
/* RTL: td:last-child = leftmost → left-side radius */
.um-table-card tbody td:last-child {
    border-left: 1px solid var(--c-border);
    border-radius: var(--r-lg) 0 0 var(--r-lg);
}

.um-table-card tbody tr.is-selected td {
    background: var(--c-brand-l) !important;
    border-color: rgba(37,99,235,.18);
}

/* Checkbox */
th.col-cb, td.col-cb {
    width: 46px;
    text-align: center !important;
    padding: 15px 10px !important;
}
.row-cb {
    width: 17px;
    height: 17px;
    accent-color: var(--c-brand);
    cursor: pointer;
    display: block;
    margin: 0 auto;
}

/* ── User Cell ── */
.user-cell { display: flex; align-items: center; gap: 12px; }
.user-av {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .8rem;
    font-weight: 800;
    flex-shrink: 0;
    letter-spacing: .02em;
    box-shadow: 0 2px 8px rgba(0,0,0,.10);
}
.av-1 { background: linear-gradient(135deg,#DBEAFE,#BFDBFE); color: #1D4ED8; }
.av-2 { background: linear-gradient(135deg,#D1FAE5,#A7F3D0); color: #065F46; }
.av-3 { background: linear-gradient(135deg,#FCE7F3,#FBCFE8); color: #9D174D; }
.av-4 { background: linear-gradient(135deg,#EDE9FE,#DDD6FE); color: #5B21B6; }
.av-5 { background: linear-gradient(135deg,#FEF3C7,#FDE68A); color: #92400E; }

.user-name  { font-weight: 700; color: var(--c-ink-1); font-size: .875rem; line-height: 1.25; }
.user-email { font-size: .7rem; color: var(--c-ink-4); margin-top: 2px; }

/* ── Badges ── */
.nat-id-wrap {
    display: inline-flex;
    align-items: center;
    gap: 5px;
}
.nat-id {
    font-family: 'Courier New', monospace;
    font-size: .78rem;
    background: var(--c-surface-2);
    border: 1px solid var(--c-border);
    padding: 4px 10px;
    border-radius: var(--r-sm);
    color: var(--c-ink-3);
    letter-spacing: .06em;
}
.nat-copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--c-ink-5);
    font-size: .78rem;
    cursor: pointer;
    transition: color var(--t-fast), transform var(--t-fast);
    flex-shrink: 0;
    line-height: 1;
}
.nat-copy:hover { color: var(--c-brand); transform: scale(1.2); }
.nat-copy.copied { color: var(--c-emerald); }

.role-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 11px;
    border-radius: var(--r-sm);
    font-size: .69rem;
    font-weight: 800;
    letter-spacing: .01em;
}
.role-admin      { background: var(--c-brand-xl);   color: var(--c-brand);   border: 1px solid rgba(37,99,235,.15); }
.role-instructor { background: var(--c-violet-l);   color: var(--c-violet);  border: 1px solid rgba(124,58,237,.15); }
.role-student    { background: var(--c-emerald-l);  color: var(--c-emerald); border: 1px solid rgba(5,150,105,.15); }
.role-multi      { background: var(--c-amber-l);    color: var(--c-amber);   border: 1px solid rgba(217,119,6,.15); }
.role-none       { background: var(--c-surface-2);  color: var(--c-ink-4);   border: 1px solid var(--c-border); }

.batch-tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--c-sky-l);
    color: var(--c-sky);
    padding: 3px 9px;
    border-radius: var(--r-full);
    font-size: .7rem;
    font-weight: 700;
    border: 1px solid rgba(2,132,199,.12);
}
.more-batches {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    background: var(--c-surface-2);
    border: 1px solid var(--c-border);
    color: var(--c-ink-4);
    padding: 3px 8px;
    border-radius: var(--r-full);
    font-size: .7rem;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--t-fast);
}
.more-batches:hover { border-color: var(--c-border-2); color: var(--c-ink-3); }

/* ── Status Pill ── */
.status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: var(--r-full);
    font-size: .73rem;
    font-weight: 700;
    white-space: nowrap;
}
.status-pill--on  { background: var(--c-emerald-l); color: var(--c-emerald); border: 1px solid rgba(5,150,105,.15); }
.status-pill--off { background: var(--c-rose-l);    color: var(--c-rose);    border: 1px solid rgba(220,38,38,.15); }
.s-pulse {
    width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0;
    background: currentColor;
    animation: sPulse 2s ease-in-out infinite;
}
@@keyframes sPulse { 0%,100% { opacity:1; transform:scale(1); } 50% { opacity:.45; transform:scale(.7); } }

.login-time { font-size: .76rem; color: var(--c-ink-4); }

/* ── DataTables overrides ── */
.dataTables_wrapper .dataTables_length,
.dataTables_wrapper .dataTables_filter,
.dataTables_wrapper .dataTables_info,
.dataTables_wrapper .dataTables_paginate {
    padding: 12px 4px;
    font-size: .8rem;
    color: var(--c-ink-4);
    font-family: var(--font);
}
.dataTables_wrapper .dataTables_filter { display: none; }
.dataTables_processing {
    background: rgba(255,255,255,.92) !important;
    border-radius: var(--r-lg) !important;
    color: var(--c-ink-2) !important;
    font-weight: 700;
    box-shadow: var(--sh-pop);
    font-family: var(--font);
}
.dataTables_wrapper,
.dataTables_scroll,
.dataTables_scrollBody { overflow: visible !important; }
#umUsersTable,
#umUsersTable tbody,
#umUsersTable tr,
#umUsersTable td { overflow: visible !important; }

/* ╔══════════════════════════════════════════════════════════╗
   ║  ARCHIVED BATCHES                                        ║
   ╚══════════════════════════════════════════════════════════╝ */
.archive {
    margin-top: 20px;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-xl);
    box-shadow: var(--sh-card);
    overflow: hidden;
}

.archive__toggle {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 20px;
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: var(--font);
    text-align: right;
    transition: background var(--t-fast);
}
.archive__toggle:hover { background: var(--c-surface-2); }

.archive__label { font-size: .9rem; font-weight: 700; color: var(--c-ink-2); }

.archive__chip {
    display: inline-flex;
    align-items: center;
    padding: 2px 10px;
    border-radius: var(--r-full);
    font-size: .7rem;
    font-weight: 700;
}
.chip--amber { background: var(--c-amber-l); color: var(--c-amber); }
.chip--blue  { background: var(--c-brand-xl); color: var(--c-brand); }

.archive__chevron {
    color: var(--c-ink-4);
    margin-right: auto;
    transition: transform var(--t-base) var(--ease);
}
.archive__chevron.is-open { transform: rotate(180deg); }

.archive__body {
    border-top: 1px solid var(--c-border);
    padding: 14px 20px 20px;
}

.archive__hint {
    font-size: .78rem;
    color: var(--c-ink-4);
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 6px;
}

.archive__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px;
}

.batch-card {
    display: block;
    text-decoration: none;
    background: var(--c-surface-2);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    padding: 14px 16px;
    transition: transform var(--t-base) var(--ease-spring), box-shadow var(--t-base);
}
.batch-card:hover { transform: translateY(-3px); box-shadow: var(--sh-lift); }

.batch-card__top { display: flex; align-items: flex-start; gap: 10px; }

.batch-card__ico {
    width: 38px;
    height: 38px;
    border-radius: var(--r-md);
    background: var(--c-amber-l);
    color: var(--c-amber);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
}

.batch-card__name {
    font-size: .85rem;
    font-weight: 700;
    color: var(--c-ink-1);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.batch-card__sub {
    font-size: .71rem;
    color: var(--c-ink-4);
    margin-top: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.batch-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 12px;
}

.batch-card__count {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--c-brand-xl);
    color: var(--c-brand);
    padding: 2px 9px;
    border-radius: var(--r-full);
    font-size: .7rem;
    font-weight: 700;
}

.batch-card__date { font-size: .68rem; color: var(--c-ink-5); }

/* ╔══════════════════════════════════════════════════════════╗
   ║  FLOATING ACTION BAR                                     ║
   ╚══════════════════════════════════════════════════════════╝ */
.action-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9900;
    pointer-events: none;
}

.action-bar__inner {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    padding: 14px 24px;
    background: rgba(15, 23, 42, 0.92);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-top: 1px solid rgba(255,255,255,.10);
    box-shadow: 0 -8px 32px rgba(15,23,42,.28);
    transform: translateY(110%);
    transition: transform var(--t-slow) var(--ease);
}

.action-bar.is-visible .action-bar__inner { transform: translateY(0); }
.action-bar.is-visible { pointer-events: all; }

/* Selection info */
.ab-sel {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px 6px 8px;
    background: rgba(255,255,255,.10);
    border-radius: var(--r-full);
    border: 1px solid rgba(255,255,255,.14);
    flex-shrink: 0;
}

.ab-sel__count {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 28px;
    padding: 0 7px;
    border-radius: var(--r-full);
    background: var(--c-brand);
    color: #fff;
    font-size: .8rem;
    font-weight: 800;
    font-family: var(--font);
    transition: transform var(--t-base) var(--ease-spring);
}

.ab-sel__count.bump { animation: countBump .3s var(--ease-spring); }
@@keyframes countBump { 0%,100% { transform: scale(1); } 50% { transform: scale(1.35); } }

.ab-sel__text { font-size: .82rem; font-weight: 600; color: rgba(255,255,255,.75); white-space: nowrap; }

.ab-sep { width: 1px; height: 28px; background: rgba(255,255,255,.14); flex-shrink: 0; }

/* Action buttons */
.ab-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: var(--r-md);
    font-size: .8rem;
    font-weight: 700;
    font-family: var(--font);
    cursor: pointer;
    border: 1px solid transparent;
    white-space: nowrap;
    transition: all var(--t-fast);
    background: rgba(255,255,255,.09);
    color: rgba(255,255,255,.85);
    border-color: rgba(255,255,255,.14);
}
.ab-action:hover:not(:disabled) {
    background: rgba(255,255,255,.16);
    color: #fff;
    border-color: rgba(255,255,255,.24);
    transform: translateY(-1px);
}
.ab-action:disabled {
    opacity: .3;
    cursor: not-allowed;
    pointer-events: none;
}

.ab-action--warn  { background: rgba(217,119,6,.18); color: #FCD34D; border-color: rgba(217,119,6,.28); }
.ab-action--warn:hover:not(:disabled)  { background: rgba(217,119,6,.28); }

.ab-action--danger { background: rgba(220,38,38,.18); color: #FCA5A5; border-color: rgba(220,38,38,.28); }
.ab-action--danger:hover:not(:disabled) { background: rgba(220,38,38,.28); }

.ab-action--clear {
    background: transparent;
    color: rgba(255,255,255,.45);
    border-color: transparent;
    margin-right: auto;
}
.ab-action--clear:hover:not(:disabled) {
    background: rgba(255,255,255,.08);
    color: rgba(255,255,255,.75);
    border-color: transparent;
    transform: none;
}

/* Tooltip wrapper */
.ab-tip { position: relative; display: inline-flex; }
.ab-tip__text {
    display: none;
    position: absolute;
    bottom: calc(100% + 8px);
    right: 50%;
    transform: translateX(50%);
    background: rgba(15,23,42,.95);
    color: rgba(255,255,255,.9);
    font-size: .7rem;
    font-weight: 600;
    padding: 5px 10px;
    border-radius: var(--r-sm);
    white-space: nowrap;
    pointer-events: none;
    border: 1px solid rgba(255,255,255,.1);
    backdrop-filter: blur(8px);
}
.ab-tip:hover .ab-tip__text { display: block; }

/* ── Responsive ── */
@@media (max-width: 1200px) { .um-metrics { grid-template-columns: repeat(3,1fr); } }
@@media (max-width: 900px)  { .um-metrics { grid-template-columns: repeat(2,1fr); } }
@@media (max-width: 640px)  {
    .um { padding: 16px 12px 100px; }
    .um-metrics { grid-template-columns: 1fr 1fr; }
    .col-md-hide { display: none; }
    .um-head__actions { width: 100%; }
    .action-bar__inner { padding: 12px 14px; gap: 6px; }
}

/* Dark mode */
@@media (prefers-color-scheme: dark) {
    :root {
        --c-bg:        #0F172A;
        --c-surface:   #1E293B;
        --c-surface-2: #162032;
        --c-border:    #334155;
        --c-border-2:  #475569;
        --c-ink-1:     #F8FAFC;
        --c-ink-2:     #E2E8F0;
        --c-ink-3:     #94A3B8;
        --c-ink-4:     #64748B;
        --c-ink-5:     #334155;
    }
}
</style>

<div class="um">

    @Html.AntiForgeryToken()

    <!-- ── Header ── -->
    <header class="um-head">
        <div class="um-head__brand">
            <div class="um-head__badge"><i class="bi bi-people-fill"></i></div>
            <div>
                <h1 class="um-head__title">مستخدمو المنصة</h1>
                <nav class="um-head__crumb" aria-label="مسار التنقل">
                    <a href="/Admin">لوحة التحكم</a>
                    <i class="bi bi-chevron-left" style="font-size:.55rem;color:var(--c-ink-5)"></i>
                    <span>المستخدمون</span>
                </nav>
            </div>
        </div>
        <div class="um-head__actions">
            <a asp-action="PartnersList" class="btn btn--ghost">
                <i class="bi bi-building"></i> الشركاء
