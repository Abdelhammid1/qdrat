    {
        <div class="archive">
            <button class="archive__toggle" id="archiveToggle"
                    data-bs-toggle="collapse" data-bs-target="#archiveBody"
                    aria-expanded="false">
                <i class="bi bi-archive-fill" style="color:var(--c-amber)"></i>
                <span class="archive__label">أرشيف الدفعات المنتهية</span>
                <span class="archive__chip chip--amber">@Model.ArchivedBatches.Count دفعة</span>
                <span class="archive__chip chip--blue">@Model.ArchivedStudentsCount طالب</span>
                <i class="bi bi-chevron-down archive__chevron" id="archChevron"></i>
            </button>

            <div class="collapse" id="archiveBody">
                <div class="archive__body">
                    <p class="archive__hint">
                        <i class="bi bi-info-circle"></i>
                        الطلاب محفوظون بحساباتهم الكاملة — يمكن إضافتهم لدفعات جديدة في أي وقت.
                    </p>
                    <div class="archive__grid">
                        @foreach (var ab in Model.ArchivedBatches)
                        {
                            <a asp-action="ArchivedBatchStudents" asp-route-batchId="@ab.BatchId" class="batch-card">
                                <div class="batch-card__top">
                                    <div class="batch-card__ico"><i class="bi bi-archive"></i></div>
                                    <div style="min-width:0;flex:1">
                                        <div class="batch-card__name">@ab.BatchName</div>
                                        @if (!string.IsNullOrWhiteSpace(ab.CourseName))
                                        {
                                            <div class="batch-card__sub">
                                                @ab.CourseName
                                                @if (!string.IsNullOrWhiteSpace(ab.BranchName))
                                                {<span> · @ab.BranchName</span>}
