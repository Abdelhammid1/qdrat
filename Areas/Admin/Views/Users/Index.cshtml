        <button class="metric metric--amber" data-filter="withoutRoles">
            <div class="metric__icon"><i class="bi bi-exclamation-triangle"></i></div>
            <div class="metric__body">
                <div class="metric__label">بلا أدوار</div>
                <div class="metric__value" id="statWithoutRoles">0</div>
                <div class="metric__hint">يحتاجون مراجعة</div>
            </div>
        </button>
    </div>

    <!-- ── Controls ── -->
    <div class="um-controls">
        <div class="search-wrap">
            <input type="text" id="umSearch" class="search-input"
                   placeholder="ابحث بالاسم أو الهوية أو البريد الإلكتروني..." />
            <i class="bi bi-search search-wrap__icon"></i>
        </div>

        <div class="filter-pills">
            <button class="pill is-active" data-filter="all">الجميع</button>
            <button class="pill" data-filter="students"><i class="bi bi-mortarboard"></i> الطلاب</button>
            <button class="pill" data-filter="inactive"><i class="bi bi-slash-circle"></i> الموقوفون</button>
            <button class="pill" data-filter="withoutRoles"><i class="bi bi-exclamation-triangle"></i> بلا أدوار</button>
        </div>

        <div class="batch-filter-wrap">
            <i class="bi bi-collection batch-filter-wrap__icon"></i>
            <select id="batchFilterSelect" class="batch-filter-select" title="فلتر بالدفعة">
                <option value="">— فلتر بالدفعة (@Model.ActiveBatches.Count) —</option>
                @foreach (var batch in Model.ActiveBatches)
                {
                    <option value="@batch.Id">@batch.Name</option>
                }
            </select>
        </div>
    </div>

    <!-- ── Table ── -->
    <div class="um-table-card">
        <table id="umUsersTable">
            <thead>
                <tr>
                    <th class="col-cb">
                        <input type="checkbox" class="row-cb" id="selectAllCb" />
                    </th>
                    <th>المستخدم</th>
                    <th class="col-md-hide">الهوية الوطنية</th>
                    <th>الدور</th>
                    <th>طالب</th>
                    <th>الدفعة</th>
                    <th class="col-md-hide">آخر دخول</th>
                    <th>الحالة</th>
