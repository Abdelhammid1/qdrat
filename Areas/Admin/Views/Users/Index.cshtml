            </div>
        </button>

        <button class="metric metric--green" data-filter="active">
            <div class="metric__icon"><i class="bi bi-person-check"></i></div>
            <div class="metric__body">
                <div class="metric__label">مفعّلون</div>
                <div class="metric__value" id="statActiveUsers">@Model.ActiveUsers</div>
                <div class="metric__hint">حسابات نشطة</div>
            </div>
        </button>

        <button class="metric metric--red" data-filter="inactive">
            <div class="metric__icon"><i class="bi bi-person-x"></i></div>
            <div class="metric__body">
                <div class="metric__label">موقوفون</div>
                <div class="metric__value" id="statInactiveUsers">@Model.InactiveUsers</div>
