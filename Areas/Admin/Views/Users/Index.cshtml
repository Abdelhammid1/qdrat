            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn--primary">
                <i class="bi bi-plus-lg"></i> مستخدم جديد
            </a>
        </div>
    </header>

    <!-- ── Metrics ── -->
    <div class="um-metrics">
        <button class="metric metric--blue is-active" data-filter="all">
            <div class="metric__icon"><i class="bi bi-people"></i></div>
            <div class="metric__body">
                <div class="metric__label">إجمالي</div>
                <div class="metric__value" id="statTotalUsers">@Model.TotalUsers</div>
