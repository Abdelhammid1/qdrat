@section Scripts {
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
<script>
/* ════════════════════════════════════════════════════════════
   STATE
   ════════════════════════════════════════════════════════════ */
let dt         = null;
let searchTmr  = null;

/** Map<userId, rowData> — persists across page turns */
const selected = new Map();

const filters = { isActive:'', isStudent:'', roleFilter:'', withoutRoles:'', searchText:'', batchId:'' };

/* ── URL constants ── */
const U_DETAILS      = '@Url.Action("Details",              "Users", new { area="Admin" })';
const U_EDIT         = '@Url.Action("Edit",                 "Users", new { area="Admin" })';
const U_ROLES        = '@Url.Action("AssignRoles",          "Users", new { area="Admin" })';
const U_PERMS        = '@Url.Action("ManagePermissions",    "Users", new { area="Admin" })';
const U_RESET        = '@Url.Action("ResetPassword",        "Users", new { area="Admin" })';
const U_TOGGLE       = '@Url.Action("ToggleActive",         "Users", new { area="Admin" })';
const U_DELETE       = '@Url.Action("DeleteUser",           "Users", new { area="Admin" })';
const U_SPECIAL_PERMS= '@Url.Action("SpecialPermissions",   "Users", new { area="Admin" })';

/* ════════════════════════════════════════════════════════════
   HELPERS
   ════════════════════════════════════════════════════════════ */
function copyNatId(btn, val) {
    event.stopPropagation();
    navigator.clipboard.writeText(val).then(() => {
        btn.classList.add('copied');
        btn.innerHTML = '<i class="bi bi-check-lg"></i>';
        setTimeout(() => {
            btn.classList.remove('copied');
            btn.innerHTML = '<i class="bi bi-copy"></i>';
        }, 1800);
    });
}

function esc(v) {
    if (v == null) return '';
    return String(v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
                    .replace(/"/g,'&quot;').replace(/'/g,'&#039;');
}
function initials(name) {
    if (!name?.trim()) return '?';
    const w = name.trim().split(/\s+/);
    return (w.length>=2 ? w[0][0]+w[1][0] : name.substring(0,2)).toUpperCase();
}
function avClass(id) {
    const pool = ['av-1','av-2','av-3','av-4','av-5'];
    let s=0; for(const c of (id||'')) s+=c.charCodeAt(0);
    return pool[s%pool.length];
}
function getToken() { return document.querySelector('[name="__RequestVerificationToken"]')?.value||''; }

async function postFetch(url, data) {
    const fd = new FormData();
    fd.append('__RequestVerificationToken', getToken());
    for (const [k,v] of Object.entries(data)) fd.append(k,v);
    return fetch(url, {method:'POST', body:fd});
}

/* ════════════════════════════════════════════════════════════
   SELECTION ENGINE
   ════════════════════════════════════════════════════════════ */
function selectRow(cb) {
    const tr  = cb.closest('tr');
    const id  = cb.dataset.id;
    let   row = {};
    try { row = JSON.parse(decodeURIComponent(cb.dataset.row)); } catch {}

    if (cb.checked) {
        selected.set(id, row);
        tr?.classList.add('is-selected');
    } else {
        selected.delete(id);
        tr?.classList.remove('is-selected');
    }
    syncBar();
}

function clearAll() {
    selected.clear();
    document.querySelectorAll('#umUsersTable .row-cb').forEach(cb => { cb.checked=false; });
    document.querySelectorAll('#umUsersTable tr.is-selected').forEach(tr => tr.classList.remove('is-selected'));
    const allCb = document.getElementById('selectAllCb');
    allCb.checked = allCb.indeterminate = false;
    syncBar();
}

function reapply() {
    document.querySelectorAll('#umUsersTable tbody .row-cb').forEach(cb => {
        const has = selected.has(cb.dataset.id);
        cb.checked = has;
        cb.closest('tr')?.classList.toggle('is-selected', has);
    });
    syncBar();
}

function syncBar() {
    const cnt    = selected.size;
    const bar    = document.getElementById('actionBar');
    const cntEl  = document.getElementById('abCount');
    const txtEl  = document.getElementById('abText');
    const single = cnt === 1;

    /* count + visibility */
    cntEl.textContent = cnt;
    cntEl.classList.toggle('bump', true);
    setTimeout(()=>cntEl.classList.remove('bump'),300);
    txtEl.textContent = cnt===1 ? 'مستخدم محدد' : 'مستخدمون محددون';
    bar.classList.toggle('is-visible', cnt>0);

    /* single-only buttons */
    ['abDetails','abEdit','abRoles','abPerms','abReset'].forEach(id => {
        document.getElementById(id).disabled = !single;
    });

    /* toggle label */
    const row = single ? [...selected.values()][0] : null;
    document.getElementById('abToggleIco').className =
        row ? (row.isActive?'bi bi-toggle-off':'bi bi-toggle-on') : 'bi bi-toggle-on';
    document.getElementById('abToggleTxt').textContent =
        row ? (row.isActive?'إيقاف':'تفعيل') : 'تفعيل / إيقاف';

    /* delete label */
    document.getElementById('abDeleteTxt').textContent =
        cnt>1 ? `حذف (${cnt})` : 'حذف';

    /* select-all state */
    const pageCbs = [...document.querySelectorAll('#umUsersTable tbody .row-cb')];
    const checked = pageCbs.filter(c=>c.checked).length;
    const allCb   = document.getElementById('selectAllCb');
    allCb.checked       = pageCbs.length>0 && checked===pageCbs.length;
    allCb.indeterminate = checked>0 && checked<pageCbs.length;
}

/* Events */
document.addEventListener('change', e => {
    if (e.target.id==='selectAllCb') {
        document.querySelectorAll('#umUsersTable tbody .row-cb').forEach(cb => {
            cb.checked = e.target.checked;
            selectRow(cb);
        });
    } else if (e.target.classList.contains('row-cb')) {
        selectRow(e.target);
    }
});

/* ════════════════════════════════════════════════════════════
   ACTION BAR HANDLERS
   ════════════════════════════════════════════════════════════ */
function abGoDetails()      { if(selected.size!==1)return; location.href=U_DETAILS      +'?id='    +encodeURIComponent([...selected.keys()][0]); }
function abGoEdit()         { if(selected.size!==1)return; location.href=U_EDIT         +'?id='    +encodeURIComponent([...selected.keys()][0]); }
function abGoRoles()        { if(selected.size!==1)return; location.href=U_ROLES        +'?userId='+encodeURIComponent([...selected.keys()][0]); }
function abGoPerms()        { if(selected.size!==1)return; location.href=U_PERMS        +'?userId='+encodeURIComponent([...selected.keys()][0]); }
function abGoReset()        { if(selected.size!==1)return; location.href=U_RESET        +'?userId='+encodeURIComponent([...selected.keys()][0]); }
function abGoSpecialPerms() { if(selected.size!==1)return; location.href=U_SPECIAL_PERMS+'?userId='+encodeURIComponent([...selected.keys()][0]); }

async function abToggle() {
    const ids = [...selected.keys()];
    if (!ids.length) return;
    const msg = ids.length===1 ? 'تغيير حالة هذا المستخدم؟' : `تغيير حالة ${ids.length} مستخدمين؟`;
    if (!confirm(msg)) return;
    document.getElementById('abToggle').disabled = true;
    for (const id of ids) await postFetch(U_TOGGLE, {userId:id});
    clearAll();
    dt?.ajax.reload(null,false);
    document.getElementById('abToggle').disabled = false;
}

async function abDelete() {
    const ids = [...selected.keys()];
    if (!ids.length) return;
    const msg = ids.length===1
        ? 'حذف هذا المستخدم؟ لا يمكن التراجع.'
        : `حذف ${ids.length} مستخدمين؟ لا يمكن التراجع.`;
    if (!confirm(msg)) return;
    document.getElementById('abDelete').disabled = true;
    for (const id of ids) await postFetch(U_DELETE, {id});
    clearAll();
    dt?.ajax.reload(null,false);
    document.getElementById('abDelete').disabled = false;
}

/* ════════════════════════════════════════════════════════════
   RENDERERS
   ════════════════════════════════════════════════════════════ */
function rCheckbox(row) {
    const payload = encodeURIComponent(JSON.stringify({id:row.id,isActive:row.isActive,fullName:row.fullName}));
    return `<input type="checkbox" class="row-cb" data-id="${esc(row.id)}" data-row="${payload}" onclick="event.stopPropagation()"/>`;
}

function rUser(row) {
    const av = avClass(row.id);
    return `<div class="user-cell">
        <div class="user-av ${av}">${esc(initials(row.fullName))}</div>
        <div>
            <div class="user-name">${esc(row.fullName||'بدون اسم')}</div>
            <div class="user-email">${esc(row.email||'')}</div>
        </div>
    </div>`;
}

function rNatId(row) {
    if (!row.nationalID) return `<span style="color:var(--c-ink-5)">—</span>`;
    return `<span class="nat-id-wrap">
        <span class="nat-id">${esc(row.nationalID)}</span>
        <button class="nat-copy" title="نسخ" onclick="copyNatId(this,'${esc(row.nationalID)}')">
            <i class="bi bi-copy"></i>
        </button>
    </span>`;
}

function rRole(row) {
    const roles = row.roles||[];
    if (!roles.length) return `<span class="role-badge role-none"><i class="bi bi-dash-circle"></i> بدون دور</span>`;
    if (roles.length>1) return `<span class="role-badge role-multi" title="${esc(roles.join(', '))}"><i class="bi bi-layers-fill"></i> ${roles.length} أدوار</span>`;
    const r=roles[0].toLowerCase();
    const [cls,ico,lbl] = r.includes('admin')||r.includes('owner')||r.includes('developer')
        ? ['role-admin',    'bi-shield-lock-fill',  'مدير']
        : r.includes('instructor') ? ['role-instructor','bi-person-video3',    'مدرب']
        : r.includes('student')    ? ['role-student',   'bi-mortarboard-fill', 'طالب']
        : ['role-none', 'bi-person', esc(roles[0])];
    return `<span class="role-badge ${cls}"><i class="bi ${ico}"></i>${lbl}</span>`;
}

function rStudent(row) {
    return row.isStudent
        ? `<i class="bi bi-check-circle-fill" style="color:var(--c-emerald);font-size:.9rem"></i>`
        : `<i class="bi bi-dash-circle"       style="color:var(--c-ink-5);font-size:.9rem"></i>`;
}

function rBatches(row) {
    if (!row.isStudent) return `<span style="color:var(--c-ink-5)">—</span>`;
    const b=row.batchNames||[];
    if (!b.length) return `<span style="color:var(--c-ink-5);font-size:.78rem">لا يوجد</span>`;
    if (b.length===1) return `<span class="batch-tag"><i class="bi bi-collection" style="font-size:.6rem"></i>${esc(b[0])}</span>`;
    const enc=encodeURIComponent(JSON.stringify(b));
    return `<span class="batch-tag"><i class="bi bi-collection" style="font-size:.6rem"></i>${esc(b[0])}</span>
            <button class="more-batches" data-user="${esc(row.fullName)}" data-batches="${enc}" onclick="openBatchModal(this)">+${b.length-1}</button>`;
}

function rLogin(row) {
    if (!row.lastLoginAtTicks) return `<span class="login-time">—</span>`;
    const ms=Math.floor(+row.lastLoginAtTicks/1e4)-62135596800000;
    const d=new Date(ms);
    if(isNaN(d)) return `<span class="login-time">—</span>`;
    return `<span class="login-time">${d.getFullYear()}/${String(d.getMonth()+1).padStart(2,'0')}/${String(d.getDate()).padStart(2,'0')} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}</span>`;
}

function rStatus(row) {
    return row.isActive
        ? `<span class="status-pill status-pill--on"><span class="s-pulse"></span>نشط</span>`
        : `<span class="status-pill status-pill--off"><i class="bi bi-slash-circle" style="font-size:.72rem"></i>موقوف</span>`;
}

/* ════════════════════════════════════════════════════════════
   BATCH MODAL
   ════════════════════════════════════════════════════════════ */
function openBatchModal(btn) {
    let list=[];
    try{list=JSON.parse(decodeURIComponent(btn.dataset.batches));}catch{}
    document.getElementById('batchModalUser').textContent = btn.dataset.user||'';
    document.getElementById('batchModalBody').innerHTML = list.length
        ? list.map((n,i)=>`<div style="display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--c-border)">
            <span style="display:flex;align-items:center;gap:8px"><span style="background:var(--c-surface-2);border-radius:var(--r-full);padding:1px 7px;font-size:.72rem;color:var(--c-ink-4)">${i+1}</span><span style="font-size:.84rem;font-weight:600">${esc(n)}</span></span>
            <i class="bi bi-check-circle-fill" style="color:var(--c-emerald)"></i></div>`).join('')
        : `<p style="color:var(--c-ink-4);font-size:.84rem;margin:0">لا توجد دفعات.</p>`;
    new bootstrap.Modal(document.getElementById('batchModal')).show();
}

/* ════════════════════════════════════════════════════════════
   FILTERS
   ════════════════════════════════════════════════════════════ */
function setActiveFilter(name) {
    document.querySelectorAll('.pill').forEach(p=>{
        p.classList.toggle('is-active', p.dataset.filter===name);
    });
    document.querySelectorAll('.metric').forEach(m=>{
        m.classList.toggle('is-active', m.dataset.filter===name);
    });
}

function applyFilter(name) {
    filters.isActive=filters.isStudent=filters.withoutRoles=filters.roleFilter=filters.batchId='';
    if(name==='active')           filters.isActive='true';
    else if(name==='inactive')    filters.isActive='false';
    else if(name==='students')    filters.isStudent='true';
    else if(name==='withoutRoles')filters.withoutRoles='true';
    setActiveFilter(name);
    // مسح الـ select عند اختيار pill آخر
    const sel = document.getElementById('batchFilterSelect');
    if(sel){ sel.value=''; sel.classList.remove('has-value'); }
    dt?.ajax.reload(null,true);
}

function applyBatchFilter(batchIdVal) {
    // مسح باقي الفلاتر
    filters.isActive=filters.isStudent=filters.withoutRoles=filters.roleFilter='';
    filters.batchId = batchIdVal;
    // إلغاء تحديد الـ pills
    document.querySelectorAll('.pill').forEach(p=>p.classList.remove('is-active'));
    document.querySelectorAll('.metric').forEach(m=>m.classList.remove('is-active'));
    dt?.ajax.reload(null,true);
}

function updateStats(s) {
    if(!s)return;
    document.getElementById('statTotalUsers').textContent  = s.totalUsers??0;
    document.getElementById('statActiveUsers').textContent = s.activeUsers??0;
    document.getElementById('statInactiveUsers').textContent=s.inactiveUsers??0;
    document.getElementById('statStudentsCount').textContent=s.studentsCount??0;
    document.getElementById('statWithoutRoles').textContent =s.withoutRolesCount??0;
}

/* ════════════════════════════════════════════════════════════
   DATATABLES INIT
   ════════════════════════════════════════════════════════════ */
$(function() {

    // ── فلتر الدفعة ──
    document.getElementById('batchFilterSelect')?.addEventListener('change', function() {
        const val = this.value;
        this.classList.toggle('has-value', val !== '');
        applyBatchFilter(val);
    });

    dt = $('#umUsersTable').DataTable({
        processing: true,
        serverSide: true,
        searching:  false,
        ordering:   false,
        pageLength: 25,
        lengthMenu: [[10,25,50,100],[10,25,50,100]],
        language: { url:'//cdn.datatables.net/plug-ins/1.13.4/i18n/ar.json', processing:'جاري التحميل...' },
        ajax: {
            url:  '@Url.Action("LoadUsersDataDT","Users",new{area="Admin"})',
            type: 'POST',
            data: d => {
                filters.searchText = (document.getElementById('umSearch')?.value||'').trim();
                d.__RequestVerificationToken = getToken();
                Object.assign(d, filters);
            },
            dataSrc: json => { updateStats(json.summary); return json.data||[]; },
            error: xhr => alert(xhr.responseJSON?.error||'حدث خطأ أثناء التحميل.')
        },
        columns: [
            { data:null, orderable:false, className:'col-cb', render:(_,t,r)=>rCheckbox(r) },
            { data:null, render:(_,t,r)=>rUser(r) },
            { data:null, render:(_,t,r)=>rNatId(r) },
            { data:null, render:(_,t,r)=>rRole(r) },
            { data:null, render:(_,t,r)=>rStudent(r) },
            { data:null, render:(_,t,r)=>rBatches(r) },
            { data:null, render:(_,t,r)=>rLogin(r) },
            { data:null, render:(_,t,r)=>rStatus(r) }
        ],
        drawCallback: () => reapply()
    });

    /* Row click → toggle checkbox */
    $('#umUsersTable tbody').on('click','tr', function(e) {
        if($(e.target).closest('.row-cb,.more-batches').length) return;
        const cb = this.querySelector('.row-cb');
        if(cb){ cb.checked=!cb.checked; selectRow(cb); }
    });

    /* Search debounce */
    document.getElementById('umSearch')?.addEventListener('input', () => {
        clearTimeout(searchTmr);
        searchTmr = setTimeout(()=>dt?.ajax.reload(null,true), 260);
    });
    document.getElementById('umSearch')?.addEventListener('keydown', e=>{
        if(e.key==='Enter'){ clearTimeout(searchTmr); dt?.ajax.reload(null,true); }
    });

    /* Filters */
    document.querySelectorAll('.pill,.metric').forEach(el=>{
        el.addEventListener('click', ()=>applyFilter(el.dataset.filter));
    });

    /* Archive accordion chevron */
    document.getElementById('archiveBody')?.addEventListener('show.bs.collapse',   ()=>document.getElementById('archChevron')?.classList.add('is-open'));
    document.getElementById('archiveBody')?.addEventListener('hidden.bs.collapse',  ()=>document.getElementById('archChevron')?.classList.remove('is-open'));
});
</script>
}
