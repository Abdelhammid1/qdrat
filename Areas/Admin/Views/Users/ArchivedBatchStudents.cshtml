@using QdratNew.ViewModels.Admin
@model List<ArchivedStudentRowDto>

@{
    ViewData["Title"] = "طلاب الدفعة المؤرشفة";
    var batchName  = ViewBag.BatchName  as string ?? "دفعة مؤرشفة";
    var courseName = ViewBag.CourseName as string;
    var branchName = ViewBag.BranchName as string;
    var archivedAt = ViewBag.ArchivedAt as DateTime?;
    int batchId    = ViewBag.BatchId;

    int activeCount   = Model.Count(s => s.HasActiveEnrollment);
    int archivedOnly  = Model.Count - activeCount;
}

@section Styles {
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --ink: #0D1B2A; --ink-2: #2C3E50; --ink-3: #5A6A7A; --ink-4: #8FA0B0;
            --canvas: #F3F6FA; --surface: #fff; --surface-2: #F8FAFC; --border: #DDE4EC;
            --blue: #1B5EAE; --blue-bg: #E8F1FB;
            --emerald: #0D7A5B; --emerald-bg: #E4F5EE;
            --amber: #985D09; --amber-bg: #FDF0D8;
            --rose: #BF1030; --rose-bg: #FDEAEE;
            --radius: 12px; --shadow: 0 2px 10px rgba(0,0,0,.07);
        }
        body { background: var(--canvas); font-family: 'Cairo', sans-serif; direction: rtl; }
        .page-wrap { padding: 1.75rem 1.5rem; }

        .page-header {
            display: flex; align-items: flex-start; gap: 14px;
            margin-bottom: 1.5rem; flex-wrap: wrap;
        }
        .header-icon {
            width: 52px; height: 52px; border-radius: 12px;
            background: var(--amber-bg); color: var(--amber);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.5rem; flex-shrink: 0;
        }
        .header-info { flex: 1; }
        .batch-title { font-size: 1.15rem; font-weight: 700; color: var(--ink); }
        .batch-meta  { font-size: .8rem; color: var(--ink-3); margin-top: 3px; }
        .batch-meta a { color: var(--blue); text-decoration: none; }
        .batch-meta a:hover { text-decoration: underline; }

        .sum-row {
            display: grid; grid-template-columns: repeat(3,1fr);
            gap: 1rem; margin-bottom: 1.5rem;
        }
        .sum-card {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: var(--radius); padding: .9rem 1.1rem;
            display: flex; align-items: center; gap: 12px;
            box-shadow: var(--shadow);
        }
        .sum-icon {
            width: 40px; height: 40px; border-radius: 9px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.1rem; flex-shrink: 0;
        }
        .ic-amber   { background: var(--amber-bg);   color: var(--amber); }
        .ic-blue    { background: var(--blue-bg);     color: var(--blue); }
        .ic-emerald { background: var(--emerald-bg);  color: var(--emerald); }
        .sum-num { font-size: 1.4rem; font-weight: 700; line-height: 1; }
        .sum-lbl { font-size: .73rem; color: var(--ink-3); margin-top: 2px; }

        .info-box {
            background: var(--amber-bg); border: 1px solid #f3c46b;
            border-radius: 10px; padding: .75rem 1.1rem;
            font-size: .82rem; color: var(--amber);
            display: flex; align-items: flex-start; gap: 8px;
            margin-bottom: 1.25rem;
        }

        .table-card {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden;
        }
        .table-card-head {
            padding: .85rem 1.25rem;
            display: flex; align-items: center; gap: 8px;
            border-bottom: 1px solid var(--border);
            font-size: .9rem; font-weight: 700; color: var(--ink);
        }
        .search-input {
            border: 1px solid var(--border); border-radius: 8px;
            padding: .4rem .85rem; font-size: .84rem; width: 220px;
            outline: none; font-family: 'Cairo', sans-serif;
        }
        .search-input:focus { border-color: var(--blue); }
        .table-wrap { overflow-x: auto; }

        table.styled { width: 100%; border-collapse: collapse; font-size: .85rem; }
        table.styled thead tr { background: var(--surface-2); }
        table.styled th {
            padding: .65rem 1rem; font-weight: 600; color: var(--ink-3);
            border-bottom: 1px solid var(--border); white-space: nowrap; text-align: right;
        }
        table.styled td {
            padding: .65rem 1rem; border-bottom: 1px solid var(--border);
            color: var(--ink-2); vertical-align: middle;
        }
        table.styled tbody tr:hover { background: var(--surface-2); }
        table.styled tbody tr:last-child td { border-bottom: none; }

        .user-avatar {
            width: 34px; height: 34px; border-radius: 50%;
            background: var(--amber-bg); color: var(--amber);
            display: inline-flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: .8rem; flex-shrink: 0;
        }

        .badge-tag {
            display: inline-flex; align-items: center; gap: 3px;
            padding: 2px 9px; border-radius: 20px;
            font-size: .72rem; font-weight: 600;
        }
        .b-active   { background: var(--emerald-bg); color: var(--emerald); }
        .b-archived { background: var(--amber-bg);   color: var(--amber); }

        .act-btn {
            display: inline-flex; align-items: center; gap: 4px;
            padding: 4px 10px; border-radius: 6px; font-size: .78rem; font-weight: 600;
            text-decoration: none; border: 1px solid var(--border);
            color: var(--ink-2); background: var(--surface); transition: background .12s;
        }
        .act-btn:hover { background: var(--surface-2); color: var(--ink); }

        .empty-row td { text-align: center; color: var(--ink-4); padding: 2rem !important; }

        @@media(max-width:680px) { .sum-row { grid-template-columns: 1fr 1fr; } }
    </style>
}

<div class="page-wrap">

    <!-- Header -->
    <div class="page-header">
        <div class="header-icon"><i class="bi bi-archive-fill"></i></div>
        <div class="header-info">
            <div class="batch-title">@batchName</div>
            <div class="batch-meta">
                <a asp-action="Index">مستخدمو المنصة</a>
                <i class="bi bi-chevron-left" style="font-size:.6rem;margin:0 4px"></i>
                <span>أرشيف الدفعات</span>
                <i class="bi bi-chevron-left" style="font-size:.6rem;margin:0 4px"></i>
                @batchName
                @if (!string.IsNullOrWhiteSpace(courseName))
                {
                    <span> — @courseName</span>
                }
                @if (!string.IsNullOrWhiteSpace(branchName))
                {
                    <span> / @branchName</span>
                }
                @if (archivedAt.HasValue)
                {
                    <span style="margin-right:8px">
                        <i class="bi bi-calendar3 me-1"></i>أُرشف في: @archivedAt.Value.ToString("yyyy/MM/dd")
                    </span>
                }
            </div>
        </div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary ms-auto">
            <i class="bi bi-arrow-right"></i> رجوع
        </a>
    </div>

    <!-- Summary -->
    <div class="sum-row">
        <div class="sum-card">
            <div class="sum-icon ic-amber"><i class="bi bi-people-fill"></i></div>
            <div>
                <div class="sum-num" style="color:var(--amber)">@Model.Count</div>
                <div class="sum-lbl">إجمالي الطلاب</div>
            </div>
        </div>
        <div class="sum-card">
            <div class="sum-icon ic-emerald"><i class="bi bi-person-check-fill"></i></div>
            <div>
                <div class="sum-num" style="color:var(--emerald)">@activeCount</div>
                <div class="sum-lbl">مسجلون في دفعة نشطة أيضاً</div>
            </div>
        </div>
        <div class="sum-card">
            <div class="sum-icon ic-blue"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <div class="sum-num" style="color:var(--blue)">@archivedOnly</div>
                <div class="sum-lbl">في الأرشيف فقط</div>
            </div>
        </div>
    </div>

    <!-- Info Box -->
    <div class="info-box">
        <i class="bi bi-info-circle-fill mt-1" style="flex-shrink:0"></i>
        <div>
            حسابات هؤلاء الطلاب <strong>فعّالة بالكامل</strong> — يمكنهم الدخول للمنصة ويمكن إضافتهم لأي دفعة جديدة.
            الطلاب الذين لديهم مؤشر "مسجل في دفعة نشطة" يظهرون <strong>تلقائياً</strong> في قائمة المستخدمين الرئيسية.
        </div>
    </div>

    <!-- Table -->
    <div class="table-card">
        <div class="table-card-head">
            <i class="bi bi-archive" style="color:var(--amber)"></i>
            طلاب الدفعة المؤرشفة
            <span style="margin-right:auto">
                <input type="text" id="search-archived" class="search-input"
                       placeholder="بحث بالاسم أو الهوية ..." />
            </span>
        </div>
        <div class="table-wrap">
            <table class="styled" id="tbl-archived">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>الطالب</th>
                        <th>رقم الهوية</th>
                        <th>الجوال</th>
                        <th>المدرسة</th>
                        <th>المستوى</th>
                        <th>تاريخ التسجيل</th>
                        <th>الحالة الحالية</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr class="empty-row">
                            <td colspan="9">
                                <i class="bi bi-inbox" style="font-size:1.4rem;display:block;margin-bottom:6px"></i>
                                لا يوجد طلاب في هذه الدفعة
                            </td>
                        </tr>
                    }
                    else
                    {
                        int i = 1;
                        foreach (var s in Model)
                        {
                            <tr>
                                <td>@(i++)</td>
                                <td>
                                    <div style="display:flex;align-items:center;gap:8px">
                                        <div class="user-avatar">
                                            @(s.FullName.Length > 0 ? s.FullName[0].ToString() : "?")
                                        </div>
                                        <span style="font-weight:600">@s.FullName</span>
                                    </div>
                                </td>
                                <td>@(s.NationalID ?? "—")</td>
                                <td>@(s.Phone ?? "—")</td>
                                <td>@(s.School ?? "—")</td>
                                <td>@(s.Level ?? "—")</td>
                                <td style="white-space:nowrap">@s.EnrolledAt.ToString("yyyy/MM/dd")</td>
                                <td>
                                    @if (s.HasActiveEnrollment)
                                    {
                                        <span class="badge-tag b-active">
                                            <i class="bi bi-circle-fill" style="font-size:.45rem"></i>
                                            مسجل في دفعة نشطة
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-tag b-archived">
                                            <i class="bi bi-archive" style="font-size:.7rem"></i>
                                            أرشيف فقط
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(s.UserId))
                                    {
                                        <a asp-action="Edit" asp-route-id="@s.UserId" class="act-btn">
                                            <i class="bi bi-pencil"></i> تعديل
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.getElementById('search-archived')?.addEventListener('input', function () {
            const q = this.value.trim().toLowerCase();
            document.querySelectorAll('#tbl-archived tbody tr:not(.empty-row)').forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        });
    </script>
}
