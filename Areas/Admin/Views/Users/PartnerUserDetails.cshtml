<!-- ════════════════════════════════════════════════
     FLOATING ACTION BAR
     ════════════════════════════════════════════════ -->
<div class="action-bar" id="actionBar" role="toolbar" aria-label="إجراءات المستخدمين المحددين">
    <div class="action-bar__inner">

        <!-- Selection info -->
        <div class="ab-sel">
            <span class="ab-sel__count" id="abCount">0</span>
            <span class="ab-sel__text" id="abText">محدد</span>
        </div>

        <div class="ab-sep"></div>

        <!-- Single-user actions -->
        <div class="ab-tip">
            <button class="ab-action" id="abDetails" onclick="abGoDetails()" style="background:rgba(85,53,181,.18);color:#C4B5FD;border-color:rgba(85,53,181,.28)">
                <i class="bi bi-person-lines-fill"></i> تفاصيل
            </button>
            <span class="ab-tip__text">يتطلب تحديد مستخدم واحد</span>
        </div>

        <div class="ab-tip">
            <button class="ab-action" id="abEdit" onclick="abGoEdit()">
                <i class="bi bi-pencil-square"></i> تعديل
            </button>
            <span class="ab-tip__text">يتطلب تحديد مستخدم واحد</span>
        </div>

        <div class="ab-tip">
            <button class="ab-action" id="abRoles" onclick="abGoRoles()">
                <i class="bi bi-person-gear"></i> الأدوار
            </button>
            <span class="ab-tip__text">يتطلب تحديد مستخدم واحد</span>
        </div>

        <div class="ab-tip">
            <button class="ab-action" id="abPerms" onclick="abGoPerms()">
                <i class="bi bi-shield-lock"></i> الصلاحيات
            </button>
            <span class="ab-tip__text">يتطلب تحديد مستخدم واحد</span>
        </div>

        <div class="ab-tip">
            <button class="ab-action" id="abReset" onclick="abGoReset()">
                <i class="bi bi-key"></i> كلمة المرور
            </button>
            <span class="ab-tip__text">يتطلب تحديد مستخدم واحد</span>
        </div>

        <div class="ab-sep"></div>

        <!-- Bulk actions -->
        <button class="ab-action ab-action--warn" id="abToggle" onclick="abToggle()">
            <i class="bi bi-toggle-on" id="abToggleIco"></i>
            <span id="abToggleTxt">تفعيل / إيقاف</span>
        </button>

        <button class="ab-action ab-action--danger" id="abDelete" onclick="abDelete()">
            <i class="bi bi-trash3"></i>
            <span id="abDeleteTxt">حذف</span>
        </button>

        <!-- Clear -->
        <button class="ab-action ab-action--clear" onclick="clearAll()">
            <i class="bi bi-x-circle"></i> إلغاء
        </button>

    </div>
</div>

@section Scripts {
    <script>
    /* ════════════════════════════════════
       URL constants
       ════════════════════════════════════ */
    const U_DETAILS = '@Url.Action("Details",           "Users", new { area="Admin" })';
    const U_EDIT    = '@Url.Action("Edit",              "Users", new { area="Admin" })';
    const U_ROLES   = '@Url.Action("AssignRoles",       "Users", new { area="Admin" })';
    const U_PERMS   = '@Url.Action("ManagePermissions", "Users", new { area="Admin" })';
    const U_RESET   = '@Url.Action("ResetPassword",     "Users", new { area="Admin" })';
    const U_TOGGLE  = '@Url.Action("ToggleActive",      "Users", new { area="Admin" })';
    const U_DELETE  = '@Url.Action("DeleteUser",        "Users", new { area="Admin" })';

    /* ════════════════════════════════════
       SELECTION ENGINE
       ════════════════════════════════════ */
    const selected = new Map(); // Map<userId, rowData>

    function getToken() {
        return document.querySelector('[name="__RequestVerificationToken"]')?.value || '';
    }

    async function postFetch(url, data) {
        const fd = new FormData();
        fd.append('__RequestVerificationToken', getToken());
        for (const [k, v] of Object.entries(data)) fd.append(k, v);
        return fetch(url, { method: 'POST', body: fd });
    }

    function selectRow(cb) {
        const tr  = cb.closest('tr');
        const id  = cb.dataset.id;
        let   row = {};
        try { row = JSON.parse(decodeURIComponent(cb.dataset.row)); } catch {}

        if (cb.checked) {
            selected.set(id, row);
            tr?.classList.add('is-selected');
        } else {
            selected.delete(id);
            tr?.classList.remove('is-selected');
        }
        syncBar();
        syncSelectAll(cb.closest('table'));
    }

    function syncSelectAll(table) {
        if (!table) return;
        const cbs     = [...table.querySelectorAll('tbody .user-cb')];
        const checked = cbs.filter(c => c.checked).length;
        const allCb   = table.querySelector('thead .select-all-cb');
        if (!allCb) return;
        allCb.checked       = cbs.length > 0 && checked === cbs.length;
        allCb.indeterminate = checked > 0 && checked < cbs.length;
    }

    function clearAll() {
        selected.clear();
        document.querySelectorAll('.user-cb').forEach(cb => {
            cb.checked = false;
            cb.closest('tr')?.classList.remove('is-selected');
        });
        document.querySelectorAll('.select-all-cb').forEach(cb => {
            cb.checked = cb.indeterminate = false;
        });
        syncBar();
    }

    function syncBar() {
        const cnt    = selected.size;
        const bar    = document.getElementById('actionBar');
        const cntEl  = document.getElementById('abCount');
        const txtEl  = document.getElementById('abText');
        const single = cnt === 1;

        cntEl.textContent = cnt;
        cntEl.classList.add('bump');
        setTimeout(() => cntEl.classList.remove('bump'), 300);
        txtEl.textContent = cnt === 1 ? 'مستخدم محدد' : 'مستخدمون محددون';
        bar.classList.toggle('is-visible', cnt > 0);

        ['abDetails', 'abEdit', 'abRoles', 'abPerms', 'abReset'].forEach(id => {
            document.getElementById(id).disabled = !single;
        });

        const row = single ? [...selected.values()][0] : null;
        document.getElementById('abToggleIco').className =
            row ? (row.isActive ? 'bi bi-toggle-off' : 'bi bi-toggle-on') : 'bi bi-toggle-on';
        document.getElementById('abToggleTxt').textContent =
            row ? (row.isActive ? 'إيقاف' : 'تفعيل') : 'تفعيل / إيقاف';

        document.getElementById('abDeleteTxt').textContent =
            cnt > 1 ? `حذف (${cnt})` : 'حذف';
    }

    /* ════════════════════════════════════
       ACTION HANDLERS
       ════════════════════════════════════ */
    function abGoDetails() { if (selected.size !== 1) return; location.href = U_DETAILS + '?id='    + encodeURIComponent([...selected.keys()][0]); }
    function abGoEdit()    { if (selected.size !== 1) return; location.href = U_EDIT    + '?id='    + encodeURIComponent([...selected.keys()][0]); }
    function abGoRoles()   { if (selected.size !== 1) return; location.href = U_ROLES   + '?userId=' + encodeURIComponent([...selected.keys()][0]); }
    function abGoPerms()   { if (selected.size !== 1) return; location.href = U_PERMS   + '?userId=' + encodeURIComponent([...selected.keys()][0]); }
    function abGoReset()   { if (selected.size !== 1) return; location.href = U_RESET   + '?userId=' + encodeURIComponent([...selected.keys()][0]); }

    async function abToggle() {
        const ids = [...selected.keys()];
        if (!ids.length) return;
        const msg = ids.length === 1 ? 'تغيير حالة هذا المستخدم؟' : `تغيير حالة ${ids.length} مستخدمين؟`;
        if (!confirm(msg)) return;
        document.getElementById('abToggle').disabled = true;
        for (const id of ids) await postFetch(U_TOGGLE, { userId: id });
        location.reload();
    }

    async function abDelete() {
        const ids = [...selected.keys()];
        if (!ids.length) return;
        const msg = ids.length === 1
            ? 'حذف هذا المستخدم؟ لا يمكن التراجع.'
            : `حذف ${ids.length} مستخدمين؟ لا يمكن التراجع.`;
        if (!confirm(msg)) return;
        document.getElementById('abDelete').disabled = true;
        for (const id of ids) await postFetch(U_DELETE, { id });
        location.reload();
    }

    /* ════════════════════════════════════
       EVENT WIRING
       ════════════════════════════════════ */
    document.addEventListener('change', e => {
        if (e.target.classList.contains('select-all-cb')) {
            const tableId = e.target.dataset.table;
            const table   = document.getElementById(tableId);
            table?.querySelectorAll('tbody .user-cb').forEach(cb => {
                cb.checked = e.target.checked;
                selectRow(cb);
            });
            syncSelectAll(table);
        } else if (e.target.classList.contains('user-cb')) {
            selectRow(e.target);
        }
    });

    // Row click toggles checkbox
    document.querySelectorAll('table.styled tbody').forEach(tbody => {
        tbody.addEventListener('click', e => {
            const tr = e.target.closest('tr');
            if (!tr || tr.classList.contains('empty-row')) return;
            if (e.target.closest('.user-cb')) return;
            const cb = tr.querySelector('.user-cb');
            if (cb) { cb.checked = !cb.checked; selectRow(cb); }
        });
    });

    /* ════════════════════════════════════
       TABS
       ════════════════════════════════════ */
    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById(btn.dataset.tab).classList.add('active');
        });
    });

    /* ════════════════════════════════════
       LIVE SEARCH
       ════════════════════════════════════ */
    function wireSearch(inputId, tableId) {
        const input = document.getElementById(inputId);
        const tbody = document.querySelector('#' + tableId + ' tbody');
        if (!input || !tbody) return;
        input.addEventListener('input', () => {
            const q = input.value.trim().toLowerCase();
            tbody.querySelectorAll('tr:not(.empty-row)').forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        });
    }

    wireSearch('search-students',    'tbl-students');
    wireSearch('search-instructors', 'tbl-instructors');
    wireSearch('search-admins',      'tbl-admins');

    /* ════════════════════════════════════
       IMPORT: فلترة الدفعات حسب الفرع
       ════════════════════════════════════ */
    const U_BATCHES_BY_BRANCH = '@Url.Action("GetBatchesByBranch", "PartnerAdmin", new { area="Admin" })';
    const PARTNER_ID = @Model.PartnerId;

    function loadBatchesForBranch(branchId) {
        const sel = document.getElementById('import-batch');
        sel.innerHTML = '<option value="">— تحميل ... —</option>';

        if (!branchId) {
            sel.innerHTML = '<option value="">— اختر دفعة —</option>';
            return;
        }

        fetch(`${U_BATCHES_BY_BRANCH}?branchId=${branchId}&partnerId=${PARTNER_ID}`)
            .then(r => r.json())
            .then(items => {
                sel.innerHTML = '<option value="">— اختر دفعة —</option>';
                items.forEach(b => {
                    const opt = document.createElement('option');
                    opt.value = b.value;
                    opt.textContent = b.text + (b.isActive ? '' : ' (غير نشطة)');
                    sel.appendChild(opt);
                });
            })
            .catch(() => {
                sel.innerHTML = '<option value="">— تعذّر التحميل —</option>';
            });
    }

    /* ════════════════════════════════════
       TempData alerts
       ════════════════════════════════════ */
    @if (TempData["Success"] != null)
    {
        <text>
        (function() {
            const msg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"]?.ToString() ?? ""));
            const el = document.createElement('div');
            el.style.cssText = 'position:fixed;top:1rem;left:50%;transform:translateX(-50%);background:#0D7A5B;color:#fff;padding:.65rem 1.4rem;border-radius:10px;z-index:99999;font-family:Cairo,sans-serif;font-size:.88rem;font-weight:600;box-shadow:0 4px 20px rgba(0,0,0,.18)';
            el.textContent = msg;
            document.body.appendChild(el);
            setTimeout(() => el.remove(), 4000);
        })();
        </text>
    }
    @if (TempData["Error"] != null)
    {
        <text>
        (function() {
            const msg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"]?.ToString() ?? ""));
            const el = document.createElement('div');
            el.style.cssText = 'position:fixed;top:1rem;left:50%;transform:translateX(-50%);background:#BF1030;color:#fff;padding:.65rem 1.4rem;border-radius:10px;z-index:99999;font-family:Cairo,sans-serif;font-size:.88rem;font-weight:600;box-shadow:0 4px 20px rgba(0,0,0,.18);max-width:80vw;text-align:center';
            el.innerHTML = msg;
            document.body.appendChild(el);
            setTimeout(() => el.remove(), 6000);
        })();
        </text>
    }

    /* ════════════════════════════════════
       Tab persistence via hash
       ════════════════════════════════════ */
    (function() {
        const hash = location.hash.replace('#', '');
        if (hash) {
            const btn = document.querySelector(`.tab-btn[data-tab="${hash}"]`);
            if (btn) btn.click();
        }
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                history.replaceState(null, '', '#' + btn.dataset.tab);
            });
        });
    })();
    </script>
}
