                <button type="submit"
                        style="background:#2E7D32;color:#fff;border:none;border-radius:8px;padding:.45rem 1.2rem;font-family:'Cairo',sans-serif;font-size:.88rem;font-weight:700;cursor:pointer">
                    <i class="bi bi-send-fill"></i> إرسال الاختبار
