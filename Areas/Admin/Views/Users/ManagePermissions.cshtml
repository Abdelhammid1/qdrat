@model QdratNew.ViewModels.Users.ManagePermissionsViewModel

@{
    ViewData["Title"] = "إدارة صلاحيات المستخدم";

    var totalPermissions = Model.Permissions != null ? Model.Permissions.Count : 0;
    var grantedPermissions = Model.Permissions != null ? Model.Permissions.Count(x => x.IsGranted) : 0;
    var deniedPermissions = totalPermissions - grantedPermissions;
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        :root {
            --ink: #0D1B2A;
            --ink-2: #2C3E50;
            --ink-3: #5A6A7A;
            --ink-4: #8FA0B0;
            --ink-5: #C8D5E0;
            --canvas: #F3F6FA;
            --surface: #FFFFFF;
            --surface-2: #F8FAFC;
            --surface-3: #EEF2F7;
            --border: #DDE4EC;
            --blue: #1B5EAE;
            --blue-2: #2471D0;
            --blue-bg: #E8F1FB;
            --blue-dark: #103E7A;
            --emerald: #0D7A5B;
            --emerald-bg: #E4F5EE;
            --amber: #985D09;
            --amber-bg: #FDF0D8;
            --rose: #BF1030;
            --rose-bg: #FDEAEE;
            --violet: #5535B5;
            --violet-bg: #EDE8F9;
            --r-sm: 6px;
            --r-md: 10px;
            --r-lg: 14px;
            --r-xl: 20px;
            --sh-xs: 0 1px 3px rgba(13,27,42,.06);
            --sh-sm: 0 2px 8px rgba(13,27,42,.08);
            --sh-md: 0 4px 18px rgba(13,27,42,.10);
            --ease: cubic-bezier(.25,.46,.45,.94);
        }

        .permissions-page {
            background: var(--canvas);
            min-height: 100vh;
            padding: 32px 28px 64px;
            direction: rtl;
            font-family: 'Cairo';
            color: var(--ink-2);
        }

        .permissions-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 14px;
            margin-bottom: 28px;
        }

        .permissions-brand {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .permissions-brand-icon {
            width: 46px;
            height: 46px;
            background: var(--blue);
            border-radius: var(--r-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 20px;
            box-shadow: 0 4px 14px rgba(27,94,174,.28);
        }

        .permissions-brand-title {
            font-size: 20px;
            font-weight: 700;
            color: var(--ink);
            line-height: 1.15;
        }

        .permissions-brand-sub {
            font-size: 16px;
            color: var(--ink-4);
            margin-top: 2px;
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn-secondary-action {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: var(--surface);
            color: var(--blue);
            border: 1px solid #B6D3F4;
            border-radius: var(--r-md);
            padding: 10px 20px;
            font-size: 18px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: background .16s var(--ease), transform .14s, box-shadow .16s;
        }

            .btn-secondary-action:hover {
                background: var(--blue-bg);
                color: var(--blue-dark);
                transform: translateY(-2px);
                box-shadow: var(--sh-sm);
            }

        .permissions-kpis {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 13px;
            margin-bottom: 24px;
        }

        @@media (max-width: 960px) {
            .permissions-kpis {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 480px) {
            .permissions-kpis {
                grid-template-columns: 1fr;
            }
        }

        .kpi-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            padding: 18px 19px;
            display: flex;
            align-items: center;
            gap: 13px;
            box-shadow: var(--sh-xs);
            transition: transform .2s var(--ease), box-shadow .2s;
            position: relative;
            overflow: hidden;
        }

            .kpi-card::after {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 4px;
                height: 100%;
                border-radius: 0 var(--r-xl) var(--r-xl) 0;
            }

            .kpi-card:hover {
                transform: translateY(-3px);
                box-shadow: var(--sh-sm);
            }

        .kpi-blue::after {
            background: var(--blue);
        }

        .kpi-emerald::after {
            background: var(--emerald);
        }

        .kpi-amber::after {
            background: var(--amber);
        }

        .kpi-violet::after {
            background: var(--violet);
        }

        .kpi-ico {
            width: 42px;
            height: 42px;
            border-radius: var(--r-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .ico-blue {
            background: var(--blue-bg);
            color: var(--blue);
        }

        .ico-emerald {
            background: var(--emerald-bg);
            color: var(--emerald);
        }

        .ico-amber {
            background: var(--amber-bg);
            color: var(--amber);
        }

        .ico-violet {
            background: var(--violet-bg);
            color: var(--violet);
        }

        .kpi-label {
            font-size: 13px;
            font-weight: 700;
            color: var(--ink-4);
            margin-bottom: 3px;
        }

        .kpi-val {
            font-size: 18px;
            font-weight: 700;
            color: var(--ink);
            line-height: 1;
        }

        .permissions-form-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            overflow: hidden;
            box-shadow: var(--sh-sm);
            margin-bottom: 24px;
        }

        .permissions-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 16px 18px;
            border-bottom: 1px solid var(--surface-3);
            flex-wrap: wrap;
        }

        .section-title {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 18px;
            font-weight: 800;
            color: var(--ink);
            margin: 0;
        }

            .section-title i {
                color: var(--blue);
            }

        .permissions-search-wrap {
            position: relative;
            flex: 1;
            min-width: 220px;
            max-width: 390px;
        }

            .permissions-search-wrap i {
                position: absolute;
                right: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--ink-4);
                font-size: 17px;
                pointer-events: none;
            }

            .permissions-search-wrap input {
                width: 100%;
                padding: 7px 32px 7px 12px;
                border: 1px solid var(--border);
                border-radius: var(--r-md);
                font-size: 18px;
                background: var(--surface-2);
                color: var(--ink);
                transition: border-color .15s, box-shadow .15s;
            }

                .permissions-search-wrap input:focus {
                    outline: none;
                    border-color: var(--blue-2);
                    box-shadow: 0 0 0 3px rgba(36,113,208,.1);
                    background: var(--surface);
                }

        .permissions-card-body {
            padding: 20px 22px 22px;
        }

        .user-info-card {
            background: var(--surface-2);
            border: 1px solid var(--surface-3);
            border-radius: var(--r-lg);
            padding: 16px 18px;
            margin-bottom: 20px;
        }

        .user-info-label {
            font-size: 15px;
            font-weight: 700;
            color: var(--ink-4);
            margin-bottom: 6px;
        }

        .user-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--blue-bg);
            color: var(--blue);
            padding: 6px 12px;
            border-radius: 30px;
            font-size: 17px;
            font-weight: 800;
        }

        .permissions-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }

        @@media (max-width: 992px) {
            .permissions-grid {
                grid-template-columns: 1fr;
            }
        }

        .permission-card {
            position: relative;
            background: var(--surface-2);
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            padding: 14px 14px;
            transition: border-color .15s, box-shadow .15s, transform .15s, background .15s;
            cursor: pointer;
            min-height: 64px;
        }

            .permission-card:hover {
                border-color: #B6D3F4;
                box-shadow: var(--sh-xs);
                transform: translateY(-2px);
            }

            .permission-card.is-granted {
                background: var(--emerald-bg);
                border-color: #B8E8D3;
            }

        .permission-card-inner {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .permission-check {
            width: 22px;
            height: 22px;
            margin: 0;
            cursor: pointer;
            flex-shrink: 0;
        }

        .permission-icon {
            width: 36px;
            height: 36px;
            border-radius: 9px;
            background: var(--blue-bg);
            color: var(--blue);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            flex-shrink: 0;
            transition: background .15s, color .15s;
        }

        .permission-card.is-granted .permission-icon {
            background: var(--emerald);
            color: #fff;
        }

        .permission-name {
            font-size: 17px;
            font-weight: 800;
            color: var(--ink);
            cursor: pointer;
            margin: 0;
            line-height: 1.6;
        }

        .permission-state {
            margin-right: auto;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 30px;
            font-size: 14px;
            font-weight: 800;
            background: var(--surface-3);
            color: var(--ink-4);
            white-space: nowrap;
        }

        .permission-card.is-granted .permission-state {
            background: var(--surface);
            color: var(--emerald);
        }

        .empty-permissions {
            text-align: center;
            padding: 44px 16px;
            color: var(--ink-4);
        }

            .empty-permissions i {
                font-size: 20px;
                display: block;
                margin-bottom: 12px;
                color: var(--ink-5);
            }

        .empty-permissions-title {
            font-size: 18px;
            font-weight: 700;
            color: var(--ink-3);
        }

        .empty-permissions-sub {
            font-size: 16px;
            margin-top: 4px;
        }

        .form-actions {
            display: flex;
            justify-content: flex-start;
            gap: 10px;
            flex-wrap: wrap;
            padding: 18px 22px;
            border-top: 1px solid var(--surface-3);
            background: var(--surface-2);
        }

        .btn-main-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            background: var(--blue);
            color: #fff;
            border: none;
            border-radius: var(--r-md);
            padding: 10px 20px;
            height: 42px;
            font-size: 18px;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            box-shadow: 0 3px 10px rgba(27,94,174,.22);
            transition: background .16s var(--ease), transform .14s, box-shadow .16s;
            white-space: nowrap;
        }

            .btn-main-action:hover {
                background: var(--blue-dark);
                color: #fff;
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(27,94,174,.28);
            }

        .btn-reset {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            padding: 8px 18px;
            height: 42px;
            border: 1px solid var(--border);
            border-radius: var(--r-md);
            font-size: 17px;
            font-weight: 700;
            color: var(--ink-3);
            background: var(--surface);
            text-decoration: none;
            transition: all .15s;
        }

            .btn-reset:hover {
                background: var(--rose-bg);
                border-color: #F5BBC4;
                color: var(--rose);
            }

        @@media (max-width: 768px) {
            .permissions-page {
                padding: 22px 14px 48px;
            }

            .top-actions {
                width: 100%;
            }

            .btn-secondary-action,
            .btn-main-action,
            .btn-reset {
                width: 100%;
                justify-content: center;
            }

            .permissions-card-header {
                align-items: stretch;
            }

            .permissions-search-wrap {
                max-width: 100%;
                width: 100%;
            }

            .form-actions {
                flex-direction: column;
            }
        }
    </style>
}

<div class="permissions-page">

    <div class="permissions-topbar">
        <div class="permissions-brand">
            <div class="permissions-brand-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <div>
                <div class="permissions-brand-title">إدارة صلاحيات المستخدم</div>
                <div class="permissions-brand-sub">
                    تحديد الصلاحيات المسموحة للمستخدم داخل لوحة الإدارة.
                </div>
            </div>
        </div>

        <div class="top-actions">
            <a asp-action="Index" class="btn-secondary-action">
                <i class="bi bi-arrow-left"></i>
                عودة
            </a>
        </div>
    </div>

    <div class="permissions-kpis">

        <div class="kpi-card kpi-blue">
            <div class="kpi-ico ico-blue">
                <i class="bi bi-person-badge"></i>
            </div>
            <div>
                <div class="kpi-label">المستخدم</div>
                <div class="kpi-val">@Model.FullName</div>
            </div>
        </div>

        <div class="kpi-card kpi-emerald">
            <div class="kpi-ico ico-emerald">
                <i class="bi bi-check-circle"></i>
            </div>
            <div>
                <div class="kpi-label">صلاحيات مفعلة</div>
                <div class="kpi-val">@grantedPermissions</div>
            </div>
        </div>

        <div class="kpi-card kpi-amber">
            <div class="kpi-ico ico-amber">
                <i class="bi bi-list-check"></i>
            </div>
            <div>
                <div class="kpi-label">إجمالي الصلاحيات</div>
                <div class="kpi-val">@totalPermissions</div>
            </div>
        </div>

        <div class="kpi-card kpi-violet">
            <div class="kpi-ico ico-violet">
                <i class="bi bi-shield-x"></i>
            </div>
            <div>
                <div class="kpi-label">غير مفعلة</div>
                <div class="kpi-val">@deniedPermissions</div>
            </div>
        </div>

    </div>

    <form asp-action="ManagePermissions" method="post" class="permissions-form-card">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />

        <div class="permissions-card-header">
            <h5 class="section-title">
                <i class="bi bi-ui-checks-grid"></i>
                قائمة الصلاحيات
            </h5>

            <div class="permissions-search-wrap">
                <i class="bi bi-search"></i>
                <input type="text"
                       id="permissionsSearch"
                       placeholder="ابحث في الصلاحيات..." />
            </div>
        </div>

        <div class="permissions-card-body">

            <div class="user-info-card">
                <div class="user-info-label">المستخدم الحالي</div>
                <div class="user-chip">
                    <i class="bi bi-person"></i>
                    @Model.FullName
                </div>
            </div>

            @if (Model.Permissions == null || !Model.Permissions.Any())
            {
                <div class="empty-permissions">
                    <i class="bi bi-inbox"></i>
                    <div class="empty-permissions-title">لا توجد صلاحيات متاحة</div>
                    <div class="empty-permissions-sub">تأكد من تهيئة قائمة الصلاحيات داخل النظام</div>
                </div>
            }
            else
            {
                <div class="permissions-grid" id="permissionsGrid">
                    @for (int i = 0; i < Model.Permissions.Count; i++)
                    {
                        var cardClass = Model.Permissions[i].IsGranted ? "permission-card is-granted" : "permission-card";
                        var stateText = Model.Permissions[i].IsGranted ? "مفعلة" : "غير مفعلة";

                        <label class="@cardClass"
                               for="permission_@i"
                               data-search="@Model.Permissions[i].Display.ToLower()">

                            <input type="hidden" name="Permissions[@i].Value" value="@Model.Permissions[i].Value" />
                            <input type="hidden" name="Permissions[@i].Display" value="@Model.Permissions[i].Display" />

                            <div class="permission-card-inner">
                                <input class="form-check-input permission-check"
                                       type="checkbox"
                                       id="permission_@i"
                                       name="Permissions[@i].IsGranted"
                                       value="true"
                                       @(Model.Permissions[i].IsGranted ? "checked" : "") />

                                <span class="permission-icon">
                                    <i class="bi bi-shield-check"></i>
                                </span>

                                <span class="permission-name">
                                    @Model.Permissions[i].Display
                                </span>

                                <span class="permission-state">
                                    @stateText
                                </span>
                            </div>
                        </label>
                    }
                </div>
            }

        </div>

        <div class="form-actions">
            <button type="submit" class="btn-main-action">
                <i class="bi bi-save"></i>
                حفظ الصلاحيات
            </button>

            <a asp-action="Index" class="btn-reset">
                <i class="bi bi-arrow-counterclockwise"></i>
                عودة
            </a>
        </div>
    </form>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            document.querySelectorAll(".permission-check").forEach(function (checkbox) {
                checkbox.addEventListener("change", function () {
                    var card = this.closest(".permission-card");
                    var state = card ? card.querySelector(".permission-state") : null;

                    if (!card) {
                        return;
                    }

                    if (this.checked) {
                        card.classList.add("is-granted");
                        if (state) {
                            state.textContent = "مفعلة";
                        }
                    } else {
                        card.classList.remove("is-granted");
                        if (state) {
                            state.textContent = "غير مفعلة";
                        }
                    }
                });
            });

            /* ── Smart permission icons ── */
            var permIcons = {
                'view':    'bi-eye',          'read':   'bi-eye',
                'create':  'bi-plus-circle',  'add':    'bi-plus-circle',
                'edit':    'bi-pencil',       'update': 'bi-pencil',
                'delete':  'bi-trash',        'remove': 'bi-trash',
                'manage':  'bi-gear',         'admin':  'bi-shield-lock',
                'export':  'bi-download',     'import': 'bi-upload',
                'report':  'bi-bar-chart',    'print':  'bi-printer',
                'assign':  'bi-person-check', 'role':   'bi-shield-check',
                'user':    'bi-person',       'batch':  'bi-collection',
                'course':  'bi-book',         'payment':'bi-credit-card',
                'default': 'bi-shield-check'
            };
            function getPermIcon(text) {
                if (!text) return permIcons['default'];
                var t = text.toLowerCase();
                for (var k in permIcons) {
                    if (t.includes(k)) return permIcons[k];
                }
                return permIcons['default'];
            }
            document.querySelectorAll(".permission-card").forEach(function(card) {
                var nameEl = card.querySelector(".permission-name");
                var iconEl = card.querySelector(".permission-icon i");
                if (nameEl && iconEl) {
                    iconEl.className = 'bi ' + getPermIcon(nameEl.textContent.trim());
                }
            });

            var searchInput = document.getElementById("permissionsSearch");
            var cards = Array.from(document.querySelectorAll(".permission-card"));

            if (searchInput) {
                searchInput.addEventListener("input", function () {
                    var value = (this.value || "").toLowerCase().trim();

                    cards.forEach(function (card) {
                        var text = card.getAttribute("data-search") || "";
                        card.style.display = text.includes(value) ? "" : "none";
                    });
                });
            }

        });
    </script>
}