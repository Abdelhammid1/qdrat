@using QdratNew.ViewModels.Admin
@model PartnersListViewModel

@{
    ViewData["Title"] = "مستخدمو الشركاء";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --ink: #0D1B2A;
            --ink-3: #5A6A7A;
            --canvas: #F3F6FA;
            --surface: #FFFFFF;
            --border: #DDE4EC;
            --blue: #1B5EAE;
            --blue-bg: #E8F1FB;
            --emerald: #0D7A5B;
            --emerald-bg: #E4F5EE;
            --amber: #985D09;
            --amber-bg: #FDF0D8;
            --rose: #BF1030;
            --rose-bg: #FDEAEE;
            --radius: 12px;
            --shadow: 0 2px 10px rgba(0,0,0,.07);
        }

        body { background: var(--canvas); font-family: 'Cairo', sans-serif; direction: rtl; }

        .page-wrap { padding: 1.75rem 1.5rem; }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 1.75rem;
        }

        .page-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--ink);
        }

        .page-title-bar {
            width: 4px;
            height: 22px;
            background: var(--blue);
            border-radius: 2px;
        }

        .badge-total {
            background: var(--blue-bg);
            color: var(--blue);
            font-size: .78rem;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: 20px;
        }

        .partners-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 1.25rem;
        }

        .partner-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            overflow: hidden;
            transition: transform .15s, box-shadow .15s;
        }

        .partner-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0,0,0,.1);
        }

        .card-head {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 1.1rem 1.25rem;
            border-bottom: 1px solid var(--border);
        }

        .partner-logo {
            width: 52px;
            height: 52px;
            border-radius: 10px;
            object-fit: contain;
            border: 1px solid var(--border);
            background: var(--canvas);
            padding: 4px;
            flex-shrink: 0;
        }

        .partner-logo-placeholder {
            width: 52px;
            height: 52px;
            border-radius: 10px;
            background: var(--blue-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--blue);
            font-size: 1.4rem;
            flex-shrink: 0;
        }

        .partner-name {
            font-size: 1rem;
            font-weight: 700;
            color: var(--ink);
            margin-bottom: 2px;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: .72rem;
            font-weight: 600;
            padding: 2px 9px;
            border-radius: 20px;
        }

        .status-active { background: var(--emerald-bg); color: var(--emerald); }
        .status-inactive { background: var(--rose-bg); color: var(--rose); }

        .card-stats {
            display: flex;
            gap: 0;
            padding: .85rem 1.25rem;
        }

        .stat-item {
            flex: 1;
            text-align: center;
            padding: .4rem .5rem;
        }

        .stat-item + .stat-item {
            border-right: 1px solid var(--border);
        }

        .stat-num {
            font-size: 1.3rem;
            font-weight: 700;
            line-height: 1;
            margin-bottom: 3px;
        }

        .stat-lbl {
            font-size: .7rem;
            color: var(--ink-3);
            font-weight: 500;
        }

        .num-blue { color: var(--blue); }
        .num-emerald { color: var(--emerald); }
        .num-amber { color: var(--amber); }

        .card-footer-btn {
            display: block;
            text-align: center;
            padding: .7rem 1.25rem;
            background: var(--blue-bg);
            color: var(--blue);
            font-size: .85rem;
            font-weight: 600;
            text-decoration: none;
            border-top: 1px solid var(--border);
            transition: background .15s;
        }

        .card-footer-btn:hover {
            background: #d0e5f8;
            color: var(--blue);
            text-decoration: none;
        }

        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            color: var(--ink-3);
        }

        .empty-state i { font-size: 3rem; margin-bottom: 1rem; display: block; }
    </style>
}

<div class="page-wrap">

    <div class="topbar">
        <div class="page-title">
            <div class="page-title-bar"></div>
            <i class="bi bi-building"></i>
            مستخدمو الشركاء
            <span class="badge-total">@Model.Partners.Count شريك</span>
        </div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-people"></i> مستخدمو المنصة
        </a>
    </div>

    @if (!Model.Partners.Any())
    {
        <div class="empty-state">
            <i class="bi bi-building-slash"></i>
            <p>لا يوجد شركاء مسجلون حتى الآن</p>
        </div>
    }
    else
    {
        <div class="partners-grid">
            @foreach (var p in Model.Partners)
            {
                <div class="partner-card">
                    <div class="card-head">
                        @if (!string.IsNullOrWhiteSpace(p.LogoPath))
                        {
                            <img src="@p.LogoPath" alt="@p.Name" class="partner-logo" />
                        }
                        else
                        {
                            <div class="partner-logo-placeholder"><i class="bi bi-building"></i></div>
                        }
                        <div>
                            <div class="partner-name">@p.Name</div>
                            @if (p.IsActive)
                            {
                                <span class="status-badge status-active"><i class="bi bi-circle-fill" style="font-size:.5rem"></i> نشط</span>
                            }
                            else
                            {
                                <span class="status-badge status-inactive"><i class="bi bi-circle-fill" style="font-size:.5rem"></i> منتهي</span>
                            }
                        </div>
                    </div>

                    <div class="card-stats">
                        <div class="stat-item">
                            <div class="stat-num num-blue">@p.StudentsCount</div>
                            <div class="stat-lbl">طالب</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-num num-emerald">@p.InstructorsCount</div>
                            <div class="stat-lbl">مدرب</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-num num-amber">@p.AdminsCount</div>
                            <div class="stat-lbl">إداري</div>
                        </div>
                    </div>

                    <a asp-action="PartnerUserDetails" asp-route-partnerId="@p.Id" class="card-footer-btn">
                        <i class="bi bi-people"></i> عرض المستخدمين
                    </a>
                </div>
            }
        </div>
    }

</div>
