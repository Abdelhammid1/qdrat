@model QdratNew.ViewModels.Users.AssignRolesViewModel

@{
    ViewData["Title"] = "تعيين الأدوار";

    var rolesList = Model.Roles != null
        ? Model.Roles.ToList()
        : new List<QdratNew.ViewModels.Users.RoleSelectionViewModel>();

    var totalRoles = rolesList.Count;
    var selectedRoles = rolesList.Count(x => x.IsSelected);
    var unselectedRoles = totalRoles - selectedRoles;
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        :root {
            --ink: #0D1B2A;
            --ink-2: #2C3E50;
            --ink-3: #5A6A7A;
            --ink-4: #8FA0B0;
            --ink-5: #C8D5E0;
            --canvas: #F3F6FA;
            --surface: #FFFFFF;
            --surface-2: #F8FAFC;
            --surface-3: #EEF2F7;
            --border: #DDE4EC;
            --blue: #1B5EAE;
            --blue-2: #2471D0;
            --blue-bg: #E8F1FB;
            --blue-dark: #103E7A;
            --emerald: #0D7A5B;
            --emerald-bg: #E4F5EE;
            --amber: #985D09;
            --amber-bg: #FDF0D8;
            --rose: #BF1030;
            --rose-bg: #FDEAEE;
            --violet: #5535B5;
            --violet-bg: #EDE8F9;
            --r-sm: 6px;
            --r-md: 10px;
            --r-lg: 14px;
            --r-xl: 20px;
            --sh-xs: 0 1px 3px rgba(13,27,42,.06);
            --sh-sm: 0 2px 8px rgba(13,27,42,.08);
            --sh-md: 0 4px 18px rgba(13,27,42,.10);
            --ease: cubic-bezier(.25,.46,.45,.94);
        }

        .roles-page {
            background: var(--canvas);
            min-height: 100vh;
            padding: 32px 28px 64px;
            direction: rtl;
            font-family: 'Cairo';
            color: var(--ink-2);
        }

        .roles-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 14px;
            margin-bottom: 28px;
        }

        .roles-brand {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .roles-brand-icon {
            width: 46px;
            height: 46px;
            background: var(--blue);
            border-radius: var(--r-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 20px;
            box-shadow: 0 4px 14px rgba(27,94,174,.28);
        }

        .roles-brand-title {
            font-size: 20px;
            font-weight: 700;
            color: var(--ink);
            line-height: 1.15;
        }

        .roles-brand-sub {
            font-size: 14px;
            color: var(--ink-4);
            margin-top: 2px;
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn-secondary-action {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: var(--surface);
            color: var(--blue);
            border: 1px solid #B6D3F4;
            border-radius: var(--r-md);
            padding: 10px 20px;
            font-size: 18px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: background .16s var(--ease), transform .14s, box-shadow .16s;
        }

            .btn-secondary-action:hover {
                background: var(--blue-bg);
                color: var(--blue-dark);
                transform: translateY(-2px);
                box-shadow: var(--sh-sm);
            }

        .roles-alert {
            border: none;
            border-radius: var(--r-lg);
            padding: 14px 18px;
            font-size: 17px;
            font-weight: 700;
            box-shadow: var(--sh-xs);
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .roles-alert-success {
            background: var(--emerald-bg);
            color: var(--emerald);
        }

        .roles-alert-danger {
            background: var(--rose-bg);
            color: var(--rose);
        }

        .roles-alert-warning {
            background: var(--amber-bg);
            color: var(--amber);
            border: 1px solid #F3D494;
        }

        .roles-kpis {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 13px;
            margin-bottom: 24px;
        }

        @@media (max-width: 960px) {
            .roles-kpis {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 480px) {
            .roles-kpis {
                grid-template-columns: 1fr;
            }
        }

        .kpi-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            padding: 18px 19px;
            display: flex;
            align-items: center;
            gap: 13px;
            box-shadow: var(--sh-xs);
            transition: transform .2s var(--ease), box-shadow .2s;
            position: relative;
            overflow: hidden;
        }

            .kpi-card::after {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 4px;
                height: 100%;
                border-radius: 0 var(--r-xl) var(--r-xl) 0;
            }

            .kpi-card:hover {
                transform: translateY(-3px);
                box-shadow: var(--sh-sm);
            }

        .kpi-blue::after {
            background: var(--blue);
        }

        .kpi-emerald::after {
            background: var(--emerald);
        }

        .kpi-amber::after {
            background: var(--amber);
        }

        .kpi-violet::after {
            background: var(--violet);
        }

        .kpi-ico {
            width: 42px;
            height: 42px;
            border-radius: var(--r-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .ico-blue {
            background: var(--blue-bg);
            color: var(--blue);
        }

        .ico-emerald {
            background: var(--emerald-bg);
            color: var(--emerald);
        }

        .ico-amber {
            background: var(--amber-bg);
            color: var(--amber);
        }

        .ico-violet {
            background: var(--violet-bg);
            color: var(--violet);
        }

        .kpi-label {
            font-size: 13px;
            font-weight: 700;
            color: var(--ink-4);
            margin-bottom: 3px;
        }

        .kpi-val {
            font-size: 18px;
            font-weight: 700;
            color: var(--ink);
            line-height: 1;
        }

        .roles-form-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            overflow: hidden;
            box-shadow: var(--sh-sm);
            margin-bottom: 24px;
        }

        .roles-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 16px 18px;
            border-bottom: 1px solid var(--surface-3);
            flex-wrap: wrap;
        }

        .section-title {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 18px;
            font-weight: 800;
            color: var(--ink);
            margin: 0;
        }

            .section-title i {
                color: var(--blue);
            }

        .roles-card-body {
            padding: 20px 22px 22px;
        }

        .user-info-card {
            background: var(--surface-2);
            border: 1px solid var(--surface-3);
            border-radius: var(--r-lg);
            padding: 16px 18px;
            margin-bottom: 20px;
        }

        .user-info-label {
            font-size: 15px;
            font-weight: 700;
            color: var(--ink-4);
            margin-bottom: 6px;
        }

        .email-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--blue-bg);
            color: var(--blue);
            padding: 6px 12px;
            border-radius: 30px;
            font-size: 17px;
            font-weight: 800;
            direction: ltr;
        }

        .roles-section-title {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 18px;
            font-weight: 800;
            color: var(--ink);
            margin-bottom: 14px;
        }

            .roles-section-title i {
                color: var(--violet);
            }

        .roles-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
        }

        @@media (max-width: 992px) {
            .roles-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 576px) {
            .roles-grid {
                grid-template-columns: 1fr;
            }
        }

        .role-card {
            position: relative;
            background: var(--surface-2);
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            padding: 14px 14px;
            transition: border-color .15s, box-shadow .15s, transform .15s, background .15s;
            cursor: pointer;
            min-height: 64px;
        }

            .role-card:hover {
                border-color: #B6D3F4;
                box-shadow: var(--sh-xs);
                transform: translateY(-2px);
            }

            .role-card.is-selected {
                background: var(--blue-bg);
                border-color: #B6D3F4;
            }

        .role-card-inner {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .role-check {
            width: 22px;
            height: 22px;
            margin: 0;
            cursor: pointer;
            flex-shrink: 0;
        }

        .role-name {
            font-size: 17px;
            font-weight: 800;
            color: var(--ink);
            cursor: pointer;
            margin: 0;
        }

        .role-icon {
            width: 36px;
            height: 36px;
            border-radius: 9px;
            background: var(--blue-bg);
            color: var(--blue);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
            transition: background .15s, color .15s;
        }

        .role-card.is-selected .role-icon {
            background: var(--blue);
            color: #fff;
        }

        .confirmation-card {
            margin-top: 22px;
            background: var(--amber-bg);
            border: 1px solid #F3D494;
            border-radius: var(--r-xl);
            padding: 18px 18px;
        }

        .confirmation-title {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--amber);
            font-size: 17px;
            font-weight: 800;
            margin-bottom: 12px;
        }

        .confirmation-text {
            color: var(--amber);
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 14px;
            line-height: 1.8;
        }

        .password-field label {
            display: block;
            font-size: 16px;
            font-weight: 700;
            color: var(--ink-3);
            margin-bottom: 5px;
        }

        .password-input {
            width: 100%;
            padding: 8px 12px;
            border: 1px solid var(--border);
            border-radius: var(--r-md);
            font-size: 18px;
            background: var(--surface);
            color: var(--ink);
            transition: border-color .16s, box-shadow .16s;
        }

            .password-input:focus {
                outline: none;
                border-color: var(--blue-2);
                box-shadow: 0 0 0 3px rgba(36,113,208,.11);
            }

        .form-actions {
            display: flex;
            justify-content: flex-start;
            gap: 10px;
            flex-wrap: wrap;
            padding: 18px 22px;
            border-top: 1px solid var(--surface-3);
            background: var(--surface-2);
        }

        .btn-main-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            background: var(--blue);
            color: #fff;
            border: none;
            border-radius: var(--r-md);
            padding: 10px 20px;
            height: 42px;
            font-size: 18px;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            box-shadow: 0 3px 10px rgba(27,94,174,.22);
            transition: background .16s var(--ease), transform .14s, box-shadow .16s;
            white-space: nowrap;
        }

            .btn-main-action:hover {
                background: var(--blue-dark);
                color: #fff;
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(27,94,174,.28);
            }

        .btn-reset {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            padding: 8px 18px;
            height: 42px;
            border: 1px solid var(--border);
            border-radius: var(--r-md);
            font-size: 17px;
            font-weight: 700;
            color: var(--ink-3);
            background: var(--surface);
            text-decoration: none;
            transition: all .15s;
        }

            .btn-reset:hover {
                background: var(--rose-bg);
                border-color: #F5BBC4;
                color: var(--rose);
            }

        @@media (max-width: 768px) {
            .roles-page {
                padding: 22px 14px 48px;
            }

            .top-actions {
                width: 100%;
            }

            .btn-secondary-action,
            .btn-main-action,
            .btn-reset {
                width: 100%;
                justify-content: center;
            }

            .form-actions {
                flex-direction: column;
            }
        }
    </style>
}

<div class="roles-page">

    @if (TempData["Error"] != null)
    {
        <div class="roles-alert roles-alert-danger">
            <i class="bi bi-exclamation-circle-fill"></i>
            @TempData["Error"]
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="roles-alert roles-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]
        </div>
    }

    <div class="roles-topbar">
        <div class="roles-brand">
            <div class="roles-brand-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <div>
                <div class="roles-brand-title">تعيين الأدوار للمستخدم</div>
                <div class="roles-brand-sub">
                    إدارة أدوار المستخدم مع حماية الأدوار الحساسة بتأكيد كلمة المرور.
                </div>
            </div>
        </div>

        <div class="top-actions">
            <a asp-action="Index" class="btn-secondary-action">
                <i class="bi bi-arrow-left"></i>
                رجوع
            </a>
        </div>
    </div>

    <div class="roles-kpis">

        <div class="kpi-card kpi-blue">
            <div class="kpi-ico ico-blue">
                <i class="bi bi-person-badge"></i>
            </div>
            <div>
                <div class="kpi-label">المستخدم</div>
                <div class="kpi-val">@Model.Email</div>
            </div>
        </div>

        <div class="kpi-card kpi-emerald">
            <div class="kpi-ico ico-emerald">
                <i class="bi bi-check-circle"></i>
            </div>
            <div>
                <div class="kpi-label">أدوار مفعلة</div>
                <div class="kpi-val">@selectedRoles</div>
            </div>
        </div>

        <div class="kpi-card kpi-amber">
            <div class="kpi-ico ico-amber">
                <i class="bi bi-list-check"></i>
            </div>
            <div>
                <div class="kpi-label">إجمالي الأدوار</div>
                <div class="kpi-val">@totalRoles</div>
            </div>
        </div>

        <div class="kpi-card kpi-violet">
            <div class="kpi-ico ico-violet">
                <i class="bi bi-shield-exclamation"></i>
            </div>
            <div>
                <div class="kpi-label">تأكيد مطلوب</div>
                <div class="kpi-val">@(Model.RequiresConfirmation ? "نعم" : "لا")</div>
            </div>
        </div>

    </div>

    <form asp-action="AssignRoles" method="post" class="roles-form-card">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="UserId" />

        <div class="roles-card-header">
            <h5 class="section-title">
                <i class="bi bi-person-lock"></i>
                بيانات المستخدم والأدوار
            </h5>
        </div>

        <div class="roles-card-body">

            <div class="user-info-card">
                <div class="user-info-label">البريد الإلكتروني</div>
                <div class="email-chip">
                    <i class="bi bi-envelope"></i>
                    @Model.Email
                </div>
            </div>

            <div class="roles-section-title">
                <i class="bi bi-ui-checks-grid"></i>
                الأدوار المتاحة
            </div>

            <div class="roles-grid">
                @for (int i = 0; i < Model.Roles.Count; i++)
                {
                    var cardClass = Model.Roles[i].IsSelected ? "role-card is-selected" : "role-card";

                    <label class="@cardClass" for="role_@i">
                        <input type="hidden" name="Roles[@i].RoleName"    value="@Model.Roles[i].RoleName" />
                        <input type="hidden" name="Roles[@i].DisplayName" value="@Model.Roles[i].DisplayName" />

                        <div class="role-card-inner">
                            <input class="form-check-input role-check"
                                   type="checkbox"
                                   name="Roles[@i].IsSelected"
                                   id="role_@i"
                                   value="true"
                                   @(Model.Roles[i].IsSelected ? "checked" : "") />
                            <input type="hidden"
                                   name="Roles[@i].IsSelected"
                                   value="false" />

                            <span class="role-icon">
                                <i class="bi bi-shield-check"></i>
                            </span>

                            <span class="role-name">
                                @Model.Roles[i].DisplayName
                            </span>
                        </div>
                    </label>
                }
            </div>

            @if (Model.RequiresConfirmation)
            {
                <div class="confirmation-card">
                    <div class="confirmation-title">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        تأكيد أدوار حساسة
                    </div>

                    <div class="confirmation-text">
                        هذا التعديل يمس أدوارًا حساسة مثل مالك / سوبر أدمن / مبرمج.
                        يرجى تأكيد كلمة المرور الخاصة بك لإتمام العملية.
                    </div>

                    <div class="password-field">
                        <label asp-for="ConfirmPassword">
                            <i class="bi bi-key" style="color:var(--amber);margin-left:4px"></i>
                            تأكيد كلمة المرور
                        </label>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="password-input"
                               autocomplete="current-password" />
                    </div>
                </div>
            }

        </div>

        <div class="form-actions">
            <button type="submit" class="btn-main-action">
                <i class="bi bi-save"></i>
                حفظ التغييرات
            </button>

            <a asp-action="Index" class="btn-reset">
                <i class="bi bi-arrow-counterclockwise"></i>
                رجوع
            </a>
        </div>
    </form>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            /* ── Role icon map ── */
            var roleIcons = {
                'superadmin':  { icon: 'bi-shield-fill-check',  bg: '#FDEAEE', color: '#BF1030' },
                'owner':       { icon: 'bi-star-fill',           bg: '#FDF0D8', color: '#985D09' },
                'developer':   { icon: 'bi-code-slash',          bg: '#EDE8F9', color: '#5535B5' },
                'admin':       { icon: 'bi-shield-lock-fill',    bg: '#E8F1FB', color: '#1B5EAE' },
                'instructor':  { icon: 'bi-person-video3',       bg: '#E4F5EE', color: '#0D7A5B' },
                'student':     { icon: 'bi-mortarboard-fill',    bg: '#E8F1FB', color: '#1B5EAE' },
                'parent':      { icon: 'bi-people-fill',         bg: '#FDF0D8', color: '#985D09' },
                'manager':     { icon: 'bi-briefcase-fill',      bg: '#EDE8F9', color: '#5535B5' },
                'supervisor':  { icon: 'bi-eye-fill',            bg: '#E4F5EE', color: '#0D7A5B' },
                'default':     { icon: 'bi-shield-check',        bg: '#E8F1FB', color: '#1B5EAE' }
            };

            function getIconDef(roleName) {
                if (!roleName) return roleIcons['default'];
                var key = roleName.toLowerCase().replace(/[\s_-]/g, '');
                for (var k in roleIcons) {
                    if (key.includes(k)) return roleIcons[k];
                }
                return roleIcons['default'];
            }

            document.querySelectorAll(".role-card").forEach(function (card) {
                var nameEl = card.querySelector(".role-name");
                var iconEl = card.querySelector(".role-icon i");
                var iconWrap = card.querySelector(".role-icon");
                if (!nameEl || !iconEl || !iconWrap) return;

                var def = getIconDef(nameEl.textContent.trim());
                iconEl.className = 'bi ' + def.icon;
                iconWrap.style.setProperty('--ri-bg',    def.bg);
                iconWrap.style.setProperty('--ri-color', def.color);
                iconWrap.style.background = def.bg;
                iconWrap.style.color      = def.color;
            });

            /* ── Checkbox toggle ── */
            document.querySelectorAll(".role-check").forEach(function (checkbox) {
                checkbox.addEventListener("change", function () {
                    var card = this.closest(".role-card");
                    if (!card) return;
                    var iconWrap = card.querySelector(".role-icon");
                    if (this.checked) {
                        card.classList.add("is-selected");
                        if (iconWrap) { iconWrap.style.background = ''; iconWrap.style.color = ''; }
                    } else {
                        card.classList.remove("is-selected");
                        var def = getIconDef(card.querySelector(".role-name")?.textContent.trim());
                        if (iconWrap) { iconWrap.style.background = def.bg; iconWrap.style.color = def.color; }
                    }
                });
            });
        });
    </script>
}