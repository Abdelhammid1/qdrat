@model QdratNew.ViewModels.ResetPasswordByAdminViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "إعادة تعيين كلمة المرور";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --p: #1B5EAE; --p-l: #2B78D4; --p-d: #103E7A; --p-bg: #E8F1FB;
            --em: #0D7A5B; --em-bg: #E4F5EE;
            --ro: #BF1030; --ro-bg: #FDEAEE;
            --am: #985D09; --am-bg: #FDF0D8;
            --ink: #0D1B2A; --ink2: #2C3E50; --ink3: #5A6A7A; --ink4: #94A3B8;
            --bg: #EEF3FA; --s0: #fff; --s1: #F8FAFC; --s2: #F1F5F9;
            --bd: #E2EBF5; --bd2: #CBD5E1;
            --r-md: 10px; --r-lg: 14px; --r-xl: 18px; --r-f: 9999px;
            --sh-sm: 0 2px 8px rgba(0,0,0,.07); --sh-md: 0 6px 24px rgba(0,0,0,.10);
            --sh-lg: 0 12px 40px rgba(0,0,0,.13);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Cairo', sans-serif;
            background: var(--bg);
            direction: rtl;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .rp-wrap {
            width: 100%;
            max-width: 480px;
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        /* ── Brand Header ── */
        .rp-brand {
            text-align: center;
            margin-bottom: 24px;
        }
        .rp-brand-icon {
            width: 64px; height: 64px;
            border-radius: 18px;
            background: linear-gradient(135deg, var(--p-d) 0%, var(--p) 100%);
            display: inline-flex; align-items: center; justify-content: center;
            font-size: 1.7rem; color: #fff;
            box-shadow: 0 8px 24px rgba(27,94,174,.35);
            margin-bottom: 14px;
        }
        .rp-brand-title {
            font-size: 1.35rem; font-weight: 800; color: var(--ink);
            margin-bottom: 4px;
        }
        .rp-brand-sub {
            font-size: .82rem; color: var(--ink3);
        }

        /* ── Card ── */
        .rp-card {
            background: var(--s0);
            border: 1px solid var(--bd);
            border-radius: var(--r-xl);
            box-shadow: var(--sh-lg);
            overflow: hidden;
        }

        /* ── User Info Bar ── */
        .rp-user-bar {
            padding: 16px 24px;
            background: linear-gradient(135deg, var(--p-bg) 0%, #dceeff 100%);
            border-bottom: 1px solid var(--bd);
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .rp-user-avatar {
            width: 42px; height: 42px;
            border-radius: 50%;
            background: var(--p);
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 1.1rem; font-weight: 800;
            flex-shrink: 0;
            box-shadow: 0 3px 10px rgba(27,94,174,.3);
        }
        .rp-user-name {
            font-weight: 700; font-size: .95rem; color: var(--p-d);
        }
        .rp-user-email {
            font-size: .78rem; color: var(--ink3); margin-top: 1px;
        }

        /* ── Form Body ── */
        .rp-body { padding: 28px 24px; }

        .rp-alert {
            display: flex; align-items: flex-start; gap: 10px;
            padding: 12px 14px;
            border-radius: var(--r-md);
            font-size: .82rem;
            margin-bottom: 22px;
            border: 1px solid;
        }
        .rp-alert-warning { background: var(--am-bg); border-color: #f3c46b; color: var(--am); }
        .rp-alert-danger  { background: var(--ro-bg); border-color: #f9b4c0; color: var(--ro); display: none; }
        .rp-alert-danger.visible { display: flex; }

        /* ── Field ── */
        .rp-field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 20px; }
        .rp-label {
            font-size: .82rem; font-weight: 700; color: var(--ink2);
            display: flex; align-items: center; gap: 5px;
        }
        .rp-label .req { color: var(--ro); }

        .rp-input-wrap { position: relative; }
        .rp-input {
            width: 100%; height: 46px;
            padding: 0 14px 0 44px;
            border: 1.5px solid var(--bd2);
            border-radius: var(--r-md);
            font-family: 'Cairo', sans-serif;
            font-size: .9rem; color: var(--ink);
            background: var(--s0);
            transition: all .2s ease;
            outline: none;
        }
        .rp-input:focus {
            border-color: var(--p);
            box-shadow: 0 0 0 3px rgba(27,94,174,.12);
        }
        .rp-input.readonly-field {
            background: var(--s2);
            color: var(--ink3);
            cursor: default;
        }
        .rp-input::placeholder { color: var(--ink4); }
        .rp-input-icon {
            position: absolute; left: 13px; top: 50%;
            transform: translateY(-50%);
            color: var(--ink4); font-size: .95rem;
            pointer-events: none;
            transition: color .2s ease;
        }
        .rp-input-wrap:focus-within .rp-input-icon { color: var(--p); }

        /* toggle eye btn */
        .rp-eye-btn {
            position: absolute; right: 12px; top: 50%;
            transform: translateY(-50%);
            border: none; background: none;
            color: var(--ink4); font-size: 1rem;
            cursor: pointer; padding: 4px;
            transition: color .2s ease;
        }
        .rp-eye-btn:hover { color: var(--p); }

        /* ── Strength ── */
        .rp-strength { margin-top: 6px; }
        .rp-strength-bar {
            height: 4px; border-radius: 999px;
            background: var(--bd); overflow: hidden;
            margin-bottom: 5px;
        }
        .rp-strength-fill {
            height: 100%; border-radius: 999px;
            width: 0; transition: width .3s ease, background .3s ease;
        }
        .rp-strength-text {
            font-size: .73rem; font-weight: 700; color: var(--ink4);
        }
        .str-0 { width: 0; }
        .str-1 { width: 25%; background: var(--ro); }
        .str-2 { width: 50%; background: var(--am); }
        .str-3 { width: 75%; background: #EAB308; }
        .str-4 { width: 100%; background: var(--em); }

        /* ── Rules ── */
        .rp-rules {
            display: flex; flex-wrap: wrap; gap: 6px;
            margin-bottom: 22px;
        }
        .rp-rule {
            display: flex; align-items: center; gap: 4px;
            font-size: .72rem; font-weight: 600;
            color: var(--ink4); transition: color .2s ease;
        }
        .rp-rule i { font-size: .7rem; }
        .rp-rule.ok { color: var(--em); }
        .rp-rule.fail { color: var(--ro); }

        /* ── Submit ── */
        .rp-submit {
            width: 100%; height: 48px;
            border: none; border-radius: var(--r-md);
            background: linear-gradient(135deg, var(--p) 0%, var(--p-l) 100%);
            color: #fff; font-family: 'Cairo', sans-serif;
            font-size: .95rem; font-weight: 800;
            cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;
            transition: all .2s ease;
            box-shadow: 0 4px 14px rgba(27,94,174,.3);
        }
        .rp-submit:hover {
            box-shadow: 0 6px 20px rgba(27,94,174,.4);
            transform: translateY(-1px);
        }
        .rp-submit:active { transform: scale(.98); }

        /* ── Footer ── */
        .rp-footer {
            padding: 14px 24px;
            border-top: 1px solid var(--bd);
            background: var(--s1);
            display: flex; align-items: center; justify-content: center;
        }
        .rp-back {
            font-size: .82rem; font-weight: 600; color: var(--ink3);
            text-decoration: none; display: flex; align-items: center; gap: 6px;
            transition: color .2s ease;
        }
        .rp-back:hover { color: var(--p); }

        /* Validation */
        .field-error { font-size: .75rem; color: var(--ro); display: flex; align-items: center; gap: 4px; }
    </style>
}

<div class="rp-wrap">

    <!-- Brand -->
    <div class="rp-brand">
        <div class="rp-brand-icon"><i class="bi bi-shield-lock-fill"></i></div>
        <div class="rp-brand-title">إعادة تعيين كلمة المرور</div>
        <div class="rp-brand-sub">تعيين كلمة مرور جديدة للمستخدم من لوحة الإدارة</div>
    </div>

    <!-- Card -->
    <div class="rp-card">

        <!-- User Info Bar -->
        <div class="rp-user-bar">
            <div class="rp-user-avatar">
                <i class="bi bi-person-fill"></i>
            </div>
            <div>
                <div class="rp-user-name">إعادة تعيين للمستخدم</div>
                <div class="rp-user-email">@Model.Email</div>
            </div>
        </div>

        <!-- Form Body -->
        <div class="rp-body">

            @if (TempData["Error"] != null)
            {
                <div class="rp-alert rp-alert-danger visible">
                    <i class="bi bi-exclamation-triangle-fill mt-1" style="flex-shrink:0"></i>
                    <span>@TempData["Error"]</span>
                </div>
            }

            <!-- Validation Summary -->
            <div asp-validation-summary="All" class="rp-alert rp-alert-danger visible" style="display:none"></div>

            <div class="rp-alert rp-alert-warning">
                <i class="bi bi-info-circle-fill mt-1" style="flex-shrink:0"></i>
                <span>كلمة المرور الجديدة ستُطبَّق فوراً. يُنصح بإبلاغ المستخدم بكلمة المرور عبر قناة آمنة.</span>
            </div>

            <form asp-action="ResetPassword" method="post" id="resetForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Email" />

                <!-- Email (readonly display) -->
                <div class="rp-field">
                    <label class="rp-label">
                        <i class="bi bi-envelope"></i>
                        البريد الإلكتروني
                    </label>
                    <div class="rp-input-wrap">
                        <i class="bi bi-envelope rp-input-icon"></i>
                        <input class="rp-input readonly-field" type="email"
                               value="@Model.Email" readonly tabindex="-1" />
                    </div>
                </div>

                <!-- New Password -->
                <div class="rp-field">
                    <label class="rp-label" for="newPass">
                        <i class="bi bi-key"></i>
                        كلمة المرور الجديدة
                        <span class="req">*</span>
                    </label>
                    <div class="rp-input-wrap">
                        <i class="bi bi-lock rp-input-icon"></i>
                        <input asp-for="NewPassword" class="rp-input"
                               id="newPass" type="password"
                               placeholder="أدخل كلمة المرور الجديدة"
                               autocomplete="new-password" />
                        <button type="button" class="rp-eye-btn" id="eyeBtn">
                            <i class="bi bi-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                    <!-- Strength bar -->
                    <div class="rp-strength" id="strengthWrap" style="display:none">
                        <div class="rp-strength-bar">
                            <div class="rp-strength-fill" id="strengthFill"></div>
                        </div>
                        <div class="rp-strength-text" id="strengthText"></div>
                    </div>
                    <span asp-validation-for="NewPassword" class="field-error">
                        <i class="bi bi-x-circle-fill"></i>
                        <span></span>
                    </span>
                </div>

                <!-- Rules -->
                <div class="rp-rules" id="rulesWrap" style="display:none">
                    <div class="rp-rule" id="r-len"><i class="bi bi-circle"></i> 8 أحرف على الأقل</div>
                    <div class="rp-rule" id="r-up"><i class="bi bi-circle"></i> حرف كبير</div>
                    <div class="rp-rule" id="r-lo"><i class="bi bi-circle"></i> حرف صغير</div>
                    <div class="rp-rule" id="r-num"><i class="bi bi-circle"></i> رقم</div>
                    <div class="rp-rule" id="r-sym"><i class="bi bi-circle"></i> رمز خاص</div>
                </div>

                <!-- Submit -->
                <button type="submit" class="rp-submit">
                    <i class="bi bi-shield-check"></i>
                    تعيين كلمة المرور
                </button>
            </form>
        </div>

        <!-- Footer -->
        <div class="rp-footer">
            <a asp-action="Index" class="rp-back">
                <i class="bi bi-arrow-right"></i>
                العودة لقائمة المستخدمين
            </a>
        </div>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const passInput   = document.getElementById('newPass');
        const eyeBtn      = document.getElementById('eyeBtn');
        const eyeIcon     = document.getElementById('eyeIcon');
        const strengthFill = document.getElementById('strengthFill');
        const strengthText = document.getElementById('strengthText');
        const strengthWrap = document.getElementById('strengthWrap');
        const rulesWrap    = document.getElementById('rulesWrap');

        // Eye toggle
        eyeBtn.addEventListener('click', () => {
            const isPass = passInput.type === 'password';
            passInput.type = isPass ? 'text' : 'password';
            eyeIcon.className = isPass ? 'bi bi-eye-slash' : 'bi bi-eye';
        });

        // Strength checker
        passInput.addEventListener('input', () => {
            const v = passInput.value;
            if (!v) {
                strengthWrap.style.display = 'none';
                rulesWrap.style.display = 'none';
                return;
            }
            strengthWrap.style.display = 'block';
            rulesWrap.style.display = 'flex';

            const checks = {
                len: v.length >= 8,
                up:  /[A-Z]/.test(v),
                lo:  /[a-z]/.test(v),
                num: /[0-9]/.test(v),
                sym: /[^A-Za-z0-9]/.test(v)
            };

            const score = Object.values(checks).filter(Boolean).length;

            // Update rules
            Object.entries(checks).forEach(([k, ok]) => {
                const el = document.getElementById('r-' + k);
                if (!el) return;
                el.className = 'rp-rule ' + (ok ? 'ok' : 'fail');
                el.querySelector('i').className = ok ? 'bi bi-check-circle-fill' : 'bi bi-x-circle';
            });

            const labels = ['', 'ضعيفة', 'مقبولة', 'جيدة', 'قوية', 'ممتازة'];
            const colors = ['', '#BF1030', '#985D09', '#EAB308', '#0D7A5B', '#0D7A5B'];
            strengthFill.className = 'rp-strength-fill str-' + score;
            strengthFill.style.width = (score * 20) + '%';
            strengthFill.style.background = colors[score] || '';
            strengthText.textContent = labels[score] || '';
            strengthText.style.color = colors[score] || '';
        });
    </script>
}
