@model IEnumerable<QdratNew.Entities.StaticPage>
@{
    ViewData["Title"] = "إدارة الصفحات الثابتة";
}
<div class="container mt-4">
    <h3 class="fw-bold text-primary mb-3">📑 إدارة الصفحات العامة</h3>
    <a href="@Url.Action("Create")" class="btn btn-success mb-3">
        <i class="fa-solid fa-plus"></i> إنشاء صفحة جديدة
    </a>

    <table class="table table-bordered table-hover text-center">
        <thead class="table-dark">
            <tr>
                <th>العنوان</th>
                <th>المعرف (Slug)</th>
                <th>نشطة؟</th>
                <th>آخر تعديل</th>
                <th>إجراءات</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var pa in Model)
        {
            <tr>
                <td>@pa.Title</td>
                <td>@pa.Slug</td>
                <td>
                    @if (pa.IsActive)
                    { <span class="badge bg-success">نشطة</span> }
                    else
                    { <span class="badge bg-secondary">معطلة</span> }
                </td>
                <td>@pa.UpdatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                <td>
                    <a href="@Url.Action("Edit", new { id = pa.Id })" class="btn btn-sm btn-primary"><i class="fa fa-pen"></i></a>
                    <a href="@Url.Action("Delete", new { id = pa.Id })" class="btn btn-sm btn-danger"
                       onclick="return confirm('هل أنت متأكد من الحذف؟')"><i class="fa fa-trash"></i></a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
