@model IReadOnlyList<QdratNew.ViewModels.Admin.CoursePackages.CoursePackageListItemViewModel>
@{
    ViewData["Title"] = "الباقات";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h4 class="mb-0 fw-bold"><i class="fas fa-boxes-stacked me-2 text-success"></i>الباقات</h4>
            <small class="text-muted">إدارة باقات الدورات: البيانات، الخصم، الدورات المشمولة، والبوستر</small>
        </div>
        <a asp-area="Admin" asp-controller="CoursePackages" asp-action="Create"
           class="btn btn-success rounded-3">
            <i class="fas fa-plus me-1"></i> باقة جديدة
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-3 mb-4">
            <i class="fas fa-circle-check me-1"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-3 mb-4">
            <i class="fas fa-circle-exclamation me-1"></i> @TempData["Error"]
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>البوستر</th>
                            <th>الباقة</th>
                            <th>الصف</th>
                            <th class="text-center">الخصم</th>
                            <th class="text-center">الدورات</th>
                            <th class="text-center">الطلبات</th>
                            <th class="text-center">نشطة</th>
                            <th class="text-center">الرئيسية</th>
                            <th class="text-center">ترتيب</th>
                            <th class="text-center">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="text-muted small">@p.Id</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(p.PosterImagePath))
                                    {
                                        <img src="@p.PosterImagePath" alt="بوستر @p.Name" loading="lazy"
                                             style="width:40px;height:52px;object-fit:cover;border-radius:6px;border:1px solid #e2e8f0;" />
                                    }
                                    else
                                    {
                                        <div style="width:40px;height:52px;background:#f1f5f9;border-radius:6px;display:flex;align-items:center;justify-content:center;">
                                            <i class="fas fa-image text-muted small"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold">@p.Name</div>
                                    <code class="small text-muted">@p.Slug</code>
                                </td>
                                <td>@p.GradeLabel</td>
                                <td class="text-center">
                                    @if (p.DiscountPercent.HasValue)
                                    {
                                        <span class="badge bg-danger">@p.DiscountPercent%</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@p.ItemsCount</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@p.RegistrationsCount</span>
                                    @if (p.NewRegistrationsCount > 0)
                                    {
                                        <span class="badge bg-warning text-dark" title="طلبات جديدة">@p.NewRegistrationsCount جديد</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <form asp-area="Admin" asp-controller="CoursePackages"
                                          asp-action="ToggleActive" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button type="submit" class="btn btn-sm rounded-pill px-3 @(p.IsActive ? "btn-success" : "btn-outline-secondary")"
                                                title="تبديل حالة التفعيل">
                                            @(p.IsActive ? "نشطة" : "معطّلة")
                                        </button>
                                    </form>
                                </td>
                                <td class="text-center">
                                    <form asp-area="Admin" asp-controller="CoursePackages"
                                          asp-action="ToggleHomeVisibility" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button type="submit" class="btn btn-sm rounded-pill px-3 @(p.ShowOnHomePage ? "btn-primary" : "btn-outline-secondary")"
                                                title="تبديل الظهور في الصفحة الرئيسية">
                                            @(p.ShowOnHomePage ? "ظاهرة" : "مخفية")
                                        </button>
                                    </form>
                                </td>
                                <td class="text-center text-muted small">@p.DisplayOrder</td>
                                <td class="text-center">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a asp-area="Admin" asp-controller="CoursePackages"
                                           asp-action="Edit" asp-route-id="@p.Id"
                                           class="btn btn-sm btn-outline-primary rounded-3" title="تعديل" aria-label="تعديل @p.Name">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <form asp-area="Admin" asp-controller="CoursePackages"
                                              asp-action="Delete" method="post" class="d-inline"
                                              data-confirm="@(p.RegistrationsCount > 0 ? "هذه الباقة لها طلبات حجز ولن تُحذف. هل تريد المحاولة؟" : "حذف الباقة نهائيًا مع دوراتها وبوسترها؟ لا يمكن التراجع.")">
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-3"
                                                    title="حذف" aria-label="حذف @p.Name">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="11" class="text-center text-muted py-5">
                                    <i class="fas fa-inbox fa-2x mb-2 d-block opacity-50"></i>
                                    لا توجد باقات بعد — ابدأ بإضافة أول باقة
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('form[data-confirm]').forEach(function (f) {
            f.addEventListener('submit', function (e) {
                if (!window.confirm(f.dataset.confirm)) e.preventDefault();
            });
        });
    </script>
}
