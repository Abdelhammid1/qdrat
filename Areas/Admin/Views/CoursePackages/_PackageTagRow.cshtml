@using QdratNew.Helpers
@* الموديل: (Index, Tag). Index نص: رقم الصف أو "__i__" لقالب الصف الجديد *@
@model (string Index, QdratNew.ViewModels.Admin.CoursePackages.PackageTagFormViewModel Tag)

<div class="border rounded-3 p-2 mb-2 bg-light" data-row="tag">
    <input type="hidden" name="Tags[@Model.Index].Id" value="@Model.Tag.Id" />
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-6">
            <label class="form-label small fw-semibold mb-1">نص الوسم <span class="text-danger">*</span></label>
            <input type="text" name="Tags[@Model.Index].Text" value="@Model.Tag.Text"
                   class="form-control form-control-sm" maxlength="100" required />
            @Html.ValidationMessage($"Tags[{Model.Index}].Text", new { @class = "text-danger small" })
        </div>
        <div class="col-8 col-md-4">
            <label class="form-label small fw-semibold mb-1">الأيقونة (اختياري)</label>
            <select name="Tags[@Model.Index].IconKey" class="form-select form-select-sm">
                <option value="">بدون أيقونة</option>
                @foreach (var icon in PackageIconCatalog.All)
                {
                    <option value="@icon.Key" selected="@(icon.Key == Model.Tag.IconKey)">@icon.Label</option>
                }
            </select>
            @Html.ValidationMessage($"Tags[{Model.Index}].IconKey", new { @class = "text-danger small" })
        </div>
        <div class="col-4 col-md-2 d-flex gap-1 justify-content-end">
            <button type="button" class="btn btn-sm btn-outline-secondary" data-move="up" title="تحريك لأعلى" aria-label="تحريك لأعلى"><i class="fas fa-arrow-up"></i></button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-move="down" title="تحريك لأسفل" aria-label="تحريك لأسفل"><i class="fas fa-arrow-down"></i></button>
            <button type="button" class="btn btn-sm btn-outline-danger" data-remove title="حذف الوسم" aria-label="حذف الوسم"><i class="fas fa-trash"></i></button>
        </div>
    </div>
</div>
