@model QdratNew.ViewModels.Admin.CoursePackages.CoursePackageFormViewModel
@using QdratNew.ViewModels.Admin.CoursePackages
@{
    var items = Model.Items.Count > 0 ? Model.Items : new List<PackageItemFormViewModel> { new() };
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>

<div class="row g-4">
    <div class="col-12 col-xl-8">

        @* ─── البيانات الأساسية ─── *@
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"><i class="fas fa-circle-info me-1 text-primary"></i> البيانات الأساسية</h6>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Name" class="form-label fw-semibold">اسم الباقة <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" maxlength="150" required data-preview="name" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Slug" class="form-label fw-semibold">الرابط المختصر (Slug) <span class="text-danger">*</span></label>
                        <input asp-for="Slug" class="form-control" dir="ltr" maxlength="160" required
                               pattern="^[a-z0-9]+(-[a-z0-9]+)*$" placeholder="مثال: foundation-package" />
                        <span asp-validation-for="Slug" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="GradeLabel" class="form-label fw-semibold">الصف <span class="text-danger">*</span></label>
                        <input asp-for="GradeLabel" class="form-control" maxlength="100" required data-preview="grade" />
                        <span asp-validation-for="GradeLabel" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Subtitle" class="form-label fw-semibold">العنوان الفرعي</label>
                        <input asp-for="Subtitle" class="form-control" maxlength="200" />
                        <span asp-validation-for="Subtitle" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="IntroText" class="form-label fw-semibold">فقرة تعريفية</label>
                        <textarea asp-for="IntroText" class="form-control" rows="3" maxlength="1000"></textarea>
                        <span asp-validation-for="IntroText" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="AccentColor" class="form-label fw-semibold">لون الباقة <span class="text-danger">*</span></label>
                        <div class="input-group" data-color-pair>
                            <input type="color" class="form-control form-control-color" value="@Model.AccentColor" aria-label="اختيار لون الباقة" />
                            <input asp-for="AccentColor" class="form-control" dir="ltr" maxlength="7" required
                                   pattern="^#[0-9A-Fa-f]{6}$" placeholder="#RRGGBB" data-preview="color" />
                        </div>
                        <span asp-validation-for="AccentColor" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="DisplayOrder" class="form-label fw-semibold">ترتيب العرض</label>
                        <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
                        <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        @* ─── الخصم والزر ─── *@
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"><i class="fas fa-tag me-1 text-danger"></i> الخصم وزر الحجز</h6>
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label asp-for="DiscountPercent" class="form-label fw-semibold">نسبة الخصم %</label>
                        <input asp-for="DiscountPercent" class="form-control" type="number" min="1" max="100" placeholder="بدون خصم" data-preview="discount" />
                        <span asp-validation-for="DiscountPercent" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="DiscountCaption" class="form-label fw-semibold">نص الخصم</label>
                        <input asp-for="DiscountCaption" class="form-control" maxlength="100" placeholder="مثال: خصم لفترة محدودة" />
                        <span asp-validation-for="DiscountCaption" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="ButtonText" class="form-label fw-semibold">نص زر الحجز <span class="text-danger">*</span></label>
                        <input asp-for="ButtonText" class="form-control" maxlength="60" required data-preview="button" />
                        <span asp-validation-for="ButtonText" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        @* ─── الدورات المشمولة ─── *@
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="fas fa-book me-1 text-success"></i> الدورات المشمولة <small class="text-muted fw-normal">(من 1 إلى 8)</small></h6>
                    <button type="button" class="btn btn-sm btn-outline-success rounded-3" id="addItemBtn">
                        <i class="fas fa-plus me-1"></i> إضافة دورة
                    </button>
                </div>
                @Html.ValidationMessage("Items", new { @class = "text-danger small d-block mb-2" })
                <div id="itemsContainer" data-prefix="Items" data-max="8" data-min="1">
                    @for (var i = 0; i < items.Count; i++)
                    {
                        @await Html.PartialAsync("_PackageItemRow", (i.ToString(), items[i]))
                    }
                </div>
                <template id="itemTemplate">
                    @await Html.PartialAsync("_PackageItemRow", ("__i__", new PackageItemFormViewModel()))
                </template>
            </div>
        </div>

        @* ─── الوسوم ─── *@
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="fas fa-tags me-1 text-warning"></i> الوسوم <small class="text-muted fw-normal">(حتى 6، اختيارية)</small></h6>
                    <button type="button" class="btn btn-sm btn-outline-success rounded-3" id="addTagBtn">
                        <i class="fas fa-plus me-1"></i> إضافة وسم
                    </button>
                </div>
                @Html.ValidationMessage("Tags", new { @class = "text-danger small d-block mb-2" })
                <div id="tagsContainer" data-prefix="Tags" data-max="6" data-min="0">
                    @for (var i = 0; i < Model.Tags.Count; i++)
                    {
                        @await Html.PartialAsync("_PackageTagRow", (i.ToString(), Model.Tags[i]))
                    }
                </div>
                <div id="tagsEmpty" class="text-muted small text-center py-2" @(Model.Tags.Count > 0 ? "hidden" : "")>لا توجد وسوم</div>
                <template id="tagTemplate">
                    @await Html.PartialAsync("_PackageTagRow", ("__i__", new PackageTagFormViewModel()))
                </template>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="position-sticky" style="top:80px">

            @* ─── البوستر ─── *@
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3"><i class="fas fa-image me-1 text-primary"></i> البوستر (اختياري)</h6>

                    @if (!string.IsNullOrEmpty(Model.ExistingPosterPath))
                    {
                        <div class="p-2 bg-light rounded-3 mb-2" id="existingPosterBox">
                            <img src="@Model.ExistingPosterPath" alt="البوستر الحالي"
                                 class="img-fluid rounded-3 border mb-2" style="max-height:220px" />
                            <div class="form-check">
                                <input asp-for="RemovePoster" class="form-check-input" type="checkbox" id="removePosterCheck" />
                                <label class="form-check-label text-danger small fw-semibold" for="removePosterCheck">حذف البوستر الحالي</label>
                            </div>
                        </div>
                        <input type="hidden" asp-for="ExistingPosterPath" />
                    }

                    <input asp-for="PosterFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" id="posterInput" />
                    <small class="text-muted d-block mt-1">JPG أو PNG أو WebP حتى 5 ميجابايت — يُحوَّل تلقائيًا إلى WebP. رفع صورة جديدة يستبدل الحالية.</small>
                    <span asp-validation-for="PosterFile" class="text-danger small"></span>
                    <div id="posterPreviewBox" class="mt-2" hidden>
                        <img id="posterPreviewImg" src="" alt="معاينة البوستر الجديد" class="img-fluid rounded-3 border" style="max-height:220px" />
                        <div class="text-muted small mt-1">معاينة البوستر الجديد</div>
                    </div>
                </div>
            </div>

            @* ─── الظهور ─── *@
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3"><i class="fas fa-eye me-1 text-info"></i> الظهور</h6>
                    <div class="form-check form-switch mb-2">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="IsActive" class="form-check-label">باقة نشطة</label>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="ShowOnHomePage" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="ShowOnHomePage" class="form-check-label">تظهر في الصفحة الرئيسية</label>
                    </div>
                </div>
            </div>

            @* ─── معاينة حية ─── *@
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3"><i class="fas fa-wand-magic-sparkles me-1 text-secondary"></i> معاينة سريعة</h6>
                    <div id="pkgPreview" class="rounded-4 p-3 text-center border" style="border-width:2px !important;">
                        <span id="pvDiscount" class="badge mb-2" hidden></span>
                        <div id="pvName" class="fw-bold fs-5"></div>
                        <div id="pvGrade" class="small mb-3"></div>
                        <span id="pvButton" class="btn btn-sm rounded-pill px-4 disabled"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
