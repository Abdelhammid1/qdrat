@model QdratNew.ViewModels.Admin.CoursePackages.CoursePackageFormViewModel
@{
    ViewData["Title"] = "تعديل الباقة";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center gap-2 mb-4">
        <a asp-area="Admin" asp-controller="CoursePackages" asp-action="Index"
           class="btn btn-sm btn-outline-secondary rounded-3" aria-label="رجوع للقائمة">
            <i class="fas fa-arrow-right"></i>
        </a>
        <h4 class="mb-0 fw-bold">تعديل الباقة: @Model.Name</h4>
    </div>

    <form asp-area="Admin" asp-controller="CoursePackages" asp-action="Edit"
          method="post" enctype="multipart/form-data" id="packageForm" novalidate>
        <input type="hidden" asp-for="Id" />
        @await Html.PartialAsync("_PackageForm", Model)
        <div class="mt-4">
            <button type="submit" class="btn btn-success rounded-3 px-4" id="packageSubmit">
                <i class="fas fa-save me-1"></i> حفظ التعديلات
            </button>
            <a asp-area="Admin" asp-controller="CoursePackages" asp-action="Index"
               class="btn btn-outline-secondary rounded-3 ms-2">إلغاء</a>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_PackageFormScripts")
}
