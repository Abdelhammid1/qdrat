@using QdratNew.Helpers
@* الموديل: (Index, Item). Index نص: رقم الصف أو "__i__" لقالب الصف الجديد. يُعاد ترقيم الأسماء بالـ JS عند الإضافة/الحذف/الترتيب *@
@model (string Index, QdratNew.ViewModels.Admin.CoursePackages.PackageItemFormViewModel Item)

<div class="border rounded-3 p-3 mb-2 bg-light" data-row="item">
    <input type="hidden" name="Items[@Model.Index].Id" value="@Model.Item.Id" />
    <div class="row g-2">
        <div class="col-12 col-md-6">
            <label class="form-label small fw-semibold mb-1">عنوان الدورة <span class="text-danger">*</span></label>
            <input type="text" name="Items[@Model.Index].Title" value="@Model.Item.Title"
                   class="form-control form-control-sm" maxlength="200" required />
            @Html.ValidationMessage($"Items[{Model.Index}].Title", new { @class = "text-danger small" })
        </div>
        <div class="col-8 col-md-3">
            <label class="form-label small fw-semibold mb-1">الأيقونة</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="fas fa-book" data-icon-preview></i></span>
                <select name="Items[@Model.Index].IconKey" class="form-select form-select-sm" data-icon-select>
                    @foreach (var icon in PackageIconCatalog.All)
                    {
                        <option value="@icon.Key" data-fa="@icon.FaClass" selected="@(icon.Key == Model.Item.IconKey)">@icon.Label</option>
                    }
                </select>
            </div>
            @Html.ValidationMessage($"Items[{Model.Index}].IconKey", new { @class = "text-danger small" })
        </div>
        <div class="col-4 col-md-3">
            <label class="form-label small fw-semibold mb-1">لون (اختياري)</label>
            <div class="input-group input-group-sm" data-color-pair>
                <input type="color" class="form-control form-control-color" value="#14A8AE" aria-label="اختيار لون الدورة" />
                <input type="text" name="Items[@Model.Index].ColorHex" value="@Model.Item.ColorHex"
                       class="form-control" dir="ltr" maxlength="7" placeholder="#RRGGBB" pattern="^#[0-9A-Fa-f]{6}$" />
            </div>
            @Html.ValidationMessage($"Items[{Model.Index}].ColorHex", new { @class = "text-danger small" })
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label small fw-semibold mb-1">عنوان الجدول</label>
            <input type="text" name="Items[@Model.Index].ScheduleTitle" value="@Model.Item.ScheduleTitle"
                   class="form-control form-control-sm" maxlength="200" />
        </div>
        <div class="col-12 col-md-5">
            <label class="form-label small fw-semibold mb-1">نص الموعد</label>
            <input type="text" name="Items[@Model.Index].ScheduleText" value="@Model.Item.ScheduleText"
                   class="form-control form-control-sm" maxlength="200" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label small fw-semibold mb-1">ملاحظة</label>
            <input type="text" name="Items[@Model.Index].ScheduleNote" value="@Model.Item.ScheduleNote"
                   class="form-control form-control-sm" maxlength="100" />
        </div>
    </div>
    <div class="d-flex gap-1 justify-content-end mt-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-move="up" title="تحريك لأعلى" aria-label="تحريك لأعلى"><i class="fas fa-arrow-up"></i></button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-move="down" title="تحريك لأسفل" aria-label="تحريك لأسفل"><i class="fas fa-arrow-down"></i></button>
        <button type="button" class="btn btn-sm btn-outline-danger" data-remove title="حذف الدورة من الباقة" aria-label="حذف الدورة من الباقة"><i class="fas fa-trash"></i></button>
    </div>
</div>
