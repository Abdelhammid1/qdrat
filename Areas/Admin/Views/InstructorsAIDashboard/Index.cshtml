@model QdratNew.ViewModels.Instructor.InstructorsAIDashboardViewModel
@using Microsoft.AspNetCore.Mvc.Rendering



@{
    ViewData["Title"] = "لوحة AI لتحليل أداء المدربين";
}
@section Styles {
    @Html.Raw(@"<link href='https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap' rel='stylesheet'>
    <style>
        .instructor-info {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
        }
.section-performance {
            margin-top: 50px;
        }
        .section-performance h4 {
            margin-bottom: 20px;
            font-weight: bold;
        }
        .info-box {
            background: #f8f9fa;
            padding: 1rem;
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
            text-align: center;
        }

        @media (max-width: 992px) {
            .instructor-info {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 600px) {
            .instructor-info {
                grid-template-columns: 1fr;
            }
        }
    </style>")
}

<div class="container mt-4">
    <h2 class="mb-4 text-dark"><i class="fas fa-brain"></i> لوحة الذكاء الاصطناعي لتحليل أداء المدربين</h2>

    <!-- نموذج الفلاتر -->
    <form method="get" class="row mb-4 align-items-end text-center">
        <div class="col-md-3">
            <label>المنهج:</label>
            <select name="curriculumId" class="form-control">
                <option value="">-- جميع المناهج --</option>
                @foreach (var item in Model.CurriculumList)
                {
                    <option value="@item.Value" selected="@(Model.SelectedCurriculumId?.ToString() == item.Value ? "selected" : null)">
                        @item.Text
                    </option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label>الدفعة:</label>
            <select name="batchId" class="form-control">
                <option value="">-- جميع الدفعات --</option>
                @foreach (var item in Model.BatchList)
                {
                    <option value="@item.Value" selected="@(Model.SelectedBatchId?.ToString() == item.Value ? "selected" : null)">
                        @item.Text
                    </option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label>من تاريخ:</label>
            <input type="date" name="fromDate" class="form-control" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-2">
            <label>إلى تاريخ:</label>
            <input type="date" name="toDate" class="form-control" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-1 d-flex justify-content-center mt-4">
            <button type="submit" class="btn btn-dark rounded-circle" title="تطبيق الفلاترة">
                <i class="fas fa-filter"></i>
            </button>
        </div>
        <div class="col-md-1 d-flex justify-content-center mt-4">
            <a href="@Url.Action("Index", "InstructorsAIDashboard", new { area = "Admin" })" class="btn btn-dark rounded-circle" title="إلغاء الفلاترة">
                <i class="fas fa-times"></i>
            </a>
        </div>
    </form>

    @if (!Model.InstructorsStats.Any())
    {
        <div class="alert alert-warning text-center shadow-sm">
            <i class="fas fa-exclamation-triangle me-2"></i>
            لا توجد بيانات تحليل في الفلاتر المحددة.
        </div>
    }
    else
    {
        <!-- كروت التحليل -->
        <div class="instructor-info mb-4">
            <div class="info-box"><h4><i class="fas fa-users"></i> عدد المدربين</h4><p>@Model.InstructorsStats.Count</p></div>
            <div class="info-box"><h4><i class="fas fa-chart-line"></i> أعلى نسبة نجاح</h4><p>@Model.InstructorsStats.Max(x => x.SuccessRate)%</p></div>
            <div class="info-box"><h4><i class="fas fa-chart-bar"></i> أقل نسبة نجاح</h4><p>@Model.InstructorsStats.Min(x => x.SuccessRate)%</p></div>
            <div class="info-box"><h4><i class="fas fa-percentage"></i> متوسط الأداء العام</h4><p>@Model.InstructorsStats.Average(x => x.AverageStudentScore).ToString("0.0")%</p></div>
        </div>

        <!-- شارت -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <!-- ✅ Bar Chart - نسبة النجاح -->
            <div class="col-md-6 card p-4 shadow-sm rounded-2xl border border-gray-200 bg-white" style="display:block;float:right">
                <h4 class="text-lg font-bold mb-3 text-center">نسبة النجاح حسب المدرب</h4>
                <canvas id="successRateChart" height="150"></canvas>
            </div>

            <!-- ✅ Line Chart - متوسط الدرجات -->
            <div class="col-md-6 card p-4 shadow-sm rounded-2xl border border-gray-200 bg-white mt-4">
                <h4 class="text-lg font-bold mb-3 text-center">📈 متوسط درجات الطلاب حسب المدرب (رسم تفاعلي)</h4>
                <canvas id="avgScoreLineChart" height="150"></canvas>
            </div>


            <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    const allData = @Html.Raw(Json.Serialize(Model.InstructorPerformanceChartData));

                    const ctx = document.getElementById('instructorBarChart').getContext('2d');
                    const chart = new Chart(ctx, {
                        type: 'bar',
                        data: {
                            labels: allData.map(x => x.InstructorName),
                            datasets: [{
                                label: 'متوسط الدرجات',
                                data: allData.map(x => x.AverageStudentScore),
                                backgroundColor: 'rgba(75, 192, 192, 0.6)',
                                borderColor: 'rgba(75, 192, 192, 1)',
                                borderWidth: 1,
                                borderRadius: 8
                            }]
                        },
                        options: {
                            responsive: true,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            return `متوسط الدرجات: ${context.parsed.y.toFixed(2)} / 100`;
                                        }
                                    }
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    max: 100,
                                    title: {
                                        display: true,
                                        text: 'درجة الطالب'
                                    }
                                }
                            }
                        }
                    });

                    const dropdown = document.getElementById('instructorDropdown');
                    if (dropdown) {
                        dropdown.addEventListener('change', function () {
                            const selected = this.value;
                            const filtered = selected === 'all' ? allData : allData.filter(x => x.InstructorName === selected);

                            chart.data.labels = filtered.map(x => x.InstructorName);
                            chart.data.datasets[0].data = filtered.map(x => x.AverageStudentScore);
                            chart.update();
                        });
                    } else {
                        console.warn("❌ لم يتم العثور على الـ Dropdown.");
                    }
                });
            </script>


        </div>
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


        <script>
            window.addEventListener("load", function () {
                // ✅ بيانات الرسوم البيانية من Model
                const labels = @Html.Raw(Json.Serialize(Model.InstructorPerformanceChartData.Select(x => x.InstructorName)));
                const scores = @Html.Raw(Json.Serialize(Model.InstructorPerformanceChartData.Select(x => x.AverageStudentScore)));

                // ✅ Bar Chart: نسبة النجاح
                new Chart(document.getElementById('successRateChart'), {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'نسبة النجاح (%)',
                            data: scores,
                            backgroundColor: scores.map(score => score >= 75 ? 'green' : 'orange'),
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: ctx => `${ctx.parsed.y.toFixed(2)}%`
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                max: 100,
                                title: { display: true, text: 'نسبة النجاح' }
                            }
                        }
                    }
                });

                // ✅ Line Chart: متوسط الدرجات (مع Hover تفاعلي)
                new Chart(document.getElementById('avgScoreLineChart'), {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'متوسط درجات الطلاب',
                            data: scores,
                            fill: true,
                            borderColor: 'rgba(54, 162, 235, 1)',
                            backgroundColor: 'rgba(54, 162, 235, 0.2)',
                            tension: 0.3,
                            pointRadius: 5,
                            pointHoverRadius: 8,
                            pointBackgroundColor: 'blue'
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            tooltip: {
                                mode: 'nearest',
                                intersect: false,
                                callbacks: {
                                    label: ctx => ` الدرجة: ${ctx.parsed.y.toFixed(2)} / 100`
                                }
                            },
                            legend: { display: false }
                        },
                        interaction: {
                            mode: 'index',
                            intersect: false
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                max: 100,
                                title: { display: true, text: 'متوسط الدرجة' }
                            }
                        }
                    }
                });
            });
        </script>










        <!-- جدول -->
        <div class="container mt-5">
            <h2 class="mb-4 text-dark"><i class="fas fa-brain"></i> تحليل أداء المدربين</h2>

            <table class="table table-bordered table-hover text-center" id="instructorsTable">
                <thead class="table-dark">
                    <tr>
                        <th>👤 اسم المدرب</th>
                        <th>📚 عدد المناهج</th>
                        <th>👥 عدد الطلاب</th>
                        <th>📊 متوسط الأداء</th>
                        <th>✅ نسبة النجاح</th>
                        <th>🤖 تحليل AI</th>
                        <th>🤖 عام AI</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var instructor in Model.InstructorsStats)
                    {
                        var modalId = $"recommendationModal_{instructor.InstructorName.GetHashCode()}";
                        var modalLabelId = $"{modalId}_Label";
                        <tr>
                            <td>
                                <a href="@Url.Action("SectionPerformance", "InstructorsAIDashboard", new { area = "Admin", instructorId = instructor.InstructorId })"
                                   class="text-dark fw-bold" style="text-decoration: none;">
                                    @instructor.InstructorName
                                </a>


                            </td>
                            <td>@instructor.TotalCurriculums</td>
                            <td>@instructor.TotalStudents</td>
                            <td>@instructor.AverageStudentScore %</td>
                            <td>
                                @instructor.SuccessRate %
                                @if (instructor.SuccessRate >= 80)
                                {
                                    <span class="text-success"><i class="fas fa-arrow-up"></i></span>
                                }
                                else if (instructor.SuccessRate >= 60)
                                {
                                    <span class="text-warning"><i class="fas fa-arrows-alt-h"></i></span>
                                }
                                else
                                {
                                    <span class="text-danger"><i class="fas fa-arrow-down"></i></span>
                                }
                            </td>
                            <td>
                                <a class="btn btn-outline-primary btn-sm"
                                   href="@Url.Action("Index", "InstructorsAISectionEvaluation", new { area = "Admin", instructorId = instructor.InstructorId })"
                                   title="تحليل المحاور التعليمية للمدرب">
                                    <i class="fas fa-chart-line"></i> تحليل
                                </a>
                            </td>
                            <td>
                                <button class="btn btn-dark btn-sm" data-bs-toggle="modal" data-bs-target="#@modalId" title="تفاصيل التوصية">
                                    <i class="fas fa-info-circle"></i>
                                </button>

                                <a asp-area="Admin"
                                   asp-controller="InstructorSmartEvaluation"
                                   asp-action="Index"
                                   asp-route-instructorId="@instructor.InstructorId"
                                   class="btn btn-outline-success btn-sm"
                                   title="تحليل ذكي شامل">
                                    <i class="fas fa-robot"></i>
                                </a>
                            </td>


                            
                        </tr>
                    }
                </tbody>
            </table>
        </div>






    }



    <div class="mt-5 text-center">
        <a asp-area="Admin" asp-controller="Instructors" asp-action="Index" class="btn btn-outline-dark">
            ⬅ العودة إلى قائمة المدربين
        </a>
    </div>





    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

        <script>
            const ctx = document.getElementById('instructorBarChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.InstructorsStats.Select(i => i.InstructorName))),
                    datasets: [{
                        label: 'نسبة النجاح (%)',
                        data: @Html.Raw(Json.Serialize(Model.InstructorsStats.Select(i => i.SuccessRate))),
                        backgroundColor: @Html.Raw(Json.Serialize(Model.InstructorsStats.Select(i =>
                    i.SuccessRate >= 80 ? "#28a745" : (i.SuccessRate >= 60 ? "#ffc107" : "#dc3545")
                )))
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100
                        }
                    }
                }
            });

                        new Chart(document.getElementById('avgScoreLineChart'), {
                type: 'line',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.InstructorPerformanceChartData.Select(x => x.InstructorName))),
                    datasets: [{
                        label: 'متوسط درجات الطلاب',
                        data: @Html.Raw(Json.Serialize(Model.InstructorPerformanceChartData.Select(x => x.AverageStudentScore))),
                        fill: true,
                        borderColor: 'rgba(75, 192, 192, 1)',
                        backgroundColor: 'rgba(75, 192, 192, 0.2)',
                        tension: 0.3,
                        pointRadius: 5,
                        pointHoverRadius: 8,
                        pointBackgroundColor: 'rgba(75, 192, 192, 1)'
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        tooltip: {
                            mode: 'index',
                            intersect: false,
                            callbacks: {
                                label: ctx => `المتوسط: ${ctx.parsed.y.toFixed(2)} / 100`
                            }
                        },
                        legend: { display: false }
                    },
                    interaction: {
                        mode: 'nearest',
                        axis: 'x',
                        intersect: false
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,
                            title: {
                                display: true,
                                text: 'درجة الطالب'
                            }
                        }
                    }
                }
            });
                       document.addEventListener("DOMContentLoaded", function () {
                const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                    new bootstrap.Tooltip(tooltipTriggerEl);
                });
            });


        </script>
    }
