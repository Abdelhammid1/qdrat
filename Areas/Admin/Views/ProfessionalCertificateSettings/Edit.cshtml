@model QdratNew.ViewModels.Admin.ProfessionalCertificates.ProfessionalCertificateSectionSettingViewModel
@{
    ViewData["Title"] = "إعدادات قسم الشهادات المهنية";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <h4 class="fw-bold mb-4">
        <i class="fas fa-gear me-2 text-secondary"></i>إعدادات قسم الشهادات المهنية
    </h4>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-3 mb-4">
            <i class="fas fa-circle-check me-1"></i> @TempData["Success"]
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4" style="max-width:640px">
        <div class="card-body p-4">
            <form asp-area="Admin" asp-controller="ProfessionalCertificateSettings" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="form-check form-switch mb-4">
                    <input asp-for="IsEnabled" class="form-check-input" type="checkbox" role="switch" />
                    <label asp-for="IsEnabled" class="form-check-label fw-bold">تفعيل القسم في الصفحة الرئيسية</label>
                </div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-600">عنوان القسم <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Subtitle" class="form-label fw-600">العنوان الفرعي</label>
                    <input asp-for="Subtitle" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-600">وصف القسم</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="ButtonText" class="form-label fw-600">نص زر التسجيل</label>
                    <input asp-for="ButtonText" class="form-control" placeholder="سجل اهتمامك" />
                </div>

                <hr />

                <div class="form-check form-switch mb-3">
                    <input asp-for="AutoCloseWhenMaxReached" class="form-check-input" type="checkbox" role="switch" />
                    <label asp-for="AutoCloseWhenMaxReached" class="form-check-label">
                        إغلاق تلقائي عند اكتمال الحد الأقصى الإجمالي
                    </label>
                </div>

                <div class="mb-3">
                    <label asp-for="GlobalMaxRequests" class="form-label fw-600">الحد الأقصى الإجمالي للطلبات</label>
                    <input asp-for="GlobalMaxRequests" class="form-control" type="number" min="1" placeholder="بلا حد" />
                    <small class="text-muted">يُطبَّق فقط عند تفعيل الإغلاق التلقائي</small>
                </div>

                <div class="mb-4">
                    <label asp-for="ClosedMessage" class="form-label fw-600">رسالة عند الإغلاق</label>
                    <textarea asp-for="ClosedMessage" class="form-control" rows="2"
                              placeholder="عذراً، التسجيل مغلق حالياً..."></textarea>
                </div>

                <button type="submit" class="btn btn-primary rounded-3 px-4">
                    <i class="fas fa-save me-1"></i> حفظ الإعدادات
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
