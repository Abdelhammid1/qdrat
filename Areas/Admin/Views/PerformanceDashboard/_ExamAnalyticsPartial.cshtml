@model QdratNew.ViewModels.Dashboard.ExamAnalyticsViewModel

@if (Model == null)
{
    <div class="alert alert-warning text-center">⚠️ لا توجد بيانات تحليلية متاحة لهذا الاختبار.</div>
}
else
{
    <div class="card shadow-sm mt-3">
        <div class="card-header bg-primary text-white fw-bold d-flex justify-content-between align-items-center">
            <span>
                <i class="bi bi-graph-up"></i> تحليل اختبار: <strong>@Model.ExamTitle</strong>
            </span>
            <small class="text-light">تاريخ الإنشاء: @Model.CreatedAt.ToString("yyyy/MM/dd")</small>
        </div>

        <div class="card-body">

            <!-- 🧠 معلومات أساسية -->
            <div class="row text-center mb-4">
                <div class="col-md-3 col-6">
                    <div class="border rounded-3 p-2 bg-light">
                        <h6 class="text-secondary mb-1">الدفعة</h6>
                        <h5 class="fw-bold text-dark">@Model.BatchName</h5>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="border rounded-3 p-2 bg-light">
                        <h6 class="text-secondary mb-1">المدرب</h6>
                        <h5 class="fw-bold text-dark">@Model.InstructorName</h5>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="border rounded-3 p-2 bg-light">
                        <h6 class="text-secondary mb-1">المنهج</h6>
                        <h5 class="fw-bold text-dark">@Model.CurriculumTitle</h5>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="border rounded-3 p-2 bg-light">
                        <h6 class="text-secondary mb-1">عدد المحاور</h6>
                        <h5 class="fw-bold text-dark">@Model.Sections?.Count()</h5>
                    </div>
                </div>
            </div>

            <!-- 🎯 كروت إحصائية رئيسية -->
            <div class="row text-center mb-4">
                <div class="col-md-2 col-6">
                    <div class="card border-primary shadow-sm">
                        <div class="card-body">
                            <h6>إجمالي الطلاب</h6>
                            <h3>@Model.TotalStudents</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card border-success shadow-sm">
                        <div class="card-body">
                            <h6>الناجحون</h6>
                            <h3>@Model.PassedStudents</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card border-danger shadow-sm">
                        <div class="card-body">
                            <h6>الراسبون</h6>
                            <h3>@Model.FailedStudents</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card border-warning shadow-sm">
                        <div class="card-body">
                            <h6>الغياب</h6>
                            <h3>@Model.AbsentStudents</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card border-info shadow-sm">
                        <div class="card-body">
                            <h6>معدل النجاح</h6>
                            <h3>@Model.SuccessRate%</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card border-dark shadow-sm">
                        <div class="card-body">
                            <h6>الخطط العلاجية</h6>
                            <h3>@Model.AtRiskStudents?.Count()</h3>
                            <a href="#" class="btn btn-outline-dark btn-sm mt-1">عرض التفاصيل</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 📊 أداء المحاور -->
            <h5 class="fw-bold text-primary mt-4 mb-3"><i class="bi bi-list-task"></i> تحليل الأداء حسب المحاور</h5>
            <table class="table table-bordered table-hover text-center align-middle">
                <thead class="table-light">
                    <tr>
                        <th>المحور</th>
                        <th>متوسط النسبة</th>
                        <th>عدد الراسبين</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Sections != null && Model.Sections.Any())
                    {
                        @foreach (var s in Model.Sections)
                        {
                            var rowClass = s.AverageScore < 50 ? "table-danger" : "";
                            <tr class="@rowClass">
                                <td>@s.SectionTitle</td>
                                <td>@s.AverageScore%</td>
                                <td>@s.FailedStudents</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-muted">⚠️ لا توجد بيانات للمحاور.</td>
                        </tr>
                    }
                </tbody>
            </table>
            <!-- 🔍 الطلاب الراسبون -->
            <h5 class="fw-bold text-danger mt-4 mb-3">
                <i class="bi bi-person-exclamation"></i> الطلاب المحتاجون إلى خطة علاجية
            </h5>

            @if (Model.AtRiskStudents != null && Model.AtRiskStudents.Any())
            {
                <table class="table table-bordered table-hover text-center align-middle">
                    <thead class="table-warning">
                        <tr>
                            <th>الطالب</th>
                            <th>عدد المحاور الضعيفة</th>
                            <th>الخيارات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model.AtRiskStudents)
                        {
                            <tr>
                                <td class="fw-bold">@student.StudentName</td>
                                <td>@student.WeakSections.Count()</td>
                                <td>
                                    <a asp-action="StudentRemedialDetails"
                                       asp-controller="PerformanceDashboard"
                                       asp-area="Admin"
                                       asp-route-studentId="@student.StudentId"
                                       asp-route-examId="@Model.ExamId"
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-activity"></i> عرض التفاصيل
                                    </a>

                                    <a asp-area="Admin"
                                       asp-controller="PerformanceExamReports"
                                       asp-action="StudentExamReport"
                                       asp-route-studentId="@student.StudentId"
                                       asp-route-examId="@Model.ExamId"
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-bar-chart"></i> عرض تقرير الطالب
                                    </a>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-success text-center">
                    🎉 لا يوجد طلاب راسبون — أداء رائع من الجميع!
                </div>
            }
        </div>
    </div>
}
