@model QdratNew.ViewModels.Remedial.StudentRemedialAnalysisViewModel
@{
    ViewData["Title"] = "📘 خطة الطالب العلاجية";
}

<div class="container py-4" dir="rtl">
    <h3 class="fw-bold text-primary mb-4">
        <i class="bi bi-activity"></i> خطة الطالب العلاجية: @Model.StudentName
    </h3>

    <!-- 🧠 معلومات أساسية -->
    <div class="row g-3 mb-4 text-center">
        <div class="col-md-3 col-6">
            <div class="card border-primary shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">الدفعة</h6>
                    <h5 class="fw-bold">@Model.BatchName</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-info shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">المنهج</h6>
                    <h5 class="fw-bold">@Model.CurriculumTitle</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-success shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">المدرب</h6>
                    <h5 class="fw-bold">@Model.InstructorName</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- 📊 المحاور الضعيفة -->
    <h4 class="fw-bold text-danger mt-4 mb-3">
        <i class="bi bi-exclamation-triangle"></i> المحاور الضعيفة للطالب
    </h4>

    @if (Model.WeakSections != null && Model.WeakSections.Any())
    {
        foreach (var sec in Model.WeakSections)
        {
            <div class="card mb-4 shadow-sm border-danger">
                <div class="card-header bg-light fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-list-task"></i> @sec.SectionTitle</span>
                    <span class="badge bg-danger">@sec.FailedIndicators.Count مؤشرات ضعيفة</span>
                </div>

                <div class="card-body">

                    <!-- 🧾 جدول المؤشرات داخل المحور -->
                    <table class="table table-bordered align-middle text-center">
                        <thead class="table-light">
                            <tr>
                                <th>المؤشر</th>
                                <th>عدد أسئلة الواجبات</th>
                                <th>عدد أسئلة الاختبارات</th>
                                <th>الخيارات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ind in sec.Indicators)
                            {
                                if (ind.IsActive && sec.FailedIndicators.Contains(ind.Title))
                                {
                                    <tr>
                                        <td>@ind.Title</td>
                                        <td>@ind.HomeworkQuestionCount</td>
                                        <td>@ind.ExamQuestionCount</td>
                                        <td>
                                            <button class="btn btn-outline-primary btn-sm toggle-details" data-target="indicator-@ind.Id">
                                                <i class="bi bi-eye"></i> عرض التفاصيل
                                            </button>
                                        </td>
                                    </tr>

                                    <!-- 🔍 جدول الأسئلة الخاصة بالمؤشر -->
                                    <tr id="indicator-@ind.Id" class="indicator-details d-none">
                                        <td colspan="4">
                                            <table class="table table-sm table-bordered mt-2">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>السؤال</th>
                                                        <th>إجابة الطالب</th>
                                                        <th>الإجابة الصحيحة</th>
                                                        <th>المصدر</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var q in ind.WrongQuestions)
                                                    {
                                                        <tr>
                                                            <td>@Html.Raw(q.QuestionText)</td>
                                                            <td class="text-danger">@Html.Raw(q.StudentAnswer)</td>
                                                            <td class="text-success">@Html.Raw(q.CorrectAnswer)</td>

                                                            <td>@q.SourceType - @q.SourceTitle</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-success text-center mt-4">
            🎉 الطالب لا يحتاج خطة علاجية — جميع المحاور متقنة.
        </div>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.toggle-details').forEach(btn => {
            btn.addEventListener('click', function () {
                const targetId = this.getAttribute('data-target');
                const targetRow = document.getElementById(targetId);
                targetRow.classList.toggle('d-none');
                this.innerHTML = targetRow.classList.contains('d-none')
                    ? '<i class="bi bi-eye"></i> عرض التفاصيل'
                    : '<i class="bi bi-eye-slash"></i> إخفاء التفاصيل';
            });
        });
    </script>
}
