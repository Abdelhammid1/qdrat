@model QdratNew.ViewModels.Admin.CourseCollections.CourseCollectionSponsorFormViewModel

<input type="hidden" asp-for="CourseCollectionId" />

<div class="row g-3">
    <div class="col-12 col-md-6">
        <label asp-for="Name" class="form-label fw-600">اسم الراعي</label>
        <input asp-for="Name" class="form-control" placeholder="اختياري" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="LinkUrl" class="form-label fw-600">رابط الراعي</label>
        <input asp-for="LinkUrl" class="form-control" placeholder="https://... (اختياري)" dir="ltr" />
        <span asp-validation-for="LinkUrl" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <hr class="my-1" />
        <label class="form-label fw-600 mb-2">
            <i class="fas fa-image me-1 text-primary"></i> لوجو الراعي <span class="text-danger">*</span>
        </label>

        @if (!string.IsNullOrEmpty(Model.ExistingLogoPath))
        {
            <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 mb-2">
                <img src="@Model.ExistingLogoPath" alt="لوجو الراعي"
                     style="width:80px;height:80px;object-fit:contain;border-radius:10px;border:1px solid #e2e8f0;background:#fff;" />
                <div class="text-muted small">اللوجو الحالي — ارفع ملفاً جديداً لاستبداله</div>
            </div>
        }

        <div>
            <input asp-for="LogoFile" type="file" class="form-control" accept="image/*" onchange="previewSponsorLogo(this)" />
            <span asp-validation-for="LogoFile" class="text-danger small"></span>
            <small class="text-muted d-block mt-1">صيغ مقبولة: JPG, PNG, WebP — سيُحوَّل تلقائياً لـ WebP</small>

            <div id="sponsorLogoPreview" class="mt-2" style="display:none;">
                <img id="sponsorLogoPreviewImg" src="" alt="معاينة"
                     style="max-width:120px;max-height:120px;object-fit:contain;border-radius:10px;border:1px solid #e2e8f0;" />
                <div class="text-muted small mt-1">معاينة اللوجو الجديد</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="DisplayOrder" class="form-label fw-600">ترتيب العرض</label>
        <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
    </div>

    <div class="col-12 col-md-6 d-flex align-items-end pb-1">
        <div class="form-check form-switch">
            <input asp-for="ShowOnHomePage" class="form-check-input" type="checkbox" role="switch" />
            <label asp-for="ShowOnHomePage" class="form-check-label">يظهر في الصفحة الرئيسية</label>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function previewSponsorLogo(input) {
            const preview = document.getElementById('sponsorLogoPreview');
            const img = document.getElementById('sponsorLogoPreviewImg');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    img.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
            } else {
                preview.style.display = 'none';
            }
        }
    </script>
}
