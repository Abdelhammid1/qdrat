@model IReadOnlyList<QdratNew.ViewModels.Admin.CourseCollections.CourseCollectionSponsorListItemViewModel>
@{
    ViewData["Title"] = "رعاة المجموعة";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var collectionId = (int)ViewBag.CollectionId;
    var collectionName = (string)ViewBag.CollectionName;
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center gap-2 mb-1">
        <a asp-area="Admin" asp-controller="CourseCollections" asp-action="Index"
           class="btn btn-sm btn-outline-secondary rounded-3">
            <i class="fas fa-arrow-right"></i> عودة إلى المجموعات
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
        <div>
            <h4 class="mb-0 fw-bold"><i class="fas fa-handshake me-2 text-success"></i>رعاة مجموعة "@collectionName"</h4>
            <small class="text-muted">إدارة لوجوهات الجهات الراعية لهذه المجموعة</small>
        </div>
        <a asp-area="Admin" asp-controller="CourseCollectionSponsors" asp-action="Create"
           asp-route-collectionId="@collectionId" class="btn btn-success rounded-3">
            <i class="fas fa-plus me-1"></i> راعٍ جديد
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-3 mb-4">
            <i class="fas fa-circle-check me-1"></i> @TempData["Success"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center text-muted py-5">
                <i class="fas fa-inbox fa-2x mb-2 d-block opacity-30"></i>
                لا يوجد رعاة بعد في هذه المجموعة
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var sponsor in Model)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body d-flex flex-column align-items-center text-center p-3">
                            <img src="@sponsor.LogoPath" alt="@(sponsor.Name ?? "شعار جهة راعية")"
                                 style="width:90px;height:90px;object-fit:contain;border-radius:10px;border:1px solid #e2e8f0;background:#fff;" class="mb-2" />
                            <div class="fw-600 small mb-1">@(sponsor.Name ?? "بدون اسم")</div>
                            @if (!string.IsNullOrEmpty(sponsor.LinkUrl))
                            {
                                <a href="@sponsor.LinkUrl" target="_blank" rel="noopener" class="small text-truncate d-block" style="max-width:100%">
                                    <i class="fas fa-link me-1"></i>@sponsor.LinkUrl
                                </a>
                            }
                            <div class="text-muted small mt-1">ترتيب: @sponsor.DisplayOrder</div>

                            <form asp-area="Admin" asp-controller="CourseCollectionSponsors"
                                  asp-action="ToggleHomeVisibility" method="post" class="d-inline mt-2 w-100">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@sponsor.Id" />
                                <input type="hidden" name="collectionId" value="@collectionId" />
                                <button type="submit" class="btn btn-sm rounded-pill px-3 w-100 @(sponsor.ShowOnHomePage ? "btn-primary" : "btn-outline-secondary")">
                                    @(sponsor.ShowOnHomePage ? "ظاهر" : "مخفي")
                                </button>
                            </form>

                            <div class="d-flex gap-2 w-100 mt-2">
                                <a asp-area="Admin" asp-controller="CourseCollectionSponsors" asp-action="Edit"
                                   asp-route-id="@sponsor.Id" asp-route-collectionId="@collectionId"
                                   class="btn btn-sm btn-outline-primary rounded-3 flex-fill">
                                    <i class="fas fa-pen"></i>
                                </a>
                                <form asp-area="Admin" asp-controller="CourseCollectionSponsors"
                                      asp-action="Delete" method="post" class="flex-fill"
                                      onsubmit="return confirm('هل أنت متأكد من حذف هذا الراعي؟');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@sponsor.Id" />
                                    <input type="hidden" name="collectionId" value="@collectionId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-3 w-100">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
