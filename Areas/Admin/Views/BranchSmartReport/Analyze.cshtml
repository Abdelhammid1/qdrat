@model QdratNew.ViewModels.Branches.BranchSmartReportViewModel

@{
    ViewData["Title"] = $"تحليل أداء الفرع: {Model.BranchName}";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4" dir="rtl">
    <div class="d-flex justify-content-end mb-3">
        <a asp-area="Admin" asp-controller="Branches" asp-action="Dashboard" class="btn btn-outline-dark">
            <i class="fas fa-arrow-right"></i> العودة إلى لوحة الفروع
        </a>
    </div>



    <!-- ✅ العنوان -->
    <h3 class="mb-4 fw-bold text-primary">
        تحليل أداء الذكاء الاصطناعي لفرع 
        <br />
        <span class="text-dark">@Model.BranchName</span>
    </h3>
    
    <hr />
    <!-- ✅ معلومات الفرع -->
    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="alert alert-info">📍 المدينة: <strong>@Model.City</strong></div></div>
        <div class="col-md-3"><div class="alert alert-secondary">🏷️ النوع: <strong>@(Model.IsPartner ? "شراكة" : "مباشر")</strong></div></div>
        <div class="col-md-3"><div class="alert alert-light">📅 تم الإنشاء: <strong>@Model.EstablishedDate.ToShortDateString()</strong></div></div>
        <div class="col-md-3"><div class="alert alert-warning">📊 مستوى الأداء: <strong>@Model.PerformanceLevel</strong></div></div>
    </div>

    <!-- ✅ كروت مؤشرات -->
    <div class="row g-4 row-cols-1 row-cols-md-3 row-cols-lg-6">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-white text-center" style="background-color: #4CA6A8;">
                <div class="card-body">
                    <div class="fs-1"><i class="fas fa-users"></i></div>
                    <div>الطلاب</div>
                    <h4 class="fw-bold">@Model.TotalStudents</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-white text-center" style="background-color: #6C757D;">
                <div class="card-body">
                    <div class="fs-1"><i class="fas fa-book"></i></div>
                    <div>الدورات</div>
                    <h4 class="fw-bold">@Model.TotalCourses</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-white text-center" style="background-color: #343A40;">
                <div class="card-body">
                    <div class="fs-1"><i class="fas fa-folder"></i></div>
                    <div>المشاريع</div>
                    <h4 class="fw-bold">@Model.TotalProjects</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-white text-center" style="background-color: #DD6B20;">
                <div class="card-body">
                    <div class="fs-1"><i class="fas fa-chart-line"></i></div>
                    <div>متوسط الأداء</div>
                    <h4 class="fw-bold">@Model.AveragePerformance.ToString("0.00")</h4>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-white text-center" style="background-color: #17a2b8;">
                <div class="card-body">
                    <div class="fs-1"><i class="fas fa-bolt"></i></div>
                    <div>نسبة التفاعل</div>
                    <h4 class="fw-bold">@Model.AverageEngagement.ToString("0.0")%</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-white text-center" style="background-color: #6f42c1;">
                <div class="card-body">
                    <div class="fs-1"><i class="fas fa-calendar-check"></i></div>
                    <div>معدل الحضور</div>
                    <h4 class="fw-bold">@Model.AverageAttendance.ToString("0.0")</h4>
                </div>
            </div>
        </div>

    </div>

    <!-- ✅ الرسومات البيانية -->
    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header fw-bold text-center bg-light">📈 تطور الأداء شهريًا</div>
                <div class="card-body">
                    <canvas id="monthlyTrendChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header fw-bold text-center bg-light">🎯 توزيع الدرجات</div>
                <div class="card-body">
                    <canvas id="scoreDistributionChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ✅ توصيات الذكاء الاصطناعي -->
    <div class="alert alert-light border-start border-5 border-primary p-4 my-5 shadow-sm">
        <h5 class="fw-bold text-primary mb-2"><i class="fas fa-brain"></i> التعليق الذكي:</h5>
        <p class="text-dark">@Model.AiComment</p>
        <h6 class="fw-bold text-success mt-3"><i class="fas fa-lightbulb"></i> التوصية:</h6>
        <p class="mb-0">@Model.Recommendation</p>
    </div>

    <!-- ✅ الطلاب المتفوقين -->
    <div class="card shadow-sm mb-5">
        <div class="card-header text-white fw-bold" style="background-color: #4CA6A8;">
            <i class="fas fa-star"></i> أفضل 5 طلاب في هذا الفرع
        </div>
        <div class="card-body table-responsive">
            <table class="table table-bordered text-center">
                <thead class="table-light">
                    <tr>
                        <th>اسم الطالب</th>
                        <th>الدرجة</th>
                        <th>نسبة التفاعل</th>
                        <th>الحضور</th>
                        <th>نقاط الضعف</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.TopStudents)
                    {
                        <tr>
                            <td>@s.StudentName</td>
                            <td>@s.Score.ToString("0.00")</td>
                            <td>@s.EngagementRate.ToString("0.0")%</td>
                            <td>@s.AttendanceCount</td>
                            <td>@(string.IsNullOrEmpty(s.WeakTopics) ? "لا توجد" : s.WeakTopics)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="alert alert-warning border-start border-5 border-dark mt-4 shadow-sm">
        <h5 class="fw-bold"><i class="fas fa-clipboard-check"></i> خلاصة التقرير:</h5>
        <p class="mb-0">هذا التقرير مبني على تحليل تفصيلي لأداء الفرع باستخدام الذكاء الاصطناعي. يُوصى باتخاذ الإجراءات المناسبة بناءً على المؤشرات المذكورة لضمان تحسين فعالية التعليم والتفاعل.</p>
    </div>


    <div class="d-flex justify-content-end mb-3">
        <a asp-area="Admin" asp-controller="Branches" asp-action="Index" class="btn btn-outline-dark">
            <i class="fas fa-arrow-right"></i> العودة إلى القائمة
        </a>
    </div>
    <a class="btn btn-outline-dark mt-4" href="@Url.Action("ExportPdf", "BranchSmartReport", new { id = Model.BranchId })">
        <i class="fas fa-file-pdf"></i> تحميل التقرير PDF
    </a>


</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const trendLabels = @Html.Raw(Json.Serialize(Model.MonthlyPerformanceTrend.Select(p => p.Month)));
            const trendScores = @Html.Raw(Json.Serialize(Model.MonthlyPerformanceTrend.Select(p => p.AverageScore)));

            new Chart(document.getElementById('monthlyTrendChart'), {
                type: 'line',
                data: {
                    labels: trendLabels,
                    datasets: [{
                        label: 'متوسط الأداء',
                        data: trendScores,
                        borderColor: '#4CA6A8',
                        backgroundColor: 'rgba(76, 166, 168, 0.2)',
                        tension: 0.3,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false }
                    }
                }
            });

            const scoreData = @Html.Raw(Json.Serialize(Model.ScoreDistribution));
            const scoreLabels = scoreData.map((_, i) => `طالب ${i + 1}`);

            new Chart(document.getElementById('scoreDistributionChart'), {
                type: 'bar',
                data: {
                    labels: scoreLabels,
                    datasets: [{
                        label: 'الدرجة',
                        data: scoreData,
                        backgroundColor: '#DD6B20'
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        });
    </script>
}
