@model IEnumerable<QdratNew.Entities.Frontend.PlatformGoal>
@{
    ViewData["Title"] = "🎯 أهداف المنصة";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4" dir="rtl">
    <div class="d-flex justify-content-between mb-3">
        <h3 class="fw-bold text-primary"><i class="bi bi-bullseye me-2"></i> أهداف المنصة</h3>
        <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i> إضافة هدف</a>
    </div>

    <table class="table table-bordered align-middle text-center">
        <thead class="table-light">
            <tr>
                <th>الترتيب</th>
                <th>الأيقونة</th>
                <th>العنوان</th>
                <th>الوصف</th>
                <th>الحالة</th>
                <th>تحكم</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var g in Model)
            {
                <tr>
                    <td>@g.DisplayOrder</td>
                    <td><i class="@g.IconClass fs-4 text-success"></i></td>
                    <td>@g.Title</td>
                    <td>@g.Description</td>
                    <td>@(g.IsActive ? "✅" : "❌")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@g.Id" class="btn btn-sm btn-primary">✏️ تعديل</a>
                        <form asp-action="Delete" asp-route-id="@g.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('هل أنت متأكد من الحذف؟');">🗑️ حذف</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
