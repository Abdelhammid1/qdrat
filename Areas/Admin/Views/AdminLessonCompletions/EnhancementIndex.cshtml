@model IEnumerable<QdratNew.ViewModels.EnhancementSkills.EnhancementSkillSetViewModel>

@{
    ViewData["Title"] = "📘 المهارات التعزيزية";

    var total = Model.Count();
    var sent = Model.Count(s => s.IsSent);
    var pending = total - sent;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold text-qdrat">@ViewData["Title"]</h2>
    <a asp-action="CreateEnhancementSet" class="btn btn-qdrat">
        ➕ إضافة يدوياً
    </a>
</div>

<!-- 🔹 الكروت الإحصائية -->
<div class="row mb-4 text-center">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-qdrat-light">
            <div class="card-body">
                <h6 class="text-muted">إجمالي المهارات</h6>
                <h3 class="fw-bold text-primary">@total</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-qdrat-light">
            <div class="card-body">
                <h6 class="text-muted">تم الإرسال ✅</h6>
                <h3 class="fw-bold text-success">@sent</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-qdrat-light">
            <div class="card-body">
                <h6 class="text-muted">قيد الانتظار ⏳</h6>
                <h3 class="fw-bold text-warning">@pending</h3>
            </div>
        </div>
    </div>
</div>

<!-- 🔹 الجدول -->
<table id="enhancementTable" class="table table-bordered table-striped text-center align-middle shadow-sm">
    <thead class="table-primary">
        <tr>
            <th>📖 المحاضرة</th>
            <th>🎓 الدفعة</th>
            <th>العنوان</th>
            <th>📅 تاريخ الإنشاء</th>
            <th>👥 الطلاب</th>
            <th>الحالة</th>
            <th>الإجراءات</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            foreach (var set in Model)
            {
                <tr>
                    <td>@set.LectureTitle</td>
                    <td>@set.BatchName</td>
                    <td>@set.Title</td>
                    <td>@set.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@set.StudentsCount</td>
                    <td>
                        @if (set.IsSent)
                        {
                            <span class="badge bg-success">✅ تم الإرسال</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">⏳ في الانتظار</span>
                        }
                    </td>
                    <td>
                        <a asp-action="EnhancementDetails" asp-route-id="@set.Id"
                           class="btn btn-sm btn-outline-info me-1">
                            📊 تفاصيل
                        </a>

                        @if (!set.IsSent)
                        {
                            <a asp-action="PickEnhancementQuestions" asp-route-setId="@set.Id"
                               class="btn btn-sm btn-outline-success me-1">
                                ✏️ اختيار الأسئلة
                            </a>

                            <form asp-action="SendEnhancementSkills" method="post" class="d-inline">
                                <input type="hidden" name="setId" value="@set.Id" />
                                <button type="submit" class="btn btn-sm btn-success"
                                        onclick="return confirm('هل أنت متأكد من إرسال هذه المهارات الآن إلى جميع الطلاب؟');">
                                    🚀 إرسال الآن
                                </button>
                            </form>
                        }

                        else
                        {
                            <a asp-action="ResendToBatch" asp-route-setId="@set.Id"
                               class="btn btn-sm btn-outline-warning">
                                🔄 إعادة إرسال
                            </a>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-muted">⚠️ لا توجد مهارات تعزيزية مسجلة بعد.</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#enhancementTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json'
                },
                dom: 'Bfrtip',
                buttons: [
                    { extend: 'copy', text: '📋 نسخ', className: 'btn btn-sm btn-outline-secondary' },
                    { extend: 'excel', text: '📊 Excel', className: 'btn btn-sm btn-outline-success' },
                    { extend: 'print', text: '🖨️ طباعة', className: 'btn btn-sm btn-outline-primary' }
                ],
                pageLength: 50,
                ordering: true,
                responsive: true
            });
        });
    </script>
}
