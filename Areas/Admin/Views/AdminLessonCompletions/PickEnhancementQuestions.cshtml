@model QdratNew.ViewModels.EnhancementSkills.PickEnhancementQuestionsViewModel

@{
    ViewData["Title"] = "اختيار الأسئلة يدوياً";
}

<div class="container mt-4">
    <!-- ✅ العنوان -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-primary">
            ✏️ اختيار الأسئلة - @Model.LectureTitle
        </h2>
        <a asp-action="EnhancementDetails" asp-route-id="@Model.SetId" class="btn btn-outline-secondary">
            🔙 رجوع
        </a>
    </div>

    <!-- ✅ معلومات الدفعة -->
    <div class="alert alert-info shadow-sm mb-4">
        <b>📖 المحاضرة:</b> @Model.LectureTitle <br />
        <b>🎓 الدفعة:</b> @Model.BatchName
    </div>

    <!-- ✅ الفلاتر -->
    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label fw-bold">📊 فلترة حسب المحور</label>
            <select id="sectionFilter" class="form-select">
                <option value="">-- الكل --</option>
                @foreach (var sec in Model.AvailableQuestions.Select(q => q.SectionTitle).Distinct().Where(s => !string.IsNullOrEmpty(s)))
                {
                    <option value="@sec">@sec</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">📘 فلترة حسب المؤشر</label>
            <select id="lessonFilter" class="form-select">
                <option value="">-- الكل --</option>
                @foreach (var lesson in Model.AvailableQuestions.Select(q => q.LessonTitle).Distinct().Where(l => !string.IsNullOrEmpty(l)))
                {
                    <option value="@lesson">@lesson</option>
                }
            </select>
        </div>
    </div>

    <form asp-action="PickEnhancementQuestions" method="post">
        <input type="hidden" asp-for="SetId" />
        <input type="hidden" asp-for="BatchId" />

        <!-- ✅ الجدول -->
        <table id="questionsTable" class="table table-bordered table-striped text-center align-middle shadow-sm">
            <thead class="table-primary">
                <tr>
                    <th>
                        <input type="checkbox" id="selectAll" />
                    </th>
                    <th>🔑 الكود</th>
                    <th>📝 النص</th>
                    <th>📊 المحور</th>
                    <th>📘 المؤشر</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var q in Model.AvailableQuestions)
                {
                    <tr>
                        <td>
                            <input type="checkbox" name="SelectedQuestionIds" value="@q.QuestionId" />
                        </td>
                        <td>@q.ReferenceNumber</td>
                        <td class="text-start">@Html.Raw(q.Title)</td> <!-- ✅ عرض النص كـ HTML -->
                        <td>@q.SectionTitle</td>
                        <td>@q.LessonTitle</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- ✅ الأزرار -->
        <div class="mt-4 d-flex justify-content-between">
            <button type="submit" class="btn btn-success">
                ✅ إرسال الأسئلة المختارة
            </button>
            <a asp-action="EnhancementDetails" asp-route-id="@Model.SetId" class="btn btn-secondary">
                🔙 رجوع
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#questionsTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json'
                },
                dom: 'Bfrtip',
                buttons: [
                    { extend: 'copy', text: '📋 نسخ', className: 'btn btn-sm btn-outline-secondary' },
                    { extend: 'excel', text: '📊 Excel', className: 'btn btn-sm btn-outline-success' },
                    { extend: 'print', text: '🖨️ طباعة', className: 'btn btn-sm btn-outline-primary' }
                ],
                pageLength: 50,
                ordering: true,
                responsive: true
            });

            // ✅ فلترة حسب المحور
            $('#sectionFilter').on('change', function () {
                table.column(3).search(this.value).draw(); // العمود الرابع (المحور)
            });

            // ✅ فلترة حسب المؤشر
            $('#lessonFilter').on('change', function () {
                table.column(4).search(this.value).draw(); // العمود الخامس (المؤشر)
            });

            // ✅ تحديد الكل
            $("#selectAll").click(function () {
                $('input[name="SelectedQuestionIds"]').prop('checked', this.checked);
            });
        });
    </script>
}
