@model QdratNew.ViewModels.Homework.CreateExtraHomeworkViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "إنشاء واجب إضافي";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        :root {
            --q-primary: #1a56db;
            --q-primary-dark: #1240a8;
            --q-primary-light: #e8f0fe;
            --q-success: #059669;
            --q-success-light: #d1fae5;
            --q-danger: #dc2626;
            --q-danger-light: #fee2e2;
            --q-warning: #d97706;
            --q-warning-light: #fef3c7;
            --q-purple: #7c3aed;
            --q-purple-light: #ede9fe;
            --q-surface: #ffffff;
            --q-bg: #f4f6fb;
            --q-border: #e2e8f0;
            --q-border-focus: #1a56db;
            --q-text: #0f172a;
            --q-text-muted: #64748b;
            --q-text-light: #94a3b8;
            --q-shadow-sm: 0 1px 3px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.04);
            --q-shadow: 0 4px 16px rgba(15,23,42,.08);
            --q-shadow-lg: 0 10px 30px rgba(15,23,42,.12);
            --q-radius: 12px;
            --q-radius-sm: 8px;
            --q-radius-lg: 16px;
            --q-transition: all .2s cubic-bezier(.4,0,.2,1);
        }

        body {
            font-family: 'Cairo', sans-serif !important;
            background: var(--q-bg);
            color: var(--q-text);
            direction: rtl;
        }

        .qdrat-page {
            max-width: 1240px;
            margin: 0 auto;
            padding: 24px 12px 44px;
        }

        .qpage-header {
            background: linear-gradient(135deg, var(--q-primary) 0%, var(--q-primary-dark) 100%);
            border-radius: var(--q-radius-lg);
            padding: 22px 28px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            box-shadow: 0 8px 24px rgba(26,86,219,.25);
            position: relative;
            overflow: hidden;
        }

            .qpage-header::before {
                content: '';
                position: absolute;
                left: -60px;
                top: -60px;
                width: 200px;
                height: 200px;
                background: rgba(255,255,255,.06);
                border-radius: 50%;
            }

            .qpage-header::after {
                content: '';
                position: absolute;
                right: 40px;
                bottom: -80px;
                width: 160px;
                height: 160px;
                background: rgba(255,255,255,.04);
                border-radius: 50%;
            }

        .qpage-header-content,
        .qpage-header-actions {
            position: relative;
            z-index: 1;
        }

        .qpage-title {
            color: #fff;
            font-size: 23px;
            font-weight: 900;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-icon {
            width: 44px;
            height: 44px;
            background: rgba(255,255,255,.18);
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .qpage-subtitle {
            color: rgba(255,255,255,.86);
            margin: 8px 56px 0 0;
            font-size: 13px;
            line-height: 1.8;
        }

        .btn-back {
            background: rgba(255,255,255,.15);
            border: 1.5px solid rgba(255,255,255,.3);
            color: #fff;
            border-radius: var(--q-radius-sm);
            padding: 9px 18px;
            font-size: 14px;
            font-weight: 800;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: var(--q-transition);
            white-space: nowrap;
        }

            .btn-back:hover {
                background: rgba(255,255,255,.28);
                color: #fff;
                transform: translateX(2px);
            }

        .q-success-alert {
            background: var(--q-success-light);
            border: 1px solid rgba(5,150,105,.22);
            color: #065f46;
            border-radius: var(--q-radius);
            padding: 14px 18px;
            margin-bottom: 18px;
            box-shadow: var(--q-shadow-sm);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .progress-stepper {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
            margin-bottom: 22px;
            background: var(--q-surface);
            border-radius: var(--q-radius);
            padding: 8px;
            box-shadow: var(--q-shadow-sm);
            border: 1px solid var(--q-border);
        }

        .step-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 12px;
            border-radius: var(--q-radius-sm);
            background: #fff;
            border: 1px solid transparent;
        }

            .step-item.active {
                background: var(--q-primary);
                color: #fff;
            }

        .step-num {
            width: 25px;
            height: 25px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 900;
            background: var(--q-border);
            color: var(--q-text-muted);
            flex-shrink: 0;
        }

        .step-item.active .step-num {
            background: rgba(255,255,255,.25);
            color: #fff;
        }

        .step-label {
            font-size: 13px;
            font-weight: 800;
            color: var(--q-text-muted);
            white-space: nowrap;
        }

        .step-item.active .step-label {
            color: #fff;
        }

        .qsection {
            background: var(--q-surface);
            border-radius: var(--q-radius);
            margin-bottom: 20px;
            box-shadow: var(--q-shadow-sm);
            border: 1px solid var(--q-border);
            overflow: hidden;
            transition: var(--q-transition);
        }

            .qsection:focus-within {
                border-color: var(--q-border-focus);
                box-shadow: 0 0 0 3px rgba(26,86,219,.08), var(--q-shadow);
            }

        .qsection-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 15px 20px;
            border-bottom: 1px solid var(--q-border);
            background: #fafbfd;
        }

        .qsection-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 16px;
            font-weight: 900;
            color: var(--q-text);
            margin: 0;
        }

        .section-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }

        .icon-blue {
            background: var(--q-primary-light);
            color: var(--q-primary);
        }

        .icon-green {
            background: var(--q-success-light);
            color: var(--q-success);
        }

        .icon-purple {
            background: var(--q-purple-light);
            color: var(--q-purple);
        }

        .icon-amber {
            background: var(--q-warning-light);
            color: var(--q-warning);
        }

        .icon-red {
            background: var(--q-danger-light);
            color: var(--q-danger);
        }

        .qsection-body {
            padding: 22px;
        }

        .form-label {
            color: var(--q-text);
            font-weight: 800;
            font-size: 13px;
            margin-bottom: 8px;
        }

        .form-control,
        .form-select {
            border: 1.5px solid var(--q-border);
            border-radius: 10px;
            padding: 10px 13px;
            font-size: 14px;
            color: var(--q-text);
            transition: var(--q-transition);
            background-color: #fff;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: var(--q-primary);
                box-shadow: 0 0 0 3px rgba(26,86,219,.10);
            }

            .form-select[multiple] {
                min-height: 142px;
                padding: 8px;
            }

        .q-help-text {
            color: var(--q-text-muted);
            font-size: 12.5px;
            line-height: 1.8;
            margin-top: 7px;
        }

        .q-badge {
            background: var(--q-primary-light);
            color: var(--q-primary);
            border-radius: 999px;
            padding: 6px 12px;
            font-size: 12px;
            font-weight: 900;
            white-space: nowrap;
        }

        .q-scroll-box {
            max-height: 360px;
            overflow: auto;
            border: 1.5px solid var(--q-border);
            border-radius: var(--q-radius);
            background: #fff;
            padding: 12px;
        }

            .q-scroll-box.is-empty {
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--q-text-muted);
                min-height: 120px;
            }

        .section-item {
            border: 1px solid var(--q-border);
            border-radius: 10px;
            padding: 10px 38px 10px 12px;
            margin-bottom: 8px !important;
            background: #fff;
            transition: var(--q-transition);
            position: relative;
        }

            .section-item:hover {
                background: #f8fafc;
                border-color: rgba(26,86,219,.28);
            }

            .section-item .form-check-input {
                float: none;
                margin-left: 0;
                margin-right: -26px;
            }

        .student-batch-box {
            border: 1px solid var(--q-border);
            border-radius: var(--q-radius);
            padding: 12px;
            margin-bottom: 12px;
            background: #fff;
        }

        .student-batch-title {
            color: var(--q-success);
            font-weight: 900;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .students-table {
            margin-bottom: 0;
        }

            .students-table thead th {
                background: #f8fafc;
                color: var(--q-text-muted);
                font-size: 12px;
                font-weight: 900;
                border-bottom: 1px solid var(--q-border);
            }

        .q-summary-card {
            height: 100%;
            border: 1px dashed rgba(26,86,219,.28);
            background: linear-gradient(135deg, #f8fafc 0%, #eef6ff 100%);
            border-radius: var(--q-radius);
            padding: 15px;
            color: var(--q-text-muted);
            font-size: 13px;
            line-height: 1.8;
        }

        .q-action-bar {
            background: var(--q-surface);
            border: 1px solid var(--q-border);
            border-radius: var(--q-radius);
            box-shadow: var(--q-shadow-sm);
            padding: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            position: sticky;
            bottom: 12px;
            z-index: 8;
        }

        .btn-q-primary,
        .btn-q-secondary {
            border-radius: 10px;
            padding: 11px 22px;
            font-weight: 900;
            font-size: 14px;
            text-decoration: none;
            min-height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: var(--q-transition);
        }

        .btn-q-primary {
            border: 0;
            color: #fff;
            background: linear-gradient(135deg, var(--q-primary) 0%, var(--q-primary-dark) 100%);
            box-shadow: 0 8px 18px rgba(26,86,219,.22);
        }

            .btn-q-primary:hover {
                color: #fff;
                transform: translateY(-1px);
                box-shadow: 0 12px 24px rgba(26,86,219,.28);
            }

        .btn-q-secondary {
            border: 1.5px solid var(--q-border);
            background: #fff;
            color: var(--q-text-muted);
        }

            .btn-q-secondary:hover {
                background: #f8fafc;
                color: var(--q-primary);
            }

        .validation-summary-errors {
            background: var(--q-danger-light);
            border: 1px solid rgba(220,38,38,.25);
            color: #991b1b;
            border-radius: var(--q-radius);
            padding: 12px 14px;
            margin-top: 14px;
        }

        @@media (max-width: 992px) {
            .progress-stepper {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 768px) {
            .qpage-header {
                flex-direction: column;
                align-items: stretch;
                padding: 18px;
            }

            .qpage-title {
                font-size: 19px;
            }

            .qpage-subtitle {
                margin-right: 0;
            }

            .progress-stepper {
                grid-template-columns: 1fr;
            }

            .qsection-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .q-action-bar {
                position: static;
                flex-direction: column;
                align-items: stretch;
            }

            .btn-q-primary,
            .btn-q-secondary,
            .btn-back {
                width: 100%;
            }
        }
    </style>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="qdrat-page pb-0" dir="rtl">
        <div class="q-success-alert" role="alert">
            <div>✅ @TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
        </div>
    </div>
}

<div class="qdrat-page" dir="rtl">
    <div class="qpage-header">
        <div class="qpage-header-content">
            <h1 class="qpage-title">
                <span class="header-icon">📚</span>
                إنشاء واجب إضافي
            </h1>
            <p class="qpage-subtitle">
                اختر الدورة والمنهج والدفعات، ثم حدد الطلاب والمحاور لإرسال واجب إضافي بنفس منطق التوليد الحالي.
            </p>
        </div>
        <div class="qpage-header-actions">
            <a asp-action="ModelAssignments" class="btn-back">↩️ رجوع</a>
        </div>
    </div>

    <div class="progress-stepper" aria-label="مراحل إنشاء الواجب الإضافي">
        <div class="step-item active">
            <span class="step-num">1</span>
            <span class="step-label">بيانات الواجب</span>
        </div>
        <div class="step-item active">
            <span class="step-num">2</span>
            <span class="step-label">الدورة والدفعات</span>
        </div>
        <div class="step-item active">
            <span class="step-num">3</span>
            <span class="step-label">الطلاب والمحاور</span>
        </div>
        <div class="step-item active">
            <span class="step-num">4</span>
            <span class="step-label">الحفظ والإرسال</span>
        </div>
    </div>

    <form asp-action="CreateExtraHomework" asp-controller="AdminLessonCompletions" asp-area="Admin" method="post" autocomplete="off">
        @Html.AntiForgeryToken()

        <div class="qsection">
            <div class="qsection-header">
                <h2 class="qsection-title">
                    <span class="section-icon icon-blue">📝</span>
                    بيانات الواجب والتوقيت
                </h2>
            </div>
            <div class="qsection-body">
                <div class="row g-4">
                    <div class="col-lg-6">
                        <label asp-for="Title" class="form-label">عنوان الواجب</label>
                        <input asp-for="Title" class="form-control" placeholder="مثلاً: واجب إضافي للمراجعة" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="col-lg-6">
                        <div class="q-summary-card">
                            هذه الصفحة لا تغيّر منطق اختيار الأسئلة أو التوليد، بل تنظّم الإدخال وتحافظ على نفس الحقول المرسلة للـ Action الحالي.
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="StartAt" class="form-label">يبدأ في</label>
                        <input asp-for="StartAt" type="datetime-local" class="form-control" />
                        <span asp-validation-for="StartAt" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="EndAt" class="form-label">ينتهي في</label>
                        <input asp-for="EndAt" type="datetime-local" class="form-control" />
                        <span asp-validation-for="EndAt" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">عدد الأسئلة لكل طالب</label>
                        <input id="QuestionsPerStudent" name="QuestionsPerStudent" class="form-control" type="number" min="1" max="200" value="15" />
                        <div class="q-help-text">سيتم الاختيار عشوائيًا من بنك الأسئلة المطابق.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="qsection">
            <div class="qsection-header">
                <h2 class="qsection-title">
                    <span class="section-icon icon-green">🎯</span>
                    الدورة والمنهج والدفعات
                </h2>
            </div>
            <div class="qsection-body">
                <div class="row g-4">
                    <div class="col-md-4">
                        <label class="form-label">الدورة</label>
                        <select id="CourseId" class="form-select">
                            <option value="">اختر الدورة...</option>
                        </select>
                        <div class="q-help-text">بعد اختيار الدورة سيتم تحميل المناهج والدفعات.</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">المنهج</label>
                        <select id="CurriculumId" class="form-select" disabled>
                            <option value="">اختر المنهج...</option>
                        </select>
                        <div class="q-help-text">بعد اختيار المنهج ستظهر المحاور الخاصة به.</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">الدفعات المستهدفة</label>
                        <select asp-for="SelectedBatchIds" class="form-select" multiple id="BatchMultiSelect" disabled>
                            <option value="">اختر الدفعات...</option>
                        </select>
                        <div class="q-help-text">يمكن اختيار أكثر من دفعة بالضغط على Ctrl أو ⌘.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="qsection h-100">
                    <div class="qsection-header">
                        <h2 class="qsection-title">
                            <span class="section-icon icon-purple">👥</span>
                            الطلاب المحددون من الدفعات
                        </h2>
                        <span class="q-badge" id="studentsCount">0 طالب</span>
                    </div>
                    <div class="qsection-body">
                        <div id="studentsContainer" class="q-scroll-box is-empty">
                            <p class="text-muted mb-0">لم يتم اختيار أي دفعة بعد.</p>
                        </div>
                        <div class="q-help-text mt-2">يتم تحميل طلاب كل دفعة عند اختيارها من القائمة أعلاه.</div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="qsection h-100">
                    <div class="qsection-header">
                        <h2 class="qsection-title">
                            <span class="section-icon icon-amber">🧩</span>
                            المحاور
                        </h2>
                        <div class="d-flex align-items-center gap-3 flex-wrap">
                            <span class="q-badge" id="sectionsCount">0 محدد</span>
                            <div class="form-check mb-0">
                                <input id="sectionsSelectAll" type="checkbox" class="form-check-input" />
                                <label for="sectionsSelectAll" class="form-check-label fw-bold small">تحديد الكل</label>
                            </div>
                        </div>
                    </div>
                    <div class="qsection-body">
                        <div id="sectionsList" class="q-scroll-box">
                            @for (int i = 0; i < Model.Sections.Count; i++)
                            {
                                <div class="form-check section-item">
                                    <input type="hidden" asp-for="Sections[@i].SectionId" />
                                    <input type="hidden" asp-for="Sections[@i].Title" />
                                    <input asp-for="Sections[@i].Selected" class="form-check-input section-check" />
                                    <label class="form-check-label fw-bold">@Model.Sections[i].Title</label>
                                </div>
                            }
                        </div>
                        <div class="q-help-text mt-2">اختر محورًا واحدًا على الأقل حتى يتم توليد الواجب من نطاق واضح.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="q-action-bar mt-3">
            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn-q-primary" onclick="return validateBeforeSubmit()">
                    <i class="bi bi-send-check"></i> حفظ وإرسال
                </button>
                <a asp-action="ModelAssignments" class="btn-q-secondary">
                    <i class="bi bi-arrow-right"></i> رجوع
                </a>
            </div>
            <div class="text-muted small">سيتم إرسال نفس البيانات المتوقعة من الـ Action الحالي بدون تغيير أسماء الحقول.</div>
        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.documentElement.setAttribute('dir', 'rtl');

        document.addEventListener('DOMContentLoaded', async function () {
            await loadCourses();
            updateCounters();
            updateStudentsCount(0);
        });

        async function loadCourses() {
            const url = '@Url.Action("GetCourses", "AdminLessonCompletions", new { area = "Admin" })';
            const res = await fetch(url);
            const data = await res.json();
            fillSelect('CourseId', data, 'اختر الدورة...');
            document.getElementById('CourseId').addEventListener('change', onCourseChanged);
        }

        async function onCourseChanged() {
            const courseId = document.getElementById('CourseId').value;
            clearSelect('CurriculumId', 'اختر المنهج...');
            clearSelect('BatchMultiSelect', 'اختر الدفعات...');
            clearLists();
            clearStudentsContainer();

            if (!courseId) {
                return;
            }

            const curUrl = '@Url.Action("GetCurriculumsByCourse", "AdminLessonCompletions", new { area = "Admin" })' + '?courseId=' + encodeURIComponent(courseId);
            const curRes = await fetch(curUrl);
            const curData = await curRes.json();
            fillSelect('CurriculumId', curData, 'اختر المنهج...');
            const curSel = document.getElementById('CurriculumId');
            curSel.disabled = false;
            curSel.removeEventListener('change', onCurriculumChanged);
            curSel.addEventListener('change', onCurriculumChanged);

            const batUrl = '@Url.Action("GetBatchesByCourse", "AdminLessonCompletions", new { area = "Admin" })' + '?courseId=' + encodeURIComponent(courseId);
            const batRes = await fetch(batUrl);
            const batData = await batRes.json();
            fillSelect('BatchMultiSelect', batData, 'اختر الدفعات...');
            document.getElementById('BatchMultiSelect').disabled = false;
        }

        async function onCurriculumChanged() {
            const curriculumId = document.getElementById('CurriculumId').value;
            const cont = document.getElementById('sectionsList');
            cont.innerHTML = '';

            if (!curriculumId) {
                updateCounters();
                return;
            }

            const url = '@Url.Action("GetSectionsByCurriculum", "AdminLessonCompletions", new { area = "Admin" })' + '?curriculumId=' + encodeURIComponent(curriculumId);
            const res = await fetch(url);
            const sections = await res.json();

            sections.forEach((s, i) => {
                const div = document.createElement('div');
                div.className = 'form-check section-item';
                div.innerHTML = `
                    <input type="hidden" name="Sections[${i}].SectionId" value="${escapeHtmlAttribute(s.id)}" />
                    <input type="hidden" name="Sections[${i}].Title" value="${escapeHtmlAttribute(s.title)}" />
                    <input class="form-check-input section-check" type="checkbox" name="Sections[${i}].Selected" value="true" />
                    <input type="hidden" name="Sections[${i}].Selected" value="false" />
                    <label class="form-check-label fw-bold">${escapeHtml(s.title)}</label>
                `;
                cont.appendChild(div);
            });

            updateCounters();
        }

        function fillSelect(id, items, placeholder) {
            const sel = document.getElementById(id);
            sel.innerHTML = '';

            const opt0 = document.createElement('option');
            opt0.value = '';
            opt0.textContent = placeholder || 'اختر...';
            sel.appendChild(opt0);

            items.forEach(x => {
                const option = document.createElement('option');
                option.value = x.id;
                option.textContent = x.title;
                sel.appendChild(option);
            });
        }

        function clearSelect(id, placeholder) {
            const sel = document.getElementById(id);
            sel.innerHTML = `<option value="">${placeholder || 'اختر...'}</option>`;
            sel.disabled = true;
        }

        function clearLists() {
            document.getElementById('sectionsList').innerHTML = '';
            document.getElementById('sectionsSelectAll').checked = false;
            updateCounters();
        }

        function clearStudentsContainer() {
            const container = document.getElementById('studentsContainer');
            container.classList.add('is-empty');
            container.innerHTML = "<p class='text-muted mb-0'>لم يتم اختيار أي دفعة بعد.</p>";
            updateStudentsCount(0);
        }

        function updateCounters() {
            const sectionsSelected = document.querySelectorAll('.section-check:checked').length;
            document.getElementById('sectionsCount').textContent = sectionsSelected + ' محدد';
        }

        function updateStudentsCount(count) {
            document.getElementById('studentsCount').textContent = count + ' طالب';
        }

        document.addEventListener('change', function (e) {
            if (e.target.classList.contains('section-check')) {
                updateCounters();
            }

            if (e.target.classList.contains('student-check')) {
                const selectedStudents = document.querySelectorAll('.student-check:checked').length;
                updateStudentsCount(selectedStudents);
            }
        });

        document.getElementById('sectionsSelectAll').addEventListener('change', function () {
            document.querySelectorAll('.section-check').forEach(c => c.checked = this.checked);
            updateCounters();
        });

        document.getElementById('BatchMultiSelect').addEventListener('change', async function () {
            const selectedBatchIds = Array.from(this.selectedOptions)
                .map(o => o.value)
                .filter(v => v !== '');

            const container = document.getElementById('studentsContainer');
            container.innerHTML = '';
            container.classList.remove('is-empty');
            updateStudentsCount(0);

            if (selectedBatchIds.length === 0) {
                clearStudentsContainer();
                return;
            }

            let allStudents = [];

            for (const batchId of selectedBatchIds) {
                const res = await fetch(`/Admin/AdminLessonCompletions/GetStudentsByBatch?batchId=${encodeURIComponent(batchId)}`);

                if (!res.ok) {
                    continue;
                }

                const students = await res.json();
                const batchBox = document.createElement('div');
                batchBox.className = 'student-batch-box';
                batchBox.innerHTML = `<div class="student-batch-title">👥 الدفعة رقم ${escapeHtml(batchId)}</div>`;

                if (students.length === 0) {
                    batchBox.innerHTML += `<p class='text-muted mb-0'>لا يوجد طلاب في هذه الدفعة.</p>`;
                } else {
                    const table = document.createElement('table');
                    table.className = 'table table-sm table-hover align-middle students-table';
                    table.innerHTML = `
                        <thead>
                            <tr>
                                <th style="width:90px;">تحديد</th>
                                <th>اسم الطالب</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${students.map(s => `
                                <tr>
                                    <td><input type="checkbox" class="form-check-input student-check" name="SelectedStudentIds" value="${escapeHtmlAttribute(s.studentID)}" checked></td>
                                    <td class="fw-bold">${escapeHtml(s.fullName)}</td>
                                </tr>
                            `).join('')}
                        </tbody>`;
                    batchBox.appendChild(table);
                }

                container.appendChild(batchBox);
                allStudents = allStudents.concat(students);
            }

            if (allStudents.length > 0) {
                const countLabel = document.createElement('div');
                countLabel.className = 'q-badge mt-2 d-inline-flex';
                countLabel.innerHTML = `إجمالي الطلاب المحملين: ${allStudents.length}`;
                container.appendChild(countLabel);
            }

            updateStudentsCount(document.querySelectorAll('.student-check:checked').length);
        });

        function validateBeforeSubmit() {
            const course = document.getElementById('CourseId').value;
            const cur = document.getElementById('CurriculumId').value;
            const batches = Array.from(document.querySelectorAll('#BatchMultiSelect option:checked'))
                .map(o => o.value)
                .filter(v => v !== '');
            const students = Array.from(document.querySelectorAll('.student-check:checked')).map(c => c.value);
            const secCount = document.querySelectorAll('.section-check:checked').length;
            const qps = parseInt(document.getElementById('QuestionsPerStudent').value || '0');

            if (!course) { alert('اختر الدورة أولًا.'); return false; }
            if (!cur) { alert('اختر المنهج.'); return false; }
            if (batches.length === 0) { alert('اختر دفعة واحدة على الأقل.'); return false; }
            if (students.length === 0) { alert('يجب اختيار طالب واحد على الأقل من الدفعات.'); return false; }
            if (secCount === 0) { alert('يجب اختيار محور واحد على الأقل.'); return false; }
            if (qps <= 0) { alert('أدخل عددًا صحيحًا للأسئلة لكل طالب.'); return false; }

            const start = document.querySelector('input[name="StartAt"]').value;
            const end = document.querySelector('input[name="EndAt"]').value;

            if (start && end && new Date(start) > new Date(end)) {
                alert('وقت البداية يجب أن يكون قبل وقت النهاية.');
                return false;
            }

            return true;
        }

        function escapeHtml(value) {
            if (value === null || value === undefined) {
                return '';
            }

            return String(value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function escapeHtmlAttribute(value) {
            return escapeHtml(value);
        }
    </script>
}
