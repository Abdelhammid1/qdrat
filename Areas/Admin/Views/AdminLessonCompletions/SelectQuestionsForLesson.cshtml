@model QdratNew.ViewModels.Homework.LessonQuestionsSelectionViewModel
@{
    ViewData["Title"] = "اختيار الأسئلة يدويًا";
}

<h2 class="text-center text-qdrat mb-4">
    🧠 اختيار الأسئلة للمؤشر: <span class="text-primary">@Model.LessonTitle</span>
</h2>

<div class="card shadow-sm p-3 mb-4 border-0">
    <form asp-action="SaveSelectedQuestions" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="LessonId" />

        <div class="table-responsive">
            <table id="questionsTable" class="table table-striped table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr class="text-center">
                        <th style="width:5%">#</th>
                        <th>نص السؤال</th>
                        <th style="width:15%">الصعوبة</th>
                        <th style="width:10%">مراجَع</th>
                        <th style="width:10%">اختيار</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Questions.Count; i++)
                    {
                        var q = Model.Questions[i];
                        <tr>
                            <td class="text-center">@(@i + 1)</td>
                            <td>@q.Title</td>
                            <td class="text-center">@q.Difficulty</td>
                            <td class="text-center">
                                @(q.IsReviewed ? "✅" : "❌")
                            </td>
                            <td class="text-center">
                                <input type="checkbox" name="SelectedQuestionIds" value="@q.QuestionId"
                                       class="form-check-input select-box" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="text-center mt-4">
            <button type="submit" class="btn btn-success px-5">
                <i class="fas fa-save"></i> حفظ الاختيار
            </button>
            <a asp-action="ConfirmHomework" asp-route-batchId="@Model.BatchId"
               class="btn btn-outline-secondary ms-3">
                <i class="fas fa-arrow-left"></i> العودة
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#questionsTable').DataTable({
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.4/i18n/ar.json"
                },
                pageLength: 10,
                order: [[1, 'asc']],
                columnDefs: [
                    { orderable: false, targets: [0, 4] }
                ]
            });
        });
    </script>
}
