@model QdratNew.ViewModels.EnhancementSkills.CreateEnhancementSetViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "إضافة مهارة تعزيزية";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        :root {
            --q-primary: #1a56db;
            --q-primary-dark: #1240a8;
            --q-primary-light: #e8f0fe;
            --q-success: #059669;
            --q-success-dark: #047857;
            --q-success-light: #d1fae5;
            --q-warning: #d97706;
            --q-warning-light: #fef3c7;
            --q-danger: #dc2626;
            --q-danger-light: #fee2e2;
            --q-purple: #7c3aed;
            --q-purple-light: #ede9fe;
            --q-surface: #ffffff;
            --q-bg: #f4f6fb;
            --q-border: #e2e8f0;
            --q-text: #0f172a;
            --q-text-muted: #64748b;
            --q-shadow-sm: 0 1px 3px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.04);
            --q-shadow: 0 4px 16px rgba(15,23,42,.08);
            --q-shadow-lg: 0 10px 30px rgba(15,23,42,.12);
            --q-radius-sm: 8px;
            --q-radius: 12px;
            --q-radius-lg: 16px;
            --q-transition: all .2s cubic-bezier(.4,0,.2,1);
        }

        body {
            font-family: 'Cairo', sans-serif !important;
            background: var(--q-bg);
            color: var(--q-text);
            direction: rtl;
        }

        .qdrat-page {
            max-width: 1180px;
            margin: 0 auto;
            padding: 24px 12px 40px;
        }

        .qpage-header {
            background: linear-gradient(135deg, var(--q-success) 0%, var(--q-primary-dark) 100%);
            border-radius: var(--q-radius-lg);
            padding: 22px 28px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            box-shadow: 0 8px 24px rgba(5,150,105,.24);
            position: relative;
            overflow: hidden;
        }

            .qpage-header::before {
                content: '';
                position: absolute;
                left: -60px;
                top: -60px;
                width: 200px;
                height: 200px;
                background: rgba(255,255,255,.07);
                border-radius: 50%;
            }

            .qpage-header::after {
                content: '';
                position: absolute;
                right: 55px;
                bottom: -90px;
                width: 180px;
                height: 180px;
                background: rgba(255,255,255,.05);
                border-radius: 50%;
            }

        .qpage-header-content,
        .qpage-header-actions {
            position: relative;
            z-index: 1;
        }

        .qpage-title {
            color: #fff;
            font-size: 23px;
            font-weight: 900;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: rgba(255,255,255,.18);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .qpage-subtitle {
            color: rgba(255,255,255,.86);
            margin: 8px 56px 0 0;
            font-size: 13px;
            line-height: 1.8;
        }

        .btn-back {
            background: rgba(255,255,255,.15);
            border: 1.5px solid rgba(255,255,255,.32);
            color: #fff;
            border-radius: var(--q-radius-sm);
            padding: 9px 18px;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: var(--q-transition);
            white-space: nowrap;
        }

            .btn-back:hover {
                color: #fff;
                background: rgba(255,255,255,.27);
                transform: translateX(2px);
            }

        .q-alert-warning {
            background: var(--q-warning-light);
            border: 1px solid rgba(217,119,6,.24);
            border-radius: var(--q-radius);
            color: #92400e;
            padding: 14px 18px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 20px;
            box-shadow: var(--q-shadow-sm);
            font-size: 14px;
            line-height: 1.8;
        }

        .qsection {
            background: var(--q-surface);
            border-radius: var(--q-radius);
            margin-bottom: 20px;
            box-shadow: var(--q-shadow-sm);
            border: 1px solid var(--q-border);
            overflow: hidden;
            transition: var(--q-transition);
        }

            .qsection:focus-within {
                border-color: var(--q-primary);
                box-shadow: 0 0 0 3px rgba(26,86,219,.08), var(--q-shadow);
            }

        .qsection-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 15px 20px;
            border-bottom: 1px solid var(--q-border);
            background: #fafbfd;
        }

        .qsection-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 16px;
            font-weight: 800;
            margin: 0;
            color: var(--q-text);
        }

        .section-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }

        .icon-blue {
            background: var(--q-primary-light);
            color: var(--q-primary);
        }

        .icon-green {
            background: var(--q-success-light);
            color: var(--q-success);
        }

        .icon-purple {
            background: var(--q-purple-light);
            color: var(--q-purple);
        }

        .icon-amber {
            background: var(--q-warning-light);
            color: var(--q-warning);
        }

        .qsection-body {
            padding: 22px;
        }

        .q-help-text {
            color: var(--q-text-muted);
            font-size: 13px;
            line-height: 1.8;
            margin-top: 7px;
        }

        .form-label {
            color: var(--q-text);
            font-weight: 800;
            font-size: 13px;
            margin-bottom: 8px;
        }

        .form-control,
        .form-select {
            border: 1.5px solid var(--q-border);
            border-radius: 10px;
            padding: 10px 13px;
            color: var(--q-text);
            font-size: 14px;
            transition: var(--q-transition);
            background-color: #fff;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: var(--q-primary);
                box-shadow: 0 0 0 3px rgba(26,86,219,.10);
            }

        .q-action-bar {
            background: var(--q-surface);
            border: 1px solid var(--q-border);
            border-radius: var(--q-radius);
            box-shadow: var(--q-shadow-sm);
            padding: 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn-q-primary,
        .btn-q-secondary {
            border: 0;
            border-radius: 10px;
            padding: 11px 22px;
            font-weight: 800;
            font-size: 14px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: var(--q-transition);
            min-height: 44px;
        }

        .btn-q-primary {
            background: linear-gradient(135deg, var(--q-success) 0%, var(--q-success-dark) 100%);
            color: #fff;
            box-shadow: 0 8px 18px rgba(5,150,105,.24);
        }

            .btn-q-primary:hover {
                color: #fff;
                transform: translateY(-1px);
                box-shadow: 0 12px 24px rgba(5,150,105,.30);
            }

        .btn-q-secondary {
            background: #fff;
            border: 1.5px solid var(--q-border);
            color: var(--q-text-muted);
        }

            .btn-q-secondary:hover {
                background: #f8fafc;
                color: var(--q-primary);
                border-color: var(--q-primary-light);
            }

        .q-note-card {
            background: linear-gradient(135deg, #f8fafc 0%, #eef6ff 100%);
            border: 1px dashed rgba(26,86,219,.32);
            border-radius: var(--q-radius);
            padding: 16px;
            color: var(--q-text-muted);
            font-size: 13px;
            line-height: 1.8;
            height: 100%;
        }

        @@media (max-width: 768px) {
            .qpage-header {
                flex-direction: column;
                align-items: stretch;
                padding: 18px;
            }

            .qpage-title {
                font-size: 19px;
            }

            .qpage-subtitle {
                margin-right: 0;
            }

            .q-action-bar {
                flex-direction: column;
                align-items: stretch;
            }

            .btn-q-primary,
            .btn-q-secondary,
            .btn-back {
                width: 100%;
            }
        }
    </style>
}

<div class="qdrat-page" dir="rtl">
    <div class="qpage-header">
        <div class="qpage-header-content">
            <h1 class="qpage-title">
                <span class="header-icon">➕</span>
                إضافة مهارة تعزيزية يدويًا
            </h1>
            <p class="qpage-subtitle">
                إنشاء مجموعة تعزيزية استثنائية مرتبطة بدفعة ومحاضرة، مع ضبط عدد الأسئلة المستهدفة لكل طالب.
            </p>
        </div>
        <div class="qpage-header-actions">
            <a asp-action="EnhancementIndex" class="btn-back">↩️ رجوع</a>
        </div>
    </div>

    <div class="q-alert-warning">
        <span>⚠️</span>
        <div>
            <strong>تنبيه تشغيلي:</strong>
            الاستخدام الأساسي هو التوليد التلقائي مع تسجيل المؤشرات. هذا الخيار يدوي ومخصص للحالات الاستثنائية فقط.
        </div>
    </div>

    <form asp-action="CreateEnhancementSet" method="post" autocomplete="off">
        @Html.AntiForgeryToken()

        <div class="qsection">
            <div class="qsection-header">
                <h2 class="qsection-title">
                    <span class="section-icon icon-blue">📝</span>
                    بيانات المهارة الأساسية
                </h2>
            </div>
            <div class="qsection-body">
                <div class="row g-4">
                    <div class="col-lg-8">
                        <label asp-for="Title" class="form-label">العنوان (اختياري)</label>
                        <input asp-for="Title" class="form-control" placeholder="مثال: تدريب إضافي على مؤشرات المحاضرة" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="col-lg-4">
                        <div class="q-note-card">
                            يتم استخدام العنوان فقط لتسهيل التمييز داخل الإدارة. إذا تُرك فارغًا سيتم الاعتماد على العنوان الافتراضي الموجود في منطق الحفظ الحالي.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="qsection">
            <div class="qsection-header">
                <h2 class="qsection-title">
                    <span class="section-icon icon-green">🎯</span>
                    نطاق الإرسال
                </h2>
            </div>
            <div class="qsection-body">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="BatchId" class="form-label">اختر الدفعة</label>
                        <select asp-for="BatchId" asp-items="Model.Batches" class="form-select" id="batchSelect">
                            <option value="">-- اختر الدفعة --</option>
                        </select>
                        <span asp-validation-for="BatchId" class="text-danger small"></span>
                        <div class="q-help-text">بعد اختيار الدفعة سيتم تحديث قائمة المحاضرات المرتبطة بها.</div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LectureId" class="form-label">اختر المحاضرة</label>
                        <select asp-for="LectureId" asp-items="Model.Lectures" class="form-select" id="lectureSelect">
                            <option value="">-- اختر المحاضرة --</option>
                        </select>
                        <span asp-validation-for="LectureId" class="text-danger small"></span>
                        <div class="q-help-text">اختيار المحاضرة يحافظ على ربط المهارة بسياقها التعليمي الصحيح.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="qsection">
            <div class="qsection-header">
                <h2 class="qsection-title">
                    <span class="section-icon icon-purple">🔢</span>
                    إعدادات الأسئلة
                </h2>
            </div>
            <div class="qsection-body">
                <div class="row g-4 align-items-start">
                    <div class="col-md-5">
                        <label asp-for="QuestionsPerStudent" class="form-label">عدد الأسئلة (اختياري)</label>
                        <input asp-for="QuestionsPerStudent" type="number" class="form-control" placeholder="مثال: 10" min="1" max="100" />
                        <span asp-validation-for="QuestionsPerStudent" class="text-danger small"></span>
                        <div class="q-help-text">إذا تركت هذا الحقل فارغًا سيتم اعتماد 25 سؤال تلقائيًا.</div>
                    </div>

                    <div class="col-md-7">
                        <div class="q-note-card">
                            لا يتم هنا تغيير منطق التوليد أو اختيار الأسئلة. الصفحة فقط تنظّم الإدخال بصريًا وتحافظ على نفس أسماء الحقول ونفس Action الحالي.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="q-action-bar">
            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn-q-primary">✅ إنشاء المهارة</button>
                <a asp-action="EnhancementIndex" class="btn-q-secondary">↩️ رجوع</a>
            </div>
            <div class="text-muted small">تأكد من اختيار الدفعة والمحاضرة قبل الإرسال.</div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.documentElement.setAttribute('dir', 'rtl');

        $(document).ready(function () {
            $('#batchSelect').change(function () {
                var batchId = $(this).val();
                var lectureSelect = $('#lectureSelect');

                lectureSelect.empty();
                lectureSelect.append('<option value="">-- اختر المحاضرة --</option>');

                if (!batchId) {
                    return;
                }

                $.getJSON('/Admin/AdminLessonCompletions/GetLecturesByBatch?batchId=' + batchId, function (data) {
                    $.each(data, function (i, lecture) {
                        lectureSelect.append('<option value="' + lecture.id + '">' + lecture.title + ' - ' + lecture.date + '</option>');
                    });
                });
            });
        });
    </script>
}
