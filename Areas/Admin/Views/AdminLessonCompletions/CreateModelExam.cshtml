@model QdratNew.ViewModels.Exam.CreateModelExamViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "إنشاء اختبار من نموذج احترافي";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        :root {
            --q-primary: #1a56db;
            --q-primary-dark: #1240a8;
            --q-primary-light: #e8f0fe;
            --q-success: #059669;
            --q-success-light: #d1fae5;
            --q-warning: #d97706;
            --q-warning-light: #fef3c7;
            --q-danger: #dc2626;
            --q-danger-light: #fee2e2;
            --q-purple: #7c3aed;
            --q-purple-light: #ede9fe;
            --q-surface: #ffffff;
            --q-bg: #f4f6fb;
            --q-border: #e2e8f0;
            --q-text: #0f172a;
            --q-text-muted: #64748b;
            --q-shadow-sm: 0 1px 3px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.04);
            --q-shadow: 0 4px 16px rgba(15,23,42,.08);
            --q-shadow-lg: 0 10px 30px rgba(15,23,42,.12);
            --q-radius-sm: 8px;
            --q-radius: 12px;
            --q-radius-lg: 16px;
            --q-transition: all .2s cubic-bezier(.4,0,.2,1);
        }

        body {
            font-family: 'Cairo', sans-serif !important;
            background: var(--q-bg);
            color: var(--q-text);
            direction: rtl;
        }

        .qdrat-page {
            max-width: 1180px;
            margin: 0 auto;
            padding: 24px 12px 44px;
        }

        .qpage-header {
            background: linear-gradient(135deg, var(--q-purple) 0%, var(--q-primary-dark) 100%);
            border-radius: var(--q-radius-lg);
            padding: 22px 28px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            box-shadow: 0 8px 24px rgba(124,58,237,.24);
            position: relative;
            overflow: hidden;
        }

            .qpage-header::before {
                content: '';
                position: absolute;
                left: -60px;
                top: -60px;
                width: 200px;
                height: 200px;
                background: rgba(255,255,255,.07);
                border-radius: 50%;
            }

            .qpage-header::after {
                content: '';
                position: absolute;
                right: 55px;
                bottom: -90px;
                width: 180px;
                height: 180px;
                background: rgba(255,255,255,.05);
                border-radius: 50%;
            }

        .qpage-header-content,
        .qpage-header-actions {
            position: relative;
            z-index: 1;
        }

        .qpage-title {
            color: #fff;
            font-size: 23px;
            font-weight: 900;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: rgba(255,255,255,.18);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .qpage-subtitle {
            color: rgba(255,255,255,.86);
            margin: 8px 56px 0 0;
            font-size: 13px;
            line-height: 1.8;
        }

        .btn-back {
            background: rgba(255,255,255,.15);
            border: 1.5px solid rgba(255,255,255,.32);
            color: #fff;
            border-radius: var(--q-radius-sm);
            padding: 9px 18px;
            font-size: 14px;
            font-weight: 800;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: var(--q-transition);
            white-space: nowrap;
        }

            .btn-back:hover {
                color: #fff;
                background: rgba(255,255,255,.27);
                transform: translateX(2px);
            }

        .progress-stepper {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
            margin-bottom: 22px;
            background: var(--q-surface);
            border-radius: var(--q-radius);
            padding: 8px;
            box-shadow: var(--q-shadow-sm);
            border: 1px solid var(--q-border);
        }

        .step-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 12px;
            border-radius: var(--q-radius-sm);
            background: #fff;
            border: 1px solid transparent;
        }

            .step-item.active {
                background: var(--q-primary);
                color: #fff;
            }

        .step-num {
            width: 25px;
            height: 25px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 900;
            background: var(--q-border);
            color: var(--q-text-muted);
            flex-shrink: 0;
        }

        .step-item.active .step-num {
            background: rgba(255,255,255,.25);
            color: #fff;
        }

        .step-label {
            font-size: 13px;
            font-weight: 800;
            color: var(--q-text-muted);
            white-space: nowrap;
        }

        .step-item.active .step-label {
            color: #fff;
        }

        .qsection {
            background: var(--q-surface);
            border-radius: var(--q-radius);
            margin-bottom: 20px;
            box-shadow: var(--q-shadow-sm);
            border: 1px solid var(--q-border);
            overflow: hidden;
            transition: var(--q-transition);
        }

            .qsection:focus-within {
                border-color: var(--q-primary);
                box-shadow: 0 0 0 3px rgba(26,86,219,.08), var(--q-shadow);
            }

        .qsection-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 15px 20px;
            border-bottom: 1px solid var(--q-border);
            background: #fafbfd;
        }

        .qsection-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 16px;
            font-weight: 900;
            margin: 0;
            color: var(--q-text);
        }

        .section-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }

        .icon-blue {
            background: var(--q-primary-light);
            color: var(--q-primary);
        }

        .icon-green {
            background: var(--q-success-light);
            color: var(--q-success);
        }

        .icon-purple {
            background: var(--q-purple-light);
            color: var(--q-purple);
        }

        .icon-amber {
            background: var(--q-warning-light);
            color: var(--q-warning);
        }

        .qsection-body {
            padding: 22px;
        }

        .q-field-label {
            color: var(--q-text);
            font-size: 14px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .form-control,
        .form-select {
            border: 1.5px solid var(--q-border);
            border-radius: var(--q-radius-sm);
            padding: 10px 13px;
            font-size: 14px;
            min-height: 45px;
            color: var(--q-text);
            box-shadow: none !important;
            transition: var(--q-transition);
        }

            .form-control:focus,
            .form-select:focus {
                border-color: var(--q-primary);
                box-shadow: 0 0 0 3px rgba(26,86,219,.10) !important;
            }

        .q-help-text {
            color: var(--q-text-muted);
            font-size: 13px;
            line-height: 1.8;
            margin-top: 7px;
        }

        .q-multi-select {
            min-height: 132px;
            padding: 10px;
        }

        .send-mode-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
        }

        .send-mode-card {
            position: relative;
            border: 1.5px solid var(--q-border);
            border-radius: var(--q-radius);
            background: #fff;
            padding: 16px 16px 16px 48px;
            cursor: pointer;
            transition: var(--q-transition);
            min-height: 92px;
        }

            .send-mode-card:hover {
                border-color: var(--q-primary);
                box-shadow: var(--q-shadow-sm);
                transform: translateY(-1px);
            }

            .send-mode-card .form-check-input {
                position: absolute;
                left: 16px;
                top: 20px;
                margin: 0;
            }

        .send-mode-title {
            display: block;
            color: var(--q-text);
            font-size: 15px;
            font-weight: 900;
            margin-bottom: 6px;
        }

        .send-mode-hint {
            display: block;
            color: var(--q-text-muted);
            font-size: 13px;
            line-height: 1.7;
        }

        .q-inline-alert {
            background: var(--q-warning-light);
            border: 1px solid rgba(217,119,6,.22);
            color: #92400e;
            border-radius: var(--q-radius);
            padding: 13px 16px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            font-size: 13px;
            line-height: 1.8;
        }

        .q-actions {
            background: var(--q-surface);
            border-radius: var(--q-radius);
            border: 1px solid var(--q-border);
            box-shadow: var(--q-shadow-sm);
            padding: 18px 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn-q-primary,
        .btn-q-secondary,
        .btn-q-outline {
            border-radius: var(--q-radius-sm);
            padding: 11px 22px;
            font-size: 14px;
            font-weight: 900;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-decoration: none;
            transition: var(--q-transition);
            border: 0;
        }

        .btn-q-primary {
            background: linear-gradient(135deg, var(--q-primary), var(--q-primary-dark));
            color: #fff;
            box-shadow: 0 6px 16px rgba(26,86,219,.24);
        }

            .btn-q-primary:hover {
                color: #fff;
                transform: translateY(-1px);
                box-shadow: 0 9px 20px rgba(26,86,219,.3);
            }

        .btn-q-secondary {
            background: var(--q-success);
            color: #fff;
            box-shadow: 0 6px 16px rgba(5,150,105,.22);
        }

            .btn-q-secondary:hover {
                color: #fff;
                background: #047857;
                transform: translateY(-1px);
            }

        .btn-q-outline {
            background: #fff;
            color: var(--q-text-muted);
            border: 1.5px solid var(--q-border);
        }

            .btn-q-outline:hover {
                color: var(--q-primary);
                border-color: var(--q-primary);
                background: var(--q-primary-light);
            }

        .text-danger {
            font-size: 12px;
            font-weight: 700;
            margin-top: 6px;
            display: block;
        }

        @@media (max-width: 768px) {
            .qdrat-page {
                padding: 16px 10px 32px;
            }

            .qpage-header {
                flex-direction: column;
                align-items: stretch;
                padding: 20px;
            }

            .qpage-title {
                font-size: 20px;
            }

            .qpage-subtitle {
                margin-right: 0;
            }

            .progress-stepper {
                grid-template-columns: 1fr 1fr;
            }

            .send-mode-grid {
                grid-template-columns: 1fr;
            }

            .qactions-left,
            .qactions-right {
                width: 100%;
            }

            .btn-q-primary,
            .btn-q-outline,
            .btn-q-secondary {
                width: 100%;
            }
        }
    </style>
}

<div class="qdrat-page" dir="rtl">
    <div class="qpage-header">
        <div class="qpage-header-content">
            <h1 class="qpage-title">
                <span class="header-icon">🧩</span>
                إنشاء اختبار من نموذج احترافي
            </h1>
            <p class="qpage-subtitle">
                اختر النموذج والدفعات، ثم حدد طريقة الإرسال وفترة إتاحة الاختبار للطلاب.
            </p>
        </div>
        <div class="qpage-header-actions">
            <a asp-action="ModelAssignments" class="btn-back">↩ رجوع</a>
        </div>
    </div>

    <div class="progress-stepper" aria-label="خطوات إنشاء الاختبار من نموذج احترافي">
        <div class="step-item active"><span class="step-num">1</span><span class="step-label">اختيار النموذج</span></div>
        <div class="step-item active"><span class="step-num">2</span><span class="step-label">تحديد الدفعات</span></div>
        <div class="step-item active"><span class="step-num">3</span><span class="step-label">طريقة الإرسال</span></div>
        <div class="step-item active"><span class="step-num">4</span><span class="step-label">التوقيت والإرسال</span></div>
    </div>

    <form asp-action="CreateModelExam" method="post" id="createModelExamForm" novalidate>
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="qsection">
            <div class="qsection-header">
                <h2 class="qsection-title">
                    <span class="section-icon icon-purple">🧠</span>
                    بيانات النموذج والاختبار
                </h2>
            </div>
            <div class="qsection-body">
                <div class="row g-3">
                    <div class="col-lg-5 col-md-6">
                        <label class="q-field-label">المنهج (للتصفية)</label>
                        <select id="CurriculumFilter" asp-for="CurriculumId" asp-items="Model.Curriculums" class="form-select">
                        </select>
                    </div>

                    <div class="col-lg-5 col-md-6">
                        <label asp-for="ModelId" class="q-field-label">النموذج الاحترافي (اختبارات)</label>
                        <select asp-for="ModelId" id="ModelIdSelect" class="form-select" asp-items="Model.Models">
                        </select>
                        <span asp-validation-for="ModelId" class="text-danger"></span>
                        <div id="models-loading" style="display:none;margin-top:6px;font-size:13px;color:#64748b">
                            <i class="fa fa-spinner fa-spin"></i> جاري تحميل النماذج...
                        </div>
                    </div>

                    <div class="col-lg-7 col-md-6">
                        <label asp-for="Title" class="q-field-label">عنوان الاختبار (اختياري)</label>
                        <input asp-for="Title" class="form-control" placeholder="مثلاً: اختبار المنهج التجريبي الأول" />
                        <div class="q-help-text">إذا تركته فارغًا، سيتم توليد عنوان تلقائي من اسم النموذج.</div>
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qsection">
            <div class="qsection-header">
                <h2 class="qsection-title">
                    <span class="section-icon icon-blue">👥</span>
                    الدفعات والطلاب المستهدفون
                </h2>
            </div>
            <div class="qsection-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="q-field-label">اختر الدفعات</label>
                        <select asp-for="SelectedBatchIds" class="form-select q-multi-select" multiple asp-items="Model.Batches" id="batchesSelect"></select>
                        <div class="q-help-text">يمكنك اختيار أكثر من دفعة بالضغط على Ctrl أو ⌘.</div>
                        <span asp-validation-for="SelectedBatchIds" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4">
                    <label class="q-field-label">طريقة الإرسال</label>
                    <div class="send-mode-grid">
                        <label class="send-mode-card" for="sendToBatchTrue">
                            <input class="form-check-input" type="radio" asp-for="SendToBatch" value="true" id="sendToBatchTrue" checked>
                            <span class="send-mode-title">📦 إرسال إلى جميع طلاب الدفعة</span>
                            <span class="send-mode-hint">سيتم إتاحة الاختبار لجميع الطلاب داخل الدفعات المختارة.</span>
                        </label>

                        <label class="send-mode-card" for="sendToBatchFalse">
                            <input class="form-check-input" type="radio" asp-for="SendToBatch" value="false" id="sendToBatchFalse">
                            <span class="send-mode-title">👥 إرسال إلى طلاب محددين فقط</span>
                            <span class="send-mode-hint">اختر طلابًا بعينهم من الدفعات المحددة قبل إنشاء الاختبار.</span>
                        </label>
                    </div>
                </div>

                <div id="load-students-area" class="mt-4" style="display:none;">
                    <div class="q-inline-alert mb-3">
                        <span>ℹ️</span>
                        <span>اختر الدفعات أولًا، ثم اضغط تحميل الطلاب لعرض الطلاب المتاحين داخل هذه الدفعات.</span>
                    </div>

                    <button type="button" id="btnLoadStudents" class="btn-q-secondary mb-3">
                        📋 تحميل الطلاب من الدفعات المختارة
                    </button>

                    <div id="students-section" style="display:none;">
                        <label class="q-field-label">اختر الطلاب</label>
                        <select asp-for="SelectedStudentIds" class="form-select q-multi-select" multiple id="studentsSelect"></select>
                        <div class="q-help-text">يمكنك اختيار أكثر من طالب.</div>
                        <span asp-validation-for="SelectedStudentIds" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qsection">
            <div class="qsection-header">
                <h2 class="qsection-title">
                    <span class="section-icon icon-amber">⏱️</span>
                    التوقيت وإعدادات التشغيل
                </h2>
            </div>
            <div class="qsection-body">
                <div class="row g-3">
                    <div class="col-lg-4 col-md-6">
                        <label asp-for="StartAt" class="q-field-label">يبدأ في</label>
                        <input asp-for="StartAt" class="form-control" type="datetime-local" />
                        <span asp-validation-for="StartAt" class="text-danger"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label asp-for="EndAt" class="q-field-label">ينتهي في</label>
                        <input asp-for="EndAt" class="form-control" type="datetime-local" />
                        <span asp-validation-for="EndAt" class="text-danger"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label asp-for="DurationMinutes" class="q-field-label">مدة الاختبار (بالدقائق)</label>
                        <input asp-for="DurationMinutes" class="form-control" type="number" value="30" min="5" step="5" />
                        <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" asp-for="IsInLab" />
                            <label class="form-check-label fw-bold" asp-for="IsInLab">
                                الاختبار حضوري (يتطلب رقم مرجعي)
                            </label>
                            <div class="q-help-text">عند تفعيل الاختبار الحضوري يتم التعامل معه كاختبار داخل المعمل حسب منطق الكنترولر الحالي.</div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" asp-for="RandomizeQuestions" />
                            <label class="form-check-label fw-bold" asp-for="RandomizeQuestions">
                                ترتيب عشوائي للأسئلة لكل طالب
                            </label>
                            <div class="q-help-text">عند التفعيل تظهر الأسئلة لكل طالب بترتيب مختلف لمكافحة الغش. عطّله إذا كانت الأسئلة يجب أن تظهر بترتيب محدد (مثلاً: أسئلة متسلسلة أو سيناريو متدرج).</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="q-actions">
            <div class="qactions-right">
                <button type="submit" class="btn-q-primary">
                    🚀 إنشاء وإرسال الاختبار
                </button>
            </div>
            <div class="qactions-left">
                <a asp-action="ModelAssignments" class="btn-q-outline">↩ رجوع</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const radioBatch = document.querySelector("input[value='true'][name='SendToBatch']");
            const radioStudents = document.querySelector("input[value='false'][name='SendToBatch']");
            const loadStudentsArea = document.getElementById("load-students-area");
            const studentsSection = document.getElementById("students-section");
            const btnLoad = document.getElementById("btnLoadStudents");
            const batchesSelect = document.getElementById("batchesSelect");
            const studentsSelect = document.getElementById("studentsSelect");

            function toggleMode() {
                if (radioStudents && radioStudents.checked) {
                    loadStudentsArea.style.display = "block";
                } else {
                    loadStudentsArea.style.display = "none";
                    studentsSection.style.display = "none";
                    studentsSelect.innerHTML = "";
                }
            }

            if (radioBatch) {
                radioBatch.addEventListener("change", toggleMode);
            }

            if (radioStudents) {
                radioStudents.addEventListener("change", toggleMode);
            }

            toggleMode();

            if (btnLoad) {
                btnLoad.addEventListener("click", async function () {
                    const selectedBatches = Array.from(batchesSelect.selectedOptions).map(o => o.value);
                    if (selectedBatches.length === 0) {
                        alert("⚠️ الرجاء اختيار دفعة واحدة على الأقل أولاً.");
                        return;
                    }

                    const response = await fetch(`/Admin/AdminLessonCompletions/LoadStudentsByBatches?batchIds=${selectedBatches.join(',')}`);
                    const data = await response.json();

                    if (data.success) {
                        studentsSection.style.display = "block";
                        studentsSelect.innerHTML = "";
                        data.students.forEach(s => {
                            const opt = document.createElement("option");
                            opt.value = s.id;
                            opt.textContent = `${s.name} - (${s.batch})`;
                            studentsSelect.appendChild(opt);
                        });
                    } else {
                        alert(data.message || "حدث خطأ أثناء تحميل الطلاب.");
                    }
                });
            }
        });
    </script>

    <script>
    // ── Curriculum → Models cascade (Exam) ───────────────────
    (function () {
        var curriculumSelect = document.getElementById('CurriculumFilter');
        var modelSelect      = document.getElementById('ModelIdSelect');
        var loadingEl        = document.getElementById('models-loading');

        if (!curriculumSelect || !modelSelect) return;

        curriculumSelect.addEventListener('change', function () {
            var curriculumId = this.value;
            loadingEl.style.display = 'block';
            modelSelect.disabled = true;

            fetch('/Admin/AdminLessonCompletions/GetModelsByCurriculum?curriculumId='
                  + encodeURIComponent(curriculumId)
                  + '&modelType=exam')
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    modelSelect.innerHTML = '';
                    data.forEach(function (item) {
                        var opt = document.createElement('option');
                        opt.value = item.value;
                        opt.textContent = item.text;
                        modelSelect.appendChild(opt);
                    });
                })
                .catch(function () {
                    modelSelect.innerHTML = '<option value="">⚠️ حدث خطأ في التحميل</option>';
                })
                .finally(function () {
                    loadingEl.style.display = 'none';
                    modelSelect.disabled = false;
                });
        });
    })();
    </script>
}
