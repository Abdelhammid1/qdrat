@model QdratNew.Entities.EnhancementSkillSet

@{
    ViewData["Title"] = $"📘 تفاصيل المهارات  التعزيزية - {Model.Title}";
}

<div class="container mt-4">
    <!-- ✅ العنوان -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">@ViewData["Title"]</h2>
        <a asp-action="EnhancementIndex" class="btn btn-outline-secondary">
            🔙 رجوع للقائمة
        </a>
    </div>

    <!-- ✅ معلومات أساسية -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">📖 المحاضرة</h6>
                    <h5 class="fw-bold">@Model.Lecture?.Title</h5>
                    <span class="badge bg-primary">ID: @Model.LectureId</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">🎓 الدفعة</h6>
                    <h5 class="fw-bold">@Model.Batch?.Name</h5>
                    <span class="badge bg-info">ID: @Model.BatchId</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">📅 تاريخ الإنشاء</h6>
                    <h5 class="fw-bold">@Model.CreatedAt.ToString("yyyy-MM-dd")</h5>
                    <span class="text-muted">@Model.CreatedAt.ToString("HH:mm")</span>
                </div>
            </div>
        </div>
    </div>

    <hr />

    <!-- ✅ حالة الجلسة -->
    @if (ViewBag.CanSend == true)
    {
        <div class="alert alert-warning shadow-sm">
            ⏳ هذه الجلسة لم يتم إرسالها بعد
        </div>

        <form asp-action="SendEnhancementSkills" method="post" class="card p-4 shadow-sm border-0 mb-4">
            <input type="hidden" name="setId" value="@Model.Id" />
            <div class="mb-3">
                <label class="form-label fw-bold">عدد الأسئلة لكل طالب</label>
                <input type="number" name="questionsPerStudent" value="25" min="1" class="form-control w-25" required />
            </div>
            <button type="submit" class="btn btn-success">
                🚀 إرسال التدريب الآن
            </button>
        </form>
    }
    else
    {
        <div class="alert alert-success shadow-sm">
            ✅ تم إرسال التدريب للطلاب
        </div>

        <!-- ✅ جدول الطلاب -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white fw-bold">
                👥 قائمة الطلاب
            </div>
            <div class="card-body p-0">
                <table class="table table-hover table-striped text-center align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>👨‍🎓 الطالب</th>
                            <th>📊 عدد الأسئلة</th>
                            <th>✔️ الإجابات الصحيحة</th>
                            <th>⚙️ الإدارة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in Model.Assignments.GroupBy(a => a.Student))
                        {
                            var total = group.Count();
                            var correct = group.Count(a => a.IsCorrect == true);

                            <tr>
                                <td>@group.Key.FullName</td>
                                <td><span class="badge bg-info">@total</span></td>
                                <td>
                                    <span class="badge @(correct == total ? "bg-success" : "bg-danger")">
                                        @correct
                                    </span>
                                </td>
                                <td>
                                    <!-- إعادة إرسال -->
                                    <form asp-action="ResendToStudent" method="post" class="d-flex justify-content-center align-items-center gap-2">
                                        <input type="hidden" name="setId" value="@Model.Id" />
                                        <input type="hidden" name="studentId" value="@group.Key.StudentID" />
                                        <input type="number" name="questionsCount" value="@total" min="1"
                                               class="form-control form-control-sm w-25" />
                                        <button type="submit" class="btn btn-sm btn-outline-warning">
                                            🔄 إعادة إرسال
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
