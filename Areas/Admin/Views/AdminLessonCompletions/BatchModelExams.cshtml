@model IEnumerable<QdratNew.ViewModels.Homework.ModelAssignmentViewModel>
@using QdratNew.Enums

@{
    ViewData["Title"] = "اختبارات الدفعة";
    var items = (Model ?? Enumerable.Empty<QdratNew.ViewModels.Homework.ModelAssignmentViewModel>()).ToList();
    var batchName = ViewBag.BatchName as string ?? "الدفعة";
}

@section Styles {
    <style>
        .batch-model-page {
            direction: rtl;
            padding: 24px;
            color: #1f2937;
        }

        .batch-model-hero,
        .batch-toolbar,
        .batch-item {
            background: #fff;
            border: 1px solid #e5e7eb;
            box-shadow: 0 10px 24px rgba(15,23,42,.06);
        }

        .batch-model-hero {
            border-radius: 14px;
            padding: 18px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            flex-wrap: wrap;
            margin-bottom: 18px;
        }

        .batch-model-title {
            font-size: 22px;
            font-weight: 900;
            margin: 0 0 4px;
            color: #0f172a;
        }

        .batch-model-sub {
            color: #64748b;
            font-size: 14px;
        }

        .batch-back-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #6d28d9;
            border: 1px solid #ddd6fe;
            background: #f5f3ff;
            border-radius: 10px;
            padding: 9px 14px;
            font-weight: 800;
            text-decoration: none;
        }

        .batch-back-btn:hover {
            color: #fff;
            background: #6d28d9;
        }

        .batch-toolbar {
            border-radius: 12px;
            padding: 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 16px;
        }

        .batch-search {
            position: relative;
            flex: 1;
            min-width: 220px;
        }

        .batch-search i {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
        }

        .batch-search input {
            width: 100%;
            border: 1px solid #dbe3ef;
            border-radius: 10px;
            padding: 9px 38px 9px 12px;
            outline: none;
        }

        .batch-count {
            color: #64748b;
            font-weight: 700;
            white-space: nowrap;
        }

        .batch-items {
            display: grid;
            gap: 12px;
        }

        .batch-item {
            border-radius: 12px;
            padding: 14px;
            display: grid;
            grid-template-columns: minmax(220px, 1fr) auto auto;
            gap: 14px;
            align-items: center;
        }

        .item-title {
            font-weight: 900;
            color: #111827;
            margin-bottom: 4px;
        }

        .item-date {
            color: #64748b;
            font-size: 13px;
        }

        .item-stats,
        .item-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .item-actions {
            justify-content: flex-end;
        }

        .item-stat {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 999px;
            padding: 6px 10px;
            color: #475569;
            font-weight: 700;
            font-size: 13px;
        }

        .act-btn {
            border: 0;
            border-radius: 9px;
            padding: 8px 10px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #fff;
            font-weight: 800;
            text-decoration: none;
            cursor: pointer;
            font-size: 13px;
        }

        .act-view { background: #2563eb; }
        .act-edit { background: #7c3aed; }
        .act-archive { background: #b45309; }
        .act-delete { background: #dc2626; }

        .empty-state {
            background: #fff;
            border: 1px dashed #cbd5e1;
            border-radius: 12px;
            padding: 48px 16px;
            text-align: center;
            color: #64748b;
        }

        .empty-state i {
            display: block;
            font-size: 30px;
            margin-bottom: 10px;
        }

        @@media (max-width: 992px) {
            .batch-item {
                grid-template-columns: 1fr;
            }

            .item-actions {
                justify-content: flex-start;
            }
        }

        @@media (max-width: 576px) {
            .batch-model-page {
                padding: 14px;
            }

            .batch-toolbar {
                align-items: stretch;
                flex-direction: column;
            }
        }
    </style>
}

<div class="batch-model-page">
    <div class="batch-model-hero">
        <div>
            <h1 class="batch-model-title">اختبارات دفعة @batchName</h1>
            <div class="batch-model-sub">الاختبارات مرتبة من الأحدث إلى الأقدم داخل الدفعة.</div>
        </div>

        <a asp-area="Admin" asp-controller="AdminLessonCompletions" asp-action="ModelAssignments" class="batch-back-btn">
            <i class="fas fa-arrow-right"></i>
            رجوع للدفعات
        </a>
    </div>

    <div class="batch-toolbar">
        <div class="batch-search">
            <i class="fas fa-search"></i>
            <input type="text" id="batchItemsSearch" placeholder="ابحث في اختبارات الدفعة..." />
        </div>
        <div class="batch-count">إجمالي: <strong>@items.Count</strong> اختبار</div>
    </div>

    @if (!items.Any())
    {
        <div class="empty-state">
            <i class="fas fa-inbox"></i>
            لا توجد اختبارات نموذجية لهذه الدفعة
        </div>
    }
    else
    {
        <div class="batch-items" id="batchItemsList">
            @foreach (var item in items)
            {
                <article class="batch-item" data-search="@($"{item.Title} {item.BatchName}".ToLower())">
                    <div>
                        <div class="item-title">@item.Title</div>
                        <div class="item-date">@item.CreatedAt.ToString("yyyy/MM/dd HH:mm")</div>
                    </div>

                    <div class="item-stats">
                        <span class="item-stat"><i class="fas fa-user-graduate"></i>@item.StudentCount طالب</span>
                        <span class="item-stat"><i class="fas fa-question-circle"></i>@item.QuestionCount سؤال</span>
                        @if (item.BlockedStudentsCount > 0)
                        {
                            <a asp-area="Admin" asp-controller="IntegrityViolations" asp-action="Index"
                               asp-route-attemptType="@((int)IntegrityAttemptType.Exam)"
                               asp-route-attemptEntityId="@item.Id"
                               class="item-stat" style="background:#fdeaea;color:#dc2626;border-color:#fecaca;">
                                <i class="fas fa-triangle-exclamation"></i>@item.BlockedStudentsCount طالب موقوف
                            </a>
                        }
                    </div>

                    <div class="item-actions">
                        <a asp-area="Admin" asp-controller="ExamAssignments" asp-action="Details" asp-route-id="@item.Id" class="act-btn act-view">
                            <i class="fas fa-eye"></i>
                            تفاصيل
                        </a>

                        <a asp-area="Admin" asp-controller="AdminLessonCompletions" asp-action="EditProfessionalExam" asp-route-id="@item.Id" class="act-btn act-edit">
                            <i class="fas fa-edit"></i>
                            تعديل
                        </a>

                        <form asp-area="Admin" asp-controller="AdminLessonCompletions" asp-action="ArchiveModelExam" method="post" class="d-inline m-0" onsubmit="return confirm('هل تريد نقل هذا الاختبار إلى الأرشيف؟')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="act-btn act-archive">
                                <i class="fas fa-archive"></i>
                                أرشفة
                            </button>
                        </form>

                        <button type="button" class="act-btn act-delete" data-action="@Url.Action("DeleteModelExam", "AdminLessonCompletions", new { area = "Admin", id = item.Id })" data-bs-toggle="modal" data-bs-target="#deleteConfirmModal">
                            <i class="fas fa-trash-alt"></i>
                            حذف
                        </button>
                    </div>
                </article>
            }
        </div>
    }
</div>

<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="deleteConfirmModalLabel">تأكيد الحذف</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body text-center">
                <p class="fw-bold">هل أنت متأكد من حذف هذا الاختبار؟</p>
                <p class="text-muted mb-0">سيتم حذف البيانات المرتبطة به نهائيا إذا لم توجد محاولات.</p>
            </div>
            <div class="modal-footer justify-content-center">
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-danger px-4">تأكيد الحذف</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const search = document.getElementById('batchItemsSearch');
            if (search) {
                search.addEventListener('input', function () {
                    const term = (this.value || '').toLowerCase().trim();
                    document.querySelectorAll('#batchItemsList .batch-item').forEach(function (item) {
                        const text = (item.getAttribute('data-search') || item.textContent || '').toLowerCase();
                        item.style.display = text.includes(term) ? '' : 'none';
                    });
                });
            }

            const modal = document.getElementById('deleteConfirmModal');
            const form = document.getElementById('deleteForm');
            if (modal && form) {
                modal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    form.setAttribute('action', button.getAttribute('data-action'));
                });
            }
        });
    </script>
}
