@model QdratNew.ViewModels.Homework.CreateModelHomeworkViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "إرسال واجب من نموذج احترافي";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        :root {
            --q-primary: #1a56db;
            --q-primary-dark: #1240a8;
            --q-primary-light: #e8f0fe;
            --q-success: #059669;
            --q-success-dark: #047857;
            --q-success-light: #d1fae5;
            --q-warning: #d97706;
            --q-warning-light: #fef3c7;
            --q-danger: #dc2626;
            --q-danger-light: #fee2e2;
            --q-purple: #7c3aed;
            --q-purple-light: #ede9fe;
            --q-surface: #ffffff;
            --q-bg: #f4f6fb;
            --q-border: #e2e8f0;
            --q-text: #0f172a;
            --q-text-muted: #64748b;
            --q-shadow-sm: 0 1px 3px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.04);
            --q-shadow: 0 4px 16px rgba(15,23,42,.08);
            --q-shadow-lg: 0 10px 30px rgba(15,23,42,.12);
            --q-radius-sm: 8px;
            --q-radius: 12px;
            --q-radius-lg: 16px;
            --q-transition: all .2s cubic-bezier(.4,0,.2,1);
        }

        body {
            font-family: 'Cairo', sans-serif !important;
            background: var(--q-bg);
            color: var(--q-text);
            direction: rtl;
        }

        .qdrat-page {
            max-width: 1120px;
            margin: 0 auto;
            padding: 24px 12px 44px;
        }

        .qpage-header {
            background: linear-gradient(135deg, var(--q-success) 0%, var(--q-primary-dark) 100%);
            border-radius: var(--q-radius-lg);
            padding: 22px 28px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            box-shadow: 0 8px 24px rgba(5,150,105,.24);
            position: relative;
            overflow: hidden;
        }

            .qpage-header::before {
                content: '';
                position: absolute;
                left: -60px;
                top: -60px;
                width: 200px;
                height: 200px;
                background: rgba(255,255,255,.07);
                border-radius: 50%;
            }

            .qpage-header::after {
                content: '';
                position: absolute;
                right: 55px;
                bottom: -90px;
                width: 180px;
                height: 180px;
                background: rgba(255,255,255,.05);
                border-radius: 50%;
            }

        .qpage-header-content,
        .qpage-header-actions {
            position: relative;
            z-index: 1;
        }

        .qpage-title {
            color: #fff;
            font-size: 23px;
            font-weight: 900;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: rgba(255,255,255,.18);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .qpage-subtitle {
            color: rgba(255,255,255,.86);
            margin: 8px 56px 0 0;
            font-size: 13px;
            line-height: 1.8;
        }

        .btn-back {
            background: rgba(255,255,255,.15);
            border: 1.5px solid rgba(255,255,255,.32);
            color: #fff;
            border-radius: var(--q-radius-sm);
            padding: 9px 18px;
            font-size: 14px;
            font-weight: 800;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: var(--q-transition);
            white-space: nowrap;
        }

            .btn-back:hover {
                color: #fff;
                background: rgba(255,255,255,.27);
                transform: translateX(2px);
            }

        .progress-stepper {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
            margin-bottom: 22px;
            background: var(--q-surface);
            border-radius: var(--q-radius);
            padding: 8px;
            box-shadow: var(--q-shadow-sm);
            border: 1px solid var(--q-border);
        }

        .step-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 12px;
            border-radius: var(--q-radius-sm);
            background: #fff;
            border: 1px solid transparent;
        }

            .step-item.active {
                background: var(--q-success);
                color: #fff;
            }

        .step-num {
            width: 25px;
            height: 25px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 900;
            background: var(--q-border);
            color: var(--q-text-muted);
            flex-shrink: 0;
        }

        .step-item.active .step-num {
            background: rgba(255,255,255,.25);
            color: #fff;
        }

        .step-label {
            font-size: 13px;
            font-weight: 800;
            color: var(--q-text-muted);
            white-space: nowrap;
        }

        .step-item.active .step-label {
            color: #fff;
        }

        .qsection {
            background: var(--q-surface);
            border-radius: var(--q-radius);
            margin-bottom: 20px;
            box-shadow: var(--q-shadow-sm);
            border: 1px solid var(--q-border);
            overflow: hidden;
            transition: var(--q-transition);
        }

            .qsection:focus-within {
                border-color: var(--q-success);
                box-shadow: 0 0 0 3px rgba(5,150,105,.08), var(--q-shadow);
            }

        .qsection-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 15px 20px;
            border-bottom: 1px solid var(--q-border);
            background: #fafbfd;
        }

        .qsection-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 16px;
            font-weight: 900;
            margin: 0;
            color: var(--q-text);
        }

        .section-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }

        .icon-blue {
            background: var(--q-primary-light);
            color: var(--q-primary);
        }

        .icon-green {
            background: var(--q-success-light);
            color: var(--q-success);
        }

        .icon-purple {
            background: var(--q-purple-light);
            color: var(--q-purple);
        }

        .icon-amber {
            background: var(--q-warning-light);
            color: var(--q-warning);
        }

        .qsection-body {
            padding: 22px;
        }

        .q-field-label {
            color: var(--q-text);
            font-size: 14px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .form-control,
        .form-select {
            border: 1.5px solid var(--q-border);
            border-radius: var(--q-radius-sm);
            padding: 10px 13px;
            font-size: 14px;
            min-height: 45px;
            color: var(--q-text);
            box-shadow: none !important;
            transition: var(--q-transition);
        }

            .form-control:focus,
            .form-select:focus {
                border-color: var(--q-success);
                box-shadow: 0 0 0 3px rgba(5,150,105,.10) !important;
            }

        .q-help-text {
            color: var(--q-text-muted);
            font-size: 13px;
            line-height: 1.8;
            margin-top: 7px;
        }

        .q-multi-select {
            min-height: 148px;
            padding: 10px;
        }

        .q-inline-alert {
            background: var(--q-success-light);
            border: 1px solid rgba(5,150,105,.22);
            color: #065f46;
            border-radius: var(--q-radius);
            padding: 13px 16px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            font-size: 13px;
            line-height: 1.8;
            margin-bottom: 20px;
        }

        .q-actions {
            background: var(--q-surface);
            border-radius: var(--q-radius);
            border: 1px solid var(--q-border);
            box-shadow: var(--q-shadow-sm);
            padding: 18px 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn-q-primary,
        .btn-q-outline {
            border-radius: var(--q-radius-sm);
            padding: 11px 22px;
            font-size: 14px;
            font-weight: 900;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-decoration: none;
            transition: var(--q-transition);
        }

        .btn-q-primary {
            border: 0;
            background: linear-gradient(135deg, var(--q-success), var(--q-success-dark));
            color: #fff;
            box-shadow: 0 6px 16px rgba(5,150,105,.24);
        }

            .btn-q-primary:hover {
                color: #fff;
                transform: translateY(-1px);
                box-shadow: 0 9px 20px rgba(5,150,105,.30);
            }

        .btn-q-outline {
            background: #fff;
            color: var(--q-text-muted);
            border: 1.5px solid var(--q-border);
        }

            .btn-q-outline:hover {
                color: var(--q-success);
                border-color: var(--q-success);
                background: var(--q-success-light);
            }

        .text-danger {
            font-size: 12px;
            font-weight: 700;
            margin-top: 6px;
            display: block;
        }

        .q-choice-box {
            border: 1.5px solid var(--q-border);
            border-radius: var(--q-radius);
            padding: 15px 16px;
            background: #fff;
        }

        .q-check-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 12px;
        }

        .q-check-row .form-check-input {
            width: 20px;
            height: 20px;
            margin: 0;
            cursor: pointer;
        }

        .q-check-row .form-check-label {
            font-size: 14px;
            font-weight: 900;
            color: var(--q-text);
            cursor: pointer;
        }

        .lecture-select-wrap {
            display: none;
            margin-top: 12px;
        }

        .lecture-select-wrap.is-visible {
            display: block;
        }

        @@media (max-width: 768px) {
            .qdrat-page {
                padding: 16px 10px 32px;
            }

            .qpage-header {
                flex-direction: column;
                align-items: stretch;
                padding: 20px;
            }

            .qpage-title {
                font-size: 20px;
            }

            .qpage-subtitle {
                margin-right: 0;
            }

            .progress-stepper {
                grid-template-columns: 1fr 1fr;
            }

            .qactions-left,
            .qactions-right {
                width: 100%;
            }

            .btn-q-primary,
            .btn-q-outline {
                width: 100%;
            }
        }
    </style>
}

<div class="qdrat-page" dir="rtl">
    <div class="qpage-header">
        <div class="qpage-header-content">
            <h1 class="qpage-title">
                <span class="header-icon">📘</span>
                إرسال واجب من نموذج احترافي
            </h1>
            <p class="qpage-subtitle">
                اختر النموذج الاحترافي والدفعات المستهدفة، ثم حدد فترة إتاحة الواجب للطلاب.
            </p>
        </div>
        <div class="qpage-header-actions">
            <a asp-action="ModelAssignments" class="btn-back">↩ رجوع</a>
        </div>
    </div>

    <div class="progress-stepper" aria-label="خطوات إرسال واجب من نموذج احترافي">
        <div class="step-item active"><span class="step-num">1</span><span class="step-label">عنوان الواجب</span></div>
        <div class="step-item active"><span class="step-num">2</span><span class="step-label">اختيار النموذج</span></div>
        <div class="step-item active"><span class="step-num">3</span><span class="step-label">تحديد الدفعات</span></div>
        <div class="step-item active"><span class="step-num">4</span><span class="step-label">التوقيت والإرسال</span></div>
    </div>

    <form asp-action="CreateModelHomework" asp-controller="AdminLessonCompletions" asp-area="Admin" method="post" id="createModelHomeworkForm" novalidate>
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="q-inline-alert">
            <span>✅</span>
            <span>سيتم إنشاء الواجب بناءً على النموذج الاحترافي المختار، مع استهداف الدفعات المحددة بنفس منطق الإرسال الحالي.</span>
        </div>

        <input type="hidden" asp-for="BatchId" />

        <div class="qsection">
            <div class="qsection-header">
                <h2 class="qsection-title">
                    <span class="section-icon icon-green">📝</span>
                    بيانات الواجب والنموذج
                </h2>
            </div>
            <div class="qsection-body">
                <div class="row g-3">
                    <div class="col-lg-7 col-md-6">
                        <label asp-for="Title" class="q-field-label">عنوان الواجب</label>
                        <input asp-for="Title" class="form-control" placeholder="مثلاً: واجب من النموذج M75" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="col-lg-5 col-md-6">
                        <label class="q-field-label">المنهج (للتصفية)</label>
                        <select id="CurriculumFilter" asp-for="CurriculumId" asp-items="Model.Curriculums" class="form-select">
                        </select>
                    </div>

                    <div class="col-12">
                        <label asp-for="ModelId" class="q-field-label">النموذج الاحترافي (واجبات)</label>
                        <select asp-for="ModelId" id="ModelIdSelect" asp-items="Model.Models" class="form-select">
                        </select>
                        <span asp-validation-for="ModelId" class="text-danger"></span>
                        <div id="models-loading" style="display:none;margin-top:6px;font-size:13px;color:#64748b">
                            <i class="fa fa-spinner fa-spin"></i> جاري تحميل النماذج...
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="qsection">
            <div class="qsection-header">
                <h2 class="qsection-title">
                    <span class="section-icon icon-blue">👥</span>
                    الدفعات المستهدفة
                </h2>
            </div>
            <div class="qsection-body">
                <label class="q-field-label">الدفعات المستهدفة</label>
                <select asp-for="SelectedBatchIds" asp-items="Model.Batches" class="form-select q-multi-select" multiple id="BatchMultiSelect"></select>
                <div class="q-help-text">يمكنك اختيار أكثر من دفعة بالضغط على Ctrl أو ⌘.</div>
                <span asp-validation-for="SelectedBatchIds" class="text-danger"></span>
            </div>
        </div>

        <div class="qsection">
            <div class="qsection-header">
                <h2 class="qsection-title">
                    <span class="section-icon icon-purple">🏫</span>
                    نوع الواجب وربطه بالمحاضرة
                </h2>
            </div>
            <div class="qsection-body">
                <div class="q-choice-box">
                    <div class="q-check-row">
                        <input asp-for="IsLinkedToLecture" class="form-check-input" id="IsLinkedToLecture" />
                        <label asp-for="IsLinkedToLecture" class="form-check-label">هذا الواجب تابع لمحاضرة محددة</label>
                    </div>
                    <div class="q-help-text">
                        عند تفعيل الربط يجب اختيار دفعة واحدة فقط، وستظهر محاضرات هذه الدفعة للاختيار. إذا لم يتم التفعيل سيُعامل الواجب كواجب إضافي مستقل.
                    </div>

                    <div id="lectureSelectWrap" class="lecture-select-wrap">
                        <label asp-for="LectureId" class="q-field-label mt-3">المحاضرة المرتبطة</label>
                        <select asp-for="LectureId" asp-items="Model.Lectures" class="form-select" id="LectureId">
                            <option value="">-- اختر المحاضرة --</option>
                        </select>
                        <span asp-validation-for="LectureId" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qsection">
            <div class="qsection-header">
                <h2 class="qsection-title">
                    <span class="section-icon icon-amber">⏱️</span>
                    فترة إتاحة الواجب
                </h2>
            </div>
            <div class="qsection-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="StartAt" class="q-field-label">يبدأ في</label>
                        <input asp-for="StartAt" type="datetime-local" class="form-control" />
                        <span asp-validation-for="StartAt" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EndAt" class="q-field-label">ينتهي في</label>
                        <input asp-for="EndAt" type="datetime-local" class="form-control" />
                        <span asp-validation-for="EndAt" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="q-actions">
            <div class="qactions-right">
                <button type="submit" class="btn-q-primary">
                    🚀 حفظ وإرسال
                </button>
            </div>
            <div class="qactions-left">
                <a asp-action="ModelAssignments" class="btn-q-outline">↩ رجوع</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('createModelHomeworkForm');
            const linkedCheckbox = document.getElementById('IsLinkedToLecture');
            const lectureWrap = document.getElementById('lectureSelectWrap');
            const lectureSelect = document.getElementById('LectureId');
            const batchSelect = document.getElementById('BatchMultiSelect');
            let currentLectureValue = lectureSelect.value;

            if (!form) {
                return;
            }

            const setLectureLoading = function (message) {
                lectureSelect.innerHTML = '';
                const option = document.createElement('option');
                option.value = '';
                option.textContent = message;
                lectureSelect.appendChild(option);
            };

            const selectedBatches = function () {
                return Array.from(batchSelect.querySelectorAll('option:checked')).map(o => o.value);
            };

            const loadLecturesForSelectedBatch = async function () {
                const batches = selectedBatches();
                const preferredLectureValue = currentLectureValue || lectureSelect.value;

                if (!linkedCheckbox.checked) {
                    return;
                }

                if (batches.length !== 1) {
                    setLectureLoading('-- اختر دفعة واحدة لعرض المحاضرات --');
                    return;
                }

                setLectureLoading('جاري تحميل المحاضرات...');

                try {
                    const response = await fetch(`/Admin/AdminLessonCompletions/GetLecturesByBatch?batchId=${encodeURIComponent(batches[0])}`);

                    if (!response.ok) {
                        throw new Error('Failed to load lectures');
                    }

                    const lectures = await response.json();
                    lectureSelect.innerHTML = '<option value="">-- اختر المحاضرة --</option>';

                    if (!lectures.length) {
                        setLectureLoading('-- لا توجد محاضرات لهذه الدفعة --');
                        return;
                    }

                    lectures.forEach(function (lecture) {
                        const option = document.createElement('option');
                        option.value = lecture.id;
                        option.textContent = `${lecture.title} - ${lecture.date}`;
                        lectureSelect.appendChild(option);
                    });

                    if (preferredLectureValue) {
                        lectureSelect.value = preferredLectureValue;
                    }
                } catch (error) {
                    setLectureLoading('تعذر تحميل المحاضرات');
                }
            };

            const toggleLectureSelection = function () {
                const isLinked = linkedCheckbox.checked;
                lectureWrap.classList.toggle('is-visible', isLinked);
                lectureSelect.disabled = !isLinked;

                if (!isLinked) {
                    lectureSelect.value = '';
                    return;
                }

                loadLecturesForSelectedBatch();
            };

            linkedCheckbox.addEventListener('change', toggleLectureSelection);
            batchSelect.addEventListener('change', function () {
                currentLectureValue = '';
                document.querySelector('[name="BatchId"]').value = selectedBatches()[0] || '0';
                loadLecturesForSelectedBatch();
            });
            lectureSelect.addEventListener('change', function () {
                currentLectureValue = lectureSelect.value;
            });

            toggleLectureSelection();

            form.addEventListener('submit', function (e) {
                const modelId = document.querySelector('[name="ModelId"]').value;
                const batches = selectedBatches();

                if (!modelId) {
                    alert('الرجاء اختيار النموذج أولاً.');
                    e.preventDefault();
                    return;
                }

                if (batches.length === 0) {
                    alert('يجب اختيار دفعة واحدة على الأقل.');
                    e.preventDefault();
                    return;
                }

                if (linkedCheckbox.checked && batches.length !== 1) {
                    alert('ربط الواجب بمحاضرة يتطلب اختيار دفعة واحدة فقط.');
                    e.preventDefault();
                    return;
                }

                if (linkedCheckbox.checked && !lectureSelect.value) {
                    alert('الرجاء اختيار المحاضرة المرتبطة بالواجب.');
                    e.preventDefault();
                    return;
                }
            });
        });
    </script>

    <script>
    // ── Curriculum → Models cascade ──────────────────────────
    (function () {
        var curriculumSelect = document.getElementById('CurriculumFilter');
        var modelSelect      = document.getElementById('ModelIdSelect');
        var loadingEl        = document.getElementById('models-loading');

        if (!curriculumSelect || !modelSelect) return;

        curriculumSelect.addEventListener('change', function () {
            var curriculumId = this.value;
            loadingEl.style.display = 'block';
            modelSelect.disabled = true;

            fetch('/Admin/AdminLessonCompletions/GetModelsByCurriculum?curriculumId='
                  + encodeURIComponent(curriculumId)
                  + '&modelType=homework')
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    modelSelect.innerHTML = '';
                    data.forEach(function (item) {
                        var opt = document.createElement('option');
                        opt.value = item.value;
                        opt.textContent = item.text;
                        modelSelect.appendChild(opt);
                    });
                })
                .catch(function () {
                    modelSelect.innerHTML = '<option value="">⚠️ حدث خطأ في التحميل</option>';
                })
                .finally(function () {
                    loadingEl.style.display = 'none';
                    modelSelect.disabled = false;
                });
        });
    })();
    </script>
}
