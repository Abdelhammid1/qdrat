@model QdratNew.ViewModels.Homework.ModelAssignmentsPageViewModel

@{
    ViewData["Title"] = "أرشيف الدفعة";
    var batchName = ViewBag.BatchName as string ?? "الدفعة";
    var homeworks = (Model?.ArchivedHomeworks ?? new List<QdratNew.ViewModels.Homework.ModelAssignmentViewModel>()).ToList();
    var exams = (Model?.ArchivedExams ?? new List<QdratNew.ViewModels.Homework.ModelAssignmentViewModel>()).ToList();
    var total = homeworks.Count + exams.Count;
}

@section Styles {
    <style>
        .batch-model-page {
            direction: rtl;
            padding: 24px;
            color: #1f2937;
        }

        .batch-model-hero,
        .batch-toolbar,
        .archive-section,
        .archive-item {
            background: #fff;
            border: 1px solid #e5e7eb;
            box-shadow: 0 10px 24px rgba(15,23,42,.06);
        }

        .batch-model-hero {
            border-radius: 14px;
            padding: 18px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            flex-wrap: wrap;
            margin-bottom: 18px;
        }

        .batch-model-title {
            font-size: 22px;
            font-weight: 900;
            margin: 0 0 4px;
            color: #0f172a;
        }

        .batch-model-sub {
            color: #64748b;
            font-size: 14px;
        }

        .batch-back-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #92400e;
            border: 1px solid #fed7aa;
            background: #fff7ed;
            border-radius: 10px;
            padding: 9px 14px;
            font-weight: 800;
            text-decoration: none;
        }

        .batch-back-btn:hover {
            color: #fff;
            background: #b45309;
        }

        .batch-toolbar {
            border-radius: 12px;
            padding: 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 16px;
        }

        .batch-search {
            position: relative;
            flex: 1;
            min-width: 220px;
        }

        .batch-search i {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
        }

        .batch-search input {
            width: 100%;
            border: 1px solid #dbe3ef;
            border-radius: 10px;
            padding: 9px 38px 9px 12px;
            outline: none;
        }

        .batch-count {
            color: #64748b;
            font-weight: 700;
            white-space: nowrap;
        }

        .archive-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
        }

        .archive-section {
            border-radius: 12px;
            overflow: hidden;
        }

        .archive-section-head {
            padding: 13px 15px;
            border-bottom: 1px solid #e5e7eb;
            font-weight: 900;
            color: #0f172a;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .archive-section-head i {
            color: #b45309;
        }

        .archive-list {
            display: grid;
            gap: 10px;
            padding: 12px;
        }

        .archive-item {
            border-radius: 10px;
            padding: 12px;
            display: grid;
            grid-template-columns: minmax(180px, 1fr) auto;
            gap: 12px;
            align-items: center;
            box-shadow: none;
        }

        .item-title {
            font-weight: 900;
            color: #111827;
            margin-bottom: 4px;
        }

        .item-date {
            color: #64748b;
            font-size: 13px;
        }

        .item-actions {
            display: flex;
            gap: 7px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .act-btn {
            border: 0;
            border-radius: 9px;
            padding: 8px 10px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #fff;
            font-weight: 800;
            text-decoration: none;
            cursor: pointer;
            font-size: 13px;
        }

        .act-view { background: #2563eb; }
        .act-restore { background: #0f766e; }

        .empty-state {
            background: #fff;
            border: 1px dashed #cbd5e1;
            border-radius: 12px;
            padding: 42px 16px;
            text-align: center;
            color: #64748b;
        }

        .empty-state i {
            display: block;
            font-size: 28px;
            margin-bottom: 10px;
        }

        @@media (max-width: 992px) {
            .archive-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 576px) {
            .batch-model-page {
                padding: 14px;
            }

            .batch-toolbar,
            .archive-item {
                align-items: stretch;
                grid-template-columns: 1fr;
            }

            .item-actions {
                justify-content: flex-start;
            }
        }
    </style>
}

<div class="batch-model-page">
    <div class="batch-model-hero">
        <div>
            <h1 class="batch-model-title">أرشيف دفعة @batchName</h1>
            <div class="batch-model-sub">العناصر المؤرشفة لهذه الدفعة فقط.</div>
        </div>

        <a asp-area="Admin" asp-controller="AdminLessonCompletions" asp-action="ModelAssignments" class="batch-back-btn">
            <i class="fas fa-arrow-right"></i>
            رجوع للدفعات
        </a>
    </div>

    <div class="batch-toolbar">
        <div class="batch-search">
            <i class="fas fa-search"></i>
            <input type="text" id="archiveSearch" placeholder="ابحث في أرشيف الدفعة..." />
        </div>
        <div class="batch-count">إجمالي: <strong>@total</strong> عنصر</div>
    </div>

    @if (total == 0)
    {
        <div class="empty-state">
            <i class="fas fa-inbox"></i>
            لا توجد عناصر مؤرشفة لهذه الدفعة
        </div>
    }
    else
    {
        <div class="archive-grid" id="archiveItemsList">
            <section class="archive-section">
                <div class="archive-section-head">
                    <span><i class="fas fa-tasks"></i> الواجبات المؤرشفة</span>
                    <span>@homeworks.Count</span>
                </div>
                <div class="archive-list">
                    @if (!homeworks.Any())
                    {
                        <div class="empty-state">لا توجد واجبات مؤرشفة</div>
                    }
                    @foreach (var item in homeworks)
                    {
                        <article class="archive-item" data-search="@($"{item.Title} واجب {item.BatchName}".ToLower())">
                            <div>
                                <div class="item-title">@item.Title</div>
                                <div class="item-date">@item.CreatedAt.ToString("yyyy/MM/dd HH:mm")</div>
                            </div>
                            <div class="item-actions">
                                <a asp-area="Admin" asp-controller="HomeworkManagement" asp-action="Details" asp-route-id="@item.Id" class="act-btn act-view">
                                    <i class="fas fa-eye"></i>
                                    تفاصيل
                                </a>
                                <form asp-area="Admin" asp-controller="AdminLessonCompletions" asp-action="RestoreModelHomework" method="post" class="d-inline m-0" onsubmit="return confirm('هل تريد إخراج هذا الواجب من الأرشيف؟')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="act-btn act-restore">
                                        <i class="fas fa-undo"></i>
                                        إخراج من الأرشيف
                                    </button>
                                </form>
                            </div>
                        </article>
                    }
                </div>
            </section>

            <section class="archive-section">
                <div class="archive-section-head">
                    <span><i class="fas fa-file-signature"></i> الاختبارات المؤرشفة</span>
                    <span>@exams.Count</span>
                </div>
                <div class="archive-list">
                    @if (!exams.Any())
                    {
                        <div class="empty-state">لا توجد اختبارات مؤرشفة</div>
                    }
                    @foreach (var item in exams)
                    {
                        <article class="archive-item" data-search="@($"{item.Title} اختبار {item.BatchName}".ToLower())">
                            <div>
                                <div class="item-title">@item.Title</div>
                                <div class="item-date">@item.CreatedAt.ToString("yyyy/MM/dd HH:mm")</div>
                            </div>
                            <div class="item-actions">
                                <a asp-area="Admin" asp-controller="ExamAssignments" asp-action="Details" asp-route-id="@item.Id" class="act-btn act-view">
                                    <i class="fas fa-eye"></i>
                                    تفاصيل
                                </a>
                                <form asp-area="Admin" asp-controller="AdminLessonCompletions" asp-action="RestoreModelExam" method="post" class="d-inline m-0" onsubmit="return confirm('هل تريد إخراج هذا الاختبار من الأرشيف؟')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="act-btn act-restore">
                                        <i class="fas fa-undo"></i>
                                        إخراج من الأرشيف
                                    </button>
                                </form>
                            </div>
                        </article>
                    }
                </div>
            </section>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const search = document.getElementById('archiveSearch');
            if (!search) return;

            search.addEventListener('input', function () {
                const term = (this.value || '').toLowerCase().trim();
                document.querySelectorAll('#archiveItemsList .archive-item').forEach(function (item) {
                    const text = (item.getAttribute('data-search') || item.textContent || '').toLowerCase();
                    item.style.display = text.includes(term) ? '' : 'none';
                });
            });
        });
    </script>
}
