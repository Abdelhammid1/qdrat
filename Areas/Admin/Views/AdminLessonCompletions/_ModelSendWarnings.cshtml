@model QdratNew.Services.ProfessionalModels.ModelSendPreview

@* PPM-S6: تحذيرات التكرار قبل إرسال واجب أو اختبار من نموذج. يوضع داخل الـ form لأن التأكيد يُرسل معه *@
<div class="alert alert-warning" id="modelSendWarnings" role="alert">
    <h2 class="h6 fw-bold mb-2">⚠️ راجع قبل الإرسال</h2>

    <div class="table-responsive mb-3">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>الدفعة</th>
                    <th>الطلاب المستهدفون</th>
                    <th>أسئلة سبق إرسالها</th>
                    <th>أُرسل من هذا النموذج</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var batch in Model.Batches)
                {
                    <tr>
                        <td>@batch.Name</td>
                        <td>@batch.StudentCount</td>
                        <td>@batch.RepeatedQuestionCount</td>
                        <td>@(batch.AlreadySentFromModel ? "نعم" : "لا")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="form-check">
        <input class="form-check-input" type="checkbox" name="ConfirmWarnings" value="true" id="confirmModelSend" />
        <label class="form-check-label fw-bold" for="confirmModelSend">
            راجعت التحذيرات وأريد الإرسال رغم التكرار
        </label>
    </div>
</div>

<script>
    // التأكيد يخص الاختيارات التي عُرضت تحذيراتها، فأي تغيير بعدها يلغيه
    (function () {
        var confirmBox = document.getElementById('confirmModelSend');
        var form = confirmBox && confirmBox.closest('form');
        if (!form) return;

        form.addEventListener('change', function (e) {
            if (e.target !== confirmBox) confirmBox.checked = false;
        });
    })();
</script>
