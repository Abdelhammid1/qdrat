@model QdratNew.ViewModels.Admin.EditProfessionalHomeworkVm
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "تعديل واجب احترافي";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        :root {
            --q-primary: #1a56db;
            --q-primary-dark: #1240a8;
            --q-primary-light: #e8f0fe;
            --q-success: #059669;
            --q-success-dark: #047857;
            --q-success-light: #d1fae5;
            --q-warning: #d97706;
            --q-warning-light: #fef3c7;
            --q-danger: #dc2626;
            --q-danger-light: #fee2e2;
            --q-purple: #7c3aed;
            --q-purple-light: #ede9fe;
            --q-surface: #ffffff;
            --q-bg: #f4f6fb;
            --q-border: #e2e8f0;
            --q-text: #0f172a;
            --q-text-muted: #64748b;
            --q-shadow-sm: 0 1px 3px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.04);
            --q-shadow: 0 4px 16px rgba(15,23,42,.08);
            --q-shadow-lg: 0 10px 30px rgba(15,23,42,.12);
            --q-radius-sm: 8px;
            --q-radius: 12px;
            --q-radius-lg: 16px;
            --q-transition: all .2s cubic-bezier(.4,0,.2,1);
        }

        body {
            font-family: 'Cairo', sans-serif !important;
            background: var(--q-bg);
            color: var(--q-text);
            direction: rtl;
        }

        .qdrat-page {
            max-width: 1120px;
            margin: 0 auto;
            padding: 24px 12px 44px;
        }

        .qpage-header {
            background: linear-gradient(135deg, var(--q-success) 0%, var(--q-primary-dark) 100%);
            border-radius: var(--q-radius-lg);
            padding: 22px 28px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            box-shadow: 0 8px 24px rgba(5,150,105,.24);
            position: relative;
            overflow: hidden;
        }

            .qpage-header::before {
                content: '';
                position: absolute;
                left: -60px;
                top: -60px;
                width: 200px;
                height: 200px;
                background: rgba(255,255,255,.07);
                border-radius: 50%;
            }

            .qpage-header::after {
                content: '';
                position: absolute;
                right: 55px;
                bottom: -90px;
                width: 180px;
                height: 180px;
                background: rgba(255,255,255,.05);
                border-radius: 50%;
            }

        .qpage-header-content,
        .qpage-header-actions {
            position: relative;
            z-index: 1;
        }

        .qpage-title {
            color: #fff;
            font-size: 23px;
            font-weight: 900;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: rgba(255,255,255,.18);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .qpage-subtitle {
            color: rgba(255,255,255,.86);
            margin: 8px 56px 0 0;
            font-size: 13px;
            line-height: 1.8;
        }

        .btn-back {
            background: rgba(255,255,255,.15);
            border: 1.5px solid rgba(255,255,255,.32);
            color: #fff;
            border-radius: var(--q-radius-sm);
            padding: 9px 18px;
            font-size: 14px;
            font-weight: 800;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: var(--q-transition);
            white-space: nowrap;
        }

            .btn-back:hover {
                color: #fff;
                background: rgba(255,255,255,.27);
                transform: translateX(2px);
            }

        .progress-stepper {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
            margin-bottom: 22px;
            background: var(--q-surface);
            border-radius: var(--q-radius);
            padding: 8px;
            box-shadow: var(--q-shadow-sm);
            border: 1px solid var(--q-border);
        }

        .step-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 12px;
            border-radius: var(--q-radius-sm);
            background: #fff;
            border: 1px solid transparent;
        }

            .step-item.active {
                background: var(--q-success);
                color: #fff;
            }

        .step-num {
            width: 25px;
            height: 25px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 900;
            background: var(--q-border);
            color: var(--q-text-muted);
            flex-shrink: 0;
        }

        .step-item.active .step-num {
            background: rgba(255,255,255,.25);
            color: #fff;
        }

        .step-label {
            font-size: 13px;
            font-weight: 800;
            color: var(--q-text-muted);
            white-space: nowrap;
        }

        .step-item.active .step-label {
            color: #fff;
        }

        .q-alert {
            border-radius: var(--q-radius);
            padding: 13px 16px;
            margin-bottom: 18px;
            font-size: 14px;
            font-weight: 800;
            line-height: 1.8;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            border: 1px solid transparent;
        }

        .q-alert-success {
            background: var(--q-success-light);
            border-color: rgba(5,150,105,.22);
            color: #065f46;
        }

        .q-alert-danger {
            background: var(--q-danger-light);
            border-color: rgba(220,38,38,.20);
            color: #991b1b;
        }

        .q-inline-alert {
            background: var(--q-success-light);
            border: 1px solid rgba(5,150,105,.22);
            color: #065f46;
            border-radius: var(--q-radius);
            padding: 13px 16px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            font-size: 13px;
            line-height: 1.8;
            margin-bottom: 20px;
        }

        .qsection {
            background: var(--q-surface);
            border-radius: var(--q-radius);
            margin-bottom: 20px;
            box-shadow: var(--q-shadow-sm);
            border: 1px solid var(--q-border);
            overflow: hidden;
            transition: var(--q-transition);
        }

            .qsection:focus-within {
                border-color: var(--q-success);
                box-shadow: 0 0 0 3px rgba(5,150,105,.08), var(--q-shadow);
            }

        .qsection-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 15px 20px;
            border-bottom: 1px solid var(--q-border);
            background: #fafbfd;
        }

        .qsection-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 16px;
            font-weight: 900;
            margin: 0;
            color: var(--q-text);
        }

        .section-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }

        .icon-blue {
            background: var(--q-primary-light);
            color: var(--q-primary);
        }

        .icon-green {
            background: var(--q-success-light);
            color: var(--q-success);
        }

        .icon-purple {
            background: var(--q-purple-light);
            color: var(--q-purple);
        }

        .icon-amber {
            background: var(--q-warning-light);
            color: var(--q-warning);
        }

        .qsection-body {
            padding: 22px;
        }

        .q-field-label {
            color: var(--q-text);
            font-size: 14px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .form-control,
        .form-control-plaintext,
        .form-select {
            border: 1.5px solid var(--q-border);
            border-radius: var(--q-radius-sm);
            padding: 10px 13px;
            font-size: 14px;
            min-height: 45px;
            color: var(--q-text);
            box-shadow: none !important;
            transition: var(--q-transition);
            background-color: #fff;
        }

        .form-control-plaintext {
            background: #f8fafc;
            color: var(--q-success) !important;
            font-weight: 900;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--q-success);
            box-shadow: 0 0 0 3px rgba(5,150,105,.10) !important;
        }

        .q-help-text {
            color: var(--q-text-muted);
            font-size: 13px;
            line-height: 1.8;
            margin-top: 7px;
        }

        .q-actions {
            background: var(--q-surface);
            border-radius: var(--q-radius);
            border: 1px solid var(--q-border);
            box-shadow: var(--q-shadow-sm);
            padding: 18px 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn-q-primary,
        .btn-q-outline {
            border-radius: var(--q-radius-sm);
            padding: 11px 22px;
            font-size: 14px;
            font-weight: 900;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-decoration: none;
            transition: var(--q-transition);
        }

        .btn-q-primary {
            border: 0;
            background: linear-gradient(135deg, var(--q-success), var(--q-success-dark));
            color: #fff;
            box-shadow: 0 6px 16px rgba(5,150,105,.24);
        }

            .btn-q-primary:hover {
                color: #fff;
                transform: translateY(-1px);
                box-shadow: 0 9px 20px rgba(5,150,105,.30);
            }

        .btn-q-outline {
            background: #fff;
            color: var(--q-text-muted);
            border: 1.5px solid var(--q-border);
        }

            .btn-q-outline:hover {
                color: var(--q-success);
                border-color: var(--q-success);
                background: var(--q-success-light);
            }

        .text-danger {
            font-size: 12px;
            font-weight: 700;
            margin-top: 6px;
            display: block;
        }

        @@media (max-width: 768px) {
            .qdrat-page {
                padding: 16px 10px 32px;
            }

            .qpage-header {
                flex-direction: column;
                align-items: stretch;
                padding: 20px;
            }

            .qpage-title {
                font-size: 20px;
            }

            .qpage-subtitle {
                margin-right: 0;
            }

            .progress-stepper {
                grid-template-columns: 1fr 1fr;
            }

            .qactions-left,
            .qactions-right {
                width: 100%;
            }

            .btn-q-primary,
            .btn-q-outline {
                width: 100%;
            }
        }
    </style>
}

<div class="qdrat-page" dir="rtl">
    <div class="qpage-header">
        <div class="qpage-header-content">
            <h1 class="qpage-title">
                <span class="header-icon">📘</span>
                تعديل واجب احترافي
            </h1>
            <p class="qpage-subtitle">
                عدّل بيانات الواجب الاحترافي وفترة الإتاحة والمدة المسموح بها بدون تغيير ارتباطه الحالي بالدفعة.
            </p>
        </div>
        <div class="qpage-header-actions">
            <a asp-area="Admin" asp-controller="AdminLessonCompletions" asp-action="ModelAssignments" class="btn-back">↩ رجوع</a>
        </div>
    </div>

    <div class="progress-stepper" aria-label="خطوات تعديل واجب احترافي">
        <div class="step-item active"><span class="step-num">1</span><span class="step-label">بيانات الواجب</span></div>
        <div class="step-item active"><span class="step-num">2</span><span class="step-label">الدفعة</span></div>
        <div class="step-item active"><span class="step-num">3</span><span class="step-label">فترة الإتاحة</span></div>
        <div class="step-item active"><span class="step-num">4</span><span class="step-label">الحفظ</span></div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="q-alert q-alert-success">
            <span>✅</span>
            <span>@TempData["Success"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="q-alert q-alert-danger">
            <span>⚠️</span>
            <span>@TempData["Error"]</span>
        </div>
    }

    <form asp-area="Admin" asp-controller="AdminLessonCompletions" asp-action="EditProfessionalHomework" method="post" id="editProfessionalHomeworkForm" novalidate>
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="q-inline-alert">
            <span>✅</span>
            <span>سيتم حفظ تعديلات الواجب الحالي فقط مع الحفاظ على نفس الربط ونفس مسار التنفيذ الحالي.</span>
        </div>

        <div class="qsection">
            <div class="qsection-header">
                <h2 class="qsection-title">
                    <span class="section-icon icon-green">📝</span>
                    بيانات الواجب والدفعة
                </h2>
            </div>
            <div class="qsection-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Title" class="q-field-label">عنوان الواجب</label>
                        <input asp-for="Title" class="form-control" placeholder="مثلاً: واجب الوحدة الثانية" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="q-field-label">الدفعة المرتبطة</label>
                        <input type="text" readonly class="form-control-plaintext" value="@Model.BatchName" />
                        <div class="q-help-text">لا يتم تغيير الدفعة من صفحة التعديل الحالية.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="qsection">
            <div class="qsection-header">
                <h2 class="qsection-title">
                    <span class="section-icon icon-amber">⏱️</span>
                    فترة إتاحة الواجب
                </h2>
            </div>
            <div class="qsection-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="StartAt" class="q-field-label">يبدأ في</label>
                        <input asp-for="StartAt" type="datetime-local" class="form-control" />
                        <span asp-validation-for="StartAt" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EndAt" class="q-field-label">ينتهي في</label>
                        <input asp-for="EndAt" type="datetime-local" class="form-control" />
                        <span asp-validation-for="EndAt" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qsection">
            <div class="qsection-header">
                <h2 class="qsection-title">
                    <span class="section-icon icon-blue">⌛</span>
                    مدة الحل
                </h2>
            </div>
            <div class="qsection-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="DurationMinutes" class="q-field-label">المدة المسموح بها (بالدقائق)</label>
                        <input asp-for="DurationMinutes" type="number" min="5" step="5" class="form-control" placeholder="مثلاً: 30" />
                        <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                        <div class="q-help-text">اترك نفس القيمة الحالية للحفاظ على مدة الحل كما هي.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="qsection">
            <div class="qsection-header">
                <h2 class="qsection-title">
                    <span class="section-icon icon-blue">📚</span>
                    النموذج الاحترافي (واجبات)
                </h2>
            </div>
            <div class="qsection-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="q-field-label">المنهج (للتصفية)</label>
                        <select id="CurriculumFilter" asp-for="CurriculumId" asp-items="Model.Curriculums" class="form-select"></select>
                        <div class="q-help-text">اختر المنهج لتضييق قائمة النماذج.</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ProfessionalModelId" class="q-field-label">النموذج الاحترافي</label>
                        <select asp-for="ProfessionalModelId" id="ModelIdSelect" asp-items="Model.ProfessionalModels" class="form-select"></select>
                        <div id="models-loading" style="display:none;margin-top:6px;font-size:13px;color:#64748b">
                            <i class="fa fa-spinner fa-spin"></i> جاري تحميل النماذج...
                        </div>
                        <div class="q-help-text">اختياري — يمكن تركه فارغاً للاحتفاظ بالنموذج الحالي.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="q-actions">
            <div class="qactions-right">
                <button type="submit" class="btn-q-primary">
                    💾 حفظ التعديلات
                </button>
            </div>
            <div class="qactions-left">
                <a asp-area="Admin" asp-controller="AdminLessonCompletions" asp-action="ModelAssignments" class="btn-q-outline">↩ رجوع</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const success = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(TempData["Success"]));
            const error = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(TempData["Error"]));

            if (success) {
                Swal.fire({
                    icon: 'success',
                    title: 'تم الحفظ ✅',
                    text: success,
                    confirmButtonColor: '#198754',
                    confirmButtonText: 'موافق'
                });
            }

            if (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'حدث خطأ ❌',
                    text: error,
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'موافق'
                });
            }
        });
    </script>

    <script>
    (function () {
        var curriculumSelect = document.getElementById('CurriculumFilter');
        var modelSelect      = document.getElementById('ModelIdSelect');
        var loadingEl        = document.getElementById('models-loading');
        if (!curriculumSelect || !modelSelect) return;

        curriculumSelect.addEventListener('change', function () {
            loadingEl.style.display = 'block';
            modelSelect.disabled = true;
            fetch('/Admin/AdminLessonCompletions/GetModelsByCurriculum?curriculumId='
                  + encodeURIComponent(this.value) + '&modelType=homework')
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    modelSelect.innerHTML = '';
                    data.forEach(function (item) {
                        var opt = document.createElement('option');
                        opt.value = item.value;
                        opt.textContent = item.text;
                        modelSelect.appendChild(opt);
                    });
                })
                .catch(function () {
                    modelSelect.innerHTML = '<option value="">⚠️ خطأ في التحميل</option>';
                })
                .finally(function () {
                    loadingEl.style.display = 'none';
                    modelSelect.disabled = false;
                });
        });
    })();
    </script>
}
