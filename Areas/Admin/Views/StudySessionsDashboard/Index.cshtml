@model QdratNew.ViewModels.StudySessionsDashboardViewModel
@{
    ViewData["Title"] = "لوحة إحصائيات الجلسات";
}

<h2 class="mb-4">لوحة إحصائيات الجلسات الدراسية</h2>

<!-- ✅ كروت إحصائية -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <h5 class="card-title">إجمالي الإيرادات</h5>
                <p class="card-text">@Model.TotalRevenue.ToString("N2") ريال</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <h5 class="card-title">عدد الجلسات</h5>
                <p class="card-text">@Model.TotalSessions جلسة</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info mb-3">
            <div class="card-body">
                <h5 class="card-title">متوسط العائد/جلسة</h5>
                <p class="card-text">@Model.AverageRevenuePerSession.ToString("N2") ريال</p>
            </div>
        </div>
    </div>
</div>

<!-- ✅ الرسم البياني للعائد -->
<div class="mb-5">
    <h4>توزيع العائد الزمني</h4>
    <canvas id="revenueChart" height="100"></canvas>
</div>

<!-- ✅ توزيع حسب حالة الجلسة -->
<div class="mb-5">
    <h4>توزيع الجلسات حسب الحالة</h4>
    <ul class="list-group">
        @foreach (var item in Model.SessionsByStatus)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                @item.Key
                <span class="badge bg-secondary">@item.Value</span>
            </li>
        }
    </ul>
</div>

<!-- ✅ إحصائيات حالة الجلسات -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card border-start border-success">
            <div class="card-body text-success">
                <h6 class="card-title">تمت الموافقة</h6>
                <p class="card-text fs-4">@Model.ApprovedCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-start border-danger">
            <div class="card-body text-danger">
                <h6 class="card-title">مرفوضة</h6>
                <p class="card-text fs-4">@Model.RejectedCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-start border-warning">
            <div class="card-body text-warning">
                <h6 class="card-title">قيد الانتظار</h6>
                <p class="card-text fs-4">@Model.PendingCount</p>
            </div>
        </div>
    </div>
</div>

<!-- ✅ تفاعل المدربين -->
<div class="mb-5">
    <h4>تفاعل المدربين</h4>
    <canvas id="trainerChart" height="100"></canvas>
</div>

<!-- ✅ توصية الذكاء الاصطناعي -->
@if (!string.IsNullOrWhiteSpace(Model.AIRecommendation))
{
    <div class="alert alert-info mt-4">
        <strong>تحليل الذكاء الاصطناعي:</strong> @Model.AIRecommendation
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const revenueCtx = document.getElementById('revenueChart').getContext('2d');
        const trainerCtx = document.getElementById('trainerChart').getContext('2d');

        new Chart(revenueCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.RevenueOverTimeChart.Select(p => p.Label))),
                datasets: [{
                    label: 'العائد',
                    data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.RevenueOverTimeChart.Select(p => p.Value))),
                    borderColor: '#4ca6a8',
                    fill: false
                }]
            }
        });

        new Chart(trainerCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.TrainerEngagementChartData.Select(p => p.Label))),
                datasets: [{
                    label: 'عدد الجلسات',
                    data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.TrainerEngagementChartData.Select(p => p.Value))),
                    backgroundColor: '#ffc107'
                }]
            }
        });
    </script>
}
