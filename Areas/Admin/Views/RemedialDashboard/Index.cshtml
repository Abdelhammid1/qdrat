@model IEnumerable<QdratNew.ViewModels.Remedial.RemedialDashboardVm>
@{
    ViewData["Title"] = "📊 لوحة التحليل الشاملة للجلسات العلاجية";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

<div class="container-fluid py-4">
    <h3 class="fw-bold text-primary mb-4 text-center">📊 لوحة التحليل الشاملة للجلسات العلاجية</h3>

    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle text-center shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>👤 الطالب</th>
                    <th>الخطة العلاجية</th>
                    <th>عدد الفيديوهات</th>
                    <th>المكتملة 🎥</th>
                    <th>إجمالي الدقائق</th>
                    <th>متوسط المشاهدة / فيديو</th>
                    <th>نتائج الاختبارات التطبيقية</th>
                    <th>نسبة التقدم</th>
                    <th>تقييم AI</th>
                    <th>التوصية الذكية</th>
                    <th>عمليات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.StudentName</td>
                        <td>@s.PlanTitle</td>
                        <td>@s.TotalVideos</td>
                        <td>@s.CompletedVideos</td>
                        <td>@s.TotalWatchMinutes دقيقة</td>
                        <td>@s.AverageWatchPerVideo دقيقة</td>
                        <td>@s.AverageQuizScore %</td>
                        <td>
                            <div class="progress" style="height: 22px;">
                                <div class="progress-bar @s.ProgressColor fw-bold" role="progressbar"
                                     style="width:@s.ProgressPercent%">
                                    @s.ProgressPercent %
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-primary">@s.AIAssessedLevel</span>
                        </td>
                        <td class="text-start">@s.AIRecommendations</td>
                        <td>
                            <a href="@Url.Action("Details", "RemedialSessions", new { id = s.PlanTitle })"
                               class="btn btn-sm btn-outline-info">
                                <i class="bi bi-eye"></i> عرض التفاصيل
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="alert alert-light border-start border-4 border-primary mt-4">
        <h6 class="fw-bold text-primary">💡 تحليلات إضافية مقترحة:</h6>
        <ul>
            <li>عرض “أكثر الفيديوهات مشاهدة” خلال الأسبوع.</li>
            <li>مقارنة بين تحسن الأداء في أول جلسة وآخر جلسة لكل طالب.</li>
            <li>توليد توصيات AI جماعية لتصنيف الطلاب: (متحسن – يحتاج متابعة – مستقر).</li>
            <li>توليد تقرير PDF عام لخطة كل طالب.</li>
        </ul>
    </div>
</div>
