@model QdratNew.ViewModels.Partner.EditPartnerViewModel
@{
    ViewData["Title"] = "تعديل الشريك";
}

<div class="qdrat-page-wrapper" dir="rtl">
    <div class="qdrat-page-header">
        <div>
            <h1 class="qdrat-page-title">
                <i class="fas fa-user-edit"></i>
                تعديل بيانات الشريك
            </h1>
            <p class="qdrat-page-subtitle">
                تحديث بيانات الشريك، فترة الشراكة، أو تغيير اللوجو الحالي دون تغيير سلوك الحفظ المعتمد.
            </p>
        </div>

        <a asp-action="Index" class="qdrat-back-btn">
            <i class="fas fa-arrow-right"></i>
            العودة للقائمة
        </a>
    </div>

    <form asp-action="Edit"
          method="post"
          enctype="multipart/form-data"
          class="qdrat-form-card">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div class="qdrat-card-header">
            <div class="qdrat-card-icon">
                <i class="fas fa-handshake"></i>
            </div>
            <div>
                <h2>بيانات الشريك</h2>
                <p>راجع البيانات الحالية وعدّل المطلوب فقط.</p>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="qdrat-validation-summary"></div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-building"></i>
                البيانات الأساسية
            </div>

            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="qdrat-form-group">
                        <label asp-for="Name" class="qdrat-label">
                            اسم الشريك
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-signature"></i>
                            <input asp-for="Name"
                                   class="form-control qdrat-input qdrat-input-lg"
                                   placeholder="اسم الشريك" />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="qdrat-form-group">
                        <label asp-for="Code" class="qdrat-label">
                            كود الشريك
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper qdrat-ltr-wrapper">
                            <i class="fas fa-link"></i>
                            <input asp-for="Code"
                                   class="form-control qdrat-input qdrat-ltr-input"
                                   placeholder="partner-code" />
                        </div>
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-calendar-alt"></i>
                فترة الشراكة
            </div>

            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="PartnershipStart" class="qdrat-label">
                            بداية الشراكة
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-calendar-check"></i>
                            <input asp-for="PartnershipStart"
                                   type="date"
                                   class="form-control qdrat-input" />
                        </div>
                        <span asp-validation-for="PartnershipStart" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="PartnershipEnd" class="qdrat-label">
                            نهاية الشراكة
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-calendar-times"></i>
                            <input asp-for="PartnershipEnd"
                                   type="date"
                                   class="form-control qdrat-input" />
                        </div>
                        <span asp-validation-for="PartnershipEnd" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-image"></i>
                الهوية البصرية
            </div>

            @if (!string.IsNullOrEmpty(Model.CurrentLogoPath))
            {
                <div class="qdrat-current-logo-box">
                    <div class="qdrat-logo-preview">
                        <img src="@Model.CurrentLogoPath"
                             alt="اللوجو الحالي" />
                    </div>
                    <div>
                        <h3>اللوجو الحالي</h3>
                        <p>سيظل اللوجو الحالي كما هو إذا لم ترفع لوجو جديد.</p>
                    </div>
                </div>
            }

            <div class="qdrat-upload-box">
                <div class="qdrat-upload-icon">
                    <i class="fas fa-cloud-upload-alt"></i>
                </div>
                <div class="qdrat-upload-content">
                    <label asp-for="LogoFile" class="qdrat-label mb-2">
                        تغيير اللوجو (اختياري)
                    </label>
                    <input asp-for="LogoFile"
                           type="file"
                           class="form-control qdrat-file-input"
                           accept="image/png,image/jpeg" />
                    <span asp-validation-for="LogoFile" class="text-danger small"></span>
                    <small class="qdrat-helper-text mb-0">
                        اترك هذا الحقل فارغًا إذا كنت لا تريد تغيير اللوجو الحالي.
                    </small>
                </div>
            </div>
        </div>

        <div class="qdrat-actions">
            <button type="submit" class="qdrat-save-btn">
                <i class="fas fa-save"></i>
                حفظ التعديلات
            </button>

            <a asp-action="Index" class="qdrat-cancel-btn">
                <i class="fas fa-times"></i>
                رجوع
            </a>
        </div>
    </form>
</div>

<style>
    .qdrat-page-wrapper {
        max-width: 1180px;
        margin: 0 auto;
        padding: 24px 16px 40px;
        font-family: 'Cairo', 'Tajawal', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .qdrat-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 22px;
        padding: 22px 24px;
        border-radius: 24px;
        background: linear-gradient(135deg, #0f766e 0%, #0891b2 55%, #2563eb 100%);
        color: #fff;
        box-shadow: 0 18px 45px rgba(15, 118, 110, 0.22);
    }

    .qdrat-page-title {
        margin: 0;
        font-size: 26px;
        font-weight: 900;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .qdrat-page-subtitle {
        margin: 8px 0 0;
        color: rgba(255, 255, 255, 0.88);
        font-size: 14px;
        line-height: 1.8;
    }

    .qdrat-back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 150px;
        padding: 11px 18px;
        border-radius: 999px;
        color: #fff;
        text-decoration: none;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.32);
        font-size: 14px;
        font-weight: 800;
        transition: all 0.2s ease-in-out;
    }

        .qdrat-back-btn:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.24);
            transform: translateY(-1px);
        }

    .qdrat-form-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 26px;
        box-shadow: 0 20px 55px rgba(15, 23, 42, 0.08);
        padding: 26px;
        overflow: hidden;
    }

    .qdrat-card-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding-bottom: 22px;
        border-bottom: 1px solid #eef2f7;
        margin-bottom: 24px;
    }

    .qdrat-card-icon {
        width: 54px;
        height: 54px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #ecfeff 0%, #dbeafe 100%);
        color: #0f766e;
        font-size: 22px;
        flex-shrink: 0;
    }

    .qdrat-card-header h2 {
        margin: 0;
        font-size: 20px;
        font-weight: 900;
        color: #111827;
    }

    .qdrat-card-header p {
        margin: 6px 0 0;
        color: #6b7280;
        font-size: 13px;
    }

    .qdrat-section {
        padding: 20px;
        border: 1px solid #eef2f7;
        background: #fbfdff;
        border-radius: 22px;
        margin-bottom: 20px;
    }

    .qdrat-section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 18px;
        color: #0f172a;
        font-size: 16px;
        font-weight: 900;
    }

        .qdrat-section-title i {
            color: #0f766e;
        }

    .qdrat-label {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 9px;
        color: #1f2937;
        font-size: 14px;
        font-weight: 900;
    }

    .qdrat-required {
        color: #dc2626;
        font-weight: 900;
    }

    .qdrat-input-wrapper {
        position: relative;
    }

        .qdrat-input-wrapper i {
            position: absolute;
            top: 50%;
            right: 15px;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 15px;
            z-index: 2;
        }

    .qdrat-input {
        height: 48px;
        border-radius: 16px;
        border: 1px solid #dbe3ef;
        background: #fff;
        padding: 10px 44px 10px 14px;
        color: #111827;
        font-size: 14px;
        font-weight: 700;
        transition: all 0.18s ease-in-out;
    }

    .qdrat-input-lg {
        height: 54px;
        font-size: 15px;
    }

    .qdrat-input:focus {
        border-color: #0f766e;
        box-shadow: 0 0 0 4px rgba(15, 118, 110, 0.10);
    }

    .qdrat-ltr-input {
        direction: ltr;
        text-align: left;
        padding-left: 16px;
        padding-right: 44px;
    }

    .qdrat-helper-text {
        display: block;
        margin-top: 9px;
        color: #64748b;
        font-size: 12.5px;
        line-height: 1.8;
        font-weight: 700;
    }

    .qdrat-validation-summary {
        color: #b91c1c;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 16px;
        padding: 12px 16px;
        margin-bottom: 20px;
        font-size: 14px;
        font-weight: 700;
    }

        .qdrat-validation-summary:empty {
            display: none;
        }

    .qdrat-current-logo-box {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 18px;
        padding: 16px;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        background: #fff;
    }

    .qdrat-logo-preview {
        width: 120px;
        height: 90px;
        border-radius: 18px;
        border: 1px solid #e5e7eb;
        background: #f8fafc;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        flex-shrink: 0;
    }

        .qdrat-logo-preview img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

    .qdrat-current-logo-box h3 {
        margin: 0 0 6px;
        color: #0f172a;
        font-size: 16px;
        font-weight: 900;
    }

    .qdrat-current-logo-box p {
        margin: 0;
        color: #64748b;
        font-size: 13px;
        font-weight: 700;
        line-height: 1.8;
    }

    .qdrat-upload-box {
        display: flex;
        gap: 16px;
        align-items: flex-start;
        padding: 18px;
        border-radius: 20px;
        border: 1px dashed #bfdbfe;
        background: linear-gradient(135deg, #f8fafc 0%, #eef6ff 100%);
    }

    .qdrat-upload-icon {
        width: 54px;
        height: 54px;
        border-radius: 18px;
        background: #fff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.08);
        flex-shrink: 0;
    }

    .qdrat-upload-content {
        flex: 1;
        min-width: 0;
    }

    .qdrat-file-input {
        min-height: 46px;
        border-radius: 16px;
        border: 1px solid #dbe3ef;
        background: #fff;
        color: #111827;
        font-size: 14px;
        font-weight: 700;
    }

    .qdrat-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding-top: 8px;
        flex-wrap: wrap;
    }

    .qdrat-save-btn,
    .qdrat-cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-width: 170px;
        min-height: 48px;
        border-radius: 999px;
        font-size: 15px;
        font-weight: 900;
        text-decoration: none;
        border: none;
        transition: all 0.2s ease-in-out;
    }

    .qdrat-save-btn {
        color: #fff;
        background: linear-gradient(135deg, #16a34a 0%, #0f766e 100%);
        box-shadow: 0 14px 30px rgba(22, 163, 74, 0.22);
    }

        .qdrat-save-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 18px 34px rgba(22, 163, 74, 0.28);
        }

    .qdrat-cancel-btn {
        color: #334155;
        background: #fff;
        border: 1px solid #cbd5e1;
    }

        .qdrat-cancel-btn:hover {
            color: #0f172a;
            background: #f8fafc;
            transform: translateY(-1px);
        }

    @@media (max-width: 768px) {
        .qdrat-page-header {
            flex-direction: column;
            align-items: stretch;
            padding: 20px;
        }

        .qdrat-page-title {
            font-size: 21px;
        }

        .qdrat-back-btn,
        .qdrat-save-btn,
        .qdrat-cancel-btn {
            width: 100%;
        }

        .qdrat-form-card {
            padding: 18px;
            border-radius: 22px;
        }

        .qdrat-section {
            padding: 16px;
        }

        .qdrat-current-logo-box,
        .qdrat-upload-box {
            flex-direction: column;
        }

        .qdrat-logo-preview {
            width: 100%;
        }

        .qdrat-actions {
            flex-direction: column;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
