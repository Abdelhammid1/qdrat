@model QdratNew.Entities.Partner
@{
    ViewData["Title"] = "تفاصيل الشريك";
}

<div class="container mt-4" dir="rtl">
    <h3 class="fw-bold mb-3">تفاصيل الشريك</h3>

    <dl class="row">
        <dt class="col-sm-3">الاسم</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">الكود</dt>
        <dd class="col-sm-9">@Model.Code</dd>

        <dt class="col-sm-3">مدة الشراكة</dt>
        <dd class="col-sm-9">
            @Model.PartnershipStart.ToShortDateString()
            →
            @Model.PartnershipEnd.ToShortDateString()
        </dd>
    </dl>

    <a asp-action="Index" class="btn btn-secondary">رجوع</a>
</div>
