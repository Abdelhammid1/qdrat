@model QdratNew.ViewModels.Branches.BranchAIAnalysisViewModel
@{
    ViewData["Title"] = $"تحليل ذكاء اصطناعي - {Model.BranchName}";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4" dir="rtl">
    <h3 class="mb-4 fw-bold text-primary">تحليل ذكاء اصطناعي للفرع: @Model.BranchName</h3>

    <!-- ✅ كروت أساسية -->
    <div class="row g-4">
        <div class="col-md-3">
            <div class="card shadow border-0 bg-info text-white">
                <div class="card-body">
                    <h6>المدينة</h6>
                    <h5 class="fw-bold">@Model.City</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow border-0 bg-secondary text-white">
                <div class="card-body">
                    <h6>نوع الفرع</h6>
                    <h5 class="fw-bold">@Model.Type</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow border-0 bg-primary text-white">
                <div class="card-body">
                    <h6>عدد الطلاب</h6>
                    <h5 class="fw-bold">@Model.TotalStudents</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow border-0" style="background-color:#DD6B20; color:white;">
                <div class="card-body">
                    <h6>متوسط الأداء</h6>
                    <h5 class="fw-bold">@Model.AveragePerformance.ToString("0.00")</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- ✅ الرسم البياني الزمني -->
    <div class="row mt-5">
        <div class="col-md-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light fw-bold">تطور الأداء الشهري</div>
                <div class="card-body">
                    @if (Model.MonthlyPerformanceTrend.Any())
                    {
                        <canvas id="performanceTrendChart"></canvas>
                    }
                    else
                    {
                        <div class="text-muted text-center">لا توجد بيانات أداء كافية لعرض الرسم البياني.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ✅ توصيات الذكاء الاصطناعي -->
    <div class="card mt-5 shadow-sm">
        <div class="card-header bg-success text-white fw-bold">
            التوصيات الذكية
        </div>
        <div class="card-body">
            @if (Model.AIRecommendations.Any())
            {
                <ul class="list-group">
                    @foreach (var rec in Model.AIRecommendations)
                    {
                        <li class="list-group-item">
                            <i class="fas fa-robot text-success me-2"></i>@rec
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="text-muted text-center">لا توجد توصيات حالية لهذا الفرع.</div>
            }
        </div>
    </div>

    <div class="mt-4 text-center">
        <a href="/Admin/Branches" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> العودة إلى قائمة الفروع
        </a>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const trendData = @Html.Raw(Json.Serialize(Model.MonthlyPerformanceTrend));

        if (trendData.length > 0) {
            const ctx = document.getElementById('performanceTrendChart');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: trendData.map(p => p.month),
                    datasets: [{
                        label: 'متوسط الأداء',
                        data: trendData.map(p => p.score),
                        fill: true,
                        backgroundColor: 'rgba(13, 110, 253, 0.2)',
                        borderColor: '#0d6efd',
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        }
    </script>
}
