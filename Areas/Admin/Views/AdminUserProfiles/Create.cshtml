@model QdratNew.ViewModels.Admin.AdminUserProfileCreateVM

<h3 class="mb-3">ربط مستخدم ببروفايل صلاحيات</h3>

<form method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">المستخدم</label>
        <select asp-for="UserId" asp-items="Model.Users" class="form-select">
            <option value="">-- اختر مستخدم --</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">بروفايل الصلاحيات</label>
        <select asp-for="AdminProfileId" asp-items="Model.Profiles" class="form-select">
            <option value="">-- اختر بروفايل --</option>
        </select>
    </div>

    <button class="btn btn-primary">💾 حفظ</button>
    <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
</form>
