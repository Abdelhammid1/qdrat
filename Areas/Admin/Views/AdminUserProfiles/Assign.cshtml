@model QdratNew.ViewModels.Admin.AdminUserProfileAssignVM
@{
    ViewData["Title"] = Model.IsEditMode ? "تعديل ربط المستخدم" : "ربط مستخدم جديد";
    var isEdit = Model.IsEditMode;
}

@* ── Assets ───────────────────────────────────────────────────────────── *@
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

<style>
:root {
    --as-bg:      #f1f4f9;
    --as-surface: #ffffff;
    --as-border:  #e2e8f0;
    --as-text:    #0f172a;
    --as-muted:   #64748b;
    --as-primary: #3b82f6;
    --as-success: #22c55e;
    --as-danger:  #ef4444;
    --as-warning: #f59e0b;
    --as-violet:  #8b5cf6;
    --as-r:       14px;
    --as-r-sm:    9px;
    --as-gap:     20px;
}
*, *::before, *::after { box-sizing: border-box; }

.as-root {
    direction:   rtl;
    font-family: 'Cairo', Tahoma, sans-serif;
    background:  var(--as-bg);
    color:       var(--as-text);
    min-height:  100vh;
    padding:     28px 20px 60px;
}

/* ── Back breadcrumb ──────────────────────────────────────────────────── */
.as-breadcrumb {
    display:       flex;
    align-items:   center;
    gap:           8px;
    font-size:     13px;
    font-weight:   700;
    color:         var(--as-muted);
    margin-bottom: 24px;
}
.as-breadcrumb a {
    color:           var(--as-primary);
    text-decoration: none;
    font-weight:     800;
    transition:      opacity .2s;
}
.as-breadcrumb a:hover { opacity: .75; }
.as-breadcrumb-sep { color: #cbd5e1; }

/* ── Page header ─────────────────────────────────────────────────────── */
.as-page-header {
    display:       flex;
    align-items:   center;
    gap:           14px;
    margin-bottom: 28px;
}
.as-page-icon {
    width: 50px; height: 50px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 21px; flex-shrink: 0;
    color: #fff;
}
.as-page-icon.mode-new  { background: linear-gradient(135deg,#22c55e,#16a34a); box-shadow:0 6px 20px rgba(34,197,94,.35); }
.as-page-icon.mode-edit { background: linear-gradient(135deg,#3b82f6,#6366f1); box-shadow:0 6px 20px rgba(99,102,241,.35); }
.as-page-header h1 { font-size:21px; font-weight:900; margin:0 0 3px; }
.as-page-header p  { font-size:13px; color:var(--as-muted); font-weight:600; margin:0; }

/* ── Layout ──────────────────────────────────────────────────────────── */
.as-layout {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap:     var(--as-gap);
    align-items: start;
}

/* ── Card ────────────────────────────────────────────────────────────── */
.as-card {
    background:    var(--as-surface);
    border:        1.5px solid var(--as-border);
    border-radius: var(--as-r);
    box-shadow:    0 2px 12px rgba(0,0,0,.04);
    overflow:      hidden;
}
.as-card-head {
    padding:       16px 22px;
    border-bottom: 1.5px solid var(--as-border);
    background:    #fafbfc;
    display:       flex;
    align-items:   center;
    gap:           10px;
}
.as-card-head-ico {
    width: 32px; height: 32px; border-radius: 9px;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px; flex-shrink: 0;
}
.as-card-head h2 { font-size:14.5px; font-weight:900; margin:0; }
.as-card-body    { padding: 24px 22px; display: flex; flex-direction: column; gap: 22px; }

/* ── Edit user banner ────────────────────────────────────────────────── */
.as-edit-banner {
    display:       flex;
    align-items:   center;
    gap:           14px;
    padding:       16px 18px;
    background:    #fffbeb;
    border:        1.5px solid #fde68a;
    border-radius: var(--as-r-sm);
}
.as-edit-banner-icon {
    width: 44px; height: 44px; border-radius: 12px;
    background: #fef3c7; color: #d97706;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; flex-shrink: 0;
}
.as-edit-banner-label { font-size:11px; font-weight:800; color:#d97706; letter-spacing:.06em; text-transform:uppercase; }
.as-edit-user-name  { font-size:16px; font-weight:900; color:var(--as-text); margin-top:2px; }
.as-edit-user-email { font-size:12.5px; font-weight:700; color:var(--as-muted); margin-top:3px; direction:ltr; text-align:right; }
.as-edit-prev-profile {
    margin-top: 8px;
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 12px; font-weight: 700;
    padding: 4px 10px; border-radius: 50px;
    background: #eff6ff; color: #2563eb; border: 1.5px solid #bfdbfe;
}

/* ── Form field ──────────────────────────────────────────────────────── */
.as-field { display:flex; flex-direction:column; gap:7px; }
.as-label {
    font-size:   13px;
    font-weight: 800;
    color:       var(--as-text);
    display:     flex;
    align-items: center;
    gap:         6px;
}
.as-label-req { color:var(--as-danger); font-size:15px; line-height:1; }
.as-label-hint { font-size:11.5px; color:var(--as-muted); font-weight:600; margin-top:-3px; }

.as-select-wrap { position: relative; }
.as-select-wrap i {
    position:       absolute;
    right:          13px;
    top:            50%;
    transform:      translateY(-50%);
    color:          var(--as-muted);
    font-size:      15px;
    pointer-events: none;
    z-index:        1;
}
.as-select {
    width:         100%;
    padding:       11px 40px 11px 14px;
    border:        1.5px solid var(--as-border);
    border-radius: var(--as-r-sm);
    font-size:     14px;
    font-family:   inherit;
    color:         var(--as-text);
    background:    #f8fafc;
    cursor:        pointer;
    outline:       none;
    direction:     rtl;
    appearance:    none;
    transition:    border-color .2s, box-shadow .2s;
    font-weight:   700;
}
.as-select:focus {
    border-color: var(--as-primary);
    box-shadow:   0 0 0 3px rgba(59,130,246,.12);
    background:   #fff;
}
.as-select option { font-weight: 700; }

/* Validation error */
.as-val-error {
    font-size:  12.5px;
    font-weight:700;
    color:      var(--as-danger);
    display:    flex;
    align-items:center;
    gap:        5px;
}
.field-validation-error { color:var(--as-danger); font-size:12.5px; font-weight:700; }

/* ── Selected preview pill ───────────────────────────────────────────── */
.as-preview-pill {
    display:       none;
    align-items:   center;
    gap:           8px;
    padding:       10px 14px;
    background:    #f0fdf4;
    border:        1.5px solid #bbf7d0;
    border-radius: var(--as-r-sm);
    font-size:     13px;
    font-weight:   800;
    color:         #15803d;
    animation:     fadeIn .25s ease;
}
.as-preview-pill.active { display:flex; }
@@keyframes fadeIn { from{opacity:0;transform:translateY(-4px)} to{opacity:1;transform:translateY(0)} }

/* ── Submit button ───────────────────────────────────────────────────── */
.as-btn-submit {
    display:        flex;
    align-items:    center;
    justify-content:center;
    gap:            8px;
    width:          100%;
    padding:        13px 24px;
    border:         none;
    border-radius:  var(--as-r-sm);
    font-size:      15px;
    font-weight:    900;
    font-family:    inherit;
    color:          #fff;
    cursor:         pointer;
    transition:     box-shadow .2s, transform .15s;
}
.as-btn-submit.mode-new  {
    background:  linear-gradient(135deg,#22c55e,#16a34a);
    box-shadow:  0 4px 16px rgba(34,197,94,.35);
}
.as-btn-submit.mode-edit {
    background:  linear-gradient(135deg,#3b82f6,#6366f1);
    box-shadow:  0 4px 16px rgba(99,102,241,.35);
}
.as-btn-submit:hover { transform:translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,.2); }

.as-btn-cancel {
    display:        flex;
    align-items:    center;
    justify-content:center;
    gap:            8px;
    width:          100%;
    padding:        11px 24px;
    border:         1.5px solid var(--as-border);
    border-radius:  var(--as-r-sm);
    font-size:      14px;
    font-weight:    800;
    font-family:    inherit;
    color:          var(--as-muted);
    background:     var(--as-surface);
    cursor:         pointer;
    text-decoration:none;
    text-align:     center;
    transition:     all .2s;
    margin-top:     8px;
}
.as-btn-cancel:hover { border-color:#94a3b8; color:var(--as-text); background:#f8fafc; }

/* ── Info sidebar card ───────────────────────────────────────────────── */
.as-info-card {
    background:    var(--as-surface);
    border:        1.5px solid var(--as-border);
    border-radius: var(--as-r);
    box-shadow:    0 2px 12px rgba(0,0,0,.04);
    overflow:      hidden;
}
.as-info-head {
    padding:       14px 18px;
    border-bottom: 1.5px solid var(--as-border);
    background:    #fafbfc;
    font-size:     13px;
    font-weight:   900;
    color:         var(--as-text);
    display:       flex;
    align-items:   center;
    gap:           8px;
}
.as-info-body { padding: 18px; display: flex; flex-direction: column; gap: 14px; }

.as-info-tip {
    display:       flex;
    gap:           10px;
    align-items:   flex-start;
}
.as-tip-dot {
    width: 28px; height: 28px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; flex-shrink: 0; margin-top: 1px;
}
.as-tip-title { font-size:13px; font-weight:800; color:var(--as-text); margin-bottom:2px; }
.as-tip-desc  { font-size:12px; font-weight:600; color:var(--as-muted); line-height:1.6; }

/* ── Profiles legend ─────────────────────────────────────────────────── */
.as-legend-item {
    display:     flex;
    align-items: center;
    gap:         8px;
    padding:     8px 0;
    border-bottom: 1px solid #f1f5f9;
    font-size:   13px; font-weight: 800;
    color:       var(--as-text);
}
.as-legend-item:last-child { border-bottom: none; }
.as-legend-dot {
    width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0;
}

@@media (max-width: 900px) {
    .as-layout { grid-template-columns: 1fr; }
}
</style>

<div class="as-root">

    @* ── Breadcrumb ── *@
    <div class="as-breadcrumb">
        <a asp-action="Index"><i class="bi bi-shield-lock-fill me-1"></i>ربط المستخدمين</a>
        <span class="as-breadcrumb-sep">/</span>
        <span>@(isEdit ? "تعديل الربط" : "ربط مستخدم جديد")</span>
    </div>

    @* ── Page Header ── *@
    <div class="as-page-header">
        <div class="as-page-icon @(isEdit ? "mode-edit" : "mode-new")">
            <i class="bi @(isEdit ? "bi-pencil-square" : "bi-person-plus-fill")"></i>
        </div>
        <div>
            <h1>@(isEdit ? "تعديل ربط المستخدم" : "ربط مستخدم جديد")</h1>
            <p>
                @(isEdit
                    ? "تغيير ملف الصلاحيات المرتبط بالمستخدم — تأكد من الاسم والبريد قبل الحفظ"
                    : "اختر المستخدم الإداري وحدد ملف الصلاحيات المناسب له")
            </p>
        </div>
    </div>

    @* ── Layout ── *@
    <div class="as-layout">

        @* ════════════════════════════════════════
           Main form card
        ════════════════════════════════════════ *@
        <div class="as-card">
            <div class="as-card-head">
                <div class="as-card-head-ico"
                     style="background:@(isEdit ? "#eff6ff" : "#f0fdf4");color:@(isEdit ? "#3b82f6" : "#22c55e");">
                    <i class="bi @(isEdit ? "bi-arrow-repeat" : "bi-link-45deg")"></i>
                </div>
                <h2>@(isEdit ? "تعديل بيانات الربط" : "بيانات الربط الجديد")</h2>
            </div>

            <div class="as-card-body">

                @* ── Edit mode: confirm banner ── *@
                @if (isEdit)
                {
                    <div class="as-edit-banner">
                        <div class="as-edit-banner-icon">
                            <i class="bi bi-person-check-fill"></i>
                        </div>
                        <div style="flex:1;min-width:0;">
                            <div class="as-edit-banner-label">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                تأكيد هوية المستخدم — أنت تعدّل ربط:
                            </div>
                            <div class="as-edit-user-name">@Model.EditUserName</div>
                            @if (!string.IsNullOrEmpty(Model.EditUserEmail))
                            {
                                <div class="as-edit-user-email">
                                    <i class="bi bi-envelope-fill me-1" style="font-size:11px;"></i>
                                    @Model.EditUserEmail
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.EditCurrentProfile))
                            {
                                <div>
                                    <span class="as-edit-prev-profile">
                                        <i class="bi bi-file-earmark-lock2-fill"></i>
                                        الملف الحالي: @Model.EditCurrentProfile
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <form method="post" id="assignForm">
                    @Html.AntiForgeryToken()

                    @* Validation summary *@
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="as-val-error">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            @Html.ValidationSummary(false, null, new { @class = "" })
                        </div>
                    }

                    @* ── User field ── *@
                    <div class="as-field">
                        <label class="as-label" for="UserId">
                            <i class="bi bi-person-fill" style="color:#3b82f6;"></i>
                            المستخدم
                            <span class="as-label-req">*</span>
                        </label>
                        @if (isEdit)
                        {
                            @* في وضع التعديل: الاسم معروض فقط — الـ userId محدد مسبقاً *@
                            <input type="hidden" asp-for="UserId" />
                            <div class="as-select-wrap">
                                <select class="as-select" disabled>
                                    <option selected>@Model.EditUserName</option>
                                </select>
                                <i class="bi bi-person-fill" style="color:#94a3b8;"></i>
                            </div>
                            <div style="font-size:12px;font-weight:700;color:var(--as-muted);">
                                <i class="bi bi-info-circle me-1"></i>
                                المستخدم محدد مسبقاً — يمكنك تغيير الملف فقط
                            </div>
                        }
                        else
                        {
                            <div class="as-select-wrap">
                                <select asp-for="UserId" asp-items="Model.Users"
                                        class="as-select" id="userSelect">
                                    <option value="">— اختر المستخدم —</option>
                                </select>
                                <i class="bi bi-chevron-down" style="font-size:12px;"></i>
                            </div>
                            <span asp-validation-for="UserId" class="field-validation-error"></span>

                            @* Preview pill when user selected *@
                            <div class="as-preview-pill" id="userPreview">
                                <i class="bi bi-check-circle-fill"></i>
                                <span id="userPreviewText">—</span>
                            </div>
                        }
                    </div>

                    @* ── Profile field ── *@
                    <div class="as-field">
                        <label class="as-label" for="AdminProfileId">
                            <i class="bi bi-file-earmark-lock2-fill" style="color:#8b5cf6;"></i>
                            ملف الصلاحيات
                            <span class="as-label-req">*</span>
                        </label>
                        <div class="as-label-hint">
                            اختر الملف المناسب — سيُطبَّق فور تسجيل الدخول التالي للمستخدم
                        </div>
                        <div class="as-select-wrap">
                            <select asp-for="AdminProfileId" asp-items="Model.Profiles"
                                    class="as-select" id="profileSelect">
                                <option value="">— اختر ملف الصلاحيات —</option>
                            </select>
                            <i class="bi bi-chevron-down" style="font-size:12px;"></i>
                        </div>
                        <span asp-validation-for="AdminProfileId" class="field-validation-error"></span>

                        @* Preview pill when profile selected *@
                        <div class="as-preview-pill" id="profilePreview">
                            <i class="bi bi-shield-check-fill"></i>
                            تم اختيار: <span id="profilePreviewText" style="font-weight:900;">—</span>
                        </div>
                    </div>

                    @* ── Submit ── *@
                    <div style="display:flex;flex-direction:column;gap:0;padding-top:6px;">
                        <button type="submit" class="as-btn-submit @(isEdit ? "mode-edit" : "mode-new")">
                            <i class="bi @(isEdit ? "bi-arrow-repeat" : "bi-floppy-fill")"></i>
                            @(isEdit ? "حفظ التعديل" : "ربط المستخدم")
                        </button>
                        <a asp-action="Index" class="as-btn-cancel">
                            <i class="bi bi-x-circle"></i>
                            إلغاء والعودة
                        </a>
                    </div>

                </form>
            </div>
        </div>

        @* ════════════════════════════════════════
           Info sidebar
        ════════════════════════════════════════ *@
        <div style="display:flex;flex-direction:column;gap:var(--as-gap);">

            @* Tips card *@
            <div class="as-info-card">
                <div class="as-info-head">
                    <i class="bi bi-lightbulb-fill" style="color:#f59e0b;"></i>
                    ملاحظات مهمة
                </div>
                <div class="as-info-body">
                    <div class="as-info-tip">
                        <div class="as-tip-dot" style="background:#fef3c7;color:#d97706;">
                            <i class="bi bi-1-circle-fill"></i>
                        </div>
                        <div>
                            <div class="as-tip-title">ربط واحد فقط لكل مستخدم</div>
                            <div class="as-tip-desc">كل مستخدم يمكنه الارتباط بملف صلاحيات واحد فقط — الربط القديم يُستبدل تلقائياً</div>
                        </div>
                    </div>
                    <div class="as-info-tip">
                        <div class="as-tip-dot" style="background:#f0fdf4;color:#16a34a;">
                            <i class="bi bi-2-circle-fill"></i>
                        </div>
                        <div>
                            <div class="as-tip-title">تفعيل فوري بعد إعادة الدخول</div>
                            <div class="as-tip-desc">تُطبَّق الصلاحيات الجديدة تلقائياً بعد تسجيل خروج المستخدم وإعادة دخوله</div>
                        </div>
                    </div>
                    <div class="as-info-tip">
                        <div class="as-tip-dot" style="background:#fef2f2;color:#dc2626;">
                            <i class="bi bi-3-circle-fill"></i>
                        </div>
                        <div>
                            <div class="as-tip-title">تأكد من الاسم والبريد</div>
                            <div class="as-tip-desc">في وضع التعديل يظهر الاسم والبريد الإلكتروني للتأكد من تعديل الشخص الصحيح</div>
                        </div>
                    </div>
                </div>
            </div>

            @* Profiles legend *@
            @if (Model.Profiles.Any())
            {
                <div class="as-info-card">
                    <div class="as-info-head">
                        <i class="bi bi-file-earmark-lock2-fill" style="color:#8b5cf6;"></i>
                        الملفات المتاحة (@Model.Profiles.Count)
                    </div>
                    <div class="as-info-body" style="padding:12px 18px;">
                        @{
                            var legendColors = new[] { "#3b82f6","#8b5cf6","#14b8a6","#f59e0b","#22c55e","#ef4444" };
                            var li = 0;
                        }
                        @foreach (var p in Model.Profiles)
                        {
                            <div class="as-legend-item">
                                <div class="as-legend-dot" style="background:@legendColors[li % legendColors.Length];"></div>
                                @p.Text
                            </div>
                            li++;
                        }
                    </div>
                </div>
            }

        </div>
    </div>
</div>

<script>
(function () {
    /* User select → preview pill */
    const userSel     = document.getElementById('userSelect');
    const userPreview = document.getElementById('userPreview');
    const userPreviewText = document.getElementById('userPreviewText');

    if (userSel) {
        userSel.addEventListener('change', function () {
            const txt = this.options[this.selectedIndex]?.text ?? '';
            const has = this.value !== '';
            if (userPreview)      userPreview.classList.toggle('active', has);
            if (userPreviewText)  userPreviewText.textContent = txt;
        });
        // trigger on load if pre-selected
        if (userSel.value) userSel.dispatchEvent(new Event('change'));
    }

    /* Profile select → preview pill */
    const profileSel     = document.getElementById('profileSelect');
    const profilePreview = document.getElementById('profilePreview');
    const profilePreviewText = document.getElementById('profilePreviewText');

    if (profileSel) {
        profileSel.addEventListener('change', function () {
            const txt = this.options[this.selectedIndex]?.text ?? '';
            const has = this.value !== '';
            if (profilePreview)     profilePreview.classList.toggle('active', has);
            if (profilePreviewText) profilePreviewText.textContent = txt;
        });
        // trigger on load if pre-selected
        if (profileSel.value) profileSel.dispatchEvent(new Event('change'));
    }
})();
</script>
