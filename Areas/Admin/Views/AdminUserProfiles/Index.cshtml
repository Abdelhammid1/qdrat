@model List<QdratNew.ViewModels.Admin.AdminUserProfileIndexVM>
@{
    ViewData["Title"] = "ربط المستخدمين بملفات الصلاحيات";
    var totalUsers    = Model?.Count ?? 0;
    var profiles      = Model?.Select(x => x.ProfileName).Distinct().OrderBy(x => x).ToList() ?? new();
}

@* ── Assets ───────────────────────────────────────────────────────────── *@
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

<style>
:root {
    --aup-bg:        #f1f4f9;
    --aup-surface:   #ffffff;
    --aup-border:    #e2e8f0;
    --aup-text:      #0f172a;
    --aup-muted:     #64748b;
    --aup-primary:   #3b82f6;
    --aup-success:   #22c55e;
    --aup-danger:    #ef4444;
    --aup-warning:   #f59e0b;
    --aup-violet:    #8b5cf6;
    --aup-teal:      #14b8a6;
    --aup-r:         14px;
    --aup-r-sm:      9px;
    --aup-gap:       20px;
}

*, *::before, *::after { box-sizing: border-box; }

.aup-root {
    direction:   rtl;
    font-family: 'Cairo', Tahoma, sans-serif;
    background:  var(--aup-bg);
    color:       var(--aup-text);
    min-height:  100vh;
    padding:     28px 20px 48px;
}

/* ── Page title ──────────────────────────────────────────────────────── */
.aup-page-title {
    display:       flex;
    align-items:   center;
    gap:           14px;
    margin-bottom: 28px;
}
.aup-page-icon {
    width: 48px; height: 48px; border-radius: 13px;
    background: linear-gradient(135deg,#3b82f6,#6366f1);
    color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; flex-shrink: 0;
    box-shadow: 0 6px 20px rgba(99,102,241,.35);
}
.aup-page-title h1 {
    font-size:   22px;
    font-weight: 900;
    color:       var(--aup-text);
    margin:      0 0 2px;
    line-height: 1.2;
}
.aup-page-title p {
    font-size:  12.5px;
    color:      var(--aup-muted);
    margin:     0;
    font-weight:600;
}

/* ── Alert messages ──────────────────────────────────────────────────── */
.aup-alert {
    display:       flex;
    align-items:   center;
    gap:           10px;
    padding:       13px 18px;
    border-radius: var(--aup-r-sm);
    font-size:     14px;
    font-weight:   700;
    margin-bottom: 20px;
    border:        1.5px solid;
}
.aup-alert-success { background:#f0fdf4; color:#15803d; border-color:#bbf7d0; }
.aup-alert-error   { background:#fef2f2; color:#dc2626; border-color:#fecaca; }

/* ── Stats strip ─────────────────────────────────────────────────────── */
.aup-stats {
    display:       grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap:           var(--aup-gap);
    margin-bottom: var(--aup-gap);
}
.aup-stat-card {
    background:    var(--aup-surface);
    border:        1.5px solid var(--aup-border);
    border-radius: var(--aup-r);
    padding:       18px 20px;
    display:       flex;
    align-items:   center;
    gap:           14px;
    box-shadow:    0 2px 10px rgba(0,0,0,.04);
    transition:    box-shadow .2s, transform .2s;
}
.aup-stat-card:hover { box-shadow: 0 6px 24px rgba(0,0,0,.08); transform: translateY(-2px); }
.aup-stat-ico {
    width: 42px; height: 42px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; flex-shrink: 0;
}
.aup-stat-val { font-size: 26px; font-weight: 900; line-height: 1; }
.aup-stat-lbl { font-size: 12px; color: var(--aup-muted); font-weight: 700; margin-top: 2px; }

/* ── Toolbar ─────────────────────────────────────────────────────────── */
.aup-toolbar {
    display:       flex;
    align-items:   center;
    gap:           12px;
    flex-wrap:     wrap;
    background:    var(--aup-surface);
    border:        1.5px solid var(--aup-border);
    border-radius: var(--aup-r);
    padding:       14px 18px;
    margin-bottom: var(--aup-gap);
    box-shadow:    0 2px 10px rgba(0,0,0,.04);
}
.aup-search-wrap {
    position:  relative;
    flex:      1;
    min-width: 200px;
}
.aup-search-wrap i {
    position:  absolute;
    right:     12px;
    top:       50%;
    transform: translateY(-50%);
    color:     var(--aup-muted);
    font-size: 15px;
    pointer-events: none;
}
.aup-search {
    width:         100%;
    padding:       9px 38px 9px 14px;
    border:        1.5px solid var(--aup-border);
    border-radius: var(--aup-r-sm);
    font-size:     14px;
    font-family:   inherit;
    color:         var(--aup-text);
    background:    #f8fafc;
    transition:    border-color .2s, box-shadow .2s;
    outline:       none;
    direction:     rtl;
}
.aup-search:focus { border-color: var(--aup-primary); box-shadow: 0 0 0 3px rgba(59,130,246,.12); background:#fff; }

.aup-filter-select {
    padding:       9px 14px;
    border:        1.5px solid var(--aup-border);
    border-radius: var(--aup-r-sm);
    font-size:     13.5px;
    font-family:   inherit;
    color:         var(--aup-text);
    background:    #f8fafc;
    cursor:        pointer;
    outline:       none;
    direction:     rtl;
    min-width:     160px;
    transition:    border-color .2s;
}
.aup-filter-select:focus { border-color: var(--aup-primary); }

.aup-btn-assign {
    display:       inline-flex;
    align-items:   center;
    gap:           7px;
    padding:       9px 20px;
    background:    linear-gradient(135deg,#3b82f6,#6366f1);
    color:         #fff;
    border:        none;
    border-radius: var(--aup-r-sm);
    font-size:     13.5px;
    font-weight:   800;
    font-family:   inherit;
    text-decoration: none;
    cursor:        pointer;
    transition:    box-shadow .2s, transform .15s;
    white-space:   nowrap;
    box-shadow:    0 4px 14px rgba(99,102,241,.35);
    flex-shrink:   0;
}
.aup-btn-assign:hover { box-shadow: 0 6px 20px rgba(99,102,241,.45); transform: translateY(-1px); color:#fff; }

/* ── Cards grid ──────────────────────────────────────────────────────── */
.aup-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap:    var(--aup-gap);
}

.aup-card {
    background:    var(--aup-surface);
    border:        1.5px solid var(--aup-border);
    border-radius: var(--aup-r);
    overflow:      hidden;
    box-shadow:    0 2px 12px rgba(0,0,0,.04);
    transition:    box-shadow .25s, transform .25s, border-color .25s;
    display:       flex;
    flex-direction:column;
}
.aup-card:hover {
    box-shadow:    0 8px 32px rgba(0,0,0,.10);
    transform:     translateY(-3px);
    border-color:  #c7d2fe;
}

/* Top accent stripe colored by profile */
.aup-card-stripe {
    height:     4px;
    width:      100%;
    flex-shrink:0;
}

.aup-card-body {
    padding:    20px 20px 16px;
    flex:       1;
    display:    flex;
    flex-direction: column;
    gap:        14px;
}

/* User row */
.aup-user-row {
    display:     flex;
    align-items: center;
    gap:         12px;
}
.aup-avatar {
    width:  44px; height: 44px; border-radius: 50%;
    display:flex; align-items:center; justify-content:center;
    font-size:17px; font-weight:900; flex-shrink:0;
    border: 2px solid var(--aup-border);
}
.aup-user-name { font-size:15.5px; font-weight:900; color:var(--aup-text); line-height:1.2; }
.aup-user-id   { font-size:11px;   font-weight:700; color:var(--aup-muted); margin-top:2px; }

/* Profile badge */
.aup-profile-block {
    display:       flex;
    align-items:   center;
    gap:           10px;
    background:    #f8fafc;
    border:        1.5px solid var(--aup-border);
    border-radius: var(--aup-r-sm);
    padding:       10px 14px;
}
.aup-profile-ico {
    width:  32px; height: 32px; border-radius: 9px;
    display:flex; align-items:center; justify-content:center;
    font-size:14px; flex-shrink:0;
}
.aup-profile-label { font-size:11px; font-weight:700; color:var(--aup-muted); }
.aup-profile-name  { font-size:14px; font-weight:900; color:var(--aup-text); margin-top:1px; }
.aup-link-arrow {
    margin-inline-start: auto;
    font-size: 18px;
    color: var(--aup-muted);
    opacity: .4;
}

/* Meta row */
.aup-meta {
    display:     flex;
    align-items: center;
    gap:         6px;
    font-size:   12px;
    font-weight: 700;
    color:       var(--aup-muted);
}
.aup-meta i { font-size:13px; }

/* Card footer actions */
.aup-card-footer {
    display:     flex;
    align-items: center;
    gap:         8px;
    padding:     12px 20px;
    border-top:  1.5px solid var(--aup-border);
    background:  #fafbfc;
}
.aup-btn {
    display:       inline-flex;
    align-items:   center;
    gap:           5px;
    padding:       7px 14px;
    border-radius: 8px;
    font-size:     13px;
    font-weight:   800;
    font-family:   inherit;
    cursor:        pointer;
    text-decoration: none;
    transition:    all .2s;
    border:        1.5px solid;
    white-space:   nowrap;
}
.aup-btn-edit {
    background: #eff6ff; color: #2563eb; border-color: #bfdbfe;
}
.aup-btn-edit:hover { background:#dbeafe; color:#1d4ed8; border-color:#93c5fd; }

.aup-btn-remove {
    background: #fff; color: var(--aup-danger); border-color: #fecaca;
    margin-inline-start: auto;
}
.aup-btn-remove:hover { background: #fef2f2; border-color: #fca5a5; }

/* ── Empty state ─────────────────────────────────────────────────────── */
.aup-empty {
    grid-column: 1/-1;
    text-align:  center;
    padding:     72px 24px;
    color:       var(--aup-muted);
}
.aup-empty i     { font-size:56px; opacity:.2; display:block; margin-bottom:16px; }
.aup-empty h3    { font-size:18px; font-weight:800; margin-bottom:8px; color:var(--aup-text); }
.aup-empty p     { font-size:13.5px; }

/* ── No-results (JS-driven) ──────────────────────────────────────────── */
#aupNoResults {
    display:    none;
    grid-column:1/-1;
    text-align: center;
    padding:    60px 24px;
    color:      var(--aup-muted);
}
#aupNoResults i { font-size:48px; opacity:.2; display:block; margin-bottom:14px; }

/* ── Results count badge ─────────────────────────────────────────────── */
.aup-count-badge {
    display:       inline-flex;
    align-items:   center;
    gap:           5px;
    padding:       4px 12px;
    background:    #eff6ff;
    color:         #2563eb;
    border:        1.5px solid #bfdbfe;
    border-radius: 50px;
    font-size:     12.5px;
    font-weight:   800;
    margin-inline-start: auto;
}

@@media (max-width: 640px) {
    .aup-grid { grid-template-columns: 1fr; }
    .aup-toolbar { flex-direction: column; align-items: stretch; }
    .aup-btn-assign { justify-content: center; }
}
</style>

<div class="aup-root">

    @* ── Alert Messages ── *@
    @if (TempData["Success"] != null)
    {
        <div class="aup-alert aup-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="aup-alert aup-alert-error">
            <i class="bi bi-exclamation-triangle-fill"></i>
            @TempData["Error"]
        </div>
    }

    @* ── Page Title ── *@
    <div class="aup-page-title">
        <div class="aup-page-icon">
            <i class="bi bi-shield-lock-fill"></i>
        </div>
        <div>
            <h1>ربط المستخدمين بملفات الصلاحيات</h1>
            <p>إدارة وتتبع ارتباط كل مستخدم إداري بملف صلاحياته</p>
        </div>
    </div>

    @* ── Stats Strip ── *@
    <div class="aup-stats">
        <div class="aup-stat-card">
            <div class="aup-stat-ico" style="background:#eff6ff;color:#3b82f6;">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <div class="aup-stat-val" style="color:#3b82f6;">@totalUsers</div>
                <div class="aup-stat-lbl">مستخدم مرتبط</div>
            </div>
        </div>
        <div class="aup-stat-card">
            <div class="aup-stat-ico" style="background:#f5f3ff;color:#8b5cf6;">
                <i class="bi bi-file-earmark-lock2-fill"></i>
            </div>
            <div>
                <div class="aup-stat-val" style="color:#8b5cf6;">@profiles.Count</div>
                <div class="aup-stat-lbl">ملف صلاحيات مُستخدم</div>
            </div>
        </div>
        <div class="aup-stat-card">
            <div class="aup-stat-ico" style="background:#f0fdf4;color:#22c55e;">
                <i class="bi bi-link-45deg"></i>
            </div>
            <div>
                <div class="aup-stat-val" style="color:#22c55e;">@totalUsers</div>
                <div class="aup-stat-lbl">ربط نشط</div>
            </div>
        </div>
    </div>

    @* ── Toolbar ── *@
    <div class="aup-toolbar">
        <div class="aup-search-wrap">
            <i class="bi bi-search"></i>
            <input class="aup-search" id="aupSearch"
                   type="text" placeholder="ابحث بالاسم أو ملف الصلاحيات…" autocomplete="off">
        </div>

        <select class="aup-filter-select" id="aupProfileFilter">
            <option value="">كل الملفات</option>
            @foreach (var p in profiles)
            {
                <option value="@p">@p</option>
            }
        </select>

        <div class="aup-count-badge">
            <i class="bi bi-funnel-fill"></i>
            <span id="aupCountLabel">@totalUsers</span> نتيجة
        </div>

        <a asp-action="Assign" class="aup-btn-assign">
            <i class="bi bi-plus-circle-fill"></i>
            ربط مستخدم جديد
        </a>
    </div>

    @* ── Cards Grid ── *@
    @if (Model == null || !Model.Any())
    {
        <div class="aup-grid">
            <div class="aup-empty">
                <i class="bi bi-shield-x"></i>
                <h3>لا يوجد مستخدمون مرتبطون</h3>
                <p>ابدأ بربط مستخدم بملف صلاحيات من خلال الزر أعلاه</p>
            </div>
        </div>
    }
    else
    {
        <div class="aup-grid" id="aupGrid">

            @{
                // نظام ألوان تلقائي لكل بروفايل
                var profileColors = new[] {
                    ("linear-gradient(90deg,#3b82f6,#6366f1)", "#eff6ff", "#3b82f6"),
                    ("linear-gradient(90deg,#8b5cf6,#a78bfa)", "#f5f3ff", "#8b5cf6"),
                    ("linear-gradient(90deg,#14b8a6,#06b6d4)", "#f0fdfa", "#14b8a6"),
                    ("linear-gradient(90deg,#f59e0b,#f97316)", "#fffbeb", "#f59e0b"),
                    ("linear-gradient(90deg,#22c55e,#16a34a)", "#f0fdf4", "#22c55e"),
                    ("linear-gradient(90deg,#ef4444,#f97316)", "#fef2f2", "#ef4444"),
                };
                var colorMap = new Dictionary<string, (string grad, string bg, string fg)>();
                var ci = 0;
                foreach (var pn in profiles)
                {
                    colorMap[pn] = profileColors[ci % profileColors.Length];
                    ci++;
                }
            }

            @foreach (var item in Model)
            {
                var (grad, cbg, cfg) = colorMap.TryGetValue(item.ProfileName, out var c)
                    ? c : profileColors[0];

                // Avatar initials
                var initials = string.IsNullOrWhiteSpace(item.UserName)
                    ? "؟"
                    : string.Join("", item.UserName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                        .Take(2).Select(w => w.Length > 0 ? w[0].ToString() : ""));
            <div class="aup-card"
                 data-name="@item.UserName.ToLower()"
                 data-profile="@item.ProfileName">

                <div class="aup-card-stripe" style="background:@grad;"></div>

                <div class="aup-card-body">

                    @* User identity *@
                    <div class="aup-user-row">
                        <div class="aup-avatar"
                             style="background:@cbg; color:@cfg; border-color:@cbg;">
                            @initials
                        </div>
                        <div>
                            <div class="aup-user-name">@item.UserName</div>
                            <div class="aup-user-id">
                                <i class="bi bi-hash" style="font-size:10px;"></i>
                                معرف @item.Id
                            </div>
                        </div>
                    </div>

                    @* Link arrow + profile block *@
                    <div style="display:flex;align-items:center;gap:6px;">
                        <i class="bi bi-arrow-down" style="color:var(--aup-muted);font-size:14px;opacity:.4;flex-shrink:0;"></i>
                        <div class="aup-profile-block" style="flex:1;border-color:@cbg;">
                            <div class="aup-profile-ico" style="background:@cbg;color:@cfg;">
                                <i class="bi bi-file-earmark-lock2-fill"></i>
                            </div>
                            <div>
                                <div class="aup-profile-label">ملف الصلاحيات المرتبط</div>
                                <div class="aup-profile-name">@item.ProfileName</div>
                            </div>
                            <i class="bi bi-shield-check aup-link-arrow" style="color:@cfg;opacity:.5;"></i>
                        </div>
                    </div>

                    @* Meta *@
                    <div class="aup-meta">
                        <i class="bi bi-calendar2-check"></i>
                        تاريخ الربط:
                        <span style="color:var(--aup-text);font-weight:800;">
                            @item.AssignedAt.ToString("yyyy/MM/dd")
                        </span>
                        <span style="color:var(--aup-muted);opacity:.7;">
                            @item.AssignedAt.ToString("HH:mm")
                        </span>
                    </div>

                </div>

                @* Footer actions *@
                <div class="aup-card-footer">
                    <a asp-action="Assign"
                       asp-route-userId="@item.Id"
                       class="aup-btn aup-btn-edit">
                        <i class="bi bi-pencil-fill"></i>
                        تعديل الربط
                    </a>

                    <form asp-action="RemoveUserFromProfile"
                          method="post"
                          class="d-inline"
                          onsubmit="return confirmRemove('@item.UserName', '@item.ProfileName')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@item.UserId" />
                        <button type="submit" class="aup-btn aup-btn-remove">
                            <i class="bi bi-trash3-fill"></i>
                            إلغاء الربط
                        </button>
                    </form>
                </div>

            </div>
            }

            <div id="aupNoResults">
                <i class="bi bi-search"></i>
                <p style="font-size:15px;font-weight:700;">لا توجد نتائج تطابق البحث</p>
            </div>

        </div>
    }

</div>

<script>
(function () {
    const searchInput  = document.getElementById('aupSearch');
    const profileSel   = document.getElementById('aupProfileFilter');
    const cards        = document.querySelectorAll('.aup-card');
    const countLabel   = document.getElementById('aupCountLabel');
    const noResults    = document.getElementById('aupNoResults');

    function filter() {
        const q       = (searchInput?.value ?? '').trim().toLowerCase();
        const profile = (profileSel?.value ?? '').toLowerCase();
        let visible   = 0;

        cards.forEach(card => {
            const name    = (card.dataset.name    ?? '').toLowerCase();
            const pname   = (card.dataset.profile ?? '').toLowerCase();
            const matchQ  = !q || name.includes(q) || pname.includes(q);
            const matchP  = !profile || pname === profile;
            const show    = matchQ && matchP;

            card.style.display = show ? '' : 'none';
            if (show) visible++;
        });

        if (countLabel) countLabel.textContent = visible;
        if (noResults)  noResults.style.display = visible === 0 && cards.length > 0 ? 'block' : 'none';
    }

    searchInput?.addEventListener('input',  filter);
    profileSel?.addEventListener('change',  filter);

    filter(); // initial pass
})();

function confirmRemove(userName, profileName) {
    return confirm(
        `هل تريد فعلاً إلغاء ربط "${userName}" بملف الصلاحيات "${profileName}"؟\n` +
        `سيفقد المستخدم جميع الصلاحيات المرتبطة بهذا الملف.`
    );
}
</script>
