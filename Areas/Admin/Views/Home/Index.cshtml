@model QdratNew.Areas.Admin.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "لوحة التحكم";
}



<div class="container-fluid py-4">

    <h4 class="fw-bold mb-4">لوحة التحكم</h4>

    <!-- 🔹 الكروت الرئيسية -->
    <div class="row g-3">
        <div class="col-md-3">
            <div class="card-soft p-3 text-center">
                <h6>عدد الطلاب</h6>
                <div class="card-value">@Model.TotalStudents</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-soft p-3 text-center">
                <h6>عدد الدفعات</h6>
                <div class="card-value">@Model.ActiveBatches</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-soft p-3 text-center">
                <h6>عدد الاختبارات</h6>
                <div class="card-value">@Model.TotalExams</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-soft p-3 text-center">
                <h6>عدد الأسئلة</h6>
                <div class="card-value">@Model.TotalQuestions</div>
            </div>
        </div>
    </div>




        <!-- 🔹 اختصارات الإدارة -->
    <div class="section-title">اختصارات الإدارة</div>
    <div class="row g-3">
        <div class="col-md-3">
            <a asp-area="Admin" asp-controller="Students" asp-action="Index"
               class="card-soft p-3 text-center link-card d-block">
                الطلاب
            </a>
        </div>
        <div class="col-md-3">
            <a asp-area="Admin" asp-controller="Batches" asp-action="Index"
               class="card-soft p-3 text-center link-card d-block">
                الدفعات
            </a>
        </div>
        <div class="col-md-3">
            <a asp-area="Internal" asp-controller="QuestionBankExplorer" asp-action="Index"
               class="card-soft p-3 text-center link-card d-block">
                بنك الأسئلةالجديدة
            </a>
        </div>
        <div class="col-md-3">
            <a asp-area="Admin" asp-controller="ExamAssignments" asp-action="Index"
               class="card-soft p-3 text-center link-card d-block">
                الاختبارات
            </a>
        </div>
    </div>



    <!-- 🔹 إحصائيات بنك الأسئلة -->
    <div class="section-title">إحصائيات بنك الأسئلة</div>

    @foreach (var curriculum in Model.QuestionBankStatsByCurriculum)
    {
        <div class="card-soft mb-3">
            <div class="p-3 border-bottom fw-bold">
                📘 @curriculum.CurriculumTitle
            </div>

            <div class="p-3">
                <div class="row g-3">
                    @foreach (var stat in curriculum.Sections)
                    {
                        var percent = stat.LessonsCount == 0
                        ? 0
                        : (int)Math.Round((double)stat.QuestionsCount / stat.LessonsCount * 100);

                        var bar =
                        percent < 20 ? "bg-danger" :
                        percent < 60 ? "bg-warning" :
                        "bg-success";

                        <div class="col-md-3">
                            <a asp-area="Admin"
                               asp-controller="Questions"
                               asp-action="ListBySection"
                               asp-route-sectionId="@stat.SectionId"
                               class="text-dark text-decoration-none link-card">

                                <div class="border rounded p-3 h-100">
                                    <div class="fw-bold mb-1">@stat.SectionTitle</div>
                                    <div class="small text-muted">
                                        مؤشرات: @stat.LessonsCount |
                                        أسئلة: @stat.QuestionsCount
                                    </div>

                                    <div class="progress mt-2">
                                        <div class="progress-bar @bar" style="width:@percent%"></div>
                                    </div>

                                    <div class="small text-muted mt-1">
                                        تغطية: @percent%
                                    </div>
                                </div>
                            </a>
                        </div>
                    }

                    <div class="col-md-3">
                        <div class="border rounded p-3 bg-light h-100">
                            <div class="fw-bold mb-2">الإجمالي</div>
                            <div class="small">
                                مؤشرات:
                                <strong>@curriculum.Sections.Sum(s => s.LessonsCount)</strong>
                            </div>
                            <div class="small">
                                أسئلة:
                                <strong>@curriculum.Sections.Sum(s => s.QuestionsCount)</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- 🔹 تنبيهات الإدارة -->
    <div class="section-title">تنبيهات الإدارة</div>
    <div class="row g-3">
        <div class="col-md-3">
            <div class="card-soft p-3 text-center">
                <h6>لم يحلوا آخر واجب</h6>
                <div class="card-value text-danger">
                    @Model.StudentsDidNotSolveLastHomework
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-soft p-3 text-center">
                <h6>تأخروا عن واجبين</h6>
                <div class="card-value text-warning">
                    @Model.StudentsLateTwoHomeworks
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-soft p-3 text-center">
                <h6>خطط غير منفذة</h6>
                <div class="card-value">
                    @Model.StudentsWithPlansNotResponded
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-soft p-3 text-center">
                <h6>إشعارات اليوم</h6>
                <div class="card-value">
                    @(Model.AdminNotifications?.Count ?? 0)
                </div>
            </div>
        </div>
    </div>


    <!-- 🔹 آخر الأنشطة -->
    <div class="section-title">آخر الأنشطة</div>
    <div class="card-soft">
        <ul class="list-group list-group-flush">
            @foreach (var activity in Model.RecentAdminActivities)
            {
                <li class="list-group-item d-flex justify-content-between">
                    <span>
                        <strong>@activity.AdminName</strong> — @activity.ActionType
                    </span>
                    <small class="text-muted">@activity.Timestamp.ToString("g")</small>
                </li>
            }
        </ul>
    </div>

</div>
