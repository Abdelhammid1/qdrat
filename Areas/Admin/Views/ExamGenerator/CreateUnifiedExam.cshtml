@model QdratNew.ViewModels.Exam.UnifiedExamCreationViewModel
@{
    ViewData["Title"] = "إنشاء اختبار مدمج";
}

<style>
    .qdrat-page {
        direction: rtl;
        text-align: right;
    }

    .qdrat-hero {
        background: linear-gradient(135deg, #111827 0%, #4338ca 48%, #2563eb 100%);
        border-radius: 24px;
        padding: 28px;
        color: #fff;
        position: relative;
        overflow: hidden;
        box-shadow: 0 18px 45px rgba(17, 24, 39, .18);
        margin-bottom: 24px;
    }

        .qdrat-hero::before {
            content: "";
            position: absolute;
            width: 230px;
            height: 230px;
            border-radius: 50%;
            background: rgba(255,255,255,.10);
            left: -75px;
            top: -85px;
        }

        .qdrat-hero::after {
            content: "";
            position: absolute;
            width: 155px;
            height: 155px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            right: 48px;
            bottom: -88px;
        }

    .qdrat-hero-content {
        position: relative;
        z-index: 2;
    }

    .qdrat-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.24);
        border-radius: 999px;
        padding: 7px 14px;
        font-size: 13px;
        margin-bottom: 14px;
    }

    .qdrat-hero h2 {
        font-weight: 900;
        margin-bottom: 8px;
        letter-spacing: -.3px;
    }

    .qdrat-hero p {
        margin: 0;
        opacity: .88;
        max-width: 780px;
        line-height: 1.9;
    }

    .qdrat-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 22px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, .06);
        overflow: hidden;
        height: 100%;
    }

    .qdrat-card-header {
        padding: 17px 20px;
        background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .qdrat-card-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 900;
        color: #0f172a;
        margin: 0;
    }

    .qdrat-icon {
        width: 38px;
        height: 38px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #eef2ff;
        color: #4338ca;
        flex: 0 0 auto;
    }

    .qdrat-card-body {
        padding: 20px;
    }

    .qdrat-muted {
        color: #64748b;
        font-size: 13px;
        line-height: 1.8;
    }

    .qdrat-page .form-label {
        font-weight: 800;
        color: #334155;
        margin-bottom: 8px;
    }

    .qdrat-page .form-control,
    .qdrat-page .form-select {
        border-radius: 14px;
        border-color: #dbe3ef;
        min-height: 46px;
        box-shadow: none;
    }

        .qdrat-page .form-select[multiple] {
            min-height: 130px;
            padding: 10px;
        }

        .qdrat-page .form-control:focus,
        .qdrat-page .form-select:focus {
            border-color: #4338ca;
            box-shadow: 0 0 0 .2rem rgba(67, 56, 202, .12);
        }

    .qdrat-page .form-check {
        padding: 14px 42px 14px 16px;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        background: #f8fafc;
        margin-bottom: 10px;
        position: relative;
    }

    .qdrat-page .form-check-input {
        float: none;
        margin-right: -26px;
        margin-left: 10px;
    }

    .qdrat-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 18px 0 4px;
        flex-wrap: wrap;
    }

    .qdrat-btn-primary {
        border: none;
        border-radius: 16px;
        padding: 12px 24px;
        font-weight: 900;
        background: linear-gradient(135deg, #4338ca 0%, #2563eb 100%);
        color: #fff;
        box-shadow: 0 12px 24px rgba(67,56,202,.22);
    }

        .qdrat-btn-primary:hover {
            color: #fff;
            transform: translateY(-1px);
        }

    .qdrat-back-link {
        border-radius: 16px;
        padding: 12px 20px;
        font-weight: 800;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        color: #334155;
        text-decoration: none;
    }

    .qdrat-alert {
        border: 0;
        border-radius: 18px;
        box-shadow: 0 10px 25px rgba(15, 23, 42, .08);
        padding: 14px 18px;
    }

    @@media (max-width: 768px) {
        .qdrat-hero {
            padding: 22px;
            border-radius: 20px;
        }

        .qdrat-card-body {
            padding: 16px;
        }

        .qdrat-actions {
            align-items: stretch;
        }

            .qdrat-actions .btn,
            .qdrat-actions a {
                width: 100%;
                text-align: center;
            }
    }
</style>

<div class="container-fluid py-4 qdrat-page">
    <div class="qdrat-hero">
        <div class="qdrat-hero-content">
            <div class="qdrat-hero-badge">
                <i class="fas fa-layer-group"></i>
                إنشاء اختبار مدمج
            </div>
            <h2><i class="fas fa-layer-group ms-2"></i> إنشاء اختبار جديد</h2>
            <p>
                أنشئ اختبارًا مدمجًا من النماذج الاحترافية أو من بنك الأسئلة العام مع تحديد الدفعات والوقت وطريقة الأداء.
            </p>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show text-center fw-bold qdrat-alert" role="alert">
            @Html.Raw(TempData["Error"])
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show text-center fw-bold qdrat-alert" role="alert">
            @Html.Raw(TempData["Success"])
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
        </div>
    }

    <form asp-action="CreateUnifiedExam" method="post">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <div class="col-12 col-xl-7">
                <div class="qdrat-card">
                    <div class="qdrat-card-header">
                        <h5 class="qdrat-card-title">
                            <span class="qdrat-icon"><i class="fas fa-pen"></i></span>
                            البيانات الأساسية
                        </h5>
                    </div>
                    <div class="qdrat-card-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Title" class="form-label">عنوان الاختبار</label>
                                <input asp-for="Title" class="form-control" placeholder="مثلاً: اختبار منتصف الدورة" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="CourseId" class="form-label">الدورة</label>
                                <select asp-for="CourseId" class="form-select" asp-items="Model.Courses">
                                    <option value="">-- اختر الدورة --</option>
                                </select>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="SelectedBatchIds" class="form-label">الدفعات المستهدفة</label>
                                <select asp-for="SelectedBatchIds" class="form-select" multiple asp-items="Model.Batches"></select>
                                <small class="qdrat-muted d-block mt-2">يمكنك اختيار أكثر من دفعة</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-5">
                <div class="qdrat-card">
                    <div class="qdrat-card-header">
                        <h5 class="qdrat-card-title">
                            <span class="qdrat-icon"><i class="fas fa-random"></i></span>
                            طريقة التوليد
                        </h5>
                    </div>
                    <div class="qdrat-card-body">
                        <label class="form-label">اختر مصدر الأسئلة</label>

                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="GenerationMode" value="FromQuestionPools" checked />
                            <label class="form-check-label fw-bold">🧩 من النماذج - تجميع أسئلة جاهزة</label>
                        </div>

                        <div class="form-check mb-0">
                            <input class="form-check-input" type="radio" asp-for="GenerationMode" value="AutoFromBank" />
                            <label class="form-check-label fw-bold">📚 من بنك الأسئلة العام</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12" id="questionPoolArea">
                <div class="qdrat-card">
                    <div class="qdrat-card-header">
                        <h5 class="qdrat-card-title">
                            <span class="qdrat-icon"><i class="fas fa-boxes"></i></span>
                            اختيار النماذج الاحترافية
                        </h5>
                        <span class="qdrat-muted">يظهر عند اختيار التوليد من النماذج</span>
                    </div>
                    <div class="qdrat-card-body">
                        <label asp-for="SelectedQuestionPoolIds" class="form-label">اختر النماذج</label>
                        <select asp-for="SelectedQuestionPoolIds" class="form-select" multiple asp-items="Model.QuestionPools"></select>
                        <small class="qdrat-muted d-block mt-2">اختر نموذجًا أو أكثر لتوليد الأسئلة منه</small>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-6">
                <div class="qdrat-card">
                    <div class="qdrat-card-header">
                        <h5 class="qdrat-card-title">
                            <span class="qdrat-icon"><i class="fas fa-list-ol"></i></span>
                            عدد الأسئلة والمدة
                        </h5>
                    </div>
                    <div class="qdrat-card-body">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="QuestionCount" class="form-label">عدد الأسئلة</label>
                                <input asp-for="QuestionCount" class="form-control" type="number" min="5" max="200" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="DurationMinutes" class="form-label">مدة الاختبار بالدقائق</label>
                                <input asp-for="DurationMinutes" class="form-control" type="number" min="5" max="180" />
                                <small class="qdrat-muted d-block mt-2">وقت النهاية يتم حسابه تلقائيًا</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-6">
                <div class="qdrat-card">
                    <div class="qdrat-card-header">
                        <h5 class="qdrat-card-title">
                            <span class="qdrat-icon"><i class="fas fa-clock"></i></span>
                            نافذة أداء الاختبار
                        </h5>
                    </div>
                    <div class="qdrat-card-body">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="StartAt" class="form-label">وقت بدء الاختبار</label>
                                <input asp-for="StartAt" class="form-control" type="datetime-local" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="EndAt" class="form-label">وقت نهاية الاختبار</label>
                                <input asp-for="EndAt" class="form-control" type="datetime-local" />
                                <small class="qdrat-muted d-block mt-2">يجب أن يكون موعد النهاية بعد موعد البداية.</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="qdrat-card">
                    <div class="qdrat-card-header">
                        <h5 class="qdrat-card-title">
                            <span class="qdrat-icon"><i class="fas fa-school"></i></span>
                            طريقة أداء الاختبار
                        </h5>
                    </div>
                    <div class="qdrat-card-body">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <div class="form-check mb-md-0">
                                    <input class="form-check-input" type="radio" asp-for="IsInLab" value="false" checked />
                                    <label class="form-check-label fw-bold">💻 أونلاين</label>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="form-check mb-0">
                                    <input class="form-check-input" type="radio" asp-for="IsInLab" value="true" />
                                    <label class="form-check-label fw-bold">🏫 حضوري في المعمل — كود مرجعي مطلوب</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="qdrat-actions">
                    <a asp-action="Index" asp-controller="ExamAssignments" class="qdrat-back-link">
                        <i class="fas fa-arrow-right ms-1"></i>
                        عودة
                    </a>
                    <button type="submit" class="btn qdrat-btn-primary">
                        🚀 إنشاء الاختبار
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // 🔄 التحكم في ظهور اختيار النماذج حسب نوع التوليد
        document.addEventListener("DOMContentLoaded", function () {

            const radioAuto = document.querySelector("input[value='AutoFromBank']");
            const radioPools = document.querySelector("input[value='FromQuestionPools']");
            const poolArea = document.getElementById("questionPoolArea");

            function toggleArea() {
                poolArea.style.display = radioPools.checked ? "block" : "none";
            }

            radioAuto.addEventListener("change", toggleArea);
            radioPools.addEventListener("change", toggleArea);
            toggleArea();
        });
    </script>
}
