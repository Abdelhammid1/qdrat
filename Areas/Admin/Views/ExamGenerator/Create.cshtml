@model QdratNew.ViewModels.Exam.ManualExamCreationViewModel
@{
    ViewData["Title"] = "توليد اختبار يدوي";
}

<style>
    .qdrat-page {
        direction: rtl;
        text-align: right;
    }

    .qdrat-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 48%, #2563eb 100%);
        border-radius: 24px;
        padding: 28px;
        color: #fff;
        position: relative;
        overflow: hidden;
        box-shadow: 0 18px 45px rgba(15, 23, 42, .18);
        margin-bottom: 24px;
    }

        .qdrat-hero::before {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: rgba(255,255,255,.11);
            left: -70px;
            top: -80px;
        }

        .qdrat-hero::after {
            content: "";
            position: absolute;
            width: 160px;
            height: 160px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            right: 40px;
            bottom: -90px;
        }

    .qdrat-hero-content {
        position: relative;
        z-index: 2;
    }

    .qdrat-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.24);
        border-radius: 999px;
        padding: 7px 14px;
        font-size: 13px;
        margin-bottom: 14px;
    }

    .qdrat-hero h2 {
        font-weight: 900;
        margin-bottom: 8px;
        letter-spacing: -.3px;
    }

    .qdrat-hero p {
        margin: 0;
        opacity: .88;
        max-width: 760px;
        line-height: 1.9;
    }

    .qdrat-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 22px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, .06);
        overflow: hidden;
        height: 100%;
    }

    .qdrat-card-header {
        padding: 17px 20px;
        background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .qdrat-card-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 900;
        color: #0f172a;
        margin: 0;
    }

    .qdrat-icon {
        width: 38px;
        height: 38px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        color: #2563eb;
        flex: 0 0 auto;
    }

    .qdrat-card-body {
        padding: 20px;
    }

    .qdrat-muted {
        color: #64748b;
        font-size: 13px;
        line-height: 1.8;
    }

    .qdrat-page .form-label {
        font-weight: 800;
        color: #334155;
        margin-bottom: 8px;
    }

    .qdrat-page .form-control,
    .qdrat-page .form-select {
        border-radius: 14px;
        border-color: #dbe3ef;
        min-height: 46px;
        box-shadow: none;
    }

        .qdrat-page .form-control:focus,
        .qdrat-page .form-select:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .12);
        }

    .qdrat-page .form-check {
        padding: 14px 42px 14px 16px;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        background: #f8fafc;
        margin-bottom: 10px;
        position: relative;
    }

    .qdrat-page .form-check-input {
        float: none;
        margin-right: -26px;
        margin-left: 10px;
    }

    .qdrat-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 18px 0 4px;
        flex-wrap: wrap;
    }

    .qdrat-btn-primary {
        border: none;
        border-radius: 16px;
        padding: 12px 24px;
        font-weight: 900;
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        color: #fff;
        box-shadow: 0 12px 24px rgba(37,99,235,.22);
    }

        .qdrat-btn-primary:hover {
            color: #fff;
            transform: translateY(-1px);
        }

    .qdrat-back-link {
        border-radius: 16px;
        padding: 12px 20px;
        font-weight: 800;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        color: #334155;
        text-decoration: none;
    }

    .qdrat-section-row {
        border: 1px solid #e5e7eb;
        background: #f8fafc;
        border-radius: 16px;
        padding: 14px;
        margin-bottom: 12px;
    }

    .qdrat-alert {
        border: 0;
        border-radius: 18px;
        box-shadow: 0 10px 25px rgba(15, 23, 42, .08);
        padding: 14px 18px;
    }

    @@media (max-width: 768px) {
        .qdrat-hero {
            padding: 22px;
            border-radius: 20px;
        }

        .qdrat-card-body {
            padding: 16px;
        }

        .qdrat-actions {
            align-items: stretch;
        }

            .qdrat-actions .btn,
            .qdrat-actions a {
                width: 100%;
                text-align: center;
            }
    }
</style>

<div class="container-fluid py-4 qdrat-page">
    <div class="qdrat-hero">
        <div class="qdrat-hero-content">
            <div class="qdrat-hero-badge">
                <i class="bi bi-shield-check"></i>
                إنشاء اختبار يدوي
            </div>
            <h2><i class="bi bi-file-earmark-plus ms-2"></i> توليد اختبار يدوي</h2>
            <p>
                اضبط نوع الاختبار والدفعة والمنهج والمحور والإعدادات الزمنية من نفس الصفحة مع الحفاظ على نفس منطق التوليد الحالي.
            </p>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger qdrat-alert">
            <i class="bi bi-exclamation-circle ms-1"></i>
            @TempData["Error"]
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success qdrat-alert">
            <i class="bi bi-check-circle ms-1"></i>
            @TempData["Success"]
        </div>
    }

    <form asp-action="Create" method="post" class="needs-validation" novalidate>
        <div class="row g-4">
            <div class="col-12 col-xl-7">
                <div class="qdrat-card">
                    <div class="qdrat-card-header">
                        <h5 class="qdrat-card-title">
                            <span class="qdrat-icon"><i class="bi bi-pencil-square"></i></span>
                            البيانات الأساسية
                        </h5>
                    </div>
                    <div class="qdrat-card-body">
                        <div class="row g-3">
                            <div class="col-12 col-lg-7">
                                <label asp-for="Title" class="form-label">عنوان الاختبار</label>
                                <input asp-for="Title" class="form-control" placeholder="اكتب عنوان الاختبار هنا" />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-lg-5">
                                <label asp-for="ExamType" class="form-label">نوع الاختبار</label>
                                <select asp-for="ExamType" asp-items="Model.ExamTypes" class="form-select" id="ExamType"></select>
                                <span asp-validation-for="ExamType" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-5">
                <div class="qdrat-card">
                    <div class="qdrat-card-header">
                        <h5 class="qdrat-card-title">
                            <span class="qdrat-icon"><i class="bi bi-geo-alt"></i></span>
                            مكان تنفيذ الاختبار
                        </h5>
                    </div>
                    <div class="qdrat-card-body">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="IsOnline" value="true" checked />
                            <label class="form-check-label fw-bold text-success">اختبار أونلاين</label>
                        </div>
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="radio" asp-for="IsOnline" value="false" />
                            <label class="form-check-label fw-bold text-danger">اختبار حضوري</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12" id="studentGroup" style="display:none;">
                <div class="qdrat-card">
                    <div class="qdrat-card-header">
                        <h5 class="qdrat-card-title">
                            <span class="qdrat-icon"><i class="bi bi-person-badge"></i></span>
                            بيانات الطالب
                        </h5>
                    </div>
                    <div class="qdrat-card-body">
                        <label asp-for="StudentId" class="form-label">اختر الطالب</label>
                        <select asp-for="StudentId" asp-items="Model.Students" class="form-select"></select>
                        <span asp-validation-for="StudentId" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="col-12" id="batchCurriculumGroup">
                <div class="qdrat-card">
                    <div class="qdrat-card-header">
                        <h5 class="qdrat-card-title">
                            <span class="qdrat-icon"><i class="bi bi-diagram-3"></i></span>
                            بيانات الدفعة والمنهج
                        </h5>
                        <span class="qdrat-muted">تتغير الحقول حسب نوع الاختبار</span>
                    </div>
                    <div class="qdrat-card-body">
                        <div class="row g-3">
                            <div class="col-12 col-md-4" id="batchDiv">
                                <label asp-for="BatchId" class="form-label">الدفعة</label>
                                <select asp-for="BatchId" asp-items="Model.Batches" class="form-select"></select>
                                <span asp-validation-for="BatchId" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-4" id="curriculumDiv">
                                <label asp-for="CurriculumId" class="form-label">المنهج</label>
                                <select asp-for="CurriculumId" asp-items="Model.Curriculums" class="form-select"></select>
                                <span asp-validation-for="CurriculumId" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-4" id="sectionDiv">
                                <label asp-for="SectionId" class="form-label">المحور</label>
                                <select asp-for="SectionId" asp-items="Model.Sections" class="form-select"></select>
                                <span asp-validation-for="SectionId" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12" id="curriculumsQuestionGroup" style="display:none;">
                <div class="qdrat-card">
                    <div class="qdrat-card-header">
                        <h5 class="qdrat-card-title">
                            <span class="qdrat-icon"><i class="bi bi-journal-text"></i></span>
                            المناهج وعدد الأسئلة
                        </h5>
                    </div>
                    <div class="qdrat-card-body">
                        @for (int i = 0; i < Model.CurriculumQuestionCounts.Count; i++)
                        {
                            <div class="qdrat-section-row">
                                <div class="row g-3 align-items-center">
                                    <div class="col-12 col-md-6 fw-bold text-secondary">
                                        @Model.CurriculumQuestionCounts[i].CurriculumTitle
                                        <input type="hidden" asp-for="CurriculumQuestionCounts[@i].CurriculumId" />
                                        <input type="hidden" asp-for="CurriculumQuestionCounts[@i].CurriculumTitle" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <input asp-for="CurriculumQuestionCounts[@i].QuestionCount"
                                               type="number"
                                               min="0"
                                               class="form-control"
                                               placeholder="عدد الأسئلة المطلوب مثال: 30" />
                                        <span asp-validation-for="CurriculumQuestionCounts[@i].QuestionCount" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="qdrat-card">
                    <div class="qdrat-card-header">
                        <h5 class="qdrat-card-title">
                            <span class="qdrat-icon"><i class="bi bi-clock-history"></i></span>
                            الإعدادات الزمنية
                        </h5>
                    </div>
                    <div class="qdrat-card-body">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="ScheduledDate" class="form-label">وقت بداية الاختبار</label>
                                <input asp-for="ScheduledDate" type="datetime-local" class="form-control" />
                                <span asp-validation-for="ScheduledDate" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="DurationMinutes" class="form-label">مدة الاختبار بالدقائق</label>
                                <input asp-for="DurationMinutes" type="number" class="form-control" min="5" placeholder="مثلاً: 60" />
                                <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="qdrat-card">
                    <div class="qdrat-card-header">
                        <h5 class="qdrat-card-title">
                            <span class="qdrat-icon"><i class="bi bi-shuffle"></i></span>
                            ترتيب الأسئلة
                        </h5>
                    </div>
                    <div class="qdrat-card-body">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="RandomizeQuestions" />
                            <label class="form-check-label fw-bold" asp-for="RandomizeQuestions">
                                ترتيب عشوائي للأسئلة لكل طالب
                            </label>
                        </div>
                        <div class="text-muted small mt-1">
                            عند التفعيل تظهر الأسئلة لكل طالب بترتيب مختلف لمكافحة الغش. عطّله إذا كانت الأسئلة يجب أن تظهر بترتيب محدد.
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="qdrat-actions">
                    <a asp-action="Index" class="qdrat-back-link">
                        <i class="bi bi-arrow-right ms-1"></i>
                        رجوع
                    </a>
                    <button type="submit" class="btn qdrat-btn-primary">
                        <i class="bi bi-plus-circle ms-1"></i>
                        توليد الاختبار
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleFields() {
            const examType = parseInt(document.getElementById("ExamType").value);

            const isPlacement = (examType === 0);
            const isCourseExam = (examType === 2);
            const isGovernmentMock = (examType === 4);
            const isPerformanceScale = (examType === 6);
            const isSectionExam = (examType === 7);
            const isCurriculumFinal = (examType === 9);

            document.getElementById("studentGroup").style.display = isPlacement ? 'block' : 'none';

            const batchGroup = document.getElementById("batchCurriculumGroup");
            const batchDiv = document.getElementById("batchDiv");
            const curriculumDiv = document.getElementById("curriculumDiv");
            const sectionDiv = document.getElementById("sectionDiv");
            const curriculumsQuestionGroup = document.getElementById("curriculumsQuestionGroup");

            if (isPlacement) {
                batchGroup.style.display = 'none';
                curriculumsQuestionGroup.style.display = 'none';
            } else if (isCourseExam || isGovernmentMock) {
                batchGroup.style.display = 'block';
                batchDiv.style.display = 'block';
                curriculumDiv.style.display = 'none';
                sectionDiv.style.display = 'none';
                curriculumsQuestionGroup.style.display = 'block';
            } else if (isPerformanceScale || isCurriculumFinal) {
                batchGroup.style.display = 'block';
                batchDiv.style.display = 'block';
                curriculumDiv.style.display = 'block';
                sectionDiv.style.display = 'none';
                curriculumsQuestionGroup.style.display = 'none';
            } else if (isSectionExam) {
                batchGroup.style.display = 'block';
                batchDiv.style.display = 'block';
                curriculumDiv.style.display = 'block';
                sectionDiv.style.display = 'block';
                curriculumsQuestionGroup.style.display = 'none';
            } else {
                batchGroup.style.display = 'block';
                batchDiv.style.display = 'block';
                curriculumDiv.style.display = 'block';
                sectionDiv.style.display = 'block';
                curriculumsQuestionGroup.style.display = 'none';
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            toggleFields();
            document.getElementById("ExamType").addEventListener("change", toggleFields);
        });
    </script>
}
