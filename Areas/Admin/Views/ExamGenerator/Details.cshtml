@model QdratNew.ViewModels.Exam.ExamAssignmentDetailsViewModel

@{
    ViewData["Title"] = "تفاصيل الاختبار";
}

<div class="container mt-4" dir="rtl">

    <div class="card shadow border-0 mb-4">
        <div class="card-header bg-primary text-white">
            <h4 class="fw-bold m-0">📄 تفاصيل الاختبار</h4>
        </div>

        <div class="card-body">

            <h5 class="fw-bold text-primary">@Model.Assignment.Title</h5>

            <ul class="list-group mb-4">
                <li class="list-group-item"><strong>الدفعة:</strong> @Model.Assignment.Batch?.Name</li>
                <li class="list-group-item"><strong>عدد الأسئلة:</strong> @Model.Assignment.TotalQuestions</li>
                <li class="list-group-item"><strong>المدة:</strong> @Model.Assignment.DurationMinutes دقيقة</li>
                <li class="list-group-item"><strong>نوع الاختبار:</strong> @(Model.Assignment.IsInLab ? "📍 حضوري" : "💻 أونلاين")</li>
                @if (Model.Assignment.IsInLab)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span><strong>الكود المرجعي:</strong></span>
                        <span class="fw-bold text-danger" id="ref-code">@Model.Assignment.ReferenceCode</span>

                        <button class="btn btn-sm btn-outline-primary copy-btn"
                                data-code="@Model.Assignment.ReferenceCode">
                            نسخ الكود
                        </button>
                    </li>
                }

                
                
                <li class="list-group-item"><strong>موعد البدء:</strong> @Model.Assignment.ScheduledDate?.ToLocalTime().ToString("yyyy/MM/dd hh:mm tt")</li>
            </ul>

            <div class="d-flex gap-2 mb-4">
                <a asp-area="Admin" asp-controller="ExamGenerator" asp-action="EditQuestions" asp-route-id="@Model.Assignment.Id"
                   class="btn btn-warning fw-bold">
                    ✏️ تعديل الأسئلة
                </a>

                <a asp-area="Admin" asp-controller="ExamGenerator" asp-action="Preview" asp-route-id="@Model.Assignment.Id"
                   class="btn btn-outline-primary fw-bold">
                    👁️ معاينة الاختبار
                </a>

                <a asp-area="Admin" asp-controller="ExamAssignments" asp-action="Index"
                   class="btn btn-secondary fw-bold">
                    ← رجوع
                </a>
            </div>

            <h5 class="fw-bold text-secondary">📝 قائمة الأسئلة المختارة:</h5>

            <table class="table table-striped table-bordered mt-3">
                <thead class="table-dark">
                    <tr>
                        <th style="width:50px;">#</th>
                        <th>السؤال</th>
                        <th style="width:80px;">معاينة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in Model.Questions)
                    {
                        <tr>
                            <td>@q.Order</td>
                            <td>
                                @(q.Question.Title?.Length > 60
                                                            ? q.Question.Title.Substring(0, 60) + "..."
                                                            : q.Question.Title)
                        </td>
                        <td class="text-center">
                            <a asp-area="Admin" asp-controller="Questions" asp-action="Preview" asp-route-id="@q.QuestionId"
                               class="btn btn-sm btn-outline-info">👁️</a>
                        </td>
                    </tr>
                                        }
                </tbody>
            </table>

        </div>
    </div>

</div>
