@model QdratNew.Entities.ExamAssignmentToBatch
@{
    ViewData["Title"] = "تأكيد إرسال الاختبار";
}

<div class="container mt-5" dir="rtl">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white text-center">
            <h4 class="fw-bold">📢 تأكيد إرسال الاختبار</h4>
        </div>

        <div class="card-body">
            <h5 class="fw-bold text-primary mb-3">@Model.Title</h5>

            <ul class="list-group mb-3">
                <li class="list-group-item">
                    <strong>الدفعة:</strong> @Model.Batch?.Name
                </li>

                <li class="list-group-item">
                    <strong>عدد الأسئلة:</strong> @Model.TotalQuestions
                </li>

                <li class="list-group-item">
                    <strong>المدة:</strong> @Model.DurationMinutes دقيقة
                </li>

                <li class="list-group-item">
                    <strong>النوع:</strong>
                    @(Model.IsInLab ? "📍 حضوري في المعمل" : "💻 أونلاين")
                </li>

                @if (Model.ReferenceCode != null)
                {
                    <li class="list-group-item">
                        <strong>الكود المرجعي:</strong>
                        <span class="text-danger fw-bold">@Model.ReferenceCode</span>
                    </li>
                }

                <li class="list-group-item">
                    <strong>موعد البداية:</strong>
                    @Model.ScheduledDate?.ToLocalTime().ToString("yyyy/MM/dd hh:mm tt")
                </li>
            </ul>

            @if (Model.IsSentToStudents)
            {
                <div class="alert alert-info text-center fw-bold">
                    ✔ تم إرسال الاختبار مسبقًا لهذه الدفعة.
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center mb-4">
                    ⚠️ بعد التأكيد سيتم إرسال الاختبار إلى جميع طلاب هذه الدفعة ولن يمكن التراجع.
                </div>

                <form asp-action="ConfirmSendConfirmed" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="text-center">
                        <button type="submit" class="btn btn-success px-5 py-2 fw-bold">
                            ✅ تأكيد الإرسال الآن
                        </button>
                        <a asp-action="Index" class="btn btn-secondary px-4 py-2 ms-2">رجوع</a>
                    </div>
                </form>
            }
        </div>
    </div>
</div>
