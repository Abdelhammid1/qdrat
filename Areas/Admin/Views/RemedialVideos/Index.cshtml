@model IEnumerable<QdratNew.Entities.RemedialVideo>
@using QdratNew.Helpers
@{
    ViewData["Title"] = "🎞️ مكتبة الفيديوهات العلاجية";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        body {
            background-color: #f9fbfd;
            font-family: 'Cairo', sans-serif;
        }

        .page-header {
            background: linear-gradient(90deg, #0069d9 0%, #00bcd4 100%);
            color: #fff;
            padding: 20px 25px;
            border-radius: 12px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        table.dataTable td, table.dataTable th {
            white-space: nowrap;
            font-size: 14px !important;
            vertical-align: middle;
        }

        .table td a.btn {
            font-size: 13px;
            padding: 5px 10px;
        }

        #videosTable_wrapper .dataTables_filter {
            float: left !important;
            text-align: left !important;
        }

        .badge {
            font-size: 13px;
            border-radius: 8px;
        }

        .btn-group .btn {
            border-radius: 6px !important;
        }

        .modal-content {
            border-radius: 1rem;
            overflow: hidden;
        }
    </style>
}

<div class="container-fluid mt-4" dir="rtl">

    <!-- 🟦 رأس الصفحة -->
    <div class="page-header mb-4 d-flex justify-content-between align-items-center shadow-sm">
        <h3 class="fw-bold mb-0"><i class="bi bi-collection-play"></i> مكتبة الفيديوهات العلاجية</h3>
        <a href="@Url.Action("Create")" class="btn btn-light text-primary fw-bold shadow-sm">
            <i class="bi bi-plus-circle"></i> إضافة فيديو جديد
        </a>
    </div>

    <!-- 🟩 رسائل النظام -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success text-center fw-bold shadow-sm">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center fw-bold shadow-sm">@TempData["Error"]</div>
    }

    <!-- 🧩 جدول الفيديوهات -->
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <table id="videosTable" class="table table-bordered table-striped text-center align-middle w-100">
                <thead class="table-primary">
                    <tr>
                        <th>#</th>
                        <th>العنوان</th>
                        <th>المنهج</th>
                        <th>المحور</th>
                        <th>المؤشر</th>
                        <th>المعاينة</th> <!-- 🆕 -->
                        <th>الحالة</th>
                        <th><i class="bi bi-gear"></i></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int counter = 1;
                        foreach (var v in Model)
                        {
                            <tr>
                                <td>@(counter++)</td>
                                <td class="fw-bold text-primary">@v.Title</td>
                                <td>@v.Lesson?.Section?.Curriculum?.Title</td>
                                <td>@v.Lesson?.Section?.Title</td>
                                <td>@v.Lesson?.Title</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(v.ThumbnailUrl))
                                    {
                                        <img src="@v.ThumbnailUrl" alt="Preview" class="rounded shadow-sm"
                                             style="width: 130px; height: 80px; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <div class="bg-light text-muted d-flex align-items-center justify-content-center rounded"
                                             style="width: 130px; height: 80px;">
                                            No Image
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (v.IsActive)
                                    {
                                        <span class="badge bg-success px-3 py-2">مفعل</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 py-2">موقوف</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <a href="@Url.Action("Details", new { id = v.Id })" class="btn btn-sm btn-outline-primary" title="التفاصيل">
                                            <i class="bi bi-file-earmark-text"></i>
                                        </a>
                                        <button class="btn btn-sm btn-outline-info preview-btn" data-id="@v.Id" title="عرض">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <a href="@Url.Action("Edit", new { id = v.Id })" class="btn btn-sm btn-outline-success" title="تعديل">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <button class="btn btn-sm btn-outline-warning toggle-btn" data-id="@v.Id" title="تبديل الحالة">
                                            <i class="bi bi-power"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger delete-btn" data-id="@v.Id" title="حذف">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="8" class="text-muted text-center">لا توجد فيديوهات علاجية بعد.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <!-- ✅ مودال المعاينة -->
    <div class="modal fade" id="questionPreviewModal" tabindex="-1" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content text-end">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title"><i class="bi bi-eye"></i> معاينة السؤال</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="questionPreviewBody"></div>
            </div>
        </div>
    </div>

@section Scripts {
        <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
        <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
        <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <script>
            // 🧠 تحميل الأسئلة من المؤشر المحدد
            async function loadQuestions(lessonId) {
                const container = $("#questionsContainer");
                container.html("<p class='text-center text-info py-3 fw-bold'>جاري تحميل الأسئلة...</p>");

                try {
                    const response = await fetch(`/Admin/RemedialVideos/GetQuestionsByLesson?lessonId=${lessonId}`);
                    const data = await response.json();

                    if (!Array.isArray(data) || data.length === 0) {
                        container.html("<p class='text-muted text-center py-3'>لا توجد أسئلة مرتبطة بهذا المؤشر.</p>");
                        return;
                    }

                    let html = `
                        <table id="questionsTable" class="table table-striped table-bordered text-center align-middle w-100">
                            <thead class="table-dark">
                                <tr>
                                    <th>اختيار</th>
                                    <th>السؤال</th>
                                    <th>معاينة</th>
                                </tr>
                            </thead>
                            <tbody>
                    `;

                    data.forEach(q => {
                        html += `
                            <tr>
                                <td><input type="checkbox" name="SelectedQuestionIds" value="${q.id}" /></td>
                                <td class="fw-bold text-start">${q.title}</td>
                                <td>
                                    <button type="button" class="btn btn-outline-info btn-sm preview-btn" data-id="${q.id}">
                                        <i class="bi bi-eye"></i> معاينة
                                    </button>
                                </td>
                            </tr>
                        `;
                    });

                    html += "</tbody></table>";
                    container.html(html);

                    // ✅ تفعيل DataTable بعد تحميل الأسئلة
                    $("#questionsTable").DataTable({
                        language: { url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json" },
                        pageLength: 5,
                        lengthMenu: [5, 10, 20],
                        ordering: false,
                        responsive: true
                    });

                } catch (error) {
                    container.html("<p class='text-danger text-center py-3 fw-bold'>حدث خطأ أثناء تحميل الأسئلة.</p>");
                }
            }

            // 👁️ زر المعاينة - نستخدم Delegation لأن العناصر تُحقن بعد التحميل
            $(document).on("click", ".preview-btn", function () {
                const questionId = $(this).data("id");
                $("#questionPreviewBody").html("<p class='text-center text-info fw-bold py-4'>جاري تحميل السؤال...</p>");
                $("#questionPreviewModal").modal("show");

                fetch(`/Admin/Questions/Preview/${questionId}`)
                    .then(response => response.text())
                    .then(html => $("#questionPreviewBody").html(html))
                    .catch(() => {
                        $("#questionPreviewBody").html("<p class='text-danger text-center fw-bold'>فشل في تحميل السؤال.</p>");
                    });
            });

            // 🟢 عند اختيار الدرس نحمل الأسئلة تلقائيًا
            $(document).on("change", "#LessonId", function () {
                const lessonId = $(this).val();
                if (lessonId) loadQuestions(lessonId);
            });
        </script>
}
