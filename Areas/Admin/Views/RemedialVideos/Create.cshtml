@model QdratNew.ViewModels.Remedial.RemedialVideoCreateVm
@{
    ViewData["Title"] = "إضافة فيديو علاجي مرتبط بمنهج ومحور ومؤشر";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

<div class="qdrat-page" dir="rtl">

    <div class="qdrat-hero mb-4">
        <div>
            <div class="qdrat-kicker">
                <i class="bi bi-collection-play"></i>
                فيديو علاجي جديد
            </div>

            <h2 class="qdrat-title">إضافة فيديو علاجي</h2>

            <p class="qdrat-subtitle">
                اربط الفيديو العلاجي بالمنهج والمحور والمؤشر، ثم اختر الأسئلة المرتبطة به ليظهر ضمن رحلة العلاج التعليمية للطالب.
            </p>
        </div>

        <div class="qdrat-hero-icon">
            <i class="bi bi-play-btn"></i>
        </div>
    </div>

    <form asp-action="Create" method="post" id="videoForm">
        @Html.AntiForgeryToken()

        <div class="qdrat-card mb-4">
            <div class="qdrat-card-header">
                <div>
                    <h5>
                        <span class="qdrat-step">1</span>
                        اختيار المنهج والمحور والمؤشر
                    </h5>
                    <p>اختر المنهج أولًا ثم المحور ليتم تحميل المؤشرات الفعالة والأسئلة المرتبطة بها.</p>
                </div>
            </div>

            <div class="qdrat-card-body">
                <div class="row g-4">

                    <div class="col-lg-4 col-md-6">
                        <div class="qdrat-field">
                            <label class="form-label">المنهج</label>
                            <div class="qdrat-input-wrap">
                                <i class="bi bi-book"></i>
                                <select class="form-select" id="curriculumSelect" name="CurriculumId">
                                    <option value="">-- اختر المنهج --</option>
                                    @foreach (var c in ViewBag.Curriculums)
                                    {
                                        <option value="@c.Id">@c.Title</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <div class="qdrat-field">
                            <label class="form-label">المحور</label>
                            <div class="qdrat-input-wrap">
                                <i class="bi bi-diagram-3"></i>
                                <select class="form-select" id="sectionSelect" name="SectionId">
                                    <option value="">-- اختر المحور --</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <div class="qdrat-field">
                            <label asp-for="LessonId" class="form-label">المؤشر (الدرس الفعّال)</label>
                            <div class="qdrat-input-wrap">
                                <i class="bi bi-bullseye"></i>
                                <select asp-for="LessonId" class="form-select" id="lessonSelect">
                                    <option value="">-- اختر المؤشر --</option>
                                </select>
                            </div>
                            <span asp-validation-for="LessonId" class="text-danger small"></span>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="qdrat-card mb-4">
            <div class="qdrat-card-header">
                <div>
                    <h5>
                        <span class="qdrat-step qdrat-step-success">2</span>
                        تفاصيل الفيديو العلاجي
                    </h5>
                    <p>أدخل عنوان الفيديو والرابط والوصف المختصر. يدعم الرابط Vimeo و YouTube للمعاينة الفورية.</p>
                </div>
            </div>

            <div class="qdrat-card-body">
                <div class="row g-4">

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="Title" class="form-label">عنوان الفيديو</label>
                            <div class="qdrat-input-wrap">
                                <i class="bi bi-type"></i>
                                <input asp-for="Title" class="form-control" placeholder="عنوان الفيديو..." />
                            </div>
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="VimeoUrl" class="form-label">رابط الفيديو</label>
                            <div class="qdrat-input-wrap">
                                <i class="bi bi-link-45deg"></i>
                                <input asp-for="VimeoUrl" class="form-control" id="videoUrlInput" placeholder="https://vimeo.com/... أو https://youtu.be/..." />
                            </div>
                            <span asp-validation-for="VimeoUrl" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-12">
                        <div id="videoPreview" class="qdrat-video-preview">
                            <div class="qdrat-empty-state qdrat-empty-state-sm">
                                <i class="bi bi-camera-video"></i>
                                <h6>لم يتم تحميل الفيديو بعد</h6>
                                <p>أدخل رابط Vimeo أو YouTube لعرض المعاينة هنا.</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="qdrat-field">
                            <label asp-for="Description" class="form-label">نبذة عن الفيديو</label>
                            <div class="qdrat-textarea-wrap">
                                <i class="bi bi-card-text"></i>
                                <textarea asp-for="Description" class="form-control" rows="4" placeholder="نبذة مختصرة..."></textarea>
                            </div>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="qdrat-card mb-4">
            <div class="qdrat-card-header">
                <div>
                    <h5>
                        <span class="qdrat-step qdrat-step-info">3</span>
                        الأسئلة المرتبطة بالفيديو
                    </h5>
                    <p>اختر الأسئلة التي سيُستخدم الفيديو العلاجي معها داخل خطة العلاج.</p>
                </div>
            </div>

            <div class="qdrat-card-body" id="questionsContainer">
                <div class="qdrat-empty-state">
                    <i class="bi bi-question-circle"></i>
                    <h6>اختر المؤشر أولًا</h6>
                    <p>سيتم عرض الأسئلة المرتبطة بالمؤشر المختار هنا.</p>
                </div>
            </div>
        </div>

        <div class="qdrat-sticky-actions">
            <a href="@Url.Action("Index")" class="btn qdrat-btn qdrat-btn-light">
                <i class="bi bi-arrow-right-circle"></i>
                العودة
            </a>

            <button type="submit" class="btn qdrat-btn qdrat-btn-primary">
                <i class="bi bi-save"></i>
                حفظ الفيديو
            </button>
        </div>
    </form>
</div>

<div class="modal fade" id="questionPreviewModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content qdrat-modal text-end">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-eye"></i>
                    معاينة السؤال
                </h5>
                <button type="button" class="btn-close ms-0" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="questionPreviewBody"></div>
        </div>
    </div>
</div>

<style>
    .qdrat-page {
        padding: 24px;
        background: #f5f7fb;
        min-height: calc(100vh - 80px);
        font-family: inherit;
    }

    .qdrat-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 26px;
        border-radius: 24px;
        background: linear-gradient(135deg, #102a43 0%, #1d4ed8 58%, #38bdf8 100%);
        color: #fff;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
    }

    .qdrat-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .qdrat-title {
        margin: 0;
        font-size: 28px;
        font-weight: 900;
        letter-spacing: -0.5px;
    }

    .qdrat-subtitle {
        margin: 10px 0 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 15px;
        line-height: 1.8;
        max-width: 900px;
    }

    .qdrat-hero-icon {
        width: 74px;
        height: 74px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.16);
        font-size: 34px;
        flex: 0 0 auto;
    }

    .qdrat-card {
        border: 1px solid #e5e7eb;
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    .qdrat-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #edf0f5;
        background: #fff;
    }

        .qdrat-card-header h5 {
            margin: 0;
            color: #0f172a;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .qdrat-card-header p {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 14px;
            font-weight: 700;
        }

    .qdrat-card-body {
        padding: 24px;
    }

    .qdrat-step {
        width: 30px;
        height: 30px;
        border-radius: 11px;
        background: #2563eb;
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        font-weight: 900;
    }

    .qdrat-step-success {
        background: #16a34a;
    }

    .qdrat-step-info {
        background: #0284c7;
    }

    .qdrat-field .form-label {
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 9px;
    }

    .qdrat-input-wrap,
    .qdrat-textarea-wrap {
        position: relative;
    }

        .qdrat-input-wrap > i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 3;
            pointer-events: none;
        }

        .qdrat-textarea-wrap > i {
            position: absolute;
            right: 15px;
            top: 18px;
            color: #64748b;
            z-index: 3;
            pointer-events: none;
        }

        .qdrat-input-wrap .form-control,
        .qdrat-input-wrap .form-select {
            min-height: 48px;
            border-radius: 15px;
            border-color: #dbe3ef;
            padding-right: 42px;
            font-weight: 700;
        }

        .qdrat-textarea-wrap .form-control {
            border-radius: 15px;
            border-color: #dbe3ef;
            padding-right: 42px;
            padding-top: 14px;
            font-weight: 700;
            line-height: 1.9;
            resize: vertical;
        }

            .qdrat-input-wrap .form-control:focus,
            .qdrat-input-wrap .form-select:focus,
            .qdrat-textarea-wrap .form-control:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 0.22rem rgba(37, 99, 235, 0.12);
            }

    .qdrat-empty-state {
        border: 1px dashed #cbd5e1;
        border-radius: 22px;
        background: #f8fafc;
        text-align: center;
        padding: 34px 18px;
        color: #64748b;
    }

    .qdrat-empty-state-sm {
        padding: 24px 16px;
    }

    .qdrat-empty-state > i {
        font-size: 34px;
        color: #94a3b8;
        margin-bottom: 10px;
    }

    .qdrat-empty-state h6 {
        margin: 0;
        font-weight: 900;
        color: #334155;
    }

    .qdrat-empty-state p {
        margin: 8px 0 0;
        font-weight: 700;
    }

    .qdrat-video-preview .ratio {
        overflow: hidden;
        border-radius: 20px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
        background: #0f172a;
    }

    .qdrat-loading-box,
    .qdrat-error-box {
        border-radius: 18px;
        padding: 22px;
        text-align: center;
        font-weight: 900;
    }

    .qdrat-loading-box {
        background: #eff6ff;
        color: #1d4ed8;
    }

    .qdrat-error-box {
        background: #fee2e2;
        color: #991b1b;
    }

    .qdrat-questions-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
        flex-wrap: wrap;
    }

        .qdrat-questions-toolbar h6 {
            margin: 0;
            font-weight: 900;
            color: #1d4ed8;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .qdrat-table-wrap {
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        overflow: hidden;
        background: #fff;
    }

    .qdrat-table {
        margin: 0;
    }

        .qdrat-table thead th {
            background: #0f172a;
            color: #fff;
            font-weight: 900;
            padding: 14px;
        }

        .qdrat-table tbody td {
            padding: 13px;
            color: #334155;
            font-weight: 700;
            border-color: #edf0f5;
            vertical-align: middle;
        }

        .qdrat-table .question-html {
            direction: rtl;
            text-align: right;
            line-height: 1.8;
        }

    .qdrat-sticky-actions {
        position: sticky;
        bottom: 16px;
        z-index: 20;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding: 14px;
        margin-top: 8px;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(10px);
        box-shadow: 0 16px 35px rgba(15, 23, 42, 0.12);
    }

    .qdrat-btn {
        min-height: 46px;
        border-radius: 14px;
        padding: 10px 24px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .qdrat-btn-primary {
        background: #16a34a;
        border-color: #16a34a;
        color: #fff;
    }

        .qdrat-btn-primary:hover {
            background: #15803d;
            border-color: #15803d;
            color: #fff;
        }

    .qdrat-btn-light {
        background: #f8fafc;
        border-color: #dbe3ef;
        color: #334155;
    }

        .qdrat-btn-light:hover {
            background: #eef2f7;
            border-color: #cbd5e1;
            color: #0f172a;
        }

    .qdrat-modal {
        border: 0;
        border-radius: 22px;
        overflow: hidden;
    }

        .qdrat-modal .modal-header {
            background: #0f172a;
            color: #fff;
            border-bottom: 0;
            padding: 18px 22px;
        }

        .qdrat-modal .modal-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 900;
        }

    @@media (max-width: 768px) {
        .qdrat-page {
            padding: 14px;
        }

        .qdrat-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 20px;
        }

        .qdrat-title {
            font-size: 23px;
        }

        .qdrat-hero-icon {
            width: 58px;
            height: 58px;
            font-size: 26px;
        }

        .qdrat-card-body,
        .qdrat-card-header {
            padding: 18px;
        }

        .qdrat-sticky-actions {
            flex-direction: column-reverse;
        }

        .qdrat-btn {
            width: 100%;
        }

        .qdrat-table {
            min-width: 760px;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
            $("#videoUrlInput").on("input", function () {
                const url = $(this).val();
                const embed = getEmbedUrl(url);

                if (embed) {
                    $("#videoPreview").html(`<div class="ratio ratio-16x9"><iframe src="${embed}" allowfullscreen allow="autoplay; fullscreen; picture-in-picture"></iframe></div>`);
                } else {
                    $("#videoPreview").html(`
                        <div class="qdrat-empty-state qdrat-empty-state-sm">
                            <i class="bi bi-camera-video"></i>
                            <h6>لم يتم التعرف على الرابط بعد</h6>
                            <p>أدخل رابط Vimeo أو YouTube صحيحًا.</p>
                        </div>`);
                }
            });
        });

        $("#curriculumSelect").change(async function () {
            const curriculumId = $(this).val();
            const sectionSelect = $("#sectionSelect");

            sectionSelect.html("<option>جاري التحميل...</option>");
            $("#lessonSelect").html("<option>-- اختر المؤشر --</option>");
            renderQuestionsEmptyState();

            if (!curriculumId) {
                sectionSelect.html("<option value=''>-- اختر المحور --</option>");
                return;
            }

            try {
                const res = await fetch(`/Admin/RemedialVideos/GetSectionsByCurriculum?curriculumId=${encodeURIComponent(curriculumId)}`);
                const data = await res.json();

                sectionSelect.html(Array.isArray(data) && data.length
                    ? "<option value=''>-- اختر المحور --</option>" + data.map(s => `<option value='${escapeHtmlAttribute(s.id)}'>${escapeHtml(s.title)}</option>`).join("")
                    : "<option>لا توجد محاور لهذا المنهج</option>");
            } catch {
                sectionSelect.html("<option>حدث خطأ أثناء تحميل المحاور</option>");
            }
        });

        $("#sectionSelect").change(async function () {
            const sectionId = $(this).val();
            const lessonSelect = $("#lessonSelect");

            lessonSelect.html("<option>جاري التحميل...</option>");
            renderQuestionsEmptyState();

            if (!sectionId) {
                lessonSelect.html("<option value=''>-- اختر المؤشر --</option>");
                return;
            }

            try {
                const res = await fetch(`/Admin/RemedialVideos/GetLessonsBySection?sectionId=${encodeURIComponent(sectionId)}`);
                const data = await res.json();

                lessonSelect.html(Array.isArray(data) && data.length
                    ? "<option value=''>-- اختر المؤشر --</option>" + data.map(l => `<option value='${escapeHtmlAttribute(l.id)}'>${escapeHtml(l.title)}</option>`).join("")
                    : "<option>لا توجد مؤشرات فعالة لهذا المحور</option>");
            } catch {
                lessonSelect.html("<option>حدث خطأ أثناء تحميل المؤشرات</option>");
            }
        });

        $("#lessonSelect").change(async function () {
            const lessonId = $(this).val();

            if (!lessonId) {
                renderQuestionsEmptyState();
                return;
            }

            await loadQuestions(lessonId);
        });

        async function loadQuestions(lessonId) {
            const container = $("#questionsContainer");
            container.html("<div class='qdrat-loading-box'><i class='bi bi-arrow-repeat'></i> جاري تحميل الأسئلة...</div>");

            try {
                const res = await fetch(`/Admin/RemedialVideos/GetQuestionsByLesson?lessonId=${encodeURIComponent(lessonId)}`);
                const data = await res.json();

                if (!Array.isArray(data) || data.length === 0) {
                    container.html(`
                        <div class="qdrat-empty-state">
                            <i class="bi bi-folder-x"></i>
                            <h6>لا توجد أسئلة مرتبطة بهذا المؤشر</h6>
                            <p>اختر مؤشرًا آخر أو أضف أسئلة مرتبطة به من بنك الأسئلة.</p>
                        </div>`);
                    return;
                }

                let html = `
                    <div class="qdrat-questions-toolbar">
                        <h6><i class="bi bi-question-circle"></i> قائمة الأسئلة المرتبطة</h6>
                    </div>
                    <div class="qdrat-table-wrap">
                        <table id="questionsTable" class="table qdrat-table table-bordered text-center w-100 align-middle">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>السؤال</th>
                                    <th>اختيار</th>
                                    <th>معاينة</th>
                                </tr>
                            </thead>
                            <tbody>`;

                let counter = 1;
                data.forEach(q => {
                    html += `
                        <tr>
                            <td>${counter++}</td>
                            <td class="question-html">${q.text || "<span class='text-muted'>بدون عنوان</span>"}</td>
                            <td>
                                <input type="checkbox" class="question-check" name="SelectedQuestionIds" value="${escapeHtmlAttribute(q.id)}" />
                            </td>
                            <td>
                                <button type="button" class="btn btn-outline-info btn-sm preview-btn" data-id="${escapeHtmlAttribute(q.id)}">
                                    <i class="bi bi-eye"></i>
                                    عرض
                                </button>
                            </td>
                        </tr>`;
                });

                html += "</tbody></table></div>";
                container.html(html);

                $("#questionsTable").DataTable({
                    pageLength: 10,
                    language: { url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json" },
                    responsive: true,
                    destroy: true
                });
            } catch {
                container.html("<div class='qdrat-error-box'><i class='bi bi-exclamation-triangle'></i> حدث خطأ أثناء تحميل الأسئلة.</div>");
            }
        }

        $(document).on("click", ".preview-btn", function () {
            const id = $(this).data("id");

            $("#questionPreviewBody").html("<div class='qdrat-loading-box'>جاري تحميل السؤال...</div>");
            $("#questionPreviewModal").modal("show");

            fetch(`/Admin/Questions/Preview/${encodeURIComponent(id)}`)
                .then(r => r.text())
                .then(html => $("#questionPreviewBody").html(html))
                .catch(() => $("#questionPreviewBody").html("<div class='qdrat-error-box'>حدث خطأ أثناء تحميل السؤال.</div>"));
        });

        function renderQuestionsEmptyState() {
            $("#questionsContainer").html(`
                <div class="qdrat-empty-state">
                    <i class="bi bi-question-circle"></i>
                    <h6>اختر المؤشر أولًا</h6>
                    <p>سيتم عرض الأسئلة المرتبطة بالمؤشر المختار هنا.</p>
                </div>`);
        }

        function getEmbedUrl(url) {
            if (!url) return "";

            if (url.includes("vimeo.com")) {
                const id = url.split("/").pop().split("?")[0];
                return id ? `https://player.vimeo.com/video/${id}` : "";
            }

            if (url.includes("youtube.com/watch?v=")) {
                const id = url.split("v=").pop().split("&")[0];
                return id ? `https://www.youtube.com/embed/${id}` : "";
            }

            if (url.includes("youtu.be")) {
                const id = url.split("/").pop().split("?")[0];
                return id ? `https://www.youtube.com/embed/${id}` : "";
            }

            return "";
        }

        function escapeHtml(value) {
            if (value === null || value === undefined) return "";

            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function escapeHtmlAttribute(value) {
            return escapeHtml(value);
        }
    </script>
}
