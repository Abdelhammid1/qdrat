@model QdratNew.Entities.RemedialVideo
@{
    string videoUrl = Model.VimeoUrl ?? "";
    string embedUrl = "";

    if (videoUrl.Contains("vimeo.com"))
    {
        var id = videoUrl.Split('/').Last().Split('?').First();
        embedUrl = $"https://player.vimeo.com/video/{id}";
    }
    else if (videoUrl.Contains("youtube.com/watch?v="))
    {
        var id = videoUrl.Split("v=").Last().Split('&').First();
        embedUrl = $"https://www.youtube.com/embed/{id}";
    }
    else if (videoUrl.Contains("youtu.be"))
    {
        var id = videoUrl.Split('/').Last().Split('?').First();
        embedUrl = $"https://www.youtube.com/embed/{id}";
    }
}

<div class="qdrat-remedial-preview" dir="rtl">

    <div class="qdrat-preview-header">
        <div>
            <span class="qdrat-preview-badge">
                <i class="bi bi-play-btn"></i>
                فيديو علاجي
            </span>
            <h4>@Model.Title</h4>
            <p>@Model.Description</p>
        </div>
    </div>

    <div class="qdrat-preview-meta">
        <div class="qdrat-meta-item">
            <i class="bi bi-book"></i>
            <div>
                <small>المنهج</small>
                <strong>@(Model.Lesson?.Section?.Curriculum?.Title ?? "غير محدد")</strong>
            </div>
        </div>

        <div class="qdrat-meta-item">
            <i class="bi bi-diagram-3"></i>
            <div>
                <small>المحور</small>
                <strong>@(Model.Lesson?.Section?.Title ?? "غير محدد")</strong>
            </div>
        </div>

        <div class="qdrat-meta-item">
            <i class="bi bi-bullseye"></i>
            <div>
                <small>المؤشر</small>
                <strong>@(Model.Lesson?.Title ?? "غير محدد")</strong>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(embedUrl))
    {
        <div class="ratio ratio-16x9 qdrat-preview-video">
            <iframe src="@embedUrl" frameborder="0" allowfullscreen allow="autoplay; fullscreen; picture-in-picture"></iframe>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.VimeoUrl))
    {
        <div class="ratio ratio-16x9 qdrat-preview-video">
            <iframe src="@Model.VimeoUrl" frameborder="0" allowfullscreen allow="autoplay; fullscreen; picture-in-picture"></iframe>
        </div>
    }
    else
    {
        <div class="qdrat-preview-empty">
            <i class="bi bi-camera-video-off"></i>
            <span>لا يوجد رابط فيديو متاح للمعاينة.</span>
        </div>
    }

    <div class="qdrat-linked-questions">
        <h6>
            <i class="bi bi-question-circle"></i>
            الأسئلة المرتبطة
        </h6>

        @if (Model.Questions != null && Model.Questions.Any())
        {
            <ul>
                @foreach (var q in Model.Questions)
                {
                    <li>@(q.Question?.Title ?? "سؤال بدون عنوان")</li>
                }
            </ul>
        }
        else
        {
            <div class="qdrat-preview-empty qdrat-preview-empty-sm">
                <i class="bi bi-folder-x"></i>
                <span>لا توجد أسئلة مرتبطة بهذا الفيديو.</span>
            </div>
        }
    </div>
</div>

<style>
    .qdrat-remedial-preview {
        background: #f8fafc;
        border-radius: 22px;
        padding: 20px;
        color: #0f172a;
    }

    .qdrat-preview-header {
        border-radius: 20px;
        padding: 22px;
        background: linear-gradient(135deg, #102a43 0%, #1d4ed8 62%, #38bdf8 100%);
        color: #fff;
        margin-bottom: 16px;
    }

    .qdrat-preview-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 12px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .qdrat-preview-header h4 {
        margin: 0;
        font-weight: 900;
        line-height: 1.7;
    }

    .qdrat-preview-header p {
        margin: 8px 0 0;
        color: rgba(255, 255, 255, 0.84);
        line-height: 1.9;
        font-weight: 700;
    }

    .qdrat-preview-meta {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 16px;
    }

    .qdrat-meta-item {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 14px;
    }

        .qdrat-meta-item i {
            width: 38px;
            height: 38px;
            border-radius: 13px;
            background: #eff6ff;
            color: #2563eb;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex: 0 0 auto;
        }

        .qdrat-meta-item small {
            display: block;
            color: #64748b;
            font-weight: 800;
            margin-bottom: 3px;
        }

        .qdrat-meta-item strong {
            display: block;
            color: #0f172a;
            font-weight: 900;
            line-height: 1.7;
        }

    .qdrat-preview-video {
        overflow: hidden;
        border-radius: 20px;
        border: 1px solid #e5e7eb;
        background: #0f172a;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.12);
        margin-bottom: 18px;
    }

    .qdrat-linked-questions {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        padding: 18px;
    }

        .qdrat-linked-questions h6 {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 900;
            color: #334155;
            margin: 0 0 12px;
        }

        .qdrat-linked-questions ul {
            margin: 0;
            padding-right: 20px;
        }

        .qdrat-linked-questions li {
            padding: 8px 0;
            color: #334155;
            font-weight: 700;
            line-height: 1.8;
            border-bottom: 1px solid #f1f5f9;
        }

            .qdrat-linked-questions li:last-child {
                border-bottom: 0;
            }

    .qdrat-preview-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border: 1px dashed #cbd5e1;
        background: #f8fafc;
        border-radius: 18px;
        padding: 24px;
        color: #64748b;
        font-weight: 900;
        margin-bottom: 16px;
    }

    .qdrat-preview-empty-sm {
        margin-bottom: 0;
        padding: 16px;
    }

    @@media (max-width: 768px) {
        .qdrat-preview-meta {
            grid-template-columns: 1fr;
        }
    }
</style>
