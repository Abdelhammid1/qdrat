@model QdratNew.ViewModels.Remedial.RemedialVideoDetailsVm
@{
    ViewData["Title"] = "🎬 تفاصيل الفيديو العلاجي";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

<div class="container py-4" dir="rtl">
    <div class="card shadow-lg border-0 mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="fw-bold mb-0"><i class="bi bi-collection-play"></i> @Model.Title</h4>
            <a href="@Url.Action("Index")" class="btn btn-light text-primary fw-bold">
                <i class="bi bi-arrow-right-circle"></i> العودة
            </a>
        </div>

        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-8">
                    @{
                        string videoUrl = Model.VimeoUrl ?? "";
                        string embedUrl = "";

                        if (videoUrl.Contains("vimeo.com"))
                        {
                            var id = videoUrl.Split('/').Last();
                            embedUrl = $"https://player.vimeo.com/video/{id}";
                        }
                        else if (videoUrl.Contains("youtube.com/watch?v="))
                        {
                            var id = videoUrl.Split("v=").Last().Split('&').First();
                            embedUrl = $"https://www.youtube.com/embed/{id}";
                        }
                        else if (videoUrl.Contains("youtu.be"))
                        {
                            var id = videoUrl.Split('/').Last();
                            embedUrl = $"https://www.youtube.com/embed/{id}";
                        }
                    }

                    @if (!string.IsNullOrEmpty(embedUrl))
                    {
                        <div class="ratio ratio-16x9 mb-3 shadow-sm border">
                            <iframe src="@embedUrl" frameborder="0" allowfullscreen allow="autoplay; fullscreen; picture-in-picture"></iframe>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning text-center fw-bold">
                            ⚠️ لم يتم التعرف على رابط الفيديو أو الرابط غير صالح.
                        </div>
                    }

                    <p class="text-muted mt-3">@(!string.IsNullOrEmpty(Model.Description) ? Model.Description : "لا يوجد وصف متاح لهذا الفيديو.")</p>
                </div>

                <div class="col-md-4">
                    <div class="border rounded-3 p-3 bg-light shadow-sm">
                        <p><strong>📘 المنهج:</strong> <span class="text-primary">@Model.CurriculumTitle</span></p>
                        <p><strong>📗 المحور:</strong> <span class="text-success">@Model.SectionTitle</span></p>
                        <p><strong>📙 المؤشر:</strong> <span class="text-warning">@Model.LessonTitle</span></p>
                        <p>
                            <strong>🔌 الحالة:</strong>
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success px-3 py-2">مفعل</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary px-3 py-2">موقوف</span>
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 🟩 جدول الأسئلة المرتبطة -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-info text-white fw-bold d-flex justify-content-between align-items-center">
            <span><i class="bi bi-question-circle"></i> الأسئلة المرتبطة بالفيديو</span>
            <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-light btn-sm text-info fw-bold">
                <i class="bi bi-pencil-square"></i> تعديل أو إضافة أسئلة
            </a>
        </div>

        <div class="card-body">
            @if (Model.Questions != null && Model.Questions.Any())
            {
                <table id="questionsTable" class="table table-striped table-bordered text-center align-middle w-100">
                    <thead class="table-dark">
                        <tr>
                            <th style="width:60px;">#</th>
                            <th>نص السؤال</th>
                            <th>معاينة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int counter = 1;
                            foreach (var q in Model.Questions)
                            {
                                <tr>
                                    <td>@counter++</td>
                                    <td class="text-start">@Html.Raw(q.QuestionTitle)</td>
                                    <td>
                                        <button type="button" class="btn btn-outline-info btn-sm preview-btn" data-id="@q.QuestionId">
                                            <i class="bi bi-eye"></i> عرض
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted text-center fw-bold py-3">
                    ❌ لا توجد أسئلة مرتبطة بهذا الفيديو حتى الآن.
                </p>
            }
        </div>
    </div>
</div>

<!-- ✅ مودال عرض السؤال -->
<div class="modal fade" id="questionPreviewModal" tabindex="-1" dir="rtl">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content text-end">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title"><i class="bi bi-eye"></i> معاينة السؤال</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="questionPreviewBody">
                <p class="text-center text-info fw-bold py-4">جاري تحميل السؤال...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#questionsTable').DataTable({
                language: { url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json" },
                pageLength: 10,
                responsive: true
            });

            // 👁️ زر المعاينة
            $(document).on("click", ".preview-btn", function () {
                const questionId = $(this).data("id");
                $("#questionPreviewBody").html("<p class='text-center text-info fw-bold py-4'>جاري تحميل السؤال...</p>");
                $("#questionPreviewModal").modal("show");

                fetch(`/Admin/Questions/Preview/${questionId}`)
                    .then(res => res.text())
                    .then(html => $("#questionPreviewBody").html(html))
                    .catch(() => $("#questionPreviewBody").html("<p class='text-danger text-center fw-bold'>⚠️ حدث خطأ أثناء تحميل السؤال.</p>"));
            });
        });
    </script>
}
