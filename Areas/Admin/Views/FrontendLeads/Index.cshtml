@model QdratNew.ViewModels.Admin.FrontendLeadsIndexVM

@{
    ViewData["Title"] = "طلبات التسجيل";
}

<h3 class="mb-4">طلبات التسجيل من الموقع</h3>

<!-- =======================
   📊 STAT CARDS
======================= -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h6 class="text-muted">إجمالي الطلبات</h6>
                <h3 class="fw-bold">@Model.TotalCount</h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h6 class="text-muted">تم التواصل</h6>
                <h3 class="fw-bold text-success">@Model.ContactedCount</h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h6 class="text-muted">لم يتم التواصل</h6>
                <h3 class="fw-bold text-warning">@Model.NotContactedCount</h3>
            </div>
        </div>
    </div>
</div>

<!-- =======================
   🔍 FILTER BUTTONS
======================= -->
<div class="mb-3">
    <a asp-action="Index" asp-route-filter="all"
       class="btn btn-sm @(Model.CurrentFilter == "all" ? "btn-primary" : "btn-outline-primary")">
        الكل
    </a>

    <a asp-action="Index" asp-route-filter="contacted"
       class="btn btn-sm @(Model.CurrentFilter == "contacted" ? "btn-success" : "btn-outline-success")">
        تم التواصل
    </a>

    <a asp-action="Index" asp-route-filter="not-contacted"
       class="btn btn-sm @(Model.CurrentFilter == "not-contacted" ? "btn-warning" : "btn-outline-warning")">
        لم يتم التواصل
    </a>
</div>

<!-- =======================
   📋 TABLE
======================= -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table id="leadsTable" class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>الاسم</th>
                    <th>الهاتف</th>
                    <th>الدورة</th>
                    <th>تاريخ الإرسال</th>
                    <th>الحالة</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Leads)
                {
                    <tr>
                        <td>@item.StudentName</td>
                        <td>@item.PhoneNumber</td>
                        <td>@item.SelectedProgram</td>
                        <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (item.IsContacted)
                            {
                                <span class="badge bg-success">تم التواصل</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">لم يتم</span>
                            }
                        </td>
                        <td>
                            @if (!item.IsContacted)
                            {
                                <form asp-action="MarkContacted" method="post">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button class="btn btn-sm btn-outline-success">
                                        تم التواصل
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }

                @if (!Model.Leads.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            لا توجد بيانات للعرض
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .dt-buttons .btn {
        margin-left: 4px;
    }

    .dt-buttons .btn i {
        font-size: 1rem;
    }
</style>



   @section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#leadsTable').DataTable({
                pageLength: 10,
                ordering: true,
                responsive: true,
                dom: '<"d-flex justify-content-between align-items-center mb-3"Bf>rtip',

                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="fas fa-file-excel"></i>',
                        titleAttr: 'تصدير Excel',
                        className: 'btn btn-sm btn-success'
                    },
                    {
                        extend: 'copyHtml5',
                        text: '<i class="fas fa-copy"></i>',
                        titleAttr: 'نسخ',
                        className: 'btn btn-sm btn-secondary'
                    },
                    {
                        extend: 'print',
                        text: '<i class="fas fa-print"></i>',
                        titleAttr: 'طباعة',
                        className: 'btn btn-sm btn-primary'
                    }
                ],

                language: {
                    search: "بحث:",
                    lengthMenu: "عرض _MENU_ صف",
                    info: "عرض _START_ إلى _END_ من _TOTAL_",
                    paginate: {
                        first: "الأول",
                        last: "الأخير",
                        next: "التالي",
                        previous: "السابق"
                    },
                    emptyTable: "لا توجد بيانات"
                }
            });
        });
    </script>


      }   