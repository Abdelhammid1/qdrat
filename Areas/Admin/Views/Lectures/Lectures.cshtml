@model QdratNew.ViewModels.Lecture.BatchLecturesPageViewModel

@{
    ViewData["Title"] = "محاضرات الدفعة";
}

<div class="container-fluid py-4" dir="rtl">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h3 class="fw-bold mb-1">محاضرات الدفعة</h3>
            <div class="text-muted">
                @Model.BatchName - @Model.CourseName
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-area="Admin"
               asp-controller="Lectures"
               asp-action="Create"
               asp-route-batchId="@Model.BatchId"
               class="btn btn-primary">
                إضافة محاضرة لهذه الدفعة
            </a>

            <a asp-area="Admin"
               asp-controller="Lectures"
               asp-action="Index"
               class="btn btn-outline-secondary">
                رجوع للدفعات
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">طلاب الدفعة</div>
                    <div class="fs-3 fw-bold">@Model.TotalStudents</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">إجمالي المحاضرات</div>
                    <div class="fs-3 fw-bold">@Model.TotalLectures</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">محاضرات اليوم</div>
                    <div class="fs-3 fw-bold text-warning">@Model.TodayLectures</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">محاضرات قادمة</div>
                    <div class="fs-3 fw-bold text-success">@Model.UpcomingLectures</div>
                </div>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">قائمة المحاضرات</h5>
            <span class="badge bg-light text-dark">@Model.Lectures.Count محاضرة</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle text-center mb-0">
                <thead class="table-light">
                    <tr>
                        <th>المحاضرة</th>
                        <th>التاريخ</th>
                        <th>الوقت</th>
                        <th>المدرب</th>
                        <th>المحور</th>
                        <th>المكان</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Lectures.Any())
                    {
                        <tr>
                            <td colspan="7" class="py-5 text-muted">
                                لا توجد محاضرات لهذه الدفعة حتى الآن.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Lectures)
                        {
                            var isToday = item.Date.Date == DateTime.Today;

                            <tr class="@(isToday ? "table-warning" : "")">
                                <td class="text-start">
                                    <div class="fw-bold">@item.Title</div>
                                    @if (isToday)
                                    {
                                        <span class="badge bg-warning text-dark">اليوم</span>
                                    }
                                </td>

                                <td>@item.Date.ToString("yyyy/MM/dd")</td>
                                <td>
                                    @if (item.ScheduledTime.HasValue)
                                    {
                                        <div class="fw-bold text-primary small">@item.ScheduledTime.Value.ToString(@"hh\:mm")</div>
                                        @if (item.ScheduledEndTime.HasValue)
                                        {
                                            <div class="text-muted small">← @item.ScheduledEndTime.Value.ToString(@"hh\:mm")</div>
                                        }
                                        else if (item.DurationMinutes.HasValue)
                                        {
                                            <div class="text-muted small">@item.DurationMinutes دقيقة</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @item.InstructorName
                                    @if (item.IsManualInstructorAssignment)
                                    {
                                        <span class="badge bg-warning text-dark" title="تعيين يدوي — لن يتغيّر تلقائيًا عند تعديل ربط المدرب بالمنهج.">
                                            <i class="fas fa-hand-pointer"></i> يدوي
                                        </span>
                                    }
                                </td>
                                <td>@item.SectionTitle</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Location) ? "—" : item.Location)</td>

                                <td>
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-area="Admin"
                                           asp-controller="Lectures"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info">
                                            تفاصيل
                                        </a>
                                        <a asp-area="Admin"
                                           asp-controller="Lectures"
                                           asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            تعديل
                                        </a>

                                        <a asp-area="Admin"
                                           asp-controller="Lectures"
                                           asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            حذف
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>
    </div>

</div>