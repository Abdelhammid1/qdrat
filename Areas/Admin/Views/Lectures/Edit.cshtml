@model QdratNew.ViewModels.Lecture.LectureEditViewModel

@{
    ViewData["Title"] = "تعديل محاضرة";
}

<div class="qdrat-page-wrapper" dir="rtl">
    <div class="qdrat-page-header">
        <div>
            <h1 class="qdrat-page-title">
                <i class="fas fa-pen-to-square"></i>
                تعديل المحاضرة
            </h1>
            <p class="qdrat-page-subtitle">
                تحديث بيانات المحاضرة مع الحفاظ على الربط الحالي بالدورة والمحور والدفعة والمدرب.
            </p>
        </div>

        <a asp-action="Index" class="qdrat-back-btn">
            <i class="fas fa-arrow-right"></i>
            العودة للقائمة
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="qdrat-alert qdrat-alert-danger">
            <div class="qdrat-alert-title">
                <i class="fas fa-triangle-exclamation"></i>
                حدثت أخطاء عند محاولة حفظ البيانات
            </div>
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="Edit" method="post" class="qdrat-form-card needs-validation" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="qdrat-card-header">
            <div class="qdrat-card-icon">
                <i class="fas fa-calendar-check"></i>
            </div>
            <div>
                <h2>بيانات المحاضرة</h2>
                <p>راجع البيانات الحالية وعدّل المطلوب فقط.</p>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="qdrat-validation-summary"></div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-pen-to-square"></i>
                البيانات الأساسية
            </div>

            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="Title" class="qdrat-label">
                            عنوان المحاضرة
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-heading"></i>
                            <input asp-for="Title" class="form-control qdrat-input" placeholder="أدخل عنوان المحاضرة" />
                        </div>
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="Date" class="qdrat-label">
                            تاريخ المحاضرة
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-calendar-day"></i>
                            <input asp-for="Date" type="date" class="form-control qdrat-input" />
                        </div>
                        <span asp-validation-for="Date" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="qdrat-form-group">
                        <label asp-for="ScheduledTime" class="qdrat-label">
                            وقت البداية المجدول
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-clock"></i>
                            <input asp-for="ScheduledTime" type="time" id="scheduledTimeInput" class="form-control qdrat-input"
                                   value="@(Model.ScheduledTime.HasValue ? Model.ScheduledTime.Value.ToString(@"hh\:mm") : "")" />
                        </div>
                        <span asp-validation-for="ScheduledTime" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="qdrat-form-group">
                        <label asp-for="DurationMinutes" class="qdrat-label">
                            المدة (بالدقائق)
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-hourglass-half"></i>
                            <input asp-for="DurationMinutes" type="number" id="durationInput" min="1" max="480"
                                   class="form-control qdrat-input" placeholder="مثال: 90" />
                        </div>
                        <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="qdrat-form-group">
                        <label class="qdrat-label">
                            وقت الانتهاء المتوقع
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-flag-checkered"></i>
                            <input type="text" id="scheduledEndDisplay" class="form-control qdrat-input"
                                   value="@(Model.ScheduledEndTime.HasValue ? Model.ScheduledEndTime.Value.ToString(@"hh\:mm") : "")"
                                   placeholder="يُحسب تلقائياً" readonly style="background:#f8fafc;cursor:default;" />
                        </div>
                        <input asp-for="ScheduledEndTime" type="hidden" id="scheduledEndTimeInput" />
                    </div>
                </div>

                <div class="col-12">
                    <div class="qdrat-form-group">
                        <label asp-for="Location" class="qdrat-label">
                            الموقع
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-location-dot"></i>
                            <input asp-for="Location" class="form-control qdrat-input" placeholder="مثال: قاعة 1 / أونلاين / فرع الرياض" />
                        </div>
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-link"></i>
                الربط التعليمي
            </div>

            <div class="row g-4">
                <div class="col-md-6 col-xl-3">
                    <div class="qdrat-form-group">
                        <label asp-for="CourseId" class="qdrat-label">
                            الدورة
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-select-wrapper">
                            <i class="fas fa-layer-group"></i>
                            <select asp-for="CourseId" class="form-select qdrat-select" asp-items="Model.Courses">
                                <option value="">اختر دورة</option>
                            </select>
                        </div>
                        <span asp-validation-for="CourseId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-md-6 col-xl-3">
                    <div class="qdrat-form-group">
                        <label asp-for="SectionId" class="qdrat-label">
                            المحور
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-select-wrapper">
                            <i class="fas fa-sitemap"></i>
                            <select asp-for="SectionId" class="form-select qdrat-select" asp-items="Model.Sections">
                                <option value="">اختر محور</option>
                            </select>
                        </div>
                        <span asp-validation-for="SectionId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-md-6 col-xl-3">
                    <div class="qdrat-form-group">
                        <label asp-for="BatchId" class="qdrat-label">
                            الدفعة
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-select-wrapper">
                            <i class="fas fa-users"></i>
                            <select asp-for="BatchId" class="form-select qdrat-select" asp-items="Model.Batches">
                                <option value="">اختر دفعة</option>
                            </select>
                        </div>
                        <span asp-validation-for="BatchId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-md-6 col-xl-3">
                    <div class="qdrat-form-group">
                        <label asp-for="InstructorId" class="qdrat-label">
                            المدرب
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-select-wrapper">
                            <i class="fas fa-user-tie"></i>
                            <select asp-for="InstructorId" id="instructorSelect" class="form-select qdrat-select" asp-items="Model.Instructors">
                                <option value="">اختر مدرب</option>
                            </select>
                        </div>
                        <span asp-validation-for="InstructorId" class="text-danger small"></span>

                        <div class="qdrat-manual-toggle">
                            <label>
                                <input type="checkbox" id="manualOverrideCheckbox" />
                                تعيين يدوي خارج ربط المنهج/الدفعة
                            </label>
                            <p class="qdrat-manual-hint">
                                ⚠️ تعيين مدرب غير مرتبط بالمنهج/الدفعة لن يتأثر تلقائيًا لاحقًا بربط أو إلغاء ربط المدربين — راجع هذا التعيين يدويًا إن تغيّر الربط.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-actions">
            <button type="submit" class="qdrat-save-btn">
                <i class="fas fa-save"></i>
                حفظ التعديلات
            </button>

            <a asp-action="Index" class="qdrat-cancel-btn">
                <i class="fas fa-times"></i>
                إلغاء
            </a>
        </div>
    </form>
</div>

<style>
    .qdrat-page-wrapper {
        max-width: 1180px;
        margin: 0 auto;
        padding: 24px 16px 40px;
        font-family: 'Cairo', 'Tajawal', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .qdrat-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 22px;
        padding: 22px 24px;
        border-radius: 24px;
        background: linear-gradient(135deg, #0f766e 0%, #0891b2 55%, #2563eb 100%);
        color: #fff;
        box-shadow: 0 18px 45px rgba(15, 118, 110, 0.22);
    }

    .qdrat-page-title {
        margin: 0;
        font-size: 26px;
        font-weight: 900;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .qdrat-page-subtitle {
        margin: 8px 0 0;
        color: rgba(255, 255, 255, 0.88);
        font-size: 14px;
        line-height: 1.8;
    }

    .qdrat-back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 150px;
        padding: 11px 18px;
        border-radius: 999px;
        color: #fff;
        text-decoration: none;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.32);
        font-size: 14px;
        font-weight: 800;
        transition: all 0.2s ease-in-out;
    }

        .qdrat-back-btn:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.24);
            transform: translateY(-1px);
        }

    .qdrat-form-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 26px;
        box-shadow: 0 20px 55px rgba(15, 23, 42, 0.08);
        padding: 26px;
        overflow: hidden;
    }

    .qdrat-card-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding-bottom: 22px;
        border-bottom: 1px solid #eef2f7;
        margin-bottom: 24px;
    }

    .qdrat-card-icon {
        width: 54px;
        height: 54px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #ecfeff 0%, #dbeafe 100%);
        color: #0f766e;
        font-size: 22px;
        flex-shrink: 0;
    }

    .qdrat-card-header h2 {
        margin: 0;
        font-size: 20px;
        font-weight: 900;
        color: #111827;
    }

    .qdrat-card-header p {
        margin: 6px 0 0;
        color: #6b7280;
        font-size: 13px;
    }

    .qdrat-section {
        padding: 20px;
        border: 1px solid #eef2f7;
        background: #fbfdff;
        border-radius: 22px;
        margin-bottom: 20px;
    }

    .qdrat-section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 18px;
        color: #0f172a;
        font-size: 16px;
        font-weight: 900;
    }

        .qdrat-section-title i {
            color: #0f766e;
        }

    .qdrat-form-group {
        margin-bottom: 2px;
    }

    .qdrat-label {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 9px;
        color: #1f2937;
        font-size: 14px;
        font-weight: 900;
    }

    .qdrat-required {
        color: #dc2626;
        font-weight: 900;
    }

    .qdrat-input-wrapper,
    .qdrat-select-wrapper {
        position: relative;
    }

        .qdrat-input-wrapper i,
        .qdrat-select-wrapper i {
            position: absolute;
            top: 50%;
            right: 15px;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 15px;
            z-index: 2;
            pointer-events: none;
        }

    .qdrat-input,
    .qdrat-select {
        min-height: 48px;
        border-radius: 16px;
        border: 1px solid #dbe3ef;
        background-color: #fff;
        padding: 10px 44px 10px 14px;
        color: #111827;
        font-size: 14px;
        font-weight: 700;
        transition: all 0.18s ease-in-out;
    }

    .qdrat-select {
        cursor: pointer;
    }

        .qdrat-input:focus,
        .qdrat-select:focus {
            border-color: #0f766e;
            box-shadow: 0 0 0 4px rgba(15, 118, 110, 0.10);
        }

    .qdrat-validation-summary,
    .qdrat-alert-danger {
        color: #b91c1c;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 16px;
        padding: 12px 16px;
        margin-bottom: 20px;
        font-size: 14px;
        font-weight: 700;
    }

        .qdrat-validation-summary:empty {
            display: none;
        }

    .qdrat-alert-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .qdrat-alert ul {
        margin: 0;
        padding-right: 22px;
    }

    .qdrat-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding-top: 8px;
        flex-wrap: wrap;
    }

    .qdrat-save-btn,
    .qdrat-cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-width: 170px;
        min-height: 48px;
        border-radius: 999px;
        font-size: 15px;
        font-weight: 900;
        text-decoration: none;
        border: none;
        transition: all 0.2s ease-in-out;
    }

    .qdrat-save-btn {
        color: #fff;
        background: linear-gradient(135deg, #16a34a 0%, #0f766e 100%);
        box-shadow: 0 14px 30px rgba(22, 163, 74, 0.22);
    }

        .qdrat-save-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 18px 34px rgba(22, 163, 74, 0.28);
        }

    .qdrat-cancel-btn {
        color: #334155;
        background: #fff;
        border: 1px solid #cbd5e1;
    }

        .qdrat-cancel-btn:hover {
            color: #0f172a;
            background: #f8fafc;
            transform: translateY(-1px);
        }

    @@media (max-width: 768px) {
        .qdrat-page-header {
            flex-direction: column;
            align-items: stretch;
            padding: 20px;
        }

        .qdrat-page-title {
            font-size: 21px;
        }

        .qdrat-back-btn,
        .qdrat-save-btn,
        .qdrat-cancel-btn {
            width: 100%;
        }

        .qdrat-form-card {
            padding: 18px;
            border-radius: 22px;
        }

        .qdrat-section {
            padding: 16px;
        }

        .qdrat-actions {
            flex-direction: column;
        }
    }

    .qdrat-manual-toggle {
        margin-top: 10px;
    }

    .qdrat-manual-toggle label {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        font-weight: 700;
        color: #334155;
        cursor: pointer;
    }

    .qdrat-manual-hint {
        display: none;
        margin: 6px 0 0;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.7;
        color: #92400e;
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 10px;
        padding: 8px 10px;
    }

    .qdrat-manual-toggle.active .qdrat-manual-hint {
        display: block;
    }
</style>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        function calcEnd() {
            const timeVal = document.getElementById('scheduledTimeInput').value;
            const durVal = parseInt(document.getElementById('durationInput').value, 10);
            const display = document.getElementById('scheduledEndDisplay');
            const hidden = document.getElementById('scheduledEndTimeInput');

            if (timeVal && durVal > 0) {
                const [h, m] = timeVal.split(':').map(Number);
                const totalMin = h * 60 + m + durVal;
                const endH = Math.floor(totalMin / 60) % 24;
                const endM = totalMin % 60;
                const pad = n => String(n).padStart(2, '0');
                const endStr = `${pad(endH)}:${pad(endM)}`;
                display.value = endStr;
                hidden.value = endStr + ':00';
            } else {
                display.value = '';
                hidden.value = '';
            }
        }
        document.getElementById('scheduledTimeInput').addEventListener('change', calcEnd);
        document.getElementById('durationInput').addEventListener('input', calcEnd);
        // احسب عند التحميل إذا كانت القيم موجودة
        calcEnd();

        // ✅ تبديل قائمة المدربين بين "المرتبطين رسميًا" و"كل المدربين النشطين" عند تفعيل التعيين اليدوي
        (function () {
            var linkedInstructors = @Html.Raw(Json.Serialize(Model.Instructors.Select(i => new { id = i.Value, name = i.Text })));
            var allInstructors = @Html.Raw(Json.Serialize(Model.AllActiveInstructors.Select(i => new { id = i.Value, name = i.Text })));

            var select = document.getElementById('instructorSelect');
            var checkbox = document.getElementById('manualOverrideCheckbox');
            var wrapper = checkbox.closest('.qdrat-manual-toggle');

            function fillOptions(list) {
                var currentValue = select.value;
                select.innerHTML = '';
                var placeholder = document.createElement('option');
                placeholder.value = '';
                placeholder.textContent = 'اختر مدرب';
                select.appendChild(placeholder);
                list.forEach(function (i) {
                    var opt = document.createElement('option');
                    opt.value = i.id;
                    opt.textContent = i.name;
                    select.appendChild(opt);
                });
                if (list.some(function (i) { return String(i.id) === currentValue; })) {
                    select.value = currentValue;
                }
            }

            // ✅ فعّل التبديل تلقائيًا إن كان المدرب الحالي غير موجود أصلاً في قائمة المرتبطين رسميًا
            var currentInstructorId = select.value;
            var isCurrentLinked = linkedInstructors.some(function (i) { return String(i.id) === currentInstructorId; });
            if (currentInstructorId && !isCurrentLinked) {
                checkbox.checked = true;
                wrapper.classList.add('active');
                fillOptions(allInstructors);
                select.value = currentInstructorId;
            }

            checkbox.addEventListener('change', function () {
                wrapper.classList.toggle('active', checkbox.checked);
                fillOptions(checkbox.checked ? allInstructors : linkedInstructors);
            });
        })();
    </script>
}
