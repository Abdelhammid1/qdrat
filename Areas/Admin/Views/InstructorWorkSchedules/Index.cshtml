@model QdratNew.ViewModels.Instructor.InstructorScheduleFilterViewModel

@{
    ViewData["Title"] = "📅 مواعيد عمل المدربين";
}

<div class="container mt-4">

       <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold"><i class="fas fa-user-clock"></i> إدارة مواعيد عمل المدربين</h2>
        <br />
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus-circle"></i> إضافة موعد جديد
        </a>
    </div>
    <form method="get" class="row g-3 mb-4">
        <div class="col-md-5">
            <label class="form-label">🔍 تصفية حسب المدرب:</label>
            <select name="instructorId" class="form-select">
                <option value="">-- جميع المدربين --</option>
                @foreach (var instructor in Model.Instructors)
                {
                    <option value="@instructor.Value" selected="@(Model.SelectedInstructorId?.ToString() == instructor.Value)">
                        @instructor.Text
                    </option>
                }
            </select>
        </div>

        <div class="col-md-5">
            <label class="form-label">📅 تصفية حسب اليوم:</label>
            <select name="dayOfWeek" class="form-select">
                <option value="">-- كل الأيام --</option>
                @foreach (var d in Model.ArabicDays)
                {
                    <option value="@d.Value" selected="@(Model.SelectedDayOfWeek?.ToString() == d.Value)">
                        @d.Text
                    </option>
                }
            </select>
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-outline-primary w-100">
                <i class="fas fa-filter"></i> تصفية
            </button>
        </div>
    </form>
    @if (Model != null && Model.Schedules.Any())
    {
        <table class="table table-bordered table-striped table-hover text-center shadow-sm" id="schedulesTable">
            <thead class="table-dark">
                <tr>
                    <th>👤 اسم المدرب</th>
                    <th>📅 اليوم</th>
                    <th>🕘 وقت البدء</th>
                    <th>🕔 وقت الانتهاء</th>
                    <th>⏸️ بداية الراحة</th>
                    <th>⏯️ نهاية الراحة</th>
                    <th>⚙️ الإجراءات</th>
                </tr>
            </thead>ً
            <tbody>
                @foreach (var item in Model.Schedules)
                {
                    <tr>
                        <td>@item.InstructorName</td>
                        <td>@DayNameHelper.GetArabicDay(item.DayOfWeek)</td>


                        <td>@TimeHelper.FormatTimeWithAmPm(item.StartTime)</td>
                        <td>@TimeHelper.FormatTimeWithAmPm(item.EndTime)</td>
                        <td>@(item.BreakStart.HasValue ? TimeHelper.FormatTimeWithAmPm(item.BreakStart.Value) : "—")</td>
                        <td>@(item.BreakEnd.HasValue ? TimeHelper.FormatTimeWithAmPm(item.BreakEnd.Value) : "—")</td>

                        <td>
                            <div class="d-flex justify-content-center gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info"><i class="fas fa-eye"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash-alt"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-warning text-center shadow-sm">
            <i class="fas fa-exclamation-circle"></i> لا توجد مواعيد عمل حالياً.
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#schedulesTable').DataTable({
                pageLength: 20, // ✅ عرض 20 صف تلقائيًا
                lengthMenu: [[10, 20, 50, -1], [10, 20, 50, "الكل"]],
                language: {
                    "search": "🔍 بحث:",
                    "paginate": {
                        "first": "الأول",
                        "last": "الأخير",
                        "next": "التالي",
                        "previous": "السابق"
                    },
                    "emptyTable": "لا توجد بيانات",
                    "info": "عرض _START_ إلى _END_ من أصل _TOTAL_",
                    "lengthMenu": "عرض _MENU_ صفوف"
                },
                dom: 'Bfrtip',
                buttons: [
                    { extend: 'copy', text: 'نسخ', className: 'btn btn-secondary' },
                    { extend: 'excel', text: 'Excel', className: 'btn btn-success' },
                    { extend: 'print', text: 'طباعة', className: 'btn btn-primary' }
                ]
            });
        });
    </script>
}

