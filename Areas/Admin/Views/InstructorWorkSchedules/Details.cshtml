@model QdratNew.ViewModels.Instructor.InstructorWorkScheduleViewModel

@{
    ViewData["Title"] = "📄 تفاصيل موعد العمل";
}

<div class="container mt-4">
    <h3 class="text-primary fw-bold mb-4"><i class="fas fa-info-circle"></i> تفاصيل موعد العمل</h3>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card border-success shadow-sm">
                <div class="card-header bg-success text-white fw-bold"><i class="fas fa-user"></i> معلومات المدرب</div>
                <div class="card-body">
                    <p><strong>👤 اسم المدرب:</strong> @Model.InstructorName</p>
                    <p><strong>📅 اليوم:</strong> @QdratNew.Helpers.DayNameHelper.GetArabicDay(Model.DayOfWeek)</p>
                    <p><strong>✅ يوم عمل:</strong> @(Model.IsWorkingDay ? "نعم" : "لا")</p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-info shadow-sm">
                <div class="card-header bg-info text-white fw-bold"><i class="fas fa-clock"></i> الوقت</div>
                <div class="card-body">
                    <p><strong>🕘 وقت البدء:</strong> @QdratNew.Helpers.TimeHelper.FormatTimeWithAmPm(Model.StartTime)</p>
                    <p><strong>🕔 وقت الانتهاء:</strong> @QdratNew.Helpers.TimeHelper.FormatTimeWithAmPm(Model.EndTime)</p>
                    <p><strong>☕ بداية الراحة:</strong> @(Model.BreakStart.HasValue ? QdratNew.Helpers.TimeHelper.FormatTimeWithAmPm(Model.BreakStart.Value) : "—")</p>
                    <p><strong>☕ نهاية الراحة:</strong> @(Model.BreakEnd.HasValue ? QdratNew.Helpers.TimeHelper.FormatTimeWithAmPm(Model.BreakEnd.Value) : "—")</p>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex justify-content-end gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="fas fa-edit"></i> تعديل
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-right"></i> رجوع للقائمة
        </a>
    </div>
</div>
