@model QdratNew.ViewModels.Instructor.InstructorWorkScheduleViewModel

@{
    ViewData["Title"] = "🗑️ تأكيد حذف الموعد";
}

<div class="container mt-4">
    <h3 class="text-danger fw-bold mb-4"><i class="fas fa-trash-alt"></i> تأكيد حذف موعد العمل</h3>

    <div class="alert alert-warning shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle"></i>
        هل أنت متأكد من أنك تريد حذف هذا الموعد؟ لا يمكن التراجع بعد الحذف.
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white fw-bold"><i class="fas fa-user"></i> معلومات المدرب</div>
                <div class="card-body">
                    <p><strong>👤 اسم المدرب:</strong> @Model.InstructorName</p>
                    <p><strong>📅 اليوم:</strong> @QdratNew.Helpers.DayNameHelper.GetArabicDay(Model.DayOfWeek)</p>
                    <p><strong>✅ يوم عمل:</strong> @(Model.IsWorkingDay ? "نعم" : "لا")</p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-secondary shadow-sm">
                <div class="card-header bg-secondary text-white fw-bold"><i class="fas fa-clock"></i> الوقت</div>
                <div class="card-body">
                    <p><strong>🕘 وقت البدء:</strong> @QdratNew.Helpers.TimeHelper.FormatTimeWithAmPm(Model.StartTime)</p>
                    <p><strong>🕔 وقت الانتهاء:</strong> @QdratNew.Helpers.TimeHelper.FormatTimeWithAmPm(Model.EndTime)</p>
                    <p><strong>☕ بداية الراحة:</strong> @(Model.BreakStart.HasValue ? QdratNew.Helpers.TimeHelper.FormatTimeWithAmPm(Model.BreakStart.Value) : "—")</p>
                    <p><strong>☕ نهاية الراحة:</strong> @(Model.BreakEnd.HasValue ? QdratNew.Helpers.TimeHelper.FormatTimeWithAmPm(Model.BreakEnd.Value) : "—")</p>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="DeleteConfirmed" method="post" class="mt-4">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex justify-content-end gap-2">
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash-alt"></i> تأكيد الحذف
            </button>
            <a asp-action="Index" class="btn btn-secondary">رجوع</a>
        </div>
    </form>
</div>
