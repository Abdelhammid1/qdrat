@model QdratNew.ViewModels.Instructor.InstructorWorkScheduleViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "إضافة موعد عمل للمدرب";
}

<div class="qdrat-page-wrapper" dir="rtl">
    <div class="qdrat-page-header">
        <div>
            <h1 class="qdrat-page-title">
                <i class="fas fa-calendar-plus"></i>
                إضافة موعد عمل للمدرب
            </h1>
            <p class="qdrat-page-subtitle">
                تحديد يوم العمل وساعات التواجد وفترة الراحة للمدرب داخل جدول المواعيد.
            </p>
        </div>

        <a asp-action="Index" class="qdrat-back-btn">
            <i class="fas fa-arrow-right"></i>
            العودة للقائمة
        </a>
    </div>

    <form asp-action="Create" method="post" class="qdrat-form-card">
        @Html.AntiForgeryToken()

        <div class="qdrat-card-header">
            <div class="qdrat-card-icon">
                <i class="fas fa-clock"></i>
            </div>
            <div>
                <h2>بيانات الموعد</h2>
                <p>اختر المدرب واليوم ثم حدد أوقات العمل والراحة بدقة.</p>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="qdrat-validation-summary"></div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="qdrat-errors-box">
                <div class="qdrat-errors-title">
                    <i class="fas fa-triangle-exclamation"></i>
                    يرجى مراجعة الأخطاء التالية
                </div>
                <ul>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-user-tie"></i>
                المدرب واليوم
            </div>

            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="InstructorId" class="qdrat-label">
                            اسم المدرب
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-select-wrapper">
                            <i class="fas fa-chalkboard-teacher"></i>
                            <select asp-for="InstructorId" class="form-select qdrat-select" asp-items="Model.Instructors">
                                <option value="">-- اختر المدرب --</option>
                            </select>
                        </div>
                        <span asp-validation-for="InstructorId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="DayOfWeek" class="qdrat-label">
                            اليوم
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-select-wrapper">
                            <i class="fas fa-calendar-day"></i>
                            <select asp-for="DayOfWeek" class="form-select qdrat-select" asp-items="Model.ArabicDays">
                                <option value="">-- اختر اليوم --</option>
                            </select>
                        </div>
                        <span asp-validation-for="DayOfWeek" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-business-time"></i>
                أوقات العمل
            </div>

            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="StartTime" class="qdrat-label">
                            وقت البدء
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-play"></i>
                            <input asp-for="StartTime" class="form-control qdrat-input" type="time" />
                        </div>
                        <span asp-validation-for="StartTime" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="EndTime" class="qdrat-label">
                            وقت الانتهاء
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-stop"></i>
                            <input asp-for="EndTime" class="form-control qdrat-input" type="time" />
                        </div>
                        <span asp-validation-for="EndTime" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-mug-hot"></i>
                فترة الراحة
            </div>

            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="BreakStart" class="qdrat-label">بداية الراحة</label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-hourglass-start"></i>
                            <input asp-for="BreakStart" class="form-control qdrat-input" type="time" />
                        </div>
                        <span asp-validation-for="BreakStart" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="BreakEnd" class="qdrat-label">نهاية الراحة</label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-hourglass-end"></i>
                            <input asp-for="BreakEnd" class="form-control qdrat-input" type="time" />
                        </div>
                        <span asp-validation-for="BreakEnd" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-section qdrat-switch-section">
            <div class="qdrat-switch-content">
                <div class="qdrat-switch-icon">
                    <i class="fas fa-toggle-on"></i>
                </div>
                <div>
                    <div class="qdrat-switch-title">حالة اليوم</div>
                    <div class="qdrat-switch-subtitle">تفعيل هذا الخيار يعني أن اليوم محسوب كيوم عمل للمدرب.</div>
                </div>
            </div>

            <label class="qdrat-switch">
                <input asp-for="IsWorkingDay" type="checkbox" />
                <span></span>
            </label>
        </div>

        <div class="qdrat-actions">
            <button type="submit" class="qdrat-save-btn">
                <i class="fas fa-save"></i>
                حفظ الموعد
            </button>

            <a asp-action="Index" class="qdrat-cancel-btn">
                <i class="fas fa-times"></i>
                رجوع
            </a>
        </div>
    </form>
</div>

<style>
    .qdrat-page-wrapper {
        max-width: 1180px;
        margin: 0 auto;
        padding: 24px 16px 40px;
        font-family: 'Cairo', 'Tajawal', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .qdrat-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 22px;
        padding: 22px 24px;
        border-radius: 24px;
        background: linear-gradient(135deg, #0f766e 0%, #0891b2 55%, #2563eb 100%);
        color: #fff;
        box-shadow: 0 18px 45px rgba(15, 118, 110, 0.22);
    }

    .qdrat-page-title {
        margin: 0;
        font-size: 26px;
        font-weight: 900;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .qdrat-page-subtitle {
        margin: 8px 0 0;
        color: rgba(255, 255, 255, 0.88);
        font-size: 14px;
        line-height: 1.8;
    }

    .qdrat-back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 150px;
        padding: 11px 18px;
        border-radius: 999px;
        color: #fff;
        text-decoration: none;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.32);
        font-size: 14px;
        font-weight: 800;
        transition: all 0.2s ease-in-out;
    }

        .qdrat-back-btn:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.24);
            transform: translateY(-1px);
        }

    .qdrat-form-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 26px;
        box-shadow: 0 20px 55px rgba(15, 23, 42, 0.08);
        padding: 26px;
        overflow: hidden;
    }

    .qdrat-card-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding-bottom: 22px;
        border-bottom: 1px solid #eef2f7;
        margin-bottom: 24px;
    }

    .qdrat-card-icon {
        width: 54px;
        height: 54px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #ecfeff 0%, #dbeafe 100%);
        color: #0f766e;
        font-size: 22px;
        flex-shrink: 0;
    }

    .qdrat-card-header h2 {
        margin: 0;
        font-size: 20px;
        font-weight: 900;
        color: #111827;
    }

    .qdrat-card-header p {
        margin: 6px 0 0;
        color: #6b7280;
        font-size: 13px;
    }

    .qdrat-section {
        padding: 20px;
        border: 1px solid #eef2f7;
        background: #fbfdff;
        border-radius: 22px;
        margin-bottom: 20px;
    }

    .qdrat-section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 18px;
        color: #0f172a;
        font-size: 16px;
        font-weight: 900;
    }

        .qdrat-section-title i {
            color: #0f766e;
        }

    .qdrat-label {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 9px;
        color: #1f2937;
        font-size: 14px;
        font-weight: 900;
    }

    .qdrat-required {
        color: #dc2626;
        font-weight: 900;
    }

    .qdrat-input-wrapper,
    .qdrat-select-wrapper {
        position: relative;
    }

        .qdrat-input-wrapper i,
        .qdrat-select-wrapper i {
            position: absolute;
            top: 50%;
            right: 15px;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 15px;
            z-index: 2;
            pointer-events: none;
        }

    .qdrat-input,
    .qdrat-select {
        height: 48px;
        border-radius: 16px;
        border: 1px solid #dbe3ef;
        background-color: #fff;
        padding: 10px 44px 10px 14px;
        color: #111827;
        font-size: 14px;
        font-weight: 700;
        transition: all 0.18s ease-in-out;
    }

        .qdrat-input:focus,
        .qdrat-select:focus {
            border-color: #0f766e;
            box-shadow: 0 0 0 4px rgba(15, 118, 110, 0.10);
        }

    .qdrat-validation-summary,
    .qdrat-errors-box {
        color: #b91c1c;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 16px;
        padding: 12px 16px;
        margin-bottom: 20px;
        font-size: 14px;
        font-weight: 700;
    }

        .qdrat-validation-summary:empty {
            display: none;
        }

    .qdrat-errors-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .qdrat-errors-box ul {
        margin: 0;
        padding-right: 20px;
    }

    .qdrat-switch-section {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        background: linear-gradient(135deg, #f8fafc 0%, #eef6ff 100%);
    }

    .qdrat-switch-content {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .qdrat-switch-icon {
        width: 46px;
        height: 46px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        color: #0f766e;
        box-shadow: 0 8px 20px rgba(15, 118, 110, 0.08);
        flex-shrink: 0;
    }

    .qdrat-switch-title {
        color: #0f172a;
        font-size: 15px;
        font-weight: 900;
    }

    .qdrat-switch-subtitle {
        color: #64748b;
        font-size: 13px;
        font-weight: 700;
        margin-top: 4px;
    }

    .qdrat-switch {
        position: relative;
        width: 58px;
        height: 32px;
        flex-shrink: 0;
    }

        .qdrat-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .qdrat-switch span {
            position: absolute;
            cursor: pointer;
            inset: 0;
            background: #cbd5e1;
            border-radius: 999px;
            transition: all 0.2s ease-in-out;
        }

            .qdrat-switch span:before {
                content: "";
                position: absolute;
                width: 24px;
                height: 24px;
                right: 4px;
                top: 4px;
                background: #fff;
                border-radius: 50%;
                transition: all 0.2s ease-in-out;
                box-shadow: 0 4px 12px rgba(15, 23, 42, 0.18);
            }

        .qdrat-switch input:checked + span {
            background: linear-gradient(135deg, #16a34a 0%, #0f766e 100%);
        }

            .qdrat-switch input:checked + span:before {
                right: 30px;
            }

    .qdrat-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding-top: 8px;
        flex-wrap: wrap;
    }

    .qdrat-save-btn,
    .qdrat-cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-width: 170px;
        min-height: 48px;
        border-radius: 999px;
        font-size: 15px;
        font-weight: 900;
        text-decoration: none;
        border: none;
        transition: all 0.2s ease-in-out;
    }

    .qdrat-save-btn {
        color: #fff;
        background: linear-gradient(135deg, #16a34a 0%, #0f766e 100%);
        box-shadow: 0 14px 30px rgba(22, 163, 74, 0.22);
    }

        .qdrat-save-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 18px 34px rgba(22, 163, 74, 0.28);
        }

    .qdrat-cancel-btn {
        color: #334155;
        background: #fff;
        border: 1px solid #cbd5e1;
    }

        .qdrat-cancel-btn:hover {
            color: #0f172a;
            background: #f8fafc;
            transform: translateY(-1px);
        }

    @@media (max-width: 768px) {
        .qdrat-page-header,
        .qdrat-switch-section {
            flex-direction: column;
            align-items: stretch;
        }

        .qdrat-page-title {
            font-size: 21px;
        }

        .qdrat-back-btn,
        .qdrat-save-btn,
        .qdrat-cancel-btn {
            width: 100%;
        }

        .qdrat-form-card {
            padding: 18px;
            border-radius: 22px;
        }

        .qdrat-section {
            padding: 16px;
        }

        .qdrat-actions {
            flex-direction: column;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
