@model QdratNew.ViewModels.Exam.PerformanceExamReviewViewModel
@using QdratNew.Helpers

@{
    ViewData["Title"] = "مراجعة اختبار مؤشر الأداء";

    var totalSections = Model.Sections?.Count() ?? 0;
    var totalQuestions = Model.Sections?.Sum(s => s.Questions.Count()) ?? 0;
    var examModeText = Model.IsOnline ? "أونلاين" : "حضوري";
}

@functions {
    string CleanText(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "—";
        }

        var text = System.Text.RegularExpressions.Regex.Replace(value, "<.*?>", " ");
        text = System.Net.WebUtility.HtmlDecode(text);
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\s+", " ").Trim();

        return string.IsNullOrWhiteSpace(text) ? "—" : text;
    }

    string SafeHtml(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "—";
        }

        return NumberHelper.ToIndicNumbersSafe(value);
    }

    string SafeText(string? value)
    {
        return NumberHelper.ToIndicNumbersSafe(CleanText(value));
    }

    string SafeNumber(object? value)
    {
        return NumberHelper.ToIndicNumbersSafe(value?.ToString() ?? "0");
    }

    string SafeDate(DateTime? value)
    {
        return value.HasValue
            ? NumberHelper.ToIndicNumbersSafe(value.Value.ToString("yyyy/MM/dd HH:mm"))
            : "—";
    }

    string GetDifficultyText(double difficultyLevel)
    {
        var level = (int)Math.Round(difficultyLevel);

        if (level <= 1)
        {
            return "سهل";
        }

        if (level == 2)
        {
            return "متوسط";
        }

        if (level == 3)
        {
            return "صعب";
        }

        return "صعب جدًا";
    }

    string GetDifficultyClass(double difficultyLevel)
    {
        var level = (int)Math.Round(difficultyLevel);

        if (level <= 1)
        {
            return "diff-easy";
        }

        if (level == 2)
        {
            return "diff-medium";
        }

        if (level == 3)
        {
            return "diff-hard";
        }

        return "diff-very-hard";
    }

    string GetDifficultyIcon(double difficultyLevel)
    {
        var level = (int)Math.Round(difficultyLevel);

        if (level <= 1)
        {
            return "bi-check-circle";
        }

        if (level == 2)
        {
            return "bi-exclamation-circle";
        }

        if (level == 3)
        {
            return "bi-fire";
        }

        return "bi-lightning-charge-fill";
    }
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

