            --q-primary-lt: #ede9fe;
            --q-success: #16a34a;
            --q-success-lt: #dcfce7;
            --q-danger: #dc2626;
            --q-danger-lt: #fee2e2;
            --q-warning: #d97706;
            --q-warning-lt: #fef3c7;
            --q-info: #0891b2;
            --q-info-lt: #cffafe;
