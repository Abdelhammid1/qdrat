                width: 100%;
                justify-content: center;
            }

            .qlb-actions {
                margin-right: 0;
            }

            .qlb-lesson-chip {
                width: 100%;
                margin-right: 0;
            }

            .qlb-modal .modal-dialog {
                margin: 8px;
            }

            .qlb-modal .modal-body {
                padding: 14px !important;
            }
        }
    </style>
}

<div class="qlb-page" dir="rtl">
    <div class="qlb-shell">

        <!-- Hero -->
        <div class="qlb-hero">
            <div class="qlb-hero-inner">
                <div class="qlb-hero-main">
                    <div class="qlb-hero-icon">
                        <i class="bi bi-clipboard-check"></i>
                    </div>

                    <h1>مراجعة اختبار مؤشر الأداء</h1>

                    <p class="qlb-hero-subtitle">
                        مراجعة بيانات الاختبار والأسئلة قبل الإرسال النهائي للطلاب، مع إمكانية معاينة السؤال أو استبداله من نفس الصفحة.
                    </p>

                    <div class="qlb-hero-meta">
                        <span class="qlb-hero-pill">
                            <i class="bi bi-journal-text"></i>
                            @Model.ExamTitle
                        </span>

                        <span class="qlb-hero-pill">
                            <i class="bi bi-book"></i>
                            @Model.CurriculumTitle
                        </span>

                        <span class="qlb-hero-pill">
                            <i class="bi bi-key"></i>
                            الكود: @(string.IsNullOrWhiteSpace(Model.ReferenceCode) ? "—" : SafeNumber(Model.ReferenceCode))
                        </span>
                    </div>
                </div>

                <a asp-action="Index" class="qlb-back-btn">
                    <i class="bi bi-arrow-right"></i>
                    رجوع
                </a>
            </div>
        </div>

        <!-- Stats -->
        <div class="qlb-stats">
            <div class="qlb-stat">
                <div class="qlb-stat-ico ico-blue">
                    <i class="bi bi-question-circle"></i>
                </div>
                <div class="qlb-stat-content">
                    <div class="qlb-stat-lbl">إجمالي الأسئلة</div>
                    <div class="qlb-stat-val">@SafeNumber(totalQuestions)</div>
                </div>
            </div>

            <div class="qlb-stat">
                <div class="qlb-stat-ico ico-green">
                    <i class="bi bi-diagram-3"></i>
                </div>
                <div class="qlb-stat-content">
                    <div class="qlb-stat-lbl">عدد المحاور</div>
                    <div class="qlb-stat-val">@SafeNumber(totalSections)</div>
                </div>
            </div>

            <div class="qlb-stat">
                <div class="qlb-stat-ico ico-amber">
                    <i class="bi bi-laptop"></i>
                </div>
                <div class="qlb-stat-content">
                    <div class="qlb-stat-lbl">نوع الاختبار</div>
                    <div class="qlb-stat-val">@examModeText</div>
                </div>
            </div>

            <div class="qlb-stat">
                <div class="qlb-stat-ico ico-cyan">
                    <i class="bi bi-send-check"></i>
                </div>
                <div class="qlb-stat-content">
                    <div class="qlb-stat-lbl">حالة المراجعة</div>
                    <div class="qlb-stat-val">جاهز للإرسال</div>
                </div>
            </div>
        </div>

        <!-- General Info -->
        <div class="qlb-info-card">
            <div class="qlb-info-grid">
                <div class="qlb-info-item">
                    <div class="qlb-info-label">
                        <i class="bi bi-journal-bookmark"></i>
                        العنوان
                    </div>
                    <div class="qlb-info-value">@Model.ExamTitle</div>
                </div>

                <div class="qlb-info-item">
                    <div class="qlb-info-label">
                        <i class="bi bi-book"></i>
                        المنهج
                    </div>
                    <div class="qlb-info-value">@Model.CurriculumTitle</div>
                </div>

                <div class="qlb-info-item">
                    <div class="qlb-info-label">
                        <i class="bi bi-calendar-event"></i>
                        البداية
                    </div>
                    <div class="qlb-info-value">@SafeDate(Model.StartAt)</div>
                </div>

                <div class="qlb-info-item">
                    <div class="qlb-info-label">
                        <i class="bi bi-calendar-x"></i>
                        النهاية
                    </div>
                    <div class="qlb-info-value">@SafeDate(Model.EndAt)</div>
                </div>

                <div class="qlb-info-item">
                    <div class="qlb-info-label">
                        <i class="bi bi-diagram-3"></i>
                        عدد المحاور
                    </div>
                    <div class="qlb-info-value">@SafeNumber(totalSections)</div>
                </div>

                <div class="qlb-info-item">
                    <div class="qlb-info-label">
                        <i class="bi bi-question-circle"></i>
                        عدد الأسئلة
                    </div>
                    <div class="qlb-info-value">@SafeNumber(totalQuestions)</div>
                </div>

                <div class="qlb-info-item">
                    <div class="qlb-info-label">
                        <i class="bi bi-laptop"></i>
                        نوع الاختبار
                    </div>
                    <div class="qlb-info-value">
                        @if (Model.IsOnline)
                        {
                            <span class="qlb-mode-badge mode-online">
                                <i class="bi bi-wifi"></i>
                                أونلاين
                            </span>
                        }
                        else
                        {
                            <span class="qlb-mode-badge mode-lab">
                                <i class="bi bi-building"></i>
                                حضوري
                            </span>
                        }
                    </div>
                </div>

                <div class="qlb-info-item">
                    <div class="qlb-info-label">
                        <i class="bi bi-key"></i>
                        كود المرجع
                    </div>
                    <div class="qlb-info-value">
                        @(string.IsNullOrWhiteSpace(Model.ReferenceCode) ? "—" : SafeNumber(Model.ReferenceCode))
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ReferenceCode))
            {
                <div class="qlb-reference-box">
                    <div>
                        <div class="qlb-reference-title">
                            <i class="bi bi-key"></i>
                            الكود المرجعي للاختبار
                        </div>
                        <div class="text-muted small mt-1">
                            يستخدم عند الحاجة لفتح الاختبار أو تتبعه داخل النظام.
                        </div>
                    </div>

                    <div class="qlb-reference-code">
                        @SafeNumber(Model.ReferenceCode)
                    </div>
                </div>
            }
        </div>

        <!-- Sections / Questions -->
        @if (Model.Sections != null && Model.Sections.Any())
        {
            @foreach (var sec in Model.Sections)
            {
                <div class="qlb-section">
                    <div class="qlb-section-head">
                        <h2 class="qlb-section-title">
                            <i class="bi bi-diagram-3"></i>
                            @sec.SectionTitle
                        </h2>

                        <span class="qlb-section-count">
                            <i class="bi bi-question-circle"></i>
                            @SafeNumber(sec.Questions.Count()) سؤال
                        </span>
                    </div>

                    @if (sec.Questions != null && sec.Questions.Any())
                    {
                        <div class="qlb-grid">
                            @foreach (var q in sec.Questions)
                            {
                                var fullTitle = CleanText(q.Title);
                                var lessonTitle = CleanText(q.LessonTitle);
                                var correctAnswer = CleanText(q.CorrectAnswer);

                                var difficultyText = GetDifficultyText(q.DifficultyLevel);
                                var difficultyClass = GetDifficultyClass(q.DifficultyLevel);
                                var difficultyIcon = GetDifficultyIcon(q.DifficultyLevel);

                                <div class="qlb-card">

                                    <!-- Card Header -->
                                    <div class="qlb-card-head">
                                        <div class="qlb-qnum">
                                            @SafeNumber(q.Order)
                                        </div>

                                        <span class="qlb-diff-badge @difficultyClass">
                                            <i class="bi @difficultyIcon"></i>
                                            @difficultyText
                                        </span>

                                        <span class="qlb-lesson-chip" title="@lessonTitle">
                                            <i class="bi bi-bullseye"></i>
                                            <span>@lessonTitle</span>
                                        </span>
                                    </div>

                                    <!-- Card Body -->
                                    <div class="qlb-card-body">

                                        <!-- Question Text - Bold -->
                                        <div class="qlb-qtitle" title="@fullTitle">
                                            <strong>
                                                @Html.Raw(SafeHtml(q.Title))
                                            </strong>
                                        </div>

                                        <!-- Correct Answer -->
                                        <div class="qlb-answer-box">
                                            <div class="qlb-answer-label">
                                                <i class="bi bi-check-circle"></i>
                                                الإجابة الصحيحة
                                            </div>

                                            <div class="qlb-answer-text" title="@correctAnswer">
                                                @Html.Raw(SafeHtml(q.CorrectAnswer))
                                            </div>
                                        </div>

                                    </div>

                                    <!-- Card Footer -->
                                    <div class="qlb-card-foot">
                                        <span class="qlb-foot-chip fc-primary">
                                            <i class="bi bi-hash"></i>
                                            ترتيب السؤال: @SafeNumber(q.Order)
                                        </span>

                                        <span class="qlb-foot-chip fc-muted">
                                            <i class="bi bi-bullseye"></i>
                                            @lessonTitle
                                        </span>

                                        <div class="qlb-actions">
                                            <button type="button"
                                                    class="qlb-btn qlb-btn-info"
                                                    onclick="previewQuestion('@q.QuestionId')"
                                                    title="معاينة">
                                                <i class="bi bi-eye"></i>
                                                معاينة
                                            </button>

                                            <a asp-action="ReplaceQuestionPage"
                                               asp-route-examId="@Model.ExamId"
                                               asp-route-sectionId="@sec.SectionId"
                                               asp-route-oldId="@q.QuestionId"
                                               class="qlb-btn qlb-btn-purple"
                                               title="استبدال">
                                                <i class="bi bi-arrow-repeat"></i>
                                                استبدال
                                            </a>
                                        </div>
                                    </div>

                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="qlb-empty">
                            <i class="bi bi-info-circle"></i>
                            لا توجد أسئلة داخل هذا المحور.
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="qlb-empty">
                <i class="bi bi-info-circle"></i>
                لا توجد محاور أو أسئلة مرتبطة بهذا الاختبار.
            </div>
        }

        <!-- Send -->
        <form asp-action="ConfirmSendPost" method="post" class="qlb-send-panel">
            @Html.AntiForgeryToken()
            <input type="hidden" name="examId" value="@Model.ExamId" />

            <button type="submit" class="qlb-send-btn">
                <i class="bi bi-send-check"></i>
                تأكيد الإرسال
            </button>
        </form>

    </div>
</div>

<div class="modal fade qlb-modal" id="questionPreviewModal" tabindex="-1" aria-hidden="true" dir="rtl">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content text-end">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-eye"></i>
                    معاينة السؤال
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body" id="questionPreviewBody">
                <div class="qlb-preview-loading">
                    <i class="bi bi-hourglass-split"></i>
                    جارٍ تحميل السؤال...
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewQuestion(qid) {
            const modalEl = document.getElementById('questionPreviewModal');
            const body = document.getElementById('questionPreviewBody');
            const modal = new bootstrap.Modal(modalEl);

            body.innerHTML = `
                <div class="qlb-preview-loading">
                    <i class="bi bi-hourglass-split"></i>
                    جارٍ تحميل السؤال...
                </div>`;

            modal.show();

            fetch(`/Admin/PerformanceIndicatorExams/PreviewPerformanceQuestion?id=${qid}`)
                .then(async response => {
                    if (!response.ok) {
                        throw new Error("PREVIEW_FAILED");
                    }

                    const html = await response.text();

                    if (html.includes("System.InvalidOperationException") || html.includes("DeveloperExceptionPage")) {
                        throw new Error("SERVER_EXCEPTION");
                    }

                    return html;
                })
                .then(html => {
                    body.innerHTML = html;
                })
                .catch(() => {
                    body.innerHTML = `
                        <div class="qlb-preview-loading">
                            <i class="bi bi-exclamation-triangle text-danger"></i>
                            تعذر تحميل معاينة السؤال.
                        </div>`;
                });
        }
    </script>
}