                height: 1px;
                background: #dbe4ef;
            }

        .pr-info-panel {
            background: #ffffff;
            border: 1px solid var(--pr-border);
            border-radius: var(--pr-radius);
            padding: 20px;
            margin-bottom: 24px;
            box-shadow: var(--pr-shadow);
        }

        .pr-info-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
        }

        .pr-info-item {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 13px 14px;
        }

        .pr-info-label {
            display: block;
            color: #64748b;
            font-size: 12px;
            font-weight: 900;
            margin-bottom: 6px;
        }

        .pr-info-value {
            color: #0f172a;
            font-size: 14px;
            font-weight: 900;
            line-height: 1.7;
            word-break: break-word;
        }

        .pr-section-card {
            background: #ffffff;
            border: 1px solid var(--pr-border);
            border-radius: var(--pr-radius);
            box-shadow: var(--pr-shadow);
            overflow: hidden;
            margin-bottom: 22px;
        }

        .pr-section-head {
            background: #ffffff;
            border-bottom: 1px solid var(--pr-border);
            padding: 14px 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .pr-section-title {
            color: #0f172a;
            font-size: 15px;
            font-weight: 900;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
            line-height: 1.7;
        }

            .pr-section-title i {
                color: var(--pr-accent);
            }

        .pr-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            border-radius: 999px;
            padding: 5px 10px;
            font-size: 11px;
            font-weight: 900;
            white-space: nowrap;
            border: 1px solid transparent;
        }

        .pr-badge-primary {
            background: #dbeafe;
            color: #1d4ed8;
            border-color: #bfdbfe;
        }

        .pr-badge-success {
            background: #dcfce7;
            color: #166534;
            border-color: #86efac;
        }

        .pr-badge-warning {
            background: #fef3c7;
            color: #92400e;
            border-color: #fde68a;
        }

        .pr-badge-danger {
            background: #fee2e2;
            color: #991b1b;
            border-color: #fecaca;
        }

        .pr-badge-secondary {
            background: #f1f5f9;
            color: #475569;
            border-color: #cbd5e1;
        }

        .pr-table-panel {
            background: #ffffff;
            overflow-x: auto;
        }

        .pr-table {
            width: 100%;
            border-collapse: collapse;
            margin: 0;
            table-layout: fixed;
        }

            .pr-table th {
                background: #f1f5f9;
                color: #0f172a;
                padding: 12px 8px;
                font-size: 12px;
                font-weight: 900;
                border: 1px solid #dbe4ef;
                text-align: center;
                white-space: nowrap;
            }

            .pr-table td {
                padding: 11px 8px;
                border: 1px solid #e2e8f0;
                vertical-align: middle;
                text-align: center;
                font-size: 13px;
                font-weight: 700;
                color: #0f172a;
                background: #ffffff;
            }

            .pr-table tbody tr:hover td {
                background: #f8fafc;
            }

        .pr-col-order {
            width: 60px;
        }

        .pr-col-ref {
            width: 110px;
        }

        .pr-col-question {
            width: 330px;
        }

        .pr-col-curriculum {
