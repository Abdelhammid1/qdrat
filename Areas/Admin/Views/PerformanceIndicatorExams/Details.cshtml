            --pr-accent: #2563eb;
            --pr-success: #16a34a;
            --pr-danger: #dc2626;
            --pr-warning: #f59e0b;
            --pr-info: #0284c7;
            --pr-text: #0f172a;
            --pr-muted: #64748b;
            --pr-radius: 14px;
            --pr-radius-sm: 9px;
