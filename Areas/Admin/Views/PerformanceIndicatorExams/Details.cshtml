            margin-bottom: 24px;
            box-shadow: var(--pr-shadow);
        }

        .pr-hero-label {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: #eff6ff;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
