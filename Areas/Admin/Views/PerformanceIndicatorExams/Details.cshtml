            white-space: nowrap;
        }

        .btn-pr-primary {
            background: var(--pr-accent);
            border-color: var(--pr-accent);
            color: #ffffff;
        }

        .btn-pr-success {
            background: var(--pr-success);
            border-color: var(--pr-success);
            color: #ffffff;
        }

        .btn-pr-outline {
            background: #ffffff;
            border-color: #cbd5e1;
            color: #334155;
        }

        .btn-pr-primary:hover,
        .btn-pr-success:hover {
            color: #ffffff;
            transform: translateY(-1px);
            text-decoration: none;
            filter: brightness(.96);
        }

        .btn-pr-outline:hover {
            background: #f1f5f9;
            color: #0f172a;
            transform: translateY(-1px);
            text-decoration: none;
        }

        .pr-hero {
            background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
