            font-size: 12px;
            font-weight: 900;
            margin-bottom: 12px;
        }

        .pr-hero-title {
            margin: 0;
            color: var(--pr-text);
            font-size: 28px;
            font-weight: 900;
            line-height: 1.35;
        }

        .pr-hero-sub {
            color: #475569;
            font-size: 13px;
            font-weight: 700;
            margin-top: 8px;
            line-height: 1.8;
        }

        .pr-chips {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
        }

        .pr-chip {
            background: #ffffff;
            border: 1px solid #dbe4ef;
            border-radius: 13px;
            padding: 14px;
            text-align: center;
            box-shadow: 0 4px 14px rgba(15, 23, 42, .04);
        }

        .pr-chip-val {
            font-size: 22px;
            font-weight: 900;
            line-height: 1;
        }

        .pr-chip-lbl {
            margin-top: 7px;
            color: #64748b;
            font-size: 12px;
            font-weight: 800;
        }

        .pr-section-label {
            font-size: 14px;
            font-weight: 900;
            color: #334155;
            margin: 20px 0 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

