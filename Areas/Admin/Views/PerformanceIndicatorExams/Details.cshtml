            display: inline-block;
            vertical-align: middle;
        }

        .pr-actions {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 6px;
            flex-wrap: nowrap;
        }

        .pr-action-btn {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            border: 1px solid transparent;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: var(--pr-transition);
            padding: 0;
            cursor: pointer;
            font-size: 13px;
        }

            .pr-action-btn.preview {
                color: #0369a1;
                background: #e0f2fe;
                border-color: #bae6fd;
            }

            .pr-action-btn.replace {
