@model QdratNew.ViewModels.Exam.PerformanceIndicatorExamViewModel

@{
    ViewData["Title"] = "تفاصيل اختبار مؤشر الأداء";

    var totalSections = Model.Sections?.Count(s => s.QuestionCount > 0) ?? 0;
    var totalQuestions = Model.TotalQuestions;
    var activeSections = Model.Sections?.Where(s => s.QuestionCount > 0).ToList() ?? new List<QdratNew.ViewModels.Exam.PerformanceIndicatorExamSectionViewModel>();
}

@functions {
    string CleanText(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "—";
        }

        var text = System.Text.RegularExpressions.Regex.Replace(value, "<.*?>", " ");
        text = System.Net.WebUtility.HtmlDecode(text);
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\s+", " ").Trim();

        return string.IsNullOrWhiteSpace(text) ? "—" : text;
    }

    string ShortText(string? value, int maxLength)
    {
        var text = CleanText(value);

        if (text == "—")
        {
            return text;
        }

        return text.Length <= maxLength ? text : text.Substring(0, maxLength) + "...";
    }

    string GetDifficultyClass(string? difficultyText)
    {
        var text = difficultyText ?? "";

        if (text.Contains("سهل") || text.Contains("Easy"))
        {
            return "pr-badge-success";
        }

        if (text.Contains("صعب") || text.Contains("Hard"))
        {
            return "pr-badge-danger";
        }

        return "pr-badge-warning";
    }

    string GetDifficultyIcon(string? difficultyText)
    {
        var text = difficultyText ?? "";

        if (text.Contains("سهل") || text.Contains("Easy"))
        {
            return "fa-solid fa-check-circle";
        }

        if (text.Contains("صعب") || text.Contains("Hard"))
        {
            return "fa-solid fa-fire";
        }

        return "fa-solid fa-exclamation-circle";
    }
}

@section Styles {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <style>
