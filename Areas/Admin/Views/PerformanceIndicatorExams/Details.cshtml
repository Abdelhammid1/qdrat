        .pr-modal .modal-header {
            background: #ffffff;
            border-bottom: 1px solid #dbe4ef;
            padding: 16px 22px;
        }

        .pr-modal .modal-title {
            font-size: 15px;
            font-weight: 900;
            color: #0f172a;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .pr-modal .modal-title i {
                color: var(--pr-accent);
            }

        .pr-modal .modal-body {
            background: #f8fafc !important;
            padding: 22px !important;
            min-height: 240px;
        }

        .pr-preview-loading {
            text-align: center;
            color: #64748b;
            font-weight: 800;
            padding: 42px 20px;
        }

            .pr-preview-loading i {
                display: block;
                font-size: 30px;
                margin-bottom: 10px;
                color: var(--pr-accent);
            }

        #questionPreviewBody p,
        #questionPreviewBody div,
        #questionPreviewBody span,
        #questionPreviewBody label,
        #questionPreviewBody strong,
        #questionPreviewBody small,
        #questionPreviewBody li {
            color: #0f172a !important;
            opacity: 1 !important;
        }

        #questionPreviewBody .card,
        #questionPreviewBody .question-card,
        #questionPreviewBody .question-preview-card,
        #questionPreviewBody .q-card,
        #questionPreviewBody .preview-box,
        #questionPreviewBody .question-box {
            background: #ffffff !important;
            color: #0f172a !important;
            border: 1px solid #dbe4ef !important;
            border-radius: 16px !important;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08) !important;
            padding: 18px !important;
        }

        @@media (max-width: 1200px) {
            .pr-table {
                table-layout: auto;
            }

            .pr-col-question {
                min-width: 300px;
            }

            .pr-col-actions {
                min-width: 130px;
            }
        }

        @@media (max-width: 992px) {
            .pr-info-grid,
            .pr-chips {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 768px) {
            .pr-page {
                padding: 18px 0 40px;
            }

            .pr-hero {
                padding: 20px;
            }

            .pr-hero-title {
                font-size: 23px;
            }

            .pr-info-grid,
            .pr-chips {
                grid-template-columns: 1fr;
            }

            .pr-header-actions,
            .btn-pr-outline,
            .btn-pr-primary,
            .btn-pr-success {
                width: 100%;
            }
        }
    </style>
}

<div class="pr-page container-fluid px-4" dir="rtl">
    <div class="pr-header">
        <div>
            <h1 class="pr-header-title">
                <i class="fa-solid fa-clipboard-list"></i>
                تفاصيل اختبار مؤشر الأداء
            </h1>

            <div class="pr-header-sub">
                مراجعة بيانات الاختبار، المحاور، الأسئلة المرسلة، وحالة الإرسال إلى الطلاب.
            </div>
        </div>

        <div class="pr-header-actions">
            <a asp-action="Index" class="btn-pr-outline">
                <i class="fa-solid fa-arrow-right"></i>
                رجوع
            </a>

            <a asp-action="Review"
               asp-route-id="@Model.Id"
               class="btn-pr-outline">
                <i class="fa-solid fa-eye"></i>
                مراجعة الأسئلة
            </a>

            <a asp-action="ExamStudents"
               asp-route-id="@Model.Id"
               class="btn-pr-primary">
                <i class="fa-solid fa-users"></i>
                الطلاب والنتائج
            </a>
        </div>
    </div>

    <div class="pr-hero">
        <div class="row g-4 align-items-center">
            <div class="col-lg-5">
                <div class="pr-hero-label">
                    <i class="fa-solid fa-chart-line"></i>
                    اختبار رقم @Model.Id
                </div>

                <h2 class="pr-hero-title">@Model.Title</h2>

                <div class="pr-hero-sub">
                    المنهج: @Model.CurriculumTitle
                    <br />
                    الدفعات: @Model.BatchName
                </div>
            </div>

            <div class="col-lg-7">
                <div class="pr-chips">
                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#2563eb;">@Model.TotalQuestions</div>
                        <div class="pr-chip-lbl">إجمالي الأسئلة</div>
                    </div>

                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#16a34a;">@totalSections</div>
                        <div class="pr-chip-lbl">محاور بها أسئلة</div>
                    </div>

                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#f59e0b;">@Model.DurationMinutes</div>
                        <div class="pr-chip-lbl">دقيقة</div>
                    </div>

                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#dc2626;">@Model.PassPercent%</div>
                        <div class="pr-chip-lbl">نسبة الاجتياز</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="pr-section-label">معلومات الاختبار</div>

    <div class="pr-info-panel">
        <div class="pr-info-grid">
            <div class="pr-info-item">
                <span class="pr-info-label">الكود المرجعي</span>
                <div class="pr-info-value">@(string.IsNullOrWhiteSpace(Model.ReferenceCode) ? "—" : Model.ReferenceCode)</div>
            </div>

            <div class="pr-info-item">
                <span class="pr-info-label">تاريخ الإنشاء</span>
                <div class="pr-info-value">@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</div>
            </div>

            <div class="pr-info-item">
                <span class="pr-info-label">بداية الاختبار</span>
                <div class="pr-info-value">@Model.StartAt.ToString("yyyy/MM/dd HH:mm")</div>
            </div>

            <div class="pr-info-item">
                <span class="pr-info-label">نهاية الاختبار</span>
                <div class="pr-info-value">@Model.EndAt.ToString("yyyy/MM/dd HH:mm")</div>
            </div>

            <div class="pr-info-item">
                <span class="pr-info-label">نوع الاختبار</span>
                <div class="pr-info-value">@(Model.IsOnline ? "أونلاين" : "حضوري")</div>
            </div>

            <div class="pr-info-item">
                <span class="pr-info-label">حالة الإرسال</span>
                <div class="pr-info-value">@(Model.IsSent ? "تم الإرسال" : "لم يرسل")</div>
            </div>

            <div class="pr-info-item">
                <span class="pr-info-label">عدد المحاور</span>
                <div class="pr-info-value">@Model.TotalSections</div>
            </div>

            <div class="pr-info-item">
                <span class="pr-info-label">عدد الأسئلة</span>
                <div class="pr-info-value">@Model.TotalQuestions</div>
            </div>
        </div>
    </div>

    <div class="pr-section-label">أسئلة الاختبار حسب المحاور</div>

    @if (Model.Sections == null || !Model.Sections.Any(s => s.QuestionCount > 0))
    {
        <div class="pr-empty">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            لا توجد أسئلة مرتبطة بهذا الاختبار حتى الآن.
        </div>
    }
    else
    {
        foreach (var sec in Model.Sections.Where(s => s.QuestionCount > 0))
        {
            <div class="pr-section-card">
                <div class="pr-section-head">
                    <h3 class="pr-section-title">
                        <i class="fa-solid fa-layer-group"></i>
                        @sec.SectionTitle
                    </h3>

                    <span class="pr-badge pr-badge-primary">
                        <i class="fa-solid fa-question-circle"></i>
                        @sec.QuestionCount سؤال
                    </span>
                </div>

                @if (sec.Questions == null || !sec.Questions.Any())
                {
                    <div class="p-3">
                        <div class="pr-empty">لا توجد أسئلة في هذا المحور.</div>
                    </div>
                }
                else
                {
                    <div class="pr-table-panel">
                        <div class="table-responsive">
                            <table class="pr-table">
                                <thead>
                                    <tr>
                                        <th class="pr-col-order">#</th>
                                        <th class="pr-col-ref">رقم السؤال</th>
                                        <th class="pr-col-question">نص السؤال</th>
                                        <th class="pr-col-curriculum">المنهج</th>
                                        <th class="pr-col-lesson">المؤشر</th>
                                        <th class="pr-col-difficulty">الصعوبة</th>
                                        <th class="pr-col-answer">الإجابة</th>
                                        <th class="pr-col-actions">الإجراءات</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var question in sec.Questions)
                                    {
                                        var fullTitle = CleanText(question.Title);
                                        var shortTitle = ShortText(question.Title, 55);

                                        var curriculumTitle = CleanText(question.CurriculumTitle);
                                        var lessonTitle = CleanText(question.LessonTitle);

                                        var correctAnswer = CleanText(question.CorrectAnswer);
                                        var shortCorrectAnswer = ShortText(question.CorrectAnswer, 18);

                                        var difficultyClass = GetDifficultyClass(question.DifficultyText);
                                        var difficultyIcon = GetDifficultyIcon(question.DifficultyText);

                                        <tr>
                                            <td>
                                                <span class="pr-badge pr-badge-primary">@question.Order</span>
                                            </td>

                                            <td>
                                                <span class="pr-badge pr-badge-secondary">
                                                    @(string.IsNullOrWhiteSpace(question.ReferenceNumber) ? "—" : question.ReferenceNumber)
                                                </span>
                                            </td>

                                            <td class="text-end">
                                                <span class="pr-question-title" title="@fullTitle">
                                                    @shortTitle
                                                </span>
                                            </td>

                                            <td>
                                                <span class="pr-short-text" title="@curriculumTitle">
                                                    @ShortText(question.CurriculumTitle, 16)
                                                </span>
                                            </td>

                                            <td>
                                                <span class="pr-short-text" title="@lessonTitle">
                                                    @ShortText(question.LessonTitle, 18)
                                                </span>
                                            </td>

                                            <td>
                                                <span class="pr-badge @difficultyClass">
                                                    <i class="@difficultyIcon"></i>
                                                    @(string.IsNullOrWhiteSpace(question.DifficultyText) ? "متوسط" : question.DifficultyText)
                                                </span>
                                            </td>

                                            <td>
                                                <span class="pr-short-text" title="@correctAnswer">
                                                    @shortCorrectAnswer
                                                </span>
                                            </td>

                                            <td>
                                                <div class="pr-actions">
                                                    <button type="button"
                                                            class="pr-action-btn preview"
                                                            data-question-preview="@question.QuestionId"
                                                            title="معاينة السؤال">
                                                        <i class="fa-solid fa-eye"></i>
                                                    </button>

                                                    <a asp-action="ReplaceQuestionPage"
                                                       asp-route-examId="@Model.Id"
                                                       asp-route-sectionId="@sec.SectionId"
                                                       asp-route-oldId="@question.QuestionId"
                                                       class="pr-action-btn replace"
                                                       title="استبدال السؤال">
                                                        <i class="fa-solid fa-arrow-rotate-right"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        }
    }

    @if (!Model.IsSent)
    {
        <div class="pr-send-panel">
            <a asp-action="ConfirmSend"
               asp-route-id="@Model.Id"
               class="btn-pr-success">
                <i class="fa-solid fa-paper-plane"></i>
                إرسال الاختبار للدفعات
            </a>
        </div>
    }
</div>

<div class="modal fade pr-modal" id="questionPreviewModal" tabindex="-1" aria-hidden="true" dir="rtl">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content text-end">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fa-solid fa-eye"></i>
                    معاينة السؤال
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body" id="questionPreviewBody">
                <div class="pr-preview-loading">
                    <i class="fa-solid fa-spinner fa-spin"></i>
                    جارٍ تحميل السؤال...
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-question-preview]').forEach(button => {
            button.addEventListener('click', async () => {
                const questionId = button.getAttribute('data-question-preview');
                const modalEl = document.getElementById('questionPreviewModal');
                const body = document.getElementById('questionPreviewBody');
                const modal = new bootstrap.Modal(modalEl);

                body.innerHTML = `
                    <div class="pr-preview-loading">
                        <i class="fa-solid fa-spinner fa-spin"></i>
                        جارٍ تحميل السؤال...
                    </div>`;

                modal.show();

                try {
                    const response = await fetch(`/Admin/PerformanceIndicatorExams/PreviewQuestion/${questionId}`);

                    if (!response.ok) {
                        throw new Error("PREVIEW_FAILED");
                    }

                    const html = await response.text();

                    if (html.includes("System.InvalidOperationException") || html.includes("DeveloperExceptionPage")) {
                        throw new Error("SERVER_EXCEPTION");
                    }

                    body.innerHTML = html;
                } catch {
                    body.innerHTML = `
                        <div class="pr-empty">
                            <i class="fa-solid fa-triangle-exclamation me-2"></i>
                            تعذر تحميل معاينة السؤال.
                        </div>`;
                }
            });
        });
    </script>
}
