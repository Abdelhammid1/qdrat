@model QdratNew.ViewModels.Exam.ConfirmSendPerformanceExamViewModel

@{
    ViewData["Title"] = "تأكيد إرسال اختبار مؤشر الأداء";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        :root {
            --pr-bg: #f4f7fb;
            --pr-card: #ffffff;
            --pr-border: #dbe4ef;
            --pr-accent: #2563eb;
            --pr-success: #16a34a;
            --pr-danger: #dc2626;
            --pr-warning: #f59e0b;
            --pr-text: #0f172a;
            --pr-muted: #64748b;
            --pr-radius: 14px;
            --pr-radius-sm: 9px;
            --pr-shadow: 0 8px 22px rgba(15, 23, 42, .06);
            --pr-transition: .2s cubic-bezier(.4,0,.2,1);
        }

        body {
            background: var(--pr-bg) !important;
        }

        .pr-page {
            min-height: 100vh;
            padding: 28px 0 60px;
            direction: rtl;
            font-family: 'Cairo', Arial, sans-serif;
        }

        .pr-header {
            background: #ffffff;
            border: 1px solid var(--pr-border);
            border-radius: var(--pr-radius);
            padding: 18px 22px;
            box-shadow: var(--pr-shadow);
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 24px;
        }

        .pr-header-title {
            color: var(--pr-text);
            font-size: 22px;
            font-weight: 900;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
            line-height: 1.35;
        }

            .pr-header-title i {
                color: var(--pr-accent);
            }

        .pr-header-sub {
            color: #475569;
            font-size: 13px;
            font-weight: 700;
            margin-top: 6px;
            line-height: 1.8;
        }

        .btn-pr-primary,
        .btn-pr-success,
        .btn-pr-outline {
            border-radius: var(--pr-radius-sm);
            padding: 8px 18px;
            font-size: 13px;
            font-weight: 900;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            text-decoration: none;
            border: 1px solid transparent;
            transition: var(--pr-transition);
            cursor: pointer;
            white-space: nowrap;
        }

        .btn-pr-success {
            background: var(--pr-success);
            border-color: var(--pr-success);
            color: #ffffff;
        }

        .btn-pr-outline {
            background: #ffffff;
            border-color: #cbd5e1;
            color: #334155;
        }

        .btn-pr-success:hover {
            color: #ffffff;
            transform: translateY(-1px);
            text-decoration: none;
            filter: brightness(.96);
        }

        .btn-pr-outline:hover {
            background: #f1f5f9;
            color: #0f172a;
            transform: translateY(-1px);
            text-decoration: none;
        }

        .pr-hero {
            background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
            border: 1px solid var(--pr-border);
            border-radius: var(--pr-radius);
            padding: 24px 28px;
            margin-bottom: 24px;
            box-shadow: var(--pr-shadow);
        }

        .pr-hero-label {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: #eff6ff;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
            border-radius: 999px;
            padding: 5px 12px;
            font-size: 12px;
            font-weight: 900;
            margin-bottom: 12px;
        }

        .pr-hero-title {
            margin: 0;
            color: var(--pr-text);
            font-size: 28px;
            font-weight: 900;
            line-height: 1.35;
        }

        .pr-hero-sub {
            color: #475569;
            font-size: 13px;
            font-weight: 700;
            margin-top: 8px;
            line-height: 1.8;
        }

        .pr-chips {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
        }

        .pr-chip {
            background: #ffffff;
            border: 1px solid #dbe4ef;
            border-radius: 13px;
            padding: 14px;
            text-align: center;
            box-shadow: 0 4px 14px rgba(15, 23, 42, .04);
        }

        .pr-chip-val {
            font-size: 22px;
            font-weight: 900;
            line-height: 1;
        }

        .pr-chip-lbl {
            margin-top: 7px;
            color: #64748b;
            font-size: 12px;
            font-weight: 800;
        }

        .pr-panel {
            background: #ffffff;
            border: 1px solid var(--pr-border);
            border-radius: var(--pr-radius);
            box-shadow: var(--pr-shadow);
            overflow: hidden;
        }

        .pr-panel-head {
            padding: 16px 20px;
            border-bottom: 1px solid var(--pr-border);
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 900;
            color: #0f172a;
        }

            .pr-panel-head i {
                color: var(--pr-accent);
            }

        .pr-panel-body {
            padding: 20px;
        }

        .pr-info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-bottom: 18px;
        }

        .pr-info-item {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 13px 14px;
        }

        .pr-info-label {
            display: block;
            color: #64748b;
            font-size: 12px;
            font-weight: 900;
            margin-bottom: 6px;
        }

        .pr-info-value {
            color: #0f172a;
            font-size: 14px;
            font-weight: 900;
            line-height: 1.7;
        }

        .pr-warning {
            background: #fff7ed;
            border: 1px solid #fed7aa;
            border-right: 4px solid #f97316;
            color: #9a3412;
            border-radius: 12px;
            padding: 14px 16px;
            font-size: 14px;
            font-weight: 900;
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .pr-form-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: flex-start;
        }

        @@media (max-width: 992px) {
            .pr-chips,
            .pr-info-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 768px) {
            .pr-page {
                padding: 18px 0 40px;
            }

            .pr-hero {
                padding: 20px;
            }

            .pr-hero-title {
                font-size: 23px;
            }

            .pr-chips,
            .pr-info-grid {
                grid-template-columns: 1fr;
            }

            .btn-pr-success,
            .btn-pr-outline {
                width: 100%;
            }

            .pr-form-actions {
                width: 100%;
            }
        }
    </style>
}

<div class="pr-page container-fluid px-4" dir="rtl">

    <div class="pr-header">
        <div>
            <h1 class="pr-header-title">
                <i class="bi bi-send-check"></i>
                تأكيد إرسال اختبار مؤشر الأداء
            </h1>

            <div class="pr-header-sub">
                مراجعة بيانات الاختبار قبل إرساله إلى الطلاب المستهدفين.
            </div>
        </div>

        <div>
            <a asp-action="Review"
               asp-route-id="@Model.ExamId"
               class="btn-pr-outline">
                <i class="bi bi-arrow-right"></i>
                رجوع للمراجعة
            </a>
        </div>
    </div>

    <div class="pr-hero">
        <div class="row g-4 align-items-center">
            <div class="col-lg-5">
                <div class="pr-hero-label">
                    <i class="bi bi-clipboard-check"></i>
                    اختبار جاهز للإرسال
                </div>

                <h2 class="pr-hero-title">@Model.ExamTitle</h2>

                <div class="pr-hero-sub">
                    يرجى التأكد من بيانات الإرسال قبل اعتماد العملية.
                </div>
            </div>

            <div class="col-lg-7">
                <div class="pr-chips">
                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#2563eb;">@Model.StudentCount</div>
                        <div class="pr-chip-lbl">طلاب مستهدفون</div>
                    </div>

                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#16a34a;">
                            <i class="bi bi-send"></i>
                        </div>
                        <div class="pr-chip-lbl">عملية إرسال</div>
                    </div>

                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#f59e0b;">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div class="pr-chip-lbl">تأكيد نهائي</div>
                    </div>

                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#dc2626;">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>
                        <div class="pr-chip-lbl">غير قابل للتراجع</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="pr-panel">
        <div class="pr-panel-head">
            <i class="bi bi-info-circle"></i>
            بيانات الإرسال
        </div>

        <div class="pr-panel-body">
            <div class="pr-info-grid">
                <div class="pr-info-item">
                    <span class="pr-info-label">المنهج</span>
                    <div class="pr-info-value">@Model.CurriculumTitle</div>
                </div>

                <div class="pr-info-item">
                    <span class="pr-info-label">الدفعة</span>
                    <div class="pr-info-value">@Model.BatchName</div>
                </div>

                <div class="pr-info-item">
                    <span class="pr-info-label">الكود المرجعي</span>
                    <div class="pr-info-value">@(string.IsNullOrWhiteSpace(Model.ReferenceCode) ? "—" : Model.ReferenceCode)</div>
                </div>

                <div class="pr-info-item">
                    <span class="pr-info-label">عدد الطلاب المستهدفين</span>
                    <div class="pr-info-value">@Model.StudentCount</div>
                </div>
            </div>

            <div class="pr-warning">
                <i class="bi bi-exclamation-triangle"></i>
                سيتم إرسال الاختبار إلى جميع طلاب الدفعة المحددة. تأكد من صحة البيانات قبل المتابعة.
            </div>

            <form asp-action="ConfirmSendPost" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="examId" value="@Model.ExamId" />

                <div class="pr-form-actions">
                    <button type="submit" class="btn-pr-success">
                        <i class="bi bi-check-circle"></i>
                        تأكيد الإرسال
                    </button>

                    <a asp-action="Review"
                       asp-route-id="@Model.ExamId"
                       class="btn-pr-outline">
                        <i class="bi bi-arrow-right"></i>
                        رجوع
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>