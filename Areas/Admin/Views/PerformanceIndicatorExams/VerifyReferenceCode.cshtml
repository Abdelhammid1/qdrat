@model int

@{
    ViewData["Title"] = "التحقق من الكود المرجعي";
}

<div class="qdrat-verify-wrapper" dir="rtl">
    <div class="qdrat-verify-card">
        <div class="qdrat-verify-icon">
            <i class="bi bi-shield-lock"></i>
        </div>

        <h1 class="qdrat-verify-title">بدء اختبار مؤشر الأداء</h1>
        <p class="qdrat-verify-subtitle">
            أدخل الكود المرجعي الذي حصلت عليه من المشرف داخل المعمل حتى تتمكن من الدخول للاختبار.
        </p>

        @if (TempData["Error"] != null)
        {
            <div class="qdrat-alert qdrat-alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>@TempData["Error"]</span>
            </div>
        }

        <form asp-action="VerifyReferenceCode" method="post" class="qdrat-verify-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model" />

            <div class="qdrat-code-field">
                <label for="referenceCode" class="qdrat-label">الكود المرجعي</label>
                <div class="qdrat-input-wrapper">
                    <i class="bi bi-key"></i>
                    <input type="text"
                           id="referenceCode"
                           name="referenceCode"
                           class="form-control qdrat-code-input"
                           placeholder="أدخل الكود المرجعي"
                           autocomplete="off"
                           required />
                </div>
            </div>

            <button type="submit" class="qdrat-submit-btn">
                <i class="bi bi-box-arrow-in-left"></i>
                تأكيد والدخول للاختبار
            </button>
        </form>
    </div>
</div>

<style>
    .qdrat-verify-wrapper {
        min-height: calc(100vh - 120px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
        background: radial-gradient(circle at top right, rgba(37,99,235,.12), transparent 32%), radial-gradient(circle at bottom left, rgba(15,118,110,.12), transparent 34%);
        font-family: 'Cairo','Tajawal',system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    }

    .qdrat-verify-card {
        width: 100%;
        max-width: 520px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 28px;
        padding: 34px 28px;
        text-align: center;
        box-shadow: 0 24px 70px rgba(15,23,42,.12);
    }

    .qdrat-verify-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 18px;
        border-radius: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 32px;
        background: linear-gradient(135deg,#2563eb 0%,#0891b2 55%,#0f766e 100%);
        box-shadow: 0 16px 34px rgba(37,99,235,.25);
    }

    .qdrat-verify-title {
        margin: 0;
        color: #0f172a;
        font-size: 26px;
        font-weight: 900;
    }

    .qdrat-verify-subtitle {
        margin: 12px auto 24px;
        max-width: 410px;
        color: #64748b;
        font-size: 14px;
        line-height: 1.9;
        font-weight: 700;
    }

    .qdrat-alert {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 13px 14px;
        border-radius: 16px;
        margin-bottom: 18px;
        font-weight: 900;
    }

    .qdrat-alert-danger {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .qdrat-verify-form {
        text-align: right;
    }

    .qdrat-code-field {
        margin-bottom: 18px;
    }

    .qdrat-label {
        display: flex;
        align-items: center;
        margin-bottom: 9px;
        color: #1f2937;
        font-size: 14px;
        font-weight: 900;
    }

    .qdrat-input-wrapper {
        position: relative;
    }

        .qdrat-input-wrapper i {
            position: absolute;
            top: 50%;
            right: 16px;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 18px;
            z-index: 2;
        }

    .qdrat-code-input {
        height: 56px;
        border-radius: 18px;
        border: 1px solid #dbe3ef;
        background: #fff;
        padding: 10px 48px 10px 16px;
        color: #111827;
        font-size: 20px;
        font-weight: 900;
        text-align: center;
        letter-spacing: 2px;
        transition: .18s ease-in-out;
        direction: ltr;
    }

        .qdrat-code-input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 4px rgba(37,99,235,.10);
        }

    .qdrat-submit-btn {
        width: 100%;
        min-height: 52px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border: 0;
        border-radius: 999px;
        color: #fff;
        background: linear-gradient(135deg,#2563eb 0%,#0f766e 100%);
        font-size: 15px;
        font-weight: 900;
        box-shadow: 0 16px 34px rgba(37,99,235,.22);
        transition: .2s ease-in-out;
    }

        .qdrat-submit-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 20px 40px rgba(37,99,235,.28);
        }

    @@media (max-width:576px) {
        .qdrat-verify-card {
            padding: 28px 18px;
            border-radius: 24px
        }

        .qdrat-verify-title {
            font-size: 22px
        }

        .qdrat-code-input {
            font-size: 18px
        }
    }
</style>
