@model QdratNew.ViewModels.PerformanceIndicator.PerformanceIndicatorExamStudentsReportViewModel
@using Microsoft.AspNetCore.Authorization
@using QdratNew.Security.AdminPermissions
@using QdratNew.Enums
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "طلاب اختبار مؤشرات الأداء";
    var canResolveIntegrity = (await AuthorizationService.AuthorizeAsync(User, AdminPermissionPolicies.IntegrityViolations_Resolve)).Succeeded;
}

@section Styles {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        body { background: #f4f7fb !important; }
        .pi-page { direction: rtl; padding: 28px 0 60px; font-family: 'Cairo', Arial, sans-serif; color: #0f172a; }
        .pi-header, .pi-card, .pi-table-panel {
            background: #fff; border: 1px solid #dbe4ef; border-radius: 14px;
            box-shadow: 0 8px 22px rgba(15,23,42,.06);
        }
        .pi-header { padding: 18px 22px; display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin-bottom: 22px; }
        .pi-title { margin: 0; font-size: 22px; font-weight: 900; display: flex; gap: 8px; align-items: center; }
        .pi-sub { color: #64748b; font-size: 13px; font-weight: 700; margin-top: 6px; }
        .pi-actions { display: flex; gap: 8px; flex-wrap: wrap; }
        .pi-btn {
            border-radius: 10px; border: 1px solid #cbd5e1; background: #fff; color: #334155;
            padding: 8px 14px; font-size: 13px; font-weight: 900; text-decoration: none;
            display: inline-flex; align-items: center; justify-content: center; gap: 7px; white-space: nowrap;
        }
        .pi-btn:hover { background: #f1f5f9; color: #0f172a; text-decoration: none; }
        .pi-hero {
            background: linear-gradient(135deg, #17233c 0%, #1f3558 100%);
            color: #fff; border-radius: 14px; padding: 26px 28px; margin-bottom: 22px;
            box-shadow: 0 14px 32px rgba(15,23,42,.16);
        }
        .pi-hero-label {
            display: inline-flex; gap: 7px; align-items: center; background: rgba(255,255,255,.1);
            border: 1px solid rgba(255,255,255,.16); border-radius: 999px; padding: 5px 12px;
            font-size: 12px; font-weight: 900; margin-bottom: 12px;
        }
        .pi-hero h2 { margin: 0; font-size: 28px; font-weight: 900; }
        .pi-hero p { margin: 8px 0 0; color: #cbd5e1; font-size: 13px; font-weight: 700; }
        .pi-stats { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin-bottom: 22px; }
        .pi-card { padding: 16px; display: flex; align-items: center; gap: 12px; min-height: 94px; }
        .pi-icon {
            width: 44px; height: 44px; border-radius: 13px; display: inline-flex; align-items: center; justify-content: center;
            font-size: 17px; flex-shrink: 0;
        }
        .blue { background: #dbeafe; color: #1d4ed8; }
        .green { background: #dcfce7; color: #15803d; }
        .orange { background: #ffedd5; color: #c2410c; }
        .red { background: #fee2e2; color: #b91c1c; }
        .violet { background: #ede9fe; color: #6d28d9; }
        .pi-card-label { color: #64748b; font-size: 12px; font-weight: 900; margin-bottom: 5px; }
        .pi-card-value { color: #0f172a; font-size: 24px; font-weight: 900; line-height: 1; }
        .pi-section-label { font-size: 14px; font-weight: 900; color: #334155; margin: 20px 0 12px; display: flex; gap: 8px; align-items: center; }
        .pi-section-label::after { content: ""; flex: 1; height: 1px; background: #dbe4ef; }
        .pi-table-panel { overflow: hidden; }
        .pi-table { width: 100%; border-collapse: collapse; margin: 0; font-size: 13px; }
        .pi-table th {
            background: #f1f5f9; color: #0f172a; padding: 12px 10px; border: 1px solid #dbe4ef;
            font-weight: 900; text-align: center; white-space: nowrap;
        }
        .pi-table td { padding: 12px 10px; border: 1px solid #e2e8f0; text-align: center; vertical-align: middle; font-weight: 700; }
        .pi-table tbody tr:hover td { background: #f8fafc; }
        .pi-student { text-align: right !important; font-weight: 900; min-width: 180px; }
        .pi-badge {
            display: inline-flex; align-items: center; justify-content: center; gap: 5px;
            border-radius: 999px; padding: 5px 10px; font-size: 11px; font-weight: 900;
            border: 1px solid transparent; white-space: nowrap;
        }
        .badge-ok { background: #dcfce7; color: #166534; border-color: #86efac; }
        .badge-bad { background: #fee2e2; color: #991b1b; border-color: #fecaca; }
        .badge-warn { background: #fef3c7; color: #92400e; border-color: #fde68a; }
        .badge-info { background: #dbeafe; color: #1d4ed8; border-color: #bfdbfe; }
        .badge-muted { background: #f1f5f9; color: #475569; border-color: #cbd5e1; }
        .weak-list { display: flex; flex-wrap: wrap; gap: 6px; justify-content: flex-start; min-width: 260px; }
        .row-actions { display: flex; justify-content: center; gap: 6px; flex-wrap: wrap; min-width: 230px; }
        .row-btn {
            border-radius: 9px; border: 1px solid #cbd5e1; background: #fff; color: #334155;
            width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center;
            text-decoration: none; transition: .2s ease;
        }
        .row-btn:hover { transform: translateY(-1px); text-decoration: none; }
        .row-btn.questions { background: #e0f2fe; color: #0369a1; border-color: #bae6fd; }
        .row-btn.report { background: #ede9fe; color: #6d28d9; border-color: #ddd6fe; }
        .pi-empty { padding: 28px; text-align: center; color: #991b1b; font-weight: 900; }
        @@media (max-width: 1200px) { .pi-stats { grid-template-columns: repeat(3, 1fr); } }
        @@media (max-width: 768px) { .pi-page { padding: 18px 0 40px; } .pi-stats { grid-template-columns: 1fr; } .pi-actions, .pi-btn { width: 100%; } }
    </style>
}

<div class="pi-page container-fluid px-4">
    <div class="pi-header">
        <div>
            <h1 class="pi-title">
                <i class="fa-solid fa-users text-primary"></i>
                طلاب اختبار مؤشرات الأداء
            </h1>
            <div class="pi-sub">تحليل حالة الطلاب، نسب الاجتياز، والمحاور التي تحتاج إلى خطة علاجية.</div>
        </div>
        <div class="pi-actions">
            <a asp-action="Details" asp-route-id="@Model.ExamId" class="pi-btn">
                <i class="fa-solid fa-arrow-right"></i>
                تفاصيل الاختبار
            </a>
            <a asp-action="Index" class="pi-btn">
                <i class="fa-solid fa-list"></i>
                الاختبارات
            </a>
        </div>
    </div>

    <div class="pi-hero">
        <div class="pi-hero-label">
            <i class="fa-solid fa-chart-line"></i>
            معيار الاجتياز @Model.PassPercent%
        </div>
        <h2>@Model.ExamTitle</h2>
        <p>المنهج: @Model.CurriculumTitle</p>
    </div>

    <div class="pi-stats">
        <div class="pi-card">
            <div class="pi-icon blue"><i class="fa-solid fa-users"></i></div>
            <div><div class="pi-card-label">إجمالي الطلاب</div><div class="pi-card-value">@Model.TotalStudents</div></div>
        </div>
        <div class="pi-card">
            <div class="pi-icon green"><i class="fa-solid fa-circle-check"></i></div>
            <div><div class="pi-card-label">أكملوا الاختبار</div><div class="pi-card-value">@Model.CompletedStudents</div></div>
        </div>
        <div class="pi-card">
            <div class="pi-icon violet"><i class="fa-solid fa-trophy"></i></div>
            <div><div class="pi-card-label">اجتازوا</div><div class="pi-card-value">@Model.PassedStudents</div></div>
        </div>
        <div class="pi-card">
            <div class="pi-icon red"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <div><div class="pi-card-label">يحتاجون خطة علاجية</div><div class="pi-card-value">@Model.NeedRemedialPlanStudents</div></div>
        </div>
        <div class="pi-card">
            <div class="pi-icon orange"><i class="fa-solid fa-chart-simple"></i></div>
            <div><div class="pi-card-label">متوسط الدرجة</div><div class="pi-card-value">@Model.AverageScore%</div></div>
        </div>
    </div>

    <div class="pi-section-label">جدول الطلاب</div>

    <div class="pi-table-panel">
        <div class="table-responsive">
            <table class="pi-table">
                <thead>
                    <tr>
                        <th>اسم الطالب</th>
                        <th>حالة الاختبار</th>
                        <th>تاريخ البدء</th>
                        <th>تاريخ الإنهاء</th>
                        <th>الدرجة</th>
                        <th>حالة الطالب</th>
                        <th>محاور تحتاج خطة علاجية</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Students.Any())
                    {
                        <tr>
                            <td colspan="8" class="pi-empty">لا يوجد طلاب داخل هذا الاختبار.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var student in Model.Students)
                        {
                            var examStatusClass = student.StatusText == "مكتمل" ? "badge-info" : student.StatusText == "بدأ ولم يكمل" ? "badge-warn" : "badge-muted";
                            var resultClass = student.Passed ? "badge-ok" : "badge-bad";
                            <tr>
                                <td class="pi-student">
                                    @student.StudentName
                                    @if (student.IsIntegrityBlocked)
                                    {
                                        <span class="pi-badge badge-bad">موقوف (ترجمة المتصفح)</span>
                                    }
                                </td>
                                <td><span class="pi-badge @examStatusClass">@student.StatusText</span></td>
                                <td>@(student.StartedAt?.ToString("yyyy/MM/dd HH:mm") ?? "—")</td>
                                <td>@(student.CompletedAt?.ToString("yyyy/MM/dd HH:mm") ?? "—")</td>
                                <td><span class="pi-badge @(student.Passed ? "badge-ok" : "badge-bad")">@Math.Round(student.ScorePercent ?? 0, 1)%</span></td>
                                <td>
                                    <span class="pi-badge @resultClass">
                                        @(student.Passed ? "اجتاز" : "يحتاج خطة علاجية")
                                    </span>
                                </td>
                                <td>
                                    @if (student.WeakSections.Any())
                                    {
                                        <div class="weak-list">
                                            @foreach (var weakSection in student.WeakSections)
                                            {
                                                <span class="pi-badge badge-warn">
                                                    @weakSection.SectionTitle: @weakSection.ScorePercent%
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="pi-badge badge-ok">لا توجد محاور ضعيفة</span>
                                    }
                                </td>
                                <td>
                                    <div class="row-actions">
                                        <a asp-action="StudentExamQuestions"
                                           asp-route-examId="@Model.ExamId"
                                           asp-route-studentId="@student.StudentId"
                                           class="row-btn questions"
                                           title="عرض الأسئلة">
                                            <i class="fa-solid fa-list-check"></i>
                                        </a>
                                        <a asp-area="Admin"
                                           asp-controller="PerformanceExamReports"
                                           asp-action="StudentExamReport"
                                           asp-route-studentId="@student.StudentId"
                                           asp-route-examId="@Model.ExamId"
                                           target="_blank"
                                           class="row-btn report"
                                           title="فتح تقرير الطالب وطباعته">
                                            <i class="fa-solid fa-file-lines"></i>
                                        </a>
                                        @if (student.IsIntegrityBlocked && canResolveIntegrity)
                                        {
                                            <form asp-area="Admin"
                                                  asp-controller="IntegrityViolations"
                                                  asp-action="ResolveByAttempt"
                                                  method="post"
                                                  style="display:inline;"
                                                  onsubmit="return confirm('تأكيد إعادة فتح المحاولة لهذا الطالب؟');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="studentId" value="@student.StudentId" />
                                                <input type="hidden" name="attemptType" value="@((int)IntegrityAttemptType.PerformanceIndicator)" />
                                                <input type="hidden" name="attemptEntityId" value="@Model.ExamId" />
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                <button type="submit" class="row-btn" style="background:#dcfce7;color:#15803d;border-color:#bbf7d0;" title="إعادة فتح المحاولة">
                                                    <i class="fa-solid fa-unlock"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
