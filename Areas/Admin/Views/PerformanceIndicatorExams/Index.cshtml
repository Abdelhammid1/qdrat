@model IEnumerable<QdratNew.Entities.PerformanceIndicatorExam>

@{
    var showArchived = (bool)(ViewBag.ShowArchived ?? false);
    var archivedCount = (int)(ViewBag.ArchivedCount ?? 0);

    ViewData["Title"] = showArchived ? "أرشيف اختبارات مؤشر الأداء" : "اختبارات مؤشر الأداء";

    var examsList = Model?.ToList() ?? new List<QdratNew.Entities.PerformanceIndicatorExam>();

    var totalExams = examsList.Count;

    var totalSections = examsList.Sum(x => x.Sections != null ? x.Sections.Count() : 0);

    var totalBatches = examsList
        .SelectMany(x => x.ExamToBatches ?? new List<QdratNew.Entities.PerformanceIndicatorExamToBatch>())
        .Where(x => x.Batch != null)
        .Select(x => x.BatchId)
        .Distinct()
        .Count();

    var avgDuration = examsList.Any()
        ? Math.Round(examsList.Average(x => x.DurationMinutes), 0)
        : 0;

    var totalQuestions = examsList.Sum(x => x.TotalQuestions);

    var latestExamDate = examsList.Any()
        ? examsList.Max(x => x.CreatedAt)
        : (DateTime?)null;

    var pageTitle = showArchived ? "أرشيف اختبارات مؤشر الأداء" : "اختبارات مؤشر الأداء";

    var pageSubtitle = showArchived
        ? "عرض الاختبارات المؤرشفة وإمكانية إخراجها من الأرشيف عند الحاجة."
        : "إدارة اختبارات مؤشرات الأداء حسب المنهج، الدفعات، المحاور، والأسئلة المرتبطة.";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        :root {
            --ink: #0D1B2A;
            --ink-2: #2C3E50;
            --ink-3: #5A6A7A;
            --ink-4: #8FA0B0;
            --ink-5: #C8D5E0;
            --canvas: #F3F6FA;
            --surface: #FFFFFF;
            --surface-2: #F8FAFC;
            --surface-3: #EEF2F7;
            --border: #DDE4EC;
            --blue: #1B5EAE;
            --blue-2: #2471D0;
            --blue-bg: #E8F1FB;
            --blue-dark: #103E7A;
            --emerald: #0D7A5B;
            --emerald-bg: #E4F5EE;
            --amber: #985D09;
            --amber-bg: #FDF0D8;
            --rose: #BF1030;
            --rose-bg: #FDEAEE;
            --violet: #5535B5;
            --violet-bg: #EDE8F9;
            --r-sm: 6px;
            --r-md: 10px;
            --r-lg: 14px;
            --r-xl: 20px;
            --sh-xs: 0 1px 3px rgba(13,27,42,.06);
            --sh-sm: 0 2px 8px rgba(13,27,42,.08);
            --sh-md: 0 4px 18px rgba(13,27,42,.10);
            --ease: cubic-bezier(.25,.46,.45,.94);
        }

        body {
            background: var(--canvas) !important;
        }

        .indicator-page {
            background: var(--canvas);
            min-height: 100vh;
            padding: 32px 28px 64px;
            direction: rtl;
            font-family: 'Cairo', Arial, sans-serif;
            color: var(--ink-2);
        }

        .indicator-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 14px;
            margin-bottom: 28px;
        }

        .indicator-brand {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .indicator-brand-icon {
            width: 46px;
            height: 46px;
            background: var(--blue);
            border-radius: var(--r-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 20px;
            box-shadow: 0 4px 14px rgba(27,94,174,.28);
            flex-shrink: 0;
        }

        .indicator-brand-title {
            font-size: 20px;
            font-weight: 800;
            color: var(--ink);
            line-height: 1.15;
        }

        .indicator-brand-sub {
            font-size: 16px;
            color: var(--ink-4);
            margin-top: 2px;
            line-height: 1.7;
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn-main-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            background: var(--blue);
            color: #fff;
            border: none;
            border-radius: var(--r-md);
            padding: 10px 20px;
            font-size: 18px;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            box-shadow: 0 3px 10px rgba(27,94,174,.24);
            transition: background .16s var(--ease), transform .14s, box-shadow .16s;
            white-space: nowrap;
        }

            .btn-main-action:hover {
                background: var(--blue-dark);
                color: #fff;
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(27,94,174,.30);
                text-decoration: none;
            }

            .btn-main-action.model-action {
                background: var(--violet);
                box-shadow: 0 3px 10px rgba(85,53,181,.22);
            }

                .btn-main-action.model-action:hover {
                    background: #3f2690;
                    color: #fff;
                    box-shadow: 0 6px 18px rgba(85,53,181,.28);
                }

        .indicator-alert {
            border: none;
            border-radius: var(--r-lg);
            padding: 14px 18px;
            font-size: 17px;
            font-weight: 700;
            box-shadow: var(--sh-xs);
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .indicator-alert-success {
            background: var(--emerald-bg);
            color: var(--emerald);
        }

        .indicator-alert-danger {
            background: var(--rose-bg);
            color: var(--rose);
        }

        .indicator-kpis {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 13px;
            margin-bottom: 24px;
        }

        @@media (max-width: 1200px) {
            .indicator-kpis {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @@media (max-width: 960px) {
            .indicator-kpis {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 480px) {
            .indicator-kpis {
                grid-template-columns: 1fr;
            }
        }

        .kpi-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            padding: 18px 19px;
            display: flex;
            align-items: center;
            gap: 13px;
            box-shadow: var(--sh-xs);
            transition: transform .2s var(--ease), box-shadow .2s;
            position: relative;
            overflow: hidden;
        }

            .kpi-card::after {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 4px;
                height: 100%;
                border-radius: 0 var(--r-xl) var(--r-xl) 0;
            }

            .kpi-card:hover {
                transform: translateY(-3px);
                box-shadow: var(--sh-sm);
            }

        .kpi-blue::after {
            background: var(--blue);
        }

        .kpi-emerald::after {
            background: var(--emerald);
        }

        .kpi-amber::after {
            background: var(--amber);
        }

        .kpi-rose::after {
            background: var(--rose);
        }

        .kpi-violet::after {
            background: var(--violet);
        }

        .kpi-ico {
            width: 42px;
            height: 42px;
            border-radius: var(--r-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .ico-blue {
            background: var(--blue-bg);
            color: var(--blue);
        }

        .ico-emerald {
            background: var(--emerald-bg);
            color: var(--emerald);
        }

        .ico-amber {
            background: var(--amber-bg);
            color: var(--amber);
        }

        .ico-rose {
            background: var(--rose-bg);
            color: var(--rose);
        }

        .ico-violet {
            background: var(--violet-bg);
            color: var(--violet);
        }

        .kpi-label {
            font-size: 15px;
            font-weight: 700;
            color: var(--ink-4);
            letter-spacing: .04em;
            text-transform: uppercase;
            margin-bottom: 3px;
        }

        .kpi-val {
            font-size: 20px;
            font-weight: 800;
            color: var(--ink);
            line-height: 1;
        }

        .archive-manager {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            margin-bottom: 22px;
            box-shadow: var(--sh-xs);
            padding: 0 !important;
            overflow: hidden;
        }

        .archive-manager-toggle {
            width: 100%;
            border: none;
            background: var(--surface);
            padding: 18px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            text-align: right;
            transition: background .15s var(--ease);
        }

            .archive-manager-toggle:hover {
                background: var(--surface-2);
            }

        .archive-manager-toggle-main {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .archive-manager-toggle-icon {
            width: 38px;
            height: 38px;
            border-radius: var(--r-md);
            background: var(--amber-bg);
            color: var(--amber);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }

        .archive-manager-toggle-text {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .archive-manager-title {
            font-size: 16px;
            font-weight: 800;
            color: var(--ink);
        }

        .archive-manager-subtitle {
            font-size: 13px;
            font-weight: 600;
            color: var(--ink-4);
        }

        .archive-manager-toggle-left {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .archive-manager-chevron {
            width: 34px;
            height: 34px;
            border-radius: var(--r-sm);
            background: var(--surface-3);
            color: var(--ink-3);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: transform .2s var(--ease), background .15s;
        }

        .archive-manager.is-open .archive-manager-chevron {
            transform: rotate(180deg);
            background: var(--amber-bg);
            color: var(--amber);
        }

        .archive-manager-body {
            display: none;
            padding: 0 18px 18px;
            border-top: 1px solid var(--surface-3);
        }

        .archive-manager.is-open .archive-manager-body {
            display: block;
        }

        .archive-manager-body-inner {
            padding-top: 16px;
        }

        .archive-manager-grid {
            display: grid;
            grid-template-columns: minmax(240px,1fr) auto;
            gap: 14px;
            align-items: end;
        }

        .archive-exams-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 8px;
            max-height: 170px;
            overflow-y: auto;
            padding: 10px;
            background: var(--surface-2);
            border: 1px solid var(--border);
            border-radius: var(--r-md);
        }

        .archive-exam-check {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 14px;
            color: var(--ink-2);
            line-height: 1.6;
        }

            .archive-exam-check input {
                accent-color: var(--amber);
            }

        .archive-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .archive-submit {
            border: none;
            border-radius: var(--r-md);
            padding: 10px 16px;
            font-size: 15px;
            font-weight: 700;
            color: #fff;
            background: var(--ink);
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            white-space: nowrap;
        }

            .archive-submit.restore {
                background: var(--emerald);
            }

            .archive-submit:hover {
                filter: brightness(.95);
            }

        .exam-count-badge {
            font-size: 14px;
            color: var(--ink-4);
        }

            .exam-count-badge strong {
                color: var(--amber);
                font-weight: 800;
            }

        .indicator-tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 18px;
            flex-wrap: wrap;
        }

        .indicator-tab {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border: 1px solid var(--border);
            background: var(--surface);
            color: var(--ink-3);
            border-radius: var(--r-md);
            padding: 10px 18px;
            font-size: 15px;
            font-weight: 800;
            text-decoration: none;
            transition: all .15s;
        }

            .indicator-tab:hover {
                background: var(--surface-2);
                color: var(--ink);
                text-decoration: none;
            }

            .indicator-tab.active {
                background: var(--blue);
                color: #fff;
                border-color: var(--blue);
                box-shadow: 0 3px 10px rgba(27,94,174,.18);
            }

        .indicator-exams-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            overflow: visible;
            box-shadow: var(--sh-sm);
            margin-bottom: 24px;
        }

        .indicator-exams-topbar {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 14px 18px;
            border-bottom: 1px solid var(--surface-3);
            flex-wrap: wrap;
        }

        .table-section-title {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 18px;
            font-weight: 800;
            color: var(--ink);
            margin-left: 10px;
        }

            .table-section-title i {
                color: var(--blue);
            }

        .indicator-search-wrap {
            position: relative;
            flex: 1;
            min-width: 220px;
            max-width: 430px;
        }

            .indicator-search-wrap i {
                position: absolute;
                right: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--ink-4);
                font-size: 17px;
                pointer-events: none;
            }

            .indicator-search-wrap input {
                width: 100%;
                padding: 7px 32px 7px 12px;
                border: 1px solid var(--border);
                border-radius: var(--r-md);
                font-size: 18px;
                background: var(--surface-2);
                color: var(--ink);
                transition: border-color .15s, box-shadow .15s;
            }

                .indicator-search-wrap input:focus {
                    outline: none;
                    border-color: var(--blue-2);
                    box-shadow: 0 0 0 3px rgba(36,113,208,.1);
                    background: var(--surface);
                }

        .indicator-count-badge {
            margin-right: auto;
            font-size: 16px;
            color: var(--ink-4);
        }

            .indicator-count-badge strong {
                color: var(--blue);
                font-weight: 800;
            }

        .exams-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
            padding: 18px;
        }

        @@media (max-width: 1200px) {
            .exams-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 768px) {
            .exams-grid {
                grid-template-columns: 1fr;
                padding: 14px;
            }
        }

        .exam-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            box-shadow: var(--sh-xs);
            transition: transform .18s var(--ease), box-shadow .18s, border-color .18s;
            overflow: hidden;
            position: relative;
        }

            .exam-card::before {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 5px;
                height: 100%;
                background: var(--blue);
            }

            .exam-card:hover {
                transform: translateY(-4px);
                box-shadow: var(--sh-md);
                border-color: #B6D3F4;
            }

            .exam-card.archived-card::before {
                background: var(--amber);
            }

        .exam-card-body {
            padding: 18px 18px 16px;
        }

        .exam-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 16px;
        }

        .exam-title-wrap {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            min-width: 0;
        }

        .exam-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: var(--blue-bg);
            color: var(--blue);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
            flex-shrink: 0;
        }

        .exam-title {
            font-size: 18px;
            font-weight: 800;
            color: var(--ink);
            margin-bottom: 3px;
            line-height: 1.45;
        }

        .exam-sub {
            font-size: 15px;
            color: var(--ink-4);
            line-height: 1.5;
        }

        .curriculum-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 11px;
            border-radius: 30px;
            font-size: 15px;
            font-weight: 700;
            white-space: nowrap;
            background: var(--blue-bg);
            color: var(--blue);
            max-width: 150px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .exam-mini-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-bottom: 16px;
        }

        .exam-mini-stat {
            background: var(--surface-2);
            border: 1px solid var(--surface-3);
            border-radius: var(--r-md);
            padding: 10px 8px;
            text-align: center;
        }

        .mini-val {
            display: block;
            font-size: 19px;
            font-weight: 800;
            color: var(--ink);
            line-height: 1.1;
        }

        .mini-label {
            display: block;
            font-size: 14px;
            color: var(--ink-4);
            margin-top: 3px;
        }

        .text-emerald {
            color: var(--emerald) !important;
        }

        .text-rose {
            color: var(--rose) !important;
        }

        .text-violet {
            color: var(--violet) !important;
        }

        .text-amber {
            color: var(--amber) !important;
        }

        .exam-batches {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            margin-bottom: 14px;
        }

        .batch-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 10px;
            border-radius: 30px;
            font-size: 13px;
            font-weight: 800;
            background: var(--violet-bg);
            color: var(--violet);
            border: 1px solid #D9CFF4;
        }

            .batch-pill.empty {
                background: var(--surface-3);
                color: var(--ink-4);
                border-color: var(--border);
            }

        .indicator-progress-wrap {
            margin-bottom: 14px;
        }

        .indicator-progress-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            font-size: 15px;
            color: var(--ink-4);
            margin-bottom: 6px;
        }

            .indicator-progress-meta strong {
                color: var(--ink);
                font-size: 16px;
            }

        .indicator-progress {
            width: 100%;
            height: 9px;
            border-radius: 30px;
            background: var(--surface-3);
            overflow: hidden;
        }

        .indicator-progress-bar {
            height: 100%;
            background: var(--blue);
            border-radius: 30px;
            transition: width .3s ease;
        }

        .exam-foot-stats {
            display: flex;
            justify-content: space-between;
            gap: 8px;
            color: var(--ink-4);
            font-size: 15px;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }

            .exam-foot-stats span {
                display: inline-flex;
                align-items: center;
                gap: 5px;
            }

        .exam-actions-row {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 8px;
            align-items: center;
        }

        .exam-access-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            width: 100%;
            background: var(--surface);
            color: var(--violet);
            border: 1px solid rgba(85,53,181,.30);
            border-radius: var(--r-md);
            padding: 9px 14px;
            font-size: 15px;
            font-weight: 800;
            text-decoration: none;
            transition: background .16s var(--ease), transform .14s, color .16s, border-color .16s;
            box-shadow: var(--sh-xs);
            margin-top: 6px;
        }

            .exam-access-btn:hover {
                background: var(--violet);
                border-color: var(--violet);
                color: #fff;
                transform: translateY(-2px);
                text-decoration: none;
            }

        .exam-open-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            width: 100%;
            background: var(--blue);
            color: #fff;
            border: none;
            border-radius: var(--r-md);
            padding: 10px 14px;
            font-size: 17px;
            font-weight: 700;
            text-decoration: none;
            transition: background .16s var(--ease), transform .14s, box-shadow .16s;
            box-shadow: 0 3px 10px rgba(27,94,174,.20);
        }

            .exam-open-btn:hover {
                color: #fff;
                background: var(--blue-dark);
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(27,94,174,.28);
                text-decoration: none;
            }

        .exam-delete-form {
            margin: 0;
            padding: 0;
        }

        .exam-delete-btn {
            width: 43px;
            height: 43px;
            border: 1px solid #F5BBC4;
            border-radius: var(--r-md);
            background: var(--rose-bg);
            color: var(--rose);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all .15s var(--ease);
        }

            .exam-delete-btn:hover {
                background: var(--rose);
                color: #fff;
                transform: translateY(-2px);
            }

        .indicator-empty {
            text-align: center;
            padding: 56px 16px;
            color: var(--ink-4);
        }

            .indicator-empty i {
                font-size: 28px;
                display: block;
                margin-bottom: 12px;
                color: var(--ink-5);
            }

        .indicator-empty-title {
            font-size: 18px;
            font-weight: 700;
            color: var(--ink-3);
        }

        .indicator-empty-sub {
            font-size: 16px;
            margin-top: 4px;
        }

        @@media (max-width: 768px) {
            .indicator-page {
                padding: 22px 14px 48px;
            }

            .indicator-topbar {
                align-items: stretch;
            }

            .top-actions {
                width: 100%;
            }

            .btn-main-action {
                width: 100%;
            }

            .archive-manager-grid {
                grid-template-columns: 1fr;
            }

            .archive-manager-toggle {
                align-items: flex-start;
            }

            .archive-manager-toggle-left {
                width: 100%;
                justify-content: space-between;
            }

            .indicator-exams-topbar {
                align-items: stretch;
            }

            .indicator-search-wrap {
                max-width: 100%;
                width: 100%;
            }

            .indicator-count-badge {
                margin-right: 0;
            }

            .exam-actions-row {
                grid-template-columns: 1fr;
            }

            .exam-delete-btn {
                width: 100%;
            }
        }
    </style>
}

<div class="indicator-page">

    @if (TempData["Success"] != null)
    {
        <div class="indicator-alert indicator-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="indicator-alert indicator-alert-danger">
            <i class="bi bi-exclamation-circle-fill"></i>
            @TempData["Error"]
        </div>
    }

    <div class="indicator-topbar">
        <div class="indicator-brand">
            <div class="indicator-brand-icon">
                <i class="bi bi-graph-up-arrow"></i>
            </div>

            <div>
                <div class="indicator-brand-title">@pageTitle</div>
                <div class="indicator-brand-sub">@pageSubtitle</div>
            </div>
        </div>

        @if (!showArchived)
        {
            <div class="top-actions">
                <a asp-action="Create" class="btn-main-action">
                    <i class="bi bi-plus-circle"></i>
                    إنشاء اختبار مؤشر أداء
                </a>

                <a asp-action="CreateFromProfessionalModel" class="btn-main-action model-action">
                    <i class="bi bi-diagram-3"></i>
                    إنشاء من نموذج احترافي
                </a>
            </div>
        }
    </div>

    <div class="indicator-kpis">

        <div class="kpi-card kpi-blue">
            <div class="kpi-ico ico-blue">
                <i class="bi bi-ui-checks-grid"></i>
            </div>
            <div>
                <div class="kpi-label">إجمالي الاختبارات</div>
                <div class="kpi-val">@totalExams</div>
            </div>
        </div>

        <div class="kpi-card kpi-emerald">
            <div class="kpi-ico ico-emerald">
                <i class="bi bi-diagram-3"></i>
            </div>
            <div>
                <div class="kpi-label">إجمالي المحاور</div>
                <div class="kpi-val">@totalSections</div>
            </div>
        </div>

        <div class="kpi-card kpi-amber">
            <div class="kpi-ico ico-amber">
                <i class="bi bi-people"></i>
            </div>
            <div>
                <div class="kpi-label">الدفعات المرتبطة</div>
                <div class="kpi-val">@totalBatches</div>
            </div>
        </div>

        <div class="kpi-card kpi-rose">
            <div class="kpi-ico ico-rose">
                <i class="bi bi-question-circle"></i>
            </div>
            <div>
                <div class="kpi-label">إجمالي الأسئلة</div>
                <div class="kpi-val">@totalQuestions</div>
            </div>
        </div>

        <div class="kpi-card kpi-violet">
            <div class="kpi-ico ico-violet">
                <i class="bi bi-clock-history"></i>
            </div>
            <div>
                <div class="kpi-label">متوسط المدة</div>
                <div class="kpi-val">@avgDuration دقيقة</div>
            </div>
        </div>

    </div>

    <div class="archive-manager" id="archiveManagerSection">
        <button type="button"
                class="archive-manager-toggle"
                id="archiveManagerToggle"
                aria-expanded="false"
                aria-controls="archiveManagerBody">

            <div class="archive-manager-toggle-main">
                <span class="archive-manager-toggle-icon">
                    <i class="bi bi-archive-fill"></i>
                </span>

                <span class="archive-manager-toggle-text">
                    <span class="archive-manager-title">إدارة الأرشيف</span>
                    <span class="archive-manager-subtitle">حدد الاختبارات المطلوبة ثم اختر أرشفة أو إخراج من الأرشيف</span>
                </span>
            </div>

            <div class="archive-manager-toggle-left">
                <span class="exam-count-badge">
                    داخل الأرشيف:
                    <strong>@archivedCount</strong>
                    اختبار
                </span>

                <span class="archive-manager-chevron">
                    <i class="bi bi-chevron-down"></i>
                </span>
            </div>
        </button>

        <div class="archive-manager-body" id="archiveManagerBody">
            <div class="archive-manager-body-inner">
                <form asp-action="ArchivePerformanceIndicatorExams" method="post">
                    @Html.AntiForgeryToken()

                    <div class="archive-manager-grid">
                        <div class="archive-exams-list">
                            @if (examsList.Any())
                            {
                                foreach (var exam in examsList)
                                {
                                    <label class="archive-exam-check">
                                        <input type="checkbox" name="selectedExamIds" value="@exam.Id" />
                                        <span>@exam.Title</span>
                                    </label>
                                }
                            }
                            else
                            {
                                <span style="color:var(--ink-4);font-size:14px;">
                                    لا توجد اختبارات في هذه القائمة.
                                </span>
                            }
                        </div>

                        <div class="archive-actions">
                            @if (!showArchived)
                            {
                                <button type="submit"
                                        class="archive-submit"
                                        onclick="return confirm('سيتم نقل الاختبارات المحددة إلى الأرشيف. هل تريد المتابعة؟')">
                                    <i class="bi bi-box-arrow-in-down"></i>
                                    أرشفة المحدد
                                </button>
                            }
                            else
                            {
                                <button type="submit"
                                        formaction="@Url.Action("RestorePerformanceIndicatorExams", "PerformanceIndicatorExams")"
                                        class="archive-submit restore"
                                        onclick="return confirm('سيتم إخراج الاختبارات المحددة من الأرشيف. هل تريد المتابعة؟')">
                                    <i class="bi bi-arrow-counterclockwise"></i>
                                    إخراج من الأرشيف
                                </button>
                            }
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="indicator-tabs">
        <a asp-area="Admin"
           asp-controller="PerformanceIndicatorExams"
           asp-action="Index"
           asp-route-showArchived="false"
           class="indicator-tab @(!showArchived ? "active" : "")">
            <i class="bi bi-file-earmark-text"></i>
            الاختبارات
        </a>

        <a asp-area="Admin"
           asp-controller="PerformanceIndicatorExams"
           asp-action="Index"
           asp-route-showArchived="true"
           class="indicator-tab @(showArchived ? "active" : "")">
            <i class="bi bi-archive-fill"></i>
            الأرشيف (@archivedCount)
        </a>
    </div>

    <div class="indicator-exams-card">

        <div class="indicator-exams-topbar">
            <div class="table-section-title">
                <i class="bi bi-grid-3x3-gap-fill"></i>
                @(showArchived ? "الاختبارات المؤرشفة" : "قائمة اختبارات مؤشر الأداء")
            </div>

            <div class="indicator-search-wrap">
                <i class="bi bi-search"></i>
                <input type="text"
                       id="indicatorExamSearch"
                       placeholder="ابحث في العنوان أو المنهج أو الدفعة أو تاريخ الإنشاء..." />
            </div>

            <div class="indicator-count-badge">
                إجمالي:
                <strong>@totalExams</strong>
                اختبار
            </div>
        </div>

        @if (!examsList.Any())
        {
            <div class="indicator-empty">
                <i class="bi bi-inbox"></i>
                <div class="indicator-empty-title">
                    @(showArchived ? "لا توجد اختبارات مؤشر أداء مؤرشفة" : "لا توجد اختبارات مؤشر أداء حتى الآن")
                </div>
                <div class="indicator-empty-sub">
                    @(showArchived ? "ستظهر هنا الاختبارات التي يتم أرشفتها." : "يمكنك إنشاء اختبار مؤشر أداء جديد من أعلى الصفحة.")
                </div>
            </div>
        }
        else
        {
            <div class="exams-grid" id="indicatorExamsGrid">

                @foreach (var item in examsList)
                {
                    var curriculumTitle = item.Curriculum != null ? item.Curriculum.Title : "غير محدد";
                    var sectionsCount = item.Sections != null ? item.Sections.Count() : 0;
                    var batchesCount = item.ExamToBatches != null ? item.ExamToBatches.Count() : 0;

                    var questionsPercent = totalQuestions > 0
                    ? Math.Round((item.TotalQuestions / (double)totalQuestions) * 100, 0)
                    : 0;

                    var batchNames = item.ExamToBatches != null && item.ExamToBatches.Any()
                    ? string.Join(" ", item.ExamToBatches.Select(x => x.Batch != null ? x.Batch.Name : "غير محدد"))
                    : "غير محدد";

                    var searchText = $"{item.Title} {curriculumTitle} {batchNames} {item.CreatedAt:yyyy/MM/dd} {item.DurationMinutes} {item.TotalQuestions}".ToLower();

                    <div class="exam-card @(showArchived ? "archived-card" : "")"
                         data-search="@searchText">

                        <div class="exam-card-body">

                            <div class="exam-head">
                                <div class="exam-title-wrap">
                                    <div class="exam-avatar">
                                        <i class="bi bi-graph-up-arrow"></i>
                                    </div>

                                    <div>
                                        <div class="exam-title">@item.Title</div>
                                        <div class="exam-sub">
                                            تاريخ الإنشاء:
                                            @item.CreatedAt.ToString("yyyy/MM/dd")
                                        </div>
                                    </div>
                                </div>

                                <span class="curriculum-pill" title="@curriculumTitle">
                                    <i class="bi bi-book"></i>
                                    @curriculumTitle
                                </span>
                            </div>

                            <div class="exam-mini-grid">
                                <div class="exam-mini-stat">
                                    <span class="mini-val">@sectionsCount</span>
                                    <span class="mini-label">محور</span>
                                </div>

                                <div class="exam-mini-stat">
                                    <span class="mini-val text-emerald">@item.TotalQuestions</span>
                                    <span class="mini-label">سؤال</span>
                                </div>

                                <div class="exam-mini-stat">
                                    <span class="mini-val text-violet">@item.DurationMinutes</span>
                                    <span class="mini-label">دقيقة</span>
                                </div>
                            </div>

                            <div class="exam-batches">
                                @if (item.ExamToBatches != null && item.ExamToBatches.Any())
                                {
                                    foreach (var b in item.ExamToBatches)
                                    {
                                        <span class="batch-pill">
                                            <i class="bi bi-people-fill"></i>
                                            @(b.Batch != null ? b.Batch.Name : "غير محدد")
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="batch-pill empty">
                                        <i class="bi bi-people"></i>
                                        لا توجد دفعات مرتبطة
                                    </span>
                                }
                            </div>

                            <div class="indicator-progress-wrap">
                                <div class="indicator-progress-meta">
                                    <span>نسبة أسئلة الاختبار من إجمالي الصفحة</span>
                                    <strong>@questionsPercent%</strong>
                                </div>

                                <div class="indicator-progress">
                                    <div class="indicator-progress-bar"
                                         style="width:@questionsPercent%;">
                                    </div>
                                </div>
                            </div>

                            <div class="exam-foot-stats">
                                <span>
                                    <i class="bi bi-diagram-3"></i>
                                    @sectionsCount محور
                                </span>

                                <span>
                                    <i class="bi bi-people"></i>
                                    @batchesCount دفعة
                                </span>

                                <span>
                                    <i class="bi bi-calendar-event"></i>
                                    @item.CreatedAt.ToString("yyyy/MM/dd")
                                </span>
                            </div>

                            <div class="exam-actions-row">
                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="exam-open-btn">
                                    <i class="bi bi-eye"></i>
                                    عرض التفاصيل
                                </a>

                                @if (!showArchived)
                                {
                                    <form asp-action="Delete"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          class="exam-delete-form"
                                          onsubmit="return confirm('هل أنت متأكد من حذف هذا الاختبار؟');">
                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="exam-delete-btn"
                                                title="حذف الاختبار">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>

                            @if (showArchived && (User.IsInRole("Owner") || User.IsInRole("Developer")))
                            {
                                <a asp-area="Admin"
                                   asp-controller="PerformanceIndicatorExams"
                                   asp-action="ManageArchiveAccess"
                                   asp-route-examId="@item.Id"
                                   class="exam-access-btn">
                                    <i class="bi bi-shield-lock-fill"></i>
                                    صلاحيات الأرشيف
                                </a>
                            }

                        </div>
                    </div>
                }

            </div>
        }

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const archiveSection = document.getElementById("archiveManagerSection");
            const archiveToggle = document.getElementById("archiveManagerToggle");

            if (archiveSection && archiveToggle) {
                archiveToggle.addEventListener("click", function () {
                    const isOpen = archiveSection.classList.contains("is-open");

                    archiveSection.classList.toggle("is-open", !isOpen);
                    archiveToggle.setAttribute("aria-expanded", (!isOpen).toString());
                });
            }

            const searchInput = document.getElementById("indicatorExamSearch");
            const cards = Array.from(document.querySelectorAll("#indicatorExamsGrid .exam-card"));

            if (searchInput) {
                searchInput.addEventListener("input", function () {
                    const value = (this.value || "").toLowerCase().trim();

                    cards.forEach(function (card) {
                        const text = card.getAttribute("data-search") || "";

                        if (text.indexOf(value) >= 0) {
                            card.style.display = "";
                        } else {
                            card.style.display = "none";
                        }
                    });
                });
            }

        });
    </script>
}