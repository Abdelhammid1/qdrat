@model QdratNew.ViewModels.PerformanceIndicator.StudentPerformanceIndicatorQuestionReportViewModel

@{
    ViewData["Title"] = "أسئلة الطالب في اختبار مؤشرات الأداء";
}

@section Styles {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        body { background: #f4f7fb !important; }
        .sq-page { direction: rtl; padding: 28px 0 60px; font-family: 'Cairo', Arial, sans-serif; color: #0f172a; }
        .sq-header, .sq-card, .sq-table-panel {
            background: #fff; border: 1px solid #dbe4ef; border-radius: 14px;
            box-shadow: 0 8px 22px rgba(15,23,42,.06);
        }
        .sq-header { padding: 18px 22px; display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin-bottom: 22px; }
        .sq-title { margin: 0; font-size: 22px; font-weight: 900; display: flex; gap: 8px; align-items: center; }
        .sq-sub { color: #64748b; font-size: 13px; font-weight: 700; margin-top: 6px; }
        .sq-btn {
            border-radius: 10px; border: 1px solid #cbd5e1; background: #fff; color: #334155;
            padding: 8px 14px; font-size: 13px; font-weight: 900; text-decoration: none;
            display: inline-flex; align-items: center; justify-content: center; gap: 7px; white-space: nowrap;
        }
        .sq-btn:hover { background: #f1f5f9; color: #0f172a; text-decoration: none; }
        .sq-hero {
            background: linear-gradient(135deg, #17233c 0%, #1f3558 100%);
            color: #fff; border-radius: 14px; padding: 26px 28px; margin-bottom: 22px;
            box-shadow: 0 14px 32px rgba(15,23,42,.16);
        }
        .sq-hero-label {
            display: inline-flex; gap: 7px; align-items: center; background: rgba(255,255,255,.1);
            border: 1px solid rgba(255,255,255,.16); border-radius: 999px; padding: 5px 12px;
            font-size: 12px; font-weight: 900; margin-bottom: 12px;
        }
        .sq-hero h2 { margin: 0; font-size: 28px; font-weight: 900; }
        .sq-hero p { margin: 8px 0 0; color: #cbd5e1; font-size: 13px; font-weight: 700; }
        .sq-stats { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin-bottom: 22px; }
        .sq-card { padding: 16px; display: flex; align-items: center; gap: 12px; min-height: 94px; }
        .sq-icon { width: 44px; height: 44px; border-radius: 13px; display: inline-flex; align-items: center; justify-content: center; font-size: 17px; flex-shrink: 0; }
        .blue { background: #dbeafe; color: #1d4ed8; }
        .green { background: #dcfce7; color: #15803d; }
        .red { background: #fee2e2; color: #b91c1c; }
        .gray { background: #f1f5f9; color: #475569; }
        .violet { background: #ede9fe; color: #6d28d9; }
        .sq-card-label { color: #64748b; font-size: 12px; font-weight: 900; margin-bottom: 5px; }
        .sq-card-value { color: #0f172a; font-size: 24px; font-weight: 900; line-height: 1; }
        .sq-section-label { font-size: 14px; font-weight: 900; color: #334155; margin: 20px 0 12px; display: flex; gap: 8px; align-items: center; }
        .sq-section-label::after { content: ""; flex: 1; height: 1px; background: #dbe4ef; }
        .sq-table-panel { overflow: hidden; }
        .sq-table { width: 100%; border-collapse: collapse; margin: 0; font-size: 13px; }
        .sq-table th {
            background: #f1f5f9; color: #0f172a; padding: 12px 10px; border: 1px solid #dbe4ef;
            font-weight: 900; text-align: center; white-space: nowrap;
        }
        .sq-table td { padding: 12px 10px; border: 1px solid #e2e8f0; text-align: center; vertical-align: middle; font-weight: 700; }
        .sq-table tbody tr:hover td { background: #f8fafc; }
        .sq-question { min-width: 260px; text-align: right !important; font-weight: 900; line-height: 1.8; }
        .sq-badge {
            display: inline-flex; align-items: center; justify-content: center; gap: 5px;
            border-radius: 999px; padding: 5px 10px; font-size: 11px; font-weight: 900;
            border: 1px solid transparent; white-space: nowrap;
        }
        .badge-ok { background: #dcfce7; color: #166534; border-color: #86efac; }
        .badge-bad { background: #fee2e2; color: #991b1b; border-color: #fecaca; }
        .badge-muted { background: #f1f5f9; color: #475569; border-color: #cbd5e1; }
        .badge-info { background: #dbeafe; color: #1d4ed8; border-color: #bfdbfe; }
        .sq-empty { padding: 28px; text-align: center; color: #991b1b; font-weight: 900; }
        @@media (max-width: 1200px) { .sq-stats { grid-template-columns: repeat(3, 1fr); } }
        @@media (max-width: 768px) { .sq-page { padding: 18px 0 40px; } .sq-stats { grid-template-columns: 1fr; } .sq-btn { width: 100%; } }
    </style>
}

<div class="sq-page container-fluid px-4">
    <div class="sq-header">
        <div>
            <h1 class="sq-title">
                <i class="fa-solid fa-list-check text-primary"></i>
                أسئلة الطالب داخل الاختبار
            </h1>
            <div class="sq-sub">عرض صحيح/خطأ/متخطى مع إجابة الطالب والإجابة الصحيحة لكل سؤال.</div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="ExamStudents" asp-route-id="@Model.ExamId" class="sq-btn">
                <i class="fa-solid fa-arrow-right"></i>
                رجوع للطلاب
            </a>
            <a asp-area="Admin"
               asp-controller="PerformanceExamReports"
               asp-action="StudentExamReport"
               asp-route-studentId="@Model.StudentId"
               asp-route-examId="@Model.ExamId"
               target="_blank"
               class="sq-btn">
                <i class="fa-solid fa-print"></i>
                تقرير قابل للطباعة
            </a>
        </div>
    </div>

    <div class="sq-hero">
        <div class="sq-hero-label">
            <i class="fa-solid fa-user-graduate"></i>
            @Model.StudentName
        </div>
        <h2>@Model.ExamTitle</h2>
        <p>النسبة النهائية: @Model.ScorePercent%</p>
    </div>

    <div class="sq-stats">
        <div class="sq-card">
            <div class="sq-icon blue"><i class="fa-solid fa-question-circle"></i></div>
            <div><div class="sq-card-label">إجمالي الأسئلة</div><div class="sq-card-value">@Model.TotalQuestions</div></div>
        </div>
        <div class="sq-card">
            <div class="sq-icon green"><i class="fa-solid fa-check"></i></div>
            <div><div class="sq-card-label">الصحيح</div><div class="sq-card-value">@Model.CorrectCount</div></div>
        </div>
        <div class="sq-card">
            <div class="sq-icon red"><i class="fa-solid fa-xmark"></i></div>
            <div><div class="sq-card-label">الخطأ</div><div class="sq-card-value">@Model.WrongCount</div></div>
        </div>
        <div class="sq-card">
            <div class="sq-icon gray"><i class="fa-solid fa-forward"></i></div>
            <div><div class="sq-card-label">المتخطى</div><div class="sq-card-value">@Model.SkippedCount</div></div>
        </div>
        <div class="sq-card">
            <div class="sq-icon violet"><i class="fa-solid fa-percent"></i></div>
            <div><div class="sq-card-label">النسبة</div><div class="sq-card-value">@Model.ScorePercent%</div></div>
        </div>
    </div>

    <div class="sq-section-label">جدول الأسئلة</div>

    <div class="sq-table-panel">
        <div class="table-responsive">
            <table class="sq-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>نص السؤال</th>
                        <th>المحور</th>
                        <th>المؤشر</th>
                        <th>إجابة الطالب</th>
                        <th>الإجابة الصحيحة</th>
                        <th>الحالة</th>
                        <th>الزمن</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Questions.Any())
                    {
                        <tr>
                            <td colspan="8" class="sq-empty">لا توجد أسئلة داخل هذا الاختبار.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var question in Model.Questions)
                        {
                            var statusClass = question.IsSkipped ? "badge-muted" : question.IsCorrect ? "badge-ok" : "badge-bad";
                            <tr>
                                <td><span class="sq-badge badge-info">@question.OrderNumber</span></td>
                                <td class="sq-question">@Html.Raw(question.QuestionTitle)</td>
                                <td>@question.SectionTitle</td>
                                <td>@question.LessonTitle</td>
                                <td>@question.StudentAnswer</td>
                                <td>@question.CorrectAnswer</td>
                                <td><span class="sq-badge @statusClass">@question.StatusText</span></td>
                                <td>@(question.TimeTakenSeconds.HasValue ? $"{Math.Round(question.TimeTakenSeconds.Value, 1)} ث" : "—")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
