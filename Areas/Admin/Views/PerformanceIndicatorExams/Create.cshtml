@model QdratNew.ViewModels.Exam.CreatePerformanceExamViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "إنشاء اختبار مؤشر الأداء";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<div class="qdrat-page-wrapper" dir="rtl">
    <div class="qdrat-page-header">
        <div>
            <h1 class="qdrat-page-title">
                <i class="bi bi-graph-up-arrow"></i>
                إنشاء اختبار مؤشر الأداء
            </h1>
            <p class="qdrat-page-subtitle">
                إنشاء اختبار يقيس مؤشرات الأداء للطلاب حسب المنهج والدفعات المستهدفة مع دعم التوليد التلقائي أو النموذج الاحترافي.
            </p>
        </div>

        <a asp-action="Index" class="qdrat-back-btn">
            <i class="bi bi-arrow-right"></i>
            العودة للقائمة
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
    {
        <div class="qdrat-alert qdrat-alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <form asp-action="Create" method="post" class="qdrat-form-card">
        @Html.AntiForgeryToken()

        <div class="qdrat-card-header">
            <div class="qdrat-card-icon">
                <i class="bi bi-clipboard2-data"></i>
            </div>
            <div>
                <h2>بيانات الاختبار</h2>
                <p>حدد المنهج والفئة المستهدفة وطريقة إنشاء الأسئلة ونافذة إتاحة الاختبار.</p>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="qdrat-validation-summary"></div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="bi bi-file-earmark-text"></i>
                البيانات العامة
            </div>

            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="ExamTitle" class="qdrat-label">
                            اسم الاختبار
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="bi bi-type"></i>
                            <input asp-for="ExamTitle" class="form-control qdrat-input" placeholder="مثال: اختبار مؤشر الأداء لمنهج القدرات" />
                        </div>
                        <span asp-validation-for="ExamTitle" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="CurriculumId" class="qdrat-label">
                            المنهج
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-select-wrapper">
                            <i class="bi bi-book"></i>
                            <select asp-for="CurriculumId" asp-items="Model.AvailableCurriculums ?? new List<SelectListItem>()" class="form-select qdrat-select">
                                <option value="">-- اختر المنهج --</option>
                            </select>
                        </div>
                        <span asp-validation-for="CurriculumId" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="bi bi-people"></i>
                الفئة المستهدفة
            </div>

            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="SelectedBatchIds" class="qdrat-label">
                            الدفعات المستهدفة
                            <span class="qdrat-required">*</span>
                        </label>
                        <select asp-for="SelectedBatchIds"
                                asp-items="Model.AvailableBatches ?? new List<SelectListItem>()"
                                class="form-select qdrat-select select2"
                                multiple></select>
                        <small class="qdrat-help-text">يمكن اختيار أكثر من دفعة لنفس الاختبار.</small>
                        <span asp-validation-for="SelectedBatchIds" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="SelectedStudentIds" class="qdrat-label">
                            الطلاب المخصصون
                            <span class="qdrat-optional">اختياري</span>
                        </label>
                        <select asp-for="SelectedStudentIds"
                                asp-items="Model.AvailableStudents ?? new List<SelectListItem>()"
                                class="form-select qdrat-select select2"
                                multiple></select>
                        <small class="qdrat-help-text">اتركها فارغة إذا كان الاختبار لكل طلاب الدفعات المحددة.</small>
                        <span asp-validation-for="SelectedStudentIds" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="bi bi-sliders"></i>
                إعدادات الاختبار
            </div>

            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="TotalQuestions" class="qdrat-label">
                            عدد الأسئلة في كل محور
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="bi bi-list-ol"></i>
                            <input asp-for="TotalQuestions" type="number" min="1" max="50" class="form-control qdrat-input" value="12" />
                        </div>
                        <span asp-validation-for="TotalQuestions" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label class="qdrat-label">
                            نوع الاختبار
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-choice-grid">
                            <label class="qdrat-choice-card" for="online">
                                <input asp-for="IsOnline" type="radio" value="true" id="online" checked />
                                <span class="qdrat-choice-icon"><i class="bi bi-wifi"></i></span>
                                <span>أونلاين</span>
                            </label>

                            <label class="qdrat-choice-card" for="onsite">
                                <input asp-for="IsOnline" type="radio" value="false" id="onsite" />
                                <span class="qdrat-choice-icon"><i class="bi bi-building-check"></i></span>
                                <span>حضوري برقم مرجعي</span>
                            </label>
                        </div>
                        <span asp-validation-for="IsOnline" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="bi bi-shuffle"></i>
                طريقة إنشاء الأسئلة
            </div>

            <div class="qdrat-choice-grid qdrat-choice-grid-wide">
                <label class="qdrat-choice-card" for="autoGen">
                    <input asp-for="ManualSelection" type="radio" value="false" id="autoGen" checked />
                    <span class="qdrat-choice-icon"><i class="bi bi-magic"></i></span>
                    <span>توليد تلقائي من بنك الأسئلة</span>
                </label>

                <label class="qdrat-choice-card" for="manualSel">
                    <input asp-for="ManualSelection" type="radio" value="true" id="manualSel" />
                    <span class="qdrat-choice-icon"><i class="bi bi-diagram-3"></i></span>
                    <span>اختيار يدوي من نموذج احترافي</span>
                </label>
            </div>

            <div id="modelSelectContainer" class="qdrat-nested-field mt-4" style="display:none;">
                <label asp-for="ProfessionalModelId" class="qdrat-label">
                    النموذج الاحترافي
                </label>
                <div class="qdrat-select-wrapper">
                    <i class="bi bi-diagram-3"></i>
                    <select asp-for="ProfessionalModelId" asp-items="Model.AvailableModels ?? new List<SelectListItem>()" class="form-select qdrat-select">
                        <option value="">-- اختر النموذج --</option>
                    </select>
                </div>
                <span asp-validation-for="ProfessionalModelId" class="text-danger small"></span>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="bi bi-calendar2-week"></i>
                توقيت الاختبار
            </div>

            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="StartAt" class="qdrat-label">
                            بداية الاختبار
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="bi bi-calendar-event"></i>
                            <input asp-for="StartAt" type="datetime-local" class="form-control qdrat-input" />
                        </div>
                        <span asp-validation-for="StartAt" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="EndAt" class="qdrat-label">
                            نهاية الاختبار
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="bi bi-clock"></i>
                            <input asp-for="EndAt" type="datetime-local" class="form-control qdrat-input" />
                        </div>
                        <span asp-validation-for="EndAt" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-actions">
            <a asp-action="Index" class="qdrat-cancel-btn">
                <i class="bi bi-arrow-right"></i>
                رجوع
            </a>
            <button type="submit" class="qdrat-save-btn">
                <i class="bi bi-check-circle"></i>
                توليد الاختبار
            </button>
        </div>
    </form>
</div>

<style>
    .qdrat-page-wrapper {
        max-width: 1180px;
        margin: 0 auto;
        padding: 24px 16px 40px;
        font-family: 'Cairo','Tajawal',system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    }

    .qdrat-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 22px;
        padding: 22px 24px;
        border-radius: 24px;
        background: linear-gradient(135deg,#1d4ed8 0%,#0891b2 55%,#0f766e 100%);
        color: #fff;
        box-shadow: 0 18px 45px rgba(29,78,216,.20);
    }

    .qdrat-page-title {
        margin: 0;
        font-size: 26px;
        font-weight: 900;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .qdrat-page-subtitle {
        margin: 8px 0 0;
        color: rgba(255,255,255,.88);
        font-size: 14px;
        line-height: 1.8;
    }

    .qdrat-back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 150px;
        padding: 11px 18px;
        border-radius: 999px;
        color: #fff;
        text-decoration: none;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.32);
        font-size: 14px;
        font-weight: 800;
        transition: .2s ease-in-out;
    }

        .qdrat-back-btn:hover {
            color: #fff;
            background: rgba(255,255,255,.24);
            transform: translateY(-1px);
        }

    .qdrat-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 16px;
        border-radius: 18px;
        margin-bottom: 18px;
        font-weight: 800;
    }

    .qdrat-alert-danger {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .qdrat-form-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 26px;
        box-shadow: 0 20px 55px rgba(15,23,42,.08);
        padding: 26px;
        overflow: hidden;
    }

    .qdrat-card-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding-bottom: 22px;
        border-bottom: 1px solid #eef2f7;
        margin-bottom: 24px;
    }

    .qdrat-card-icon {
        width: 54px;
        height: 54px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg,#eff6ff 0%,#ecfeff 100%);
        color: #1d4ed8;
        font-size: 23px;
        flex-shrink: 0;
    }

    .qdrat-card-header h2 {
        margin: 0;
        font-size: 20px;
        font-weight: 900;
        color: #111827;
    }

    .qdrat-card-header p {
        margin: 6px 0 0;
        color: #6b7280;
        font-size: 13px;
    }

    .qdrat-section {
        padding: 20px;
        border: 1px solid #eef2f7;
        background: #fbfdff;
        border-radius: 22px;
        margin-bottom: 20px;
    }

    .qdrat-section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 18px;
        color: #0f172a;
        font-size: 16px;
        font-weight: 900;
    }

        .qdrat-section-title i {
            color: #1d4ed8;
        }

    .qdrat-form-group {
        margin-bottom: 2px;
    }

    .qdrat-label {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 9px;
        color: #1f2937;
        font-size: 14px;
        font-weight: 900;
    }

    .qdrat-required {
        color: #dc2626;
        font-weight: 900;
    }

    .qdrat-optional {
        color: #64748b;
        background: #f1f5f9;
        padding: 2px 8px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 900;
    }

    .qdrat-help-text {
        display: block;
        color: #64748b;
        font-size: 12px;
        margin-top: 7px;
        font-weight: 700;
    }

    .qdrat-input-wrapper, .qdrat-select-wrapper {
        position: relative;
    }

        .qdrat-input-wrapper i, .qdrat-select-wrapper i {
            position: absolute;
            top: 50%;
            right: 15px;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 15px;
            z-index: 2;
        }

    .qdrat-input, .qdrat-select {
        min-height: 48px;
        border-radius: 16px;
        border: 1px solid #dbe3ef;
        background: #fff;
        padding: 10px 44px 10px 14px;
        color: #111827;
        font-size: 14px;
        font-weight: 700;
        transition: .18s ease-in-out;
    }

        .qdrat-input:focus, .qdrat-select:focus {
            border-color: #1d4ed8;
            box-shadow: 0 0 0 4px rgba(29,78,216,.10);
        }

    .qdrat-validation-summary {
        color: #b91c1c;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 16px;
        padding: 12px 16px;
        margin-bottom: 20px;
        font-size: 14px;
        font-weight: 700;
    }

        .qdrat-validation-summary:empty {
            display: none;
        }

    .qdrat-choice-grid {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 12px;
    }

    .qdrat-choice-grid-wide {
        max-width: 760px;
    }

    .qdrat-choice-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px;
        border: 1px solid #dbe3ef;
        background: #fff;
        border-radius: 18px;
        cursor: pointer;
        font-weight: 900;
        color: #0f172a;
        transition: .18s ease-in-out;
    }

        .qdrat-choice-card:hover {
            border-color: #93c5fd;
            box-shadow: 0 10px 24px rgba(15,23,42,.06);
        }

        .qdrat-choice-card input {
            width: 18px;
            height: 18px;
            accent-color: #1d4ed8;
        }

    .qdrat-choice-icon {
        width: 34px;
        height: 34px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        color: #1d4ed8;
    }

    .qdrat-nested-field {
        padding: 16px;
        border-radius: 18px;
        border: 1px dashed #bfdbfe;
        background: #f8fbff;
    }

    .qdrat-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding-top: 8px;
        flex-wrap: wrap;
    }

    .qdrat-save-btn, .qdrat-cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-width: 170px;
        min-height: 48px;
        border-radius: 999px;
        font-size: 15px;
        font-weight: 900;
        text-decoration: none;
        border: none;
        transition: .2s ease-in-out;
    }

    .qdrat-save-btn {
        color: #fff;
        background: linear-gradient(135deg,#16a34a 0%,#0f766e 100%);
        box-shadow: 0 14px 30px rgba(22,163,74,.22);
    }

        .qdrat-save-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 18px 34px rgba(22,163,74,.28);
        }

    .qdrat-cancel-btn {
        color: #334155;
        background: #fff;
        border: 1px solid #cbd5e1;
    }

        .qdrat-cancel-btn:hover {
            color: #0f172a;
            background: #f8fafc;
            transform: translateY(-1px);
        }

    .select2-container--default .select2-selection--multiple {
        min-height: 48px;
        border-radius: 16px;
        border: 1px solid #dbe3ef;
        padding: 5px 8px;
        direction: rtl;
    }

    .select2-container--default.select2-container--focus .select2-selection--multiple {
        border-color: #1d4ed8;
        box-shadow: 0 0 0 4px rgba(29,78,216,.10);
    }

    .select2-container--default .select2-selection--multiple .select2-selection__choice {
        border: 0;
        border-radius: 999px;
        background: #eff6ff;
        color: #1d4ed8;
        font-weight: 800;
        padding: 4px 8px;
    }

    @@media (max-width:768px) {
        .qdrat-page-header {
            flex-direction: column;
            align-items: stretch;
            padding: 20px
        }

        .qdrat-page-title {
            font-size: 21px
        }

        .qdrat-back-btn {
            width: 100%
        }

        .qdrat-form-card {
            padding: 18px;
            border-radius: 22px
        }

        .qdrat-section {
            padding: 16px
        }

        .qdrat-choice-grid {
            grid-template-columns: 1fr
        }

        .qdrat-actions {
            flex-direction: column
        }

        .qdrat-save-btn, .qdrat-cancel-btn {
            width: 100%
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(function () {
            $('.select2').select2({ width: '100%', placeholder: "اختر من القائمة...", dir: "rtl" });

            $('input[name="ManualSelection"]').change(function () {
                if ($('#manualSel').is(':checked')) {
                    $('#modelSelectContainer').fadeIn(300);
                } else {
                    $('#modelSelectContainer').fadeOut(200);
                }
            });

            if ($('#manualSel').is(':checked')) {
                $('#modelSelectContainer').show();
            }
        });
    </script>
}
