@model QdratNew.ViewModels.Exam.CreateFromProfessionalModelViewModel

@{
    ViewData["Title"] = "إنشاء اختبار من نموذج احترافي";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<div class="qdrat-page-wrapper" dir="rtl">
    <div class="qdrat-page-header">
        <div>
            <h1 class="qdrat-page-title">
                <i class="bi bi-diagram-3"></i>
                إنشاء اختبار من نموذج احترافي
            </h1>
            <p class="qdrat-page-subtitle">
                اختر المنهج والدفعة والنموذج الاحترافي ثم حدد توقيت الاختبار ومدته لإرساله للطلاب.
            </p>
        </div>

        <a asp-action="Index" class="qdrat-back-btn">
            <i class="bi bi-arrow-right"></i>
            العودة للقائمة
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
    {
        <div class="qdrat-alert qdrat-alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <form asp-action="CreateFromProfessionalModel" method="post" class="qdrat-form-card">
        @Html.AntiForgeryToken()

        <div class="qdrat-card-header">
            <div class="qdrat-card-icon">
                <i class="bi bi-patch-check"></i>
            </div>
            <div>
                <h2>بيانات النموذج والاختبار</h2>
                <p>حدد النموذج الاحترافي والدفعة المستهدفة وتوقيت الإتاحة.</p>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="qdrat-validation-summary"></div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="bi bi-diagram-2"></i>
                اختيار المصدر والدفعة
            </div>

            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="qdrat-form-group">
                        <label asp-for="SelectedCurriculumId" class="qdrat-label">
                            المنهج
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-select-wrapper">
                            <i class="bi bi-book"></i>
                            <select asp-for="SelectedCurriculumId" asp-items="Model.AvailableCurriculums" class="form-select qdrat-select">
                                <option value="">-- اختر المنهج --</option>
                            </select>
                        </div>
                        <span asp-validation-for="SelectedCurriculumId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="qdrat-form-group">
                        <label asp-for="SelectedBatchId" class="qdrat-label">
                            الدفعة
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-select-wrapper">
                            <i class="bi bi-people"></i>
                            <select asp-for="SelectedBatchId" asp-items="Model.AvailableBatches" class="form-select qdrat-select">
                                <option value="">-- اختر الدفعة --</option>
                            </select>
                        </div>
                        <span asp-validation-for="SelectedBatchId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="qdrat-form-group">
                        <label asp-for="SelectedModelId" class="qdrat-label">
                            النموذج الاحترافي
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-select-wrapper">
                            <i class="bi bi-diagram-3"></i>
                            <select asp-for="SelectedModelId" asp-items="Model.AvailableModels" class="form-select qdrat-select">
                                <option value="">-- اختر النموذج --</option>
                            </select>
                        </div>
                        <span asp-validation-for="SelectedModelId" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="bi bi-calendar2-week"></i>
                توقيت الاختبار
            </div>

            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="qdrat-form-group">
                        <label asp-for="StartAt" class="qdrat-label">
                            تاريخ ووقت البداية
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="bi bi-calendar-event"></i>
                            <input asp-for="StartAt" type="datetime-local" class="form-control qdrat-input" />
                        </div>
                        <span asp-validation-for="StartAt" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="qdrat-form-group">
                        <label asp-for="EndAt" class="qdrat-label">
                            تاريخ ووقت النهاية
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="bi bi-clock"></i>
                            <input asp-for="EndAt" type="datetime-local" class="form-control qdrat-input" />
                        </div>
                        <span asp-validation-for="EndAt" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="qdrat-form-group">
                        <label asp-for="DurationMinutes" class="qdrat-label">
                            مدة الاختبار بالدقائق
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="bi bi-hourglass-split"></i>
                            <input asp-for="DurationMinutes" type="number" class="form-control qdrat-input" min="1" max="300" />
                        </div>
                        <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-actions">
            <a asp-action="Index" class="qdrat-cancel-btn">
                <i class="bi bi-arrow-right"></i>
                إلغاء
            </a>
            <button type="submit" class="qdrat-save-btn">
                <i class="bi bi-check-circle"></i>
                إنشاء وإرسال الاختبار
            </button>
        </div>
    </form>
</div>

<style>
    .qdrat-page-wrapper {
        max-width: 1180px;
        margin: 0 auto;
        padding: 24px 16px 40px;
        font-family: 'Cairo','Tajawal',system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    }

    .qdrat-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 22px;
        padding: 22px 24px;
        border-radius: 24px;
        background: linear-gradient(135deg,#4338ca 0%,#2563eb 55%,#0891b2 100%);
        color: #fff;
        box-shadow: 0 18px 45px rgba(37,99,235,.20);
    }

    .qdrat-page-title {
        margin: 0;
        font-size: 26px;
        font-weight: 900;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .qdrat-page-subtitle {
        margin: 8px 0 0;
        color: rgba(255,255,255,.88);
        font-size: 14px;
        line-height: 1.8;
    }

    .qdrat-back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 150px;
        padding: 11px 18px;
        border-radius: 999px;
        color: #fff;
        text-decoration: none;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.32);
        font-size: 14px;
        font-weight: 800;
        transition: .2s ease-in-out;
    }

        .qdrat-back-btn:hover {
            color: #fff;
            background: rgba(255,255,255,.24);
            transform: translateY(-1px);
        }

    .qdrat-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 16px;
        border-radius: 18px;
        margin-bottom: 18px;
        font-weight: 800;
    }

    .qdrat-alert-danger {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .qdrat-form-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 26px;
        box-shadow: 0 20px 55px rgba(15,23,42,.08);
        padding: 26px;
        overflow: hidden;
    }

    .qdrat-card-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding-bottom: 22px;
        border-bottom: 1px solid #eef2f7;
        margin-bottom: 24px;
    }

    .qdrat-card-icon {
        width: 54px;
        height: 54px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg,#eef2ff 0%,#eff6ff 100%);
        color: #4338ca;
        font-size: 23px;
        flex-shrink: 0;
    }

    .qdrat-card-header h2 {
        margin: 0;
        font-size: 20px;
        font-weight: 900;
        color: #111827;
    }

    .qdrat-card-header p {
        margin: 6px 0 0;
        color: #6b7280;
        font-size: 13px;
    }

    .qdrat-section {
        padding: 20px;
        border: 1px solid #eef2f7;
        background: #fbfdff;
        border-radius: 22px;
        margin-bottom: 20px;
    }

    .qdrat-section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 18px;
        color: #0f172a;
        font-size: 16px;
        font-weight: 900;
    }

        .qdrat-section-title i {
            color: #4338ca;
        }

    .qdrat-label {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 9px;
        color: #1f2937;
        font-size: 14px;
        font-weight: 900;
    }

    .qdrat-required {
        color: #dc2626;
        font-weight: 900;
    }

    .qdrat-input-wrapper, .qdrat-select-wrapper {
        position: relative;
    }

        .qdrat-input-wrapper i, .qdrat-select-wrapper i {
            position: absolute;
            top: 50%;
            right: 15px;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 15px;
            z-index: 2;
        }

    .qdrat-input, .qdrat-select {
        min-height: 48px;
        border-radius: 16px;
        border: 1px solid #dbe3ef;
        background: #fff;
        padding: 10px 44px 10px 14px;
        color: #111827;
        font-size: 14px;
        font-weight: 700;
        transition: .18s ease-in-out;
    }

        .qdrat-input:focus, .qdrat-select:focus {
            border-color: #4338ca;
            box-shadow: 0 0 0 4px rgba(67,56,202,.10);
        }

    .qdrat-validation-summary {
        color: #b91c1c;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 16px;
        padding: 12px 16px;
        margin-bottom: 20px;
        font-size: 14px;
        font-weight: 700;
    }

        .qdrat-validation-summary:empty {
            display: none;
        }

    .qdrat-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding-top: 8px;
        flex-wrap: wrap;
    }

    .qdrat-save-btn, .qdrat-cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-width: 190px;
        min-height: 48px;
        border-radius: 999px;
        font-size: 15px;
        font-weight: 900;
        text-decoration: none;
        border: none;
        transition: .2s ease-in-out;
    }

    .qdrat-save-btn {
        color: #fff;
        background: linear-gradient(135deg,#16a34a 0%,#0f766e 100%);
        box-shadow: 0 14px 30px rgba(22,163,74,.22);
    }

        .qdrat-save-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 18px 34px rgba(22,163,74,.28);
        }

    .qdrat-cancel-btn {
        color: #334155;
        background: #fff;
        border: 1px solid #cbd5e1;
    }

        .qdrat-cancel-btn:hover {
            color: #0f172a;
            background: #f8fafc;
            transform: translateY(-1px);
        }

    @@media (max-width:768px) {
        .qdrat-page-header {
            flex-direction: column;
            align-items: stretch;
            padding: 20px
        }

        .qdrat-page-title {
            font-size: 21px
        }

        .qdrat-back-btn {
            width: 100%
        }

        .qdrat-form-card {
            padding: 18px;
            border-radius: 22px
        }

        .qdrat-section {
            padding: 16px
        }

        .qdrat-actions {
            flex-direction: column
        }

        .qdrat-save-btn, .qdrat-cancel-btn {
            width: 100%
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
