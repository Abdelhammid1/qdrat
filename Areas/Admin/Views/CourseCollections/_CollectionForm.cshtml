@model QdratNew.ViewModels.Admin.CourseCollections.CourseCollectionFormViewModel
@using QdratNew.Enums

<div class="row g-3">
    <div class="col-12 col-md-6">
        <label asp-for="Name" class="form-label fw-600">اسم المجموعة <span class="text-danger">*</span></label>
        <input asp-for="Name" class="form-control" placeholder="مثال: ورش تدريبية موسمية" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="Slug" class="form-label fw-600">Slug <span class="text-danger">*</span></label>
        <input asp-for="Slug" class="form-control" placeholder="مثال: seasonal-workshops" dir="ltr" />
        <span asp-validation-for="Slug" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="Subtitle" class="form-label fw-600">عنوان فرعي</label>
        <input asp-for="Subtitle" class="form-control" maxlength="300" />
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="ButtonText" class="form-label fw-600">نص الزر</label>
        <input asp-for="ButtonText" class="form-control" placeholder="اكتشف المجموعة" maxlength="100" />
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label fw-600">الوصف</label>
        <textarea asp-for="Description" class="form-control" rows="3" maxlength="1000"></textarea>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="DisplayStyle" class="form-label fw-600">شكل العرض</label>
        <select asp-for="DisplayStyle" class="form-select"
                asp-items="Html.GetEnumSelectList<CourseCollectionDisplayStyle>()"></select>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="DisplayOrder" class="form-label fw-600">ترتيب العرض</label>
        <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
    </div>

    @* {{!-- ─── قسم اللوجو ─── --}} *@
    <div class="col-12">
        <hr class="my-1" />
        <label class="form-label fw-600 mb-2">
            <i class="fas fa-image me-1 text-primary"></i> لوجو المجموعة
        </label>

        @if (!string.IsNullOrEmpty(Model.ExistingLogoPath))
        {
            <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 mb-2" id="existingLogoBox">
                <img src="@Model.ExistingLogoPath" alt="لوجو المجموعة"
                     style="width:80px;height:80px;object-fit:contain;border-radius:10px;border:1px solid #e2e8f0;background:#fff;" />
                <div>
                    <div class="text-muted small mb-2">اللوجو الحالي</div>
                    <div class="form-check">
                        <input asp-for="RemoveLogo" class="form-check-input" type="checkbox" id="removeLogoCheck"
                               onchange="toggleLogoRemoval(this)" />
                        <label class="form-check-label text-danger small fw-600" for="removeLogoCheck">
                            حذف اللوجو الحالي
                        </label>
                    </div>
                </div>
            </div>
        }
        else
        {
            <input type="hidden" asp-for="RemoveLogo" value="false" />
        }

        <div id="logoUploadArea">
            <input asp-for="LogoFile" type="file" class="form-control" accept="image/*"
                   onchange="previewLogo(this)" id="logoFileInput" />
            <small class="text-muted">صيغ مقبولة: JPG, PNG, WebP — سيُحوَّل تلقائياً لـ WebP</small>

            <div id="logoPreview" class="mt-2" style="display:none;">
                <img id="logoPreviewImg" src="" alt="معاينة"
                     style="max-width:120px;max-height:120px;object-fit:contain;border-radius:10px;border:1px solid #e2e8f0;" />
                <div class="text-muted small mt-1">معاينة اللوجو الجديد</div>
            </div>
        </div>
    </div>

    @* {{!-- ─── قسم خلفية السكشن ─── --}} *@
    <div class="col-12">
        <hr class="my-1" />
        <label class="form-label fw-600 mb-2">
            <i class="fas fa-panorama me-1 text-primary"></i> خلفية السكشن (تظهر خلف عنوان المجموعة بالرئيسية)
        </label>

        @if (!string.IsNullOrEmpty(Model.ExistingBackgroundImagePath))
        {
            <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 mb-2" id="existingBgBox">
                <img src="@Model.ExistingBackgroundImagePath" alt="خلفية السكشن"
                     style="width:140px;height:80px;object-fit:cover;border-radius:10px;border:1px solid #e2e8f0;background:#fff;" />
                <div>
                    <div class="text-muted small mb-2">الخلفية الحالية</div>
                    <div class="form-check">
                        <input asp-for="RemoveBackgroundImage" class="form-check-input" type="checkbox" id="removeBgCheck"
                               onchange="toggleBgRemoval(this)" />
                        <label class="form-check-label text-danger small fw-600" for="removeBgCheck">
                            حذف الخلفية الحالية
                        </label>
                    </div>
                </div>
            </div>
        }
        else
        {
            <input type="hidden" asp-for="RemoveBackgroundImage" value="false" />
        }

        <div id="bgUploadArea">
            <input asp-for="BackgroundImageFile" type="file" class="form-control" accept="image/*"
                   onchange="previewBg(this)" id="bgFileInput" />
            <small class="text-muted">يُفضّل صورة عريضة (16:9) — سيُحوَّل تلقائياً لـ WebP. اتركه فارغاً لاستخدام خلفية افتراضية.</small>

            <div id="bgPreview" class="mt-2" style="display:none;">
                <img id="bgPreviewImg" src="" alt="معاينة"
                     style="max-width:220px;max-height:130px;object-fit:cover;border-radius:10px;border:1px solid #e2e8f0;" />
                <div class="text-muted small mt-1">معاينة الخلفية الجديدة</div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <hr class="my-1" />
        <label class="form-label fw-600 mb-2">الحد الأقصى الإجمالي للطلبات</label>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="GlobalMaxRequests" class="form-label fw-600">الحد الأقصى</label>
        <input asp-for="GlobalMaxRequests" class="form-control" type="number" min="1" placeholder="بلا حد" />
        <small class="text-muted">اتركه فارغاً للسماح بطلبات غير محدودة</small>
    </div>

    <div class="col-12 col-md-6 d-flex align-items-end pb-1">
        <div class="form-check form-switch">
            <input asp-for="AutoCloseWhenMaxReached" class="form-check-input" type="checkbox" role="switch" />
            <label asp-for="AutoCloseWhenMaxReached" class="form-check-label">إغلاق تلقائي عند اكتمال العدد</label>
        </div>
    </div>

    <div class="col-12">
        <label asp-for="ClosedMessage" class="form-label fw-600">رسالة الإغلاق</label>
        <input asp-for="ClosedMessage" class="form-control" maxlength="500"
               placeholder="اكتمل عدد الطلبات المتاحة لهذه المجموعة حالياً" />
    </div>

    <div class="col-12 d-flex gap-4 pt-2">
        <div class="form-check form-switch">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
            <label asp-for="IsActive" class="form-check-label">نشط</label>
        </div>
        <div class="form-check form-switch">
            <input asp-for="ShowOnHomePage" class="form-check-input" type="checkbox" role="switch" />
            <label asp-for="ShowOnHomePage" class="form-check-label">يظهر في الصفحة الرئيسية</label>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function previewLogo(input) {
            const preview = document.getElementById('logoPreview');
            const img = document.getElementById('logoPreviewImg');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    img.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
            } else {
                preview.style.display = 'none';
            }
        }

        function toggleLogoRemoval(checkbox) {
            const uploadArea = document.getElementById('logoUploadArea');
            const existingBox = document.getElementById('existingLogoBox');
            if (checkbox.checked) {
                if (existingBox) existingBox.style.opacity = '0.4';
            } else {
                if (existingBox) existingBox.style.opacity = '1';
            }
        }

        function previewBg(input) {
            const preview = document.getElementById('bgPreview');
            const img = document.getElementById('bgPreviewImg');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    img.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
            } else {
                preview.style.display = 'none';
            }
        }

        function toggleBgRemoval(checkbox) {
            const existingBox = document.getElementById('existingBgBox');
            if (checkbox.checked) {
                if (existingBox) existingBox.style.opacity = '0.4';
            } else {
                if (existingBox) existingBox.style.opacity = '1';
            }
        }
    </script>
}
