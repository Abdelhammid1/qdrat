@using QdratNew.Enums
@model IReadOnlyList<QdratNew.ViewModels.Admin.CourseCollections.CourseCollectionListItemViewModel>
@{
    ViewData["Title"] = "مجموعات الدورات";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0 fw-bold"><i class="fas fa-layer-group me-2 text-success"></i>مجموعات الدورات</h4>
            <small class="text-muted">إدارة مجموعات الدورات التسويقية القابلة لإعادة الاستخدام</small>
        </div>
        <a asp-area="Admin" asp-controller="CourseCollections" asp-action="Create"
           class="btn btn-success rounded-3">
            <i class="fas fa-plus me-1"></i> مجموعة جديدة
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-3 mb-4">
            <i class="fas fa-circle-check me-1"></i> @TempData["Success"]
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>اللوجو</th>
                            <th>اسم المجموعة</th>
                            <th>شكل العرض</th>
                            <th class="text-center">الدورات</th>
                            <th class="text-center">الرعاة</th>
                            <th class="text-center">نشط</th>
                            <th class="text-center">الصفحة الرئيسية</th>
                            <th class="text-center">ترتيب</th>
                            <th class="text-center">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td class="text-muted small">@c.Id</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(c.LogoPath))
                                    {
                                        <img src="@c.LogoPath" alt="لوجو @c.Name"
                                             style="width:40px;height:40px;object-fit:contain;border-radius:6px;border:1px solid #e2e8f0;" />
                                    }
                                    else
                                    {
                                        <div style="width:40px;height:40px;background:#f1f5f9;border-radius:6px;display:flex;align-items:center;justify-content:center;">
                                            <i class="fas fa-layer-group text-muted small"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-600">@c.Name</div>
                                    <code class="small text-muted">@c.Slug</code>
                                </td>
                                <td>
                                    @if (c.DisplayStyle == CourseCollectionDisplayStyle.Spotlight)
                                    {
                                        <span class="badge bg-warning text-dark">Spotlight</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark">Grid</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-area="Admin" asp-controller="CourseCollectionCourses" asp-action="Index"
                                       asp-route-collectionId="@c.Id" class="badge bg-light text-dark border text-decoration-none">
                                        @c.CourseCount <i class="fas fa-arrow-left ms-1 small"></i>
                                    </a>
                                </td>
                                <td class="text-center">
                                    <a asp-area="Admin" asp-controller="CourseCollectionSponsors" asp-action="Index"
                                       asp-route-collectionId="@c.Id" class="badge bg-light text-dark border text-decoration-none">
                                        @c.SponsorCount <i class="fas fa-arrow-left ms-1 small"></i>
                                    </a>
                                </td>
                                <td class="text-center">
                                    <form asp-area="Admin" asp-controller="CourseCollections"
                                          asp-action="ToggleActive" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <button type="submit" class="btn btn-sm rounded-pill px-3 @(c.IsActive ? "btn-success" : "btn-outline-secondary")">
                                            @(c.IsActive ? "نشط" : "معطّل")
                                        </button>
                                    </form>
                                </td>
                                <td class="text-center">
                                    <form asp-area="Admin" asp-controller="CourseCollections"
                                          asp-action="ToggleHomeVisibility" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <button type="submit" class="btn btn-sm rounded-pill px-3 @(c.ShowOnHomePage ? "btn-primary" : "btn-outline-secondary")">
                                            @(c.ShowOnHomePage ? "ظاهر" : "مخفي")
                                        </button>
                                    </form>
                                </td>
                                <td class="text-center text-muted small">@c.DisplayOrder</td>
                                <td class="text-center">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a asp-area="Admin" asp-controller="CourseCollectionCourses" asp-action="Index"
                                           asp-route-collectionId="@c.Id"
                                           class="btn btn-sm btn-outline-success rounded-3" title="إدارة الدورات">
                                            <i class="fas fa-list-check"></i>
                                        </a>
                                        <a asp-area="Admin" asp-controller="CourseCollectionSponsors" asp-action="Index"
                                           asp-route-collectionId="@c.Id"
                                           class="btn btn-sm btn-outline-warning rounded-3" title="إدارة الرعاة">
                                            <i class="fas fa-handshake"></i>
                                        </a>
                                        <a asp-area="Admin" asp-controller="CourseCollectionRegistrations" asp-action="Index"
                                           asp-route-CourseCollectionId="@c.Id"
                                           class="btn btn-sm btn-outline-info rounded-3" title="طلبات هذه المجموعة">
                                            <i class="fas fa-clipboard-list"></i>
                                        </a>
                                        <a asp-area="Admin" asp-controller="CourseCollections"
                                           asp-action="Edit" asp-route-id="@c.Id"
                                           class="btn btn-sm btn-outline-primary rounded-3" title="تعديل">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted py-5">
                                    <i class="fas fa-inbox fa-2x mb-2 d-block opacity-30"></i>
                                    لا توجد مجموعات بعد
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
