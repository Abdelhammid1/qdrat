@model QdratNew.ViewModels.Exam.MinistrySimExamStudentPickerVm

@if (!Model.Students.Any())
{
    <div class="qdrat-empty">
        <i class="bi bi-inboxes ms-1"></i>
        لا يوجد طلاب مسجَّلون فعليًا في هذه الدفعة.
    </div>
}
else
{
    @foreach (var student in Model.Students)
    {
        var disabled = student.AlreadyAssigned || student.HasAttempt;
        <div class="qdrat-student-row @(disabled ? "disabled" : "")">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="studentIds" value="@student.StudentId"
                       id="student-@student.StudentId" @(disabled ? "disabled" : "") />
                <label class="form-check-label" for="student-@student.StudentId">@student.FullName</label>
            </div>
            @if (student.HasAttempt)
            {
                <span class="badge bg-secondary">لديه محاولة مسجَّلة</span>
            }
            else if (student.AlreadyAssigned)
            {
                <span class="badge bg-success">مُسنَد له بالفعل</span>
            }
        </div>
    }
}
