@model QdratNew.ViewModels.Exam.MinistrySimExamIndexVm
@{
    ViewData["Title"] = "اختبار معمل القياس";
}

<style>
    .qdrat-page { direction: rtl; text-align: right; }

    .qdrat-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 48%, #2563eb 100%);
        border-radius: 24px; padding: 28px; color: #fff; margin-bottom: 24px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, .18);
    }

    .qdrat-card {
        background: #fff; border: 1px solid #e5e7eb; border-radius: 22px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, .06); overflow: hidden; margin-bottom: 18px;
    }

    .qdrat-card-header {
        padding: 17px 20px; background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 1px solid #e5e7eb; display: flex; align-items: center; justify-content: space-between; gap: 12px;
    }

    .qdrat-card-body { padding: 20px; }

    .qdrat-status-badge {
        display: inline-flex; align-items: center; gap: 6px;
        border-radius: 999px; padding: 4px 12px; font-size: 12.5px; font-weight: 800;
    }
    .qdrat-status-badge.published { background: #ecfdf5; color: #047857; }
    .qdrat-status-badge.draft { background: #fff6ea; color: #7a5615; }

    .qdrat-btn-primary {
        border: none; border-radius: 16px; padding: 10px 22px; font-weight: 900;
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: #fff;
        box-shadow: 0 12px 24px rgba(37,99,235,.22);
    }
</style>

<div class="container-fluid py-4 qdrat-page">

    <div class="qdrat-hero">
        <h2 class="mb-1"><i class="bi bi-diagram-3 ms-2"></i> اختبار معمل القياس</h2>
        <p class="mb-0" style="opacity:.9">5 مراحل متتالية (كمي + لفظي)، قفل أحادي الاتجاه، ترقيم تراكمي 1–120.</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="qdrat-card">
        <div class="qdrat-card-header">
            <h5 class="mb-0"><i class="bi bi-plus-circle ms-1"></i> إنشاء اختبار جديد</h5>
        </div>
        <div class="qdrat-card-body">
            @if (!Model.Courses.Any())
            {
                <p class="text-muted mb-0">لا توجد دورات نشطة حاليًا لإنشاء اختبار محاكاة وزارة لها.</p>
            }
            else
            {
                <form method="get" asp-action="Create" class="d-flex flex-wrap gap-2 align-items-center">
                    <select name="courseId" class="form-select" style="max-width:320px;" required>
                        <option value="">اختر الدورة...</option>
                        @foreach (var c in Model.Courses)
                        {
                            <option value="@c.Value">@c.Text</option>
                        }
                    </select>
                    <button type="submit" class="btn qdrat-btn-primary">
                        <i class="bi bi-arrow-left-short ms-1"></i> متابعة
                    </button>
                </form>
            }
        </div>
    </div>

    <div class="qdrat-card">
        <div class="qdrat-card-header">
            <h5 class="mb-0"><i class="bi bi-list-check ms-1"></i> الاختبارات الحالية</h5>
        </div>
        <div class="qdrat-card-body">
            @if (!Model.Exams.Any())
            {
                <p class="text-muted mb-0">لا توجد اختبارات محاكاة وزارة حتى الآن — استخدم النموذج أعلاه لإنشاء أول اختبار.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>العنوان</th>
                                <th>الدورة</th>
                                <th>الحالة</th>
                                <th>تاريخ الإنشاء</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var exam in Model.Exams)
                            {
                                <tr>
                                    <td>@exam.Title</td>
                                    <td>@exam.CourseName</td>
                                    <td>
                                        <span class="qdrat-status-badge @(exam.IsPublished ? "published" : "draft")">
                                            <i class="bi @(exam.IsPublished ? "bi-check-circle" : "bi-pencil-square")"></i>
                                            @(exam.IsPublished ? "منشور" : "مسودة")
                                        </span>
                                    </td>
                                    <td>@exam.CreatedAt.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-id="@exam.Id">
                                            <i class="bi bi-eye ms-1"></i> عرض
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>
