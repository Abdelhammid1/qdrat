@model QdratNew.ViewModels.Exam.MinistrySimExamAddQuestionVm
@using QdratNew.Helpers
@{
    ViewData["Title"] = "إضافة سؤال يدويًا";
}

<link href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<style>
    .qdrat-page { direction: rtl; text-align: right; }

    .qdrat-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 48%, #2563eb 100%);
        border-radius: 24px; padding: 28px; color: #fff; margin-bottom: 24px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, .18);
    }

    .qdrat-card {
        background: #fff; border: 1px solid #e5e7eb; border-radius: 22px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, .06); padding: 20px; margin-bottom: 18px;
    }

    .qdrat-empty { padding: 40px 20px; text-align: center; color: #64748b; }
</style>

<div class="container-fluid py-4 qdrat-page">
    <div class="qdrat-hero">
        <h3 class="mb-1"><i class="bi bi-plus-circle ms-2"></i> إضافة سؤال يدويًا</h3>
        <p class="mb-0" style="opacity:.9">المؤشر: @Model.LessonTitle — المحور: @Model.SectionTitle</p>
        <a class="btn btn-sm btn-light mt-3" href="@Url.Action("ReviewStage", "MinistrySimExam", new { area = "Admin", stageId = Model.StageId })">
            <i class="bi bi-arrow-right ms-1"></i> رجوع لمراجعة المرحلة
        </a>
    </div>

    <form id="antiForm">@Html.AntiForgeryToken()</form>

    <div class="qdrat-card">
        @if (!Model.Candidates.Any())
        {
            <div class="qdrat-empty">
                <i class="bi bi-inbox" style="font-size:28px"></i>
                <p class="mb-0 mt-2">لا توجد أسئلة متاحة من نفس المؤشر ونفس مستوى الصعوبة غير مستخدمة بالفعل في هذه المرحلة.</p>
            </div>
        }
        else
        {
            <table id="candTable" class="table table-striped table-bordered text-center">
                <thead>
                    <tr>
                        <th>نص السؤال</th>
                        <th>صح</th>
                        <th>إجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in Model.Candidates)
                    {
                        <tr>
                            <td class="text-start">@Html.Raw(NumberHelper.ToIndicNumbersSafe(q.Title))</td>
                            <td>@Html.Raw(NumberHelper.ToIndicNumbersSafe(q.CorrectAnswer))</td>
                            <td>
                                <button type="button" class="btn btn-outline-success btn-sm"
                                        onclick="confirmAdd('@q.QuestionId')">
                                    <i class="bi bi-plus-circle"></i> إضافة
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.7.0.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    @if (Model.Candidates.Any())
    {
        <text>
        new DataTable('#candTable', {
            language: { url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/ar.json' }
        });
        </text>
    }

    function confirmAdd(questionId) {
        Swal.fire({
            title: "تأكيد الإضافة؟",
            text: "سيُضاف هذا السؤال إلى المرحلة.",
            icon: "question",
            showCancelButton: true,
            confirmButtonText: "نعم، أضف",
            cancelButtonText: "إلغاء"
        }).then(function (result) {
            if (!result.isConfirmed) return;

            var token = document.querySelector('#antiForm input[name="__RequestVerificationToken"]').value;
            var formData = new FormData();
            formData.append("stageId", "@Model.StageId");
            formData.append("lessonId", "@Model.LessonId");
            formData.append("difficulty", "@Model.DifficultyLevel");
            formData.append("questionId", questionId);

            fetch('@Url.Action("AddQuestionManuallyConfirm", "MinistrySimExam", new { area = "Admin" })', {
                method: "POST",
                headers: { "RequestVerificationToken": token },
                body: formData
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.success) {
                    Swal.fire({
                        icon: "success",
                        title: "تمت الإضافة بنجاح",
                        timer: 1500,
                        showConfirmButton: false
                    }).then(function () {
                        window.location.href = '@Url.Action("ReviewStage", "MinistrySimExam", new { area = "Admin", stageId = Model.StageId })';
                    });
                } else {
                    Swal.fire("خطأ", data.message || "تعذّرت الإضافة.", "error");
                }
            })
            .catch(function () {
                Swal.fire("خطأ", "تعذّر الاتصال بالخادم — حاول مرة أخرى.", "error");
            });
        });
    }
</script>
}
