@model QdratNew.ViewModels.Exam.MinistrySimExamReviewStageVm
@using QdratNew.Helpers
@using System.Text.RegularExpressions
@{
    ViewData["Title"] = "مراجعة أسئلة القسم";

    var quantCount = Model.Questions.Count(x => x.IsQuant);
    var verbalCount = Model.Questions.Count(x => !x.IsQuant);
    var manualCount = Model.Questions.Count(x => x.IsManuallySelected);
    var incompleteCount = Model.IndicatorStatuses.Count(x => !x.IsComplete);
}

<style>
    .qdrat-page { direction: rtl; text-align: right; }

    /* ───── Hero ───── */
    .rs-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 48%, #2563eb 100%);
        border-radius: 24px; padding: 26px 28px; color: #fff; margin-bottom: 20px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, .18);
    }
    .rs-hero h2 { font-weight: 900; }
    .rs-hero-axes { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
    .rs-axis-pill {
        background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.25);
        border-radius: 999px; padding: 5px 14px; font-size: 13px; font-weight: 700;
    }

    /* ───── Stats ───── */
    .rs-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; margin-bottom: 20px; }
    .rs-stat {
        background: #fff; border: 1px solid #e5e7eb; border-radius: 18px; padding: 14px 18px;
        box-shadow: 0 6px 18px rgba(15, 23, 42, .05);
    }
    .rs-stat-value { font-size: 26px; font-weight: 900; color: #0f172a; line-height: 1.1; }
    .rs-stat-label { font-size: 12.5px; color: #64748b; font-weight: 700; margin-top: 2px; }
    .rs-stat.warn .rs-stat-value { color: #b91c1c; }
    .rs-stat.ok .rs-stat-value { color: #047857; }

    /* ───── Cards ───── */
    .qdrat-card {
        background: #fff; border: 1px solid #e5e7eb; border-radius: 22px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, .06); overflow: hidden; margin-bottom: 18px;
    }
    .qdrat-card-header {
        padding: 16px 20px; background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 1px solid #e5e7eb; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
    }

    /* ───── Toolbar ───── */
    .rs-toolbar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .rs-chip {
        border: 1px solid #cbd5e1; background: #fff; color: #334155; border-radius: 999px;
        padding: 5px 14px; font-size: 13px; font-weight: 800; cursor: pointer; transition: .15s;
    }
    .rs-chip:hover { border-color: #2563eb; color: #1d4ed8; }
    .rs-chip.active { background: #1d4ed8; border-color: #1d4ed8; color: #fff; }
    .rs-search { min-width: 220px; max-width: 320px; }

    /* ───── Question rows ───── */
    .rs-q {
        display: flex; align-items: flex-start; gap: 14px;
        padding: 16px 20px; border-bottom: 1px solid #eef2f7; flex-wrap: wrap;
    }
    .rs-q:last-child { border-bottom: none; }
    .rs-q:hover { background: #fafcff; }
    .rs-q.is-hidden { display: none; }

    .rs-q-order {
        font-weight: 900; font-size: 15px; color: #1d4ed8;
        background: #eef4ff; border-radius: 12px; padding: 6px 0; width: 48px; text-align: center; flex-shrink: 0;
    }
    .rs-q-body { flex: 1; min-width: 260px; }
    .rs-q-title {
        position: relative; max-height: 74px; overflow: hidden; line-height: 1.8; font-size: 15px; color: #0f172a;
    }
    .rs-q-title::after {
        content: ""; position: absolute; inset-inline: 0; bottom: 0; height: 22px;
        background: linear-gradient(180deg, rgba(255,255,255,0), #fff);
    }
    .rs-q:hover .rs-q-title::after { background: linear-gradient(180deg, rgba(250,252,255,0), #fafcff); }
    .rs-q-title svg, .rs-q-title img { max-height: 60px; max-width: 100%; }

    .rs-q-meta { font-size: 12.5px; color: #64748b; margin-top: 8px; display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .rs-badge { display: inline-block; border-radius: 999px; padding: 2px 10px; font-size: 11.5px; font-weight: 800; }
    .rs-badge.quant { background: #eef4ff; color: #2f59c0; }
    .rs-badge.verbal { background: #fff6ea; color: #b45309; }
    .rs-badge.manual { background: #ecfdf5; color: #047857; }
    .rs-badge.diff-0 { background: #ecfdf5; color: #047857; }
    .rs-badge.diff-1 { background: #fef9c3; color: #854d0e; }
    .rs-badge.diff-2 { background: #ffedd5; color: #c2410c; }
    .rs-badge.diff-3 { background: #fee2e2; color: #b91c1c; }
    .rs-badge.plain { background: #f1f5f9; color: #475569; }

    .rs-q-note {
        margin-top: 8px; background: #fffbeb; border: 1px dashed #fcd34d; color: #92400e;
        border-radius: 10px; padding: 6px 10px; font-size: 12.5px; display: inline-block; max-width: 100%;
    }

    .rs-q-actions { display: flex; gap: 8px; flex-wrap: wrap; flex-shrink: 0; align-items: center; }

    .rs-empty { padding: 40px 20px; text-align: center; color: #64748b; }

    /* ───── Indicators ───── */
    .rs-ind-row {
        display: flex; align-items: center; justify-content: space-between; gap: 12px;
        padding: 12px 20px; border-bottom: 1px dashed #e5e7eb; flex-wrap: wrap;
    }
    .rs-ind-row:last-child { border-bottom: none; }
    .rs-ind-count { font-family: monospace; font-weight: 800; color: #b91c1c; }

    @@media (max-width: 576px) {
        .rs-hero { padding: 20px; }
        .rs-q-actions { width: 100%; }
        .rs-search { max-width: 100%; width: 100%; }
    }
</style>

<div class="container-fluid py-4 qdrat-page">
    <div class="rs-hero">
        <h2 class="mb-1"><i class="bi bi-diagram-3 ms-2"></i> مراجعة أسئلة @SectionNameHelper.Name(Model.StageNumber)</h2>
        <div class="rs-hero-axes">
            <span class="rs-axis-pill"><i class="bi bi-calculator ms-1"></i> الكمي: @Model.QuantSectionTitle</span>
            <span class="rs-axis-pill"><i class="bi bi-book ms-1"></i> اللفظي: @Model.VerbalSectionTitle</span>
            <span class="rs-axis-pill"><i class="bi bi-clock ms-1"></i> @Model.DurationMinutes دقيقة</span>
        </div>
        <a class="btn btn-sm btn-light mt-3" href="@Url.Action("Details", "MinistrySimExam", new { area = "Admin", id = Model.MinistrySimExamId })">
            <i class="bi bi-arrow-right ms-1"></i> رجوع لحالة الاختبار
        </a>
    </div>

    <div class="rs-stats">
        <div class="rs-stat"><div class="rs-stat-value">@Model.Questions.Count</div><div class="rs-stat-label">إجمالي الأسئلة</div></div>
        <div class="rs-stat"><div class="rs-stat-value">@quantCount</div><div class="rs-stat-label">أسئلة كمية</div></div>
        <div class="rs-stat"><div class="rs-stat-value">@verbalCount</div><div class="rs-stat-label">أسئلة لفظية</div></div>
        <div class="rs-stat ok"><div class="rs-stat-value">@manualCount</div><div class="rs-stat-label">استبدال يدوي</div></div>
        <div class="rs-stat @(incompleteCount > 0 ? "warn" : "ok")"><div class="rs-stat-value">@incompleteCount</div><div class="rs-stat-label">مؤشرات ناقصة</div></div>
    </div>

    <form id="antiForm">@Html.AntiForgeryToken()</form>

    @if (incompleteCount > 0)
    {
        <div class="qdrat-card">
            <div class="qdrat-card-header">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle ms-1" style="color:#b91c1c"></i> مؤشرات ناقصة العدد</h5>
            </div>
            <div>
                @foreach (var ind in Model.IndicatorStatuses.Where(x => !x.IsComplete))
                {
                    string diffLabelInd = ind.DifficultyLevel switch
                    {
                        0 => "سهل",
                        1 => "متوسط",
                        2 => "صعب",
                        _ => "صعب جدًا"
                    };

                    <div class="rs-ind-row">
                        <div>
                            <span class="rs-badge @(ind.IsQuant ? "quant" : "verbal")">@(ind.IsQuant ? "كمي" : "لفظي")</span>
                            المؤشر: @ind.LessonTitle — الصعوبة: @diffLabelInd
                        </div>
                        <div class="rs-ind-count">@ind.ActualCount / @ind.RequestedCount</div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-warning btn-sm"
                                    onclick="regenerateIndicator(@Model.StageId, @ind.LessonId, @ind.DifficultyLevel)">
                                <i class="bi bi-arrow-clockwise ms-1"></i> إعادة توليد
                            </button>
                            <a class="btn btn-outline-success btn-sm"
                               href="@Url.Action("AddQuestionPage", "MinistrySimExam", new { area = "Admin", stageId = Model.StageId, lessonId = ind.LessonId, difficulty = ind.DifficultyLevel })">
                                <i class="bi bi-plus-circle ms-1"></i> إضافة يدوية
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="qdrat-card">
        <div class="qdrat-card-header">
            <h5 class="mb-0"><i class="bi bi-list-ol ms-1"></i> أسئلة القسم (<span id="rsVisibleCount">@Model.Questions.Count</span>)</h5>
            <div class="rs-toolbar">
                <button type="button" class="rs-chip active" data-filter="all">الكل</button>
                <button type="button" class="rs-chip" data-filter="quant">كمي</button>
                <button type="button" class="rs-chip" data-filter="verbal">لفظي</button>
                <button type="button" class="rs-chip" data-filter="manual">استبدال يدوي</button>
                <input type="search" id="rsSearch" class="form-control form-control-sm rs-search"
                       placeholder="ابحث في السؤال أو المؤشر أو اللمحة..." aria-label="بحث في الأسئلة" />
            </div>
        </div>

        <div id="rsList">
            @if (!Model.Questions.Any())
            {
                <div class="rs-empty">
                    <i class="bi bi-inbox" style="font-size:28px"></i>
                    <p class="mb-0 mt-2">لا توجد أسئلة مبنية لهذا القسم بعد.</p>
                </div>
            }
            else
            {
                @foreach (var q in Model.Questions)
                {
                    string diffLabel = q.DifficultyLevel switch
                    {
                        0 => "سهل",
                        1 => "متوسط",
                        2 => "صعب",
                        _ => "صعب جدًا"
                    };

                    var plainTitle = Regex.Replace(q.Title ?? "", "<[^>]*>", " ");
                    var searchText = (plainTitle + " " + q.LessonTitle + " " + q.InternalNote).ToLowerInvariant();

                    <div class="rs-q"
                         data-quant="@(q.IsQuant ? "1" : "0")"
                         data-manual="@(q.IsManuallySelected ? "1" : "0")"
                         data-search="@searchText">
                        <div class="rs-q-order">@q.StageOrder</div>
                        <div class="rs-q-body">
                            <div class="rs-q-title">@Html.Raw(NumberHelper.ToIndicNumbersSafe(q.Title))</div>
                            <div class="rs-q-meta">
                                <span class="rs-badge @(q.IsQuant ? "quant" : "verbal")">@(q.IsQuant ? "كمي" : "لفظي")</span>
                                <span class="rs-badge plain"><i class="bi bi-bullseye ms-1"></i>@q.LessonTitle</span>
                                <span class="rs-badge diff-@(q.DifficultyLevel > 3 ? 3 : q.DifficultyLevel)">@diffLabel</span>
                                <span class="rs-badge plain">الترتيب العام #@q.GlobalOrder</span>
                                @if (q.IsManuallySelected)
                                {
                                    <span class="rs-badge manual"><i class="bi bi-hand-index-thumb ms-1"></i> استبدال يدوي</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(q.InternalNote))
                            {
                                <div class="rs-q-note"><i class="bi bi-lightbulb ms-1"></i> @q.InternalNote</div>
                            }
                        </div>
                        <div class="rs-q-actions">
                            <button type="button" class="btn btn-primary btn-sm" onclick="msePreviewQuestion('@q.QuestionId')">
                                <i class="bi bi-eye ms-1"></i> معاينة
                            </button>
                            @if (q.AlternativesAvailable > 0)
                            {
                                <a class="btn btn-outline-primary btn-sm"
                                   title="بدائل من نفس المؤشر ونفس الصعوبة فقط"
                                   href="@Url.Action("ReplaceQuestionPage", "MinistrySimExam", new { area = "Admin", stageQuestionId = q.StageQuestionId })">
                                    <i class="bi bi-arrow-repeat ms-1"></i> استبدال (@q.AlternativesAvailable)
                                </a>
                            }
                            else
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm" disabled
                                        title="لا توجد بدائل متاحة من نفس المؤشر ونفس الصعوبة">
                                    <i class="bi bi-arrow-repeat ms-1"></i> لا بدائل
                                </button>
                            }
                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="excludeQuestion(@q.StageQuestionId)">
                                <i class="bi bi-x-circle ms-1"></i> استبعاد
                            </button>
                        </div>
                    </div>
                }

                <div class="rs-empty" id="rsNoResults" style="display:none">
                    <i class="bi bi-search" style="font-size:28px"></i>
                    <p class="mb-0 mt-2">لا توجد أسئلة مطابقة للبحث.</p>
                </div>
            }
        </div>
    </div>
</div>

@await Html.PartialAsync("_QuestionPreviewModalPartial")

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    (function () {
        var activeFilter = 'all';
        var rows = Array.prototype.slice.call(document.querySelectorAll('#rsList .rs-q'));
        var searchInput = document.getElementById('rsSearch');

        function applyFilters() {
            var term = (searchInput.value || '').trim().toLowerCase();
            var visible = 0;

            rows.forEach(function (row) {
                var ok = true;
                if (activeFilter === 'quant') ok = row.dataset.quant === '1';
                else if (activeFilter === 'verbal') ok = row.dataset.quant === '0';
                else if (activeFilter === 'manual') ok = row.dataset.manual === '1';

                if (ok && term) ok = (row.dataset.search || '').indexOf(term) !== -1;

                row.classList.toggle('is-hidden', !ok);
                if (ok) visible++;
            });

            document.getElementById('rsVisibleCount').textContent = visible;
            var noResults = document.getElementById('rsNoResults');
            if (noResults) noResults.style.display = (rows.length > 0 && visible === 0) ? '' : 'none';
        }

        document.querySelectorAll('.rs-chip').forEach(function (chip) {
            chip.addEventListener('click', function () {
                document.querySelectorAll('.rs-chip').forEach(function (c) { c.classList.remove('active'); });
                chip.classList.add('active');
                activeFilter = chip.dataset.filter;
                applyFilters();
            });
        });

        searchInput.addEventListener('input', applyFilters);
    })();

    function getAntiForgeryToken() {
        return document.querySelector('#antiForm input[name="__RequestVerificationToken"]').value;
    }

    function excludeQuestion(stageQuestionId) {
        Swal.fire({
            title: "تأكيد الاستبعاد؟",
            text: "سيتم حذف هذا السؤال من القسم، ولن يُسحَب بديل تلقائيًا — يترك المؤشر ناقصًا حتى تعيد التوليد أو تضيف سؤالاً يدويًا.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "نعم، استبعد",
            cancelButtonText: "إلغاء"
        }).then(function (result) {
            if (!result.isConfirmed) return;

            var formData = new FormData();
            formData.append("stageQuestionId", stageQuestionId);

            fetch('@Url.Action("ExcludeQuestion", "MinistrySimExam", new { area = "Admin" })', {
                method: "POST",
                headers: { "RequestVerificationToken": getAntiForgeryToken() },
                body: formData
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.success) {
                    window.location.reload();
                } else {
                    Swal.fire("خطأ", data.message || "تعذّر الاستبعاد.", "error");
                }
            })
            .catch(function () {
                Swal.fire("خطأ", "تعذّر الاتصال بالخادم — حاول مرة أخرى.", "error");
            });
        });
    }

    function regenerateIndicator(stageId, lessonId, difficulty) {
        Swal.fire({
            title: "إعادة توليد أسئلة هذا المؤشر؟",
            text: "سيتم استبدال كل أسئلة هذا المؤشر/الصعوبة باختيار عشوائي جديد بنفس العدد المطلوب.",
            icon: "question",
            showCancelButton: true,
            confirmButtonText: "نعم، أعد التوليد",
            cancelButtonText: "إلغاء"
        }).then(function (result) {
            if (!result.isConfirmed) return;

            var formData = new FormData();
            formData.append("stageId", stageId);
            formData.append("lessonId", lessonId);
            formData.append("difficulty", difficulty);

            fetch('@Url.Action("RegenerateIndicator", "MinistrySimExam", new { area = "Admin" })', {
                method: "POST",
                headers: { "RequestVerificationToken": getAntiForgeryToken() },
                body: formData
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.success) {
                    Swal.fire({ icon: "success", title: "تم التوليد بالكامل", timer: 1500, showConfirmButton: false })
                        .then(function () { window.location.reload(); });
                } else {
                    var msg = (data.messages && data.messages.length) ? data.messages.join('\n') : (data.message || "لم يكتمل العدد المطلوب.");
                    Swal.fire("تنبيه", msg, "warning").then(function () { window.location.reload(); });
                }
            })
            .catch(function () {
                Swal.fire("خطأ", "تعذّر الاتصال بالخادم — حاول مرة أخرى.", "error");
            });
        });
    }
</script>
}
