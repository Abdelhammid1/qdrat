@model QdratNew.ViewModels.Exam.MinistrySimExamCreateVm
@{
    ViewData["Title"] = "بناء اختبار معمل القياس";
}

<style>
    .qdrat-page {
        direction: rtl;
        text-align: right;
    }

    .qdrat-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 48%, #2563eb 100%);
        border-radius: 24px;
        padding: 28px;
        color: #fff;
        position: relative;
        overflow: hidden;
        box-shadow: 0 18px 45px rgba(15, 23, 42, .18);
        margin-bottom: 24px;
    }

        .qdrat-hero::before {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: rgba(255,255,255,.11);
            left: -70px;
            top: -80px;
        }

        .qdrat-hero::after {
            content: "";
            position: absolute;
            width: 160px;
            height: 160px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            right: 40px;
            bottom: -90px;
        }

    .qdrat-hero-content {
        position: relative;
        z-index: 2;
    }

    .qdrat-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.24);
        border-radius: 999px;
        padding: 7px 14px;
        font-size: 13px;
        margin-bottom: 14px;
    }

    .qdrat-hero h2 {
        font-weight: 900;
        margin-bottom: 8px;
        letter-spacing: -.3px;
    }

    .qdrat-hero p {
        margin: 0;
        opacity: .88;
        max-width: 760px;
        line-height: 1.9;
    }

    .qdrat-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 22px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, .06);
        overflow: hidden;
        height: 100%;
    }

    .qdrat-card-header {
        padding: 17px 20px;
        background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .qdrat-card-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 900;
        color: #0f172a;
        margin: 0;
    }

    .qdrat-icon {
        width: 38px;
        height: 38px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        color: #2563eb;
        flex: 0 0 auto;
    }

    .qdrat-stage-number {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #2563eb;
        color: #fff;
        font-weight: 900;
        flex: 0 0 auto;
    }

    .qdrat-card-body {
        padding: 20px;
    }

    .qdrat-muted {
        color: #64748b;
        font-size: 13px;
        line-height: 1.8;
    }

    .qdrat-page .form-label {
        font-weight: 800;
        color: #334155;
        margin-bottom: 8px;
    }

    .qdrat-page .form-control,
    .qdrat-page .form-select {
        border-radius: 14px;
        border-color: #dbe3ef;
        min-height: 46px;
        box-shadow: none;
    }

        .qdrat-page .form-control:focus,
        .qdrat-page .form-select:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .12);
        }

    .qdrat-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 18px 0 4px;
        flex-wrap: wrap;
    }

    .qdrat-btn-primary {
        border: none;
        border-radius: 16px;
        padding: 12px 24px;
        font-weight: 900;
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        color: #fff;
        box-shadow: 0 12px 24px rgba(37,99,235,.22);
    }

        .qdrat-btn-primary:disabled {
            opacity: .55;
            box-shadow: none;
            cursor: not-allowed;
        }

    .qdrat-back-link {
        border-radius: 16px;
        padding: 12px 20px;
        font-weight: 800;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        color: #334155;
        text-decoration: none;
    }

    .qdrat-alert {
        border: 0;
        border-radius: 18px;
        box-shadow: 0 10px 25px rgba(15, 23, 42, .08);
        padding: 14px 18px;
    }

    .qdrat-shortfalls {
        background: #fff6ea;
        border: 1px solid #e0a63b;
        color: #7a5615;
        border-radius: 16px;
        padding: 14px 18px;
        margin-top: 14px;
        font-size: 13.5px;
        line-height: 1.9;
        width: 100%;
    }

    .qdrat-shortfalls ul {
        margin: 6px 0 0;
        padding-inline-start: 20px;
    }

    /* Sprint 3 (MSE-B): قائمة المؤشرات + التحقق الحي */
    .qdrat-indicators-block {
        margin-top: 14px;
        border-top: 1px dashed #e5e7eb;
        padding-top: 14px;
    }

    .qdrat-indicators-loading,
    .qdrat-indicators-error,
    .qdrat-indicators-empty {
        font-size: 13px;
        color: #64748b;
        padding: 10px 4px;
    }

    .qdrat-indicators-error {
        color: #b91c1c;
    }

    .qdrat-indicators-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12.5px;
    }

        .qdrat-indicators-table th,
        .qdrat-indicators-table td {
            padding: 6px 8px;
            text-align: center;
            border-bottom: 1px solid #eef2f7;
            vertical-align: middle;
        }

        .qdrat-indicators-table .qdrat-indicator-title {
            text-align: right;
            font-weight: 700;
            color: #334155;
        }

        .qdrat-indicators-table th {
            color: #64748b;
            font-weight: 800;
        }

        .qdrat-indicators-table .indicator-count-input {
            width: 60px;
            display: inline-block;
            min-height: 32px;
            text-align: center;
            padding: 2px 4px;
        }

        .qdrat-indicators-table .indicator-count-input:disabled {
            background: #f1f5f9;
        }

    .qdrat-indicator-available {
        display: block;
        font-size: 10.5px;
        color: #94a3b8;
        margin-top: 2px;
    }

    .qdrat-axis-summary {
        margin-top: 8px;
        font-size: 12.5px;
        font-weight: 800;
        padding: 6px 10px;
        border-radius: 10px;
        display: inline-flex;
        gap: 6px;
        align-items: center;
    }

        .qdrat-axis-summary.ok {
            background: #ecfdf5;
            color: #047857;
        }

        .qdrat-axis-summary.bad {
            background: #fef2f2;
            color: #b91c1c;
        }

    @@media (max-width: 768px) {
        .qdrat-hero {
            padding: 22px;
            border-radius: 20px;
        }

        .qdrat-card-body {
            padding: 16px;
        }

        .qdrat-actions {
            align-items: stretch;
        }

            .qdrat-actions .btn,
            .qdrat-actions a {
                width: 100%;
                text-align: center;
            }
    }
</style>

<div class="container-fluid py-4 qdrat-page">
    <div class="qdrat-hero">
        <div class="qdrat-hero-content">
            <div class="qdrat-hero-badge">
                <i class="bi bi-mortarboard"></i>
                اختبار معمل القياس
            </div>
            <h2><i class="bi bi-diagram-3 ms-2"></i> بناء اختبار معمل القياس — @Model.CourseName</h2>
            <p>
                5 مراحل ثابتة ومتتالية، كل مرحلة = محور كمي + محور لفظي. حدّد المحور وعدد الأسئلة ومدة كل مرحلة، ثم أكمل اختيار المؤشرات في الخطوة التالية.
            </p>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        var errorLines = TempData["Error"].ToString().Split('\n', StringSplitOptions.RemoveEmptyEntries);
        <div class="alert alert-danger qdrat-alert">
            <i class="bi bi-exclamation-circle ms-1"></i>
            @if (errorLines.Length > 1)
            {
                <strong class="d-block mb-1">تحقق من البيانات التالية:</strong>
                <ul class="mb-0 ps-3">
                    @foreach (var line in errorLines)
                    {
                        <li>@line</li>
                    }
                </ul>
            }
            else
            {
                @errorLines[0]
            }
        </div>
    }

    @if (!Model.QuantSections.Any() || !Model.VerbalSections.Any())
    {
        <div class="alert alert-warning qdrat-alert">
            <i class="bi bi-exclamation-triangle ms-1"></i>
            هذه الدورة لا تحتوي على محاور كافية (كمي/لفظي) بعد. أضف المحاور والمناهج المرتبطة بالدورة قبل بناء اختبار المحاكاة.
        </div>
    }

    <form id="ministrySimExamCreateForm" asp-action="Create" method="post" class="needs-validation" novalidate>
        <input type="hidden" asp-for="CourseId" />
        <input type="hidden" asp-for="CourseName" />

        <div class="row g-4">
            <div class="col-12">
                <div class="qdrat-card">
                    <div class="qdrat-card-header">
                        <h5 class="qdrat-card-title">
                            <span class="qdrat-icon"><i class="bi bi-pencil-square"></i></span>
                            البيانات الأساسية
                        </h5>
                    </div>
                    <div class="qdrat-card-body">
                        <label asp-for="Title" class="form-label">عنوان الاختبار</label>
                        <input asp-for="Title" class="form-control" placeholder="اكتب عنوان الاختبار هنا" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            @for (int i = 0; i < Model.Stages.Count; i++)
            {
                var stage = Model.Stages[i];
                <div class="col-12">
                    <div class="qdrat-card">
                        <div class="qdrat-card-header">
                            <h5 class="qdrat-card-title">
                                <span class="qdrat-stage-number">@stage.StageNumber</span>
                                المرحلة @stage.StageNumber
                            </h5>
                            <span class="qdrat-muted">افتراضي: 11 كمي + 13 لفظي = 24 سؤال / 26 دقيقة</span>
                        </div>
                        <div class="qdrat-card-body">
                            <input type="hidden" asp-for="Stages[i].StageNumber" />
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label asp-for="Stages[i].QuantSectionId" class="form-label">
                                        <i class="bi bi-calculator ms-1 text-primary"></i> @Html.DisplayNameFor(m => m.Stages[i].QuantSectionId)
                                    </label>
                                    <select asp-for="Stages[i].QuantSectionId" asp-items="Model.QuantSections" class="form-select stage-section-select"
                                            data-stage-index="@i" data-axis="quant">
                                        <option value="">-- اختر المحور الكمي --</option>
                                    </select>
                                    <span asp-validation-for="Stages[i].QuantSectionId" class="text-danger small"></span>

                                    <div class="qdrat-indicators-block" id="quant-indicators-block-@i" data-stage-index="@i" data-axis="quant" hidden>
                                        <div class="qdrat-indicators-content" id="quant-indicators-content-@i"></div>
                                        <div class="qdrat-axis-summary" id="quant-axis-summary-@i"></div>
                                    </div>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label asp-for="Stages[i].VerbalSectionId" class="form-label">
                                        <i class="bi bi-book ms-1 text-primary"></i> @Html.DisplayNameFor(m => m.Stages[i].VerbalSectionId)
                                    </label>
                                    <select asp-for="Stages[i].VerbalSectionId" asp-items="Model.VerbalSections" class="form-select stage-section-select"
                                            data-stage-index="@i" data-axis="verbal">
                                        <option value="">-- اختر المحور اللفظي --</option>
                                    </select>
                                    <span asp-validation-for="Stages[i].VerbalSectionId" class="text-danger small"></span>

                                    <div class="qdrat-indicators-block" id="verbal-indicators-block-@i" data-stage-index="@i" data-axis="verbal" hidden>
                                        <div class="qdrat-indicators-content" id="verbal-indicators-content-@i"></div>
                                        <div class="qdrat-axis-summary" id="verbal-axis-summary-@i"></div>
                                    </div>
                                </div>

                                <div class="col-12 col-md-4">
                                    <label asp-for="Stages[i].QuantQuestionCount" class="form-label">@Html.DisplayNameFor(m => m.Stages[i].QuantQuestionCount)</label>
                                    <input asp-for="Stages[i].QuantQuestionCount" type="text" inputmode="numeric" pattern="[0-9]*" class="form-control stage-target-input"
                                           data-stage-index="@i" data-axis="quant" />
                                    <span asp-validation-for="Stages[i].QuantQuestionCount" class="text-danger small"></span>
                                </div>

                                <div class="col-12 col-md-4">
                                    <label asp-for="Stages[i].VerbalQuestionCount" class="form-label">@Html.DisplayNameFor(m => m.Stages[i].VerbalQuestionCount)</label>
                                    <input asp-for="Stages[i].VerbalQuestionCount" type="text" inputmode="numeric" pattern="[0-9]*" class="form-control stage-target-input"
                                           data-stage-index="@i" data-axis="verbal" />
                                    <span asp-validation-for="Stages[i].VerbalQuestionCount" class="text-danger small"></span>
                                </div>

                                <div class="col-12 col-md-4">
                                    <label asp-for="Stages[i].DurationMinutes" class="form-label">@Html.DisplayNameFor(m => m.Stages[i].DurationMinutes)</label>
                                    <input asp-for="Stages[i].DurationMinutes" type="text" inputmode="numeric" pattern="[0-9]*" class="form-control" />
                                    <span asp-validation-for="Stages[i].DurationMinutes" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="col-12">
                <div class="qdrat-actions">
                    <a asp-area="Admin" asp-controller="Courses" asp-action="Index" class="qdrat-back-link">
                        <i class="bi bi-arrow-right ms-1"></i>
                        رجوع
                    </a>
                    <button type="submit" id="continueBtn" class="btn qdrat-btn-primary" disabled title="أكمل اختيار المؤشرات بالعدد المطلوب بالضبط في كل مرحلة أولاً">
                        <i class="bi bi-save ms-1"></i>
                        حفظ الاختبار كمسودة
                    </button>
                </div>
                <div id="validationBlockers" class="qdrat-shortfalls" style="display:none;">
                    <strong><i class="bi bi-exclamation-triangle ms-1"></i> السبب في تعطيل زر الحفظ حاليًا:</strong>
                    <ul id="validationBlockersList" class="mb-0"></ul>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Sprint 3 (MSE-B — B3/B4): جلب مؤشرات المحور عبر AJAX + تحقق حي لعدم تجاوز/نقص عدد الأسئلة المطلوب لكل مرحلة
        (function () {
            'use strict';

            var getIndicatorsUrl = '@Url.Action("GetIndicatorsForSection", "MinistrySimExam", new { area = "Admin" })';
            var continueBtn = document.getElementById('continueBtn');

            function axisState(stageIndex, axis) {
                var block = document.getElementById(axis + '-indicators-block-' + stageIndex);
                var content = document.getElementById(axis + '-indicators-content-' + stageIndex);
                var summary = document.getElementById(axis + '-axis-summary-' + stageIndex);
                var sectionSelect = document.querySelector('.stage-section-select[data-stage-index="' + stageIndex + '"][data-axis="' + axis + '"]');
                var targetInput = document.querySelector('.stage-target-input[data-stage-index="' + stageIndex + '"][data-axis="' + axis + '"]');
                return { block: block, content: content, summary: summary, sectionSelect: sectionSelect, targetInput: targetInput };
            }

            function renderLoading(state) {
                state.content.innerHTML = '<div class="qdrat-indicators-loading"><i class="bi bi-arrow-repeat ms-1"></i> جاري تحميل المؤشرات...</div>';
                state.summary.textContent = '';
                state.summary.className = 'qdrat-axis-summary';
            }

            function renderError(state) {
                state.content.innerHTML = '<div class="qdrat-indicators-error"><i class="bi bi-exclamation-circle ms-1"></i> تعذّر تحميل مؤشرات هذا المحور. حاول اختيار المحور مرة أخرى.</div>';
                state.summary.textContent = '';
                state.summary.className = 'qdrat-axis-summary';
            }

            function loadIndicators(stageIndex, axis) {
                var state = axisState(stageIndex, axis);
                if (!state.sectionSelect || !state.sectionSelect.value) {
                    state.block.hidden = true;
                    state.content.innerHTML = '';
                    updateValidation();
                    return;
                }

                state.block.hidden = false;
                renderLoading(state);

                fetch(getIndicatorsUrl + '?sectionId=' + encodeURIComponent(state.sectionSelect.value), {
                    method: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                    .then(function (response) {
                        if (!response.ok) throw new Error('bad-response');
                        return response.text();
                    })
                    .then(function (html) {
                        state.content.innerHTML = html;
                        bindIndicatorInputs(stageIndex, axis);
                        updateValidation();
                    })
                    .catch(function () {
                        renderError(state);
                        updateValidation();
                    });
            }

            function bindIndicatorInputs(stageIndex, axis) {
                var state = axisState(stageIndex, axis);
                var inputs = state.content.querySelectorAll('.indicator-count-input');
                inputs.forEach(function (input) {
                    input.addEventListener('input', function () { updateAxisSummary(stageIndex, axis); });
                });
            }

            function updateAxisSummary(stageIndex, axis) {
                var state = axisState(stageIndex, axis);
                if (!state.targetInput || state.block.hidden) return;

                var inputs = state.content.querySelectorAll('.indicator-count-input');
                var selected = 0;
                inputs.forEach(function (input) {
                    var val = parseInt(input.value, 10);
                    if (!isNaN(val) && val > 0) selected += val;
                });

                var target = parseInt(state.targetInput.value, 10) || 0;
                var ok = inputs.length > 0 && selected === target;

                state.summary.textContent = 'المختار: ' + selected + ' / المطلوب: ' + target + (ok ? ' — مكتمل' : ' — غير مطابق');
                state.summary.className = 'qdrat-axis-summary ' + (ok ? 'ok' : 'bad');

                updateValidation();
            }

            // يبني قائمة أسباب واضحة تُعرض تحت زر الحفظ بدل ترك الزر معطلاً بلا أي تفسير — يشمل حالة "لا يمكن
            // الوصول للعدد المطلوب أصلاً" (نقص فعلي في بنك الأسئلة) بدل التعطيل الصامت.
            function updateValidation() {
                var axisBlocks = document.querySelectorAll('.qdrat-indicators-block');
                var allOk = axisBlocks.length > 0;
                var blockers = [];
                var axisLabel = { quant: 'الكمي', verbal: 'اللفظي' };

                axisBlocks.forEach(function (block) {
                    var stageIndex = block.getAttribute('data-stage-index');
                    var axis = block.getAttribute('data-axis');
                    var state = axisState(stageIndex, axis);
                    var stageLabel = 'المرحلة ' + (parseInt(stageIndex, 10) + 1) + ' — المحور ' + axisLabel[axis];

                    if (!state.sectionSelect || !state.sectionSelect.value) {
                        allOk = false;
                        blockers.push(stageLabel + ': لم يتم اختيار المحور بعد.');
                        return;
                    }

                    var inputs = state.content.querySelectorAll('.indicator-count-input');
                    var selected = 0;
                    var maxAvailable = 0;
                    inputs.forEach(function (input) {
                        var val = parseInt(input.value, 10);
                        if (!isNaN(val) && val > 0) selected += val;
                        maxAvailable += parseInt(input.getAttribute('data-available'), 10) || 0;
                    });
                    var target = parseInt(state.targetInput.value, 10) || 0;

                    if (inputs.length === 0) {
                        allOk = false;
                        blockers.push(stageLabel + ': لا توجد مؤشرات (دروس) متاحة لهذا المحور بعد.');
                    } else if (selected !== target) {
                        allOk = false;
                        if (maxAvailable < target) {
                            blockers.push(stageLabel + ': العدد المطلوب (' + target + ') أكبر من إجمالي الأسئلة المتاحة فعليًا لكل مؤشرات هذا المحور (' + maxAvailable + ' سؤال بحد أقصى) — قلّل عدد الأسئلة المطلوب لهذا المحور أو أضف أسئلة جديدة له.');
                        } else {
                            blockers.push(stageLabel + ': المختار حاليًا ' + selected + ' من أصل ' + target + ' مطلوب — وزّع الفرق على المؤشرات حتى يتطابق العدد بالضبط.');
                        }
                    }
                });

                if (continueBtn) continueBtn.disabled = !allOk;

                var blockersBox = document.getElementById('validationBlockers');
                var blockersList = document.getElementById('validationBlockersList');
                if (blockersBox && blockersList) {
                    if (blockers.length > 0) {
                        blockersList.innerHTML = blockers.map(function (b) { return '<li>' + b + '</li>'; }).join('');
                        blockersBox.style.display = '';
                    } else {
                        blockersBox.style.display = 'none';
                        blockersList.innerHTML = '';
                    }
                }
            }

            document.querySelectorAll('.stage-section-select').forEach(function (select) {
                select.addEventListener('change', function () {
                    loadIndicators(select.dataset.stageIndex, select.dataset.axis);
                });
            });

            document.querySelectorAll('.stage-target-input').forEach(function (input) {
                input.addEventListener('input', function () {
                    updateAxisSummary(input.dataset.stageIndex, input.dataset.axis);
                });
            });

            // Sprint 5 (MSE-C / C4): قبل إرسال النموذج، حوّل قيم منتقي المؤشرات (المُحمَّلة عبر AJAX)
            // إلى حقول Hidden مطابقة لتسمية ViewModel (Stages[i].QuantIndicators[k]/VerbalIndicators[k])
            // ليتم حفظها فعليًا كمسودة عبر Action Create [HttpPost].
            function appendHidden(form, name, value) {
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = name;
                input.value = value;
                input.className = 'injected-indicator-input';
                form.appendChild(input);
            }

            var mainForm = document.getElementById('ministrySimExamCreateForm');
            mainForm.addEventListener('submit', function () {
                mainForm.querySelectorAll('.injected-indicator-input').forEach(function (el) { el.remove(); });

                document.querySelectorAll('.qdrat-indicators-block').forEach(function (block) {
                    var stageIndex = block.getAttribute('data-stage-index');
                    var axis = block.getAttribute('data-axis');
                    var arrayName = axis === 'quant' ? 'QuantIndicators' : 'VerbalIndicators';
                    var content = block.querySelector('.qdrat-indicators-content');
                    if (!content) return;

                    var idx = 0;
                    content.querySelectorAll('.indicator-count-input').forEach(function (input) {
                        var val = parseInt(input.value, 10);
                        if (!val || val <= 0) return;

                        appendHidden(mainForm, 'Stages[' + stageIndex + '].' + arrayName + '[' + idx + '].LessonId', input.dataset.lessonId);
                        appendHidden(mainForm, 'Stages[' + stageIndex + '].' + arrayName + '[' + idx + '].Difficulty', input.dataset.difficulty);
                        appendHidden(mainForm, 'Stages[' + stageIndex + '].' + arrayName + '[' + idx + '].RequestedCount', val);
                        idx++;
                    });
                });
            });

            updateValidation();
        })();
    </script>
}
