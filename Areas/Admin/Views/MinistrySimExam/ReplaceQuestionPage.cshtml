@model QdratNew.ViewModels.Exam.MinistrySimExamReplaceQuestionVm
@using QdratNew.Helpers
@{
    ViewData["Title"] = "استبدال سؤال";
}

<link href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<style>
    .qdrat-page { direction: rtl; text-align: right; }

    .qdrat-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 48%, #2563eb 100%);
        border-radius: 24px; padding: 28px; color: #fff; margin-bottom: 24px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, .18);
    }

    .qdrat-card {
        background: #fff; border: 1px solid #e5e7eb; border-radius: 22px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, .06); padding: 20px; margin-bottom: 18px;
    }

    .qdrat-empty { padding: 40px 20px; text-align: center; color: #64748b; }

    .alt-note {
        display: inline-block; background: #fffbeb; border: 1px dashed #fcd34d; color: #92400e;
        border-radius: 10px; padding: 3px 10px; font-size: 12.5px; font-weight: 700;
    }
</style>

<div class="container-fluid py-4 qdrat-page">
    <div class="qdrat-hero">
        <h3 class="mb-1"><i class="bi bi-arrow-repeat ms-2"></i> استبدال سؤال</h3>
        <p class="mb-0" style="opacity:.9">المؤشر: @Model.LessonTitle — المحور: @Model.SectionTitle — الترتيب داخل القسم: #@Model.StageOrder</p>
    </div>

    <div class="alert alert-info d-flex justify-content-between align-items-start gap-3 flex-wrap">
        <div>
            <strong>السؤال الحالي:</strong> @Html.Raw(NumberHelper.ToIndicNumbersSafe(Model.OldTitle))
            <div class="small mt-2">البدائل المعروضة من نفس المؤشر (<strong>@Model.LessonTitle</strong>) ونفس مستوى الصعوبة فقط.</div>
        </div>
        <button type="button" class="btn btn-outline-primary btn-sm flex-shrink-0" onclick="msePreviewQuestion('@Model.OldQuestionId')">
            <i class="bi bi-eye ms-1"></i> معاينة الحالي
        </button>
    </div>

    <form id="antiForm">@Html.AntiForgeryToken()</form>

    <div class="qdrat-card">
        @if (!Model.Alternatives.Any())
        {
            <div class="qdrat-empty">
                <i class="bi bi-inbox" style="font-size:28px"></i>
                <p class="mb-0 mt-2">لا توجد بدائل متاحة من نفس المؤشر ونفس مستوى الصعوبة حاليًا.</p>
            </div>
        }
        else
        {
            <table id="altTable" class="table table-striped table-bordered text-center">
                <thead>
                    <tr>
                        <th>نص السؤال</th>
                        <th>صح</th>
                        <th>اللمحة</th>
                        <th>إجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in Model.Alternatives)
                    {
                        <tr>
                            <td class="text-start">@Html.Raw(NumberHelper.ToIndicNumbersSafe(q.Title))</td>
                            <td>@Html.Raw(NumberHelper.ToIndicNumbersSafe(q.CorrectAnswer))</td>
                            @* data-search يحمل النص الكامل اللمحة ليكون البحث فعالًا حتى لو كان المعروض مختصرًا *@
                            <td data-search="@q.InternalNote">
                                @if (string.IsNullOrWhiteSpace(q.InternalNote))
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    <span class="alt-note" title="@q.InternalNote">@(q.InternalNote.Length > 36 ? q.InternalNote.Substring(0, 36) + "..." : q.InternalNote)</span>
                                }
                            </td>
                            <td class="text-nowrap">
                                <button type="button" class="btn btn-primary btn-sm" onclick="msePreviewQuestion('@q.QuestionId')">
                                    <i class="bi bi-eye"></i> معاينة
                                </button>
                                <button type="button" class="btn btn-outline-primary btn-sm"
                                        onclick="confirmReplace('@Model.StageQuestionId', '@q.QuestionId')">
                                    <i class="bi bi-arrow-repeat"></i> استبدال
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@await Html.PartialAsync("_QuestionPreviewModalPartial")

@section Scripts {
<script src="https://code.jquery.com/jquery-3.7.0.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    @if (Model.Alternatives.Any())
    {
        <text>
        new DataTable('#altTable', {
            language: { url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/ar.json' }
        });
        </text>
    }

    function confirmReplace(stageQuestionId, newQuestionId) {
        Swal.fire({
            title: "تأكيد الاستبدال؟",
            text: "سيتم استبدال السؤال بالسؤال الجديد.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "نعم",
            cancelButtonText: "إلغاء"
        }).then(function (result) {
            if (!result.isConfirmed) return;

            var token = document.querySelector('#antiForm input[name="__RequestVerificationToken"]').value;
            var formData = new FormData();
            formData.append("stageQuestionId", stageQuestionId);
            formData.append("newQuestionId", newQuestionId);

            fetch('@Url.Action("ReplaceQuestionConfirm", "MinistrySimExam", new { area = "Admin" })', {
                method: "POST",
                headers: { "RequestVerificationToken": token },
                body: formData
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.success) {
                    Swal.fire({
                        icon: "success",
                        title: "تم الاستبدال بنجاح",
                        timer: 1500,
                        showConfirmButton: false
                    }).then(function () {
                        window.location.href = '@Url.Action("ReviewStage", "MinistrySimExam", new { area = "Admin", stageId = Model.StageId })';
                    });
                } else {
                    Swal.fire("خطأ", data.message || "تعذّر الاستبدال.", "error");
                }
            })
            .catch(function () {
                Swal.fire("خطأ", "تعذّر الاتصال بالخادم — حاول مرة أخرى.", "error");
            });
        });
    }
</script>
}
