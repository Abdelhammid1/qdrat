@* Modal معاينة السؤال — يعيد استخدام نفس بارشال معاينة بنك الأسئلة عبر MinistrySimExam/PreviewQuestion.
   الاستخدام: ضمّن البارشال ثم استدعِ msePreviewQuestion('<guid>') *@
<div class="modal fade" id="mseQuestionPreviewModal" tabindex="-1" aria-labelledby="mseQuestionPreviewTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content" style="border-radius:20px; overflow:hidden;">
            <div class="modal-header" style="background:linear-gradient(135deg,#0f172a,#1e3a8a); color:#fff;">
                <h5 class="modal-title" id="mseQuestionPreviewTitle"><i class="bi bi-eye ms-2"></i> معاينة السؤال</h5>
                <button type="button" class="btn-close btn-close-white ms-0" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body" id="mseQuestionPreviewBody" style="background:#f8fafc;"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
            </div>
        </div>
    </div>
</div>

<script>
    function msePreviewQuestion(questionId) {
        var body = document.getElementById('mseQuestionPreviewBody');
        body.innerHTML = '<div class="text-center text-muted py-5"><div class="spinner-border" role="status"></div><p class="mt-3 mb-0">جارٍ تحميل السؤال...</p></div>';

        bootstrap.Modal.getOrCreateInstance(document.getElementById('mseQuestionPreviewModal')).show();

        fetch('@Url.Action("PreviewQuestion", "MinistrySimExam", new { area = "Admin" })?questionId=' + encodeURIComponent(questionId))
            .then(function (r) {
                if (!r.ok) throw new Error('http ' + r.status);
                return r.text();
            })
            .then(function (html) { body.innerHTML = html; })
            .catch(function () {
                body.innerHTML = '<div class="alert alert-danger mb-0">تعذّر تحميل السؤال — حاول مرة أخرى.</div>';
            });
    }
</script>
