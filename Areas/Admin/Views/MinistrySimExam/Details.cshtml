@model QdratNew.ViewModels.Exam.MinistrySimExamDetailsVm
@{
    ViewData["Title"] = "حالة اختبار معمل القياس";
}

<style>
    .qdrat-page { direction: rtl; text-align: right; }

    .qdrat-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 48%, #2563eb 100%);
        border-radius: 24px; padding: 28px; color: #fff; margin-bottom: 24px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, .18);
    }

    .qdrat-status-badge {
        display: inline-flex; align-items: center; gap: 8px;
        border-radius: 999px; padding: 7px 14px; font-size: 13px; font-weight: 800;
    }

    .qdrat-status-badge.published { background: #ecfdf5; color: #047857; }
    .qdrat-status-badge.draft { background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.24); color: #fff; }

    .qdrat-card {
        background: #fff; border: 1px solid #e5e7eb; border-radius: 22px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, .06); overflow: hidden; margin-bottom: 18px;
    }

    .qdrat-card-header {
        padding: 17px 20px; background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 1px solid #e5e7eb; display: flex; align-items: center; justify-content: space-between; gap: 12px;
    }

    .qdrat-card-body { padding: 20px; }

    /* كروت الإحصائيات */
    .qdrat-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 14px; margin-bottom: 22px; }
    .qdrat-stat {
        background: #fff; border: 1px solid #e5e7eb; border-radius: 20px; padding: 16px 18px;
        display: flex; align-items: center; gap: 14px; box-shadow: 0 8px 22px rgba(15, 23, 42, .05);
    }
    .qdrat-stat-icon {
        width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center; font-size: 22px; flex-shrink: 0;
    }
    .qdrat-stat-icon.blue { background: #eff6ff; color: #1d4ed8; }
    .qdrat-stat-icon.green { background: #ecfdf5; color: #047857; }
    .qdrat-stat-icon.amber { background: #fff7ed; color: #b45309; }
    .qdrat-stat-icon.violet { background: #f5f3ff; color: #6d28d9; }
    .qdrat-stat-value { font-size: 24px; font-weight: 900; line-height: 1.1; color: #0f172a; }
    .qdrat-stat-label { font-size: 13px; color: #64748b; margin-top: 2px; }

    /* كروت المراحل */
    .qdrat-stage-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
    .qdrat-stage-card {
        background: #fff; border: 1px solid #e5e7eb; border-radius: 22px; padding: 18px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, .06); display: flex; flex-direction: column; gap: 14px;
        transition: box-shadow .2s ease, transform .2s ease;
    }
    .qdrat-stage-card:hover { box-shadow: 0 16px 36px rgba(15, 23, 42, .10); transform: translateY(-2px); }
    .qdrat-stage-card.complete { border-top: 4px solid #059669; }
    .qdrat-stage-card.incomplete { border-top: 4px solid #d97706; }
    .qdrat-stage-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .qdrat-stage-num {
        width: 42px; height: 42px; border-radius: 12px; background: #1e3a8a; color: #fff;
        display: grid; place-items: center; font-weight: 900; font-size: 18px; flex-shrink: 0;
    }
    .qdrat-stage-title { font-weight: 800; font-size: 16px; margin: 0; }
    .qdrat-stage-meta { font-size: 12.5px; color: #64748b; }
    .qdrat-chip { display: inline-flex; align-items: center; gap: 5px; border-radius: 999px; padding: 4px 10px; font-size: 12px; font-weight: 800; }
    .qdrat-chip.ok { background: #ecfdf5; color: #047857; }
    .qdrat-chip.bad { background: #fff7ed; color: #b45309; }
    .qdrat-section-box { border: 1px solid #e5e7eb; border-radius: 14px; padding: 10px 12px; background: #f8fafc; }
    .qdrat-section-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .qdrat-section-kind { font-size: 12px; font-weight: 800; color: #475569; }
    .qdrat-section-name { font-weight: 700; font-size: 14px; color: #0f172a; overflow-wrap: anywhere; }
    .qdrat-progress { height: 6px; border-radius: 999px; background: #e2e8f0; margin-top: 8px; overflow: hidden; }
    .qdrat-progress > span { display: block; height: 100%; background: #2563eb; border-radius: 999px; }
    .qdrat-progress.ok > span { background: #059669; }
    .qdrat-stage-actions { display: flex; gap: 8px; justify-content: flex-start; margin-top: auto; }
    .qdrat-icon-btn {
        width: 44px; height: 44px; border-radius: 12px; display: inline-grid; place-items: center; font-size: 19px;
        border: 1px solid #cbd5e1; background: #fff; color: #1d4ed8; text-decoration: none; transition: background .15s ease, color .15s ease;
    }
    .qdrat-icon-btn:hover, .qdrat-icon-btn:focus-visible { background: #1d4ed8; color: #fff; }

    .qdrat-axis-count { font-family: monospace; font-weight: 800; }
    .qdrat-axis-count.ok { color: #047857; }
    .qdrat-axis-count.bad { color: #b91c1c; }

    @@media (max-width: 575.98px) { .qdrat-hero { padding: 20px; } .qdrat-stage-grid { grid-template-columns: 1fr; } }
    @@media (prefers-reduced-motion: reduce) { .qdrat-stage-card { transition: none; } .qdrat-stage-card:hover { transform: none; } }

    .qdrat-shortfalls {
        background: #fff6ea; border: 1px solid #e0a63b; color: #7a5615;
        border-radius: 16px; padding: 14px 18px; margin-bottom: 18px; font-size: 13.5px; line-height: 1.9;
    }

    .qdrat-shortfalls ul { margin: 6px 0 0; padding-inline-start: 20px; }

    .qdrat-btn-primary {
        border: none; border-radius: 16px; padding: 12px 24px; font-weight: 900;
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: #fff;
        box-shadow: 0 12px 24px rgba(37,99,235,.22);
    }

    .qdrat-btn-primary:disabled { opacity: .55; box-shadow: none; cursor: not-allowed; }

    .qdrat-code-banner {
        background: linear-gradient(135deg, #065f46 0%, #059669 100%); color: #fff; border-radius: 18px;
        padding: 18px 22px; margin-bottom: 18px; display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap;
    }
    .qdrat-code-value { font-family: monospace; font-size: 28px; font-weight: 900; letter-spacing: 4px; }
</style>

<div class="container-fluid py-4 qdrat-page">
    <div class="qdrat-hero">
        <span class="qdrat-status-badge @(Model.IsPublished ? "published" : "draft")">
            <i class="fas @(Model.IsPublished ? "fa-circle-check" : "fa-pen-to-square")"></i>
            @(Model.IsPublished ? "منشور" : "مسودة")
        </span>
        <h2 class="mt-3 mb-1"><i class="fas fa-diagram-project ms-2"></i> @Model.Title</h2>
        <p class="mb-0" style="opacity:.9">الدورة: @Model.CourseName</p>
        @if (Model.IsPublished && Model.PublishedAt.HasValue)
        {
            <p class="mb-0" style="opacity:.8">تاريخ النشر: @Model.PublishedAt.Value.ToString("yyyy-MM-dd HH:mm")</p>
        }
    </div>

    @{
        var totalTarget = Model.Stages.Sum(x => x.QuantTarget + x.VerbalTarget);
        var totalActual = Model.Stages.Sum(x => x.QuantActual + x.VerbalActual);
        var completeStages = Model.Stages.Count(x => x.IsComplete);
        var totalMinutes = Model.Stages.Sum(x => x.DurationMinutes);
    }
    <div class="qdrat-stats">
        <div class="qdrat-stat">
            <div class="qdrat-stat-icon blue"><i class="fas fa-layer-group" aria-hidden="true"></i></div>
            <div><div class="qdrat-stat-value">@Model.Stages.Count</div><div class="qdrat-stat-label">عدد الأقسام</div></div>
        </div>
        <div class="qdrat-stat">
            <div class="qdrat-stat-icon green"><i class="fas fa-circle-check" aria-hidden="true"></i></div>
            <div><div class="qdrat-stat-value">@completeStages / @Model.Stages.Count</div><div class="qdrat-stat-label">أقسام مكتملة</div></div>
        </div>
        <div class="qdrat-stat">
            <div class="qdrat-stat-icon violet"><i class="fas fa-circle-question" aria-hidden="true"></i></div>
            <div><div class="qdrat-stat-value">@totalActual / @totalTarget</div><div class="qdrat-stat-label">الأسئلة المضافة / المطلوبة</div></div>
        </div>
        <div class="qdrat-stat">
            <div class="qdrat-stat-icon amber"><i class="fas fa-clock" aria-hidden="true"></i></div>
            <div><div class="qdrat-stat-value">@totalMinutes</div><div class="qdrat-stat-label">إجمالي الدقائق</div></div>
        </div>
        @if (Model.IsPublished)
        {
            <div class="qdrat-stat">
                <div class="qdrat-stat-icon blue"><i class="fas fa-users" aria-hidden="true"></i></div>
                <div><div class="qdrat-stat-value">@Model.AssignedStudentsCount</div><div class="qdrat-stat-label">طالب مُسنَد (@Model.AssignedBatchesCount دفعة)</div></div>
            </div>
        }
    </div>

    @if (TempData["PublishError"] != null)
    {
        <div class="alert alert-danger">@TempData["PublishError"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning">@TempData["Warning"]</div>
    }

    @* Sprint 17 (MSE-J / J2): الرمز المرجعي المولَّد بعد إسناد حضوري — يُعرض مرة واحدة هنا فور التحويل من شاشة الإسناد *@
    @if (TempData["GeneratedReferenceCode"] != null)
    {
        <div class="qdrat-code-banner">
            <div>
                <div class="fw-bold mb-1"><i class="fas fa-key ms-1"></i> الرمز المرجعي لهذه الجلسة الحضورية</div>
                <div class="small" style="opacity:.9">أعلِنه شفهيًا للطلاب الحاضرين في المعمل — رمز واحد لكل من أُسنِد لهم الاختبار في هذه العملية</div>
            </div>
            <span class="qdrat-code-value" id="generatedCode">@TempData["GeneratedReferenceCode"]</span>
            <button type="button" class="btn btn-sm btn-light" onclick="navigator.clipboard.writeText(document.getElementById('generatedCode').textContent.trim())">
                <i class="fas fa-clipboard ms-1"></i> نسخ
            </button>
        </div>
    }

    @if (!Model.IsReadyToPublish && Model.ShortfallMessages.Any())
    {
        <div class="qdrat-shortfalls" id="shortfallBox">
            <strong><i class="fas fa-triangle-exclamation ms-1"></i> لا يمكن نشر الاختبار حاليًا — النواقص التالية تمنع النشر:</strong>
            <ul>
                @foreach (var msg in Model.ShortfallMessages)
                {
                    <li>@msg</li>
                }
            </ul>
        </div>
    }

    <h5 class="mb-3"><i class="fas fa-list-check ms-1"></i> الأقسام</h5>
    @if (!Model.Stages.Any())
    {
        <div class="alert alert-light border">لا توجد أقسام لهذا الاختبار.</div>
    }
    else
    {
        <div class="qdrat-stage-grid mb-4">
            @foreach (var stage in Model.Stages)
            {
                var quantPct = stage.QuantTarget > 0 ? Math.Min(100, stage.QuantActual * 100 / stage.QuantTarget) : 0;
                var verbalPct = stage.VerbalTarget > 0 ? Math.Min(100, stage.VerbalActual * 100 / stage.VerbalTarget) : 0;
                var quantOk = stage.QuantActual == stage.QuantTarget;
                var verbalOk = stage.VerbalActual == stage.VerbalTarget;
                <div class="qdrat-stage-card @(stage.IsComplete ? "complete" : "incomplete")">
                    <div class="qdrat-stage-head">
                        <div class="d-flex align-items-center gap-2">
                            <div class="qdrat-stage-num">@stage.StageNumber</div>
                            <div>
                                <h6 class="qdrat-stage-title">@QdratNew.Helpers.SectionNameHelper.Name(stage.StageNumber)</h6>
                                <div class="qdrat-stage-meta"><i class="fas fa-clock ms-1" aria-hidden="true"></i>@stage.DurationMinutes دقيقة — @(stage.QuantActual + stage.VerbalActual) / @(stage.QuantTarget + stage.VerbalTarget) سؤال</div>
                            </div>
                        </div>
                        <span class="qdrat-chip @(stage.IsComplete ? "ok" : "bad")">
                            <i class="fas @(stage.IsComplete ? "fa-circle-check" : "fa-circle-exclamation")" aria-hidden="true"></i>
                            @(stage.IsComplete ? "مكتملة" : "ناقصة")
                        </span>
                    </div>

                    <div class="qdrat-section-box">
                        <div class="qdrat-section-top">
                            <span class="qdrat-section-kind"><i class="fas fa-calculator ms-1" aria-hidden="true"></i>كمي</span>
                            <span class="qdrat-axis-count @(quantOk ? "ok" : "bad")">@stage.QuantActual / @stage.QuantTarget</span>
                        </div>
                        <div class="qdrat-section-name">@stage.QuantSectionTitle</div>
                        <div class="qdrat-progress @(quantOk ? "ok" : "")"><span style="width:@(quantPct)%"></span></div>
                    </div>

                    <div class="qdrat-section-box">
                        <div class="qdrat-section-top">
                            <span class="qdrat-section-kind"><i class="fas fa-book-open ms-1" aria-hidden="true"></i>لفظي</span>
                            <span class="qdrat-axis-count @(verbalOk ? "ok" : "bad")">@stage.VerbalActual / @stage.VerbalTarget</span>
                        </div>
                        <div class="qdrat-section-name">@stage.VerbalSectionTitle</div>
                        <div class="qdrat-progress @(verbalOk ? "ok" : "")"><span style="width:@(verbalPct)%"></span></div>
                    </div>

                    <div class="qdrat-stage-actions">
                        <a class="qdrat-icon-btn" title="مراجعة الأسئلة" aria-label="مراجعة أسئلة @QdratNew.Helpers.SectionNameHelper.Name(stage.StageNumber)"
                           href="@Url.Action("ReviewStage", "MinistrySimExam", new { area = "Admin", stageId = stage.StageId })">
                            <i class="fas fa-list-ol" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    }

    @if (!Model.IsPublished)
    {
        <form id="antiForgeryForm">@Html.AntiForgeryToken()</form>
        <button type="button" id="publishBtn" class="btn qdrat-btn-primary" @(Model.IsReadyToPublish ? "" : "disabled")
                title="@(Model.IsReadyToPublish ? "" : "أكمل العدد المطلوب بالضبط في كل محور ومؤشر قبل النشر")">
            <i class="fas fa-paper-plane ms-1"></i>
            نشر الاختبار
        </button>
    }
    else
    {
        @* Sprint 8 (MSE-E): الإسناد لا يُتاح إلا بعد النشر (E1/E2) *@
        <div class="qdrat-card">
            <div class="qdrat-card-header">
                <h5 class="mb-0"><i class="fas fa-paper-plane ms-1"></i> الإسناد</h5>
                <span class="text-muted" style="font-size:13px">@Model.AssignedBatchesCount دفعة — @Model.AssignedStudentsCount طالب مُسنَد لهم الاختبار</span>
            </div>
            <div class="qdrat-card-body d-flex gap-2 flex-wrap">
                <a class="btn qdrat-btn-primary" href="@Url.Action("AssignToBatch", "MinistrySimExam", new { area = "Admin", id = Model.ExamId })">
                    <i class="fas fa-users ms-1"></i> إسناد لدفعة/دفعات
                </a>
                <a class="btn btn-outline-primary" href="@Url.Action("AssignToStudent", "MinistrySimExam", new { area = "Admin", id = Model.ExamId })">
                    <i class="fas fa-user-check ms-1"></i> إسناد لطالب/طلاب
                </a>
            </div>
        </div>

        @* Sprint 14 (MSE-H): عرض نتيجة طالب محدد (Drill-down) *@
        <div class="qdrat-card">
            <div class="qdrat-card-header">
                <h5 class="mb-0"><i class="fas fa-chart-column ms-1"></i> نتائج الطلاب</h5>
            </div>
            <div class="qdrat-card-body d-flex gap-2 flex-wrap">
                <a class="btn qdrat-btn-primary" href="@Url.Action("SelectStudentForResult", "MinistrySimExam", new { area = "Admin", id = Model.ExamId })">
                    <i class="fas fa-id-card ms-1"></i> عرض نتيجة طالب
                </a>
                @* Sprint 19 (MSE-K / K5): تقرير ولي الأمر يبدأ دائمًا باختيار الطالب — نفس مسار عرض النتيجة *@
                <a class="btn btn-outline-primary" href="@Url.Action("SelectStudentForResult", "MinistrySimExam", new { area = "Admin", id = Model.ExamId })">
                    <i class="fas fa-file-pdf ms-1"></i> تقرير ولي الأمر (PDF)
                </a>
            </div>
        </div>

        @* Sprint 15 (MSE-I): تحليلات مجمّعة لكل دفعة مُسنَد لها الاختبار *@
        @if (Model.AssignedBatches.Any())
        {
            <div class="qdrat-card">
                <div class="qdrat-card-header">
                    <h5 class="mb-0"><i class="fas fa-chart-line ms-1"></i> تحليلات الدفعة</h5>
                </div>
                <div class="qdrat-card-body d-flex gap-2 flex-wrap">
                    @foreach (var batch in Model.AssignedBatches)
                    {
                        <a class="btn btn-outline-primary" href="@Url.Action("BatchAnalytics", "MinistrySimExam", new { area = "Admin", examId = Model.ExamId, batchId = batch.BatchId })">
                            <i class="fas fa-chart-line ms-1"></i> تحليلات دفعة "@batch.BatchName"
                        </a>
                    }
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';
            var publishBtn = document.getElementById('publishBtn');
            if (!publishBtn) return;

            publishBtn.addEventListener('click', function () {
                var token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;
                publishBtn.disabled = true;

                fetch('@Url.Action("Publish", "MinistrySimExam", new { area = "Admin" })', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: 'id=@Model.ExamId'
                })
                    .then(function (response) { return response.json().then(function (data) { return { ok: response.ok, data: data }; }); })
                    .then(function (result) {
                        if (result.ok && result.data.success) {
                            window.location.reload();
                        } else {
                            var messages = (result.data.messages || [result.data.message || 'تعذّر نشر الاختبار.']).join('\n');
                            alert(messages);
                            publishBtn.disabled = false;
                        }
                    })
                    .catch(function () {
                        alert('تعذّر الاتصال بالخادم — حاول مرة أخرى.');
                        publishBtn.disabled = false;
                    });
            });
        })();
    </script>
}
