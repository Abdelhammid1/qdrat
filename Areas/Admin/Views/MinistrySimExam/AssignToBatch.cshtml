@model QdratNew.ViewModels.Exam.MinistrySimExamAssignBatchPageVm
@{
    ViewData["Title"] = "إسناد لدفعة/دفعات";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-dispatch-audience.css" asp-append-version="true" />
}

<style>
    .qdrat-page { direction: rtl; text-align: right; }

    .qdrat-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 48%, #2563eb 100%);
        border-radius: 24px; padding: 28px; color: #fff; margin-bottom: 24px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, .18);
    }

    .qdrat-card {
        background: #fff; border: 1px solid #e5e7eb; border-radius: 22px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, .06); padding: 20px; margin-bottom: 18px;
    }

    .qdrat-batch-row {
        display: flex; align-items: center; justify-content: space-between; gap: 12px;
        padding: 12px 14px; border: 1px solid #e5e7eb; border-radius: 14px; margin-bottom: 10px;
    }

    .qdrat-batch-row.assigned { background: #ecfdf5; border-color: #a7f3d0; }

    .qdrat-empty { padding: 40px 20px; text-align: center; color: #64748b; }

    .qdrat-btn-primary {
        border: none; border-radius: 16px; padding: 12px 24px; font-weight: 900;
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: #fff;
        box-shadow: 0 12px 24px rgba(37,99,235,.22);
    }

    .qdrat-mode-row { display: flex; gap: 14px; flex-wrap: wrap; }
    .qdrat-mode-option {
        flex: 1; min-width: 180px; border: 2px solid #e5e7eb; border-radius: 16px; padding: 14px 16px; cursor: pointer;
    }
    .qdrat-mode-option input { margin-inline-end: 8px; }
    .qdrat-mode-option:has(input:checked) { border-color: #2563eb; background: #eff6ff; }
</style>

<div class="container-fluid py-4 qdrat-page">
    <div class="qdrat-hero">
        <h3 class="mb-1"><i class="bi bi-people ms-2"></i> إسناد لدفعة/دفعات</h3>
        <p class="mb-0" style="opacity:.9">@Model.Title — الدورة: @Model.CourseName</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning">@TempData["Warning"]</div>
    }

    <form method="post" asp-action="AssignToBatch" asp-route-id="@Model.ExamId">
        @Html.AntiForgeryToken()

        <div class="qdrat-card">
            <label class="form-label fw-bold d-block mb-2">طريقة الحضور</label>
            <div class="qdrat-mode-row">
                <label class="qdrat-mode-option">
                    <input type="radio" name="isOnline" value="true" checked />
                    <strong>أونلاين</strong> — فتح مباشر للطالب بلا رمز
                </label>
                <label class="qdrat-mode-option">
                    <input type="radio" name="isOnline" value="false" />
                    <strong>حضوري</strong> — يلزم رمزًا مرجعيًا من المعمل
                </label>
            </div>
        </div>

        <div class="qdrat-card">
            <label for="visibleFrom" class="form-label fw-bold d-block mb-2">موعد ظهور الاختبار للطالب</label>
            <input type="datetime-local" id="visibleFrom" name="visibleFrom" class="form-control" style="max-width:320px" />
            <div class="form-text">اتركه فارغًا ليظهر الاختبار للطلاب فورًا، أو حدد التاريخ والوقت الذي يبدأ فيه الظهور في أريا الطالب.</div>
        </div>

        @* APD-S5.1: دفعات المنصة (المعهد فقط) أو المدارس الشريكة: تكليف تملكه كل مدرسة وتتابعه من منطقتها *@
        <div class="qdrat-card">
            @if (Model.AudiencePicker != null)
            {
                <partial name="~/Areas/Admin/Views/Shared/_DispatchAudiencePicker.cshtml" model="Model.AudiencePicker" />
                <div class="form-text mt-2">اختيار دفعة مُسنَدة بالفعل يُسند الاختبار لطلابها الجدد فقط، ولا يكرره لمن أُسند له.</div>
            }
        </div>

        <button type="submit" class="btn qdrat-btn-primary" id="mseAssignBatchSubmit">
            <i class="bi bi-send-check ms-1"></i> إسناد الدفعات المختارة
        </button>
    </form>
</div>

@section Scripts {
    <script src="~/js/admin-dispatch-audience.js" asp-append-version="true"></script>
    <script>
        (function () {
            // منع الضغطة المزدوجة؛ الخادم يقفل لكل مدرسة أيضًا
            var form = document.querySelector('form[action*="AssignToBatch"]');
            var button = document.getElementById('mseAssignBatchSubmit');
            if (!form || !button) return;
            form.addEventListener('submit', function () {
                setTimeout(function () {
                    button.disabled = true;
                    button.innerHTML = '<span class="spinner-border spinner-border-sm ms-1" role="status"></span> جارٍ الإسناد...';
                }, 0);
            });
        })();
    </script>
}
