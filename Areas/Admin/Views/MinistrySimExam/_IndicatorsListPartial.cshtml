@model QdratNew.ViewModels.Exam.MinistrySimExamIndicatorsListVm

@if (!Model.Indicators.Any())
{
    <div class="qdrat-indicators-empty">
        <i class="bi bi-inboxes ms-1"></i>
        لا توجد مؤشرات (دروس) نشطة لهذا المحور بعد.
    </div>
}
else
{
    <table class="qdrat-indicators-table" data-section-id="@Model.SectionId">
        <thead>
            <tr>
                <th>المؤشر</th>
                <th>سهل</th>
                <th>متوسط</th>
                <th>صعب</th>
                <th>صعب جدًا</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var indicator in Model.Indicators)
            {
                <tr data-lesson-id="@indicator.LessonId">
                    <td class="qdrat-indicator-title">@indicator.LessonTitle</td>
                    <td>
                        <input type="number" min="0" max="@indicator.EasyAvailable" value="0"
                               class="form-control form-control-sm indicator-count-input"
                               data-lesson-id="@indicator.LessonId" data-difficulty="Easy" data-available="@indicator.EasyAvailable"
                               @(indicator.EasyAvailable == 0 ? "disabled" : "") />
                        <span class="qdrat-indicator-available">من @indicator.EasyAvailable متاح</span>
                    </td>
                    <td>
                        <input type="number" min="0" max="@indicator.MediumAvailable" value="0"
                               class="form-control form-control-sm indicator-count-input"
                               data-lesson-id="@indicator.LessonId" data-difficulty="Medium" data-available="@indicator.MediumAvailable"
                               @(indicator.MediumAvailable == 0 ? "disabled" : "") />
                        <span class="qdrat-indicator-available">من @indicator.MediumAvailable متاح</span>
                    </td>
                    <td>
                        <input type="number" min="0" max="@indicator.HardAvailable" value="0"
                               class="form-control form-control-sm indicator-count-input"
                               data-lesson-id="@indicator.LessonId" data-difficulty="Hard" data-available="@indicator.HardAvailable"
                               @(indicator.HardAvailable == 0 ? "disabled" : "") />
                        <span class="qdrat-indicator-available">من @indicator.HardAvailable متاح</span>
                    </td>
                    <td>
                        <input type="number" min="0" max="@indicator.VeryHardAvailable" value="0"
                               class="form-control form-control-sm indicator-count-input"
                               data-lesson-id="@indicator.LessonId" data-difficulty="VeryHard" data-available="@indicator.VeryHardAvailable"
                               @(indicator.VeryHardAvailable == 0 ? "disabled" : "") />
                        <span class="qdrat-indicator-available">من @indicator.VeryHardAvailable متاح</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
