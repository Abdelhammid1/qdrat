@model QdratNew.ViewModels.Admin.Analytics.BatchPerformanceDetailsVM
@{
    ViewData["Title"] = "تحليل أداء الدفعة — " + (Model?.BatchName ?? "");

    // ── Risk theme tokens (shared across all partials via CSS vars) ─────────
    var (riskHex, riskLight, riskMid, riskLabel, riskLevel) =
        (Model?.RiskLevel ?? "") switch
        {
            "خطر عالي جدًا" => ("#dc2626","#fef2f2","#fecaca","خطر عالي جدًا","critical"),
            "خطر عالي"      => ("#ef4444","#fef2f2","#fecaca","خطر عالي",     "high"),
            "متوسط"         => ("#f59e0b","#fffbeb","#fde68a","يحتاج متابعة", "medium"),
            _               => ("#22c55e","#f0fdf4","#bbf7d0","مستقر",        "stable")
        };
}

@* ── Assets ──────────────────────────────────────────────────────────── *@
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap"
      rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
      rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

@* ── Design tokens injected from Razor ───────────────────────────────── *@
<style>
    :root {
        --risk:        @riskHex;
        --risk-light:  @riskLight;
        --risk-mid:    @riskMid;
        --surface:     #ffffff;
        --bg:          #f1f4f9;
        --border:      #e2e8f0;
        --text:        #0f172a;
        --muted:       #64748b;
        --r:           14px;
        --r-sm:        10px;
        --gap:         20px;
        --success:     #22c55e;
        --warning:     #f59e0b;
        --danger:      #ef4444;
        --primary:     #3b82f6;
        --teal:        #14b8a6;
        --violet:      #8b5cf6;
        --topbar-h:    60px;
        --footer-h:    68px;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    .bpd-root {
        direction:   rtl;
        font-family: 'Cairo', 'Tajawal', Tahoma, sans-serif;
        background:  var(--bg);
        color:       var(--text);
        /* leave room for sticky topbar + sticky footer */
        padding-top:    calc(var(--topbar-h) + 16px);
        padding-bottom: calc(var(--footer-h) + 24px);
        min-height:     100vh;
    }
    .bpd-inner { max-width: 1400px; margin: 0 auto; padding: 0 20px; }

    /* ── Shared helpers ───────────────────────────────────────────────── */
    .card  {
        background:    var(--surface);
        border:        1.5px solid var(--border);
        border-radius: var(--r);
        box-shadow:    0 2px 12px rgba(0,0,0,.05);
    }
    .badge {
        display:       inline-flex;
        align-items:   center;
        gap:           5px;
        padding:       4px 12px;
        border-radius: 50px;
        font-size:     12px;
        font-weight:   800;
    }
    .bar    { height: 6px; border-radius: 20px; background: var(--border); overflow: hidden; }
    .bar-fill { height: 100%; border-radius: 20px; }
    .avatar {
        width: 34px; height: 34px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 13px; font-weight: 900; flex-shrink: 0;
    }
    .tbl   { width: 100%; border-collapse: collapse; font-size: 13.5px; }
    .tbl th {
        background: #f8fafc; color: var(--muted); font-size: 11.5px;
        font-weight: 800; letter-spacing: .05em; text-transform: uppercase;
        padding: 11px 14px; border-bottom: 1.5px solid var(--border);
    }
    .tbl td { padding: 11px 14px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }
    .tbl tr:last-child td { border-bottom: none; }
    .tbl tr:hover td { background: #fafbfc; }
    .empty {
        padding: 48px 24px; text-align: center; color: var(--muted);
        background: #fafafa; border-radius: var(--r-sm);
    }
    .empty i { font-size: 40px; opacity: .25; display: block; margin-bottom: 12px; }

    @@media (max-width: 768px) {
        .bpd-inner { padding: 0 12px; }
    }
</style>

@* ── Sticky command bar ───────────────────────────────────────────────── *@
<div class="bpd-root" id="bpdRoot">

    @await Html.PartialAsync("~/Areas/Admin/Views/Analytics/_BatchCommandBar.cshtml", Model)
    @await Html.PartialAsync("~/Areas/Admin/Views/Analytics/_BatchVerdictBanner.cshtml", Model)
    @await Html.PartialAsync("~/Areas/Admin/Views/Analytics/_BatchPerformanceMap.cshtml", Model)
    @await Html.PartialAsync("~/Areas/Admin/Views/Analytics/_BatchDeepDiveTabs.cshtml", Model)
    @await Html.PartialAsync("~/Areas/Admin/Views/Analytics/_BatchActionFooter.cshtml", Model)

</div>
