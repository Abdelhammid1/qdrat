@model QdratNew.ViewModels.Admin.Analytics.BatchPerformanceDetailsVM
@* ═══════════════════════════════════════════════════════════════════
   _BatchVerdictBanner — الحكم الذكي على الدفعة
   ليس hero عادي — بل "محطة حكم" تقرأ البيانات وتصدر جملة واحدة واضحة
   مع 4 أرقام مشبعة في صف أفقي أسفله
═══════════════════════════════════════════════════════════════════ *@
@{
    var weak  = Model?.WeaknessPercentage ?? 0;
    var score = Model?.AvgScore ?? 0;
    var isDanger  = Model?.RiskLevel?.Contains("خطر") == true;
    var isWarning = Model?.RiskLevel == "متوسط";

    // الحكم اللحظي: جملة تشخيصية واحدة تُبنى من البيانات
    var verdictIcon = isDanger ? "bi-exclamation-octagon-fill"
                   : isWarning ? "bi-exclamation-circle-fill"
                   : "bi-check-circle-fill";
}
<style>
    /* ── Page identity header ──────────────────────────────────────── */
    .bpd-page-header {
        display:        flex;
        align-items:    center;
        gap:            16px;
        padding:        20px 28px;
        background:     var(--surface);
        border:         1.5px solid var(--border);
        border-radius:  var(--r);
        margin-bottom:  var(--gap);
        box-shadow:     0 2px 12px rgba(0,0,0,.04);
    }
    .bpd-ph-icon {
        width:  52px; height: 52px; border-radius: 14px;
        background: #eff6ff; color: #3b82f6;
        display: flex; align-items: center; justify-content: center;
        font-size: 22px; flex-shrink: 0;
        border: 1.5px solid #bfdbfe;
    }
    .bpd-ph-body { flex: 1; min-width: 0; }
    .bpd-ph-sup {
        font-size: 11.5px; font-weight: 800; letter-spacing: .07em;
        text-transform: uppercase; color: var(--muted);
        margin-bottom: 4px;
    }
    .bpd-ph-name {
        font-size: 22px; font-weight: 900; color: var(--text);
        line-height: 1.2; margin-bottom: 6px;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .bpd-ph-meta {
        display: flex; align-items: center; gap: 18px;
        flex-wrap: wrap;
    }
    .bpd-ph-chip {
        display: inline-flex; align-items: center; gap: 5px;
        font-size: 12.5px; font-weight: 700; color: var(--muted);
    }
    .bpd-ph-chip i { font-size: 13px; }
    .bpd-ph-divider { width: 1px; height: 20px; background: var(--border); }

    @@media (max-width: 600px) {
        .bpd-page-header { padding: 16px; gap: 12px; }
        .bpd-ph-name     { font-size: 17px; }
        .bpd-ph-icon     { width: 42px; height: 42px; font-size: 18px; }
    }

    /* ── Verdict banner ────────────────────────────────────────────── */
    .vb-wrap {
        border-radius: var(--r);
        border:        2px solid var(--risk-mid);
        background:    var(--risk-light);
        padding:       28px 32px;
        margin:        0 0 var(--gap);
        position:      relative;
        overflow:      hidden;
    }
    /* Subtle ambient glow top-right */
    .vb-wrap::after {
        content:       '';
        position:      absolute;
        top: -80px; left: -80px;
        width:  260px; height: 260px;
        border-radius: 50%;
        background:    var(--risk);
        opacity:       .05;
        pointer-events:none;
    }

    /* Top row: icon + verdict text */
    .vb-top {
        display:     flex;
        align-items: flex-start;
        gap:         18px;
        margin-bottom: 22px;
    }
    .vb-icon-ring {
        width:  56px; height: 56px; border-radius: 16px;
        background:  var(--risk); color:#fff;
        display:flex; align-items:center; justify-content:center;
        font-size:26px; flex-shrink:0;
        box-shadow: 0 8px 24px color-mix(in srgb, var(--risk) 35%, transparent);
    }
    .vb-label {
        font-size:11.5px; font-weight:800; letter-spacing:.08em;
        text-transform:uppercase; color:var(--risk); opacity:.75;
        margin-bottom:4px;
    }
    .vb-title {
        font-size:22px; font-weight:900; color:var(--risk);
        margin-bottom:6px; line-height:1.25;
    }
    .vb-msg {
        font-size:14.5px; color:var(--risk); opacity:.85;
        line-height:1.75; max-width:640px;
    }

    /* Bottom stat row — 4 quick facts */
    .vb-stats {
        display:grid;
        grid-template-columns: repeat(4, 1fr);
        gap:14px;
        border-top: 1.5px solid var(--risk-mid);
        padding-top:18px;
    }
    .vb-stat {
        display:flex; align-items:center; gap:12px;
    }
    .vb-stat-ico {
        width:38px; height:38px; border-radius:11px;
        background:rgba(255,255,255,.6);
        display:flex; align-items:center; justify-content:center;
        font-size:17px; color:var(--risk); flex-shrink:0;
        border:1px solid var(--risk-mid);
    }
    .vb-stat-val { font-size:20px; font-weight:900; color:var(--risk); line-height:1; }
    .vb-stat-lbl { font-size:12px; color:var(--risk); opacity:.7; font-weight:700; margin-top:2px; }

    @@media (max-width:768px) {
        .vb-wrap  { padding:18px; }
        .vb-stats { grid-template-columns:repeat(2,1fr); }
        .vb-title { font-size:18px; }
    }
    @@media (max-width:480px) {
        .vb-stats { grid-template-columns:1fr 1fr; }
    }
</style>

<div class="bpd-inner">

    @* ── Page identity header: batch name prominent ── *@
    <div class="bpd-page-header">
        <div class="bpd-ph-icon">
            <i class="bi bi-layers-fill"></i>
        </div>
        <div class="bpd-ph-body">
            <div class="bpd-ph-sup">تحليل أداء الدفعة</div>
            <div class="bpd-ph-name">@(Model?.BatchName ?? "—")</div>
            <div class="bpd-ph-meta">
                @if (!string.IsNullOrEmpty(Model?.CourseName))
                {
                    <span class="bpd-ph-chip">
                        <i class="bi bi-book-fill"></i>
                        @Model.CourseName
                    </span>
                }
                @if (Model?.StudentsCount > 0 && !string.IsNullOrEmpty(Model?.CourseName))
                {
                    <span class="bpd-ph-divider"></span>
                }
                @if (Model?.StudentsCount > 0)
                {
                    <span class="bpd-ph-chip">
                        <i class="bi bi-people-fill"></i>
                        @Model.StudentsCount طالب
                    </span>
                }
            </div>
        </div>
    </div>

    <div class="vb-wrap">

        @* ── Verdict ── *@
        <div class="vb-top">
            <div class="vb-icon-ring">
                <i class="bi @verdictIcon"></i>
            </div>
            <div>
                <div class="vb-label">تقييم النظام الذكي</div>
                <div class="vb-title">@(Model?.RiskLevel ?? "—")</div>
                <div class="vb-msg">@(Model?.DecisionMessage ?? "—")</div>
            </div>
        </div>

        @* ── 4 quick stats ── *@
        <div class="vb-stats">
            <div class="vb-stat">
                <div class="vb-stat-ico"><i class="bi bi-people-fill"></i></div>
                <div>
                    <div class="vb-stat-val">@(Model?.StudentsCount ?? 0)</div>
                    <div class="vb-stat-lbl">طالب في الدفعة</div>
                </div>
            </div>
            <div class="vb-stat">
                <div class="vb-stat-ico"><i class="bi bi-percent"></i></div>
                <div>
                    <div class="vb-stat-val">@weak.ToString("0.#")%</div>
                    <div class="vb-stat-lbl">متوسط الضعف</div>
                </div>
            </div>
            <div class="vb-stat">
                <div class="vb-stat-ico"><i class="bi bi-book-half"></i></div>
                <div>
                    <div class="vb-stat-val">@(Model?.CriticalLessonsCount ?? 0)</div>
                    <div class="vb-stat-lbl">درس حرج</div>
                </div>
            </div>
            <div class="vb-stat">
                <div class="vb-stat-ico"><i class="bi bi-question-diamond-fill"></i></div>
                <div>
                    <div class="vb-stat-val">@(Model?.HighRiskQuestionsCount ?? 0)</div>
                    <div class="vb-stat-lbl">سؤال عالي الخطأ</div>
                </div>
            </div>
        </div>

    </div>
</div>
