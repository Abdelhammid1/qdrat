@using QdratNew.ViewModels.Admin.Analytics
@model QdratNew.ViewModels.Admin.Analytics.AdvancedAnalyticsDashboardVM

@{
    ViewData["Title"] = "تفاصيل مستوى النظام";

    var avgW = Model?.AvgWeakness ?? 0;
    var students = Model?.Students ?? new List<QdratNew.ViewModels.Admin.Analytics.StudentAnalyticsVM>();
    var lessons = (Model?.Lessons ?? new List<LessonAnalyticsVM>())
        .OrderByDescending(x => x.WeakPercentage)
        .ToList(); var batches = Model?.Batches ?? new List<QdratNew.ViewModels.Admin.Analytics.BatchAnalyticsVM>();
    var instructors = Model?.Instructors ?? new List<QdratNew.ViewModels.Admin.Analytics.InstructorAnalyticsVM>();

    var riskHigh = Model?.RiskHigh ?? 0;
    var riskMedium = Model?.RiskMedium ?? 0;
    var riskLow = Model?.RiskLow ?? 0;
    var totalBatch = riskHigh + riskMedium + riskLow;

    string systemStatus, systemColor, systemBg, systemBorder, systemIcon, systemMsg, systemAction;

    if (avgW > 60)
    {
        systemStatus = "خطر";
        systemColor = "#dc2626";
        systemBg = "#fff1f1";
        systemBorder = "#fca5a5";
        systemIcon = "bi-exclamation-octagon-fill";
        systemMsg = "النظام في حالة خطر؛ يوجد ضعف عام مرتفع ويجب مراجعة الدروس الحرجة والطلاب أصحاب الأولوية العالية فورًا.";
        systemAction = "مراجعة الدروس الحرجة والتواصل مع مدربي الدفعات عالية الخطورة";
    }
    else if (avgW > 40)
    {
        systemStatus = "متوسط";
        systemColor = "#d97706";
        systemBg = "#fffbeb";
        systemBorder = "#fcd34d";
        systemIcon = "bi-exclamation-triangle-fill";
        systemMsg = "النظام في حالة متوسطة؛ توجد مؤشرات ضعف تحتاج متابعة قبل تحولها إلى حالات حرجة.";
        systemAction = "متابعة الطلاب ذوي الأداء المتوسط ومراجعة الدروس التي تجاوزت 50% ضعف";
    }
    else
    {
        systemStatus = "مستقر";
        systemColor = "#16a34a";
        systemBg = "#f0fdf4";
        systemBorder = "#86efac";
        systemIcon = "bi-check-circle-fill";
        systemMsg = "النظام مستقر؛ لا توجد مؤشرات خطر عالية حاليًا بناءً على البيانات المتاحة.";
        systemAction = "الاستمرار في المتابعة الدورية والرصد الأسبوعي";
    }

    var top10Lessons = lessons.OrderByDescending(x => x.WeakPercentage).Take(10).ToList();

    // Gauge fill angle for SVG (0-180 degrees mapped to 0-100%)
    var gaugeAngle = (int)(avgW * 1.8); // max 180deg at 100%
    var gaugeColor = avgW > 60 ? "#dc2626" : avgW > 40 ? "#d97706" : "#16a34a";
}

<style>
    :root {
        --q-bg: #f0f2f5;
        --q-surface: #ffffff;
        --q-border: #e5e7eb;
        --q-primary: #1e40af;
        --q-primary-light: #dbeafe;
        --q-success: #16a34a;
        --q-success-light: #dcfce7;
        --q-warning: #d97706;
        --q-warning-light: #fef3c7;
        --q-danger: #dc2626;
        --q-danger-light: #fee2e2;
        --q-info: #0891b2;
        --q-info-light: #cffafe;
        --q-violet: #7c3aed;
        --q-violet-light: #ede9fe;
        --q-text: #111827;
        --q-muted: #6b7280;
        --q-radius: 16px;
        --q-radius-sm: 10px;
        --q-shadow: 0 4px 20px rgba(0,0,0,.07);
        --q-shadow-sm: 0 2px 10px rgba(0,0,0,.05);
    }

    *, *::before, *::after {
        box-sizing: border-box;
    }

    body {
        background: var(--q-bg);
        font-family: 'Tajawal', 'Cairo', Tahoma, Arial, sans-serif;
        color: var(--q-text);
    }

    .qd-page {
        direction: rtl;
    }

    /* ── Header ── */
    .qd-header {
        background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 60%, #1e40af 100%);
        border-radius: 22px;
        padding: 28px 32px;
        color: #fff;
        position: relative;
        overflow: hidden;
    }

        .qd-header::before {
            content: '';
            position: absolute;
            inset: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
            pointer-events: none;
        }

    .qd-header-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 8px;
        padding: 4px 12px;
        font-size: 12px;
        font-weight: 700;
        color: #93c5fd;
        margin-bottom: 10px;
    }

    .qd-header-title {
        font-size: 22px;
        font-weight: 800;
        margin: 0 0 4px;
    }

    .qd-header-sub {
        color: #93c5fd;
        font-size: 14px;
        margin: 0;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,255,255,.12);
        color: #fff;
        border: 1px solid rgba(255,255,255,.2);
        border-radius: var(--q-radius-sm);
        padding: 8px 18px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: background .2s;
        backdrop-filter: blur(4px);
    }

        .btn-back:hover {
            background: rgba(255,255,255,.22);
            color: #fff;
        }

    /* ── KPI ── */
    .qd-kpi {
        background: var(--q-surface);
        border-radius: var(--q-radius);
        padding: 20px;
        border: 1px solid var(--q-border);
        box-shadow: var(--q-shadow-sm);
        height: 100%;
        transition: transform .18s, box-shadow .18s;
        position: relative;
        overflow: hidden;
    }

        .qd-kpi:hover {
            transform: translateY(-3px);
            box-shadow: var(--q-shadow);
        }

        .qd-kpi::after {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 4px;
            height: 100%;
            border-radius: 0 var(--q-radius) var(--q-radius) 0;
        }

        .qd-kpi.kpi-danger::after {
            background: var(--q-danger);
        }

        .qd-kpi.kpi-warning::after {
            background: var(--q-warning);
        }

        .qd-kpi.kpi-success::after {
            background: var(--q-success);
        }

        .qd-kpi.kpi-primary::after {
            background: var(--q-primary);
        }

        .qd-kpi.kpi-info::after {
            background: var(--q-info);
        }

        .qd-kpi.kpi-violet::after {
            background: var(--q-violet);
        }

    .qd-kpi-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        margin-bottom: 14px;
    }

    .qd-kpi-value {
        font-size: 28px;
        font-weight: 800;
        line-height: 1;
        margin-bottom: 4px;
    }

    .qd-kpi-label {
        font-size: 13px;
        color: var(--q-muted);
        font-weight: 600;
        margin-bottom: 4px;
    }

    .qd-kpi-sub {
        font-size: 11px;
        color: var(--q-muted);
    }

    /* ── System Decision Panel ── */
    .qd-sys-panel {
        border-radius: var(--q-radius);
        padding: 22px 26px;
        border: 1.5px solid;
        display: flex;
        align-items: flex-start;
        gap: 18px;
    }

    .qd-sys-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        flex-shrink: 0;
        background: rgba(0,0,0,.07);
    }

    .qd-sys-tag {
        font-size: 11px;
        font-weight: 700;
        opacity: .7;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .qd-sys-status {
        font-size: 20px;
        font-weight: 800;
        margin: 2px 0 6px;
    }

    .qd-sys-msg {
        font-size: 13px;
        opacity: .9;
        margin: 0 0 10px;
        line-height: 1.6;
    }

    .qd-sys-action {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(0,0,0,.06);
        border-radius: 8px;
        padding: 5px 12px;
        font-size: 12px;
        font-weight: 700;
    }

    /* ── Gauge Card ── */
    .gauge-card {
        background: var(--q-surface);
        border-radius: var(--q-radius);
        padding: 24px;
        border: 1px solid var(--q-border);
        box-shadow: var(--q-shadow-sm);
        text-align: center;
    }

    .gauge-wrap {
        position: relative;
        display: inline-block;
    }

    .gauge-svg {
        display: block;
    }

    .gauge-center {
        position: absolute;
        bottom: 10px;
        left: 50%;
        transform: translateX(-50%);
        text-align: center;
    }

    .gauge-pct {
        font-size: 26px;
        font-weight: 900;
        line-height: 1;
    }

    .gauge-label {
        font-size: 11px;
        color: var(--q-muted);
    }

    /* ── Risk Distribution ── */
    .risk-dist-card {
        background: var(--q-surface);
        border-radius: var(--q-radius);
        padding: 22px;
        border: 1px solid var(--q-border);
        box-shadow: var(--q-shadow-sm);
    }

    .risk-bar-wrap {
        height: 14px;
        border-radius: 20px;
        background: #f3f4f6;
        overflow: hidden;
        display: flex;
        margin: 10px 0;
    }

    .risk-bar-seg {
        height: 100%;
        transition: width .5s;
    }

    .risk-legend {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 14px;
    }

    .risk-legend-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 12px;
        border-radius: 10px;
        border: 1px solid var(--q-border);
    }

    .risk-legend-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .risk-legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .risk-legend-label {
        font-size: 13px;
        font-weight: 700;
    }

    .risk-legend-count {
        font-size: 16px;
        font-weight: 800;
    }

    /* ── Indicators Summary ── */
    .indicator-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .indicator-item {
        background: #f8fafc;
        border-radius: var(--q-radius-sm);
        padding: 14px 16px;
        border: 1px solid var(--q-border);
    }

    .indicator-value {
        font-size: 26px;
        font-weight: 800;
        line-height: 1;
        margin-bottom: 4px;
    }

    .indicator-label {
        font-size: 12px;
        color: var(--q-muted);
        font-weight: 600;
    }

    .indicator-desc {
        font-size: 11px;
        color: var(--q-muted);
        margin-top: 4px;
    }

    /* ── Card Box ── */
    .card-box {
        background: var(--q-surface);
        border-radius: var(--q-radius);
        padding: 24px;
        border: 1px solid var(--q-border);
        box-shadow: var(--q-shadow-sm);
    }

    /* ── Section Title ── */
    .qd-section-title {
        font-size: 16px;
        font-weight: 800;
        color: var(--q-text);
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
    }

        .qd-section-title .icon-wrap {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

    .qd-section-sub {
        font-size: 12px;
        color: var(--q-muted);
        margin-bottom: 16px;
        margin-right: 42px;
    }

    /* ── Table ── */
    .qd-table-wrap {
        border-radius: var(--q-radius-sm);
        overflow: hidden;
        border: 1px solid var(--q-border);
    }

    .qd-table {
        margin: 0;
        font-size: 13px;
    }

        .qd-table thead th {
            background: #f8fafc;
            color: var(--q-muted);
            font-weight: 700;
            font-size: 11px;
            letter-spacing: .4px;
            text-transform: uppercase;
            padding: 12px 14px;
            border-bottom: 1px solid var(--q-border);
            white-space: nowrap;
        }

        .qd-table tbody td {
            padding: 11px 14px;
            vertical-align: middle;
            border-bottom: 1px solid #f3f4f6;
        }

        .qd-table tbody tr:last-child td {
            border-bottom: none;
        }

        .qd-table tbody tr:hover {
            background: #fafbfc;
        }

    /* ── Progress ── */
    .qd-progress {
        height: 7px;
        border-radius: 20px;
        background: #edf0f3;
        overflow: hidden;
        margin-top: 4px;
    }

    .qd-progress-bar {
        height: 100%;
        border-radius: 20px;
        transition: width .4s;
    }

    /* ── Badges ── */
    .qd-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .badge-danger {
        background: var(--q-danger-light);
        color: #991b1b;
    }

    .badge-warning {
        background: var(--q-warning-light);
        color: #92400e;
    }

    .badge-success {
        background: var(--q-success-light);
        color: #14532d;
    }

    .badge-primary {
        background: var(--q-primary-light);
        color: #1e3a8a;
    }

    /* ── Rank circle ── */
    .rank-circle {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 800;
        background: var(--q-danger-light);
        color: var(--q-danger);
    }

    /* ── AI insight strip ── */
    .ai-strip {
        background: linear-gradient(135deg, #faf5ff, #ede9fe);
        border: 1px solid #ddd6fe;
        border-radius: var(--q-radius);
        padding: 18px 22px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .ai-strip-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: var(--q-violet);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .ai-strip-title {
        font-size: 12px;
        font-weight: 700;
        color: var(--q-violet);
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .ai-strip-msg {
        font-size: 13px;
        font-weight: 600;
        color: #3b0764;
        margin: 2px 0 0;
    }

    /* ── Empty ── */
    .qd-empty {
        padding: 40px 20px;
        text-align: center;
        background: var(--q-success-light);
        border-radius: var(--q-radius-sm);
    }

        .qd-empty i {
            font-size: 40px;
            color: var(--q-success);
            opacity: .7;
            display: block;
            margin-bottom: 10px;
        }

    .qd-empty-title {
        font-weight: 800;
        font-size: 15px;
        color: var(--q-success);
        margin-bottom: 4px;
    }

    .qd-empty-sub {
        font-size: 12px;
        color: #166534;
    }

    @@media (max-width: 991px) {
        .qd-header {
            padding: 20px;
        }

        .qd-header-title {
            font-size: 18px;
        }

        .qd-sys-panel {
            flex-direction: column;
            gap: 10px;
        }

        .indicator-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 767px) {
        .qd-kpi-value {
            font-size: 22px;
        }

        .gauge-pct {
            font-size: 20px;
        }
    }
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid qd-page py-4 px-3 px-lg-4">

    @* ── 1. Header ── *@
    <div class="qd-header mb-4">
        <div class="row align-items-center g-3">
            <div class="col-lg-8">
                <div class="qd-header-badge">
                    <i class="bi bi-shield-fill-check"></i> قراءة عامة للمنصة
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div style="background:rgba(255,255,255,.12);border-radius:14px;width:50px;height:50px;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;">
                        <i class="bi bi-cpu-fill"></i>
                    </div>
                    <div>
                        <h1 class="qd-header-title">تفاصيل مستوى النظام</h1>
                        <p class="qd-header-sub">قراءة عامة لحالة المنصة بناءً على ضعف الدروس، الحالات الحرجة، أداء الطلاب، وتحليل الدفعات</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a asp-area="Admin" asp-controller="Analytics" asp-action="AdvancedDashboard" class="btn-back">
                    <i class="bi bi-arrow-right"></i> رجوع للوحة التحليل
                </a>
            </div>
        </div>
    </div>

    @* ── 2. KPI Row ── *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="qd-kpi @(avgW > 60 ? "kpi-danger" : avgW > 40 ? "kpi-warning" : "kpi-success")">
                <div class="qd-kpi-icon" style="background:rgba(0,0,0,.05);color:@systemColor;">
                    <i class="bi @systemIcon"></i>
                </div>
                <div class="qd-kpi-value" style="color:@systemColor;">@systemStatus</div>
                <div class="qd-kpi-label">مستوى النظام</div>
                <div class="qd-kpi-sub">بناءً على متوسط الضعف @Math.Round(avgW, 1)%</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="qd-kpi kpi-danger">
                <div class="qd-kpi-icon" style="background:var(--q-danger-light);color:var(--q-danger);">
                    <i class="bi bi-percent"></i>
                </div>
                <div class="qd-kpi-value" style="color:var(--q-danger);">@Math.Round(avgW, 1)%</div>
                <div class="qd-kpi-label">متوسط الضعف</div>
                <div class="qd-kpi-sub">عبر جميع الدروس المحللة</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="qd-kpi kpi-danger">
                <div class="qd-kpi-icon" style="background:var(--q-danger-light);color:var(--q-danger);">
                    <i class="bi bi-person-fill-exclamation"></i>
                </div>
                <div class="qd-kpi-value" style="color:var(--q-danger);">@(Model?.CriticalCases ?? 0)</div>
                <div class="qd-kpi-label">الحالات الحرجة</div>
                <div class="qd-kpi-sub">تحتاج تدخلًا فوريًا</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="qd-kpi kpi-warning">
                <div class="qd-kpi-icon" style="background:var(--q-warning-light);color:var(--q-warning);">
                    <i class="bi bi-exclamation-diamond-fill"></i>
                </div>
                <div class="qd-kpi-value" style="color:var(--q-warning);">@(Model?.HighRiskCount ?? 0)</div>
                <div class="qd-kpi-label">الدروس الحرجة</div>
                <div class="qd-kpi-sub">ضعف ≥ 70%</div>
            </div>
        </div>
    </div>

    @* ── 3. System Decision Panel ── *@
    <div class="qd-sys-panel mb-4"
         style="background:@systemBg; border-color:@systemBorder;">
        <div class="qd-sys-icon" style="color:@systemColor;">
            <i class="bi @systemIcon"></i>
        </div>
        <div class="flex-grow-1">
            <div class="qd-sys-tag" style="color:@systemColor;">قراءة النظام الذكية</div>
            <div class="qd-sys-status" style="color:@systemColor;">@systemStatus</div>
            <p class="qd-sys-msg" style="color:@systemColor;">@systemMsg</p>
            <span class="qd-sys-action" style="color:@systemColor;">
                <i class="bi bi-lightning-charge-fill"></i>
                الإجراء المقترح: @systemAction
            </span>
        </div>
        <div class="d-none d-lg-flex flex-column align-items-center justify-content-center flex-shrink-0"
             style="min-width:100px;gap:4px;">
            <div style="font-size:40px;font-weight:900;color:@systemColor;line-height:1;">@Math.Round(avgW, 0)%</div>
            <div style="font-size:11px;color:var(--q-muted);">متوسط الضعف</div>
        </div>
    </div>

    @* ── 4. AI Strip ── *@
    <div class="ai-strip mb-4">
        <div class="ai-strip-icon"><i class="bi bi-stars"></i></div>
        <div>
            <div class="ai-strip-title">رؤية الذكاء الاصطناعي</div>
            <div class="ai-strip-msg">
                @if (avgW > 60)
                {
                    <text>يُلاحَظ تدهور واسع في مؤشرات الأداء. يُوصى بعقد جلسات مراجعة عاجلة للمدربين وتفعيل خطة تدخل تعليمي فوري.</text>
                }
                else if (avgW > 40)
                {
                    <text>بعض المؤشرات تستدعي الانتباه. المتابعة المركزة على الدروس الأعلى ضعفًا ستمنع تحولها إلى حالات حرجة.</text>
                }
                else
                {
                    <text>مؤشرات الأداء العامة ضمن النطاق المقبول. الاستمرار في المتابعة الدورية يُعزز الاستقرار التعليمي.</text>
                }
            </div>
        </div>
    </div>

    @* ── 5. Three Columns: Gauge + Risk Dist + Indicators ── *@
    <div class="row g-3 mb-4">

        @* Weakness Gauge *@
        <div class="col-lg-3 col-md-6">
            <div class="gauge-card h-100">
                <div style="font-size:13px;font-weight:800;margin-bottom:16px;">مقياس الضعف العام</div>
                <div class="gauge-wrap">
                    <svg class="gauge-svg" width="180" height="100" viewBox="0 0 180 100">
                        <!-- Track -->
                        <path d="M 10 90 A 80 80 0 0 1 170 90"
                              fill="none" stroke="#f3f4f6" stroke-width="16" stroke-linecap="round" />
                        <!-- Fill -->
                        <path d="M 10 90 A 80 80 0 0 1 170 90"
                              fill="none" stroke="@gaugeColor" stroke-width="16" stroke-linecap="round"
                              stroke-dasharray="251"
                              stroke-dashoffset="@(251 - (int)(avgW * 2.51))"
                              style="transition:stroke-dashoffset 1s ease;" />
                        <!-- Labels -->
                        <text x="8" y="108" font-size="10" fill="#9ca3af" font-family="Tajawal,Arial">0</text>
                        <text x="84" y="18" font-size="10" fill="#9ca3af" font-family="Tajawal,Arial" text-anchor="middle">50</text>
                        <text x="168" y="108" font-size="10" fill="#9ca3af" font-family="Tajawal,Arial" text-anchor="end">100</text>
                    </svg>
                    <div class="gauge-center">
                        <div class="gauge-pct" style="color:@gaugeColor;">@Math.Round(avgW, 1)%</div>
                        <div class="gauge-label">متوسط الضعف</div>
                    </div>
                </div>
                <div class="d-flex justify-content-center gap-3 mt-2">
                    <div style="font-size:11px;color:var(--q-success);font-weight:700;">▬ مستقر &lt;40%</div>
                    <div style="font-size:11px;color:var(--q-warning);font-weight:700;">▬ متوسط &lt;60%</div>
                    <div style="font-size:11px;color:var(--q-danger);font-weight:700;">▬ خطر ≥60%</div>
                </div>
            </div>
        </div>

        @* Risk Distribution *@
        <div class="col-lg-4 col-md-6">
            <div class="risk-dist-card h-100">
                <div style="font-size:13px;font-weight:800;margin-bottom:4px;">توزيع مخاطر الدفعات</div>
                <div style="font-size:11px;color:var(--q-muted);margin-bottom:10px;">من إجمالي @totalBatch دفعة محللة</div>

                @if (totalBatch > 0)
                {
                    var hPct = riskHigh * 100 / totalBatch;
                    var mPct = riskMedium * 100 / totalBatch;
                    var lPct = 100 - hPct - mPct;
                    <div class="risk-bar-wrap">
                        <div class="risk-bar-seg" style="width:@hPct%;background:var(--q-danger);"></div>
                        <div class="risk-bar-seg" style="width:@mPct%;background:var(--q-warning);"></div>
                        <div class="risk-bar-seg" style="width:@lPct%;background:var(--q-success);"></div>
                    </div>
                    <div class="risk-legend">
                        <div class="risk-legend-row" style="background:#fff5f5;">
                            <div class="risk-legend-left">
                                <div class="risk-legend-dot" style="background:var(--q-danger);"></div>
                                <div>
                                    <div class="risk-legend-label" style="color:var(--q-danger);">خطر عالي</div>
                                    <div style="font-size:10px;color:var(--q-muted);">ضعف ≥ 70%</div>
                                </div>
                            </div>
                            <div class="risk-legend-count" style="color:var(--q-danger);">@riskHigh</div>
                        </div>
                        <div class="risk-legend-row" style="background:#fffbeb;">
                            <div class="risk-legend-left">
                                <div class="risk-legend-dot" style="background:var(--q-warning);"></div>
                                <div>
                                    <div class="risk-legend-label" style="color:var(--q-warning);">متوسط</div>
                                    <div style="font-size:10px;color:var(--q-muted);">ضعف 50–70%</div>
                                </div>
                            </div>
                            <div class="risk-legend-count" style="color:var(--q-warning);">@riskMedium</div>
                        </div>
                        <div class="risk-legend-row" style="background:#f0fdf4;">
                            <div class="risk-legend-left">
                                <div class="risk-legend-dot" style="background:var(--q-success);"></div>
                                <div>
                                    <div class="risk-legend-label" style="color:var(--q-success);">جيد</div>
                                    <div style="font-size:10px;color:var(--q-muted);">ضعف &lt; 50%</div>
                                </div>
                            </div>
                            <div class="risk-legend-count" style="color:var(--q-success);">@riskLow</div>
                        </div>
                    </div>
                }
                else
                {
                    <div style="font-size:13px;color:var(--q-muted);text-align:center;padding:20px 0;">لا توجد دفعات محللة</div>
                }
            </div>
        </div>

        @* System Indicators *@
        <div class="col-lg-5">
            <div class="card-box h-100">
                <div style="font-size:13px;font-weight:800;margin-bottom:14px;">ملخص مؤشرات النظام</div>
                <div class="indicator-grid">
                    <div class="indicator-item">
                        <div class="indicator-value" style="color:var(--q-primary);">@students.Count</div>
                        <div class="indicator-label">الطلاب المحللون</div>
                        <div class="indicator-desc">طلاب لديهم بيانات أداء كافية</div>
                    </div>
                    <div class="indicator-item">
                        <div class="indicator-value" style="color:var(--q-warning);">@lessons.Count</div>
                        <div class="indicator-label">الدروس الضعيفة</div>
                        <div class="indicator-desc">تحتاج مراجعة أو تدخل تدريبي</div>
                    </div>
                    <div class="indicator-item">
                        <div class="indicator-value" style="color:var(--q-info);">@batches.Count</div>
                        <div class="indicator-label">الدفعات المتابَعة</div>
                        <div class="indicator-desc">ظهرت في نطاق التحليل الحالي</div>
                    </div>
                    <div class="indicator-item">
                        <div class="indicator-value" style="color:var(--q-violet);">@instructors.Count</div>
                        <div class="indicator-label">المدربون المحللون</div>
                        <div class="indicator-desc">مرتبطون ببيانات أداء قابلة للقياس</div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    @* ── 6. Top 10 Weak Lessons ── *@
    <div class="card-box">
        <div class="qd-section-title mb-1">
            <div class="icon-wrap" style="background:var(--q-danger-light);color:var(--q-danger);">
                <i class="bi bi-trophy-fill"></i>
            </div>
            أعلى الدروس تأثيرًا على مستوى النظام
        </div>
        <div class="qd-section-sub">أعلى 10 دروس من حيث نسبة الضعف — تمثل أكبر خطر على الأداء العام</div>

        @if (!top10Lessons.Any())
        {
            <div class="qd-empty">
                <i class="bi bi-patch-check-fill"></i>
                <div class="qd-empty-title">لا توجد دروس مؤثرة حاليًا</div>
                <div class="qd-empty-sub">جميع الدروس ضمن المستوى المقبول</div>
            </div>
        }
        else
        {
            <div class="table-responsive qd-table-wrap">
                <table class="table qd-table text-center">
                    <thead>
                        <tr>
                            <th style="min-width:30px;">#</th>
                            <th style="text-align:right;min-width:180px;">الدرس</th>
                            <th style="min-width:130px;">الدفعة</th>
                            <th style="min-width:130px;">المدرب</th>
                            <th style="min-width:100px;">الطلاب المتأثرون</th>
                            <th style="min-width:160px;">نسبة الضعف</th>
                            <th style="min-width:90px;">الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var rowNum = 0;
                        }
                        @foreach (var l in top10Lessons)
                        {
                            rowNum++;
                            var isH = l.WeakPercentage >= 70;
                            var isMed = l.WeakPercentage >= 50;
                            var bColor = isH ? "var(--q-danger)" : isMed ? "var(--q-warning)" : "var(--q-success)";
                            var bClass = isH ? "badge-danger" : isMed ? "badge-warning" : "badge-success";
                            var bText = isH ? "خطر عالي" : isMed ? "متوسط" : "مستقر";
                            var bIcon = isH ? "bi-exclamation-triangle-fill" : isMed ? "bi-dash-circle-fill" : "bi-check-circle-fill";

                            <tr>
                                <td>
                                    <div class="rank-circle" style="@(rowNum <= 3 ? $"background:{bColor}22;color:{bColor};" : "")">@rowNum</div>
                                </td>
                                <td style="text-align:right;">
                                    <div style="font-weight:700;font-size:13px;">@l.LessonName</div>
                                </td>
                                <td>
                                    <span style="font-size:12px;color:var(--q-muted);">
                                        <i class="bi bi-layers-fill me-1" style="color:var(--q-primary);"></i>@l.BatchName
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                        <div style="width:24px;height:24px;border-radius:50%;background:var(--q-info-light);color:var(--q-info);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:800;flex-shrink:0;">
                                            @(string.IsNullOrWhiteSpace(l.InstructorName) || l.InstructorName == "-" ? "م" : l.InstructorName.Substring(0, 1))
                                        </div>
                                        <span style="font-size:12px;">@l.InstructorName</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="qd-badge badge-primary">
                                        <i class="bi bi-people-fill"></i> @l.AffectedStudents
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="font-size:14px;font-weight:800;color:@bColor;white-space:nowrap;">@Math.Round(l.WeakPercentage, 1)%</div>
                                        <div class="qd-progress flex-grow-1">
                                            <div class="qd-progress-bar" style="width:@l.WeakPercentage%;background:@bColor;"></div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="qd-badge @bClass">
                                        <i class="bi @bIcon"></i> @bText
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                <div style="font-size:12px;color:var(--q-muted);">
                    عرض أعلى <strong>@top10Lessons.Count</strong> من إجمالي <strong>@lessons.Count</strong> درس ضعيف
                </div>
                @if (lessons.Count > 10)
                {
                    <a asp-area="Admin" asp-controller="Analytics" asp-action="HighRiskLessonsDetails"
                       style="font-size:12px;color:var(--q-primary);font-weight:700;text-decoration:none;">
                        عرض جميع الدروس الحرجة <i class="bi bi-arrow-left ms-1"></i>
                    </a>
                }
            </div>
        }
    </div>

</div>