@model QdratNew.ViewModels.Admin.Analytics.BatchPerformanceDetailsVM
@* ═══════════════════════════════════════════════════════════════════
   _BatchPerformanceMap — خريطة أداء الدفعة
   المحتوى الرئيسي: Radar chart (5 أبعاد) + Donut (توزيع محاولات)
   على يسار: 5 KPI stats رأسية مدمجة مع الراداروثيقة الترابط
═══════════════════════════════════════════════════════════════════ *@
@{
    var score  = Model?.AvgScore ?? 0;
    var weak   = Model?.WeaknessPercentage ?? 0;
    var correct= Model?.CorrectAttempts ?? 0;
    var wrong  = Model?.WrongAttempts ?? 0;

    // Derive 5 radar dimensions from available data
    var stableCount  = Model?.Students?.Count(s => s.RiskLevel == "مستقر") ?? 0;
    var totalStu     = Math.Max(1, Model?.Students?.Count ?? 1);
    var stablePct    = Math.Round((double)stableCount / totalStu * 100, 1);
    var instAvg      = (Model?.Instructors?.Any() == true)
                       ? Math.Round(Model!.Instructors.Average(i => i.AvgScore), 1)
                       : 0.0;
    var contentSafe  = Math.Round(Math.Max(0, 100 - weak), 1);
    var qSafety      = Math.Round(Math.Max(0,
                           100 - (Model?.HighRiskQuestionsCount ?? 0) * 4.0), 1);
}
<style>
    .pm-wrap {
        display:               grid;
        grid-template-columns: 240px 1fr 1fr;
        gap:                   var(--gap);
        margin-bottom:         var(--gap);
    }

    /* ── Left: KPI column ── */
    .pm-kpi-col {
        display:        flex;
        flex-direction: column;
        gap:            10px;
    }
    .pm-kpi-item {
        background:    var(--surface);
        border:        1.5px solid var(--border);
        border-radius: var(--r-sm);
        padding:       14px 16px;
        display:       flex;
        align-items:   center;
        gap:           12px;
        transition:    transform .15s, box-shadow .15s;
        position:      relative;
        overflow:      hidden;
    }
    .pm-kpi-item:hover { transform:translateY(-2px); box-shadow:0 6px 20px rgba(0,0,0,.08); }
    .pm-kpi-item::before {
        content:       '';
        position:      absolute;
        top:0; right:0; bottom:0;
        width:         3px;
        border-radius: 0 var(--r-sm) var(--r-sm) 0;
        background:    var(--accent, #e2e8f0);
    }
    .pm-kpi-ico {
        width:36px; height:36px; border-radius:10px;
        display:flex; align-items:center; justify-content:center;
        font-size:16px; flex-shrink:0;
    }
    .pm-kpi-val  { font-size:18px; font-weight:900; line-height:1; }
    .pm-kpi-lbl  { font-size:11.5px; color:var(--muted); font-weight:700; margin-top:2px; }

    /* ── Center: Radar chart ── */
    .pm-radar-card {
        background:    var(--surface);
        border:        1.5px solid var(--border);
        border-radius: var(--r);
        padding:       22px 24px;
        display:       flex;
        flex-direction:column;
        gap:           10px;
    }
    .pm-card-hd {
        display:flex; align-items:center; gap:8px;
        font-size:13.5px; font-weight:800; color:var(--text);
    }
    .pm-card-hd i { color:var(--primary); }
    .pm-card-sub  { font-size:12px; color:var(--muted); margin-bottom:4px; }
    .pm-chart-area { flex:1; min-height:240px; position:relative; }

    /* ── Right: Attempts donut ── */
    .pm-donut-card {
        background:    var(--surface);
        border:        1.5px solid var(--border);
        border-radius: var(--r);
        padding:       22px 24px;
        display:       flex;
        flex-direction:column;
        gap:           14px;
    }
    .pm-donut-area {
        flex:1; display:flex;
        flex-direction:column; align-items:center;
        justify-content:center; gap:16px;
    }
    .pm-legend {
        width:100%;
        display:flex; flex-direction:column; gap:10px;
    }
    .pm-legend-row {
        display:flex; align-items:center; gap:10px;
        padding:10px 12px;
        border-radius:8px;
        border:1px solid var(--border);
        background:#fafafa;
    }
    .pm-legend-dot { width:10px;height:10px;border-radius:50%;flex-shrink:0; }
    .pm-legend-lbl { flex:1; font-size:13px; color:var(--muted); font-weight:600; }
    .pm-legend-val { font-size:16px; font-weight:900; }
    .pm-total-row  {
        display:flex; justify-content:space-between; align-items:center;
        padding-top:10px; border-top:1px solid var(--border);
        font-size:13px; color:var(--muted); font-weight:600;
    }
    .pm-total-row strong { font-size:16px; color:var(--text); }

    @@media (max-width:1100px) {
        .pm-wrap { grid-template-columns: 1fr 1fr; }
        .pm-kpi-col { grid-column:1/-1; flex-direction:row; flex-wrap:wrap; }
        .pm-kpi-item { flex:1; min-width:140px; }
    }
    @@media (max-width:640px) {
        .pm-wrap { grid-template-columns:1fr; }
        .pm-kpi-col { grid-column:1; }
    }
</style>

<div class="bpd-inner">
    <div class="pm-wrap">

        @* ── KPI column ── *@
        <div class="pm-kpi-col">

            @{
                void KpiItem(string ico, string val, string lbl, string colorHex, string bgHex) { }
            }

            <div class="pm-kpi-item" style="--accent:@(score >= 70 ? "#22c55e" : score >= 50 ? "#f59e0b" : "#ef4444");">
                <div class="pm-kpi-ico" style="background:@(score >= 70 ? "#f0fdf4" : score >= 50 ? "#fffbeb" : "#fef2f2");color:@(score >= 70 ? "#16a34a" : score >= 50 ? "#d97706" : "#dc2626");">
                    <i class="bi bi-bar-chart-fill"></i>
                </div>
                <div>
                    <div class="pm-kpi-val" style="color:@(score >= 70 ? "#16a34a" : score >= 50 ? "#d97706" : "#dc2626");">@score.ToString("0.#")%</div>
                    <div class="pm-kpi-lbl">متوسط الأداء</div>
                </div>
            </div>

            <div class="pm-kpi-item" style="--accent:@(weak >= 60 ? "#ef4444" : weak >= 40 ? "#f59e0b" : "#22c55e");">
                <div class="pm-kpi-ico" style="background:#fef2f2;color:#dc2626;">
                    <i class="bi bi-percent"></i>
                </div>
                <div>
                    <div class="pm-kpi-val" style="color:@(weak >= 60 ? "#dc2626" : weak >= 40 ? "#d97706" : "#16a34a");">@weak.ToString("0.#")%</div>
                    <div class="pm-kpi-lbl">متوسط الضعف</div>
                </div>
            </div>

            <div class="pm-kpi-item" style="--accent:#14b8a6;">
                <div class="pm-kpi-ico" style="background:#f0fdfa;color:#0d9488;">
                    <i class="bi bi-person-check-fill"></i>
                </div>
                <div>
                    <div class="pm-kpi-val" style="color:#0d9488;">@stablePct.ToString("0.#")%</div>
                    <div class="pm-kpi-lbl">نسبة المستقرين</div>
                </div>
            </div>

            <div class="pm-kpi-item" style="--accent:#8b5cf6;">
                <div class="pm-kpi-ico" style="background:#f5f3ff;color:#7c3aed;">
                    <i class="bi bi-person-badge-fill"></i>
                </div>
                <div>
                    <div class="pm-kpi-val" style="color:#7c3aed;">@instAvg.ToString("0.#")%</div>
                    <div class="pm-kpi-lbl">متوسط المدربين</div>
                </div>
            </div>

            <div class="pm-kpi-item" style="--accent:#3b82f6;">
                <div class="pm-kpi-ico" style="background:#eff6ff;color:#2563eb;">
                    <i class="bi bi-list-check"></i>
                </div>
                <div>
                    <div class="pm-kpi-val" style="color:#2563eb;">@(Model?.TotalAttempts ?? 0)</div>
                    <div class="pm-kpi-lbl">إجمالي المحاولات</div>
                </div>
            </div>
        </div>

        @* ── Radar Chart ── *@
        <div class="pm-radar-card">
            <div class="pm-card-hd">
                <i class="bi bi-graph-up-arrow"></i>
                بصمة أداء الدفعة
            </div>
            <div class="pm-card-sub">5 أبعاد تُحدد الصحة الكاملة للدفعة</div>
            <div class="pm-chart-area">
                <canvas id="radarChart"></canvas>
            </div>
        </div>

        @* ── Donut Chart ── *@
        <div class="pm-donut-card">
            <div class="pm-card-hd">
                <i class="bi bi-pie-chart-fill"></i>
                توزيع المحاولات
            </div>
            <div class="pm-card-sub">صحيح مقابل خطأ من إجمالي @(Model?.TotalAttempts ?? 0) محاولة</div>
            <div class="pm-donut-area">
                <canvas id="attemptsDonut" width="160" height="160"></canvas>
                <div class="pm-legend">
                    <div class="pm-legend-row">
                        <div class="pm-legend-dot" style="background:#22c55e;"></div>
                        <div class="pm-legend-lbl">إجابات صحيحة</div>
                        <div class="pm-legend-val" style="color:#16a34a;">@correct</div>
                    </div>
                    <div class="pm-legend-row">
                        <div class="pm-legend-dot" style="background:#ef4444;"></div>
                        <div class="pm-legend-lbl">إجابات خاطئة</div>
                        <div class="pm-legend-val" style="color:#dc2626;">@wrong</div>
                    </div>
                    <div class="pm-total-row">
                        <span>الإجمالي</span>
                        <strong>@(Model?.TotalAttempts ?? 0)</strong>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
(function () {
    if (typeof Chart === 'undefined') return;

    /* ── Radar ── */
    var radarCtx = document.getElementById('radarChart');
    if (radarCtx) {
        var radarData = [
            @score.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture),
            @contentSafe.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture),
            @stablePct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture),
            @qSafety.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture),
            @instAvg.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)
        ];
        new Chart(radarCtx, {
            type: 'radar',
            data: {
                labels: ['متوسط الأداء', 'سلامة المحتوى', 'الطلاب المستقرون', 'جودة الأسئلة', 'كفاءة المدربين'],
                datasets: [{
                    label:           'مستوى الدفعة',
                    data:            radarData,
                    backgroundColor: 'rgba(59,130,246,.12)',
                    borderColor:     '#3b82f6',
                    borderWidth:     2.5,
                    pointBackgroundColor: '#3b82f6',
                    pointBorderColor:     '#fff',
                    pointBorderWidth:     2,
                    pointRadius:          5,
                    pointHoverRadius:     7
                }, {
                    label:           'المستهدف المثالي',
                    data:            [100,100,100,100,100],
                    backgroundColor: 'transparent',
                    borderColor:     'rgba(100,116,139,.2)',
                    borderWidth:     1.5,
                    borderDash:      [5,4],
                    pointRadius:     0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    r: {
                        min: 0, max: 100,
                        ticks: {
                            display:   true,
                            stepSize:  25,
                            font:      { family:'Cairo', size:10 },
                            color:     '#94a3b8',
                            backdropColor:'transparent'
                        },
                        grid:        { color:'rgba(226,232,240,.8)' },
                        angleLines:  { color:'rgba(226,232,240,.8)' },
                        pointLabels: {
                            font:  { family:'Cairo', size:11.5, weight:'700' },
                            color: '#374151'
                        }
                    }
                },
                plugins: {
                    legend: { display:false },
                    tooltip: {
                        rtl: true,
                        callbacks: { label: function(c) { return ' '+c.dataset.label+': '+c.parsed.r.toFixed(1)+'%'; } }
                    }
                },
                animation: { duration:900 }
            }
        });
    }

    /* ── Donut ── */
    var donutCtx = document.getElementById('attemptsDonut');
    if (donutCtx) {
        new Chart(donutCtx, {
            type: 'doughnut',
            data: {
                labels: ['صحيح', 'خطأ'],
                datasets: [{
                    data:            [@correct, @wrong],
                    backgroundColor: ['#22c55e','#ef4444'],
                    borderColor:     ['#fff','#fff'],
                    borderWidth:     3,
                    hoverOffset:     6
                }]
            },
            options: {
                cutout:   '72%',
                responsive:false,
                plugins: {
                    legend: { display:false },
                    tooltip: {
                        rtl:true,
                        callbacks:{ label:function(c){ return ' '+c.label+': '+c.parsed.toLocaleString('ar-SA'); } }
                    }
                },
                animation:{ duration:900 }
            }
        });
    }
}());
</script>
