@model QdratNew.ViewModels.Admin.Analytics.BatchPerformanceDetailsVM
@* ═══════════════════════════════════════════════════════════════════
   _BatchStudentsTable — Students risk table + stacked bar + donut
   Identity: Violet/indigo accent · Chart: Risk donut + stacked bar
   فلسفة: "الطالب هو الهدف النهائي — اعرف من يحتاج تدخلًا فوريًا"
═══════════════════════════════════════════════════════════════════ *@
@{
    var hasStu = Model?.Students != null && Model.Students.Any();

    int dangerCount = 0, medCount = 0, stableCount = 0, total = 0;
    if (hasStu)
    {
        dangerCount = Model!.Students.Count(x => x.RiskLevel == "خطر");
        medCount    = Model!.Students.Count(x => x.RiskLevel == "متوسط");
        stableCount = Model!.Students.Count(x => x.RiskLevel == "مستقر");
        total       = Model!.Students.Count;
    }
}
<style>
    .bst-section { margin-bottom: 24px; }
    .bst-card {
        background:    var(--bpd-surface);
        border:        1.5px solid var(--bpd-border);
        border-radius: var(--bpd-radius);
        padding:       26px 28px;
        box-shadow:    var(--bpd-shadow-sm);
    }
    .bst-hd-ico   { background: var(--bpd-violet-bg); color: var(--bpd-violet); }
    .bst-hd-title { color: var(--bpd-violet); }

    /* Risk distribution strip */
    .bst-dist-strip {
        background:    #f8fafc;
        border:        1.5px solid var(--bpd-border);
        border-radius: var(--bpd-radius-sm);
        padding:       12px 18px;
        display:       flex;
        align-items:   center;
        flex-wrap:     wrap;
        gap:           10px;
        margin-bottom: 18px;
    }
    .bst-dist-label { font-size: 12px; font-weight: 800; color: var(--bpd-muted); }
    .bst-dist-total { margin-inline-start: auto; font-size:12px; color:var(--bpd-muted); }

    /* Charts row */
    .bst-charts-row {
        display:   grid;
        grid-template-columns: 220px 1fr;
        gap:       20px;
        margin-bottom: 20px;
    }
    .bst-chart-panel {
        background:    #f8fafc;
        border:        1.5px solid var(--bpd-border);
        border-radius: var(--bpd-radius-sm);
        padding:       16px 18px;
    }
    .bst-chart-lbl {
        font-size:   12.5px;
        font-weight: 800;
        color:       var(--bpd-muted);
        margin-bottom:12px;
        display:     flex;
        align-items: center;
        gap:         6px;
    }
    .bst-chart-lbl i { color: var(--bpd-violet); }
    .bst-donut-body {
        display:         flex;
        flex-direction:  column;
        align-items:     center;
        gap:             10px;
    }
    .bst-donut-legend {
        display:       flex;
        flex-direction:column;
        gap:           6px;
        width:         100%;
    }
    .bst-donut-leg-row {
        display:     flex;
        align-items: center;
        gap:         7px;
        font-size:   12.5px;
    }
    .bst-donut-dot { width:9px;height:9px;border-radius:50%;flex-shrink:0; }
    .bst-donut-lbl { flex:1; color:var(--bpd-muted); font-weight:600; }
    .bst-donut-cnt { font-weight:900; color:var(--bpd-text); }

    /* Avatar */
    .bst-avatar {
        width:          32px; height: 32px;
        border-radius:  50%;
        background:     var(--bpd-violet-bg);
        color:          var(--bpd-violet);
        display:        flex;
        align-items:    center;
        justify-content:center;
        font-size:      12px;
        font-weight:    900;
        flex-shrink:    0;
        border:         2px solid var(--bpd-violet-mid);
    }

    @@media (max-width: 768px) {
        .bst-charts-row { grid-template-columns: 1fr; }
    }
</style>

<div class="bst-section">
    <div class="bst-card">

        <div class="bpd-sec-hd">
            <div class="bpd-sec-ico bst-hd-ico"><i class="bi bi-people-fill"></i></div>
            <div>
                <div class="bpd-sec-title bst-hd-title">تحليل الطلاب داخل الدفعة</div>
            </div>
        </div>
        <div class="bpd-sec-sub">أداء كل طالب في الاختبارات والواجبات والحضور مع تصنيف مستوى الخطورة</div>

        @if (!hasStu)
        {
            <div class="bpd-empty">
                <i class="bi bi-person-slash"></i>
                <div class="bpd-empty-t">لا توجد بيانات طلاب لهذه الدفعة</div>
                <div class="bpd-empty-s">لا توجد محاولات مسجلة</div>
            </div>
        }
        else
        {
            @* ── Risk summary strip ── *@
            <div class="bst-dist-strip">
                <div class="bst-dist-label">توزيع الخطورة:</div>
                <span class="bpd-badge badge-d">
                    <i class="bi bi-exclamation-triangle-fill"></i> خطر: @dangerCount
                </span>
                <span class="bpd-badge badge-w">
                    <i class="bi bi-dash-circle-fill"></i> متوسط: @medCount
                </span>
                <span class="bpd-badge badge-s">
                    <i class="bi bi-check-circle-fill"></i> مستقر: @stableCount
                </span>
                <div class="bst-dist-total">الإجمالي: <strong>@total</strong></div>
            </div>

            @* ── Charts Row ── *@
            <div class="bst-charts-row">

                @* Donut — risk distribution *@
                <div class="bst-chart-panel">
                    <div class="bst-chart-lbl">
                        <i class="bi bi-pie-chart-fill"></i> توزيع الخطورة
                    </div>
                    <div class="bst-donut-body">
                        <canvas id="riskDonut" width="140" height="140"></canvas>
                        <div class="bst-donut-legend">
                            <div class="bst-donut-leg-row">
                                <div class="bst-donut-dot" style="background:#ef4444;"></div>
                                <div class="bst-donut-lbl">خطر</div>
                                <div class="bst-donut-cnt" style="color:#dc2626;">@dangerCount</div>
                            </div>
                            <div class="bst-donut-leg-row">
                                <div class="bst-donut-dot" style="background:#f59e0b;"></div>
                                <div class="bst-donut-lbl">متوسط</div>
                                <div class="bst-donut-cnt" style="color:#d97706;">@medCount</div>
                            </div>
                            <div class="bst-donut-leg-row">
                                <div class="bst-donut-dot" style="background:#22c55e;"></div>
                                <div class="bst-donut-lbl">مستقر</div>
                                <div class="bst-donut-cnt" style="color:#16a34a;">@stableCount</div>
                            </div>
                        </div>
                    </div>
                </div>

                @* Stacked bar — top 15 students score breakdown *@
                <div class="bst-chart-panel">
                    <div class="bst-chart-lbl">
                        <i class="bi bi-bar-chart-steps"></i>
                        مقارنة أداء الطلاب (اختبار / واجب / حضور)
                    </div>
                    <canvas id="stuStackedBar" style="max-height:220px;width:100%;"></canvas>
                </div>

            </div>

            @* ── Table ── *@
            <div class="table-responsive bpd-tbl-wrap">
                <table class="table bpd-tbl text-center">
                    <thead>
                        <tr>
                            <th style="text-align:right;min-width:160px;">الطالب</th>
                            <th style="min-width:110px;">الاختبارات</th>
                            <th style="min-width:110px;">الواجبات</th>
                            <th style="min-width:110px;">الحضور</th>
                            <th style="min-width:90px;">الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model!.Students)
                        {
                            var eColor = s.ExamScore    >= 70 ? "var(--bpd-success)" : s.ExamScore    >= 50 ? "var(--bpd-warning)" : "var(--bpd-danger)";
                            var hColor = s.HomeworkScore>= 70 ? "var(--bpd-success)" : s.HomeworkScore>= 50 ? "var(--bpd-warning)" : "var(--bpd-danger)";
                            var aColor = s.Attendance   >= 70 ? "var(--bpd-success)" : s.Attendance   >= 50 ? "var(--bpd-warning)" : "var(--bpd-danger)";
                            var rBadge = s.RiskLevel == "خطر" ? "badge-d" : s.RiskLevel == "متوسط" ? "badge-w" : "badge-s";
                            var rIcon  = s.RiskLevel == "خطر" ? "bi-exclamation-triangle-fill" : s.RiskLevel == "متوسط" ? "bi-dash-circle-fill" : "bi-check-circle-fill";
                            <tr>
                                <td style="text-align:right;">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="bst-avatar">
                                            @(string.IsNullOrWhiteSpace(s.StudentName) ? "؟" : s.StudentName[0].ToString())
                                        </div>
                                        <span style="font-weight:800;font-size:13px;">@s.StudentName</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="bpd-score" style="color:@eColor;">@s.ExamScore.ToString("0.#")%</div>
                                    <div class="bpd-bar"><div class="bpd-bar-fill" style="width:@s.ExamScore%;background:@eColor;"></div></div>
                                </td>
                                <td>
                                    <div class="bpd-score" style="color:@hColor;">@s.HomeworkScore.ToString("0.#")%</div>
                                    <div class="bpd-bar"><div class="bpd-bar-fill" style="width:@s.HomeworkScore%;background:@hColor;"></div></div>
                                </td>
                                <td>
                                    <div class="bpd-score" style="color:@aColor;">@s.Attendance.ToString("0.#")%</div>
                                    <div class="bpd-bar"><div class="bpd-bar-fill" style="width:@s.Attendance%;background:@aColor;"></div></div>
                                </td>
                                <td>
                                    <span class="bpd-badge @rBadge">
                                        <i class="bi @rIcon"></i> @s.RiskLevel
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (hasStu)
{
    @* build JS arrays for stacked bar (max 15 students) *@
    var top15 = Model!.Students.Take(15).ToList();

    <script>
    (function () {
        /* ── Risk donut ── */
        var donutCtx = document.getElementById('riskDonut');
        if (donutCtx && typeof Chart !== 'undefined') {
            new Chart(donutCtx, {
                type: 'doughnut',
                data: {
                    labels: ['خطر', 'متوسط', 'مستقر'],
                    datasets: [{
                        data:            [@dangerCount, @medCount, @stableCount],
                        backgroundColor: ['#ef4444','#f59e0b','#22c55e'],
                        borderColor:     ['#fff','#fff','#fff'],
                        borderWidth:     3,
                        hoverOffset:     5
                    }]
                },
                options: {
                    cutout:   '65%',
                    responsive: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            rtl: true,
                            callbacks: {
                                label: function(c) { return ' ' + c.label + ': ' + c.parsed + ' طالب'; }
                            }
                        }
                    },
                    animation: { duration: 900 }
                }
            });
        }

        /* ── Stacked bar ── */
        var barCtx = document.getElementById('stuStackedBar');
        if (barCtx && typeof Chart !== 'undefined') {
            var stuLabels = [
                @Html.Raw(string.Join(",", top15.Select(s =>
                    "'" + (s.StudentName ?? "—").Replace("'","\'").Replace("\\","\\\\") + "'")))
            ];
            var examData = [
                @Html.Raw(string.Join(",", top15.Select(s =>
                    s.ExamScore.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))))
            ];
            var hwData = [
                @Html.Raw(string.Join(",", top15.Select(s =>
                    s.HomeworkScore.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))))
            ];
            var attData = [
                @Html.Raw(string.Join(",", top15.Select(s =>
                    s.Attendance.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))))
            ];

            new Chart(barCtx, {
                type: 'bar',
                data: {
                    labels: stuLabels,
                    datasets: [
                        {
                            label:           'الاختبارات',
                            data:            examData,
                            backgroundColor: 'rgba(124,58,237,.75)',
                            borderRadius:    { topLeft: 4, topRight: 4 },
                            borderSkipped:   false
                        },
                        {
                            label:           'الواجبات',
                            data:            hwData,
                            backgroundColor: 'rgba(8,145,178,.65)',
                            borderRadius:    0,
                            borderSkipped:   false
                        },
                        {
                            label:           'الحضور',
                            data:            attData,
                            backgroundColor: 'rgba(34,197,94,.6)',
                            borderRadius:    { bottomLeft: 4, bottomRight: 4 },
                            borderSkipped:   false
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display:  true,
                            position: 'top',
                            align:    'start',
                            labels: {
                                font:      { family: 'Cairo', size: 12 },
                                boxWidth:  12,
                                boxHeight: 12,
                                padding:   14
                            }
                        },
                        tooltip: {
                            rtl: true,
                            callbacks: {
                                label: function(c) { return ' ' + c.dataset.label + ': ' + c.parsed.y.toFixed(1) + '%'; }
                            }
                        }
                    },
                    scales: {
                        x: {
                            stacked: false,
                            grid:    { display: false },
                            ticks: {
                                font:  { family: 'Cairo', size: 10 },
                                color: '#64748b',
                                maxRotation: 45
                            }
                        },
                        y: {
                            min: 0, max: 100,
                            stacked: false,
                            grid:    { color: '#f1f5f9' },
                            ticks: {
                                font:     { family: 'Cairo', size: 11 },
                                color:    '#94a3b8',
                                callback: function(v) { return v + '%'; }
                            }
                        }
                    },
                    animation: { duration: 900 }
                }
            });
        }
    }());
    </script>
}
