@model QdratNew.ViewModels.Admin.Analytics.BatchPerformanceDetailsVM
@* ═══════════════════════════════════════════════════════════════════
   _BatchCommandBar — Sticky 60px top navigation strip
   NO hero banners. Just identity + wayfinding + status in one line.
   هذا ليس بانر — هو شريط قيادة دائم.
═══════════════════════════════════════════════════════════════════ *@
@using QdratNew.Extensions
@using QdratNew.ViewModels.Admin.Shared
@{
    var riskClass = (Model?.RiskLevel ?? "") switch
    {
        "خطر عالي جدًا" or "خطر عالي" => "cb-risk-danger",
        "متوسط"                         => "cb-risk-warning",
        _                               => "cb-risk-stable"
    };

    var bridgeCtx = new AnalyticsDecisionBridgeContext
    {
        BatchId      = Model?.BatchId,
        CurriculumId = Model?.CurriculumId,
        InstructorId = Model?.InstructorId,
        SourceMetric = "batch-performance",
        SourcePage   = "BatchPerformanceDetails",
        ReturnUrl    = Url.Action("BatchPerformanceDetails", "Analytics", new
        {
            area         = "Admin",
            batchId      = Model?.BatchId,
            curriculumId = Model?.CurriculumId,
            instructorId = Model?.InstructorId
        }) ?? ""
    };
}
<style>
    .cb-bar {
        position:   fixed;
        top:        0; right: 0; left: 0;
        height:     var(--topbar-h);
        background: rgba(255,255,255,.92);
        backdrop-filter: saturate(180%) blur(12px);
        -webkit-backdrop-filter: saturate(180%) blur(12px);
        border-bottom: 1px solid var(--border);
        z-index:    1000;
        display:    flex;
        align-items:center;
        padding:    0 24px;
        gap:        16px;
    }
    /* Breadcrumb */
    .cb-crumb {
        display:     flex;
        align-items: center;
        gap:         6px;
        font-size:   13px;
        color:       var(--muted);
        flex-shrink: 0;
    }
    .cb-crumb a { color: var(--muted); text-decoration:none; font-weight:700; transition:color .15s; }
    .cb-crumb a:hover { color: var(--text); }
    .cb-crumb-sep { color: #cbd5e1; }

    /* Divider */
    .cb-divider { width:1px; height:24px; background:var(--border); flex-shrink:0; }

    /* Batch identity */
    .cb-identity { display:flex; align-items:center; gap:10px; flex:1; min-width:0; }
    .cb-batch-icon {
        width:32px; height:32px; border-radius:9px;
        background: #eff6ff; color: #3b82f6;
        display:flex; align-items:center; justify-content:center;
        font-size:15px; flex-shrink:0;
    }
    .cb-batch-name {
        font-size:   15px; font-weight:900; color:var(--text);
        white-space: nowrap; overflow:hidden; text-overflow:ellipsis;
    }
    .cb-course {
        font-size:12px; color:var(--muted); font-weight:600;
        white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
    }

    /* Risk pill */
    .cb-risk-pill {
        display:       inline-flex; align-items:center; gap:6px;
        padding:       5px 14px; border-radius:50px;
        font-size:     12.5px; font-weight:800;
        white-space:   nowrap; flex-shrink:0;
        border:        1.5px solid;
    }
    .cb-risk-danger  { background:#fef2f2; color:#dc2626; border-color:#fecaca; }
    .cb-risk-warning { background:#fffbeb; color:#d97706; border-color:#fde68a; }
    .cb-risk-stable  { background:#f0fdf4; color:#16a34a; border-color:#bbf7d0; }
    .cb-risk-danger .cb-pulse  { animation: cb-blink 1.4s ease-in-out infinite; }
    .cb-pulse { width:7px; height:7px; border-radius:50%; flex-shrink:0; }
    @@keyframes cb-blink { 0%,100%{opacity:1} 50%{opacity:.3} }

    /* Back button */
    .cb-back {
        display:inline-flex; align-items:center; gap:6px;
        background:none; border:1.5px solid var(--border);
        border-radius:8px; padding:6px 14px;
        font-size:13px; font-weight:700; color:var(--muted);
        text-decoration:none; transition:all .2s; flex-shrink:0;
        font-family:inherit;
    }
    .cb-back:hover { border-color:#94a3b8; color:var(--text); }
    .cb-lab {
        display:inline-flex; align-items:center; gap:6px;
        background:#111827; border:1.5px solid #111827;
        border-radius:8px; padding:6px 14px;
        font-size:13px; font-weight:800; color:#fff;
        text-decoration:none; transition:all .2s; flex-shrink:0;
        font-family:inherit;
    }
    .cb-lab:hover { background:#0f172a; border-color:#0f172a; color:#fff; }

    /* Decision bridge button */
    .cb-decision-btn {
        display:     inline-flex;
        align-items: center;
        flex-shrink: 0;
        font-family: inherit;
        border-radius: 8px;
    }

    @@media (max-width:768px) {
        .cb-crumb, .cb-divider, .cb-course { display:none; }
        .cb-bar { padding:0 14px; gap:10px; }
        .cb-lab span { display:none; }
        .cb-decision-btn span { display:none; }
    }
</style>

<nav class="cb-bar" aria-label="شريط التنقل">

    @* Breadcrumb *@
    <div class="cb-crumb">
        <a asp-area="Admin" asp-controller="Analytics" asp-action="AdvancedDashboard">
            <i class="bi bi-grid-3x3-gap-fill me-1"></i>التحليل المتقدم
        </a>
        <span class="cb-crumb-sep">/</span>
        <span style="color:var(--text);font-weight:800;">تحليل الدفعة</span>
    </div>

    <div class="cb-divider"></div>

    @* Batch identity *@
    <div class="cb-identity">
        <div class="cb-batch-icon"><i class="bi bi-layers-fill"></i></div>
        <div style="min-width:0;">
            <div class="cb-batch-name">@(Model?.BatchName ?? "—")</div>
            <div class="cb-course"><i class="bi bi-book me-1"></i>@(Model?.CourseName ?? "—")</div>
        </div>
    </div>

    @* Risk pill *@
    <div class="cb-risk-pill @riskClass">
        <div class="cb-pulse" style="background:var(--risk);"></div>
        @(Model?.RiskLevel ?? "—")
    </div>

    @if (User.IsInRole("Owner") || User.IsInRole("Developer"))
    {
        <a asp-area="Admin"
           asp-controller="DecisionLab"
           asp-action="BatchAnalysis"
           asp-route-batchId="@Model?.BatchId"
           asp-route-curriculumId="@Model?.CurriculumId"
           class="cb-lab">
            <i class="bi bi-flask"></i>
            <span>DecisionLab</span>
        </a>

        @if (Model?.BatchId > 0)
        {
            <a href="@Url.ToDecisionLabUrl(bridgeCtx)"
               class="btn btn-sm btn-outline-primary cb-decision-btn fw-bold">
                <i class="fas fa-brain me-1"></i>
                <span>مختبر القرار ←</span>
            </a>
        }
    }

    @* Back *@
    <a asp-area="Admin" asp-controller="Analytics" asp-action="AdvancedDashboard"
       asp-route-curriculumId="@Model?.CurriculumId"
       asp-route-batchId="@Model?.BatchId"
       asp-route-instructorId="@Model?.InstructorId"
       class="cb-back">
        <i class="bi bi-arrow-right"></i>
        <span class="d-none d-md-inline">رجوع</span>
    </a>
</nav>
