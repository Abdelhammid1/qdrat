@model QdratNew.ViewModels.Admin.Analytics.BatchPerformanceDetailsVM
@* ═══════════════════════════════════════════════════════════════════
   _BatchHeader — Hero banner with batch identity & navigation
   Identity: Dark navy gradient · فلسفة: "من أنت؟ وإلى أين؟"
═══════════════════════════════════════════════════════════════════ *@
<style>
    .bhd-hero {
        background:    linear-gradient(135deg, #0f172a 0%, #1e3a5f 55%, #1e40af 100%);
        border-radius: var(--bpd-radius);
        padding:       30px 36px;
        color:         #fff;
        position:      relative;
        overflow:      hidden;
        margin-bottom: 24px;
        box-shadow:    0 16px 40px rgba(30,64,175,.25);
    }
    .bhd-hero::before {
        content:  '';
        position: absolute;
        inset:    0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/svg%3E");
        pointer-events: none;
    }
    .bhd-hero::after {
        content:  '';
        position: absolute;
        inset-inline-end: -60px;
        top:      -60px;
        width:    220px;
        height:   220px;
        border-radius: 50%;
        background: rgba(255,255,255,.04);
        pointer-events: none;
    }
    .bhd-eyebrow {
        display:       inline-flex;
        align-items:   center;
        gap:           7px;
        background:    rgba(255,255,255,.1);
        border:        1px solid rgba(255,255,255,.18);
        border-radius: 8px;
        padding:       4px 14px;
        font-size:     13px;
        font-weight:   700;
        color:         #93c5fd;
        margin-bottom: 14px;
    }
    .bhd-icon-wrap {
        width:          56px;
        height:         56px;
        background:     rgba(255,255,255,.12);
        border:         1px solid rgba(255,255,255,.2);
        border-radius:  16px;
        display:        flex;
        align-items:    center;
        justify-content:center;
        font-size:      26px;
        flex-shrink:    0;
    }
    .bhd-title {
        font-size:   26px;
        font-weight: 900;
        margin:      0 0 4px;
        line-height: 1.2;
    }
    .bhd-sub {
        color:       #93c5fd;
        font-size:   14.5px;
        margin:      0;
        line-height: 1.5;
    }
    .bhd-back {
        display:       inline-flex;
        align-items:   center;
        gap:           7px;
        background:    rgba(255,255,255,.12);
        color:         #fff;
        border:        1.5px solid rgba(255,255,255,.22);
        border-radius: var(--bpd-radius-sm);
        padding:       10px 20px;
        font-size:     14px;
        font-weight:   700;
        text-decoration: none;
        backdrop-filter: blur(4px);
        transition:    background .2s, border-color .2s;
        white-space:   nowrap;
    }
    .bhd-back:hover {
        background:   rgba(255,255,255,.22);
        border-color: rgba(255,255,255,.38);
        color:        #fff;
    }
    .bhd-meta-chips {
        display:    flex;
        flex-wrap:  wrap;
        gap:        8px;
        margin-top: 14px;
    }
    .bhd-chip {
        display:       inline-flex;
        align-items:   center;
        gap:           5px;
        background:    rgba(255,255,255,.08);
        border:        1px solid rgba(255,255,255,.14);
        border-radius: 6px;
        padding:       4px 12px;
        font-size:     12.5px;
        color:         rgba(255,255,255,.75);
        font-weight:   600;
    }
    @@media (max-width: 768px) {
        .bhd-hero  { padding: 22px 18px; }
        .bhd-title { font-size: 20px; }
        .bhd-back  { width: 100%; justify-content: center; margin-top: 14px; }
    }
</style>

<div class="bhd-hero">
    <div class="row align-items-center g-3 position-relative">
        <div class="col-lg-8">
            <div class="bhd-eyebrow">
                <i class="bi bi-layers-fill"></i> تحليل أداء دفعة
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="bhd-icon-wrap">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <div>
                    <h1 class="bhd-title">@(Model?.BatchName ?? "—")</h1>
                    <p class="bhd-sub">
                        <i class="bi bi-book me-1"></i>@(Model?.CourseName ?? "—")
                        &nbsp;·&nbsp; نافذة قرار شاملة للدروس والأسئلة والطلاب والمدربين
                    </p>
                </div>
            </div>
            <div class="bhd-meta-chips">
                <span class="bhd-chip">
                    <i class="bi bi-people-fill"></i>
                    @(Model?.StudentsCount ?? 0) طالب
                </span>
                <span class="bhd-chip">
                    <i class="bi bi-person-badge-fill"></i>
                    @(Model?.Instructors?.Count ?? 0) مدرب
                </span>
                <span class="bhd-chip">
                    <i class="bi bi-book-half"></i>
                    @(Model?.CriticalLessonsCount ?? 0) درس حرج
                </span>
                <span class="bhd-chip">
                    <i class="bi bi-list-check"></i>
                    @(Model?.TotalAttempts ?? 0) محاولة
                </span>
            </div>
        </div>
        <div class="col-lg-4 text-lg-end">
            <a asp-area="Admin"
               asp-controller="Analytics"
               asp-action="AdvancedDashboard"
               class="bhd-back">
                <i class="bi bi-arrow-right"></i>
                رجوع للوحة التحليل
            </a>
        </div>
    </div>
</div>
