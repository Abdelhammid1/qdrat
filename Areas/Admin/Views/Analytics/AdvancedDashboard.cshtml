                <i class="bi bi-person-fill-exclamation"></i> تفاصيل الحالات
            </a>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════════
   OFFCANVAS 5 — دروس عالية الخطورة
   ═══════════════════════════════════════════════════════════════════ *@

<div class="offcanvas offcanvas-end qd-offcanvas" tabindex="-1" id="highRiskOffcanvas" aria-labelledby="highRiskOffcanvasLabel" data-bs-scroll="true">
    <div class="offcanvas-header" style="background:linear-gradient(135deg,#7f1d1d,#b91c1c)">
        <div>
            <h5 class="offcanvas-title" id="highRiskOffcanvasLabel" style="font-size:17px;font-weight:800">
                <i class="bi bi-exclamation-diamond-fill me-2"></i> دروس عالية الخطورة
            </h5>
            <div style="font-size:13px;opacity:.8;margin-top:3px">@(Model?.HighRiskCount ?? 0) درس بنسبة ضعف ≥ 70%</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div class="qd-oc-summary">
            <span class="qd-badge badge-danger"><i class="bi bi-exclamation-diamond-fill me-1"></i>خطر عالي ≥ 70%: @highRiskLessons.Count(l => l.WeakPercentage >= 70)</span>
            <span class="qd-badge badge-warning"><i class="bi bi-exclamation-triangle me-1"></i>متوسط 50–69%: @(Model?.Lessons?.Count(l => l.WeakPercentage >= 50 && l.WeakPercentage < 70) ?? 0)</span>
        </div>
        <div class="qd-oc-list">
            @if (!highRiskLessons.Any())
            {
                <div class="qd-empty">
                    <i class="bi bi-shield-check" style="color:var(--q-success);opacity:.6"></i>
                    <div class="qd-empty-title" style="color:var(--q-success)">لا توجد دروس عالية الخطورة</div>
                    <div class="qd-empty-sub">جميع الدروس ضمن النسب المقبولة</div>
                </div>
            }
            else
            {
                @foreach (var lesson in highRiskLessons)
                {
                    var weakColor = lesson.WeakPercentage >= 85 ? "var(--q-danger)" : "var(--q-warning)";
                    var weakBadge = lesson.WeakPercentage >= 85 ? "badge-danger" : "badge-warning";
                    <div class="qd-oc-item" style="border-right:4px solid @weakColor">
                        <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
                            <div style="flex:1;min-width:0">
                                <div class="qd-oc-item-title">@lesson.LessonName</div>
                                <div class="qd-oc-item-sub">
                                    @if (!string.IsNullOrEmpty(lesson.BatchName)) { <span><i class="bi bi-layers me-1"></i>@lesson.BatchName</span> }
                                    @if (!string.IsNullOrEmpty(lesson.InstructorName)) { <span class="ms-2"><i class="bi bi-person-badge me-1"></i>@lesson.InstructorName</span> }
                                </div>
                            </div>
                            <div style="font-size:20px;font-weight:900;color:@weakColor;flex-shrink:0">@Math.Round(lesson.WeakPercentage)%</div>
                        </div>
                        <div class="qd-oc-item-stats">
                            <span class="qd-badge @weakBadge"><i class="bi bi-arrow-down-circle-fill me-1"></i>نسبة الضعف: @Math.Round(lesson.WeakPercentage)%</span>
                            @if (lesson.AffectedStudents > 0)
                            {
                                <span class="qd-badge badge-primary"><i class="bi bi-people-fill me-1"></i>@lesson.AffectedStudents طالب متأثر</span>
                            }
                            @if (lesson.TotalAttempts > 0)
                            {
                                <span class="qd-badge badge-info"><i class="bi bi-clipboard-data me-1"></i>@lesson.TotalAttempts محاولة</span>
                            }
                        </div>
                        @if (lesson.BatchId.HasValue && (User.IsInRole("Owner") || User.IsInRole("Developer")))
                        {
                            var lessonBridgeCtx = new AnalyticsDecisionBridgeContext
                            {
                                BatchId      = lesson.BatchId,
                                CurriculumId = Model.SelectedCurriculumId,
                                SourceMetric = "high-risk-lesson",
                                SourcePage   = "AdvancedDashboard",
                                ReturnUrl    = Url.Action("AdvancedDashboard", "Analytics", new { area = "Admin", curriculumId = Model.SelectedCurriculumId, batchId = Model.SelectedBatchId, instructorId = Model.SelectedInstructorId }) ?? ""
                            };
                            var lessonBtnColor = lesson.WeakPercentage >= 85 ? "var(--q-danger)" : "var(--q-warning)";
                            <div class="mt-2 d-flex gap-2 flex-wrap">
                                <a href="@Url.ToDecisionLabUrl(lessonBridgeCtx)"
                                   class="qd-nav-btn"
                                   style="font-size:11px;padding:3px 9px;background:@lessonBtnColor;color:#fff;border-color:@lessonBtnColor;text-decoration:none;">
                                    <i class="bi bi-lightning-charge-fill"></i> اتخذ قراراً للدفعة
                                </a>
                                <a href="@Url.ToBatchAnalysisUrl(lessonBridgeCtx)"
                                   class="qd-nav-btn qd-nav-btn-secondary"
                                   style="font-size:11px;padding:3px 9px;text-decoration:none;">
                                    <i class="bi bi-bar-chart-line"></i> تحليل الدفعة
                                </a>
                            </div>
                        }
                    </div>
                }
            }
        </div>
        <div class="qd-oc-footer">
            <button type="button" class="qd-nav-btn qd-nav-btn-ghost" data-bs-dismiss="offcanvas">
                <i class="bi bi-x-lg"></i> إغلاق
            </button>
            <a class="qd-nav-btn qd-nav-btn-secondary"
               asp-area="Admin" asp-controller="Analytics" asp-action="MetricDecisionDetails" asp-route-metric="high-risk-lessons"
               asp-route-curriculumId="@Model?.SelectedCurriculumId" asp-route-batchId="@Model?.SelectedBatchId" asp-route-instructorId="@Model?.SelectedInstructorId">
                <i class="bi bi-graph-up"></i> تحليل القرار
            </a>
            <a class="qd-nav-btn qd-nav-btn-primary"
               asp-area="Admin" asp-controller="Analytics" asp-action="AdvancedDashboard"
               asp-route-curriculumId="@Model?.SelectedCurriculumId" asp-route-batchId="@Model?.SelectedBatchId" asp-route-instructorId="@Model?.SelectedInstructorId">
                <i class="bi bi-bar-chart-fill"></i> لوحة التحليلات
            </a>
        </div>
    </div>
</div>

} @* end @if (false) — offcanvas placeholder *@

@* ===================== SCRIPTS ===================== *@
<script>
    /* ── Chart instances ── */
    let riskChartInstance       = null;
    let lessonChartInstance     = null;
    let criticalChartInstance   = null;
    let radarChartInstance      = null;
    let instructorChartInstance = null;
    let studentDistInstance     = null;
    let batchRiskInstance       = null;

    /* ── Boot ── */
    document.addEventListener("DOMContentLoaded", function () {
        /* Auto-load dashboard content via AJAX on page load */
        loadAdvancedDashboard(1);

        /* tooltips */
        document.querySelectorAll('[data-bs-toggle-tooltip="tooltip"]').forEach(el => {
            new bootstrap.Tooltip(el, { trigger: 'hover', placement: el.dataset.bsPlacement || 'top' });
        });

        /* offcanvas focus */
        document.querySelectorAll('.offcanvas').forEach(oc => {
            oc.addEventListener('shown.bs.offcanvas', () => {
                const f = oc.querySelector('input, button, a, [tabindex="0"]');
                if (f) f.focus();
            });
        });

        /* pagination links */
        document.addEventListener("click", function (e) {
            const pageLink = e.target.closest("[data-dashboard-page]");
            if (!pageLink) return;
            e.preventDefault();
            loadAdvancedDashboard(pageLink.getAttribute("data-dashboard-page"));
        });
    });

    /* ── Offcanvas search ── */
    function filterOcList(input, listId) {
        const q = input.value.trim().toLowerCase();
        document.querySelectorAll(`#${listId} .qd-oc-item-v2`).forEach(item => {
            const text = (item.dataset.searchText || item.textContent).toLowerCase();
            item.hidden = q.length > 0 && !text.includes(q);
        });
    }

    /* ── Reset filters ── */
    function resetFilters() {
        ['curriculumId','batchId','instructorId'].forEach(id => {
            const el = document.getElementById(id);
            if (el) el.value = "";
        });
        window.location.href = new URL(window.location.origin + "/Admin/Analytics/AdvancedDashboard").toString();
    }

    /* ── AJAX load ── */
    async function loadAdvancedDashboard(page) {
        const content      = document.getElementById("advancedDashboardContent");
        const curriculumId = document.getElementById("curriculumId")?.value  || "";
        const batchId      = document.getElementById("batchId")?.value       || "";
        const instructorId = document.getElementById("instructorId")?.value  || "";

        const url =
            `/Admin/Analytics/AdvancedDashboardData` +
            `?curriculumId=${encodeURIComponent(curriculumId)}` +
            `&batchId=${encodeURIComponent(batchId)}` +
            `&instructorId=${encodeURIComponent(instructorId)}` +
            `&page=${encodeURIComponent(page)}`;

        content.innerHTML = `
            <div class="row g-3 p-2">
                ${[1,2,3].map(() => `
                    <div class="col-md-4">
                        <div style="background:#fff;border-radius:16px;padding:20px;border:1px solid #e5e7eb;">
                            <div class="skeleton" style="height:18px;width:55%;border-radius:6px;margin-bottom:12px;"></div>
                            <div class="skeleton" style="height:36px;width:38%;border-radius:6px;margin-bottom:14px;"></div>
                            <div class="skeleton" style="height:7px;border-radius:20px;"></div>
                        </div>
                    </div>`).join('')}
            </div>`;

        try {
            const response = await fetch(url, { method:"GET", headers:{"X-Requested-With":"XMLHttpRequest"} });
            if (!response.ok) {
                content.innerHTML = `<div class="alert alert-danger border-0 rounded-3 m-2"><i class="bi bi-x-octagon-fill me-2"></i>فشل تحميل بيانات التحليل. يرجى المحاولة مرة أخرى.</div>`;
                return;
            }
            content.innerHTML = await response.text();
            initializeAdvancedDashboardCharts();
        } catch (error) {
            console.error(error);
            content.innerHTML = `<div class="alert alert-danger border-0 rounded-3 m-2"><i class="bi bi-wifi-off me-2"></i>حدث خطأ أثناء الاتصال بالخادم.</div>`;
        }
    }

    /* ── Helpers ── */
    function parseJsonElement(id, fallback) {
        const el = document.getElementById(id);
        if (!el) return fallback;
        try { return JSON.parse(el.textContent || ""); } catch { return fallback; }
    }

    function hasData(arr) { return Array.isArray(arr) && arr.reduce((a, b) => a + Number(b || 0), 0) > 0; }
    function destroyChart(c) { if (c) c.destroy(); }

    function emptyState(title, sub) {
        return `<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;padding:20px;text-align:center;color:#9ca3af;">
                    <i class="bi bi-bar-chart-line" style="font-size:28px;opacity:.4;margin-bottom:8px;"></i>
                    <div style="font-weight:800;color:#374151;font-size:14px;">${title}</div>
                    <div style="font-size:12px;margin-top:3px;">${sub}</div>
                </div>`;
    }

    function initializeAdvancedDashboardCharts() {
        /* ── Chart.js Defaults (داخل الدالة لضمان تحميل Chart.js) ── */
        if (typeof Chart !== 'undefined') {
            Chart.defaults.font.family                     = "'Tajawal','Cairo',Tahoma,Arial,sans-serif";
            Chart.defaults.font.size                       = 12;
            Chart.defaults.color                           = "#6b7280";
            Chart.defaults.plugins.tooltip.padding         = 10;
            Chart.defaults.plugins.tooltip.backgroundColor = "rgba(15,23,42,.92)";
            Chart.defaults.plugins.tooltip.cornerRadius    = 8;
            Chart.defaults.plugins.tooltip.titleFont       = { weight:"700", size:13 };
            Chart.defaults.plugins.tooltip.bodyFont        = { size:12 };
        } else {
            console.warn("Chart.js not loaded yet, retrying...");
            setTimeout(initializeAdvancedDashboardCharts, 300);
            return;
        }

        destroyChart(riskChartInstance);
        destroyChart(lessonChartInstance);
        destroyChart(criticalChartInstance);
        destroyChart(radarChartInstance);
        destroyChart(instructorChartInstance);
        destroyChart(studentDistInstance);
        destroyChart(batchRiskInstance);
        riskChartInstance = lessonChartInstance = criticalChartInstance =
        radarChartInstance = instructorChartInstance = studentDistInstance = batchRiskInstance = null;

        const riskData         = parseJsonElement("riskDataJson",          []);
        const lessonNames      = parseJsonElement("lessonNamesJson",        []);
        const lessonValues     = parseJsonElement("lessonValuesJson",       []);
        const criticalLabels   = parseJsonElement("criticalLabelsJson",     []);
        const criticalExams    = parseJsonElement("criticalExamsJson",      []);
        const criticalHomework = parseJsonElement("criticalHomeworkJson",   []);
        const criticalAttend   = parseJsonElement("criticalAttendanceJson", []);
        const instrNames       = parseJsonElement("instructorNamesJson",    []);
        const instrScores      = parseJsonElement("instructorScoresJson",   []);
        const studentDist      = parseJsonElement("studentDistJson",        []);
        const perfAvg          = parseJsonElement("performanceAvgJson",     []);

        // 1. Radar
        const radarEl = document.getElementById("performanceRadarChart");
        if (radarEl) {
            if (hasData(perfAvg)) {
                radarChartInstance = new Chart(radarEl, {
                    type: "radar",
                    data: {
                        labels: ["الاختبارات","الواجبات","الحضور"],
                        datasets: [{
                            label: "الأداء الفعلي", data: perfAvg,
                            backgroundColor: "rgba(30,64,175,.15)", borderColor: "#1e40af",
                            borderWidth: 2.5, pointBackgroundColor: "#1e40af", pointBorderColor: "#fff",
                            pointBorderWidth: 2, pointRadius: 5, pointHoverRadius: 7, fill: true
                        },{
                            label: "حد القبول 70%", data: [70,70,70],
                            backgroundColor: "rgba(220,38,38,.06)", borderColor: "rgba(220,38,38,.4)",
                            borderWidth: 1.5, borderDash: [5,4], pointRadius: 0, fill: true
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false, animation: { duration: 800 },
                        scales: { r: { min:0, max:100, ticks:{ stepSize:25, callback: v=>v+"%" }, grid:{ color:"rgba(0,0,0,.07)" }, angleLines:{ color:"rgba(0,0,0,.07)" }, pointLabels:{ font:{ size:12, weight:"700" }, color:"#374151" } } },
                        plugins: { legend:{ position:"bottom", labels:{ usePointStyle:true, pointStyle:"circle", padding:16 } }, tooltip:{ callbacks:{ label: ctx=>` ${ctx.dataset.label}: ${ctx.raw}%` } } }
                    }
                });
            } else {
                radarEl.closest('.qdn-chart-body').innerHTML = emptyState("لا توجد بيانات كافية","سيظهر المخطط بعد توفر بيانات الأداء");
            }
        }

        // 2. Risk Doughnut
        const riskEl = document.getElementById("riskChart");
        if (riskEl) {
            if (hasData(riskData)) {
                riskChartInstance = new Chart(riskEl, {
                    type: "doughnut",
                    data: { labels:["خطر عالي","متوسط","جيد"], datasets:[{ data:riskData, backgroundColor:["#dc2626","#d97706","#16a34a"], borderWidth:0, hoverOffset:8 }] },
                    options: {
                        responsive:true, maintainAspectRatio:false, cutout:"70%",
                        animation:{ animateScale:true, animateRotate:true, duration:900 },
                        plugins:{ legend:{ display:false }, tooltip:{ callbacks:{ label: ctx=>` ${ctx.label}: ${ctx.raw} دفعة` } } }
                    }
                });
            } else {
                riskEl.closest('.qdn-chart-body').innerHTML = emptyState("لا توجد بيانات","سيظهر المخطط بعد توفر بيانات الدفعات");
            }
        }

        // 3. Student Distribution
        const studEl = document.getElementById("studentDistChart");
        if (studEl) {
            if (hasData(studentDist)) {
                studentDistInstance = new Chart(studEl, {
                    type: "doughnut",
                    data: { labels:["ممتاز","متوسط","ضعيف"], datasets:[{ data:studentDist, backgroundColor:["#16a34a","#d97706","#dc2626"], borderWidth:0, hoverOffset:8 }] },
                    options: {
                        responsive:true, maintainAspectRatio:false, cutout:"70%",
                        animation:{ animateScale:true, animateRotate:true, duration:900 },
                        plugins:{ legend:{ display:false }, tooltip:{ callbacks:{ label: ctx=>` ${ctx.label}: ${ctx.raw} طالب` } } }
                    }
                });
            } else {
                studEl.closest('.qdn-chart-body').innerHTML = emptyState("لا توجد بيانات طلاب","سيظهر المخطط بعد توفر بيانات الأداء");
            }
        }

        // 4. Instructor Bar
        const instrEl = document.getElementById("instructorBarChart");
        if (instrEl) {
            if (instrNames.length > 0) {
                const instrColors = instrScores.map(v => v>=80?"#16a34a":v>=60?"#d97706":"#dc2626");
                instructorChartInstance = new Chart(instrEl, {
                    type:"bar",
                    data:{ labels:instrNames, datasets:[{ label:"متوسط الأداء %", data:instrScores, backgroundColor:instrColors.map(c=>c+"cc"), borderColor:instrColors, borderWidth:0, borderRadius:6, borderSkipped:false }] },
                    options:{
                        indexAxis:"y", responsive:true, maintainAspectRatio:false, animation:{ duration:700, delay: ctx=>ctx.dataIndex*60 },
                        plugins:{ legend:{ display:false }, tooltip:{ callbacks:{ label: ctx=>` ${ctx.dataset.label}: ${ctx.raw}%` } } },
                        scales:{ x:{ beginAtZero:true, max:100, grid:{ color:"#f3f4f6" }, ticks:{ callback: v=>v+"%" } }, y:{ grid:{ display:false } } }
                    }
                });
            } else {
                instrEl.closest('.qdn-chart-body').innerHTML = emptyState("لا توجد بيانات مدربين","سيظهر المخطط بعد تعيين مدربين");
            }
        }

        // 4.b Batch Risk Doughnut
        const batchRiskEl = document.getElementById("batchRiskChart");
        if (batchRiskEl) {
            if (hasData(riskData)) {
                batchRiskInstance = new Chart(batchRiskEl, {
                    type: "doughnut",
                    data: { labels:["خطر عالي","متوسط","جيد"], datasets:[{ data:riskData, backgroundColor:["#dc2626","#d97706","#16a34a"], borderWidth:0, hoverOffset:8 }] },
                    options: {
                        responsive:true, maintainAspectRatio:false, cutout:"65%",
                        animation:{ animateScale:true, duration:900 },
                        plugins:{ legend:{ position:"bottom", labels:{ usePointStyle:true, pointStyle:"circle", padding:14 } }, tooltip:{ callbacks:{ label: ctx=>` ${ctx.label}: ${ctx.raw} دفعة` } } }
                    }
                });
            } else {
                batchRiskEl.closest('.qdn-chart-body').innerHTML = emptyState("لا توجد بيانات","سيظهر المخطط بعد توفر بيانات الدفعات");
            }
        }

        // 5. Weak Lessons Bar
        const lessonEl = document.getElementById("lessonWeakChart");
        if (lessonEl) {
            if (lessonNames.length > 0) {
                const colors = lessonValues.map(v => v>=70?"#dc2626":v>=50?"#d97706":"#16a34a");
                lessonChartInstance = new Chart(lessonEl, {
                    type:"bar",
                    data:{ labels:lessonNames, datasets:[{ label:"نسبة الضعف %", data:lessonValues, backgroundColor:colors.map(c=>c+"cc"), borderColor:colors, borderWidth:0, borderRadius:5, borderSkipped:false }] },
                    options:{
                        responsive:true, maintainAspectRatio:false, animation:{ duration:700, easing:"easeOutQuart" },
                        plugins:{ legend:{ display:false }, tooltip:{ callbacks:{ label: ctx=>` نسبة الضعف: ${ctx.raw}%` } } },
                        scales:{ y:{ beginAtZero:true, max:100, grid:{ color:"#f3f4f6" }, ticks:{ callback: v=>v+"%" } }, x:{ grid:{ display:false }, ticks:{ maxRotation:30, font:{ size:10 } } } }
                    }
                });
            } else {
                lessonEl.closest('.qdn-chart-body').innerHTML = emptyState("لا توجد دروس ضعيفة","سيظهر التحليل بعد توفر بيانات المحاولات");
            }
        }

        // 6. Critical Students Bar
        const critEl = document.getElementById("criticalChart");
        if (critEl) {
            if (criticalLabels.length > 0) {
                criticalChartInstance = new Chart(critEl, {
                    type:"bar",
                    data:{
                        labels:criticalLabels,
                        datasets:[
                            { label:"الحضور",     data:criticalAttend,   backgroundColor:"rgba(30,64,175,.7)",  borderRadius:4, borderSkipped:false },
                            { label:"الواجبات",   data:criticalHomework, backgroundColor:"rgba(8,145,178,.7)",  borderRadius:4, borderSkipped:false },
                            { label:"الاختبارات", data:criticalExams,    backgroundColor:"rgba(220,38,38,.7)",  borderRadius:4, borderSkipped:false }
                        ]
                    },
                    options:{
                        indexAxis:"y", responsive:true, maintainAspectRatio:false, animation:{ duration:700, delay: ctx=>ctx.dataIndex*80 },
                        plugins:{ legend:{ position:"top", labels:{ usePointStyle:true, pointStyle:"circle", padding:14 } }, tooltip:{ rtl:true, textDirection:"rtl", callbacks:{ label: item=>` ${item.dataset.label}: ${item.raw}%` } } },
                        scales:{ x:{ beginAtZero:true, max:100, grid:{ color:"#f3f4f6" }, ticks:{ callback: v=>v+"%" } }, y:{ grid:{ display:false } } }
                    }
                });
            } else {
                critEl.closest('.qdn-chart-body').innerHTML = emptyState("لا توجد بيانات طلاب حرجين","سيظهر التحليل بعد تسجيل محاولات الطلاب");
            }
        }
    }
</script>