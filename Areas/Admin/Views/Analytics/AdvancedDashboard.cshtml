                        @if (!string.IsNullOrEmpty(cs.ActionRequired))
                        {
                            <div style="margin-top:8px;padding:6px 10px;background:var(--q-danger-light);border-radius:6px;font-size:12px;font-weight:700;color:#991b1b">
                                <i class="bi bi-lightning-charge-fill me-1"></i>@cs.ActionRequired
                            </div>
                        }
                        @if (cs.BatchId.HasValue && (User.IsInRole("Owner") || User.IsInRole("Developer")))
                        {
                            var csBridgeCtx = new AnalyticsDecisionBridgeContext
                            {
                                BatchId      = cs.BatchId,
                                CurriculumId = Model.SelectedCurriculumId,
                                SourceMetric = "critical-student",
                                SourcePage   = "AdvancedDashboard",
                                ReturnUrl    = Url.Action("AdvancedDashboard", "Analytics", new { area = "Admin", curriculumId = Model.SelectedCurriculumId, batchId = Model.SelectedBatchId, instructorId = Model.SelectedInstructorId }) ?? ""
                            };
                            <div class="mt-2 d-flex gap-2 flex-wrap">
                                <a href="@Url.ToDecisionLabUrl(csBridgeCtx)"
                                   class="qd-nav-btn"
                                   style="font-size:11px;padding:3px 9px;background:var(--q-danger);color:#fff;border-color:var(--q-danger);text-decoration:none;">
                                    <i class="bi bi-lightning-charge-fill"></i> اتخذ قراراً فورياً
                                </a>
                                <a href="@Url.ToBatchAnalysisUrl(csBridgeCtx)"
                                   class="qd-nav-btn qd-nav-btn-secondary"
                                   style="font-size:11px;padding:3px 9px;text-decoration:none;">
                                    <i class="bi bi-bar-chart-line"></i> تحليل الدفعة
                                </a>
                            </div>
                        }
                    </div>
                }
            }
        </div>
        <div class="qd-oc-footer">
            <button type="button" class="qd-nav-btn qd-nav-btn-ghost" data-bs-dismiss="offcanvas">
                <i class="bi bi-x-lg"></i> إغلاق
            </button>
            <a class="qd-nav-btn qd-nav-btn-secondary"
               asp-area="Admin" asp-controller="Analytics" asp-action="MetricDecisionDetails" asp-route-metric="critical-cases"
               asp-route-curriculumId="@Model?.SelectedCurriculumId" asp-route-batchId="@Model?.SelectedBatchId" asp-route-instructorId="@Model?.SelectedInstructorId">
                <i class="bi bi-graph-up"></i> تحليل القرار
            </a>
            <a class="qd-nav-btn qd-nav-btn-primary"
               asp-area="Admin" asp-controller="Analytics" asp-action="CriticalStudentsDetails"
