@* ═══════════════════════════════════════════════════════════════════
   OFFCANVAS 2 — المدربون النشطون
   ═══════════════════════════════════════════════════════════════════ *@
<div class="offcanvas offcanvas-end qd-offcanvas" tabindex="-1" id="instructorsOffcanvas" aria-labelledby="instructorsOffcanvasLabel" data-bs-scroll="true">
    <div class="offcanvas-header" style="background:linear-gradient(135deg,#164e63,#0891b2)">
        <div>
            <h5 class="offcanvas-title" id="instructorsOffcanvasLabel" style="font-size:17px;font-weight:800">
                <i class="bi bi-person-badge-fill me-2"></i> المدربون النشطون
            </h5>
            <div style="font-size:13px;opacity:.8;margin-top:3px">@(Model?.TotalInstructors ?? 0) مدرب مرتبط بدفعات</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div class="qd-oc-summary">
            <span style="font-size:13px;color:var(--q-muted);font-weight:700;">
                <i class="bi bi-info-circle me-1"></i>
                متوسط الأداء عبر جميع المدربين
            </span>
        </div>
        <div class="qd-oc-list">
            @if (Model?.Instructors == null || !Model.Instructors.Any())
            {
                <div class="qd-empty">
                    <i class="bi bi-person-badge"></i>
                    <div class="qd-empty-title">لا يوجد مدربون</div>
                    <div class="qd-empty-sub">لم يتم تعيين مدربين بعد</div>
                </div>
            }
            else
            {
                @foreach (var instr in Model.Instructors)
                {
                    var iRisk = instr.RiskLevel == "High" ? "badge-danger" : instr.RiskLevel == "Medium" ? "badge-warning" : "badge-success";
                    var iRiskLabel = instr.RiskLevel == "High" ? "خطر عالي" : instr.RiskLevel == "Medium" ? "متوسط" : "جيد";
                    var scoreColor = instr.AvgScore >= 70 ? "var(--q-success)" : instr.AvgScore >= 50 ? "var(--q-warning)" : "var(--q-danger)";
                    <div class="qd-oc-item">
                        <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
                            <div>
                                <div class="qd-oc-item-title">@instr.InstructorName</div>
                                <div class="qd-oc-item-sub">
                                    <i class="bi bi-layers me-1"></i>@instr.BatchesCount دفعة
                                </div>
                            </div>
                            <div style="font-size:22px;font-weight:900;color:@scoreColor;flex-shrink:0">@Math.Round(instr.AvgScore)%</div>
                        </div>
                        <div class="qd-oc-item-stats">
                            <span class="qd-badge @iRisk">@iRiskLabel</span>
                            @if (instr.WeakLessonsCount > 0)
                            {
                                <span class="qd-badge badge-warning"><i class="bi bi-exclamation-diamond me-1"></i>@instr.WeakLessonsCount درس ضعيف</span>
                            }
                            else
                            {
                                <span class="qd-badge badge-success"><i class="bi bi-check2-circle me-1"></i>لا دروس ضعيفة</span>
                            }
                        </div>
                    </div>
                }
            }
        </div>
        <div class="qd-oc-footer">
            <button type="button" class="qd-nav-btn qd-nav-btn-ghost" data-bs-dismiss="offcanvas">
                <i class="bi bi-x-lg"></i> إغلاق
            </button>
            <a class="qd-nav-btn qd-nav-btn-secondary"
               asp-area="Admin" asp-controller="Analytics" asp-action="MetricDecisionDetails" asp-route-metric="total-instructors"
               asp-route-curriculumId="@Model?.SelectedCurriculumId" asp-route-batchId="@Model?.SelectedBatchId" asp-route-instructorId="@Model?.SelectedInstructorId">
                <i class="bi bi-graph-up"></i> تحليل القرار
            </a>
            <a class="qd-nav-btn qd-nav-btn-primary"
               asp-area="Admin" asp-controller="Analytics" asp-action="AdvancedDashboard"
               asp-route-curriculumId="@Model?.SelectedCurriculumId" asp-route-batchId="@Model?.SelectedBatchId" asp-route-instructorId="@Model?.SelectedInstructorId">
                <i class="bi bi-bar-chart-fill"></i> لوحة التحليلات
            </a>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════════
   OFFCANVAS 3 — الطلاب المحللون
   ═══════════════════════════════════════════════════════════════════ *@

<div class="offcanvas offcanvas-end qd-offcanvas" tabindex="-1" id="studentsAnalyticsOffcanvas" aria-labelledby="studentsAnalyticsOffcanvasLabel" data-bs-scroll="true">
    <div class="offcanvas-header" style="background:linear-gradient(135deg,#92400e,#d97706)">
        <div>
            <h5 class="offcanvas-title" id="studentsAnalyticsOffcanvasLabel" style="font-size:17px;font-weight:800">
                <i class="bi bi-people-fill me-2"></i> الطلاب المحللون
            </h5>
            <div style="font-size:13px;opacity:.8;margin-top:3px">@allStudents.Count طالب لديهم مؤشرات أداء</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div class="qd-oc-summary">
            <span class="qd-badge badge-success"><i class="bi bi-star-fill me-1"></i>ممتاز: @excellentCount</span>
            <span class="qd-badge badge-warning"><i class="bi bi-dash-circle me-1"></i>متوسط: @mediumCount</span>
            <span class="qd-badge badge-danger"><i class="bi bi-arrow-down-circle-fill me-1"></i>ضعيف: @weakCount</span>
        </div>
        <div class="qd-oc-list">
            @if (!allStudents.Any())
            {
                <div class="qd-empty">
                    <i class="bi bi-people"></i>
                    <div class="qd-empty-title">لا يوجد طلاب محللون</div>
                    <div class="qd-empty-sub">لم يتم تسجيل محاولات بعد</div>
                </div>
            }
            else
            {
                @foreach (var st in allStudents.OrderBy(s => s.ExamScore))
                {
                    var stPriorityBadge = st.Priority == "High" ? "badge-danger" : st.Priority == "Medium" ? "badge-warning" : "badge-success";
                    var stPriorityLabel = st.Priority == "High" ? "أولوية عالية" : st.Priority == "Medium" ? "متوسط" : "جيد";
                    var examColor = st.ExamScore >= 70 ? "var(--q-success)" : st.ExamScore >= 50 ? "var(--q-warning)" : "var(--q-danger)";
                    <div class="qd-oc-item">
                        <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
                            <div style="flex:1;min-width:0">
                                <div class="qd-oc-item-title">@st.StudentName</div>
                                @if (!string.IsNullOrEmpty(st.WeakReason))
                                {
                                    <div class="qd-oc-item-sub"><i class="bi bi-exclamation-circle me-1"></i>@st.WeakReason</div>
                                }
                            </div>
                            <div style="font-size:20px;font-weight:900;color:@examColor;flex-shrink:0">@Math.Round(st.ExamScore)%</div>
                        </div>
                        <div class="qd-oc-item-stats">
                            <span class="qd-badge @stPriorityBadge">@stPriorityLabel</span>
                            <span class="qd-badge badge-primary"><i class="bi bi-journal-check me-1"></i>واجبات: @Math.Round(st.HomeworkScore)%</span>
                            <span class="qd-badge badge-info"><i class="bi bi-calendar2-check me-1"></i>حضور: @Math.Round(st.Attendance)%</span>
                        </div>
                        @if (st.BatchId.HasValue && (User.IsInRole("Owner") || User.IsInRole("Developer")))
                        {
                            var stBridgeCtx = new AnalyticsDecisionBridgeContext
                            {
                                BatchId      = st.BatchId,
                                CurriculumId = Model.SelectedCurriculumId,
                                SourceMetric = "student-weak-" + st.Priority.ToLower(),
                                SourcePage   = "AdvancedDashboard",
                                ReturnUrl    = Url.Action("AdvancedDashboard", "Analytics", new { area = "Admin", curriculumId = Model.SelectedCurriculumId, batchId = Model.SelectedBatchId, instructorId = Model.SelectedInstructorId }) ?? ""
                            };
                            <div class="mt-2">
                                <a href="@Url.ToDecisionLabUrl(stBridgeCtx)"
                                   class="qd-nav-btn"
                                   style="font-size:11px;padding:3px 9px;background:var(--q-primary);color:#fff;border-color:var(--q-primary);text-decoration:none;">
                                    <i class="bi bi-lightning-charge-fill"></i> اتخذ قراراً للدفعة
                                </a>
                            </div>
                        }
                    </div>
                }
            }
        </div>
        <div class="qd-oc-footer">
            <button type="button" class="qd-nav-btn qd-nav-btn-ghost" data-bs-dismiss="offcanvas">
                <i class="bi bi-x-lg"></i> إغلاق
            </button>
            <a class="qd-nav-btn qd-nav-btn-secondary"
               asp-area="Admin" asp-controller="Analytics" asp-action="MetricDecisionDetails" asp-route-metric="analyzed-students"
               asp-route-curriculumId="@Model?.SelectedCurriculumId" asp-route-batchId="@Model?.SelectedBatchId" asp-route-instructorId="@Model?.SelectedInstructorId">
                <i class="bi bi-graph-up"></i> تحليل القرار
            </a>
            <a class="qd-nav-btn qd-nav-btn-primary"
               asp-area="Admin" asp-controller="Analytics" asp-action="AnalyzedStudentsDetails"
               asp-route-curriculumId="@Model?.SelectedCurriculumId" asp-route-batchId="@Model?.SelectedBatchId" asp-route-instructorId="@Model?.SelectedInstructorId">
                <i class="bi bi-people-fill"></i> تفاصيل الطلاب
            </a>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════════
   OFFCANVAS 4 — حالات أولوية عالية
   ═══════════════════════════════════════════════════════════════════ *@

<div class="offcanvas offcanvas-end qd-offcanvas" tabindex="-1" id="criticalOffcanvas" aria-labelledby="criticalOffcanvasLabel" data-bs-scroll="true">
    <div class="offcanvas-header" style="background:linear-gradient(135deg,#7f1d1d,#dc2626)">
        <div>
            <h5 class="offcanvas-title" id="criticalOffcanvasLabel" style="font-size:17px;font-weight:800">
                <i class="bi bi-person-fill-exclamation me-2"></i> حالات أولوية عالية
            </h5>
            <div style="font-size:13px;opacity:.8;margin-top:3px">@(Model?.CriticalCases ?? 0) حالة تحتاج تدخل فوري</div>
