</div>

@section Scripts {
<script>
    // ══════════════════════════════════════════════════════════════════
    //  توزيع الأسئلة — Distribution Card
    // ══════════════════════════════════════════════════════════════════

    let distChart = null;
    let distLoaded = false;

    function toggleDistCard() {
        const card = document.getElementById('distCard');
        card.classList.toggle('is-open');
        if (card.classList.contains('is-open') && !distLoaded) {
            loadDistribution();
        }
    }

    async function loadDistribution() {
        const curriculumId = document.getElementById('distCurriculumSelect').value;
        const base = '@Url.Action("GetQuestionDistribution","AnalyticsDashboard", new { area = "Admin" })';
        const url  = curriculumId ? `${base}?curriculumId=${curriculumId}` : base;

        document.getElementById('distSpinner').classList.add('active');
        document.getElementById('distRefreshBtn').disabled = true;

        try {
            const resp = await fetch(url);
            if (!resp.ok) throw new Error();
            const json = await resp.json();
            if (!json.success) throw new Error();
            renderDistribution(json.data, curriculumId);
            distLoaded = true;
        } catch {
            document.getElementById('distContent').innerHTML =
                `<div class="rc-error-box mt-2"><i class="bi bi-exclamation-circle-fill" style="flex-shrink:0;"></i> تعذّر تحميل البيانات.</div>`;
        } finally {
            document.getElementById('distSpinner').classList.remove('active');
            document.getElementById('distRefreshBtn').disabled = false;
        }
    }

    function renderDistribution(data, curriculumId) {
        const el = document.getElementById('distContent');

        if (!data || data.length === 0) {
            el.innerHTML = '<div style="text-align:center;padding:32px;color:#94A3B8;font-size:13px;">لا توجد بيانات لهذا المنهج.</div>';
            return;
        }

        // تجميع الإجماليات (PropertyNamingPolicy = null → PascalCase)
        let easy = 0, medium = 0, hard = 0, veryHard = 0, total = 0;
        data.forEach(d => {
            easy     += d.EasyCount;
            medium   += d.MediumCount;
            hard     += d.HardCount;
            veryHard += d.VeryHardCount;
            total    += d.Total;
        });

        const pct = v => total > 0 ? Math.round(v / total * 100) : 0;

        const levels = [
            { label: 'سهل',       count: easy,     color: '#10B981', bg: '#F0FDF4', border: '#A7F3D0' },
            { label: 'متوسط',     count: medium,   color: '#F59E0B', bg: '#FFFBEB', border: '#FDE68A' },
            { label: 'صعب',       count: hard,     color: '#EF4444', bg: '#FFF1F2', border: '#FECDD3' },
            { label: 'صعب جداً',  count: veryHard, color: '#7C3AED', bg: '#F5F3FF', border: '#C4B5FD' },
        ];

        const legendHtml = levels.map(l => `
            <div class="dist-legend-row" style="background:${l.bg};border-color:${l.border};">
                <div class="dist-legend-dot" style="background:${l.color};"></div>
                <div class="dist-legend-label" style="color:${l.color};">${l.label}</div>
                <div class="dist-legend-count" style="color:${l.color};">${l.count.toLocaleString()}</div>
                <div class="dist-legend-pct" style="color:${l.color};">${pct(l.count)}%</div>
            </div>`).join('');

        // جدول تفصيلي عند عرض كل المناهج
        let detailTable = '';
        if (!curriculumId && data.length > 1) {
            const rows = data.map((d, i) => `
                <tr>
                    <td style="color:#334155;max-width:170px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${d.CurriculumTitle}">${d.CurriculumTitle}</td>
                    <td style="text-align:center;color:#10B981;">${d.EasyCount}</td>
                    <td style="text-align:center;color:#F59E0B;">${d.MediumCount}</td>
                    <td style="text-align:center;color:#EF4444;">${d.HardCount}</td>
                    <td style="text-align:center;color:#7C3AED;">${d.VeryHardCount}</td>
                    <td style="text-align:center;color:#475569;font-weight:700;">${d.Total}</td>
                </tr>`).join('');

            detailTable = `
            <div class="dist-table-wrap">
                <div style="padding:10px 14px;font-size:13px;font-weight:700;color:#334155;background:#F8FAFC;border-bottom:1px solid #E2E8F0;display:flex;align-items:center;gap:6px;">
                    <i class="bi bi-list-ul"></i> توزيع تفصيلي لكل منهج
                </div>
                <div style="max-height:300px;overflow-y:auto;">
                    <table>
                        <thead>
                            <tr>
                                <th style="text-align:right;">المنهج</th>
                                <th style="text-align:center;color:#10B981;">سهل</th>
                                <th style="text-align:center;color:#F59E0B;">متوسط</th>
                                <th style="text-align:center;color:#EF4444;">صعب</th>
                                <th style="text-align:center;color:#7C3AED;">صعب جداً</th>
                                <th style="text-align:center;">الإجمالي</th>
                            </tr>
                        </thead>
                        <tbody>${rows}</tbody>
                    </table>
                </div>
            </div>`;
        }

        el.innerHTML = `
        <div>
            <div id="distChartArea" style="display:grid;grid-template-columns:200px 1fr;gap:24px;align-items:center;margin-bottom:4px;">
                <div style="position:relative;width:180px;height:180px;margin:auto;">
                    <canvas id="distDonutChart" width="180" height="180"></canvas>
                    <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;pointer-events:none;">
                        <div style="font-size:22px;font-weight:900;color:#0F172A;line-height:1;">${total.toLocaleString()}</div>
                        <div style="font-size:11px;font-weight:600;color:#94A3B8;margin-top:2px;">سؤال</div>
                    </div>
                </div>
                <div>${legendHtml}</div>
            </div>
            ${detailTable}
        </div>`;

        // بناء/تحديث الرسم البياني
        const ctx = document.getElementById('distDonutChart').getContext('2d');
        if (distChart) distChart.destroy();
        distChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['سهل', 'متوسط', 'صعب', 'صعب جداً'],
                datasets: [{
                    data: [easy, medium, hard, veryHard],
                    backgroundColor: ['#10B981', '#F59E0B', '#EF4444', '#7C3AED'],
                    borderColor: '#fff',
                    borderWidth: 3,
                    hoverOffset: 8
                }]
            },
            options: {
                cutout: '68%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        rtl: true,
                        callbacks: {
                            label: ctx => {
                                const v = ctx.parsed;
                                const p = total > 0 ? Math.round(v / total * 100) : 0;
                                return `  ${v.toLocaleString()} سؤال (${p}%)`;
                            }
                        }
                    }
                },
                animation: { duration: 500, easing: 'easeInOutQuart' }
            }
        });
    }

    // ══════════════════════════════════════════════════════════════════
    //  إعادة التصنيف — Recalibration Panel
    // ══════════════════════════════════════════════════════════════════

    // ══ تبديل ظهور البانيل ══
    function toggleRecalibPanel() {
        const card = document.getElementById('difficultyRecalibrationCard');
        card.classList.toggle('is-open');
    }

    // ══ تحديث الشريط البصري والنطاقات ══
    function rcUpdateBar() {
        const vh = parseFloat(document.getElementById('rcVeryHardMax').value) || 15;
        const h  = parseFloat(document.getElementById('rcHardMax').value)     || 49;
        const m  = parseFloat(document.getElementById('rcMediumMax').value)   || 79;
        const e  = 100 - m;

        document.getElementById('rcBarVH').style.flex = vh;
        document.getElementById('rcBarH').style.flex  = Math.max(h - vh, 0);
        document.getElementById('rcBarM').style.flex  = Math.max(m - h, 0);
        document.getElementById('rcBarE').style.flex  = Math.max(e, 0);

        document.getElementById('rcVHRange').textContent = `0% — ${vh}%`;
        document.getElementById('rcHRange').textContent  = `${vh+1}% — ${h}%`;
        document.getElementById('rcMRange').textContent  = `${h+1}% — ${m}%`;
        document.getElementById('rcEasyRange').textContent = `${m+1}% — 100%`;

        const isValid = vh < h && h < m && m < 100;
        const msg = document.getElementById('rcValidationMsg');
        msg.classList.toggle('visible', !isValid);
    }

    // ══ بناء الـ payload ══
    function buildPayload() {
        const curriculumRaw = document.getElementById('rcCurriculumId')?.value;
        return {
            veryHardMaxPercent : parseFloat(document.getElementById('rcVeryHardMax').value) || 15,
            hardMaxPercent     : parseFloat(document.getElementById('rcHardMax').value)     || 49,
            mediumMaxPercent   : parseFloat(document.getElementById('rcMediumMax').value)   || 79,
            fromDate           : document.getElementById('rcFromDate').value || null,
            toDate             : document.getElementById('rcToDate').value   || null,
            curriculumId       : curriculumRaw ? parseInt(curriculumRaw) : null
        };
    }

    // تهيئة الشريط عند التحميل
    document.addEventListener('DOMContentLoaded', function() { rcUpdateBar(); });

    // ══ تشغيل المعاينة أو التطبيق ══
    async function runRecalibration(apply) {
        const payload   = buildPayload();
        const actionUrl = apply
            ? '@Url.Action("ApplyDifficultyRecalibration","AnalyticsDashboard", new { area = "Admin" })'
            : '@Url.Action("PreviewDifficultyRecalibration","AnalyticsDashboard", new { area = "Admin" })';

        // تحقق من صحة القيم
        if (payload.veryHardMaxPercent >= payload.hardMaxPercent ||
            payload.hardMaxPercent     >= payload.mediumMaxPercent ||
            payload.mediumMaxPercent   >= 100) {
            showRcAlert('تأكد من أن النسب بترتيب تصاعدي صحيح وأن المتوسط أقل من 100%.', 'danger');
            return;
        }

        if (apply && !confirm('سيتم تحديث مستوى الصعوبة لكل الأسئلة في قاعدة البيانات. هل تريد المتابعة؟')) return;

        setRcLoading(true);
        document.getElementById('rcResultArea').style.display = 'none';

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            const resp  = await fetch(actionUrl, {
                method  : 'POST',
                headers : {
                    'Content-Type'            : 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(payload)
            });

            if (!resp.ok) {
                const err = await resp.json().catch(() => ({}));
                showRcAlert(err.message ?? 'حدث خطأ في الخادم.', 'danger');
                return;
            }

            const json = await resp.json();
            if (!json.success) { showRcAlert(json.message ?? 'فشلت العملية.', 'danger'); return; }

            renderRcResult(json.data, apply);
        } catch (e) {
            showRcAlert('تعذّر الاتصال بالخادم.', 'danger');
        } finally {
            setRcLoading(false);
        }
    }

    function setRcLoading(on) {
        document.getElementById('rcSpinner').classList.toggle('active', on);
        document.getElementById('rcPreviewBtn').disabled = on;
        document.getElementById('rcApplyBtn').disabled   = on;
    }

    function showRcAlert(msg, type) {
        const area = document.getElementById('rcResultArea');
        const isError = type === 'danger' || type === 'error';
        area.innerHTML = `<div class="rc-error-box mt-3">
            <i class="bi bi-exclamation-circle-fill" style="font-size:18px;flex-shrink:0"></i>
            <span>${msg}</span>
        </div>`;
    }

    // ══ عرض النتائج ══
    function renderRcResult(d, applied) {
        const diffLabel = {
            0: '<span class="badge bg-success">سهل</span>',
            1: '<span class="badge bg-warning text-dark">متوسط</span>',
            2: '<span class="badge bg-danger">صعب</span>',
            3: '<span class="badge" style="background:#7c3aed;">صعب جداً</span>'
        };

        const dateRange = (d.fromDate || d.toDate)
            ? `<span class="me-3"><i class="bi bi-calendar2 me-1"></i>${d.fromDate ? d.fromDate.substring(0,10) : '—'} → ${d.toDate ? d.toDate.substring(0,10) : '—'}</span>`
            : '<span class="me-3"><i class="bi bi-calendar2 me-1"></i>كل المحاولات</span>';

        const headerColor = applied ? 'var(--q-success)' : 'var(--q-primary)';
        const headerIcon  = applied ? 'bi-check2-all' : 'bi-eye';
        const headerTitle = applied ? 'تم تطبيق إعادة التصنيف بنجاح' : 'معاينة إعادة التصنيف';

        // بطاقات الإحصاء
        const chips = [
            { val: d.totalQuestions, lbl: 'إجمالي الأسئلة',   bg: '#F1F5F9', color: '#334155', border: '#CBD5E1' },
            { val: d.updatedCount,   lbl: 'سيتغير تصنيفها',   bg: '#F5F3FF', color: '#6D28D9', border: '#C4B5FD' },
            { val: d.veryHardCount,  lbl: `صعب جداً 0–${d.veryHardMaxPercent}%`, bg: '#F5F3FF', color: '#7C3AED', border: '#C4B5FD' },
            { val: d.hardCount,      lbl: `صعب ${d.veryHardMaxPercent+1}–${d.hardMaxPercent}%`, bg: '#FFF1F2', color: '#DC2626', border: '#FECDD3' },
            { val: d.mediumCount,    lbl: `متوسط ${d.hardMaxPercent+1}–${d.mediumMaxPercent}%`, bg: '#FFFBEB', color: '#D97706', border: '#FDE68A' },
            { val: d.easyCount,      lbl: `سهل ${d.mediumMaxPercent+1}–100%`, bg: '#F0FDF4', color: '#059669', border: '#A7F3D0' }
        ];

        const statCards = `<div class="rc-stat-grid">${chips.map(c => `
            <div class="rc-stat-chip" style="background:${c.bg};border-color:${c.border};">
                <div class="rc-stat-chip-val" style="color:${c.color};">${c.val}</div>
                <div class="rc-stat-chip-lbl" style="color:${c.color};">${c.lbl}</div>
            </div>`).join('')}</div>`;

        // جدول التغييرات
        let tableHtml = '';
        if (d.changedItems && d.changedItems.length > 0) {
            const diffBadge = {
                0: `<span class="rc-diff-badge" style="background:#F0FDF4;color:#059669;border-color:#A7F3D0;">سهل</span>`,
                1: `<span class="rc-diff-badge" style="background:#FFFBEB;color:#D97706;border-color:#FDE68A;">متوسط</span>`,
                2: `<span class="rc-diff-badge" style="background:#FFF1F2;color:#DC2626;border-color:#FECDD3;">صعب</span>`,
                3: `<span class="rc-diff-badge" style="background:#F5F3FF;color:#7C3AED;border-color:#C4B5FD;">صعب جداً</span>`
            };
            const rows = d.changedItems.map(item => `
                <tr style="font-size:12px;">
                    <td style="max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:9px 12px;color:#334155;font-weight:600;"
                        title="${item.questionTitle}">${item.questionTitle}</td>
                    <td style="text-align:center;padding:9px 12px;">${diffBadge[item.oldDifficulty] ?? item.oldDifficulty}</td>
                    <td style="text-align:center;padding:9px 6px;color:#94A3B8;"><i class="bi bi-arrow-left"></i></td>
                    <td style="text-align:center;padding:9px 12px;">${diffBadge[item.newDifficulty] ?? item.newDifficulty}</td>
                    <td style="text-align:center;padding:9px 12px;font-weight:800;color:#2563EB;">${item.successRate}%</td>
                    <td style="text-align:center;padding:9px 12px;color:#64748B;">${item.uniqueStudents}</td>
                </tr>`).join('');

            tableHtml = `
            <div class="rc-changed-table-wrap">
                <div class="rc-changed-table-title">
                    <i class="bi bi-list-check"></i>
                    الأسئلة المتغيرة (${d.changedItems.length} سؤال)
                </div>
                <div style="max-height:340px;overflow-y:auto;">
                    <table style="width:100%;border-collapse:collapse;font-family:inherit;">
                        <thead>
                            <tr style="background:#F8FAFC;font-size:11px;color:#64748B;font-weight:700;text-transform:uppercase;letter-spacing:.5px;border-bottom:1px solid #E2E8F0;">
                                <th style="padding:9px 12px;text-align:right;">السؤال</th>
                                <th style="padding:9px 12px;text-align:center;">التصنيف القديم</th>
                                <th style="width:28px;"></th>
                                <th style="padding:9px 12px;text-align:center;">التصنيف الجديد</th>
                                <th style="padding:9px 12px;text-align:center;">نسبة النجاح</th>
                                <th style="padding:9px 12px;text-align:center;">الطلاب</th>
                            </tr>
                        </thead>
                        <tbody style="border-top:1px solid #E2E8F0;">${rows}</tbody>
                    </table>
                </div>
            </div>`;
        }

        const rc = document.getElementById('rcResultArea');
        rc.innerHTML = `
        <div class="rc-result-card mt-4" style="border-color:${headerColor};background:${applied ? '#F0FDF4' : '#EFF6FF'};">
            <div class="rc-result-header">
                <span class="rc-result-icon" style="color:${headerColor};">
                    <i class="bi ${headerIcon}"></i>
                </span>
                <span class="rc-result-title" style="color:${headerColor};">${headerTitle}</span>
                <span class="rc-result-meta">
                    <i class="bi bi-calendar2 me-1"></i>${dateRange.replace(/<[^>]+>/g,'')}
                </span>
            </div>
            ${statCards}
            <div style="font-size:12px;color:#64748B;margin-bottom:16px;">
                <i class="bi bi-info-circle me-1"></i>
                ${d.skippedNoData} سؤال بدون محاولات — لم يُصنَّف
            </div>
            ${tableHtml}
        </div>`;
    }
</script>
}

@* Offcanvas panels moved to _AdvancedDashboardContent.cshtml (loaded via AJAX) *@
@if (false) {
<div class="offcanvas offcanvas-end qd-offcanvas" tabindex="-1" id="batchesOffcanvas" aria-labelledby="batchesOffcanvasLabel" data-bs-scroll="true">
    <div class="offcanvas-header" style="background:linear-gradient(135deg,#1e3a8a,#1e40af)">
        <div>
            <h5 class="offcanvas-title" id="batchesOffcanvasLabel" style="font-size:17px;font-weight:800">
                <i class="bi bi-layers-fill me-2"></i> إجمالي الدفعات
            </h5>
            <div style="font-size:13px;opacity:.8;margin-top:3px">@(Model?.TotalBatches ?? 0) دفعة نشطة في النظام</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div class="qd-oc-summary">
            <span class="qd-badge badge-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>خطر عالي: @(Model?.RiskHigh ?? 0)</span>
            <span class="qd-badge badge-warning"><i class="bi bi-dash-circle-fill me-1"></i>متوسط: @(Model?.RiskMedium ?? 0)</span>
            <span class="qd-badge badge-success"><i class="bi bi-check-circle-fill me-1"></i>جيد: @(Model?.RiskLow ?? 0)</span>
        </div>
        <div class="qd-oc-list">
            @if (Model?.Batches == null || !Model.Batches.Any())
            {
                <div class="qd-empty">
                    <i class="bi bi-layers"></i>
                    <div class="qd-empty-title">لا توجد دفعات</div>
                    <div class="qd-empty-sub">لم يتم إضافة دفعات بعد</div>
                </div>
            }
            else
            {
                @foreach (var batch in Model.Batches)
                {
                    var bRisk = batch.RiskLevel == "High" ? "badge-danger" : batch.RiskLevel == "Medium" ? "badge-warning" : "badge-success";
                    var bRiskLabel = batch.RiskLevel == "High" ? "خطر عالي" : batch.RiskLevel == "Medium" ? "متوسط" : "جيد";
                    Model.DecisionStatusMap.TryGetValue(batch.BatchId, out var batchDecision);
                    <div class="qd-oc-item">
                        <div class="qd-oc-item-title d-flex align-items-center gap-2 flex-wrap">
                            @batch.BatchName
                            @if (batchDecision != null && batchDecision.StatusLabel != "لا قرار")
                            {
                                <span class="badge bg-@batchDecision.StatusCssClass"
                                      style="font-size:10px;font-weight:700;">
                                    @batchDecision.StatusLabel
                                </span>
                            }
                            @if (batchDecision?.HasActiveInterventionTask == true
                                 && batchDecision.LatestDecisionAt.HasValue)
                            {
                                var daysSince = (int)(DateTime.Now - batchDecision.LatestDecisionAt.Value).TotalDays;
                                <span class="badge"
                                      style="background:#ede9fe;color:#5b21b6;font-size:10px;font-weight:700;">
                                    <i class="fas fa-bolt me-1"></i>تدخل جارٍ منذ @daysSince يوم
                                </span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(batch.CourseName))
                        {
                            <div class="qd-oc-item-sub"><i class="bi bi-book me-1"></i>@batch.CourseName</div>
                        }
                        <div class="qd-oc-item-stats">
                            <span class="qd-badge @bRisk">@bRiskLabel</span>
                            <span class="qd-badge badge-primary"><i class="bi bi-people-fill me-1"></i>@batch.StudentsCount طالب</span>
                            @if (batch.WeakLessonsCount > 0)
                            {
                                <span class="qd-badge badge-warning"><i class="bi bi-exclamation-diamond me-1"></i>@batch.WeakLessonsCount درس ضعيف</span>
                            }
                            @if (batch.AffectedStudents > 0)
                            {
                                <span class="qd-badge badge-danger"><i class="bi bi-person-fill-exclamation me-1"></i>@batch.AffectedStudents متأثر</span>
                            }
                        </div>
                        @if ((batch.RiskLevel == "High" || batch.RiskLevel == "Medium") && (User.IsInRole("Owner") || User.IsInRole("Developer")))
                        {
                            var batchBridgeCtx = new AnalyticsDecisionBridgeContext
                            {
                                BatchId      = batch.BatchId,
                                CurriculumId = Model.SelectedCurriculumId,
                                InstructorId = Model.SelectedInstructorId,
                                SourceMetric = batch.RiskLevel == "High" ? "high-risk-batch" : "medium-risk-batch",
                                SourcePage   = "AdvancedDashboard",
                                ReturnUrl    = Url.Action("AdvancedDashboard", "Analytics", new
                                {
                                    area         = "Admin",
                                    curriculumId = Model.SelectedCurriculumId,
                                    batchId      = Model.SelectedBatchId,
                                    instructorId = Model.SelectedInstructorId
                                }) ?? ""
                            };
                            var btnColor = batch.RiskLevel == "High" ? "var(--q-danger)" : "var(--q-warning)";
                            <div class="mt-2 d-flex gap-2 flex-wrap">
                                <a href="@Url.ToDecisionLabUrl(batchBridgeCtx)"
                                   class="qd-nav-btn"
                                   style="font-size:12px;padding:4px 10px;background:@btnColor;color:#fff;border-color:@btnColor;text-decoration:none;">
                                    <i class="bi bi-lightning-charge-fill"></i> اتخذ قراراً لهذه الدفعة
                                </a>
                                <a href="@Url.ToBatchAnalysisUrl(batchBridgeCtx)"
                                   class="qd-nav-btn qd-nav-btn-secondary"
                                   style="font-size:12px;padding:4px 10px;text-decoration:none;">
                                    <i class="bi bi-bar-chart-line"></i> تحليل الدفعة
                                </a>
                            </div>
                        }
                    </div>
                }
            }
        </div>
        <div class="qd-oc-footer">
