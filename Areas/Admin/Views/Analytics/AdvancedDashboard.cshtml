@model QdratNew.ViewModels.Analytics.AnalyticsShellVM
@using QdratNew.Extensions
@using QdratNew.ViewModels.Admin.Shared

@{
    ViewData["Title"] = "لوحة التحليلات الذكية";
    var now = DateTime.Now.ToString("dd/MM/yyyy — HH:mm");
}
@{
    var allStudents = Model?.Students ?? new List<QdratNew.ViewModels.Admin.Analytics.StudentAnalyticsVM>();
    var excellentCount = allStudents.Count(s => s.Priority == "Low" || (s.ExamScore >= 70 && s.HomeworkScore >= 70));
    var mediumCount = allStudents.Count(s => s.Priority == "Medium");
    var weakCount = allStudents.Count(s => s.Priority == "High");
}


@{
    var criticalStudents = allStudents.Where(s => s.Priority == "High").OrderBy(s => s.ExamScore).ToList();
}

@{
    var highRiskLessons = (Model?.Lessons ?? new List<QdratNew.ViewModels.Admin.Analytics.LessonAnalyticsVM>())
        .Where(l => l.WeakPercentage >= 70)
        .OrderByDescending(l => l.WeakPercentage)
        .ToList();
}


@* ===================== STYLES ===================== *@
<style>
    :root {
        --q-bg: #f0f2f5;
        --q-surface: #ffffff;
        --q-border: #e5e7eb;
        --q-primary: #1e40af;
        --q-primary-light: #dbeafe;
        --q-success: #16a34a;
        --q-success-light: #dcfce7;
        --q-warning: #d97706;
        --q-warning-light: #fef3c7;
        --q-danger: #dc2626;
        --q-danger-light: #fee2e2;
        --q-info: #0891b2;
        --q-info-light: #cffafe;
        --q-violet: #7c3aed;
        --q-violet-light: #ede9fe;
        --q-text: #111827;
        --q-muted: #6b7280;
        --q-radius: 16px;
        --q-radius-sm: 10px;
        --q-shadow: 0 4px 20px rgba(0,0,0,.07);
        --q-shadow-sm: 0 2px 10px rgba(0,0,0,.05);
    }

    *, *::before, *::after {
        box-sizing: border-box;
    }

    body {
        background: var(--q-bg);
        font-family: 'Cairo';
        color: var(--q-text);
    }

    .qd-page {
        direction: rtl;
    }

    /* ── Header ── */
    .qd-header {
        background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 60%, #1e40af 100%);
        border-radius: 22px;
        padding: 28px 32px;
        color: #fff;
        position: relative;
        overflow: hidden;
    }

        .qd-header::before {
            content: '';
            position: absolute;
            inset: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
            pointer-events: none;
        }

    .qd-header-title {
        font-size: 24px;
        font-weight: 800;
        margin: 0 0 4px;
    }

    .qd-header-sub {
        color: #93c5fd;
        font-size: 16px;
        margin: 0;
    }

    .qd-header-meta {
        color: #94a3b8;
        font-size: 14px;
        margin-top: 6px;
    }

    /* ── Filter Bar ── */
    .qd-filter-bar {
        background: var(--q-surface);
        border-radius: var(--q-radius);
        padding: 16px 20px;
        border: 1px solid var(--q-border);
        box-shadow: var(--q-shadow-sm);
    }

        .qd-filter-bar .form-select,
        .qd-filter-bar .btn {
            border-radius: var(--q-radius-sm);
            font-size: 15px;
            height: 38px;
            border-color: var(--q-border);
        }

            .qd-filter-bar .form-select:focus {
                box-shadow: 0 0 0 3px rgba(30,64,175,.15);
                border-color: var(--q-primary);
            }

    .qd-filter-label {
        font-size: 14px;
        font-weight: 700;
        color: var(--q-muted);
        margin-bottom: 6px;
    }

    .btn-filter-apply {
        background: var(--q-primary);
        color: #fff;
        border: none;
        font-weight: 700;
        padding: 0 22px;
        height: 38px;
        border-radius: var(--q-radius-sm);
        white-space: nowrap;
        transition: background .2s;
    }

        .btn-filter-apply:hover {
            background: #1d4ed8;
            color: #fff;
        }

    .btn-filter-reset {
        background: transparent;
        color: var(--q-muted);
        border: 1px solid var(--q-border);
        font-weight: 600;
        padding: 0 16px;
        height: 38px;
        border-radius: var(--q-radius-sm);
        white-space: nowrap;
        transition: .2s;
    }

        .btn-filter-reset:hover {
            background: #f3f4f6;
            color: var(--q-text);
        }

    /* ── Decision Panel ── */
    .qd-decision {
        border-radius: var(--q-radius);
        padding: 20px 24px;
        border: 1.5px solid;
        display: flex;
        align-items: flex-start;
        gap: 16px;
    }

    .qd-decision-icon {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        flex-shrink: 0;
    }

    .qd-decision-title {
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        opacity: .7;
    }

    .qd-decision-status {
        font-size: 22px;
        font-weight: 800;
        margin: 2px 0 4px;
    }

    .qd-decision-msg {
        font-size: 15px;
        opacity: .85;
        margin: 0 0 6px;
    }

    .qd-decision-action {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 14px;
        font-weight: 700;
        background: rgba(0,0,0,.06);
        border-radius: 8px;
        padding: 4px 10px;
    }

    /* ── KPI Cards ── */
    .qd-kpi {
        background: var(--q-surface);
        border-radius: var(--q-radius);
        padding: 20px;
        border: 1px solid var(--q-border);
        box-shadow: var(--q-shadow-sm);
        height: 100%;
        transition: transform .18s, box-shadow .18s;
        position: relative;
        overflow: hidden;
    }

    .qd-card-link {
        display: block;
        height: 100%;
        color: inherit;
        text-decoration: none;
    }

        .qd-card-link:hover {
            color: inherit;
            text-decoration: none;
        }

        .qd-kpi:hover {
            transform: translateY(-3px);
            box-shadow: var(--q-shadow);
        }

        .qd-kpi::after {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 4px;
            height: 100%;
            border-radius: 0 var(--q-radius) var(--q-radius) 0;
        }

        .qd-kpi.kpi-danger::after {
            background: var(--q-danger);
        }

        .qd-kpi.kpi-warning::after {
            background: var(--q-warning);
        }

        .qd-kpi.kpi-success::after {
            background: var(--q-success);
        }

        .qd-kpi.kpi-primary::after {
            background: var(--q-primary);
        }

        .qd-kpi.kpi-info::after {
            background: var(--q-info);
        }

        .qd-kpi.kpi-violet::after {
            background: var(--q-violet);
        }

    .qd-kpi-open {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-top: 10px;
        color: var(--q-muted);
        font-size: 12px;
        font-weight: 800;
    }

    .qd-kpi-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        margin-bottom: 14px;
    }

    .qd-kpi-value {
        font-size: 28px;
        font-weight: 800;
        line-height: 1;
        margin-bottom: 4px;
    }

    .qd-kpi-label {
        font-size: 15px;
        color: var(--q-muted);
        font-weight: 600;
        margin-bottom: 8px;
    }

    .qd-kpi-sub {
        font-size: 13px;
        color: var(--q-muted);
    }

    .qd-kpi-trend {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        font-size: 13px;
        font-weight: 700;
        border-radius: 6px;
        padding: 2px 7px;
    }

    /* ── Section Headers ── */
    .qd-section-title {
        font-size: 16px;
        font-weight: 800;
        color: var(--q-text);
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
    }

        .qd-section-title .icon-wrap {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

    .qd-section-sub {
        font-size: 14px;
        color: var(--q-muted);
        margin-bottom: 16px;
        margin-right: 42px;
    }

    /* ── Card Box ── */
    .card-box {
        background: var(--q-surface);
        border-radius: var(--q-radius);
        padding: 24px;
        border: 1px solid var(--q-border);
        box-shadow: var(--q-shadow-sm);
    }

    /* ── Tables ── */
    .qd-table-wrap {
        border-radius: var(--q-radius-sm);
        overflow: hidden;
        border: 1px solid var(--q-border);
    }

    .qd-table {
        margin: 0;
        font-size: 15px;
    }

        .qd-table thead th {
            background: #f8fafc;
            color: var(--q-muted);
            font-weight: 700;
            font-size: 13px;
            letter-spacing: .4px;
            text-transform: uppercase;
            padding: 12px 14px;
            border-bottom: 1px solid var(--q-border);
            white-space: nowrap;
        }

        .qd-table tbody td {
            padding: 11px 14px;
            vertical-align: middle;
            border-bottom: 1px solid #f3f4f6;
        }

        .qd-table tbody tr:last-child td {
            border-bottom: none;
        }

        .qd-table tbody tr:hover {
            background: #fafbfc;
        }

    /* ── Badges ── */
    .qd-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
    }

    .badge-danger {
        background: var(--q-danger-light);
        color: #991b1b;
    }

    .badge-warning {
        background: var(--q-warning-light);
        color: #92400e;
    }

    .badge-success {
        background: var(--q-success-light);
        color: #14532d;
    }

    .badge-primary {
        background: var(--q-primary-light);
        color: #1e3a8a;
    }

    .badge-info {
        background: var(--q-info-light);
        color: #164e63;
    }

    .badge-violet {
        background: var(--q-violet-light);
        color: #4c1d95;
    }

    /* ── Progress ── */
    .qd-progress {
        height: 8px;
        border-radius: 20px;
        background: #edf0f3;
        overflow: hidden;
    }

    .qd-progress-bar {
        height: 100%;
        border-radius: 20px;
        transition: width .4s;
    }

    /* ── Charts ── */
    .chart-box {
        position: relative;
        height: 300px;
    }

    /* ── AI Insight Card ── */
    .qd-ai-card {
        background: linear-gradient(135deg, #faf5ff, #ede9fe);
        border: 1px solid #ddd6fe;
        border-radius: var(--q-radius);
        padding: 18px;
    }

    .qd-ai-title {
        font-size: 14px;
        font-weight: 800;
        color: var(--q-violet);
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: 6px;
    }

    .qd-ai-headline {
        font-size: 15px;
        font-weight: 700;
        color: #3b0764;
        margin-bottom: 6px;
    }

    .qd-ai-body {
        font-size: 15px;
        color: #4c1d95;
        margin: 0;
    }

    .qd-ai-action {
        margin-top: 10px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: var(--q-violet);
        color: #fff;
        border-radius: 8px;
        padding: 5px 12px;
        font-size: 14px;
        font-weight: 700;
    }

    .qd-ai-priority {
        font-size: 13px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 6px;
        background: #7c3aed22;
        color: var(--q-violet);
        margin-right: 8px;
    }

    /* ── Empty State ── */
    .qd-empty {
        padding: 40px 20px;
        text-align: center;
        color: var(--q-muted);
        background: #fafafa;
        border-radius: var(--q-radius-sm);
    }

        .qd-empty i {
            font-size: 36px;
            opacity: .35;
            display: block;
            margin-bottom: 10px;
        }

    .qd-empty-title {
        font-weight: 700;
        font-size: 16px;
        color: var(--q-text);
        margin-bottom: 4px;
    }

    .qd-empty-sub {
        font-size: 14px;
    }

    /* ── Pagination ── */
    .qd-pager {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

        .qd-pager a, .qd-pager span {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 700;
            border: 1px solid var(--q-border);
            color: var(--q-muted);
            text-decoration: none;
            transition: .18s;
        }

            .qd-pager a:hover {
                background: var(--q-primary-light);
                color: var(--q-primary);
                border-color: var(--q-primary);
            }

            .qd-pager span.active {
                background: var(--q-primary);
                color: #fff;
                border-color: var(--q-primary);
            }

            .qd-pager span.disabled {
                opacity: .4;
                pointer-events: none;
            }

    /* ── Loading overlay ── */
    .qd-loading {
        background: var(--q-surface);
        border-radius: var(--q-radius);
        padding: 60px 20px;
        text-align: center;
        box-shadow: var(--q-shadow-sm);
    }

        .qd-loading .spinner-border {
            width: 36px;
            height: 36px;
            border-width: 3px;
            color: var(--q-primary);
        }

    /* ── Responsive ── */
    @@media (max-width: 991px) {
        .qd-header {
            padding: 20px;
        }

        .qd-header-title {
            font-size: 18px;
        }

        .qd-filter-bar .d-flex {
            flex-wrap: wrap;
        }
    }

    @@media (max-width: 767px) {
        .chart-box {
            height: 240px;
        }

        .qd-kpi-value {
            font-size: 22px;
        }

        .qd-decision {
            flex-direction: column;
            gap: 10px;
        }

        .table-responsive {
            border-radius: var(--q-radius-sm);
        }
    }

    /* ─── Clickable KPI Cards ─── */
    .qd-kpi-clickable { cursor: pointer; }
    .qd-kpi-clickable:hover { border-color: #93c5fd; }

    /* ─── Analytics Offcanvas ─── */
    .qd-offcanvas { width: 480px !important; }
    .qd-offcanvas .offcanvas-header { padding: 18px 20px; color: #fff; direction: rtl; }
    .qd-offcanvas .offcanvas-header .btn-close { filter: invert(1); opacity: .85; }
    .qd-offcanvas .offcanvas-body { padding: 0; direction: rtl; display: flex; flex-direction: column; overflow: hidden; background: var(--q-bg); }
    .qd-oc-summary { padding: 12px 14px; background: var(--q-surface); border-bottom: 1px solid var(--q-border); display: flex; gap: 8px; flex-wrap: wrap; align-items: center; flex-shrink: 0; }
    .qd-oc-list { padding: 12px; overflow-y: auto; flex: 1; }
    .qd-oc-footer { padding: 12px 14px; background: var(--q-surface); border-top: 1px solid var(--q-border); display: flex; gap: 8px; flex-wrap: wrap; flex-shrink: 0; align-items: center; }
    .qd-oc-item { background: var(--q-surface); border: 1px solid var(--q-border); border-radius: var(--q-radius-sm); padding: 12px 14px; margin-bottom: 8px; transition: box-shadow .15s, border-color .15s; }
    .qd-oc-item:last-child { margin-bottom: 0; }
    .qd-oc-item:hover { box-shadow: var(--q-shadow-sm); border-color: #93c5fd; }
    .qd-oc-item-title { font-size: 14px; font-weight: 800; color: var(--q-text); margin-bottom: 4px; }
    .qd-oc-item-sub { font-size: 12px; color: var(--q-muted); margin-bottom: 2px; }
    .qd-oc-item-stats { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
    .qd-nav-btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 16px; border-radius: var(--q-radius-sm); font-size: 13px; font-weight: 700; text-decoration: none; transition: all .15s; border: 1px solid var(--q-border); white-space: nowrap; }
    .qd-nav-btn-primary { background: var(--q-primary); color: #fff !important; border-color: var(--q-primary); }
    .qd-nav-btn-primary:hover { background: #1d4ed8; }
    .qd-nav-btn-secondary { background: transparent; color: var(--q-muted); }
    .qd-nav-btn-secondary:hover { background: var(--q-primary-light); color: var(--q-primary) !important; border-color: #93c5fd; }
    .qd-nav-btn-ghost { background: #f3f4f6; color: var(--q-muted); border-color: var(--q-border); }
    .qd-nav-btn-ghost:hover { background: #e5e7eb; color: var(--q-text); }
    .qd-nav-ms-auto { margin-right: auto; }
    @@media(max-width:576px) { .qd-offcanvas { width: 100% !important; } }
</style>

@* ===================== GOOGLE FONT ===================== *@
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

@* ===================== PAGE ===================== *@
<div class="container-fluid qd-page py-4 px-3 px-lg-4">

    @* ── 1. Page Header ── *@
    <div class="qd-header mb-4">
        <div class="row align-items-center g-3">
            <div class="col-lg-6">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div style="background:rgba(255,255,255,.12);border-radius:14px;width:48px;height:48px;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <div>
                        <h1 class="qd-header-title">لوحة التحليلات الذكية</h1>
                        <p class="qd-header-sub">محرك القرارات — أداء الطلاب، الدفعات، المدربين، والدروس الضعيفة</p>
                    </div>
                </div>
                <div class="qd-header-meta">
                    <i class="bi bi-clock me-1"></i> آخر تحديث: @now
                </div>
                @if (User.IsInRole("Owner") || User.IsInRole("Developer"))
                {
                    <div class="mt-3">
                        <a asp-area="Admin"
                           asp-controller="DecisionLab"
                           asp-action="Index"
                           asp-route-batchId="@Model.SelectedBatchId"
                           asp-route-curriculumId="@Model.SelectedCurriculumId"
                           class="btn btn-sm btn-light fw-bold">
                            <i class="bi bi-flask me-1"></i>
                            فتح مختبر القرار
                        </a>
                    </div>
                }
            </div>
            <div class="col-lg-6">
                @* Filter Bar *@
                <div class="qd-filter-bar">
                    <form id="advancedDashboardFilters"
                          method="get"
                          asp-area="Admin"
                          asp-controller="Analytics"
                          asp-action="AdvancedDashboard">
                        <div class="row g-2 align-items-end">
                            <div class="col-12 col-sm-4">
                                <div class="qd-filter-label"><i class="bi bi-book me-1"></i>المنهج</div>
                                <select id="curriculumId" name="curriculumId" class="form-select form-select-sm">
                                    <option value="">كل المناهج</option>
                                    @foreach (var item in Model.CurriculumsFilter)
                                    {
                                        <option value="@item.Id" selected="@(Model.SelectedCurriculumId == item.Id)">@item.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-sm-4">
                                <div class="qd-filter-label"><i class="bi bi-people me-1"></i>الدفعة</div>
                                <select id="batchId" name="batchId" class="form-select form-select-sm">
                                    <option value="">كل الدفعات</option>
                                    @foreach (var item in Model.BatchesFilter)
                                    {
                                        <option value="@item.Id" selected="@(Model.SelectedBatchId == item.Id)">@item.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-sm-4">
                                <div class="qd-filter-label"><i class="bi bi-person-badge me-1"></i>المدرب</div>
                                <select id="instructorId" name="instructorId" class="form-select form-select-sm">
                                    <option value="">كل المدربين</option>
                                    @foreach (var item in Model.InstructorsFilter)
                                    {
                                        <option value="@item.Id" selected="@(Model.SelectedInstructorId == item.Id)">@item.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <div class="d-flex gap-2 justify-content-end mt-1">
                                    <button type="button" class="btn-filter-reset" onclick="resetFilters()">
                                        <i class="bi bi-x-circle me-1"></i> إعادة تعيين
                                    </button>
                                    <button type="submit" class="btn-filter-apply">
