    @* ── 6. إعادة تصنيف صعوبة الأسئلة (Professional Redesign) ── *@
    @Html.AntiForgeryToken()

    <style>
    /* ── Recalibration Card ── */
    .rc-card {
        background: #fff;
        border: 1px solid #E2E8F0;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(15,23,42,.06);
        margin-top: 24px;
    }

    .rc-card-toggle {
        width: 100%;
        border: none;
        background: none;
        padding: 20px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        cursor: pointer;
        font-family: inherit;
        text-align: right;
        transition: background .15s;
    }
    .rc-card-toggle:hover { background: #FAFBFF; }

    .rc-toggle-left { display: flex; align-items: center; gap: 14px; }

    .rc-toggle-icon {
        width: 44px; height: 44px; border-radius: 12px; flex-shrink: 0;
        background: linear-gradient(135deg, #6D28D9, #7C3AED);
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: 20px;
        box-shadow: 0 4px 12px rgba(109,40,217,.30);
    }

    .rc-toggle-title { font-size: 16px; font-weight: 800; color: #0F172A; }
    .rc-toggle-sub   { font-size: 13px; color: #64748B; margin-top: 2px; font-weight: 500; }

    .rc-chevron {
        width: 32px; height: 32px; border-radius: 8px;
        background: #F1F5F9; display: flex; align-items: center; justify-content: center;
        color: #64748B; font-size: 14px; transition: transform .25s, background .15s; flex-shrink: 0;
    }
    .rc-card.is-open .rc-chevron { transform: rotate(180deg); background: #EDE9FE; color: #7C3AED; }

    .rc-body { display: none; border-top: 1px solid #F1F5F9; }
    .rc-card.is-open .rc-body { display: block; }
    .rc-body-inner { padding: 28px 24px; }

    /* Section sub-label */
    .rc-section-label {
        display: flex; align-items: center; gap: 8px;
        font-size: 12px; font-weight: 800; text-transform: uppercase;
        letter-spacing: .7px; color: #94A3B8; margin-bottom: 16px;
    }
    .rc-section-label::after { content: ''; flex: 1; height: 1px; background: #E2E8F0; }

    /* Difficulty zones visual bar */
    .rc-zone-bar {
        height: 10px; border-radius: 20px; overflow: hidden;
        display: flex; margin-bottom: 6px; gap: 2px;
        transition: all .3s;
    }
    .rc-zone-bar-seg { height: 100%; border-radius: 20px; transition: flex .3s; }

    /* Difficulty inputs grid */
    .rc-zones-grid {
        display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 8px;
    }
    @@media (max-width: 768px) { .rc-zones-grid { grid-template-columns: repeat(2, 1fr); } }

    .rc-zone-input {
        border-radius: 14px; overflow: hidden;
        border: 2px solid var(--zc, #E2E8F0);
        background: var(--zb, #F8FAFC);
        transition: border-color .2s, box-shadow .2s;
    }
    .rc-zone-input:focus-within {
        border-color: var(--zc, #7C3AED);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--zc, #7C3AED) 15%, transparent);
    }

    .rc-zone-header {
        padding: 10px 13px 8px;
        display: flex; align-items: center; gap: 7px;
    }
    .rc-zone-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--zc, #CBD5E1); flex-shrink: 0; }
    .rc-zone-name { font-size: 13px; font-weight: 800; color: var(--zc, #475569); }

    .rc-zone-body { padding: 0 13px 12px; }

    .rc-zone-input-wrap {
        display: flex; align-items: center; gap: 0;
        background: #fff; border-radius: 10px; overflow: hidden;
        border: 1.5px solid #E2E8F0;
    }
    .rc-zone-input-wrap input[type="number"] {
        flex: 1; border: none; outline: none; padding: 8px 10px;
        font-family: inherit; font-size: 16px; font-weight: 800;
        color: #0F172A; background: transparent; min-width: 0;
        text-align: center;
    }
    .rc-zone-input-wrap .rc-pct { padding: 8px 10px 8px 6px; font-size: 13px; font-weight: 700; color: #94A3B8; }

    .rc-zone-range-label { font-size: 11px; color: #94A3B8; font-weight: 600; margin-top: 6px; text-align: center; }

    .rc-zone-readonly {
        padding: 9px 10px; text-align: center;
        font-size: 13px; font-weight: 700; color: #64748B;
        background: #F8FAFC; border-radius: 10px; border: 1.5px solid #E2E8F0;
    }

    .rc-validation-msg {
        font-size: 12px; color: #EF4444; font-weight: 600;
        margin-top: 8px; display: none; align-items: center; gap: 5px;
    }
    .rc-validation-msg.visible { display: flex; }

    /* Date range */
    .rc-date-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
    }
    @@media (max-width: 640px) { .rc-date-grid { grid-template-columns: 1fr; } }

    .rc-date-field { }
    .rc-date-label {
        font-size: 12px; font-weight: 700; color: #475569;
        margin-bottom: 6px; display: block;
    }
    .rc-date-input {
        width: 100%; border: 1.5px solid #E2E8F0; border-radius: 10px;
        padding: 9px 13px; font-family: inherit; font-size: 13px;
        color: #0F172A; background: #fff; outline: none; transition: border-color .15s, box-shadow .15s;
    }
    .rc-date-input:focus { border-color: #3B82F6; box-shadow: 0 0 0 3px rgba(59,130,246,.12); }

    /* Action buttons */
    .rc-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

    .rc-btn {
        display: inline-flex; align-items: center; gap: 7px;
        padding: 10px 22px; border-radius: 10px;
        font-family: inherit; font-size: 13px; font-weight: 800;
        cursor: pointer; border: none; transition: all .18s; white-space: nowrap;
    }
    .rc-btn-preview {
        background: #EEF2FF; color: #4338CA; border: 1.5px solid #C7D2FE;
    }
    .rc-btn-preview:hover { background: #E0E7FF; border-color: #A5B4FC; }
    .rc-btn-preview:disabled { opacity: .45; cursor: not-allowed; }

    .rc-btn-apply {
        background: linear-gradient(135deg, #6D28D9, #7C3AED);
        color: #fff; border: none;
        box-shadow: 0 4px 14px rgba(109,40,217,.32);
    }
    .rc-btn-apply:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(109,40,217,.42); }
    .rc-btn-apply:disabled { opacity: .45; cursor: not-allowed; transform: none; box-shadow: none; }

    .rc-spinner {
        display: none; align-items: center; gap: 8px;
        font-size: 13px; color: #64748B; font-weight: 600;
    }
    .rc-spinner.active { display: flex; }
    .rc-spin-dot {
        width: 18px; height: 18px; border-radius: 50%;
        border: 2.5px solid #E2E8F0; border-top-color: #7C3AED;
        animation: rcSpin .7s linear infinite;
    }
    @@keyframes rcSpin { to { transform: rotate(360deg); } }

    /* Result area */
    #rcResultArea { margin-top: 20px; }

    .rc-result-card {
        border-radius: 16px; padding: 20px;
        border: 1.5px solid; animation: rcFadeIn .3s ease;
    }
    @@keyframes rcFadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

    .rc-result-header {
        display: flex; align-items: center; gap: 10px; margin-bottom: 18px; flex-wrap: wrap;
    }
    .rc-result-icon { font-size: 22px; }
    .rc-result-title { font-size: 15px; font-weight: 800; }
    .rc-result-meta { margin-right: auto; font-size: 12px; color: #64748B; }

    .rc-stat-grid {
        display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; margin-bottom: 16px;
    }
    @@media (max-width: 768px) { .rc-stat-grid { grid-template-columns: repeat(3, 1fr); } }
    @@media (max-width: 480px) { .rc-stat-grid { grid-template-columns: repeat(2, 1fr); } }

    .rc-stat-chip {
        border-radius: 12px; padding: 12px 8px; text-align: center;
        border: 1px solid transparent;
    }
    .rc-stat-chip-val { font-size: 22px; font-weight: 900; line-height: 1; }
    .rc-stat-chip-lbl { font-size: 10px; font-weight: 600; margin-top: 4px; opacity: .8; }

    .rc-changed-table-wrap { border-radius: 10px; overflow: hidden; border: 1px solid #E2E8F0; }
    .rc-changed-table-title {
        padding: 10px 14px; font-size: 13px; font-weight: 700; color: #334155;
        background: #F8FAFC; border-bottom: 1px solid #E2E8F0;
        display: flex; align-items: center; gap: 6px;
    }
    .rc-diff-badge {
        display: inline-flex; align-items: center; gap: 3px;
        padding: 2px 7px; border-radius: 20px; font-size: 11px; font-weight: 700; border: 1px solid;
    }

    .rc-error-box {
        padding: 14px 18px; border-radius: 12px;
        background: #FFF1F2; border: 1.5px solid #FECDD3; color: #9F1239;
        font-size: 13px; font-weight: 700; display: flex; align-items: center; gap: 9px;
    }
    </style>

    @* ── توزيع الأسئلة حسب الصعوبة ── *@
    <style>
