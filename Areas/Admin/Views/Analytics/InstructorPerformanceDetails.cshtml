@using QdratNew.ViewModels.Admin.Analytics
@model QdratNew.ViewModels.Admin.Analytics.InstructorPerformanceDetailsVM

@{
    ViewData["Title"] = "تفاصيل أداء المدرب";

    var batches = Model?.Batches ?? new List<InstructorBatchPerformanceVM>();

    var lessons = batches
        .SelectMany(batch => (batch.WeakLessons ?? new List<InstructorWeakLessonVM>())
            .Select(lesson => new
            {
                lesson.LessonId,
                lesson.LessonName,
                lesson.AffectedStudents,
                WeakPercentage = lesson.WeaknessPercentage,
                lesson.HighRiskQuestions,
                BatchId = batch.BatchId,
                BatchName = batch.BatchName,
                CourseName = batch.CourseName,
                InstructorName = Model?.InstructorName ?? "-"
            }))
        .OrderByDescending(x => x.WeakPercentage)
        .ToList();

    var highRiskLessons = lessons
        .Where(x => x.WeakPercentage >= 70)
        .ToList();

    var medRiskLessons = lessons
        .Where(x => x.WeakPercentage >= 50 && x.WeakPercentage < 70)
        .ToList();

    var avgWeakness = lessons.Any()
        ? Math.Round(lessons.Average(x => x.WeakPercentage), 1)
        : 0;

    var affectedStudents = lessons.Sum(x => x.AffectedStudents);

    var maxWeakness = lessons.Any()
        ? Math.Round(lessons.Max(x => x.WeakPercentage), 1)
        : 0;

    var worstLesson = lessons.FirstOrDefault();
}
<style>
    :root {
        --q-bg: #f0f2f5;
        --q-surface: #ffffff;
        --q-border: #e5e7eb;
        --q-primary: #1e40af;
        --q-primary-light: #dbeafe;
        --q-success: #16a34a;
        --q-success-light: #dcfce7;
        --q-warning: #d97706;
        --q-warning-light: #fef3c7;
        --q-danger: #dc2626;
        --q-danger-light: #fee2e2;
        --q-info: #0891b2;
        --q-info-light: #cffafe;
        --q-violet: #7c3aed;
        --q-violet-light: #ede9fe;
        --q-text: #111827;
        --q-muted: #6b7280;
        --q-radius: 16px;
        --q-radius-sm: 10px;
        --q-shadow: 0 4px 20px rgba(0,0,0,.07);
        --q-shadow-sm: 0 2px 10px rgba(0,0,0,.05);
    }

    *, *::before, *::after {
        box-sizing: border-box;
    }

    body {
        background: var(--q-bg);
        font-family: 'Tajawal', 'Cairo', Tahoma, Arial, sans-serif;
        color: var(--q-text);
    }

    .qd-page {
        direction: rtl;
    }

    /* ── Header ── */
    .qd-header {
        background: linear-gradient(135deg, #431407 0%, #9a3412 55%, #ea580c 100%);
        border-radius: 22px;
        padding: 28px 32px;
        color: #fff;
        position: relative;
        overflow: hidden;
    }

        .qd-header::before {
            content: '';
            position: absolute;
            inset: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
            pointer-events: none;
        }

    .qd-header-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.25);
        border-radius: 8px;
        padding: 4px 12px;
        font-size: 12px;
        font-weight: 700;
        color: #fed7aa;
        margin-bottom: 10px;
    }

    .qd-header-title {
        font-size: 22px;
        font-weight: 800;
        margin: 0 0 4px;
    }

    .qd-header-sub {
        color: #fed7aa;
        font-size: 14px;
        margin: 0;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,255,255,.12);
        color: #fff;
        border: 1px solid rgba(255,255,255,.25);
        border-radius: var(--q-radius-sm);
        padding: 8px 18px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: background .2s;
        backdrop-filter: blur(4px);
    }

        .btn-back:hover {
            background: rgba(255,255,255,.22);
            color: #fff;
        }

    /* ── KPI Cards ── */
    .qd-kpi {
        background: var(--q-surface);
        border-radius: var(--q-radius);
        padding: 20px;
        border: 1px solid var(--q-border);
        box-shadow: var(--q-shadow-sm);
        height: 100%;
        transition: transform .18s, box-shadow .18s;
        position: relative;
        overflow: hidden;
    }

        .qd-kpi:hover {
            transform: translateY(-3px);
            box-shadow: var(--q-shadow);
        }

        .qd-kpi::after {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 4px;
            height: 100%;
            border-radius: 0 var(--q-radius) var(--q-radius) 0;
        }

        .qd-kpi.kpi-warning::after {
            background: var(--q-warning);
        }

        .qd-kpi.kpi-danger::after {
            background: var(--q-danger);
        }

        .qd-kpi.kpi-primary::after {
            background: var(--q-primary);
        }

        .qd-kpi.kpi-violet::after {
            background: var(--q-violet);
        }

    .qd-kpi-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        margin-bottom: 14px;
    }

    .qd-kpi-value {
        font-size: 28px;
        font-weight: 800;
        line-height: 1;
        margin-bottom: 4px;
    }

    .qd-kpi-label {
        font-size: 13px;
        color: var(--q-muted);
        font-weight: 600;
        margin-bottom: 4px;
    }

    .qd-kpi-sub {
        font-size: 11px;
        color: var(--q-muted);
    }

    /* ── Worst Lesson Spotlight ── */
    .qd-spotlight {
        background: linear-gradient(135deg, #fff7ed, #fff1f2);
        border: 1.5px solid #fca5a5;
        border-radius: var(--q-radius);
        padding: 20px 24px;
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
    }

    .qd-spotlight-icon {
        width: 54px;
        height: 54px;
        border-radius: 50%;
        background: var(--q-danger);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        flex-shrink: 0;
    }

    .qd-spotlight-tag {
        font-size: 11px;
        font-weight: 700;
        color: var(--q-danger);
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .qd-spotlight-title {
        font-size: 17px;
        font-weight: 800;
        color: #7f1d1d;
        margin: 2px 0 6px;
    }

    .qd-spotlight-meta {
        font-size: 12px;
        color: #991b1b;
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
    }

        .qd-spotlight-meta span {
            display: flex;
            align-items: center;
            gap: 4px;
        }

    .qd-spotlight-pct {
        font-size: 38px;
        font-weight: 900;
        color: var(--q-danger);
        line-height: 1;
    }

    /* ── Risk Distribution ── */
    .risk-dist-card {
        background: var(--q-surface);
        border-radius: var(--q-radius);
        padding: 18px 22px;
        border: 1px solid var(--q-border);
        box-shadow: var(--q-shadow-sm);
    }

    .risk-dist-bar {
        height: 12px;
        border-radius: 20px;
        background: #f3f4f6;
        overflow: hidden;
        display: flex;
        margin: 10px 0;
    }

    .risk-dist-seg {
        height: 100%;
        transition: width .5s;
    }

    .risk-dist-legend {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }

    .risk-legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 700;
    }

    .risk-legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    /* ── Card Box ── */
    .card-box {
        background: var(--q-surface);
        border-radius: var(--q-radius);
        padding: 24px;
        border: 1px solid var(--q-border);
        box-shadow: var(--q-shadow-sm);
    }

    /* ── Section Title ── */
    .qd-section-title {
        font-size: 16px;
        font-weight: 800;
        color: var(--q-text);
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
    }

        .qd-section-title .icon-wrap {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

    .qd-section-sub {
        font-size: 12px;
        color: var(--q-muted);
        margin-bottom: 16px;
        margin-right: 42px;
    }

    /* ── Table ── */
    .qd-table-wrap {
        border-radius: var(--q-radius-sm);
        overflow: hidden;
        border: 1px solid var(--q-border);
    }

    .qd-table {
        margin: 0;
        font-size: 13px;
    }

        .qd-table thead th {
            background: #f8fafc;
            color: var(--q-muted);
            font-weight: 700;
            font-size: 11px;
            letter-spacing: .4px;
            text-transform: uppercase;
            padding: 12px 14px;
            border-bottom: 1px solid var(--q-border);
            white-space: nowrap;
        }

        .qd-table tbody td {
            padding: 12px 14px;
            vertical-align: middle;
            border-bottom: 1px solid #f3f4f6;
        }

        .qd-table tbody tr:last-child td {
            border-bottom: none;
        }

        .qd-table tbody tr:hover {
            background: #fafbfc;
        }

        .qd-table tbody tr.row-high:hover {
            background: #fff1f0;
        }

        .qd-table tbody tr.row-med:hover {
            background: #fffbf0;
        }

    /* ── Progress ── */
    .qd-progress {
        height: 8px;
        border-radius: 20px;
        background: #edf0f3;
        overflow: hidden;
        margin-top: 5px;
    }

    .qd-progress-bar {
        height: 100%;
        border-radius: 20px;
        transition: width .4s;
    }

    /* ── Badges ── */
    .qd-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .badge-danger {
        background: var(--q-danger-light);
        color: #991b1b;
    }

    .badge-warning {
        background: var(--q-warning-light);
        color: #92400e;
    }

    .badge-success {
        background: var(--q-success-light);
        color: #14532d;
    }

    .badge-primary {
        background: var(--q-primary-light);
        color: #1e3a8a;
    }

    /* ── Rank ── */
    .rank-circle {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 800;
        flex-shrink: 0;
    }

    .rank-high {
        background: var(--q-danger-light);
        color: var(--q-danger);
    }

    .rank-med {
        background: var(--q-warning-light);
        color: var(--q-warning);
    }

    /* ── Detail Link ── */
    .btn-detail {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: var(--q-primary-light);
        color: var(--q-primary);
        border: none;
        border-radius: 8px;
        padding: 5px 12px;
        font-size: 11px;
        font-weight: 700;
        text-decoration: none;
        transition: background .2s;
        white-space: nowrap;
        font-family: inherit;
        cursor: pointer;
    }

        .btn-detail:hover {
            background: #bfdbfe;
            color: var(--q-primary);
        }

    /* ── Search ── */
    .qd-search {
        border-radius: var(--q-radius-sm);
        border: 1px solid var(--q-border);
        padding: 8px 14px;
        font-size: 13px;
        width: 100%;
        max-width: 280px;
        outline: none;
        transition: border .2s;
        font-family: inherit;
    }

        .qd-search:focus {
            border-color: #ea580c;
            box-shadow: 0 0 0 3px rgba(234,88,12,.1);
        }

    /* ── Empty ── */
    .qd-empty {
        padding: 50px 20px;
        text-align: center;
        background: var(--q-success-light);
        border-radius: var(--q-radius-sm);
    }

        .qd-empty i {
            font-size: 44px;
            color: var(--q-success);
            opacity: .7;
            display: block;
            margin-bottom: 12px;
        }

    .qd-empty-title {
        font-weight: 800;
        font-size: 16px;
        color: var(--q-success);
        margin-bottom: 4px;
    }

    .qd-empty-sub {
        font-size: 12px;
        color: #166534;
    }


    /* ── Clickable Cards / Rows ── */
    .qd-action-link {
        display: block;
        height: 100%;
        color: inherit;
        text-decoration: none;
    }

        .qd-action-link:hover {
            color: inherit;
            text-decoration: none;
        }

    .qd-clickable-card {
        cursor: pointer;
        transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }

        .qd-clickable-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--q-shadow);
            border-color: rgba(30, 64, 175, .28);
        }

        .qd-clickable-card .qd-kpi-sub::after {
            content: " — اضغط للتفاصيل";
            color: var(--q-primary);
            font-weight: 800;
        }

    .qd-clickable-row {
        cursor: pointer;
        transition: background .15s ease, transform .15s ease;
    }

        .qd-clickable-row:hover {
            background: #f8fafc !important;
        }

    .qd-row-main-link {
        color: inherit;
        text-decoration: none;
        display: block;
    }

        .qd-row-main-link:hover {
            color: var(--q-primary);
            text-decoration: none;
        }

    .qd-action-hint {
        font-size: 11px;
        color: var(--q-primary);
        font-weight: 800;
        margin-top: 4px;
    }



    @@media (max-width: 991px) {
        .qd-header {
            padding: 20px;
        }

        .qd-header-title {
            font-size: 18px;
        }

        .qd-spotlight {
            flex-direction: column;
            gap: 10px;
        }
    }

    @@media (max-width: 767px) {
        .qd-kpi-value {
            font-size: 22px;
        }
    }
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid qd-page py-4 px-3 px-lg-4">

    @* ── 1. Header ── *@
    <div class="qd-header mb-4">
        <div class="row align-items-center g-3">
            <div class="col-lg-8">
                <div class="qd-header-badge">
                    <i class="bi bi-book-half"></i> تحليل الدروس
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div style="background:rgba(255,255,255,.15);border-radius:14px;width:50px;height:50px;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;">
                        <i class="bi bi-exclamation-diamond-fill"></i>
                    </div>

                    <div>
                        <h1 class="qd-header-title">تفاصيل الدروس الحرجة</h1>
                        <p class="qd-header-sub">الدروس التي ظهرت فيها نسب ضعف مرتفعة وتحتاج تدخلًا تدريبيًا مباشرًا</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 text-lg-end">
                <a asp-area="Admin"
                   asp-controller="Analytics"
                   asp-action="AdvancedDashboard"
                   class="btn-back">
                    <i class="bi bi-arrow-right"></i> رجوع للوحة التحليل
                </a>
            </div>
        </div>
    </div>

    @* ── 2. KPI Cards ── *@
    <div class="row g-3 mb-4">

        <div class="col-6 col-md-3">
            <a asp-area="Admin"
               asp-controller="Analytics"
               asp-action="InstructorPerformanceDetails"
               asp-route-instructorId="@Model.InstructorId"
               asp-fragment="lessons-section"
               class="qd-action-link">

                <div class="qd-kpi kpi-warning qd-clickable-card">
                    <div class="qd-kpi-icon" style="background:var(--q-warning-light);color:var(--q-warning);">
                        <i class="bi bi-book-half"></i>
                    </div>

                    <div class="qd-kpi-value" style="color:var(--q-warning);">@lessons.Count</div>
                    <div class="qd-kpi-label">الدروس الضعيفة</div>
                    <div class="qd-kpi-sub">نسبة ضعف ≥ 50%</div>
                </div>

            </a>
        </div>

        <div class="col-6 col-md-3">
            <a asp-area="Admin"
               asp-controller="Analytics"
               asp-action="InstructorPerformanceDetails"
               asp-route-instructorId="@Model.InstructorId"
               asp-fragment="lessons-section"
               class="qd-action-link">

                <div class="qd-kpi kpi-danger qd-clickable-card">
                    <div class="qd-kpi-icon" style="background:var(--q-danger-light);color:var(--q-danger);">
                        <i class="bi bi-exclamation-diamond-fill"></i>
                    </div>

                    <div class="qd-kpi-value" style="color:var(--q-danger);">@highRiskLessons.Count</div>
                    <div class="qd-kpi-label">عالية الخطورة</div>
                    <div class="qd-kpi-sub">نسبة ضعف ≥ 70%</div>
                </div>

            </a>
        </div>

        <div class="col-6 col-md-3">
            <a asp-area="Admin"
               asp-controller="Analytics"
               asp-action="InstructorPerformanceDetails"
               asp-route-instructorId="@Model.InstructorId"
               asp-fragment="risk-section"
               class="qd-action-link">

                <div class="qd-kpi kpi-danger qd-clickable-card">
                    <div class="qd-kpi-icon" style="background:#fff7ed;color:#ea580c;">
                        <i class="bi bi-percent"></i>
                    </div>

                    <div class="qd-kpi-value" style="color:#ea580c;">@avgWeakness%</div>
                    <div class="qd-kpi-label">متوسط الضعف</div>
                    <div class="qd-kpi-sub">عبر جميع الدروس المحللة</div>
                </div>

            </a>
        </div>

        <div class="col-6 col-md-3">
            <a asp-area="Admin"
               asp-controller="Analytics"
               asp-action="AnalyzedStudentsDetails"
               asp-route-instructorId="@Model.InstructorId"
               class="qd-action-link">

                <div class="qd-kpi kpi-primary qd-clickable-card">
                    <div class="qd-kpi-icon" style="background:var(--q-primary-light);color:var(--q-primary);">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <div class="qd-kpi-value" style="color:var(--q-primary);">@affectedStudents</div>
                    <div class="qd-kpi-label">الطلاب المتأثرون</div>
                    <div class="qd-kpi-sub">طالب تضرر من ضعف الدروس</div>
                </div>

            </a>
        </div>

    </div>

    @* ── 3. Worst Lesson Spotlight + Risk Distribution ── *@
    @if (lessons.Any())
    {
        var total = lessons.Count;
        var highPct = total > 0 ? (highRiskLessons.Count * 100 / total) : 0;
        var medPct = total > 0 ? (medRiskLessons.Count * 100 / total) : 0;
        var lowPct = 100 - highPct - medPct;

        <div class="row g-3 mb-4" id="risk-section">

            @* Worst lesson spotlight *@
            <div class="col-lg-7">
                @if (worstLesson != null)
                {
                    <a asp-area="Admin"
                       asp-controller="Analytics"
                       asp-action="WeakLessonDetails"
                       asp-route-lessonId="@worstLesson.LessonId"
                       asp-route-batchId="@worstLesson.BatchId"
                       asp-route-instructorId="@Model.InstructorId"
                       class="qd-action-link">

                        <div class="qd-spotlight h-100 qd-clickable-card">
                            <div class="qd-spotlight-icon">
                                <i class="bi bi-exclamation-octagon-fill"></i>
                            </div>

                            <div class="flex-grow-1">
                                <div class="qd-spotlight-tag">الدرس الأعلى خطورة</div>
                                <div class="qd-spotlight-title">@(worstLesson?.LessonName ?? "-")</div>

                                <div class="qd-spotlight-meta">
                                    <span>
                                        <i class="bi bi-layers-fill"></i>
                                        @(worstLesson?.BatchName ?? "-")
                                    </span>

                                    <span>
                                        <i class="bi bi-person-badge-fill"></i>
                                        @(worstLesson?.InstructorName ?? "-")
                                    </span>

                                    <span>
                                        <i class="bi bi-people-fill"></i>
                                        @(worstLesson?.AffectedStudents ?? 0) طالب متأثر
                                    </span>
                                </div>

                                <div class="qd-action-hint">
                                    اضغط لعرض تفاصيل الدرس والأسئلة عالية الخطأ
                                </div>
                            </div>

                            <div class="text-center flex-shrink-0">
                                <div class="qd-spotlight-pct">@maxWeakness%</div>
                                <div style="font-size:11px;color:#991b1b;">نسبة الضعف</div>

                                <div class="qd-progress mt-2" style="width:100px;">
                                    <div class="qd-progress-bar" style="width:@maxWeakness%;background:var(--q-danger);height:10px;"></div>
                                </div>
                            </div>
                        </div>

                    </a>
                }
            </div>

            @* Risk distribution *@
            <div class="col-lg-5">
                <a asp-area="Admin"
                   asp-controller="Analytics"
                   asp-action="InstructorPerformanceDetails"
                   asp-route-instructorId="@Model.InstructorId"
                   asp-fragment="lessons-section"
                   class="qd-action-link">

                    <div class="risk-dist-card h-100 qd-clickable-card">
                        <div style="font-size:13px;font-weight:800;margin-bottom:2px;">
                            توزيع مستويات الخطورة
                        </div>

                        <div style="font-size:11px;color:var(--q-muted);margin-bottom:10px;">
                            من إجمالي @total درس ضعيف
                        </div>

                        <div class="risk-dist-bar">
                            <div class="risk-dist-seg" style="width:@highPct%;background:var(--q-danger);"></div>
                            <div class="risk-dist-seg" style="width:@medPct%;background:var(--q-warning);"></div>
                            <div class="risk-dist-seg" style="width:@lowPct%;background:var(--q-success);"></div>
                        </div>

                        <div class="risk-dist-legend mt-3">
                            <div class="risk-legend-item">
                                <div class="risk-legend-dot" style="background:var(--q-danger);"></div>
                                <span>خطر عالي — <strong>@highRiskLessons.Count</strong> (@highPct%)</span>
                            </div>

                            <div class="risk-legend-item">
                                <div class="risk-legend-dot" style="background:var(--q-warning);"></div>
                                <span>متوسط — <strong>@medRiskLessons.Count</strong> (@medPct%)</span>
                            </div>

                            <div class="risk-legend-item">
                                <div class="risk-legend-dot" style="background:var(--q-success);"></div>
                                <span>مقبول — <strong>@(total - highRiskLessons.Count - medRiskLessons.Count)</strong> (@lowPct%)</span>
                            </div>
                        </div>

                        <div class="d-flex gap-3 mt-3 pt-3" style="border-top:1px solid var(--q-border);">
                            <div>
                                <div style="font-size:18px;font-weight:800;color:var(--q-danger);">@maxWeakness%</div>
                                <div style="font-size:11px;color:var(--q-muted);">أعلى نسبة ضعف</div>
                            </div>

                            <div>
                                <div style="font-size:18px;font-weight:800;color:#ea580c;">@avgWeakness%</div>
                                <div style="font-size:11px;color:var(--q-muted);">متوسط الضعف</div>
                            </div>

                            <div>
                                <div style="font-size:18px;font-weight:800;color:var(--q-primary);">@affectedStudents</div>
                                <div style="font-size:11px;color:var(--q-muted);">طالب متأثر</div>
                            </div>
                        </div>

                        <div class="qd-action-hint">
                            اضغط لعرض قائمة الدروس المرتبطة بتوزيع الخطورة
                        </div>
                    </div>

                </a>
            </div>

        </div>
    }

    @* ── 4. Lessons Table ── *@
    <div class="card-box" id="lessons-section">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
            <div>
                <div class="qd-section-title">
                    <div class="icon-wrap" style="background:#fff7ed;color:#ea580c;">
                        <i class="bi bi-table"></i>
                    </div>

                    قائمة الدروس الحرجة
                </div>

                <div class="qd-section-sub">
                    مرتبة تنازليًا حسب نسبة الضعف — الأعلى خطورة أولًا
                </div>
            </div>

            @if (lessons.Any())
            {
                <input type="text"
                       class="qd-search"
                       id="lessonSearch"
                       placeholder="🔍  ابحث باسم الدرس..."
                       oninput="filterLessons(this.value)" />
            }
        </div>

        @if (!lessons.Any())
        {
            <div class="qd-empty">
                <i class="bi bi-patch-check-fill"></i>
                <div class="qd-empty-title">لا توجد دروس حرجة حاليًا</div>
                <div class="qd-empty-sub">أداء جميع الدروس ضمن المستوى المقبول — استمر في المتابعة الدورية</div>
            </div>
        }
        else
        {
            <div class="table-responsive qd-table-wrap">
                <table class="table qd-table" id="lessonsTable">
                    <thead>
                        <tr>
                            <th style="min-width:30px;">#</th>
                            <th style="min-width:180px;">الدرس</th>
                            <th style="min-width:130px;">الدفعة</th>
                            <th style="min-width:130px;">المدرب</th>
                            <th style="min-width:100px;">الطلاب المتأثرون</th>
                            <th style="min-width:160px;">نسبة الضعف</th>
                            <th style="min-width:90px;">الحالة</th>
                            <th style="min-width:90px;">التفاصيل</th>
                        </tr>
                    </thead>

                    <tbody id="lessonsBody">
                        @{
                            var rowNum = 0;
                        }

                        @foreach (var l in lessons)
                        {
                            rowNum++;

                            var isHigh = l.WeakPercentage >= 70;
                            var isMed = l.WeakPercentage >= 50 && l.WeakPercentage < 70;
                            var barColor = isHigh ? "var(--q-danger)" : isMed ? "var(--q-warning)" : "var(--q-success)";
                            var badgeClass = isHigh ? "badge-danger" : isMed ? "badge-warning" : "badge-success";
                            var statusText = isHigh ? "خطر عالي" : isMed ? "متوسط" : "مستقر";
                            var statusIcon = isHigh ? "bi-exclamation-triangle-fill" : isMed ? "bi-dash-circle-fill" : "bi-check-circle-fill";
                            var rankClass = isHigh ? "rank-high" : "rank-med";
                            var rowClass = isHigh ? "row-high" : isMed ? "row-med" : "";

                            var lessonDetailsUrl = Url.Action(
                            "WeakLessonDetails",
                            "Analytics",
                            new
                            {
                                area = "Admin",
                                lessonId = l.LessonId,
                                batchId = l.BatchId,
                                instructorId = Model.InstructorId
                            });

                            <tr class="lesson-row @rowClass qd-clickable-row"
                                onclick="window.location.href='@lessonDetailsUrl'">

                                <td>
                                    <div class="rank-circle @rankClass">@rowNum</div>
                                </td>

                                <td>
                                    <a asp-area="Admin"
                                       asp-controller="Analytics"
                                       asp-action="WeakLessonDetails"
                                       asp-route-lessonId="@l.LessonId"
                                       asp-route-batchId="@l.BatchId"
                                       asp-route-instructorId="@Model.InstructorId"
                                       class="qd-row-main-link lesson-name"
                                       onclick="event.stopPropagation();">

                                        <div style="font-weight:700;font-size:13px;">@l.LessonName</div>
                                        <div class="qd-action-hint">عرض تفاصيل الدرس</div>
                                    </a>
                                </td>

                                <td>
                                    <a asp-area="Admin"
                                       asp-controller="Analytics"
                                       asp-action="BatchPerformanceDetails"
                                       asp-route-batchId="@l.BatchId"
                                       asp-route-instructorId="@Model.InstructorId"
                                       class="qd-row-main-link"
                                       onclick="event.stopPropagation();">

                                        <span style="font-size:12px;color:var(--q-muted);">
                                            <i class="bi bi-layers-fill me-1" style="color:var(--q-primary);"></i>
                                            @l.BatchName
                                        </span>

                                        <div class="qd-action-hint">تفاصيل الدفعة</div>
                                    </a>
                                </td>

                                <td>
                                    <a asp-area="Admin"
                                       asp-controller="Analytics"
                                       asp-action="InstructorPerformanceDetails"
                                       asp-route-instructorId="@Model.InstructorId"
                                       class="qd-row-main-link"
                                       onclick="event.stopPropagation();">

                                        <div class="d-flex align-items-center gap-2">
                                            <div style="width:26px;height:26px;border-radius:50%;background:var(--q-info-light);color:var(--q-info);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;flex-shrink:0;">
                                                @(string.IsNullOrWhiteSpace(l.InstructorName) || l.InstructorName == "-" ? "م" : l.InstructorName.Substring(0, 1))
                                            </div>

                                            <span style="font-size:12px;font-weight:600;">@l.InstructorName</span>
                                        </div>

                                        <div class="qd-action-hint">تفاصيل المدرب</div>
                                    </a>
                                </td>

                                <td class="text-center">
                                    <a asp-area="Admin"
                                       asp-controller="Analytics"
                                       asp-action="AnalyzedStudentsDetails"
                                       asp-route-instructorId="@Model.InstructorId"
                                       class="qd-row-main-link"
                                       onclick="event.stopPropagation();">

                                        <span class="qd-badge badge-primary">
                                            <i class="bi bi-people-fill"></i> @l.AffectedStudents
                                        </span>

                                        <div class="qd-action-hint">الطلاب المتأثرون</div>
                                    </a>
                                </td>

                                <td>
                                    <a asp-area="Admin"
                                       asp-controller="Analytics"
                                       asp-action="WeakLessonDetails"
                                       asp-route-lessonId="@l.LessonId"
                                       asp-route-batchId="@l.BatchId"
                                       asp-route-instructorId="@Model.InstructorId"
                                       class="qd-row-main-link"
                                       onclick="event.stopPropagation();">

                                        <div class="d-flex align-items-center gap-2">
                                            <div style="font-size:14px;font-weight:800;color:@barColor;white-space:nowrap;">
                                                @Math.Round(l.WeakPercentage, 1)%
                                            </div>

                                            <div class="qd-progress flex-grow-1">
                                                <div class="qd-progress-bar" style="width:@l.WeakPercentage%;background:@barColor;"></div>
                                            </div>
                                        </div>

                                        <div class="qd-action-hint">تحليل نسبة الضعف</div>
                                    </a>
                                </td>

                                <td>
                                    <a asp-area="Admin"
                                       asp-controller="Analytics"
                                       asp-action="WeakLessonDetails"
                                       asp-route-lessonId="@l.LessonId"
                                       asp-route-batchId="@l.BatchId"
                                       asp-route-instructorId="@Model.InstructorId"
                                       class="qd-row-main-link"
                                       onclick="event.stopPropagation();">

                                        <span class="qd-badge @badgeClass">
                                            <i class="bi @statusIcon"></i> @statusText
                                        </span>

                                        <div class="qd-action-hint">تفاصيل الحالة</div>
                                    </a>
                                </td>

                                <td>
                                    <a asp-area="Admin"
                                       asp-controller="Analytics"
                                       asp-action="WeakLessonDetails"
                                       asp-route-lessonId="@l.LessonId"
                                       asp-route-batchId="@l.BatchId"
                                       asp-route-instructorId="@Model.InstructorId"
                                       class="btn-detail"
                                       onclick="event.stopPropagation();">

                                        <i class="bi bi-arrow-left-circle-fill"></i> تفاصيل
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex align-items-center justify-content-between mt-3 flex-wrap gap-2">
                <div style="font-size:12px;color:var(--q-muted);">
                    إجمالي:
                    <strong>@lessons.Count</strong>
                    درس ضعيف
                    &nbsp;·&nbsp;
                    <span style="color:var(--q-danger);font-weight:700;">
                        @highRiskLessons.Count خطر عالي
                    </span>
                </div>

                <div style="font-size:12px;color:var(--q-muted);" id="filteredLessonCount"></div>
            </div>
        }
    </div>

</div>

<script>
    function filterLessons(query) {
        const rows    = document.querySelectorAll(".lesson-row");
        const counter = document.getElementById("filteredLessonCount");
        const q       = query.trim().toLowerCase();
        let visible   = 0;

        rows.forEach(row => {
            const name = row.querySelector(".lesson-name")?.textContent?.toLowerCase() || "";
            const show = !q || name.includes(q);
            row.style.display = show ? "" : "none";
            if (show) visible++;
        });

        if (counter) counter.textContent = q ? `نتائج البحث: ${visible} درس` : "";
    }
</script>