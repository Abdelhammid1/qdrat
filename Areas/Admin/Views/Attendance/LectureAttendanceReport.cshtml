@model QdratNew.ViewModels.Attendance.LectureAttendanceReportViewModel
@{
    ViewData["Title"] = "تقرير حضور المحاضرة";
}

<div class="container py-4">
    <!-- 🟦 شريط الأزرار العلوي -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-action="BatchAttendanceReport" asp-route-batchId="@Model.BatchId"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-right-circle"></i> العودة لتقرير الدفعة
        </a>

        <a asp-action="ExportLectureReportPdf" asp-route-lectureId="@Model.LectureId"
           class="btn btn-danger">
            <i class="bi bi-file-earmark-pdf"></i> تحميل التقرير PDF
        </a>
    </div>

    <!-- 🟦 العنوان -->
    <div class="card shadow-sm mb-4 border-0 rounded-4">
        <div class="card-body text-center">
            <h3 class="fw-bold text-primary mb-2">📋 تقرير حضور المحاضرة</h3>
            <h5 class="text-muted">@Model.LectureTitle</h5>
            <p class="mb-0">
                <strong>المدرب:</strong> @Model.InstructorName |
                <strong>المنهج:</strong> @Model.CurriculumTitle |
                <strong>الدفعة:</strong> @Model.BatchName |
                <strong>التاريخ:</strong> @Model.Date.ToString("yyyy/MM/dd")
            </p>
        </div>
    </div>

    <!-- 🟩 الإحصائيات -->
    <div class="row g-3 mb-4 text-center">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-light rounded-4">
                <h6 class="text-secondary">إجمالي الطلاب</h6>
                <h4 class="fw-bold">@Model.TotalStudents</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-success text-white rounded-4">
                <h6>عدد الحاضرين</h6>
                <h4 class="fw-bold">@Model.PresentCount</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-danger text-white rounded-4">
                <h6>عدد الغائبين</h6>
                <h4 class="fw-bold">@Model.AbsentCount</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-info text-white rounded-4">
                <h6>نسبة الحضور</h6>
                <h4 class="fw-bold">@Model.AttendanceRate %</h4>
                <div class="progress mt-2" style="height:8px;">
                    <div class="progress-bar bg-success" style="width:@Model.AttendanceRate%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- 🟨 الجدول -->
    <div class="card border-0 shadow-sm rounded-4 p-3">
        <table id="studentsTable" class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>اسم الطالب</th>
                    <th>الحالة</th>
                    <th>الملاحظات</th>
                    <th>تقرير الطالب</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Students.Count; i++)
                {
                    var s = Model.Students[i];
                    <tr class="@(s.IsPresent ? "table-success" : "table-danger")">
                        <td>@(i + 1)</td>
                        <td>@s.FullName</td>
                        <td>
                            @if (s.IsPresent)
                            {
                                <span class="badge bg-success">حاضر</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">غائب</span>
                            }
                        </td>
                        <td>@s.Notes</td>
                        <td>
                            <a asp-action="StudentStats" asp-route-studentId="@s.StudentId"
                               class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-bar-chart-line"></i> عرض التقرير
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#studentsTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json"
                },
                "pageLength": 25
            });
        });
    </script>
}
<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
