@model QdratNew.ViewModels.Attendance.StudentAttendanceFullReportViewModel
@{
    ViewData["Title"] = "تقرير حضور الطالب";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-action="BatchAttendanceReport" asp-route-batchId="@Context.Request.Query["batchId"]"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-right-circle"></i> العودة لتقرير الدفعة
        </a>
    </div>

    <!-- 🟦 بيانات الطالب -->
    <div class="card shadow-sm border-0 mb-4 rounded-4 p-3">
        <div class="text-center">
            <h3 class="fw-bold text-primary mb-1">📋 تقرير حضور الطالب</h3>
            <h5 class="text-muted">@Model.FullName</h5>
            <p class="mb-0"><strong>الفرع:</strong> @Model.BranchName</p>
        </div>
    </div>

    <!-- 🟩 الإحصائيات -->
    <div class="row g-3 text-center mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-light rounded-4">
                <h6 class="text-secondary">إجمالي المحاضرات</h6>
                <h4 class="fw-bold">@Model.TotalLectures</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-success text-white rounded-4">
                <h6>عدد الحاضرين</h6>
                <h4 class="fw-bold">@Model.AttendedLectures</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-danger text-white rounded-4">
                <h6>عدد الغيابات</h6>
                <h4 class="fw-bold">@Model.AbsentLectures</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-info text-white rounded-4">
                <h6>نسبة الحضور</h6>
                <h4 class="fw-bold">@Model.AttendanceRate %</h4>
                <div class="progress mt-2" style="height:8px;">
                    <div class="progress-bar bg-success" style="width:@Model.AttendanceRate%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- 🟨 آخر محاضرة -->
    <div class="alert alert-primary text-center mb-4">
        <strong>آخر محاضرة حضرها:</strong> @Model.LastLectureAttended
    </div>

    <!-- 🟧 تفاصيل المحاضرات -->
    <div class="card border-0 shadow-sm rounded-4 p-3">
        <table id="lecturesTable" class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>عنوان المحاضرة</th>
                    <th>التاريخ</th>
                    <th>الحضور</th>
                    <th>ملاحظات</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Lectures.Count; i++)
                {
                    var lec = Model.Lectures[i];
                    <tr class="@(lec.IsPresent ? "table-success" : "table-danger")">
                        <td>@(i + 1)</td>
                        <td>@lec.LectureTitle</td>
                        <td>@lec.Date.ToString("yyyy/MM/dd")</td>
                        <td>
                            @if (lec.IsPresent)
                            {
                                <span class="badge bg-success">حاضر</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">غائب</span>
                            }
                        </td>
                        <td>@lec.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#lecturesTable').DataTable({
                "language": { "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json" },
                "pageLength": 20
            });
        });
    </script>
}
<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
