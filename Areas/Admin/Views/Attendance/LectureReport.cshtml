                    font-size: 9px !important;
                    font-weight: 900 !important;
                    padding: 5px 4px !important;
                    text-align: center !important;
                    vertical-align: middle !important;
                    white-space: normal !important;
                }

                .print-table td {
                    border: 1px solid #CBD5E1 !important;
                    font-size: 9px !important;
                    font-weight: 700 !important;
                    padding: 5px 4px !important;
                    text-align: center !important;
                    vertical-align: middle !important;
                    color: #111827 !important;
                    line-height: 1.4 !important;
                    word-break: break-word !important;
                }

                .print-table .student-name-cell {
                    text-align: right !important;
                    font-weight: 900 !important;
                }

            .present-text {
                color: #065F46 !important;
                font-weight: 900 !important;
            }

            .absent-text {
                color: #9F1239 !important;
                font-weight: 900 !important;
            }

            .print-footer {
                margin-top: 8px !important;
                display: flex !important;
                justify-content: space-between !important;
                font-size: 8px !important;
                color: #64748B !important;
                border-top: 1px solid #CBD5E1 !important;
                padding-top: 5px !important;
            }
        }
    </style>
}

<div class="attendance-report-page">

    <div class="attendance-report-topbar">
        <div class="attendance-report-brand">
            <div class="attendance-report-brand-icon">
                <i class="bi bi-file-earmark-bar-graph-fill"></i>
            </div>
            <div>
                <div class="attendance-report-brand-title">تقرير حضور المحاضرة</div>
                <div class="attendance-report-brand-sub">
                    @Model.LectureTitle - @Model.BatchName - @Model.LectureDate.ToString("yyyy/MM/dd")
                </div>
            </div>
        </div>

        <div class="top-actions">
            <a asp-area="Admin"
               asp-controller="Attendance"
               asp-action="Lectures"
               asp-route-batchId="@Model.BatchId"
               class="btn-secondary-action">
                <i class="bi bi-arrow-left"></i>
                رجوع لمحاضرات الدفعة
            </a>

            <button type="button"
                    class="btn-print-action"
                    onclick="printAttendanceReport()">
                <i class="bi bi-printer"></i>
                طباعة التقرير
            </button>
        </div>
    </div>

    <div class="lecture-info-card">
        <div class="lecture-info-header">
            <i class="bi bi-info-circle"></i>
            بيانات المحاضرة
        </div>

        <div class="lecture-info-grid">
            <div class="lecture-info-item">
                <div class="lecture-info-label">
                    <i class="bi bi-person-badge"></i>
                    المدرب
                </div>
                <div class="lecture-info-value">@Model.InstructorName</div>
            </div>

            <div class="lecture-info-item">
                <div class="lecture-info-label">
                    <i class="bi bi-people"></i>
                    الدفعة
                </div>
                <div class="lecture-info-value">@Model.BatchName</div>
            </div>

            <div class="lecture-info-item">
                <div class="lecture-info-label">
                    <i class="bi bi-book"></i>
                    الدورة / المنهج
                </div>
                <div class="lecture-info-value">@Model.CourseTitle</div>
            </div>

            <div class="lecture-info-item">
                <div class="lecture-info-label">
                    <i class="bi bi-diagram-3"></i>
                    المحور
                </div>
                <div class="lecture-info-value">@Model.SectionTitle</div>
            </div>
        </div>
    </div>

    <div class="attendance-kpis">
        <div class="kpi-card kpi-blue">
            <div class="kpi-ico ico-blue"><i class="bi bi-people"></i></div>
            <div>
                <div class="kpi-label">الطلاب</div>
                <div class="kpi-val">@total</div>
            </div>
        </div>

        <div class="kpi-card kpi-emerald">
            <div class="kpi-ico ico-emerald"><i class="bi bi-check-circle"></i></div>
            <div>
                <div class="kpi-label">حاضر</div>
                <div class="kpi-val">@present</div>
            </div>
        </div>

        <div class="kpi-card kpi-rose">
            <div class="kpi-ico ico-rose"><i class="bi bi-x-circle"></i></div>
            <div>
                <div class="kpi-label">غائب</div>
                <div class="kpi-val">@absent</div>
            </div>
        </div>

        <div class="kpi-card kpi-amber">
            <div class="kpi-ico ico-amber"><i class="bi bi-clock-history"></i></div>
            <div>
                <div class="kpi-label">متأخر</div>
                <div class="kpi-val">@late</div>
            </div>
        </div>

        <div class="kpi-card kpi-info">
            <div class="kpi-ico ico-info"><i class="bi bi-box-arrow-left"></i></div>
            <div>
                <div class="kpi-label">إذن مبكر</div>
                <div class="kpi-val">@early</div>
            </div>
        </div>

        <div class="kpi-card kpi-violet">
            <div class="kpi-ico ico-violet"><i class="bi bi-percent"></i></div>
            <div>
                <div class="kpi-label">النسبة</div>
                <div class="kpi-val">@rate%</div>
            </div>
        </div>
    </div>

    <div class="students-table-card">
        <div class="students-table-topbar">
            <div class="table-section-title">
                <i class="bi bi-table"></i>
                تفاصيل الطلاب
            </div>

            <div class="students-table-search-wrap">
                <i class="bi bi-search"></i>
                <input type="text"
                       id="attendanceReportSearch"
                       placeholder="ابحث في الطالب أو الحالة أو الملاحظات..." />
            </div>

            <div class="students-count-badge">
                إجمالي: <strong>@total</strong> طالب
            </div>
        </div>

        @if (!studentsList.Any())
        {
            <div class="students-empty">
                <i class="bi bi-inbox"></i>
                <div class="students-empty-title">لا توجد بيانات حضور لهذه المحاضرة</div>
                <div class="students-empty-sub">تأكد من تسجيل الحضور أولًا لهذه المحاضرة</div>
            </div>
        }
        else
        {
            <div class="table-responsive-safe">
                <table id="attendanceReportTable">
                    <thead>
                        <tr>
                            <th style="text-align:right; width:28%">الطالب</th>
                            <th style="width:11%">حاضر</th>
                            <th style="width:11%">متأخر</th>
                            <th style="width:12%">إذن مبكر</th>
                            <th style="width:12%">وقت الحضور</th>
                            <th style="width:12%">وقت الانصراف</th>
                            <th style="width:14%">ملاحظات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in studentsList)
                        {
                            <tr>
                                <td style="text-align:right">
                                    <div class="student-title-cell">
                                        <div class="student-avatar">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        <div>
                                            <div class="student-item-name">@item.StudentName</div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    @if (item.IsPresent)
                                    {
                                        <span class="status-pill sp-present">
                                            <i class="bi bi-check-circle"></i>
                                            حاضر
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill sp-absent">
                                            <i class="bi bi-x-circle"></i>
                                            غائب
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (item.IsLateArrival)
                                    {
                                        <span class="status-pill sp-late">
                                            <i class="bi bi-clock-history"></i>
                                            متأخر
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill sp-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @if (item.HasEarlyLeavePermission)
                                    {
                                        <span class="status-pill sp-early">
                                            <i class="bi bi-box-arrow-left"></i>
                                            بإذن
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill sp-muted">—</span>
                                    }
                                </td>

                                <td>
                                    <span class="time-chip">
                                        <i class="bi bi-clock"></i>
                                        @(item.ActualArrivalTime.HasValue? item.ActualArrivalTime.Value.ToString(@"hh\:mm") : "—")
                                    </span>
                                </td>

                                <td>
                                    <span class="time-chip">
                                        <i class="bi bi-clock-history"></i>
                                        @(item.ActualDepartureTime.HasValue? item.ActualDepartureTime.Value.ToString(@"hh\:mm") : "—")
                                    </span>
                                </td>

                                <td>
                                    <span class="notes-chip">
                                        @(string.IsNullOrWhiteSpace(item.Notes) ? "—" : item.Notes)
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div id="attendancePrintableContent">
    <div class="print-page">
        <div class="print-header">
            <div>
                <div class="print-title">تقرير حضور المحاضرة</div>
                <div class="print-subtitle">
                    @Model.LectureTitle<br />
                    @Model.BatchName - @Model.LectureDate.ToString("yyyy/MM/dd")
                </div>
            </div>
            <div class="print-date">
                @DateTime.Now.ToString("yyyy/MM/dd HH:mm")
            </div>
        </div>

        <div class="print-info-grid">
            <div class="print-info-item">
                <div class="print-info-label">المدرب</div>
                <div class="print-info-value">@Model.InstructorName</div>
            </div>
            <div class="print-info-item">
                <div class="print-info-label">الدفعة</div>
                <div class="print-info-value">@Model.BatchName</div>
            </div>
            <div class="print-info-item">
                <div class="print-info-label">الدورة / المنهج</div>
                <div class="print-info-value">@Model.CourseTitle</div>
            </div>
            <div class="print-info-item">
                <div class="print-info-label">المحور</div>
                <div class="print-info-value">@Model.SectionTitle</div>
            </div>
        </div>

        <div class="print-kpis">
            <div class="print-kpi">
                <div class="print-kpi-label">إجمالي الطلاب</div>
                <div class="print-kpi-value">@total</div>
            </div>
            <div class="print-kpi">
                <div class="print-kpi-label">حاضر</div>
                <div class="print-kpi-value">@present</div>
            </div>
            <div class="print-kpi">
                <div class="print-kpi-label">غائب</div>
                <div class="print-kpi-value">@absent</div>
            </div>
            <div class="print-kpi">
                <div class="print-kpi-label">متأخر</div>
                <div class="print-kpi-value">@late</div>
            </div>
            <div class="print-kpi">
                <div class="print-kpi-label">إذن مبكر</div>
                <div class="print-kpi-value">@early</div>
            </div>
            <div class="print-kpi">
                <div class="print-kpi-label">نسبة الحضور</div>
                <div class="print-kpi-value">@rate%</div>
            </div>
        </div>

        <table class="print-table">
            <thead>
                <tr>
                    <th style="width:5%">#</th>
                    <th style="width:25%">الطالب</th>
                    <th style="width:10%">الحضور</th>
                    <th style="width:10%">التأخر</th>
                    <th style="width:12%">إذن مبكر</th>
                    <th style="width:12%">وقت الحضور</th>
                    <th style="width:12%">وقت الانصراف</th>
                    <th style="width:14%">ملاحظات</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var rowIndex = 1;
                }

                @foreach (var item in studentsList)
                {
                    <tr>
                        <td>@rowIndex</td>
                        <td class="student-name-cell">@item.StudentName</td>
                        <td class="@(item.IsPresent ? "present-text" : "absent-text")">@(item.IsPresent ? "حاضر" : "غائب")</td>
                        <td>@(item.IsLateArrival ? "متأخر" : "—")</td>
                        <td>@(item.HasEarlyLeavePermission ? "بإذن" : "—")</td>
                        <td>@(item.ActualArrivalTime.HasValue? item.ActualArrivalTime.Value.ToString(@"hh\:mm") : "—")</td>
                        <td>@(item.ActualDepartureTime.HasValue? item.ActualDepartureTime.Value.ToString(@"hh\:mm") : "—")</td>
                        <td>@(string.IsNullOrWhiteSpace(item.Notes) ? "—" : item.Notes)</td>
                    </tr>

                    rowIndex++;
                }
            </tbody>
        </table>

        <div class="print-footer">
            <div>منصة قدرات - تقرير حضور المحاضرة</div>
            <div>إجمالي السجلات: @total</div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        var attendanceReportDataTable = null;

        document.addEventListener("DOMContentLoaded", function () {
            var tableElement = document.getElementById('attendanceReportTable');

            if (tableElement && window.jQuery && $.fn.DataTable) {
               attendanceReportDataTable = $('#attendanceReportTable').DataTable({
    language: {
        url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json"
    },
    pageLength: 25,
    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "الكل"]],
    order: [[0, "asc"]],
    responsive: false,
    scrollX: false,
    autoWidth: false,
    stateSave: true,
    dom: 'lrtip',
    columnDefs: [
        { targets: 0, width: "28%" },
        { targets: 1, width: "11%" },
        { targets: 2, width: "11%" },
        { targets: 3, width: "12%" },
        { targets: 4, width: "12%" },
        { targets: 5, width: "12%" },
        { targets: 6, width: "14%" }
    ]
});

attendanceReportDataTable.columns.adjust().draw(false);

                $('#attendanceReportSearch').on('input', function () {
                    attendanceReportDataTable.search($(this).val()).draw();
                });
            }
        });

        function printAttendanceReport() {
            var printableContent = document.getElementById('attendancePrintableContent');

            if (!printableContent) {
                alert('لم يتم العثور على نسخة الطباعة داخل الصفحة.');
                return;
            }

            window.print();
        }
    </script>
}