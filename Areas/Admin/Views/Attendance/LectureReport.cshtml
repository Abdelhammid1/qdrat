@model QdratNew.ViewModels.Attendance.AdminRecordAttendanceVM

@{
    ViewData["Title"] = "تقرير حضور المحاضرة";

    var studentsList = Model.Students != null
        ? Model.Students.ToList()
        : new List<QdratNew.ViewModels.Attendance.AdminAttendanceStudentRowVM>();

    var total = studentsList.Count;
    var present = studentsList.Count(x => x.IsPresent);
    var absent = total - present;
    var late = studentsList.Count(x => x.IsLateArrival);
    var early = studentsList.Count(x => x.HasEarlyLeavePermission);
    var rate = total > 0 ? Math.Round((present * 100.0) / total, 1) : 0;
}

