@model QdratNew.ViewModels.Attendance.LectureAttendanceReportViewModel
@{
    Layout = null;
}

<html dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>تقرير حضور المحاضرة - @Model.LectureTitle</title>
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            direction: rtl;
            margin: 40px;
        }

        h2, h4, h5 {
            text-align: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            border: 1px solid #999;
            padding: 8px;
            text-align: center;
        }

        th {
            background-color: #f2f2f2;
        }

        .present {
            background-color: #c8e6c9;
        }

        .absent {
            background-color: #ffcdd2;
        }
    </style>
</head>
<body>
    <h2>تقرير حضور المحاضرة</h2>
    <h4>@Model.LectureTitle</h4>
    <p><strong>المدرب:</strong> @Model.InstructorName | <strong>المنهج:</strong> @Model.CurriculumTitle | <strong>الدفعة:</strong> @Model.BatchName | <strong>التاريخ:</strong> @Model.Date.ToString("yyyy/MM/dd")</p>

    <h5>إحصائيات</h5>
    <table>
        <tr><th>إجمالي الطلاب</th><th>عدد الحاضرين</th><th>عدد الغائبين</th><th>نسبة الحضور</th></tr>
        <tr>
            <td>@Model.TotalStudents</td>
            <td>@Model.PresentCount</td>
            <td>@Model.AbsentCount</td>
            <td>@Model.AttendanceRate %</td>
        </tr>
    </table>

    <h5>تفاصيل الطلاب</h5>
    <table>
        <thead>
            <tr><th>#</th><th>اسم الطالب</th><th>الحالة</th><th>الملاحظات</th></tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Students.Count; i++)
            {
                var s = Model.Students[i];
                <tr class="@(s.IsPresent ? "present" : "absent")">
                    <td>@(i + 1)</td>
                    <td>@s.FullName</td>
                    <td>@(s.IsPresent ? "حاضر" : "غائب")</td>
                    <td>@s.Notes</td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>
