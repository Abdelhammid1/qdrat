@model IEnumerable<QdratNew.ViewModels.Attendance.BatchLectureListViewModel>
@{
    ViewData["Title"] = "محاضرات الدفعة";
}

<div class="container py-4">
    <h3 class="fw-bold text-primary text-center mb-3">📚 محاضرات الدفعة @ViewBag.BatchName</h3>
    <div class="card shadow-sm p-3 border-0 rounded-4">
        <table id="lecturesTable" class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>عنوان المحاضرة</th>
                    <th>المدرب</th>
                    <th>التاريخ</th>
                    <th>المحور</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count(); i++)
                {
                    var l = Model.ElementAt(i);
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@l.Title</td>
                        <td>@l.InstructorName</td>
                        <td>@l.Date.ToString("yyyy/MM/dd")</td>
                        <td>@l.SectionName</td>
                        <td>
                            <a asp-action="Mark" asp-route-id="@l.LectureId"
                               class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-check2-square"></i> تسجيل الحضور
                            </a>

                            <a asp-action="LectureAttendanceReport" asp-route-lectureId="@l.LectureId"
                               class="btn btn-outline-success btn-sm">
                                <i class="bi bi-people"></i> عرض الطلاب
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#lecturesTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json"
                },
                "pageLength": 15
            });
        });
    </script>
}
<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
