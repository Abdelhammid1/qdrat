@model QdratNew.ViewModels.Attendance.AttendanceBatchArchiveAccessVM

@{
    ViewData["Title"] = "موافقات الوصول لأرشيف الحضور";
}

<div class="container-fluid py-4" dir="rtl">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h2 class="h4 mb-1">موافقات الوصول — أرشيف الحضور</h2>
            <div class="text-muted">@Model.BatchName — @Model.CourseTitle</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ArchiveHistory" asp-route-batchId="@Model.BatchId" class="btn btn-outline-secondary">
                <i class="bi bi-clock-history"></i> الهيستوري
            </a>
            <a asp-action="Lectures" asp-route-batchId="@Model.BatchId" class="btn btn-outline-primary">
                <i class="bi bi-arrow-right"></i> رجوع للمحاضرات
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="UpdateArchiveAccess" method="post" class="card border-0 shadow-sm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="batchId" value="@Model.BatchId" />

        <div class="card-header bg-white py-3">
            <div class="text-muted small">
                <i class="bi bi-info-circle text-primary me-1"></i>
                حدد المستخدمين المصرح لهم بعرض سجلات الحضور لهذه الدفعة المؤرشفة. لا يُمنح حق التعديل لأحد.
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:70px">السماح</th>
                        <th>المستخدم</th>
                        <th>البريد الإلكتروني</th>
                        <th>الطبقات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Users.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                لا يوجد مستخدمون نشطون ضمن Admin أو Employee أو SuperAdmin.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>
                                    <input class="form-check-input" type="checkbox"
                                           name="allowedUserIds" value="@user.UserId"
                                           @(user.IsAllowed ? "checked" : "") />
                                </td>
                                <td class="fw-semibold">@user.DisplayName</td>
                                <td>@user.Email</td>
                                <td>@user.Roles</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white d-flex justify-content-end gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-shield-check me-1"></i> حفظ الموافقات
            </button>
        </div>
    </form>
</div>
