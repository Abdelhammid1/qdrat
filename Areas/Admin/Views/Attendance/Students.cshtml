@model List<QdratNew.ViewModels.Attendance.StudentAttendanceOverviewViewModel>
@{
    ViewData["Title"] = "قائمة الطلاب";
}

<div class="container mt-4">
    <h3 class="mb-4">قائمة الطلاب لمحاضرة: <span class="text-primary">@ViewBag.LectureTitle</span> بتاريخ @ViewBag.LectureDate</h3>

    <table class="table table-bordered text-center">
        <thead class="table-light">
            <tr>
                <th>الاسم</th>
                <th>الفرع</th>
                <th>الإحصائيات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model)
            {
                <tr>
                    <td>@student.FullName</td>
                    <td>@student.BranchName</td>
                    <td>
                        <a asp-action="StudentStats" asp-route-studentId="@student.StudentId" class="btn btn-outline-primary btn-sm">
                            عرض الإحصائيات
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
