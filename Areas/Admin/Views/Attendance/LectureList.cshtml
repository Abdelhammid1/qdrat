@model QdratNew.ViewModels.Attendance.LectureFilterViewModel

<div class="row mb-3">
    <div class="col-md-3">
        <select id="filterInstructor" class="form-control">
            <option value="">كل المدربين</option>
            @foreach (var item in Model.Instructors)
            {
                <option value="@item.Value">@item.Text</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select id="filterBatch" class="form-control">
            <option value="">كل الدفعات</option>
            @foreach (var item in Model.Batches)
            {
                <option value="@item.Value">@item.Text</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <input type="date" id="filterDate" class="form-control" />
    </div>
    <div class="col-md-3">
        <button id="btnSearch" class="btn btn-primary w-100">بحث</button>
    </div>
</div>

<table id="lecturesTable" class="table table-bordered text-center">
    <thead>
        <tr>
            <th>تاريخ المحاضرة</th>
            <th>المدرب</th>
            <th>الدفعة</th>
            <th>المنهج</th>
            <th>إجراء</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        let table;

        $(document).ready(function () {
            table = $('#lecturesTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Action("LoadLectureData", "Attendance", new { area = "Admin" })',
                    data: function (d) {
                        d.instructorId = $('#filterInstructor').val();
                        d.batchId = $('#filterBatch').val();
                        d.date = $('#filterDate').val();
                    }
                },
                columns: [
                    { data: 'lectureDate' },
                    { data: 'instructorName' },
                    { data: 'batchName' },
                    { data: 'curriculumTitle' },
                    {
                        data: 'lectureId',
                        render: function (data) {
                            return `<a href="/Admin/Attendance/Record?lectureId=${data}" class="btn btn-sm btn-success">تسجيل الحضور</a>`;
                        },
                        orderable: false
                    }
                ],
                order: [] // بدون ترتيب تلقائي لأننا نرتب يدويًا بالسيرفر
            });

            $('#btnSearch').click(function () {
                table.ajax.reload();
            });
        });
    </script>
}
