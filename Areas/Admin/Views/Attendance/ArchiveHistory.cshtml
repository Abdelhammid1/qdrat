@model QdratNew.ViewModels.Attendance.AttendanceBatchArchiveHistoryVM

@{
    ViewData["Title"] = "هيستوري أرشيف الحضور";
}

<div class="container-fluid py-4" dir="rtl">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h2 class="h4 mb-1">هيستوري الأرشيف — حضور وانصراف</h2>
            <div class="text-muted">@Model.BatchName — @Model.CourseTitle</div>
        </div>
        <div class="d-flex gap-2">
            @if (User.IsInRole("Owner") || User.IsInRole("Developer"))
            {
                <a asp-action="ManageArchiveAccess" asp-route-batchId="@Model.BatchId" class="btn btn-outline-secondary">
                    <i class="bi bi-shield-lock-fill me-1"></i> الموافقات
                </a>
            }
            <a asp-action="Lectures" asp-route-batchId="@Model.BatchId" class="btn btn-outline-primary">
                <i class="bi bi-arrow-right"></i> رجوع للمحاضرات
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>التاريخ والوقت</th>
                        <th>المستخدم</th>
                        <th>نوع العملية</th>
                        <th>التفاصيل</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                لا توجد أحداث مسجّلة لهذه الدفعة المؤرشفة حتى الآن.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.Timestamp.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>@item.AdminName</td>
                                <td>
                                    @switch (item.ActionType)
                                    {
                                        case "AttendanceArchiveView":
                                            <span class="badge bg-primary">عرض</span>
                                            break;
                                        case "AttendanceArchiveEditAttempt":
                                            <span class="badge bg-danger">محاولة تعديل</span>
                                            break;
                                        case "AttendanceArchiveAccessUpdated":
                                            <span class="badge bg-warning text-dark">تعديل موافقات</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@item.ActionType</span>
                                            break;
                                    }
                                </td>
                                <td>@item.Description</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
