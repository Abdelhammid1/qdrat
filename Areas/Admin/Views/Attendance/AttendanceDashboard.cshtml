@model QdratNew.ViewModels.Attendance.AttendanceDashboardVM
@{
    ViewData["Title"] = "لوحة تحكم الحضور";
}

<div class="container-fluid py-4">

    <h3 class="fw-bold text-primary mb-4">📊 لوحة تحكم الحضور</h3>

    <!-- ===================== -->
    <!-- الفلتر -->
    <!-- ===================== -->
<form method="get"
      asp-area="Admin"
      asp-controller="Attendance"
      asp-action="AttendanceDashboard"
      class="row g-3 mb-4">

    <div class="col-md-4">
        <label class="form-label">الدفعة</label>
            <select name="batchId" class="form-control">
                <option value="">كل الدفعات</option>

                @foreach (var item in Model.BatchFilter)
                {
                    if (Model.SelectedBatchId.HasValue &&
                    Model.SelectedBatchId.Value.ToString() == item.Value)
                    {
                        <option value="@item.Value" selected="selected">
                            @item.Text
                        </option>
                    }
                    else
                    {
                        <option value="@item.Value">
                            @item.Text
                        </option>
                    }
                }
            </select>
    </div>

    <div class="col-md-4">
        <label class="form-label">التاريخ</label>
        <input type="date"
               name="date"
               value="@(Model.SelectedDate.HasValue 
                        ? Model.SelectedDate.Value.ToString("yyyy-MM-dd") 
                        : "")"
               class="form-control" />
    </div>

    <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">
            تطبيق الفلتر
        </button>
    </div>

</form>
    <!-- ===================== -->
    <!-- الكروت الإحصائية -->
    <!-- ===================== -->
    <div class="row mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 text-center p-3">
                <h6>عدد الدفعات</h6>
                <h3 class="fw-bold text-primary">@Model.TotalBatches</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 text-center p-3">
                <h6>عدد الطلاب</h6>
                <h3 class="fw-bold text-success">@Model.TotalStudents</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 text-center p-3">
                <h6>عدد المحاضرات</h6>
                <h3 class="fw-bold text-warning">@Model.TotalLectures</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 text-center p-3">
                <h6>متوسط الحضور العام</h6>
                <h3 class="fw-bold text-danger">@Model.OverallAttendanceRate %</h3>
            </div>
        </div>

    </div>

    <!-- ===================== -->
    <!-- جدول الدفعات -->
    <!-- ===================== -->
    <div class="card shadow-sm border-0 rounded-4 p-3">

        @if (!Model.Batches.Any())
        {
            <div class="alert alert-info text-center">
                لا توجد محاضرات في التاريخ المحدد.
            </div>
        }
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>الدفعة</th>
                    <th>الدورة</th>
                    <th>الطلاب</th>
                    <th>المحاضرات</th>
                    <th>نسبة الحضور</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Batches)
                {
                    <tr>
                        <td>@item.BatchName</td>
                        <td>@item.CourseName</td>
                        <td>@item.StudentsCount</td>
                        <td>@item.TotalLectures</td>
                        <td>
                            <div class="progress" style="height:8px;">
                                <div class="progress-bar bg-success"
                                     style="width:@item.AverageAttendanceRate%">
                                </div>
                            </div>
                            <small class="fw-bold">
                                @item.AverageAttendanceRate %
                            </small>
                        </td>
                        <td>
                            <!-- زر عرض المحاضرات -->
                            <a asp-action="BatchLectures" asp-route-batchId="@item.BatchId"
                               class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-eye"></i> عرض المحاضرات
                            </a>
                            <a asp-action="BatchAttendanceReport"
                               asp-route-batchId="@item.BatchId"
                               class="btn btn-outline-primary btn-sm">
                                التفاصيل
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>