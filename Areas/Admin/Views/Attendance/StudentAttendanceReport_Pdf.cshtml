@model QdratNew.ViewModels.Attendance.StudentAttendanceFullReportViewModel
@{
    Layout = null;
}

<html dir="rtl" lang="ar">
<head>
    <meta charset="utf-8" />
    <title>تقرير حضور الطالب - @Model.FullName</title>
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            direction: rtl;
            margin: 40px;
            color: #333;
        }

        h2, h4, h5 {
            text-align: center;
            margin-bottom: 5px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            border: 1px solid #999;
            padding: 8px;
            text-align: center;
        }

        th {
            background-color: #f2f2f2;
        }

        .present {
            background-color: #c8e6c9;
        }

        .absent {
            background-color: #ffcdd2;
        }

        .summary-table td {
            font-weight: bold;
        }
    </style>
</head>
<body>
    <h2>تقرير حضور الطالب</h2>
    <h4>@Model.FullName</h4>
    <p style="text-align:center;"><strong>الفرع:</strong> @Model.BranchName</p>

    <h5>إحصائيات عامة</h5>
    <table class="summary-table">
        <tr>
            <th>إجمالي المحاضرات</th>
            <th>عدد الحاضرين</th>
            <th>عدد الغيابات</th>
            <th>نسبة الحضور</th>
        </tr>
        <tr>
            <td>@Model.TotalLectures</td>
            <td>@Model.AttendedLectures</td>
            <td>@Model.AbsentLectures</td>
            <td>@Model.AttendanceRate %</td>
        </tr>
    </table>

    <h5 style="margin-top:30px;">آخر محاضرة حضرها:</h5>
    <p style="text-align:center; font-weight:bold;">@Model.LastLectureAttended</p>

    <h5 style="margin-top:40px;">تفاصيل المحاضرات</h5>
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>عنوان المحاضرة</th>
                <th>التاريخ</th>
                <th>الحالة</th>
                <th>ملاحظات</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Lectures.Count; i++)
            {
                var lec = Model.Lectures[i];
                <tr class="@(lec.IsPresent ? "present" : "absent")">
                    <td>@(i + 1)</td>
                    <td>@lec.LectureTitle</td>
                    <td>@lec.Date.ToString("yyyy/MM/dd")</td>
                    <td>@(lec.IsPresent ? "حاضر" : "غائب")</td>
                    <td>@lec.Notes</td>
                </tr>
            }
        </tbody>
    </table>

    <br />
    <br />
    <p style="text-align:center; font-size:13px; color:#666;">
        تم توليد التقرير بواسطة نظام قدرات الذكي © @DateTime.Now.Year
    </p>
</body>
</html>
