@model IEnumerable<QdratNew.ViewModels.Admin.UserPartnerListItemViewModel>

@{
    ViewData["Title"] = "ربط المستخدمين بالمدارس";
}

<h3 class="mb-4">ربط المستخدمين بالمدارس</h3>

<a asp-action="Create" class="btn btn-primary mb-3">
    <i class="fas fa-plus me-1"></i> إضافة ربط جديد
</a>

<table id="userPartnersTable" class="table table-striped table-bordered align-middle w-100">
    <thead class="table-light">
        <tr>
            <th>المستخدم</th>
            <th>البريد</th>
            <th>المدرسة</th>
            <th class="text-center">الإجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.UserName</td>
                <td>@item.UserEmail</td>
                <td>@item.PartnerName</td>
                <td class="text-center">

                    <!-- تفاصيل -->
                    <a asp-action="Details"
                       asp-route-userId="@item.UserId"
                       class="btn btn-sm btn-outline-info me-1"
                       data-bs-toggle="tooltip"
                       title="عرض التفاصيل">
                        <i class="fas fa-eye"></i>
                    </a>

                    <!-- تعديل -->
                    <a asp-action="Edit"
                       asp-route-userId="@item.UserId"
                       class="btn btn-sm btn-outline-warning me-1"
                       data-bs-toggle="tooltip"
                       title="تعديل الربط">
                        <i class="fas fa-edit"></i>
                    </a>

                    <!-- حذف -->
                    <form asp-action="Delete"
                          method="post"
                          class="d-inline">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit"
                                class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="tooltip"
                                title="حذف الربط"
                                onclick="return confirm('هل أنت متأكد من الحذف؟');">
                            <i class="fas fa-trash"></i>
                        </button>
                    </form>

                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- DataTables -->
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <!-- Bootstrap Tooltip -->
    <script>
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => {
            new bootstrap.Tooltip(el);
        });
    </script>

    <!-- DataTable Init -->
    <script>
        $(document).ready(function () {
            $('#userPartnersTable').DataTable({
                language: {
                    search: "بحث:",
                    lengthMenu: "عرض _MENU_ سجل",
                    info: "عرض _START_ إلى _END_ من _TOTAL_ سجل",
                    infoEmpty: "لا توجد بيانات",
                    zeroRecords: "لا توجد نتائج",
                    paginate: {
                        first: "الأول",
                        last: "الأخير",
                        next: "التالي",
                        previous: "السابق"
                    }
                },
                order: [[0, "asc"]],
                columnDefs: [
                    { orderable: false, targets: 3 }
                ]
            });
        });
    </script>
}
