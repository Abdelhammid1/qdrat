@model QdratNew.ViewModels.Admin.UserPartnerDetailsViewModel

<h3 class="mb-4">تفاصيل ربط المستخدم</h3>

<div class="mb-3">
    <strong>المستخدم:</strong> @Model.UserName
</div>

<h5 class="mt-4">المدارس المرتبطة</h5>

<div class="row g-3 mt-2">
    @foreach (var p in Model.Partners)
    {
        <div class="col-md-4">
            <div class="card shadow-sm text-center p-3">
                @if (!string.IsNullOrEmpty(p.LogoPath))
                {
                    <img src="@p.LogoPath"
                         style="height:60px;object-fit:contain"
                         class="mb-2" />
                }
                <div class="fw-bold">@p.Name</div>
            </div>
        </div>
    }
</div>

<div class="mt-4">
    <a asp-action="Edit" asp-route-userId="@Model.UserId"
       class="btn btn-primary">تعديل</a>

    <a asp-action="Index" class="btn btn-secondary ms-2">رجوع</a>
</div>
