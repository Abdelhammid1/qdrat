@model QdratNew.ViewModels.Admin.UserPartnerCreateViewModel

@{
    ViewData["Title"] = "ربط مستخدم بمدارس";
}

<div class="qdrat-page" dir="rtl">

    <div class="qdrat-hero mb-4">
        <div>
            <div class="qdrat-kicker">
                <i class="bi bi-link-45deg"></i>
                ربط المستخدمين بالمدارس
            </div>

            <h2 class="qdrat-title">ربط مستخدم بمدارس</h2>

            <p class="qdrat-subtitle">
                اختر المستخدم ثم حدد المدارس المرتبطة به. يمكن اختيار أكثر من مدرسة، وسيتم إرسال نفس أسماء الحقول الحالية عند الحفظ.
            </p>
        </div>

        <div class="qdrat-hero-icon">
            <i class="bi bi-building-check"></i>
        </div>
    </div>

    <div class="qdrat-card">
        <div class="qdrat-card-header">
            <div>
                <h5>
                    <i class="bi bi-person-gear"></i>
                    بيانات الربط
                </h5>
                <p>
                    حدد المستخدم والمدارس التي يمكنه إدارتها أو الوصول إليها.
                </p>
            </div>
        </div>

        <div class="qdrat-card-body">
            <form method="post" autocomplete="off">
                @Html.AntiForgeryToken()

                <div class="row g-4">
                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label class="form-label">المستخدم</label>
                            <div class="qdrat-input-wrap">
                                <i class="bi bi-person-badge"></i>
                                <select asp-for="UserId" class="form-select" required>
                                    <option value="">اختر المستخدم</option>
                                    @foreach (var u in Model.Users)
                                    {
                                        <option value="@u.Id">@u.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-info-box">
                            <div class="qdrat-info-icon">
                                <i class="bi bi-info-circle"></i>
                            </div>
                            <div>
                                <h6>طريقة الاختيار</h6>
                                <p>اضغط على اسم المدرسة لتحديدها، واضغط مرة أخرى لإلغاء التحديد.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="qdrat-section mt-4">
                    <div class="qdrat-section-title">
                        <div>
                            <h6>
                                <i class="bi bi-buildings"></i>
                                المدارس المرتبطة
                            </h6>
                            <span>اختر مدرسة واحدة أو أكثر حسب صلاحيات المستخدم.</span>
                        </div>
                    </div>

                    <div class="qdrat-partners-grid" id="partnersContainer">
                        @foreach (var p in Model.Partners)
                        {
                            <button type="button"
                                    class="qdrat-partner-btn partner-btn"
                                    data-id="@p.Id">
                                <span class="qdrat-partner-check">
                                    <i class="bi bi-check2"></i>
                                </span>
                                <span class="qdrat-partner-name">@p.Name</span>
                            </button>
                        }
                    </div>

                    <div id="partnerInputs"></div>
                </div>

                <div class="qdrat-actions">
                    <a asp-action="Index" class="btn qdrat-btn qdrat-btn-light">
                        <i class="bi bi-arrow-right"></i>
                        رجوع
                    </a>

                    <button type="submit" class="btn qdrat-btn qdrat-btn-primary">
                        <i class="bi bi-check-circle"></i>
                        حفظ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .qdrat-page {
        padding: 24px;
        background: #f5f7fb;
        min-height: calc(100vh - 80px);
        font-family: inherit;
    }

    .qdrat-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 26px;
        border-radius: 24px;
        background: linear-gradient(135deg, #102a43 0%, #1d4ed8 58%, #38bdf8 100%);
        color: #fff;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
    }

    .qdrat-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .qdrat-title {
        margin: 0;
        font-size: 28px;
        font-weight: 900;
        letter-spacing: -0.5px;
    }

    .qdrat-subtitle {
        margin: 10px 0 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 15px;
        line-height: 1.8;
        max-width: 850px;
    }

    .qdrat-hero-icon {
        width: 74px;
        height: 74px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.16);
        font-size: 34px;
        flex: 0 0 auto;
    }

    .qdrat-card {
        border: 1px solid #e5e7eb;
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    .qdrat-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #edf0f5;
        background: #fff;
    }

        .qdrat-card-header h5 {
            margin: 0;
            color: #0f172a;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .qdrat-card-header h5 i {
                color: #2563eb;
            }

        .qdrat-card-header p {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 14px;
        }

    .qdrat-card-body {
        padding: 24px;
    }

    .qdrat-field .form-label {
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 9px;
    }

    .qdrat-input-wrap {
        position: relative;
    }

        .qdrat-input-wrap > i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 3;
            pointer-events: none;
        }

        .qdrat-input-wrap .form-select,
        .qdrat-input-wrap .form-control {
            min-height: 48px;
            border-radius: 15px;
            border-color: #dbe3ef;
            padding-right: 42px;
            font-weight: 700;
        }

            .qdrat-input-wrap .form-select:focus,
            .qdrat-input-wrap .form-control:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 0.22rem rgba(37, 99, 235, 0.12);
            }

    .qdrat-info-box {
        height: 100%;
        min-height: 86px;
        border: 1px solid #bfdbfe;
        background: #eff6ff;
        border-radius: 18px;
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .qdrat-info-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: #dbeafe;
        color: #1d4ed8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        flex: 0 0 auto;
    }

    .qdrat-info-box h6 {
        margin: 0 0 5px;
        color: #1e3a8a;
        font-weight: 900;
    }

    .qdrat-info-box p {
        margin: 0;
        color: #1e40af;
        font-size: 13px;
        font-weight: 700;
        line-height: 1.7;
    }

    .qdrat-section {
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        background: #f8fafc;
        padding: 18px;
    }

    .qdrat-section-title {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 16px;
    }

        .qdrat-section-title h6 {
            margin: 0;
            color: #0f172a;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 9px;
        }

            .qdrat-section-title h6 i {
                color: #2563eb;
            }

        .qdrat-section-title span {
            display: block;
            margin-top: 6px;
            color: #64748b;
            font-size: 13px;
            font-weight: 700;
        }

    .qdrat-partners-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
        gap: 12px;
    }

    .qdrat-partner-btn {
        border: 1px solid #dbe3ef;
        background: #fff;
        color: #334155;
        border-radius: 16px;
        padding: 13px 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 900;
        text-align: right;
        transition: 0.16s ease;
    }

        .qdrat-partner-btn:hover {
            border-color: #93c5fd;
            background: #eff6ff;
            color: #1d4ed8;
            transform: translateY(-1px);
        }

        .qdrat-partner-btn.is-selected {
            border-color: #2563eb;
            background: #2563eb;
            color: #fff;
            box-shadow: 0 12px 28px rgba(37, 99, 235, 0.22);
        }

    .qdrat-partner-check {
        width: 26px;
        height: 26px;
        border-radius: 999px;
        border: 1px solid #cbd5e1;
        background: #f8fafc;
        display: flex;
        align-items: center;
        justify-content: center;
        color: transparent;
        flex: 0 0 auto;
    }

    .qdrat-partner-btn.is-selected .qdrat-partner-check {
        border-color: rgba(255, 255, 255, 0.55);
        background: rgba(255, 255, 255, 0.18);
        color: #fff;
    }

    .qdrat-partner-name {
        line-height: 1.6;
    }

    .qdrat-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 26px;
        margin-top: 28px;
        border-top: 1px solid #edf0f5;
    }

    .qdrat-btn {
        min-height: 46px;
        border-radius: 14px;
        padding: 10px 24px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .qdrat-btn-primary {
        background: #16a34a;
        border-color: #16a34a;
        color: #fff;
    }

        .qdrat-btn-primary:hover {
            background: #15803d;
            border-color: #15803d;
            color: #fff;
        }

    .qdrat-btn-light {
        background: #f8fafc;
        border-color: #dbe3ef;
        color: #334155;
    }

        .qdrat-btn-light:hover {
            background: #eef2f7;
            border-color: #cbd5e1;
            color: #0f172a;
        }

    @@media (max-width: 768px) {
        .qdrat-page {
            padding: 14px;
        }

        .qdrat-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 20px;
        }

        .qdrat-title {
            font-size: 23px;
        }

        .qdrat-hero-icon {
            width: 58px;
            height: 58px;
            font-size: 26px;
        }

        .qdrat-card-body,
        .qdrat-card-header {
            padding: 18px;
        }

        .qdrat-partners-grid {
            grid-template-columns: 1fr;
        }

        .qdrat-actions {
            flex-direction: column-reverse;
        }

        .qdrat-btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <script>
        (function () {
            const selectedPartners = new Set();
            const container = document.getElementById("partnerInputs");
            const buttons = document.querySelectorAll(".partner-btn");

            if (!container) {
                return;
            }

            buttons.forEach(function (btn) {
                btn.addEventListener("click", function () {
                    const id = btn.dataset.id;

                    if (selectedPartners.has(id)) {
                        selectedPartners.delete(id);
                        btn.classList.remove("is-selected");
                    } else {
                        selectedPartners.add(id);
                        btn.classList.add("is-selected");
                    }

                    renderInputs();
                });
            });

            function renderInputs() {
                container.innerHTML = "";

                selectedPartners.forEach(function (id) {
                    const input = document.createElement("input");
                    input.type = "hidden";
                    input.name = "PartnerIds";
                    input.value = id;
                    container.appendChild(input);
                });
            }
        })();
    </script>
}
