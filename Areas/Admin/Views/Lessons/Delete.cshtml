@model QdratNew.Entities.Lesson

@{
    ViewData["Title"] = "حذف المؤشر";
}

<div class="container mt-4" dir="rtl">
    <h2 class="text-center mb-4 text-danger">تأكيد حذف المؤشر</h2>

    <div class="card border-danger">
        <div class="card-body">
            <h5 class="card-title">اسم المؤشر: @Model.Title</h5>
            <p class="card-text">هل أنت متأكد أنك تريد حذف هذا المؤشر؟</p>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
                    <button type="submit" class="btn btn-danger">تأكيد الحذف</button>
                </div>
            </form>
        </div>
    </div>
</div>
