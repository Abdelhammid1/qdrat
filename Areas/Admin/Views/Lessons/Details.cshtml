@model QdratNew.Entities.Lesson

@{
    ViewData["Title"] = "تفاصيل المؤشر";
}

<div class="container mt-4" dir="rtl">
    <h2 class="text-center mb-4">تفاصيل المؤشر</h2>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">اسم المؤشر: @Model.Title</h5>
            <p class="card-text">محتوى المؤشر: @Model.Content</p>
            <p class="card-text">الوحدة: @(Model.Unit?.Title ?? "-")</p>
            <p class="card-text">
                المحور: @(Model.Unit?.SectionUnits?.FirstOrDefault()?.Section?.Title ?? "-")
            </p>
        </div>
    </div>

    <div class="mt-4 d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-secondary">عودة للقائمة</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">تعديل</a>
    </div>
</div>
