@model QdratNew.ViewModels.Lesson.LessonCreateViewModel

@{
    ViewData["Title"] = "إنشاء مؤشر جديد";
}

<div class="qdrat-page-wrapper" dir="rtl">
    <div class="qdrat-page-header">
        <div>
            <h1 class="qdrat-page-title">
                <i class="fas fa-lightbulb"></i>
                إنشاء مؤشر جديد
            </h1>
            <p class="qdrat-page-subtitle">
                أضف مؤشرًا تعليميًا جديدًا داخل المحور والوحدة المناسبة لاستخدامه في التوليد والتحليل.
            </p>
        </div>

        <a asp-action="Index" class="qdrat-back-btn">
            <i class="fas fa-arrow-right"></i>
            العودة للقائمة
        </a>
    </div>

    <form asp-action="Create" method="post" class="qdrat-form-card">
        @Html.AntiForgeryToken()

        <div class="qdrat-card-header">
            <div class="qdrat-card-icon">
                <i class="fas fa-layer-group"></i>
            </div>
            <div>
                <h2>بيانات المؤشر</h2>
                <p>حدد المحور والوحدة ثم أدخل عنوان وتفاصيل المؤشر.</p>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="qdrat-validation-summary"></div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-sitemap"></i>
                الربط التعليمي
            </div>

            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="SelectedSectionId" class="qdrat-label">
                            اختر المحور
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-select-wrapper">
                            <i class="fas fa-chart-pie"></i>
                            <select asp-for="SelectedSectionId"
                                    asp-items="Model.Sections"
                                    class="form-select qdrat-select"
                                    id="SelectedSectionId"></select>
                        </div>
                        <span asp-validation-for="SelectedSectionId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="SelectedUnitId" class="qdrat-label">
                            اختر الوحدة
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-select-wrapper">
                            <i class="fas fa-bookmark"></i>
                            <select asp-for="SelectedUnitId"
                                    asp-items="Model.Units"
                                    class="form-select qdrat-select"
                                    id="SelectedUnitId">
                                <option value="">-- اختر الوحدة --</option>
                            </select>
                        </div>
                        <span asp-validation-for="SelectedUnitId" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-pen-nib"></i>
                محتوى المؤشر
            </div>

            <div class="row g-4">
                <div class="col-12">
                    <div class="qdrat-form-group">
                        <label asp-for="Title" class="qdrat-label">
                            اسم المؤشر
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-heading"></i>
                            <input asp-for="Title"
                                   class="form-control qdrat-input"
                                   placeholder="أدخل اسم المؤشر"
                                   required />
                        </div>
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-12">
                    <div class="qdrat-form-group">
                        <label asp-for="Content" class="qdrat-label">
                            محتوى المؤشر
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-textarea-wrapper">
                            <textarea asp-for="Content"
                                      class="form-control qdrat-textarea"
                                      rows="5"
                                      placeholder="أدخل تفاصيل المؤشر"
                                      required></textarea>
                        </div>
                        <span asp-validation-for="Content" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-section qdrat-status-section">
            <div class="qdrat-switch-card">
                <div class="qdrat-switch-info">
                    <div class="qdrat-switch-icon">
                        <i class="fas fa-toggle-on"></i>
                    </div>
                    <div>
                        <h3>حالة المؤشر</h3>
                        <p>عند التفعيل يظهر المؤشر ضمن عمليات التوليد المرتبطة بالمحاور والوحدات.</p>
                    </div>
                </div>

                <div class="form-check form-switch qdrat-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="IsActive" class="form-check-label">مفعل</label>
                </div>
            </div>
        </div>

        <div class="qdrat-actions">
            <a asp-action="Index" class="qdrat-cancel-btn">
                <i class="fas fa-times"></i>
                العودة للقائمة
            </a>

            <button type="submit" class="qdrat-save-btn">
                <i class="fas fa-save"></i>
                حفظ المؤشر
            </button>
        </div>
    </form>
</div>

<style>
    .qdrat-page-wrapper {
        max-width: 1180px;
        margin: 0 auto;
        padding: 24px 16px 40px;
        font-family: 'Cairo', 'Tajawal', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .qdrat-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 22px;
        padding: 22px 24px;
        border-radius: 24px;
        background: linear-gradient(135deg, #0f766e 0%, #0891b2 55%, #2563eb 100%);
        color: #fff;
        box-shadow: 0 18px 45px rgba(15, 118, 110, 0.22);
    }

    .qdrat-page-title {
        margin: 0;
        font-size: 26px;
        font-weight: 900;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .qdrat-page-subtitle {
        margin: 8px 0 0;
        color: rgba(255, 255, 255, 0.88);
        font-size: 14px;
        line-height: 1.8;
    }

    .qdrat-back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 150px;
        padding: 11px 18px;
        border-radius: 999px;
        color: #fff;
        text-decoration: none;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.32);
        font-size: 14px;
        font-weight: 800;
        transition: all 0.2s ease-in-out;
    }

        .qdrat-back-btn:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.24);
            transform: translateY(-1px);
        }

    .qdrat-form-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 26px;
        box-shadow: 0 20px 55px rgba(15, 23, 42, 0.08);
        padding: 26px;
        overflow: hidden;
    }

    .qdrat-card-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding-bottom: 22px;
        border-bottom: 1px solid #eef2f7;
        margin-bottom: 24px;
    }

    .qdrat-card-icon {
        width: 54px;
        height: 54px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #ecfeff 0%, #dbeafe 100%);
        color: #0f766e;
        font-size: 22px;
        flex-shrink: 0;
    }

    .qdrat-card-header h2 {
        margin: 0;
        font-size: 20px;
        font-weight: 900;
        color: #111827;
    }

    .qdrat-card-header p {
        margin: 6px 0 0;
        color: #6b7280;
        font-size: 13px;
    }

    .qdrat-section {
        padding: 20px;
        border: 1px solid #eef2f7;
        background: #fbfdff;
        border-radius: 22px;
        margin-bottom: 20px;
    }

    .qdrat-section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 18px;
        color: #0f172a;
        font-size: 16px;
        font-weight: 900;
    }

        .qdrat-section-title i {
            color: #0f766e;
        }

    .qdrat-form-group {
        margin-bottom: 2px;
    }

    .qdrat-label {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 9px;
        color: #1f2937;
        font-size: 14px;
        font-weight: 900;
    }

    .qdrat-required {
        color: #dc2626;
        font-weight: 900;
    }

    .qdrat-input-wrapper,
    .qdrat-select-wrapper {
        position: relative;
    }

        .qdrat-input-wrapper i,
        .qdrat-select-wrapper i {
            position: absolute;
            top: 50%;
            right: 15px;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 15px;
            z-index: 2;
            pointer-events: none;
        }

    .qdrat-input,
    .qdrat-select {
        min-height: 48px;
        border-radius: 16px;
        border: 1px solid #dbe3ef;
        background-color: #fff;
        padding: 10px 44px 10px 14px;
        color: #111827;
        font-size: 14px;
        font-weight: 700;
        transition: all 0.18s ease-in-out;
    }

        .qdrat-input:focus,
        .qdrat-select:focus,
        .qdrat-textarea:focus {
            border-color: #0f766e;
            box-shadow: 0 0 0 4px rgba(15, 118, 110, 0.10);
        }

    .qdrat-textarea {
        border-radius: 18px;
        border: 1px solid #dbe3ef;
        background: #fff;
        padding: 14px 16px;
        color: #111827;
        font-size: 14px;
        font-weight: 700;
        resize: vertical;
        min-height: 140px;
        transition: all 0.18s ease-in-out;
    }

    .qdrat-validation-summary {
        color: #b91c1c;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 16px;
        padding: 12px 16px;
        margin-bottom: 20px;
        font-size: 14px;
        font-weight: 700;
    }

        .qdrat-validation-summary:empty {
            display: none;
        }

    .qdrat-switch-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 18px;
        border-radius: 18px;
        background: linear-gradient(135deg, #f8fafc 0%, #eef6ff 100%);
        border: 1px dashed #bfdbfe;
    }

    .qdrat-switch-info {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .qdrat-switch-icon {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        color: #0f766e;
        font-size: 20px;
        box-shadow: 0 8px 20px rgba(15, 118, 110, 0.08);
        flex-shrink: 0;
    }

    .qdrat-switch-info h3 {
        margin: 0;
        color: #0f172a;
        font-size: 16px;
        font-weight: 900;
    }

    .qdrat-switch-info p {
        margin: 5px 0 0;
        color: #64748b;
        font-size: 13px;
        line-height: 1.7;
    }

    .qdrat-switch {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 110px;
        justify-content: flex-end;
        padding-right: 0;
    }

        .qdrat-switch .form-check-input {
            width: 48px;
            height: 24px;
            margin: 0;
            cursor: pointer;
        }

            .qdrat-switch .form-check-input:checked {
                background-color: #0f766e;
                border-color: #0f766e;
            }

        .qdrat-switch .form-check-label {
            margin: 0;
            color: #334155;
            font-size: 14px;
            font-weight: 900;
            cursor: pointer;
        }

    .qdrat-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding-top: 8px;
        flex-wrap: wrap;
    }

    .qdrat-save-btn,
    .qdrat-cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-width: 170px;
        min-height: 48px;
        border-radius: 999px;
        font-size: 15px;
        font-weight: 900;
        text-decoration: none;
        border: none;
        transition: all 0.2s ease-in-out;
    }

    .qdrat-save-btn {
        color: #fff;
        background: linear-gradient(135deg, #16a34a 0%, #0f766e 100%);
        box-shadow: 0 14px 30px rgba(22, 163, 74, 0.22);
    }

        .qdrat-save-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 18px 34px rgba(22, 163, 74, 0.28);
        }

    .qdrat-cancel-btn {
        color: #334155;
        background: #fff;
        border: 1px solid #cbd5e1;
    }

        .qdrat-cancel-btn:hover {
            color: #0f172a;
            background: #f8fafc;
            transform: translateY(-1px);
        }

    @@media (max-width: 768px) {
        .qdrat-page-header {
            flex-direction: column;
            align-items: stretch;
            padding: 20px;
        }

        .qdrat-page-title {
            font-size: 21px;
        }

        .qdrat-back-btn {
            width: 100%;
        }

        .qdrat-form-card {
            padding: 18px;
            border-radius: 22px;
        }

        .qdrat-section {
            padding: 16px;
        }

        .qdrat-switch-card,
        .qdrat-switch-info {
            align-items: flex-start;
            flex-direction: column;
        }

        .qdrat-switch {
            width: 100%;
            justify-content: flex-start;
        }

        .qdrat-actions {
            flex-direction: column;
        }

        .qdrat-save-btn,
        .qdrat-cancel-btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById("SelectedSectionId").addEventListener("change", function () {
            var sectionId = this.value;
            var unitDropdown = document.getElementById("SelectedUnitId");

            unitDropdown.innerHTML = "<option value=''>-- اختر الوحدة --</option>";

            fetch('/Admin/Lessons/GetUnitsBySectionId?sectionId=' + sectionId)
                .then(response => response.json())
                .then(data => {
                    data.forEach(unit => {
                        var option = document.createElement("option");
                        option.value = unit.value;
                        option.text = unit.text;
                        unitDropdown.appendChild(option);
                    });
                });
        });
    </script>
}
