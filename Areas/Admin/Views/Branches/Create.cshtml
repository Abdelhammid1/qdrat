@model QdratNew.Entities.Branch

@{
    ViewData["Title"] = "إضافة فرع جديد";
}

<div class="container-fluid py-4" dir="rtl">
    <div class="qdrat-page-header mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <div class="qdrat-breadcrumb mb-2">
                    <span>الإدارة</span>
                    <i class="fas fa-chevron-left"></i>
                    <span>الفروع</span>
                    <i class="fas fa-chevron-left"></i>
                    <strong>إضافة فرع</strong>
                </div>
                <h2 class="qdrat-page-title mb-1">
                    <i class="fas fa-plus-circle"></i>
                    إضافة فرع جديد
                </h2>
                <p class="qdrat-page-subtitle mb-0">
                    أدخل بيانات الفرع الأساسية ليظهر داخل منظومة الإدارة والدفعات والشركاء.
                </p>
            </div>

            <div class="qdrat-header-actions">
                <a asp-action="Index" class="btn btn-light qdrat-btn-back">
                    <i class="fas fa-arrow-right"></i>
                    الرجوع إلى القائمة
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-xl-8">
            <div class="qdrat-card">
                <div class="qdrat-card-header">
                    <div>
                        <h5 class="mb-1">
                            <i class="fas fa-building"></i>
                            تفاصيل الفرع
                        </h5>
                        <p class="mb-0">الحقول التالية تُستخدم في تنظيم الفروع وربط الطلاب والدفعات.</p>
                    </div>
                </div>

                <form asp-action="Create" method="post" class="qdrat-form">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger qdrat-validation-summary"></div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <div class="qdrat-field">
                                <label asp-for="Name" class="form-label">
                                    <i class="fas fa-building"></i>
                                    اسم الفرع
                                </label>
                                <input asp-for="Name" class="form-control qdrat-input" placeholder="أدخل اسم الفرع" autocomplete="off" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="qdrat-field">
                                <label asp-for="City" class="form-label">
                                    <i class="fas fa-city"></i>
                                    المدينة
                                </label>
                                <input asp-for="City" class="form-control qdrat-input" placeholder="أدخل اسم المدينة" value="@ViewBag.SuggestedCity" autocomplete="off" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="qdrat-field">
                                <label asp-for="Location" class="form-label">
                                    <i class="fas fa-map-marker-alt"></i>
                                    العنوان
                                </label>
                                <input asp-for="Location" class="form-control qdrat-input" placeholder="أدخل عنوان الفرع" autocomplete="off" />
                                <span asp-validation-for="Location" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="qdrat-field">
                                <label asp-for="State" class="form-label">
                                    <i class="fas fa-map"></i>
                                    الولاية / المنطقة
                                </label>
                                <input asp-for="State" class="form-control qdrat-input" placeholder="أدخل اسم الولاية أو المنطقة" autocomplete="off" />
                                <span asp-validation-for="State" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="qdrat-field">
                                <label asp-for="Country" class="form-label">
                                    <i class="fas fa-globe"></i>
                                    الدولة
                                </label>
                                <input asp-for="Country" class="form-control qdrat-input" placeholder="أدخل اسم الدولة" autocomplete="off" />
                                <span asp-validation-for="Country" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="qdrat-field">
                                <label asp-for="EstablishedDate" class="form-label">
                                    <i class="fas fa-calendar-alt"></i>
                                    تاريخ التأسيس
                                </label>
                                <input asp-for="EstablishedDate" type="date" class="form-control qdrat-input" />
                                <span asp-validation-for="EstablishedDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="qdrat-check-card h-100">
                                <div class="form-check form-switch m-0">
                                    <input class="form-check-input" asp-for="IsPartner" role="switch" />
                                    <label class="form-check-label" asp-for="IsPartner">
                                        <span class="qdrat-check-title">
                                            <i class="fas fa-handshake"></i>
                                            هل الفرع شريك؟
                                        </span>
                                        <span class="qdrat-check-text">تفعيل هذه الخاصية يميز الفرع كفرع شريك داخل النظام.</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="qdrat-check-card h-100" style="border-color:#bbf7d0;background:#f0fdf4;">
                                <div class="form-check form-switch m-0">
                                    <input class="form-check-input" asp-for="IsActive" role="switch" checked />
                                    <label class="form-check-label" asp-for="IsActive">
                                        <span class="qdrat-check-title">
                                            <i class="fas fa-toggle-on" style="color:#16a34a"></i>
                                            حالة الفرع
                                        </span>
                                        <span class="qdrat-check-text">الفرع فعّال افتراضياً. أوقفه إذا لم يكن جاهزاً للعمل بعد.</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="qdrat-actions mt-4">
                        <button type="submit" class="btn btn-success qdrat-btn-primary">
                            <i class="fas fa-save"></i>
                            إضافة الفرع
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary qdrat-btn-outline">
                            <i class="fas fa-times"></i>
                            إلغاء
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="qdrat-side-card mb-4">
                <div class="qdrat-side-icon">
                    <i class="fas fa-sitemap"></i>
                </div>
                <h5>تنظيم الفروع</h5>
                <p>
                    بيانات الفرع تساعد في ربط الطلاب والدفعات والمدربين ضمن هيكلة إدارية واضحة.
                </p>
            </div>

            <div class="qdrat-tips-card">
                <h6>
                    <i class="fas fa-lightbulb"></i>
                    ملاحظات إدخال
                </h6>
                <ul class="mb-0">
                    <li>اكتب اسم الفرع بشكل واضح ومختصر.</li>
                    <li>تأكد من المدينة والمنطقة لتسهيل الفلترة لاحقًا.</li>
                    <li>فعّل خيار الشريك فقط للفروع التابعة لشركاء المنصة.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
    .qdrat-page-header {
        background: linear-gradient(135deg, #f8fafc 0%, #eef4ff 100%);
        border: 1px solid #e5edf8;
        border-radius: 22px;
        padding: 24px;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.06);
    }

    .qdrat-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #64748b;
        font-size: 13px;
    }

        .qdrat-breadcrumb i {
            font-size: 10px;
            color: #94a3b8;
        }

    .qdrat-page-title {
        color: #1e293b;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .qdrat-page-title i {
            color: #2563eb;
        }

    .qdrat-page-subtitle {
        color: #64748b;
        font-size: 15px;
    }

    .qdrat-btn-back,
    .qdrat-btn-outline,
    .qdrat-btn-primary {
        border-radius: 14px;
        padding: 10px 18px;
        font-weight: 700;
    }

    .qdrat-card,
    .qdrat-side-card,
    .qdrat-tips-card {
        background: #ffffff;
        border: 1px solid #e5edf8;
        border-radius: 24px;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.06);
    }

    .qdrat-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #edf2f7;
    }

        .qdrat-card-header h5 {
            color: #1e293b;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .qdrat-card-header h5 i {
                color: #2563eb;
            }

        .qdrat-card-header p {
            color: #64748b;
            font-size: 14px;
        }

    .qdrat-form {
        padding: 24px;
    }

    .qdrat-field .form-label {
        color: #334155;
        font-weight: 800;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .qdrat-field .form-label i {
            color: #2563eb;
            width: 18px;
            text-align: center;
        }

    .qdrat-input {
        min-height: 48px;
        border-radius: 14px;
        border: 1px solid #dbe5f1;
        background-color: #fbfdff;
        transition: border-color .2s ease, box-shadow .2s ease, background-color .2s ease;
    }

        .qdrat-input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .12);
            background-color: #ffffff;
        }

    .qdrat-check-card {
        border: 1px solid #dbeafe;
        border-radius: 18px;
        padding: 18px;
        background: #f8fbff;
        display: flex;
        align-items: center;
    }

        .qdrat-check-card .form-switch {
            display: flex;
            gap: 12px;
            align-items: flex-start;
        }

        .qdrat-check-card .form-check-input {
            width: 3rem;
            height: 1.5rem;
            margin: 2px 0 0 0;
            cursor: pointer;
        }

    .qdrat-check-title {
        display: block;
        color: #1e293b;
        font-weight: 800;
        margin-bottom: 4px;
    }

        .qdrat-check-title i {
            color: #2563eb;
            margin-left: 6px;
        }

    .qdrat-check-text {
        display: block;
        color: #64748b;
        font-size: 13px;
        line-height: 1.7;
    }

    .qdrat-actions {
        border-top: 1px solid #edf2f7;
        padding-top: 20px;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: flex-start;
    }

    .qdrat-validation-summary {
        border-radius: 16px;
        border: 0;
    }

    .qdrat-side-card {
        padding: 26px;
        text-align: center;
    }

    .qdrat-side-icon {
        width: 72px;
        height: 72px;
        border-radius: 24px;
        background: #eff6ff;
        color: #2563eb;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        margin-bottom: 16px;
    }

    .qdrat-side-card h5 {
        color: #1e293b;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .qdrat-side-card p {
        color: #64748b;
        line-height: 1.8;
        margin-bottom: 0;
    }

    .qdrat-tips-card {
        padding: 22px;
    }

        .qdrat-tips-card h6 {
            color: #1e293b;
            font-weight: 800;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .qdrat-tips-card h6 i {
                color: #f59e0b;
            }

        .qdrat-tips-card ul {
            padding-right: 18px;
            color: #64748b;
            line-height: 2;
            font-size: 14px;
        }

    @@media (max-width: 768px) {
        .qdrat-page-header,
        .qdrat-card-header,
        .qdrat-form,
        .qdrat-side-card,
        .qdrat-tips-card {
            padding: 18px;
        }

        .qdrat-actions {
            flex-direction: column;
        }

            .qdrat-actions .btn,
            .qdrat-header-actions .btn {
                width: 100%;
            }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
