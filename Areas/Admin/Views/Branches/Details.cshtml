@model QdratNew.Entities.Branch

@{
    ViewData["Title"] = "تفاصيل الفرع";
}

<h2 class="text-secondary"><i class="fas fa-info-circle"></i> تفاصيل الفرع</h2>

<div class="card shadow-sm p-4">
    <h4 class="text-primary"><i class="fas fa-building"></i> معلومات الفرع</h4>
    <hr />
    <dl class="row" dir="rtl">
        <dt class="col-sm-3 text-secondary"><i class="fas fa-building"></i> اسم الفرع</dt>
        <dd class="col-sm-9 fw-bold">@Html.DisplayFor(model => model.Name)</dd>

        <dt class="col-sm-3 text-secondary"><i class="fas fa-map-marker-alt"></i> العنوان</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Location)</dd>

        <dt class="col-sm-3 text-secondary"><i class="fas fa-city"></i> المدينة</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.City)</dd>

        <dt class="col-sm-3 text-secondary"><i class="fas fa-map"></i> الولاية / المنطقة</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.State)</dd>

        <dt class="col-sm-3 text-secondary"><i class="fas fa-globe"></i> الدولة</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Country)</dd>

        <dt class="col-sm-3 text-secondary"><i class="fas fa-handshake"></i> هل الفرع شريك؟</dt>
        <dd class="col-sm-9">
            @if (Model.IsPartner)
            {
                <span class="badge bg-success"><i class="fas fa-check"></i> نعم</span>
            }
            else
            {
                <span class="badge bg-danger"><i class="fas fa-times"></i> لا</span>
            }
        </dd>

        <dt class="col-sm-3 text-secondary"><i class="fas fa-calendar-alt"></i> تاريخ التأسيس</dt>
        <dd class="col-sm-9">@Model.EstablishedDate.ToString("yyyy-MM-dd")</dd>
    </dl>
</div>

<div class="mt-4 d-flex justify-content-between">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> الرجوع إلى القائمة
    </a>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">
        <i class="fas fa-edit"></i> تعديل
    </a>
</div>
