@model QdratNew.ViewModels.Admin.CoursePackages.CoursePackageRegistrationDetailsViewModel
@using QdratNew.Enums
@{
    ViewData["Title"] = "تفاصيل طلب الباقة";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var riyadh = TimeSpan.FromHours(3);

    var statuses = new (CoursePackageRegistrationStatus Value, string Label)[]
    {
        (CoursePackageRegistrationStatus.New, "جديد"),
        (CoursePackageRegistrationStatus.Contacted, "تم التواصل"),
        (CoursePackageRegistrationStatus.NeedFollowUp, "يحتاج متابعة"),
        (CoursePackageRegistrationStatus.Converted, "مؤكد"),
        (CoursePackageRegistrationStatus.Rejected, "مرفوض")
    };
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h4 class="mb-0 fw-bold"><i class="fas fa-file-lines me-2 text-success"></i>طلب حجز رقم @Model.Id</h4>
            <small class="text-muted">@Model.PackageNameSnapshot</small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-3"><i class="fas fa-arrow-right me-1"></i> العودة للصندوق</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-3" role="status"><i class="fas fa-circle-check me-1"></i> @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-3" role="alert"><i class="fas fa-circle-exclamation me-1"></i> @TempData["Error"]</div>
    }

    <div class="row g-4">
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">بيانات المُرسِل</h6>
                    <dl class="row mb-3">
                        <dt class="col-4 text-muted fw-normal">الاسم</dt>
                        <dd class="col-8 fw-semibold">@Model.FullName</dd>
                        <dt class="col-4 text-muted fw-normal">الجوال</dt>
                        <dd class="col-8" dir="ltr" style="text-align:end">@Model.PhoneNumber</dd>
                        <dt class="col-4 text-muted fw-normal">الباقة</dt>
                        <dd class="col-8">@Model.PackageNameSnapshot</dd>
                        <dt class="col-4 text-muted fw-normal">تاريخ الطلب</dt>
                        <dd class="col-8" dir="ltr" style="text-align:end">@((Model.SubmittedAt + riyadh).ToString("yyyy-MM-dd HH:mm"))</dd>
                        <dt class="col-4 text-muted fw-normal">أول تواصل</dt>
                        <dd class="col-8" dir="ltr" style="text-align:end">@(Model.ContactedAt.HasValue ? (Model.ContactedAt.Value + riyadh).ToString("yyyy-MM-dd HH:mm") : "—")</dd>
                        <dt class="col-4 text-muted fw-normal">آخر تحديث</dt>
                        <dd class="col-8" dir="ltr" style="text-align:end">@(Model.LastUpdatedAt.HasValue ? (Model.LastUpdatedAt.Value + riyadh).ToString("yyyy-MM-dd HH:mm") : "—")</dd>
                        <dt class="col-4 text-muted fw-normal">IP</dt>
                        <dd class="col-8 small" dir="ltr" style="text-align:end">@(Model.IpAddress ?? "—")</dd>
                    </dl>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="tel:@Model.PhoneNumber" class="btn btn-outline-primary"><i class="fas fa-phone me-1"></i> اتصال</a>
                        <a href="https://wa.me/@Model.WhatsAppNumber" target="_blank" rel="noopener noreferrer" class="btn btn-outline-success"><i class="fab fa-whatsapp me-1"></i> واتساب</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">المتابعة</h6>
                    <form asp-action="UpdateStatus" method="post">
                        <input type="hidden" name="Id" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label" for="regStatusSel">الحالة</label>
                            <select id="regStatusSel" name="Status" class="form-select">
                                @foreach (var s in statuses)
                                {
                                    <option value="@((int)s.Value)" selected="@(Model.Status == s.Value)">@s.Label</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="regNotes">ملاحظات الأدمن</label>
                            <textarea id="regNotes" name="AdminNotes" class="form-control" rows="5" maxlength="1000"
                                      placeholder="نتيجة الاتصال، موعد المتابعة…">@Model.AdminNotes</textarea>
                            <div class="form-text">حتى 1000 حرف.</div>
                        </div>

                        <button type="submit" class="btn btn-success rounded-3"><i class="fas fa-floppy-disk me-1"></i> حفظ</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
