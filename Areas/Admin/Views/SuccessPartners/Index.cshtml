@model IEnumerable<QdratNew.Entities.SuccessPartner>
@{
    ViewData["Title"] = "🤝 شركاؤنا في النجاح";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4" dir="rtl">
    <div class="d-flex justify-content-between mb-3">
        <h3 class="fw-bold text-primary"><i class="bi bi-people-fill me-2"></i> شركاؤنا في النجاح</h3>
        <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i> إضافة شريك جديد</a>
    </div>

    <div class="alert alert-info small">
        🔄 يمكنك سحب الصفوف بالماوس لتغيير ترتيب الشركاء، وسيتم حفظ الترتيب تلقائيًا.
    </div>

    <table class="table table-bordered align-middle" id="partnersTable">
        <thead class="table-light">
            <tr>
                <th style="width:60px;">🔀</th>
                <th>الشعار</th>
                <th>الاسم</th>
                <th>الرابط</th>
                <th>الحالة</th>
                <th>تحكم</th>
            </tr>
        </thead>
        <tbody id="sortable">
            @foreach (var p in Model.OrderBy(p => p.DisplayOrder))
            {
                <tr data-id="@p.Id" style="cursor:grab;">
                    <td class="text-center text-secondary"><i class="bi bi-list fs-4"></i></td>
                    <td>
                        @if (!string.IsNullOrEmpty(p.LogoPath))
                        {
                            <img src="@p.LogoPath" style="width:70px;height:70px;object-fit:contain;" class="img-thumbnail" />
                        }
                    </td>
                    <td>@p.Name</td>
                    <td>
                        @if (!string.IsNullOrEmpty(p.Url))
                        {
                            <a href="@p.Url" target="_blank">@p.Url</a>
                        }
                    </td>
                    <td>
                        @(p.IsActive ? "✅ نشط" : "❌ معطل")
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-primary">✏️ تعديل</a>
                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('هل أنت متأكد من الحذف؟');">
                                🗑️ حذف
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <script>
        $(function () {
            $("#sortable").sortable({
                placeholder: "ui-state-highlight",
                update: function () {
                    const orderedIds = $("#sortable tr").map(function () {
                        return $(this).data("id");
                    }).get();

                    $.ajax({
                        url: '/Admin/SuccessPartners/Reorder',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(orderedIds),
                        success: function () {
                            console.log('✅ تم تحديث الترتيب بنجاح');
                        },
                        error: function () {
                            alert('⚠️ حدث خطأ أثناء تحديث الترتيب');
                        }
                    });
                }
            });
            $("#sortable").disableSelection();
        });
    </script>

    <style>
        .ui-state-highlight {
            height: 3rem;
            background: #f8f9fa;
            border: 2px dashed #198754;
        }

        tr[data-id]:hover {
            background-color: #f6f8fa !important;
        }
    </style>
}
