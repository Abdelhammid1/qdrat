@model QdratNew.ViewModels.Homework.HomeworkArchiveAccessViewModel

@{
    ViewData["Title"] = "موافقات الوصول للأرشيف";
}

<div class="container-fluid py-4" dir="rtl">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h2 class="h4 mb-1">موافقات الوصول للأرشيف</h2>
            <div class="text-muted">@Model.HomeworkTitle - @Model.BatchName</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ArchiveHistory" asp-route-homeworkSetId="@Model.HomeworkSetId" class="btn btn-outline-secondary">
                الهيستوري
            </a>
            <a asp-action="Index" asp-route-showArchived="true" class="btn btn-outline-primary">
                رجوع للأرشيف
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="UpdateArchiveAccess" method="post" class="card border-0 shadow-sm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="homeworkSetId" value="@Model.HomeworkSetId" />

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:70px">السماح</th>
                        <th>المستخدم</th>
                        <th>البريد</th>
                        <th>الطبقات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Users.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                لا يوجد مستخدمون نشطون ضمن Admin أو Employee أو SuperAdmin.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>
                                    <input class="form-check-input" type="checkbox" name="allowedUserIds" value="@user.UserId" checked="@user.IsAllowed" />
                                </td>
                                <td class="fw-semibold">@user.DisplayName</td>
                                <td>@user.Email</td>
                                <td>@user.Roles</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white d-flex justify-content-end gap-2">
            <button type="submit" class="btn btn-primary">
                حفظ الموافقات
            </button>
        </div>
    </form>
</div>
