@model HomeworkAnalyticsViewModel
@using System.Text.Json
@using QdratNew.ViewModels.Homework


<div class="card-custom hover-lift fade-in">

    <h5>توزيع الإجابات</h5>

    <canvas id="donutChart"></canvas>

</div>

<script>
    new Chart(document.getElementById("donutChart"), {
        type: 'doughnut',
        data: {
            labels: ["صحيح", "خطأ", "متروك"],
            datasets: [{
                data: [
                    @Model.CorrectAnswers,
                    @Model.WrongAnswers,
                    @Model.SkippedAnswers
                ],
                backgroundColor: ["#4CAF7A", "#D67A4B", "#9A9A9A"]
            }]
        }
    });
</script>