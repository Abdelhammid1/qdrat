@model HomeworkAnalyticsViewModel
@using QdratNew.Enums
@using QdratNew.ViewModels.Homework



<div class="card-custom section-box hover-lift fade-in">

    <h4 class="section-title mb-3">تحليل السلوك</h4>

    @{
        var css = "behavior-good";
        var text = "طبيعي";

        if (Model.BehaviorLevel == StudentBehaviorLevel.مريب)
        {
            css = "behavior-warning";
            text = "مريب";
        }
        else if (Model.BehaviorLevel == StudentBehaviorLevel.غش_محتمل)
        {
            css = "behavior-danger";
            text = "غير طبيعي";
        }
    }

    <div class="@css fs-4 mb-2">@text</div>

    <div class="text-muted">
        متوسط الزمن: @Model.AvgTimePerQuestion دقيقة
    </div>

</div>