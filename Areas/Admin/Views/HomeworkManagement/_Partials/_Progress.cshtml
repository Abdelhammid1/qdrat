@using QdratNew.ViewModels.Homework
@model HomeworkAnalyticsViewModel


<div class="card-custom section-box text-center hover-lift fade-in">

    <h5 class="mb-3">تطور الأداء</h5>

    <div class="progress-circle mx-auto mb-3">
        <div class="progress-fill" id="progressFill"></div>
    </div>

    <div>@Model.ParentReport.Progress</div>

</div>

<script>
    window.addEventListener("load", function () {

        const percent = @Model.ScorePercentage;
        const fill = document.getElementById("progressFill");

        setTimeout(() => {
            fill.style.transform = `rotate(${percent * 3.6}deg)`;
        }, 300);

    });
</script>