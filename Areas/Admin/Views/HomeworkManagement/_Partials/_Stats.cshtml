@using QdratNew.ViewModels.Homework
@model HomeworkAnalyticsViewModel


<div class="row g-3">

    <div class="col-md-2">
        <div class="card-custom card-stats hover-lift fade-in">
            <h3>@Model.TotalQuestions</h3>
            <small>إجمالي</small>
        </div>
    </div>

    <div class="col-md-2">
        <div class="card-custom card-stats success hover-lift fade-in">
            <h3>@Model.CorrectAnswers</h3>
            <small>صحيح</small>
        </div>
    </div>

    <div class="col-md-2">
        <div class="card-custom card-stats danger hover-lift fade-in">
            <h3>@Model.WrongAnswers</h3>
            <small>خطأ</small>
        </div>
    </div>

    <div class="col-md-2">
        <div class="card-custom card-stats gray hover-lift fade-in">
            <h3>@Model.SkippedAnswers</h3>
            <small>متروك</small>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card-custom card-score text-center pulse">
            <h2>@Model.ScorePercentage %</h2>
            <small>النتيجة</small>
        </div>
    </div>

</div>