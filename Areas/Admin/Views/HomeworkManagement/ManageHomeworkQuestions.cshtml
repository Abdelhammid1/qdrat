@model QdratNew.ViewModels.Homework.ManageHomeworkQuestionsViewModel
@using QdratNew.Helpers

@{
    ViewData["Title"] = "إدارة الأسئلة داخل الواجب";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <style>
        :root {
            --pr-bg: #f4f7fb;
            --pr-surface: #111827;
            --pr-card: #1c2538;
            --pr-border: rgba(255,255,255,.08);
            --pr-accent: #2563eb;
            --pr-accent-glow: rgba(37,99,235,.16);
            --pr-success: #16a34a;
            --pr-danger: #dc2626;
            --pr-warning: #f59e0b;
            --pr-text: #e2e8f0;
            --pr-muted: #64748b;
            --pr-radius: 14px;
            --pr-radius-sm: 9px;
            --pr-font: 'Cairo', sans-serif;
            --pr-transition: .2s cubic-bezier(.4,0,.2,1);
        }

        body {
            background: var(--pr-bg) !important;
        }

        .pr-page {
            font-family: var(--pr-font);
            min-height: 100vh;
            padding: 28px 0 60px;
            direction: rtl;
        }

        .pr-header {
            background: #ffffff !important;
            border: 1px solid #dbe4ef !important;
            border-radius: var(--pr-radius) !important;
            padding: 18px 22px !important;
            box-shadow: 0 8px 22px rgba(15, 23, 42, 0.06) !important;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 24px;
        }

        .pr-header-title {
            color: #0f172a !important;
            font-size: 22px !important;
            font-weight: 900 !important;
            margin: 0;
            line-height: 1.2;
        }

            .pr-header-title i {
                color: var(--pr-accent) !important;
                opacity: 1 !important;
            }

        .pr-header-sub {
            color: #475569 !important;
            font-size: 13px !important;
            font-weight: 600 !important;
            margin-top: 5px;
            line-height: 1.8;
        }

        .pr-header-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .btn-pr-primary {
            background: var(--pr-accent);
            border: 1px solid var(--pr-accent);
            color: #ffffff;
            font-size: 13px;
            font-weight: 800;
            border-radius: var(--pr-radius-sm);
            padding: 8px 18px;
            transition: var(--pr-transition);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            cursor: pointer;
        }

            .btn-pr-primary:hover {
                background: #1d4ed8;
                border-color: #1d4ed8;
                color: #ffffff;
                transform: translateY(-1px);
                box-shadow: 0 6px 18px rgba(37,99,235,.25);
                text-decoration: none;
            }

        .btn-pr-outline {
            background: #ffffff;
            border: 1px solid #cbd5e1;
            color: #334155;
            font-size: 13px;
            font-weight: 800;
            border-radius: var(--pr-radius-sm);
            padding: 8px 18px;
            transition: var(--pr-transition);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            text-decoration: none;
        }

            .btn-pr-outline:hover {
                background: #f1f5f9;
                border-color: #94a3b8;
                color: #0f172a;
                text-decoration: none;
            }

        .btn-pr-danger {
            background: #fff;
            border: 1px solid #fecaca;
            color: #b91c1c;
            font-size: 13px;
            font-weight: 800;
            border-radius: var(--pr-radius-sm);
            padding: 8px 18px;
            transition: var(--pr-transition);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            text-decoration: none;
        }

            .btn-pr-danger:hover {
                background: #fee2e2;
                border-color: #fca5a5;
                color: #991b1b;
            }

        .pr-hero {
            background: linear-gradient(135deg, #1a2540 0%, #1c3052 60%, #162440 100%);
            border: 1px solid var(--pr-border);
            border-radius: var(--pr-radius);
            padding: 28px 32px;
            margin-bottom: 24px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 14px 32px rgba(15, 23, 42, 0.18);
        }

            .pr-hero::before {
                content: '';
                position: absolute;
                top: -70px;
                left: -70px;
                width: 240px;
                height: 240px;
                background: radial-gradient(circle, rgba(59,130,246,.20) 0%, transparent 70%);
                pointer-events: none;
            }

        .pr-hero-label {
            font-size: 13px;
            color: #94a3b8;
            margin-bottom: 6px;
            font-weight: 700;
        }

        .pr-hero-title {
            font-size: 34px;
            font-weight: 900;
            line-height: 1.35;
            color: #ffffff;
            margin: 0;
        }

        .pr-hero-filtered {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            background: rgba(59,130,246,.14);
            color: #bfdbfe;
            border: 1px solid rgba(59,130,246,.30);
            border-radius: 20px;
            padding: 5px 13px;
            margin-top: 12px;
            font-weight: 700;
        }

        .pr-chips {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
        }

        .pr-chip {
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.10);
            border-radius: var(--pr-radius-sm);
            padding: 13px 14px;
            text-align: center;
        }

        .pr-chip-val {
            font-size: 24px;
            font-weight: 900;
            line-height: 1;
        }

        .pr-chip-lbl {
            font-size: 12px;
            color: #cbd5e1;
            margin-top: 5px;
            font-weight: 700;
        }

        .pr-section-label {
            font-size: 12px;
            font-weight: 900;
            color: #334155;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .pr-section-label::after {
                content: '';
                flex: 1;
                height: 1px;
                background: #dbe4ef;
            }

        .pr-filter-panel {
            background: #ffffff;
            border: 1px solid #dbe4ef;
            border-radius: var(--pr-radius);
            padding: 20px 24px;
            margin-bottom: 20px;
            box-shadow: 0 8px 22px rgba(15, 23, 42, 0.05);
        }

            .pr-filter-panel .form-label {
                font-size: 12px;
                font-weight: 800;
                color: #334155;
                margin-bottom: 6px;
            }

            .pr-filter-panel .form-control {
                background: #ffffff;
                border: 1px solid #cbd5e1;
                color: #0f172a;
                border-radius: var(--pr-radius-sm);
                font-size: 13px;
                height: 41px;
                font-weight: 700;
                transition: var(--pr-transition);
            }

                .pr-filter-panel .form-control:focus {
                    border-color: rgba(37,99,235,.65);
                    box-shadow: 0 0 0 3px rgba(37,99,235,.12);
                }

        .pr-toolbar {
            background: #111827;
            border: 1px solid #243041;
            border-radius: var(--pr-radius);
            padding: 14px 20px;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.12);
        }

        .pr-toolbar-title {
            font-size: 14px;
            font-weight: 900;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .pr-selected-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            font-weight: 800;
            color: #bfdbfe;
            background: rgba(37,99,235,.20);
            border: 1px solid rgba(37,99,235,.35);
            border-radius: 20px;
            padding: 5px 13px;
        }

        .pr-table-panel {
            background: #ffffff !important;
            border: 1px solid #d8e0ec !important;
            border-radius: var(--pr-radius) !important;
            overflow: hidden;
            box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
        }

            .pr-table-panel .table,
            .pr-table-panel table.dataTable {
                background-color: #ffffff !important;
                color: #1e293b !important;
                margin: 0 !important;
                width: 100% !important;
            }

                .pr-table-panel .table thead th,
                .pr-table-panel table.dataTable thead th {
                    background: #f1f5f9 !important;
                    color: #0f172a !important;
                    border-bottom: 1px solid #cbd5e1 !important;
                    border-color: #dbe4ef !important;
                    font-size: 12px !important;
                    font-weight: 900 !important;
                    opacity: 1 !important;
                    padding: 12px 14px !important;
                    white-space: nowrap;
                    vertical-align: middle;
                    text-align: center;
                }

                .pr-table-panel .table tbody td,
                .pr-table-panel table.dataTable tbody td {
                    background: #ffffff !important;
                    color: #1e293b !important;
                    border-color: #e2e8f0 !important;
                    font-size: 13px !important;
                    font-weight: 700 !important;
                    opacity: 1 !important;
                    padding: 12px 14px !important;
                    vertical-align: middle !important;
                    text-align: center;
                }

                .pr-table-panel .table tbody tr:hover td,
                .pr-table-panel table.dataTable tbody tr:hover td {
                    background: #f8fafc !important;
                }

        .pr-q-title {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            min-width: 360px;
            text-align: right;
        }

        .pr-q-title-text {
            color: #0f172a !important;
            font-weight: 800 !important;
            opacity: 1 !important;
            line-height: 1.65;
            white-space: normal;
            max-width: 620px;
        }

        .pr-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            font-size: 11px;
            font-weight: 900;
            border-radius: 20px;
            padding: 4px 10px;
            border: 1px solid transparent;
            white-space: nowrap;
        }

        .pr-badge-confirmed {
            background: #dcfce7 !important;
            color: #15803d !important;
            border-color: #86efac !important;
        }

        .pr-badge-warning {
            background: #fef3c7 !important;
            color: #92400e !important;
            border-color: #fde68a !important;
        }

        .pr-badge-note {
            background: #eef2ff !important;
            color: #3730a3 !important;
            border-color: #c7d2fe !important;
            max-width: 300px;
            white-space: normal;
            line-height: 1.6;
        }

        .pr-badge-empty {
            background: #f1f5f9 !important;
            color: #64748b !important;
            border-color: #cbd5e1 !important;
        }

        .pr-section-pill {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 20px;
            padding: 4px 12px;
            background: #dbeafe;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
            font-size: 11px;
            font-weight: 900;
            white-space: nowrap;
        }

        .pr-action-group {
            display: flex;
            gap: 5px;
            align-items: center;
            justify-content: center;
            flex-wrap: nowrap;
        }

        .pr-action-btn {
            background: #f8fafc !important;
            border: 1px solid #cbd5e1 !important;
            color: #475569 !important;
            border-radius: 7px;
            width: 31px;
            height: 31px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            transition: var(--pr-transition);
            text-decoration: none;
            cursor: pointer;
            opacity: 1 !important;
        }

            .pr-action-btn:hover {
                background: #e2e8f0 !important;
                color: #0f172a !important;
                text-decoration: none;
                transform: translateY(-1px);
            }

            .pr-action-btn.preview {
                color: #2563eb !important;
            }

        .pr-check {
            width: 18px;
            height: 18px;
            cursor: pointer;
            border-radius: 4px;
        }

        .pr-footer-actions {
            background: #f8fafc;
            border-top: 1px solid #dbe4ef;
            padding: 16px 18px;
            display: flex;
            justify-content: center;
        }

        .btn-pr-add {
            background: var(--pr-success);
            border: 1px solid var(--pr-success);
            color: #ffffff;
            font-size: 14px;
            font-weight: 900;
            border-radius: 12px;
            padding: 11px 24px;
            transition: var(--pr-transition);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
        }

            .btn-pr-add:hover {
                background: #15803d;
                border-color: #15803d;
                color: #ffffff;
                transform: translateY(-1px);
                box-shadow: 0 8px 20px rgba(22, 163, 74, .20);
            }

        .dataTables_wrapper {
            direction: rtl;
            padding: 16px;
        }

            .dataTables_wrapper .dataTables_length label,
            .dataTables_wrapper .dataTables_filter label,
            .dataTables_wrapper .dataTables_info {
                color: #334155 !important;
                font-size: 13px !important;
                font-weight: 800 !important;
            }

            .dataTables_wrapper .dataTables_length select,
            .dataTables_wrapper .dataTables_filter input {
                background: #ffffff !important;
                border: 1px solid #94a3b8 !important;
                color: #0f172a !important;
                border-radius: 8px !important;
                font-size: 13px !important;
                font-weight: 700 !important;
                padding: 5px 10px;
            }

            .dataTables_wrapper .dataTables_paginate .paginate_button {
                background: #ffffff !important;
                border: 1px solid #cbd5e1 !important;
                color: #334155 !important;
                font-weight: 800 !important;
                border-radius: 7px !important;
                margin: 0 2px;
                font-size: 12px;
                padding: 4px 10px !important;
            }

                .dataTables_wrapper .dataTables_paginate .paginate_button.current,
                .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
                    background: var(--pr-accent) !important;
                    border-color: var(--pr-accent) !important;
                    color: #ffffff !important;
                }

        table.dataTable thead .sorting:before,
        table.dataTable thead .sorting:after,
        table.dataTable thead .sorting_asc:before,
        table.dataTable thead .sorting_asc:after,
        table.dataTable thead .sorting_desc:before,
        table.dataTable thead .sorting_desc:after {
            color: #475569 !important;
            opacity: 1 !important;
        }

        .pr-modal .modal-content {
            background: #ffffff !important;
            border: 1px solid #334155;
            border-radius: var(--pr-radius);
            color: #0f172a;
            overflow: hidden;
            box-shadow: 0 24px 70px rgba(15, 23, 42, 0.35);
        }

        .pr-modal .modal-header {
            background: #111827;
            border-bottom: 1px solid #334155;
            padding: 16px 22px;
        }

        .pr-modal .modal-title {
            font-size: 15px;
            font-weight: 900;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .pr-modal .modal-body {
            padding: 0 !important;
            background: #f8fafc !important;
        }

        .pr-modal .btn-close {
            filter: invert(1) brightness(1.7);
            opacity: 1;
        }

        .pr-empty {
            text-align: center;
            padding: 50px 20px;
            color: #64748b;
            background: #f8fafc;
        }

            .pr-empty i {
                font-size: 34px;
                margin-bottom: 12px;
                opacity: .75;
            }

        #questionPreviewModalBody {
            background: #f8fafc !important;
            color: #0f172a !important;
            font-size: 15px !important;
            font-weight: 600 !important;
            line-height: 1.9 !important;
            padding: 22px !important;
            min-height: 260px;
        }

            #questionPreviewModalBody > * {
                color: #0f172a !important;
            }

            #questionPreviewModalBody p,
            #questionPreviewModalBody div,
            #questionPreviewModalBody span,
            #questionPreviewModalBody label,
            #questionPreviewModalBody strong,
            #questionPreviewModalBody small,
            #questionPreviewModalBody li {
                color: #0f172a !important;
                font-size: 15px !important;
                font-weight: 600 !important;
                line-height: 1.9 !important;
                opacity: 1 !important;
            }

            #questionPreviewModalBody .card,
            #questionPreviewModalBody .question-card,
            #questionPreviewModalBody .question-preview-card,
            #questionPreviewModalBody .q-card,
            #questionPreviewModalBody .preview-box,
            #questionPreviewModalBody .question-box,
            #questionPreviewModalBody .student-answer-box,
            #questionPreviewModalBody .answer-review-box,
            #questionPreviewModalBody .review-card,
            #questionPreviewModalBody .result-card {
                background: #ffffff !important;
                color: #0f172a !important;
                border: 1px solid #dbe4ef !important;
                border-radius: 16px !important;
                box-shadow: 0 10px 24px rgba(15, 23, 42, 0.10) !important;
                padding: 18px !important;
            }

            #questionPreviewModalBody h1,
            #questionPreviewModalBody h2,
            #questionPreviewModalBody h3,
            #questionPreviewModalBody h4,
            #questionPreviewModalBody h5,
            #questionPreviewModalBody h6,
            #questionPreviewModalBody .question-title,
            #questionPreviewModalBody .q-title,
            #questionPreviewModalBody .title {
                color: #0f172a !important;
                font-weight: 800 !important;
                opacity: 1 !important;
            }

            #questionPreviewModalBody .question-text,
            #questionPreviewModalBody .q-text,
            #questionPreviewModalBody .question-content,
            #questionPreviewModalBody .preview-question-text {
                color: #0f172a !important;
                font-size: 16px !important;
                font-weight: 700 !important;
                line-height: 1.9 !important;
                opacity: 1 !important;
            }

            #questionPreviewModalBody .option,
            #questionPreviewModalBody .answer-option,
            #questionPreviewModalBody .choice,
            #questionPreviewModalBody .option-card,
            #questionPreviewModalBody .answer-card,
            #questionPreviewModalBody .q-option,
            #questionPreviewModalBody .list-group-item {
                background: #ffffff !important;
                color: #0f172a !important;
                border: 1px solid #cbd5e1 !important;
                border-radius: 14px !important;
                font-weight: 700 !important;
                opacity: 1 !important;
                margin-bottom: 8px;
            }

                #questionPreviewModalBody .option *,
                #questionPreviewModalBody .answer-option *,
                #questionPreviewModalBody .choice *,
                #questionPreviewModalBody .option-card *,
                #questionPreviewModalBody .answer-card *,
                #questionPreviewModalBody .q-option *,
                #questionPreviewModalBody .list-group-item * {
                    color: #0f172a !important;
                    opacity: 1 !important;
                }

                #questionPreviewModalBody .correct,
                #questionPreviewModalBody .is-correct,
                #questionPreviewModalBody .correct-answer,
                #questionPreviewModalBody .answer-option.correct,
                #questionPreviewModalBody .option-card.correct,
                #questionPreviewModalBody .choice.correct {
                    background: #dcfce7 !important;
                    color: #14532d !important;
                    border: 2px solid #16a34a !important;
                    font-weight: 800 !important;
                }

            #questionPreviewModalBody .wrong,
            #questionPreviewModalBody .is-wrong,
            #questionPreviewModalBody .wrong-answer,
            #questionPreviewModalBody .student-wrong-answer {
                background: #fee2e2 !important;
                color: #991b1b !important;
                border: 2px solid #dc2626 !important;
                font-weight: 800 !important;
            }

            #questionPreviewModalBody .badge,
            #questionPreviewModalBody .badge-success,
            #questionPreviewModalBody .bg-success,
            #questionPreviewModalBody .correct-badge {
                background: #16a34a !important;
                color: #ffffff !important;
                border: 1px solid #15803d !important;
                font-weight: 800 !important;
                opacity: 1 !important;
            }

            #questionPreviewModalBody .bg-danger,
            #questionPreviewModalBody .badge-danger,
            #questionPreviewModalBody .wrong-badge {
                background: #dc2626 !important;
                color: #ffffff !important;
                border: 1px solid #b91c1c !important;
                font-weight: 800 !important;
                opacity: 1 !important;
            }

            #questionPreviewModalBody img {
                opacity: 1 !important;
                max-width: 100% !important;
                height: auto !important;
                border-radius: 12px;
            }

            #questionPreviewModalBody audio,
            #questionPreviewModalBody video {
                max-width: 520px !important;
                width: 100% !important;
                border-radius: 12px;
            }

        @@media (max-width: 992px) {
            .pr-chips {
                grid-template-columns: 1fr;
            }

            .pr-filter-actions {
                width: 100%;
            }

                .pr-filter-actions button {
                    width: 100%;
                    justify-content: center;
                }
        }

        @@media (max-width: 768px) {
            .pr-page {
                padding: 18px 0 40px;
            }

            .pr-hero {
                padding: 22px;
            }

            .pr-hero-title {
                font-size: 24px;
            }

            .pr-q-title {
                min-width: 260px;
            }

            .pr-toolbar {
                align-items: flex-start;
            }

            .pr-modal .modal-dialog {
                margin: 8px;
            }

            #questionPreviewModalBody {
                padding: 14px !important;
            }
        }
    </style>
}

<div class="pr-page container-fluid px-4" dir="rtl">

    <div class="pr-header">
        <div>
            <h1 class="pr-header-title">
                <i class="bi bi-journal-check me-2" style="font-size:18px;"></i>
                إدارة الأسئلة داخل الواجب
            </h1>

            <div class="pr-header-sub">
                اختيار أسئلة إضافية من بنك الأسئلة وربطها بالواجب الحالي مع دعم البحث، المعاينة، والاختيار المتعدد.
            </div>
        </div>

        <div class="pr-header-actions">
            <a asp-action="Details"
               asp-route-id="@Model.HomeworkSetId"
               class="btn-pr-outline">
                <i class="bi bi-arrow-right"></i>
                رجوع لتفاصيل الواجب
            </a>
        </div>
    </div>

    <div class="pr-hero">
        <div class="row g-4 align-items-center">
            <div class="col-lg-5">
                <div class="pr-hero-label">إدارة واجب</div>

                <h2 class="pr-hero-title">
                    @Model.HomeworkTitle
                </h2>

                <div class="pr-hero-filtered">
                    <i class="bi bi-layers" style="font-size:11px;"></i>
                    رقم الواجب: @Model.HomeworkSetId
                </div>
            </div>

            <div class="col-lg-7">
                <div class="pr-chips">
                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#bfdbfe;">
                            <span id="loadedQuestionsCount">0</span>
                        </div>
                        <div class="pr-chip-lbl">أسئلة محملة</div>
                    </div>

                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#86efac;">
                            <span id="selectedQuestionsNumber">0</span>
                        </div>
                        <div class="pr-chip-lbl">أسئلة محددة</div>
                    </div>

                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#fde68a;">متعدد</div>
                        <div class="pr-chip-lbl">طريقة الإضافة</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="pr-section-label">البحث في بنك الأسئلة</div>

    <div class="pr-filter-panel">
        <form id="searchForm" class="row g-3 align-items-end">
            <div class="col-lg-8">
                <label class="form-label">بحث سريع</label>
                <input id="searchInput"
                       type="text"
                       class="form-control"
                       placeholder="ابحث في نص السؤال أو الملاحظة الداخلية..." />
            </div>

            <div class="col-lg-4 d-flex flex-wrap gap-2 pr-filter-actions">
                <button type="button"
                        id="btnSearch"
                        class="btn-pr-primary">
                    <i class="bi bi-search"></i>
                    بحث
                </button>

                <button id="btnReset"
                        type="button"
                        class="btn-pr-danger">
                    <i class="bi bi-arrow-repeat"></i>
                    إعادة تعيين
                </button>
            </div>
        </form>
    </div>

    <div class="pr-section-label">قائمة الأسئلة المتاحة</div>

    <div class="pr-toolbar">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="pr-toolbar-title">
                <i class="bi bi-table"></i>
                جدول بنك الأسئلة
            </div>

            <span class="pr-selected-badge" id="selectedQuestionsCount">
                <i class="bi bi-check2-square"></i>
                0 سؤال محدد
            </span>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Details"
               asp-route-id="@Model.HomeworkSetId"
               class="btn-pr-outline"
               style="background:transparent;color:#e2e8f0;border-color:#334155;">
                <i class="bi bi-arrow-right"></i>
                رجوع
            </a>
        </div>
    </div>

    <div class="pr-table-panel">
        <div class="table-responsive">
            <table id="questionsTable" class="table table-hover align-middle mb-0 w-100 text-center">
                <thead>
                    <tr>
                        <th style="width:80px;">اختيار</th>
                        <th style="min-width:420px;">السؤال</th>
                        <th style="min-width:150px;">المحور</th>
                        <th style="min-width:240px;">الملاحظة الداخلية</th>
                        <th style="width:150px;">المراجعة</th>
                        <th style="width:110px;">معاينة</th>
                    </tr>
                </thead>

                <tbody></tbody>
            </table>
        </div>

        <div class="pr-footer-actions">
            <button id="btnAddSelected" class="btn-pr-add">
                <i class="bi bi-plus-circle"></i>
                إضافة الأسئلة المحددة إلى الواجب
            </button>
        </div>
    </div>
</div>

<div class="modal fade pr-modal" id="questionPreviewModal" tabindex="-1" dir="rtl">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content text-end">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-eye" style="color:#60a5fa;"></i>
                    معاينة السؤال
                </h5>

                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="questionPreviewModalBody">
                <div class="pr-empty">
                    <i class="bi bi-hourglass-split"></i>
                    <p>جارٍ التحميل...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            const homeworkSetId = '@Model.HomeworkSetId';
            let selectedQuestions = new Set();

            function updateSelectedCount() {
                const count = selectedQuestions.size;
                const label = count === 1 ? 'سؤال محدد' : 'أسئلة محددة';

                $('#selectedQuestionsCount').html(`<i class="bi bi-check2-square"></i> ${count} ${label}`);
                $('#selectedQuestionsNumber').text(count);
            }

            function cleanQuestionTitle(rawTitle) {
                if (!rawTitle) {
                    return '';
                }

                return rawTitle.replace(/<span[^>]*display:none[^>]*>(.*?)<\/span>/gi, '$1');
            }

            function shortenText(text, maxLength) {
                if (!text) {
                    return '';
                }

                return text.length > maxLength ? text.substring(0, maxLength) + '...' : text;
            }

            function safeHtmlText(value) {
                if (!value || value.trim() === '') {
                    return '—';
                }

                return $('<div>').text(value).html();
            }

            const table = $('#questionsTable').DataTable({
                processing: true,
                serverSide: true,
                scrollX: true,
                autoWidth: false,
                responsive: false,
                ajax: {
                    url: '/Admin/HomeworkManagement/LoadQuestionsData',
                    type: 'POST',
                    data: function (d) {
                        d.homeworkSetId = homeworkSetId;
                        d.searchTerm = $('#searchInput').val();
                    },
                    dataSrc: function (json) {
                        const rows = json && json.data ? json.data : [];
                        $('#loadedQuestionsCount').text(json && typeof json.recordsFiltered !== 'undefined'
                            ? json.recordsFiltered
                            : rows.length);
                        return rows;
                    },
                    error: function (xhr) {
                        console.error("AJAX Error:", xhr.responseText);

                        if (typeof Swal !== "undefined") {
                            Swal.fire('خطأ', 'فشل تحميل بيانات الأسئلة من السيرفر.', 'error');
                        }
                    }
                },
                order: [[1, 'asc']],
                columns: [
                    {
                        data: 'questionId',
                        render: function (data) {
                            const checked = selectedQuestions.has(data) ? 'checked' : '';

                            return `
                                <input type="checkbox"
                                       class="form-check-input pr-check select-question"
                                       value="${data}" ${checked} />`;
                        },
                        orderable: false,
                        searchable: false,
                        className: "text-center"
                    },
                    {
                        data: 'title',
                        className: "dt-body-right",
                        render: function (d, type, row) {
                            const cleanTitle = cleanQuestionTitle(d || '');
                            const shortTitle = shortenText(cleanTitle, 90);
                            const questionId = row.questionId;

                            return `
                                <div class="pr-q-title">
                                    <button type="button"
                                            class="pr-action-btn preview flex-shrink-0"
                                            onclick="showQuestionPreview('${questionId}')"
                                            title="معاينة">
                                        <i class="bi bi-eye"></i>
                                    </button>

                                    <div class="pr-q-title-text">
                                        ${shortTitle || '—'}
                                    </div>
                                </div>`;
                        }
                    },
                    {
                        data: 'sectionTitle',
                        render: function (d) {
                            return d
                                ? `<span class="pr-section-pill">${safeHtmlText(d)}</span>`
                                : `<span class="pr-badge pr-badge-empty">—</span>`;
                        }
                    },
                    {
                        data: 'internalNote',
                        render: function (d) {
                            return d && d.trim() !== ''
                                ? `<span class="pr-badge pr-badge-note">${safeHtmlText(shortenText(d, 80))}</span>`
                                : `<span class="pr-badge pr-badge-empty">—</span>`;
                        }
                    },
                    {
                        data: 'isReviewed',
                        render: function (v) {
                            return v
                                ? `<span class="pr-badge pr-badge-confirmed"><i class="bi bi-check-circle"></i> تمت المراجعة</span>`
                                : `<span class="pr-badge pr-badge-warning"><i class="bi bi-hourglass-split"></i> قيد المراجعة</span>`;
                        },
                        className: "text-center"
                    },
                    {
                        data: 'questionId',
                        render: function (id) {
                            return `
                                <button type="button"
                                        class="pr-action-btn preview"
                                        onclick="showQuestionPreview('${id}')"
                                        title="معاينة">
                                    <i class="bi bi-eye"></i>
                                </button>`;
                        },
                        orderable: false,
                        searchable: false,
                        className: "text-center"
                    }
                ],
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.5/i18n/ar.json"
                },
                pageLength: 30,
                lengthMenu: [[10, 25, 30, 50, 100, -1], [10, 25, 30, 50, 100, "الكل"]],
                drawCallback: function () {
                    $('.select-question').each(function () {
                        const id = $(this).val();

                        if (selectedQuestions.has(id)) {
                            $(this).prop('checked', true);
                        }
                    });

                    updateSelectedCount();
                }
            });

            $('#questionsTable').on('change', '.select-question', function () {
                const id = $(this).val();

                if ($(this).is(':checked')) {
                    selectedQuestions.add(id);
                } else {
                    selectedQuestions.delete(id);
                }

                updateSelectedCount();
            });

            $('#btnSearch').on('click', function () {
                table.ajax.reload();
            });

            $('#searchInput').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    table.ajax.reload();
                }
            });

            $('#btnReset').on('click', function () {
                $('#searchInput').val('');
                selectedQuestions.clear();
                updateSelectedCount();
                table.ajax.reload();
            });

            $('#btnAddSelected').on('click', async function () {
                const selectedIds = Array.from(selectedQuestions);

                if (selectedIds.length === 0) {
                    if (typeof Swal !== "undefined") {
                        Swal.fire('تنبيه', 'يرجى اختيار سؤال واحد على الأقل.', 'warning');
                    }

                    return;
                }

                try {
                    const response = await fetch('/Admin/HomeworkManagement/AddMultipleQuestionsToHomework', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify({
                            homeworkSetId: homeworkSetId,
                            questionIds: selectedIds
                        })
                    });

                    if (!response.ok) {
                        const error = await response.text();

                        if (typeof Swal !== "undefined") {
                            Swal.fire('خطأ', 'فشل إرسال الطلب.\n' + error, 'error');
                        }

                        return;
                    }

                    const result = await response.json();

                    if (typeof Swal !== "undefined") {
                        Swal.fire('تم', result.message || 'تمت إضافة الأسئلة بنجاح.', 'success');
                    }

                    selectedQuestions.clear();
                    updateSelectedCount();
                    table.ajax.reload();
                } catch {
                    if (typeof Swal !== "undefined") {
                        Swal.fire('خطأ', 'حدث خطأ أثناء إضافة الأسئلة المحددة.', 'error');
                    }
                }
            });
        });

        function showQuestionPreview(id) {
            const body = document.getElementById('questionPreviewModalBody');

            body.innerHTML = `
                <div class="pr-empty">
                    <i class="bi bi-hourglass-split"></i>
                    <p>جارٍ التحميل...</p>
                </div>`;

            const modal = new bootstrap.Modal(document.getElementById('questionPreviewModal'));
            modal.show();

            fetch(`/Admin/Questions/Preview/${id}`)
                .then(async response => {
                    if (!response.ok) {
                        throw new Error("HTTP_" + response.status);
                    }

                    const html = await response.text();

                    if (html.includes("System.InvalidOperationException") || html.includes("DeveloperExceptionPage")) {
                        throw new Error("SERVER_EXCEPTION");
                    }

                    return html;
                })
                .then(html => {
                    body.innerHTML = html;
                })
                .catch(() => {
                    body.innerHTML = `
                        <div class="pr-empty">
                            <i class="bi bi-exclamation-triangle text-danger"></i>
                            <h5 style="color:#991b1b;font-weight:900;">تعذر تحميل معاينة السؤال</h5>
                            <p style="color:#475569;font-weight:700;">
                                يوجد خطأ في تحميل بارشال المعاينة أو في صلاحيات أكشن المعاينة.
                            </p>
                        </div>`;

                    if (typeof Swal !== "undefined") {
                        Swal.fire('خطأ', 'حدث خطأ أثناء تحميل السؤال.', 'error');
                    }
                });
        }
    </script>
}
