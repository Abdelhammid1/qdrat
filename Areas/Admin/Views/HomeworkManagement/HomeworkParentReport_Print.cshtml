@model QdratNew.ViewModels.Homework.HomeworkAnalyticsViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_ReportLayout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;700;800&display=swap" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
    /* ❌ لم يتم تعديل أي شيء من تصميمك الأصلي */
    .stat-card {
        height: 110px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .chart-card {
        height: 320px;
        display: flex;
        flex-direction: column;
    }

        .chart-card canvas {
            flex: 1;
            max-height: 250px;
        }

    .card-box canvas {
        flex: 1;
        max-height: 260px;
    }

    .circle {
        position: relative;
        width: 140px;
        height: 140px;
    }

    .circle-text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 22px;
        font-weight: bold;
        color: #176669;
    }

    .behavior-card {
        padding: 20px;
    }

    .behavior-badge {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: bold;
    }

        .behavior-badge.ممتاز {
            background: #28a745;
            color: #fff;
        }

        .behavior-badge.طبيعي {
            background: #17a2b8;
            color: #fff;
        }

        .behavior-badge.مريب {
            background: #ffc107;
            color: #000;
        }

        .behavior-badge.غش_محتمل {
            background: #dc3545;
            color: #fff;
        }

    .behavior-text {
        background: #f8f9fa;
        padding: 12px;
        border-radius: 10px;
        font-size: 14px;
        line-height: 1.8;
    }

    .behavior-card {
        transition: 0.3s;
    }

        .behavior-card:hover {
            transform: translateY(-5px);
        }

    .section-indicator-card {
        border: 1px solid #dfecee;
        border-radius: 10px;
        background: #fff;
        margin-bottom: 16px;
        page-break-inside: avoid;
        break-inside: avoid;
        overflow: hidden;
    }

    .section-indicator-head {
        background: #176669;
        color: #fff;
        padding: 12px 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 700;
    }

    .section-indicator-body {
        padding: 12px 14px;
    }

    .indicator-summary {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 10px;
    }

    .indicator-summary span {
        background: #eef7f7;
        color: #176669;
        border-radius: 16px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 700;
    }

    .indicators-print-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
    }

    .indicators-print-table th,
    .indicators-print-table td {
        border: 1px solid #dfe5e8;
        padding: 7px;
        text-align: center;
    }

    .indicators-print-table th {
        background: #f1f6f7;
        color: #176669;
        font-weight: 700;
    }

    @@media print {
        .section-indicator-card {
            page-break-inside: avoid;
            break-inside: avoid;
        }
    }

    @@media print {
        @@page {
            size: A4 portrait;
            margin: 14mm 10mm;
        }

        html,
        body {
            width: auto !important;
            min-height: auto !important;
            overflow: visible !important;
            background: #fff !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .report-container {
            width: 100% !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .report-header,
        .card-box,
        .stat-card,
        .chart-card,
        .behavior-card,
        .rec-item,
        .alert,
        .level-wrapper {
            break-inside: avoid-page;
            page-break-inside: avoid;
            overflow: visible !important;
        }

        .report-header {
            margin-bottom: 10mm !important;
        }

        .report-container > .row.g-3.mb-4 {
            display: grid !important;
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
            gap: 10px !important;
        }

        .report-container > .row.g-3.mb-4 > [class*="col-"] {
            width: auto !important;
            max-width: none !important;
            flex: none !important;
            padding: 0 !important;
        }

        .card-box {
            box-shadow: none !important;
            border: 1px solid #dfe5e8 !important;
            margin-bottom: 10px !important;
        }

        .stat-card,
        .stat-main,
        .stat-green,
        .stat-red,
        .stat-gray {
            min-height: 74px !important;
            height: auto !important;
            padding: 12px 14px !important;
        }

        .chart-card {
            height: 260px !important;
            min-height: 260px !important;
        }

        .chart-card canvas,
        .card-box canvas,
        .print-chart-img {
            max-width: 100% !important;
            max-height: 210px !important;
            object-fit: contain !important;
        }

        h1, h2, h3, h4, h5,
        .section-indicator-head {
            break-after: avoid-page;
            page-break-after: avoid;
        }

        .section-indicator-card {
            break-inside: avoid-page;
            page-break-inside: avoid;
            margin-bottom: 12px !important;
        }

        .indicators-print-table {
            width: 100% !important;
            border-collapse: collapse !important;
            break-inside: auto;
            page-break-inside: auto;
        }

        .indicators-print-table thead {
            display: table-header-group;
        }

        .indicators-print-table tfoot {
            display: table-footer-group;
        }

        .indicators-print-table tr {
            break-inside: avoid-page;
            page-break-inside: avoid;
        }

        .indicators-print-table th,
        .indicators-print-table td {
            font-size: 10px !important;
            padding: 5px !important;
            line-height: 1.45 !important;
        }

        .page-break {
            break-before: page;
            page-break-before: always;
        }
    }
</style>
<div class="cover-page">

    <div class="cover-content">

        <div class="cover-header">
            <h2>تقرير أداء الطالب في الواجب</h2>
            <div class="date">@DateTime.Now.ToString("yyyy/MM/dd")</div>
        </div>

        <div class="cover-body">

            <p class="greeting">
                ولي الأمر الكريم،
            </p>

            <p>
                نحيطكم علمًا بأن هذا التقرير يعكس مستوى أداء ابنكم/ابنتكم
                <strong>@Model.StudentName</strong>
                في الواجبات التعليمية حتى تاريخ
                <strong>@DateTime.Now.ToString("yyyy/MM/dd")</strong>.
            </p>

            <p>
                يتضمن هذا التقرير تحليلًا شاملًا لنتائج الطالب في الواجب،
                مع توضيح مدى تقدمه، ونقاط القوة التي يتميز بها،
                بالإضافة إلى الجوانب التي تحتاج إلى مزيد من المتابعة والتطوير.
            </p>

            <p>
                ويأتي ذلك في إطار حرصنا على دعم الطالب وتحسين مستواه بشكل مستمر،
                من خلال تقديم تقارير دقيقة تساعدكم على متابعة أدائه واتخاذ القرارات المناسبة لدعمه.
            </p>

            <p class="closing">
                شاكرين ومقدّرين تعاونكم،
                <br />
                <strong>فريق منصة قدرات التعليمية</strong>
            </p>

        </div>

    </div>

</div>

<!-- فصل الصفحة -->
<div class="page-break"></div>


<div class="report-container">

    <!-- Header -->
    <div class="report-header d-flex justify-content-between align-items-center">

        <div>
            <div class="report-title">تقرير تحليل أداء الطالب</div>
            <div class="text-muted">
                اسم الطالب: @Model.StudentName |
                الدفعة: @Model.BatchName |
                واجب: @Model.HomeworkSetId
            </div>
        </div>

        <!-- ✅ فقط أضفنا onclick -->

    </div>

    <!-- ❌ باقي التصميم كما هو بدون أي تعديل -->
    <!-- Stats -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card-box stat-main stat-card text-center">
                <h2>@Model.ScorePercentage%</h2>
                <small>النتيجة</small>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card-box stat-card text-center">
                <h3>@Model.TotalQuestions</h3>
                <small>إجمالي</small>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card-box text-center stat-green">
                <h3>@Model.CorrectAnswers</h3>
                <small>صحيح</small>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card-box text-center stat-red">
                <h3>@Model.WrongAnswers</h3>
                <small>خطأ</small>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card-box text-center stat-gray">
                <h3>@Model.SkippedAnswers</h3>
                <small>متخطاه</small>
            </div>
        </div>

    </div>

    <!-- Behavior -->
    <div class="row mb-4">

        <div class="col-md-6">
            <div class="card-box chart-card text-center h-100">
                <h5>تطور المستوى</h5>

                <div class="level-wrapper">
                    <canvas id="levelChart"></canvas>

                    <div class="level-text">
                        @Model.ScorePercentage%
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card-box h-100 behavior-card">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">تحليل السلوك أثناء الحل</h5>

                    <span class="behavior-badge @Model.BehaviorLevel.ToString()">
                        @Model.BehaviorLevel
                    </span>
                </div>

                <!-- متوسط الزمن -->
                <div class="behavior-metric mb-3">
                    <div class="d-flex justify-content-between">
                        <span>متوسط زمن الحل</span>
                        <strong>@Model.AvgTimePerQuestion دقيقة</strong>
                    </div>

                    <div class="progress mt-2">
                        <div class="progress-bar bg-info"
                             style="width:@(Math.Min(Model.AvgTimePerQuestion * 10, 100))%">
                        </div>
                    </div>
                </div>

                <!-- تحليل نصي -->
                <div class="behavior-text">
                    @Model.BehaviorAnalysisText
                </div>

            </div>
        </div>

    </div>
    <hr />
    <br />
    <!-- Charts (✔ تم تصحيحها بالكامل) -->
    <div class="row mb-4">

        <!-- Donut -->
        <div class="col-md-4">
            <div class="card-box chart-card text-center h-100">
                <h5>توزيع الإجابات</h5>
                <canvas id="donutChart"></canvas>
            </div>
        </div>

        <!-- Progress Timeline -->
        <div class="col-md-4">
            <div class="card-box chart-card text-center h-100">
                <h5>تطور أداء الطالب</h5>
                <canvas id="progressChart"></canvas>
            </div>
        </div>

        <!-- Sections -->
        <div class="col-md-4">
            <div class="card-box h-100">
                <h5>الأداء حسب المحاور</h5>

                @foreach (var s in Model.SectionsPerformance)
                {
                    <div class="mb-3">

                        <!-- العنوان + النسبة -->
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <small>@s.SectionTitle</small>
                            <small class="fw-bold">@s.Accuracy %</small>
                        </div>

                        <!-- البار -->
                        <div class="progress">
                            <div class="progress-bar bg-success"
                                 style="width:@s.Accuracy%">
                            </div>
                        </div>

                    </div>
                }


            </div>
        </div>

    </div>


    <!-- فصل الصفحة -->



    @if (Model.SectionIndicatorCards.Any())
    {
        <div class="page-break"></div>
        <br/>
        <br/>
        <hr/>


        <div class="mb-4">
            <h5 class="mb-3 text-center">تحليل المؤشرات داخل كل محور</h5>

            @foreach (var sectionCard in Model.SectionIndicatorCards)
            {
                <div class="section-indicator-card">
                    <div class="section-indicator-head">
                        <span>@sectionCard.SectionTitle</span>
                        <span>@sectionCard.Accuracy%</span>
                    </div>

                    <div class="section-indicator-body">
                        <div class="indicator-summary">
                            <span>إجمالي @sectionCard.TotalQuestions</span>
                            <span>صحيح @sectionCard.CorrectCount</span>
                            <span>خطأ @sectionCard.WrongCount</span>
                            <span>متروك @sectionCard.SkippedCount</span>
                        </div>

                        <table class="indicators-print-table">
                            <thead>
                                <tr>
                                    <th>المؤشر</th>
                                    <th>عدد الأسئلة</th>
                                    <th>صحيح</th>
                                    <th>خطأ</th>
                                    <th>متروك</th>
                                    <th>نسبة النجاح</th>
                                    <th>الصعوبة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var indicator in sectionCard.Indicators)
                                {
                                    <tr>
                                        <td>@indicator.LessonTitle</td>
                                        <td>@indicator.QuestionCount</td>
                                        <td>@indicator.CorrectCount</td>
                                        <td>@indicator.WrongCount</td>
                                        <td>@indicator.SkippedCount</td>
                                        <td>@indicator.Accuracy%</td>
                                        <td>@indicator.HardnessIndex%</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Recommendations -->
    <!-- فصل الصفحة -->
    <div class="page-break"></div>



    <div class="row">

        <!-- Recommendations -->
        <div class="col-md-6">
            <div class="card-box h-100">

                <h5 class="mb-3">💡 توصيات مخصصة</h5>

                @if (Model.ParentReport.HomeRecommendations.Any())
                {
                    foreach (var item in Model.ParentReport.HomeRecommendations)
                    {
                        <div class="rec-item d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-light text-dark">💡</span>
                            <span>@item</span>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted">لا توجد توصيات حالياً</div>
                }

            </div>
        </div>

        <!-- Parent Report -->
        <div class="col-md-6">
            <div class="card-box h-100">

                <h5 class="mb-3">👨‍👩‍👦 تقرير ولي الأمر</h5>

                <div class="mb-2">
                    <strong>المستوى:</strong> @Model.ParentReport.Level
                </div>

                <div class="mb-2">
                    <strong>الالتزام:</strong> @Model.ParentReport.Commitment
                </div>

                <div class="mb-2">
                    <strong>التقدم:</strong> @Model.ParentReport.Progress
                </div>

                <!-- ✅ الجديد -->
                <div class="alert alert-light mt-3">
                    @Model.ParentReport.ParentInsight
                </div>

            </div>
        </div>

    </div>



</div>



@section Scripts {

    <script>
        // =========================
        // Circle
        // =========================
        const percent = @Model.ScorePercentage;
        const circle = document.getElementById("circleFill");
        if (circle) {
            circle.style.transform = `rotate(${percent * 3.6}deg)`;
        }
    </script>

    <script>
        // =========================
        // Charts Initialization (معدل)
        // =========================
        let donutChart, progressChart, levelChart;

        function initCharts() {

            window.__chartsReady = false;

            if (donutChart) donutChart.destroy();
            if (progressChart) progressChart.destroy();
            if (levelChart) levelChart.destroy();

            // =========================
            // Level Chart
            // =========================
            const levelCtx = document.getElementById("levelChart");

            if (levelCtx) {
                levelChart = new Chart(levelCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ["التقدم", "المتبقي"],
                        datasets: [{
                            data: [
                                @Model.ScorePercentage,
                                @(100 - Model.ScorePercentage)
                            ],
                            backgroundColor: ["#339999", "#da784d"],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        cutout: "70%",
                        plugins: { legend: { display: false } },
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            }

            // =========================
            // Donut
            // =========================
            const donutCtx = document.getElementById("donutChart");

            if (donutCtx) {
                donutChart = new Chart(donutCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ["صحيح", "خطأ", "متروك"],
                        datasets: [{
                            data: [
                                @Model.CorrectAnswers,
                                @Model.WrongAnswers,
                                @Model.SkippedAnswers
                            ],
                            backgroundColor: ["#339999", "#da784d", "#474444"]
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            }

            // =========================
            // Line
            // =========================
            const progressData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProgressTimeline));

            const labels = progressData.map(x => x.HomeworkTitle);
            const scores = progressData.map(x => x.Score);

            const progressCtx = document.getElementById("progressChart");

            if (progressCtx) {
                progressChart = new Chart(progressCtx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: "تطور الأداء",
                            data: scores,
                            borderColor: "#176669",
                            backgroundColor: "rgba(23,102,105,0.1)",
                            fill: true,
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            }

            // ✅ نعتبر الشارتات جاهزة بعد وقت بسيط
            setTimeout(() => {
                window.__chartsReady = true;
            }, 800);
        }
    </script>

    <script>
        // =========================
        // PRINT FUNCTION (محسن)
        // =========================

        async function printReport() {


                    // ✅ غير اسم الملف هنا (الأهم)
        const studentName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StudentName));        const date = new Date().toISOString().slice(0,10);

        document.title = `تقرير أداء ${studentName} - في الواجب ${date}`;
            // تأكد من تحديث الشارت قبل التحويل
            if (donutChart) donutChart.update();
            if (progressChart) progressChart.update();

            const canvases = document.querySelectorAll("canvas");
            const replaced = [];

            canvases.forEach(canvas => {

                const img = document.createElement("img");
                img.src = canvas.toDataURL("image/png");
                img.className = "print-chart-img";

                img.style.width = "100%";
                img.style.height = "220px";
                img.style.objectFit = "contain";

                replaced.push({ canvas, img });

                canvas.style.display = "none";
                canvas.parentNode.appendChild(img);
            });

            await new Promise(r => setTimeout(r, 300));

            window.print();

            // رجوع الصفحة كما كانت
            setTimeout(() => {
                replaced.forEach(item => {
                    item.canvas.style.display = "block";
                    if (item.img.parentNode) {
                        item.img.parentNode.removeChild(item.img);
                    }
                });
            }, 500);
        }
    </script>


    <script>
        // =========================
        // LOAD (معدل بدون setTimeout عشوائي)
        // =========================

        window.onload = function () {

            initCharts();

            const waitCharts = setInterval(() => {

                if (window.__chartsReady) {
                    clearInterval(waitCharts);
                    printReport();
                }

            }, 200);
        };
    </script>


  

}
