@model QdratNew.ViewModels.Homework.HomeworkArchiveHistoryViewModel

@{
    ViewData["Title"] = "هيستوري الأرشيف";
}

<div class="container-fluid py-4" dir="rtl">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h2 class="h4 mb-1">هيستوري الأرشيف</h2>
            <div class="text-muted">@Model.HomeworkTitle - @Model.BatchName</div>
        </div>
        <div class="d-flex gap-2">
            @if (User.IsInRole("Owner") || User.IsInRole("Developer"))
            {
                <a asp-action="ManageArchiveAccess" asp-route-homeworkSetId="@Model.HomeworkSetId" class="btn btn-outline-secondary">
                    الموافقات
                </a>
            }
            <a asp-action="Index" asp-route-showArchived="true" class="btn btn-outline-primary">
                رجوع للأرشيف
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>التاريخ</th>
                        <th>المستخدم</th>
                        <th>العملية</th>
                        <th>التفاصيل</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                لا توجد أحداث مسجلة لهذا الواجب المؤرشف حتى الآن.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.Timestamp.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>@item.AdminName</td>
                                <td>@item.ActionType</td>
                                <td>@item.Description</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
