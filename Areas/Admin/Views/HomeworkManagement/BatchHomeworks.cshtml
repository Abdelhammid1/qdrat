@model QdratNew.ViewModels.Homework.HomeworkBatchDetailsPageVM
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using QdratNew.Security.AdminPermissions
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = $"واجبات دفعة {Model.BatchName}";
    var jsonOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var studentsJson             = JsonSerializer.Serialize(Model.Students, jsonOpts);
    var curriculumInstructorsJson = JsonSerializer.Serialize(Model.CurriculumInstructors, jsonOpts);
    var isArchived = ViewBag.IsArchived as bool? ?? false;
    var canViewDetails = (await AuthorizationService.AuthorizeAsync(User, AdminPermissionPolicies.Homework_Details)).Succeeded;
    var canViewBatchReport = (await AuthorizationService.AuthorizeAsync(User, AdminPermissionPolicies.Homework_Reports)).Succeeded;
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <style>
        :root {
            --ink:#0D1B2A;--ink-2:#2C3E50;--ink-3:#5A6A7A;--ink-4:#8FA0B0;--ink-5:#C8D5E0;
            --canvas:#F3F6FA;--surface:#FFFFFF;--surface-2:#F8FAFC;--surface-3:#EEF2F7;--border:#DDE4EC;
            --blue:#1B5EAE;--blue-2:#2471D0;--blue-bg:#E8F1FB;--blue-dark:#103E7A;
            --emerald:#0D7A5B;--emerald-bg:#E4F5EE;
            --amber:#985D09;--amber-bg:#FDF0D8;
            --rose:#BF1030;--rose-bg:#FDEAEE;
            --violet:#5535B5;--violet-bg:#EDE8F9;
            --r-sm:6px;--r-md:10px;--r-lg:14px;--r-xl:20px;
            --sh-xs:0 1px 3px rgba(13,27,42,.06);--sh-sm:0 2px 8px rgba(13,27,42,.08);--sh-md:0 4px 18px rgba(13,27,42,.10);
            --ease:cubic-bezier(.25,.46,.45,.94);
        }

        /* ─── Page ─── */
        .bh-page { background:var(--canvas);min-height:100vh;padding:32px 28px 64px;direction:rtl;font-family:'Cairo',sans-serif;color:var(--ink-2); }

        /* ─── Topbar ─── */
        .bh-topbar { display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;margin-bottom:28px; }
        .bh-back-btn { display:inline-flex;align-items:center;gap:7px;padding:9px 18px;border:1px solid var(--border);border-radius:var(--r-md);background:var(--surface);color:var(--ink-3);font-size:14px;font-weight:700;text-decoration:none;transition:all .15s; }
        .bh-back-btn:hover { background:var(--blue-bg);border-color:#b6d3f4;color:var(--blue); }
        .bh-brand { display:flex;align-items:center;gap:13px; }
        .bh-brand-icon { width:46px;height:46px;background:var(--blue);border-radius:var(--r-lg);display:flex;align-items:center;justify-content:center;color:#fff;font-size:20px;box-shadow:0 4px 14px rgba(27,94,174,.28); }
        .bh-brand-title { font-size:20px;font-weight:700;color:var(--ink);line-height:1.15; }
        .bh-brand-sub   { font-size:14px;color:var(--ink-4);margin-top:2px; }

        /* ─── KPI grid ─── */
        .bh-kpis { display:grid;grid-template-columns:repeat(5,1fr);gap:13px;margin-bottom:24px; }
        @@media(max-width:1100px){ .bh-kpis{grid-template-columns:repeat(3,1fr);} }
        @@media(max-width:700px) { .bh-kpis{grid-template-columns:repeat(2,1fr);} }

        .kpi-card { background:var(--surface);border:1px solid var(--border);border-radius:var(--r-xl);padding:18px 19px;display:flex;align-items:center;gap:13px;box-shadow:var(--sh-xs);transition:transform .2s var(--ease),box-shadow .2s;position:relative;overflow:hidden; }
        .kpi-card::after { content:'';position:absolute;top:0;right:0;width:4px;height:100%;border-radius:0 var(--r-xl) var(--r-xl) 0; }
        .kpi-card:hover { transform:translateY(-3px);box-shadow:var(--sh-sm); }
        .kpi-card.kpi-clickable { cursor:pointer; }
        .kpi-card.kpi-clickable:hover { border-color:#b6d3f4; }
        .kpi-blue::after   { background:var(--blue); }
        .kpi-emerald::after{ background:var(--emerald); }
        .kpi-amber::after  { background:var(--amber); }
        .kpi-rose::after   { background:var(--rose); }
        .kpi-violet::after { background:var(--violet); }
        .kpi-ico { width:42px;height:42px;border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0; }
        .ico-blue    { background:var(--blue-bg);   color:var(--blue); }
        .ico-emerald { background:var(--emerald-bg);color:var(--emerald); }
        .ico-amber   { background:var(--amber-bg);  color:var(--amber); }
        .ico-rose    { background:var(--rose-bg);   color:var(--rose); }
        .ico-violet  { background:var(--violet-bg); color:var(--violet); }
        .kpi-label { font-size:12px;font-weight:700;color:var(--ink-4);letter-spacing:.04em;text-transform:uppercase;margin-bottom:3px; }
        .kpi-val   { font-size:22px;font-weight:700;color:var(--ink);line-height:1; }
        .kpi-hint  { font-size:11px;color:var(--ink-4);margin-top:4px; }

        /* ─── Section card ─── */
        .hw-section-card { background:var(--surface);border:1px solid var(--border);border-radius:var(--r-xl);box-shadow:var(--sh-sm); }
        .hw-section-topbar { display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid var(--surface-3);flex-wrap:wrap; }
        .section-title { display:flex;align-items:center;gap:8px;font-size:18px;font-weight:800;color:var(--ink);margin-left:10px; }
        .section-title i { color:var(--blue); }
        .hw-search-wrap { position:relative;flex:1;min-width:220px;max-width:380px; }
        .hw-search-wrap i { position:absolute;right:11px;top:50%;transform:translateY(-50%);color:var(--ink-4);font-size:14px;pointer-events:none; }
        .hw-search-wrap input { width:100%;padding:7px 32px 7px 12px;border:1px solid var(--border);border-radius:var(--r-md);font-size:14px;background:var(--surface-2);color:var(--ink);transition:border-color .15s,box-shadow .15s; }
        .hw-search-wrap input:focus { outline:none;border-color:var(--blue-2);box-shadow:0 0 0 3px rgba(36,113,208,.1);background:var(--surface); }
        .total-badge { margin-right:auto;font-size:13px;color:var(--ink-4); }
        .total-badge strong { color:var(--blue);font-weight:700; }

        /* ─── Homework cards grid ─── */
        .hw-cards-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:16px;padding:18px; }
        @@media(max-width:1200px){ .hw-cards-grid{grid-template-columns:repeat(2,1fr);} }
        @@media(max-width:768px) { .hw-cards-grid{grid-template-columns:1fr;padding:14px;} }

        .hw-card { background:var(--surface);border:1px solid var(--border);border-radius:var(--r-xl);box-shadow:var(--sh-xs);transition:transform .18s var(--ease),box-shadow .18s,border-color .18s;overflow:hidden;position:relative; }
        .hw-card::before { content:'';position:absolute;top:0;right:0;width:5px;height:100%;background:var(--blue); }
        .hw-card:hover { transform:translateY(-4px);box-shadow:var(--sh-md);border-color:#B6D3F4; }
        .hw-card.is-critical::before { background:var(--rose); }
        .hw-card.is-late::before     { background:var(--amber); }
        .hw-card.is-closed { opacity:.8; }
        .hw-card-body { padding:18px 18px 16px; }
        .hw-card-head { margin-bottom:14px; }
        .hw-card-title-row { display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:6px; }
        .hw-card-icon { width:36px;height:36px;border-radius:var(--r-md);background:var(--blue-bg);color:var(--blue);display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0; }
        .hw-card-title { font-size:15px;font-weight:800;color:var(--ink);line-height:1.35; }
        .hw-card-date  { font-size:12px;color:var(--ink-4);margin-top:3px; }
        .status-pill { display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:30px;font-size:11px;font-weight:700;white-space:nowrap; }
        .pill-closed { background:var(--surface-3);color:var(--ink-4); }
        .pill-open   { background:var(--emerald-bg);color:var(--emerald); }
        .hw-stats-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-bottom:12px; }
        .hw-stat { background:var(--surface-2);border:1px solid var(--surface-3);border-radius:var(--r-md);padding:9px 6px;text-align:center; }
        .stat-val   { display:block;font-size:18px;font-weight:800;color:var(--ink);line-height:1.1; }
        .stat-label { display:block;font-size:11px;color:var(--ink-4);margin-top:2px; }
        .text-emerald { color:var(--emerald)!important; }
        .text-rose    { color:var(--rose)!important; }
        .hw-progress-wrap { margin-bottom:12px; }
        .hw-progress-meta { display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--ink-4);margin-bottom:5px; }
        .hw-progress-meta strong { color:var(--ink);font-size:13px; }
        .hw-progress { width:100%;height:8px;border-radius:30px;background:var(--surface-3);overflow:hidden; }
        .hw-progress-bar { height:100%;border-radius:30px;transition:width .3s ease; }
        .hw-progress-bar.low  { background:var(--rose); }
        .hw-progress-bar.mid  { background:var(--amber); }
        .hw-progress-bar.high { background:var(--emerald); }
        .hw-alerts { margin-bottom:14px;display:flex;flex-direction:column;gap:6px; }
        .hw-alert-row { display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:var(--r-md);font-size:13px;font-weight:700; }
        .hw-alert-amber { background:var(--amber-bg);color:var(--amber); }
        .hw-alert-rose  { background:var(--rose-bg); color:var(--rose); }
        .contact-badge { margin-right:auto;display:inline-flex;align-items:center;gap:4px;padding:3px 8px;border-radius:30px;font-size:11px;font-weight:700;background:#fff3;border:1px solid currentColor;opacity:.85; }
        .hw-card-actions { display:flex;gap:8px;flex-wrap:wrap; }
        .hw-action-btn { flex:1;display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:9px 10px;border-radius:var(--r-md);font-size:13px;font-weight:700;text-decoration:none;transition:all .15s;border:1px solid var(--border); }
        .btn-details  { background:var(--blue);color:#fff;border-color:var(--blue);box-shadow:0 2px 8px rgba(27,94,174,.18); }
        .btn-details:hover { background:var(--blue-dark);color:#fff; }
        .btn-students { background:var(--blue-bg);color:var(--blue);border-color:#b6d3f4; }
        .btn-students:hover { background:var(--blue);color:#fff; }
        .hw-empty { text-align:center;padding:56px 16px;color:var(--ink-4); }
        .hw-empty i { font-size:22px;display:block;margin-bottom:12px;color:var(--ink-5); }
        .hw-empty-title { font-size:18px;font-weight:600;color:var(--ink-3); }
        .hw-empty-sub   { font-size:14px;margin-top:4px; }

        /* ─── Offcanvas students list ─── */
        .students-offcanvas .offcanvas-header {
            background: var(--blue);
            color: #fff;
            padding: 18px 20px;
            direction: rtl;
        }
        .students-offcanvas .offcanvas-header .btn-close { filter:invert(1); }
        .students-offcanvas .offcanvas-body { padding:0;direction:rtl;background:var(--canvas); }
        .students-offcanvas { width: 480px !important; }

        .student-search-bar { padding:14px 16px;background:var(--surface);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:10; }
        .student-search-bar input { width:100%;padding:8px 36px 8px 12px;border:1px solid var(--border);border-radius:var(--r-md);font-size:14px;background:var(--surface-2); }
        .student-search-bar .s-icon { position:absolute;right:27px;top:50%;transform:translateY(-50%);color:var(--ink-4);font-size:15px;pointer-events:none; }

        .student-list { padding:12px; }

        .student-row {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            padding: 13px 14px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: box-shadow .15s, border-color .15s;
        }
        .student-row:hover { box-shadow:var(--sh-sm);border-color:#b6d3f4; }

        .student-avatar {
            width: 40px; height: 40px; border-radius: 50%;
            background: var(--blue-bg); color: var(--blue);
            display: flex; align-items: center; justify-content: center;
            font-size: 17px; font-weight: 800; flex-shrink: 0;
        }
        .student-info { flex: 1; min-width: 0; }
        .student-name { font-size:14px;font-weight:800;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
        .student-meta { display:flex;gap:10px;margin-top:4px;flex-wrap:wrap; }
        .student-meta-badge { display:inline-flex;align-items:center;gap:3px;font-size:11px;font-weight:700;padding:2px 7px;border-radius:20px; }
        .meta-att  { background:var(--emerald-bg);color:var(--emerald); }
        .meta-hw   { background:var(--blue-bg);color:var(--blue); }
        .meta-phone{ color:var(--ink-4); }

        .student-icon-btns { display:flex;gap:6px; }
        .icon-btn {
            width: 34px; height: 34px; border-radius: var(--r-md);
            border: 1px solid var(--border);
            background: var(--surface-2);
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; font-size: 15px;
            transition: all .15s;
            color: var(--ink-3);
        }
        .icon-btn:hover { transform: translateY(-2px); }
        .icon-btn.btn-att  { border-color:#b6d3f4;background:var(--blue-bg);   color:var(--blue); }
        .icon-btn.btn-att:hover  { background:var(--blue);color:#fff;box-shadow:0 4px 12px rgba(27,94,174,.25); }
        .icon-btn.btn-hw   { border-color:#bfe5d6;background:var(--emerald-bg);color:var(--emerald); }
        .icon-btn.btn-hw:hover   { background:var(--emerald);color:#fff;box-shadow:0 4px 12px rgba(13,122,91,.25); }

        /* ─── Modal shared ─── */
        .ux-modal .modal-dialog { max-width: 680px; }
        .ux-modal .modal-content { border:none;border-radius:var(--r-xl);overflow:hidden;box-shadow:0 20px 60px rgba(13,27,42,.18); }
        .ux-modal .modal-header {
            padding: 20px 24px;
            border: none;
            background: linear-gradient(135deg,var(--blue-dark) 0%,var(--blue-2) 100%);
            color: #fff;
            direction: rtl;
        }
        .ux-modal .modal-title { font-size:17px;font-weight:800; }
        .ux-modal .modal-header .btn-close { filter:invert(1);opacity:.8; }
        .ux-modal .modal-body { padding:24px;direction:rtl;background:var(--canvas);max-height:72vh;overflow-y:auto; }
        .ux-modal .modal-footer { border:none;background:var(--surface);padding:16px 24px;direction:rtl; }

        .modal-student-header {
            display: flex; align-items: center; gap: 14px;
            background: var(--surface); border: 1px solid var(--border);
            border-radius: var(--r-lg); padding: 14px 16px; margin-bottom: 20px;
        }
        .modal-student-avatar {
            width: 48px; height: 48px; border-radius: 50%;
            background: var(--blue-bg); color: var(--blue);
            display: flex; align-items: center; justify-content: center;
            font-size: 20px; font-weight: 800; flex-shrink: 0;
        }
        .modal-student-name { font-size:16px;font-weight:800;color:var(--ink); }
        .modal-student-sub  { font-size:13px;color:var(--ink-4);margin-top:2px; }
        .modal-stat-pills { display:flex;gap:8px;margin-top:6px;flex-wrap:wrap; }
        .modal-stat-pill { display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:30px;font-size:12px;font-weight:700; }
        .pill-blue    { background:var(--blue-bg);color:var(--blue); }
        .pill-emerald { background:var(--emerald-bg);color:var(--emerald); }
        .pill-amber   { background:var(--amber-bg);color:var(--amber); }

        /* ─── Attendance Calendar ─── */
        .att-month-group { margin-bottom: 22px; }
        .att-month-title {
            font-size: 13px; font-weight: 800; color: var(--ink-4);
            letter-spacing: .05em; text-transform: uppercase;
            padding-bottom: 8px; margin-bottom: 10px;
            border-bottom: 2px solid var(--border);
            display: flex; align-items: center; gap: 6px;
        }
        .att-month-title i { color:var(--blue); }

        .att-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
            gap: 8px;
        }

        .att-cell {
            border-radius: var(--r-lg);
            padding: 12px 10px;
            text-align: center;
            border: 1px solid transparent;
            transition: transform .15s, box-shadow .15s;
        }
        .att-cell:hover { transform: translateY(-2px); box-shadow: var(--sh-sm); }

        .att-present { background:#EDFAF3;border-color:#A7E0C2;color:#0D7A5B; }
        .att-late    { background:var(--amber-bg);border-color:#F4D493;color:var(--amber); }
        .att-absent  { background:var(--rose-bg);border-color:#F5BBC4;color:var(--rose); }
        .att-none    { background:var(--surface-3);border-color:var(--border);color:var(--ink-4); }

        .att-date-num { font-size:20px;font-weight:900;line-height:1;margin-bottom:4px; }
        .att-date-str { font-size:10px;font-weight:700;opacity:.7;margin-bottom:8px; }
        .att-title    { font-size:11px;font-weight:700;line-height:1.35;margin-bottom:8px;
                        white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
        .att-badge {
            display: inline-flex; align-items: center; gap: 3px;
            padding: 3px 8px; border-radius: 20px; font-size: 11px; font-weight: 800;
            background: rgba(255,255,255,.6);
        }

        /* ─── Homework Timeline ─── */
        .hw-timeline { display:flex;flex-direction:column;gap:10px; }

        .hw-timeline-item {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            padding: 14px 16px;
            display: flex;
            align-items: flex-start;
            gap: 14px;
            transition: box-shadow .15s, border-color .15s;
            position: relative;
        }
        .hw-timeline-item:hover { box-shadow: var(--sh-sm); border-color:#B6D3F4; }
        .hw-timeline-item.solved   { border-right: 4px solid var(--emerald); }
        .hw-timeline-item.unsolved { border-right: 4px solid var(--rose); }

        .hw-tl-date {
            flex-shrink: 0;
            background: var(--surface-2);
            border: 1px solid var(--border);
            border-radius: var(--r-md);
            padding: 8px 10px;
            text-align: center;
            min-width: 58px;
        }
        .hw-tl-month { font-size:10px;font-weight:800;color:var(--ink-4);text-transform:uppercase; }
        .hw-tl-day   { font-size:22px;font-weight:900;color:var(--ink);line-height:1; }

        .hw-tl-body { flex:1;min-width:0; }
        .hw-tl-title { font-size:14px;font-weight:800;color:var(--ink);margin-bottom:8px;
                       white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }

        .hw-tl-status { display:flex;align-items:center;gap:8px;flex-wrap:wrap; }
        .hw-tl-badge {
            display:inline-flex;align-items:center;gap:4px;
            padding:4px 10px;border-radius:30px;font-size:12px;font-weight:800;
        }
        .tl-solved   { background:var(--emerald-bg);color:var(--emerald); }
        .tl-unsolved { background:var(--rose-bg);   color:var(--rose); }
        .tl-score    { background:var(--blue-bg);    color:var(--blue); }
        .tl-student  { background:var(--amber-bg);   color:var(--amber); }
        .tl-parent   { background:var(--violet-bg);  color:var(--violet); }
        .tl-no-contact { background:var(--surface-3);color:var(--ink-4); }

        .hw-tl-icon {
            flex-shrink: 0;
            width: 36px; height: 36px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 16px;
        }
        .tl-icon-solved   { background:var(--emerald-bg);color:var(--emerald); }
        .tl-icon-unsolved { background:var(--rose-bg);color:var(--rose); }

        /* ─── Homework Curriculum Group ─── */
        .hw-curriculum-group { margin-bottom: 20px; }
        .hw-curriculum-header {
            display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;
            padding: 10px 14px; margin-bottom: 12px;
            background: var(--blue-bg); border: 1px solid #b6d3f4;
            border-radius: var(--r-lg);
        }
        .hw-curriculum-label {
            display: flex; align-items: center; gap: 8px;
            font-size: 14px; font-weight: 800; color: var(--blue);
        }
        .hw-curriculum-label i { font-size: 16px; }
        .hw-curriculum-instructor {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 4px 12px; border-radius: 20px;
            font-size: 12px; font-weight: 700;
            background: rgba(27,94,174,.12); color: var(--blue-dark);
            border: 1px solid #b6d3f4;
        }

        @@media(max-width:768px){ .bh-page{padding:22px 14px 48px;} .ux-modal .modal-dialog{max-width:100%;margin:.5rem;} .students-offcanvas{width:100%!important;} }
    </style>
}

@{
    var totalAssignedAll  = Model.Homeworks.Sum(h => h.TotalAssigned);
    var totalSubmittedAll = Model.Homeworks.Sum(h => h.SubmittedCount);
    var overallPct        = totalAssignedAll > 0 ? (int)Math.Round(totalSubmittedAll * 100.0 / totalAssignedAll) : 0;
    var totalCritical     = Model.Homeworks.Sum(h => h.Critical3daysCount);
    var totalLate24       = Model.Homeworks.Sum(h => h.Late24hCount);
}

<div class="bh-page">

    @* Topbar *@
    <div class="bh-topbar">
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
            <a asp-area="Admin" asp-controller="HomeworkManagement" asp-action="Index" class="bh-back-btn">
                <i class="bi bi-arrow-right"></i> العودة للدفعات
            </a>
            @if (canViewBatchReport)
            {
                <a asp-area="Admin" asp-controller="HomeworkManagement" asp-action="BatchPerformanceReport"
                   asp-route-batchId="@Model.BatchId"
                   class="bh-back-btn" style="background:var(--blue);color:#fff;border-color:var(--blue);">
                    <i class="bi bi-graph-up-arrow"></i> تقرير أداء الدفعة
                </a>
            }
        </div>
        <div class="bh-brand">
            <div class="bh-brand-icon"><i class="bi bi-journal-text"></i></div>
            <div>
                <div class="bh-brand-title">@Model.BatchName</div>
                <div class="bh-brand-sub">@Model.CourseTitle</div>
            </div>
        </div>
    </div>

    @* KPI *@
    <div class="bh-kpis">
        <div class="kpi-card kpi-violet kpi-clickable"
             data-bs-toggle="offcanvas" data-bs-target="#studentsOffcanvas"
             role="button" title="عرض قائمة الطلاب">
            <div class="kpi-ico ico-violet"><i class="bi bi-people-fill"></i></div>
            <div>
                <div class="kpi-label">طلاب الدفعة</div>
                <div class="kpi-val">@Model.TotalStudents</div>
                <div class="kpi-hint">اضغط لعرض القائمة</div>
            </div>
        </div>
        <div class="kpi-card kpi-blue">
            <div class="kpi-ico ico-blue"><i class="bi bi-clipboard2-fill"></i></div>
            <div>
                <div class="kpi-label">إجمالي الواجبات</div>
                <div class="kpi-val">@Model.Homeworks.Count</div>
            </div>
        </div>
        <div class="kpi-card kpi-emerald">
            <div class="kpi-ico ico-emerald"><i class="bi bi-check2-circle"></i></div>
            <div>
                <div class="kpi-label">نسبة الحل</div>
                <div class="kpi-val">@overallPct%</div>
            </div>
        </div>
        <div class="kpi-card kpi-amber">
            <div class="kpi-ico ico-amber"><i class="bi bi-clock-history"></i></div>
            <div>
                <div class="kpi-label">متأخر 24 ساعة</div>
                <div class="kpi-val">@totalLate24</div>
            </div>
        </div>
        <div class="kpi-card kpi-rose">
            <div class="kpi-ico ico-rose"><i class="bi bi-exclamation-triangle-fill"></i></div>
            <div>
                <div class="kpi-label">حالات حرجة</div>
                <div class="kpi-val">@totalCritical</div>
            </div>
        </div>
    </div>

    @* Homework Cards *@
    <div class="hw-section-card">
        <div class="hw-section-topbar">
            <div class="section-title"><i class="bi bi-journals"></i> واجبات الدفعة</div>
            <div class="hw-search-wrap">
                <i class="bi bi-search"></i>
                <input type="text" id="hwSearch" placeholder="ابحث في عنوان الواجب..." />
            </div>
            <div class="total-badge">إجمالي: <strong>@Model.Homeworks.Count</strong> واجب</div>
        </div>

        @if (!Model.Homeworks.Any())
        {
            <div class="hw-empty">
                <i class="bi bi-inbox"></i>
                <div class="hw-empty-title">لا توجد واجبات لهذه الدفعة</div>
                <div class="hw-empty-sub">لم يتم إرسال أي واجبات لهذه الدفعة حتى الآن</div>
            </div>
        }
        else
        {
            <div class="hw-cards-grid" id="hwCardsGrid">
                @foreach (var hw in Model.Homeworks)
                {
                    var cardMod  = hw.Critical3daysCount > 0 ? "is-critical" : hw.Late24hCount > 0 ? "is-late" : "";
                    var barClass = hw.SolvedPercentage >= 70 ? "high" : hw.SolvedPercentage >= 40 ? "mid" : "low";
                    var notSub   = hw.TotalAssigned - hw.SubmittedCount;

                    <div class="hw-card @cardMod @(hw.IsClosed ? "is-closed" : "")" data-search="@hw.Title.ToLower()">
                        <div class="hw-card-body">
                            <div class="hw-card-head">
                                <div class="hw-card-title-row">
                                    <div style="display:flex;align-items:flex-start;gap:9px;flex:1">
                                        <div class="hw-card-icon"><i class="bi bi-file-earmark-text-fill"></i></div>
                                        <div>
                                            <div class="hw-card-title">@hw.Title</div>
                                            <div class="hw-card-date">
                                                <i class="bi bi-calendar3"></i> @hw.CreatedAt.ToString("yyyy/MM/dd")
                                                @if (hw.EndAt.HasValue)
                                                {
                                                    <span style="margin-right:8px;color:var(--amber)"><i class="bi bi-flag-fill"></i> حتى @hw.EndAt.Value.ToString("yyyy/MM/dd")</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    @if (hw.IsClosed) { <span class="status-pill pill-closed"><i class="bi bi-lock-fill"></i> مغلق</span> }
                                    else              { <span class="status-pill pill-open"><i class="bi bi-unlock-fill"></i> مفتوح</span> }
                                </div>
                            </div>
                            <div class="hw-stats-grid">
                                <div class="hw-stat"><span class="stat-val">@hw.TotalAssigned</span><span class="stat-label">الطلاب</span></div>
                                <div class="hw-stat"><span class="stat-val text-emerald">@hw.SubmittedCount</span><span class="stat-label">سلّموا</span></div>
                                <div class="hw-stat"><span class="stat-val text-rose">@notSub</span><span class="stat-label">لم يُسلّموا</span></div>
                            </div>
                            <div class="hw-progress-wrap">
                                <div class="hw-progress-meta"><span>نسبة الحل</span><strong>@hw.SolvedPercentage%</strong></div>
                                <div class="hw-progress"><div class="hw-progress-bar @barClass" style="width:@hw.SolvedPercentage%"></div></div>
                            </div>
                            @if (hw.Late24hCount > 0 || hw.Critical3daysCount > 0)
                            {
                                <div class="hw-alerts">
                                    @if (hw.Late24hCount > 0)
                                    { <div class="hw-alert-row hw-alert-amber"><i class="bi bi-clock-history"></i><span>@hw.Late24hCount طالب متأخر أكثر من 24 ساعة</span></div> }
                                    @if (hw.Critical3daysCount > 0)
                                    { <div class="hw-alert-row hw-alert-rose"><i class="bi bi-exclamation-triangle-fill"></i><span>@hw.Critical3daysCount طالب لم يحل منذ 3 أيام</span><span class="contact-badge"><i class="bi bi-telephone-fill"></i> تواصل مع ولي الأمر</span></div> }
                                </div>
                            }
                            <div class="hw-card-actions">
                                @if (canViewDetails)
                                {
                                    <a asp-area="Admin" asp-controller="HomeworkManagement" asp-action="Details" asp-route-id="@hw.HomeworkSetId" class="hw-action-btn btn-details"><i class="bi bi-eye-fill"></i> التفاصيل</a>
                                }
                                <a asp-area="Admin" asp-controller="HomeworkManagement" asp-action="StudentsReport" asp-route-homeworkSetId="@hw.HomeworkSetId" class="hw-action-btn btn-students"><i class="bi bi-people-fill"></i> الطلاب</a>
                                @if (isArchived)
                                {
                                    <a asp-area="Admin" asp-controller="HomeworkManagement" asp-action="ArchiveHistory" asp-route-homeworkSetId="@hw.HomeworkSetId" class="hw-action-btn btn-details"><i class="bi bi-clock-history"></i> الهيستوري</a>
                                    @if (User.IsInRole("Owner") || User.IsInRole("Developer"))
                                    {
                                        <a asp-area="Admin" asp-controller="HomeworkManagement" asp-action="ManageArchiveAccess" asp-route-homeworkSetId="@hw.HomeworkSetId" class="hw-action-btn btn-students"><i class="bi bi-shield-lock-fill"></i> الموافقات</a>
                                        <form asp-area="Admin" asp-controller="HomeworkManagement" asp-action="RestoreHomeworkSet" method="post" style="display:inline-flex; flex:1;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@hw.HomeworkSetId" />
                                            <button type="submit" class="hw-action-btn btn-details" onclick="return confirm('هل تريد استرجاع هذا الواجب من الأرشيف؟')">
                                                <i class="bi bi-arrow-counterclockwise"></i> استرجاع
                                            </button>
                                        </form>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

</div>

@* ══════════════════════════════════════════════════
   OFFCANVAS — قائمة الطلاب
   ══════════════════════════════════════════════════ *@
<div class="offcanvas offcanvas-end students-offcanvas" tabindex="-1" id="studentsOffcanvas"
     aria-labelledby="studentsOffcanvasLabel" data-bs-scroll="true">

    <div class="offcanvas-header">
        <div>
            <h5 class="offcanvas-title fw-800" id="studentsOffcanvasLabel" style="font-size:17px;font-weight:800">
                <i class="bi bi-people-fill me-2"></i> طلاب الدفعة
            </h5>
            <div style="font-size:13px;opacity:.8;margin-top:3px">@Model.BatchName — @Model.TotalStudents طالب</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

    <div class="offcanvas-body">

        <div class="student-search-bar" style="position:relative">
            <i class="s-icon bi bi-search"></i>
            <input type="text" id="studentSearch" placeholder="ابحث باسم الطالب..." style="padding-right:36px" />
        </div>

        <div class="student-list" id="studentList">
            @foreach (var s in Model.Students)
            {
                var attPct = s.TotalLectures > 0 ? (int)Math.Round(s.AttendedCount * 100.0 / s.TotalLectures) : 0;
                var hwPct  = s.TotalHomeworks > 0 ? (int)Math.Round(s.SolvedHomeworks * 100.0 / s.TotalHomeworks) : 0;
                var initial = s.FullName.Length > 0 ? s.FullName[0].ToString() : "ط";

                <div class="student-row" data-student-name="@s.FullName.ToLower()">
                    <div class="student-avatar">@initial</div>
                    <div class="student-info">
                        <div class="student-name">@s.FullName</div>
                        <div class="student-meta">
                            <span class="student-meta-badge meta-att">
                                <i class="bi bi-calendar2-check"></i> @s.AttendedCount/@s.TotalLectures حضور
                            </span>
                            <span class="student-meta-badge meta-hw">
                                <i class="bi bi-clipboard2-check"></i> @s.SolvedHomeworks/@s.TotalHomeworks واجب
                            </span>
                        </div>
                    </div>
                    <div class="student-icon-btns">
                        <button class="icon-btn btn-att"
                                data-student-id="@s.StudentId"
                                title="تقويم الحضور"
                                onclick="openAttModal(@s.StudentId)"
                                data-bs-toggle="tooltip" data-bs-placement="top">
                            <i class="bi bi-calendar2-week-fill"></i>
                        </button>
                        <button class="icon-btn btn-hw"
                                data-student-id="@s.StudentId"
                                title="سجل الواجبات"
                                onclick="openHwModal(@s.StudentId)"
                                data-bs-toggle="tooltip" data-bs-placement="top">
                            <i class="bi bi-clipboard2-data-fill"></i>
                        </button>
                    </div>
                </div>
            }
        </div>

    </div>
</div>

@* ══════════════════════════════════════════════════
   MODAL 1 — تقويم الحضور
   ══════════════════════════════════════════════════ *@
<div class="modal fade ux-modal" id="attendanceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-calendar2-week-fill me-2"></i>
                    تقويم الحضور
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="attendanceModalBody">
                <!-- populated by JS -->
            </div>

            <div class="modal-footer">
                <div id="attendanceModalSummary" style="font-size:13px;color:var(--ink-4);margin-left:auto"></div>
                <button type="button" class="btn btn-sm" data-bs-dismiss="modal"
                        style="background:var(--surface-3);color:var(--ink-3);border:none;border-radius:var(--r-md);padding:7px 16px;font-weight:700">
                    إغلاق
                </button>
            </div>

        </div>
    </div>
</div>

@* ══════════════════════════════════════════════════
   MODAL 2 — سجل الواجبات
   ══════════════════════════════════════════════════ *@
<div class="modal fade ux-modal" id="homeworkModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-clipboard2-data-fill me-2"></i>
                    سجل الواجبات
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="homeworkModalBody">
                <!-- populated by JS -->
            </div>

            <div class="modal-footer">
                <div id="homeworkModalSummary" style="font-size:13px;color:var(--ink-4);margin-left:auto"></div>
                <button type="button" class="btn btn-sm" data-bs-dismiss="modal"
                        style="background:var(--surface-3);color:var(--ink-3);border:none;border-radius:var(--r-md);padding:7px 16px;font-weight:700">
                    إغلاق
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
    // ── بيانات الطلاب والمناهج مضمّنة في الصفحة ────────────────────
    const studentsData           = @Html.Raw(studentsJson);
    const curriculumInstructors  = @Html.Raw(curriculumInstructorsJson);

    document.addEventListener("DOMContentLoaded", function () {

        // تهيئة tooltips
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
            new bootstrap.Tooltip(el, { trigger: 'hover focus' });
        });

        // بحث في واجبات
        const hwSearchInput = document.getElementById("hwSearch");
        const hwCards = Array.from(document.querySelectorAll(".hw-card"));
        if (hwSearchInput) {
            hwSearchInput.addEventListener("input", function () {
                const val = this.value.toLowerCase().trim();
                hwCards.forEach(c => { c.style.display = (c.dataset.search || "").includes(val) ? "" : "none"; });
            });
        }

        // بحث في الطلاب
        const studentSearchInput = document.getElementById("studentSearch");
        const studentRows = Array.from(document.querySelectorAll(".student-row"));
        if (studentSearchInput) {
            studentSearchInput.addEventListener("input", function () {
                const val = this.value.toLowerCase().trim();
                studentRows.forEach(r => { r.style.display = (r.dataset.studentName || "").includes(val) ? "" : "none"; });
            });
        }
    });

    // ── helpers ──────────────────────────────────────────────────────
    function findStudent(id) {
        return studentsData.find(s => s.studentId === id);
    }

    function initials(name) {
        if (!name) return "ط";
        const parts = name.trim().split(" ");
        return parts.length >= 2
            ? parts[0][0] + parts[1][0]
            : parts[0][0];
    }

    // ═══════════════════════════════════════════════════════
    // MODAL 1 — تقويم الحضور
    // ═══════════════════════════════════════════════════════
    function openAttModal(studentId) {
        const s = findStudent(studentId);
        if (!s) return;

        const attPct = s.totalLectures > 0
            ? Math.round(s.attendedCount * 100 / s.totalLectures) : 0;

        // ── header ──
        const body = document.getElementById("attendanceModalBody");
        body.innerHTML = `
          <div class="modal-student-header">
            <div class="modal-student-avatar">${initials(s.fullName)}</div>
            <div>
              <div class="modal-student-name">${s.fullName}</div>
              <div class="modal-stat-pills">
                <span class="modal-stat-pill pill-blue">
                  <i class="bi bi-calendar2-check"></i> ${s.attendedCount} / ${s.totalLectures} محاضرة
                </span>
                <span class="modal-stat-pill ${attPct >= 75 ? 'pill-emerald' : attPct >= 50 ? 'pill-amber' : 'pill-rose'}">
                  <i class="bi bi-pie-chart-fill"></i> ${attPct}% حضور
                </span>
              </div>
            </div>
          </div>
          ${buildAttCalendar(s.lectures)}
        `;

        document.getElementById("attendanceModalSummary").innerHTML =
            `حضر <strong>${s.attendedCount}</strong> من أصل <strong>${s.totalLectures}</strong> محاضرة`;

        const modal = new bootstrap.Modal(document.getElementById("attendanceModal"));
        modal.show();
    }

    function buildAttCalendar(lectures) {
        if (!lectures || lectures.length === 0)
            return `<div style="text-align:center;padding:40px;color:var(--ink-4)">
                      <i class="bi bi-calendar-x" style="font-size:28px;display:block;margin-bottom:10px"></i>
                      لا توجد محاضرات مسجّلة
                    </div>`;

        // تجميع حسب الشهر
        const groups = {};
        lectures.forEach(l => {
            const key = l.monthLabel || l.date.slice(0,7);
            if (!groups[key]) groups[key] = [];
            groups[key].push(l);
        });

        let html = '';
        for (const [month, items] of Object.entries(groups)) {
            html += `<div class="att-month-group">
                       <div class="att-month-title">
                         <i class="bi bi-calendar3"></i> ${month}
                       </div>
                       <div class="att-grid">`;
            items.forEach(l => {
                const parts   = (l.date || "").split("/");
                const dayNum  = parts[2] || "—";
                const dateStr = l.date || "";

                let cls, icon, badge;
                if (!l.hasRecord) {
                    cls = "att-none"; icon = "bi-dash-circle"; badge = "غير مسجّل";
                } else if (!l.isPresent) {
                    cls = "att-absent"; icon = "bi-x-circle-fill"; badge = "غائب";
                } else if (l.isLate) {
                    cls = "att-late"; icon = "bi-clock-fill"; badge = "متأخر";
                } else {
                    cls = "att-present"; icon = "bi-check-circle-fill"; badge = "حاضر";
                }

                html += `
                  <div class="att-cell ${cls}" title="${l.title} — ${dateStr}">
                    <div class="att-date-num">${dayNum}</div>
                    <div class="att-date-str">${dateStr}</div>
                    <div class="att-title">${l.title}</div>
                    <div class="att-badge">
                      <i class="bi ${icon}"></i> ${badge}
                    </div>
                  </div>`;
            });
            html += `</div></div>`;
        }
        return html;
    }

    // ═══════════════════════════════════════════════════════
    // MODAL 2 — سجل الواجبات
    // ═══════════════════════════════════════════════════════
    function openHwModal(studentId) {
        const s = findStudent(studentId);
        if (!s) return;

        const hwPct = s.totalHomeworks > 0
            ? Math.round(s.solvedHomeworks * 100 / s.totalHomeworks) : 0;

        const body = document.getElementById("homeworkModalBody");
        body.innerHTML = `
          <div class="modal-student-header">
            <div class="modal-student-avatar">${initials(s.fullName)}</div>
            <div>
              <div class="modal-student-name">${s.fullName}</div>
              <div class="modal-stat-pills">
                <span class="modal-stat-pill pill-blue">
                  <i class="bi bi-clipboard2-fill"></i> ${s.totalHomeworks} واجب
                </span>
                <span class="modal-stat-pill ${hwPct >= 75 ? 'pill-emerald' : hwPct >= 40 ? 'pill-amber' : 'pill-rose'}">
                  <i class="bi bi-check2-circle"></i> ${s.solvedHomeworks} محلول (${hwPct}%)
                </span>
              </div>
            </div>
          </div>
          ${buildHwTimeline(s.homeworks)}
        `;

        document.getElementById("homeworkModalSummary").innerHTML =
            `حلّ <strong>${s.solvedHomeworks}</strong> من أصل <strong>${s.totalHomeworks}</strong> واجب`;

        const modal = new bootstrap.Modal(document.getElementById("homeworkModal"));
        modal.show();
    }

    function buildHwTimeline(homeworks) {
        if (!homeworks || homeworks.length === 0)
            return `<div style="text-align:center;padding:40px;color:var(--ink-4)">
                      <i class="bi bi-clipboard2-x" style="font-size:28px;display:block;margin-bottom:10px"></i>
                      لا توجد واجبات مرسلة
                    </div>`;

        // ── تجميع حسب المنهج (القسم) ──
        const grouped = {};
        const NO_CURR = "__none__";
        homeworks.forEach(h => {
            const key = (h.curriculumId != null) ? String(h.curriculumId) : NO_CURR;
            if (!grouped[key]) grouped[key] = [];
            grouped[key].push(h);
        });

        // المناهج أولاً ثم بدون منهج
        const orderedKeys = Object.keys(grouped).filter(k => k !== NO_CURR);
        if (grouped[NO_CURR]) orderedKeys.push(NO_CURR);

        let html = '';
        orderedKeys.forEach(key => {
            const items = grouped[key];
            if (key !== NO_CURR) {
                const cid      = parseInt(key);
                const currInfo = curriculumInstructors.find(c => c.curriculumId === cid);
                const title    = (currInfo && currInfo.curriculumTitle) ? currInfo.curriculumTitle : "منهج";
                const instr    = (currInfo && currInfo.instructorName)  ? currInfo.instructorName  : "";
                html += `
                  <div class="hw-curriculum-group">
                    <div class="hw-curriculum-header">
                      <div class="hw-curriculum-label">
                        <i class="bi bi-book-half"></i>
                        <span>قسم ${title}</span>
                      </div>
                      ${instr ? `<span class="hw-curriculum-instructor">
                        <i class="bi bi-person-badge-fill"></i> ${instr}
                      </span>` : ''}
                    </div>
                    <div class="hw-timeline">`;
            } else {
                html += `<div class="hw-curriculum-group"><div class="hw-timeline">`;
            }

            items.forEach(h => {
                const parts = (h.date || "").split("/");
                const day   = parts[2] || "—";
                const mon   = parts[1] || "—";

                const isSolved    = h.isSolved;
                const itemCls     = isSolved ? "solved" : "unsolved";
                const iconCls     = isSolved ? "tl-icon-solved" : "tl-icon-unsolved";
                const iconName    = isSolved ? "bi-check-circle-fill" : "bi-x-circle-fill";
                const statusBadge = isSolved
                    ? `<span class="hw-tl-badge tl-solved"><i class="bi bi-check-circle-fill"></i> تم الحل</span>`
                    : `<span class="hw-tl-badge tl-unsolved"><i class="bi bi-x-circle-fill"></i> لم يُحل</span>`;

                const scoreBadge = (isSolved && h.score != null)
                    ? `<span class="hw-tl-badge tl-score"><i class="bi bi-star-fill"></i> ${Math.round(h.score)}%</span>`
                    : "";

                let contactBadge = "";
                if (!isSolved) {
                    if (h.parentContacted) {
                        contactBadge = `<span class="hw-tl-badge tl-parent"><i class="bi bi-people-fill"></i> تم تبليغ ولي الأمر</span>`;
                    } else if (h.studentContacted) {
                        contactBadge = `<span class="hw-tl-badge tl-student"><i class="bi bi-bell-fill"></i> تم تذكير الطالب</span>`;
                    } else {
                        contactBadge = `<span class="hw-tl-badge tl-no-contact"><i class="bi bi-dash"></i> لم يتم التواصل</span>`;
                    }
                }

                html += `
                  <div class="hw-timeline-item ${itemCls}">
                    <div class="hw-tl-date">
                      <div class="hw-tl-month">${mon}</div>
                      <div class="hw-tl-day">${day}</div>
                    </div>
                    <div class="hw-tl-body">
                      <div class="hw-tl-title" title="${h.title}">${h.title}</div>
                      <div class="hw-tl-status">
                        ${statusBadge}${scoreBadge}${contactBadge}
                      </div>
                    </div>
                    <div class="hw-tl-icon ${iconCls}">
                      <i class="bi ${iconName}"></i>
                    </div>
                  </div>`;
            });

            html += `    </div></div>`;
        });

        return html;
    }
</script>
}
