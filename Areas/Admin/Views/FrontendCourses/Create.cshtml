@model QdratNew.Entities.Frontend.FrontendCourse
@{
    ViewData["Title"] = Model.Id == 0 ? "إضافة دورة جديدة" : "تعديل دورة";
    var isEditMode = Model.Id != 0;
}

<div class="qdrat-page-wrapper" dir="rtl">
    <div class="container-fluid px-0 px-lg-2 py-3 py-lg-4">

        <div class="qdrat-hero-card mb-4">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3">
                <div>
                    <div class="qdrat-kicker mb-2">
                        <i class="bi bi-globe2"></i>
                        إدارة واجهة الموقع
                    </div>
                    <h2 class="qdrat-page-title mb-2">
                        <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle")"></i>
                        @ViewData["Title"]
                    </h2>
                    <p class="qdrat-page-subtitle mb-0">
                        إعداد بيانات الدورة التي تظهر في الواجهة العامة، مع التحكم في الرابط والصورة وترتيب الظهور.
                    </p>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Index" class="btn qdrat-btn-soft">
                        <i class="bi bi-arrow-right-circle"></i>
                        رجوع للقائمة
                    </a>
                </div>
            </div>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert qdrat-alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-x-circle-fill fs-5"></i>
                <div class="fw-bold">@TempData["Error"]</div>
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert qdrat-alert-success d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div class="fw-bold">@TempData["Success"]</div>
            </div>
        }

        <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" enctype="multipart/form-data" method="post" class="needs-validation" novalidate>
            @if (Model.Id != 0)
            {
                <input type="hidden" asp-for="Id" />
            }

            <div class="row g-4">
                <div class="col-12 col-xl-8">
                    <div class="qdrat-section-card h-100">
                        <div class="qdrat-section-header">
                            <div>
                                <h5 class="mb-1">
                                    <i class="bi bi-journal-bookmark"></i>
                                    البيانات الأساسية
                                </h5>
                                <p class="mb-0">اكتب عنوان الدورة والرابط والوصف الذي يظهر للزائر.</p>
                            </div>
                        </div>

                        <div class="qdrat-section-body">
                            <div class="row g-3">
                                <div class="col-12 col-lg-6">
                                    <label asp-for="Title" class="form-label qdrat-label">عنوان الدورة</label>
                                    <div class="qdrat-input-icon">
                                        <i class="bi bi-type"></i>
                                        <input asp-for="Title" class="form-control qdrat-control" placeholder="مثال: دورة القدرات العامة" required />
                                    </div>
                                    <span asp-validation-for="Title" class="text-danger small d-block mt-1"></span>
                                </div>

                                <div class="col-12 col-lg-6">
                                    <label asp-for="Slug" class="form-label qdrat-label">الرابط (Slug)</label>
                                    <div class="qdrat-input-icon">
                                        <i class="bi bi-link-45deg"></i>
                                        <input asp-for="Slug" class="form-control qdrat-control" placeholder="اكتب الرابط أو دعه يُولد تلقائيًا من العنوان" />
                                    </div>
                                    <div id="slug-feedback" class="small mt-2"></div>
                                </div>

                                <div class="col-12">
                                    <label asp-for="ShortDescription" class="form-label qdrat-label">الوصف المختصر</label>
                                    <textarea asp-for="ShortDescription" class="form-control qdrat-control qdrat-textarea" rows="3" placeholder="ملخص قصير عن الدورة..."></textarea>
                                    <span asp-validation-for="ShortDescription" class="text-danger small d-block mt-1"></span>
                                </div>

                                <div class="col-12">
                                    <label asp-for="FullDescription" class="form-label qdrat-label">المحتوى الكامل</label>
                                    <textarea asp-for="FullDescription" class="form-control qdrat-control qdrat-textarea" rows="7" placeholder="تفاصيل الدورة ومحتواها وأهدافها..."></textarea>
                                    <span asp-validation-for="FullDescription" class="text-danger small d-block mt-1"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-4">
                    <div class="qdrat-section-card mb-4">
                        <div class="qdrat-section-header compact">
                            <div>
                                <h5 class="mb-1">
                                    <i class="bi bi-image"></i>
                                    صورة الغلاف
                                </h5>
                                <p class="mb-0">ارفع صورة مناسبة لبطاقة الدورة.</p>
                            </div>
                        </div>

                        <div class="qdrat-section-body">
                            <label class="form-label qdrat-label">اختيار صورة</label>
                            <input type="file" name="imageFile" class="form-control qdrat-control" accept="image/*" />

                            @if (!string.IsNullOrEmpty(Model.ImagePath))
                            {
                                <div class="qdrat-image-preview mt-3">
                                    <img src="@Url.Content(Model.ImagePath)" alt="@Model.Title" />
                                    <div class="qdrat-image-caption">
                                        <i class="bi bi-check-circle"></i>
                                        الصورة الحالية
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="qdrat-empty-preview mt-3">
                                    <i class="bi bi-card-image"></i>
                                    <span>لا توجد صورة حالية</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="qdrat-section-card">
                        <div class="qdrat-section-header compact">
                            <div>
                                <h5 class="mb-1">
                                    <i class="bi bi-sliders"></i>
                                    إعدادات الظهور
                                </h5>
                                <p class="mb-0">تحكم في ترتيب الدورة ومكان ظهورها.</p>
                            </div>
                        </div>

                        <div class="qdrat-section-body">
                            <div class="mb-3">
                                <label asp-for="DisplayOrder" class="form-label qdrat-label">ترتيب العرض</label>
                                <div class="qdrat-input-icon">
                                    <i class="bi bi-sort-numeric-down"></i>
                                    <input asp-for="DisplayOrder" type="number" class="form-control qdrat-control" min="0" />
                                </div>
                                <span asp-validation-for="DisplayOrder" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="qdrat-switch-list">
                                <label class="qdrat-switch-item" for="ShowInNavbar">
                                    <span class="qdrat-switch-text">
                                        <strong>عرض في القائمة المنسدلة للدورات</strong>
                                        <small>تظهر ضمن قائمة الدورات في الموقع.</small>
                                    </span>
                                    <input asp-for="ShowInNavbar" class="form-check-input" />
                                </label>

                                <label class="qdrat-switch-item" for="ShowAsMainLink">
                                    <span class="qdrat-switch-text">
                                        <strong>إظهار كرابط مستقل</strong>
                                        <small>تظهر كرابط مباشر في القائمة الرئيسية.</small>
                                    </span>
                                    <input asp-for="ShowAsMainLink" class="form-check-input" />
                                </label>

                                <label class="qdrat-switch-item" for="IsActive">
                                    <span class="qdrat-switch-text">
                                        <strong>نشطة</strong>
                                        <small>السماح بعرض الدورة في الواجهة.</small>
                                    </span>
                                    <input asp-for="IsActive" class="form-check-input" />
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="qdrat-actions-bar">
                        <a asp-action="Index" class="btn qdrat-btn-outline">
                            <i class="bi bi-x-circle"></i>
                            إلغاء
                        </a>
                        <button type="submit" class="btn qdrat-btn-primary">
                            <i class="bi bi-save2"></i>
                            حفظ الدورة
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<style>
    .qdrat-page-wrapper {
        background: #f4f7fb;
        min-height: calc(100vh - 80px);
    }

    .qdrat-hero-card {
        background: linear-gradient(135deg, #0f766e 0%, #2563eb 100%);
        border-radius: 24px;
        padding: 28px;
        color: #fff;
        box-shadow: 0 18px 45px rgba(37, 99, 235, .18);
        position: relative;
        overflow: hidden;
    }

        .qdrat-hero-card::after {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            border-radius: 999px;
            background: rgba(255,255,255,.12);
            left: -70px;
            top: -80px;
        }

    .qdrat-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 13px;
        border-radius: 999px;
        background: rgba(255,255,255,.16);
        font-size: .9rem;
        font-weight: 800;
    }

    .qdrat-page-title {
        font-weight: 900;
        letter-spacing: -.5px;
    }

        .qdrat-page-title i {
            margin-left: 8px;
        }

    .qdrat-page-subtitle {
        color: rgba(255,255,255,.86);
        max-width: 780px;
        line-height: 1.8;
    }

    .qdrat-btn-soft,
    .qdrat-btn-outline,
    .qdrat-btn-primary {
        border-radius: 14px;
        font-weight: 800;
        padding: 10px 18px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .qdrat-btn-soft {
        color: #0f172a;
        background: #fff;
        border: 1px solid rgba(255,255,255,.7);
    }

    .qdrat-btn-outline {
        color: #475569;
        background: #fff;
        border: 1px solid #dbe3ef;
    }

    .qdrat-btn-primary {
        color: #fff;
        background: linear-gradient(135deg, #16a34a 0%, #0f766e 100%);
        border: none;
        box-shadow: 0 14px 24px rgba(15, 118, 110, .22);
    }

    .qdrat-alert-danger,
    .qdrat-alert-success {
        border-radius: 18px;
        border: none;
        padding: 15px 18px;
    }

    .qdrat-alert-danger {
        color: #991b1b;
        background: #fee2e2;
    }

    .qdrat-alert-success {
        color: #166534;
        background: #dcfce7;
    }

    .qdrat-section-card {
        background: #fff;
        border-radius: 22px;
        border: 1px solid #e5edf7;
        box-shadow: 0 16px 38px rgba(15, 23, 42, .06);
        overflow: hidden;
    }

    .qdrat-section-header {
        padding: 22px 24px;
        border-bottom: 1px solid #eef3f8;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    }

        .qdrat-section-header.compact {
            padding: 18px 20px;
        }

        .qdrat-section-header h5 {
            color: #0f172a;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .qdrat-section-header p {
            color: #64748b;
            font-size: .92rem;
            line-height: 1.7;
        }

    .qdrat-section-body {
        padding: 24px;
    }

    .qdrat-label {
        color: #334155;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .qdrat-control {
        border-radius: 15px;
        border: 1px solid #dbe3ef;
        min-height: 48px;
        box-shadow: none !important;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

        .qdrat-control:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 .22rem rgba(37, 99, 235, .11) !important;
        }

    .qdrat-textarea {
        resize: vertical;
        line-height: 1.8;
    }

    .qdrat-input-icon {
        position: relative;
    }

        .qdrat-input-icon > i {
            position: absolute;
            top: 50%;
            right: 15px;
            transform: translateY(-50%);
            color: #94a3b8;
            z-index: 2;
        }

        .qdrat-input-icon .qdrat-control {
            padding-right: 42px;
        }

    .qdrat-image-preview {
        position: relative;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid #dbe3ef;
        background: #f8fafc;
    }

        .qdrat-image-preview img {
            display: block;
            width: 100%;
            height: 210px;
            object-fit: cover;
        }

    .qdrat-image-caption {
        position: absolute;
        right: 12px;
        bottom: 12px;
        background: rgba(15, 23, 42, .78);
        color: #fff;
        padding: 7px 12px;
        border-radius: 999px;
        font-size: .85rem;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .qdrat-empty-preview {
        min-height: 145px;
        border: 1px dashed #cbd5e1;
        border-radius: 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #64748b;
        background: #f8fafc;
        font-weight: 800;
    }

        .qdrat-empty-preview i {
            font-size: 2rem;
            color: #94a3b8;
        }

    .qdrat-switch-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .qdrat-switch-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 14px 15px;
        background: #f8fafc;
        cursor: pointer;
        transition: border-color .2s ease, background .2s ease;
    }

        .qdrat-switch-item:hover {
            border-color: #bfdbfe;
            background: #f1f5f9;
        }

    .qdrat-switch-text {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .qdrat-switch-text strong {
            color: #0f172a;
            font-size: .95rem;
        }

        .qdrat-switch-text small {
            color: #64748b;
            line-height: 1.6;
        }

    .qdrat-switch-item .form-check-input {
        width: 2.8rem;
        height: 1.45rem;
        margin: 0;
        cursor: pointer;
    }

    .qdrat-actions-bar {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        background: #fff;
        border: 1px solid #e5edf7;
        border-radius: 22px;
        padding: 16px;
        box-shadow: 0 14px 30px rgba(15, 23, 42, .05);
    }

    @@media (max-width: 767.98px) {
        .qdrat-hero-card {
            padding: 22px;
            border-radius: 20px;
        }

        .qdrat-section-body,
        .qdrat-section-header {
            padding: 18px;
        }

        .qdrat-actions-bar {
            flex-direction: column-reverse;
        }

            .qdrat-actions-bar .btn {
                width: 100%;
                justify-content: center;
            }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function arabicToSlug(text) {
            const map = {
                'ا': 'a', 'أ': 'a', 'إ': 'i', 'آ': 'a', 'ء': '', 'ئ': 'e', 'ؤ': 'o',
                'ب': 'b', 'ت': 't', 'ث': 'th', 'ج': 'j', 'ح': 'h', 'خ': 'kh',
                'د': 'd', 'ذ': 'th', 'ر': 'r', 'ز': 'z', 'س': 's', 'ش': 'sh',
                'ص': 's', 'ض': 'd', 'ط': 't', 'ظ': 'z', 'ع': 'a', 'غ': 'gh',
                'ف': 'f', 'ق': 'q', 'ك': 'k', 'ل': 'l', 'م': 'm', 'ن': 'n',
                'ه': 'h', 'و': 'w', 'ي': 'y', 'ى': 'a', 'ة': 'h', 'ﻻ': 'la'
            };

            return text.trim().toLowerCase()
                .replace(/[^\u0621-\u064A0-9\s]/g, '')
                .split('').map(ch => map[ch] || ch).join('')
                .replace(/\s+/g, '-')
                .replace(/-+/g, '-')
                .replace(/^-|-$/g, '');
        }

        document.addEventListener('DOMContentLoaded', function () {
            const titleInput = document.querySelector('input[name="Title"]');
            const slugInput = document.querySelector('input[name="Slug"]');
            const feedback = document.getElementById('slug-feedback');
            const saveBtn = document.querySelector('button[type="submit"]');
            const currentSlug = '@Model.Slug';

            async function checkSlug(slug) {
                if (!feedback || !saveBtn) {
                    return;
                }

                if (!slug || slug.length < 2) {
                    feedback.innerHTML = "";
                    saveBtn.disabled = false;
                    return;
                }

                try {
                    const response = await fetch(`/Admin/FrontendCourses/CheckSlugExists?slug=${encodeURIComponent(slug)}`);
                    const data = await response.json();

                    if (data.exists && slug !== currentSlug) {
                        feedback.innerHTML = "<span class='text-danger fw-bold'><i class='bi bi-exclamation-triangle'></i> هذا الرابط مستخدم مسبقًا</span>";
                        saveBtn.disabled = true;
                    } else {
                        feedback.innerHTML = "<span class='text-success fw-bold'><i class='bi bi-check-circle'></i> الرابط متاح</span>";
                        saveBtn.disabled = false;
                    }
                } catch {
                    feedback.innerHTML = "<span class='text-warning fw-bold'><i class='bi bi-wifi-off'></i> فشل التحقق من الرابط</span>";
                    saveBtn.disabled = false;
                }
            }

            if (titleInput && slugInput) {
                titleInput.addEventListener('input', function () {
                    if (!slugInput.dataset.userEdited || slugInput.value.trim() === '') {
                        const slugValue = arabicToSlug(this.value);
                        slugInput.value = slugValue;
                        checkSlug(slugValue);
                    }
                });

                slugInput.addEventListener('input', function () {
                    this.dataset.userEdited = "true";
                    checkSlug(this.value);
                });
            }
        });
    </script>
}
