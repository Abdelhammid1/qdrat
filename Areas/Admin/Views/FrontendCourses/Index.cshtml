@model IEnumerable<QdratNew.Entities.Frontend.FrontendCourse>
@{
    ViewData["Title"] = "📚 الدورات التعريفية";
}

<div class="container mt-4" dir="rtl">
    <h3 class="fw-bold text-primary mb-3">📘 إدارة الدورات</h3>
    <a asp-action="Create" class="btn btn-success mb-3">➕ إضافة دورة</a>

    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>العنوان</th>
                <th>عرض بالقائمة</th>
                <th>الترتيب</th>
                <th>نشطة؟</th>
                <th>الخيارات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@(item.ShowInNavbar ? "✅" : "❌")</td>
                    <td>@item.DisplayOrder</td>
                    <td>@(item.IsActive ? "✅" : "❌")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">تعديل</a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-danger" type="submit" onclick="return confirm('تأكيد الحذف؟')">حذف</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
