@model QdratNew.ViewModels.PartnerSubscriptions.PartnerSubscriptionDetailsViewModel

@{
    ViewData["Title"] = "تفاصيل عقد الشراكة";

    var enabledPermissions = 0;
    var disabledPermissions = 0;

    if (Model.CanCreateHomework) enabledPermissions++; else disabledPermissions++;
    if (Model.CanCreateExams) enabledPermissions++; else disabledPermissions++;
    if (Model.CanUsePlacementExams) enabledPermissions++; else disabledPermissions++;
    if (Model.CanUsePerformanceIndicatorExams) enabledPermissions++; else disabledPermissions++;
    if (Model.CanUseReinforcementSkills) enabledPermissions++; else disabledPermissions++;
    if (Model.CanUseRemedialPlans) enabledPermissions++; else disabledPermissions++;
    if (Model.CanUseRemedialSessions) enabledPermissions++; else disabledPermissions++;
    if (Model.CanAccessEducationalContent) enabledPermissions++; else disabledPermissions++;
    if (Model.CanUseProfessionalModels) enabledPermissions++; else disabledPermissions++;

    var totalPermissions = enabledPermissions + disabledPermissions;
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        :root {
            --ink: #0D1B2A;
            --ink-2: #2C3E50;
            --ink-3: #5A6A7A;
            --ink-4: #8FA0B0;
            --ink-5: #C8D5E0;
            --canvas: #F3F6FA;
            --surface: #FFFFFF;
            --surface-2: #F8FAFC;
            --surface-3: #EEF2F7;
            --border: #DDE4EC;
            --blue: #1B5EAE;
            --blue-2: #2471D0;
            --blue-bg: #E8F1FB;
            --blue-dark: #103E7A;
            --emerald: #0D7A5B;
            --emerald-bg: #E4F5EE;
            --amber: #985D09;
            --amber-bg: #FDF0D8;
            --rose: #BF1030;
            --rose-bg: #FDEAEE;
            --violet: #5535B5;
            --violet-bg: #EDE8F9;
            --r-sm: 6px;
            --r-md: 10px;
            --r-lg: 14px;
            --r-xl: 20px;
            --sh-xs: 0 1px 3px rgba(13,27,42,.06);
            --sh-sm: 0 2px 8px rgba(13,27,42,.08);
            --sh-md: 0 4px 18px rgba(13,27,42,.10);
            --ease: cubic-bezier(.25,.46,.45,.94);
        }

        .subscription-details-page {
            background: var(--canvas);
            min-height: 100vh;
            padding: 32px 28px 64px;
            direction: rtl;
            font-family: 'Cairo';
            color: var(--ink-2);
        }

        .subscription-details-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 14px;
            margin-bottom: 28px;
        }

        .subscription-details-brand {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .subscription-details-brand-icon {
            width: 46px;
            height: 46px;
            background: var(--blue);
            border-radius: var(--r-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 20px;
            box-shadow: 0 4px 14px rgba(27,94,174,.28);
        }

        .subscription-details-brand-title {
            font-size: 20px;
            font-weight: 700;
            color: var(--ink);
            line-height: 1.15;
        }

        .subscription-details-brand-sub {
            font-size: 16px;
            color: var(--ink-4);
            margin-top: 2px;
        }

        .partner-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--violet-bg);
            color: var(--violet);
            padding: 5px 12px;
            border-radius: 30px;
            font-size: 16px;
            font-weight: 800;
            margin-top: 8px;
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn-secondary-action {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: var(--surface);
            color: var(--blue);
            border: 1px solid #B6D3F4;
            border-radius: var(--r-md);
            padding: 10px 20px;
            font-size: 18px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: background .16s var(--ease), transform .14s, box-shadow .16s;
        }

            .btn-secondary-action:hover {
                background: var(--blue-bg);
                color: var(--blue-dark);
                transform: translateY(-2px);
                box-shadow: var(--sh-sm);
            }

        .details-kpis {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 13px;
            margin-bottom: 24px;
        }

        @@media (max-width: 960px) {
            .details-kpis {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 480px) {
            .details-kpis {
                grid-template-columns: 1fr;
            }
        }

        .kpi-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            padding: 18px 19px;
            display: flex;
            align-items: center;
            gap: 13px;
            box-shadow: var(--sh-xs);
            transition: transform .2s var(--ease), box-shadow .2s;
            position: relative;
            overflow: hidden;
        }

            .kpi-card::after {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 4px;
                height: 100%;
                border-radius: 0 var(--r-xl) var(--r-xl) 0;
            }

            .kpi-card:hover {
                transform: translateY(-3px);
                box-shadow: var(--sh-sm);
            }

        .kpi-blue::after {
            background: var(--blue);
        }

        .kpi-emerald::after {
            background: var(--emerald);
        }

        .kpi-amber::after {
            background: var(--amber);
        }

        .kpi-violet::after {
            background: var(--violet);
        }

        .kpi-ico {
            width: 42px;
            height: 42px;
            border-radius: var(--r-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .ico-blue {
            background: var(--blue-bg);
            color: var(--blue);
        }

        .ico-emerald {
            background: var(--emerald-bg);
            color: var(--emerald);
        }

        .ico-amber {
            background: var(--amber-bg);
            color: var(--amber);
        }

        .ico-violet {
            background: var(--violet-bg);
            color: var(--violet);
        }

        .kpi-label {
            font-size: 15px;
            font-weight: 700;
            color: var(--ink-4);
            letter-spacing: .04em;
            text-transform: uppercase;
            margin-bottom: 3px;
        }

        .kpi-val {
            font-size: 20px;
            font-weight: 700;
            color: var(--ink);
            line-height: 1;
        }

        .details-section-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            box-shadow: var(--sh-sm);
            margin-bottom: 24px;
            overflow: hidden;
        }

        .details-section-header {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 15px 18px;
            border-bottom: 1px solid var(--surface-3);
            font-size: 18px;
            font-weight: 800;
            color: var(--ink);
        }

            .details-section-header i {
                color: var(--blue);
            }

        .details-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 13px;
            padding: 18px;
        }

        @@media (max-width: 992px) {
            .details-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 576px) {
            .details-grid {
                grid-template-columns: 1fr;
            }
        }

        .detail-card {
            background: var(--surface-2);
            border: 1px solid var(--surface-3);
            border-radius: var(--r-lg);
            padding: 16px 17px;
            min-height: 92px;
            transition: border-color .15s, transform .15s, box-shadow .15s;
        }

            .detail-card:hover {
                border-color: #B6D3F4;
                transform: translateY(-2px);
                box-shadow: var(--sh-xs);
            }

        .detail-label {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--ink-4);
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 7px;
        }

        .detail-value {
            color: var(--ink);
            font-size: 20px;
            font-weight: 800;
            line-height: 1.5;
        }

        .detail-sub {
            color: var(--ink-4);
            font-size: 15px;
            font-weight: 700;
            margin-right: 4px;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 6px 13px;
            border-radius: 30px;
            font-size: 16px;
            font-weight: 800;
            white-space: nowrap;
        }

        .sp-active {
            background: var(--emerald-bg);
            color: var(--emerald);
        }

        .sp-expired {
            background: var(--rose-bg);
            color: var(--rose);
        }

        .permissions-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 13px;
            padding: 18px;
        }

        @@media (max-width: 1100px) {
            .permissions-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 640px) {
            .permissions-grid {
                grid-template-columns: 1fr;
            }
        }

        .permission-card {
            background: var(--surface-2);
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            padding: 14px 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            transition: border-color .15s, box-shadow .15s, transform .15s, background .15s;
            min-height: 70px;
        }

            .permission-card:hover {
                border-color: #B6D3F4;
                box-shadow: var(--sh-xs);
                transform: translateY(-2px);
            }

            .permission-card.is-enabled {
                background: var(--emerald-bg);
                border-color: #B8E8D3;
            }

            .permission-card.is-disabled {
                background: var(--surface-2);
                border-color: var(--border);
            }

        .permission-title {
            display: flex;
            align-items: center;
            gap: 9px;
            color: var(--ink);
            font-size: 17px;
            font-weight: 800;
        }

        .permission-icon {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: var(--surface);
            color: var(--blue);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }

        .permission-card.is-enabled .permission-icon {
            color: var(--emerald);
        }

        .permission-state {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 11px;
            border-radius: 30px;
            font-size: 15px;
            font-weight: 800;
            white-space: nowrap;
        }

        .state-enabled {
            background: var(--surface);
            color: var(--emerald);
        }

        .state-disabled {
            background: var(--surface-3);
            color: var(--ink-4);
        }

        @@media (max-width: 768px) {
            .subscription-details-page {
                padding: 22px 14px 48px;
            }

            .top-actions {
                width: 100%;
            }

            .btn-secondary-action {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
}

<div class="subscription-details-page">

    <div class="subscription-details-topbar">
        <div class="subscription-details-brand">
            <div class="subscription-details-brand-icon">
                <i class="bi bi-file-earmark-text-fill"></i>
            </div>
            <div>
                <div class="subscription-details-brand-title">تفاصيل عقد الشراكة</div>
                <div class="subscription-details-brand-sub">
                    عرض بيانات العقد والقيود والصلاحيات التعليمية المرتبطة به.
                </div>
                <div class="partner-pill">
                    <i class="bi bi-building"></i>
                    @Model.PartnerName
                </div>
            </div>
        </div>

        <div class="top-actions">
            <a asp-action="Index"
               asp-route-partnerId="@ViewBag.PartnerId"
               class="btn-secondary-action">
                <i class="bi bi-arrow-left"></i>
                رجوع لعقود الشراكة
            </a>
        </div>
    </div>

    <div class="details-kpis">

        <div class="kpi-card kpi-blue">
            <div class="kpi-ico ico-blue">
                <i class="bi bi-calendar-event"></i>
            </div>
            <div>
                <div class="kpi-label">بداية العقد</div>
                <div class="kpi-val">@Model.StartDate.ToString("yyyy/MM/dd")</div>
            </div>
        </div>

        <div class="kpi-card kpi-amber">
            <div class="kpi-ico ico-amber">
                <i class="bi bi-calendar-check"></i>
            </div>
            <div>
                <div class="kpi-label">نهاية العقد</div>
                <div class="kpi-val">@Model.EndDate.ToString("yyyy/MM/dd")</div>
            </div>
        </div>

        <div class="kpi-card kpi-emerald">
            <div class="kpi-ico ico-emerald">
                <i class="bi bi-shield-check"></i>
            </div>
            <div>
                <div class="kpi-label">الصلاحيات المفعلة</div>
                <div class="kpi-val">@enabledPermissions / @totalPermissions</div>
            </div>
        </div>

        <div class="kpi-card kpi-violet">
            <div class="kpi-ico ico-violet">
                <i class="bi bi-person-badge"></i>
            </div>
            <div>
                <div class="kpi-label">المدربون الحاليون</div>
                <div class="kpi-val">
                    @Model.CurrentInstructorsCount
                    @if (Model.MaxInstructors.HasValue)
                    {
                        <span class="detail-sub">/ @Model.MaxInstructors</span>
                    }
                </div>
            </div>
        </div>

    </div>

    <div class="details-section-card">
        <div class="details-section-header">
            <i class="bi bi-info-circle"></i>
            بيانات العقد الأساسية
        </div>

        <div class="details-grid">

            <div class="detail-card">
                <div class="detail-label">
                    <i class="bi bi-calendar-event"></i>
                    بداية العقد
                </div>
                <div class="detail-value">@Model.StartDate.ToString("yyyy/MM/dd")</div>
            </div>

            <div class="detail-card">
                <div class="detail-label">
                    <i class="bi bi-calendar-check"></i>
                    نهاية العقد
                </div>
                <div class="detail-value">@Model.EndDate.ToString("yyyy/MM/dd")</div>
            </div>

            <div class="detail-card">
                <div class="detail-label">
                    <i class="bi bi-activity"></i>
                    حالة العقد
                </div>
                <div class="detail-value">
                    @if (Model.IsActive)
                    {
                        <span class="status-pill sp-active">
                            <i class="bi bi-check-circle"></i>
                            نشط
                        </span>
                    }
                    else
                    {
                        <span class="status-pill sp-expired">
                            <i class="bi bi-x-circle"></i>
                            منتهي
                        </span>
                    }
                </div>
            </div>

        </div>
    </div>

    <div class="details-section-card">
        <div class="details-section-header">
            <i class="bi bi-bar-chart"></i>
            القيود العددية
        </div>

        <div class="details-grid">

            <div class="detail-card">
                <div class="detail-label">
                    <i class="bi bi-people"></i>
                    حد الطلاب النشطين
                </div>
                <div class="detail-value">
                    @(Model.MaxActiveStudents.HasValue? Model.MaxActiveStudents.Value.ToString() : "غير محدود")
                </div>
            </div>

            <div class="detail-card">
                <div class="detail-label">
                    <i class="bi bi-person-video3"></i>
                    حد المدربين
                </div>
                <div class="detail-value">
                    @(Model.MaxInstructors.HasValue? Model.MaxInstructors.Value.ToString() : "غير محدود")
                </div>
            </div>

            <div class="detail-card">
                <div class="detail-label">
                    <i class="bi bi-person-check"></i>
                    المدربون الحاليون
                </div>
                <div class="detail-value">
                    @Model.CurrentInstructorsCount
                    @if (Model.MaxInstructors.HasValue)
                    {
                        <span class="detail-sub">/ @Model.MaxInstructors</span>
                    }
                </div>
            </div>

        </div>
    </div>

    <div class="details-section-card">
        <div class="details-section-header">
            <i class="bi bi-shield-lock"></i>
            الصلاحيات التعليمية
        </div>

        <div class="permissions-grid">

            <div class="permission-card @(Model.CanCreateHomework ? "is-enabled" : "is-disabled")">
                <div class="permission-title">
                    <span class="permission-icon">
                        <i class="bi bi-journal-check"></i>
                    </span>
                    الواجبات
                </div>
                <span class="permission-state @(Model.CanCreateHomework ? "state-enabled" : "state-disabled")">
                    <i class="bi @(Model.CanCreateHomework ? "bi-check-circle" : "bi-x-circle")"></i>
                    @(Model.CanCreateHomework ? "مفعّلة" : "غير مفعّلة")
                </span>
            </div>

            <div class="permission-card @(Model.CanCreateExams ? "is-enabled" : "is-disabled")">
                <div class="permission-title">
                    <span class="permission-icon">
                        <i class="bi bi-ui-checks"></i>
                    </span>
                    الاختبارات
                </div>
                <span class="permission-state @(Model.CanCreateExams ? "state-enabled" : "state-disabled")">
                    <i class="bi @(Model.CanCreateExams ? "bi-check-circle" : "bi-x-circle")"></i>
                    @(Model.CanCreateExams ? "مفعّلة" : "غير مفعّلة")
                </span>
            </div>

            <div class="permission-card @(Model.CanUsePlacementExams ? "is-enabled" : "is-disabled")">
                <div class="permission-title">
                    <span class="permission-icon">
                        <i class="bi bi-mortarboard"></i>
                    </span>
                    تحديد المستوى
                </div>
                <span class="permission-state @(Model.CanUsePlacementExams ? "state-enabled" : "state-disabled")">
                    <i class="bi @(Model.CanUsePlacementExams ? "bi-check-circle" : "bi-x-circle")"></i>
                    @(Model.CanUsePlacementExams ? "مفعّل" : "غير مفعّل")
                </span>
            </div>

            <div class="permission-card @(Model.CanUsePerformanceIndicatorExams ? "is-enabled" : "is-disabled")">
                <div class="permission-title">
                    <span class="permission-icon">
                        <i class="bi bi-graph-up-arrow"></i>
                    </span>
                    مؤشر الأداء
                </div>
                <span class="permission-state @(Model.CanUsePerformanceIndicatorExams ? "state-enabled" : "state-disabled")">
                    <i class="bi @(Model.CanUsePerformanceIndicatorExams ? "bi-check-circle" : "bi-x-circle")"></i>
                    @(Model.CanUsePerformanceIndicatorExams ? "مفعّل" : "غير مفعّل")
                </span>
            </div>

            <div class="permission-card @(Model.CanUseReinforcementSkills ? "is-enabled" : "is-disabled")">
                <div class="permission-title">
                    <span class="permission-icon">
                        <i class="bi bi-lightning-charge"></i>
                    </span>
                    المهارات التعزيزية
                </div>
                <span class="permission-state @(Model.CanUseReinforcementSkills ? "state-enabled" : "state-disabled")">
                    <i class="bi @(Model.CanUseReinforcementSkills ? "bi-check-circle" : "bi-x-circle")"></i>
                    @(Model.CanUseReinforcementSkills ? "مفعّلة" : "غير مفعّلة")
                </span>
            </div>

            <div class="permission-card @(Model.CanUseRemedialPlans ? "is-enabled" : "is-disabled")">
                <div class="permission-title">
                    <span class="permission-icon">
                        <i class="bi bi-clipboard2-pulse"></i>
                    </span>
                    الخطط العلاجية
                </div>
                <span class="permission-state @(Model.CanUseRemedialPlans ? "state-enabled" : "state-disabled")">
                    <i class="bi @(Model.CanUseRemedialPlans ? "bi-check-circle" : "bi-x-circle")"></i>
                    @(Model.CanUseRemedialPlans ? "مفعّلة" : "غير مفعّلة")
                </span>
            </div>

            <div class="permission-card @(Model.CanUseRemedialSessions ? "is-enabled" : "is-disabled")">
                <div class="permission-title">
                    <span class="permission-icon">
                        <i class="bi bi-calendar2-check"></i>
                    </span>
                    الجلسات العلاجية
                </div>
                <span class="permission-state @(Model.CanUseRemedialSessions ? "state-enabled" : "state-disabled")">
                    <i class="bi @(Model.CanUseRemedialSessions ? "bi-check-circle" : "bi-x-circle")"></i>
                    @(Model.CanUseRemedialSessions ? "مفعّلة" : "غير مفعّلة")
                </span>
            </div>

            <div class="permission-card @(Model.CanAccessEducationalContent ? "is-enabled" : "is-disabled")">
                <div class="permission-title">
                    <span class="permission-icon">
                        <i class="bi bi-book"></i>
                    </span>
                    المحتوى التعليمي
                </div>
                <span class="permission-state @(Model.CanAccessEducationalContent ? "state-enabled" : "state-disabled")">
                    <i class="bi @(Model.CanAccessEducationalContent ? "bi-check-circle" : "bi-x-circle")"></i>
                    @(Model.CanAccessEducationalContent ? "مفعّل" : "غير مفعّل")
                </span>
            </div>

            <div class="permission-card @(Model.CanUseProfessionalModels ? "is-enabled" : "is-disabled")">
                <div class="permission-title">
                    <span class="permission-icon">
                        <i class="bi bi-layers"></i>
                    </span>
                    النماذج الاحترافية
                </div>
                <span class="permission-state @(Model.CanUseProfessionalModels ? "state-enabled" : "state-disabled")">
                    <i class="bi @(Model.CanUseProfessionalModels ? "bi-check-circle" : "bi-x-circle")"></i>
                    @(Model.CanUseProfessionalModels ? "مفعّلة" : "غير مفعّلة")
                </span>
            </div>

        </div>
    </div>

</div>