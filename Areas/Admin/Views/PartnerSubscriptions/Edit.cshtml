@model QdratNew.ViewModels.PartnerSubscriptions.PartnerSubscriptionEditViewModel

@{
    ViewData["Title"] = "تعديل عقد الشراكة";
}
<!-- 🔴 رسائل الخطأ -->
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>تعذّر حفظ التعديلات:</strong>
        <ul class="mb-0 mt-2">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-4" dir="rtl">

    <h3 class="fw-bold mb-3">✏️ تعديل عقد الشراكة</h3>

    <div class="alert alert-info">
        المدرسة: <strong>@Model.PartnerName</strong>
    </div>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="PartnerId" />
        <!-- 📄 بيانات العقد -->
        <div class="card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-header fw-bold">📄 بيانات العقد</div>
            <div class="card-body row g-3">

                <div class="col-md-4">
                    <label class="form-label">بداية العقد</label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">نهاية العقد</label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">حد الطلاب النشطين</label>
                    <input asp-for="MaxActiveStudents" class="form-control"
                           placeholder="غير محدود" />
                </div>

                <div class="card-body row g-3">

                    <div class="col-md-3">
                        <label class="form-label">بداية العقد</label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">نهاية العقد</label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">حد الطلاب النشطين</label>
                        <input asp-for="MaxActiveStudents"
                               class="form-control"
                               placeholder="غير محدود" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">حد المدربين</label>
                        <input asp-for="MaxInstructors"
                               type="number"
                               min="0"
                               class="form-control"
                               placeholder="غير محدود" />
                        <small class="text-muted">
                            اتركه فارغًا ليكون غير محدود
                        </small>
                    </div>

                </div>
            </div>

        <!-- 🔐 الصلاحيات -->
        <div class="card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-header fw-bold">🔐 الصلاحيات التعليمية</div>
            <div class="card-body row row-cols-1 row-cols-md-2 g-3">

                <div class="form-check">
                    <input asp-for="CanCreateHomework" class="form-check-input" />
                    <label class="form-check-label">الواجبات</label>
                </div>

                <div class="form-check">
                    <input asp-for="CanCreateExams" class="form-check-input" />
                    <label class="form-check-label">الاختبارات</label>
                </div>

                <div class="form-check">
                    <input asp-for="CanUsePlacementExams" class="form-check-input" />
                    <label class="form-check-label">تحديد المستوى</label>
                </div>

                <div class="form-check">
                    <input asp-for="CanUsePerformanceIndicatorExams" class="form-check-input" />
                    <label class="form-check-label">مؤشر الأداء</label>
                </div>

                <div class="form-check">
                    <input asp-for="CanUseReinforcementSkills" class="form-check-input" />
                    <label class="form-check-label">المهارات التعزيزية</label>
                </div>

                <div class="form-check">
                    <input asp-for="CanUseRemedialPlans" class="form-check-input" />
                    <label class="form-check-label">الخطط العلاجية</label>
                </div>

                <div class="form-check">
                    <input asp-for="CanUseRemedialSessions" class="form-check-input" />
                    <label class="form-check-label">الجلسات العلاجية</label>
                </div>

                <div class="form-check">
                    <input asp-for="CanAccessEducationalContent" class="form-check-input" />
                    <label class="form-check-label">المحتوى التعليمي</label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input"
                           asp-for="CanUseProfessionalModels" />

                    <label class="form-check-label"
                           asp-for="CanUseProfessionalModels">
                        السماح باستخدام النماذج الاحترافية
                    </label>
                </div>

                <small class="text-muted d-block mb-3">
                    يتيح هذا الخيار للشريك إرسال الواجبات باستخدام نماذج احترافية جاهزة
                    مع إمكانية تخصيص الأسئلة قبل الإرسال.
                </small>

            </div>
        </div>

        <!-- 📦 الدورات -->
        <div class="card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-header fw-bold">📦 الدورات المتعاقد عليها</div>
            <div class="card-body">

                <table class="table table-bordered align-middle text-center">
                    <thead class="table-light">
                        <tr>
                            <th>الدورة</th>
                            <th>تعاقد</th>
                            <th>
                                بنك الأسئلة
                                <span title="السماح باستخدام بنك أسئلة المنصة">ⓘ</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Courses.Count; i++)
                        {
                            <tr>
                                <td>
                                    @Model.Courses[i].CourseName

                                    <input type="hidden" asp-for="Courses[i].CourseId" />
                                    <input type="hidden" asp-for="Courses[i].CourseName" />
                                </td>

                                <td>
                                    <input asp-for="Courses[i].IsSelected" />
                                </td>
                                <td>
                                    <input asp-for="Courses[i].CanUsePlatformQuestionBank" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>

        <!-- 🕒 وصول بعد الانتهاء -->
        <div class="card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-body">
                <label class="form-label">الوصول بعد انتهاء العقد (اختياري)</label>
                <input asp-for="AccessUntilDate" type="date" class="form-control" />
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" asp-route-partnerId="@Model.PartnerId"
               class="btn btn-outline-secondary">
                رجوع
            </a>
            <button type="submit" class="btn btn-success">
                حفظ العقد
            </button>
        </div>

    </form>
</div>
