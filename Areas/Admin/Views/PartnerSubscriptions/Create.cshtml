@model QdratNew.ViewModels.PartnerSubscriptions.PartnerSubscriptionCreateViewModel

@{
    ViewData["Title"] = "إنشاء عقد شراكة";
}

<div class="qdrat-page-wrapper" dir="rtl">
    <div class="qdrat-page-header">
        <div>
            <h1 class="qdrat-page-title">
                <i class="fas fa-file-signature"></i>
                إنشاء عقد شراكة
            </h1>
            <p class="qdrat-page-subtitle">
                إنشاء عقد شراكة جديد وتحديد حدود الاستخدام والصلاحيات والدورات المتعاقد عليها.
            </p>
        </div>

        <a asp-action="Index" asp-route-partnerId="@Model.PartnerId" class="qdrat-back-btn">
            <i class="fas fa-arrow-right"></i>
            العودة للعقود
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="qdrat-alert qdrat-alert-danger" role="alert">
            <div class="qdrat-alert-icon">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <div>
                <strong>تعذّر حفظ البيانات</strong>
                <ul class="mb-0 mt-2">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="qdrat-alert qdrat-alert-danger" role="alert">
            <div class="qdrat-alert-icon">
                <i class="fas fa-times-circle"></i>
            </div>
            <div>@TempData["Error"]</div>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="qdrat-alert qdrat-alert-success" role="alert">
            <div class="qdrat-alert-icon">
                <i class="fas fa-check-circle"></i>
            </div>
            <div>@TempData["Success"]</div>
        </div>
    }

    <div class="qdrat-partner-strip">
        <div class="qdrat-partner-icon">
            <i class="fas fa-school"></i>
        </div>
        <div>
            <span>المدرسة / الشريك</span>
            <strong>@Model.PartnerName</strong>
        </div>
    </div>

    <form asp-action="Create" method="post" class="qdrat-form-card">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="PartnerId" />

        <div class="qdrat-card-header">
            <div class="qdrat-card-icon">
                <i class="fas fa-clipboard-list"></i>
            </div>
            <div>
                <h2>بيانات العقد</h2>
                <p>حدد فترة العقد والحدود التشغيلية قبل تفعيل الصلاحيات التعليمية.</p>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-calendar-alt"></i>
                مدة العقد وحدود الاستخدام
            </div>

            <div class="row g-4">
                <div class="col-lg-3 col-md-6">
                    <div class="qdrat-form-group">
                        <label asp-for="StartDate" class="qdrat-label">بداية العقد</label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-calendar-day"></i>
                            <input asp-for="StartDate" type="date" class="form-control qdrat-input" />
                        </div>
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="qdrat-form-group">
                        <label asp-for="EndDate" class="qdrat-label">نهاية العقد</label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-calendar-check"></i>
                            <input asp-for="EndDate" type="date" class="form-control qdrat-input" />
                        </div>
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="qdrat-form-group">
                        <label asp-for="MaxActiveStudents" class="qdrat-label">حد الطلاب النشطين</label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-user-graduate"></i>
                            <input asp-for="MaxActiveStudents" class="form-control qdrat-input" placeholder="غير محدود" />
                        </div>
                        <span asp-validation-for="MaxActiveStudents" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="qdrat-form-group">
                        <label asp-for="MaxInstructors" class="qdrat-label">حد المدربين</label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-chalkboard-teacher"></i>
                            <input asp-for="MaxInstructors" type="number" min="0" class="form-control qdrat-input" placeholder="غير محدود" />
                        </div>
                        <span asp-validation-for="MaxInstructors" class="text-danger small"></span>
                        <small class="qdrat-help-text">اتركه فارغًا ليكون غير محدود.</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-shield-alt"></i>
                الصلاحيات التعليمية
            </div>

            <div class="qdrat-permissions-grid">
                <label class="qdrat-toggle-card">
                    <input asp-for="CanCreateHomework" />
                    <span class="qdrat-toggle-box"><i class="fas fa-tasks"></i></span>
                    <span>الواجبات</span>
                </label>

                <label class="qdrat-toggle-card">
                    <input asp-for="CanCreateExams" />
                    <span class="qdrat-toggle-box"><i class="fas fa-file-alt"></i></span>
                    <span>الاختبارات</span>
                </label>

                <label class="qdrat-toggle-card">
                    <input asp-for="CanUsePlacementExams" />
                    <span class="qdrat-toggle-box"><i class="fas fa-layer-group"></i></span>
                    <span>تحديد المستوى</span>
                </label>

                <label class="qdrat-toggle-card">
                    <input asp-for="CanUsePerformanceIndicatorExams" />
                    <span class="qdrat-toggle-box"><i class="fas fa-chart-line"></i></span>
                    <span>مؤشر الأداء</span>
                </label>

                <label class="qdrat-toggle-card">
                    <input asp-for="CanUseReinforcementSkills" />
                    <span class="qdrat-toggle-box"><i class="fas fa-bolt"></i></span>
                    <span>المهارات التعزيزية</span>
                </label>

                <label class="qdrat-toggle-card">
                    <input asp-for="CanUseRemedialPlans" />
                    <span class="qdrat-toggle-box"><i class="fas fa-route"></i></span>
                    <span>الخطط العلاجية</span>
                </label>

                <label class="qdrat-toggle-card">
                    <input asp-for="CanUseRemedialSessions" />
                    <span class="qdrat-toggle-box"><i class="fas fa-user-clock"></i></span>
                    <span>الجلسات العلاجية</span>
                </label>

                <label class="qdrat-toggle-card">
                    <input asp-for="CanAccessEducationalContent" />
                    <span class="qdrat-toggle-box"><i class="fas fa-book-open"></i></span>
                    <span>المحتوى التعليمي</span>
                </label>

                <label class="qdrat-toggle-card qdrat-toggle-card-wide">
                    <input asp-for="CanUseProfessionalModels" />
                    <span class="qdrat-toggle-box"><i class="fas fa-medal"></i></span>
                    <span>
                        السماح باستخدام النماذج الاحترافية
                        <small>يتيح للشريك إرسال الواجبات باستخدام نماذج احترافية جاهزة مع إمكانية تخصيص الأسئلة قبل الإرسال.</small>
                    </span>
                </label>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-boxes"></i>
                الدورات المتعاقد عليها
            </div>

            <div class="qdrat-table-wrapper">
                <table class="table qdrat-table align-middle text-center">
                    <thead>
                        <tr>
                            <th>الدورة</th>
                            <th>تعاقد</th>
                            <th>بنك الأسئلة <span class="qdrat-info" title="السماح باستخدام بنك أسئلة المنصة">ⓘ</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Courses.Count; i++)
                        {
                            <tr>
                                <td class="text-start">
                                    <div class="qdrat-course-name">
                                        <i class="fas fa-book"></i>
                                        <span>@Model.Courses[i].CourseName</span>
                                    </div>

                                    <input type="hidden" asp-for="Courses[i].CourseId" />
                                    <input type="hidden" asp-for="Courses[i].CourseName" />
                                </td>
                                <td>
                                    <input asp-for="Courses[i].IsSelected" class="qdrat-table-check" />
                                </td>
                                <td>
                                    <input asp-for="Courses[i].CanUsePlatformQuestionBank" class="qdrat-table-check" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-clock"></i>
                الوصول بعد انتهاء العقد
            </div>

            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="qdrat-form-group">
                        <label asp-for="AccessUntilDate" class="qdrat-label">الوصول بعد انتهاء العقد (اختياري)</label>
                        <div class="qdrat-input-wrapper">
                            <i class="fas fa-unlock-alt"></i>
                            <input asp-for="AccessUntilDate" type="date" class="form-control qdrat-input" />
                        </div>
                        <span asp-validation-for="AccessUntilDate" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-actions">
            <button type="submit" class="qdrat-save-btn">
                <i class="fas fa-save"></i>
                حفظ العقد
            </button>

            <a asp-action="Index" asp-route-partnerId="@Model.PartnerId" class="qdrat-cancel-btn">
                <i class="fas fa-times"></i>
                رجوع
            </a>
        </div>
    </form>
</div>

<style>
    .qdrat-page-wrapper {
        max-width: 1240px;
        margin: 0 auto;
        padding: 24px 16px 42px;
        font-family: 'Cairo', 'Tajawal', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .qdrat-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 20px;
        padding: 24px;
        border-radius: 26px;
        background: linear-gradient(135deg, #0f766e 0%, #0891b2 52%, #2563eb 100%);
        color: #fff;
        box-shadow: 0 18px 46px rgba(15, 118, 110, 0.22);
    }

    .qdrat-page-title {
        margin: 0;
        font-size: 26px;
        font-weight: 900;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .qdrat-page-subtitle {
        margin: 8px 0 0;
        color: rgba(255, 255, 255, 0.88);
        font-size: 14px;
        line-height: 1.8;
    }

    .qdrat-back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 155px;
        padding: 11px 18px;
        border-radius: 999px;
        color: #fff;
        text-decoration: none;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.32);
        font-size: 14px;
        font-weight: 900;
        transition: all 0.2s ease-in-out;
    }

        .qdrat-back-btn:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.24);
            transform: translateY(-1px);
        }

    .qdrat-alert {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 14px 16px;
        border-radius: 18px;
        margin-bottom: 16px;
        font-size: 14px;
        font-weight: 800;
        line-height: 1.8;
    }

        .qdrat-alert ul {
            padding-right: 18px;
        }

    .qdrat-alert-danger {
        color: #991b1b;
        background: #fef2f2;
        border: 1px solid #fecaca;
    }

    .qdrat-alert-success {
        color: #166534;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
    }

    .qdrat-alert-icon {
        font-size: 18px;
        padding-top: 3px;
    }

    .qdrat-partner-strip {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 18px;
        padding: 18px 20px;
        border-radius: 22px;
        background: linear-gradient(135deg, #ecfeff 0%, #eff6ff 100%);
        border: 1px solid #bfdbfe;
    }

    .qdrat-partner-icon {
        width: 50px;
        height: 50px;
        border-radius: 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        color: #0f766e;
        font-size: 21px;
        box-shadow: 0 10px 22px rgba(15, 118, 110, 0.08);
        flex-shrink: 0;
    }

    .qdrat-partner-strip span {
        display: block;
        color: #64748b;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 4px;
    }

    .qdrat-partner-strip strong {
        display: block;
        color: #0f172a;
        font-size: 18px;
        font-weight: 900;
    }

    .qdrat-form-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 26px;
        box-shadow: 0 20px 55px rgba(15, 23, 42, 0.08);
        padding: 26px;
        overflow: hidden;
    }

    .qdrat-card-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding-bottom: 22px;
        border-bottom: 1px solid #eef2f7;
        margin-bottom: 24px;
    }

    .qdrat-card-icon {
        width: 54px;
        height: 54px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #ecfeff 0%, #dbeafe 100%);
        color: #0f766e;
        font-size: 22px;
        flex-shrink: 0;
    }

    .qdrat-card-header h2 {
        margin: 0;
        font-size: 20px;
        font-weight: 900;
        color: #111827;
    }

    .qdrat-card-header p {
        margin: 6px 0 0;
        color: #6b7280;
        font-size: 13px;
    }

    .qdrat-section {
        padding: 20px;
        border: 1px solid #eef2f7;
        background: #fbfdff;
        border-radius: 22px;
        margin-bottom: 20px;
    }

    .qdrat-section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 18px;
        color: #0f172a;
        font-size: 16px;
        font-weight: 900;
    }

        .qdrat-section-title i {
            color: #0f766e;
        }

    .qdrat-form-group {
        margin-bottom: 2px;
    }

    .qdrat-label {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 9px;
        color: #1f2937;
        font-size: 14px;
        font-weight: 900;
    }

    .qdrat-input-wrapper {
        position: relative;
    }

        .qdrat-input-wrapper i {
            position: absolute;
            top: 50%;
            right: 15px;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 15px;
            z-index: 2;
        }

    .qdrat-input {
        height: 48px;
        border-radius: 16px;
        border: 1px solid #dbe3ef;
        background: #fff;
        padding: 10px 44px 10px 14px;
        color: #111827;
        font-size: 14px;
        font-weight: 700;
        transition: all 0.18s ease-in-out;
    }

        .qdrat-input:focus {
            border-color: #0f766e;
            box-shadow: 0 0 0 4px rgba(15, 118, 110, 0.10);
        }

    .qdrat-help-text {
        display: block;
        color: #64748b;
        font-size: 12px;
        font-weight: 700;
        margin-top: 7px;
    }

    .qdrat-permissions-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .qdrat-toggle-card {
        position: relative;
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 66px;
        padding: 14px 16px;
        border-radius: 18px;
        background: #fff;
        border: 1px solid #e2e8f0;
        cursor: pointer;
        transition: all 0.18s ease-in-out;
        color: #0f172a;
        font-size: 14px;
        font-weight: 900;
    }

        .qdrat-toggle-card:hover {
            border-color: #0f766e;
            transform: translateY(-1px);
            box-shadow: 0 12px 24px rgba(15, 23, 42, 0.06);
        }

        .qdrat-toggle-card input {
            width: 19px;
            height: 19px;
            accent-color: #0f766e;
            flex-shrink: 0;
        }

    .qdrat-toggle-box {
        width: 38px;
        height: 38px;
        border-radius: 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #0f766e;
        background: #ecfeff;
        flex-shrink: 0;
    }

    .qdrat-toggle-card small {
        display: block;
        margin-top: 4px;
        color: #64748b;
        font-size: 12px;
        font-weight: 700;
        line-height: 1.7;
    }

    .qdrat-toggle-card-wide {
        grid-column: 1 / -1;
    }

    .qdrat-table-wrapper {
        overflow-x: auto;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        background: #fff;
    }

    .qdrat-table {
        margin: 0;
        min-width: 640px;
    }

        .qdrat-table thead th {
            background: #f8fafc;
            color: #0f172a;
            font-size: 13px;
            font-weight: 900;
            border-bottom: 1px solid #e5e7eb;
            padding: 14px;
        }

        .qdrat-table tbody td {
            padding: 14px;
            border-color: #eef2f7;
            color: #111827;
            font-size: 14px;
            font-weight: 800;
        }

    .qdrat-course-name {
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .qdrat-course-name i {
            color: #2563eb;
        }

    .qdrat-table-check {
        width: 19px;
        height: 19px;
        accent-color: #0f766e;
        cursor: pointer;
    }

    .qdrat-info {
        color: #2563eb;
        font-weight: 900;
        cursor: help;
    }

    .qdrat-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding-top: 8px;
        flex-wrap: wrap;
    }

    .qdrat-save-btn,
    .qdrat-cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-width: 170px;
        min-height: 48px;
        border-radius: 999px;
        font-size: 15px;
        font-weight: 900;
        text-decoration: none;
        border: none;
        transition: all 0.2s ease-in-out;
    }

    .qdrat-save-btn {
        color: #fff;
        background: linear-gradient(135deg, #16a34a 0%, #0f766e 100%);
        box-shadow: 0 14px 30px rgba(22, 163, 74, 0.22);
    }

        .qdrat-save-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 18px 34px rgba(22, 163, 74, 0.28);
        }

    .qdrat-cancel-btn {
        color: #334155;
        background: #fff;
        border: 1px solid #cbd5e1;
    }

        .qdrat-cancel-btn:hover {
            color: #0f172a;
            background: #f8fafc;
            transform: translateY(-1px);
        }

    @@media (max-width: 768px) {
        .qdrat-page-header {
            flex-direction: column;
            align-items: stretch;
            padding: 20px;
        }

        .qdrat-page-title {
            font-size: 21px;
        }

        .qdrat-back-btn {
            width: 100%;
        }

        .qdrat-form-card {
            padding: 18px;
            border-radius: 22px;
        }

        .qdrat-section {
            padding: 16px;
        }

        .qdrat-permissions-grid {
            grid-template-columns: 1fr;
        }

        .qdrat-actions {
            flex-direction: column;
        }

        .qdrat-save-btn,
        .qdrat-cancel-btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
