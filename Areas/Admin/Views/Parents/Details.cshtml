@model QdratNew.ViewModels.Parent.ParentDetailsViewModel
@using QdratNew.Entities
@{
    ViewData["Title"] = $"تفاصيل وليّ الأمر — {Model.FullName}";
}

@section Styles {
<style>
:root {
    --pd-primary:       #7c3aed;
    --pd-primary-dark:  #5b21b6;
    --pd-primary-light: #ede9fe;
    --pd-success:       #10b981;
    --pd-warning:       #f59e0b;
    --pd-danger:        #ef4444;
    --pd-info:          #3b82f6;
    --pd-surface:       #ffffff;
    --pd-surface-2:     #f8fafc;
    --pd-border:        #e2e8f0;
    --pd-text-1:        #0f172a;
    --pd-text-2:        #475569;
    --pd-text-3:        #94a3b8;
    --pd-shadow-sm:     0 1px 3px rgba(0,0,0,.06);
    --pd-shadow-md:     0 4px 16px rgba(0,0,0,.08);
    --pd-shadow-lg:     0 10px 40px rgba(0,0,0,.14);
    --pd-radius:        14px;
    --pd-radius-sm:     8px;
    --pd-transition:    0.22s cubic-bezier(.4,0,.2,1);
}

.pdetails-page { font-family: 'Cairo', sans-serif; }

/* ── Hero profile card ── */
.profile-hero {
    background: linear-gradient(135deg, #1e0a3c 0%, #4c1d95 50%, #7c3aed 100%);
    border-radius: var(--pd-radius);
    padding: 2rem;
    margin-bottom: 1.75rem;
    color: #fff;
    position: relative;
    overflow: hidden;
}
.profile-hero::before {
    content: '';
    position: absolute; inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Ccircle cx='30' cy='30' r='20'/%3E%3C/g%3E%3C/svg%3E");
}
.profile-hero-inner {
    position: relative; z-index: 1;
    display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap;
}
.profile-avatar-lg {
    width: 80px; height: 80px; border-radius: 50%;
    background: rgba(255,255,255,.2);
    border: 3px solid rgba(255,255,255,.4);
    display: flex; align-items: center; justify-content: center;
    font-size: 2.2rem; font-weight: 800; flex-shrink: 0;
    backdrop-filter: blur(8px);
}
.profile-info { flex: 1; }
.profile-info h1 { font-size: 1.6rem; font-weight: 800; margin: 0 0 .3rem; }
.profile-meta { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: .5rem; }
.profile-meta-item {
    display: inline-flex; align-items: center; gap: .3rem;
    background: rgba(255,255,255,.15); border: 1px solid rgba(255,255,255,.2);
    border-radius: 50px; padding: .25rem .75rem; font-size: .8rem;
    backdrop-filter: blur(6px);
}
.profile-actions { display: flex; gap: .6rem; flex-wrap: wrap; }
.btn-hero {
    display: inline-flex; align-items: center; gap: .4rem;
    padding: .55rem 1.1rem; border-radius: 50px; border: none;
    font-family: 'Cairo', sans-serif; font-size: .85rem; font-weight: 700;
    cursor: pointer; text-decoration: none; transition: all var(--pd-transition);
}
.btn-hero-light { background: rgba(255,255,255,.2); color: #fff; border: 1px solid rgba(255,255,255,.3); }
.btn-hero-light:hover { background: rgba(255,255,255,.3); color: #fff; }
.btn-hero-danger { background: rgba(239,68,68,.25); color: #fca5a5; border: 1px solid rgba(239,68,68,.35); }
.btn-hero-danger:hover { background: rgba(239,68,68,.4); color: #fff; }

/* ── Info cards grid ── */
.info-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(220px,1fr));
    gap: 1rem; margin-bottom: 1.75rem;
}
.info-card {
    background: var(--pd-surface); border: 1px solid var(--pd-border);
    border-radius: var(--pd-radius); padding: 1.2rem 1.4rem;
    box-shadow: var(--pd-shadow-sm); display: flex; gap: 1rem; align-items: flex-start;
}
.info-icon {
    width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; font-size: 1.15rem;
}
.info-icon.purple { background: #ede9fe; color: var(--pd-primary); }
.info-icon.green  { background: #d1fae5; color: var(--pd-success); }
.info-icon.blue   { background: #dbeafe; color: var(--pd-info); }
.info-icon.amber  { background: #fef3c7; color: var(--pd-warning); }
.info-icon.pink   { background: #fce7f3; color: #9d174d; }
.info-lbl  { font-size: .75rem; color: var(--pd-text-3); font-weight: 600; margin-bottom: .2rem; }
.info-val  { font-size: .95rem; font-weight: 700; color: var(--pd-text-1); }
.info-val.mono { direction: ltr; text-align: right; }

/* ── Section header ── */
.section-hdr {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 1rem; padding-bottom: .75rem;
    border-bottom: 2px solid var(--pd-primary-light);
}
.section-hdr h2 {
    font-size: 1.1rem; font-weight: 800; color: var(--pd-text-1);
    display: flex; align-items: center; gap: .5rem; margin: 0;
}
.section-hdr h2 span { font-size: .75rem; background: var(--pd-primary-light); color: var(--pd-primary); padding: .15rem .55rem; border-radius: 50px; font-weight: 700; }

/* ── Student cards grid ── */
.students-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
}

.student-card {
    background: var(--pd-surface); border: 1px solid var(--pd-border);
    border-radius: var(--pd-radius); box-shadow: var(--pd-shadow-sm);
    overflow: hidden; transition: transform var(--pd-transition), box-shadow var(--pd-transition);
}
.student-card:hover { transform: translateY(-3px); box-shadow: var(--pd-shadow-md); }

.student-card-top {
    padding: 1.2rem; display: flex; align-items: center; gap: 1rem;
    border-bottom: 1px solid var(--pd-border);
}
.student-avatar {
    width: 50px; height: 50px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem; font-weight: 800; color: #fff;
}
.avatar-male   { background: linear-gradient(135deg, #3b82f6, #1d4ed8); }
.avatar-female { background: linear-gradient(135deg, #ec4899, #9d174d); }

.student-name { font-weight: 800; font-size: .95rem; color: var(--pd-text-1); }
.student-id   { font-size: .75rem; color: var(--pd-text-3); margin-top: .1rem; }

.status-badge {
    display: inline-flex; align-items: center; gap: .25rem;
    padding: .2rem .6rem; border-radius: 50px;
    font-size: .72rem; font-weight: 700; margin-top: .3rem;
}
.status-active   { background: #d1fae5; color: #065f46; }
.status-inactive { background: #fee2e2; color: #991b1b; }

.student-card-stats {
    padding: .85rem 1.2rem;
    display: grid; grid-template-columns: 1fr 1fr; gap: .5rem;
}
.stat-mini { text-align: center; }
.stat-mini .val { font-size: 1.2rem; font-weight: 800; color: var(--pd-text-1); }
.stat-mini .lbl { font-size: .7rem; color: var(--pd-text-3); margin-top: .1rem; }

.score-bar {
    height: 5px; border-radius: 10px; background: var(--pd-border); overflow: hidden; margin-top: .35rem;
}
.score-fill { height: 100%; border-radius: 10px; transition: width .6s ease; }
.fill-success { background: var(--pd-success); }
.fill-info    { background: var(--pd-info); }
.fill-warning { background: var(--pd-warning); }
.fill-danger  { background: var(--pd-danger); }

.student-card-footer {
    padding: .75rem 1.2rem; border-top: 1px solid var(--pd-border);
    display: flex; gap: .5rem; background: var(--pd-surface-2);
}
.btn-card {
    flex: 1; padding: .5rem; border-radius: var(--pd-radius-sm); border: none;
    font-family: 'Cairo', sans-serif; font-size: .8rem; font-weight: 700;
    cursor: pointer; text-decoration: none; text-align: center;
    display: flex; align-items: center; justify-content: center; gap: .35rem;
    transition: all var(--pd-transition);
}
.btn-card-primary { background: var(--pd-primary-light); color: var(--pd-primary); }
.btn-card-primary:hover { background: var(--pd-primary); color: #fff; }
.btn-card-green { background: #d1fae5; color: #065f46; }
.btn-card-green:hover { background: var(--pd-success); color: #fff; }

/* ── Empty ── */
.empty-students {
    text-align: center; padding: 3rem 2rem;
    border: 2px dashed var(--pd-border); border-radius: var(--pd-radius);
    color: var(--pd-text-2);
}
.empty-students .ei { font-size: 3rem; opacity: .4; margin-bottom: .75rem; }

/* ── Account section ── */
.account-section {
    background: var(--pd-surface); border: 1px solid var(--pd-border);
    border-radius: var(--pd-radius); box-shadow: var(--pd-shadow-sm);
    padding: 1.4rem; margin-bottom: 1.75rem;
}
.account-row { display: flex; align-items: center; gap: .75rem; padding: .6rem 0; border-bottom: 1px solid var(--pd-border); }
.account-row:last-child { border-bottom: none; padding-bottom: 0; }
.account-row .ar-icon { width: 32px; height: 32px; border-radius: 8px; background: var(--pd-primary-light); color: var(--pd-primary); display: flex; align-items: center; justify-content: center; font-size: .9rem; flex-shrink: 0; }
.account-row .ar-lbl { font-size: .78rem; color: var(--pd-text-3); }
.account-row .ar-val { font-size: .9rem; font-weight: 700; color: var(--pd-text-1); }

/* ── Level badge helper ── */
.level-tag {
    display: inline-block; padding: .15rem .55rem; border-radius: 50px;
    font-size: .72rem; font-weight: 700;
}
.level-ممتاز    { background: #d1fae5; color: #065f46; }
.level-جيدجدا   { background: #dbeafe; color: #1d4ed8; }
.level-جيد      { background: #fef3c7; color: #92400e; }
.level-مقبول    { background: #f3f4f6; color: #374151; }
.level-ضعيف     { background: #fee2e2; color: #991b1b; }
</style>
}

<div class="pdetails-page">

    {{!-- Hero --}}
    <div class="profile-hero">
        <div class="profile-hero-inner">
            <div class="profile-avatar-lg">@Model.FullName[0]</div>
            <div class="profile-info">
                <h1>@Model.FullName</h1>
                <div class="profile-meta">
                    <span class="profile-meta-item">
                        @{
                            var relIcons = new Dictionary<string, string> {
                                {"أب","👨"}, {"أم","👩"}, {"أخو","🧑"}, {"أخرى","👤"}
                            };
                            var relIcon = relIcons.ContainsKey(Model.RelationToStudent.ToString())
                                ? relIcons[Model.RelationToStudent.ToString()] : "👤";
                        }
                        @relIcon @Model.RelationToStudent
                    </span>
                    <span class="profile-meta-item"><i class="fas fa-phone"></i> @Model.PhoneNumber</span>
                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <span class="profile-meta-item"><i class="fas fa-envelope"></i> @Model.Email</span>
                    }
                    <span class="profile-meta-item">
                        <i class="fas fa-users"></i> @Model.Students.Count طالب مرتبط
                    </span>
                    @if (Model.HasUserAccount)
                    {
                        <span class="profile-meta-item" style="background:rgba(16,185,129,.25)">
                            <i class="fas fa-check"></i> لديه حساب تسجيل دخول
                        </span>
                    }
                </div>
            </div>
            <div class="profile-actions">
                <a asp-action="Edit" asp-route-id="@Model.ParentID" class="btn-hero btn-hero-light">
                    <i class="fas fa-edit"></i> تعديل
                </a>
                <a asp-action="Delete" asp-route-id="@Model.ParentID" class="btn-hero btn-hero-danger">
                    <i class="fas fa-trash"></i> حذف
                </a>
                <a asp-action="Index" class="btn-hero btn-hero-light">
                    <i class="fas fa-arrow-right"></i> العودة
                </a>
            </div>
        </div>
    </div>

    {{!-- Info Cards --}}
    <div class="info-grid">
        <div class="info-card">
            <div class="info-icon purple"><i class="fas fa-id-badge"></i></div>
            <div>
                <div class="info-lbl">الرقم القومي</div>
                <div class="info-val mono">@Model.NationalID</div>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.WhatsAppNumber))
        {
            <div class="info-card">
                <div class="info-icon green"><i class="fab fa-whatsapp"></i></div>
                <div>
                    <div class="info-lbl">واتساب</div>
                    <div class="info-val mono">@Model.WhatsAppNumber</div>
                </div>
            </div>
        }
        <div class="info-card">
            <div class="info-icon amber"><i class="fas fa-calendar-alt"></i></div>
            <div>
                <div class="info-lbl">تاريخ التسجيل</div>
                <div class="info-val">@Model.DateCreated.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("ar-EG"))</div>
            </div>
        </div>
        <div class="info-card">
            <div class="info-icon blue"><i class="fas fa-users"></i></div>
            <div>
                <div class="info-lbl">عدد الطلاب</div>
                <div class="info-val">@Model.Students.Count طالب</div>
            </div>
        </div>
    </div>

    {{!-- Account info --}}
    @if (Model.HasUserAccount)
    {
        <div class="account-section">
            <div class="section-hdr" style="margin-bottom:.85rem">
                <h2><i class="fas fa-lock" style="color:var(--pd-success)"></i> حساب الدخول</h2>
            </div>
            @if (!string.IsNullOrEmpty(Model.UserEmail))
            {
                <div class="account-row">
                    <div class="ar-icon"><i class="fas fa-envelope"></i></div>
                    <div><div class="ar-lbl">البريد الإلكتروني</div><div class="ar-val">@Model.UserEmail</div></div>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.UserName))
            {
                <div class="account-row">
                    <div class="ar-icon"><i class="fas fa-user"></i></div>
                    <div><div class="ar-lbl">اسم المستخدم</div><div class="ar-val">@Model.UserName</div></div>
                </div>
            }
        </div>
    }

    {{!-- Students Section --}}
    <div class="section-hdr">
        <h2>
            <i class="fas fa-school" style="color:var(--pd-primary)"></i>
            الطلاب المرتبطون
            <span>@Model.Students.Count</span>
        </h2>
        <a asp-action="Edit" asp-route-id="@Model.ParentID"
           style="font-size:.82rem;color:var(--pd-primary);text-decoration:none;font-weight:700">
            <i class="fas fa-edit"></i> تعديل الطلاب
        </a>
    </div>

    @if (!Model.Students.Any())
    {
        <div class="empty-students">
            <div class="ei">🎓</div>
            <p>لم يتم ربط أي طالب بهذا وليّ الأمر بعد</p>
            <a asp-action="Edit" asp-route-id="@Model.ParentID" style="color:var(--pd-primary);font-weight:700">
                <i class="fas fa-plus"></i> ربط طلاب الآن
            </a>
        </div>
    }
    else
    {
        <div class="students-grid">
            @foreach (var s in Model.Students)
            {
                var avatarClass = s.Gender == "ذكر" || s.Gender == "Male" ? "avatar-male" : "avatar-female";
                var statusClass = s.EnrollmentStatus == "نشط" || s.EnrollmentStatus == "Active" ? "status-active" : "status-inactive";
                var hw = s.AvgHomeworkScore ?? 0;
                var placement = s.LastPlacementScore ?? 0;
                var kpi = s.LastKpiScore ?? 0;
                string FillClass(double score) => score >= 75 ? "fill-success" : score >= 50 ? "fill-warning" : "fill-danger";

                <div class="student-card">
                    <div class="student-card-top">
                        <div class="student-avatar @avatarClass">@s.FullName[0]</div>
                        <div>
                            <div class="student-name">@s.FullName</div>
                            <div class="student-id">@s.NationalID</div>
                            <span class="status-badge @statusClass">
                                <i class="@(statusClass == "status-active" ? "fas fa-check" : "fas fa-times")"></i>
                                @s.EnrollmentStatus
                            </span>
                        </div>
                        <div style="margin-right:auto;text-align:center">
                            @if (!string.IsNullOrEmpty(s.Level))
                            {
                                var lvlClass = s.Level?.Replace(" ","") == "جيدجداً" ? "level-جيدجدا" : "level-" + s.Level?.Replace(" ","");
                                <span class="level-tag @lvlClass">@s.Level</span>
                            }
                            @if (!string.IsNullOrEmpty(s.School))
                            {
                                <div style="font-size:.72rem;color:var(--pd-text-3);margin-top:.3rem">@s.School</div>
                            }
                        </div>
                    </div>

                    <div class="student-card-stats">
                        <div class="stat-mini">
                            <div class="val">@s.HomeworkCount</div>
                            <div class="lbl">واجبات</div>
                            @if (s.HomeworkCount > 0)
                            {
                                <div class="score-bar">
                                    <div class="score-fill @FillClass(hw)" style="width:@hw%"></div>
                                </div>
                                <div style="font-size:.7rem;color:var(--pd-text-3)">متوسط @hw.ToString("0.0")%</div>
                            }
                        </div>
                        <div class="stat-mini">
                            <div class="val">@(placement > 0 ? placement.ToString("0") + "%" : "—")</div>
                            <div class="lbl">تحديد مستوى</div>
                            @if (placement > 0)
                            {
                                <div class="score-bar">
                                    <div class="score-fill @FillClass(placement)" style="width:@placement%"></div>
                                </div>
                            }
                        </div>
                        <div class="stat-mini">
                            <div class="val">@(kpi > 0 ? kpi.ToString("0") + "%" : "—")</div>
                            <div class="lbl">مؤشر الأداء</div>
                            @if (kpi > 0)
                            {
                                <div class="score-bar">
                                    <div class="score-fill @FillClass(kpi)" style="width:@kpi%"></div>
                                </div>
                            }
                        </div>
                        <div class="stat-mini">
                            <div class="val">@s.Age</div>
                            <div class="lbl">سنة العمر</div>
                        </div>
                    </div>

                    <div class="student-card-footer">
                        <a asp-controller="Students" asp-action="Details" asp-route-id="@s.StudentID" class="btn-card btn-card-primary">
                            <i class="fas fa-eye"></i> ملف الطالب
                        </a>
                        <a asp-action="StudentReport" asp-route-id="@Model.ParentID" asp-route-studentId="@s.StudentID" class="btn-card btn-card-green">
                            <i class="fas fa-chart-bar"></i> التقرير
                        </a>
                    </div>
                </div>
            }
        </div>
    }

</div>
