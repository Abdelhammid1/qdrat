@model QdratNew.ViewModels.Parent.ParentFormViewModel
@using QdratNew.Entities
@{
    ViewData["Title"] = "إضافة وليّ أمر جديد";
}

@section Styles {
<style>
:root {
    --pf-primary:      #7c3aed;
    --pf-primary-dark: #5b21b6;
    --pf-primary-light:#ede9fe;
    --pf-success:      #10b981;
    --pf-danger:       #ef4444;
    --pf-warning:      #f59e0b;
    --pf-surface:      #ffffff;
    --pf-surface-2:    #f8fafc;
    --pf-border:       #e2e8f0;
    --pf-text-1:       #0f172a;
    --pf-text-2:       #475569;
    --pf-text-3:       #94a3b8;
    --pf-shadow-sm:    0 1px 3px rgba(0,0,0,.06);
    --pf-shadow-md:    0 4px 16px rgba(0,0,0,.08);
    --pf-radius:       14px;
    --pf-radius-sm:    8px;
    --pf-transition:   0.22s cubic-bezier(.4,0,.2,1);
}

.pform-page { font-family: 'Cairo', sans-serif; }

/* ── Page Header ── */
.pform-header {
    display: flex; align-items: center; gap: 1rem;
    margin-bottom: 2rem;
}
.pform-header-icon {
    width: 52px; height: 52px; border-radius: 14px;
    background: linear-gradient(135deg, var(--pf-primary), var(--pf-primary-dark));
    display: flex; align-items: center; justify-content: center;
    font-size: 1.5rem; color: #fff;
    box-shadow: 0 4px 14px rgba(124,58,237,.35);
}
.pform-header h1 { font-size: 1.55rem; font-weight: 800; color: var(--pf-text-1); margin: 0; }
.pform-header p  { color: var(--pf-text-2); font-size: .9rem; margin: .2rem 0 0; }

/* ── Layout ── */
.pform-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 1.5rem;
    align-items: start;
}
@@media (max-width: 900px) {
    .pform-layout { grid-template-columns: 1fr; }
}

/* ── Cards ── */
.pform-card {
    background: var(--pf-surface);
    border: 1px solid var(--pf-border);
    border-radius: var(--pf-radius);
    box-shadow: var(--pf-shadow-sm);
    overflow: hidden;
    margin-bottom: 1.25rem;
}
.pform-card-header {
    padding: 1rem 1.4rem;
    border-bottom: 1px solid var(--pf-border);
    background: linear-gradient(to left, #f8f7ff, #f1f0fe);
    display: flex; align-items: center; gap: .7rem;
}
.pform-card-header .ch-icon {
    width: 34px; height: 34px; border-radius: 9px;
    background: var(--pf-primary-light); color: var(--pf-primary);
    display: flex; align-items: center; justify-content: center;
    font-size: 1rem;
}
.pform-card-header h2 { font-size: 1rem; font-weight: 700; color: var(--pf-text-1); margin: 0; }
.pform-card-body { padding: 1.4rem; }

/* ── Form fields ── */
.field-group { margin-bottom: 1.25rem; }
.field-group:last-child { margin-bottom: 0; }
.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
@@media (max-width: 600px) { .field-row { grid-template-columns: 1fr; } }

.field-label {
    display: block; font-size: .82rem; font-weight: 700;
    color: var(--pf-text-1); margin-bottom: .4rem;
}
.field-label .req { color: var(--pf-danger); margin-right: .2rem; }

.field-input {
    width: 100%; border: 1.5px solid var(--pf-border);
    border-radius: var(--pf-radius-sm); padding: .65rem .9rem;
    font-family: 'Cairo', sans-serif; font-size: .9rem; color: var(--pf-text-1);
    background: var(--pf-surface-2); outline: none;
    transition: border-color var(--pf-transition), box-shadow var(--pf-transition);
    box-sizing: border-box;
}
.field-input:focus {
    border-color: var(--pf-primary);
    box-shadow: 0 0 0 3px rgba(124,58,237,.1);
    background: #fff;
}
.field-input.is-invalid { border-color: var(--pf-danger); }

.field-error {
    color: var(--pf-danger); font-size: .78rem; margin-top: .3rem; display: block;
}

/* ── Relation radio cards ── */
.relation-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: .6rem;
}
@@media (max-width: 500px) { .relation-grid { grid-template-columns: 1fr 1fr; } }
.relation-option { display: none; }
.relation-label {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: .3rem; padding: .75rem .5rem;
    border: 2px solid var(--pf-border); border-radius: var(--pf-radius-sm);
    cursor: pointer; transition: all var(--pf-transition);
    background: var(--pf-surface-2); font-size: .82rem; font-weight: 700; color: var(--pf-text-2);
    text-align: center;
}
.relation-label .rl-icon { font-size: 1.4rem; }
.relation-option:checked + .relation-label {
    border-color: var(--pf-primary); background: var(--pf-primary-light);
    color: var(--pf-primary);
    box-shadow: 0 0 0 3px rgba(124,58,237,.15);
}

/* ── Student picker ── */
.student-search {
    display: flex; align-items: center; gap: .5rem;
    border: 1.5px solid var(--pf-border); border-radius: var(--pf-radius-sm);
    padding: .5rem .85rem; margin-bottom: .85rem;
    background: var(--pf-surface-2);
    transition: border-color var(--pf-transition);
}
.student-search:focus-within { border-color: var(--pf-primary); }
.student-search input { border: none; background: transparent; outline: none; flex: 1; font-family: 'Cairo', sans-serif; font-size: .88rem; }

.student-list { max-height: 340px; overflow-y: auto; }
.student-list::-webkit-scrollbar { width: 5px; }
.student-list::-webkit-scrollbar-track { background: var(--pf-surface-2); }
.student-list::-webkit-scrollbar-thumb { background: var(--pf-border); border-radius: 10px; }

.student-item {
    display: flex; align-items: center; gap: .75rem;
    padding: .7rem .85rem; border-radius: var(--pf-radius-sm);
    cursor: pointer; transition: background var(--pf-transition);
    border-bottom: 1px solid var(--pf-border);
}
.student-item:last-child { border-bottom: none; }
.student-item:hover { background: #faf9ff; }
.student-item input[type=checkbox] { width: 16px; height: 16px; accent-color: var(--pf-primary); cursor: pointer; }
.student-avatar-sm {
    width: 34px; height: 34px; border-radius: 50%;
    background: linear-gradient(135deg, #7c3aed, #5b21b6);
    color: #fff; display: flex; align-items: center; justify-content: center;
    font-size: .8rem; font-weight: 800; flex-shrink: 0;
}
.student-name { font-size: .88rem; font-weight: 700; color: var(--pf-text-1); }
.student-meta { font-size: .75rem; color: var(--pf-text-3); }

.selected-count {
    display: inline-flex; align-items: center; gap: .3rem;
    background: var(--pf-primary-light); color: var(--pf-primary);
    border-radius: 50px; padding: .2rem .65rem; font-size: .78rem; font-weight: 700;
    margin-bottom: .5rem;
}

/* ── Sidebar card ── */
.summary-card {
    background: linear-gradient(160deg, #f8f7ff 0%, #ede9fe 100%);
    border: 1.5px solid #c4b5fd; border-radius: var(--pf-radius);
    padding: 1.4rem; margin-bottom: 1.25rem;
}
.summary-card h3 { font-size: .95rem; font-weight: 800; color: var(--pf-primary); margin: 0 0 1rem; display: flex; align-items: center; gap: .5rem; }
.summary-row { display: flex; align-items: center; gap: .5rem; margin-bottom: .7rem; font-size: .85rem; color: var(--pf-text-2); }
.summary-row strong { color: var(--pf-text-1); font-weight: 700; }

/* ── Buttons ── */
.btn-primary {
    width: 100%; padding: .85rem; border: none; border-radius: var(--pf-radius-sm);
    background: linear-gradient(135deg, var(--pf-primary), var(--pf-primary-dark));
    color: #fff; font-family: 'Cairo', sans-serif; font-size: 1rem; font-weight: 800;
    cursor: pointer; display: flex; align-items: center; justify-content: center; gap: .6rem;
    transition: opacity var(--pf-transition), transform var(--pf-transition);
    box-shadow: 0 4px 14px rgba(124,58,237,.35);
    text-decoration: none;
}
.btn-primary:hover { opacity: .9; transform: translateY(-1px); }
.btn-secondary {
    width: 100%; padding: .75rem; border: 1.5px solid var(--pf-border); border-radius: var(--pf-radius-sm);
    background: var(--pf-surface); color: var(--pf-text-2); font-family: 'Cairo', sans-serif;
    font-size: .9rem; font-weight: 600; cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: .5rem;
    transition: background var(--pf-transition);
    text-decoration: none; margin-top: .6rem;
}
.btn-secondary:hover { background: var(--pf-surface-2); color: var(--pf-text-1); }
</style>
}

<div class="pform-page">
    <div class="pform-header">
        <div class="pform-header-icon"><i class="fas fa-user-plus"></i></div>
        <div>
            <h1>إضافة وليّ أمر جديد</h1>
            <p>قم بملء البيانات وربط الطلاب بوليّ الأمر</p>
        </div>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="pform-layout">

@*             {{!-- Main column --}}
 *@        
 
 <div>

                @* {{!-- بيانات ولي الأمر --}} *@
                <div class="pform-card">
                    <div class="pform-card-header">
                        <div class="ch-icon"><i class="fas fa-id-badge"></i></div>
                        <h2>البيانات الشخصية</h2>
                    </div>
                    <div class="pform-card-body">
                        <div class="field-row">
                            <div class="field-group">
                                <label class="field-label" asp-for="FullName"><span class="req">*</span> الاسم الكامل</label>
                                <input asp-for="FullName" class="field-input @(ViewData.ModelState["FullName"]?.Errors.Any() == true ? "is-invalid" : "")" placeholder="مثال: أحمد محمد السيد" />
                                <span asp-validation-for="FullName" class="field-error"></span>
                            </div>
                            <div class="field-group">
                                <label class="field-label" asp-for="NationalID"><span class="req">*</span> الرقم القومي</label>
                                <input asp-for="NationalID" class="field-input @(ViewData.ModelState["NationalID"]?.Errors.Any() == true ? "is-invalid" : "")" placeholder="مثال: 29901010100123" maxlength="14" />
                                <span asp-validation-for="NationalID" class="field-error"></span>
                            </div>
                        </div>
                        <div class="field-row">
                            <div class="field-group">
                                <label class="field-label" asp-for="PhoneNumber"><span class="req">*</span> رقم الهاتف</label>
                                <input asp-for="PhoneNumber" class="field-input @(ViewData.ModelState["PhoneNumber"]?.Errors.Any() == true ? "is-invalid" : "")" placeholder="01xxxxxxxxx" dir="ltr" />
                                <span asp-validation-for="PhoneNumber" class="field-error"></span>
                            </div>
                            <div class="field-group">
                                <label class="field-label" asp-for="WhatsAppNumber">رقم الواتساب</label>
                                <input asp-for="WhatsAppNumber" class="field-input" placeholder="01xxxxxxxxx (اختياري)" dir="ltr" />
                                <span asp-validation-for="WhatsAppNumber" class="field-error"></span>
                            </div>
                        </div>
                        <div class="field-group">
                            <label class="field-label" asp-for="Email">البريد الإلكتروني</label>
                            <input asp-for="Email" type="email" class="field-input" placeholder="example@mail.com (اختياري)" dir="ltr" />
                            <span asp-validation-for="Email" class="field-error"></span>
                        </div>
                    </div>
                </div>

                @* {{!-- صلة القرابة --}} *@
                <div class="pform-card">
                    <div class="pform-card-header">
                        <div class="ch-icon"><i class="fas fa-heart"></i></div>
                        <h2>صلة القرابة بالطالب</h2>
                    </div>
                    <div class="pform-card-body">
                        <div class="relation-grid">
                            @foreach (ParentRelation rel in Enum.GetValues(typeof(ParentRelation)))
                            {
                                var icons = new Dictionary<ParentRelation, string> {
                                    { ParentRelation.أب, "👨" },
                                    { ParentRelation.أم, "👩" },
                                    { ParentRelation.أخو, "🧑" },
                                    { ParentRelation.أخرى, "👤" }
                                };
                                <div>
                                    <input type="radio" name="RelationToStudent" id="rel_@rel" value="@((int)rel)"
                                           class="relation-option"
                                           @(Model.RelationToStudent == rel ? "checked" : "") />
                                    <label for="rel_@rel" class="relation-label">
                                        <span class="rl-icon">@icons[rel]</span>
                                        @rel
                                    </label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="RelationToStudent" class="field-error" style="margin-top:.5rem;display:block"></span>
                    </div>
                </div>

               @*  {{!-- حساب المستخدم --}} *@
                <div class="pform-card">
                    <div class="pform-card-header">
                        <div class="ch-icon"><i class="fas fa-lock"></i></div>
                        <h2>ربط بحساب مستخدم (اختياري)</h2>
                    </div>
                    <div class="pform-card-body">
                        <div class="field-group" style="margin:0">
                            <label class="field-label" asp-for="UserId">اختر حساباً موجوداً</label>
                            <select asp-for="UserId" asp-items="Model.AvailableUsers" class="field-input"></select>
                        </div>
                    </div>
                </div>

            </div>

          @*   {{!-- Sidebar --}} *@
            <div>

               @*  {{!-- ربط الطلاب --}} *@
                <div class="pform-card">
                    <div class="pform-card-header">
                        <div class="ch-icon"><i class="fas fa-school"></i></div>
                        <h2>ربط الطلاب</h2>
                    </div>
                    <div class="pform-card-body" style="padding-bottom:.5rem">
                        <div class="selected-count" id="selCount">
                            <i class="fas fa-check"></i>
                            <span id="selNum">0</span> طالب مختار
                        </div>
                        <div class="student-search">
                            <i class="fas fa-search" style="color:#94a3b8"></i>
                            <input type="text" id="studentSearch" placeholder="بحث في الطلاب…" oninput="filterStudents(this.value)" />
                        </div>
                        <div class="student-list" id="studentList">
                            @if (!Model.AvailableStudents.Any())
                            {
                                <div style="text-align:center;padding:1.5rem;color:var(--pf-text-3);font-size:.85rem">
                                    <div style="font-size:2rem;margin-bottom:.5rem">🎓</div>
                                    لا توجد طلاب بدون وليّ أمر
                                </div>
                            }
                            else
                            {
                                @foreach (var s in Model.AvailableStudents)
                                {
                                    <div class="student-item" onclick="toggleStudent(this)" data-name="@s.FullName.ToLower()">
                                        <input type="checkbox" name="SelectedStudentIds" value="@s.StudentID"
                                               id="stu_@s.StudentID"
                                               @(s.IsSelected ? "checked" : "")
                                               onclick="event.stopPropagation()" onchange="updateCount()" />
                                        <div class="student-avatar-sm">@s.FullName[0]</div>
                                        <div style="flex:1;min-width:0">
                                            <div class="student-name">@s.FullName</div>
                                            <div class="student-meta">
                                                @s.NationalID
                                                @if (!string.IsNullOrEmpty(s.Level)) { <span> · @s.Level</span> }
                                                @if (!string.IsNullOrEmpty(s.School)) { <span> · @s.School</span> }
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                @* {{!-- ملخص --}} *@
                <div class="summary-card">
                    <h3><i class="fas fa-info-circle"></i> ملاحظات</h3>
                    <div class="summary-row"><i class="fas fa-circle" style="color:var(--pf-primary)"></i> يمكن ربط أكثر من طالب بنفس وليّ الأمر</div>
                    <div class="summary-row"><i class="fas fa-circle" style="color:var(--pf-primary)"></i> الطلاب المعروضون هم من ليس لديهم وليّ أمر حالياً</div>
                    <div class="summary-row"><i class="fas fa-circle" style="color:var(--pf-primary)"></i> ربط حساب مستخدم يتيح لوليّ الأمر تسجيل الدخول</div>
                </div>

                <button type="submit" class="btn-primary">
                    <i class="fas fa-save"></i> حفظ وليّ الأمر
                </button>
                <a asp-action="Index" class="btn-secondary">
                    <i class="fas fa-arrow-right"></i> إلغاء والعودة
                </a>

            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
    function updateCount() {
        const n = document.querySelectorAll('#studentList input[type=checkbox]:checked').length;
        document.getElementById('selNum').textContent = n;
    }

    function toggleStudent(item) {
        const cb = item.querySelector('input[type=checkbox]');
        cb.checked = !cb.checked;
        updateCount();
    }

    function filterStudents(q) {
        q = q.toLowerCase();
        document.querySelectorAll('#studentList .student-item').forEach(item => {
            item.style.display = item.dataset.name.includes(q) ? '' : 'none';
        });
    }

    document.addEventListener('DOMContentLoaded', updateCount);
</script>
@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
