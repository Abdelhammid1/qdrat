@model QdratNew.Entities.Parent
@{
    ViewData["Title"] = $"حذف وليّ الأمر — {Model.FullName}";
    var studentsCount = Model.Students?.Count ?? 0;
}

@section Styles {
<style>
:root {
    --del-danger:       #ef4444;
    --del-danger-dark:  #b91c1c;
    --del-danger-light: #fee2e2;
    --del-warning:      #f59e0b;
    --del-warning-light:#fef3c7;
    --del-surface:      #ffffff;
    --del-surface-2:    #f8fafc;
    --del-border:       #e2e8f0;
    --del-text-1:       #0f172a;
    --del-text-2:       #475569;
    --del-text-3:       #94a3b8;
    --del-shadow-sm:    0 1px 3px rgba(0,0,0,.06);
    --del-shadow-md:    0 4px 16px rgba(0,0,0,.08);
    --del-radius:       14px;
    --del-radius-sm:    8px;
    --del-transition:   0.22s cubic-bezier(.4,0,.2,1);
}

.delete-page {
    font-family: 'Cairo', sans-serif;
    max-width: 600px; margin: 0 auto;
}

/* ── Danger card ── */
.danger-card {
    background: var(--del-surface);
    border: 1.5px solid var(--del-danger);
    border-radius: var(--del-radius);
    box-shadow: 0 0 0 4px rgba(239,68,68,.08), var(--del-shadow-md);
    overflow: hidden;
    animation: popIn .3s cubic-bezier(.34,1.56,.64,1);
}
@@keyframes popIn {
    from { opacity: 0; transform: scale(.95) translateY(10px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
}

.danger-header {
    background: linear-gradient(135deg, #7f1d1d, #b91c1c, #ef4444);
    padding: 1.75rem 2rem;
    display: flex; align-items: center; gap: 1rem; color: #fff;
}
.danger-icon-wrap {
    width: 60px; height: 60px; border-radius: 50%;
    background: rgba(255,255,255,.15); border: 2px solid rgba(255,255,255,.3);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.8rem; flex-shrink: 0;
    animation: pulse-ring 2s infinite;
}
@@keyframes pulse-ring {
    0%,100% { box-shadow: 0 0 0 0 rgba(255,255,255,.3); }
    50%      { box-shadow: 0 0 0 8px rgba(255,255,255,.0); }
}
.danger-header h1 { font-size: 1.3rem; font-weight: 800; margin: 0 0 .2rem; }
.danger-header p  { opacity: .8; font-size: .88rem; margin: 0; }

.danger-body { padding: 1.75rem 2rem; }

/* ── Parent summary ── */
.parent-summary {
    background: var(--del-surface-2); border: 1px solid var(--del-border);
    border-radius: var(--del-radius-sm); padding: 1.1rem 1.3rem;
    display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem;
}
.del-avatar {
    width: 48px; height: 48px; border-radius: 50%;
    background: linear-gradient(135deg, #7c3aed, #5b21b6);
    color: #fff; display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem; font-weight: 800; flex-shrink: 0;
}
.del-name { font-size: 1.05rem; font-weight: 800; color: var(--del-text-1); }
.del-meta { font-size: .82rem; color: var(--del-text-3); margin-top: .1rem; }

/* ── Warning box ── */
.warning-box {
    background: var(--del-warning-light); border: 1.5px solid #fde68a;
    border-radius: var(--del-radius-sm); padding: 1rem 1.25rem;
    margin-bottom: 1.25rem; display: flex; gap: .75rem;
}
.warning-box .wi { font-size: 1.4rem; flex-shrink: 0; margin-top: .1rem; }
.warning-box p { margin: 0; font-size: .87rem; color: #78350f; font-weight: 600; line-height: 1.5; }
.warning-box strong { color: #92400e; }

/* ── Students list preview ── */
.students-preview {
    margin-bottom: 1.25rem;
}
.students-preview-header {
    font-size: .82rem; font-weight: 700; color: var(--del-text-2);
    margin-bottom: .6rem; display: flex; align-items: center; gap: .4rem;
}
.student-chip {
    display: inline-flex; align-items: center; gap: .4rem;
    background: #ede9fe; color: #5b21b6; border-radius: 50px;
    padding: .25rem .75rem; font-size: .8rem; font-weight: 700; margin: .2rem;
}

/* ── Confirm phrase ── */
.confirm-box { margin-bottom: 1.25rem; }
.confirm-box label { font-size: .85rem; font-weight: 700; color: var(--del-text-1); display: block; margin-bottom: .4rem; }
.confirm-box .confirm-phrase {
    background: var(--del-danger-light); border: 1px solid #fca5a5;
    border-radius: var(--del-radius-sm); padding: .4rem .85rem;
    font-size: .82rem; font-weight: 700; color: var(--del-danger-dark);
    letter-spacing: .5px; margin-bottom: .5rem; display: inline-block;
}
.confirm-box input[type=text] {
    width: 100%; border: 1.5px solid var(--del-border); border-radius: var(--del-radius-sm);
    padding: .6rem .9rem; font-family: 'Cairo', sans-serif; font-size: .9rem;
    outline: none; transition: border-color var(--del-transition), box-shadow var(--del-transition);
    box-sizing: border-box;
}
.confirm-box input[type=text]:focus { border-color: var(--del-danger); box-shadow: 0 0 0 3px rgba(239,68,68,.1); }

/* ── Buttons ── */
.del-actions { display: flex; gap: .75rem; }
.btn-delete-confirm {
    flex: 1; padding: .85rem; border: none; border-radius: var(--del-radius-sm);
    background: linear-gradient(135deg, var(--del-danger), var(--del-danger-dark));
    color: #fff; font-family: 'Cairo', sans-serif; font-size: .95rem; font-weight: 800;
    cursor: pointer; display: flex; align-items: center; justify-content: center; gap: .5rem;
    transition: opacity var(--del-transition), transform var(--del-transition);
    box-shadow: 0 4px 14px rgba(239,68,68,.35); opacity: .5;
}
.btn-delete-confirm.ready { opacity: 1; }
.btn-delete-confirm.ready:hover { transform: translateY(-1px); }
.btn-cancel {
    flex: 1; padding: .85rem; border: 1.5px solid var(--del-border); border-radius: var(--del-radius-sm);
    background: var(--del-surface); color: var(--del-text-2); font-family: 'Cairo', sans-serif;
    font-size: .9rem; font-weight: 600; cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: .5rem;
    text-decoration: none; transition: background var(--del-transition);
}
.btn-cancel:hover { background: var(--del-surface-2); color: var(--del-text-1); }
</style>
}

<div class="delete-page">
    <div class="danger-card">

        <div class="danger-header">
            <div class="danger-icon-wrap">🗑️</div>
            <div>
                <h1>تأكيد حذف وليّ الأمر</h1>
                <p>هذا الإجراء لا يمكن التراجع عنه</p>
            </div>
        </div>

        <div class="danger-body">

            <div class="parent-summary">
                <div class="del-avatar">@Model.FullName[0]</div>
                <div>
                    <div class="del-name">@Model.FullName</div>
                    <div class="del-meta">@Model.PhoneNumber · @Model.RelationToStudent · @Model.NationalID</div>
                </div>
            </div>

            @if (studentsCount > 0)
            {
                <div class="warning-box">
                    <span class="wi">⚠️</span>
                    <p>
                        وليّ الأمر هذا مرتبط بـ <strong>@studentsCount طالب</strong>.
                        عند الحذف سيتم <strong>إلغاء ارتباط الطلاب</strong> بهذا الوليّ
                        وسيصبحون بدون وليّ أمر. لن يتم حذف بياناتهم.
                    </p>
                </div>

                @if (Model.Students?.Any() == true)
                {
                    <div class="students-preview">
                        <div class="students-preview-header">
                            <i class="fas fa-users"></i> الطلاب المرتبطون الذين سيتأثرون:
                        </div>
                        @foreach (var s in Model.Students)
                        {
                            <span class="student-chip">🎓 @s.FullName</span>
                        }
                    </div>
                }
            }
            else
            {
                <div class="warning-box" style="background:#f0fdf4;border-color:#86efac">
                    <span class="wi">ℹ️</span>
                    <p style="color:#14532d">لا يوجد طلاب مرتبطون بهذا وليّ الأمر. يمكن الحذف بأمان.</p>
                </div>
            }

            <div class="confirm-box">
                <label>للتأكيد، اكتب اسم وليّ الأمر بالضبط:</label>
                <div class="confirm-phrase">@Model.FullName</div>
                <input type="text" id="confirmInput" placeholder="اكتب الاسم هنا للتأكيد…"
                       oninput="checkConfirm(this.value)" />
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.ParentID" />
                <div class="del-actions">
                    <a asp-action="Details" asp-route-id="@Model.ParentID" class="btn-cancel">
                        <i class="fas fa-arrow-right"></i> إلغاء
                    </a>
                    <button type="submit" class="btn-delete-confirm" id="deleteBtn" disabled>
                        <i class="fas fa-trash"></i> تأكيد الحذف
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const CONFIRM_NAME = "@Model.FullName.Replace("\"", "\\\"")";
    const btn = document.getElementById('deleteBtn');

    function checkConfirm(val) {
        const ok = val.trim() === CONFIRM_NAME;
        btn.disabled = !ok;
        btn.classList.toggle('ready', ok);
    }
</script>
}
