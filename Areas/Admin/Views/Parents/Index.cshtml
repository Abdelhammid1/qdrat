@model QdratNew.ViewModels.Parent.ParentIndexViewModel
@{
    ViewData["Title"] = "إدارة أولياء الأمور";
    var relations = new[] { "أب", "أم", "أخو", "أخرى" };
}

@section Styles {
<style>
/* ══════════════════════════════════════════
   PARENTS INDEX — Design Tokens
══════════════════════════════════════════ */
:root {
    --p-primary:      #7c3aed;
    --p-primary-dark: #5b21b6;
    --p-primary-light:#ede9fe;
    --p-success:      #10b981;
    --p-warning:      #f59e0b;
    --p-danger:       #ef4444;
    --p-info:         #3b82f6;
    --p-surface:      #ffffff;
    --p-surface-2:    #f8fafc;
    --p-border:       #e2e8f0;
    --p-text-1:       #0f172a;
    --p-text-2:       #475569;
    --p-text-3:       #94a3b8;
    --p-shadow-sm:    0 1px 3px rgba(0,0,0,.06);
    --p-shadow-md:    0 4px 16px rgba(0,0,0,.08);
    --p-shadow-lg:    0 10px 40px rgba(0,0,0,.14);
    --p-radius:       14px;
    --p-radius-sm:    8px;
    --p-transition:   0.22s cubic-bezier(.4,0,.2,1);
}

.parents-page { font-family: 'Cairo', sans-serif; }

/* ── Hero ── */
.parents-hero {
    background: linear-gradient(135deg, #1e0a3c 0%, #4c1d95 55%, #7c3aed 100%);
    border-radius: var(--p-radius);
    padding: 2.2rem 2rem;
    margin-bottom: 1.75rem;
    position: relative;
    overflow: hidden;
    color: #fff;
}
.parents-hero::before {
    content: '';
    position: absolute; inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}
.parents-hero .hero-icon {
    width: 56px; height: 56px;
    background: rgba(255,255,255,.15);
    border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.8rem;
    backdrop-filter: blur(8px);
    margin-bottom: 1rem;
}
.parents-hero h1 { font-size: 1.75rem; font-weight: 800; margin: 0; }
.parents-hero p  { opacity: .75; margin: .3rem 0 0; font-size: .95rem; }
.hero-badge {
    display: inline-flex; align-items: center; gap: .4rem;
    background: rgba(255,255,255,.18);
    border: 1px solid rgba(255,255,255,.25);
    border-radius: 50px; padding: .3rem .85rem;
    font-size: .82rem; font-weight: 600;
    backdrop-filter: blur(8px);
}

/* ── Stats bar ── */
.stats-bar {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(160px,1fr));
    gap: 1rem; margin-bottom: 1.75rem;
}
.stat-card {
    background: var(--p-surface);
    border: 1px solid var(--p-border);
    border-radius: var(--p-radius);
    padding: 1.2rem 1.4rem;
    box-shadow: var(--p-shadow-sm);
    display: flex; align-items: center; gap: 1rem;
    transition: transform var(--p-transition), box-shadow var(--p-transition);
}
.stat-card:hover { transform: translateY(-2px); box-shadow: var(--p-shadow-md); }
.stat-icon {
    width: 46px; height: 46px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.3rem; flex-shrink: 0;
}
.stat-icon.purple { background: #ede9fe; color: var(--p-primary); }
.stat-icon.green  { background: #d1fae5; color: var(--p-success); }
.stat-icon.blue   { background: #dbeafe; color: var(--p-info); }
.stat-icon.amber  { background: #fef3c7; color: var(--p-warning); }
.stat-val  { font-size: 1.6rem; font-weight: 800; color: var(--p-text-1); line-height: 1; }
.stat-lbl  { font-size: .78rem; color: var(--p-text-2); margin-top: .15rem; }

/* ── Toolbar ── */
.toolbar {
    background: var(--p-surface);
    border: 1px solid var(--p-border);
    border-radius: var(--p-radius);
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    display: flex; flex-wrap: wrap; align-items: center; gap: .75rem;
    box-shadow: var(--p-shadow-sm);
}
.search-box {
    flex: 1; min-width: 220px;
    display: flex; align-items: center; gap: .5rem;
    background: var(--p-surface-2);
    border: 1.5px solid var(--p-border);
    border-radius: 50px; padding: .45rem 1rem;
    transition: border-color var(--p-transition);
}
.search-box:focus-within { border-color: var(--p-primary); }
.search-box input { border: none; background: transparent; outline: none; flex: 1; font-family: 'Cairo', sans-serif; font-size: .9rem; }
.search-box .s-icon { color: var(--p-text-3); font-size: .95rem; }
.filter-select {
    border: 1.5px solid var(--p-border); border-radius: 50px;
    padding: .45rem 1rem; background: var(--p-surface-2);
    font-family: 'Cairo', sans-serif; font-size: .88rem; color: var(--p-text-1);
    outline: none; transition: border-color var(--p-transition); cursor: pointer;
}
.filter-select:focus { border-color: var(--p-primary); }
.btn-add {
    display: inline-flex; align-items: center; gap: .5rem;
    background: linear-gradient(135deg, var(--p-primary), var(--p-primary-dark));
    color: #fff; border: none; border-radius: 50px;
    padding: .5rem 1.25rem; font-family: 'Cairo', sans-serif;
    font-size: .88rem; font-weight: 700; cursor: pointer;
    text-decoration: none;
    transition: opacity var(--p-transition), transform var(--p-transition);
    box-shadow: 0 4px 14px rgba(124,58,237,.35);
}
.btn-add:hover { opacity: .9; transform: translateY(-1px); color: #fff; }

/* ── Table ── */
.table-card {
    background: var(--p-surface);
    border: 1px solid var(--p-border);
    border-radius: var(--p-radius);
    box-shadow: var(--p-shadow-sm);
    overflow: hidden;
}
.parents-table { width: 100%; border-collapse: collapse; }
.parents-table thead tr {
    background: linear-gradient(to left, #f8f7ff, #f1f0fe);
    border-bottom: 2px solid var(--p-primary-light);
}
.parents-table thead th {
    padding: .85rem 1rem; font-size: .8rem; font-weight: 700;
    color: var(--p-primary); text-align: right; white-space: nowrap;
}
.parents-table tbody tr {
    border-bottom: 1px solid var(--p-border);
    transition: background var(--p-transition);
}
.parents-table tbody tr:last-child { border-bottom: none; }
.parents-table tbody tr:hover { background: #faf9ff; }
.parents-table td { padding: .85rem 1rem; font-size: .88rem; color: var(--p-text-1); vertical-align: middle; }

/* ── Avatar ── */
.parent-avatar {
    width: 40px; height: 40px; border-radius: 50%;
    background: linear-gradient(135deg, var(--p-primary), var(--p-primary-dark));
    color: #fff; display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: .95rem; flex-shrink: 0;
}

/* ── Badges ── */
.rel-badge {
    display: inline-flex; align-items: center; gap: .3rem;
    padding: .25rem .7rem; border-radius: 50px;
    font-size: .75rem; font-weight: 700;
}
.rel-أب   { background:#ede9fe; color:#5b21b6; }
.rel-أم   { background:#fce7f3; color:#9d174d; }
.rel-أخو  { background:#dbeafe; color:#1d4ed8; }
.rel-أخرى { background:#f3f4f6; color:#374151; }

.student-count-badge {
    display: inline-flex; align-items: center; gap: .3rem;
    background: #d1fae5; color: #065f46;
    padding: .25rem .65rem; border-radius: 50px;
    font-size: .78rem; font-weight: 700;
}
.account-badge {
    display: inline-flex; align-items: center; gap: .3rem;
    padding: .25rem .65rem; border-radius: 50px;
    font-size: .75rem; font-weight: 700;
}
.account-yes { background:#d1fae5; color:#065f46; }
.account-no  { background:#f3f4f6; color:#6b7280; }

/* ── Action buttons ── */
.actions-cell { display: flex; gap: .4rem; align-items: center; flex-wrap: nowrap; }
.btn-action {
    width: 32px; height: 32px; border-radius: 8px; border: none;
    display: flex; align-items: center; justify-content: center;
    font-size: .85rem; cursor: pointer; text-decoration: none;
    transition: transform var(--p-transition), opacity var(--p-transition);
}
.btn-action:hover { transform: scale(1.1); opacity: .9; }
.btn-view   { background: #dbeafe; color: var(--p-info); }
.btn-edit   { background: #fef3c7; color: #92400e; }
.btn-delete { background: #fee2e2; color: var(--p-danger); }
.btn-report { background: #d1fae5; color: #065f46; }

/* ── Empty state ── */
.empty-state {
    text-align: center; padding: 4rem 2rem;
    color: var(--p-text-2);
}
.empty-state .empty-icon { font-size: 3.5rem; margin-bottom: 1rem; opacity: .4; }
.empty-state h3 { font-size: 1.1rem; font-weight: 700; color: var(--p-text-1); margin-bottom: .4rem; }

/* ── Pagination ── */
.pagination-bar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--p-border);
    font-size: .85rem; color: var(--p-text-2);
    flex-wrap: wrap; gap: .5rem;
}
.page-btn {
    width: 34px; height: 34px; border-radius: var(--p-radius-sm);
    border: 1.5px solid var(--p-border); background: var(--p-surface);
    display: flex; align-items: center; justify-content: center;
    font-size: .85rem; cursor: pointer; text-decoration: none; color: var(--p-text-1);
    transition: all var(--p-transition);
}
.page-btn:hover, .page-btn.active { background: var(--p-primary); border-color: var(--p-primary); color: #fff; }
.page-btn.disabled { opacity: .4; pointer-events: none; }

/* ── Alert ── */
.alert-success {
    background: #d1fae5; border: 1px solid #6ee7b7; color: #065f46;
    border-radius: var(--p-radius-sm); padding: .85rem 1.25rem;
    margin-bottom: 1.25rem; display: flex; align-items: center; gap: .6rem;
    font-weight: 600; animation: slideDown .3s ease;
}
@@keyframes slideDown { from { opacity:0; transform:translateY(-8px); } to { opacity:1; transform:translateY(0); } }
</style>
}

<div class="parents-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-success">
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @* {{!-- Hero --}} *@
    <div class="parents-hero">
        <div class="hero-icon">👨‍👩‍👧‍👦</div>
        <h1>إدارة أولياء الأمور</h1>
        <p>إضافة وتعديل وتتبع أولياء الأمور وأبنائهم من الطلاب</p>
        <br />
        <span class="hero-badge">
            <i class="fas fa-users"></i>
            إجمالي @Model.TotalCount وليّ أمر
        </span>
    </div>

    @* {{!-- Stats --}} *@
    <div class="stats-bar">
        <div class="stat-card">
            <div class="stat-icon purple"><i class="fas fa-users"></i></div>
            <div>
                <div class="stat-val">@Model.TotalCount</div>
                <div class="stat-lbl">إجمالي أولياء الأمور</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green"><i class="fas fa-user-check"></i></div>
            <div>
                <div class="stat-val">@Model.Parents.Count(p => p.HasUserAccount)</div>
                <div class="stat-lbl">لديهم حسابات</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon blue"><i class="fas fa-school"></i></div>
            <div>
                <div class="stat-val">@Model.Parents.Sum(p => p.StudentsCount)</div>
                <div class="stat-lbl">إجمالي الطلاب المرتبطين</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon amber"><i class="fas fa-calendar-alt"></i></div>
            <div>
                <div class="stat-val">@Model.Parents.Count(p => p.DateCreated.Month == DateTime.Now.Month && p.DateCreated.Year == DateTime.Now.Year)</div>
                <div class="stat-lbl">مضافون هذا الشهر</div>
            </div>
        </div>
    </div>

    @* {{!-- Toolbar --}} *@
    <form method="get" asp-action="Index">
        <div class="toolbar">
            <div class="search-box">
                <span class="s-icon"><i class="fas fa-search"></i></span>
                <input name="search" value="@Model.SearchTerm" placeholder="بحث بالاسم أو الهاتف أو الرقم القومي…" />
            </div>
            <select name="relation" class="filter-select" onchange="this.form.submit()">
                <option value="">— كل الصلات —</option>
                @foreach (var r in relations)
                {
                    <option value="@r" selected="@(Model.RelationFilter == r)">@r</option>
                }
            </select>
            <button type="submit" class="btn-add" style="background:linear-gradient(135deg,#475569,#1e293b)">
                <i class="fas fa-filter"></i> فلترة
            </button>
            <a asp-action="Create" class="btn-add ms-auto">
                <i class="fas fa-plus"></i> إضافة وليّ أمر
            </a>
        </div>
    </form>

    @* {{!-- Table --}} *@
    <div class="table-card">
        @if (!Model.Parents.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">👨‍👩‍👧</div>
                <h3>لا توجد نتائج</h3>
                <p>جرّب تعديل بحثك أو أضف وليّ أمر جديد</p>
            </div>
        }
        else
        {
            <table class="parents-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>وليّ الأمر</th>
                        <th>الهاتف</th>
                        <th>الصلة</th>
                        <th>الطلاب</th>
                        <th>حساب</th>
                        <th>تاريخ الإضافة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (p, i) in Model.Parents.Select((p, i) => (p, i)))
                    {
                        <tr>
                            <td style="color:var(--p-text-3);font-size:.8rem">@((Model.Page - 1) * Model.PageSize + i + 1)</td>
                            <td>
                                <div style="display:flex;align-items:center;gap:.75rem">
                                    <div class="parent-avatar">@p.FullName[0]</div>
                                    <div>
                                        <div style="font-weight:700">@p.FullName</div>
                                        <div style="font-size:.77rem;color:var(--p-text-3)">@p.NationalID</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div>@p.PhoneNumber</div>
                                @if (!string.IsNullOrEmpty(p.WhatsAppNumber))
                                {
                                    <div style="font-size:.77rem;color:#25D366"><i class="fab fa-whatsapp"></i> @p.WhatsAppNumber</div>
                                }
                            </td>
                            <td>
                                <span class="rel-badge rel-@p.RelationToStudent">@p.RelationToStudent</span>
                            </td>
                            <td>
                                <span class="student-count-badge">
                                    <i class="fas fa-users"></i> @p.StudentsCount طالب
                                </span>
                            </td>
                            <td>
                                @if (p.HasUserAccount)
                                {
                                    <span class="account-badge account-yes"><i class="fas fa-check"></i> نعم</span>
                                }
                                else
                                {
                                    <span class="account-badge account-no"><i class="fas fa-times"></i> لا</span>
                                }
                            </td>
                            <td style="color:var(--p-text-2);font-size:.82rem">
                                @p.DateCreated.ToString("d MMM yyyy", new System.Globalization.CultureInfo("ar-EG"))
                            </td>
                            <td>
                                <div class="actions-cell">
                                    <a asp-action="Details" asp-route-id="@p.ParentID" class="btn-action btn-view" title="تفاصيل">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@p.ParentID" class="btn-action btn-edit" title="تعديل">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@p.ParentID" class="btn-action btn-delete" title="حذف">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Model.TotalPages > 1)
            {
                <div class="pagination-bar">
                    <span>عرض @Model.Parents.Count من @Model.TotalCount نتيجة</span>
                    <div style="display:flex;gap:.35rem">
                        <a asp-action="Index" asp-route-page="@(Model.Page - 1)"
                           asp-route-search="@Model.SearchTerm"
                           asp-route-relation="@Model.RelationFilter"
                           class="page-btn @(Model.Page <= 1 ? "disabled" : "")">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                        @for (int pg = Math.Max(1, Model.Page - 2); pg <= Math.Min(Model.TotalPages, Model.Page + 2); pg++)
                        {
                            <a asp-action="Index" asp-route-page="@pg"
                               asp-route-search="@Model.SearchTerm"
                               asp-route-relation="@Model.RelationFilter"
                               class="page-btn @(pg == Model.Page ? "active" : "")">@pg</a>
                        }
                        <a asp-action="Index" asp-route-page="@(Model.Page + 1)"
                           asp-route-search="@Model.SearchTerm"
                           asp-route-relation="@Model.RelationFilter"
                           class="page-btn @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </div>
                </div>
            }
        }
    </div>
</div>
