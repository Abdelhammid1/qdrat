@model List<QdratNew.ViewModels.RegisterUserViewModel>

@{
    ViewData["Title"] = "قائمة المستخدمين";
}

<h2>@ViewData["Title"]</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>الاسم</th>
            <th>البريد</th>
            <th>الرقم القومي</th>
            <th>الدور</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>@user.NationalID</td>
                <td>@user.Role</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-primary">إضافة مستخدم جديد</a>
