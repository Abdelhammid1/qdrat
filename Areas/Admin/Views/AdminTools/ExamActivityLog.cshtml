@model QdratNew.ViewModels.Admin.ExamActivityLogViewModel

@{
    ViewData["Title"] = "سجل تعديلات أسئلة الاختبارات";
}

<h2 class="mb-4">📜 سجل تعديلات أسئلة الاختبارات</h2>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-3">
        <label class="form-label">رقم الطالب</label>
        <input type="number" name="studentId" class="form-control" value="@Model.StudentId" />
    </div>
    <div class="col-md-3">
        <label class="form-label">رقم تكليف الدفعة (ExamAssignmentId)</label>
        <input type="number" name="examAssignmentId" class="form-control" value="@Model.ExamAssignmentId" />
    </div>
    <div class="col-md-3">
        <label class="form-label">رقم التكليف الفردي (ExamAssignmentToStudentId)</label>
        <input type="number" name="examAssignmentToStudentId" class="form-control" value="@Model.ExamAssignmentToStudentId" />
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">🔍 فلترة</button>
    </div>
</form>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">لا توجد سجلات مطابقة.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th>التاريخ</th>
                    <th>الأدمن</th>
                    <th>نوع الإجراء</th>
                    <th>السبب</th>
                    <th>الطالب</th>
                    <th>التكليف</th>
                    <th>التفاصيل</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@item.AdminName</td>
                        <td>@item.ActionType</td>
                        <td>@(string.IsNullOrWhiteSpace(item.Reason) ? "—" : item.Reason)</td>
                        <td>@(item.StudentId?.ToString() ?? "—")</td>
                        <td>
                            @if (item.ExamAssignmentToStudentId.HasValue)
                            {
                                <span>فردي #@item.ExamAssignmentToStudentId</span>
                            }
                            else if (item.ExamAssignmentId.HasValue)
                            {
                                <span>دفعة #@item.ExamAssignmentId</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td>@item.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
