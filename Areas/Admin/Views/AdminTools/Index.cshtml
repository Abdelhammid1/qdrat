@{
    ViewData["Title"] = "أدوات الذكاء الاصطناعي";
}

<h2 class="mb-4">⚙️ أدوات الذكاء الاصطناعي</h2>

<div id="alert-container"></div>

<div class="row g-3">
    <div class="col-md-4">
        <button onclick="callApi('/Admin/AdminTools/TrainAllModels')" class="btn btn-primary w-100">
            🔄 تدريب كل النماذج
        </button>
    </div>

    <div class="col-md-4">
        <button onclick="callApi('/Admin/AdminTools/TrainStudentModel')" class="btn btn-success w-100">
            🎓 تدريب نموذج الطلاب
        </button>
    </div>

    <div class="col-md-4">
        <button onclick="callApi('/Admin/AdminTools/TrainChartModel')" class="btn btn-info w-100">
            📈 تدريب نموذج الرسوم البيانية
        </button>
    </div>

    <div class="col-md-4">
        <button onclick="callApi('/Admin/AdminTools/GenerateAllStudentPredictions')" class="btn btn-warning w-100">
            📊 توليد التنبؤات لجميع الطلاب
        </button>
    </div>

    <div class="col-md-4">
        <button onclick="callApi('/Admin/AdminTools/TrainAIStudentProgressModel')" class="btn btn-dark w-100">
            🧠 تدريب نموذج التقدم
        </button>
    </div>

    <div class="col-md-4">
        <button onclick="callApi('/Admin/AdminTools/ApiRecomputeExamReportIntegrity')" class="btn btn-danger w-100"
                title="يُشغَّل فقط بعد تنفيذ Fix_ExamReport_ScoreIntegrity.sql">
            🩺 إعادة حساب نتائج الاختبارات المتضاربة
        </button>
    </div>

    <div class="col-md-4">
        <a asp-action="ExamActivityLog" class="btn btn-secondary w-100">
            📜 سجل تعديلات أسئلة الاختبارات
        </a>
    </div>
</div>

@section Scripts {
    <script>
        async function callApi(url) {
            try {
                const response = await fetch(url, { method: "GET" });
                const data = await response.json().catch(() => null);

                if (response.ok && data?.success) {
                    showAlert(data.message || "✅ العملية نجحت", "success");
                } else {
                    showAlert("❌ خطأ أثناء التنفيذ: " + (data?.message || url), "danger");
                }
            } catch (err) {
                showAlert("⚠️ فشل الاتصال بالسيرفر: " + err, "danger");
            }
        }

        function showAlert(message, type) {
            const container = document.getElementById("alert-container");
            container.innerHTML = `
                <div class="alert alert-${type} alert-dismissible fade show mt-3" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>`;
        }
    </script>
}
