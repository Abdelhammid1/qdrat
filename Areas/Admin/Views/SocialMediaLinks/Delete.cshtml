@model QdratNew.Entities.SocialMediaLink

@{
    ViewData["Title"] = "حذف الرابط";
}

<h4 class="mb-3 text-danger">هل أنت متأكد من حذف الرابط التالي؟</h4>

<div class="border p-3">
    <dl class="row">
        <dt class="col-sm-3">المنصة</dt>
        <dd class="col-sm-9">@Model.Platform</dd>

        <dt class="col-sm-3">الرابط</dt>
        <dd class="col-sm-9">@Model.Url</dd>

        <dt class="col-sm-3">الأيقونة</dt>
        <dd class="col-sm-9"><i class="@Model.IconClass"></i> @Model.IconClass</dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger"><i class="fas fa-trash-alt"></i> حذف</button>
        <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
    </form>
</div>
