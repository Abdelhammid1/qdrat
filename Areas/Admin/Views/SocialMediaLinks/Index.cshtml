@model List<QdratNew.Entities.SocialMediaLink>

@{
    ViewData["Title"] = "روابط التواصل الاجتماعي";
}

<div class="container mt-4" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4><i class="fas fa-share-alt"></i> إدارة روابط السوشيال ميديا</h4>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-circle"></i> إضافة رابط جديد
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (Model.Any())
    {
        <table class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>المنصة</th>
                    <th>الرابط</th>
                    <th>الأيقونة</th>
                    <th class="text-center">إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var link in Model)
                {
                    <tr>
                        <td>
                            @link.Platform
                        </td>
                        <td><a href="@link.Url" target="_blank">@link.Url</a></td>
                        <td><i class="@link.IconClass fa-lg text-primary"></i></td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@link.Id" class="btn btn-sm btn-warning me-1"><i class="fas fa-edit"></i></a>
                            <a asp-action="Delete" asp-route-id="@link.Id" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">لا توجد روابط مسجلة بعد.</div>
    }
</div>
