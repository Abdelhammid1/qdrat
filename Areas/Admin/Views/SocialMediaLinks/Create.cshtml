@model QdratNew.Entities.SocialMediaLink
@using QdratNew.Helpers

@{
    ViewData["Title"] = "إضافة رابط سوشيال ميديا";
}

<div class="qdrat-page" dir="rtl">

    <div class="qdrat-hero mb-4">
        <div>
            <div class="qdrat-kicker">
                <i class="fas fa-share-alt"></i>
                روابط التواصل الاجتماعي
            </div>

            <h2 class="qdrat-title">إضافة رابط جديد</h2>

            <p class="qdrat-subtitle">
                أضف رابط منصة تواصل اجتماعي ليظهر في واجهات المنصة العامة حسب حالة التفعيل وترتيب الظهور.
            </p>
        </div>

        <div class="qdrat-hero-icon">
            <i class="fas fa-plus-circle"></i>
        </div>
    </div>

    <div class="qdrat-card">
        <div class="qdrat-card-header">
            <div>
                <h5>
                    <i class="fas fa-link"></i>
                    بيانات الرابط
                </h5>
                <p>أدخل اسم المنصة والرابط واختر الأيقونة المناسبة.</p>
            </div>
        </div>

        <div class="qdrat-card-body">
            <form asp-action="Create" method="post" autocomplete="off">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert qdrat-alert qdrat-alert-danger mb-4"></div>

                <div class="row g-4">
                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="Platform" class="form-label">اسم المنصة</label>
                            <div class="qdrat-input-wrap">
                                <i class="fas fa-hashtag"></i>
                                <input asp-for="Platform" class="form-control" placeholder="مثال: Facebook" />
                            </div>
                            <span asp-validation-for="Platform" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="Url" class="form-label">الرابط</label>
                            <div class="qdrat-input-wrap">
                                <i class="fas fa-globe"></i>
                                <input asp-for="Url" class="form-control" placeholder="https://example.com" />
                            </div>
                            <span asp-validation-for="Url" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-8 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="IconClass" class="form-label">أيقونة المنصة</label>
                            <div class="qdrat-input-wrap qdrat-select-wrap">
                                <i class="fas fa-icons"></i>
                                <select asp-for="IconClass" class="form-select" id="IconClassSelect">
                                    @foreach (var option in SocialMediaIcons.IconOptions)
                                    {
                                        <option value="@option.Key" selected="@(Model.IconClass == option.Key)">@option.Value</option>
                                    }
                                </select>
                            </div>
                            <div class="qdrat-help mt-2">
                                <i class="fas fa-info-circle"></i>
                                <span>اختر الأيقونة المطابقة للمنصة حتى تظهر بشكل مناسب في الواجهة.</span>
                            </div>
                            <span asp-validation-for="IconClass" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-12">
                        <div class="qdrat-icon-preview-box">
                            <span>معاينة الأيقونة</span>
                            <div class="qdrat-icon-preview">
                                <i id="IconPreview" class="@(string.IsNullOrWhiteSpace(Model.IconClass) ? "fas fa-share-alt" : Model.IconClass)"></i>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="DisplayOrder" class="form-label">ترتيب الظهور</label>
                            <div class="qdrat-input-wrap">
                                <i class="fas fa-sort-numeric-down"></i>
                                <input asp-for="DisplayOrder" type="number" class="form-control" min="0" placeholder="مثال: 1" />
                            </div>
                            <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-status-box">
                            <div class="form-check form-switch qdrat-switch">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label">مفعل</label>
                            </div>
                            <small>عند التفعيل سيظهر الرابط في أماكن العرض المعتمدة داخل الواجهة العامة.</small>
                        </div>
                    </div>
                </div>

                <div class="qdrat-actions">
                    <a asp-action="Index" class="btn qdrat-btn qdrat-btn-light">
                        <i class="fas fa-times"></i>
                        إلغاء
                    </a>

                    <button type="submit" class="btn qdrat-btn qdrat-btn-primary">
                        <i class="fas fa-plus-circle"></i>
                        إضافة
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .qdrat-page {
        padding: 24px;
        background: #f5f7fb;
        min-height: calc(100vh - 80px);
        font-family: inherit;
    }

    .qdrat-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 26px;
        border-radius: 24px;
        background: linear-gradient(135deg, #102a43 0%, #1d4ed8 58%, #38bdf8 100%);
        color: #fff;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
    }

    .qdrat-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .qdrat-title {
        margin: 0;
        font-size: 28px;
        font-weight: 900;
        letter-spacing: -0.5px;
    }

    .qdrat-subtitle {
        margin: 10px 0 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 15px;
        line-height: 1.8;
        max-width: 850px;
    }

    .qdrat-hero-icon {
        width: 74px;
        height: 74px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.16);
        font-size: 34px;
        flex: 0 0 auto;
    }

    .qdrat-card {
        border: 1px solid #e5e7eb;
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    .qdrat-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #edf0f5;
        background: #fff;
    }

        .qdrat-card-header h5 {
            margin: 0;
            color: #0f172a;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .qdrat-card-header h5 i {
                color: #2563eb;
            }

        .qdrat-card-header p {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 14px;
        }

    .qdrat-card-body {
        padding: 24px;
    }

    .qdrat-field .form-label {
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 9px;
    }

    .qdrat-input-wrap {
        position: relative;
    }

        .qdrat-input-wrap > i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 3;
            pointer-events: none;
        }

        .qdrat-input-wrap .form-control,
        .qdrat-input-wrap .form-select {
            min-height: 48px;
            border-radius: 15px;
            border-color: #dbe3ef;
            padding-right: 42px;
            font-weight: 700;
        }

            .qdrat-input-wrap .form-control:focus,
            .qdrat-input-wrap .form-select:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 0.22rem rgba(37, 99, 235, 0.12);
            }

    .qdrat-help {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #64748b;
        font-size: 13px;
        font-weight: 700;
        line-height: 1.7;
    }

        .qdrat-help i {
            color: #2563eb;
        }

    .qdrat-icon-preview-box,
    .qdrat-status-box {
        height: 100%;
        min-height: 118px;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 18px;
        background: #f8fafc;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 10px;
    }

        .qdrat-icon-preview-box span {
            color: #64748b;
            font-size: 13px;
            font-weight: 900;
        }

    .qdrat-icon-preview {
        width: 58px;
        height: 58px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        color: #2563eb;
        font-size: 28px;
    }

    .qdrat-switch {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-right: 0;
        margin-bottom: 0;
    }

        .qdrat-switch .form-check-input {
            float: none;
            margin: 0;
            width: 46px;
            height: 24px;
            cursor: pointer;
        }

        .qdrat-switch .form-check-label {
            font-weight: 900;
            color: #1e293b;
            cursor: pointer;
        }

    .qdrat-status-box small {
        color: #64748b;
        line-height: 1.8;
        font-weight: 700;
    }

    .qdrat-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 26px;
        margin-top: 28px;
        border-top: 1px solid #edf0f5;
    }

    .qdrat-btn {
        min-height: 46px;
        border-radius: 14px;
        padding: 10px 24px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .qdrat-btn-primary {
        background: #16a34a;
        border-color: #16a34a;
        color: #fff;
    }

        .qdrat-btn-primary:hover {
            background: #15803d;
            border-color: #15803d;
            color: #fff;
        }

    .qdrat-btn-light {
        background: #f8fafc;
        border-color: #dbe3ef;
        color: #334155;
    }

        .qdrat-btn-light:hover {
            background: #eef2f7;
            border-color: #cbd5e1;
            color: #0f172a;
        }

    .qdrat-alert {
        border: 0;
        border-radius: 18px;
        padding: 15px 18px;
        font-weight: 800;
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.07);
    }

        .qdrat-alert:empty {
            display: none;
        }

    .qdrat-alert-danger {
        color: #991b1b;
        background: #fee2e2;
    }

    @@media (max-width: 768px) {
        .qdrat-page {
            padding: 14px;
        }

        .qdrat-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 20px;
        }

        .qdrat-title {
            font-size: 23px;
        }

        .qdrat-hero-icon {
            width: 58px;
            height: 58px;
            font-size: 26px;
        }

        .qdrat-card-body,
        .qdrat-card-header {
            padding: 18px;
        }

        .qdrat-actions {
            flex-direction: column-reverse;
        }

        .qdrat-btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const select = document.getElementById('IconClassSelect');
            const preview = document.getElementById('IconPreview');

            if (!select || !preview) {
                return;
            }

            select.addEventListener('change', function () {
                preview.className = this.value || 'fas fa-share-alt';
            });
        })();
    </script>
}
