@inject QdratNew.Services.Interfaces.ISystemSettingService SettingService
@{
    var siteLogoPath = await SettingService.GetAsync("SiteLogoPath");
    var instituteName = await SettingService.GetAsync("SiteName");
    var instituteAddress = await SettingService.GetAsync("InstituteAddress");
    var footerCopyright = await SettingService.GetAsync("FooterCopyright");

    var logoUrl = string.IsNullOrWhiteSpace(siteLogoPath) ? Url.Content("~/assets/logo.png") : Url.Content(siteLogoPath);
    var displayInstituteName = string.IsNullOrWhiteSpace(instituteName) ? "معهد القدرات للتدريب" : instituteName;
    var displayFooter = string.IsNullOrWhiteSpace(footerCopyright) ? "منصة قدرات — جميع الحقوق محفوظة" : footerCopyright;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Font -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="~/css/report-print.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --qr-primary: #087F73;
            --qr-primary-dark: #05564E;
            --qr-ink: #0B1F33;
            --qr-amber: #F59E0B;
            --qr-bg: #F7FAFC;
            --qr-muted: #667085;
            --qr-border: #E4EAEE;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background: var(--qr-bg);
            direction: rtl;
            margin: 0;
            color: var(--qr-ink);
        }

        .report-container {
            max-width: 1080px;
            margin: 24px auto;
            padding: 0 16px;
        }

        .card-box {
            background: #fff;
            border-radius: 18px;
            padding: 20px;
            border: 1px solid var(--qr-border);
            box-shadow: 0 4px 16px rgba(11, 31, 51, .04);
            margin-bottom: 18px;
        }

        .report-title {
            font-size: 19px;
            font-weight: 800;
            color: var(--qr-primary-dark);
        }

        .btn-report {
            background: var(--qr-primary);
            color: #fff;
            border: none;
            padding: 8px 16px;
            border-radius: 10px;
            font-weight: 600;
        }

        .btn-report:hover { background: var(--qr-primary-dark); color: #fff; }

        /* ========================= letterhead (screen) ========================= */
        .qr-letterhead {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            background: #fff;
            border: 1px solid var(--qr-border);
            border-radius: 18px;
            padding: 18px 22px;
            margin: 20px auto 0;
            max-width: 1080px;
            border-bottom: 3px solid var(--qr-primary);
            flex-wrap: wrap;
        }

        .qr-letterhead .qr-brand { display: flex; align-items: center; gap: 12px; }
        .qr-letterhead img { height: 46px; width: auto; object-fit: contain; }
        .qr-letterhead .qr-brand-name { font-weight: 800; font-size: 17px; color: var(--qr-primary-dark); }
        .qr-letterhead .qr-brand-address { font-size: 12.5px; color: var(--qr-muted); }
        .qr-letterhead .qr-doc-meta { text-align: start; font-size: 12.5px; color: var(--qr-muted); }
        .qr-letterhead .qr-doc-meta b { color: var(--qr-ink); display: block; font-size: 14px; }

        @@media (max-width: 700px) {
            .qr-letterhead { flex-direction: column; align-items: flex-start; }
            .qr-letterhead .qr-doc-meta { text-align: start; }
        }

        /* ========================= PRINT MODE ========================= */
        @@media print {
            .btn-report, .no-print { display: none !important; }

            body { background: #fff !important; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }

            @@page { size: A4 portrait; margin: 10mm; }

            .card-box, canvas { page-break-inside: avoid !important; break-inside: avoid !important; }

            .row { display: block !important; }
            .col-md-6, .col-md-4, .col-md-3, .col-md-2 { width: 100% !important; }
            canvas { max-height: 210px !important; }

            .qr-letterhead { box-shadow: none !important; border-radius: 0; margin: 0 auto 12px; }
        }
    </style>
</head>

<body>
    <div class="qr-letterhead">
        <div class="qr-brand">
            <img src="@logoUrl" alt="@displayInstituteName" onerror="this.style.display='none'" />
            <div>
                <div class="qr-brand-name">@displayInstituteName</div>
                @if (!string.IsNullOrWhiteSpace(instituteAddress))
                {
                    <div class="qr-brand-address">@instituteAddress</div>
                }
            </div>
        </div>
        <div class="qr-doc-meta">
            <b>@ViewData["Title"]</b>
            تاريخ الإصدار: @DateTime.Now.ToString("yyyy/MM/dd")
        </div>
    </div>

    <div class="report-container">
        @RenderBody()
    </div>

    <div class="no-print text-center text-muted" style="font-size:12.5px; padding:10px 0 26px;">
        @displayFooter
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
