@model QdratNew.ViewModels.ActionsModalViewModel

<!-- زر فتح المودال -->
<button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#actionsModal_@Model.ItemId" title="الإجراءات">
    <i class="fas fa-ellipsis-v"></i>
</button>

<!-- مودال الإجراءات -->
<div class="modal fade" id="actionsModal_@Model.ItemId" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content text-end">
            <div class="modal-header bg-dark text-white py-2">
                <h6 class="modal-title"><i class="fas fa-tools me-1"></i> الإجراءات المتاحة</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body d-flex flex-column gap-2">

                @* تعديل *@
                @if (!string.IsNullOrWhiteSpace(Model.EditUrl))
                {
                    <a href="@Model.EditUrl" class="btn btn-sm btn-dark w-100" title="تعديل">
                        <i class="fas fa-edit me-1"></i> تعديل
                    </a>
                }

                @* تفاصيل *@
                @if (!string.IsNullOrWhiteSpace(Model.DetailsUrl))
                {
                    <a href="@Model.DetailsUrl" class="btn btn-sm btn-outline-primary w-100" title="تفاصيل">
                        <i class="fas fa-info-circle me-1"></i> التفاصيل
                    </a>
                }

                @* التصنيفات *@
                @if (Model.EnableLabels && !string.IsNullOrWhiteSpace(Model.LabelsModalId))
                {
                    <button class="btn btn-sm btn-outline-info w-100"
                            data-bs-toggle="modal"
                            data-bs-target="#@Model.LabelsModalId"
                            title="تصنيفات">
                        <i class="fas fa-tags me-1"></i> التصنيفات
                    </button>
                }

                @* سجل التعديلات *@
                @if (Model.EnableAudit && !string.IsNullOrWhiteSpace(Model.AuditModalId))
                {
                    <button class="btn btn-sm btn-outline-warning w-100"
                            data-bs-toggle="modal"
                            data-bs-target="#@Model.AuditModalId"
                            title="سجل التعديلات">
                        <i class="fas fa-history me-1"></i> آخر التعديلات
                    </button>
                }
                @* زر فحص التشابه *@
                @if (Model.EnableSimilarityCheck)
                {
                    <button class="btn btn-sm btn-outline-danger w-100"
                            onclick="checkSimilar('@Model.ItemId')"
                            title="فحص الأسئلة المتشابهة">
                        <i class="fas fa-copy me-1"></i> فحص التشابه
                    </button>
                }

                @* حذف *@
                @if (Model.EnableDelete)
                {
                    <button class="btn btn-sm btn-danger w-100"
                            onclick="openConfirmDelete('@Model.ItemId', '@Model.ItemTitle')"
                            title="حذف">
                        <i class="fas fa-trash-alt me-1"></i> حذف
                    </button>
                }


            </div>
        </div>
    </div>
</div>
