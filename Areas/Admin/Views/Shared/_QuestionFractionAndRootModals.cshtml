@* Shared math input modals for question create/edit pages. *@

<div class="modal fade" id="fractionModal" tabindex="-1" aria-labelledby="fractionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header q-modal-primary">
                <h5 class="modal-title" id="fractionModalLabel">
                    <i class="fas fa-divide me-2"></i>إدخال كسر
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="q-label" for="numeratorInput">البسط</label>
                        <input type="text" id="numeratorInput" class="q-input" autocomplete="off" />
                    </div>
                    <div class="col-md-6">
                        <label class="q-label" for="denominatorInput">المقام</label>
                        <input type="text" id="denominatorInput" class="q-input" autocomplete="off" />
                    </div>
                </div>
                <div class="mt-3">
                    <label class="q-label">المعاينة</label>
                    <div id="fractionPreview" class="question-preview math-content" style="min-height:70px;"></div>
                </div>
                <button type="button" class="btn-save-q w-100 mt-3" onclick="insertStyledFraction()">
                    <i class="fas fa-plus-circle"></i> إدراج الكسر
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="rootModal" tabindex="-1" aria-labelledby="rootModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header q-modal-primary">
                <h5 class="modal-title" id="rootModalLabel">
                    <i class="fas fa-square-root-alt me-2"></i>إدخال جذر
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <label class="q-label" for="rootValue">القيمة داخل الجذر</label>
                <input type="text" id="rootValue" class="q-input mb-3" autocomplete="off" />

                <label class="q-label" for="rootType">نوع الجذر</label>
                <select id="rootType" class="q-select mb-3">
                    <option value="2">جذر تربيعي</option>
                    <option value="3">جذر تكعيبي</option>
                </select>

                <label class="q-label">المعاينة</label>
                <div id="rootPreview" class="question-preview math-content" style="min-height:70px;"></div>

                <button type="button" class="btn-save-q w-100 mt-3" onclick="insertRoot()">
                    <i class="fas fa-plus-circle"></i> إدراج الجذر
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="nestedRootModal" tabindex="-1" aria-labelledby="nestedRootModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header q-modal-primary">
                <h5 class="modal-title" id="nestedRootModalLabel">
                    <i class="fas fa-stream me-2"></i>إدخال جذر متداخل
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <div id="nestedRootsContainer"></div>

                <div class="d-flex flex-wrap gap-2 mt-3 mb-3">
                    <button type="button" class="math-btn" onclick="addRootLevel()">
                        <i class="fas fa-plus"></i> مستوى جديد
                    </button>
                    <button type="button" class="math-btn" onclick="generateNestedRootPreview()">
                        <i class="fas fa-eye"></i> معاينة
                    </button>
                </div>

                <label class="q-label">المعاينة</label>
                <div id="nestedRootPreview" class="question-preview math-content" style="min-height:80px;"></div>

                <button type="button" class="btn-save-q w-100 mt-3" onclick="insertNestedRoot()">
                    <i class="fas fa-plus-circle"></i> إدراج الجذر المتداخل
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="exponentModal" tabindex="-1" aria-labelledby="exponentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header q-modal-primary">
                <h5 class="modal-title" id="exponentModalLabel">
                    <i class="fas fa-superscript me-2"></i>إدخال أُس
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="q-label" for="baseInput">الأساس</label>
                        <input type="text" id="baseInput" class="q-input" autocomplete="off" />
                    </div>
                    <div class="col-md-6">
                        <label class="q-label" for="exponentInput">الأُس</label>
                        <input type="text" id="exponentInput" class="q-input" autocomplete="off" />
                    </div>
                </div>
                <div class="mt-3">
                    <label class="q-label">المعاينة</label>
                    <div id="exponentPreview" class="question-preview math-content" style="min-height:70px;"></div>
                </div>
                <button type="button" class="btn-save-q w-100 mt-3" onclick="insertExponent()">
                    <i class="fas fa-plus-circle"></i> إدراج الأُس
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="rootWithExponentModal" tabindex="-1" aria-labelledby="rootWithExponentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header q-modal-primary">
                <h5 class="modal-title" id="rootWithExponentModalLabel">
                    <i class="fas fa-leaf me-2"></i>إدخال جذر + أُس
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <label class="q-label" for="rootBaseValue">القيمة داخل الجذر</label>
                <input type="text" id="rootBaseValue" class="q-input mb-3" autocomplete="off" />

                <label class="q-label" for="rootExponentValue">الأُس</label>
                <input type="text" id="rootExponentValue" class="q-input mb-3" autocomplete="off" />

                <label class="q-label">المعاينة</label>
                <div id="rootWithExponentPreview" class="question-preview math-content" style="min-height:70px;"></div>

                <button type="button" class="btn-save-q w-100 mt-3" onclick="insertRootWithExponent()">
                    <i class="fas fa-plus-circle"></i> إدراج جذر + أُس
                </button>
            </div>
        </div>
    </div>
</div>
