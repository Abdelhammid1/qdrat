@model QdratNew.ViewModels.Question.QuestionLabelModalViewModel
@using QdratNew.Enums
@using System.ComponentModel.DataAnnotations
@using System.Reflection

@functions {
    private string GetDisplayName(QuestionUsageType flag)
    {
        var field = flag.GetType().GetField(flag.ToString());
        var attr = field?.GetCustomAttribute<DisplayAttribute>();
        return attr?.Name ?? flag.ToString();
    }
}

<div class="modal fade" id="labelsModal_@Model.QuestionId"
     tabindex="-1"
     aria-labelledby="labelsModalLabel_@Model.QuestionId"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-end">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="labelsModalLabel_@Model.QuestionId">
                    <i class="fas fa-tags me-2"></i> التصنيفات الخاصة بالسؤال
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                @{
                    var usage = Model?.UsageTypes ?? QuestionUsageType.None;

                    var labels = Enum.GetValues(typeof(QuestionUsageType))
                    .Cast<QuestionUsageType>()
                    .Where(flag => flag != QuestionUsageType.None && usage.HasFlag(flag))
                    .Select(flag => GetDisplayName(flag))
                    .ToList();
                }

                @if (labels.Any())
                {
                    <ul class="list-group" dir="rtl" style="float:right; display:block;">
                        @foreach (var label in labels)
                        {
                            <li class="list-group-item" style="float:right; display:block;">
                                <i class="fas fa-check-circle text-success me-2"></i> @label
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">لا توجد تصنيفات مضافة لهذا السؤال.</p>
                }
            </div>
        </div>
    </div>
</div>
