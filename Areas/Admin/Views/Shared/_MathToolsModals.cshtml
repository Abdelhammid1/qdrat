



<!-- ✅ مودال الكسر -->
<div class="modal fade" id="fractionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content text-end">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title"><i class="fas fa-divide"></i> إدخال كسر</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label>البسط</label>
                <input id="numeratorInput" class="form-control mb-2" />
                <label>المقام</label>
                <input id="denominatorInput" class="form-control mb-2" />
                <div class="text-center mt-3" id="fractionPreview"></div>
            </div>
            <div class="modal-footer justify-content-center">
                <button class="btn btn-success" onclick="insertStyledFraction()">إدراج</button>
            </div>
        </div>
    </div>
</div>

<!-- ✅ مودال الجذر -->
<div class="modal fade" id="rootModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content text-end">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title"><i class="fas fa-square-root-alt"></i> إدخال جذر</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label>القيمة داخل الجذر</label>
                <input id="rootValue" class="form-control mb-2" />
                <label>نوع الجذر</label>
                <select id="rootType" class="form-select">
                    <option value="2">جذر تربيعي</option>
                    <option value="3">جذر تكعيبي</option>
                </select>
                <div class="text-center mt-3" id="rootPreview"></div>
            </div>
            <div class="modal-footer justify-content-center">
                <button class="btn btn-success" onclick="insertRoot()">إدراج</button>
            </div>
        </div>
    </div>
</div>

<!-- ✅ مودال الجذر المتداخل -->
<div class="modal fade" id="nestedRootModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content text-end">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title"><i class="fas fa-stream"></i> جذر متداخل</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="nestedRootsContainer"></div>
                <div class="text-center">
                    <button class="btn btn-outline-primary btn-sm" onclick="addRootLevel()">➕ مستوى جديد</button>
                </div>
                <div class="text-center mt-3" id="nestedRootPreview"></div>
            </div>
            <div class="modal-footer justify-content-center">
                <button class="btn btn-success" onclick="insertNestedRoot()">إدراج</button>
            </div>
        </div>
    </div>
</div>

<!-- ✅ مودال الأس -->
<div class="modal fade" id="exponentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content text-end">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title"><i class="fas fa-superscript"></i> إدخال أُس</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label>الأساس</label>
                <input id="baseInput" class="form-control mb-2" />
                <label>القوة (الأُس)</label>
                <input id="exponentInput" class="form-control mb-2" />
                <div class="text-center mt-3" id="exponentPreview"></div>
            </div>
            <div class="modal-footer justify-content-center">
                <button class="btn btn-success" onclick="insertExponent()">إدراج</button>
            </div>
        </div>
    </div>
</div>

<!-- ✅ مودال جذر + أُس -->
<div class="modal fade" id="rootWithExponentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content text-end">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title"><i class="fas fa-leaf"></i> جذر + أُس</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label>القيمة داخل الجذر</label>
                <input id="rootBaseValue" class="form-control mb-2" />
                <label>الأُس</label>
                <input id="rootExponentValue" class="form-control mb-2" />
                <div class="text-center mt-3" id="rootWithExponentPreview"></div>
            </div>
            <div class="modal-footer justify-content-center">
                <button class="btn btn-success" onclick="insertRootWithExponent()">إدراج</button>
            </div>
        </div>
    </div>
</div>

<!-- ✅ مودال MathLive -->
<div class="modal fade" id="mathliveModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content text-end">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title"><i class="fas fa-square-root-alt"></i> إدخال معادلة رياضية</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <math-field id="mathlive-field" style="width: 100%; font-size: 24px;"></math-field>
            </div>
            <div class="modal-footer justify-content-center">
                <button class="btn btn-success" onclick="insertMathExpression()">إدراج المعادلة</button>
            </div>
        </div>
    </div>
</div>
