<!-- ✅ مودال شامل للأدوات الرياضية -->
<div class="modal fade" id="mathToolsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title"><i class="fas fa-tools"></i> أدوات رياضية</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body d-grid gap-2">
                <button type="button" class="btn btn-outline-primary"
                        onclick="closeAndThenOpen('mathToolsModal', () => openFractionModal('questionText'));">
                    ➕ إدخال كسر
                </button>

                <button type="button" class="btn btn-outline-success"
                        onclick="setTimeout(() => openRootModal('questionText'), 500);"
                        data-bs-dismiss="modal">
                    √ إدخال جذر
                </button>

                <button type="button" class="btn btn-outline-dark"
                        onclick="setTimeout(() => openNestedRootModal('questionText'), 500);"
                        data-bs-dismiss="modal">
                    🌲 جذر متداخل
                </button>

                <button type="button" class="btn btn-outline-secondary"
                        onclick="setTimeout(() => openExponentModal('questionText'), 500);"
                        data-bs-dismiss="modal">
                    🡱 إدخال أُس
                </button>

                <button type="button" class="btn btn-outline-info"
                        onclick="setTimeout(() => openRootWithExponentModal('questionText'), 500);"
                        data-bs-dismiss="modal">
                    🌿 إدخال جذر + أُس
                </button>


            </div>
        </div>
    </div>
</div>
