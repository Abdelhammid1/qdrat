@model QdratNew.ViewModels.Layout.AdminNotificationIconsViewModel

<div class="d-flex gap-4">

    <!-- 🔔 إشعارات النظام -->
    <div class="position-relative" title="الإشعارات">
        <a href="/Admin/Notifications/Index" class="text-decoration-none">
            <i class="fas fa-bell text-muted fs-5 hover-icon"></i>
            @if (Model.NotificationsCount > 0)
            {
                <span class="badge bg-danger position-absolute top-0 start-0 translate-middle rounded-pill">
                    @Model.NotificationsCount
                </span>
            }
        </a>
    </div>

    <!-- 📌 مهام اليوم -->
    <div class="position-relative" title="مهام اليوم">
        <a href="/Admin/Home/TodayTasks" class="text-decoration-none">
            <i class="fas fa-tasks text-muted fs-5 hover-icon"></i>
            @if (Model.TasksCount > 0)
            {
                <span class="badge bg-primary position-absolute top-0 start-0 translate-middle rounded-pill">
                    @Model.TasksCount
                </span>
            }
        </a>
    </div>

</div>
