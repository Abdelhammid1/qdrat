@model string

<div class="d-flex flex-wrap gap-2 mb-3">
    <button type="button" class="btn btn-dark btn-sm" onclick="openFractionModal('@Model')" title="إدخال كسر">
        <i class="fas fa-divide"></i>
    </button>
    <button type="button" class="btn btn-dark btn-sm" onclick="openRootModal('@Model')" title="إدخال جذر">
        <i class="fas fa-square-root-alt"></i>
    </button>
    <button type="button" class="btn btn-dark btn-sm" onclick="openNestedRootModal('@Model')" title="جذر متداخل">
        <i class="fas fa-stream"></i>
    </button>
    <button type="button" class="btn btn-dark btn-sm" onclick="openExponentModal('@Model')" title="أُس">
        <i class="fas fa-superscript"></i>
    </button>
    <button type="button" class="btn btn-dark btn-sm" onclick="openRootWithExponentModal('@Model')" title="جذر + أُس">
        <i class="fas fa-leaf"></i>
    </button>
    <button type="button" class="btn btn-dark btn-sm" onclick="openMathLiveModal('@Model')">
        <i class="fas fa-square-root-alt"></i> معادلة
    </button>
</div>
