@{
    Layout = null;
}
@inject QdratNew.Interfaces.IUserAccountDropdownService AccountDropdownService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @await Component.InvokeAsync("SiteMetaData")
    @RenderSection("Styles", required: false)

    <!-- Bootstrap RTL -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.5/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />


    <style>
        :root {
            --main-bg: #1d1f21;
            --main-card: #2c2f33;
            --main-accent: #4CA6A8;
            --text-color: #fff;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: var(--main-bg);
            color: var(--text-color);
        }

        .sidebar {
            width: 250px;
            background-color: var(--main-card);
            color: var(--text-color);
            height: 100vh;
            position: fixed;
            top: 0;
            right: 0;
            transition: all 0.3s;
            z-index: 1000;
        }

            .sidebar.collapsed {
                width: 70px;
            }

            .sidebar .nav-link {
                color: var(--text-color);
                padding: 0.75rem 1rem;
                display: flex;
                gap: 10px;
            }

                .sidebar .nav-link i {
                    width: 30px;
                    text-align: center;
                }

                .sidebar .nav-link:hover {
                    background-color: var(--main-accent);
                }

            .sidebar.collapsed .nav-link span {
                display: none;
            }

            .sidebar.collapsed .nav-link:hover span {
                display: inline-block;
                position: absolute;
                right: 80px;
                background-color: #333;
                color: white;
                padding: 4px 8px;
                border-radius: 4px;
                white-space: nowrap;
            }

        .content {
            margin-right: 250px;
            transition: all 0.3s;
        }

            .content.collapsed {
                margin-right: 70px;
            }

        .topbar {
            background-color: #2c2f33;
            color: white;
            padding: 0.5rem 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #ccc;
            transition: border-color 0.3s;
        }

            .user-avatar:hover {
                border-color: var(--main-accent);
            }

        .dataTables_wrapper .dataTables_filter input,
        .dataTables_wrapper .dataTables_length select {
            background-color: var(--main-card);
            color: var(--text-color);
            border: 1px solid #555;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button {
            background-color: var(--main-bg);
            color: #ccc;
            border: none;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button.current {
                background-color: var(--main-accent);
                color: #fff;
            }

        .table.dataTable {
            background-color: var(--main-card);
            color: var(--text-color);
        }

            .table.dataTable thead {
                background-color: #34383d;
                color: var(--text-color);
            }



        .dataTable,
        .dataTables_wrapper {
            background-color: #2c2f33 !important;
            color: #fff !important;
            border: none;
        }

            .dataTable thead th {
                background-color: #34383d !important;
                color: #ccc !important;
                border-bottom: 1px solid #444;
            }

            .dataTable tbody td {
                background-color: #2c2f33 !important;
                color: #ddd !important;
            }

            .dataTables_wrapper .dataTables_paginate .paginate_button {
                background-color: #1d1f21 !important;
                color: #aaa !important;
                border: none;
            }

                .dataTables_wrapper .dataTables_paginate .paginate_button.current {
                    background-color: #4CA6A8 !important;
                    color: #fff !important;
                }

        .dataTables_filter input,
        .dataTables_length select {
            background-color: #2c2f33 !important;
            color: #ccc !important;
            border: 1px solid #555;
        }

        button.dt-button {
            background-color: #4CA6A8 !important;
            color: #fff !important;
            border: none !important;
            border-radius: 4px;
            margin-left: 5px;
        }

            button.dt-button:hover {
                background-color: #339999 !important;
                color: #fff !important;
            }

        .page-title {
            font-size: 1.8rem;
            font-weight: bold;
            color: #4CA6A8;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
        }

        .dropdown-menu-dark {
            background-color: #2c2f33;
            color: #f1f1f1;
        }

            .dropdown-menu-dark .dropdown-item {
                color: #ddd;
            }

                .dropdown-menu-dark .dropdown-item:hover {
                    background-color: #4CA6A8;
                    color: white;
                }






    </style>





</head>
<body>
 
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
            <span class="fw-bold sidebar-title">القائمة</span>
            <button class="btn btn-sm text-white" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
        </div>

        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link d-flex align-items-center" asp-area="Admin" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-home me-2"></i>
                    <span class="link-label">الرئيسية</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link d-flex align-items-center" asp-area="Admin" asp-controller="Users" asp-action="Index">
                    <i class="fas fa-users me-2"></i>
                    <span class="link-label">المستخدمون</span>
                </a>
            </li>


            @Html.Partial("_AdminSidebarPartial")






        </ul>



        @Html.Partial("_AdminFooterDropdownPartial")

    </div>


    <!-- Main content -->
    <div class="content" id="mainContent">
        <!-- Topbar -->
        <div class="topbar" style="direction:ltr;">
           

            <div class="d-flex align-items-center gap-3">
                @{

                    var path = Context.Request.Path.ToString(); // الطريقة الأفضل داخل Layout
                    var isAdminArea = path.ToLower().Contains("/admin");
                }

                @if (isAdminArea)
                {
                    var accountDropdownModel = await AccountDropdownService.GetDropdownViewModelAsync(User);
                    @await Html.PartialAsync("_UnifiedAccountMenu", accountDropdownModel)
                }
                else
                {
                    <partial name="_LoginPartial" />
                }
                <div id="notification-widget-container"></div>

         @*        <div class="position-relative" title="التنبيهات">
                    <i class="fas fa-bell text-muted fs-5 hover-icon"></i>
                    <span class="badge bg-danger position-absolute top-0 start-0 translate-middle rounded-pill">3</span>
                </div>

                <div class="position-relative" title="مهام اليوم">
                    <i class="fas fa-tasks text-muted fs-5 hover-icon"></i>
                    <span class="badge bg-primary position-absolute top-0 start-0 translate-middle rounded-pill">5</span>
                </div> *@
            </div>
            @*             <a class="navbar-brand" asp-area="Public" asp-controller="Home" asp-action="Index"> *@  

               @*  لوجو المنصة *@
            <img src="@ViewData["SiteLogoPath"]" alt="شعار المنصة" style="width:100px;height:50px;" />
            @* </a> *@
        </div>

        <!-- ✅ Modal التحليل الذكي -->
        <div class="modal fade" id="smartAnalysisModal" tabindex="-1" aria-labelledby="smartAnalysisTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title fw-bold" id="smartAnalysisTitle">تحليل ذكي</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                    </div>
                    <div class="modal-body" id="smartAnalysisContent">
                        <div class="text-center text-muted">جاري تحميل التحليل...</div>
                    </div>
                </div>
            </div>
        </div>



        <div class="container-fluid p-4">
            @RenderBody()
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById("sidebar");
            const content = document.getElementById("mainContent");

            sidebar.classList.toggle("collapsed");
            content.classList.toggle("collapsed");

            // حفظ الحالة في localStorage
            localStorage.setItem("sidebar-collapsed", sidebar.classList.contains("collapsed"));
        }

        // عند التحميل: إعادة تطبيق الحالة
        document.addEventListener("DOMContentLoaded", function () {
            const isCollapsed = localStorage.getItem("sidebar-collapsed") === "true";
            if (isCollapsed) {
                document.getElementById("sidebar").classList.add("collapsed");
                document.getElementById("mainContent").classList.add("collapsed");
            }
        });
    </script>



    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
