@model QdratNew.ViewModels.EnhancementSkills.EditEnhancementSetViewModel

@{
    ViewData["Title"] = $"تعديل: {Model.Title}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0 text-primary">
            <i class="fas fa-edit me-2"></i> تعديل المجموعة التعزيزية
        </h4>
        <small class="text-muted">@Model.BatchName — @Model.LectureTitle</small>
    </div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-right me-1"></i> رجوع للتفاصيل
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">

        @if (Model.IsSent)
        {
            <div class="alert alert-info border-0 mb-3">
                <i class="fas fa-info-circle me-2"></i>
                هذه المجموعة تم إرسالها للطلاب بالفعل. يمكنك تعديل العنوان والوصف والموعد النهائي.
                <strong>تغيير عدد الأسئلة لن يؤثر على الأسئلة المُرسَلة مسبقاً.</strong>
            </div>
        }

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="BatchName" />
            <input type="hidden" asp-for="LectureTitle" />
            <input type="hidden" asp-for="IsSent" />

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i> معلومات المجموعة</h6>
                </div>
                <div class="card-body">

                    <!-- معلومات ثابتة (قراءة فقط) -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label text-muted small">الدفعة</label>
                            <div class="fw-semibold">@Model.BatchName</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small">المحاضرة</label>
                            <div class="fw-semibold">@Model.LectureTitle</div>
                        </div>
                    </div>

                    <hr class="my-3" />

                    <!-- العنوان -->
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">
                            العنوان <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Title" class="form-control" placeholder="مهارات تعزيزية" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <!-- الوصف -->
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">الوصف</label>
                        <textarea asp-for="Description" class="form-control" rows="2"
                                  placeholder="وصف اختياري..."></textarea>
                    </div>

                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-light py-3">
                    <h6 class="mb-0 fw-bold"><i class="fas fa-sliders me-2"></i> إعدادات الأسئلة والوقت</h6>
                </div>
                <div class="card-body">

                    <div class="row g-3">
                        <!-- عدد الأسئلة -->
                        <div class="col-md-6">
                            <label asp-for="QuestionsPerStudent" class="form-label fw-semibold">
                                عدد الأسئلة لكل طالب <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input asp-for="QuestionsPerStudent" type="number"
                                       class="form-control" min="1" max="100" />
                                <span class="input-group-text">سؤال</span>
                            </div>
                            <span asp-validation-for="QuestionsPerStudent" class="text-danger small"></span>
                        </div>

                        <!-- الموعد النهائي -->
                        <div class="col-md-6">
                            <label asp-for="EndAt" class="form-label fw-semibold">الموعد النهائي</label>
                            <input asp-for="EndAt" type="datetime-local" class="form-control" />
                            <div class="form-text">اختياري — اترك فارغاً إذا لم يكن هناك موعد محدد</div>
                        </div>
                    </div>

                </div>
            </div>

            <div class="d-flex gap-2 justify-content-end">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">إلغاء</a>
                <button type="submit" class="btn btn-primary px-4">
                    <i class="fas fa-save me-1"></i> حفظ التعديلات
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
