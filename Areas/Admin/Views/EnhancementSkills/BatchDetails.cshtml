@model QdratNew.ViewModels.EnhancementSkills.BatchEnhancementDetailsVm

@{
    ViewData["Title"] = $"مهارات دفعة: {Model.BatchName}";
}

<style>
    :root {
        --bd-primary: #6366f1;
        --bd-success: #22c55e;
        --bd-warning: #f59e0b;
        --bd-danger: #ef4444;
        --bd-info: #06b6d4;
        --bd-muted: #64748b;
        --bd-border: #e2e8f0;
        --bd-shadow: 0 1px 4px rgba(0,0,0,.06), 0 4px 16px rgba(0,0,0,.04);
    }
    .bd-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid var(--bd-border);
        box-shadow: var(--bd-shadow);
        overflow: hidden;
        transition: transform .2s, box-shadow .2s;
        height: 100%;
    }
    .bd-card:hover { transform: translateY(-3px); box-shadow: 0 6px 28px rgba(99,102,241,.13); }
    .bd-card-header {
        padding: 16px 18px 12px;
        border-bottom: 1px solid var(--bd-border);
    }
    .bd-card-body { padding: 14px 18px 16px; }
    .bd-status-badge {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 3px 10px; border-radius: 20px;
        font-size: .72rem; font-weight: 700;
    }
    .bd-method-tag {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 2px 8px; border-radius: 6px;
        font-size: .72rem; font-weight: 600;
    }
    .bd-progress-mini { height: 6px; border-radius: 3px; overflow: hidden; background: #f1f5f9; }
    .bd-progress-fill { height: 100%; border-radius: 3px; transition: width .4s; }
    .bd-stat-row { display: flex; gap: 12px; flex-wrap: wrap; margin: 10px 0; }
    .bd-stat-chip {
        display: flex; align-items: center; gap: 5px;
        font-size: .77rem; font-weight: 600;
        color: var(--bd-muted);
    }
    .bd-hero {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 60%, #a78bfa 100%);
        border-radius: 16px;
        padding: 24px 28px;
        color: #fff;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        box-shadow: 0 4px 24px rgba(99,102,241,.3);
    }
    .bd-hero-stats { display: flex; gap: 24px; flex-wrap: wrap; }
    .bd-hero-stat { text-align: center; }
    .bd-hero-stat .val { font-size: 1.8rem; font-weight: 800; line-height: 1; }
    .bd-hero-stat .lbl { font-size: .75rem; opacity: .85; margin-top: 2px; }
    .bd-section-title {
        font-size: 1rem; font-weight: 700; color: #1e293b;
        display: flex; align-items: center; gap: 8px;
        margin-bottom: 16px;
    }
    .bd-archive-toggle {
        background: linear-gradient(135deg, #64748b, #475569);
        border-radius: 12px;
        padding: 14px 20px;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        margin-bottom: 0;
        user-select: none;
    }
    .bd-action-btn {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 5px 10px; border-radius: 7px;
        font-size: .75rem; font-weight: 600;
        border: 1.5px solid;
        transition: all .15s;
        cursor: pointer;
        background: transparent;
    }
    .bd-action-btn:hover { opacity: .85; }
</style>

<!-- Hero -->
<div class="bd-hero">
    <div>
        <div style="font-size:.85rem;opacity:.8;margin-bottom:4px">
            <a asp-action="Index" style="color:#fff;opacity:.75;text-decoration:none">
                <i class="fas fa-brain me-1"></i> المهارات التعزيزية
            </a>
            <i class="fas fa-chevron-left mx-2" style="font-size:.65rem"></i>
            <span>@Model.BatchName</span>
        </div>
        <h4 class="fw-bold mb-1" style="font-size:1.4rem">@Model.BatchName</h4>
        <p class="mb-0" style="opacity:.85;font-size:.9rem">
            <i class="fas fa-book-open me-1"></i> @Model.CourseTitle
            <span class="mx-2 opacity-50">|</span>
            <i class="fas fa-users me-1"></i> @Model.TotalStudents طالب
        </p>
    </div>
    <div class="bd-hero-stats">
        <div class="bd-hero-stat">
            <div class="val">@Model.Sets.Count</div>
            <div class="lbl">مجموعات نشطة</div>
        </div>
        <div class="bd-hero-stat">
            <div class="val">@Model.Sets.Count(s => s.IsSent)</div>
            <div class="lbl">مُرسَل</div>
        </div>
        <div class="bd-hero-stat">
            <div class="val">@Model.Sets.Count(s => !s.IsSent)</div>
            <div class="lbl">انتظار</div>
        </div>
        <div class="bd-hero-stat">
            <div class="val">@Model.ArchivedSets.Count</div>
            <div class="lbl">مؤرشف</div>
        </div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Create" class="btn btn-light btn-sm fw-semibold" style="border-radius:8px">
            <i class="fas fa-plus me-1"></i> مجموعة جديدة
        </a>
        <a asp-action="Index" class="btn btn-outline-light btn-sm" style="border-radius:8px">
            <i class="fas fa-arrow-right me-1"></i> الرئيسية
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" style="border-radius:12px">
        @TempData["Success"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" style="border-radius:12px">
        @TempData["Error"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- المجموعات النشطة -->
@if (Model.Sets.Any())
{
    <div class="bd-section-title mb-3">
        <i class="fas fa-layer-group" style="color:var(--bd-primary)"></i>
        المجموعات النشطة
        <span class="badge ms-1" style="background:#eef2ff;color:var(--bd-primary);font-weight:600">@Model.Sets.Count</span>
    </div>
    <div class="row g-3 mb-4">
        @foreach (var s in Model.Sets)
        {
            var pct = s.StudentsCount > 0 && s.QuestionsPerStudent > 0
                ? (int)Math.Round(s.AnsweredCount * 100.0 / (s.StudentsCount * s.QuestionsPerStudent)) : 0;
            <div class="col-sm-6 col-xl-4">
                <div class="bd-card">
                    <div class="bd-card-header">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <div class="fw-bold" style="font-size:.95rem;color:#1e293b">@s.Title</div>
                            @if (s.IsSent)
                            {
                                <span class="bd-status-badge" style="background:#f0fdf4;color:var(--bd-success)">
                                    <i class="fas fa-check-circle"></i> مُرسَل
                                </span>
                            }
                            else
                            {
                                <span class="bd-status-badge" style="background:#fffbeb;color:var(--bd-warning)">
                                    <i class="fas fa-clock"></i> انتظار
                                </span>
                            }
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            @if (s.GenerationMethod == 1)
                            {
                                <span class="bd-method-tag" style="background:#eef2ff;color:var(--bd-primary)">
                                    <i class="fas fa-layer-group"></i> محاور
                                </span>
                            }
                            else
                            {
                                <span class="bd-method-tag" style="background:#f0fdf4;color:var(--bd-success)">
                                    <i class="fas fa-file-alt"></i> نموذج
                                </span>
                            }
                            <small class="text-muted">@s.LectureTitle</small>
                        </div>
                    </div>
                    <div class="bd-card-body">
                        <div class="bd-stat-row">
                            <span class="bd-stat-chip">
                                <i class="fas fa-users" style="color:var(--bd-info)"></i> @s.StudentsCount طالب
                            </span>
                            <span class="bd-stat-chip">
                                <i class="fas fa-question-circle" style="color:var(--bd-primary)"></i> @s.QuestionsPerStudent س/طالب
                            </span>
                            @if (s.IsSent && s.SentAt.HasValue)
                            {
                                <span class="bd-stat-chip">
                                    <i class="fas fa-calendar" style="color:var(--bd-success)"></i> @s.SentAt.Value.ToString("M/d")
                                </span>
                            }
                            @if (s.EndAt.HasValue)
                            {
                                <span class="bd-stat-chip">
                                    <i class="fas fa-hourglass-end" style="color:var(--bd-danger)"></i> @s.EndAt.Value.ToString("M/d")
                                </span>
                            }
                        </div>

                        @if (s.IsSent && s.StudentsCount > 0)
                        {
                            <div class="mb-2">
                                <div class="d-flex justify-content-between mb-1" style="font-size:.72rem;color:var(--bd-muted)">
                                    <span>نسبة الإجابة</span>
                                    <span class="fw-bold">@pct%</span>
                                </div>
                                <div class="bd-progress-mini">
                                    <div class="bd-progress-fill"
                                         style="width:@pct%;background:@(pct>=70?"#22c55e":pct>=40?"#f59e0b":"#ef4444")"></div>
                                </div>
                            </div>
                        }

                        <div class="d-flex gap-1 flex-wrap mt-2">
                            <a asp-action="Details" asp-route-id="@s.Id"
                               class="bd-action-btn" style="color:var(--bd-info);border-color:var(--bd-info)">
                                <i class="fas fa-eye"></i> تفاصيل
                            </a>
                            <a asp-action="Edit" asp-route-id="@s.Id"
                               class="bd-action-btn" style="color:var(--bd-warning);border-color:var(--bd-warning)">
                                <i class="fas fa-edit"></i> تعديل
                            </a>
                            @if (!s.IsSent)
                            {
                                <form asp-action="Send" method="post" class="d-inline"
                                      onsubmit="return confirm('إرسال للطلاب الآن؟')">
                                    <input type="hidden" name="id" value="@s.Id" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="bd-action-btn"
                                            style="color:var(--bd-success);border-color:var(--bd-success)">
                                        <i class="fas fa-paper-plane"></i> إرسال
                                    </button>
                                </form>
                            }
                            <form asp-action="Archive" method="post" class="d-inline"
                                  onsubmit="return confirm('أرشفة هذه المجموعة؟')">
                                <input type="hidden" name="id" value="@s.Id" />
                                @Html.AntiForgeryToken()
                                <button type="submit" class="bd-action-btn"
                                        style="color:var(--bd-muted);border-color:var(--bd-muted)">
                                    <i class="fas fa-archive"></i>
                                </button>
                            </form>
                            <form asp-action="Delete" method="post" class="d-inline"
                                  onsubmit="return confirm('حذف نهائي؟')">
                                <input type="hidden" name="id" value="@s.Id" />
                                @Html.AntiForgeryToken()
                                <button type="submit" class="bd-action-btn"
                                        style="color:var(--bd-danger);border-color:var(--bd-danger)">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-4 text-muted mb-4">
        <i class="fas fa-inbox fa-2x mb-2 d-block opacity-25"></i>
        لا توجد مجموعات نشطة لهذه الدفعة.
        <br/>
        <a asp-action="Create" class="btn btn-primary btn-sm mt-2">
            <i class="fas fa-plus me-1"></i> إنشاء مجموعة
        </a>
    </div>
}

<!-- الأرشيف -->
@if (Model.ArchivedSets.Any())
{
    <div class="bd-archive-toggle mb-0" onclick="toggleArchive()" style="border-radius:12px 12px 0 0">
        <div class="d-flex align-items-center gap-2">
            <i class="fas fa-archive"></i>
            <span class="fw-bold">أرشيف الدفعة</span>
            <span class="badge bg-light text-secondary">@Model.ArchivedSets.Count</span>
        </div>
        <i class="fas fa-chevron-down" id="archiveArrow" style="transition:.25s"></i>
    </div>
    <div id="archiveBody" style="display:none;background:#fff;border:1px solid var(--bd-border);border-top:none;border-radius:0 0 12px 12px" class="mb-4">
        <div class="p-3">
            <div class="row g-2">
                @foreach (var s in Model.ArchivedSets)
                {
                    <div class="col-sm-6 col-xl-4">
                        <div style="background:#f8fafc;border-radius:10px;border:1px solid var(--bd-border);padding:12px 14px">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="fw-semibold" style="font-size:.88rem;color:#374151">@s.Title</div>
                                <span class="badge bg-secondary-subtle text-secondary" style="font-size:.68rem">مؤرشف</span>
                            </div>
                            <div style="font-size:.75rem;color:var(--bd-muted);margin-bottom:10px">
                                <i class="fas fa-calendar me-1"></i> @s.CreatedAt.ToString("yyyy/MM/dd")
                                <span class="mx-2">·</span>
                                <i class="fas fa-users me-1"></i> @s.StudentsCount طالب
                            </div>
                            <div class="d-flex gap-1">
                                <a asp-action="Details" asp-route-id="@s.Id"
                                   class="btn btn-xs btn-outline-info" style="padding:3px 8px;font-size:.72rem;border-radius:6px">
                                    <i class="fas fa-eye"></i> تفاصيل
                                </a>
                                <form asp-action="Restore" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@s.Id" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-xs btn-outline-success"
                                            style="padding:3px 8px;font-size:.72rem;border-radius:6px"
                                            onclick="return confirm('استرجاع؟')">
                                        <i class="fas fa-undo"></i> استرجاع
                                    </button>
                                </form>
                                <form asp-action="Delete" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@s.Id" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-xs btn-outline-danger"
                                            style="padding:3px 8px;font-size:.72rem;border-radius:6px"
                                            onclick="return confirm('حذف نهائي؟')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function toggleArchive() {
            const body = document.getElementById('archiveBody');
            const arrow = document.getElementById('archiveArrow');
            const isOpen = body.style.display !== 'none';
            body.style.display = isOpen ? 'none' : 'block';
            arrow.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
        }
    </script>
}
