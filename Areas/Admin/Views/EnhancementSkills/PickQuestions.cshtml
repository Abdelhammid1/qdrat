@model QdratNew.ViewModels.EnhancementSkills.PickEnhancementQuestionsViewModel

@{
    ViewData["Title"] = "اختيار الأسئلة";
    var selected = Model.AvailableQuestions.Where(q => q.IsSelected).ToList();
    var available = Model.AvailableQuestions.Where(q => !q.IsSelected).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0 text-primary">
            <i class="fas fa-list-check me-2"></i> اختيار الأسئلة
        </h4>
        <small class="text-muted">@Model.SetTitle — @Model.BatchName — @Model.LectureTitle</small>
    </div>
    <a asp-action="Details" asp-route-id="@Model.SetId" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-right me-1"></i> رجوع للتفاصيل
    </a>
</div>

<form asp-action="PickQuestions" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="SetId" value="@Model.SetId" />
    <input type="hidden" name="SetTitle" value="@Model.SetTitle" />
    <input type="hidden" name="BatchName" value="@Model.BatchName" />
    <input type="hidden" name="LectureTitle" value="@Model.LectureTitle" />

    <div class="row g-4">
        <!-- الأسئلة المتاحة -->
        <div class="col-md-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fas fa-database me-1 text-secondary"></i>
                        الأسئلة المتاحة
                        <span class="badge bg-secondary ms-1">@available.Count</span>
                    </h6>
                    <input type="text" id="searchAvailable" class="form-control form-control-sm"
                           placeholder="بحث..." style="width:160px">
                </div>
                <div class="card-body p-0" style="max-height:520px; overflow-y:auto;">
                    @if (available.Any())
                    {
                        <table class="table table-hover align-middle mb-0 text-end" id="availableTable">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>
                                        <input type="checkbox" id="selectAll" class="form-check-input"
                                               title="تحديد الكل">
                                    </th>
                                    <th>السؤال</th>
                                    <th>الدرس</th>
                                    <th>المحور</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var q in available)
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" name="SelectedQuestionIds"
                                                   value="@q.QuestionId" class="form-check-input q-check" />
                                        </td>
                                        <td class="question-text">
                                            <span class="d-inline-block text-truncate" style="max-width:200px"
                                                  title="@q.Title">@q.Title</span>
                                        </td>
                                        <td><small class="text-muted lesson-text">@q.LessonTitle</small></td>
                                        <td><small class="text-muted">@q.SectionTitle</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="fas fa-inbox fa-2x mb-2 d-block opacity-25"></i>
                            لا توجد أسئلة تعزيزية إضافية لهذه المحاضرة
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- الأسئلة المختارة حالياً -->
        <div class="col-md-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-primary text-white py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fas fa-check-circle me-1"></i>
                        الأسئلة المختارة حالياً
                        <span class="badge bg-white text-primary ms-1">@selected.Count</span>
                    </h6>
                </div>
                <div class="card-body p-0" style="max-height:520px; overflow-y:auto;">
                    @if (selected.Any())
                    {
                        <table class="table table-hover align-middle mb-0 text-end">
                            <tbody>
                                @foreach (var q in selected)
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" name="SelectedQuestionIds"
                                                   value="@q.QuestionId" class="form-check-input"
                                                   checked />
                                        </td>
                                        <td>
                                            <div class="d-inline-block text-truncate" style="max-width:180px"
                                                 title="@q.Title">@q.Title</div>
                                            <div><small class="text-muted">@q.LessonTitle</small></div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="fas fa-hand-pointer fa-2x mb-2 d-block opacity-25"></i>
                            اختر الأسئلة من القائمة على اليمين
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-action="Details" asp-route-id="@Model.SetId" class="btn btn-outline-secondary">إلغاء</a>
        <button type="submit" class="btn btn-primary px-4">
            <i class="fas fa-save me-1"></i> حفظ الاختيار
        </button>
    </div>
</form>

@section Scripts {
    <script>
        // بحث في الجدول
        document.getElementById('searchAvailable')?.addEventListener('input', function () {
            const q = this.value.toLowerCase();
            document.querySelectorAll('#availableTable tbody tr').forEach(row => {
                const text = row.querySelector('.question-text')?.textContent?.toLowerCase() +
                             row.querySelector('.lesson-text')?.textContent?.toLowerCase();
                row.style.display = text?.includes(q) ? '' : 'none';
            });
        });

        // تحديد الكل
        document.getElementById('selectAll')?.addEventListener('change', function () {
            document.querySelectorAll('.q-check').forEach(cb => {
                if (cb.closest('tr').style.display !== 'none') {
                    cb.checked = this.checked;
                }
            });
        });
    </script>
}
