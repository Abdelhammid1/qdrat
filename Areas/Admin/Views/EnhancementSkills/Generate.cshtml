@{
    ViewData["Title"] = "➕ إنشاء جلسة تعزيزية جديدة";
}

<h2 class="fw-bold text-success mb-3">@ViewData["Title"]</h2>

<form asp-action="Generate" method="post">
    <div class="mb-3">
        <label for="batchId" class="form-label">الدفعة</label>
        <input type="number" name="batchId" class="form-control" placeholder="أدخل رقم الدفعة" required />
    </div>

    <div class="mb-3">
        <label for="lectureId" class="form-label">المحاضرة</label>
        <input type="number" name="lectureId" class="form-control" placeholder="أدخل رقم المحاضرة" required />
    </div>

    <div class="mb-3">
        <label for="lessonIds" class="form-label">المؤشرات (IDs مفصولة بفواصل)</label>
        <input type="text" name="lessonIds" class="form-control" placeholder="مثال: 1,2,3" required />
    </div>

    <div class="mb-3">
        <label for="questionsPerStudent" class="form-label">عدد الأسئلة لكل طالب</label>
        <input type="number" name="questionsPerStudent" class="form-control" value="5" />
    </div>

    <button type="submit" class="btn btn-primary">✅ توليد التدريب</button>
    <a asp-action="Index" class="btn btn-secondary">🔙 رجوع</a>
</form>
