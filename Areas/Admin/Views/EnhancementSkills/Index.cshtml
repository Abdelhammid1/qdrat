@model QdratNew.ViewModels.EnhancementSkills.EnhancementIndexVm

@{
    ViewData["Title"] = "المهارات التعزيزية";
}

<style>
    :root {
        --enh-primary: #6366f1;
        --enh-primary-light: #eef2ff;
        --enh-success: #22c55e;
        --enh-success-light: #f0fdf4;
        --enh-warning: #f59e0b;
        --enh-warning-light: #fffbeb;
        --enh-danger: #ef4444;
        --enh-danger-light: #fef2f2;
        --enh-info: #06b6d4;
        --enh-info-light: #ecfeff;
        --enh-muted: #64748b;
        --enh-border: #e2e8f0;
        --enh-card-shadow: 0 1px 3px rgba(0,0,0,.06), 0 4px 16px rgba(0,0,0,.04);
        --enh-card-shadow-hover: 0 4px 24px rgba(99,102,241,.15);
    }

    /* ── Stat Cards ── */
    .enh-stat-card {
        background: #fff;
        border-radius: 16px;
        padding: 20px 22px;
        box-shadow: var(--enh-card-shadow);
        display: flex;
        align-items: center;
        gap: 16px;
        transition: transform .2s, box-shadow .2s;
        border: 1px solid var(--enh-border);
        position: relative;
        overflow: hidden;
    }
    .enh-stat-card::before {
        content: '';
        position: absolute;
        top: 0; right: 0;
        width: 4px;
        height: 100%;
    }
    .enh-stat-card.primary::before { background: var(--enh-primary); }
    .enh-stat-card.success::before { background: var(--enh-success); }
    .enh-stat-card.warning::before { background: var(--enh-warning); }
    .enh-stat-card.danger::before  { background: var(--enh-danger); }
    .enh-stat-card.info::before    { background: var(--enh-info); }
    .enh-stat-card.muted::before   { background: var(--enh-muted); }

    .enh-stat-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--enh-card-shadow-hover);
    }
    .enh-stat-icon {
        width: 52px; height: 52px;
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }
    .enh-stat-icon.primary { background: var(--enh-primary-light); color: var(--enh-primary); }
    .enh-stat-icon.success { background: var(--enh-success-light); color: var(--enh-success); }
    .enh-stat-icon.warning { background: var(--enh-warning-light); color: var(--enh-warning); }
    .enh-stat-icon.danger  { background: var(--enh-danger-light);  color: var(--enh-danger); }
    .enh-stat-icon.info    { background: var(--enh-info-light);    color: var(--enh-info); }
    .enh-stat-icon.muted   { background: #f1f5f9; color: var(--enh-muted); }

    .enh-stat-value {
        font-size: 2rem;
        font-weight: 800;
        line-height: 1;
        color: #0f172a;
    }
    .enh-stat-label {
        font-size: .8rem;
        color: var(--enh-muted);
        margin-top: 4px;
    }

    /* ── Chart Cards ── */
    .enh-chart-card {
        background: #fff;
        border-radius: 16px;
        padding: 20px;
        box-shadow: var(--enh-card-shadow);
        border: 1px solid var(--enh-border);
        height: 100%;
    }
    .enh-chart-title {
        font-weight: 700;
        font-size: .95rem;
        color: #1e293b;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .enh-chart-title i { color: var(--enh-primary); }

    /* ── Batch Cards ── */
    .enh-batch-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid var(--enh-border);
        box-shadow: var(--enh-card-shadow);
        transition: transform .2s, box-shadow .2s;
        overflow: hidden;
    }
    .enh-batch-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 32px rgba(99,102,241,.14);
    }
    .enh-batch-header {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        padding: 18px 20px 14px;
        color: #fff;
    }
    .enh-batch-name {
        font-weight: 800;
        font-size: 1.05rem;
        margin-bottom: 2px;
    }
    .enh-batch-course {
        font-size: .78rem;
        opacity: .85;
    }
    .enh-batch-body { padding: 16px 20px 18px; }
    .enh-batch-stats { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; }
    .enh-batch-stat-pill {
        display: flex; align-items: center; gap: 6px;
        font-size: .78rem; font-weight: 600;
        padding: 4px 10px;
        border-radius: 20px;
    }
    .enh-batch-progress { margin-bottom: 14px; }
    .enh-batch-progress .prog-label {
        display: flex; justify-content: space-between;
        font-size: .75rem; color: var(--enh-muted);
        margin-bottom: 4px;
    }
    .enh-batch-progress .progress { height: 7px; border-radius: 4px; }

    /* ── Archive Section ── */
    .enh-archive-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid var(--enh-border);
        box-shadow: var(--enh-card-shadow);
        overflow: hidden;
    }
    .enh-archive-header {
        background: linear-gradient(135deg, #64748b 0%, #475569 100%);
        padding: 14px 20px;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        user-select: none;
    }
    .enh-table-wrapper { overflow-x: auto; }
    .enh-table { width: 100%; border-collapse: collapse; font-size: .875rem; }
    .enh-table th {
        background: #f8fafc;
        padding: 10px 14px;
        font-weight: 600;
        color: var(--enh-muted);
        text-align: right;
        border-bottom: 1px solid var(--enh-border);
        white-space: nowrap;
    }
    .enh-table td {
        padding: 11px 14px;
        border-bottom: 1px solid #f1f5f9;
        color: #374151;
        vertical-align: middle;
    }
    .enh-table tr:last-child td { border-bottom: none; }
    .enh-table tbody tr:hover td { background: #fafbff; }

    /* ── Section Header ── */
    .enh-section-header {
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 16px;
    }
    .enh-section-title {
        font-size: 1rem;
        font-weight: 700;
        color: #1e293b;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .enh-badge {
        display: inline-flex; align-items: center;
        padding: 2px 9px;
        border-radius: 20px;
        font-size: .72rem;
        font-weight: 600;
    }

    /* Dark mode */
    @@media (prefers-color-scheme: dark) {
        .enh-stat-card, .enh-chart-card, .enh-batch-card, .enh-archive-card { background: #1e293b; border-color: #334155; }
        .enh-stat-value { color: #f1f5f9; }
        .enh-section-title { color: #f1f5f9; }
        .enh-table th { background: #0f172a; color: #94a3b8; border-color: #334155; }
        .enh-table td { color: #cbd5e1; border-color: #1e293b; }
    }
</style>

<!-- ══ Header ══ -->
<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h4 class="fw-bold mb-1" style="color:#1e293b">
            <i class="fas fa-brain me-2" style="color:var(--enh-primary)"></i> المهارات التعزيزية
        </h4>
        <p class="text-muted mb-0 small">لوحة إدارة وإرسال المهارات التعزيزية للدفعات</p>
    </div>
    <a asp-action="Create" class="btn btn-primary px-4" style="border-radius:10px">
        <i class="fas fa-plus me-1"></i> إنشاء مجموعة جديدة
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" style="border-radius:12px">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" style="border-radius:12px">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ══ بطاقات الإحصاءات ══ -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="enh-stat-card primary">
            <div class="enh-stat-icon primary"><i class="fas fa-layer-group"></i></div>
            <div>
                <div class="enh-stat-value">@Model.TotalSets</div>
                <div class="enh-stat-label">إجمالي المجموعات</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="enh-stat-card success">
            <div class="enh-stat-icon success"><i class="fas fa-paper-plane"></i></div>
            <div>
                <div class="enh-stat-value">@Model.SentSets</div>
                <div class="enh-stat-label">تم الإرسال</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="enh-stat-card warning">
            <div class="enh-stat-icon warning"><i class="fas fa-clock"></i></div>
            <div>
                <div class="enh-stat-value">@Model.PendingSets</div>
                <div class="enh-stat-label">في الانتظار</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="enh-stat-card muted">
            <div class="enh-stat-icon muted"><i class="fas fa-archive"></i></div>
            <div>
                <div class="enh-stat-value">@Model.ArchivedCount</div>
                <div class="enh-stat-label">المؤرشف</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="enh-stat-card info">
            <div class="enh-stat-icon info"><i class="fas fa-users"></i></div>
            <div>
                <div class="enh-stat-value">@Model.TotalStudentsReached</div>
                <div class="enh-stat-label">طلاب مستفيدون</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="enh-stat-card @(Model.OverallResponseRate >= 70 ? "success" : Model.OverallResponseRate >= 40 ? "warning" : "danger")">
            <div class="enh-stat-icon @(Model.OverallResponseRate >= 70 ? "success" : Model.OverallResponseRate >= 40 ? "warning" : "danger")">
                <i class="fas fa-chart-pie"></i>
            </div>
            <div>
                <div class="enh-stat-value">@Model.OverallResponseRate%</div>
                <div class="enh-stat-label">نسبة الاستجابة</div>
            </div>
        </div>
    </div>
</div>

<!-- ══ 3 رسوم بيانية ══ -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="enh-chart-card">
            <div class="enh-chart-title"><i class="fas fa-chart-donut"></i> توزيع حالات المجموعات</div>
            <canvas id="donutChart" height="220"></canvas>
        </div>
    </div>
    <div class="col-md-4">
        <div class="enh-chart-card">
            <div class="enh-chart-title"><i class="fas fa-chart-bar"></i> المجموعات حسب الدفعة</div>
            <canvas id="batchBarChart" height="220"></canvas>
        </div>
    </div>
    <div class="col-md-4">
        <div class="enh-chart-card">
            <div class="enh-chart-title"><i class="fas fa-chart-line"></i> نسبة الاستجابة لكل دفعة</div>
            <canvas id="responseChart" height="220"></canvas>
        </div>
    </div>
</div>

<!-- ══ الدفعات ══ -->
@if (Model.BatchCards.Any())
{
    <div class="enh-section-header mb-3">
        <div class="enh-section-title">
            <i class="fas fa-graduation-cap" style="color:var(--enh-primary)"></i>
            المجموعات حسب الدفعة
            <span class="enh-badge ms-1" style="background:#eef2ff;color:var(--enh-primary)">@Model.BatchCards.Count دفعة</span>
        </div>
    </div>
    <div class="row g-3 mb-4">
        @foreach (var batch in Model.BatchCards)
        {
            <div class="col-sm-6 col-lg-4 col-xl-3">
                <div class="enh-batch-card h-100">
                    <div class="enh-batch-header">
                        <div class="enh-batch-name">@batch.BatchName</div>
                        <div class="enh-batch-course">
                            <i class="fas fa-book-open me-1"></i>@batch.CourseTitle
                        </div>
                    </div>
                    <div class="enh-batch-body">
                        <div class="enh-batch-stats">
                            <span class="enh-batch-stat-pill" style="background:#eef2ff;color:var(--enh-primary)">
                                <i class="fas fa-layer-group"></i> @batch.TotalSets مجموعة
                            </span>
                            <span class="enh-batch-stat-pill" style="background:var(--enh-success-light);color:var(--enh-success)">
                                <i class="fas fa-check"></i> @batch.SentSets مُرسَل
                            </span>
                            @if (batch.PendingSets > 0)
                            {
                                <span class="enh-batch-stat-pill" style="background:var(--enh-warning-light);color:var(--enh-warning)">
                                    <i class="fas fa-clock"></i> @batch.PendingSets انتظار
                                </span>
                            }
                            @if (batch.ArchivedSets > 0)
                            {
                                <span class="enh-batch-stat-pill" style="background:#f1f5f9;color:var(--enh-muted)">
                                    <i class="fas fa-archive"></i> @batch.ArchivedSets أرشيف
                                </span>
                            }
                            <span class="enh-batch-stat-pill" style="background:var(--enh-info-light);color:var(--enh-info)">
                                <i class="fas fa-users"></i> @batch.TotalStudents طالب
                            </span>
                        </div>
                        @if (batch.TotalAssignments > 0)
                        {
                            <div class="enh-batch-progress">
                                <div class="prog-label">
                                    <span>نسبة الاستجابة</span>
                                    <span class="fw-bold">@batch.ResponseRate%</span>
                                </div>
                                <div class="progress">
                                    <div class="progress-bar @(batch.ResponseRate >= 70 ? "bg-success" : batch.ResponseRate >= 40 ? "bg-warning" : "bg-danger")"
                                         style="width:@batch.ResponseRate%"></div>
                                </div>
                            </div>
                        }
                        <a asp-action="BatchDetails" asp-route-batchId="@batch.BatchId"
                           class="btn btn-sm w-100 fw-semibold"
                           style="background:var(--enh-primary);color:#fff;border-radius:8px;padding:8px">
                            <i class="fas fa-eye me-1"></i> عرض مهارات الدفعة
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5 text-muted">
        <i class="fas fa-brain fa-3x mb-3 d-block opacity-25"></i>
        <div class="fw-semibold mb-2">لا توجد مجموعات تعزيزية بعد</div>
        <a asp-action="Create" class="btn btn-primary btn-sm mt-1">
            <i class="fas fa-plus me-1"></i> إنشاء أول مجموعة
        </a>
    </div>
}

<!-- ══ الأرشيف ══ -->
@if (Model.ArchivedSets.Any())
{
    <div class="enh-archive-card mb-4">
        <div class="enh-archive-header" onclick="toggleArchive()" id="archiveToggle">
            <div class="d-flex align-items-center gap-2">
                <i class="fas fa-archive"></i>
                <span class="fw-bold">الأرشيف</span>
                <span class="badge bg-light text-secondary ms-1">@Model.ArchivedSets.Count</span>
            </div>
            <i class="fas fa-chevron-down" id="archiveArrow" style="transition:.2s"></i>
        </div>
        <div id="archiveBody" style="display:none">
            <div class="enh-table-wrapper">
                <table class="enh-table">
                    <thead>
                        <tr>
                            <th>المجموعة</th>
                            <th>الدفعة</th>
                            <th>المصدر</th>
                            <th>تاريخ الإنشاء</th>
                            <th>الطلاب</th>
                            <th>الإجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.ArchivedSets)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@s.Title</div>
                                    @if (!string.IsNullOrEmpty(s.Description))
                                    {
                                        <small class="text-muted">@s.Description</small>
                                    }
                                </td>
                                <td><span class="badge bg-secondary-subtle text-secondary">@s.BatchName</span></td>
                                <td>
                                    @if (s.GenerationMethod == 1)
                                    {
                                        <span class="badge" style="background:#eef2ff;color:var(--enh-primary)">
                                            <i class="fas fa-layer-group me-1"></i>محاور
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:#f0fdf4;color:var(--enh-success)">
                                            <i class="fas fa-file-alt me-1"></i>نموذج
                                        </span>
                                    }
                                </td>
                                <td><small class="text-muted">@s.CreatedAt.ToString("yyyy/MM/dd")</small></td>
                                <td><span class="badge bg-info-subtle text-info">@s.StudentsCount</span></td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@s.Id"
                                           class="btn btn-xs btn-outline-info" style="padding:3px 8px;font-size:.75rem" title="تفاصيل">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <form asp-action="Restore" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@s.Id" />
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-xs btn-outline-success"
                                                    style="padding:3px 8px;font-size:.75rem" title="استرجاع"
                                                    onclick="return confirm('استرجاع هذه المجموعة من الأرشيف؟')">
                                                <i class="fas fa-undo"></i> استرجاع
                                            </button>
                                        </form>
                                        <form asp-action="Delete" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@s.Id" />
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-xs btn-outline-danger"
                                                    style="padding:3px 8px;font-size:.75rem" title="حذف"
                                                    onclick="return confirm('حذف نهائي؟')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        // ── بيانات الرسوم من السيرفر ──
        const sent = @Model.SentSets;
        const pending = @Model.PendingSets;
        const archived = @Model.ArchivedCount;

        const batchLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.BatchCards.Select(b => b.BatchName).ToList()));
        const batchTotals = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.BatchCards.Select(b => b.TotalSets).ToList()));
        const batchSent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.BatchCards.Select(b => b.SentSets).ToList()));
        const batchRates = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.BatchCards.Select(b => b.ResponseRate).ToList()));

        // ── Chart 1: Donut ──
        new Chart(document.getElementById('donutChart'), {
            type: 'doughnut',
            data: {
                labels: ['مُرسَل', 'في الانتظار', 'مؤرشف'],
                datasets: [{
                    data: [sent, pending, archived],
                    backgroundColor: ['#22c55e', '#f59e0b', '#94a3b8'],
                    borderWidth: 0,
                    hoverOffset: 6
                }]
            },
            options: {
                cutout: '68%',
                plugins: {
                    legend: { position: 'bottom', labels: { font: { family: 'Cairo' }, padding: 12, boxWidth: 12 } }
                },
                animation: { duration: 700, easing: 'easeInOutQuart' }
            }
        });

        // ── Chart 2: Bar (دفعات) ──
        new Chart(document.getElementById('batchBarChart'), {
            type: 'bar',
            data: {
                labels: batchLabels,
                datasets: [
                    { label: 'إجمالي', data: batchTotals, backgroundColor: '#c7d2fe', borderRadius: 6, borderSkipped: false },
                    { label: 'مُرسَل', data: batchSent, backgroundColor: '#6366f1', borderRadius: 6, borderSkipped: false }
                ]
            },
            options: {
                plugins: { legend: { labels: { font: { family: 'Cairo' }, boxWidth: 12 } } },
                scales: {
                    x: { grid: { display: false }, ticks: { font: { family: 'Cairo' } } },
                    y: { grid: { color: '#f1f5f9' }, beginAtZero: true, ticks: { stepSize: 1, font: { family: 'Cairo' } } }
                },
                animation: { duration: 700 }
            }
        });

        // ── Chart 3: Response Rate ──
        new Chart(document.getElementById('responseChart'), {
            type: 'bar',
            data: {
                labels: batchLabels,
                datasets: [{
                    label: 'نسبة الاستجابة %',
                    data: batchRates,
                    backgroundColor: batchRates.map(r => r >= 70 ? '#22c55e' : r >= 40 ? '#f59e0b' : '#ef4444'),
                    borderRadius: 6, borderSkipped: false
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false }, ticks: { font: { family: 'Cairo' } } },
                    y: {
                        grid: { color: '#f1f5f9' }, beginAtZero: true, max: 100,
                        ticks: { callback: v => v + '%', font: { family: 'Cairo' } }
                    }
                },
                animation: { duration: 700 }
            }
        });

        // ── Toggle Archive ──
        function toggleArchive() {
            const body = document.getElementById('archiveBody');
            const arrow = document.getElementById('archiveArrow');
            const isOpen = body.style.display !== 'none';
            body.style.display = isOpen ? 'none' : 'block';
            arrow.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
        }
    </script>
}
