@model QdratNew.ViewModels.Exam.ExamBatchDetailsPageVM
@using Microsoft.AspNetCore.Authorization
@using QdratNew.Security.AdminPermissions
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = $"اختبارات دفعة {Model.BatchName}";
    var totalExams = Model.Exams.Count;
    var sentExams = Model.Exams.Count(x => x.IsSent);
    var totalCompleted = Model.Exams.Sum(x => x.CompletedCount);
    var totalPending = Model.Exams.Sum(x => x.PendingCount);

    var canViewDetails  = (await AuthorizationService.AuthorizeAsync(User, AdminPermissionPolicies.Exams_Details)).Succeeded;
    var canViewResults  = (await AuthorizationService.AuthorizeAsync(User, AdminPermissionPolicies.Exams_Results)).Succeeded;
    var canPublishExam  = (await AuthorizationService.AuthorizeAsync(User, AdminPermissionPolicies.Exams_Publish)).Succeeded;
    var canArchiveExam  = (await AuthorizationService.AuthorizeAsync(User, AdminPermissionPolicies.Exams_Archive)).Succeeded;
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <style>
        :root {
            --ink:#0D1B2A;--ink-2:#2C3E50;--ink-3:#5A6A7A;--ink-4:#8FA0B0;--ink-5:#C8D5E0;
            --canvas:#F3F6FA;--surface:#FFFFFF;--surface-2:#F8FAFC;--surface-3:#EEF2F7;--border:#DDE4EC;
            --blue:#1B5EAE;--blue-2:#2471D0;--blue-bg:#E8F1FB;--blue-dark:#103E7A;
            --emerald:#0D7A5B;--emerald-bg:#E4F5EE;--amber:#985D09;--amber-bg:#FDF0D8;
            --rose:#BF1030;--rose-bg:#FDEAEE;--violet:#5535B5;--violet-bg:#EDE8F9;
            --r-sm:6px;--r-md:10px;--r-lg:14px;--r-xl:20px;
            --sh-xs:0 1px 3px rgba(13,27,42,.06);--sh-sm:0 2px 8px rgba(13,27,42,.08);--sh-md:0 4px 18px rgba(13,27,42,.10);
            --ease:cubic-bezier(.25,.46,.45,.94);
        }

        .be-page { background:var(--canvas);min-height:100vh;padding:32px 28px 64px;direction:rtl;font-family:'Cairo',sans-serif;color:var(--ink-2); }
        .be-topbar { display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;margin-bottom:28px; }
        .be-back-btn { display:inline-flex;align-items:center;gap:7px;padding:9px 18px;border:1px solid var(--border);border-radius:var(--r-md);background:var(--surface);color:var(--ink-3);font-size:14px;font-weight:800;text-decoration:none;transition:all .15s; }
        .be-back-btn:hover { background:var(--blue-bg);border-color:#b6d3f4;color:var(--blue); }
        .be-brand { display:flex;align-items:center;gap:13px; }
        .be-brand-icon { width:46px;height:46px;background:var(--violet);border-radius:var(--r-lg);display:flex;align-items:center;justify-content:center;color:#fff;font-size:20px;box-shadow:0 4px 14px rgba(85,53,181,.25); }
        .be-brand-title { font-size:20px;font-weight:900;color:var(--ink);line-height:1.15; }
        .be-brand-sub { font-size:14px;color:var(--ink-4);margin-top:2px; }

        .be-kpis { display:grid;grid-template-columns:repeat(5,1fr);gap:13px;margin-bottom:24px; }
        @@media(max-width:1100px){ .be-kpis{grid-template-columns:repeat(3,1fr);} }
        @@media(max-width:700px){ .be-kpis{grid-template-columns:repeat(2,1fr);} }
        .kpi-card { background:var(--surface);border:1px solid var(--border);border-radius:var(--r-xl);padding:18px 19px;display:flex;align-items:center;gap:13px;box-shadow:var(--sh-xs);position:relative;overflow:hidden; }
        .kpi-card::after { content:'';position:absolute;top:0;right:0;width:4px;height:100%; }
        .kpi-blue::after{background:var(--blue);} .kpi-emerald::after{background:var(--emerald);} .kpi-amber::after{background:var(--amber);} .kpi-rose::after{background:var(--rose);} .kpi-violet::after{background:var(--violet);}
        .kpi-ico { width:42px;height:42px;border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0; }
        .ico-blue{background:var(--blue-bg);color:var(--blue);} .ico-emerald{background:var(--emerald-bg);color:var(--emerald);} .ico-amber{background:var(--amber-bg);color:var(--amber);} .ico-rose{background:var(--rose-bg);color:var(--rose);} .ico-violet{background:var(--violet-bg);color:var(--violet);}
        .kpi-label { font-size:12px;font-weight:800;color:var(--ink-4);margin-bottom:3px; }
        .kpi-val { font-size:22px;font-weight:900;color:var(--ink);line-height:1; }

        .ex-section-card { background:var(--surface);border:1px solid var(--border);border-radius:var(--r-xl);box-shadow:var(--sh-sm); }
        .ex-section-topbar { display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid var(--surface-3);flex-wrap:wrap; }
        .section-title { display:flex;align-items:center;gap:8px;font-size:18px;font-weight:900;color:var(--ink);margin-left:10px; }
        .section-title i { color:var(--violet); }
        .ex-search-wrap { position:relative;flex:1;min-width:220px;max-width:380px; }
        .ex-search-wrap i { position:absolute;right:11px;top:50%;transform:translateY(-50%);color:var(--ink-4);font-size:14px;pointer-events:none; }
        .ex-search-wrap input { width:100%;padding:7px 32px 7px 12px;border:1px solid var(--border);border-radius:var(--r-md);font-size:14px;background:var(--surface-2);color:var(--ink); }
        .total-badge { margin-right:auto;font-size:13px;color:var(--ink-4); }
        .total-badge strong { color:var(--violet);font-weight:900; }

        .ex-cards-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:16px;padding:18px; }
        @@media(max-width:1200px){ .ex-cards-grid{grid-template-columns:repeat(2,1fr);} }
        @@media(max-width:768px){ .be-page{padding:22px 14px 48px;} .ex-cards-grid{grid-template-columns:1fr;padding:14px;} }
        .ex-card { background:var(--surface);border:1px solid var(--border);border-radius:var(--r-xl);box-shadow:var(--sh-xs);transition:transform .18s var(--ease),box-shadow .18s,border-color .18s;overflow:hidden;position:relative; }
        .ex-card::before { content:'';position:absolute;top:0;right:0;width:5px;height:100%;background:var(--violet); }
        .ex-card.is-pending::before { background:var(--amber); }
        .ex-card.is-archived { opacity:.82; }
        .ex-card:hover { transform:translateY(-4px);box-shadow:var(--sh-md);border-color:#D7CDF8; }
        .ex-card-body { padding:18px 18px 16px; }
        .ex-card-head { margin-bottom:14px; }
        .ex-card-title-row { display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:6px; }
        .ex-card-icon { width:36px;height:36px;border-radius:var(--r-md);background:var(--violet-bg);color:var(--violet);display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0; }
        .ex-card-title { font-size:15px;font-weight:900;color:var(--ink);line-height:1.35; }
        .ex-card-date { font-size:12px;color:var(--ink-4);margin-top:3px; }
        .status-pill { display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:30px;font-size:11px;font-weight:900;white-space:nowrap; }
        .pill-sent { background:var(--emerald-bg);color:var(--emerald); }
        .pill-pending { background:var(--surface-3);color:var(--ink-4); }
        .pill-archived { background:var(--amber-bg);color:var(--amber); }
        .ex-meta-row { display:flex;gap:7px;flex-wrap:wrap;margin-bottom:12px; }
        .ex-meta-chip { display:inline-flex;align-items:center;gap:5px;background:var(--surface-2);border:1px solid var(--surface-3);border-radius:30px;padding:5px 9px;font-size:12px;font-weight:800;color:var(--ink-3); }
        .ex-stats-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-bottom:12px; }
        .ex-stat { background:var(--surface-2);border:1px solid var(--surface-3);border-radius:var(--r-md);padding:9px 6px;text-align:center; }
        .stat-val { display:block;font-size:18px;font-weight:900;color:var(--ink);line-height:1.1; }
        .stat-label { display:block;font-size:11px;color:var(--ink-4);margin-top:2px; }
        .text-emerald{color:var(--emerald)!important;} .text-amber{color:var(--amber)!important;} .text-violet{color:var(--violet)!important;}
        .ex-progress-wrap { margin-bottom:12px; }
        .ex-progress-meta { display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--ink-4);margin-bottom:5px; }
        .ex-progress-meta strong { color:var(--ink);font-size:13px; }
        .ex-progress { width:100%;height:8px;border-radius:30px;background:var(--surface-3);overflow:hidden; }
        .ex-progress-bar { height:100%;border-radius:30px;background:var(--emerald);transition:width .3s ease; }
        .ex-card-actions { display:flex;gap:8px;flex-wrap:wrap; }
        .ex-action-btn { flex:1;display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:9px 10px;border-radius:var(--r-md);font-size:13px;font-weight:900;text-decoration:none;transition:all .15s;border:1px solid var(--border);cursor:pointer; }
        .btn-details { background:var(--blue);color:#fff;border-color:var(--blue); }
        .btn-details:hover { background:var(--blue-dark);color:#fff; }
        .btn-students { background:var(--amber-bg);color:var(--amber);border-color:#F3D494; }
        .btn-students:hover { background:var(--amber);color:#fff; }
        .btn-analytics { background:var(--violet-bg);color:var(--violet);border-color:#D7CDF8; }
        .btn-analytics:hover { background:var(--violet);color:#fff; }
        .btn-archive { background:var(--surface-3);color:var(--ink-3);border-color:var(--border); }
        .btn-archive:hover { background:var(--ink);color:#fff; }
        .ex-empty { text-align:center;padding:56px 16px;color:var(--ink-4); }
        .ex-empty i { font-size:22px;display:block;margin-bottom:12px;color:var(--ink-5); }
        .ex-empty-title { font-size:18px;font-weight:900;color:var(--ink-3); }
    </style>
}

<div class="be-page">
    <form id="antiForgeryForm" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <div class="be-topbar">
        <div class="be-brand">
            <div class="be-brand-icon"><i class="fas fa-file-signature"></i></div>
            <div>
                <div class="be-brand-title">اختبارات دفعة @Model.BatchName</div>
                <div class="be-brand-sub">@Model.CourseTitle</div>
            </div>
        </div>

        <a asp-area="Admin"
           asp-controller="ExamAssignments"
           asp-action="Index"
           asp-route-showArchived="@Model.IsArchived"
           class="be-back-btn">
            <i class="fas fa-arrow-right"></i>
            رجوع للدفعات
        </a>
    </div>

    <div class="be-kpis">
        <div class="kpi-card kpi-blue">
            <div class="kpi-ico ico-blue"><i class="fas fa-user-graduate"></i></div>
            <div><div class="kpi-label">طلاب الدفعة</div><div class="kpi-val">@Model.TotalStudents</div></div>
        </div>
        <div class="kpi-card kpi-violet">
            <div class="kpi-ico ico-violet"><i class="fas fa-file-signature"></i></div>
            <div><div class="kpi-label">اختبارات الدفعة</div><div class="kpi-val">@totalExams</div></div>
        </div>
        <div class="kpi-card kpi-emerald">
            <div class="kpi-ico ico-emerald"><i class="fas fa-paper-plane"></i></div>
            <div><div class="kpi-label">اختبارات مرسلة</div><div class="kpi-val">@sentExams</div></div>
        </div>
        <div class="kpi-card kpi-amber">
            <div class="kpi-ico ico-amber"><i class="fas fa-hourglass-half"></i></div>
            <div><div class="kpi-label">لم يبدأ</div><div class="kpi-val">@totalPending</div></div>
        </div>
        <div class="kpi-card kpi-rose">
            <div class="kpi-ico ico-rose"><i class="fas fa-check-circle"></i></div>
            <div><div class="kpi-label">مكتمل</div><div class="kpi-val">@totalCompleted</div></div>
        </div>
    </div>

    <div class="ex-section-card">
        <div class="ex-section-topbar">
            <div class="section-title">
                <i class="fas fa-clipboard-list"></i>
                @(Model.IsArchived ? "اختبارات الدفعة المؤرشفة" : "اختبارات الدفعة")
            </div>
            <div class="ex-search-wrap">
                <i class="fas fa-search"></i>
                <input type="text" id="examSearch" placeholder="ابحث في الاختبارات أو المناهج..." />
            </div>
            <div class="total-badge">إجمالي: <strong>@totalExams</strong> اختبار</div>
        </div>

        @if (!Model.Exams.Any())
        {
            <div class="ex-empty">
                <i class="fas fa-inbox"></i>
                <div class="ex-empty-title">لا توجد اختبارات لهذه الدفعة</div>
            </div>
        }
        else
        {
            <div class="ex-cards-grid" id="examCardsGrid">
                @foreach (var exam in Model.Exams)
                {
                    var statusClass = exam.IsSent ? "" : "is-pending";
                    var archivedClass = exam.IsArchived ? "is-archived" : "";
                    <article class="ex-card @statusClass @archivedClass" data-search="@($"{exam.Title} {exam.CurriculumTitle}".ToLower())">
                        <div class="ex-card-body">
                            <div class="ex-card-head">
                                <div class="ex-card-title-row">
                                    <div class="d-flex align-items-start gap-2">
                                        <div class="ex-card-icon"><i class="fas fa-file-signature"></i></div>
                                        <div>
                                            <div class="ex-card-title">@exam.Title</div>
                                            <div class="ex-card-date">@exam.CreatedAt.ToString("yyyy/MM/dd HH:mm")</div>
                                        </div>
                                    </div>
                                    @if (exam.IsArchived)
                                    {
                                        <span class="status-pill pill-archived"><i class="fas fa-archive"></i> مؤرشف</span>
                                    }
                                    else if (exam.IsSent)
                                    {
                                        <span class="status-pill pill-sent"><i class="fas fa-check"></i> مرسل</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill pill-pending"><i class="fas fa-clock"></i> غير مرسل</span>
                                    }
                                </div>
                            </div>

                            <div class="ex-meta-row">
                                <span class="ex-meta-chip"><i class="fas fa-book-open"></i>@(!string.IsNullOrWhiteSpace(exam.CurriculumTitle) ? exam.CurriculumTitle : "بدون منهج")</span>
                                <span class="ex-meta-chip"><i class="fas fa-question-circle"></i>@exam.TotalQuestions سؤال</span>
                                <span class="ex-meta-chip"><i class="fas fa-stopwatch"></i>@exam.DurationMinutes دقيقة</span>
                                <span class="ex-meta-chip"><i class="fas @(exam.IsOnline ? "fa-wifi" : "fa-building")"></i>@(exam.IsOnline ? "أونلاين" : "حضوري")</span>
                            </div>

                            <div class="ex-stats-grid">
                                <div class="ex-stat">
                                    <span class="stat-val">@exam.TotalAssigned</span>
                                    <span class="stat-label">مكلف</span>
                                </div>
                                <div class="ex-stat">
                                    <span class="stat-val text-emerald">@exam.CompletedCount</span>
                                    <span class="stat-label">مكتمل</span>
                                </div>
                                <div class="ex-stat">
                                    <span class="stat-val text-amber">@exam.PendingCount</span>
                                    <span class="stat-label">لم يبدأ</span>
                                </div>
                            </div>

                            <div class="ex-progress-wrap">
                                <div class="ex-progress-meta">
                                    <span>نسبة الإنهاء</span>
                                    <strong>@exam.CompletionPercentage%</strong>
                                </div>
                                <div class="ex-progress">
                                    <div class="ex-progress-bar" style="width:@exam.CompletionPercentage%"></div>
                                </div>
                            </div>

                            <div class="ex-card-actions">
                                @if (canViewDetails)
                                {
                                    <a asp-area="Admin" asp-controller="ExamAssignments" asp-action="Details" asp-route-id="@exam.AssignmentId" class="ex-action-btn btn-details">
                                        <i class="fas fa-info-circle"></i>
                                        تفاصيل
                                    </a>
                                }
                                <a asp-area="Admin" asp-controller="ExamAssignments" asp-action="ExamStudents" asp-route-assignmentId="@exam.AssignmentId" class="ex-action-btn btn-students">
                                    <i class="fas fa-users"></i>
                                    الطلاب
                                </a>
                                @if (canViewResults)
                                {
                                    <a asp-area="Admin" asp-controller="ExamAssignments" asp-action="ExamBatchAnalytics" asp-route-assignmentId="@exam.AssignmentId" class="ex-action-btn btn-analytics">
                                        <i class="fas fa-chart-line"></i>
                                        التحليل
                                    </a>
                                }
                                @if (canArchiveExam)
                                {
                                    <button type="button" class="ex-action-btn btn-archive" data-id="@exam.AssignmentId" data-restore="@exam.IsArchived.ToString().ToLowerInvariant()">
                                        <i class="fas @(exam.IsArchived ? "fa-undo" : "fa-archive")"></i>
                                        @(exam.IsArchived ? "إخراج" : "أرشفة")
                                    </button>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const search = document.getElementById('examSearch');
            if (search) {
                search.addEventListener('input', function () {
                    const term = (this.value || '').toLowerCase().trim();
                    document.querySelectorAll('#examCardsGrid .ex-card').forEach(function (card) {
                        const text = (card.getAttribute('data-search') || card.textContent || '').toLowerCase();
                        card.style.display = text.includes(term) ? '' : 'none';
                    });
                });
            }

            function token() {
                const input = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]');
                return input ? input.value : '';
            }

            document.querySelectorAll('[data-id][data-restore]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const id = btn.getAttribute('data-id');
                    const restore = btn.getAttribute('data-restore') === 'true';
                    const message = restore
                        ? 'هل تريد إخراج هذا الاختبار من الأرشيف؟'
                        : 'هل تريد نقل هذا الاختبار إلى الأرشيف؟';

                    if (!confirm(message)) return;

                    fetch(restore ? '/Admin/ExamAssignments/RestoreExamAssignment' : '/Admin/ExamAssignments/ArchiveExamAssignment', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                            'RequestVerificationToken': token()
                        },
                        body: new URLSearchParams({ id: id }).toString()
                    })
                    .then(function (response) { return response.json(); })
                    .then(function (result) {
                        if (!result || !result.success) {
                            alert(result && result.message ? result.message : 'تعذر تنفيذ العملية.');
                            return;
                        }

                        window.location.reload();
                    })
                    .catch(function () {
                        alert('تعذر الاتصال بالخادم.');
                    });
                });
            });
        });
    </script>
}
