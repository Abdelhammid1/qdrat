@model QdratNew.ViewModels.Exam.AllBatchesForAnalysisViewModel
@{
    ViewData["Title"] = "تحليل المحاور المنتهية حسب الدفعة";
}

<h2 class="mb-4">🧠 تحليل المحاور المنتهية حسب الدفعة</h2>

@if (!Model.Batches.Any())
{
    <div class="alert alert-warning">لا توجد دفعات متاحة للتحليل.</div>
}
else
{
    <table class="table table-bordered text-center" id="batchesTable">
        <thead class="table-dark">
            <tr>
                <th>اسم الدفعة</th>
                <th>الدورة</th>
                <th>عدد الطلاب</th>
                <th>التحليل</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model.Batches)
            {
                <tr>
                    <td>@b.Name</td>
                    <td>@b.CourseName</td>
                    <td>@b.StudentCount</td>
                    <td>
                        <a asp-action="AnalyzeSections"
                           asp-route-batchId="@b.Id"
                           class="btn btn-sm btn-outline-primary">
                            🔍 عرض المحاور
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#batchesTable').DataTable({
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json"
                }
            });
        });
    </script>
}
