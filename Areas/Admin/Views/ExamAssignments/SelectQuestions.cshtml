@model QdratNew.ViewModels.Exam.ManualExamQuestionSelectionViewModel

@{
    ViewData["Title"] = "تحديد الأسئلة يدويًا للاختبار";

    var totalAvailableQuestions = Model.AvailableQuestions?.Count() ?? 0;
    var requiredCount = Model.RequiredCount;
}

@section Styles {
    <style>
        :root {
            --pr-bg: #f4f7fb;
            --pr-card: #ffffff;
            --pr-border: #dbe4ef;
            --pr-accent: #2563eb;
            --pr-success: #16a34a;
            --pr-danger: #dc2626;
            --pr-warning: #f59e0b;
            --pr-info: #0284c7;
            --pr-violet: #7c3aed;
            --pr-text: #0f172a;
            --pr-muted: #64748b;
            --pr-radius: 14px;
            --pr-radius-sm: 9px;
            --pr-transition: .2s cubic-bezier(.4,0,.2,1);
            --pr-shadow: 0 8px 22px rgba(15, 23, 42, .06);
        }

        body {
            background: var(--pr-bg) !important;
        }

        .pr-page {
            direction: rtl;
            min-height: 100vh;
            padding: 28px 0 60px;
            font-family: 'Cairo', Arial, sans-serif;
        }

        .pr-header {
            background: #ffffff;
            border: 1px solid var(--pr-border);
            border-radius: var(--pr-radius);
            padding: 18px 22px;
            box-shadow: var(--pr-shadow);
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 24px;
        }

        .pr-header-title {
            color: var(--pr-text);
            font-size: 22px;
            font-weight: 900;
            margin: 0;
            line-height: 1.35;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .pr-header-title i {
                color: var(--pr-accent);
            }

        .pr-header-sub {
            color: #475569;
            font-size: 13px;
            font-weight: 700;
            margin-top: 6px;
            line-height: 1.8;
        }

        .pr-header-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .btn-pr-primary,
        .btn-pr-success,
        .btn-pr-outline {
            border-radius: var(--pr-radius-sm);
            padding: 8px 18px;
            font-size: 13px;
            font-weight: 900;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            text-decoration: none;
            border: 1px solid transparent;
