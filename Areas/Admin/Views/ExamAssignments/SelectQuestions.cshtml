}

@functions {
    string CleanText(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "—";
        }

        var text = System.Text.RegularExpressions.Regex.Replace(value, "<.*?>", " ");
        text = System.Net.WebUtility.HtmlDecode(text);
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\s+", " ").Trim();

        return string.IsNullOrWhiteSpace(text) ? "—" : text;
    }

    string ShortText(string? value, int maxLength)
    {
        var text = CleanText(value);

        if (text == "—")
        {
            return text;
        }

        return text.Length <= maxLength ? text : text.Substring(0, maxLength) + "...";
    }

    string GetDifficultyText(object? difficulty)
    {
        var value = difficulty?.ToString() ?? "";

        if (value.Contains("Easy") || value.Contains("سهل"))
        {
            return "سهل";
        }

        if (value.Contains("Hard") || value.Contains("صعب"))
        {
            return "صعب";
        }

        return "متوسط";
    }

    string GetDifficultyClass(object? difficulty)
    {
        var text = GetDifficultyText(difficulty);

        if (text == "سهل")
        {
            return "pr-badge-easy";
        }

        if (text == "صعب")
        {
            return "pr-badge-hard";
        }

        return "pr-badge-medium";
    }

    string GetDifficultyIcon(object? difficulty)
    {
        var text = GetDifficultyText(difficulty);

        if (text == "سهل")
        {
            return "fas fa-check-circle";
        }

        if (text == "صعب")
        {
            return "fas fa-fire";
        }

        return "fas fa-exclamation-circle";
    }
}

<div class="pr-page container-fluid px-4" dir="rtl">

    <div class="pr-header">
        <div>
            <h1 class="pr-header-title">
                <i class="fas fa-tasks"></i>
                تحديد الأسئلة يدويًا للاختبار
            </h1>

            <div class="pr-header-sub">
                اختر الأسئلة المطلوبة من بنك الأسئلة، وسيقوم النظام بإكمال العدد الناقص تلقائيًا عند الاعتماد.
            </div>
        </div>

        <div class="pr-header-actions">
            <a asp-action="Details"
               asp-route-id="@Model.AssignmentId"
               class="btn-pr-outline">
                <i class="fas fa-arrow-right"></i>
                رجوع لتفاصيل الاختبار
            </a>
        </div>
    </div>

    <div class="pr-hero">
        <div class="row g-4 align-items-center">
            <div class="col-lg-5">
                <div class="pr-hero-label">
                    <i class="fas fa-list-check"></i>
                    اختيار يدوي
                </div>

                <h2 class="pr-hero-title">
                    تحديد أسئلة الاختبار
                </h2>

                <div class="pr-hero-sub">
                    يمكن اختيار عدد أقل من المطلوب، وسيكمل النظام باقي الأسئلة تلقائيًا من بنك الأسئلة.
                </div>
            </div>

            <div class="col-lg-7">
                <div class="pr-chips">
                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#2563eb;">@requiredCount</div>
                        <div class="pr-chip-lbl">المطلوب اختياره</div>
                    </div>

                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#16a34a;" id="selectedQuestionsCount">0</div>
                        <div class="pr-chip-lbl">المحدد حاليًا</div>
                    </div>

                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#f59e0b;">@totalAvailableQuestions</div>
                        <div class="pr-chip-lbl">المتاح في الجدول</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="pr-alert">
        <i class="fas fa-circle-info"></i>
        <span>
            يمكنك اختيار <strong>@Model.RequiredCount</strong> سؤالًا يدويًا، وسيقوم النظام بإكمال العدد المطلوب تلقائيًا من بنك الأسئلة.
        </span>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger fw-bold">@TempData["Error"]</div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning shadow-sm">
            <div class="fw-bold mb-2">@TempData["Warning"]</div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="confirmResetCb" name="ConfirmResetAttempts" value="true" form="manualSelectionForm" />
                <label class="form-check-label fw-bold" for="confirmResetCb">تأكيد إعادة التعيين (سيمسح محاولات الطلاب القديمة)</label>
            </div>
            <textarea id="editReasonInput" name="EditReason" class="form-control" rows="2" placeholder="سبب التعديل (إجباري)" form="manualSelectionForm"></textarea>
        </div>
    }

    <form asp-action="SelectQuestions" method="post" id="manualSelectionForm">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="ExamId" />
        <input type="hidden" asp-for="AssignmentId" />
        <input type="hidden" asp-for="RequiredCount" />

        <div id="selectedIdsContainer"></div>

        <div class="pr-section-label">جدول الأسئلة المتاحة</div>

        <div class="pr-toolbar">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <div class="pr-toolbar-title">
                    <i class="fas fa-table"></i>
                    بنك الأسئلة
                </div>

                <span class="pr-selected-badge">
                    <i class="fas fa-question-circle"></i>
                    @totalAvailableQuestions سؤال متاح
                </span>

                <span class="pr-selected-badge" id="selectedQuestionsBadge">
                    <i class="fas fa-check-square"></i>
                    0 سؤال محدد
                </span>
            </div>

            <button type="submit" class="btn-pr-success">
                <i class="fas fa-paper-plane"></i>
                اعتماد الأسئلة وإرسال الاختبار
            </button>
        </div>

        <div class="pr-table-panel">
            <div class="table-responsive">
                <table class="table table-hover text-center w-100" id="questionsTable">
                    <thead>
                        <tr>
                            <th style="min-width:360px;">السؤال</th>
                            <th style="width:120px;">الصعوبة</th>
                            <th style="width:140px;">التصنيف</th>
                            <th style="min-width:150px;">المؤشر</th>
                            <th style="min-width:150px;">المحور</th>
                            <th style="width:90px;">تحديد</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var q in Model.AvailableQuestions)
                        {
                            var modalId = $"usageModal_{q.Id}";
                            var fullTitle = CleanText(q.Title);
                            var shortTitle = ShortText(q.Title, 70);

                            var lessonTitle = CleanText(q.LessonTitle);
                            var sectionTitle = CleanText(q.SectionTitle);

                            var difficultyText = GetDifficultyText(q.Difficulty);
                            var difficultyClass = GetDifficultyClass(q.Difficulty);
                            var difficultyIcon = GetDifficultyIcon(q.Difficulty);

                            <tr>
                                <td class="text-end">
                                    <div class="pr-q-cell">
                                        <button type="button"
                                                class="pr-action-btn preview"
                                                title="معاينة السؤال"
                                                onclick="loadQuestionPreview('@q.Id')">
                                            <i class="fas fa-eye"></i>
                                        </button>

                                        <span class="pr-q-text" title="@fullTitle">
                                            @shortTitle
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    <span class="pr-badge @difficultyClass">
                                        <i class="@difficultyIcon"></i>
                                        @difficultyText
                                    </span>
                                </td>

                                <td>
                                    <button type="button"
                                            class="pr-action-btn tags"
                                            data-bs-toggle="modal"
                                            data-bs-target="#@modalId"
                                            title="عرض التصنيفات">
                                        <i class="fas fa-tags"></i>
                                        التصنيفات
                                    </button>

                                    <div class="modal fade pr-modal" id="@modalId" tabindex="-1" aria-hidden="true" dir="rtl">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content text-end">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">
                                                        <i class="fas fa-tags"></i>
                                                        التصنيفات
                                                    </h5>

                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>

                                                <div class="modal-body">
                                                    <div class="pr-tags-wrap">
                                                        @foreach (var name in q.UsageTypes.GetDisplayNamesFromFlags())
                                                        {
                                                            <span class="pr-tag">
                                                                <i class="fas fa-tag"></i>
                                                                @name
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="pr-badge pr-badge-empty pr-short-text" title="@lessonTitle">
                                        @ShortText(q.LessonTitle, 18)
                                    </span>
                                </td>

                                <td>
                                    <span class="pr-badge pr-badge-empty pr-short-text" title="@sectionTitle">
                                        @ShortText(q.SectionTitle, 18)
                                    </span>
                                </td>

                                <td>
                                    <input type="checkbox"
                                           class="form-check-input pr-check question-checkbox"
                                           value="@q.Id" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="pr-submit-panel">
            <button type="submit" class="btn-pr-success">
                <i class="fas fa-paper-plane"></i>
                اعتماد الأسئلة وإرسال الاختبار
            </button>
        </div>
    </form>
</div>

<div class="modal fade pr-modal" id="previewModal" tabindex="-1" aria-hidden="true" dir="rtl">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content text-end">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-eye"></i>
                    معاينة السؤال
                </h5>

                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="previewModalBody">
                <div class="pr-empty">
                    <i class="fas fa-spinner fa-spin"></i>
                    جارٍ التحميل...
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const selectedIds = new Set();

        function updateSelectedCounters() {
            const count = selectedIds.size;
            const label = count === 1 ? 'سؤال محدد' : 'أسئلة محددة';

            const selectedQuestionsCount = document.getElementById('selectedQuestionsCount');
            const selectedQuestionsBadge = document.getElementById('selectedQuestionsBadge');

            if (selectedQuestionsCount) {
                selectedQuestionsCount.textContent = count;
            }

            if (selectedQuestionsBadge) {
                selectedQuestionsBadge.innerHTML = `<i class="fas fa-check-square"></i> ${count} ${label}`;
            }
        }

        function loadQuestionPreview(id) {
            const body = document.getElementById("previewModalBody");

            body.innerHTML = `
                <div class="pr-empty">
                    <i class="fas fa-spinner fa-spin"></i>
                    جارٍ التحميل...
                </div>`;

            const modal = new bootstrap.Modal(document.getElementById("previewModal"));
            modal.show();

            fetch(`/Admin/Questions/Preview/${id}`)
                .then(async res => {
                    if (!res.ok) {
                        throw new Error("HTTP_" + res.status);
                    }

                    const html = await res.text();

                    if (html.includes("System.InvalidOperationException") || html.includes("DeveloperExceptionPage")) {
                        throw new Error("SERVER_EXCEPTION");
                    }

                    return html;
                })
                .then(html => {
                    body.innerHTML = html;
                })
                .catch(() => {
                    body.innerHTML = `
                        <div class="pr-empty">
                            <i class="fas fa-exclamation-triangle text-danger"></i>
                            تعذر تحميل معاينة السؤال.
                        </div>`;

                    if (typeof Swal !== "undefined") {
                        Swal.fire('خطأ!', 'حدث خطأ أثناء تحميل السؤال.', 'error');
                    }
                });
        }

        $(document).ready(function () {
            var table = $('#questionsTable').DataTable({
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "الكل"]],
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json"
                },
                columnDefs: [
                    { orderable: false, targets: [2, 5] }
                ]
            });

            $('#questionsTable').on('change', '.question-checkbox', function () {
                const id = $(this).val();

                if (this.checked) {
                    selectedIds.add(id);
                } else {
                    selectedIds.delete(id);
                }

                updateSelectedCounters();
            });

            table.on('draw', function () {
                $('.question-checkbox').each(function () {
                    const id = $(this).val();
                    $(this).prop('checked', selectedIds.has(id));
                });

                updateSelectedCounters();
            });

            $('#manualSelectionForm').on('submit', function (e) {
                const confirmCb = document.getElementById('confirmResetCb');
                if (confirmCb) {
                    const reasonBox = document.getElementById('editReasonInput');
                    if (!confirmCb.checked) {
                        e.preventDefault();
                        if (typeof Swal !== "undefined") {
                            Swal.fire('تنبيه', 'يجب تفعيل "تأكيد إعادة التعيين" قبل الاعتماد.', 'warning');
                        } else {
                            alert('يجب تفعيل "تأكيد إعادة التعيين" قبل الاعتماد.');
                        }
                        return;
                    }
                    if (!reasonBox.value.trim()) {
                        e.preventDefault();
                        if (typeof Swal !== "undefined") {
                            Swal.fire('تنبيه', 'يجب كتابة سبب التعديل.', 'warning');
                        } else {
                            alert('يجب كتابة سبب التعديل.');
                        }
                        return;
                    }
                }

                $('#selectedIdsContainer').empty();

                selectedIds.forEach(function (id) {
                    $('#selectedIdsContainer').append(`<input type="hidden" name="SelectedQuestionIds" value="${id}" />`);
                });
            });

            updateSelectedCounters();
        });
    </script>
}