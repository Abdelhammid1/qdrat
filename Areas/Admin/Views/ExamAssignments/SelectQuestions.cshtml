                    color: #0f172a !important;
                    border-bottom: 1px solid #cbd5e1 !important;
                    font-size: 12px !important;
                    font-weight: 900 !important;
                    padding: 12px 10px !important;
                    white-space: nowrap;
                    text-align: center;
                    vertical-align: middle;
