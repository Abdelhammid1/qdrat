                .pr-table-panel .table tbody td {
                    color: #0f172a;
                    border-bottom: 1px solid #edf2f7;
                    padding: 11px 10px;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-align: middle;
                    text-align: center;
                    background: #ffffff;
