        }

        .btn-pr-primary {
            background: var(--pr-accent);
            border-color: var(--pr-accent);
            color: #ffffff;
        }

        .btn-pr-success {
            background: var(--pr-success);
            border-color: var(--pr-success);
            color: #ffffff;
        }

        .btn-pr-outline {
            background: #ffffff;
            border-color: #cbd5e1;
            color: #334155;
        }

        .btn-pr-primary:hover,
        .btn-pr-success:hover {
            color: #ffffff;
