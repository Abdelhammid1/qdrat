@model QdratNew.ViewModels.Exam.PlacementExamDetailsViewModel

@{
    ViewData["Title"] = "تفاصيل اختبار قياس المستوى";
}

<h2 class="mb-4">📘 تفاصيل اختبار قياس المستوى: @Model.Title</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row row-cols-1 row-cols-md-2 g-4">
    <div class="col-md-6">
        <div class="card h-100 border-info">
            <div class="card-header bg-info text-white fw-bold">📦 معلومات عامة</div>
            <div class="card-body">
                <p><strong>📋 عنوان الاختبار:</strong> @Model.Title</p>
                <p><strong>📚 الدورة:</strong> @Model.CourseName</p>
                <p><strong>تاريخ التوليد:</strong> @Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</p>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100 border-primary">
            <div class="card-header bg-primary text-white fw-bold">🧠 إعدادات الاختبار</div>
            <div class="card-body">
                <p><strong>عدد الأسئلة:</strong> @Model.TotalQuestions</p>
                <p><strong>⏱️ المدة:</strong> @Model.DurationMinutes دقيقة</p>
            </div>
        </div>
    </div>
</div>
