@model QdratNew.ViewModels.Exam.GenerateExamPreviewViewModel
@{
    ViewData["Title"] = "مراجعة بيانات اختبار المحور";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-eye me-2"></i> مراجعة بيانات الاختبار قبل التوليد</h5>
            <a asp-action="CompletedSections" asp-controller="ExamAssignments" class="btn btn-sm btn-outline-light">
                <i class="fas fa-arrow-right"></i> رجوع
            </a>
        </div>

        <div class="card-body bg-light">

            @* ✅ تحذيرات *@
            @if (Model.CompletedLessonsCount == 0)
            {
                <div class="alert alert-danger">
                    ⚠️ لا يوجد أي مؤشر مكتمل في هذا المحور. تأكد قبل التوليد.
                </div>
            }
            @if (Model.AvailableQuestionsCount == 0)
            {
                <div class="alert alert-danger">
                    ⚠️ لا يوجد أي سؤال متاح لهذا المحور. لا يمكن توليد اختبار فعلي.
                </div>
            }
            @if (!Model.IsOnline && !Model.ScheduledDate.HasValue)
            {
                <div class="alert alert-warning">
                    ⚠️ يجب تحديد موعد الاختبار الحضوري قبل توليد الاختبار.
                </div>
            }

            <div class="row g-4">

                <!-- بيانات الدفعة والمحور -->
                <div class="col-md-6">
                    <div class="card h-100 border-start border-4 border-primary">
                        <div class="card-body">
                            <h6 class="text-primary mb-3"><i class="fas fa-layer-group me-1"></i> معلومات الدفعة والمحور</h6>
                            <p><strong>اسم الدفعة:</strong> @Model.BatchName</p>
                            <p><strong>اسم المحور:</strong> @Model.SectionTitle</p>
                            <p><strong>المدرب:</strong> @Model.InstructorName</p>
                        </div>
                    </div>
                </div>

                <!-- مؤشرات الدرس والأسئلة -->
                <div class="col-md-6">
                    <div class="card h-100 border-start border-4 border-success">
                        <div class="card-body">
                            <h6 class="text-success mb-3"><i class="fas fa-chart-line me-1"></i> مؤشرات وأداء المنهج</h6>
                            <p><strong>المؤشرات المكتملة:</strong> @Model.CompletedLessonsCount من @Model.TotalLessonsCount</p>
                            <p><strong>الأسئلة المتاحة:</strong> @Model.AvailableQuestionsCount سؤال</p>
                        </div>
                    </div>
                </div>

                <!-- نوع الاختبار -->
                <div class="col-md-6">
                    <div class="card h-100 border-start border-4 border-info">
                        <div class="card-body">
                            <h6 class="text-info mb-3"><i class="fas fa-vial me-1"></i> نوع الاختبار</h6>
                            <p>
                                <strong>نوع التنفيذ:</strong>
                                <span class="badge bg-@(Model.IsOnline ? "primary" : "secondary")">
                                    @(Model.IsOnline ? "أونلاين" : "حضوري في المعهد")
                                </span>
                            </p>

                            @if (!Model.IsOnline)
                            {
                                <p>
                                    <strong>ميعاد التنفيذ:</strong>
                                    @(Model.ScheduledDate.HasValue? Model.ScheduledDate.Value.ToString("yyyy-MM-dd HH:mm") : "لم يتم التحديد")
                                </p>
                            }
                        </div>
                    </div>
                </div>

                <!-- زر توليد وزر تعديل -->
                <div class="col-md-6 d-flex flex-column align-items-end gap-2">
                    <form asp-action="GenerateExamForSection"
                          asp-controller="ExamAssignments"
                          asp-area="Admin"
                          method="post"
                          class="w-100">

                        <input type="hidden" name="batchId" value="@Model.BatchId" />
                        <input type="hidden" name="sectionId" value="@Model.SectionId" />
                        <input type="hidden" name="curriculumId" value="@Model.CurriculumId" />
                        <input type="hidden" name="lessonId" value="@Model.LessonId" />

                        <button type="submit" class="btn btn-success w-100 py-2">
                            <i class="fas fa-bolt"></i> توليد الاختبار الآن
                        </button>
                    </form>

                    <a asp-action="SelectExamMode"
                       asp-route-batchId="@Model.BatchId"
                       asp-route-sectionId="@Model.SectionId"
                       asp-route-curriculumId="@Model.CurriculumId"
                       asp-route-lessonId="@Model.LessonId"
                       class="btn btn-outline-warning w-100">
                        <i class="fas fa-sliders-h"></i> تعديل نوع الاختبار والميعاد
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
