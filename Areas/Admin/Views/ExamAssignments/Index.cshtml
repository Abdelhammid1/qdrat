@model QdratNew.ViewModels.Exam.ExamAssignmentFilterViewModel

@{
    ViewData["Title"] = Model.ShowArchived ? "أرشيف الاختبارات" : "إدارة الاختبارات";
    var archivedExamAssignmentsCount = ViewBag.ArchivedExamAssignmentsCount as int? ?? 0;
    var isExamArchiveOwner = ViewBag.IsExamArchiveOwner as bool? ?? false;
    var pageTitle = Model.ShowArchived ? "أرشيف الاختبارات حسب الدفعات" : "الاختبارات حسب الدفعات";
    var pageSubtitle = Model.ShowArchived
        ? "افتح دفعة لمراجعة الاختبارات المؤرشفة داخلها"
        : "افتح دفعة لمتابعة اختبارات الطلاب والتحليلات";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <style>
        :root {
            --ink:#0D1B2A;--ink-2:#2C3E50;--ink-3:#5A6A7A;--ink-4:#8FA0B0;--ink-5:#C8D5E0;
            --canvas:#F3F6FA;--surface:#FFFFFF;--surface-2:#F8FAFC;--surface-3:#EEF2F7;--border:#DDE4EC;
            --blue:#1B5EAE;--blue-2:#2471D0;--blue-bg:#E8F1FB;--blue-dark:#103E7A;
            --emerald:#0D7A5B;--emerald-bg:#E4F5EE;--amber:#985D09;--amber-bg:#FDF0D8;
            --rose:#BF1030;--rose-bg:#FDEAEE;--violet:#5535B5;--violet-bg:#EDE8F9;
            --r-sm:6px;--r-md:10px;--r-lg:14px;--r-xl:20px;
            --sh-xs:0 1px 3px rgba(13,27,42,.06);--sh-sm:0 2px 8px rgba(13,27,42,.08);--sh-md:0 4px 18px rgba(13,27,42,.10);
            --ease:cubic-bezier(.25,.46,.45,.94);
        }

        .exam-page { background:var(--canvas);min-height:100vh;padding:32px 28px 64px;direction:rtl;font-family:'Cairo',sans-serif;color:var(--ink-2); }
        .exam-topbar { display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;margin-bottom:28px; }
        .exam-brand { display:flex;align-items:center;gap:13px; }
        .exam-brand-icon { width:46px;height:46px;background:var(--blue);border-radius:var(--r-lg);display:flex;align-items:center;justify-content:center;color:#fff;font-size:20px;box-shadow:0 4px 14px rgba(27,94,174,.28); }
        .exam-brand-title { font-size:20px;font-weight:800;color:var(--ink);line-height:1.15; }
        .exam-brand-sub { font-size:15px;color:var(--ink-4);margin-top:2px; }
        .top-actions { display:flex;align-items:center;gap:10px;flex-wrap:wrap; }
        .btn-main-action,.btn-secondary-action { display:inline-flex;align-items:center;justify-content:center;gap:7px;border-radius:var(--r-md);padding:10px 18px;font-size:15px;font-weight:800;text-decoration:none;transition:background .15s,transform .12s,box-shadow .15s; }
        .btn-main-action { background:var(--blue);color:#fff;border:1px solid var(--blue);box-shadow:0 3px 10px rgba(27,94,174,.22); }
        .btn-main-action:hover { background:var(--blue-dark);color:#fff;transform:translateY(-1px); }
        .btn-secondary-action { background:var(--surface);color:var(--blue);border:1px solid #B6D3F4; }
        .btn-secondary-action:hover { background:var(--blue-bg);color:var(--blue-dark);transform:translateY(-1px); }

        .exam-kpis { display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-bottom:24px; }
        @@media(max-width:960px){ .exam-kpis{grid-template-columns:repeat(2,1fr);} }
        @@media(max-width:480px){ .exam-kpis{grid-template-columns:1fr;} }
        .kpi-card { background:var(--surface);border:1px solid var(--border);border-radius:var(--r-xl);padding:18px 19px;display:flex;align-items:center;gap:13px;box-shadow:var(--sh-xs);position:relative;overflow:hidden; }
        .kpi-card::after { content:'';position:absolute;top:0;right:0;width:4px;height:100%; }
        .kpi-blue::after{background:var(--blue);} .kpi-emerald::after{background:var(--emerald);} .kpi-amber::after{background:var(--amber);} .kpi-violet::after{background:var(--violet);}
        .kpi-ico { width:42px;height:42px;border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0; }
        .ico-blue{background:var(--blue-bg);color:var(--blue);} .ico-emerald{background:var(--emerald-bg);color:var(--emerald);} .ico-amber{background:var(--amber-bg);color:var(--amber);} .ico-violet{background:var(--violet-bg);color:var(--violet);}
        .kpi-label { font-size:13px;font-weight:800;color:var(--ink-4);margin-bottom:3px; }
        .kpi-val { font-size:22px;font-weight:900;color:var(--ink);line-height:1; }

        .models-tabs { display:flex;gap:10px;margin-bottom:18px;flex-wrap:wrap; }
        .model-tab { display:inline-flex;align-items:center;gap:7px;border:1px solid var(--border);background:var(--surface);color:var(--ink-3);border-radius:var(--r-md);padding:10px 18px;font-size:15px;font-weight:800;text-decoration:none;transition:all .15s; }
        .model-tab.active { background:var(--blue);color:#fff;border-color:var(--blue);box-shadow:0 3px 10px rgba(27,94,174,.18); }

        .archive-manager { background:var(--surface);border:1px solid var(--border);border-radius:var(--r-xl);margin-bottom:22px;box-shadow:var(--sh-xs);overflow:hidden; }
        .archive-manager-toggle { width:100%;border:none;background:var(--surface);padding:18px;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:14px;text-align:right; }
        .archive-manager-toggle:hover { background:var(--surface-2); }
        .archive-manager-toggle-main { display:flex;align-items:center;gap:10px; }
        .archive-manager-toggle-icon { width:38px;height:38px;border-radius:var(--r-md);background:var(--amber-bg);color:var(--amber);display:inline-flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0; }
        .archive-manager-toggle-text { display:flex;flex-direction:column;gap:2px; }
        .archive-manager-title { font-size:16px;font-weight:900;color:var(--ink); }
        .archive-manager-subtitle { font-size:13px;font-weight:700;color:var(--ink-4); }
        .archive-manager-toggle-left { display:flex;align-items:center;gap:12px;flex-wrap:wrap; }
        .archive-manager-chevron { width:34px;height:34px;border-radius:var(--r-sm);background:var(--surface-3);color:var(--ink-3);display:inline-flex;align-items:center;justify-content:center;transition:transform .2s var(--ease); }
        .archive-manager.is-open .archive-manager-chevron { transform:rotate(180deg);background:var(--amber-bg);color:var(--amber); }
        .archive-manager-body { display:none;padding:0 18px 18px;border-top:1px solid var(--surface-3); }
        .archive-manager.is-open .archive-manager-body { display:block; }
        .archive-manager-body-inner { padding-top:16px; }
        .archive-manager-grid { display:grid;grid-template-columns:minmax(240px,1fr) auto;gap:14px;align-items:end; }
        .archive-batches { display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:8px;max-height:170px;overflow-y:auto;padding:10px;background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-md); }
        .archive-batch-check { display:flex;align-items:center;gap:7px;font-size:14px;color:var(--ink-2); }
        .archive-actions { display:flex;align-items:center;gap:10px;flex-wrap:wrap; }
        .archive-submit { border:none;border-radius:var(--r-md);padding:10px 16px;font-size:15px;font-weight:800;color:#fff;background:var(--ink);cursor:pointer; }
        .archive-submit.restore { background:var(--emerald); }
        .exam-count-badge { font-size:14px;color:var(--ink-4); }
        .exam-count-badge strong { color:var(--blue);font-weight:900; }

        .batches-section-card { background:var(--surface);border:1px solid var(--border);border-radius:var(--r-xl);overflow:visible;box-shadow:var(--sh-sm); }
        .batches-section-topbar { display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid var(--surface-3);flex-wrap:wrap; }
        .section-title { display:flex;align-items:center;gap:8px;font-size:18px;font-weight:900;color:var(--ink);margin-left:10px; }
        .section-title i { color:var(--blue); }
        .batch-search-wrap { position:relative;flex:1;min-width:220px;max-width:390px; }
        .batch-search-wrap i { position:absolute;right:11px;top:50%;transform:translateY(-50%);color:var(--ink-4);font-size:17px;pointer-events:none; }
        .batch-search-wrap input { width:100%;padding:7px 32px 7px 12px;border:1px solid var(--border);border-radius:var(--r-md);font-size:15px;background:var(--surface-2);color:var(--ink); }
        .total-badge { margin-right:auto;font-size:14px;color:var(--ink-4); }
        .total-badge strong { color:var(--blue);font-weight:900; }
        .batches-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:14px;padding:18px; }
        @@media(max-width:1200px){ .batches-grid{grid-template-columns:repeat(2,1fr);} }
        @@media(max-width:768px){ .exam-page{padding:22px 14px 48px;} .batches-grid{grid-template-columns:1fr;padding:14px;} .archive-manager-grid{grid-template-columns:1fr;} .top-actions,.btn-main-action,.btn-secondary-action{width:100%;} .archive-manager-toggle{align-items:flex-start;} }

        .batch-card { background:var(--surface);border:1px solid var(--border);border-radius:var(--r-xl);box-shadow:var(--sh-xs);transition:transform .18s var(--ease),box-shadow .18s,border-color .18s;overflow:hidden;position:relative; }
        .batch-card::before { content:'';position:absolute;top:0;right:0;width:5px;height:100%;background:var(--violet); }
        .batch-card:hover { transform:translateY(-4px);box-shadow:var(--sh-md);border-color:#D7CDF8; }
        .batch-card-body { padding:18px 18px 16px; }
        .batch-head { display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:14px; }
        .batch-title-wrap { display:flex;align-items:flex-start;gap:10px;min-width:0; }
        .batch-avatar { width:38px;height:38px;border-radius:50%;background:var(--violet-bg);color:var(--violet);display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0; }
        .batch-title { font-size:17px;font-weight:900;color:var(--ink);margin-bottom:3px;word-break:break-word; }
        .batch-sub { font-size:13px;color:var(--ink-4);line-height:1.5;word-break:break-word; }
        .sent-pill { display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:30px;background:var(--emerald-bg);color:var(--emerald);font-size:12px;font-weight:900;white-space:nowrap; }
        .batch-mini-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-bottom:12px; }
        .batch-mini-stat { background:var(--surface-2);border:1px solid var(--surface-3);border-radius:var(--r-md);padding:9px 7px;text-align:center; }
        .mini-val { display:block;font-size:18px;font-weight:900;color:var(--ink);line-height:1.1; }
        .mini-label { display:block;font-size:11px;color:var(--ink-4);margin-top:2px; }
        .text-emerald { color:var(--emerald)!important; } .text-amber{color:var(--amber)!important;} .text-violet{color:var(--violet)!important;}
        .batch-progress-wrap { margin-bottom:12px; }
        .batch-progress-meta { display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--ink-4);margin-bottom:5px; }
        .batch-progress-meta strong { color:var(--ink);font-size:13px; }
        .batch-progress { width:100%;height:8px;border-radius:30px;background:var(--surface-3);overflow:hidden; }
        .batch-progress-bar { height:100%;border-radius:30px;background:var(--emerald); }
        .batch-foot-stats { display:flex;justify-content:space-between;gap:8px;color:var(--ink-4);font-size:13px;margin-bottom:14px; }
        .batch-foot-stats span { display:inline-flex;align-items:center;gap:5px; }
        .batch-actions { display:grid;grid-template-columns:1fr;gap:8px; }
        .batch-open-btn { display:inline-flex;align-items:center;justify-content:center;gap:7px;width:100%;background:var(--blue);color:#fff;border:1px solid var(--blue);border-radius:var(--r-md);padding:10px 14px;font-size:15px;font-weight:900;text-decoration:none;box-shadow:0 3px 10px rgba(27,94,174,.20); }
        .batch-open-btn:hover { color:#fff;background:var(--blue-dark);transform:translateY(-2px); }
        .batches-empty { text-align:center;padding:56px 16px;color:var(--ink-4); }
        .batches-empty i { font-size:24px;display:block;margin-bottom:12px;color:var(--ink-5); }
        .batches-empty-title { font-size:18px;font-weight:900;color:var(--ink-3); }

        .batch-access-btn { display:inline-flex;align-items:center;justify-content:center;gap:7px;width:100%;background:var(--amber-bg);color:var(--amber);border:1px solid #fcd34d;border-radius:var(--r-md);padding:9px 14px;font-size:14px;font-weight:900;text-decoration:none;margin-top:8px;transition:background .15s,transform .12s; }
        .batch-access-btn:hover { background:var(--amber);color:#fff;transform:translateY(-1px);text-decoration:none; }
    </style>
}

<div class="exam-page">

    @if (TempData["Success"] != null)
    {
        <div style="background:#e4f5ee;border:1px solid #6ee7b7;border-radius:10px;padding:13px 18px;margin-bottom:18px;color:#065f46;font-weight:800;font-size:14px;display:flex;align-items:center;gap:10px;">
            <i class="fas fa-check-circle" style="font-size:17px;"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div style="background:#fee2e2;border:1px solid #fca5a5;border-radius:10px;padding:13px 18px;margin-bottom:18px;color:#991b1b;font-weight:800;font-size:14px;display:flex;align-items:center;gap:10px;">
            <i class="fas fa-exclamation-triangle" style="font-size:17px;"></i>
            @TempData["Error"]
        </div>
    }

    <div class="exam-topbar">
        <div class="exam-brand">
            <div class="exam-brand-icon"><i class="fas fa-clipboard-check"></i></div>
            <div>
                <div class="exam-brand-title">@pageTitle</div>
                <div class="exam-brand-sub">@pageSubtitle</div>
            </div>
        </div>

        <div class="top-actions">
            <a asp-area="Admin" asp-controller="ExamGenerator" asp-action="Create" class="btn-main-action">
                <i class="fas fa-plus-circle"></i>
                توليد اختبار
            </a>
            <a href="/Admin/ExamIndividualAssignments" class="btn-secondary-action">
                <i class="fa-solid fa-user-check"></i>
                إدارة الاختبارات الفردية
            </a>
        </div>
    </div>

    <div class="exam-kpis">
        <div class="kpi-card kpi-blue">
            <div class="kpi-ico ico-blue"><i class="fas fa-layer-group"></i></div>
            <div><div class="kpi-label">دفعات بها اختبارات</div><div class="kpi-val">@Model.TotalBatches</div></div>
        </div>
        <div class="kpi-card kpi-violet">
            <div class="kpi-ico ico-violet"><i class="fas fa-file-signature"></i></div>
            <div><div class="kpi-label">إجمالي الاختبارات</div><div class="kpi-val">@Model.TotalExamsCount</div></div>
        </div>
        <div class="kpi-card kpi-emerald">
            <div class="kpi-ico ico-emerald"><i class="fas fa-paper-plane"></i></div>
            <div><div class="kpi-label">اختبارات مرسلة</div><div class="kpi-val">@Model.TotalSentExams</div></div>
        </div>
        <div class="kpi-card kpi-amber">
            <div class="kpi-ico ico-amber"><i class="fas fa-user-check"></i></div>
            <div><div class="kpi-label">طلاب أنهوا الاختبار</div><div class="kpi-val">@Model.TotalCompletedStudents</div></div>
        </div>
    </div>

    <div class="archive-manager" id="archiveManagerSection">
        <button type="button" class="archive-manager-toggle" id="archiveManagerToggle" aria-expanded="false" aria-controls="archiveManagerBody">
            <div class="archive-manager-toggle-main">
                <span class="archive-manager-toggle-icon"><i class="fas fa-archive"></i></span>
                <span class="archive-manager-toggle-text">
                    <span class="archive-manager-title">إدارة الأرشيف حسب الدفعات</span>
                    <span class="archive-manager-subtitle">حدد الدفعات المطلوبة ثم اختر أرشفة أو إخراج من الأرشيف</span>
                </span>
            </div>
            <div class="archive-manager-toggle-left">
                <span class="exam-count-badge">داخل الأرشيف: <strong>@archivedExamAssignmentsCount</strong> اختبار</span>
                <span class="archive-manager-chevron"><i class="fas fa-chevron-down"></i></span>
            </div>
        </button>

        <div class="archive-manager-body" id="archiveManagerBody">
            <div class="archive-manager-body-inner">
                <form asp-action="ArchiveExamAssignmentsByBatches" method="post">
                    @Html.AntiForgeryToken()
                    <div class="archive-manager-grid">
                        <div class="archive-batches">
                            @foreach (var batch in Model.Batches)
                            {
                                <label class="archive-batch-check">
                                    <input type="checkbox" name="selectedBatchIds" value="@batch.Value" />
                                    <span>@batch.Text</span>
                                </label>
                            }
                        </div>
                        <div class="archive-actions">
                            <button type="submit" class="archive-submit" onclick="return confirm('سيتم نقل اختبارات الدفعات المحددة إلى الأرشيف. هل تريد المتابعة؟')">
                                <i class="fas fa-box-archive"></i>
                                أرشفة المحدد
                            </button>
                            <button type="submit"
                                    formaction="@Url.Action("RestoreExamAssignmentsByBatches", "ExamAssignments", new { area = "Admin" })"
                                    class="archive-submit restore"
                                    onclick="return confirm('سيتم إخراج اختبارات الدفعات المحددة من الأرشيف. هل تريد المتابعة؟')">
                                <i class="fas fa-undo"></i>
                                إخراج من الأرشيف
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="models-tabs">
        <a asp-area="Admin" asp-controller="ExamAssignments" asp-action="Index" asp-route-showArchived="false" class="model-tab @(Model.ShowArchived ? "" : "active")">
            <i class="fas fa-file-signature"></i>
            الاختبارات
        </a>
        <a asp-area="Admin" asp-controller="ExamAssignments" asp-action="Index" asp-route-showArchived="true" class="model-tab @(Model.ShowArchived ? "active" : "")">
            <i class="fas fa-archive"></i>
            الأرشيف (@archivedExamAssignmentsCount)
        </a>
    </div>

    <div class="batches-section-card">
        <div class="batches-section-topbar">
            <div class="section-title">
                <i class="fas fa-grid-2"></i>
                @pageTitle
            </div>
            <div class="batch-search-wrap">
                <i class="fas fa-search"></i>
                <input type="text" id="batchSearch" placeholder="ابحث في اسم الدفعة أو الدورة..." />
            </div>
            <div class="total-badge">
                إجمالي: <strong>@Model.TotalBatches</strong> دفعة
            </div>
        </div>

        @if (!Model.BatchCards.Any())
        {
            <div class="batches-empty">
                <i class="fas fa-inbox"></i>
                <div class="batches-empty-title">لا توجد دفعات بها اختبارات</div>
            </div>
        }
        else
        {
            <div class="batches-grid" id="batchesGrid">
                @foreach (var batch in Model.BatchCards)
                {
                    <div class="batch-card" data-search="@($"{batch.BatchName} {batch.CourseTitle}".ToLower())">
                        <div class="batch-card-body">
                            <div class="batch-head">
                                <div class="batch-title-wrap">
                                    <div class="batch-avatar"><i class="fas fa-users"></i></div>
                                    <div>
                                        <div class="batch-title">@batch.BatchName</div>
                                        <div class="batch-sub">@(!string.IsNullOrWhiteSpace(batch.CourseTitle) ? batch.CourseTitle : "بدون دورة")</div>
                                    </div>
                                </div>
                                <span class="sent-pill">@batch.SentExams مرسل</span>
                            </div>

                            <div class="batch-mini-grid">
                                <div class="batch-mini-stat">
                                    <span class="mini-val">@batch.TotalExams</span>
                                    <span class="mini-label">اختبار</span>
                                </div>
                                <div class="batch-mini-stat">
                                    <span class="mini-val text-emerald">@batch.CompletedCount</span>
                                    <span class="mini-label">مكتمل</span>
                                </div>
                                <div class="batch-mini-stat">
                                    <span class="mini-val text-amber">@batch.PendingCount</span>
                                    <span class="mini-label">لم يبدأ</span>
                                </div>
                            </div>

                            <div class="batch-progress-wrap">
                                <div class="batch-progress-meta">
                                    <span>نسبة الإنهاء</span>
                                    <strong>@batch.CompletionPercentage%</strong>
                                </div>
                                <div class="batch-progress">
                                    <div class="batch-progress-bar" style="width:@batch.CompletionPercentage%"></div>
                                </div>
                            </div>

                            <div class="batch-foot-stats">
                                <span><i class="fas fa-user-graduate"></i>@batch.TotalStudents طالب</span>
                                <span><i class="fas fa-play-circle"></i>@batch.InProgressCount قيد الحل</span>
                            </div>

                            <div class="batch-actions">
                                <a asp-area="Admin"
                                   asp-controller="ExamAssignments"
                                   asp-action="BatchExams"
                                   asp-route-batchId="@batch.BatchId"
                                   asp-route-archived="@Model.ShowArchived"
                                   class="batch-open-btn">
                                    <i class="fas fa-folder-open"></i>
                                    فتح اختبارات الدفعة
                                </a>

                                @if (Model.ShowArchived && isExamArchiveOwner)
                                {
                                    <a asp-area="Admin"
                                       asp-controller="ExamAssignments"
                                       asp-action="ManageArchiveAccess"
                                       asp-route-batchId="@batch.BatchId"
                                       class="batch-access-btn">
                                        <i class="fas fa-shield-halved"></i>
                                        إدارة صلاحيات الأرشيف
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const archiveManagerSection = document.getElementById('archiveManagerSection');
            const archiveManagerToggle = document.getElementById('archiveManagerToggle');

            if (archiveManagerSection && archiveManagerToggle) {
                archiveManagerToggle.addEventListener('click', function () {
                    const isOpen = archiveManagerSection.classList.toggle('is-open');
                    archiveManagerToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                });
            }

            const search = document.getElementById('batchSearch');
            if (search) {
                search.addEventListener('input', function () {
                    const term = (this.value || '').toLowerCase().trim();
                    document.querySelectorAll('#batchesGrid .batch-card').forEach(function (card) {
                        const text = (card.getAttribute('data-search') || card.textContent || '').toLowerCase();
                        card.style.display = text.includes(term) ? '' : 'none';
                    });
                });
            }
        });
    </script>
}
