@model QdratNew.ViewModels.Exam.ExamBatchAnalyticsViewModel
@{
    Layout = null; // ✅ بدون لايوت نهائيًا
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>تقرير تحليلي للاختبار - @Model.BatchName</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background: #fff;
            font-family: "Cairo", sans-serif;
            direction: rtl;
            padding: 10px;
        }

        .card, .table {
            box-shadow: none !important;
            border: 1px solid #ddd !important;
        }

        @@page {
            size: A4 portrait;
            margin: 5mm;
        }

        .table th, .table td {
            border: 1px solid #ccc !important;
            padding: 6px;
            font-size: 13px;
        }

        h3, h4, h5 {
            font-weight: 700;
            color: #111;
        }

        .print-title {
            text-align: center;
            margin-bottom: 15px;
        }
    </style>
</head>

<body>

    <div class="container-fluid">
        <div class="print-title">
            <h3>📊 التقرير التحليلي للاختبار</h3>
            <p class="text-muted">
                الدفعة: <strong>@Model.BatchName</strong> — الاختبار: <strong>@Model.ExamTitle</strong>
            </p>
        </div>

        <!-- كروت الإحصاءات -->
        <div class="row g-3 text-center mb-4">
            <div class="col-md-2 col-6"><div class="card p-2"><h6>👨‍🎓 الطلاب</h6><h4>@Model.TotalStudents</h4></div></div>
            <div class="col-md-2 col-6"><div class="card p-2 text-success"><h6>✅ أكملوا</h6><h4>@Model.CompletedCount</h4></div></div>
            <div class="col-md-2 col-6"><div class="card p-2 text-danger"><h6>🚫 غائبين</h6><h4>@Model.AbsentCount</h4></div></div>
            <div class="col-md-2 col-6"><div class="card p-2 text-primary"><h6>📈 معدل النجاح</h6><h4>@Model.PassedCount / @Model.TotalStudents</h4></div></div>
            <div class="col-md-2 col-6"><div class="card p-2 text-warning"><h6>📉 الراسبون</h6><h4>@Model.FailedCount</h4></div></div>
            <div class="col-md-2 col-6"><div class="card p-2 text-info"><h6>⏱️ متوسط الزمن</h6><h4>@Model.AvgDurationMinutes د</h4></div></div>
        </div>

        <!-- جدول الطلاب -->
        <h5 class="fw-bold text-primary mt-4">📋 أداء الطلاب</h5>
        <table class="table table-bordered text-center align-middle">
            <thead class="table-light">
                <tr>
                    <th>الاسم</th>
                    <th>النتيجة</th>
                    <th>عدد الأسئلة</th>
                    <th>✅ الصحيحة</th>
                    <th>❌ الخاطئة</th>
                    <th>⏭️ المتخطاة</th>
                    <th>⏱️ الزمن (د)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Students)
                {
                    <tr>
                        <td>@s.FullName</td>
                        <td>@(s.Score.HasValue ? s.Score + "%" : "-")</td>
                        <td>@s.TotalQuestions</td>
                        <td>@s.CorrectAnswers</td>
                        <td>@s.WrongAnswers</td>
                        <td>@s.SkippedQuestions</td>
                        <td>@s.DurationMinutes</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- جدول المحاور -->
        <h5 class="fw-bold text-success mt-5">📚 أداء المحاور</h5>
        <table class="table table-bordered text-center">
            <thead class="table-light">
                <tr>
                    <th>المحور</th>
                    <th>عدد المؤشرات</th>
                    <th>عدد الأسئلة</th>
                    <th>نسبة النجاح</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sec in Model.Sections)
                {
                    <tr>
                        <td>@sec.SectionTitle</td>
                        <td>@sec.LessonCount</td>
                        <td>@sec.QuestionCount</td>
                        <td>@sec.AvgSuccessRate%</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
