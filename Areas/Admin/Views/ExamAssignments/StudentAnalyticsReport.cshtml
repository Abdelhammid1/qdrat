@model QdratNew.ViewModels.Reports.StudentAnalyticsDashboard2Vm
@{
    Layout = "~/Views/Shared/_ReportLayout.cshtml";
    ViewData["Title"] = "📊 لوحة التحليل الذكي للطالب";
}

<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;700;800&display=swap" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    :root {
        --primary: #339999;
        --secondary: #ff9933;
        --neutral: #666666;
        --bg: #f9fbfd;
        --radius: 14px;
        --shadow: 0 4px 12px rgba(0,0,0,0.08);
    }

    body {
        background: var(--bg);
        font-family: 'Cairo', sans-serif;
        direction: rtl;
    }

    .container {
        max-width: 1200px;
        margin: 40px auto;
        padding: 20px;
    }

    /* Header */
    .report-header {
        background: #fff;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
    }

        .report-header h2 {
            color: var(--primary);
            font-weight: 800;
        }

    .chips span {
        background: #eef6f6;
        color: var(--primary);
        border-radius: 50px;
        padding: 5px 14px;
        margin: 3px;
        font-size: 13px;
        font-weight: 600;
    }

    /* KPI Cards */
    .stats {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(160px,1fr));
        gap: 15px;
        margin-top: 25px;
    }

    .card {
        background: #fff;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        text-align: center;
        padding: 20px;
    }

    .card h6 {
        color: var(--neutral);
        font-size: 15px;
        margin-bottom: 5px;
    }

    .card h3 {
        color: var(--primary);
        font-weight: 800;
    }

    /* Charts & Recommendations */
    .analysis-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 20px;
        margin-top: 30px;
    }

    .analysis-card {
        background: #fff;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 20px;
    }

        .analysis-card h4 {
            color: var(--primary);
            font-weight: 700;
            margin-bottom: 15px;
        }

    .progress-bar {
        height: 20px;
        background: #e9ecef;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 10px;
    }

    .progress-inner {
        height: 100%;
        background: var(--secondary);
        color: #fff;
        font-weight: 600;
        font-size: 13px;
        line-height: 20px;
        text-align: center;
    }

    /* Table */
    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 18px;
    }

    th, td {
        border: 1px solid #dee2e6;
        padding: 8px;
        text-align: center;
        font-size: 14px;
    }

    th {
        background: #e9f6f6;
        color: var(--primary);
        font-weight: 700;
    }

    .good { color: var(--secondary); font-weight: 700; }
    .weak { color: var(--neutral); font-weight: 700; }

    /* Print Optimization */
    @@media print {
        .no-print, nav, header, footer, .sidebar { display: none !important; }
        body { background: #fff !important; -webkit-print-color-adjust: exact !important; }
        .analysis-card, .card, table, canvas { page-break-inside: avoid !important; break-inside: avoid !important; }
        #sectionsChart { width: 100% !important; height: 380px !important; }
        @@page { size: A4 portrait; margin: 10mm; }
    }
</style>

<div class="container">
    <!-- Header -->
    <div class="report-header">
        <div>
            <h2>@Model.StudentName</h2>
            <div class="chips">
                <span>المستوى: @Model.Level</span>
                <span>الدفعة: @Model.BatchName</span>
                <span>📈 الأداء العام: @Model.OverallPerformance%</span>
            </div>
        </div>
        <button class="btn btn-sm btn-success no-print" onclick="window.print()">🖨️ طباعة</button>
    </div>

    <!-- KPI Cards -->
    <div class="stats">
        <div class="card"><h6>عدد الاختبارات</h6><h3>@Model.TotalExams</h3></div>
        <div class="card"><h6>اختبارات مكتملة</h6><h3>@Model.CompletedExams</h3></div>
        <div class="card"><h6>عدد الواجبات</h6><h3>@Model.TotalHomeworks</h3></div>
        <div class="card"><h6>واجبات منجزة</h6><h3>@Model.CompletedHomeworks</h3></div>
        <div class="card"><h6>نسبة الحضور</h6><h3>@Model.AttendancePercent%</h3></div>
        <div class="card"><h6>متوسط أداء الاختبارات</h6><h3>@Model.AverageExamScore%</h3></div>
    </div>

    <!-- Analysis -->
    <div class="analysis-grid">
        <div class="analysis-card">
            <h4>📊 تحليل المحاور</h4>
            <canvas id="sectionsChart" style="height:300px; max-height:300px;"></canvas>
        </div>

        <div class="analysis-card">
            <h4>🧠 توصيات ذكية</h4>
            <div class="progress-bar">
                <div class="progress-inner" style="width:@Model.AverageExamScore%">نسبة الإنجاز: @Model.AverageExamScore%</div>
            </div>
            <h5>⚙️ @Model.SpeedLabel</h5>
            <p>@Model.SpeedNote</p>
            <h5>🎯 المسار التدريبي المقترح</h5>
            <p><strong>@Model.TrackCard1:</strong> @Model.TrackCard1Desc</p>
            <p><strong>@Model.TrackCard2:</strong> @Model.TrackCard2Desc</p>

            @if (Model.IndividualTips != null && Model.IndividualTips.Any())
            {
                <ul class="list-unstyled mt-3">
                    @foreach (var tip in Model.IndividualTips)
                    {
                        <li>💡 @tip</li>
                    }
                </ul>
            }

        </div>
    </div>

    <!-- Section Table -->
    <div class="analysis-card mt-4">
        <h4>📘 تفصيل الأداء حسب المحاور</h4>
        <table>
            <thead>
                <tr>
                    <th>المحور</th>
                    <th>عدد الأسئلة</th>
                    <th>صحيحة</th>
                    <th>خاطئة</th>
                    <th>متخطاة</th>
                    <th>النسبة</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.SectionPerformances)
                {
                    var percent = s.Total == 0 ? 0 : Math.Round((s.Correct / (double)s.Total) * 100, 1);
                    var color = percent >= 70 ? "good" : "weak";
                    <tr>
                        <td>@s.SectionTitle</td>
                        <td>@s.Total</td>
                        <td class="good">@s.Correct</td>
                        <td class="weak">@s.Wrong</td>
                        <td>@s.Skipped</td>
                        <td class="@color">@percent%</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Timeline Chart -->
    <div class="analysis-card mt-4">
        <h4>⏱️ تطور الأداء الزمني</h4>
        <canvas id="progressChart" height="200"></canvas>
    </div>

    <div class="text-center mt-4 no-print">
        <button class="btn btn-success" onclick="window.print()">🖨️ حفظ / PDF</button>
    </div>
</div>

<script>
    // Bar Chart (Sections)
    const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SectionPerformances.Select(s => s.SectionTitle)));
    const correct = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SectionPerformances.Select(s => s.Correct)));
    const wrong = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SectionPerformances.Select(s => s.Wrong)));
    const skipped = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SectionPerformances.Select(s => s.Skipped)));

       new Chart(document.getElementById('sectionsChart'), {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [
                { label: 'صحيحة', data: correct, backgroundColor: '#339999', borderRadius: 6, maxBarThickness: 40 },
                { label: 'خاطئة', data: wrong, backgroundColor: '#ff9933', borderRadius: 6, maxBarThickness: 40 },
                { label: 'متخطاة', data: skipped, backgroundColor: '#666666', borderRadius: 6, maxBarThickness: 40 }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: 'bottom' } },
            scales: {
                x: { grid: { display: false } },
                y: {
                    beginAtZero: true,
                    max: 100, // ✅ أقصى ارتفاع للقيم (مناسب لو النسبة مئوية)
                    ticks: { stepSize: 20 },
                    grid: { color: '#eee' }
                }
            }
        }
    });


    // Line Chart (Timeline)
    const tLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProgressTimeline.Select(p => p.Label)));
    const tValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProgressTimeline.Select(p => p.Value)));

    new Chart(document.getElementById('progressChart'), {
        type: 'line',
        data: {
            labels: tLabels,
            datasets: [{
                label: 'نسبة الأداء',
                data: tValues,
                borderColor: '#339999',
                backgroundColor: '#33999933',
                tension: 0.3,
                fill: true,
                pointRadius: 5
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { position: 'bottom' } },
            scales: { y: { beginAtZero: true, max: 100 } }
        }
    });
</script>
