@model QdratNew.ViewModels.Exam.ExamModeSelectionViewModel

@{
    ViewData["Title"] = "تحديد نوع الاختبار";
}

<div class="card mt-4 shadow-sm">
    <div class="card-header bg-info text-white text-end">
        <h5><i class="fas fa-sliders-h ms-2"></i> تحديد نوع الاختبار</h5>
    </div>
    <div class="card-body">

        <form asp-action="SelectExamMode" method="post" class="text-end">
            @Html.AntiForgeryToken()

            @* Hidden IDs *@
            <input type="hidden" asp-for="BatchId" />
            <input type="hidden" asp-for="SectionId" />
            <input type="hidden" asp-for="CurriculumId" />
            <input type="hidden" asp-for="LessonId" />

            @* Hidden text fields to preserve values *@
            <input type="hidden" asp-for="BatchName" />
            <input type="hidden" asp-for="SectionTitle" />

            <div class="mb-3 row">
                <label class="col-sm-3 col-form-label">اسم الدفعة:</label>
                <div class="col-sm-9">
                    <input type="text" class="form-control" value="@Model.BatchName" readonly />
                </div>
            </div>

            <div class="mb-3 row">
                <label class="col-sm-3 col-form-label">اسم المحور:</label>
                <div class="col-sm-9">
                    <input type="text" class="form-control" value="@Model.SectionTitle" readonly />
                </div>
            </div>

            <div class="mb-3 row">
                <label class="col-sm-3 col-form-label">نوع الاختبار:</label>
                <div class="col-sm-9">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" asp-for="IsOnline" value="true" />
                        <label class="form-check-label">أونلاين</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" asp-for="IsOnline" value="false" />
                        <label class="form-check-label">حضوري في المعهد</label>
                    </div>
                </div>
            </div>

            <div class="mb-3 row" id="scheduleDateDiv">
                <label class="col-sm-3 col-form-label">تاريخ الاختبار:</label>
                <div class="col-sm-9">
                    <input asp-for="ScheduledDate" class="form-control"
                           type="datetime-local"
                           value="@Model.ScheduledDate?.ToString("yyyy-MM-ddTHH:mm")"
                           required />
                </div>
            </div>

            <div class="text-end mt-4">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-check-circle ms-1"></i> تأكيد
                </button>
                <a asp-action="CompletedSections" asp-controller="ExamAssignments" class="btn btn-secondary ms-2">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function toggleSchedule() {
            const isOnline = document.querySelector('input[name="IsOnline"]:checked')?.value === "true";
            const scheduleDiv = document.getElementById("scheduleDateDiv");
            scheduleDiv.style.display = isOnline ? "none" : "flex";
        }

        document.querySelectorAll('input[name="IsOnline"]').forEach(radio => {
            radio.addEventListener("change", toggleSchedule);
        });

        toggleSchedule();
    </script>
}
