@model QdratNew.ViewModels.Exam.ExamArchiveBatchAccessVM

@{
    ViewData["Title"] = "صلاحيات الوصول لأرشيف الاختبارات";
    var allowedCount = Model.Users.Count(u => u.IsAllowed);
    var totalCount   = Model.Users.Count;
    var pendingCount = totalCount - allowedCount;
}

@section Styles {
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
<style>
/* ===========================
   DESIGN TOKENS
   =========================== */
:root {
    --c-bg:          #f0f4f8;
    --c-surface:     #ffffff;
    --c-surface-2:   #f8fafc;
    --c-border:      #e2e8f0;
    --c-border-2:    #cbd5e1;

    --c-ink:         #0f172a;
    --c-ink-2:       #1e293b;
    --c-ink-3:       #334155;
    --c-ink-4:       #64748b;
    --c-ink-5:       #94a3b8;

    --c-primary:     #4f46e5;
    --c-primary-2:   #6366f1;
    --c-primary-bg:  #eef2ff;
    --c-primary-dk:  #3730a3;

    --c-amber:       #d97706;
    --c-amber-bg:    #fffbeb;
    --c-amber-bd:    #fcd34d;

    --c-emerald:     #059669;
    --c-emerald-bg:  #ecfdf5;
    --c-emerald-bd:  #6ee7b7;

    --c-rose:        #e11d48;
    --c-rose-bg:     #fff1f2;
    --c-rose-bd:     #fda4af;

    --c-violet:      #7c3aed;
    --c-violet-bg:   #f5f3ff;
    --c-violet-bd:   #c4b5fd;

    --radius-sm:     8px;
    --radius-md:     12px;
    --radius-lg:     16px;
    --radius-xl:     22px;
    --radius-full:   9999px;

    --shadow-xs:     0 1px 2px rgba(15,23,42,.04);
    --shadow-sm:     0 2px 8px rgba(15,23,42,.07);
    --shadow-md:     0 4px 20px rgba(15,23,42,.10);
    --shadow-lg:     0 8px 32px rgba(15,23,42,.13);

    --ease:          cubic-bezier(.25,.46,.45,.94);
    --ease-bounce:   cubic-bezier(.34,1.56,.64,1);
}

/* ===========================
   BASE
   =========================== */
*, *::before, *::after { box-sizing: border-box; }

body { background: var(--c-bg) !important; }

.mac-page {
    min-height: 100vh;
    padding: 0 0 80px;
    direction: rtl;
    font-family: 'Cairo', 'Segoe UI', Arial, sans-serif;
    color: var(--c-ink-2);
}

/* ===========================
   HERO HEADER
   =========================== */
.mac-hero {
    background: linear-gradient(135deg, #3730a3 0%, #4f46e5 40%, #7c3aed 100%);
    padding: 36px 40px 80px;
    position: relative;
    overflow: hidden;
}

.mac-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
        radial-gradient(circle at 20% 50%, rgba(255,255,255,.08) 0%, transparent 50%),
        radial-gradient(circle at 80% 20%, rgba(124,58,237,.4) 0%, transparent 40%);
}

.mac-hero::after {
    content: '';
    position: absolute;
    bottom: -1px; left: 0; right: 0;
    height: 56px;
    background: var(--c-bg);
    clip-path: ellipse(55% 100% at 50% 100%);
}

.mac-hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    max-width: 1300px;
    margin: 0 auto;
}

.mac-hero-left { flex: 1; min-width: 280px; }

.mac-hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,.15);
    border: 1px solid rgba(255,255,255,.25);
    border-radius: var(--radius-full);
    padding: 5px 14px;
    font-size: 12px;
    font-weight: 800;
    color: rgba(255,255,255,.9);
    margin-bottom: 14px;
    backdrop-filter: blur(4px);
}

.mac-hero-title {
    font-size: 28px;
    font-weight: 900;
    color: #ffffff;
    margin: 0 0 6px;
    line-height: 1.25;
    text-shadow: 0 2px 8px rgba(0,0,0,.15);
}

.mac-hero-sub {
    font-size: 14px;
    font-weight: 700;
    color: rgba(255,255,255,.72);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
}

.mac-hero-sub-sep {
    width: 4px; height: 4px;
    border-radius: 50%;
    background: rgba(255,255,255,.4);
    display: inline-block;
}

.mac-hero-right {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

.mac-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 800;
    color: rgba(255,255,255,.9);
    background: rgba(255,255,255,.14);
    border: 1px solid rgba(255,255,255,.22);
    text-decoration: none;
    transition: background .2s var(--ease), transform .15s;
    backdrop-filter: blur(4px);
    white-space: nowrap;
}
.mac-back-btn:hover {
    background: rgba(255,255,255,.22);
    color: #fff;
    text-decoration: none;
    transform: translateY(-1px);
}

/* ===========================
   STATS STRIP
   =========================== */
.mac-stats-strip {
    max-width: 1300px;
    margin: -46px auto 28px;
    padding: 0 40px;
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
}

.mac-stat-card {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    padding: 18px 20px;
    box-shadow: var(--shadow-md);
    display: flex;
    align-items: center;
    gap: 14px;
    transition: transform .2s var(--ease), box-shadow .2s;
}
.mac-stat-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }

.mac-stat-icon {
    width: 46px; height: 46px;
    border-radius: var(--radius-md);
    display: flex; align-items: center; justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
}

.mac-stat-icon.violet  { background: var(--c-violet-bg);  color: var(--c-violet);  }
.mac-stat-icon.emerald { background: var(--c-emerald-bg); color: var(--c-emerald); }
.mac-stat-icon.amber   { background: var(--c-amber-bg);   color: var(--c-amber);   }

.mac-stat-val {
    font-size: 26px;
    font-weight: 900;
    color: var(--c-ink);
    line-height: 1;
}
.mac-stat-lbl {
    font-size: 12px;
    font-weight: 800;
    color: var(--c-ink-5);
    margin-top: 3px;
}

/* ===========================
   MAIN CONTENT
   =========================== */
.mac-content {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 40px;
}

/* ===========================
   ALERTS
   =========================== */
.mac-alert {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 20px;
    border-radius: var(--radius-lg);
    font-size: 14px;
    font-weight: 800;
    margin-bottom: 20px;
    animation: slideDown .3s var(--ease);
}
.mac-alert-success {
    background: var(--c-emerald-bg);
    border: 1px solid var(--c-emerald-bd);
    color: #065f46;
}
.mac-alert-error {
    background: var(--c-rose-bg);
    border: 1px solid var(--c-rose-bd);
    color: #9f1239;
}
.mac-alert i { font-size: 18px; flex-shrink: 0; }

@@keyframes slideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to   { opacity: 1; transform: translateY(0); }
}

/* ===========================
   NOTICE
   =========================== */
.mac-notice {
    background: linear-gradient(135deg, #ede9fe 0%, #f5f3ff 100%);
    border: 1px solid var(--c-violet-bd);
    border-radius: var(--radius-lg);
    padding: 16px 20px;
    margin-bottom: 24px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
}
.mac-notice-icon {
    width: 36px; height: 36px;
    border-radius: var(--radius-sm);
    background: var(--c-violet-bg);
    color: var(--c-violet);
    display: flex; align-items: center; justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
    border: 1px solid var(--c-violet-bd);
}
.mac-notice-text {
    font-size: 13px;
    font-weight: 700;
    color: #4c1d95;
    line-height: 1.7;
}
.mac-notice-text strong { font-weight: 900; color: var(--c-violet); }

/* ===========================
   PERMISSION CARD
   =========================== */
.mac-perm-card {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
}

.mac-perm-header {
    padding: 18px 24px;
    border-bottom: 1px solid var(--c-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    background: var(--c-surface);
}

.mac-perm-header-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    font-weight: 900;
    color: var(--c-ink);
}

.mac-perm-header-title-icon {
    width: 34px; height: 34px;
    border-radius: var(--radius-sm);
    background: var(--c-primary-bg);
    color: var(--c-primary);
    display: flex; align-items: center; justify-content: center;
    font-size: 15px;
}

.mac-perm-header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
}

.mac-search {
    position: relative;
    min-width: 220px;
}
.mac-search i {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--c-ink-5);
    font-size: 13px;
    pointer-events: none;
}
.mac-search input {
    width: 100%;
    height: 38px;
    border: 1px solid var(--c-border-2);
    border-radius: var(--radius-md);
    background: var(--c-surface-2);
    color: var(--c-ink);
    padding: 0 36px 0 12px;
    font-size: 13px;
    font-weight: 700;
    font-family: inherit;
    outline: none;
    transition: border-color .15s, box-shadow .15s;
}
.mac-search input:focus {
    border-color: var(--c-primary-2);
    box-shadow: 0 0 0 3px rgba(99,102,241,.12);
}

.mac-btn-sm {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: var(--radius-md);
    font-size: 12px;
    font-weight: 900;
    border: 1px solid transparent;
    cursor: pointer;
    font-family: inherit;
    transition: all .15s var(--ease);
    white-space: nowrap;
}
.mac-btn-sm.ghost {
    background: var(--c-surface-2);
    border-color: var(--c-border-2);
    color: var(--c-ink-3);
}
.mac-btn-sm.ghost:hover {
    background: var(--c-border);
    color: var(--c-ink);
}

/* ===========================
   USER LIST
   =========================== */
.mac-user-list { padding: 12px 16px; }

.mac-user-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 12px;
    border-radius: var(--radius-lg);
    transition: background .15s var(--ease), transform .15s;
    cursor: default;
    position: relative;
}

.mac-user-row:not(:last-child) {
    border-bottom: 1px solid var(--c-border);
    border-radius: 0;
    padding-bottom: 14px;
    margin-bottom: 2px;
}

.mac-user-row:hover { background: var(--c-surface-2); border-radius: var(--radius-lg); }

.mac-user-row.is-allowed { background: #f0fdf4; }
.mac-user-row.is-allowed:hover { background: #dcfce7; }

/* Avatar */
.mac-user-avatar {
    width: 44px; height: 44px;
    border-radius: var(--radius-md);
    display: flex; align-items: center; justify-content: center;
    font-size: 16px;
    font-weight: 900;
    color: #fff;
    flex-shrink: 0;
    background: linear-gradient(135deg, #4f46e5, #7c3aed);
    box-shadow: 0 3px 10px rgba(79,70,229,.3);
    user-select: none;
}

.mac-user-info { flex: 1; min-width: 0; }

.mac-user-name {
    font-size: 14px;
    font-weight: 900;
    color: var(--c-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mac-user-email {
    font-size: 12px;
    font-weight: 700;
    color: var(--c-ink-5);
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mac-user-roles { display: flex; gap: 4px; flex-wrap: wrap; flex-shrink: 0; }

.mac-role-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    font-size: 11px;
    font-weight: 900;
    white-space: nowrap;
}

.mac-role-pill.admin     { background: #dbeafe; color: #1d4ed8; border: 1px solid #bfdbfe; }
.mac-role-pill.employee  { background: var(--c-violet-bg); color: var(--c-violet); border: 1px solid var(--c-violet-bd); }
.mac-role-pill.superadmin{ background: var(--c-amber-bg); color: var(--c-amber); border: 1px solid var(--c-amber-bd); }
.mac-role-pill.other     { background: var(--c-surface-2); color: var(--c-ink-4); border: 1px solid var(--c-border-2); }

/* Toggle Switch */
.mac-toggle-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
}

.mac-toggle-label {
    font-size: 12px;
    font-weight: 800;
    color: var(--c-ink-5);
    transition: color .2s;
    min-width: 52px;
    text-align: center;
}

.mac-toggle {
    position: relative;
    width: 52px;
    height: 28px;
    flex-shrink: 0;
}

.mac-toggle input {
    opacity: 0;
    width: 0;
    height: 0;
    position: absolute;
}

.mac-toggle-track {
    position: absolute;
    inset: 0;
    background: #e2e8f0;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: background .25s var(--ease);
    border: 1.5px solid transparent;
}

.mac-toggle-track::after {
    content: '';
    position: absolute;
    width: 20px; height: 20px;
    background: #fff;
    border-radius: 50%;
    top: 2px; right: 3px;
    transition: transform .25s var(--ease-bounce), box-shadow .2s;
    box-shadow: 0 2px 6px rgba(0,0,0,.18);
}

.mac-toggle input:checked + .mac-toggle-track {
    background: linear-gradient(135deg, #059669, #10b981);
    border-color: #059669;
}

.mac-toggle input:checked + .mac-toggle-track::after {
    transform: translateX(-24px);
    box-shadow: 0 2px 8px rgba(5,150,105,.3);
}

.mac-toggle input:focus + .mac-toggle-track {
    box-shadow: 0 0 0 3px rgba(79,70,229,.15);
}

/* Allowed Status */
.mac-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    font-size: 11px;
    font-weight: 900;
    transition: all .2s;
    white-space: nowrap;
    min-width: 72px;
    justify-content: center;
}
.mac-status-pill.allowed {
    background: var(--c-emerald-bg);
    color: #065f46;
    border: 1px solid var(--c-emerald-bd);
}
.mac-status-pill.denied {
    background: var(--c-surface-2);
    color: var(--c-ink-5);
    border: 1px solid var(--c-border-2);
}

/* Empty State */
.mac-empty {
    text-align: center;
    padding: 64px 20px;
    color: var(--c-ink-5);
}
.mac-empty-icon {
    width: 64px; height: 64px;
    border-radius: var(--radius-lg);
    background: var(--c-surface-2);
    color: var(--c-ink-5);
    display: flex; align-items: center; justify-content: center;
    font-size: 26px;
    margin: 0 auto 16px;
    border: 1px solid var(--c-border);
}
.mac-empty-title { font-size: 16px; font-weight: 900; color: var(--c-ink-4); }
.mac-empty-sub   { font-size: 13px; font-weight: 700; margin-top: 6px; }

/* ===========================
   FOOTER / SAVE
   =========================== */
.mac-perm-footer {
    padding: 18px 24px;
    background: linear-gradient(to bottom, var(--c-surface-2), var(--c-surface));
    border-top: 1px solid var(--c-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
}

.mac-footer-info {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    color: var(--c-ink-4);
}

.mac-footer-info i { color: var(--c-primary-2); }

.mac-save-btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 12px 28px;
    border: none;
    border-radius: var(--radius-md);
    font-size: 15px;
    font-weight: 900;
    color: #fff;
    background: linear-gradient(135deg, var(--c-primary), var(--c-primary-2));
    cursor: pointer;
    font-family: inherit;
    box-shadow: 0 4px 14px rgba(79,70,229,.35);
    transition: box-shadow .2s, transform .15s var(--ease);
}
.mac-save-btn:hover {
    box-shadow: 0 6px 20px rgba(79,70,229,.45);
    transform: translateY(-2px);
}
.mac-save-btn:active { transform: translateY(0); }

/* ===========================
   HIDDEN CHECKBOXES FORM
   =========================== */
.mac-form-hidden { display: none; }

/* ===========================
   RESPONSIVE
   =========================== */
@@media (max-width: 900px) {
    .mac-hero       { padding: 28px 20px 72px; }
    .mac-stats-strip { padding: 0 20px; grid-template-columns: repeat(3,1fr); gap: 10px; }
    .mac-content    { padding: 0 20px; }
    .mac-stat-val   { font-size: 22px; }
}

@@media (max-width: 640px) {
    .mac-hero-title  { font-size: 22px; }
    .mac-stats-strip { grid-template-columns: 1fr; margin-top: -36px; }
    .mac-perm-header { flex-direction: column; align-items: flex-start; }
    .mac-perm-header-actions { width: 100%; }
    .mac-search      { min-width: 100%; }
    .mac-user-row    { flex-wrap: wrap; }
    .mac-user-roles  { order: 3; }
    .mac-toggle-wrap { order: 4; margin-right: auto; }
}

/* ===========================
   DARK MODE
   =========================== */
@@media (prefers-color-scheme: dark) {
    :root {
        --c-bg:      #0f172a;
        --c-surface: #1e293b;
        --c-surface-2: #293548;
        --c-border:  #334155;
        --c-border-2:#475569;
        --c-ink:     #f1f5f9;
        --c-ink-2:   #e2e8f0;
        --c-ink-3:   #cbd5e1;
        --c-ink-4:   #94a3b8;
        --c-ink-5:   #64748b;
    }
    .mac-user-row.is-allowed { background: rgba(5,150,105,.12); }
}
</style>
}

<div class="mac-page container-fluid px-0" dir="rtl">

    <!-- ══════════════ HERO HEADER ══════════════ -->
    <div class="mac-hero">
        <div class="mac-hero-inner">
            <div class="mac-hero-left">
                <div class="mac-hero-eyebrow">
                    <i class="fas fa-shield-halved"></i>
                    إدارة الصلاحيات
                </div>
                <h1 class="mac-hero-title">صلاحيات أرشيف الاختبارات</h1>
                <p class="mac-hero-sub">
                    <i class="fas fa-users-rectangle" style="opacity:.7;"></i>
                    <span>@Model.BatchName</span>
                    @if (!string.IsNullOrWhiteSpace(Model.CourseTitle))
                    {
                        <span class="mac-hero-sub-sep"></span>
                        <span>@Model.CourseTitle</span>
                    }
                </p>
            </div>
            <div class="mac-hero-right">
                <a asp-area="Admin"
                   asp-controller="ExamAssignments"
                   asp-action="Index"
                   asp-route-showArchived="true"
                   class="mac-back-btn">
                    <i class="fas fa-arrow-right"></i>
                    رجوع للأرشيف
                </a>
            </div>
        </div>
    </div>

    <!-- ══════════════ STATS STRIP ══════════════ -->
    <div class="mac-stats-strip">
        <div class="mac-stat-card">
            <div class="mac-stat-icon violet"><i class="fas fa-users"></i></div>
            <div>
                <div class="mac-stat-val">@totalCount</div>
                <div class="mac-stat-lbl">إجمالي المستخدمين</div>
            </div>
        </div>
        <div class="mac-stat-card">
            <div class="mac-stat-icon emerald"><i class="fas fa-user-check"></i></div>
            <div>
                <div class="mac-stat-val" id="allowedCounter">@allowedCount</div>
                <div class="mac-stat-lbl">مصرح لهم بالوصول</div>
            </div>
        </div>
        <div class="mac-stat-card">
            <div class="mac-stat-icon amber"><i class="fas fa-user-lock"></i></div>
            <div>
                <div class="mac-stat-val" id="pendingCounter">@pendingCount</div>
                <div class="mac-stat-lbl">غير مصرح لهم</div>
            </div>
        </div>
    </div>

    <!-- ══════════════ MAIN CONTENT ══════════════ -->
    <div class="mac-content">

        <!-- Alerts -->
        @if (TempData["Success"] != null)
        {
            <div class="mac-alert mac-alert-success">
                <i class="fas fa-circle-check"></i>
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="mac-alert mac-alert-error">
                <i class="fas fa-circle-exclamation"></i>
                @TempData["Error"]
            </div>
        }

        <!-- Notice -->
        <div class="mac-notice">
            <div class="mac-notice-icon"><i class="fas fa-lock-open"></i></div>
            <div class="mac-notice-text">
                المالك والمبرمج يملكان <strong>وصولاً تلقائياً</strong> لجميع الأرشيف دون الحاجة لإضافتهما هنا.
                استخدم المفاتيح أدناه لمنح أو سحب الوصول من باقي الإداريين لهذه الدفعة المؤرشفة.
            </div>
        </div>

        <!-- Real form (hidden checkboxes, submitted on save) -->
        <form id="accessForm" asp-action="UpdateArchiveAccess" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="batchId" value="@Model.BatchId" />
            <div id="hiddenInputs">
                @foreach (var user in Model.Users.Where(u => u.IsAllowed))
                {
                    <input type="hidden" name="allowedUserIds" value="@user.UserId" />
                }
            </div>
        </form>

        <!-- Permission Card -->
        <div class="mac-perm-card">

            <!-- Card Header -->
            <div class="mac-perm-header">
                <div class="mac-perm-header-title">
                    <div class="mac-perm-header-title-icon"><i class="fas fa-users-gear"></i></div>
                    المستخدمون المؤهلون للوصول
                </div>
                <div class="mac-perm-header-actions">
                    <div class="mac-search">
                        <i class="fas fa-magnifying-glass"></i>
                        <input type="text" id="userSearch" placeholder="ابحث باسم المستخدم أو البريد..." />
                    </div>
                    <button type="button" class="mac-btn-sm ghost" id="selectAllBtn">
                        <i class="fas fa-check-double"></i> تحديد الكل
                    </button>
                    <button type="button" class="mac-btn-sm ghost" id="clearAllBtn">
                        <i class="fas fa-xmark"></i> إلغاء الكل
                    </button>
                </div>
            </div>

            <!-- User List -->
            <div class="mac-user-list" id="userList">
                @if (!Model.Users.Any())
                {
                    <div class="mac-empty">
                        <div class="mac-empty-icon"><i class="fas fa-users-slash"></i></div>
                        <div class="mac-empty-title">لا يوجد مستخدمون مؤهلون</div>
                        <div class="mac-empty-sub">لا يوجد مستخدمون نشطون بأدوار Admin أو Employee أو SuperAdmin.</div>
                    </div>
                }
                else
                {
                    @foreach (var user in Model.Users)
                    {
                        var initials = string.Join("", (user.DisplayName ?? "U")
                            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                            .Take(2)
                            .Select(w => w[0].ToString()));

                        <div class="mac-user-row @(user.IsAllowed ? "is-allowed" : "")"
                             data-search="@($"{user.DisplayName} {user.Email}".ToLower())"
                             data-uid="@user.UserId">

                            <!-- Avatar -->
                            <div class="mac-user-avatar">@initials</div>

                            <!-- Info -->
                            <div class="mac-user-info">
                                <div class="mac-user-name">@user.DisplayName</div>
                                <div class="mac-user-email">@user.Email</div>
                            </div>

                            <!-- Roles -->
                            <div class="mac-user-roles">
                                @foreach (var role in user.Roles.Split('،', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                {
                                    var roleClass = role.Trim() switch {
                                        "Admin"      => "admin",
                                        "SuperAdmin" => "superadmin",
                                        "Employee"   => "employee",
                                        _            => "other"
                                    };
                                    <span class="mac-role-pill @roleClass">
                                        <i class="fas fa-circle" style="font-size:6px;"></i>
                                        @role.Trim()
                                    </span>
                                }
                            </div>

                            <!-- Toggle Switch -->
                            <div class="mac-toggle-wrap">
                                <label class="mac-toggle">
                                    <input type="checkbox"
                                           class="user-toggle"
                                           data-uid="@user.UserId"
                                           @(user.IsAllowed ? "checked" : "") />
                                    <span class="mac-toggle-track"></span>
                                </label>
                                <span class="mac-status-pill @(user.IsAllowed ? "allowed" : "denied")" id="pill-@user.UserId">
                                    @if (user.IsAllowed)
                                    {
                                        <i class="fas fa-check"></i> <span>مصرح</span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-minus"></i> <span>محجوب</span>
                                    }
                                </span>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Card Footer -->
            <div class="mac-perm-footer">
                <div class="mac-footer-info">
                    <i class="fas fa-circle-info"></i>
                    <span>التغييرات تُطبَّق فوراً عند الحفظ على جميع اختبارات هذه الدفعة.</span>
                </div>
                <button type="button" class="mac-save-btn" id="saveBtn">
                    <i class="fas fa-floppy-disk"></i>
                    حفظ الصلاحيات
                </button>
            </div>
        </div>

    </div><!-- /mac-content -->
</div><!-- /mac-page -->

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {

    const allowedSet = new Set(
        Array.from(document.querySelectorAll('.user-toggle:checked'))
             .map(el => el.dataset.uid)
    );

    /* ── Toggle change ── */
    document.querySelectorAll('.user-toggle').forEach(function (toggle) {
        toggle.addEventListener('change', function () {
            const uid  = this.dataset.uid;
            const row  = this.closest('.mac-user-row');
            const pill = document.getElementById('pill-' + uid);

            if (this.checked) {
                allowedSet.add(uid);
                row.classList.add('is-allowed');
                pill.className = 'mac-status-pill allowed';
                pill.innerHTML = '<i class="fas fa-check"></i><span>مصرح</span>';
            } else {
                allowedSet.delete(uid);
                row.classList.remove('is-allowed');
                pill.className = 'mac-status-pill denied';
                pill.innerHTML = '<i class="fas fa-minus"></i><span>محجوب</span>';
            }

            updateCounters();
        });
    });

    /* ── Select All ── */
    document.getElementById('selectAllBtn').addEventListener('click', function () {
        document.querySelectorAll('.user-toggle').forEach(function (t) {
            if (!t.checked) { t.checked = true; t.dispatchEvent(new Event('change')); }
        });
    });

    /* ── Clear All ── */
    document.getElementById('clearAllBtn').addEventListener('click', function () {
        document.querySelectorAll('.user-toggle').forEach(function (t) {
            if (t.checked) { t.checked = false; t.dispatchEvent(new Event('change')); }
        });
    });

    /* ── Search ── */
    document.getElementById('userSearch').addEventListener('input', function () {
        const term = this.value.toLowerCase().trim();
        document.querySelectorAll('#userList .mac-user-row').forEach(function (row) {
            const text = row.getAttribute('data-search') || '';
            row.style.display = text.includes(term) ? '' : 'none';
        });
    });

    /* ── Save ── */
    document.getElementById('saveBtn').addEventListener('click', function () {
        const form    = document.getElementById('accessForm');
        const hidden  = document.getElementById('hiddenInputs');
        hidden.innerHTML = '';

        allowedSet.forEach(function (uid) {
            const input = document.createElement('input');
            input.type  = 'hidden';
            input.name  = 'allowedUserIds';
            input.value = uid;
            hidden.appendChild(input);
        });

        form.submit();
    });

    /* ── Update Counters ── */
    function updateCounters() {
        document.getElementById('allowedCounter').textContent = allowedSet.size;
        const total = document.querySelectorAll('.user-toggle').length;
        document.getElementById('pendingCounter').textContent = total - allowedSet.size;
    }
});
</script>
}
