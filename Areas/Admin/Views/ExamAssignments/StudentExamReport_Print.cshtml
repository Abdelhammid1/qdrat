@model QdratNew.ViewModels.Reports.ExamDetailedReportViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>تقرير أداء الطالب - للطباعة</title>
    <style>
        @@font-face {
            font-family: 'ZA-Roots';
            src: url('/fonts/ZA-roots.woff2') format('woff2'),
                 url('/fonts/ZA-roots.woff') format('woff'),
                 url('/fonts/ZA-roots.TTF') format('truetype');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }
        @@font-face {
            font-family: 'ZA-roots';
            src: url('/fonts/ZA-roots.woff2') format('woff2'),
                 url('/fonts/ZA-roots.woff') format('woff'),
                 url('/fonts/ZA-roots.TTF') format('truetype');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }
        body {
            font-family: 'Cairo', sans-serif;
            background: #fff;
            color: #000;
            direction: rtl;
            margin: 0;
            padding: 15px;
        }

        h2, h3, h4 {
            text-align: center;
            color: #1e293b;
        }

        .report-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .report-header img {
            width: 140px;
            height: 80px;
            margin-bottom: 10px;
        }

        .student-info {
            border: 1px solid #ccc;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 25px;
        }

        .student-info p {
            margin: 5px 0;
            font-size: 15px;
        }

        .stats {
            display: flex;
            justify-content: space-around;
            text-align: center;
            margin-bottom: 20px;
        }

        .stats div {
            border: 1px solid #ccc;
            border-radius: 8px;
            padding: 10px;
            width: 22%;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
            font-size: 14px;
        }

        th, td {
            border: 1px solid #ccc;
            padding: 8px;
            text-align: center;
        }

        th {
            background-color: #f1f5f9;
        }

        .section-heading {
            font-size: 17px;
            color: #334155;
            margin: 25px 0 10px;
        }

        canvas {
            width: 100% !important;
            height: auto !important;
            page-break-inside: avoid;
        }

        @@page {
            size: A4 portrait;
            margin: 10mm;
        }
    </style>
</head>

<body>

    <div class="report-header">
        <img src="~/images/160×100.png" alt="شعار مركز القدرات" />
        <h2>📘 تقرير أداء الطالب في الاختبار</h2>
        <p><strong>@Model.ExamTitle</strong></p>
    </div>

    <div class="student-info">
        <p><strong>👨‍🎓 الاسم:</strong> @Model.StudentName</p>
        <p><strong>🎓 المستوى:</strong> @Model.Level</p>
        <p><strong>📞 رقم ولي الأمر:</strong> @Model.ParentPhone</p>
        <p><strong>📅 تاريخ الاختبار:</strong> @Model.ExamDate.ToString("yyyy-MM-dd HH:mm")</p>
    </div>

    <div class="stats">
        <div>
            <h4>@Model.TotalQuestions</h4>
            <p>عدد الأسئلة</p>
        </div>
        <div>
            <h4 style="color:green">@Model.CorrectAnswers</h4>
            <p>إجابات صحيحة</p>
        </div>
        <div>
            <h4 style="color:red">@Model.WrongQuestions.Count()</h4>
            <p>إجابات خاطئة</p>
        </div>
        <div>
            <h4>@Model.OverallPercent%</h4>
            <p>النسبة العامة</p>
        </div>
    </div>

    @if (Model.LessonPerformances != null && Model.LessonPerformances.Any())
    {
        <h3 class="section-heading">📊 تحليل الدروس (المؤشرات)</h3>
        <table>
            <thead>
                <tr>
                    <th>المحور</th>
                    <th>الدرس</th>
                    <th>عدد الأسئلة</th>
                    <th>الصحيحة</th>
                    <th>نسبة الدقة</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.LessonPerformances)
                {
                    <tr>
                        <td>@l.SectionTitle</td>
                        <td>@l.LessonTitle</td>
                        <td>@l.TotalQuestions</td>
                        <td>@l.CorrectAnswers</td>
                        <td>@l.AccuracyPercent%</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.WrongQuestions != null && Model.WrongQuestions.Any())
    {
        <h3 class="section-heading">❌ الأسئلة الخاطئة</h3>
        <table>
            <thead>
                <tr>
                    <th>السؤال</th>
                    <th>إجابة الطالب</th>
                    <th>الإجابة الصحيحة</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var q in Model.WrongQuestions)
                {
                    <tr>
                        <td style="text-align:right">@q.QuestionText</td>
                        <td style="color:red">@q.StudentAnswer</td>
                        <td style="color:green">@q.CorrectAnswer</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <!-- الرسوم البيانية -->
    <div class="section-heading">📈 تحليل المحاور</div>
    <div class="chart-container">
        <canvas id="quantChart"></canvas>
    </div>

    <div class="chart-container">
        <canvas id="verbalChart"></canvas>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const quantLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.QuantLabels ?? new List<string>()));
        const quantCorrect = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.QuantCorrectCounts ?? new List<int>()));
        const quantWrong = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.QuantWrongCounts ?? new List<int>()));

        const verbalLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VerbalLabels ?? new List<string>()));
        const verbalCorrect = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VerbalCorrectCounts ?? new List<int>()));
        const verbalWrong = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VerbalWrongCounts ?? new List<int>()));

        function buildChart(id, labels, correct, wrong, color1, color2) {
            const canvas = document.getElementById(id);
            if (!canvas || labels.length === 0) return;

            new Chart(canvas, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        { label: 'صحيحة', data: correct, backgroundColor: color1 },
                        { label: 'خاطئة', data: wrong, backgroundColor: color2 }
                    ]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { position: 'top' } },
                    scales: { y: { beginAtZero: true } }
                }
            });
        }

        buildChart('quantChart', quantLabels, quantCorrect, quantWrong, '#16a34a', '#ef4444');
        buildChart('verbalChart', verbalLabels, verbalCorrect, verbalWrong, '#3b82f6', '#f97316');
    </script>
</body>
</html>
