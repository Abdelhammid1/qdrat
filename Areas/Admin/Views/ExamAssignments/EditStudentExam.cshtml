@model QdratNew.ViewModels.Exam.EditStudentExamVm
@{
    ViewData["Title"] = "تعديل اختبار فردي";
}

<div class="container mt-4" dir="rtl">
    <h3 class="fw-bold text-primary mb-4">تعديل اختبار فردي</h3>

    <form asp-action="EditStudentExam" method="post" class="card shadow-sm p-4">
        <input type="hidden" asp-for="AssignmentId" />

        <div class="mb-3">
            <label class="fw-bold">عنوان الاختبار</label>
            <input asp-for="Title" class="form-control" />
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="fw-bold">موعد البداية</label>
                <input asp-for="ScheduledDate" type="datetime-local" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label class="fw-bold">موعد النهاية</label>
                <input asp-for="EndAt" type="datetime-local" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label class="fw-bold">المدة (دقائق)</label>
                <input asp-for="DurationMinutes" class="form-control" />
            </div>
        </div>

        <div class="mb-3">
            <label class="fw-bold">الرقم المرجعي</label>
            <input asp-for="ReferenceCode" class="form-control" />
        </div>

        <div class="text-end">
            <button class="btn btn-primary px-5">
                <i class="fa-solid fa-save me-2"></i>
                حفظ التغييرات
            </button>
        </div>
    </form>
</div>
