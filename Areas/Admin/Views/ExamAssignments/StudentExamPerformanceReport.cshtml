@model QdratNew.ViewModels.Reports.StudentExamPerformanceReportVm
@using System.Text.Json

@{
    ViewData["Title"] = "تقرير أداء الطالب في الاختبار";
    Layout = null;

    // ── مستوى الأداء ────────────────────────────────────────────────
    var pct = Model.OverallPercent;
    string perfLevel = pct >= 85 ? "ممتاز"
                     : pct >= 70 ? "جيد جداً"
                     : pct >= 55 ? "جيد"
                     : pct >= 40 ? "مقبول"
                     : "يحتاج مراجعة";
    string perfColor = pct >= 85 ? "#10B981"
                     : pct >= 70 ? "#0EA5E9"
                     : pct >= 55 ? "#F59E0B"
                     : "#EF4444";

    // ── تحليل الوقت ─────────────────────────────────────────────────
    double timeUsedPct  = Model.DurationMinutes > 0
        ? Math.Min(100, Math.Round(Model.SolveMinutes / Model.DurationMinutes * 100, 1))
        : 0;
    double timeRemain   = Math.Max(0, Model.DurationMinutes - Model.SolveMinutes);

    string timeBarColor = timeUsedPct <= 60 ? "#10B981"
                        : timeUsedPct <= 85 ? "#F59E0B"
                        : "#EF4444";

    // ── أيقونة السرعة ───────────────────────────────────────────────
    string speedIcon = Model.SpeedLabel == "سريع جداً" ? "fa-bolt"
                     : Model.SpeedLabel == "سريع"     ? "fa-forward"
                     : Model.SpeedLabel == "بطيء"     ? "fa-snail"
                     : "fa-gauge-simple-high";

    // ── بيانات الشارتات ─────────────────────────────────────────────
    var sectionLabelsJson = JsonSerializer.Serialize(
        Model.Sections?.Select(s => s.SectionTitle).ToList() ?? new List<string>());
    var sectionScoresJson = JsonSerializer.Serialize(
        Model.Sections?.Select(s => s.AccuracyPercent).ToList() ?? new List<double>());
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <style>
        @@font-face {
            font-family: 'ZA-Roots';
            src: url('/fonts/ZA-roots.woff2') format('woff2'),
                 url('/fonts/ZA-roots.woff') format('woff'),
                 url('/fonts/ZA-roots.TTF') format('truetype');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }
        @@font-face {
            font-family: 'ZA-roots';
            src: url('/fonts/ZA-roots.woff2') format('woff2'),
                 url('/fonts/ZA-roots.woff') format('woff'),
                 url('/fonts/ZA-roots.TTF') format('truetype');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }
        :root {
            --clr-primary:   #4F46E5;
            --clr-primary-d: #3730A3;
            --clr-success:   #10B981;
            --clr-danger:    #EF4444;
            --clr-warning:   #F59E0B;
            --clr-info:      #0EA5E9;
            --clr-bg:        #F1F5F9;
            --clr-surface:   #FFFFFF;
            --clr-border:    #E2E8F0;
            --clr-text:      #1E293B;
            --clr-muted:     #64748B;
            --radius:        16px;
            --shadow-sm:     0 2px 8px rgba(0,0,0,.06);
            --shadow-md:     0 4px 20px rgba(0,0,0,.10);
            --shadow-lg:     0 8px 40px rgba(0,0,0,.14);
            --font:          'Cairo', sans-serif;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }
        body {
            font-family: var(--font);
            background: var(--clr-bg);
            color: var(--clr-text);
            min-height: 100vh;
            direction: rtl;
        }

        /* ── HERO ───────────────────────────────────────────────────── */
        .hero {
            background: linear-gradient(135deg, #1E1B4B 0%, #312E81 40%, #4F46E5 100%);
            color: #fff;
            padding: 32px 0 80px;
            position: relative;
            overflow: hidden;
        }
        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
        }
        .hero-inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            flex-wrap: wrap;
            position: relative;
            z-index: 1;
        }
        .hero-info h1 {
            font-size: clamp(1.4rem, 4vw, 2rem);
            font-weight: 900;
            letter-spacing: -.5px;
            margin-bottom: 6px;
        }
        .hero-info .sub {
            opacity: .8;
            font-size: .9rem;
            margin-bottom: 12px;
        }
        .meta-pills { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
        .meta-pill {
            background: rgba(255,255,255,.15);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255,255,255,.25);
            border-radius: 50px;
            padding: 5px 14px;
            font-size: .82rem;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .hero-label {
            font-size: .8rem;
            opacity: .7;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        /* ── SCORE GAUGE ─────────────────────────────────────────────── */
        .score-gauge-wrap {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }
        .score-gauge {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: conic-gradient(
                @Html.Raw(perfColor) calc(@pct * 1%), rgba(255,255,255,.15) 0
            );
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            box-shadow: 0 0 0 6px rgba(255,255,255,.15), 0 0 0 12px rgba(255,255,255,.08);
        }
        .score-gauge::after {
            content: '';
            position: absolute;
            inset: 14px;
            border-radius: 50%;
            background: #312E81;
        }
        .score-gauge-inner {
            position: relative;
            z-index: 2;
            text-align: center;
        }
        .score-gauge-inner .num {
            font-size: 2rem;
            font-weight: 900;
            line-height: 1;
        }
        .score-gauge-inner .lbl {
            font-size: .72rem;
            opacity: .8;
        }
        .perf-badge {
            background: @Html.Raw(perfColor);
            color: #fff;
            padding: 4px 18px;
            border-radius: 50px;
            font-size: .85rem;
            font-weight: 700;
        }

        /* ── CONTENT ─────────────────────────────────────────────────── */
        .content {
            max-width: 1200px;
            margin: -48px auto 40px;
            padding: 0 24px;
            position: relative;
            z-index: 2;
        }

        /* ── CARD ───────────────────────────────────────────────────── */
        .card {
            background: var(--clr-surface);
            border-radius: var(--radius);
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--clr-border);
            padding: 24px;
            overflow: hidden;
        }
        .card-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
            padding-bottom: 14px;
            border-bottom: 2px solid var(--clr-bg);
        }
        .card-header .icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }
        .card-header h2 {
            font-size: 1rem;
            font-weight: 700;
            color: var(--clr-text);
        }

        /* ── KPI GRID ────────────────────────────────────────────────── */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(155px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }
        .kpi-card {
            background: var(--clr-surface);
            border-radius: var(--radius);
            padding: 20px;
            border: 1px solid var(--clr-border);
            box-shadow: var(--shadow-sm);
            display: flex;
            flex-direction: column;
            gap: 8px;
            position: relative;
            overflow: hidden;
            transition: transform .2s, box-shadow .2s;
        }
        .kpi-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
        .kpi-card::before {
            content: '';
            position: absolute;
            top: 0; right: 0;
            width: 4px; height: 100%;
            background: var(--accent);
        }
        .kpi-card .kpi-icon {
            width: 42px; height: 42px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            background: color-mix(in srgb, var(--accent) 12%, transparent);
            color: var(--accent);
        }
        .kpi-card .kpi-value {
            font-size: 1.9rem;
            font-weight: 900;
            color: var(--accent);
            line-height: 1;
        }
        .kpi-card .kpi-label {
            font-size: .78rem;
            color: var(--clr-muted);
            font-weight: 500;
        }

        /* ── CHARTS GRID ─────────────────────────────────────────────── */
        .charts-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }
        .charts-grid .full { grid-column: 1 / -1; }
        @@media (max-width: 768px) {
            .charts-grid { grid-template-columns: 1fr; }
            .charts-grid .full { grid-column: 1; }
        }
        .chart-canvas-wrap { position: relative; width: 100%; }

        /* ── TIME BAR ────────────────────────────────────────────────── */
        .time-bar-bg {
            background: var(--clr-bg);
            border-radius: 50px;
            height: 14px;
            overflow: hidden;
            margin: 10px 0;
        }
        .time-bar-fill {
            height: 100%;
            border-radius: 50px;
            background: @Html.Raw(timeBarColor);
            transition: width .8s ease;
        }
        .time-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 12px;
            margin-top: 16px;
        }
        .time-stat-box {
            background: var(--clr-bg);
            border-radius: 10px;
            padding: 12px 16px;
            text-align: center;
        }
        .time-stat-box .tsv {
            font-size: 1.4rem;
            font-weight: 900;
            color: var(--clr-text);
            line-height: 1;
        }
        .time-stat-box .tsl {
            font-size: .75rem;
            color: var(--clr-muted);
            font-weight: 500;
            margin-top: 4px;
        }

        /* ── INDICATORS TABLE ────────────────────────────────────────── */
        .indicators-table-wrap { overflow-x: auto; }
        .indicators-table {
            width: 100%;
            border-collapse: collapse;
            font-size: .875rem;
        }
        .indicators-table thead tr {
            background: linear-gradient(135deg, #4F46E5, #7C3AED);
            color: #fff;
        }
        .indicators-table th {
            padding: 12px 14px;
            font-weight: 600;
            text-align: center;
            white-space: nowrap;
        }
        .indicators-table tbody tr {
            border-bottom: 1px solid var(--clr-border);
            transition: background .15s;
        }
        .indicators-table tbody tr:hover { background: #F8FAFF; }
        .indicators-table td {
            padding: 12px 14px;
            text-align: center;
            vertical-align: middle;
        }
        .td-title { text-align: right; font-weight: 600; color: var(--clr-text); }
        .progress-bar-wrap {
            background: var(--clr-bg);
            border-radius: 50px;
            height: 8px;
            overflow: hidden;
            width: 100%;
            min-width: 80px;
        }
        .progress-bar-fill { height: 100%; border-radius: 50px; transition: width .6s ease; }
        .badge-score {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 50px;
            font-size: .78rem;
            font-weight: 700;
        }
        .badge-success { background: #D1FAE5; color: #065F46; }
        .badge-warning { background: #FEF3C7; color: #92400E; }
        .badge-danger  { background: #FEE2E2; color: #991B1B; }

        .btn-review {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: 8px;
            font-size: .8rem;
            font-weight: 600;
            text-decoration: none;
            border: 1.5px solid #4F46E5;
            color: #4F46E5;
            background: transparent;
            transition: all .2s;
            cursor: pointer;
            font-family: var(--font);
        }
        .btn-review:hover { background: #4F46E5; color: #fff; }
        .btn-review-green {
            border-color: #10B981;
            color: #10B981;
        }
        .btn-review-green:hover { background: #10B981; color: #fff; }

        /* ── RECOMMENDATIONS ─────────────────────────────────────────── */
        .rec-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 14px;
        }
        .rec-item {
            display: flex;
            gap: 14px;
            align-items: flex-start;
            padding: 16px;
            border-radius: 12px;
            border: 1px solid #E0E7FF;
            background: linear-gradient(135deg, #F5F3FF 0%, #EEF2FF 100%);
            transition: box-shadow .2s;
        }
        .rec-item:hover { box-shadow: var(--shadow-md); }
        .rec-num {
            width: 32px; height: 32px;
            flex-shrink: 0;
            border-radius: 50%;
            background: var(--clr-primary);
            color: #fff;
            font-weight: 800;
            font-size: .88rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .rec-icon-box {
            width: 36px; height: 36px;
            flex-shrink: 0;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
        }
        .rec-text { font-size: .85rem; color: #374151; line-height: 1.7; }
        .rec-title { font-weight: 800; font-size: .9rem; margin-bottom: 4px; }
        .final-advice {
            background: linear-gradient(135deg, #10B981, #0EA5E9);
            color: #fff;
            border-radius: 12px;
            padding: 16px 24px;
            font-weight: 600;
            font-size: .95rem;
            text-align: center;
            margin-top: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        .alert-box {
            border-radius: 10px;
            padding: 14px 18px;
            margin-bottom: 16px;
            font-size: .9rem;
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }
        .alert-green { background: #F0FDF4; border: 1px solid #6EE7B7; color: #065F46; }
        .alert-amber { background: #FFF7ED; border: 1px solid #FCD34D; color: #92400E; }
        .alert-blue  { background: #EFF6FF; border: 1px solid #93C5FD; color: #1E40AF; }

        /* ── ACTION BAR ──────────────────────────────────────────────── */
        .action-bar {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 32px;
            padding: 24px;
        }
        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 28px;
            border-radius: 10px;
            font-size: .9rem;
            font-weight: 700;
            text-decoration: none;
            border: none;
            cursor: pointer;
            transition: all .2s;
            font-family: var(--font);
        }
        .btn-primary.main {
            background: var(--clr-primary);
            color: #fff;
        }
        .btn-primary.main:hover {
            background: var(--clr-primary-d);
            transform: translateY(-1px);
            box-shadow: 0 4px 16px rgba(79,70,229,.4);
        }
        .btn-primary.ghost {
            background: var(--clr-surface);
            color: var(--clr-text);
            border: 1.5px solid var(--clr-border);
        }
        .btn-primary.ghost:hover { border-color: var(--clr-primary); color: var(--clr-primary); }

        /* ── UTILS ───────────────────────────────────────────────────── */
        .section-gap { margin-bottom: 24px; }

        /* ── PRINT ───────────────────────────────────────────────────── */
        @@media print {
            @@page { size: A4 portrait; margin: 12mm 10mm; }
            html, body { width: auto !important; min-height: auto !important; overflow: visible !important; }
            .no-print { display: none !important; }
            body { background: #fff !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .hero {
                padding: 18px 0 18px !important;
                margin-bottom: 10mm !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                overflow: visible !important;
                break-after: avoid-page;
            }
            .content { margin-top: 0 !important; }
            .card { box-shadow: none !important; border: 1px solid #ddd !important; break-inside: avoid; }
            .kpi-card { break-inside: avoid; }
        }

        /* ── ANIMATIONS ──────────────────────────────────────────────── */
        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .fade-up   { animation: fadeUp .5s ease forwards; }
        .delay-1   { animation-delay: .1s; opacity: 0; }
        .delay-2   { animation-delay: .2s; opacity: 0; }
        .delay-3   { animation-delay: .3s; opacity: 0; }
        .delay-4   { animation-delay: .4s; opacity: 0; }
        .delay-5   { animation-delay: .5s; opacity: 0; }
    </style>
</head>
<body>

<!-- ════════════════════════════════════════════════════════ -->
<!-- HERO                                                     -->
<!-- ════════════════════════════════════════════════════════ -->
<div class="hero">
    <div class="hero-inner">
        <div class="hero-info">
            <div class="hero-label">
                <i class="fa-solid fa-file-chart-column"></i> تقرير أداء الاختبار
            </div>
            <h1>@Model.ExamTitle</h1>
            <div class="sub">تحليل شامل لأداء الطالب في الاختبار</div>
            <div class="meta-pills">
                <span class="meta-pill"><i class="fa-solid fa-user-graduate"></i> @Model.StudentName</span>
                <span class="meta-pill">
                    <i class="fa-solid fa-calendar"></i>
                    @Model.ExamDate.ToString("dd/MM/yyyy")
                </span>
                <span class="meta-pill"><i class="fa-solid fa-clock"></i> @Model.SolveMinutes.ToString("0") دقيقة</span>
                <span class="meta-pill"><i class="fa-solid fa-list-check"></i> @Model.TotalQuestions سؤال</span>
            </div>
        </div>
        <div class="score-gauge-wrap">
            <div class="score-gauge">
                <div class="score-gauge-inner">
                    <div class="num">@pct.ToString("0")%</div>
                    <div class="lbl">النسبة</div>
                </div>
            </div>
            <span class="perf-badge">@perfLevel</span>
        </div>
    </div>
</div>

<!-- ════════════════════════════════════════════════════════ -->
<!-- CONTENT                                                  -->
<!-- ════════════════════════════════════════════════════════ -->
<div class="content">

    <!-- ── KPI CARDS ── -->
    <div class="kpi-grid section-gap fade-up">
        <div class="kpi-card" style="--accent:#10B981">
            <div class="kpi-icon"><i class="fa-solid fa-circle-check"></i></div>
            <div class="kpi-value">@Model.CorrectAnswers</div>
            <div class="kpi-label">إجابات صحيحة</div>
        </div>
        <div class="kpi-card" style="--accent:#EF4444">
            <div class="kpi-icon"><i class="fa-solid fa-circle-xmark"></i></div>
            <div class="kpi-value">@Model.WrongAnswers</div>
            <div class="kpi-label">إجابات خاطئة</div>
        </div>
        <div class="kpi-card" style="--accent:#F59E0B">
            <div class="kpi-icon"><i class="fa-solid fa-circle-minus"></i></div>
            <div class="kpi-value">@Model.SkippedQuestions</div>
            <div class="kpi-label">أسئلة متجاوزة</div>
        </div>
        <div class="kpi-card" style="--accent:#0EA5E9">
            <div class="kpi-icon"><i class="fa-solid fa-list-ol"></i></div>
            <div class="kpi-value">@Model.TotalQuestions</div>
            <div class="kpi-label">إجمالي الأسئلة</div>
        </div>
        <div class="kpi-card" style="--accent:#8B5CF6">
            <div class="kpi-icon"><i class="fa-solid fa-gauge-high"></i></div>
            <div class="kpi-value">@pct.ToString("0")%</div>
            <div class="kpi-label">النسبة الكلية</div>
        </div>
        <div class="kpi-card" style="--accent:#EC4899">
            <div class="kpi-icon"><i class="fa-solid fa-@speedIcon"></i></div>
            <div class="kpi-value" style="font-size:1.4rem">@Model.SpeedLabel</div>
            <div class="kpi-label">تصنيف السرعة</div>
        </div>
    </div>

    <!-- ── CHARTS ── -->
    <div class="charts-grid section-gap">

        <!-- دونات: توزيع الإجابات -->
        <div class="card fade-up delay-1">
            <div class="card-header">
                <div class="icon" style="background:#EEF2FF; color:#4F46E5">
                    <i class="fa-solid fa-chart-pie"></i>
                </div>
                <h2>توزيع الإجابات</h2>
            </div>
            <div class="chart-canvas-wrap" style="height:240px">
                <canvas id="pieChart"></canvas>
            </div>
        </div>

        <!-- شريطي: أداء الأقسام -->
        @if (Model.Sections?.Any() == true)
        {
            <div class="card fade-up delay-2">
                <div class="card-header">
                    <div class="icon" style="background:#ECFDF5; color:#10B981">
                        <i class="fa-solid fa-chart-bar"></i>
                    </div>
                    <h2>الأداء حسب الأقسام</h2>
                </div>
                <div class="chart-canvas-wrap" style="height:240px">
                    <canvas id="sectionBar"></canvas>
                </div>
            </div>
        }

        <!-- تحليل الوقت (full width) -->
        <div class="card @(Model.Sections?.Any() == true ? "full" : "") fade-up delay-3">
            <div class="card-header">
                <div class="icon" style="background:#FFF7ED; color:#F59E0B">
                    <i class="fa-solid fa-hourglass-half"></i>
                </div>
                <h2>تحليل الوقت</h2>
                <span style="margin-right:auto; font-size:.78rem; color:var(--clr-muted)">
                    @timeUsedPct.ToString("0")% من الوقت المتاح
                </span>
            </div>
            <div class="time-bar-bg">
                <div class="time-bar-fill" id="timeBarFill" style="width:0"></div>
            </div>
            <div class="time-stats">
                <div class="time-stat-box">
                    <div class="tsv" style="color:#4F46E5">@Model.SolveMinutes.ToString("0") د</div>
                    <div class="tsl">وقت الحل</div>
                </div>
                <div class="time-stat-box">
                    <div class="tsv" style="color:#64748B">@Model.DurationMinutes.ToString("0") د</div>
                    <div class="tsl">الوقت المتاح</div>
                </div>
                <div class="time-stat-box">
                    <div class="tsv" style="color:#10B981">@timeRemain.ToString("0") د</div>
                    <div class="tsl">الوقت المتبقي</div>
                </div>
                <div class="time-stat-box">
                    <div class="tsv" style="color:#EC4899; font-size:1.1rem">@Model.SpeedLabel</div>
                    <div class="tsl">تصنيف السرعة</div>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.SpeedNote))
            {
                <div class="alert-box alert-blue" style="margin-top:14px; margin-bottom:0">
                    <i class="fa-solid fa-circle-info" style="flex-shrink:0; margin-top:2px"></i>
                    <span>@Model.SpeedNote</span>
                </div>
            }
        </div>

    </div>

    <!-- ── SECTIONS TABLE ── -->
    @if (Model.Sections?.Any() == true)
    {
        <div class="card section-gap fade-up delay-4">
            <div class="card-header">
                <div class="icon" style="background:#EEF2FF; color:#4F46E5">
                    <i class="fa-solid fa-table-list"></i>
                </div>
                <h2>تفاصيل الأداء بالأقسام</h2>
            </div>
            <div class="indicators-table-wrap">
                <table class="indicators-table">
                    <thead>
                        <tr>
                            <th style="text-align:right">القسم</th>
                            <th>الأسئلة</th>
                            <th>صحيح</th>
                            <th>خاطئ</th>
                            <th>تجاوز</th>
                            <th>نسبة الأداء</th>
                            <th>المستوى</th>
                            <th class="no-print">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sec in Model.Sections)
                        {
                            var sp   = sec.AccuracyPercent;
                            var sc   = sp >= 85 ? "badge-success" : sp >= 55 ? "badge-warning" : "badge-danger";
                            var bar  = sp >= 85 ? "#10B981"       : sp >= 55 ? "#F59E0B"       : "#EF4444";
                            var lev  = sp >= 85 ? "ممتاز"
                                     : sp >= 70 ? "جيد جداً"
                                     : sp >= 55 ? "جيد"
                                     : sp >= 40 ? "مقبول"
                                     : "قيد التطوير";
                            <tr>
                                <td class="td-title">@sec.SectionTitle</td>
                                <td>@sec.Total</td>
                                <td style="color:#10B981; font-weight:700">@sec.Correct</td>
                                <td style="color:#EF4444; font-weight:700">@sec.Wrong</td>
                                <td style="color:#F59E0B; font-weight:700">@sec.Skipped</td>
                                <td>
                                    <div style="display:flex; align-items:center; gap:8px; min-width:120px">
                                        <div class="progress-bar-wrap" style="flex:1">
                                            <div class="progress-bar-fill" style="width:@sp%; background:@bar"></div>
                                        </div>
                                        <span class="badge-score @sc">@sp.ToString("0")%</span>
                                    </div>
                                </td>
                                <td><span class="badge-score @sc">@lev</span></td>
                                <td class="no-print">
                                    <div style="display:flex; gap:6px; justify-content:center; flex-wrap:wrap">
                                        <a href="/Admin/ExamAssignments/SectionQuestions?examAssignmentId=@Model.ExamAssignmentId&sectionId=@sec.SectionId&studentId=@Model.StudentId"
                                           class="btn-review">
                                            <i class="fa-solid fa-eye"></i> الأسئلة
                                        </a>
                                        <a href="/Admin/ExamAssignments/SectionLessons?assignmentId=@Model.ExamAssignmentId&examAssignmentId=@Model.ExamAssignmentId&sectionId=@sec.SectionId&studentId=@Model.StudentId"
                                           class="btn-review btn-review-green">
                                            <i class="fa-solid fa-book-open"></i> الدروس
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ── RECOMMENDATIONS ── -->
    @{
        bool hasRec = !string.IsNullOrEmpty(Model.TrackCard1)
                   || !string.IsNullOrEmpty(Model.TrackCard2)
                   || (Model.IndividualTips?.Any() == true);
    }
    @if (hasRec)
    {
        <div class="card section-gap fade-up delay-5">
            <div class="card-header">
                <div class="icon" style="background:#ECFDF5; color:#10B981">
                    <i class="fa-solid fa-lightbulb"></i>
                </div>
                <h2>التوصيات والمسار التطويري</h2>
            </div>

            <!-- Track Cards as rec-items -->
            @if (!string.IsNullOrEmpty(Model.TrackCard1) || !string.IsNullOrEmpty(Model.TrackCard2))
            {
                <div class="rec-grid" style="margin-bottom:16px">
                    @if (!string.IsNullOrEmpty(Model.TrackCard1))
                    {
                        <div class="rec-item" style="background:linear-gradient(135deg,#EFF6FF,#DBEAFE); border-color:#BFDBFE;">
                            <div class="rec-icon-box" style="background:#DBEAFE; color:#2563EB">
                                <i class="fa-solid fa-map"></i>
                            </div>
                            <div>
                                <div class="rec-title" style="color:#1E40AF">@Model.TrackCard1</div>
                                @if (!string.IsNullOrEmpty(Model.TrackCard1Desc))
                                {
                                    <div class="rec-text">@Model.TrackCard1Desc</div>
                                }
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.TrackCard2))
                    {
                        <div class="rec-item" style="background:linear-gradient(135deg,#ECFDF5,#D1FAE5); border-color:#6EE7B7;">
                            <div class="rec-icon-box" style="background:#D1FAE5; color:#059669">
                                <i class="fa-solid fa-compass"></i>
                            </div>
                            <div>
                                <div class="rec-title" style="color:#065F46">@Model.TrackCard2</div>
                                @if (!string.IsNullOrEmpty(Model.TrackCard2Desc))
                                {
                                    <div class="rec-text">@Model.TrackCard2Desc</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Individual Tips -->
            @if (Model.IndividualTips?.Any() == true)
            {
                <div style="font-weight:700; font-size:.9rem; color:var(--clr-text); margin-bottom:12px">
                    <i class="fa-solid fa-stars" style="color:#F59E0B; margin-left:6px"></i>
                    نصائح شخصية
                </div>
                <div class="rec-grid">
                    @for (int i = 0; i < Model.IndividualTips.Count; i++)
                    {
                        <div class="rec-item">
                            <div class="rec-num">@(i + 1)</div>
                            <div class="rec-text">@Model.IndividualTips[i]</div>
                        </div>
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.SpeedNote))
            {
                <div class="final-advice">
                    <i class="fa-solid fa-star"></i>
                    @Model.SpeedNote
                </div>
            }
        </div>
    }

    <!-- ── ACTION BAR ── -->
    <div class="action-bar no-print">
        <button onclick="window.print()" class="btn-primary main">
            <i class="fa-solid fa-print"></i> طباعة / PDF
        </button>
        <a asp-area="Admin"
           asp-controller="ExamAssignments"
           asp-action="Index"
           class="btn-primary ghost">
            <i class="fa-solid fa-arrow-right"></i> العودة للاختبارات
        </a>
    </div>

</div><!-- /content -->

<!-- ════════════════════════════════════════════════════════ -->
<!-- SCRIPTS                                                  -->
<!-- ════════════════════════════════════════════════════════ -->
<script>
(function () {
    const palette = {
        green:  '#10B981',
        red:    '#EF4444',
        amber:  '#F59E0B',
        blue:   '#0EA5E9',
        indigo: '#4F46E5',
        purple: '#7C3AED',
    };

    // ── 1. دونات: توزيع الإجابات ─────────────────────────────────
    new Chart(document.getElementById('pieChart'), {
        type: 'doughnut',
        data: {
            labels: ['صحيحة', 'خاطئة', 'متجاوزة'],
            datasets: [{
                data: [@Model.CorrectAnswers, @Model.WrongAnswers, @Model.SkippedQuestions],
                backgroundColor: [palette.green, palette.red, palette.amber],
                borderWidth: 2,
                borderColor: '#fff',
                hoverOffset: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: { font: { family: 'Cairo', size: 12 }, padding: 16 }
                },
                tooltip: {
                    callbacks: { label: ctx => ` ${ctx.label}: ${ctx.parsed} سؤال` }
                }
            },
            cutout: '65%'
        }
    });

    // ── 2. شريطي: أداء الأقسام ───────────────────────────────────
    const sectionBarEl = document.getElementById('sectionBar');
    if (sectionBarEl) {
        const secLabels = @Html.Raw(sectionLabelsJson);
        const secScores = @Html.Raw(sectionScoresJson);
        const secColors = secScores.map(s => s >= 85 ? palette.green : s >= 55 ? palette.amber : palette.red);

        new Chart(sectionBarEl, {
            type: 'bar',
            data: {
                labels: secLabels,
                datasets: [{
                    label: 'نسبة الأداء %',
                    data: secScores,
                    backgroundColor: secColors,
                    borderRadius: 8,
                    borderSkipped: false
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                indexAxis: 'y',
                plugins: { legend: { display: false } },
                scales: {
                    x: {
                        beginAtZero: true,
                        max: 100,
                        ticks: { callback: v => v + '%' },
                        grid: { color: '#F1F5F9' }
                    },
                    y: { ticks: { font: { family: 'Cairo', size: 11 } } }
                }
            }
        });
    }

    // ── 3. شريط الوقت ────────────────────────────────────────────
    setTimeout(function () {
        const bar = document.getElementById('timeBarFill');
        if (bar) bar.style.width = '@timeUsedPct%';
    }, 300);

})();
</script>

</body>
</html>
