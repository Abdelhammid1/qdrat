@model QdratNew.ViewModels.Homework.ModelAssignmentsPageViewModel
@{
    ViewData["Title"] = "الواجبات والاختبارات المرسلة من النماذج الاحترافية";
}

<h2 class="mb-4">📘 الواجبات والاختبارات من النماذج الاحترافية</h2>

<div class="mb-3">
    <a asp-action="CreateModelHomework" asp-route-batchId="0" class="btn btn-success">
        ➕ إنشاء واجب نموذجي
    </a>
    <a asp-action="CreateModelExam" asp-route-batchId="0" class="btn btn-primary">
        ➕ إنشاء اختبار نموذجي
    </a>
</div>

<h4>📌 الواجبات</h4>
<table id="homeworksTable" class="table table-bordered table-striped align-middle">
    <thead class="table-light">
        <tr>
            <th>العنوان</th>
            <th>الدفعة</th>
            <th>عدد الطلاب</th>
            <th>عدد الأسئلة</th>
            <th>التاريخ</th>
            <th>الطلاب الجدد</th>
            <th>إجراءات</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Homeworks.Any())
        {
            foreach (var item in Model.Homeworks)
            {
                <tr>
                    <td class="fw-bold">@item.Title</td>
                    <td>@item.BatchName</td>
                    <td>@item.StudentCount</td>
                    <td>@item.QuestionCount</td>
                    <td>@item.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                    <td>
                        <form asp-action="GenerateHomeworkForNewStudents" method="post">
                            <input type="hidden" name="homeworkSetId" value="@item.Id" />
                            <button type="submit" class="btn btn-outline-primary btn-sm">
                                🔁 توليد للطلاب الجدد
                            </button>
                        </form>
                    </td>
                    <td class="text-nowrap">
                        <a asp-area="Admin" asp-controller="HomeworkManagement" asp-action="Details" asp-route-id="@item.Id"
                           class="btn btn-info btn-sm">تفاصيل</a>

                        <a asp-area="Admin" asp-controller="AdminLessonCompletions" asp-action="EditProfessionalHomework" asp-route-id="@item.Id"
                           class="btn btn-outline-secondary btn-sm">✏️ تعديل</a>

                        <button type="button" class="btn btn-outline-danger btn-sm"
                                data-action="@Url.Action("DeleteModelHomework", "AdminLessonCompletions", new { id = item.Id })"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteConfirmModal">
                            🗑 حذف
                        </button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="7" class="text-center text-muted">❌ لا توجد واجبات مرسلة من النماذج.</td></tr>
        }
    </tbody>
</table>

<hr />

<h4>📌 الاختبارات</h4>
<table id="examsTable" class="table table-bordered table-striped align-middle">
    <thead class="table-light">
        <tr>
            <th>العنوان</th>
            <th>الدفعة</th>
            <th>عدد الطلاب</th>
            <th>عدد الأسئلة</th>
            <th>التاريخ</th>
            <th>إجراءات</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Exams.Any())
        {
            foreach (var item in Model.Exams)
            {
                <tr>
                    <td class="fw-bold">@item.Title</td>
                    <td>@item.BatchName</td>
                    <td>@item.StudentCount</td>
                    <td>@item.QuestionCount</td>
                    <td>@item.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                    <td class="text-nowrap">
                        <a asp-area="Admin" asp-controller="ExamAssignments" asp-action="Details" asp-route-id="@item.Id"
                           class="btn btn-info btn-sm">تفاصيل</a>

                        <a asp-area="Admin" asp-controller="AdminLessonCompletions" asp-action="EditProfessionalExam" asp-route-id="@item.Id"
                           class="btn btn-outline-secondary btn-sm">✏️ تعديل</a>

                        <button type="button" class="btn btn-outline-danger btn-sm"
                                data-action="@Url.Action("DeleteModelExam", "AdminLessonCompletions", new { id = item.Id })"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteConfirmModal">
                            🗑 حذف
                        </button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="6" class="text-center text-muted">❌ لا توجد اختبارات مرسلة من النماذج.</td></tr>
        }
    </tbody>
</table>

<!-- ✅ مودال تأكيد الحذف -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="deleteConfirmModalLabel">تأكيد الحذف</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body text-center">
                <p class="fw-bold fs-5">هل أنت متأكد من حذف هذا العنصر؟</p>
                <p class="text-muted mb-0">سيتم حذف جميع البيانات المرتبطة به نهائيًا.</p>
            </div>
            <div class="modal-footer justify-content-center">
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-danger px-4">تأكيد الحذف</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" />

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <!-- أزرار التصدير -->
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.colVis.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // ✅ تفعيل DataTables للواجبات
            $('#homeworksTable').DataTable({
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json'
                },
                dom: 'Bfrtip',
                buttons: [
                    { extend: 'copy', text: '📋 نسخ' },
                    { extend: 'excel', text: '📊 Excel' },
                    { extend: 'print', text: '🖨 طباعة' },
                    { extend: 'colvis', text: '👁‍ عرض الأعمدة' }
                ],
                pageLength: 15,
                order: [[4, 'desc']]
            });

            // ✅ تفعيل DataTables للاختبارات
            $('#examsTable').DataTable({
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json'
                },
                dom: 'Bfrtip',
                buttons: [
                    { extend: 'copy', text: '📋 نسخ' },
                    { extend: 'excel', text: '📊 Excel' },
                    { extend: 'print', text: '🖨 طباعة' },
                    { extend: 'colvis', text: '👁‍ عرض الأعمدة' }
                ],
                pageLength: 15,
                order: [[4, 'desc']]
            });

            // ✅ تفعيل مودال الحذف
            const modal = document.getElementById('deleteConfirmModal');
            const form = document.getElementById('deleteForm');
            modal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const actionUrl = button.getAttribute('data-action');
                form.setAttribute('action', actionUrl);
            });

            // ✅ تنبيهات النجاح والخطأ
            const success = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(TempData["Success"]));
            const error = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(TempData["Error"]));

            if (success) {
                Swal.fire({ icon: 'success', title: 'تم بنجاح ✅', text: success });
            }
            if (error) {
                Swal.fire({ icon: 'warning', title: 'تنبيه ⚠️', text: error });
            }
        });
    </script>
}

