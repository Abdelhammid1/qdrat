@model QdratNew.ViewModels.Exam.ExamQuestionsListViewModel
@{
    ViewData["Title"] = "📋 الأسئلة المرتبطة بالاختبار";
}

<h2 class="mb-4">📋 الأسئلة المرسلة للاختبار: @Model.ExamTitle</h2>

@if (!Model.Questions.Any())
{
    <div class="alert alert-warning">❌ لا توجد أسئلة مرتبطة بهذا الاختبار حتى الآن.</div>
}
else
{
    <table class="table table-bordered text-center" id="examQuestionsTable">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>السؤال</th>
                <th>المؤشر</th>
                <th>المحور</th>
                <th>الصعوبة</th>
                <th>نوع التحديد</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var q in Model.Questions)
            {
                <tr>
                    <td>@q.Order</td>
                    <td class="text-start">
                        <button type="button"
                                class="btn btn-outline-info btn-sm rounded-circle"
                                title="معاينة السؤال"
                                onclick="loadQuestionPreview('@q.QuestionId')">
                            <i class="fas fa-eye"></i>
                        </button>
                        <span class="ms-2">
                            @(q.QuestionText?.Length > 15 ? q.QuestionText.Substring(0, 15) + "..." : q.QuestionText)
                        </span>
                    </td>
                    <td>@q.LessonTitle</td>
                    <td>@q.SectionTitle</td>
                    <td>
                        <span class="badge bg-secondary">@q.Difficulty.ToString()</span>
                    </td>
                    <td>
                        @if (q.IsManual)
                        {
                            <span class="badge bg-success">✅ يدوي</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">⚙️ تلقائي</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-4 text-end">
    <a asp-action="Details" asp-route-id="@Context.Request.RouteValues["id"]" class="btn btn-secondary">
        🔙 عودة للتفاصيل
    </a>
</div>

<!-- ✅ مودال المعاينة -->
<div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content text-end">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title"><i class="fas fa-eye"></i> معاينة السؤال</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="previewModalBody">
                <div class="text-center">جاري التحميل...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function loadQuestionPreview(id) {
            fetch(`/Admin/Questions/Preview/${id}`)
                .then(res => res.text())
                .then(html => {
                    document.getElementById("previewModalBody").innerHTML = html;
                    new bootstrap.Modal(document.getElementById("previewModal")).show();
                })
                .catch(() => {
                    Swal.fire('خطأ!', 'حدث خطأ أثناء تحميل السؤال.', 'error');
                });
        }

        $(document).ready(function () {
            $('#examQuestionsTable').DataTable({
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json"
                }
            });
        });
    </script>
}
