@model QdratNew.ViewModels.Section.SectionViewModel

@{
    ViewData["Title"] = "إضافة محور تعليمي";
}

<div class="qdrat-page" dir="rtl">

    <div class="qdrat-hero mb-4">
        <div>
            <div class="qdrat-kicker">
                <i class="fas fa-layer-group"></i>
                محور تعليمي جديد
            </div>

            <h2 class="qdrat-title">إضافة محور تعليمي</h2>

            <p class="qdrat-subtitle">
                أضف محورًا جديدًا واربطه بالمنهج المناسب ليتم استخدامه لاحقًا في بنك الأسئلة والواجبات والاختبارات.
            </p>
        </div>

        <div class="qdrat-hero-icon">
            <i class="fas fa-sitemap"></i>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert qdrat-alert qdrat-alert-success">
            <i class="fas fa-check-circle"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert qdrat-alert qdrat-alert-danger">
            <i class="fas fa-exclamation-circle"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <div class="qdrat-card">
        <div class="qdrat-card-header">
            <div>
                <h5>
                    <i class="fas fa-pen-to-square"></i>
                    بيانات المحور
                </h5>
                <p>
                    تأكد من كتابة عنوان واضح للمحور واختيار المنهج المرتبط به بدقة.
                </p>
            </div>
        </div>

        <div class="qdrat-card-body">
            <form asp-action="Create" method="post" autocomplete="off">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert qdrat-alert qdrat-alert-danger mb-4"></div>

                <div class="row g-4">
                    <div class="col-lg-7 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="Title" class="form-label">عنوان المحور</label>

                            <div class="qdrat-input-wrap">
                                <i class="fas fa-layer-group"></i>
                                <input asp-for="Title"
                                       class="form-control"
                                       placeholder="مثل: محور الجبر أو محور الهندسة" />
                            </div>

                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-5 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="CurriculumId" class="form-label">المنهج المرتبط</label>

                            <div class="qdrat-input-wrap">
                                <i class="fas fa-book-open"></i>
                                <select asp-for="CurriculumId" asp-items="Model.Curriculums" class="form-select">
                                    <option value="">-- اختر المنهج --</option>
                                </select>
                            </div>

                            <span asp-validation-for="CurriculumId" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="qdrat-info-box mt-4">
                    <i class="fas fa-circle-info"></i>
                    <span>
                        المحور هو المستوى التنظيمي الذي تُبنى عليه المؤشرات والأسئلة والتحليلات، لذلك يفضّل أن يكون الاسم مختصرًا وواضحًا.
                    </span>
                </div>

                <div class="qdrat-actions">
                    <a asp-action="Index" class="btn qdrat-btn qdrat-btn-light">
                        <i class="fas fa-arrow-right"></i>
                        رجوع
                    </a>

                    <button type="submit" class="btn qdrat-btn qdrat-btn-primary">
                        <i class="fas fa-save"></i>
                        حفظ المحور
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

<style>
    .qdrat-page {
        padding: 24px;
        background: #f5f7fb;
        min-height: calc(100vh - 80px);
        font-family: inherit;
    }

    .qdrat-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 26px;
        border-radius: 24px;
        background: linear-gradient(135deg, #102a43 0%, #1d4ed8 58%, #38bdf8 100%);
        color: #fff;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
    }

    .qdrat-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .qdrat-title {
        margin: 0;
        font-size: 28px;
        font-weight: 900;
        letter-spacing: -0.5px;
    }

    .qdrat-subtitle {
        margin: 10px 0 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 15px;
        line-height: 1.8;
        max-width: 850px;
    }

    .qdrat-hero-icon {
        width: 74px;
        height: 74px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.16);
        font-size: 34px;
        flex: 0 0 auto;
    }

    .qdrat-card {
        border: 1px solid #e5e7eb;
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    .qdrat-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #edf0f5;
        background: #fff;
    }

        .qdrat-card-header h5 {
            margin: 0;
            color: #0f172a;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .qdrat-card-header h5 i {
                color: #2563eb;
            }

        .qdrat-card-header p {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 14px;
        }

    .qdrat-card-body {
        padding: 24px;
    }

    .qdrat-field .form-label {
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 9px;
    }

    .qdrat-input-wrap {
        position: relative;
    }

        .qdrat-input-wrap > i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 3;
            pointer-events: none;
        }

        .qdrat-input-wrap .form-control,
        .qdrat-input-wrap .form-select {
            min-height: 48px;
            border-radius: 15px;
            border-color: #dbe3ef;
            padding-right: 42px;
            font-weight: 700;
        }

            .qdrat-input-wrap .form-control:focus,
            .qdrat-input-wrap .form-select:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 0.22rem rgba(37, 99, 235, 0.12);
            }

    .qdrat-info-box {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 14px 16px;
        border-radius: 18px;
        background: #eff6ff;
        color: #1e40af;
        font-size: 14px;
        font-weight: 800;
        line-height: 1.8;
    }

        .qdrat-info-box i {
            margin-top: 4px;
        }

    .qdrat-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 26px;
        margin-top: 28px;
        border-top: 1px solid #edf0f5;
    }

    .qdrat-btn {
        min-height: 46px;
        border-radius: 14px;
        padding: 10px 24px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .qdrat-btn-primary {
        background: #16a34a;
        border-color: #16a34a;
        color: #fff;
    }

        .qdrat-btn-primary:hover {
            background: #15803d;
            border-color: #15803d;
            color: #fff;
        }

    .qdrat-btn-light {
        background: #f8fafc;
        border-color: #dbe3ef;
        color: #334155;
    }

        .qdrat-btn-light:hover {
            background: #eef2f7;
            border-color: #cbd5e1;
            color: #0f172a;
        }

    .qdrat-alert {
        border: 0;
        border-radius: 18px;
        padding: 15px 18px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 800;
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.07);
    }

        .qdrat-alert:empty {
            display: none;
        }

    .qdrat-alert-danger {
        color: #991b1b;
        background: #fee2e2;
    }

    .qdrat-alert-success {
        color: #166534;
        background: #dcfce7;
    }

    @@media (max-width: 768px) {
        .qdrat-page {
            padding: 14px;
        }

        .qdrat-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 20px;
        }

        .qdrat-title {
            font-size: 23px;
        }

        .qdrat-hero-icon {
            width: 58px;
            height: 58px;
            font-size: 26px;
        }

        .qdrat-card-body,
        .qdrat-card-header {
            padding: 18px;
        }

        .qdrat-actions {
            flex-direction: column-reverse;
        }

        .qdrat-btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
