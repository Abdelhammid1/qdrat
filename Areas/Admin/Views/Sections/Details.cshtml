@model QdratNew.Entities.Section

<h2><i class="fas fa-info-circle"></i> تفاصيل المحور</h2>

<div class="form-group">
    <label>📌 العنوان:</label>
    <p class="form-control-plaintext">@Model.Title</p>
</div>

<div class="form-group">
    <label>📖 المنهج:</label>
    <p class="form-control-plaintext">@Model.Curriculum?.Title</p>

@if (Model.AIScore != null)
{
    <div class="alert alert-info">
        <strong>تحليل الذكاء الاصطناعي:</strong><br />
        النتيجة: @(Model.AIScore * 100)% <br />
        الملاحظات: @Model.AINotes
    </div>
    }
</div>

<hr />
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="fas fa-edit"></i> تعديل</a>
<a asp-action="Index" class="btn btn-secondary">رجوع</a>
