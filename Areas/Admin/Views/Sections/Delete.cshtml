@model QdratNew.Entities.Section

<h2><i class="fas fa-trash"></i> حذف المحور</h2>

<p>هل أنت متأكد أنك تريد حذف المحور التالي؟</p>

<div class="form-group">
    <label>📌 العنوان:</label>
    <p class="form-control-plaintext">@Model.Title</p>
</div>

<div class="form-group">
    <label>📖 المنهج:</label>
    <p class="form-control-plaintext">@Model.Curriculum?.Title</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> تأكيد الحذف</button>
    <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
</form>
