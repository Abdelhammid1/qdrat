@model QdratNew.Entities.ProfessionalModel
@{
    ViewData["Title"] = "حذف النموذج";
}

<h2 class="mb-3 text-danger">حذف النموذج</h2>

<div class="alert alert-warning">
    <i class="fa fa-exclamation-triangle me-2"></i>
    هل أنت متأكد أنك تريد حذف هذا النموذج؟ لا يمكن التراجع بعد الحذف.
</div>

<div class="card border-danger shadow-sm mb-4">
    <div class="card-header bg-danger text-white fw-bold">
        <i class="fa fa-info-circle me-1"></i> تفاصيل النموذج
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">العنوان</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3">الوصف</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3">تاريخ الإنشاء</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</dd>

            <dt class="col-sm-3">أنشئ بواسطة</dt>
            <dd class="col-sm-9">@Model.CreatedBy</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">
            <i class="fa fa-trash me-1"></i> تأكيد الحذف
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fa fa-arrow-left me-1"></i> إلغاء
        </a>
    </div>
</form>
