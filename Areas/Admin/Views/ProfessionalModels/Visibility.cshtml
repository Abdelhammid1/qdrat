@model QdratNew.ViewModels.ProfessionalModel.ProfessionalModelVisibilityVm

<h3 class="mb-3">تحديد صلاحيات ظهور النموذج</h3>

<form asp-action="Visibility" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ProfessionalModelId" />

    <div class="form-check mb-3">
        <input asp-for="IsGlobal" class="form-check-input" />
        <label asp-for="IsGlobal" class="form-check-label"></label>
    </div>

    <div class="mb-3">
        <label class="form-label">الشركاء</label>
        <select asp-for="SelectedPartnerIds"
                asp-items="Model.Partners"
                class="form-select"
                multiple>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">فترات الاشتراك (المدارس)</label>
        <select asp-for="SelectedSubscriptionPeriodIds"
                asp-items="Model.SubscriptionPeriods"
                class="form-select"
                multiple>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">
        حفظ الصلاحيات
    </button>
</form>
