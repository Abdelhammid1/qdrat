@model QdratNew.ViewModels.ProfessionalModel.ProfessionalModelVisibilityVm

<h3 class="mb-3">تحديد صلاحيات ظهور النموذج</h3>

<form asp-action="Visibility" method="post" dir="rtl">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ProfessionalModelId" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

    <partial name="_PartnerAudienceSection" model="Model" />

    <details class="my-3" open="@(Model.SelectedSubscriptionPeriodIds.Count > 0)">
        <summary class="fw-bold mb-2">خيارات متقدمة: فترات الاشتراك</summary>
        <label asp-for="SelectedSubscriptionPeriodIds" class="form-label">فترات الاشتراك (المدارس)</label>
        <select asp-for="SelectedSubscriptionPeriodIds"
                asp-items="Model.SubscriptionPeriods"
                class="form-select"
                multiple>
        </select>
        <div class="form-text">تُطبَّق عند تفعيل «موجّه للشركاء»، ويرى النموذج شريك الفترة الفعالة بتاريخ اليوم.</div>
    </details>

    <button type="submit" class="btn btn-primary">
        حفظ الصلاحيات
    </button>
</form>

@section Scripts {
    <script src="~/js/admin-professional-model-partners.js" asp-append-version="true"></script>
}
