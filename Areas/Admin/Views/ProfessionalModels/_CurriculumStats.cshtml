@using QdratNew.Enums
@using QdratNew.ViewModels.ProfessionalModel

@{
    var stats        = ViewBag.CurriculumStats as List<CurriculumModelStatsVm> ?? new();
    string[] accents = { "blue", "emerald", "violet", "amber", "rose" };
    int ai = 0;
    var totalHw  = stats.Sum(s => s.HomeworkCount);
    var totalEx  = stats.Sum(s => s.ExamCount);
}

@if (!stats.Any()) { return; }

<style>
.cstats-section { margin-bottom: 28px; direction: rtl; font-family: 'Cairo', sans-serif; }

.cstats-header  { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:14px; margin-bottom:18px; }
.cstats-header-left { display:flex; align-items:center; gap:13px; }
.cstats-header-icon {
    width:46px; height:46px; border-radius:var(--r-lg);
    background:linear-gradient(135deg,#103E7A 0%,#2471D0 100%);
    display:flex; align-items:center; justify-content:center;
    color:#fff; font-size:20px; box-shadow:0 4px 14px rgba(27,94,174,.30); flex-shrink:0;
}
.cstats-header-text h3 { margin:0; font-size:18px; font-weight:800; color:var(--ink); }
.cstats-header-text p  { margin:3px 0 0; font-size:13px; color:var(--ink-4); font-weight:600; }
.cstats-header-right { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
.cstats-pill {
    display:inline-flex; align-items:center; gap:6px; padding:6px 13px;
    border-radius:30px; font-size:13px; font-weight:700;
    border:1px solid var(--border); background:var(--surface); color:var(--ink-3); white-space:nowrap;
}
.cstats-pill i { font-size:12px; }
.cstats-pill--blue  { color:var(--blue);  background:var(--blue-bg);  border-color:#B6D3F4; }
.cstats-pill--amber { color:var(--amber); background:var(--amber-bg); border-color:#F3D494; }

.cstats-grid {
    display:grid; grid-template-columns:repeat(3,1fr); gap:16px;
}
@@media (max-width:1100px) { .cstats-grid { grid-template-columns:repeat(2,1fr); } }
@@media (max-width:640px)  { .cstats-grid { grid-template-columns:1fr; } }

/* ── Card ── */
.cstat-card {
    background:var(--surface); border:1px solid var(--border); border-radius:var(--r-xl);
    overflow:hidden; box-shadow:var(--sh-sm);
    transition:box-shadow .22s var(--ease), transform .22s var(--ease);
    --accent:var(--blue); --accent-bg:var(--blue-bg);
}
.cstat-card:hover { box-shadow:var(--sh-md); transform:translateY(-2px); }
.cstat-card[data-accent="blue"]    { --accent:#1B5EAE; --accent-bg:#E8F1FB; }
.cstat-card[data-accent="emerald"] { --accent:#0D7A5B; --accent-bg:#E4F5EE; }
.cstat-card[data-accent="violet"]  { --accent:#5535B5; --accent-bg:#EDE8F9; }
.cstat-card[data-accent="amber"]   { --accent:#985D09; --accent-bg:#FDF0D8; }
.cstat-card[data-accent="rose"]    { --accent:#BF1030; --accent-bg:#FDEAEE; }

.cstat-accent-bar { height:4px; background:var(--accent); }

.cstat-card-head { padding:15px 16px 12px; display:flex; align-items:flex-start; gap:12px; }
.cstat-icon {
    width:42px; height:42px; border-radius:11px;
    background:var(--accent-bg); color:var(--accent);
    display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0;
}
.cstat-info { flex:1; min-width:0; }
.cstat-name {
    font-size:15px; font-weight:800; color:var(--ink); display:block;
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
}
.cstat-total {
    display:inline-flex; align-items:center; gap:4px; margin-top:5px;
    padding:2px 9px; border-radius:30px; font-size:12px; font-weight:700;
    background:var(--accent-bg); color:var(--accent);
}
.cstat-divider { height:1px; background:var(--surface-3); margin:0 16px; }

/* ── Action links (not buttons anymore) ── */
.cstat-card-actions { padding:12px 16px 15px; display:flex; gap:8px; }

.cstat-link {
    flex:1; display:flex; align-items:center; justify-content:center; gap:7px;
    padding:10px 12px; border:1.5px solid; border-radius:var(--r-md);
    font-family:'Cairo',sans-serif; font-size:13px; font-weight:800;
    text-decoration:none; transition:all .18s var(--ease); white-space:nowrap;
    cursor:pointer;
}
.cstat-link i { font-size:13px; }
.cstat-link-count {
    display:inline-flex; align-items:center; justify-content:center;
    min-width:20px; height:20px; padding:0 5px; border-radius:20px;
    font-size:11px; font-weight:900; transition:all .18s;
}
.cstat-link-arrow { font-size:10px; margin-right:auto; }

/* Homework link */
.cstat-link-hw { background:var(--amber-bg); color:var(--amber); border-color:#F3D494; }
.cstat-link-hw .cstat-link-count { background:#F3D494; color:var(--amber); }
.cstat-link-hw:hover {
    background:#985D09; color:#fff; border-color:#985D09;
    box-shadow:0 4px 14px rgba(152,93,9,.28);
}
.cstat-link-hw:hover .cstat-link-count { background:rgba(255,255,255,.22); color:#fff; }

/* Exam link */
.cstat-link-ex { background:var(--blue-bg); color:var(--blue); border-color:#B6D3F4; }
.cstat-link-ex .cstat-link-count { background:#B6D3F4; color:var(--blue); }
.cstat-link-ex:hover {
    background:var(--blue); color:#fff; border-color:var(--blue);
    box-shadow:0 4px 14px rgba(27,94,174,.30);
}
.cstat-link-ex:hover .cstat-link-count { background:rgba(255,255,255,.22); color:#fff; }

/* Disabled (zero count) */
.cstat-link-disabled {
    flex:1; display:flex; align-items:center; justify-content:center; gap:7px;
    padding:10px 12px; border:1.5px solid var(--border); border-radius:var(--r-md);
    font-family:'Cairo',sans-serif; font-size:13px; font-weight:800;
    background:var(--surface-2); color:var(--ink-5); white-space:nowrap; cursor:default;
    opacity:.5;
}
.cstat-link-disabled i { font-size:13px; }
.cstat-link-disabled-count {
    display:inline-flex; align-items:center; justify-content:center;
    min-width:20px; height:20px; padding:0 5px; border-radius:20px;
    font-size:11px; font-weight:900; background:var(--surface-3); color:var(--ink-4);
}
</style>

<div class="cstats-section">

    <div class="cstats-header">
        <div class="cstats-header-left">
            <div class="cstats-header-icon"><i class="fa-solid fa-books"></i></div>
            <div class="cstats-header-text">
                <h3>النماذج حسب المناهج</h3>
                <p>اضغط على نوع النموذج لاستعراض قائمته الكاملة</p>
            </div>
        </div>
        <div class="cstats-header-right">
            <span class="cstats-pill"><i class="fa-solid fa-layer-group"></i> @stats.Count منهج</span>
            <span class="cstats-pill cstats-pill--amber"><i class="fa fa-tasks"></i> @totalHw واجبات</span>
            <span class="cstats-pill cstats-pill--blue"><i class="fa fa-file-alt"></i> @totalEx اختبارات</span>
        </div>
    </div>

    <div class="cstats-grid">
    @foreach (var s in stats)
    {
        var accent = accents[ai % accents.Length]; ai++;
        <div class="cstat-card" data-accent="@accent">
            <div class="cstat-accent-bar"></div>
            <div class="cstat-card-head">
                <div class="cstat-icon"><i class="fa-solid fa-book-open"></i></div>
                <div class="cstat-info">
                    <span class="cstat-name" title="@s.CurriculumTitle">@s.CurriculumTitle</span>
                    <span class="cstat-total">
                        <i class="fa-solid fa-layer-group" style="font-size:10px"></i>
                        @s.TotalCount نموذج
                    </span>
                </div>
            </div>
            <div class="cstat-divider"></div>
            <div class="cstat-card-actions">

                @if (s.HomeworkCount > 0)
                {
                    <a asp-action="Index"
                       asp-route-curriculumId="@s.CurriculumId"
                       asp-route-modelType="@((int)ProfessionalModelType.Homework)"
                       class="cstat-link cstat-link-hw"
                       title="عرض نماذج الواجبات لـ @s.CurriculumTitle">
                        <i class="fa fa-tasks"></i>
                        <span>واجبات</span>
                        <span class="cstat-link-count">@s.HomeworkCount</span>
                        <i class="fa fa-arrow-left cstat-link-arrow"></i>
                    </a>
                }
                else
                {
                    <span class="cstat-link-disabled">
                        <i class="fa fa-tasks"></i>
                        <span>واجبات</span>
                        <span class="cstat-link-disabled-count">0</span>
                    </span>
                }

                @if (s.ExamCount > 0)
                {
                    <a asp-action="Index"
                       asp-route-curriculumId="@s.CurriculumId"
                       asp-route-modelType="@((int)ProfessionalModelType.Exam)"
                       class="cstat-link cstat-link-ex"
                       title="عرض نماذج الاختبارات لـ @s.CurriculumTitle">
                        <i class="fa fa-file-alt"></i>
                        <span>اختبارات</span>
                        <span class="cstat-link-count">@s.ExamCount</span>
                        <i class="fa fa-arrow-left cstat-link-arrow"></i>
                    </a>
                }
                else
                {
                    <span class="cstat-link-disabled">
                        <i class="fa fa-file-alt"></i>
                        <span>اختبارات</span>
                        <span class="cstat-link-disabled-count">0</span>
                    </span>
                }

            </div>
        </div>
    }
    </div>

</div>
