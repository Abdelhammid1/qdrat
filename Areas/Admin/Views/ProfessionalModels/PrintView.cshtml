@model QdratNew.Entities.ProfessionalModel
@using System.Text.RegularExpressions
@using QdratNew.Helpers
@using QdratNew.Enums

@{
    Layout = null;
    var totalQuestions = Model.Questions?.Count ?? 0;
    var modelTypeLabel = Model.ModelType == ProfessionalModelType.Exam ? "اختبار" : "نموذج";

    Func<string?, bool, string?> htmlConvert = (s, isQuantitative) =>
    {
        if (string.IsNullOrWhiteSpace(s)) return s;
        if (!isQuantitative) return s;
        try
        {
            if (s.Contains("style=", StringComparison.OrdinalIgnoreCase))
                return NumberHelper.ToIndicNumbersInsideHtml(s);
            return HtmlNumberHelper.ConvertHtmlPreservingTags(s, true);
        }
        catch { return s; }
    };
}
<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@modelTypeLabel - @Model.Title</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />

    <style>
        :root {
            --brand:        #1a3a6b;
            --accent:       #0d6efd;
            --green:        #16a34a;
            --green-bg:     #f0fdf4;
            --green-bd:     #86efac;
            --gold:         #d4a017;
            --txt:          #0f172a;
            --txt2:         #475569;
            --muted:        #94a3b8;
            --bd:           #e2e8f0;
            --bd2:          #cbd5e1;
            --surf:         #f8fafc;
            --white:        #ffffff;
            --r:            8px;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        @@font-face {
            font-family: 'ZA-Roots';
            src: url('/fonts/ZA-roots.woff2') format('woff2'),
                 url('/fonts/ZA-roots.woff') format('woff'),
                 url('/fonts/ZA-roots.TTF') format('truetype');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }
        @@font-face {
            font-family: 'ZA-roots';
            src: url('/fonts/ZA-roots.woff2') format('woff2'),
                 url('/fonts/ZA-roots.woff') format('woff'),
                 url('/fonts/ZA-roots.TTF') format('truetype');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }

        body {
            font-family: 'Cairo', sans-serif;
            font-size: 13px;
            background: var(--surf);
            color: var(--txt);
            direction: rtl;
            line-height: 1.6;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        /* ── WRAPPER ── */
        .wrap { max-width: 820px; margin: 0 auto; padding: 16px 12px 40px; }

        /* ── PRINT BAR ── */
        .print-bar {
            display: flex; align-items: center; justify-content: space-between;
            background: var(--white); border: 1px solid var(--bd);
            border-radius: var(--r); padding: 10px 16px; margin-bottom: 16px;
            box-shadow: 0 1px 4px rgba(0,0,0,.06);
        }
        .print-bar-info { display: flex; align-items: center; gap: 8px; color: var(--txt2); font-weight: 600; }
        .code-pill { background: var(--brand); color: #fff; padding: 3px 10px; border-radius: 99px; font-size: 12px; font-weight: 700; }
        .count-pill { background: var(--surf); border: 1px solid var(--bd); padding: 3px 10px; border-radius: 99px; font-size: 12px; }
        .btn-print {
            display: inline-flex; align-items: center; gap: 6px;
            background: var(--accent); color: #fff; border: none;
            border-radius: var(--r); padding: 8px 18px;
            font-family: 'Cairo', sans-serif; font-size: 13px; font-weight: 700;
            cursor: pointer; box-shadow: 0 2px 6px rgba(13,110,253,.3);
            transition: background .15s, transform .1s;
        }
        .btn-print:hover { background: #0b5ed7; transform: translateY(-1px); }
        .btn-print svg { width: 15px; height: 15px; }

        /* ── COVER ── */
        .cover {
            background: var(--white); border-radius: 12px;
            overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,.08);
            margin-bottom: 16px; page-break-after: always;
        }
        .cover-stripe { height: 6px; background: var(--brand); }
        .cover-body { padding: 28px 36px 32px; }

        .cover-head {
            display: flex; align-items: center; justify-content: space-between;
            padding-bottom: 18px; border-bottom: 1px solid var(--bd); margin-bottom: 24px;
        }
        .cover-head img { height: 56px; object-fit: contain; }
        .cover-org { text-align: left; font-size: 12px; color: var(--muted); }
        .cover-org strong { display: block; font-size: 13px; color: var(--txt2); font-weight: 700; }

        .cover-hero { text-align: center; padding: 8px 0 20px; }
        .cover-badge {
            display: inline-flex; align-items: center; gap: 5px;
            background: rgba(26,58,107,.07); color: var(--brand);
            border: 1px solid rgba(26,58,107,.15); border-radius: 99px;
            padding: 4px 14px; font-size: 12px; font-weight: 700; margin-bottom: 12px;
        }
        .cover-title { font-size: 32px; font-weight: 800; color: var(--brand); line-height: 1.2; margin-bottom: 6px; }
        .cover-desc { font-size: 14px; color: var(--txt2); max-width: 460px; margin: 0 auto 20px; }

        .cover-stats { display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; }
        .cstat {
            background: var(--surf); border: 1px solid var(--bd);
            border-radius: var(--r); padding: 12px 22px; text-align: center; min-width: 110px;
        }
        .cstat-val { font-size: 24px; font-weight: 800; color: var(--brand); line-height: 1; margin-bottom: 2px; }
        .cstat-lbl { font-size: 11px; color: var(--muted); font-weight: 600; }

        .cover-foot {
            display: flex; align-items: center; justify-content: space-between;
            padding-top: 18px; border-top: 1px solid var(--bd); margin-top: 20px;
            font-size: 12px; color: var(--muted);
        }
        .cover-foot-field { display: flex; align-items: center; gap: 5px; }
        .field-line { display: inline-block; width: 100px; border-bottom: 1px solid var(--bd2); height: 16px; }

        /* ── QUESTION PAGE ── */
        .qpage {
            background: var(--white); border-radius: 12px;
            overflow: hidden; box-shadow: 0 2px 10px rgba(0,0,0,.06);
            margin-bottom: 16px; page-break-after: always;
        }
        .qpage:last-child { page-break-after: avoid; margin-bottom: 0; }

        .qpage-stripe { height: 4px; background: linear-gradient(90deg, var(--brand) 0%, var(--accent) 100%); }
        .qpage-inner { padding: 14px 20px 18px; }

        /* Header row */
        .qhead {
            display: flex; align-items: center; justify-content: space-between;
            padding-bottom: 10px; border-bottom: 1px solid var(--bd); margin-bottom: 12px;
        }
        .qhead img { height: 36px; object-fit: contain; opacity: .8; }
        .breadcrumb { display: flex; align-items: center; gap: 5px; font-size: 11.5px; color: var(--muted); font-weight: 500; }
        .bc-sep { color: var(--bd2); }
        .bc-section { color: var(--txt2); font-weight: 600; }
        .bc-lesson { color: var(--accent); font-weight: 700; }

        /* Q number row */
        .qnum-row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
        .qnum {
            width: 30px; height: 30px; border-radius: 50%;
            background: var(--brand); color: #fff;
            display: flex; align-items: center; justify-content: center;
            font-size: 13px; font-weight: 800; flex-shrink: 0;
            box-shadow: 0 2px 6px rgba(26,58,107,.25);
        }

        /* Question title */
        .qtitle {
            border-right: 3px solid var(--brand);
            background: rgba(26,58,107,.03);
            border-radius: 0 var(--r) var(--r) 0;
            padding: 10px 14px;
            margin-bottom: 12px;
            font-size: 14px; font-weight: 700; line-height: 1.7;
            color: var(--txt);
        }
        [dir="ltr"] .qtitle { border-right: none; border-left: 3px solid var(--brand); border-radius: var(--r) 0 0 var(--r); }

        .question-content { unicode-bidi: isolate; }
        .question-content svg { direction: ltr !important; }

        /* Verbal passage */
        .vpassage-wrap { margin-bottom: 10px; }
        .vpassage-lbl { display: flex; align-items: center; gap: 6px; font-size: 11.5px; font-weight: 700; color: var(--txt2); margin-bottom: 5px; }
        .vp-dot { width: 7px; height: 7px; background: var(--gold); border-radius: 50%; flex-shrink: 0; }
        .vpassage-box {
            background: #fffbeb; border: 1px solid #fde68a;
            border-radius: var(--r); padding: 10px 14px;
            font-size: 13px; line-height: 1.9;
        }

        /* Q image */
        .qimg-wrap { text-align: center; margin-bottom: 10px; }
        .qimg-wrap img { max-height: 180px; max-width: 100%; border-radius: var(--r); border: 1px solid var(--bd); }

        /* Comparison table */
        .cmp-wrap { margin-bottom: 10px; }
        .cmp-table {
            width: auto; min-width: 280px; margin: 0 auto;
            border-collapse: separate; border-spacing: 0;
            border-radius: var(--r); overflow: hidden;
            border: 1px solid var(--bd);
        }
        .cmp-table thead th { background: var(--brand); color: #fff; font-size: 12px; font-weight: 700; padding: 7px 16px; text-align: center; }
        .cmp-table tbody td { padding: 8px 16px; text-align: center; font-size: 13px; border-top: 1px solid var(--bd); }

        /* Options */
        .opts-lbl { font-size: 11px; font-weight: 700; color: var(--muted); letter-spacing: .3px; margin-bottom: 8px; }
        .opts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px; }
        .opts-grid.single-col { grid-template-columns: 1fr; }

        .opt {
            position: relative;
            border: 1px solid var(--bd); border-radius: var(--r);
            background: var(--white);
            padding: 8px 12px;
            display: flex; align-items: center; gap: 10px;
            min-height: 44px;
        }
        .opt.correct { border-color: var(--green-bd); background: var(--green-bg); }

        .opt-letter {
            flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%;
            background: var(--surf); border: 1px solid var(--bd2);
            display: flex; align-items: center; justify-content: center;
            font-size: 12px; font-weight: 800; color: var(--txt2);
        }
        .opt.correct .opt-letter { background: var(--green); border-color: var(--green); color: #fff; }

        .opt-txt { flex: 1; font-size: 13px; line-height: 1.6; color: var(--txt); }
        .opt.correct .opt-txt { font-weight: 700; color: #14532d; }

        .opt-img { display: block; max-height: 64px; max-width: 100%; border-radius: 5px; margin: 0 auto; object-fit: contain; }

        .correct-tag {
            position: absolute; top: -1px; left: -1px; right: auto;
            background: var(--green); color: #fff;
            font-size: 10px; font-weight: 800;
            padding: 2px 8px; border-radius: 0 0 5px 0;
            display: flex; align-items: center; gap: 3px;
        }

        /* Answer space */
        .ans-space {
            border: 1px dashed var(--bd2); border-radius: var(--r);
            padding: 10px 14px; min-height: 64px; position: relative; margin-top: 4px;
        }
        .ans-lbl {
            position: absolute; top: -9px;
            background: var(--white); padding: 0 6px;
            font-size: 10.5px; font-weight: 700; color: var(--muted);
        }
        [dir="rtl"] .ans-lbl { right: 12px; }
        [dir="ltr"] .ans-lbl { left: 12px; }
        .ans-lines { display: flex; flex-direction: column; gap: 16px; padding-top: 6px; }
        .ans-line { border-bottom: 1px solid var(--bd); }

        /* Page footer */
        .qfoot {
            display: flex; align-items: center; justify-content: space-between;
            margin-top: 12px; padding-top: 8px; border-top: 1px solid var(--bd);
            font-size: 11px; color: var(--muted);
        }
        .qfoot-ref { display: flex; align-items: center; gap: 4px; font-weight: 600; }
        .qfoot-ref span {
            background: var(--surf); border: 1px solid var(--bd);
            border-radius: 4px; padding: 1px 6px; font-size: 10.5px; font-weight: 800; color: var(--brand);
        }
        .qfoot-num { font-weight: 800; color: var(--txt2); }

        /* ── PRINT ── */
        @@media print {
            html, body { background: #fff !important; }
            .print-bar { display: none !important; }
            .wrap { max-width: 100%; padding: 0; }
            .cover, .qpage { border-radius: 0; box-shadow: none; margin-bottom: 0; break-after: page; }
            .qpage:last-child { break-after: avoid; }
            .qpage-stripe, .qnum, .correct-tag, .opt.correct,
            .qtitle, .cover-stripe, .cmp-table thead th {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body>
<div class="wrap">

    <!-- PRINT BAR -->
    <div class="print-bar">
        <div class="print-bar-info">
            <span class="code-pill">@Model.Title</span>
            <span class="count-pill">@totalQuestions سؤال</span>
            <span style="color:var(--muted)">—</span>
            <span>@Model.Description</span>
        </div>
        <button class="btn-print" onclick="window.print()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                <rect x="6" y="14" width="12" height="8"></rect>
            </svg>
            طباعة / PDF
        </button>
    </div>

    <!-- COVER -->
    <div class="cover">
        <div class="cover-stripe"></div>
        <div class="cover-body">

            <div class="cover-head">
                <img src="/images/160×100.png" alt="قدرات" />
                <div class="cover-org">
                    <strong>منصة قدرات نيو</strong>
                    نظام إدارة التعلم
                </div>
            </div>

            <div class="cover-hero">
                <div class="cover-badge">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                    </svg>
                    @modelTypeLabel احترافي
                </div>
                <div class="cover-title">@Model.Title</div>
                <div class="cover-desc">@Model.Description</div>
                <div class="cover-stats">
                    <div class="cstat">
                        <div class="cstat-val">@totalQuestions</div>
                        <div class="cstat-lbl">عدد الأسئلة</div>
                    </div>
                    <div class="cstat">
                        <div class="cstat-val">@Model.CreatedAt.ToString("yyyy")</div>
                        <div class="cstat-lbl">سنة الإنشاء</div>
                    </div>
                    <div class="cstat">
                        <div class="cstat-val">@modelTypeLabel</div>
                        <div class="cstat-lbl">نوع النموذج</div>
                    </div>
                </div>
            </div>

            <div class="cover-foot">
                <div class="cover-foot-field">الاسم: <span class="field-line"></span></div>
                <div class="cover-foot-field">التاريخ: <span class="field-line"></span></div>
                <div class="cover-foot-field">الدرجة: <span class="field-line"></span></div>
            </div>

        </div>
    </div>

    <!-- QUESTIONS -->
    @{
        var letters   = new[] { "أ", "ب", "ج", "د", "هـ", "و" };
        var lettersEn = new[] { "A", "B", "C", "D", "E", "F" };
        int qi = 0;
    }

    @foreach (var mq in Model.Questions.OrderBy(q => q.OrderNumber))
    {
        var q      = mq.Question;
        var isRTL  = q?.Lesson?.Section?.Curriculum?.IsRTL ?? true;
        var dir    = isRTL ? "rtl" : "ltr";
        qi++;

        var hasImgOpts = q.Options.Any(x => !string.IsNullOrWhiteSpace(x.ImageUrl));
        var optLetters = isRTL ? letters : lettersEn;

        <div class="qpage" dir="@dir">
            <div class="qpage-stripe"></div>
            <div class="qpage-inner">

                <!-- Header -->
                <div class="qhead">
                    <div class="breadcrumb">
                        <span class="bc-section">@q.Lesson?.Section?.Title</span>
                        <span class="bc-sep">›</span>
                        <span class="bc-lesson">@q.Lesson?.Title</span>
                    </div>
                    <img src="/images/160×100.png" alt="قدرات" />
                </div>

                <!-- Q Number -->
                <div class="qnum-row">
                    <div class="qnum">@qi</div>
                </div>

                <!-- Q Title -->
                <div class="qtitle question-content">@Html.Raw(htmlConvert(q.Title, q.IsQuantitative))</div>

                <!-- Verbal Passage -->
                @if (q.VerbalPassage != null && !string.IsNullOrWhiteSpace(q.VerbalPassage.Content))
                {
                    <div class="vpassage-wrap">
                        <div class="vpassage-lbl"><span class="vp-dot"></span>@q.VerbalPassage.Title</div>
                        <div class="vpassage-box question-content">@Html.Raw(htmlConvert(q.VerbalPassage.Content, q.IsQuantitative))</div>
                    </div>
                }

                <!-- Q Image -->
                @if (!string.IsNullOrWhiteSpace(q.ImageUrl))
                {
                    <div class="qimg-wrap">
                        <img src="@Url.Content(q.ImageUrl)" alt="صورة السؤال" />
                    </div>
                }

                <!-- Comparison -->
                @if (q.Template == QdratNew.Enums.QuestionTemplate.CompareValues || q.Template == QdratNew.Enums.QuestionTemplate.CompareWithImage)
                {
                    <div class="cmp-wrap">
                        <table class="cmp-table">
                            <thead><tr><th>القيمة الأولى</th><th>القيمة الثانية</th></tr></thead>
                            <tbody>
                                <tr>
                                    <td class="question-content">@Html.Raw(htmlConvert(q.ValueA ?? "—", q.IsQuantitative))</td>
                                    <td class="question-content">@Html.Raw(htmlConvert(q.ValueB ?? "—", q.IsQuantitative))</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }

                <!-- Options -->
                @if (q.Options != null && q.Options.Any())
                {
                    <div class="opts-lbl">الاختيارات</div>
                    <div class="opts-grid @(hasImgOpts ? "single-col" : "")">
                        @{ int oi = 0; }
                        @foreach (var opt in q.Options)
                        {
                            var ca      = (q.CorrectAnswer ?? "").Trim();
                            var ot      = (opt.Text ?? "").Trim();
                            var hasImg  = !string.IsNullOrWhiteSpace(opt.ImageUrl);
                            var correct = !hasImgOpts && !string.IsNullOrWhiteSpace(ca)
                                          && string.Equals(ot, ca, StringComparison.OrdinalIgnoreCase);
                            var ltr     = oi < optLetters.Length ? optLetters[oi] : (oi + 1).ToString();
                            oi++;

                            <div class="opt @(correct ? "correct" : "")">
                                @if (correct)
                                {
                                    <div class="correct-tag">
                                        <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                        صحيح
                                    </div>
                                }
                                <div class="opt-letter">@ltr</div>
                                <div class="opt-txt question-content">
                                    @if (hasImg)
                                    {
                                        <img class="opt-img" src="@Url.Content(opt.ImageUrl)" alt="خيار" />
                                    }
                                    else
                                    {
                                        @Html.Raw(htmlConvert(opt.Text, q.IsQuantitative))
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- Answer space -->
                <div class="ans-space">
                    <span class="ans-lbl">✏ مساحة الإجابة</span>
                    <div class="ans-lines">
                        <div class="ans-line"></div>
                        <div class="ans-line"></div>
                    </div>
                </div>

                <!-- Footer -->
                <div class="qfoot">
                    <div class="qfoot-ref">النموذج <span>@Model.Title</span></div>
                    <div class="qfoot-num">@qi / @totalQuestions</div>
                </div>

            </div>
        </div>
    }

</div>
</body>
</html>
