@model QdratNew.ViewModels.ProfessionalModel.IPartnerAudienceFields
@using QdratNew.Enums
@{
    var selected = Model.SelectedPartnerIds.ToHashSet();
    var selectedCount = Model.PartnerOptions.Count(p => selected.Contains(p.Id));
}

<link rel="stylesheet" href="~/css/admin-professional-model-partners.css" asp-append-version="true" />

<section class="ppm-audience" data-ppm-audience>
    <h6 class="ppm-audience-title">
        <i class="fa fa-handshake"></i>
        الإتاحة للشركاء
    </h6>

    <div class="form-check form-switch ppm-audience-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="IsForPartners" name="IsForPartners" value="true" checked="@Model.IsForPartners" data-ppm-for-partners />
        @* يأتي بعد الـ Checkbox: الـ Binder يأخذ أول قيمة *@
        <input type="hidden" name="IsForPartners" value="false" />
        <label class="form-check-label" for="IsForPartners">موجّه للشركاء</label>
    </div>
    <p class="ppm-audience-help">عند الإيقاف يبقى النموذج داخليًا ولا يظهر لأي شريك، وتبقى اختياراتك محفوظة لإعادة التفعيل.</p>

    <div data-ppm-audience-body>
        <div class="ppm-audience-radios">
            <div class="form-check">
                <input class="form-check-input" type="radio" id="PartnerAudienceAll" name="PartnerAudience" value="@((int)PartnerAudience.All)" checked="@(Model.PartnerAudience != PartnerAudience.Selected)" data-ppm-audience-radio />
                <label class="form-check-label" for="PartnerAudienceAll">لكل الشركاء</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" id="PartnerAudienceSelected" name="PartnerAudience" value="@((int)PartnerAudience.Selected)" checked="@(Model.PartnerAudience == PartnerAudience.Selected)" data-ppm-audience-radio />
                <label class="form-check-label" for="PartnerAudienceSelected">شركاء محددون</label>
            </div>
        </div>

        <div data-ppm-partners-panel>
            @Html.ValidationMessage(nameof(Model.SelectedPartnerIds), new { @class = "text-danger small d-block mb-2" })

            @if (Model.PartnerOptions.Count == 0)
            {
                <div class="ppm-partners-empty">
                    <i class="fa fa-circle-info"></i>
                    لا يوجد شركاء نشطون في النظام حاليًا.
                </div>
            }
            else
            {
                <div class="ppm-partners-tools" data-ppm-tools hidden>
                    <input type="search" class="form-control form-control-sm" placeholder="ابحث بالاسم أو الكود..." aria-label="بحث في الشركاء" data-ppm-search />
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-ppm-select-all>تحديد الكل</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-ppm-clear-all>إلغاء</button>
                    <span class="ppm-partners-count">تم اختيار <b data-ppm-count>@selectedCount</b></span>
                </div>

                <div class="ppm-partners-list">
                    @foreach (var partner in Model.PartnerOptions)
                    {
                        <label class="ppm-partner @(partner.IsActive ? "" : "ppm-partner-ended")" data-ppm-partner data-ppm-search-text="@partner.Name @partner.Code">
                            <input class="form-check-input" type="checkbox" name="SelectedPartnerIds" value="@partner.Id" checked="@selected.Contains(partner.Id)" />
                            <span class="ppm-partner-name">@partner.Name</span>
                            <span class="ppm-partner-code">@partner.Code</span>
                            @if (!partner.IsActive)
                            {
                                <span class="ppm-partner-ended-tag">منتهي</span>
                            }
                        </label>
                    }
                </div>

                <div class="ppm-partners-empty" data-ppm-no-results hidden>لا توجد نتائج مطابقة للبحث.</div>
            }
        </div>
    </div>
</section>
