@model QdratNew.Entities.ProfessionalModel
@using QdratNew.Helpers
@using QdratNew.Enums

@{
    Layout = null;
    var totalQuestions = Model.Questions?.Count ?? 0;
    var modelTypeLabel = Model.ModelType == ProfessionalModelType.Exam ? "اختبار" : "نموذج";

    Func<string, bool, string> T = (key, isRTL) =>
    {
        if (isRTL) return key;
        return key switch
        {
            "طباعة / PDF"       => "Print / PDF",
            "القيمة الأولى"     => "Value A",
            "القيمة الثانية"    => "Value B",
            "لا توجد خيارات."  => "No options available",
            "الإجابة الصحيحة"  => "Correct Answer",
            "السؤال"            => "Question",
            "الاختيارات"        => "Options",
            _                   => key
        };
    };

    Func<string?, bool, string?> htmlConvert = (s, isQuantitative) =>
    {
        if (string.IsNullOrWhiteSpace(s)) return s;
        if (!isQuantitative) return s;
        try
        {
            if (s.Contains("style=", StringComparison.OrdinalIgnoreCase))
                return NumberHelper.ToIndicNumbersInsideHtml(s);
            return HtmlNumberHelper.ConvertHtmlPreservingTags(s, true);
        }
        catch { return s; }
    };
}
<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@modelTypeLabel متواصل - @Model.Title</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />

    <style>
        :root {
            --brand:      #1a3a6b;
            --accent:     #0d6efd;
            --green:      #16a34a;
            --green-bg:   #f0fdf4;
            --green-bd:   #86efac;
            --gold:       #d4a017;
            --txt:        #0f172a;
            --txt2:       #475569;
            --muted:      #94a3b8;
            --bd:         #e2e8f0;
            --bd2:        #cbd5e1;
            --surf:       #f8fafc;
            --white:      #ffffff;
            --r:          8px;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        @@font-face {
            font-family: 'ZA-Roots';
            src: url('/fonts/ZA-roots.woff2') format('woff2'),
                 url('/fonts/ZA-roots.woff') format('woff'),
                 url('/fonts/ZA-roots.TTF') format('truetype');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }
        @@font-face {
            font-family: 'ZA-roots';
            src: url('/fonts/ZA-roots.woff2') format('woff2'),
                 url('/fonts/ZA-roots.woff') format('woff'),
                 url('/fonts/ZA-roots.TTF') format('truetype');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }

        body {
            font-family: 'Cairo', sans-serif;
            font-size: 13px;
            background: var(--surf);
            color: var(--txt);
            direction: rtl;
            line-height: 1.6;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        /* ── WRAPPER ── */
        .wrap { max-width: 820px; margin: 0 auto; padding: 16px 12px 40px; }

        /* ── PRINT BAR ── */
        .print-bar {
            display: flex; align-items: center; justify-content: space-between;
            background: var(--white); border: 1px solid var(--bd);
            border-radius: var(--r); padding: 10px 16px; margin-bottom: 16px;
            box-shadow: 0 1px 4px rgba(0,0,0,.06);
        }
        .print-bar-info { display: flex; align-items: center; gap: 8px; color: var(--txt2); font-weight: 600; }
        .code-pill  { background: var(--brand); color: #fff; padding: 3px 10px; border-radius: 99px; font-size: 12px; font-weight: 700; }
        .count-pill { background: var(--surf); border: 1px solid var(--bd); padding: 3px 10px; border-radius: 99px; font-size: 12px; }
        .mode-pill  { background: #fff7ed; border: 1px solid #fed7aa; color: #c2410c; padding: 3px 10px; border-radius: 99px; font-size: 11px; font-weight: 700; }

        .btn-print {
            display: inline-flex; align-items: center; gap: 6px;
            background: var(--accent); color: #fff; border: none;
            border-radius: var(--r); padding: 8px 18px;
            font-family: 'Cairo', sans-serif; font-size: 13px; font-weight: 700;
            cursor: pointer; box-shadow: 0 2px 6px rgba(13,110,253,.3);
            transition: background .15s, transform .1s;
        }
        .btn-print:hover { background: #0b5ed7; transform: translateY(-1px); }
        .btn-print svg { width: 15px; height: 15px; }

        /* ── COVER ── */
        .cover {
            background: var(--white); border-radius: 12px;
            overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,.08);
            margin-bottom: 20px;
        }
        .cover-stripe { height: 6px; background: var(--brand); }
        .cover-body { padding: 24px 32px 28px; }

        .cover-head {
            display: flex; align-items: center; justify-content: space-between;
            padding-bottom: 16px; border-bottom: 1px solid var(--bd); margin-bottom: 20px;
        }
        .cover-head img { height: 52px; object-fit: contain; }
        .cover-org { text-align: left; font-size: 12px; color: var(--muted); }
        .cover-org strong { display: block; font-size: 13px; color: var(--txt2); font-weight: 700; }

        .cover-hero { text-align: center; padding: 4px 0 16px; }
        .cover-badge {
            display: inline-flex; align-items: center; gap: 5px;
            background: rgba(26,58,107,.07); color: var(--brand);
            border: 1px solid rgba(26,58,107,.15); border-radius: 99px;
            padding: 4px 14px; font-size: 12px; font-weight: 700; margin-bottom: 10px;
        }
        .cover-mode-badge {
            display: inline-flex; align-items: center; gap: 5px;
            background: #fff7ed; color: #c2410c;
            border: 1px solid #fed7aa; border-radius: 99px;
            padding: 4px 14px; font-size: 11px; font-weight: 700;
            margin-right: 6px; margin-bottom: 10px;
        }
        .cover-title { font-size: 28px; font-weight: 800; color: var(--brand); line-height: 1.2; margin-bottom: 6px; }
        .cover-desc  { font-size: 13px; color: var(--txt2); max-width: 440px; margin: 0 auto 16px; }

        .cover-stats { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; }
        .cstat { background: var(--surf); border: 1px solid var(--bd); border-radius: var(--r); padding: 10px 20px; text-align: center; min-width: 100px; }
        .cstat-val { font-size: 22px; font-weight: 800; color: var(--brand); line-height: 1; margin-bottom: 2px; }
        .cstat-lbl { font-size: 11px; color: var(--muted); font-weight: 600; }

        .cover-foot {
            display: flex; align-items: center; justify-content: space-between;
            padding-top: 16px; border-top: 1px solid var(--bd); margin-top: 16px;
            font-size: 12px; color: var(--muted);
        }
        .cover-foot-field { display: flex; align-items: center; gap: 5px; }
        .field-line { display: inline-block; width: 100px; border-bottom: 1px solid var(--bd2); height: 16px; }

        /* ── QUESTION BLOCK (continuous — no page break after) ── */
        .qblock {
            background: var(--white);
            border: 1px solid var(--bd);
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 12px;
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .qblock-stripe { height: 3px; background: linear-gradient(90deg, var(--brand) 0%, var(--accent) 100%); }
        .qblock-inner  { padding: 12px 18px 16px; }

        /* Block header */
        .bhead {
            display: flex; align-items: center; justify-content: space-between;
            padding-bottom: 8px; border-bottom: 1px solid var(--bd); margin-bottom: 10px;
        }
        .bhead img { height: 30px; object-fit: contain; opacity: .75; }

        .breadcrumb { display: flex; align-items: center; gap: 4px; font-size: 11px; color: var(--muted); font-weight: 500; }
        .bc-sep     { color: var(--bd2); }
        .bc-section { color: var(--txt2); font-weight: 600; }
        .bc-lesson  { color: var(--accent); font-weight: 700; }

        /* Q number + title row */
        .qtitle-row { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 10px; }

        .qnum {
            width: 26px; height: 26px; border-radius: 50%; flex-shrink: 0; margin-top: 2px;
            background: var(--brand); color: #fff;
            display: flex; align-items: center; justify-content: center;
            font-size: 12px; font-weight: 800;
            box-shadow: 0 2px 5px rgba(26,58,107,.25);
        }

        .qtitle {
            flex: 1;
            border-right: 3px solid var(--brand);
            background: rgba(26,58,107,.03);
            border-radius: 0 var(--r) var(--r) 0;
            padding: 8px 12px;
            font-size: 13.5px; font-weight: 700; line-height: 1.7; color: var(--txt);
        }
        [dir="ltr"] .qtitle { border-right: none; border-left: 3px solid var(--brand); border-radius: var(--r) 0 0 var(--r); }

        .question-content { unicode-bidi: isolate; }
        .question-content svg { direction: ltr !important; }

        /* Verbal passage */
        .vpassage-wrap { margin-bottom: 8px; }
        .vpassage-lbl  { display: flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 700; color: var(--txt2); margin-bottom: 4px; }
        .vp-dot        { width: 6px; height: 6px; background: var(--gold); border-radius: 50%; flex-shrink: 0; }
        .vpassage-box  { background: #fffbeb; border: 1px solid #fde68a; border-radius: var(--r); padding: 8px 12px; font-size: 12.5px; line-height: 1.85; }

        /* Q image */
        .qimg-wrap { text-align: center; margin-bottom: 8px; }
        .qimg-wrap img { max-height: 160px; max-width: 100%; border-radius: var(--r); border: 1px solid var(--bd); }

        /* Comparison table */
        .cmp-wrap  { margin-bottom: 8px; }
        .cmp-table { width: auto; min-width: 260px; margin: 0 auto; border-collapse: separate; border-spacing: 0; border-radius: var(--r); overflow: hidden; border: 1px solid var(--bd); }
        .cmp-table thead th { background: var(--brand); color: #fff; font-size: 11.5px; font-weight: 700; padding: 6px 14px; text-align: center; }
        .cmp-table tbody td { padding: 7px 14px; text-align: center; font-size: 12.5px; border-top: 1px solid var(--bd); }

        /* Options */
        .opts-lbl  { font-size: 11px; font-weight: 700; color: var(--muted); letter-spacing: .3px; margin-bottom: 6px; }
        .opts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; }
        .opts-grid.single-col { grid-template-columns: 1fr; }

        .opt {
            position: relative;
            border: 1px solid var(--bd); border-radius: var(--r);
            background: var(--white); padding: 7px 10px;
            display: flex; align-items: center; gap: 8px; min-height: 40px;
        }
        .opt.correct { border-color: var(--green-bd); background: var(--green-bg); }

        .opt-letter {
            flex-shrink: 0; width: 24px; height: 24px; border-radius: 50%;
            background: var(--surf); border: 1px solid var(--bd2);
            display: flex; align-items: center; justify-content: center;
            font-size: 11px; font-weight: 800; color: var(--txt2);
        }
        .opt.correct .opt-letter { background: var(--green); border-color: var(--green); color: #fff; }

        .opt-txt { flex: 1; font-size: 12.5px; line-height: 1.6; color: var(--txt); }
        .opt.correct .opt-txt { font-weight: 700; color: #14532d; }

        .opt-img { display: block; max-height: 56px; max-width: 100%; border-radius: 5px; margin: 0 auto; object-fit: contain; }

        .correct-tag {
            position: absolute; top: -1px; left: -1px; right: auto;
            background: var(--green); color: #fff;
            font-size: 9.5px; font-weight: 800; padding: 2px 7px;
            border-radius: 0 0 5px 0;
            display: flex; align-items: center; gap: 3px;
        }

        /* No options alert */
        .no-opts {
            background: var(--surf); border: 1px solid var(--bd);
            border-radius: var(--r); padding: 8px 14px;
            font-size: 12px; color: var(--muted); text-align: center;
        }

        /* Block footer */
        .bfoot {
            display: flex; align-items: center; justify-content: space-between;
            margin-top: 10px; padding-top: 7px; border-top: 1px solid var(--bd);
            font-size: 10.5px; color: var(--muted);
        }
        .bfoot-ref  { display: flex; align-items: center; gap: 4px; font-weight: 600; }
        .bfoot-ref span { background: var(--surf); border: 1px solid var(--bd); border-radius: 4px; padding: 1px 5px; font-size: 10px; font-weight: 800; color: var(--brand); }
        .bfoot-num  { font-weight: 800; color: var(--txt2); }

        /* ── PRINT ── */
        @@media print {
            @@page { size: A4; margin: 10mm; }

            html, body { background: #fff !important; font-size: 12px !important; }

            .print-bar { display: none !important; }

            .wrap { max-width: 100%; padding: 0; }

            .cover { border-radius: 0; box-shadow: none; margin-bottom: 12px; }

            .qblock {
                border-radius: 0; margin-bottom: 8px;
                break-inside: avoid; page-break-inside: avoid;
                box-shadow: none;
            }

            .qblock-stripe, .qnum, .correct-tag, .opt.correct,
            .qtitle, .cover-stripe, .cmp-table thead th {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .qimg-wrap img { max-height: 120px !important; }
            .opt-img        { max-height: 48px !important; }
        }
    </style>
</head>
<body>
<div class="wrap">

    <!-- PRINT BAR -->
    <div class="print-bar">
        <div class="print-bar-info">
            <span class="code-pill">@Model.Title</span>
            <span class="count-pill">@totalQuestions سؤال</span>
            <span class="mode-pill">طباعة متواصلة</span>
            <span style="color:var(--muted)">—</span>
            <span>@Model.Description</span>
        </div>
        <button class="btn-print" onclick="window.print()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                <rect x="6" y="14" width="12" height="8"></rect>
            </svg>
            طباعة / PDF
        </button>
    </div>

    <!-- COVER -->
    <div class="cover">
        <div class="cover-stripe"></div>
        <div class="cover-body">

            <div class="cover-head">
                <img src="/images/160×100.png" alt="قدرات" />
                <div class="cover-org">
                    <strong>منصة قدرات نيو</strong>
                    نظام إدارة التعلم
                </div>
            </div>

            <div class="cover-hero">
                <div class="cover-badge">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                    </svg>
                    @modelTypeLabel احترافي
                </div>
                <div class="cover-mode-badge">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="8" y1="6" x2="21" y2="6"></line>
                        <line x1="8" y1="12" x2="21" y2="12"></line>
                        <line x1="8" y1="18" x2="21" y2="18"></line>
                        <line x1="3" y1="6" x2="3.01" y2="6"></line>
                        <line x1="3" y1="12" x2="3.01" y2="12"></line>
                        <line x1="3" y1="18" x2="3.01" y2="18"></line>
                    </svg>
                    تدفق متواصل
                </div>
                <div class="cover-title">@Model.Title</div>
                <div class="cover-desc">@Model.Description</div>
                <div class="cover-stats">
                    <div class="cstat">
                        <div class="cstat-val">@totalQuestions</div>
                        <div class="cstat-lbl">عدد الأسئلة</div>
                    </div>
                    <div class="cstat">
                        <div class="cstat-val">@Model.CreatedAt.ToString("yyyy")</div>
                        <div class="cstat-lbl">سنة الإنشاء</div>
                    </div>
                    <div class="cstat">
                        <div class="cstat-val">@modelTypeLabel</div>
                        <div class="cstat-lbl">نوع النموذج</div>
                    </div>
                </div>
            </div>

            <div class="cover-foot">
                <div class="cover-foot-field">الاسم: <span class="field-line"></span></div>
                <div class="cover-foot-field">التاريخ: <span class="field-line"></span></div>
                <div class="cover-foot-field">الدرجة: <span class="field-line"></span></div>
            </div>

        </div>
    </div>

    <!-- QUESTIONS -->
    @{
        var letters   = new[] { "أ", "ب", "ج", "د", "هـ", "و" };
        var lettersEn = new[] { "A", "B", "C", "D", "E", "F" };
        int qi = 0;
    }

    @foreach (var mq in Model.Questions.OrderBy(q => q.OrderNumber))
    {
        var q          = mq.Question;
        var isRTL      = q?.Lesson?.Section?.Curriculum?.IsRTL ?? true;
        var dir        = isRTL ? "rtl" : "ltr";
        qi++;

        var hasImgOpts = q.Options != null && q.Options.Any(x => !string.IsNullOrWhiteSpace(x.ImageUrl));
        var optLetters = isRTL ? letters : lettersEn;

        <div class="qblock" dir="@dir">
            <div class="qblock-stripe"></div>
            <div class="qblock-inner">

                <!-- Block header -->
                <div class="bhead">
                    <div class="breadcrumb">
                        <span class="bc-section">@q.Lesson?.Section?.Title</span>
                        <span class="bc-sep">›</span>
                        <span class="bc-lesson">@q.Lesson?.Title</span>
                    </div>
                    <img src="/images/160×100.png" alt="قدرات" />
                </div>

                <!-- Q number + title -->
                <div class="qtitle-row">
                    <div class="qnum">@qi</div>
                    <div class="qtitle question-content">@Html.Raw(htmlConvert(q.Title, q.IsQuantitative))</div>
                </div>

                <!-- Verbal passage -->
                @if (q.VerbalPassage != null && !string.IsNullOrWhiteSpace(q.VerbalPassage.Content))
                {
                    <div class="vpassage-wrap">
                        <div class="vpassage-lbl"><span class="vp-dot"></span>@q.VerbalPassage.Title</div>
                        <div class="vpassage-box question-content">@Html.Raw(htmlConvert(q.VerbalPassage.Content, q.IsQuantitative))</div>
                    </div>
                }

                <!-- Q image -->
                @if (!string.IsNullOrWhiteSpace(q.ImageUrl))
                {
                    <div class="qimg-wrap">
                        <img src="@Url.Content(q.ImageUrl)" alt="صورة السؤال" />
                    </div>
                }

                <!-- Comparison -->
                @if (q.Template == QdratNew.Enums.QuestionTemplate.CompareValues || q.Template == QdratNew.Enums.QuestionTemplate.CompareWithImage)
                {
                    <div class="cmp-wrap">
                        <table class="cmp-table">
                            <thead>
                                <tr>
                                    <th>@T("القيمة الأولى", isRTL)</th>
                                    <th>@T("القيمة الثانية", isRTL)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="question-content">@Html.Raw(htmlConvert(q.ValueA ?? "—", q.IsQuantitative))</td>
                                    <td class="question-content">@Html.Raw(htmlConvert(q.ValueB ?? "—", q.IsQuantitative))</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }

                <!-- Options -->
                @if (q.Options != null && q.Options.Any())
                {
                    <div class="opts-lbl">@T("الاختيارات", isRTL)</div>
                    <div class="opts-grid @(hasImgOpts ? "single-col" : "")">
                        @{ int oi = 0; }
                        @foreach (var opt in q.Options)
                        {
                            var ca      = (q.CorrectAnswer ?? "").Trim();
                            var ot      = (opt.Text ?? "").Trim();
                            var hasImg  = !string.IsNullOrWhiteSpace(opt.ImageUrl);
                            var correct = !hasImgOpts && !string.IsNullOrWhiteSpace(ca)
                                          && string.Equals(ot, ca, StringComparison.OrdinalIgnoreCase);
                            var ltr     = oi < optLetters.Length ? optLetters[oi] : (oi + 1).ToString();
                            oi++;

                            <div class="opt @(correct ? "correct" : "")">
                                @if (correct)
                                {
                                    <div class="correct-tag">
                                        <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                        @T("الإجابة الصحيحة", isRTL)
                                    </div>
                                }
                                <div class="opt-letter">@ltr</div>
                                <div class="opt-txt question-content">
                                    @if (hasImg)
                                    {
                                        <img class="opt-img" src="@Url.Content(opt.ImageUrl)" alt="خيار" />
                                    }
                                    else
                                    {
                                        @Html.Raw(htmlConvert(opt.Text, q.IsQuantitative))
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="no-opts">@T("لا توجد خيارات.", isRTL)</div>
                }

                <!-- Block footer -->
                <div class="bfoot">
                    <div class="bfoot-ref">النموذج <span>@Model.Title</span></div>
                    <div class="bfoot-num">@qi / @totalQuestions</div>
                </div>

            </div>
        </div>
    }

</div>
</body>
</html>
