@model QdratNew.ViewModels.ProfessionalModel.ProfessionalModelAddQuestionsVm

@{
    ViewData["Title"] = "إضافة أسئلة للنموذج";
}

<div class="professional-model-add-page" dir="rtl">

    <section class="model-hero">
        <div class="hero-main">
            <div class="hero-icon">
                <i class="fas fa-plus-circle"></i>
            </div>

            <div>
                <div class="hero-eyebrow">إدارة النماذج الاحترافية</div>
                <h1>إضافة أسئلة للنموذج</h1>
                <p>
                    اختر الأسئلة المناسبة من بنك الأسئلة لإضافتها إلى النموذج:
                    <strong>@Model.ModelTitle</strong>
                </p>
            </div>
        </div>

        <div class="hero-actions">
            <a asp-area="Admin"
               asp-controller="ProfessionalModels"
               asp-action="Details"
               asp-route-id="@Model.ModelId"
               class="hero-btn muted">
                <i class="fas fa-arrow-right"></i>
                رجوع
            </a>

            <button type="submit"
                    form="addQuestionsForm"
                    class="hero-btn primary">
                <i class="fas fa-check-circle"></i>
                إضافة المحدد
            </button>
        </div>
    </section>

    <form id="addQuestionsForm" asp-action="AddQuestions" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="modelId" value="@Model.ModelId" />

        <section class="filter-card">
            <div class="filter-title">
                <i class="fas fa-sliders-h"></i>
                تصفية بنك الأسئلة
            </div>

            <div class="filter-grid">
                <div class="field search-field">
                    <label>
                        <i class="fas fa-search"></i>
                        بحث عام
                    </label>
                    <input id="generalQuestionSearch"
                           type="text"
                           class="form-control-custom"
                           placeholder="ابحث في السؤال، المنهج، المحور، المؤشر، القطعة أو الكود الداخلي..." />
                </div>

                <div class="field">
                    <label>
                        <i class="fas fa-book"></i>
                        المنهج
                    </label>
                    <select id="filterCurriculum" class="form-control-custom">
                        <option value="">كل المناهج</option>
                    </select>
                </div>

                <div class="field">
                    <label>
                        <i class="fas fa-layer-group"></i>
                        المحور
                    </label>
                    <select id="filterSection" class="form-control-custom">
                        <option value="">كل المحاور</option>
                    </select>
                </div>

                <div class="field">
                    <label>
                        <i class="fas fa-bookmark"></i>
                        المؤشر
                    </label>
                    <select id="filterLesson" class="form-control-custom">
                        <option value="">كل المؤشرات</option>
                    </select>
                </div>

                <div class="field action-field">
                    <button type="button" id="clearAllFilters" class="reset-btn">
                        <i class="fas fa-undo-alt"></i>
                        إعادة ضبط
                    </button>
                </div>
            </div>
        </section>

        <section class="model-table-card">
            <div class="table-head">
                <div>
                    <span>بنك الأسئلة</span>
                    <h2>الأسئلة المتاحة للإضافة</h2>
                </div>

                <div class="count-badge">
                    إجمالي المحدد:
                    <strong id="selectedQuestionsCount">0</strong>
                </div>
            </div>

            <div class="table-wrap">
                <table class="model-table" id="questionsTable">
                    <thead>
                        <tr>
                            <th style="width:55px;">
                                <input type="checkbox" id="selectAllPage" />
                            </th>
                            <th style="width:70px;">معاينة</th>
                            <th style="width:32%; text-align:right;">السؤال</th>
                            <th>المنهج</th>
                            <th>المحور</th>
                            <th>المؤشر</th>
                            <th>الكود الداخلي</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>

                    <tbody></tbody>
                </table>
            </div>

            <div id="noFilteredQuestions" class="empty-box d-none">
                <i class="fas fa-filter"></i>
                <strong>لا توجد نتائج مطابقة</strong>
                <span>غيّر البحث أو أعد ضبط الفلاتر.</span>
            </div>
        </section>

        <section class="bottom-actions">
            <div>
                <strong>إضافة الأسئلة المحددة للنموذج</strong>
                <span>
                    التحديد يُحفظ عند التنقل بين الصفحات. يمكنك اختيار أسئلة من صفحات متعددة ثم الإضافة دفعة واحدة.
                </span>
            </div>

            <div class="bottom-actions-buttons">
                <a asp-area="Admin"
                   asp-controller="ProfessionalModels"
                   asp-action="Details"
                   asp-route-id="@Model.ModelId"
                   class="bottom-btn muted">
                    رجوع
                </a>

                <button type="submit" id="submitAddQuestions" class="bottom-btn primary">
                    <i class="fas fa-check"></i>
                    إضافة الأسئلة المحددة (<span id="submitCount">0</span>)
                </button>
            </div>
        </section>
    </form>
</div>

<div class="modal fade" id="questionPreviewModal" tabindex="-1" dir="rtl">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content text-end border-0 rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">
                    <i class="fas fa-eye ms-2"></i>
                    معاينة السؤال
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body" id="questionPreviewModalBody">
                <div class="text-center text-muted p-4">
                    جاري التحميل...
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .professional-model-add-page {
        --font: 'Cairo', 'Tahoma', sans-serif;
        --ink: #0d1117;
        --ink-3: #374151;
        --mute: #6b7280;
        --mute-2: #9ca3af;
        --bg: #f4f6fb;
        --bg-2: #eef1f8;
        --surface: #ffffff;
        --border: #e5e8f0;
        --green: #059669;
        --green-lt: #d1fae5;
        --green-dk: #064e3b;
        --blue: #2563eb;
        --blue-lt: #dbeafe;
        --blue-dk: #1e3a8a;
        --amber: #d97706;
        --amber-lt: #fef3c7;
        --amber-dk: #78350f;
        --red: #dc2626;
        --red-lt: #fee2e2;
        --red-dk: #7f1d1d;
        --purple: #7c3aed;
        --purple-lt: #ede9fe;
        --purple-dk: #3b0764;
        --cyan: #0891b2;
        --cyan-lt: #cffafe;
        --radius: 14px;
        --radius-lg: 22px;
        --shadow: 0 2px 16px rgba(13, 17, 23, .07);
        --shadow-sm: 0 1px 6px rgba(13, 17, 23, .05);
        background: var(--bg);
        min-height: 100vh;
        padding: 24px;
        color: var(--ink);
        font-family: var(--font);
    }

        .professional-model-add-page *,
        .professional-model-add-page *::before,
        .professional-model-add-page *::after {
            box-sizing: border-box;
        }

        .professional-model-add-page a {
            text-decoration: none;
        }

    .model-hero {
        background: linear-gradient(135deg, #0d1117, #172554);
        color: #fff;
        border-radius: var(--radius-lg);
        padding: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        margin-bottom: 14px;
        box-shadow: var(--shadow);
    }

    .hero-main {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .hero-icon {
        width: 58px;
        height: 58px;
        border-radius: 18px;
        background: rgba(255, 255, 255, .10);
        border: 1px solid rgba(255, 255, 255, .12);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
    }

    .hero-eyebrow {
        color: #93c5fd;
        font-size: 12px;
        font-weight: 900;
        margin-bottom: 4px;
    }

    .model-hero h1 {
        margin: 0;
        font-size: 24px;
        font-weight: 900;
    }

    .model-hero p {
        margin: 6px 0 0;
        color: rgba(255, 255, 255, .70);
        font-size: 13px;
        line-height: 1.7;
        max-width: 760px;
    }

    .hero-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .hero-btn {
        border: 0;
        border-radius: 12px;
        padding: 10px 15px;
        font-size: 12.5px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
        transition: .15s;
        cursor: pointer;
    }

        .hero-btn.primary {
            background: var(--blue);
            color: #fff;
        }

        .hero-btn.muted {
            background: rgba(255,255,255,.10);
            color: #fff;
            border: 1px solid rgba(255,255,255,.16);
        }

        .hero-btn:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    .filter-card,
    .model-table-card,
    .bottom-actions {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
    }

    .filter-card {
        padding: 18px;
        margin-bottom: 14px;
    }

    .filter-title {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--ink);
        font-size: 14px;
        font-weight: 900;
        margin-bottom: 14px;
    }

        .filter-title i {
            color: var(--blue);
        }

    .filter-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr auto;
        gap: 12px;
        align-items: end;
    }

    .field label {
        display: flex;
        align-items: center;
        gap: 6px;
        color: var(--ink-3);
        font-size: 11.5px;
        font-weight: 900;
        margin-bottom: 6px;
    }

        .field label i {
            color: var(--blue);
        }

    .form-control-custom {
        width: 100%;
        min-height: 42px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #fff;
        padding: 9px 12px;
        color: var(--ink);
        font-size: 12.5px;
        font-family: var(--font);
        outline: none;
        transition: .15s;
    }

        .form-control-custom:focus {
            border-color: var(--blue);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .10);
        }

    .reset-btn {
        min-height: 42px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--bg-2);
        color: var(--ink-3);
        padding: 0 14px;
        font-family: var(--font);
        font-size: 12px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        cursor: pointer;
        white-space: nowrap;
    }

        .reset-btn:hover {
            background: var(--red-lt);
            color: var(--red-dk);
            border-color: rgba(220, 38, 38, .20);
        }

    .model-table-card {
        overflow: hidden;
    }

    .table-head {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        background: linear-gradient(180deg, #ffffff, #f8fafc);
    }

        .table-head span {
            display: block;
            color: var(--blue);
            font-size: 11px;
            font-weight: 900;
            margin-bottom: 3px;
        }

        .table-head h2 {
            margin: 0;
            color: var(--ink);
            font-size: 15px;
            font-weight: 900;
        }

    .count-badge {
        background: var(--bg-2);
        color: var(--ink-3);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 7px 12px;
        font-size: 11.5px;
        font-weight: 900;
        white-space: nowrap;
    }

        .count-badge strong {
            color: var(--blue);
        }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .model-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1280px;
    }

        .model-table th {
            background: var(--bg-2);
            color: var(--mute);
            font-size: 11px;
            font-weight: 900;
            padding: 11px 16px;
            border-bottom: 1px solid var(--border);
            text-align: center;
            white-space: nowrap;
        }

        .model-table td {
            color: var(--ink-3);
            font-size: 12.5px;
            padding: 12px 16px;
            border-bottom: 1px solid var(--border);
            text-align: center;
            vertical-align: middle;
        }

        .model-table tbody tr:hover td {
            background: #f8fafc;
        }

    .select-cell {
        text-align: center;
    }

    .question-cell {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        min-width: 0;
    }

    .question-avatar {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        color: #fff;
        background: linear-gradient(135deg, #1e3a8a, #2563eb);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 900;
        flex-shrink: 0;
    }

    .question-text {
        min-width: 0;
        text-align: right;
    }

        .question-text strong {
            display: block;
            color: var(--ink);
            font-size: 13.5px;
            font-weight: 900;
            line-height: 1.9;
            max-width: 520px;
        }

        .question-text span {
            display: block;
            color: var(--mute);
            font-size: 10.5px;
            margin-top: 3px;
            text-align: right;
            direction: ltr;
        }

    .curriculum-pill,
    .section-pill,
    .lesson-pill,
    .note-pill,
    .passage-pill,
    .media-type-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        border-radius: 999px;
        padding: 5px 9px;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
        border: 1px solid;
    }

    .curriculum-pill {
        background: var(--blue-lt);
        color: var(--blue-dk);
        border-color: rgba(37, 99, 235, .16);
    }

    .section-pill {
        background: var(--cyan-lt);
        color: #155e75;
        border-color: rgba(8, 145, 178, .16);
    }

    .lesson-pill {
        background: var(--green-lt);
        color: var(--green-dk);
        border-color: rgba(5, 150, 105, .18);
    }

    .note-pill {
        background: var(--bg-2);
        color: var(--ink-3);
        border-color: var(--border);
        direction: ltr;
    }

    .passage-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5px;
        min-width: 165px;
    }

    .passage-pill {
        background: var(--bg-2);
        color: var(--ink-3);
        border-color: var(--border);
    }

        .passage-pill.empty {
            color: var(--mute);
        }

    .media-type-pill.text {
        background: var(--cyan-lt);
        color: #155e75;
        border-color: rgba(8, 145, 178, .16);
    }

    .media-type-pill.audio {
        background: var(--purple-lt);
        color: var(--purple-dk);
        border-color: rgba(124, 58, 237, .18);
    }

    .media-type-pill.none,
    .media-type-pill.unknown {
        background: var(--bg-2);
        color: var(--mute);
        border-color: var(--border);
    }

    .row-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
    }

    .action-btn {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        border: 1px solid;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: .15s;
        font-size: 13px;
        cursor: pointer;
    }

        .action-btn.view {
            background: var(--blue-lt);
            color: var(--blue-dk);
            border-color: rgba(37, 99, 235, .18);
        }

        .action-btn.edit {
            background: var(--amber-lt);
            color: var(--amber-dk);
            border-color: rgba(217, 119, 6, .18);
        }

        .action-btn:hover {
            transform: translateY(-1px);
            box-shadow: var(--shadow-sm);
        }

    .bottom-actions {
        margin-top: 14px;
        padding: 16px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
    }

        .bottom-actions strong {
            display: block;
            color: var(--ink);
            font-size: 14px;
            font-weight: 900;
            margin-bottom: 3px;
        }

        .bottom-actions span {
            display: block;
            color: var(--mute);
            font-size: 12px;
        }

    .bottom-actions-buttons {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .bottom-btn {
        border-radius: 12px;
        padding: 10px 16px;
        font-size: 12px;
        font-weight: 900;
        border: 1px solid;
        cursor: pointer;
    }

        .bottom-btn.primary {
            background: var(--blue);
            color: #fff;
            border-color: var(--blue);
        }

        .bottom-btn.muted {
            background: var(--bg-2);
            color: var(--ink-3);
            border-color: var(--border);
        }

    .empty-box {
        padding: 46px 20px;
        text-align: center;
        color: var(--mute);
    }

        .empty-box i {
            display: block;
            font-size: 34px;
            color: var(--mute-2);
            margin-bottom: 10px;
        }

        .empty-box strong {
            display: block;
            color: var(--ink);
            font-size: 16px;
            font-weight: 900;
            margin-bottom: 4px;
        }

        .empty-box span {
            display: block;
            font-size: 12px;
        }

    .d-none {
        display: none !important;
    }

    div.dataTables_wrapper {
        padding: 0;
    }

        div.dataTables_wrapper div.dataTables_length,
        div.dataTables_wrapper div.dataTables_info,
        div.dataTables_wrapper div.dataTables_paginate {
            padding: 12px 16px;
            font-size: 12px;
            font-weight: 800;
            color: var(--ink-3);
        }

        div.dataTables_wrapper div.dataTables_filter {
            display: none !important;
        }

        div.dataTables_wrapper div.dataTables_length select {
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 6px 9px;
            font-size: 12px;
            outline: none;
            margin: 0 6px;
        }

    @@media (max-width: 1200px) {
        .filter-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .search-field {
            grid-column: 1 / -1;
        }

        .action-field {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 768px) {
        .professional-model-add-page {
            padding: 14px;
        }

        .model-hero {
            align-items: flex-start;
            flex-direction: column;
        }

        .hero-main {
            align-items: flex-start;
            flex-direction: column;
        }

        .filter-grid {
            grid-template-columns: 1fr;
        }

        .search-field,
        .action-field {
            grid-column: auto;
        }

        .table-head,
        .bottom-actions {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

@section Scripts {
    <script>
        var table = null;
        var searchTimer = null;
        var selectedIds = new Set();

        function initialsFromText(value) {
            var clean = $('<div>').html(value || '').text().trim();

            if (!clean) {
                return 'سـ';
            }

            var parts = clean.split(/\s+/);

            if (parts.length >= 2) {
                return (parts[0].substring(0, 1) + parts[1].substring(0, 1)).toUpperCase();
            }

            return clean.substring(0, Math.min(2, clean.length)).toUpperCase();
        }

        function renderMediaType(row) {
            var type = row.PassageMediaType || 'none';
            var label = row.PassageMediaLabel || '—';
            var icon = 'fas fa-minus';

            if (type === 'text') {
                icon = 'fas fa-align-right';
            }

            if (type === 'audio') {
                icon = 'fas fa-volume-up';
            }

            if (type === 'unknown') {
                icon = 'fas fa-question-circle';
            }

            return `
                <span class="media-type-pill ${type}">
                    <i class="${icon}"></i>
                    ${label}
                </span>`;
        }

        function refreshSelectedCount() {
            var count = selectedIds.size;
            $('#selectedQuestionsCount').text(count);
            $('#submitCount').text(count);
        }

        function restoreCheckboxesOnCurrentPage() {
            if (!table) return;
            var rows = table.rows({ page: 'current' }).nodes();
            $('input[name="questionIds"]', rows).each(function () {
                $(this).prop('checked', selectedIds.has($(this).val()));
            });
            var allChecked = rows.length > 0 &&
                $('input[name="questionIds"]', rows).length > 0 &&
                $('input[name="questionIds"]:not(:checked)', rows).length === 0;
            $('#selectAllPage').prop('checked', allChecked);
        }

        $(document).ready(function () {
            table = $('#questionsTable').DataTable({
                processing: true,
                serverSide: true,
                orderCellsTop: true,
                fixedHeader: true,
                scrollX: true,
                pageLength: 25,
                lengthMenu: [10, 25, 50, 100],
                order: [[2, 'desc']],
                dom:
                    "<'row g-2 align-items-center'<'col-md-6'l>>" +
                    "<'row'<'col-12'tr>>" +
                    "<'row g-2 align-items-center'<'col-md-6'i><'col-md-6'p>>",

                ajax: {
                    url: '@Url.Action("LoadQuestionsData", "ProfessionalModels", new { area = "Admin" })',
                    type: 'POST',
                    data: function (d) {
                        d.modelId = '@Model.ModelId';

                        d.curriculumId = $('#filterCurriculum').val() || null;
                        d.sectionId = $('#filterSection').val() || null;
                        d.lessonId = $('#filterLesson').val() || null;
                    },
                    dataSrc: function (json) {
                        var hasRows = json && json.data && json.data.length > 0;
                        $('#noFilteredQuestions').toggleClass('d-none', hasRows);
                        return json.data;
                    }
                },

                columns: [
                    {
                        data: 'Id',
                        orderable: false,
                        searchable: false,
                        className: 'select-cell',
                        render: function (data) {
                            return `<input type="checkbox" name="questionIds" value="${data}" />`;
                        }
                    },
                    {
                        data: 'Id',
                        orderable: false,
                        searchable: false,
                        className: 'text-center',
                        render: function (data) {
                            return `
                                <button type="button"
                                        class="action-btn view btn-preview-question"
                                        data-id="${data}"
                                        title="معاينة">
                                    <i class="fas fa-eye"></i>
                                </button>`;
                        }
                    },
                    {
                        data: 'Title',
                        render: function (data, type, row) {
                            var avatar = initialsFromText(data);
                            var questionId = row.Id || '';
                            var clean = $('<div>').html(data || '').text().trim();
                            var display = clean.length > 20
                                ? clean.substring(0, 20) + '…'
                                : (clean || 'سؤال بدون نص');
                            var titleAttr = clean.replace(/"/g, '&quot;');

                            return `
                                <div class="question-cell">
                                    <div class="question-avatar">${avatar}</div>
                                    <div class="question-text">
                                        <strong title="${titleAttr}">${display}</strong>
                                        <span>ID: ${questionId}</span>
                                    </div>
                                </div>`;
                        }
                    },
                    {
                        data: 'CurriculumTitle',
                        render: function (data) {
                            return `
                                <span class="curriculum-pill">
                                    <i class="fas fa-book"></i>
                                    ${data || 'غير محدد'}
                                </span>`;
                        }
                    },
                    {
                        data: 'SectionTitle',
                        render: function (data) {
                            return `
                                <span class="section-pill">
                                    <i class="fas fa-layer-group"></i>
                                    ${data || 'غير محدد'}
                                </span>`;
                        }
                    },
                    {
                        data: 'LessonTitle',
                        render: function (data) {
                            return `
                                <span class="lesson-pill">
                                    <i class="fas fa-bookmark"></i>
                                    ${data || 'غير محدد'}
                                </span>`;
                        }
                    },
                    {
                        data: 'InternalNote',
                        render: function (data) {
                            return `
                                <span class="note-pill">
                                    ${data || '—'}
                                </span>`;
                        }
                    },
                    {
                        data: 'Id',
                        orderable: false,
                        searchable: false,
                        className: 'text-center',
                        render: function (data) {
                            return `
                                <div class="row-actions">
                                    <a href="/Admin/Questions/Edit/${data}"
                                       target="_blank"
                                       class="action-btn edit"
                                       title="تعديل">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                </div>`;
                        }
                    }
                ],

                initComplete: function () {
                    loadCurriculums();
                },

                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.7/i18n/ar.json"
                }
            });

            $('#generalQuestionSearch').on('keyup change', function () {
                clearTimeout(searchTimer);

                var value = this.value || '';

                searchTimer = setTimeout(function () {
                    table.search(value).draw();
                }, 350);
            });

            $('#filterCurriculum').on('change', function () {
                $('#filterSection')
                    .empty()
                    .append('<option value="">كل المحاور</option>');

                $('#filterLesson')
                    .empty()
                    .append('<option value="">كل المؤشرات</option>');

                loadSections();
                table.ajax.reload();
            });

            $('#filterSection').on('change', function () {
                const sectionId = $(this).val();

                $('#filterLesson')
                    .empty()
                    .append('<option value="">كل المؤشرات</option>');

                if (!sectionId) {
                    table.ajax.reload();
                    return;
                }

                fetch(`/Admin/ProfessionalModels/GetLessonsForQuestionFilters?sectionId=${sectionId}`)
                    .then(function (res) {
                        if (!res.ok) {
                            throw new Error('Failed');
                        }

                        return res.json();
                    })
                    .then(function (data) {
                        data.forEach(function (item) {
                            $('#filterLesson').append(
                                `<option value="${item.id}">${item.title}</option>`
                            );
                        });

                        table.ajax.reload();
                    })
                    .catch(function () {
                        $('#filterLesson')
                            .empty()
                            .append('<option value="">تعذر التحميل</option>');

                        table.ajax.reload();
                    });
            });

            $('#filterLesson').on('change', function () {
                table.ajax.reload();
            });

            $('#clearAllFilters').on('click', function () {
                $('#generalQuestionSearch').val('');

                $('#filterCurriculum').val('');

                $('#filterSection')
                    .empty()
                    .append('<option value="">كل المحاور</option>');

                $('#filterLesson')
                    .empty()
                    .append('<option value="">كل المؤشرات</option>');

                table.search('');
                table.ajax.reload();

                loadCurriculums();
            });

            $('#selectAllPage').on('change', function () {
                var isChecked = $(this).is(':checked');
                var rows = table.rows({ page: 'current' }).nodes();

                $('input[name="questionIds"]', rows).each(function () {
                    $(this).prop('checked', isChecked);
                    if (isChecked) {
                        selectedIds.add($(this).val());
                    } else {
                        selectedIds.delete($(this).val());
                    }
                });
                refreshSelectedCount();
            });

            $(document).on('change', 'input[name="questionIds"]', function () {
                if ($(this).is(':checked')) {
                    selectedIds.add($(this).val());
                } else {
                    selectedIds.delete($(this).val());
                }
                refreshSelectedCount();
            });

            table.on('draw', function () {
                restoreCheckboxesOnCurrentPage();
                refreshSelectedCount();
            });

            $('#addQuestionsForm').on('submit', function () {
                // disable checkboxes so they are not submitted alongside the hidden inputs
                $(this).find('input[type="checkbox"][name="questionIds"]').prop('disabled', true);
                $(this).find('input[type="hidden"][name="questionIds"]').remove();
                selectedIds.forEach(function (id) {
                    $('<input>').attr({ type: 'hidden', name: 'questionIds', value: id })
                               .appendTo('#addQuestionsForm');
                });
            });

            $(document).on('click', '.btn-preview-question', function () {
                const id = $(this).data('id');
                const url = '@Url.Action("Preview", "Questions", new { area = "Admin" })/' + id;

                $('#questionPreviewModalBody').html('<div class="text-center text-muted p-4">جاري تحميل السؤال...</div>');

                fetch(url)
                    .then(function (res) {
                        if (!res.ok) {
                            throw new Error('Failed');
                        }

                        return res.text();
                    })
                    .then(function (html) {
                        $('#questionPreviewModalBody').html(html);

                        new bootstrap.Modal(
                            document.getElementById('questionPreviewModal')
                        ).show();
                    })
                    .catch(function () {
                        $('#questionPreviewModalBody').html('<div class="alert alert-danger mb-0">تعذر تحميل السؤال.</div>');

                        new bootstrap.Modal(
                            document.getElementById('questionPreviewModal')
                        ).show();
                    });
            });
        });

        function loadCurriculums() {
            fetch('/Admin/ProfessionalModels/GetCurriculumsForQuestionFilters')
                .then(function (res) {
                    if (!res.ok) {
                        throw new Error('Failed');
                    }

                    return res.json();
                })
                .then(function (data) {
                    $('#filterCurriculum')
                        .empty()
                        .append('<option value="">كل المناهج</option>');

                    data.forEach(function (item) {
                        $('#filterCurriculum').append(
                            `<option value="${item.id}">${item.title}</option>`
                        );
                    });
                })
                .catch(function () {
                    $('#filterCurriculum')
                        .empty()
                        .append('<option value="">تعذر التحميل</option>');
                });
        }

        function loadSections() {
            const curriculumId = $('#filterCurriculum').val();

            let url = '/Admin/ProfessionalModels/GetSectionsForQuestionFilters';

            if (curriculumId) {
                url += `?curriculumId=${curriculumId}`;
            }

            fetch(url)
                .then(function (res) {
                    if (!res.ok) {
                        throw new Error('Failed');
                    }

                    return res.json();
                })
                .then(function (data) {
                    $('#filterSection')
                        .empty()
                        .append('<option value="">كل المحاور</option>');

                    data.forEach(function (item) {
                        $('#filterSection').append(
                            `<option value="${item.id}">${item.title}</option>`
                        );
                    });
                })
                .catch(function () {
                    $('#filterSection')
                        .empty()
                        .append('<option value="">تعذر التحميل</option>');
                });
        }
    </script>
}