@model QdratNew.ViewModels.Exam.PlacementExamReviewVm
@using QdratNew.Helpers

@{
    ViewData["Title"] = "📋 مراجعة اختبار تحديد المستوى";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<div class="container py-4" dir="rtl">

    <!-- 🧭 العنوان -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-clipboard-check"></i> مراجعة اختبار تحديد المستوى
        </h2>

        <a asp-action="Index" class="btn btn-outline-secondary">
            رجوع
        </a>
    </div>

    <!-- 📊 كروت المعلومات -->
    <div class="row mb-4">

        <div class="col-md-3">
            <div class="card p-3 text-center">
                <div>📘 العنوان</div>
                <strong>@Model.ExamTitle</strong>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 text-center">
                <div>📚 المنهج</div>
                <strong>@Model.CurriculumTitle</strong>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 text-center">
                <div>🏫 الدفعة</div>
                <strong>@Model.BatchName</strong>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 text-center">
                <div>⏱️ الزمن</div>
                <strong>@Model.DurationMinutes دقيقة</strong>
            </div>
        </div>

    </div>

    <!-- 📘 عرض المحاور -->
    @foreach (var sec in Model.Sections)
    {
        <div class="card mb-4 shadow-sm">

            <div class="card-header bg-light">
                <h5 class="fw-bold text-primary">
                    @sec.SectionTitle
                    <span class="badge bg-primary">@sec.Questions.Count() سؤال</span>
                </h5>
            </div>

            <div class="card-body p-0">
                <table class="table table-bordered table-hover text-center">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>السؤال</th>
                            <th>المؤشر</th>
                            <th>الصعوبة</th>
                            <th>الإجابة</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var q in sec.Questions)
                        {
                            <tr>
                                <td>@q.Order</td>

                                <td class="text-start">
                                    @Html.Raw(NumberHelper.ToIndicNumbersSafe(q.Title))
                                </td>

                                <td>@q.LessonTitle</td>

                                <td>
                                    <span class="badge bg-warning">
                                        @q.Difficulty
                                    </span>
                                </td>

                                <td>
                                    @Html.Raw(NumberHelper.ToIndicNumbersSafe(q.CorrectAnswer))
                                </td>

                                <td>
                                    <button class="btn btn-info btn-sm"
                                            onclick="previewQuestion('@q.QuestionId')">
                                        معاينة
                                    </button>

                                    <a asp-action="ReplaceQuestion"
                                       asp-route-examId="@Model.ExamId"
                                       asp-route-questionId="@q.QuestionId"
                                       class="btn btn-primary btn-sm">
                                        استبدال
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ✅ إرسال -->
    <form asp-action="ConfirmSendPost" method="post">
        <input type="hidden" name="examId" value="@Model.ExamId" />

        <button type="submit" class="btn btn-success w-100">
            تأكيد إرسال الاختبار
        </button>
    </form>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function previewQuestion(id) {
            Swal.fire({
                html: "جارٍ التحميل...",
                width: 800,
                showConfirmButton: false,
                didOpen: () => {
                    fetch(`/Admin/Questions/Preview?id=${id}`)
                        .then(r => r.text())
                        .then(html => Swal.update({ html }));
                }
            });
        }
    </script>
}