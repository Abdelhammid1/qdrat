@model QdratNew.ViewModels.ProfessionalModel.ProfessionalModelEditVm
@using QdratNew.Enums
@{
    ViewData["Title"] = "تعديل النموذج";
}

<div class="qdrat-page" dir="rtl">

    <div class="qdrat-hero mb-4">
        <div>
            <div class="qdrat-kicker">
                <i class="fa fa-layer-group"></i>
                النماذج الاحترافية
            </div>

            <h2 class="qdrat-title">تعديل النموذج</h2>

            <p class="qdrat-subtitle">
                عدّل بيانات النموذج الاحترافي مع الحفاظ على ارتباطاته الحالية بالأسئلة والاختبارات دون تغيير مسار التشغيل.
            </p>
        </div>

        <div class="qdrat-hero-icon">
            <i class="fa fa-edit"></i>
        </div>
    </div>

    <div class="qdrat-card">
        <div class="qdrat-card-header">
            <div>
                <h5>
                    <i class="fa fa-pen-to-square"></i>
                    بيانات النموذج
                </h5>
                <p>
                    يمكنك تعديل كود النموذج ووصفه فقط من هذه الصفحة.
                </p>
            </div>
        </div>

        <div class="qdrat-card-body">
            <form asp-action="Edit" method="post" novalidate autocomplete="off">
                @Html.AntiForgeryToken()

                <input type="hidden" name="id" value="@ViewBag.ModelId" />

                <div asp-validation-summary="ModelOnly" class="alert qdrat-alert qdrat-alert-danger mb-4"></div>

                <div class="row g-4">

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="Title" class="form-label"></label>
                            <div class="qdrat-input-wrap">
                                <i class="fa fa-tag"></i>
                                <input asp-for="Title" class="form-control" placeholder="مثال: M75" />
                            </div>
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="CurriculumId" class="form-label">المنهج</label>
                            <div class="qdrat-select-wrap">
                                <i class="fa fa-book"></i>
                                <select asp-for="CurriculumId" asp-items="Model.Curriculums" class="form-select qdrat-select"></select>
                            </div>
                            <span asp-validation-for="CurriculumId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="ModelType" class="form-label">نوع النموذج</label>
                            <div class="qdrat-select-wrap">
                                <i class="fa fa-tags"></i>
                                <select asp-for="ModelType" class="form-select qdrat-select">
                                    @if (Model.ModelType == ProfessionalModelType.Exam)
                                    {
                                        <option value="@((int)ProfessionalModelType.Exam)" selected>اختبارات</option>
                                        <option value="@((int)ProfessionalModelType.Homework)">واجبات</option>
                                    }
                                    else
                                    {
                                        <option value="@((int)ProfessionalModelType.Exam)">اختبارات</option>
                                        <option value="@((int)ProfessionalModelType.Homework)" selected>واجبات</option>
                                    }
                                </select>
                            </div>
                            <span asp-validation-for="ModelType" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="qdrat-field">
                            <label asp-for="Description" class="form-label"></label>
                            <div class="qdrat-textarea-wrap">
                                <i class="fa fa-align-right"></i>
                                <textarea asp-for="Description" class="form-control" rows="5" placeholder="اكتب وصفًا مختصرًا يوضح هدف النموذج أو مصدره..."></textarea>
                            </div>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                </div>

                <div class="qdrat-warning-panel mt-4">
                    <div class="qdrat-warning-icon">
                        <i class="fa fa-circle-info"></i>
                    </div>
                    <div>
                        <strong>تنبيه قبل الحفظ</strong>
                        <p>
                            تعديل بيانات النموذج لا يغيّر الأسئلة المرتبطة به ولا يغيّر أي اختبار تم إنشاؤه مسبقًا منه.
                        </p>
                    </div>
                </div>

                <div class="qdrat-actions">
                    <a asp-action="Index" class="btn qdrat-btn qdrat-btn-light">
                        <i class="fa fa-arrow-right"></i>
                        رجوع
                    </a>

                    <button type="submit" class="btn qdrat-btn qdrat-btn-primary">
                        <i class="fa fa-save"></i>
                        تحديث
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

<style>
    .qdrat-page {
        padding: 24px;
        background: #f5f7fb;
        min-height: calc(100vh - 80px);
        font-family: inherit;
    }

    .qdrat-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 26px;
        border-radius: 24px;
        background: linear-gradient(135deg, #102a43 0%, #1d4ed8 58%, #38bdf8 100%);
        color: #fff;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
    }

    .qdrat-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .qdrat-title {
        margin: 0;
        font-size: 28px;
        font-weight: 900;
        letter-spacing: -0.5px;
    }

    .qdrat-subtitle {
        margin: 10px 0 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 15px;
        line-height: 1.8;
        max-width: 850px;
    }

    .qdrat-hero-icon {
        width: 74px;
        height: 74px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.16);
        font-size: 34px;
        flex: 0 0 auto;
    }

    .qdrat-card {
        border: 1px solid #e5e7eb;
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    .qdrat-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #edf0f5;
        background: #fff;
    }

        .qdrat-card-header h5 {
            margin: 0;
            color: #0f172a;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .qdrat-card-header h5 i {
                color: #2563eb;
            }

        .qdrat-card-header p {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 14px;
        }

    .qdrat-card-body {
        padding: 24px;
    }

    .qdrat-field .form-label {
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 9px;
    }

    .qdrat-input-wrap,
    .qdrat-textarea-wrap {
        position: relative;
    }

        .qdrat-input-wrap > i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 3;
            pointer-events: none;
        }

        .qdrat-textarea-wrap > i {
            position: absolute;
            right: 15px;
            top: 18px;
            color: #64748b;
            z-index: 3;
            pointer-events: none;
        }

        .qdrat-input-wrap .form-control {
            min-height: 48px;
            border-radius: 15px;
            border-color: #dbe3ef;
            padding-right: 42px;
            font-weight: 700;
        }

        .qdrat-textarea-wrap .form-control {
            border-radius: 15px;
            border-color: #dbe3ef;
            padding-right: 42px;
            padding-top: 14px;
            font-weight: 700;
            line-height: 1.9;
            resize: vertical;
        }

            .qdrat-input-wrap .form-control:focus,
            .qdrat-textarea-wrap .form-control:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 0.22rem rgba(37, 99, 235, 0.12);
            }

    .qdrat-select-wrap {
        position: relative;
    }

        .qdrat-select-wrap > i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 3;
            pointer-events: none;
        }

        .qdrat-select-wrap .qdrat-select {
            min-height: 48px;
            border-radius: 15px;
            border-color: #dbe3ef;
            padding-right: 42px;
            font-weight: 700;
            appearance: auto;
        }

            .qdrat-select-wrap .qdrat-select:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 0.22rem rgba(37, 99, 235, 0.12);
            }

    .qdrat-warning-panel {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        border: 1px solid #fde68a;
        background: #fffbeb;
        border-radius: 18px;
        padding: 16px;
        color: #92400e;
    }

    .qdrat-warning-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fef3c7;
        color: #d97706;
        flex: 0 0 auto;
        font-size: 18px;
    }

    .qdrat-warning-panel strong {
        display: block;
        font-weight: 900;
        margin-bottom: 4px;
    }

    .qdrat-warning-panel p {
        margin: 0;
        font-weight: 700;
        line-height: 1.8;
    }

    .qdrat-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 26px;
        margin-top: 28px;
        border-top: 1px solid #edf0f5;
    }

    .qdrat-btn {
        min-height: 46px;
        border-radius: 14px;
        padding: 10px 24px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .qdrat-btn-primary {
        background: #2563eb;
        border-color: #2563eb;
        color: #fff;
    }

        .qdrat-btn-primary:hover {
            background: #1d4ed8;
            border-color: #1d4ed8;
            color: #fff;
        }

    .qdrat-btn-light {
        background: #f8fafc;
        border-color: #dbe3ef;
        color: #334155;
    }

        .qdrat-btn-light:hover {
            background: #eef2f7;
            border-color: #cbd5e1;
            color: #0f172a;
        }

    .qdrat-alert {
        border: 0;
        border-radius: 18px;
        padding: 15px 18px;
        font-weight: 800;
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.07);
    }

        .qdrat-alert:empty {
            display: none;
        }

    .qdrat-alert-danger {
        color: #991b1b;
        background: #fee2e2;
    }

    @@media (max-width: 768px) {
        .qdrat-page {
            padding: 14px;
        }

        .qdrat-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 20px;
        }

        .qdrat-title {
            font-size: 23px;
        }

        .qdrat-hero-icon {
            width: 58px;
            height: 58px;
            font-size: 26px;
        }

        .qdrat-card-body,
        .qdrat-card-header {
            padding: 18px;
        }

        .qdrat-actions {
            flex-direction: column-reverse;
        }

        .qdrat-btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
