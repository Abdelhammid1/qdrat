@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('questionSearch');
            const sectionFilter = document.getElementById('sectionFilter');
            const lessonFilter = document.getElementById('lessonFilter');

            const resetButton = document.getElementById('resetQuestionFilters');
            const visibleCount = document.getElementById('visibleQuestionsCount');
            const noFilteredQuestions = document.getElementById('noFilteredQuestions');
            const rows = Array.from(document.querySelectorAll('#questionsTable tbody .question-row'));

            function normalize(value) {
                if (!value) {
                    return '';
                }

                return value.toString().trim().toLowerCase();
            }

            function applyFilters() {
                const searchValue = normalize(searchInput ? searchInput.value : '');
                const sectionValue = normalize(sectionFilter ? sectionFilter.value : '');
                const lessonValue = normalize(lessonFilter ? lessonFilter.value : '');
                let shown = 0;

                rows.forEach(function (row) {
                    const rowSearch = normalize(row.getAttribute('data-search'));
                    const rowSection = normalize(row.getAttribute('data-section'));
                    const rowLesson = normalize(row.getAttribute('data-lesson'));
                    const matchSearch = searchValue === '' || rowSearch.indexOf(searchValue) !== -1;
                    const matchSection = sectionValue === '' || rowSection === sectionValue;
                    const matchLesson = lessonValue === '' || rowLesson === lessonValue;
                    const visible = matchSearch && matchSection && matchLesson;
                    row.style.display = visible ? '' : 'none';

                    if (visible) {
                        shown++;
                    }
                });

                if (visibleCount) {
                    visibleCount.textContent = shown;
                }

                if (noFilteredQuestions) {
                    noFilteredQuestions.classList.toggle('d-none', shown !== 0);
                }
            }

            if (searchInput) {
                searchInput.addEventListener('input', applyFilters);
            }

            if (sectionFilter) {
                sectionFilter.addEventListener('change', applyFilters);
            }

            if (lessonFilter) {
                lessonFilter.addEventListener('change', applyFilters);
            }

            if (resetButton) {
                resetButton.addEventListener('click', function () {
                    if (searchInput) {
                        searchInput.value = '';
                    }

                    if (sectionFilter) {
                        sectionFilter.value = '';
                    }

                    if (lessonFilter) {
                        lessonFilter.value = '';
                    }

                    applyFilters();
                });
            }

            applyFilters();
        });

        function showQuestionPreview(id) {
            var modalBody = document.getElementById('questionPreviewModalBody');

            if (modalBody) {
                modalBody.innerHTML = '<div class="text-center text-muted p-4">جاري تحميل السؤال...</div>';
            }

            fetch(`/Admin/Questions/Preview/${id}`)
                .then(function (res) {
                    if (!res.ok) {
                        throw new Error('Preview failed');
                    }

                    return res.text();
                })
                .then(function (html) {
                    modalBody.innerHTML = html;

                    new bootstrap.Modal(
                        document.getElementById('questionPreviewModal')
                    ).show();
                })
                .catch(function () {
                    modalBody.innerHTML = '<div class="alert alert-danger mb-0">تعذر تحميل معاينة السؤال.</div>';

                    new bootstrap.Modal(
                        document.getElementById('questionPreviewModal')
                    ).show();
                });
        }
    </script>
