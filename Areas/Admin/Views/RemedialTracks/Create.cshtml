@model QdratNew.ViewModels.RemedialTracks.RemedialTrackCreateVm
@{
    ViewData["Title"] = "خطة علاجية جديدة";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-rtk.css" asp-append-version="true" />
}

<div class="rtk-page container-fluid mt-4" dir="rtl">

    <header class="rtk-hero">
        <div class="rtk-hero__top">
            <div>
                <div class="rtk-hero__label"><i class="fas fa-route ms-1"></i> الخطة العلاجية العاجلة</div>
                <h1>خطة علاجية جديدة</h1>
                <p>أدخل بيانات الترويسة أولًا، ثم أضف المحاور والفيديوهات والنماذج في صفحة البناء.</p>
            </div>
            <a class="rtk-btn rtk-btn--light" asp-area="Admin" asp-controller="RemedialTracks" asp-action="Index">
                <i class="fas fa-arrow-right"></i> الخطط
            </a>
        </div>
    </header>

    <section class="rtk-panel">
        <form method="post" asp-area="Admin" asp-controller="RemedialTracks" asp-action="Create" id="rtkCreateForm" novalidate>
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="rtk-alert rtk-alert--error" role="alert">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            @if (Model.Curricula.Count == 0)
            {
                <div class="rtk-empty"><i class="fas fa-book-open"></i> لا توجد مناهج بعد. أنشئ منهجًا أولًا.</div>
            }
            else
            {
                <div class="rtk-grid">
                    <div class="rtk-field rtk-field--wide">
                        <label asp-for="Input.Title">اسم الخطة</label>
                        <input asp-for="Input.Title" maxlength="200" required autocomplete="off" />
                        <span asp-validation-for="Input.Title" class="field-validation-error"></span>
                    </div>

                    <div class="rtk-field rtk-field--wide">
                        <label asp-for="Input.Description">وصف (اختياري)</label>
                        <textarea asp-for="Input.Description" maxlength="1000"></textarea>
                        <span asp-validation-for="Input.Description" class="field-validation-error"></span>
                    </div>

                    <div class="rtk-field">
                        <label asp-for="Input.CurriculumId">المنهج</label>
                        <select asp-for="Input.CurriculumId" required>
                            <option value="">— اختر المنهج —</option>
                            @foreach (var c in Model.Curricula)
                            {
                                <option value="@c.Id" selected="@(Model.Input.CurriculumId == c.Id)">@c.Text</option>
                            }
                        </select>
                        <span asp-validation-for="Input.CurriculumId" class="field-validation-error"></span>
                    </div>

                    <div class="rtk-field">
                        <label asp-for="Input.PassPercent">نسبة النجاح %</label>
                        <input asp-for="Input.PassPercent" type="text" inputmode="numeric" maxlength="3" />
                        <div class="rtk-hint">من 1 إلى 100 (الافتراضي 60).</div>
                        <span asp-validation-for="Input.PassPercent" class="field-validation-error"></span>
                    </div>

                    <div class="rtk-field">
                        <label asp-for="Input.MinWatchPercent">حد المشاهدة المطلوب %</label>
                        <input asp-for="Input.MinWatchPercent" type="text" inputmode="numeric" maxlength="3" />
                        <div class="rtk-hint">من 50 إلى 100 (الافتراضي 90).</div>
                        <span asp-validation-for="Input.MinWatchPercent" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="rtk-form-actions">
                    <button type="submit" class="rtk-btn" id="rtkCreateSubmit"><i class="fas fa-check"></i> إنشاء ومتابعة البناء</button>
                    <a class="rtk-btn rtk-btn--outline" asp-area="Admin" asp-controller="RemedialTracks" asp-action="Index">إلغاء</a>
                </div>
            }
        </form>
    </section>
</div>

@section Scripts {
    <script>
    (function () {
        'use strict';
        var form = document.getElementById('rtkCreateForm');
        if (!form || form.dataset.bound === '1') return;   // منع تكرار الربط
        form.dataset.bound = '1';
        form.addEventListener('submit', function () {
            var btn = document.getElementById('rtkCreateSubmit');
            if (btn) { btn.disabled = true; btn.classList.add('is-busy'); }   // منع الإرسال المزدوج
        });
    })();
    </script>
}
