@model QdratNew.ViewModels.Admin.CourseCollections.CourseCollectionDashboardViewModel
@using QdratNew.Enums
@{
    ViewData["Title"] = "طلبات مجموعات الدورات";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <h4 class="fw-bold mb-0"><i class="fas fa-clipboard-list me-2 text-primary"></i>طلبات التسجيل في مجموعات الدورات</h4>
        <small class="text-muted">إجمالي الطلبات: @Model.TotalCount</small>
    </div>

    @* كروت الإحصائيات *@
    <div class="row g-3 mb-4">
        @{
            var stats = new[] {
                new { Label = "إجمالي", Count = Model.TotalCount, Color = "secondary", Icon = "fas fa-list" },
                new { Label = "جديد", Count = Model.NewCount, Color = "primary", Icon = "fas fa-star" },
                new { Label = "تم التواصل", Count = Model.ContactedCount, Color = "success", Icon = "fas fa-phone" },
                new { Label = "يحتاج متابعة", Count = Model.NeedFollowUpCount, Color = "warning", Icon = "fas fa-clock" },
                new { Label = "مرفوض", Count = Model.RejectedCount, Color = "danger", Icon = "fas fa-ban" },
                new { Label = "مؤكد", Count = Model.ConvertedCount, Color = "info", Icon = "fas fa-circle-check" }
            };
        }
        @foreach (var stat in stats)
        {
            <div class="col-6 col-md-4 col-lg-2">
                <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                    <div class="text-@stat.Color mb-1"><i class="@stat.Icon"></i></div>
                    <div class="fw-bold fs-4">@stat.Count</div>
                    <div class="text-muted small">@stat.Label</div>
                </div>
            </div>
        }
    </div>

    @* الفلاتر *@
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-600">بحث</label>
                    <input type="text" name="SearchText" value="@Model.Filter.SearchText"
                           class="form-control form-control-sm" placeholder="الاسم / الجوال / الهوية" />
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label small fw-600">المجموعة</label>
                    <select name="CourseCollectionId" class="form-select form-select-sm">
                        <option value="">— الكل —</option>
                        @foreach (var c in Model.CollectionsForFilter)
                        {
                            <option value="@c.Id" selected="@(Model.Filter.CourseCollectionId == c.Id)">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label small fw-600">الدورة</label>
                    <select name="CourseId" class="form-select form-select-sm">
                        <option value="">— الكل —</option>
                        @foreach (var c in Model.CoursesForFilter)
                        {
                            <option value="@c.Id" selected="@(Model.Filter.CourseId == c.Id)">@c.TitleAr</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-1">
                    <label class="form-label small fw-600">الحالة</label>
                    <select name="Status" class="form-select form-select-sm">
                        <option value="">— الكل —</option>
                        <option value="1" selected="@(Model.Filter.Status == CourseCollectionRegistrationStatus.New)">جديد</option>
                        <option value="2" selected="@(Model.Filter.Status == CourseCollectionRegistrationStatus.Contacted)">تم التواصل</option>
                        <option value="3" selected="@(Model.Filter.Status == CourseCollectionRegistrationStatus.NeedFollowUp)">يحتاج متابعة</option>
                        <option value="4" selected="@(Model.Filter.Status == CourseCollectionRegistrationStatus.Rejected)">مرفوض</option>
                        <option value="5" selected="@(Model.Filter.Status == CourseCollectionRegistrationStatus.Converted)">مؤكد</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-600">من تاريخ</label>
                    <input type="date" name="FromDate" value="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                </div>
                <div class="col-6 col-md-1">
                    <label class="form-label small fw-600">إلى تاريخ</label>
                    <input type="date" name="ToDate" value="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                </div>
                <div class="col-12 col-md-1">
                    <button type="submit" class="btn btn-primary btn-sm w-100 rounded-3">بحث</button>
                </div>
            </form>
        </div>
    </div>

    @* جدول الطلبات *@
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>الاسم</th>
                            <th>الجوال</th>
                            <th>الهوية</th>
                            <th>المجموعة</th>
                            <th>الدورات</th>
                            <th>الحالة</th>
                            <th>تاريخ الطلب</th>
                            <th>الموظف</th>
                            <th class="text-center">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-muted">@item.Id</td>
                                <td class="fw-600">@item.FullName</td>
                                <td dir="ltr">@item.PhoneNumber</td>
                                <td dir="ltr">@item.NationalId</td>
                                <td>
                                    <span class="badge bg-light text-dark border">@item.CollectionName</span>
                                </td>
                                <td style="min-width:160px">
                                    @foreach (var c in item.Courses)
                                    {
                                        <div class="mb-1">
                                            <span class="d-block fw-600 small">@c.TitleAr</span>
                                            @if (!string.IsNullOrEmpty(c.StandardCode))
                                            {
                                                <code class="small text-muted">@c.StandardCode</code>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>
                                    @{
                                        var (statusLabel, statusColor) = item.Status switch {
                                            CourseCollectionRegistrationStatus.New => ("جديد", "primary"),
                                            CourseCollectionRegistrationStatus.Contacted => ("تم التواصل", "success"),
                                            CourseCollectionRegistrationStatus.NeedFollowUp => ("يحتاج متابعة", "warning"),
                                            CourseCollectionRegistrationStatus.Rejected => ("مرفوض", "danger"),
                                            CourseCollectionRegistrationStatus.Converted => ("مؤكد", "info"),
                                            _ => ("—", "secondary")
                                        };
                                    }
                                    <span class="badge bg-@statusColor">@statusLabel</span>
                                </td>
                                <td class="text-muted">@item.SubmittedAt.ToString("dd/MM/yyyy")</td>
                                <td class="text-muted small">@(item.HandledByName ?? "—")</td>
                                <td class="text-center">
                                    <div class="d-flex gap-1 justify-content-center flex-wrap">
                                        <a asp-area="Admin" asp-controller="CourseCollectionRegistrations"
                                           asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-xs btn-outline-secondary rounded-2" title="تفاصيل">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <form asp-area="Admin" asp-controller="CourseCollectionRegistrations"
                                              asp-action="MarkContacted" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-xs btn-outline-success rounded-2" title="تم التواصل">
                                                <i class="fas fa-phone"></i>
                                            </button>
                                        </form>
                                        <form asp-area="Admin" asp-controller="CourseCollectionRegistrations"
                                              asp-action="MarkNeedFollowUp" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-xs btn-outline-warning rounded-2" title="يحتاج متابعة">
                                                <i class="fas fa-clock"></i>
                                            </button>
                                        </form>
                                        <form asp-area="Admin" asp-controller="CourseCollectionRegistrations"
                                              asp-action="Reject" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-xs btn-outline-danger rounded-2" title="رفض">
                                                <i class="fas fa-ban"></i>
                                            </button>
                                        </form>
                                        <form asp-area="Admin" asp-controller="CourseCollectionRegistrations"
                                              asp-action="Convert" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-xs btn-outline-info rounded-2" title="تأكيد">
                                                <i class="fas fa-circle-check"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Items.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted py-5">
                                    <i class="fas fa-inbox fa-2x mb-2 d-block opacity-30"></i>
                                    لا توجد طلبات مطابقة
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-transparent d-flex justify-content-center gap-1 py-3">
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <a href="?SearchText=@Model.Filter.SearchText&CourseCollectionId=@Model.Filter.CourseCollectionId&CourseId=@Model.Filter.CourseId&Status=@((int?)Model.Filter.Status)&FromDate=@Model.Filter.FromDate?.ToString("yyyy-MM-dd")&ToDate=@Model.Filter.ToDate?.ToString("yyyy-MM-dd")&Page=@p"
                       class="btn btn-sm @(p == Model.CurrentPage ? "btn-primary" : "btn-outline-secondary") rounded-3">@p</a>
                }
            </div>
        }
    </div>
</div>
