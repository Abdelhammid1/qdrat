@model QdratNew.ViewModels.Exam.SectionLessonsViewModel
@{
    ViewData["Title"] = "📘 مؤشرات المحور: " + Model.SectionTitle;
}

<div class="container mt-4">
    <h4 class="fw-bold text-primary mb-3">
        <i class="fas fa-layer-group me-2"></i> المحور: @Model.SectionTitle
    </h4>

    <div class="card shadow-sm border-0">
        <div class="card-body table-responsive">
            <table class="table table-hover text-center align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>المؤشر</th>
                        <th>عدد الأسئلة</th>
                        <th>نسبة النجاح</th>
                        <th>⏱️ متوسط الزمن (ث)</th>
                        <th>💪 مؤشر الصعوبة</th>
                        <th>عرض الأسئلة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.Lessons)
                    {
                        var color = l.AvgSuccessRate >= 80 ? "text-success fw-bold"
                        : l.AvgSuccessRate >= 60 ? "text-warning fw-bold"
                        : "text-danger fw-bold";

                        <tr>
                            <td>@l.LessonTitle</td>
                            <td>@l.QuestionCount</td>
                            <td class="@color">@l.AvgSuccessRate%</td>
                            <td>@Math.Round(l.AvgTimeSeconds, 1)</td>
                            <td>
                                <div class="progress" style="height: 18px;">
                                    <div class="progress-bar bg-danger" role="progressbar"
                                         style="width:@l.HardnessIndex%">
                                        @l.HardnessIndex%
                                    </div>
                                </div>
                            </td>
                            <td>
                                <a asp-area="Admin"
                                   asp-controller="ExamIndividualAssignments"
                                   asp-action="LessonQuestionsDetailIndividual"
                                   asp-route-examAssignmentId="@Model.AssignmentId"
                                   asp-route-studentId="@Model.StudentId"
                                   asp-route-lessonId="@l.LessonId"
                                   class="btn btn-outline-secondary">
                                    عرض <i class="fas fa-arrow-left"></i>
                                </a>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3 text-start">
        <a asp-area="Admin" asp-controller="ExamAssignments" asp-action="ExamBatchAnalytics" asp-route-assignmentId="@Model.AssignmentId"
           class="btn btn-outline-secondary">
            <i class="fas fa-arrow-right"></i> رجوع للتقرير
        </a>
    </div>
</div>
