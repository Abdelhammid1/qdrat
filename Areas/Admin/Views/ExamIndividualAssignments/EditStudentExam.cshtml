@model QdratNew.ViewModels.Exam.EditStudentExamVm
@{
    ViewData["Title"] = "تعديل اختبار فردي";
}

<div class="container-fluid py-4" dir="rtl">
    <div class="qdrat-page-header mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <div class="qdrat-breadcrumb mb-2">
                    <span>الإدارة</span>
                    <i class="fas fa-chevron-left"></i>
                    <span>الاختبارات الفردية</span>
                    <i class="fas fa-chevron-left"></i>
                    <strong>تعديل اختبار</strong>
                </div>
                <h2 class="qdrat-page-title mb-1">
                    <i class="fas fa-pen-to-square"></i>
                    تعديل اختبار فردي
                </h2>
                <p class="qdrat-page-subtitle mb-0">
                    عدّل بيانات الاختبار الفردي مع الحفاظ على الطالب والربط الحالي دون تغيير مسار التنفيذ.
                </p>
            </div>

            <div class="qdrat-header-actions">
                <a asp-action="Index" class="btn btn-light qdrat-btn-back">
                    <i class="fas fa-arrow-right"></i>
                    الرجوع إلى القائمة
                </a>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger qdrat-alert fw-bold">
            <i class="fas fa-triangle-exclamation"></i>
            @TempData["Error"]
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success qdrat-alert fw-bold">
            <i class="fas fa-circle-check"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning qdrat-alert fw-bold flex-column align-items-stretch">
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="fas fa-triangle-exclamation"></i>
                @TempData["Warning"]
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="confirmResetCb" name="ConfirmResetAttempts" value="true" form="editStudentExamForm" />
                <label class="form-check-label fw-bold" for="confirmResetCb">تأكيد إعادة التعيين (سيمسح المحاولات القديمة)</label>
            </div>
            <textarea id="editReasonInput" name="EditReason" class="form-control" rows="2" placeholder="سبب التعديل (إجباري)" form="editStudentExamForm"></textarea>
        </div>
    }

    <form id="editStudentExamForm" asp-action="EditStudentExam" method="post" class="qdrat-form">
        <input type="hidden" asp-for="AssignmentId" />
        <input type="hidden" asp-for="ExamId" />

        <div class="row g-4">
            <div class="col-12 col-xl-8">
                <div class="qdrat-card mb-4">
                    <div class="qdrat-card-header">
                        <div>
                            <h5 class="mb-1">
                                <i class="fas fa-id-card"></i>
                                بيانات الاختبار
                            </h5>
                            <p class="mb-0">عدّل العنوان وتحقق من الطالب المرتبط بهذا الاختبار الفردي.</p>
                        </div>
                    </div>

                    <div class="qdrat-card-body">
                        <div class="row g-3">
                            <div class="col-12 col-lg-7">
                                <div class="qdrat-field">
                                    <label asp-for="Title" class="form-label">
                                        <i class="fas fa-heading"></i>
                                        عنوان الاختبار
                                    </label>
                                    <input asp-for="Title" class="form-control qdrat-input" autocomplete="off" />
                                </div>
                            </div>

                            <div class="col-12 col-lg-5">
                                <div class="qdrat-field">
                                    <label class="form-label">
                                        <i class="fas fa-user-graduate"></i>
                                        الطالب
                                    </label>
                                    <input class="form-control qdrat-input bg-light" value="@Model.StudentName" disabled />
                                    <input type="hidden" asp-for="StudentId" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="qdrat-card mb-4">
                    <div class="qdrat-card-header">
                        <div>
                            <h5 class="mb-1">
                                <i class="fas fa-sliders"></i>
                                نوع الاختبار وطريقة التوليد
                            </h5>
                            <p class="mb-0">حافظ على نفس آلية الاختبار أو غيّر طريقة توليد الأسئلة حسب الحاجة.</p>
                        </div>
                    </div>

                    <div class="qdrat-card-body">
                        <div class="row g-3">
                            <div class="col-12 col-lg-6">
                                <div class="qdrat-field h-100">
                                    <label class="form-label">
                                        <i class="fas fa-display"></i>
                                        نوع الاختبار
                                    </label>

                                    <div class="qdrat-radio-group">
                                        <label class="qdrat-radio-card">
                                            <input class="form-check-input" type="radio" asp-for="IsOnline" value="true" />
                                            <span>
                                                <strong>أونلاين</strong>
                                                <small>بدون رقم مرجعي</small>
                                            </span>
                                        </label>

                                        <label class="qdrat-radio-card">
                                            <input class="form-check-input" type="radio" asp-for="IsOnline" value="false" />
                                            <span>
                                                <strong>حضوري</strong>
                                                <small>يتطلب رقمًا مرجعيًا</small>
                                            </span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-lg-6">
                                <div id="refBox" class="qdrat-field h-100" style="display:none;">
                                    <label asp-for="ReferenceCode" class="form-label">
                                        <i class="fas fa-hashtag"></i>
                                        الرقم المرجعي
                                    </label>
                                    <input asp-for="ReferenceCode" class="form-control qdrat-input" placeholder="مثال: 12345" autocomplete="off" />
                                    <div class="qdrat-help-text">يظهر هذا الحقل فقط عند اختيار الاختبار الحضوري.</div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="qdrat-field">
                                    <label class="form-label" for="modeSelector">
                                        <i class="fas fa-wand-magic-sparkles"></i>
                                        طريقة توليد الأسئلة
                                    </label>
                                    <select id="modeSelector" class="form-select qdrat-input">
                                        <option value="">-- اختر --</option>

                                        @if (Model.UseProfessionalModel)
                                        {
                                            <option value="model" selected>نموذج احترافي</option>
                                        }
                                        else
                                        {
                                            <option value="model">نموذج احترافي</option>
                                        }

                                        @if (Model.UseAutoGeneration)
                                        {
                                            <option value="auto" selected>توليد تلقائي</option>
                                        }
                                        else
                                        {
                                            <option value="auto">توليد تلقائي</option>
                                        }
                                    </select>

                                    <input type="hidden" asp-for="UseProfessionalModel" id="UseProfessionalModel" />
                                    <input type="hidden" asp-for="UseAutoGeneration" id="UseAutoGeneration" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="modelArea" class="qdrat-card mb-4" style="display:none;">
                    <div class="qdrat-card-header qdrat-card-header-soft">
                        <div>
                            <h5 class="mb-1">
                                <i class="fas fa-medal"></i>
                                النموذج الاحترافي
                            </h5>
                            <p class="mb-0">اختر النموذج الاحترافي المستخدم في توليد أسئلة الاختبار.</p>
                        </div>
                    </div>

                    <div class="qdrat-card-body">
                        <div class="qdrat-field">
                            <label asp-for="ProfessionalModelId" class="form-label">
                                <i class="fas fa-list-check"></i>
                                اختيار النموذج الاحترافي
                            </label>
                            <select asp-for="ProfessionalModelId" class="form-select qdrat-input">
                                <option value="">-- اختر --</option>
                                @foreach (var m in Model.ProfessionalModels)
                                {
                                    <option value="@m.Id">@m.Title</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div id="autoArea" class="qdrat-card mb-4" style="display:none;">
                    <div class="qdrat-card-header qdrat-card-header-soft">
                        <div>
                            <h5 class="mb-1">
                                <i class="fas fa-sitemap"></i>
                                التوليد التلقائي
                            </h5>
                            <p class="mb-0">اضبط عدد الأسئلة المطلوب لكل محور كما هو محفوظ في نموذج التعديل الحالي.</p>
                        </div>
                    </div>

                    <div class="qdrat-card-body">
                        <div class="qdrat-section-list">
                            @for (int i = 0; i < Model.Sections.Count; i++)
                            {
                                <div class="qdrat-section-row mb-3">
                                    <div class="row g-3 align-items-center">
                                        <div class="col-md-7">
                                            <label class="qdrat-section-title">@Model.Sections[i].SectionTitle</label>
                                            <input type="hidden" asp-for="Sections[@i].SectionId" />
                                            <input type="hidden" asp-for="Sections[@i].SectionTitle" />
                                        </div>

                                        <div class="col-md-5">
                                            <label asp-for="Sections[@i].RequestedCount" class="form-label qdrat-count-label">عدد الأسئلة</label>
                                            <input asp-for="Sections[@i].RequestedCount" type="number" min="0" class="form-control qdrat-input" />
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="qdrat-card">
                    <div class="qdrat-card-header">
                        <div>
                            <h5 class="mb-1">
                                <i class="fas fa-clock"></i>
                                الوقت والمدة
                            </h5>
                            <p class="mb-0">عدّل موعد البداية والانتهاء ومدة الاختبار بالدقائق.</p>
                        </div>
                    </div>

                    <div class="qdrat-card-body">
                        <div class="row g-3">
                            <div class="col-12 col-lg-4">
                                <div class="qdrat-field">
                                    <label asp-for="ScheduledDate" class="form-label">
                                        <i class="fas fa-calendar-plus"></i>
                                        موعد البدء
                                    </label>
                                    <input asp-for="ScheduledDate" type="datetime-local" class="form-control qdrat-input" />
                                </div>
                            </div>

                            <div class="col-12 col-lg-4">
                                <div class="qdrat-field">
                                    <label asp-for="EndAt" class="form-label">
                                        <i class="fas fa-calendar-check"></i>
                                        موعد الانتهاء
                                    </label>
                                    <input asp-for="EndAt" type="datetime-local" class="form-control qdrat-input" />
                                </div>
                            </div>

                            <div class="col-12 col-lg-4">
                                <div class="qdrat-field">
                                    <label asp-for="DurationMinutes" class="form-label">
                                        <i class="fas fa-hourglass-half"></i>
                                        المدة (دقائق)
                                    </label>
                                    <input asp-for="DurationMinutes" type="number" class="form-control qdrat-input" min="1" />
                                </div>
                            </div>
                        </div>

                        <div class="qdrat-actions mt-4">
                            <button type="submit" class="btn btn-success qdrat-btn-primary">
                                <i class="fas fa-save"></i>
                                حفظ التعديلات
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary qdrat-btn-outline">
                                <i class="fas fa-times"></i>
                                إلغاء
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-4">
                <div class="qdrat-side-card mb-4">
                    <div class="qdrat-side-icon">
                        <i class="fas fa-user-clock"></i>
                    </div>
                    <h5>تعديل آمن للاختبار</h5>
                    <p>
                        يتم الحفاظ على معرف الاختبار والتعيين والطالب من خلال الحقول المخفية الحالية، مع تعديل بيانات التشغيل فقط.
                    </p>
                </div>

                <div class="qdrat-tips-card mb-4">
                    <h6>
                        <i class="fas fa-lightbulb"></i>
                        ملاحظات التعديل
                    </h6>
                    <ul class="mb-0">
                        <li>اختيار أونلاين يخفي الرقم المرجعي.</li>
                        <li>اختيار حضوري يعرض حقل الرقم المرجعي.</li>
                        <li>طريقة التوليد تحدد المنطقة التي سيتم إرسال بياناتها.</li>
                    </ul>
                </div>

                <div class="qdrat-status-card">
                    <div class="qdrat-status-row">
                        <span><i class="fas fa-link"></i> رقم التعيين</span>
                        <strong>@Model.AssignmentId</strong>
                    </div>
                    <div class="qdrat-status-row">
                        <span><i class="fas fa-file-lines"></i> رقم الاختبار</span>
                        <strong>@Model.ExamId</strong>
                    </div>
                    <div class="qdrat-status-row">
                        <span><i class="fas fa-user"></i> الطالب</span>
                        <strong>@Model.StudentName</strong>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<style>
    .qdrat-page-header {
        background: linear-gradient(135deg, #f8fafc 0%, #eef4ff 100%);
        border: 1px solid #e5edf8;
        border-radius: 22px;
        padding: 24px;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.06);
    }

    .qdrat-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #64748b;
        font-size: 13px;
        flex-wrap: wrap;
    }

        .qdrat-breadcrumb i {
            font-size: 10px;
            color: #94a3b8;
        }

    .qdrat-page-title {
        color: #1e293b;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .qdrat-page-title i,
        .qdrat-card-header i,
        .qdrat-field label i,
        .qdrat-tips-card h6 i {
            color: #2563eb;
        }

    .qdrat-page-subtitle {
        color: #64748b;
        font-size: 15px;
    }

    .qdrat-alert {
        border-radius: 18px;
        display: flex;
        align-items: center;
        gap: 10px;
        border: 0;
    }

    .qdrat-btn-back,
    .qdrat-btn-primary,
    .qdrat-btn-outline {
        border-radius: 14px;
        padding: 10px 16px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .qdrat-btn-back {
        color: #334155;
        border: 1px solid #e2e8f0;
    }

    .qdrat-card,
    .qdrat-side-card,
    .qdrat-tips-card,
    .qdrat-status-card {
        background: #ffffff;
        border: 1px solid #e5edf8;
        border-radius: 22px;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.06);
        overflow: hidden;
    }

    .qdrat-card-header {
        padding: 18px 22px;
        border-bottom: 1px solid #e5edf8;
        background: #ffffff;
    }

    .qdrat-card-header-soft {
        background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
    }

    .qdrat-card-header h5 {
        color: #1e293b;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .qdrat-card-header p,
    .qdrat-help-text,
    .qdrat-radio-card small,
    .qdrat-side-card p,
    .qdrat-tips-card li {
        color: #64748b;
        font-size: 14px;
    }

    .qdrat-card-body {
        padding: 22px;
    }

    .qdrat-field label {
        font-weight: 800;
        color: #334155;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
    }

    .qdrat-input {
        border-radius: 14px;
        border-color: #dbe5f1;
        min-height: 46px;
        box-shadow: none !important;
    }

        .qdrat-input:focus {
            border-color: #2563eb;
        }

    .qdrat-radio-group {
        display: grid;
        gap: 12px;
    }

    .qdrat-radio-card {
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 14px;
        display: flex;
        align-items: center;
        gap: 12px;
        cursor: pointer;
        background: #f8fafc;
        margin: 0;
    }

        .qdrat-radio-card span {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .qdrat-radio-card strong {
            color: #1e293b;
        }

    .qdrat-section-row {
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 16px;
        background: #f8fafc;
    }

    .qdrat-section-title {
        font-weight: 800;
        color: #1e293b;
        margin: 0;
    }

    .qdrat-count-label {
        font-size: 13px;
        color: #64748b;
    }

    .qdrat-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: flex-start;
    }

    .qdrat-side-card,
    .qdrat-tips-card,
    .qdrat-status-card {
        padding: 22px;
    }

    .qdrat-side-icon {
        width: 52px;
        height: 52px;
        border-radius: 18px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        margin-bottom: 14px;
    }

    .qdrat-side-card h5,
    .qdrat-tips-card h6 {
        font-weight: 800;
        color: #1e293b;
    }

    .qdrat-tips-card ul {
        padding-right: 18px;
    }

    .qdrat-tips-card li {
        margin-bottom: 8px;
    }

    .qdrat-status-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid #edf2f7;
    }

        .qdrat-status-row:last-child {
            border-bottom: 0;
        }

        .qdrat-status-row span {
            color: #64748b;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .qdrat-status-row strong {
            color: #1e293b;
        }

    @@media (max-width: 768px) {
        .qdrat-page-header,
        .qdrat-card-body,
        .qdrat-side-card,
        .qdrat-tips-card,
        .qdrat-status-card {
            padding: 18px;
        }

        .qdrat-actions .btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById("editStudentExamForm");
            const cb = document.getElementById("confirmResetCb");
            const reasonBox = document.getElementById("editReasonInput");
            if (!form || !cb) return;

            form.addEventListener("submit", function (e) {
                if (!cb.checked) {
                    e.preventDefault();
                    alert('يجب تفعيل "تأكيد إعادة التعيين" قبل الحفظ لوجود محاولات سابقة.');
                    return;
                }
                if (!reasonBox.value.trim()) {
                    e.preventDefault();
                    alert("يجب كتابة سبب التعديل.");
                }
            });
        })();

        function updateRefBox() {
            const isOnline = document.querySelector('input[name="IsOnline"]:checked').value;
            document.getElementById("refBox").style.display =
                (isOnline === "false") ? "block" : "none";
        }

        document.querySelectorAll('input[name="IsOnline"]').forEach(x => {
            x.addEventListener("change", updateRefBox);
        });

        updateRefBox();


        // منطق اختيار التوليد
        const modelArea = document.getElementById("modelArea");
        const autoArea = document.getElementById("autoArea");

        function updateMode() {
            const mode = document.getElementById("modeSelector").value;

            modelArea.style.display = "none";
            autoArea.style.display = "none";

            document.getElementById("UseProfessionalModel").value = "false";
            document.getElementById("UseAutoGeneration").value = "false";

            if (mode === "model") {
                modelArea.style.display = "block";
                document.getElementById("UseProfessionalModel").value = "true";
            }

            if (mode === "auto") {
                autoArea.style.display = "block";
                document.getElementById("UseAutoGeneration").value = "true";
            }
        }

        document.getElementById("modeSelector").addEventListener("change", updateMode);
        updateMode();
    </script>
}
