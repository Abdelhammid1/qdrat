@model List<QdratNew.ViewModels.Exam.IndividualExamListVm>

@{
    ViewData["Title"] = "الاختبارات الفردية";

    var totalExams = Model?.Count ?? 0;
    var submittedCount = Model?.Count(x => x.IsSubmitted) ?? 0;
    var pendingCount = totalExams - submittedCount;
    var totalQuestions = Model?.Sum(x => x.TotalQuestions) ?? 0;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

    <style>
        :root {
            --ink: #0D1B2A;
            --ink-2: #2C3E50;
            --ink-3: #5A6A7A;
            --ink-4: #8FA0B0;
            --ink-5: #C8D5E0;
            --canvas: #F3F6FA;
            --surface: #FFFFFF;
            --surface-2: #F8FAFC;
            --surface-3: #EEF2F7;
            --border: #DDE4EC;
            --blue: #1B5EAE;
            --blue-2: #2471D0;
            --blue-bg: #E8F1FB;
            --blue-dark: #103E7A;
            --emerald: #0D7A5B;
            --emerald-bg: #E4F5EE;
            --amber: #985D09;
            --amber-bg: #FDF0D8;
            --rose: #BF1030;
            --rose-bg: #FDEAEE;
            --violet: #5535B5;
            --violet-bg: #EDE8F9;
            --r-sm: 6px;
            --r-md: 10px;
            --r-lg: 14px;
            --r-xl: 20px;
            --sh-xs: 0 1px 3px rgba(13,27,42,.06);
            --sh-sm: 0 2px 8px rgba(13,27,42,.08);
            --sh-md: 0 4px 18px rgba(13,27,42,.10);
            --ease: cubic-bezier(.25,.46,.45,.94);
        }

        .exam-page {
            background: var(--canvas);
            min-height: 100vh;
            padding: 32px 28px 64px;
            direction: rtl;
            font-family: 'Cairo';
            color: var(--ink-2);
        }

        .exam-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 14px;
            margin-bottom: 28px;
        }

        .exam-brand {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .exam-brand-icon {
            width: 46px;
            height: 46px;
            background: var(--blue);
            border-radius: var(--r-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 20px;
            box-shadow: 0 4px 14px rgba(27,94,174,.28);
        }

        .exam-brand-title {
            font-size: 20px;
            font-weight: 700;
            color: var(--ink);
            line-height: 1.15;
        }

        .exam-brand-sub {
            font-size: 16px;
            color: var(--ink-4);
            margin-top: 2px;
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn-main-action {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: var(--blue);
            color: #fff;
            border: none;
            border-radius: var(--r-md);
            padding: 10px 20px;
            font-size: 18px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            box-shadow: 0 3px 10px rgba(27,94,174,.28);
            transition: background .16s var(--ease), transform .14s, box-shadow .16s;
        }

            .btn-main-action:hover {
                background: var(--blue-dark);
                color: #fff;
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(27,94,174,.32);
            }

        .btn-secondary-action {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: var(--surface);
            color: var(--blue);
            border: 1px solid #B6D3F4;
            border-radius: var(--r-md);
            padding: 10px 20px;
            font-size: 18px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: background .16s var(--ease), transform .14s, box-shadow .16s;
        }

            .btn-secondary-action:hover {
                background: var(--blue-bg);
                color: var(--blue-dark);
                transform: translateY(-2px);
                box-shadow: var(--sh-sm);
            }

        .exam-alert {
            border: none;
            border-radius: var(--r-lg);
            padding: 14px 18px;
            font-size: 17px;
            font-weight: 700;
            box-shadow: var(--sh-xs);
            margin-bottom: 18px;
        }

        .exam-alert-danger {
            background: var(--rose-bg);
            color: var(--rose);
        }

        .exam-alert-success {
            background: var(--emerald-bg);
            color: var(--emerald);
        }

        .exam-kpis {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 13px;
            margin-bottom: 24px;
        }

        @@media (max-width: 960px) {
            .exam-kpis {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 480px) {
            .exam-kpis {
                grid-template-columns: 1fr;
            }
        }

        .kpi-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            padding: 18px 19px;
            display: flex;
            align-items: center;
            gap: 13px;
            box-shadow: var(--sh-xs);
            transition: transform .2s var(--ease), box-shadow .2s;
            position: relative;
            overflow: hidden;
        }

            .kpi-card::after {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 4px;
                height: 100%;
                border-radius: 0 var(--r-xl) var(--r-xl) 0;
            }

            .kpi-card:hover {
                transform: translateY(-3px);
                box-shadow: var(--sh-sm);
            }

        .kpi-blue::after {
            background: var(--blue);
        }

        .kpi-emerald::after {
            background: var(--emerald);
        }

        .kpi-amber::after {
            background: var(--amber);
        }

        .kpi-violet::after {
            background: var(--violet);
        }

        .kpi-ico {
            width: 42px;
            height: 42px;
            border-radius: var(--r-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .ico-blue {
            background: var(--blue-bg);
            color: var(--blue);
        }

        .ico-emerald {
            background: var(--emerald-bg);
            color: var(--emerald);
        }

        .ico-amber {
            background: var(--amber-bg);
            color: var(--amber);
        }

        .ico-violet {
            background: var(--violet-bg);
            color: var(--violet);
        }

        .kpi-label {
            font-size: 15px;
            font-weight: 700;
            color: var(--ink-4);
            letter-spacing: .04em;
            text-transform: uppercase;
            margin-bottom: 3px;
        }

        .kpi-val {
            font-size: 20px;
            font-weight: 700;
            color: var(--ink);
            line-height: 1;
        }

        .exam-table-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            overflow: visible;
            box-shadow: var(--sh-sm);
            margin-bottom: 24px;
        }

        .exam-table-topbar {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 11px 16px;
            border-bottom: 1px solid var(--surface-3);
            flex-wrap: wrap;
        }

        .table-section-title {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 18px;
            font-weight: 800;
            color: var(--ink);
            margin-left: 10px;
        }

            .table-section-title i {
                color: var(--blue);
            }

        .exam-table-search-wrap {
            position: relative;
            flex: 1;
            min-width: 200px;
            max-width: 360px;
        }

            .exam-table-search-wrap i {
                position: absolute;
                right: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--ink-4);
                font-size: 17px;
                pointer-events: none;
            }

            .exam-table-search-wrap input {
                width: 100%;
                padding: 7px 32px 7px 12px;
                border: 1px solid var(--border);
                border-radius: var(--r-md);
                font-size: 18px;
                background: var(--surface-2);
                color: var(--ink);
                transition: border-color .15s, box-shadow .15s;
            }

                .exam-table-search-wrap input:focus {
                    outline: none;
                    border-color: var(--blue-2);
                    box-shadow: 0 0 0 3px rgba(36,113,208,.1);
                    background: var(--surface);
                }

        .exam-count-badge {
            margin-right: auto;
            font-size: 16px;
            color: var(--ink-4);
        }

            .exam-count-badge strong {
                color: var(--blue);
                font-weight: 700;
            }

        .table-responsive-safe {
            width: 100%;
            overflow-x: auto;
            overflow-y: visible;
        }

        #examsTable {
            width: 100% !important;
            border-collapse: collapse;
        }

            #examsTable thead th {
                background: var(--surface-2) !important;
                padding: 11px 15px !important;
                font-size: 15px !important;
                font-weight: 700 !important;
                color: var(--ink-4) !important;
                text-transform: uppercase;
                letter-spacing: .05em;
                white-space: nowrap;
                border: none !important;
                text-align: center;
            }

            #examsTable tbody tr {
                border-bottom: 1px solid var(--surface-3);
                transition: background .1s;
            }

                #examsTable tbody tr:last-child {
                    border-bottom: none;
                }

                #examsTable tbody tr:hover {
                    background: #F5F8FD;
                }

            #examsTable td {
                padding: 11px 15px !important;
                vertical-align: middle !important;
                font-size: 18px !important;
                color: var(--ink-2);
                border: none !important;
                text-align: center;
            }

        .exam-title-cell {
            display: flex;
            align-items: center;
            gap: 10px;
            text-align: right;
        }

        .exam-avatar {
            width: 33px;
            height: 33px;
            border-radius: 50%;
            background: var(--blue-bg);
            color: var(--blue);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }

        .student-avatar {
            background: var(--violet-bg);
            color: var(--violet);
        }

        .exam-item-name {
            font-weight: 600;
            color: var(--ink);
            font-size: 18px;
        }

        .student-name {
            font-weight: 600;
            color: var(--ink-2);
            font-size: 17px;
        }

        .id-chip {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 34px;
            height: 28px;
            border-radius: 20px;
            background: var(--surface-3);
            color: var(--ink-3);
            font-size: 15px;
            font-weight: 700;
            padding: 0 10px;
        }

        .num-val {
            font-weight: 700;
            color: var(--ink);
            font-size: 19px;
        }

        .num-unit {
            font-size: 15px;
            color: var(--ink-4);
            display: block;
            margin-top: 1px;
        }

        .date-chip {
            font-size: 16px;
            color: var(--ink-3);
            white-space: nowrap;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 11px;
            border-radius: 30px;
            font-size: 16px;
            font-weight: 700;
            white-space: nowrap;
        }

        .sp-submitted {
            background: var(--emerald-bg);
            color: var(--emerald);
        }

        .sp-pending {
            background: var(--amber-bg);
            color: var(--amber);
        }

        .exam-act-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            flex-wrap: nowrap;
            position: relative;
            overflow: visible;
        }

        .act-form {
            display: inline-flex;
            margin: 0;
            padding: 0;
        }

        .act-btn {
            position: relative;
            width: 34px;
            height: 34px;
            min-width: 34px;
            padding: 0;
            border-radius: var(--r-sm);
            font-size: 16px;
            font-weight: 600;
            text-decoration: none;
            border: 1.5px solid transparent;
            cursor: pointer;
            background: transparent;
            transition: all .15s;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            overflow: visible;
        }

            .act-btn i {
                margin: 0;
                font-size: 15px;
                line-height: 1;
            }

            .act-btn .act-text {
                position: absolute;
                bottom: calc(100% + 8px);
                right: 50%;
                transform: translateX(50%) translateY(4px);
                background: var(--ink);
                color: #fff;
                font-size: 13px;
                font-weight: 600;
                padding: 5px 9px;
                border-radius: 6px;
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
                transition: opacity .15s ease, transform .15s ease, visibility .15s ease;
                z-index: 9999;
                box-shadow: 0 4px 12px rgba(13,27,42,.18);
                min-width: max-content;
            }

                .act-btn .act-text::after {
                    content: "";
                    position: absolute;
                    top: 100%;
                    right: 50%;
                    transform: translateX(50%);
                    border-width: 5px;
                    border-style: solid;
                    border-color: var(--ink) transparent transparent transparent;
                }

            .act-btn:hover .act-text {
                opacity: 1;
                visibility: visible;
                transform: translateX(50%) translateY(0);
            }

        .act-view {
            background: var(--blue-bg);
            color: var(--blue);
            border-color: #B6D3F4;
        }

            .act-view:hover {
                background: var(--blue);
                color: #fff;
                border-color: var(--blue);
            }

        .act-report {
            background: var(--emerald-bg);
            color: var(--emerald);
            border-color: #B8E8D3;
        }

            .act-report:hover {
                background: var(--emerald);
                color: #fff;
                border-color: var(--emerald);
            }

        .act-edit {
            background: var(--amber-bg);
            color: var(--amber);
            border-color: #F3D494;
        }

            .act-edit:hover {
                background: var(--amber);
                color: #fff;
                border-color: var(--amber);
            }

        .act-delete {
            background: var(--rose-bg);
            color: var(--rose);
            border-color: #F5B8C2;
        }

            .act-delete:hover {
                background: var(--rose);
                color: #fff;
                border-color: var(--rose);
            }

        .dataTables_wrapper {
            direction: rtl;
            overflow: visible;
        }

            .dataTables_wrapper .dataTables_filter {
                display: none;
            }

            .dataTables_wrapper .dataTables_length,
            .dataTables_wrapper .dataTables_info {
                padding: 9px 16px;
                font-size: 16px;
                color: var(--ink-4);
            }

            .dataTables_wrapper .dataTables_paginate {
                padding: 9px 16px;
            }

                .dataTables_wrapper .dataTables_paginate .paginate_button {
                    border-radius: var(--r-sm) !important;
                    font-size: 16px !important;
                    padding: 4px 10px !important;
                    border: 1px solid var(--border) !important;
                    margin: 0 2px !important;
                    color: var(--ink-3) !important;
                }

                    .dataTables_wrapper .dataTables_paginate .paginate_button.current,
                    .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
                        background: var(--blue) !important;
                        border-color: var(--blue) !important;
                        color: #fff !important;
                    }

                    .dataTables_wrapper .dataTables_paginate .paginate_button:hover:not(.current):not(.disabled) {
                        background: var(--blue-bg) !important;
                        border-color: #B6D3F4 !important;
                        color: var(--blue) !important;
                    }

            .dataTables_wrapper .dataTables_length select {
                border: 1px solid var(--border);
                border-radius: var(--r-sm);
                padding: 3px 8px;
                font-size: 16px;
                color: var(--ink);
            }

        div.dataTables_wrapper div.dataTables_paginate,
        div.dataTables_wrapper div.dataTables_info,
        div.dataTables_wrapper div.dataTables_length {
            border-top: 1px solid var(--surface-3);
            background: var(--surface-2);
        }

        .hw-empty {
            text-align: center;
            padding: 56px 16px;
            color: var(--ink-4);
        }

            .hw-empty i {
                font-size: 20px;
                display: block;
                margin-bottom: 12px;
                color: var(--ink-5);
            }

        .hw-empty-title {
            font-size: 18px;
            font-weight: 600;
            color: var(--ink-3);
        }

        .hw-empty-sub {
            font-size: 16px;
            margin-top: 4px;
        }

        @@media (max-width: 768px) {
            .exam-page {
                padding: 22px 14px 48px;
            }

            .top-actions {
                width: 100%;
            }

            .btn-main-action,
            .btn-secondary-action {
                width: 100%;
                justify-content: center;
            }

            .exam-table-topbar {
                align-items: stretch;
            }

            .exam-table-search-wrap {
                max-width: 100%;
                width: 100%;
            }

            .exam-count-badge {
                margin-right: 0;
            }
        }
    </style>
}

<div class="exam-page">

    @if (TempData["Error"] != null)
    {
        <div class="exam-alert exam-alert-danger">
            <i class="fa-solid fa-circle-exclamation"></i>
            @TempData["Error"]
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="exam-alert exam-alert-success">
            <i class="fa-solid fa-check-circle"></i>
            @TempData["Success"]
        </div>
    }

    <div class="exam-topbar">
        <div class="exam-brand">
            <div class="exam-brand-icon">
                <i class="fa-solid fa-user-check"></i>
            </div>
            <div>
                <div class="exam-brand-title">إدارة الاختبارات الفردية</div>
                <div class="exam-brand-sub">متابعة الاختبارات المرسلة لطالب محدد مع التقارير والتعديل والحذف</div>
            </div>
        </div>

        <div class="top-actions">
            <a href="/Admin/ExamAssignments" class="btn-secondary-action">
                <i class="fa-solid fa-arrow-right"></i>
                العودة لاختبارات الدُفعات
            </a>

            <a href="/Admin/ExamIndividualAssignments/CreateStudentExam" class="btn-main-action">
                <i class="fa-solid fa-plus"></i>
                إنشاء اختبار فردي جديد
            </a>
        </div>
    </div>

    <div class="exam-kpis">

        <div class="kpi-card kpi-blue">
            <div class="kpi-ico ico-blue">
                <i class="fa-solid fa-list-check"></i>
            </div>
            <div>
                <div class="kpi-label">إجمالي الاختبارات</div>
                <div class="kpi-val">@totalExams</div>
            </div>
        </div>

        <div class="kpi-card kpi-emerald">
            <div class="kpi-ico ico-emerald">
                <i class="fa-solid fa-check-circle"></i>
            </div>
            <div>
                <div class="kpi-label">تم الحل</div>
                <div class="kpi-val">@submittedCount</div>
            </div>
        </div>

        <div class="kpi-card kpi-amber">
            <div class="kpi-ico ico-amber">
                <i class="fa-solid fa-hourglass-half"></i>
            </div>
            <div>
                <div class="kpi-label">لم يُحل</div>
                <div class="kpi-val">@pendingCount</div>
            </div>
        </div>

        <div class="kpi-card kpi-violet">
            <div class="kpi-ico ico-violet">
                <i class="fa-solid fa-question-circle"></i>
            </div>
            <div>
                <div class="kpi-label">إجمالي الأسئلة</div>
                <div class="kpi-val">@totalQuestions</div>
            </div>
        </div>

    </div>

    <div class="exam-table-card">

        <div class="exam-table-topbar">
            <div class="table-section-title">
                <i class="fa-solid fa-list-check"></i>
                الاختبارات الفردية
            </div>

            <div class="exam-table-search-wrap">
                <i class="fa-solid fa-search"></i>
                <input type="text"
                       id="individualExamSearch"
                       placeholder="ابحث في الاختبارات أو أسماء الطلاب..." />
            </div>

            <div class="exam-count-badge">
                إجمالي: <strong>@totalExams</strong> اختبار
            </div>
        </div>

        <div class="table-responsive-safe">
            <table id="examsTable">
                <thead>
                    <tr>
                        <th style="width:7%">#</th>
                        <th style="text-align:right; width:22%">عنوان الاختبار</th>
                        <th style="text-align:right; width:18%">اسم الطالب</th>
                        <th style="width:9%">الأسئلة</th>
                        <th style="width:9%">المدة</th>
                        <th style="width:14%">تاريخ الإرسال</th>
                        <th style="width:14%">تاريخ الانتهاء</th>
                        <th style="width:10%">الحالة</th>
                        <th style="width:13%">الإجراءات</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="id-chip">@item.AssignmentId</span>
                                </td>

                                <td style="text-align:right">
                                    <div class="exam-title-cell">
                                        <div class="exam-avatar">
                                            <i class="fa-solid fa-file-signature"></i>
                                        </div>
                                        <span class="exam-item-name">@item.ExamTitle</span>
                                    </div>
                                </td>

                                <td style="text-align:right">
                                    <div class="exam-title-cell">
                                        <div class="exam-avatar student-avatar">
                                            <i class="fa-solid fa-user-graduate"></i>
                                        </div>
                                        <span class="student-name">@item.StudentName</span>
                                    </div>
                                </td>

                                <td>
                                    <span class="num-val">@item.TotalQuestions</span>
                                    <span class="num-unit">سؤال</span>
                                </td>

                                <td>
                                    <span class="num-val">@item.DurationMinutes</span>
                                    <span class="num-unit">دقيقة</span>
                                </td>

                                <td>
                                    <span class="date-chip">@item.AssignedAt.ToString("yyyy/MM/dd hh:mm tt")</span>
                                </td>

                                <td>
                                    <span class="date-chip">@(item.DueDate.HasValue? item.DueDate.Value.ToString("yyyy/MM/dd hh:mm tt") : "—")</span>
                                </td>

                                <td>
                                    @if (item.IsSubmitted)
                                    {
                                        <span class="status-pill sp-submitted">
                                            <i class="fa-solid fa-check-circle"></i>
                                            تم الحل
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill sp-pending">
                                            <i class="fa-solid fa-hourglass-half"></i>
                                            لم يُحل
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="exam-act-row">

                                        <a href="/Admin/ExamIndividualAssignments/Details/@item.AssignmentId"
                                           class="act-btn act-view"
                                           aria-label="تفاصيل الاختبار">
                                            <i class="fa-solid fa-eye"></i>
                                            <span class="act-text">تفاصيل الاختبار</span>
                                        </a>

                                        <a asp-area="Admin"
                                           asp-controller="ExamIndividualAssignments"
                                           asp-action="StudentIndividualExamPerformanceReport"
                                           asp-route-examAssignmentId="@item.AssignmentId"
                                           asp-route-studentId="@item.StudentId"
                                           class="act-btn act-report"
                                           aria-label="تقرير أداء الطالب">
                                            <i class="fa-solid fa-chart-column"></i>
                                            <span class="act-text">تقرير أداء الطالب</span>
                                        </a>

                                        <a href="/Admin/ExamIndividualAssignments/EditStudentExam?assignmentId=@item.AssignmentId"
                                           class="act-btn act-edit"
                                           aria-label="تعديل الاختبار">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                            <span class="act-text">تعديل الاختبار</span>
                                        </a>

                                        <form method="post"
                                              asp-action="Delete"
                                              asp-route-id="@item.AssignmentId"
                                              class="act-form"
                                              onsubmit="return confirm('هل أنت متأكد من حذف هذا الاختبار؟');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="act-btn act-delete"
                                                    aria-label="حذف الاختبار">
                                                <i class="fa-solid fa-trash"></i>
                                                <span class="act-text">حذف الاختبار</span>
                                            </button>
                                        </form>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="hw-empty">
                <i class="fa-solid fa-inbox"></i>
                <div class="hw-empty-title">لا توجد اختبارات فردية</div>
                <div class="hw-empty-sub">يمكنك إنشاء اختبار فردي جديد من أعلى الصفحة</div>
            </div>
        }

    </div>

</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var table = new DataTable('#examsTable', {
                paging: true,
                searching: true,
                ordering: true,
                pageLength: 25,
                order: [[5, 'desc']],
                language: {
                    url: '/lib/datatables/ar.json'
                },
                columnDefs: [
                    { orderable: false, targets: [8] }
                ],
                dom: 'Brtip'
            });

            var searchInput = document.getElementById('individualExamSearch');

            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    table.search(this.value).draw();
                });
            }
        });
    </script>
}