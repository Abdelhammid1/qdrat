@model QdratNew.ViewModels.Exam.CreateStudentExamVm
@{
    ViewData["Title"] = "إنشاء اختبار فردي";
    var lockBranch = Model.BranchId.HasValue;
    var lockBatch = Model.BatchId.HasValue;
    var lockStudent = Model.StudentId > 0;
}

<div class="container-fluid py-4" dir="rtl">
    <div class="qdrat-page-header mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <div class="qdrat-breadcrumb mb-2">
                    <span>الإدارة</span>
                    <i class="fas fa-chevron-left"></i>
                    <span>الاختبارات الفردية</span>
                    <i class="fas fa-chevron-left"></i>
                    <strong>إنشاء اختبار</strong>
                </div>
                <h2 class="qdrat-page-title mb-1">
                    <i class="fas fa-user-graduate"></i>
                    إنشاء اختبار فردي للطالب
                </h2>
                <p class="qdrat-page-subtitle mb-0">
                    أنشئ اختبارًا مخصصًا لطالب محدد باستخدام نموذج احترافي أو توليد تلقائي من المحاور والمؤشرات.
                </p>
            </div>

            <div class="qdrat-header-actions">
                <a asp-action="Index" class="btn btn-light qdrat-btn-back">
                    <i class="fas fa-arrow-right"></i>
                    الرجوع إلى القائمة
                </a>
            </div>
        </div>
    </div>

    <form asp-action="CreateStudentExam" method="post" class="qdrat-form">
        <div class="row g-4">
            <div class="col-12 col-xl-8">
                <div class="qdrat-card mb-4">
                    <div class="qdrat-card-header">
                        <div>
                            <h5 class="mb-1">
                                <i class="fas fa-id-card"></i>
                                بيانات الاختبار والطالب
                            </h5>
                            <p class="mb-0">حدد عنوان الاختبار ثم اختر الفرع والدفعة والطالب المستهدف.</p>
                        </div>
                    </div>

                    <div class="qdrat-card-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="qdrat-field">
                                    <label asp-for="Title" class="form-label">
                                        <i class="fas fa-heading"></i>
                                        عنوان الاختبار
                                    </label>
                                    <input asp-for="Title" class="form-control qdrat-input" placeholder="مثال: اختبار قياس تجريبي - المستوى الأول" autocomplete="off" />
                                    <span asp-validation-for="Title" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-12 col-lg-4">
                                <div class="qdrat-field">
                                    <label asp-for="BranchId" class="form-label">
                                        <i class="fas fa-building"></i>
                                        الفرع
                                    </label>
                                    <select asp-for="BranchId" class="form-select qdrat-input @(lockBranch ? "bg-light" : "")" id="branchSelect">
                                        <option value="">-- اختر الفرع --</option>
                                        @foreach (var b in Model.Branches)
                                        {
                                            <option value="@b.Id">@b.Name</option>
                                        }
                                    </select>

                                    @if (lockBranch)
                                    {
                                        <input type="hidden" asp-for="BranchId" />
                                    }
                                </div>
                            </div>

                            <div class="col-12 col-lg-4">
                                <div class="qdrat-field">
                                    <label asp-for="BatchId" class="form-label">
                                        <i class="fas fa-users"></i>
                                        الدفعة
                                    </label>
                                    <select asp-for="BatchId" class="form-select qdrat-input @(lockBatch ? "bg-light" : "")" id="batchSelect">
                                        <option value="">-- اختر الدفعة --</option>
                                        @foreach (var b in Model.Batches)
                                        {
                                            <option value="@b.Id">@b.Name</option>
                                        }
                                    </select>

                                    @if (lockBatch)
                                    {
                                        <input type="hidden" asp-for="BatchId" />
                                    }
                                </div>
                            </div>

                            <div class="col-12 col-lg-4">
                                <div class="qdrat-field">
                                    <label asp-for="StudentId" class="form-label">
                                        <i class="fas fa-user"></i>
                                        الطالب
                                    </label>
                                    <select asp-for="StudentId" class="form-select qdrat-input @(lockStudent ? "bg-light" : "")" id="studentSelect">
                                        <option value="">-- اختر الطالب --</option>
                                        @foreach (var s in Model.Students)
                                        {
                                            <option value="@s.Id">@s.Name</option>
                                        }
                                    </select>

                                    @if (lockStudent)
                                    {
                                        <input type="hidden" asp-for="StudentId" />
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="qdrat-card mb-4">
                    <div class="qdrat-card-header">
                        <div>
                            <h5 class="mb-1">
                                <i class="fas fa-sliders"></i>
                                إعدادات الاختبار
                            </h5>
                            <p class="mb-0">حدد نوع الاختبار وطريقة توليد الأسئلة دون تغيير مسار التنفيذ الحالي.</p>
                        </div>
                    </div>

                    <div class="qdrat-card-body">
                        <div class="row g-3">
                            <div class="col-12 col-lg-6">
                                <div class="qdrat-field h-100">
                                    <label class="form-label">
                                        <i class="fas fa-display"></i>
                                        نوع الاختبار
                                    </label>

                                    <div class="qdrat-radio-group">
                                        <label class="qdrat-radio-card">
                                            <input class="form-check-input" type="radio" asp-for="IsOnline" value="true" />
                                            <span>
                                                <strong>أونلاين</strong>
                                                <small>بدون رقم مرجعي حضوري</small>
                                            </span>
                                        </label>

                                        <label class="qdrat-radio-card">
                                            <input class="form-check-input" type="radio" asp-for="IsOnline" value="false" />
                                            <span>
                                                <strong>حضوري داخل المعمل</strong>
                                                <small>يتطلب رقمًا مرجعيًا للفتح</small>
                                            </span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-lg-6">
                                <div class="qdrat-field h-100" id="referenceCodeArea" style="display:none;">
                                    <label asp-for="ReferenceCode" class="form-label">
                                        <i class="fas fa-hashtag"></i>
                                        الرقم المرجعي (6 أرقام)
                                    </label>
                                    <input asp-for="ReferenceCode" maxlength="6" pattern="\d{6}" class="form-control qdrat-input" placeholder="مثال: 123456" autocomplete="off" />
                                    <div class="qdrat-help-text">يظهر هذا الحقل عند اختيار الاختبار الحضوري داخل المعمل.</div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="qdrat-field">
                                    <label class="form-label" for="generationMode">
                                        <i class="fas fa-wand-magic-sparkles"></i>
                                        طريقة التوليد
                                    </label>
                                    <select id="generationMode" class="form-select qdrat-input">
                                        <option value="">-- اختر --</option>
                                        <option value="model">من نموذج احترافي</option>
                                        <option value="auto">توليد تلقائي من المحاور</option>
                                    </select>

                                    <input type="hidden" asp-for="UseProfessionalModel" id="UseProfessionalModel" />
                                    <input type="hidden" asp-for="UseAutoGeneration" id="UseAutoGeneration" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="modelArea" class="qdrat-card mb-4" style="display:none;">
                    <div class="qdrat-card-header qdrat-card-header-soft">
                        <div>
                            <h5 class="mb-1">
                                <i class="fas fa-medal"></i>
                                النموذج الاحترافي
                            </h5>
                            <p class="mb-0">اختر النموذج المعتمد لتوليد اختبار فردي بنفس توزيع النموذج.</p>
                        </div>
                    </div>

                    <div class="qdrat-card-body">
                        <div class="qdrat-field">
                            <label asp-for="ProfessionalModelId" class="form-label">
                                <i class="fas fa-list-check"></i>
                                اختر النموذج
                            </label>
                            <select asp-for="ProfessionalModelId" class="form-select qdrat-input">
                                <option value="">-- اختر النموذج --</option>
                                @foreach (var m in Model.ProfessionalModels)
                                {
                                    <option value="@m.Id">@m.Title</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div id="autoArea" class="qdrat-card mb-4" style="display:none;">
                    <div class="qdrat-card-header qdrat-card-header-soft">
                        <div>
                            <h5 class="mb-1">
                                <i class="fas fa-sitemap"></i>
                                التوليد التلقائي من المحاور
                            </h5>
                            <p class="mb-0">اختر المنهج ثم وزّع الأسئلة على المؤشرات النشطة داخل كل محور.</p>
                        </div>
                    </div>

                    <div class="qdrat-card-body">
                        <div class="qdrat-field mb-4">
                            <label asp-for="CurriculumId" class="form-label">
                                <i class="fas fa-book-open"></i>
                                اختر المنهج
                            </label>
                            <select asp-for="CurriculumId" class="form-select qdrat-input" id="curriculumSelector">
                                <option value="">-- اختر المنهج --</option>
                                @foreach (var c in Model.Curriculums)
                                {
                                    <option value="@c.Id">@c.Title</option>
                                }
                            </select>
                        </div>

                        <div id="sectionsContainer" class="qdrat-dynamic-container"></div>
                    </div>
                </div>

                <div class="qdrat-card">
                    <div class="qdrat-card-header">
                        <div>
                            <h5 class="mb-1">
                                <i class="fas fa-clock"></i>
                                الإعدادات الزمنية
                            </h5>
                            <p class="mb-0">حدد نافذة إتاحة الاختبار والمدة بالدقائق.</p>
                        </div>
                    </div>

                    <div class="qdrat-card-body">
                        <div class="row g-3">
                            <div class="col-12 col-lg-4">
                                <div class="qdrat-field">
                                    <label asp-for="ScheduledDate" class="form-label">
                                        <i class="fas fa-calendar-plus"></i>
                                        موعد البدء
                                    </label>
                                    <input asp-for="ScheduledDate" type="datetime-local" class="form-control qdrat-input" />
                                </div>
                            </div>

                            <div class="col-12 col-lg-4">
                                <div class="qdrat-field">
                                    <label asp-for="EndAt" class="form-label">
                                        <i class="fas fa-calendar-check"></i>
                                        موعد الانتهاء
                                    </label>
                                    <input asp-for="EndAt" type="datetime-local" class="form-control qdrat-input" />
                                </div>
                            </div>

                            <div class="col-12 col-lg-4">
                                <div class="qdrat-field">
                                    <label asp-for="DurationMinutes" class="form-label">
                                        <i class="fas fa-hourglass-half"></i>
                                        مدة الاختبار (دقائق)
                                    </label>
                                    <input asp-for="DurationMinutes" type="number" min="1" class="form-control qdrat-input" />
                                </div>
                            </div>
                        </div>

                        <div class="qdrat-actions mt-4">
                            <button type="submit" class="btn btn-success qdrat-btn-primary">
                                <i class="fas fa-check-circle"></i>
                                إنشاء الاختبار
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary qdrat-btn-outline">
                                <i class="fas fa-times"></i>
                                إلغاء
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-4">
                <div class="qdrat-side-card mb-4">
                    <div class="qdrat-side-icon">
                        <i class="fas fa-user-check"></i>
                    </div>
                    <h5>اختبار فردي دقيق</h5>
                    <p>
                        هذه الصفحة مخصصة لإنشاء اختبار لطالب واحد، مع إمكانية قفل الفرع أو الدفعة أو الطالب حسب مصدر الدخول الحالي.
                    </p>
                </div>

                <div class="qdrat-tips-card mb-4">
                    <h6>
                        <i class="fas fa-lightbulb"></i>
                        ملاحظات تشغيلية
                    </h6>
                    <ul class="mb-0">
                        <li>النموذج الاحترافي يحافظ على توزيع الأسئلة المعتمد.</li>
                        <li>التوليد التلقائي يعتمد على المنهج والمحاور والمؤشرات النشطة.</li>
                        <li>الاختبار الحضوري يحتاج رقمًا مرجعيًا مكونًا من 6 أرقام.</li>
                    </ul>
                </div>

                <div class="qdrat-status-card">
                    <div class="qdrat-status-row">
                        <span><i class="fas fa-building"></i> الفرع</span>
                        <strong>@(lockBranch ? "محدد مسبقًا" : "اختياري")</strong>
                    </div>
                    <div class="qdrat-status-row">
                        <span><i class="fas fa-users"></i> الدفعة</span>
                        <strong>@(lockBatch ? "محددة مسبقًا" : "حسب الفرع")</strong>
                    </div>
                    <div class="qdrat-status-row">
                        <span><i class="fas fa-user"></i> الطالب</span>
                        <strong>@(lockStudent ? "محدد مسبقًا" : "حسب الدفعة")</strong>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<style>
