        background: linear-gradient(135deg, #f8fafc 0%, #eef4ff 100%);
        border: 1px solid #e5edf8;
        border-radius: 22px;
        padding: 24px;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.06);
    }

    .qdrat-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #64748b;
        font-size: 13px;
        flex-wrap: wrap;
    }

        .qdrat-breadcrumb i {
            font-size: 10px;
            color: #94a3b8;
        }

    .qdrat-page-title {
        color: #1e293b;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .qdrat-page-title i,
        .qdrat-card-header i,
        .qdrat-field label i,
        .qdrat-tips-card h6 i {
            color: #2563eb;
        }

    .qdrat-page-subtitle {
        color: #64748b;
        font-size: 15px;
    }

    .qdrat-btn-back,
    .qdrat-btn-primary,
    .qdrat-btn-outline {
        border-radius: 14px;
        padding: 10px 16px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .qdrat-btn-back {
        color: #334155;
        border: 1px solid #e2e8f0;
    }

    .qdrat-card,
    .qdrat-side-card,
    .qdrat-tips-card,
    .qdrat-status-card {
        background: #ffffff;
        border: 1px solid #e5edf8;
        border-radius: 22px;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.06);
        overflow: hidden;
    }

    .qdrat-card-header {
        padding: 18px 22px;
        border-bottom: 1px solid #e5edf8;
        background: #ffffff;
    }

    .qdrat-card-header-soft {
        background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
    }

    .qdrat-card-header h5 {
