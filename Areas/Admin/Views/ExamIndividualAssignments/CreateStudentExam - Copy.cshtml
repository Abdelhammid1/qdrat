@model QdratNew.ViewModels.Exam.CreateStudentExamVm
@{
    ViewData["Title"] = "إنشاء اختبار فردي";
}

<div class="container mt-4" dir="rtl">

    <h3 class="fw-bold text-primary mb-4">
        إنشاء اختبار فردي للطالب
    </h3>

    <form asp-action="CreateStudentExam" method="post" class="card shadow-sm p-4">

        <!-- ========================================================= -->
<!-- عنوان الاختبار -->
<!-- ========================================================= -->
<div class="mb-4">
    <label class="form-label fw-bold">عنوان الاختبار</label>
    <input asp-for="Title" class="form-control"
           placeholder="مثال: اختبار قياس تجريبي - المستوى الأول" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>
        <!-- ========================================================= -->
        <!-- 1) اختيار الفرع -->
        <!-- ========================================================= -->
        <div class="mb-3">
            <label class="form-label fw-bold">الفرع</label>
            <select asp-for="BranchId" class="form-select" id="branchSelect">
                <option value="">-- اختر الفرع --</option>
                @foreach (var b in Model.Branches)
                {
                    <option value="@b.Id">@b.Name</option>
                }
            </select>
        </div>

        <!-- ========================================================= -->
        <!-- 2) اختيار الدفعة -->
        <!-- ========================================================= -->
        <div class="mb-3">
            <label class="form-label fw-bold">الدفعة</label>
            <select asp-for="BatchId" class="form-select" id="batchSelect" disabled>
                <option value="">-- اختر الدفعة --</option>
            </select>
        </div>

        <!-- ========================================================= -->
        <!-- 3) اختيار الطالب -->
        <!-- ========================================================= -->
        <div class="mb-4">
            <label class="form-label fw-bold">الطالب</label>
            <select asp-for="StudentId" class="form-select" id="studentSelect" disabled>
                <option value="">-- اختر الطالب --</option>
            </select>
        </div>

        <hr />

        <!-- ========================================================= -->
        <!-- 4) نوع الاختبار -->
        <!-- ========================================================= -->
        <div class="mb-4">
            <label class="form-label fw-bold">نوع الاختبار</label>

            <div class="form-check">
                <input class="form-check-input" type="radio" name="IsOnline" value="true" checked>
                <label class="form-check-label">أونلاين</label>
            </div>

            <div class="form-check">
                <input class="form-check-input" type="radio" name="IsOnline" value="false">
                <label class="form-check-label">حضوري داخل المعمل</label>
            </div>
        </div>

        <!-- الرقم المرجعي -->
        <div class="mb-4" id="referenceCodeArea" style="display:none;">
            <label class="form-label fw-bold">الرقم المرجعي (6 أرقام)</label>
            <input asp-for="ReferenceCode" maxlength="6"
                   pattern="\d{6}"
                   class="form-control"
                   placeholder="مثال: 123456" />
        </div>

        <hr />

        <!-- ========================================================= -->
        <!-- 5) طريقة التوليد -->
        <!-- ========================================================= -->
        <div class="mb-4">
            <label class="form-label fw-bold">طريقة التوليد</label>
            <select id="generationMode" class="form-select">
                <option value="">-- اختر --</option>
                <option value="model">من نموذج احترافي</option>
                <option value="auto">توليد تلقائي من المحاور</option>
            </select>

            <input type="hidden" asp-for="UseProfessionalModel" id="UseProfessionalModel" />
            <input type="hidden" asp-for="UseAutoGeneration" id="UseAutoGeneration" />
        </div>

        <!-- ========================================================= -->
        <!-- نموذج احترافي -->
        <!-- ========================================================= -->
        <div id="modelArea" class="border rounded p-3 mb-4" style="display:none;">
            <label class="form-label fw-bold">اختر النموذج</label>
            <select asp-for="ProfessionalModelId" class="form-select">
                <option value="">-- اختر النموذج --</option>
                @foreach (var m in Model.ProfessionalModels)
                {
                    <option value="@m.Id">@m.Title</option>
                }
            </select>
        </div>

        <!-- ========================================================= -->
        <!-- توليد تلقائي -->
        <!-- ========================================================= -->
        <div id="autoArea" class="border rounded p-4 mb-4" style="display:none;">

            <div class="mb-3">
                <label class="form-label fw-bold">اختر المنهج</label>
                <select asp-for="CurriculumId" class="form-select" id="curriculumSelector">
                    <option value="">-- اختر المنهج --</option>
                    @foreach (var c in Model.Curriculums)
                    {
                        <option value="@c.Id">@c.Title</option>
                    }
                </select>
            </div>

            <div id="sectionsContainer"></div>

        </div>

        <hr />

        <!-- ========================================================= -->
        <!-- الإعدادات الزمنية -->
        <!-- ========================================================= -->
        <div class="row">
            <div class="col-md-4 mb-3">
                <label>موعد البدء</label>
                <input asp-for="ScheduledDate" type="datetime-local" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label>موعد الانتهاء</label>
                <input asp-for="EndAt" type="datetime-local" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label>مدة الاختبار (دقائق)</label>
                <input asp-for="DurationMinutes" type="number" min="1" class="form-control" />
            </div>
        </div>

        <div class="text-end mt-4">
            <button type="submit" class="btn btn-primary px-5">
                إنشاء الاختبار
            </button>
        </div>

    </form>
</div>

@section Scripts {

    <script>

        // ===========================
        // نوع الاختبار (أونلاين / حضوري)
        // ===========================
        const radios = document.querySelectorAll("input[name='IsOnline']");
        const referenceArea = document.getElementById("referenceCodeArea");

        radios.forEach(r => {
            r.addEventListener("change", function () {
                if (this.value === "false") {
                    referenceArea.style.display = "block";
                } else {
                    referenceArea.style.display = "none";
                }
            });
        });

        // ===========================
        // تحميل الدفعات
        // ===========================
        document.getElementById("branchSelect")
            .addEventListener("change", function () {

                const branchId = this.value;
                const batchSelect = document.getElementById("batchSelect");
                const studentSelect = document.getElementById("studentSelect");

                batchSelect.innerHTML = "<option value=''>-- جاري التحميل --</option>";
                studentSelect.innerHTML = "<option value=''>-- اختر الطالب --</option>";
                studentSelect.disabled = true;

                if (!branchId) return;

                fetch(`/Admin/ExamIndividualAssignments/GetBatchesByBranch?branchId=${branchId}`)
                    .then(r => r.json())
                    .then(data => {

                        batchSelect.innerHTML = "<option value=''>-- اختر الدفعة --</option>";

                        data.forEach(b => {
                            batchSelect.innerHTML += `<option value="${b.id}">${b.name}</option>`;
                        });

                        batchSelect.disabled = false;
                    });
            });

        // ===========================
        // تحميل الطلاب
        // ===========================
        document.getElementById("batchSelect")
            .addEventListener("change", function () {

                const batchId = this.value;
                const studentSelect = document.getElementById("studentSelect");

                studentSelect.innerHTML = "<option value=''>-- جاري التحميل --</option>";

                if (!batchId) return;

                fetch(`/Admin/ExamIndividualAssignments/GetStudentsByBatch?batchId=${batchId}`)
                    .then(r => r.json())
                    .then(data => {

                        studentSelect.innerHTML = "<option value=''>-- اختر الطالب --</option>";

                        data.forEach(s => {
                            studentSelect.innerHTML += `<option value="${s.id}">${s.name}</option>`;
                        });

                        studentSelect.disabled = false;
                    });
            });

        // ===========================
        // وضع التوليد
        // ===========================
        const generationMode = document.getElementById("generationMode");
        const modelArea = document.getElementById("modelArea");
        const autoArea = document.getElementById("autoArea");

        generationMode.addEventListener("change", function () {

            modelArea.style.display = "none";
            autoArea.style.display = "none";

            document.getElementById("UseProfessionalModel").value = "false";
            document.getElementById("UseAutoGeneration").value = "false";

            if (this.value === "model") {
                modelArea.style.display = "block";
                document.getElementById("UseProfessionalModel").value = "true";
            }

            if (this.value === "auto") {
                autoArea.style.display = "block";
                document.getElementById("UseAutoGeneration").value = "true";
            }
        });

        // ===========================
        // تحميل المحاور
        // ===========================
        document.getElementById("curriculumSelector")
            .addEventListener("change", function () {

                const curriculumId = this.value;

                if (!curriculumId) return;

                fetch(`/Admin/ExamAssignments/GetSectionsByCurriculum?curriculumId=${curriculumId}`)
                    .then(r => r.json())
                    .then(data => {

                        let html = "";

                        data.forEach((sec, i) => {

                            html += `
                            <div class="card mb-3 p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong>${sec.title}</strong>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            onclick="loadLessons(${sec.id}, ${i})">
                                        التوزيع
                                    </button>
                                </div>

                                <div id="lessonsContainer_${i}" class="mt-3"></div>

                                <input type="hidden" name="Sections[${i}].SectionId" value="${sec.id}" />
                                <input type="hidden" name="Sections[${i}].SectionTitle" value="${sec.title}" />
                            </div>
                            `;
                        });

                        document.getElementById("sectionsContainer").innerHTML = html;
                    });
            });


        function loadLessons(sectionId, sectionIndex) {

            fetch(`/Admin/ExamIndividualAssignments/GetActiveLessonsBySection?sectionId=${sectionId}`)
                .then(r => r.json())
                .then(data => {

                    let html = "";

                    data.forEach((lesson, lessonIndex) => {

                        html += `
                            <div class="row mb-2 align-items-center">
                                <div class="col-md-8 fw-semibold">
                                    ${lesson.title}
                                </div>
                                <div class="col-md-4">
                                    <input type="number"
                                           min="0"
                                           value="0"
                                           name="Sections[${sectionIndex}].Lessons[${lessonIndex}].QuestionCount"
                                           class="form-control" />

                                    <input type="hidden"
                                           name="Sections[${sectionIndex}].Lessons[${lessonIndex}].LessonId"
                                           value="${lesson.id}" />

                                    <input type="hidden"
                                           name="Sections[${sectionIndex}].Lessons[${lessonIndex}].LessonTitle"
                                           value="${lesson.title}" />
                                </div>
                            </div>
                        `;
                    });

                    document.getElementById(`lessonsContainer_${sectionIndex}`).innerHTML = html;
                });
        }
    </script>

}