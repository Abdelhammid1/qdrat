<style>
    /* هوية لوجو المنصة: تيل #3a7f85 / فحمي #454341 / برتقالي #d9784a */
    .qdrat-page { direction: rtl; text-align: right; }

    .msea-hero {
        background: linear-gradient(135deg, #3a7f85 0%, #48949a 45%, #454341 100%);
        border-radius: 24px; padding: 28px; color: #fff; margin-bottom: 22px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, .16);
        display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
    }
    .msea-hero-icon {
        width: 60px; height: 60px; border-radius: 18px; background: rgba(255,255,255,.16);
        border: 1px solid rgba(255,255,255,.28); display: grid; place-items: center; font-size: 26px; flex-shrink: 0;
    }
    .msea-hero h2 { margin: 0 0 4px; font-size: 1.5rem; font-weight: 800; }
    .msea-hero p { margin: 0; opacity: .92; }
    .msea-hero-meta { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 6px; font-size: .9rem; opacity: .95; }

    /* كروت الإحصائيات */
    .msea-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 14px; margin-bottom: 22px; }
    .msea-stat {
        background: #fff; border: 1px solid #e5e7eb; border-radius: 20px; padding: 16px 18px;
        display: flex; align-items: center; gap: 14px; box-shadow: 0 8px 22px rgba(15, 23, 42, .05);
    }
    .msea-stat-icon { width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center; font-size: 21px; flex-shrink: 0; }
    .msea-stat-icon.teal { background: #e6f1f2; color: #2f6a6f; }
    .msea-stat-icon.charcoal { background: #ecebea; color: #454341; }
    .msea-stat-icon.orange { background: #fbe6da; color: #a8532b; }
    .msea-stat-value { font-size: 24px; font-weight: 900; line-height: 1.1; color: #2b2a29; }
    .msea-stat-label { font-size: 13px; color: #6b6966; margin-top: 2px; }

    /* التابات */
    .msea-nav-tabs { border: none; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
    .msea-nav-tabs .nav-link {
        border: 1px solid #e5e7eb; border-radius: 14px; padding: 10px 18px; font-weight: 700;
        color: #454341; background: #fff; display: inline-flex; align-items: center; gap: 8px; min-height: 44px;
    }
    .msea-nav-tabs .nav-link:hover { border-color: #48949a; color: #2f6a6f; }
    .msea-nav-tabs .nav-link.active { background: linear-gradient(135deg, #3a7f85 0%, #2f6a6f 100%); color: #fff; border-color: transparent; }
    .msea-nav-tabs .nav-link:focus-visible { outline: 3px solid #48949a; outline-offset: 2px; }
    .msea-count { background: rgba(58,127,133,.12); border-radius: 999px; padding: 1px 9px; font-size: 12px; }
    .msea-nav-tabs .nav-link.active .msea-count { background: rgba(255,255,255,.22); }

    /* الكروت */
    .msea-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
    .msea-card {
        background: #fff; border: 1px solid #e5e7eb; border-radius: 20px; padding: 18px;
        box-shadow: 0 8px 22px rgba(15, 23, 42, .05); display: flex; flex-direction: column; gap: 10px;
        transition: box-shadow .2s ease, transform .2s ease;
    }
    .msea-card:hover { box-shadow: 0 16px 34px rgba(15, 23, 42, .10); transform: translateY(-2px); }
    .msea-card-head { display: flex; align-items: center; gap: 12px; }
    .msea-icon {
        width: 46px; height: 46px; border-radius: 14px; background: #e6f1f2; color: #2f6a6f;
        display: grid; place-items: center; font-size: 1.15rem; flex-shrink: 0;
    }
    .msea-icon.orange { background: #fbe6da; color: #a8532b; }
    .msea-card-title { font-weight: 800; font-size: 1rem; color: #2b2a29; margin: 0; overflow-wrap: anywhere; }
    .msea-card-sub { color: #6b6966; font-size: 13px; overflow-wrap: anywhere; }

    .msea-badge {
        display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; padding: 4px 11px;
        font-size: 12px; font-weight: 800; background: #e6f1f2; color: #2f6a6f;
    }
    .msea-badge.orange { background: #fbe6da; color: #a8532b; }
    .msea-exam-chip {
        display: inline-flex; align-items: center; gap: 5px; background: #f3f2f1; color: #454341;
        border-radius: 999px; padding: 4px 11px; font-size: 12px; margin: 2px 0 0 4px;
    }

    .msea-actions { margin-top: auto; display: flex; gap: 8px; }
    .msea-btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px;
        border-radius: 14px; padding: 8px 18px; font-weight: 800; text-decoration: none; border: 1px solid transparent;
        cursor: pointer; transition: background .15s ease, color .15s ease;
    }
    .msea-btn.primary { background: linear-gradient(135deg, #3a7f85 0%, #2f6a6f 100%); color: #fff; box-shadow: 0 10px 22px rgba(58,127,133,.25); }
    .msea-btn.primary:hover { background: #2f6a6f; color: #fff; }
    .msea-btn.outline { background: #fff; color: #2f6a6f; border-color: #48949a; }
    .msea-btn.outline:hover { background: #3a7f85; color: #fff; }
    .msea-btn.grow { flex: 1; }
    .msea-btn:focus-visible { outline: 3px solid #48949a; outline-offset: 2px; }
    .msea-icon-btn { width: 44px; padding: 0; }

    /* البحث */
    .msea-search { position: relative; max-width: 460px; margin-bottom: 12px; }
    .msea-search > i.fa-magnifying-glass { position: absolute; inset-inline-start: 14px; top: 50%; transform: translateY(-50%); color: #48949a; pointer-events: none; }
    .msea-search .form-control { min-height: 46px; border-radius: 14px; padding-inline-start: 40px; padding-inline-end: 44px; }
    .msea-search .form-control:focus { border-color: #48949a; box-shadow: 0 0 0 3px rgba(72,148,154,.2); }
    .msea-search-clear {
        position: absolute; inset-inline-end: 6px; top: 50%; transform: translateY(-50%); width: 34px; height: 34px;
        border: none; border-radius: 10px; background: transparent; color: #6b6966; cursor: pointer;
    }
    .msea-search-clear:hover { background: #e6f1f2; color: #2f6a6f; }
    .msea-search-meta { font-size: 13px; color: #6b6966; margin-bottom: 12px; }
    .msea-card[hidden], .msea-grid[hidden], .msea-empty[hidden] { display: none !important; }

    /* حالات فارغة */
    .msea-empty {
        text-align: center; padding: 36px 16px; border: 2px dashed #d3e7e9; border-radius: 20px;
        background: #f6fafa; color: #6b6966;
    }
    .msea-empty i { font-size: 34px; color: #48949a; display: block; margin-bottom: 10px; }

    /* لوحات داخلية */
    .msea-panel {
        background: #fff; border: 1px solid #e5e7eb; border-radius: 22px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, .06); overflow: hidden; margin-bottom: 18px;
    }
    .msea-panel-head {
        padding: 16px 20px; background: linear-gradient(180deg, #f6fafa 0%, #eef5f5 100%);
        border-bottom: 1px solid #e5e7eb; display: flex; align-items: center; justify-content: space-between; gap: 12px;
    }
    .msea-panel-head h5 { margin: 0; font-weight: 800; color: #2b2a29; display: flex; align-items: center; gap: 8px; }
    .msea-panel-head h5 i { color: #3a7f85; }
    .msea-panel-body { padding: 20px; }

    .msea-table { width: 100%; border-collapse: separate; border-spacing: 0; }
    .msea-table th { font-size: 12.5px; color: #6b6966; font-weight: 800; padding: 10px 12px; border-bottom: 2px solid #e5e7eb; text-align: right; }
    .msea-table td { padding: 12px; border-bottom: 1px solid #eef0f1; vertical-align: middle; }
    .msea-table tr:last-child td { border-bottom: none; }
    .msea-avatar {
        width: 38px; height: 38px; border-radius: 50%; background: #e6f1f2; color: #2f6a6f;
        display: inline-grid; place-items: center; font-weight: 900; flex-shrink: 0;
    }

    .msea-form-row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
    .msea-form-row .form-control, .msea-form-row .form-select { min-height: 44px; border-radius: 12px; }
    .msea-form-row .form-control:focus, .msea-form-row .form-select:focus { border-color: #48949a; box-shadow: 0 0 0 3px rgba(72,148,154,.2); }

    @@media (max-width: 575.98px) {
        .msea-hero { padding: 20px; }
        .msea-grid { grid-template-columns: 1fr; }
        .msea-form-row .form-control, .msea-form-row .form-select, .msea-form-row .msea-btn { width: 100%; max-width: none !important; }
    }
    @@media (prefers-reduced-motion: reduce) { .msea-card { transition: none; } .msea-card:hover { transform: none; } }
</style>
