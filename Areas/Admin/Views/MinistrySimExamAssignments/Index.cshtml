@model QdratNew.ViewModels.Exam.MinistrySimExamAssignmentsOverviewVm
@using System.Linq
@{
    ViewData["Title"] = "إسنادات اختبار معمل القياس";
    var activeTab = Context.Request.Query["tab"].ToString();
    if (string.IsNullOrEmpty(activeTab)) activeTab = "batches";
    var totalBatchAssignments = Model.Batches.Sum(b => b.AssignedExamsCount);
}

@await Html.PartialAsync("_AssignmentsStyles")

<div class="container-fluid py-4 qdrat-page">

    <div class="msea-hero">
        <div class="msea-hero-icon"><i class="fas fa-clipboard-user" aria-hidden="true"></i></div>
        <div>
            <h2>إسنادات اختبار معمل القياس</h2>
            <p>تصفّح مَن أُسنِد له كل اختبار — حسب الدفعة، أو طلاب المعهد المُسنَد لهم فرديًا، أو الطلاب الضيوف.</p>
        </div>
    </div>

    <div class="msea-stats">
        <div class="msea-stat">
            <div class="msea-stat-icon teal"><i class="fas fa-layer-group" aria-hidden="true"></i></div>
            <div><div class="msea-stat-value">@Model.Batches.Count</div><div class="msea-stat-label">دفعات متاحة للإسناد</div></div>
        </div>
        <div class="msea-stat">
            <div class="msea-stat-icon charcoal"><i class="fas fa-file-circle-check" aria-hidden="true"></i></div>
            <div><div class="msea-stat-value">@totalBatchAssignments</div><div class="msea-stat-label">إسنادات على مستوى الدفعات</div></div>
        </div>
        <div class="msea-stat">
            <div class="msea-stat-icon teal"><i class="fas fa-user-check" aria-hidden="true"></i></div>
            <div><div class="msea-stat-value">@Model.InstituteStudents.Count</div><div class="msea-stat-label">طلاب معهد (إسناد فردي)</div></div>
        </div>
        <div class="msea-stat">
            <div class="msea-stat-icon orange"><i class="fas fa-user-tag" aria-hidden="true"></i></div>
            <div><div class="msea-stat-value">@Model.Guests.Count</div><div class="msea-stat-label">طلاب ضيوف</div></div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning">@TempData["Warning"]</div>
    }

    <ul class="nav msea-nav-tabs" id="mseaTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == "batches" ? "active" : "")" id="tab-batches-btn" data-bs-toggle="tab" data-bs-target="#tab-batches" type="button" role="tab">
                <i class="fas fa-layer-group" aria-hidden="true"></i> الدفعات <span class="msea-count">@Model.Batches.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == "students" ? "active" : "")" id="tab-students-btn" data-bs-toggle="tab" data-bs-target="#tab-students" type="button" role="tab">
                <i class="fas fa-user-check" aria-hidden="true"></i> طلاب المعهد (إسناد فردي) <span class="msea-count">@Model.InstituteStudents.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == "guests" ? "active" : "")" id="tab-guests-btn" data-bs-toggle="tab" data-bs-target="#tab-guests" type="button" role="tab">
                <i class="fas fa-user-tag" aria-hidden="true"></i> طلاب ضيوف / زائرين <span class="msea-count">@Model.Guests.Count</span>
            </button>
        </li>
    </ul>

    <div class="tab-content">

        <!-- تاب الدفعات -->
        <div class="tab-pane fade @(activeTab == "batches" ? "show active" : "")" id="tab-batches" role="tabpanel">
            @if (!Model.Batches.Any())
            {
                <div class="msea-empty">
                    <i class="fas fa-layer-group" aria-hidden="true"></i>
                    لا توجد دفعات تابعة لدورات بها اختبار محاكاة وزارة حتى الآن.
                </div>
            }
            else
            {
                <div class="msea-search">
                    <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                    <input type="search" id="mseaBatchSearch" class="form-control" placeholder="ابحث باسم الدفعة أو الدورة..." aria-label="بحث في الدفعات" autocomplete="off" />
                    <button type="button" id="mseaBatchSearchClear" class="msea-search-clear" title="مسح البحث" aria-label="مسح البحث" hidden>
                        <i class="fas fa-xmark" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="msea-search-meta" id="mseaBatchSearchMeta" aria-live="polite" hidden></div>

                <div class="msea-grid" id="mseaBatchGrid">
                    @foreach (var batch in Model.Batches)
                    {
                        <div class="msea-card" data-batch-search="@(batch.Name + " " + batch.CourseName)">
                            <div class="msea-card-head">
                                <div class="msea-icon"><i class="fas fa-layer-group" aria-hidden="true"></i></div>
                                <div>
                                    <h6 class="msea-card-title">@batch.Name</h6>
                                    <div class="msea-card-sub">@batch.CourseName</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="msea-badge"><i class="fas fa-users" aria-hidden="true"></i> @batch.EnrolledStudentsCount طالب</span>
                                <span class="msea-badge orange"><i class="fas fa-file-circle-check" aria-hidden="true"></i> @batch.AssignedExamsCount اختبار مُسنَد</span>
                            </div>
                            <div class="msea-actions">
                                <a asp-action="BatchDetails" asp-route-batchId="@batch.BatchId" class="msea-btn primary msea-icon-btn" title="تفاصيل الدفعة" aria-label="تفاصيل الدفعة: @batch.Name">
                                    <i class="fas fa-eye" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>
                <div class="msea-empty" id="mseaBatchNoResults" hidden>
                    <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                    لا توجد دفعات مطابقة لبحثك.
                </div>
            }
        </div>

        <!-- تاب طلاب المعهد -->
        <div class="tab-pane fade @(activeTab == "students" ? "show active" : "")" id="tab-students" role="tabpanel">
            @if (!Model.InstituteStudents.Any())
            {
                <div class="msea-empty">
                    <i class="fas fa-user-check" aria-hidden="true"></i>
                    لا يوجد طلاب مُسنَد لهم اختبار محاكاة وزارة بشكل فردي حتى الآن.
                </div>
            }
            else
            {
                <div class="msea-panel">
                    <div class="msea-panel-body table-responsive">
                        <table class="msea-table">
                            <thead>
                                <tr>
                                    <th>الطالب</th>
                                    <th>الاختبارات المُسنَدة فرديًا</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.InstituteStudents)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="msea-avatar" aria-hidden="true">@(string.IsNullOrWhiteSpace(s.FullName) ? "؟" : s.FullName.Trim().Substring(0, 1))</span>
                                                <span class="fw-bold">@s.FullName</span>
                                            </div>
                                        </td>
                                        <td>
                                            @foreach (var title in s.AssignedExamTitles)
                                            {
                                                <span class="msea-exam-chip"><i class="fas fa-file-lines" aria-hidden="true"></i> @title</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        <!-- تاب الضيوف -->
        <div class="tab-pane fade @(activeTab == "guests" ? "show active" : "")" id="tab-guests" role="tabpanel">

            <div class="msea-panel" style="max-width:640px;">
                <div class="msea-panel-head">
                    <h5><i class="fas fa-user-plus" aria-hidden="true"></i> إضافة طالب ضيف جديد</h5>
                </div>
                <div class="msea-panel-body">
                    <form method="post" asp-action="CreateGuestStudent" class="msea-form-row">
                        @Html.AntiForgeryToken()
                        <input type="text" name="fullName" class="form-control" placeholder="الاسم الكامل" style="max-width:240px;" required aria-label="الاسم الكامل" />
                        <input type="text" name="phoneNumber" class="form-control" placeholder="رقم الهاتف" style="max-width:190px;" aria-label="رقم الهاتف" />
                        <button type="submit" class="msea-btn primary">
                            <i class="fas fa-plus" aria-hidden="true"></i> إضافة
                        </button>
                    </form>
                </div>
            </div>

            @if (!Model.Guests.Any())
            {
                <div class="msea-empty">
                    <i class="fas fa-user-tag" aria-hidden="true"></i>
                    لا يوجد طلاب ضيوف/زائرين مُضافين حتى الآن.
                </div>
            }
            else
            {
                <div class="msea-grid">
                    @foreach (var guest in Model.Guests)
                    {
                        <div class="msea-card">
                            <div class="msea-card-head">
                                <div class="msea-icon orange"><i class="fas fa-user-tag" aria-hidden="true"></i></div>
                                <div>
                                    <h6 class="msea-card-title">@guest.FullName</h6>
                                    <div class="msea-card-sub"><i class="fas fa-phone ms-1" aria-hidden="true"></i>@(string.IsNullOrEmpty(guest.PhoneNumber) ? "—" : guest.PhoneNumber)</div>
                                </div>
                            </div>
                            <div>
                                @if (!guest.AssignedExamTitles.Any())
                                {
                                    <span class="text-muted small">لا توجد اختبارات مُسنَدة بعد</span>
                                }
                                else
                                {
                                    foreach (var title in guest.AssignedExamTitles)
                                    {
                                        <span class="msea-exam-chip"><i class="fas fa-file-lines" aria-hidden="true"></i> @title</span>
                                    }
                                }
                            </div>
                            <div class="msea-actions">
                                <a asp-action="GuestDetails" asp-route-guestId="@guest.GuestId" class="msea-btn primary msea-icon-btn" title="تفاصيل الضيف" aria-label="تفاصيل الضيف: @guest.FullName">
                                    <i class="fas fa-eye" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>

</div>

@section Scripts {
    <script>
        (function () {
            'use strict';
            var input = document.getElementById('mseaBatchSearch');
            if (!input) return;

            var grid = document.getElementById('mseaBatchGrid');
            var clearBtn = document.getElementById('mseaBatchSearchClear');
            var meta = document.getElementById('mseaBatchSearchMeta');
            var noResults = document.getElementById('mseaBatchNoResults');
            var cards = Array.prototype.slice.call(grid.querySelectorAll('[data-batch-search]'));

            // توحيد النص العربي: إزالة التشكيل وتوحيد الألف والتاء المربوطة والياء
            function normalize(text) {
                return (text || '').toString().toLowerCase()
                    .replace(/[ً-ٰٟـ]/g, '')
                    .replace(/[أإآٱ]/g, 'ا')
                    .replace(/ة/g, 'ه')
                    .replace(/ى/g, 'ي')
                    .replace(/\s+/g, ' ')
                    .trim();
            }

            var index = cards.map(function (c) { return normalize(c.getAttribute('data-batch-search')); });

            function apply() {
                var q = normalize(input.value);
                var terms = q ? q.split(' ') : [];
                var visible = 0;

                cards.forEach(function (card, i) {
                    var match = terms.every(function (t) { return index[i].indexOf(t) !== -1; });
                    card.hidden = !match;
                    if (match) visible++;
                });

                clearBtn.hidden = !q;
                noResults.hidden = visible !== 0;
                grid.hidden = visible === 0;
                meta.hidden = !q;
                meta.textContent = q ? ('النتائج: ' + visible + ' من ' + cards.length) : '';
            }

            input.addEventListener('input', apply);
            clearBtn.addEventListener('click', function () { input.value = ''; apply(); input.focus(); });
            input.addEventListener('keydown', function (e) { if (e.key === 'Escape') { input.value = ''; apply(); } });
        })();
    </script>
}
