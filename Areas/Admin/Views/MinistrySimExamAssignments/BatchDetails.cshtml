@model QdratNew.ViewModels.Exam.MinistrySimExamBatchDetailsVm
@using System.Linq
@{
    ViewData["Title"] = "اختبارات الدفعة — " + Model.BatchName;
}

@await Html.PartialAsync("_AssignmentsStyles")

<div class="container-fluid py-4 qdrat-page">

    <div class="msea-hero">
        <div class="msea-hero-icon"><i class="fas fa-layer-group" aria-hidden="true"></i></div>
        <div>
            <h2>@Model.BatchName</h2>
            <p>@Model.CourseName</p>
        </div>
    </div>

    <div class="msea-stats">
        <div class="msea-stat">
            <div class="msea-stat-icon orange"><i class="fas fa-file-circle-check" aria-hidden="true"></i></div>
            <div><div class="msea-stat-value">@Model.AssignedExams.Count</div><div class="msea-stat-label">اختبارات مُسنَدة</div></div>
        </div>
        <div class="msea-stat">
            <div class="msea-stat-icon teal"><i class="fas fa-file-circle-plus" aria-hidden="true"></i></div>
            <div><div class="msea-stat-value">@Model.AssignableExams.Count</div><div class="msea-stat-label">اختبارات متاحة للإسناد</div></div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning">@TempData["Warning"]</div>
    }

    <div class="msea-panel">
        <div class="msea-panel-head">
            <h5><i class="fas fa-circle-plus" aria-hidden="true"></i> إسناد اختبار جديد لهذه الدفعة</h5>
        </div>
        <div class="msea-panel-body">
            @if (!Model.AssignableExams.Any())
            {
                <div class="msea-empty">
                    <i class="fas fa-file-circle-xmark" aria-hidden="true"></i>
                    لا يوجد اختبار منشور آخر من دورة هذه الدفعة يمكن إسناده حاليًا.
                </div>
            }
            else
            {
                <form method="post" asp-action="AssignExamToBatch" class="msea-form-row">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="batchId" value="@Model.BatchId" />
                    <select name="examId" class="form-select" style="max-width:360px;" required aria-label="اختر الاختبار">
                        <option value="">اختر الاختبار...</option>
                        @foreach (var e in Model.AssignableExams)
                        {
                            <option value="@e.Value">@e.Text</option>
                        }
                    </select>
                    <button type="submit" class="msea-btn primary">
                        <i class="fas fa-check" aria-hidden="true"></i> إسناد
                    </button>
                </form>
            }
        </div>
    </div>

    <div class="msea-panel">
        <div class="msea-panel-head">
            <h5><i class="fas fa-list-check" aria-hidden="true"></i> الاختبارات المُسنَدة حاليًا (@Model.AssignedExams.Count)</h5>
        </div>
        <div class="msea-panel-body">
            @if (!Model.AssignedExams.Any())
            {
                <div class="msea-empty">
                    <i class="fas fa-inbox" aria-hidden="true"></i>
                    لم يُسنَد أي اختبار محاكاة وزارة لهذه الدفعة حتى الآن.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="msea-table">
                        <thead>
                            <tr>
                                <th>العنوان</th>
                                <th>تاريخ الإسناد</th>
                                <th><span class="visually-hidden">إجراءات</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var exam in Model.AssignedExams)
                            {
                                <tr>
                                    <td class="fw-bold"><i class="fas fa-file-lines ms-2" style="color:#3a7f85" aria-hidden="true"></i>@exam.Title</td>
                                    <td><i class="fas fa-calendar-day ms-1 text-muted" aria-hidden="true"></i>@exam.AssignedAt.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <a class="msea-btn outline msea-icon-btn" title="عرض الاختبار" aria-label="عرض الاختبار @exam.Title"
                                           asp-controller="MinistrySimExam" asp-action="Details" asp-route-id="@exam.ExamId">
                                            <i class="fas fa-eye" aria-hidden="true"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <a asp-action="Index" asp-route-tab="batches" class="msea-btn outline">
        <i class="fas fa-arrow-right" aria-hidden="true"></i> رجوع لكل الدفعات
    </a>

</div>
