@model QdratNew.ViewModels.Exam.MinistrySimExamGuestDetailsVm
@using System.Linq
@{
    ViewData["Title"] = "اختبارات الضيف — " + Model.FullName;
}

<style>
    .qdrat-page { direction: rtl; text-align: right; }

    .qdrat-hero {
        background: linear-gradient(135deg, #0f172a 0%, #7e22ce 48%, #a21caf 100%);
        border-radius: 24px; padding: 28px; color: #fff; margin-bottom: 24px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, .18);
    }

    .qdrat-card {
        background: #fff; border: 1px solid #e5e7eb; border-radius: 22px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, .06); overflow: hidden; margin-bottom: 18px;
    }

    .qdrat-card-header {
        padding: 17px 20px; background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 1px solid #e5e7eb; display: flex; align-items: center; justify-content: space-between; gap: 12px;
    }

    .qdrat-card-body { padding: 20px; }

    .qdrat-btn-primary {
        border: none; border-radius: 16px; padding: 10px 22px; font-weight: 900;
        background: linear-gradient(135deg, #a21caf 0%, #86198f 100%); color: #fff;
        box-shadow: 0 12px 24px rgba(162,28,175,.22);
    }
</style>

<div class="container-fluid py-4 qdrat-page">

    <div class="qdrat-hero">
        <h2 class="mb-1"><i class="bi bi-person-badge ms-2"></i> @Model.FullName</h2>
        <p class="mb-0" style="opacity:.9">
            <i class="bi bi-telephone ms-1"></i> @(string.IsNullOrEmpty(Model.PhoneNumber) ? "—" : Model.PhoneNumber)
            <span class="ms-2">طالب ضيف/زائر — غير منتمٍ لأي دورة أو دفعة</span>
        </p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning">@TempData["Warning"]</div>
    }

    <div class="qdrat-card">
        <div class="qdrat-card-header">
            <h5 class="mb-0"><i class="bi bi-plus-circle ms-1"></i> إسناد اختبار جديد لهذا الضيف</h5>
        </div>
        <div class="qdrat-card-body">
            @if (!Model.AssignableExams.Any())
            {
                <p class="text-muted mb-0">لا يوجد اختبار منشور آخر يمكن إسناده حاليًا.</p>
            }
            else
            {
                <form method="post" asp-action="AssignExamToGuest" class="d-flex flex-wrap gap-2 align-items-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="guestId" value="@Model.GuestId" />
                    <select name="examId" class="form-select" style="max-width:380px;" required>
                        <option value="">اختر الاختبار...</option>
                        @foreach (var e in Model.AssignableExams)
                        {
                            <option value="@e.Value">@e.Text</option>
                        }
                    </select>
                    <button type="submit" class="btn qdrat-btn-primary">
                        <i class="bi bi-check2 ms-1"></i> إسناد
                    </button>
                </form>
            }
        </div>
    </div>

    <div class="qdrat-card">
        <div class="qdrat-card-header">
            <h5 class="mb-0"><i class="bi bi-list-check ms-1"></i> الاختبارات المُسنَدة حاليًا (@Model.AssignedExams.Count)</h5>
        </div>
        <div class="qdrat-card-body">
            @if (!Model.AssignedExams.Any())
            {
                <p class="text-muted mb-0">لم يُسنَد أي اختبار محاكاة وزارة لهذا الضيف حتى الآن.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>العنوان</th>
                                <th>تاريخ الإسناد</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var exam in Model.AssignedExams)
                            {
                                <tr>
                                    <td>@exam.Title</td>
                                    <td>@exam.AssignedAt.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <a class="btn btn-outline-secondary btn-sm" asp-controller="MinistrySimExam" asp-action="Details" asp-route-id="@exam.ExamId">
                                            <i class="bi bi-eye ms-1"></i> عرض الاختبار
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <a asp-action="Index" asp-route-tab="guests" class="btn btn-outline-secondary px-4">
        <i class="bi bi-arrow-right ms-1"></i> رجوع لكل الضيوف
    </a>

</div>
