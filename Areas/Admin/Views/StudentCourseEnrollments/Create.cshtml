@model QdratNew.ViewModels.Students.StudentCourseEnrollmentRegisterViewModel

@{
    ViewData["Title"] = "تسجيل طالب في دورة";
}

<h2 class="text-primary mb-4">تسجيل طالب في دورة</h2>

<form asp-action="Create" method="post" class="card p-4 shadow-sm">

    <div class="mb-3">
        <label asp-for="StudentId" class="form-label"></label>
        <select asp-for="StudentId" asp-items="Model.Students" class="form-select">
            <option value="">-- اختر الطالب --</option>
        </select>
        <span asp-validation-for="StudentId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CourseId" class="form-label"></label>
        <select asp-for="CourseId" asp-items="Model.Courses" class="form-select">
            <option value="">-- اختر الدورة --</option>
        </select>
        <span asp-validation-for="CourseId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">حفظ التسجيل</button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
