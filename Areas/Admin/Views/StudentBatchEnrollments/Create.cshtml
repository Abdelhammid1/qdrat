@model QdratNew.ViewModels.StudentBatchEnrollments.StudentBatchEnrollmentFormViewModel
@{
    ViewData["Title"] = "إضافة ربط طالب بالدفعة";
}

<div class="qdrat-page" dir="rtl">

    <div class="qdrat-hero mb-4">
        <div>
            <div class="qdrat-kicker">
                <i class="bi bi-person-plus"></i>
                ربط طالب بدفعة
            </div>

            <h2 class="qdrat-title">إضافة ربط طالب بالدفعة</h2>

            <p class="qdrat-subtitle">
                اختر الطالب ثم حدد الدفعات المرتبطة به مع تاريخ التسجيل وحالة الارتباط داخل النظام.
            </p>
        </div>

        <div class="qdrat-hero-icon">
            <i class="bi bi-people"></i>
        </div>
    </div>

    <div class="qdrat-card">
        <div class="qdrat-card-header">
            <div>
                <h5>
                    <i class="bi bi-diagram-3"></i>
                    بيانات الربط
                </h5>
                <p>
                    لا يتم تغيير منطق الحفظ الحالي؛ فقط حدد الطالب والدفعات ثم اضغط حفظ.
                </p>
            </div>
        </div>

        <div class="qdrat-card-body">
            <form asp-action="Create" method="post" autocomplete="off">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert qdrat-alert qdrat-alert-danger mb-4"></div>

                <div class="row g-4">

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="StudentID" class="form-label">الطالب</label>
                            <div class="qdrat-input-wrap">
                                <i class="bi bi-person-badge"></i>
                                <select asp-for="StudentID" class="form-select" asp-items="Model.Students"></select>
                            </div>
                            <span asp-validation-for="StudentID" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <div class="qdrat-field">
                            <label asp-for="EnrolledAt" class="form-label">تاريخ التسجيل</label>
                            <div class="qdrat-input-wrap">
                                <i class="bi bi-calendar-event"></i>
                                <input asp-for="EnrolledAt" type="date" class="form-control" />
                            </div>
                            <span asp-validation-for="EnrolledAt" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <div class="qdrat-field">
                            <label asp-for="Status" class="form-label">الحالة</label>
                            <div class="qdrat-input-wrap">
                                <i class="bi bi-shield-check"></i>
                                <input asp-for="Status" class="form-control" placeholder="مثال: نشط" />
                            </div>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="qdrat-batches-panel">
                            <div class="qdrat-batches-head">
                                <div>
                                    <label class="form-label fw-bold mb-1">الدفعات</label>
                                    <p>اختر دفعة واحدة أو أكثر للطالب حسب الارتباط المطلوب.</p>
                                </div>
                                <span class="qdrat-badge">
                                    <i class="bi bi-check2-square"></i>
                                    اختيار متعدد
                                </span>
                            </div>

                            <div class="qdrat-batches-grid">
                                @foreach (var batch in Model.Batches)
                                {
                                    <input type="checkbox"
                                           class="btn-check"
                                           name="SelectedBatchIds"
                                           value="@batch.Value"
                                           id="batch-@batch.Value"
                                           autocomplete="off"
                                           @(batch.Selected ? "checked" : "")>

                                    <label class="qdrat-batch-choice" for="batch-@batch.Value">
                                        <span class="qdrat-batch-check">
                                            <i class="bi bi-check-lg"></i>
                                        </span>
                                        <span>@batch.Text</span>
                                    </label>
                                }
                            </div>
                        </div>
                    </div>

                </div>

                <div class="qdrat-actions">
                    <a asp-action="Index" class="btn qdrat-btn qdrat-btn-light">
                        <i class="bi bi-arrow-right"></i>
                        إلغاء
                    </a>

                    <button type="submit" class="btn qdrat-btn qdrat-btn-primary">
                        <i class="bi bi-check-circle"></i>
                        حفظ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .qdrat-page {
        padding: 24px;
        background: #f5f7fb;
        min-height: calc(100vh - 80px);
        font-family: inherit;
    }

    .qdrat-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 26px;
        border-radius: 24px;
        background: linear-gradient(135deg, #102a43 0%, #1d4ed8 58%, #38bdf8 100%);
        color: #fff;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
    }

    .qdrat-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .qdrat-title {
        margin: 0;
        font-size: 28px;
        font-weight: 900;
        letter-spacing: -0.5px;
    }

    .qdrat-subtitle {
        margin: 10px 0 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 15px;
        line-height: 1.8;
        max-width: 850px;
    }

    .qdrat-hero-icon {
        width: 74px;
        height: 74px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.16);
        font-size: 34px;
        flex: 0 0 auto;
    }

    .qdrat-card {
        border: 1px solid #e5e7eb;
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    .qdrat-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #edf0f5;
        background: #fff;
    }

        .qdrat-card-header h5 {
            margin: 0;
            color: #0f172a;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .qdrat-card-header h5 i {
                color: #2563eb;
            }

        .qdrat-card-header p {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 14px;
        }

    .qdrat-card-body {
        padding: 24px;
    }

    .qdrat-field .form-label {
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 9px;
    }

    .qdrat-input-wrap {
        position: relative;
    }

        .qdrat-input-wrap > i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 3;
            pointer-events: none;
        }

        .qdrat-input-wrap .form-control,
        .qdrat-input-wrap .form-select {
            min-height: 48px;
            border-radius: 15px;
            border-color: #dbe3ef;
            padding-right: 42px;
            font-weight: 700;
        }

            .qdrat-input-wrap .form-control:focus,
            .qdrat-input-wrap .form-select:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 0.22rem rgba(37, 99, 235, 0.12);
            }

    .qdrat-batches-panel {
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        padding: 18px;
        background: #f8fafc;
    }

    .qdrat-batches-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 16px;
    }

        .qdrat-batches-head p {
            margin: 0;
            color: #64748b;
            font-size: 13px;
            font-weight: 700;
        }

    .qdrat-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border-radius: 999px;
        background: #eff6ff;
        color: #1d4ed8;
        padding: 8px 12px;
        font-size: 12px;
        font-weight: 900;
        white-space: nowrap;
    }

    .qdrat-batches-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .qdrat-batch-choice {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        border: 1px solid #cbd5e1;
        background: #fff;
        color: #334155;
        border-radius: 999px;
        padding: 10px 14px;
        font-weight: 900;
        cursor: pointer;
        transition: all 0.16s ease;
        user-select: none;
    }

        .qdrat-batch-choice:hover {
            border-color: #2563eb;
            color: #1d4ed8;
            box-shadow: 0 10px 20px rgba(37, 99, 235, 0.10);
        }

    .qdrat-batch-check {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        border: 1px solid #cbd5e1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        color: transparent;
        background: #f8fafc;
    }

    .btn-check:checked + .qdrat-batch-choice {
        background: #16a34a;
        border-color: #16a34a;
        color: #fff;
        box-shadow: 0 12px 25px rgba(22, 163, 74, 0.22);
    }

        .btn-check:checked + .qdrat-batch-choice .qdrat-batch-check {
            background: rgba(255, 255, 255, 0.18);
            border-color: rgba(255, 255, 255, 0.45);
            color: #fff;
        }

    .qdrat-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 26px;
        margin-top: 28px;
        border-top: 1px solid #edf0f5;
    }

    .qdrat-btn {
        min-height: 46px;
        border-radius: 14px;
        padding: 10px 24px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .qdrat-btn-primary {
        background: #16a34a;
        border-color: #16a34a;
        color: #fff;
    }

        .qdrat-btn-primary:hover {
            background: #15803d;
            border-color: #15803d;
            color: #fff;
        }

    .qdrat-btn-light {
        background: #f8fafc;
        border-color: #dbe3ef;
        color: #334155;
    }

        .qdrat-btn-light:hover {
            background: #eef2f7;
            border-color: #cbd5e1;
            color: #0f172a;
        }

    .qdrat-alert {
        border: 0;
        border-radius: 18px;
        padding: 15px 18px;
        font-weight: 800;
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.07);
    }

        .qdrat-alert:empty {
            display: none;
        }

    .qdrat-alert-danger {
        color: #991b1b;
        background: #fee2e2;
    }

    @@media (max-width: 768px) {
        .qdrat-page {
            padding: 14px;
        }

        .qdrat-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 20px;
        }

        .qdrat-title {
            font-size: 23px;
        }

        .qdrat-hero-icon {
            width: 58px;
            height: 58px;
            font-size: 26px;
        }

        .qdrat-card-body,
        .qdrat-card-header {
            padding: 18px;
        }

        .qdrat-batches-head {
            flex-direction: column;
        }

        .qdrat-actions {
            flex-direction: column-reverse;
        }

        .qdrat-btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
