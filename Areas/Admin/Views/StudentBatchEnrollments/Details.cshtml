        --bg: #f4f6fb;
        --bg-2: #eef1f8;
        --surface: #ffffff;
        --border: #e5e8f0;
        --green: #059669;
        --green-lt: #d1fae5;
        --green-dk: #064e3b;
        --blue: #2563eb;
        --blue-lt: #dbeafe;
        --blue-dk: #1e3a8a;
        --amber: #d97706;
        --amber-lt: #fef3c7;
        --amber-dk: #78350f;
        --red: #dc2626;
        --red-lt: #fee2e2;
