@using QdratNew.ViewModels.StudentBatchEnrollments
@model StudentBatchEnrollmentDetailsViewModel

@{
    ViewData["Title"] = "تفاصيل ربط الطالب بالدفعات";

    var relatedBatches = Model.RelatedBatches != null
        ? Model.RelatedBatches
        : new List<StudentBatchEnrollmentRelatedBatchVm>();

    var totalBatchLinks = relatedBatches.Count;
    var otherBatchLinks = relatedBatches.Count(x => !x.IsCurrent);

    var activeBatchLinks = relatedBatches.Count(x =>
        !string.IsNullOrWhiteSpace(x.Status)
        && (x.Status == "نشط" || x.Status == "Active"));

    var inactiveBatchLinks = totalBatchLinks - activeBatchLinks;

    var isMultiBatchStudent = totalBatchLinks > 1;

    var isActive = !string.IsNullOrWhiteSpace(Model.Status)
                   && (Model.Status == "نشط" || Model.Status == "Active");

    var statusCss = ResolveStatusCss(Model.Status);
    var recentCss = ResolveRecentCss(Model.EnrolledAt);
    var recentText = ResolveRecentText(Model.EnrolledAt);

    var daysSinceEnrollment = (DateTime.Today - Model.EnrolledAt.Date).Days;
    if (daysSinceEnrollment < 0)
    {
        daysSinceEnrollment = 0;
    }

    var healthScore = CalculateHealthScore(isActive, totalBatchLinks, activeBatchLinks);
    var ringCircumference = 251.2;
    var ringOffset = ringCircumference * (1 - (healthScore / 100.0));

    string SafeText(string? value, string fallback = "غير محدد")
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

    string BuildAvatar(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "ط";
        }

        var cleaned = name.Trim();
        var parts = cleaned.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
        {
            return (parts[0].Substring(0, 1) + parts[1].Substring(0, 1)).ToUpper();
        }

        return cleaned.Substring(0, Math.Min(2, cleaned.Length)).ToUpper();
    }

    string ResolveStatusCss(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return "neutral";
        }

        if (status == "نشط" || status == "Active")
        {
            return "active";
        }

        if (status.Contains("موقوف") || status.Contains("غير") || status.Contains("Inactive"))
        {
            return "danger";
        }

        return "warning";
    }

    string ResolveRecentCss(DateTime enrolledAt)
    {
        if (enrolledAt.Date == DateTime.Today)
        {
            return "today";
        }

        if (enrolledAt.Date >= DateTime.Today.AddDays(-6))
        {
            return "week";
        }

        return "old";
    }

    string ResolveRecentText(DateTime enrolledAt)
    {
        if (enrolledAt.Date == DateTime.Today)
        {
            return "تم الربط اليوم";
        }

        if (enrolledAt.Date >= DateTime.Today.AddDays(-6))
        {
            return "تم الربط هذا الأسبوع";
        }

        return "ربط سابق";
    }

    int CalculateHealthScore(bool currentIsActive, int linksCount, int activeLinksCount)
    {
        var score = currentIsActive ? 82 : 45;

        if (linksCount > 1)
        {
            score += 10;
        }

        if (linksCount > 1 && activeLinksCount == linksCount)
        {
            score += 6;
        }

        if (activeLinksCount == 0 && linksCount > 0)
        {
            score -= 20;
        }

        if (score > 98)
        {
            score = 98;
        }

        if (score < 25)
        {
            score = 25;
        }

        return score;
    }

    string BuildHealthLabel(int score)
    {
        if (score >= 90)
        {
            return "مميز";
        }

        if (score >= 80)
        {
            return "مستقر";
        }

        if (score >= 60)
        {
            return "يحتاج متابعة";
        }

        return "غير مستقر";
    }

    string BuildHealthCss(int score)
    {
        if (score >= 90)
        {
            return "vip";
        }

        if (score >= 80)
        {
            return "ex";
        }

        if (score >= 60)
        {
            return "wn";
        }

        return "dg";
    }
}

<div class="enrollment-details-page" dir="rtl">

    <nav class="enrollment-topnav">
        <div class="nav-brand">
            <span class="nav-logo">قدرات</span>
            <div class="nav-sep"></div>
            <div class="nav-breadcrumb">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index">لوحة التحكم</a>
                <span>›</span>
                <a asp-area="Admin" asp-controller="StudentBatchEnrollments" asp-action="Index">ربط الطلاب بالدفعات</a>
                <span>›</span>
                <span class="current">ملف ربط الطالب</span>
            </div>
        </div>

        <div class="nav-actions">
            <a class="nav-btn" asp-area="Admin" asp-controller="StudentBatchEnrollments" asp-action="Index">
                <i class="fas fa-arrow-right"></i>
                رجوع
            </a>

            <a class="nav-btn primary" asp-area="Admin" asp-controller="StudentBatchEnrollments" asp-action="Edit" asp-route-id="@Model.Id">
                <i class="fas fa-edit"></i>
                تعديل الربط الحالي
            </a>
        </div>
    </nav>

    <div class="enrollment-page">

        <section class="enrollment-hero enrollment-fade d1 @(isMultiBatchStudent ? "multi-hero" : "")">
            <div class="hero-content">
                <div class="hero-left">
                    <div class="hero-avatar">
                        @BuildAvatar(Model.StudentName)
                    </div>

                    <div class="hero-info">
                        <div class="hero-title-line">
                            <h1>ملف ارتباط الطالب بالدفعات</h1>

                            @if (isMultiBatchStudent)
                            {
                                <span class="vip-badge">
                                    <i class="fas fa-crown"></i>
                                    طالب متعدد الدفعات
                                </span>
                            }
                        </div>

                        <div class="hero-meta">
                            <span class="hero-tag @statusCss">
                                <i class="fas fa-circle"></i>
                                الرابط الحالي: @SafeText(Model.Status)
                            </span>

                            <span class="hero-tag info">
                                <i class="fas fa-user-graduate"></i>
                                @SafeText(Model.StudentName, "طالب غير محدد")
                            </span>

                            <span class="hero-tag neutral">
                                <i class="fas fa-users"></i>
                                الدفعة الحالية: @SafeText(Model.BatchName, "دفعة غير محددة")
                            </span>

                            <span class="hero-tag @(isMultiBatchStudent ? "vip" : "neutral")">
                                <i class="fas fa-layer-group"></i>
                                @totalBatchLinks دفعة مرتبطة
                            </span>

                            <span class="hero-tag @recentCss">
                                <i class="fas fa-clock"></i>
                                @recentText
                            </span>
                        </div>

                        @if (isMultiBatchStudent)
                        {
                            <div class="multi-message">
                                <i class="fas fa-star"></i>
                                هذا الطالب لديه اشتراك في أكثر من دفعة، ويجب التعامل معه كطالب عالي القيمة داخل المنصة مع متابعة محتواه وواجباته واختباراته حسب كل دفعة.
                            </div>
                        }
                        else
                        {
                            <p class="hero-desc">
                                هذه الصفحة تعرض علاقة الطالب بالدفعة ككيان تشغيلي مستقل. الربط هو الأساس الذي تُبنى عليه الواجبات، الاختبارات، الحضور، والتحليلات التعليمية داخل المنصة.
                            </p>
                        }

                        <div class="hero-actions">
                            <a class="hbtn outline" asp-area="Admin" asp-controller="StudentBatchEnrollments" asp-action="Index">
                                <i class="fas fa-list"></i>
                                قائمة الروابط
                            </a>

                            <a class="hbtn solid-blue" asp-area="Admin" asp-controller="StudentBatchEnrollments" asp-action="Edit" asp-route-id="@Model.Id">
                                <i class="fas fa-edit"></i>
                                تعديل الربط الحالي
                            </a>

                            <a class="hbtn solid-cyan" asp-area="Admin" asp-controller="Batches" asp-action="Details" asp-route-id="@Model.BatchId">
                                <i class="fas fa-users"></i>
                                فتح الدفعة الحالية
                            </a>

                            <a class="hbtn solid-red" asp-area="Admin" asp-controller="StudentBatchEnrollments" asp-action="Delete" asp-route-id="@Model.Id">
                                <i class="fas fa-trash-alt"></i>
                                حذف الربط
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="health-ring-wrap">
                <div class="health-ring">
                    <svg viewBox="0 0 100 100" aria-hidden="true">
                        <circle class="ring-bg" cx="50" cy="50" r="40"></circle>
                        <circle class="ring-fill"
                                cx="50"
                                cy="50"
                                r="40"
                                stroke="@(healthScore >= 90 ? "#7c3aed" : healthScore >= 80 ? "#059669" : healthScore >= 60 ? "#d97706" : "#dc2626")"
                                stroke-dasharray="251.2"
                                stroke-dashoffset="@ringOffset.ToString("0.##")"></circle>
                    </svg>
                    <div class="ring-val">
                        @healthScore
                        <small>%</small>
                    </div>
                </div>

                <div class="health-label">
                    قيمة الارتباط
                    <span class="@BuildHealthCss(healthScore)">@BuildHealthLabel(healthScore)</span>
                </div>
            </div>
        </section>

        <section class="kpi-strip">

            <article class="kpi-card b enrollment-fade d1">
                <div class="kpi-icon b">
                    <i class="fas fa-hashtag"></i>
                </div>
                <div class="kpi-val">@Model.Id</div>
                <div class="kpi-label">الرابط الحالي</div>
                <div class="kpi-delta eq">المعرف التشغيلي للعلاقة المفتوحة</div>
            </article>

            <article class="kpi-card @(isMultiBatchStudent ? "vip" : "g") enrollment-fade d2">
                <div class="kpi-icon @(isMultiBatchStudent ? "vip" : "g")">
                    <i class="fas fa-layer-group"></i>
                </div>
                <div class="kpi-val">@totalBatchLinks</div>
                <div class="kpi-label">دفعات مرتبطة بالطالب</div>
                <div class="kpi-delta @(isMultiBatchStudent ? "vip" : "eq")">
                    @(isMultiBatchStudent ? "ميزة اشتراك متعددة" : "دفعة واحدة")
                </div>
            </article>

            <article class="kpi-card g enrollment-fade d3">
                <div class="kpi-icon g">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="kpi-val">@activeBatchLinks</div>
                <div class="kpi-label">روابط نشطة</div>
                <div class="kpi-delta @(inactiveBatchLinks == 0 ? "up" : "dn")">
                    @(inactiveBatchLinks == 0 ? "كل الروابط مستقرة" : inactiveBatchLinks + " روابط تحتاج مراجعة")
                </div>
            </article>

            <article class="kpi-card a enrollment-fade d4">
                <div class="kpi-icon a">
                    <i class="fas fa-calendar-alt"></i>
                </div>
                <div class="kpi-val">@Model.EnrolledAt.ToString("yyyy/MM/dd")</div>
                <div class="kpi-label">تاريخ الرابط الحالي</div>
                <div class="kpi-delta eq">@recentText</div>
            </article>

            <article class="kpi-card p enrollment-fade d5">
                <div class="kpi-icon p">
                    <i class="fas fa-hourglass-half"></i>
                </div>
                <div class="kpi-val">@daysSinceEnrollment</div>
                <div class="kpi-label">أيام منذ الربط الحالي</div>
                <div class="kpi-delta eq">من تاريخ @Model.EnrolledAt.ToString("yyyy/MM/dd")</div>
            </article>

        </section>

        @if (isMultiBatchStudent)
        {
            <section class="student-value-section enrollment-fade d2">
                <div class="value-left">
                    <div class="value-icon">
                        <i class="fas fa-crown"></i>
                    </div>
                    <div>
                        <h2>طالب عالي القيمة داخل المنصة</h2>
                        <p>
                            الطالب مشترك في @totalBatchLinks دفعات. هذا يعني أنه يتلقى محتوى وتعليمات واختبارات من أكثر من مسار، لذلك يجب أن تظهر هذه المعلومة بوضوح للأدمن قبل أي تعديل أو حذف لأي ربط.
                        </p>
                    </div>
                </div>

                <div class="value-stats">
                    <div>
                        <strong>@totalBatchLinks</strong>
                        <span>إجمالي الدفعات</span>
                    </div>
                    <div>
                        <strong>@activeBatchLinks</strong>
                        <span>نشطة</span>
                    </div>
                    <div>
                        <strong>@otherBatchLinks</strong>
                        <span>غير الرابط الحالي</span>
                    </div>
                </div>
            </section>
        }

        <section class="section-block enrollment-fade d3">
            <div class="section-title-row">
                <div class="section-heading">
                    <div class="section-accent vip"></div>
                    <div>
                        <h2>ملف الاشتراك متعدد الدفعات</h2>
                        <p>كل الدفعات المرتبط بها الطالب، مع تمييز الرابط الحالي بوضوح.</p>
                    </div>
                </div>

                <span class="section-badge @(isMultiBatchStudent ? "vip" : "neutral")">
                    @totalBatchLinks روابط
                </span>
            </div>

            <div class="batch-subscription-grid">
                @if (relatedBatches.Any())
                {
                    foreach (var item in relatedBatches)
                    {
                        var itemStatusCss = ResolveStatusCss(item.Status);
                        var itemRecentCss = ResolveRecentCss(item.EnrolledAt);
                        var itemRecentText = ResolveRecentText(item.EnrolledAt);

                        <article class="batch-subscription-card @(item.IsCurrent ? "current" : "")">
                            <div class="batch-card-top">
                                <div class="batch-icon">
                                    <i class="fas fa-users"></i>
                                </div>

                                <div class="batch-title">
                                    <strong>@SafeText(item.BatchName, "دفعة غير محددة")</strong>
                                    <span>ربط رقم @item.EnrollmentId</span>
                                </div>

                                @if (item.IsCurrent)
                                {
                                    <span class="current-badge">
                                        <i class="fas fa-location-dot"></i>
                                        الرابط المفتوح
                                    </span>
                                }
                            </div>

                            <div class="batch-card-meta">
                                <span class="status-pill @itemStatusCss">
                                    <i class="fas fa-circle"></i>
                                    @SafeText(item.Status)
                                </span>

                                <span class="recent-pill @itemRecentCss">
                                    <i class="fas fa-clock"></i>
                                    @itemRecentText
                                </span>

                                <span class="date-pill">
                                    <i class="fas fa-calendar-alt"></i>
                                    @item.EnrolledAt.ToString("yyyy/MM/dd")
                                </span>
                            </div>

                            <div class="batch-card-actions">
                                <a asp-area="Admin"
                                   asp-controller="StudentBatchEnrollments"
                                   asp-action="Details"
                                   asp-route-id="@item.EnrollmentId"
                                   class="mini-action view">
                                    <i class="fas fa-eye"></i>
                                    تفاصيل الربط
                                </a>

                                <a asp-area="Admin"
                                   asp-controller="Batches"
                                   asp-action="Details"
                                   asp-route-id="@item.BatchId"
                                   class="mini-action batch">
                                    <i class="fas fa-layer-group"></i>
                                    فتح الدفعة
                                </a>

                                <a asp-area="Admin"
                                   asp-controller="StudentBatchEnrollments"
                                   asp-action="Edit"
                                   asp-route-id="@item.EnrollmentId"
                                   class="mini-action edit">
                                    <i class="fas fa-edit"></i>
                                    تعديل
                                </a>
                            </div>
                        </article>
                    }
                }
                else
                {
                    <div class="empty-related">
                        لا توجد دفعات مرتبطة بهذا الطالب.
                    </div>
                }
            </div>
        </section>

        <section class="main-grid">

            <div class="left-stack">

                <section class="dash-card enrollment-fade d4">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent blue"></div>
                            <div>
                                <div class="ch-title">الرابط الحالي المفتوح</div>
                                <div class="ch-sub">العلاقة التي دخل عليها الأدمن الآن</div>
                            </div>
                        </div>

                        <span class="section-badge current">Current Link</span>
                    </div>

                    <div class="relationship-map">
                        <div class="relation-node student-node">
                            <div class="node-avatar">@BuildAvatar(Model.StudentName)</div>
                            <div>
                                <span>الطالب</span>
                                <strong>@SafeText(Model.StudentName, "طالب غير محدد")</strong>
                            </div>
                        </div>

                        <div class="relation-line">
                            <div class="line-dot"></div>
                            <div class="line-text">الرابط الحالي منذ @Model.EnrolledAt.ToString("yyyy/MM/dd")</div>
                            <div class="line-dot"></div>
                        </div>

                        <div class="relation-node batch-node">
                            <div class="node-avatar">
                                <i class="fas fa-users"></i>
                            </div>
                            <div>
                                <span>الدفعة الحالية</span>
                                <strong>@SafeText(Model.BatchName, "دفعة غير محددة")</strong>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="dash-card enrollment-fade d5">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent cyan"></div>
                            <div>
                                <div class="ch-title">بيانات الرابط الحالي</div>
                                <div class="ch-sub">البيانات المحفوظة في سجل الربط المفتوح</div>
                            </div>
                        </div>
                    </div>

                    <div class="details-grid">
                        <div class="detail-item">
                            <span>رقم الربط</span>
                            <strong>@Model.Id</strong>
                        </div>

                        <div class="detail-item">
                            <span>رقم الطالب</span>
                            <strong>@Model.StudentID</strong>
                        </div>

                        <div class="detail-item">
                            <span>رقم الدفعة</span>
                            <strong>@Model.BatchId</strong>
                        </div>

                        <div class="detail-item">
                            <span>اسم الطالب</span>
                            <strong>@SafeText(Model.StudentName, "طالب غير محدد")</strong>
                        </div>

                        <div class="detail-item">
                            <span>اسم الدفعة الحالية</span>
                            <strong>@SafeText(Model.BatchName, "دفعة غير محددة")</strong>
                        </div>

                        <div class="detail-item">
                            <span>تاريخ الربط</span>
                            <strong>@Model.EnrolledAt.ToString("yyyy/MM/dd HH:mm")</strong>
                        </div>

                        <div class="detail-item">
                            <span>حالة الربط</span>
                            <strong>@SafeText(Model.Status)</strong>
                        </div>

                        <div class="detail-item">
                            <span>تصنيف الفترة</span>
                            <strong>@recentText</strong>
                        </div>

                        <div class="detail-item">
                            <span>عدد الدفعات الكلي</span>
                            <strong>@totalBatchLinks</strong>
                        </div>
                    </div>
                </section>

                <section class="dash-card enrollment-fade d6">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent amber"></div>
                            <div>
                                <div class="ch-title">أثر الربط داخل المنصة</div>
                                <div class="ch-sub">ما الذي يعتمد على صحة علاقة الطالب بالدفعة؟</div>
                            </div>
                        </div>
                    </div>

                    <div class="impact-grid">
                        <div class="impact-item">
                            <i class="fas fa-calendar-check"></i>
                            <div>
                                <strong>الحضور</strong>
                                <span>تسجيل حضور الطالب داخل محاضرات الدفعة يعتمد على وجود هذا الربط.</span>
                            </div>
                        </div>

                        <div class="impact-item">
                            <i class="fas fa-file-alt"></i>
                            <div>
                                <strong>الواجبات</strong>
                                <span>ظهور الواجبات للطالب يتم بناءً على الدفعات التي يرتبط بها.</span>
                            </div>
                        </div>

                        <div class="impact-item">
                            <i class="fas fa-vial"></i>
                            <div>
                                <strong>الاختبارات</strong>
                                <span>إرسال الاختبارات المخصصة للدفعة يصل إلى الطالب من خلال علاقة الربط.</span>
                            </div>
                        </div>

                        <div class="impact-item">
                            <i class="fas fa-chart-line"></i>
                            <div>
                                <strong>التحليلات</strong>
                                <span>تقارير أداء الطالب داخل كل دفعة تعتمد على صحة واستمرار هذا الربط.</span>
                            </div>
                        </div>
                    </div>
                </section>

            </div>

            <aside class="right-stack">

                <section class="dash-card enrollment-fade d3">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent ink"></div>
                            <div>
                                <div class="ch-title">التشخيص التشغيلي</div>
                                <div class="ch-sub">قراءة مباشرة لحالة الطالب وروابطه</div>
                            </div>
                        </div>
                    </div>

                    <div class="diag-section">
                        @if (isMultiBatchStudent)
                        {
                            <div class="diag-item">
                                <div class="diag-icon vip">
                                    <i class="fas fa-crown"></i>
                                </div>
                                <div>
                                    <div class="diag-title">طالب متعدد الدفعات</div>
                                    <div class="diag-body">هذا الطالب مرتبط بأكثر من دفعة. لا تتعامل مع الرابط الحالي بمعزل عن باقي الدفعات.</div>
                                </div>
                            </div>
                        }

                        @if (isActive)
                        {
                            <div class="diag-item">
                                <div class="diag-icon str">
                                    <i class="fas fa-check-circle"></i>
                                </div>
                                <div>
                                    <div class="diag-title">الرابط الحالي نشط</div>
                                    <div class="diag-body">العلاقة الحالية تعمل ويمكن الاعتماد عليها في الحضور والواجبات والاختبارات.</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="diag-item">
                                <div class="diag-icon risk">
                                    <i class="fas fa-exclamation-triangle"></i>
                                </div>
                                <div>
                                    <div class="diag-title">الرابط الحالي يحتاج مراجعة</div>
                                    <div class="diag-body">حالة الربط ليست نشطة. راجع السبب قبل الاعتماد على هذه العلاقة في العمليات التعليمية.</div>
                                </div>
                            </div>
                        }

                        @if (inactiveBatchLinks > 0)
                        {
                            <div class="diag-item">
                                <div class="diag-icon risk">
                                    <i class="fas fa-link-slash"></i>
                                </div>
                                <div>
                                    <div class="diag-title">روابط غير نشطة</div>
                                    <div class="diag-body">يوجد @inactiveBatchLinks روابط غير نشطة لهذا الطالب ضمن دفعاته.</div>
                                </div>
                            </div>
                        }

                        @if (Model.EnrolledAt.Date == DateTime.Today)
                        {
                            <div class="diag-item">
                                <div class="diag-icon opp">
                                    <i class="fas fa-calendar-day"></i>
                                </div>
                                <div>
                                    <div class="diag-title">ربط جديد اليوم</div>
                                    <div class="diag-body">تم إنشاء الرابط الحالي اليوم، تأكد من ظهور المحتوى والاختبارات المناسبة.</div>
                                </div>
                            </div>
                        }
                        else if (Model.EnrolledAt.Date >= DateTime.Today.AddDays(-6))
                        {
                            <div class="diag-item">
                                <div class="diag-icon opp">
                                    <i class="fas fa-clock"></i>
                                </div>
                                <div>
                                    <div class="diag-title">ربط حديث</div>
                                    <div class="diag-body">الرابط الحالي تم إنشاؤه خلال آخر 7 أيام. راجع اكتمال ظهور المحتوى التعليمي للطالب.</div>
                                </div>
                            </div>
                        }
                    </div>
                </section>

                <section class="dash-card enrollment-fade d4">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent green"></div>
                            <div>
                                <div class="ch-title">حالة الارتباط</div>
                                <div class="ch-sub">مؤشر مختصر لقيمة واستقرار الربط</div>
                            </div>
                        </div>
                    </div>

                    <div class="status-panel">
                        <div class="status-big @(isMultiBatchStudent ? "vip" : statusCss)">
                            <i class="fas @(isMultiBatchStudent ? "fa-crown" : "fa-link")"></i>
                            <strong>@(isMultiBatchStudent ? "طالب متعدد الدفعات" : SafeText(Model.Status))</strong>
                            <span>
                                @(isMultiBatchStudent
                                                                ? "هذا الطالب له أكثر من مسار داخل المنصة"
                                                                : (isActive ? "العلاقة الحالية تعمل بشكل طبيعي" : "العلاقة الحالية تحتاج مراجعة"))
                            </span>
                        </div>

                        <div class="progress-item">
                            <div class="progress-head">
                                <span>قيمة الارتباط</span>
                                <b>@healthScore%</b>
                            </div>
                            <div class="progress-track">
                                <div style="width:@healthScore%;background:@(healthScore >= 90 ? "var(--purple)" : healthScore >= 80 ? "var(--green)" : healthScore >= 60 ? "var(--amber)" : "var(--red)")"></div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="dash-card enrollment-fade d5">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent red"></div>
                            <div>
                                <div class="ch-title">إجراءات سريعة</div>
                                <div class="ch-sub">روابط مباشرة للعمليات الأساسية</div>
                            </div>
                        </div>
                    </div>

                    <div class="quick-actions">
                        <a asp-area="Admin" asp-controller="StudentBatchEnrollments" asp-action="Edit" asp-route-id="@Model.Id" class="quick-action edit">
                            <i class="fas fa-edit"></i>
                            <span>تعديل الرابط الحالي</span>
                        </a>

                        <a asp-area="Admin" asp-controller="Batches" asp-action="Details" asp-route-id="@Model.BatchId" class="quick-action batch">
                            <i class="fas fa-users"></i>
                            <span>فتح الدفعة الحالية</span>
                        </a>

                        <a asp-area="Admin" asp-controller="StudentBatchEnrollments" asp-action="Delete" asp-route-id="@Model.Id" class="quick-action delete">
                            <i class="fas fa-trash-alt"></i>
                            <span>حذف الرابط الحالي</span>
                        </a>

                        <a asp-area="Admin" asp-controller="StudentBatchEnrollments" asp-action="Index" class="quick-action back">
                            <i class="fas fa-list"></i>
                            <span>كل الروابط</span>
                        </a>
                    </div>
                </section>

            </aside>
        </section>

    </div>
</div>

<style>
    .enrollment-details-page {
