@model QdratNew.ViewModels.Batch.BatchViewModel

<h2><i class="fas fa-trash-alt"></i> حذف الدفعة</h2>

<div class="alert alert-warning">
    هل أنت متأكد من حذف الدفعة: <strong>@Model.Name</strong>؟
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> حذف</button>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> إلغاء</a>
</form>
