<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('archiveSearch');
        const genderFilter = document.getElementById('genderFilter');
        const contentFilter = document.getElementById('contentFilter');
        const resetBtn = document.getElementById('resetFilters');
        const resetEmptyBtn = document.getElementById('resetFiltersFromEmpty');
        const cards = Array.from(document.querySelectorAll('.archive-batch-card'));
        const visibleCount = document.getElementById('visibleCount');
        const noResults = document.getElementById('noResults');

        function normalize(value) {
            return (value || '').toString().trim().toLowerCase();
        }

        function applyFilters() {
            const search = normalize(searchInput ? searchInput.value : '');
            const gender = (genderFilter ? genderFilter.value : '').trim();
            const content = (contentFilter ? contentFilter.value : '').trim();

            let shown = 0;

            cards.forEach(function (card) {
                const cardSearch = normalize(card.getAttribute('data-search'));
                const cardGender = (card.getAttribute('data-gender') || '').trim();
                const cardContentState = card.getAttribute('data-content-state') || '';

                const matchSearch = search === '' || cardSearch.indexOf(search) !== -1;
                const matchGender = gender === '' || cardGender === gender;
                const matchContent = content === '' || cardContentState.indexOf(content) !== -1;

                const visible = matchSearch && matchGender && matchContent;

                card.style.display = visible ? '' : 'none';

                if (visible) {
                    shown++;
                }
            });

            if (visibleCount) {
                visibleCount.textContent = shown;
            }

            if (noResults) {
                noResults.classList.toggle('d-none', shown !== 0);
            }
        }

        function resetFilters() {
            if (searchInput) {
                searchInput.value = '';
            }

            if (genderFilter) {
                genderFilter.value = '';
            }

            if (contentFilter) {
                contentFilter.value = '';
            }

            applyFilters();
        }

        if (searchInput) {
            searchInput.addEventListener('input', applyFilters);
        }

        if (genderFilter) {
            genderFilter.addEventListener('change', applyFilters);
        }

        if (contentFilter) {
            contentFilter.addEventListener('change', applyFilters);
        }

        if (resetBtn) {
            resetBtn.addEventListener('click', resetFilters);
        }

        if (resetEmptyBtn) {
            resetEmptyBtn.addEventListener('click', resetFilters);
        }

        applyFilters();
    });
</script>
