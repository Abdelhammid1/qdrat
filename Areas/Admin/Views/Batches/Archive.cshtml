@model IEnumerable<QdratNew.ViewModels.Batch.BatchArchiveViewModel>

@{
    ViewData["Title"] = "أرشيف الدفعات";

    var batches = Model?.ToList() ?? new List<QdratNew.ViewModels.Batch.BatchArchiveViewModel>();

    int totalArchived = ViewBag.TotalArchived != null
        ? (int)ViewBag.TotalArchived
        : batches.Count;

    DateTime? lastArchivedAt = ViewBag.LastArchivedAt as DateTime?;

    var batchesWithStudentsCount = batches.Count(b => b.StudentsCount > 0);
    var batchesWithoutStudentsCount = batches.Count(b => b.StudentsCount == 0);
    var batchesWithLecturesCount = batches.Count(b => b.LecturesCount > 0);
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

<div class="qdrat-archive-batches-page" dir="rtl">

    <section class="archive-hero-card">
        <div class="hero-content">
            <div class="hero-icon">
                <i class="fa-solid fa-box-archive"></i>
            </div>
            <div>
                <div class="hero-label">إدارة الأرشيف</div>
                <h1>أرشيف الدفعات</h1>
                <p>
                    جميع الدفعات المؤرشفة محفوظة هنا مع إمكانية مراجعة بياناتها واسترجاعها عند الحاجة.
                </p>
            </div>
        </div>

        <div class="hero-actions">
            <a asp-area="Admin"
               asp-controller="Batches"
               asp-action="Index"
               class="btn-hero secondary">
                <i class="fa-solid fa-arrow-right"></i>
                العودة للدفعات
            </a>
        </div>
    </section>

    <section class="archive-kpi-grid">
        <div class="kpi-card purple">
            <div class="kpi-icon">
                <i class="fa-solid fa-boxes-stacked"></i>
            </div>
            <div class="kpi-body">
                <span>إجمالي المؤرشف</span>
                <strong>@totalArchived</strong>
                <small>دفعة داخل الأرشيف</small>
            </div>
        </div>

        <div class="kpi-card amber">
            <div class="kpi-icon">
                <i class="fa-solid fa-clock-rotate-left"></i>
            </div>
            <div class="kpi-body">
                <span>آخر أرشفة</span>
                <strong>@(lastArchivedAt.HasValue? lastArchivedAt.Value.ToString("yyyy/MM/dd") : "—")</strong>
                <small>@(lastArchivedAt.HasValue? lastArchivedAt.Value.ToString("HH:mm") : "لا يوجد تاريخ")</small>
            </div>
        </div>

        <div class="kpi-card blue">
            <div class="kpi-icon">
                <i class="fa-solid fa-users"></i>
            </div>
            <div class="kpi-body">
                <span>دفعات بها طلاب</span>
                <strong>@batchesWithStudentsCount</strong>
                <small>مقابل @batchesWithoutStudentsCount بدون طلاب</small>
            </div>
        </div>

        <div class="kpi-card green">
            <div class="kpi-icon">
                <i class="fa-solid fa-chalkboard-user"></i>
            </div>
            <div class="kpi-body">
                <span>دفعات بها محاضرات</span>
                <strong>@batchesWithLecturesCount</strong>
                <small>مؤرشفة مع سجل تعليمي</small>
            </div>
        </div>
    </section>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="system-alert success">
            <i class="fa-solid fa-circle-check"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="system-alert danger">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <section class="archive-toolbar-card">
        <div class="toolbar-title">
            <div>
                <span>فلترة الأرشيف</span>
                <strong>تحكم سريع في الدفعات المعروضة</strong>
            </div>
        </div>

        <div class="toolbar-grid">
            <div class="filter-field search">
                <label for="archiveSearch">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    بحث سريع
                </label>
                <input id="archiveSearch"
                       type="text"
                       class="qdrat-input"
                       autocomplete="off"
                       placeholder="ابحث باسم الدفعة أو الدورة أو المستخدم..." />
            </div>

            <div class="filter-field">
                <label for="genderFilter">
                    <i class="fa-solid fa-venus-mars"></i>
                    النوع
                </label>
                <select id="genderFilter" class="qdrat-input">
                    <option value="">كل الأنواع</option>
                    <option value="ذكور">ذكور</option>
                    <option value="إناث">إناث</option>
                    <option value="مختلط">مختلط</option>
                </select>
            </div>

            <div class="filter-field">
                <label for="contentFilter">
                    <i class="fa-solid fa-layer-group"></i>
                    حالة المحتوى
                </label>
                <select id="contentFilter" class="qdrat-input">
                    <option value="">كل الحالات</option>
                    <option value="has-students">بها طلاب</option>
                    <option value="no-students">بدون طلاب</option>
                    <option value="has-lectures">بها محاضرات</option>
                    <option value="no-lectures">بدون محاضرات</option>
                </select>
            </div>

            <div class="filter-actions">
                <button type="button" id="resetFilters" class="btn-reset">
                    <i class="fa-solid fa-rotate-right"></i>
                    إعادة ضبط
                </button>
            </div>
        </div>
    </section>

    <section class="archive-list-card">
        <div class="list-head">
            <div>
                <span>سجل الأرشيف</span>
                <h2>الدفعات المؤرشفة</h2>
            </div>

            <div class="list-counter">
                المعروض:
                <strong id="visibleCount">@batches.Count</strong>
                من
                <strong>@batches.Count</strong>
            </div>
        </div>

        @if (!batches.Any())
        {
            <div class="empty-state">
                <i class="fa-regular fa-folder-open"></i>
                <strong>الأرشيف فارغ</strong>
                <span>لا توجد دفعات مؤرشفة حاليًا.</span>
                <a asp-area="Admin"
                   asp-controller="Batches"
                   asp-action="Index"
                   class="empty-link">
                    العودة لإدارة الدفعات
                </a>
            </div>
        }
        else
        {
            <div class="archive-card-grid" id="archiveCards">
                @foreach (var batch in batches)
                {
                    var avatar = BuildAvatar(batch.Name);
                    var searchText = $"{batch.Name} {batch.CourseName} {batch.Gender} {batch.ArchivedByUserName}".ToLower();
                    var contentState = ResolveContentState(batch);

                    <article class="archive-batch-card"
                             data-search="@searchText"
                             data-gender="@batch.Gender"
                             data-content-state="@contentState">
                        <div class="card-top">
                            <div class="batch-identity">
                                <div class="batch-avatar">@avatar</div>
                                <div>
                                    <h3>@SafeText(batch.Name, "دفعة بدون اسم")</h3>
                                    <span>رقم الدفعة: @batch.Id</span>
                                </div>
                            </div>

                            <span class="archive-badge">
                                <i class="fa-solid fa-box-archive"></i>
                                مؤرشفة
                            </span>
                        </div>

                        <div class="batch-course-line">
                            <i class="fa-solid fa-book-open"></i>
                            <span>@SafeText(batch.CourseName, "دورة غير محددة")</span>
                        </div>

                        <div class="mini-stat-grid">
                            <div class="mini-stat">
                                <span>النوع</span>
                                <strong>
                                    <i class="fa-solid fa-venus-mars"></i>
                                    @SafeText(batch.Gender, "غير محدد")
                                </strong>
                            </div>

                            <div class="mini-stat">
                                <span>الطلاب</span>
                                <strong>
                                    <i class="fa-solid fa-user-graduate"></i>
                                    @batch.StudentsCount
                                </strong>
                            </div>

                            <div class="mini-stat">
                                <span>المحاضرات</span>
                                <strong class="@(batch.LecturesCount > 0 ? "ok" : "danger")">
                                    <i class="fa-solid fa-chalkboard-user"></i>
                                    @batch.LecturesCount
                                </strong>
                            </div>
                        </div>

                        <div class="timeline-box">
                            <div class="timeline-row">
                                <span>
                                    <i class="fa-solid fa-play"></i>
                                    البداية
                                </span>
                                <strong>@batch.StartDate.ToString("yyyy/MM/dd")</strong>
                            </div>

                            <div class="timeline-row">
                                <span>
                                    <i class="fa-solid fa-flag-checkered"></i>
                                    النهاية
                                </span>
                                <strong>@(batch.EndDate.HasValue? batch.EndDate.Value.ToString("yyyy/MM/dd") : "مفتوحة")</strong>
                            </div>

                            <div class="timeline-row archive-date">
                                <span>
                                    <i class="fa-solid fa-calendar-xmark"></i>
                                    تاريخ الأرشفة
                                </span>
                                <strong>
                                    @(batch.ArchivedAt.HasValue? batch.ArchivedAt.Value.ToString("yyyy/MM/dd - HH:mm") : "غير محدد")
                                </strong>
                            </div>
                        </div>

                        <div class="archived-by">
                            <span>
                                <i class="fa-solid fa-user-shield"></i>
                                أرشف بواسطة
                            </span>
                            <strong>@SafeText(batch.ArchivedByUserName, "غير محدد")</strong>
                        </div>

                        <div class="card-actions">
                            @if (User.IsInRole("Owner") || User.IsInRole("Developer"))
                            {
                                <a asp-area="Admin"
                                   asp-controller="Batches"
                                   asp-action="Students"
                                   asp-route-batchId="@batch.Id"
                                   class="action-btn students"
                                   title="إدارة طلاب هذه الدفعة والتحكم في إمكانية دخولهم لاريا الطالب">
                                    <i class="fa-solid fa-user-graduate"></i>
                                    الطلاب
                                </a>
                            }

                            <a asp-area="Admin"
                               asp-controller="InstructorBatchPermissions"
                               asp-action="ManageBatch"
                               asp-route-id="@batch.Id"
                               class="action-btn permissions"
                               title="إدارة صلاحيات المدربين والموظفين لهذه الدفعة">
                                <i class="fa-solid fa-user-lock"></i>
                                الصلاحيات
                            </a>

                            <form asp-area="Admin"
                                  asp-controller="Batches"
                                  asp-action="RestoreBatchesByIds"
                                  method="post"
                                  class="restore-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="selectedBatchIds" value="@batch.Id" />
                                <input type="hidden" name="returnToArchive" value="true" />
                                <button type="submit"
                                        class="action-btn restore"
                                        onclick="return confirm('سيتم إخراج دفعة &quot;@batch.Name&quot; من الأرشيف. هل تريد المتابعة؟')">
                                    <i class="fa-solid fa-rotate-left"></i>
                                    استرجاع
                                </button>
                            </form>
                        </div>
                    </article>
                }
            </div>

            <div id="noResults" class="empty-state d-none">
                <i class="fa-solid fa-filter-circle-xmark"></i>
                <strong>لا توجد نتائج مطابقة</strong>
                <span>غيّر كلمات البحث أو أعد ضبط الفلاتر.</span>
                <button type="button" id="resetFiltersFromEmpty" class="empty-link as-button">
                    إعادة ضبط الفلاتر
                </button>
            </div>
        }
    </section>
</div>

@functions {
    string SafeText(string? value, string fallback = "غير محدد")
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

    string BuildAvatar(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "دف";
        }

        var cleaned = name.Trim();
        var parts = cleaned.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
        {
            return (parts[0].Substring(0, 1) + parts[1].Substring(0, 1)).ToUpper();
        }

        return cleaned.Substring(0, Math.Min(2, cleaned.Length)).ToUpper();
    }

    string ResolveContentState(QdratNew.ViewModels.Batch.BatchArchiveViewModel batch)
    {
        var states = new List<string>();

        states.Add(batch.StudentsCount > 0 ? "has-students" : "no-students");
        states.Add(batch.LecturesCount > 0 ? "has-lectures" : "no-lectures");

        return string.Join(" ", states);
    }
}

<style>
    .qdrat-archive-batches-page {
        --font: 'Cairo','Tahoma',sans-serif;
        --ink: #101827;
        --ink-soft: #334155;
        --muted: #64748b;
        --muted-2: #94a3b8;
        --surface: #ffffff;
        --page-bg: #f4f7fb;
        --line: #e5eaf2;
        --line-2: #dbe3ef;
        --purple: #7c3aed;
        --purple-dark: #4c1d95;
        --purple-soft: #ede9fe;
        --blue: #2563eb;
        --blue-dark: #1e3a8a;
        --blue-soft: #dbeafe;
        --green: #059669;
        --green-dark: #064e3b;
        --green-soft: #d1fae5;
        --amber: #d97706;
        --amber-dark: #78350f;
        --amber-soft: #fef3c7;
        --red: #dc2626;
        --red-dark: #7f1d1d;
        --red-soft: #fee2e2;
        --shadow: 0 18px 40px rgba(15,23,42,.07);
        --shadow-sm: 0 8px 20px rgba(15,23,42,.05);
        --radius: 20px;
        --radius-sm: 14px;
        min-height: 100vh;
        padding: 24px;
        background: radial-gradient(circle at top right, rgba(124,58,237,.09), transparent 34%), linear-gradient(180deg, #f8fafc 0%, var(--page-bg) 100%);
        color: var(--ink);
        font-family: var(--font);
    }

        .qdrat-archive-batches-page *,
        .qdrat-archive-batches-page *::before,
        .qdrat-archive-batches-page *::after {
            box-sizing: border-box;
        }

        .qdrat-archive-batches-page a {
            text-decoration: none;
        }

    .archive-hero-card {
        border-radius: 26px;
        padding: 24px;
        margin-bottom: 16px;
        background: linear-gradient(135deg, rgba(76,29,149,.96), rgba(124,58,237,.94)), radial-gradient(circle at top left, rgba(255,255,255,.26), transparent 30%);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        box-shadow: var(--shadow);
        overflow: hidden;
        position: relative;
    }

        .archive-hero-card::after {
            content: "";
            position: absolute;
            inset-inline-start: -60px;
            bottom: -80px;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: rgba(255,255,255,.10);
            pointer-events: none;
        }

    .hero-content {
        display: flex;
        align-items: center;
        gap: 16px;
        position: relative;
        z-index: 1;
    }

    .hero-icon {
        width: 64px;
        height: 64px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.20);
        font-size: 26px;
        flex-shrink: 0;
    }

    .hero-label {
        color: #ddd6fe;
        font-size: 12px;
        font-weight: 900;
        margin-bottom: 4px;
    }

    .archive-hero-card h1 {
        margin: 0;
        font-size: 25px;
        font-weight: 900;
        letter-spacing: -.4px;
    }

    .archive-hero-card p {
        margin: 7px 0 0;
        max-width: 650px;
        font-size: 13px;
        font-weight: 600;
        line-height: 1.8;
        color: rgba(255,255,255,.78);
    }

    .hero-actions {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-hero {
        min-height: 42px;
        border-radius: 13px;
        padding: 10px 15px;
        font-size: 12.5px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: .18s ease;
        white-space: nowrap;
    }

        .btn-hero.secondary {
            background: rgba(255,255,255,.14);
            color: #fff;
            border: 1px solid rgba(255,255,255,.20);
        }

        .btn-hero:hover {
            color: #fff;
            transform: translateY(-1px);
            background: rgba(255,255,255,.20);
        }

    .archive-kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 16px;
    }

    .kpi-card {
        background: rgba(255,255,255,.92);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 16px;
        display: flex;
        gap: 13px;
        align-items: center;
        box-shadow: var(--shadow-sm);
        position: relative;
        overflow: hidden;
    }

        .kpi-card::before {
            content: "";
            position: absolute;
            inset-inline-start: 14px;
            inset-inline-end: 14px;
            bottom: 0;
            height: 3px;
            border-radius: 999px 999px 0 0;
        }

        .kpi-card.purple::before {
            background: var(--purple);
        }

        .kpi-card.amber::before {
            background: var(--amber);
        }

        .kpi-card.blue::before {
            background: var(--blue);
        }

        .kpi-card.green::before {
            background: var(--green);
        }

    .kpi-icon {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
        flex-shrink: 0;
    }

    .kpi-card.purple .kpi-icon {
        background: var(--purple-soft);
        color: var(--purple-dark);
    }

    .kpi-card.amber .kpi-icon {
        background: var(--amber-soft);
        color: var(--amber-dark);
    }

    .kpi-card.blue .kpi-icon {
        background: var(--blue-soft);
        color: var(--blue-dark);
    }

    .kpi-card.green .kpi-icon {
        background: var(--green-soft);
        color: var(--green-dark);
    }

    .kpi-body span {
        display: block;
        color: var(--muted);
        font-size: 11.5px;
        font-weight: 900;
        margin-bottom: 5px;
    }

    .kpi-body strong {
        display: block;
        color: var(--ink);
        font-size: 25px;
        line-height: 1;
        font-weight: 900;
    }

    .kpi-body small {
        display: block;
        color: var(--muted-2);
        font-size: 10.5px;
        font-weight: 800;
        margin-top: 7px;
    }

    .system-alert {
        border-radius: var(--radius-sm);
        padding: 13px 16px;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        font-weight: 800;
        border: 1px solid;
    }

        .system-alert.success {
            background: var(--green-soft);
            color: var(--green-dark);
            border-color: rgba(5,150,105,.18);
        }

        .system-alert.danger {
            background: var(--red-soft);
            color: var(--red-dark);
            border-color: rgba(220,38,38,.18);
        }

    .archive-toolbar-card,
    .archive-list-card {
        background: rgba(255,255,255,.96);
        border: 1px solid var(--line);
        border-radius: 24px;
        box-shadow: var(--shadow-sm);
    }

    .archive-toolbar-card {
        padding: 18px;
        margin-bottom: 16px;
    }

    .toolbar-title {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
    }

        .toolbar-title span,
        .list-head span {
            display: block;
            color: var(--purple);
            font-size: 11.5px;
            font-weight: 900;
            margin-bottom: 3px;
        }

        .toolbar-title strong {
            display: block;
            color: var(--ink);
            font-size: 15px;
            font-weight: 900;
        }

    .toolbar-grid {
        display: grid;
        grid-template-columns: minmax(220px, 2fr) minmax(160px, 1fr) minmax(160px, 1fr) auto;
        gap: 12px;
        align-items: end;
    }

    .filter-field label {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 7px;
        color: var(--ink-soft);
        font-size: 11.5px;
        font-weight: 900;
    }

        .filter-field label i {
            color: var(--purple);
        }

    .qdrat-input {
        width: 100%;
        min-height: 44px;
        border-radius: 14px;
        border: 1px solid var(--line-2);
        background: #fff;
        color: var(--ink);
        padding: 9px 12px;
        font-family: var(--font);
        font-size: 12.5px;
        font-weight: 700;
        outline: none;
        transition: .16s ease;
    }

        .qdrat-input:focus {
            border-color: var(--purple);
            box-shadow: 0 0 0 3px rgba(124,58,237,.10);
        }

    .filter-actions {
        display: flex;
        align-items: end;
    }

    .btn-reset {
        min-height: 44px;
        border-radius: 14px;
        border: 1px solid var(--line-2);
        background: #f1f5f9;
        color: var(--ink-soft);
        padding: 0 15px;
        font-family: var(--font);
        font-size: 12px;
        font-weight: 900;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        transition: .16s ease;
    }

        .btn-reset:hover {
            background: var(--red-soft);
            border-color: rgba(220,38,38,.20);
            color: var(--red-dark);
        }

    .archive-list-card {
        overflow: hidden;
    }

    .list-head {
        padding: 18px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        border-bottom: 1px solid var(--line);
        background: linear-gradient(180deg,#ffffff,#f8fafc);
    }

        .list-head h2 {
            margin: 0;
            color: var(--ink);
            font-size: 16px;
            font-weight: 900;
        }

    .list-counter {
        background: #f1f5f9;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 8px 13px;
        color: var(--ink-soft);
        font-size: 11.5px;
        font-weight: 900;
        white-space: nowrap;
    }

        .list-counter strong {
            color: var(--purple);
