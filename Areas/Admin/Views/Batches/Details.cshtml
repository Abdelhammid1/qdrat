        background: var(--mute-3);
        border-radius: 2px;
        margin: 8px 0 4px;
        overflow: hidden;
    }

    .inst-activity-fill {
        height: 100%;
        border-radius: 2px;
        transition: width .7s ease;
    }

    .inst-score-label {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        font-size: 10px;
        color: var(--mute);
    }

    .inst-perf-btn {
        display: block;
        margin-top: 12px;
        padding: 8px 12px;
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        color: #fff;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        text-align: center;
        text-decoration: none;
        transition: opacity .2s, transform .15s;
    }

    .inst-perf-btn:hover {
        opacity: .88;
        transform: translateY(-1px);
        color: #fff;
    }

    .diag-section {
        padding: 14px 18px;
    }

    .diag-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 11px 0;
        border-bottom: 1px solid var(--border);
    }

        .diag-item:last-child {
            border-bottom: none;
        }

    .diag-icon {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
        margin-top: 1px;
    }

        .diag-icon.str {
            background: var(--green-lt);
        }

        .diag-icon.wkn {
            background: var(--amber-lt);
        }

        .diag-icon.opp {
            background: var(--blue-lt);
        }

        .diag-icon.risk {
            background: var(--red-lt);
        }

    .diag-title {
        font-size: 12.5px;
        font-weight: 800;
        color: var(--ink);
    }

    .diag-body {
        font-size: 11.5px;
        color: var(--mute);
        line-height: 1.65;
        margin-top: 2px;
    }

    .att-month {
        padding: 14px 18px;
    }

    .att-week-labels {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        margin-bottom: 4px;
    }

    .att-wl {
        text-align: center;
        font-size: 9px;
        color: var(--mute-2);
        font-weight: 800;
    }

    .att-grid-cal {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 3px;
    }

    .att-day {
        aspect-ratio: 1;
        border-radius: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 9.5px;
        font-weight: 800;
        cursor: default;
        transition: .12s;
    }

        .att-day:hover {
            transform: scale(1.06);
        }

        .att-day.high {
            background: var(--green-lt);
            color: var(--green-dk);
        }

        .att-day.mid {
            background: var(--amber-lt);
            color: var(--amber-dk);
        }

        .att-day.low {
            background: var(--red-lt);
            color: var(--red-dk);
        }

        .att-day.no-lecture {
            background: var(--bg-2);
            color: var(--mute-2);
        }

        .att-day.today {
            outline: 2px solid var(--blue);
            outline-offset: 1px;
        }

    .att-legend {
        display: flex;
        gap: 12px;
        margin-top: 10px;
        font-size: 10px;
        color: var(--mute);
        flex-wrap: wrap;
    }

        .att-legend i {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 2px;
            margin-left: 3px;
            vertical-align: -1px;
        }

    .prog-item {
        margin-bottom: 12px;
    }

        .prog-item:last-child {
            margin-bottom: 0;
        }

    .prog-head {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        font-size: 11.5px;
        margin-bottom: 4px;
    }

        .prog-head span {
            font-weight: 700;
            color: var(--ink-3);
        }

        .prog-head b {
            font-weight: 800;
            color: var(--ink);
        }

            .prog-head b span {
                color: var(--mute);
                font-weight: 500;
            }

    .prog-track {
        height: 7px;
        background: var(--bg-2);
        border-radius: 4px;
        overflow: hidden;
        border: 1px solid var(--border);
    }

    .prog-fill {
        height: 100%;
        border-radius: 4px;
        transition: width .7s ease;
    }

    .heatmap-wrap {
        padding: 12px 18px 16px;
    }

    .hm-days {
        display: flex;
        gap: 4px;
        margin-bottom: 2px;
    }

    .hm-day {
        flex: 1;
        text-align: center;
        font-size: 9.5px;
        color: var(--mute-2);
        font-weight: 800;
    }

    .hm-row {
        display: flex;
        gap: 4px;
        margin-bottom: 4px;
    }

    .hm-cell {
        flex: 1;
        height: 28px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 800;
        cursor: default;
        transition: .15s;
    }

        .hm-cell:hover {
            transform: scale(1.05);
        }

    .full-section {
        margin-top: 18px;
    }

    .sec-label {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
    }

    .sec-label-line {
        width: 4px;
        height: 20px;
        border-radius: 2px;
        background: var(--ink);
    }

    .sec-label h2 {
        font-size: 15px;
        font-weight: 800;
        color: var(--ink);
        margin: 0;
    }

    .sec-label p {
        font-size: 12px;
        color: var(--mute);
        margin: 1px 0 0;
    }

    .students-split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin-bottom: 18px;
    }

    .student-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 11px 18px;
        border-bottom: 1px solid var(--border);
        cursor: default;
        transition: .12s;
    }

        .student-row:last-child {
            border-bottom: none;
        }

        .student-row:hover {
            background: var(--bg-2);
        }

    .risk-row {
        background: #fff5f5;
    }

    .st-rank {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 800;
        flex-shrink: 0;
    }

    .top .st-rank {
        background: linear-gradient(135deg, #fbbf24, #f59e0b);
        color: #fff;
    }

    .bottom .st-rank {
        background: var(--red-lt);
        color: var(--red-dk);
    }

    .st-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 800;
        flex-shrink: 0;
    }

    .top-avatar {
        background: var(--green-lt);
        color: var(--green-dk);
    }

    .risk-avatar {
        background: var(--red-lt);
        color: var(--red-dk);
    }

    .st-info {
        flex: 1;
        min-width: 0;
    }

    .st-name {
        font-size: 13px;
        font-weight: 800;
        color: var(--ink);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .st-detail {
        font-size: 11px;
        color: var(--mute);
        margin-top: 1px;
    }

    .st-score {
        font-size: 20px;
        font-weight: 800;
        letter-spacing: -.5px;
        text-align: center;
        flex-shrink: 0;
        min-width: 44px;
    }

    .top .st-score {
        color: var(--green);
    }

    .bottom .st-score {
        color: var(--red);
    }

    .st-score small {
        display: block;
        font-size: 9px;
        font-weight: 700;
        color: var(--mute);
        text-align: center;
    }

    .st-trend {
        font-size: 11px;
        font-weight: 800;
        padding: 2px 7px;
        border-radius: 5px;
        flex-shrink: 0;
        white-space: nowrap;
    }

        .st-trend.up {
            background: var(--green-lt);
            color: var(--green-dk);
        }

        .st-trend.dn {
            background: var(--red-lt);
            color: var(--red-dk);
        }

        .st-trend.eq {
            background: var(--bg-2);
            color: var(--mute);
        }

    .problem-flags {
        display: flex;
        gap: 4px;
        flex-wrap: wrap;
        margin-top: 3px;
    }

    .pflag {
        font-size: 9.5px;
        font-weight: 800;
        padding: 1px 6px;
        border-radius: 4px;
        border: 1px solid rgba(124, 58, 237, .2);
        background: var(--purple-lt);
        color: var(--purple-dk);
    }

        .pflag.neutral {
            background: var(--bg-2);
            color: var(--mute);
            border-color: var(--border);
        }

    .empty {
        text-align: center;
        color: var(--mute);
        font-size: 12px;
        padding: 24px;
    }

        .empty.full {
            grid-column: 1 / -1;
        }

    .txt-green {
        color: var(--green);
    }

    .txt-red {
        color: var(--red);
    }

    .txt-amber {
        color: var(--amber);
    }

    .txt-blue {
        color: var(--blue);
    }

    .fw7 {
        font-weight: 700;
    }

    .fw8 {
        font-weight: 800;
    }

    @@media (max-width: 1200px) {
        .kpi-strip {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .main-grid {
            grid-template-columns: 1fr;
        }

        .students-split {
            grid-template-columns: 1fr;
        }

        .instructor-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .batch-page {
            padding: 16px;
        }

        .batch-topnav {
            height: auto;
            padding: 14px;
            flex-direction: column;
            align-items: flex-start;
        }

        .nav-brand {
            align-items: flex-start;
        }

        .nav-actions {
            width: 100%;
        }

        .batch-hero {
            grid-template-columns: 1fr;
            padding: 20px;
        }

        .hero-left {
            flex-direction: column;
            align-items: flex-start;
        }

        .kpi-strip {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .lessons-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .instructor-grid {
            grid-template-columns: 1fr;
        }

        .card-head {
            align-items: flex-start;
            flex-direction: column;
        }

        .student-row {
            align-items: flex-start;
            flex-wrap: wrap;
        }
    }

    @@media (max-width: 520px) {
        .kpi-strip {
            grid-template-columns: 1fr;
        }

        .lessons-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const fills = document.querySelectorAll('.prog-fill, .inst-activity-fill, .hw-prog-fill, .lc-bar-fill');

        fills.forEach(function (el) {
            const target = el.style.width;
            el.style.width = '0';
            setTimeout(function () {
                el.style.width = target;
            }, 250);
        });

        const ring = document.querySelector('.ring-fill');

        if (ring) {
            const originalOffset = ring.getAttribute('stroke-dashoffset');
            ring.setAttribute('stroke-dashoffset', '251.2');

            setTimeout(function () {
                ring.style.transition = 'stroke-dashoffset .9s ease';
                ring.setAttribute('stroke-dashoffset', originalOffset);
            }, 200);
        }
    });
</script>

@* ====================================================
   MODALS — أزرار البطاقة العلوية
   ==================================================== *@

@* Toast للنتائج *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="bq-toast bq-toast-success" id="bqToastSuccess">
        <span class="bq-toast-icon">✅</span>
        <span class="bq-toast-msg">@TempData["SuccessMessage"]</span>
        <button class="bq-toast-close" onclick="this.parentElement.remove()">✕</button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="bq-toast bq-toast-error" id="bqToastError">
        <span class="bq-toast-icon">❌</span>
        <span class="bq-toast-msg">@TempData["ErrorMessage"]</span>
        <button class="bq-toast-close" onclick="this.parentElement.remove()">✕</button>
    </div>
}

@* ===== Modal 1: مراسلة الدفعة ===== *@
<div class="bq-modal-overlay" id="modalBatchMessage" role="dialog" aria-modal="true" aria-labelledby="modalBatchMessageTitle">
    <div class="bq-modal bq-modal-blue">
        <div class="bq-modal-header">
            <div class="bq-modal-icon-wrap blue"><span>✉</span></div>
            <div>
                <h2 id="modalBatchMessageTitle" class="bq-modal-title">مراسلة الدفعة</h2>
                <p class="bq-modal-subtitle">إرسال رسالة لجميع طلاب <strong>@Model.Name</strong> (@Model.StudentsCount طالب)</p>
            </div>
            <button class="bq-modal-x" onclick="closeModal('modalBatchMessage')" aria-label="إغلاق">✕</button>
        </div>

        <form asp-area="Admin" asp-controller="Batches" asp-action="SendBatchMessage" method="post" class="bq-modal-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="batchId" value="@Model.Id" />

            <div class="bq-field">
                <label class="bq-label" for="bmSubject">موضوع الرسالة</label>
                <input id="bmSubject" name="subject" type="text" class="bq-input"
                       placeholder="مثال: إعلان هام، تذكير بالمحاضرة..." maxlength="120" required />
            </div>

            <div class="bq-field">
                <label class="bq-label" for="bmMessage">نص الرسالة</label>
                <textarea id="bmMessage" name="message" class="bq-textarea"
                          rows="4" placeholder="اكتب نص الرسالة هنا..." maxlength="600" required></textarea>
                <div class="bq-char-counter"><span id="bmMsgCount">0</span>/600</div>
            </div>

            <div class="bq-recipients-info">
                <span class="bq-rec-chip">👥 سيستقبلها @Model.StudentsCount طالب</span>
                <span class="bq-rec-chip">📋 @Model.Name</span>
            </div>

            <div class="bq-modal-footer">
                <button type="button" class="bq-btn bq-btn-ghost" onclick="closeModal('modalBatchMessage')">إلغاء</button>
                <button type="submit" class="bq-btn bq-btn-blue">
                    <span>✉ إرسال الرسالة</span>
                </button>
            </div>
        </form>
    </div>
</div>

@* ===== Modal 2: إشعار متابعة ===== *@
<div class="bq-modal-overlay" id="modalFollowUp" role="dialog" aria-modal="true" aria-labelledby="modalFollowUpTitle">
    <div class="bq-modal bq-modal-amber">
        <div class="bq-modal-header">
            <div class="bq-modal-icon-wrap amber"><span>⚠</span></div>
            <div>
                <h2 id="modalFollowUpTitle" class="bq-modal-title">إشعار متابعة</h2>
                <p class="bq-modal-subtitle">تنبيه متابعة لطلاب <strong>@Model.Name</strong></p>
            </div>
            <button class="bq-modal-x" onclick="closeModal('modalFollowUp')" aria-label="إغلاق">✕</button>
        </div>

        <form asp-area="Admin" asp-controller="Batches" asp-action="SendBatchFollowUpNotification" method="post" class="bq-modal-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="batchId" value="@Model.Id" />

            <div class="bq-field">
                <label class="bq-label">نوع المتابعة</label>
                <div class="bq-follow-types">
                    <label class="bq-type-option">
                        <input type="radio" name="followUpType" value="attendance" checked />
                        <span class="bq-type-card">
                            <span class="bq-type-icon">🗓</span>
                            <span>متابعة الحضور</span>
                        </span>
                    </label>
                    <label class="bq-type-option">
                        <input type="radio" name="followUpType" value="homework" />
                        <span class="bq-type-card">
                            <span class="bq-type-icon">📝</span>
                            <span>متابعة الواجبات</span>
                        </span>
                    </label>
                    <label class="bq-type-option">
                        <input type="radio" name="followUpType" value="exam" />
                        <span class="bq-type-card">
                            <span class="bq-type-icon">🏆</span>
                            <span>متابعة الاختبارات</span>
                        </span>
                    </label>
                    <label class="bq-type-option">
                        <input type="radio" name="followUpType" value="general" />
                        <span class="bq-type-card">
                            <span class="bq-type-icon">📌</span>
                            <span>متابعة عامة</span>
                        </span>
                    </label>
                </div>
            </div>

            <div class="bq-field">
                <label class="bq-label" for="fuMessage">رسالة المتابعة</label>
                <textarea id="fuMessage" name="message" class="bq-textarea"
                          rows="4" placeholder="اكتب رسالة المتابعة هنا..." maxlength="500" required></textarea>
                <div class="bq-char-counter"><span id="fuMsgCount">0</span>/500</div>
            </div>

            <div class="bq-kpi-preview">
                <div class="bq-kpi-item amber">
                    <span class="bq-kpi-n">@Model.AttendancePercent.ToString("0")%</span>
                    <span class="bq-kpi-l">نسبة الحضور</span>
                </div>
                <div class="bq-kpi-item amber">
                    <span class="bq-kpi-n">@Model.HomeworkSubmissionPercent.ToString("0")%</span>
                    <span class="bq-kpi-l">تسليم الواجبات</span>
                </div>
                <div class="bq-kpi-item amber">
                    <span class="bq-kpi-n">@Model.ExamAverageScore.ToString("0")%</span>
                    <span class="bq-kpi-l">متوسط الاختبارات</span>
                </div>
            </div>

            <div class="bq-modal-footer">
                <button type="button" class="bq-btn bq-btn-ghost" onclick="closeModal('modalFollowUp')">إلغاء</button>
                <button type="submit" class="bq-btn bq-btn-amber">⚠ إرسال إشعار المتابعة</button>
            </div>
        </form>
    </div>
</div>

@* ===== Modal 3: إجراء عاجل ===== *@
<div class="bq-modal-overlay" id="modalUrgentAlert" role="dialog" aria-modal="true" aria-labelledby="modalUrgentTitle">
    <div class="bq-modal bq-modal-red">
        <div class="bq-modal-header">
            <div class="bq-modal-icon-wrap red"><span>🚨</span></div>
            <div>
                <h2 id="modalUrgentTitle" class="bq-modal-title">إجراء عاجل</h2>
                <p class="bq-modal-subtitle">تنبيه عاجل وفوري لطلاب <strong>@Model.Name</strong></p>
            </div>
            <button class="bq-modal-x" onclick="closeModal('modalUrgentAlert')" aria-label="إغلاق">✕</button>
        </div>

        <div class="bq-urgent-banner">
            🚨 سيُرسل هذا الإشعار كتنبيه ذو أولوية عالية لجميع @Model.StudentsCount طالب
        </div>

        <form asp-area="Admin" asp-controller="Batches" asp-action="SendBatchUrgentAlert" method="post" class="bq-modal-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="batchId" value="@Model.Id" />

            <div class="bq-field">
                <label class="bq-label">سبب الإجراء العاجل</label>
                <div class="bq-urgent-reasons">
                    <label class="bq-reason-option">
                        <input type="radio" name="urgentReason" value="غياب متكرر" checked />
                        <span class="bq-reason-card">📉 غياب متكرر</span>
                    </label>
                    <label class="bq-reason-option">
                        <input type="radio" name="urgentReason" value="تدني الدرجات" />
                        <span class="bq-reason-card">⚠ تدني الدرجات</span>
                    </label>
                    <label class="bq-reason-option">
                        <input type="radio" name="urgentReason" value="عدم تسليم الواجبات" />
                        <span class="bq-reason-card">📝 إهمال الواجبات</span>
                    </label>
                    <label class="bq-reason-option">
                        <input type="radio" name="urgentReason" value="مشكلة سلوكية" />
                        <span class="bq-reason-card">🔴 مشكلة سلوكية</span>
                    </label>
                    <label class="bq-reason-option">
                        <input type="radio" name="urgentReason" value="تغيير طارئ" />
                        <span class="bq-reason-card">📢 تغيير طارئ</span>
                    </label>
                    <label class="bq-reason-option">
                        <input type="radio" name="urgentReason" value="أخرى" />
                        <span class="bq-reason-card">📋 أخرى</span>
                    </label>
                </div>
            </div>

            <div class="bq-field">
                <label class="bq-label" for="uaMessage">تفاصيل الإجراء العاجل</label>
                <textarea id="uaMessage" name="message" class="bq-textarea bq-textarea-red"
                          rows="4" placeholder="اكتب تفاصيل الإجراء العاجل المطلوب هنا..." maxlength="500" required></textarea>
                <div class="bq-char-counter"><span id="uaMsgCount">0</span>/500</div>
            </div>

            <div class="bq-modal-footer">
                <button type="button" class="bq-btn bq-btn-ghost" onclick="closeModal('modalUrgentAlert')">إلغاء</button>
                <button type="submit" class="bq-btn bq-btn-red">🚨 إرسال الإجراء العاجل</button>
            </div>
        </form>
    </div>
</div>

@* ===== CSS للـ Modals ===== *@
<style>
    :root {
        --bq-blue: #2563eb;
        --bq-blue-light: #eff6ff;
        --bq-amber: #d97706;
        --bq-amber-light: #fffbeb;
        --bq-red: #dc2626;
        --bq-red-light: #fef2f2;
        --bq-green: #059669;
        --bq-green-light: #ecfdf5;
        --bq-radius: 16px;
        --bq-shadow: 0 20px 60px rgba(0,0,0,.25);
    }

    /* Overlay */
    .bq-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.55);
        backdrop-filter: blur(4px);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        animation: bqFadeIn .2s ease;
    }

    .bq-modal-overlay.is-open {
        display: flex;
    }

    @@keyframes bqFadeIn {
        from { opacity: 0; }
        to   { opacity: 1; }
    }

    @@keyframes bqSlideUp {
        from { opacity: 0; transform: translateY(28px) scale(.97); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* Modal Card */
    .bq-modal {
        background: #fff;
        border-radius: var(--bq-radius);
        box-shadow: var(--bq-shadow);
        width: 100%;
        max-width: 560px;
        max-height: 90vh;
        overflow-y: auto;
        animation: bqSlideUp .28s cubic-bezier(.16,1,.3,1);
        border-top: 5px solid var(--bq-blue);
        position: relative;
    }

    .bq-modal-blue  { border-top-color: var(--bq-blue); }
    .bq-modal-amber { border-top-color: var(--bq-amber); }
    .bq-modal-red   { border-top-color: var(--bq-red); }

    /* Header */
    .bq-modal-header {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 22px 22px 0;
    }

    .bq-modal-icon-wrap {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .bq-modal-icon-wrap.blue  { background: var(--bq-blue-light);  color: var(--bq-blue); }
    .bq-modal-icon-wrap.amber { background: var(--bq-amber-light); color: var(--bq-amber); }
    .bq-modal-icon-wrap.red   { background: var(--bq-red-light);   color: var(--bq-red); }

    .bq-modal-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: #111827;
        margin: 0 0 4px;
        font-family: 'Cairo', 'Tajawal', sans-serif;
    }

    .bq-modal-subtitle {
        font-size: .875rem;
        color: #6b7280;
        margin: 0;
        font-family: 'Cairo', 'Tajawal', sans-serif;
    }

    .bq-modal-subtitle strong { color: #374151; }

    .bq-modal-x {
        margin-right: auto;
        margin-left: 0;
        background: none;
        border: none;
        font-size: 1.1rem;
        color: #9ca3af;
        cursor: pointer;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background .15s, color .15s;
        flex-shrink: 0;
    }

    .bq-modal-x:hover { background: #f3f4f6; color: #374151; }

    /* Form Body */
    .bq-modal-form { padding: 18px 22px 22px; }

    .bq-field { margin-bottom: 18px; }

    .bq-label {
        display: block;
        font-size: .875rem;
        font-weight: 600;
        color: #374151;
        margin-bottom: 8px;
        font-family: 'Cairo', 'Tajawal', sans-serif;
    }

    .bq-input,
    .bq-textarea {
        width: 100%;
        border: 1.5px solid #d1d5db;
        border-radius: 10px;
        padding: 10px 14px;
        font-size: .9rem;
        font-family: 'Cairo', 'Tajawal', sans-serif;
        color: #111827;
        background: #fafafa;
        transition: border-color .2s, box-shadow .2s;
        resize: vertical;
        box-sizing: border-box;
        direction: rtl;
    }

    .bq-input:focus,
    .bq-textarea:focus {
        outline: none;
        border-color: var(--bq-blue);
        box-shadow: 0 0 0 3px rgba(37,99,235,.12);
        background: #fff;
    }

    .bq-modal-red .bq-textarea-red:focus {
        border-color: var(--bq-red);
        box-shadow: 0 0 0 3px rgba(220,38,38,.12);
    }

    .bq-modal-amber .bq-input:focus,
    .bq-modal-amber .bq-textarea:focus {
        border-color: var(--bq-amber);
        box-shadow: 0 0 0 3px rgba(217,119,6,.12);
    }

    .bq-char-counter {
        text-align: left;
        font-size: .75rem;
        color: #9ca3af;
        margin-top: 4px;
    }

    /* Recipients Info */
    .bq-recipients-info {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 6px;
    }

    .bq-rec-chip {
        background: var(--bq-blue-light);
        color: var(--bq-blue);
        font-size: .8rem;
        font-weight: 600;
        padding: 5px 12px;
        border-radius: 20px;
        font-family: 'Cairo', 'Tajawal', sans-serif;
    }

    /* Follow-Up Type Cards */
    .bq-follow-types {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .bq-type-option input[type="radio"] { display: none; }

    .bq-type-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        padding: 12px 8px;
        border: 2px solid #e5e7eb;
        border-radius: 10px;
        cursor: pointer;
        font-size: .82rem;
        font-weight: 600;
        color: #6b7280;
        background: #fafafa;
        transition: border-color .2s, background .2s, color .2s;
        font-family: 'Cairo', 'Tajawal', sans-serif;
        text-align: center;
        user-select: none;
    }

    .bq-type-icon { font-size: 1.4rem; }

    .bq-type-option input:checked + .bq-type-card {
        border-color: var(--bq-amber);
        background: var(--bq-amber-light);
        color: var(--bq-amber);
    }

    .bq-type-card:hover { border-color: #d1d5db; background: #f9fafb; }

    /* KPI Preview inside follow-up modal */
    .bq-kpi-preview {
        display: flex;
        gap: 10px;
        background: var(--bq-amber-light);
        border-radius: 10px;
        padding: 12px;
        margin-bottom: 6px;
    }

    .bq-kpi-item {
        flex: 1;
        text-align: center;
    }

    .bq-kpi-n {
        display: block;
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--bq-amber);
        font-family: 'Cairo', 'Tajawal', sans-serif;
    }

    .bq-kpi-l {
        display: block;
        font-size: .72rem;
        color: #78350f;
        margin-top: 2px;
        font-family: 'Cairo', 'Tajawal', sans-serif;
    }

    /* Urgent Banner */
    .bq-urgent-banner {
        background: var(--bq-red-light);
        border: 1px solid #fca5a5;
        border-radius: 10px;
        padding: 12px 18px;
        margin: 14px 22px 4px;
        font-size: .875rem;
        font-weight: 600;
        color: #991b1b;
        font-family: 'Cairo', 'Tajawal', sans-serif;
        direction: rtl;
    }

    /* Urgent Reason Cards */
    .bq-urgent-reasons {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 8px;
    }

    .bq-reason-option input[type="radio"] { display: none; }

    .bq-reason-card {
        display: block;
        padding: 9px 6px;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        cursor: pointer;
        font-size: .78rem;
        font-weight: 600;
        color: #6b7280;
        background: #fafafa;
        transition: border-color .2s, background .2s, color .2s;
        font-family: 'Cairo', 'Tajawal', sans-serif;
        text-align: center;
        user-select: none;
    }

    .bq-reason-option input:checked + .bq-reason-card {
        border-color: var(--bq-red);
        background: var(--bq-red-light);
        color: var(--bq-red);
    }

    .bq-reason-card:hover { border-color: #d1d5db; background: #f9fafb; }

    /* Footer */
    .bq-modal-footer {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        padding-top: 10px;
        border-top: 1px solid #f3f4f6;
        margin-top: 16px;
    }

    .bq-btn {
        padding: 10px 22px;
        border-radius: 10px;
        font-size: .9rem;
        font-weight: 700;
        font-family: 'Cairo', 'Tajawal', sans-serif;
        cursor: pointer;
        border: none;
        transition: opacity .2s, transform .1s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .bq-btn:hover { opacity: .9; }
    .bq-btn:active { transform: scale(.97); }

    .bq-btn-ghost {
        background: #f3f4f6;
        color: #374151;
    }

    .bq-btn-blue  { background: var(--bq-blue);  color: #fff; }
    .bq-btn-amber { background: var(--bq-amber); color: #fff; }
    .bq-btn-red   { background: var(--bq-red);   color: #fff; }

    /* Toast */
    .bq-toast {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 10000;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 18px;
        border-radius: 12px;
        font-size: .9rem;
        font-weight: 600;
        font-family: 'Cairo', 'Tajawal', sans-serif;
        box-shadow: 0 8px 30px rgba(0,0,0,.18);
        animation: bqSlideUp .3s ease, bqFadeOut 4s 3s forwards;
        max-width: 380px;
        direction: rtl;
    }

    .bq-toast-success { background: var(--bq-green-light); color: #065f46; border: 1px solid #a7f3d0; }
    .bq-toast-error   { background: var(--bq-red-light);   color: #991b1b; border: 1px solid #fca5a5; }

    .bq-toast-icon { font-size: 1.1rem; }
    .bq-toast-msg  { flex: 1; }

    .bq-toast-close {
        background: none;
        border: none;
        cursor: pointer;
        color: inherit;
        opacity: .6;
        font-size: .9rem;
        padding: 2px 6px;
        border-radius: 6px;
        transition: opacity .15s;
    }

    .bq-toast-close:hover { opacity: 1; }

    @@keyframes bqFadeOut {
        from { opacity: 1; transform: translateY(0); }
        to   { opacity: 0; transform: translateY(-10px); pointer-events: none; }
    }

    @@media (max-width: 600px) {
        .bq-follow-types { grid-template-columns: 1fr 1fr; }
        .bq-urgent-reasons { grid-template-columns: 1fr 1fr; }
        .bq-modal { max-width: 100%; }
    }
</style>

@* ===== JS للـ Modals ===== *@
<script>
    function openModal(id) {
        var el = document.getElementById(id);
        if (el) {
            el.classList.add('is-open');
            document.body.style.overflow = 'hidden';
        }
    }

    function closeModal(id) {
        var el = document.getElementById(id);
        if (el) {
            el.classList.remove('is-open');
            document.body.style.overflow = '';
        }
    }

    // إغلاق عند الضغط خارج المودال
    document.querySelectorAll('.bq-modal-overlay').forEach(function (overlay) {
        overlay.addEventListener('click', function (e) {
            if (e.target === overlay) closeModal(overlay.id);
        });
    });

    // إغلاق بـ Escape
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            document.querySelectorAll('.bq-modal-overlay.is-open').forEach(function (el) {
                closeModal(el.id);
            });
        }
    });

    // عداد الأحرف
    function bindCounter(textareaId, counterId) {
        var ta = document.getElementById(textareaId);
        var cnt = document.getElementById(counterId);
        if (!ta || !cnt) return;
        ta.addEventListener('input', function () { cnt.textContent = ta.value.length; });
    }

    bindCounter('bmMessage', 'bmMsgCount');
    bindCounter('fuMessage', 'fuMsgCount');
    bindCounter('uaMessage', 'uaMsgCount');

    // إخفاء الـ Toast تلقائياً
    setTimeout(function () {
        ['bqToastSuccess', 'bqToastError'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) el.remove();
        });
    }, 6000);
</script>