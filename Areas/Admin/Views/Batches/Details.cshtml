@model QdratNew.ViewModels.Batch.BatchDetailsDashboardViewModel

@{
    ViewData["Title"] = "تفاصيل الدفعة";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var ringCircumference = 251.2;
    var safeHealthScore = Model.HealthScore < 0 ? 0 : Model.HealthScore > 100 ? 100 : Model.HealthScore;
    var ringOffset = ringCircumference * (1 - (safeHealthScore / 100.0));
}

<div class="batch-details-page" dir="rtl">

    <nav class="batch-topnav">
        <div class="nav-brand">
            <span class="nav-logo">قدرات</span>
            <div class="nav-sep"></div>
            <div class="nav-breadcrumb">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index">لوحة التحكم</a>
                <span>›</span>
                <a asp-area="Admin" asp-controller="Batches" asp-action="Index">الدفعات</a>
                <span>›</span>
                <span class="current">@Model.Name</span>
            </div>
        </div>

        <div class="nav-actions">
            <a class="nav-btn" asp-area="Admin" asp-controller="Batches" asp-action="BatchStudents" asp-route-batchId="@Model.Id">👥 الطلاب</a>
            <button type="button" class="nav-btn">⬇ تصدير PDF</button>
            <button type="button" class="nav-btn">✉ إرسال التقرير</button>
            <a class="nav-btn primary" asp-area="Admin" asp-controller="Batches" asp-action="Edit" asp-route-id="@Model.Id">⚙ إعدادات الدفعة</a>
        </div>
    </nav>

    <div class="batch-page">

        <section class="batch-hero batch-fade d1">
            <div class="hero-content">
                <div class="hero-left">
                    <div class="hero-avatar">@Model.AvatarText</div>

                    <div class="hero-info">
                        <h1>@Model.Name</h1>

                        <div class="hero-meta">
                            <span class="hero-tag active">● @Model.StatusText</span>
                            <span class="hero-tag info">@Model.StudentsCount طالب</span>
                            <span class="hero-tag info">@Model.InstructorsCount مدربين</span>
                            <span class="hero-tag neutral">الدورة: @Model.CourseName</span>
                            <span class="hero-tag neutral">الفرع: @Model.BranchName</span>
                            <span class="hero-tag neutral">بدأت: @Model.StartDate.ToString("yyyy/MM/dd")</span>
                            <span class="hero-tag neutral">تنتهي: @Model.EndDate.ToString("yyyy/MM/dd")</span>
                            <span class="hero-tag neutral">@Model.StageText</span>
                        </div>

                        <p class="hero-desc">@Model.Description</p>

                        <div class="hero-actions">
                            <a class="hbtn outline"
                               asp-area="Admin"
                               asp-controller="Batches"
                               asp-action="BatchStudents"
                               asp-route-batchId="@Model.Id">👥 عرض الطلاب</a>

                            <a class="hbtn outline"
                               asp-area="Admin"
                               asp-controller="Analytics"
                               asp-action="BatchPerformanceDetails"
                               asp-route-batchId="@Model.Id">📊 تقرير مفصل</a>

                            <button type="button" class="hbtn solid-blue"
                                    onclick="openModal('modalBatchMessage')">✉ مراسلة الدفعة</button>

                            <button type="button" class="hbtn solid-amber"
                                    onclick="openModal('modalFollowUp')">⚠ إشعار متابعة</button>

                            <button type="button" class="hbtn solid-red"
                                    onclick="openModal('modalUrgentAlert')">🚨 إجراء عاجل</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="health-ring-wrap">
                <div class="health-ring">
                    <svg viewBox="0 0 100 100" aria-hidden="true">
                        <circle class="ring-bg" cx="50" cy="50" r="40"></circle>
                        <circle class="ring-fill"
                                cx="50"
                                cy="50"
                                r="40"
                                stroke="@(safeHealthScore >= 85 ? "#059669" : safeHealthScore >= 70 ? "#2563eb" : safeHealthScore >= 55 ? "#d97706" : "#dc2626")"
                                stroke-dasharray="251.2"
                                stroke-dashoffset="@ringOffset.ToString("0.##")"></circle>
                    </svg>
                    <div class="ring-val">
                        @safeHealthScore.ToString("0")
                        <small>%</small>
                    </div>
                </div>

                <div class="health-label">
                    مؤشر صحة الدفعة
                    <span class="@Model.HealthCssClass">@Model.HealthLabel</span>
                </div>
            </div>
        </section>

        <section class="kpi-strip">
            <article class="kpi-card b batch-fade d1">
                <div class="kpi-icon b">👥</div>
                <div class="kpi-val">@Model.StudentsCount</div>
                <div class="kpi-label">إجمالي الطلاب</div>
                <div class="kpi-delta eq">حسب الطلاب المرتبطين بالدفعة</div>
            </article>

            <article class="kpi-card g batch-fade d2">
                <div class="kpi-icon g">✅</div>
                <div class="kpi-val">@Model.AttendancePercent.ToString("0")<sup>%</sup></div>
                <div class="kpi-label">متوسط نسبة الحضور</div>
                <div class="kpi-delta @(Model.AttendancePercent >= 85 ? "up" : "dn")">@Model.AttendanceDeltaText</div>
            </article>

            <article class="kpi-card a batch-fade d3">
                <div class="kpi-icon a">📝</div>
                <div class="kpi-val">@Model.HomeworkSubmissionPercent.ToString("0")<sup>%</sup></div>
                <div class="kpi-label">نسبة تسليم الواجبات</div>
                <div class="kpi-delta @(Model.HomeworkSubmissionPercent >= 90 ? "up" : "dn")">@Model.HomeworkDeltaText</div>
            </article>

            <article class="kpi-card g batch-fade d4">
                <div class="kpi-icon g">🏆</div>
                <div class="kpi-val">@Model.ExamAverageScore.ToString("0")<sup>%</sup></div>
                <div class="kpi-label">متوسط درجات الاختبارات</div>
                <div class="kpi-delta @(Model.ExamAverageScore >= 80 ? "up" : "dn")">@Model.ExamDeltaText</div>
            </article>

            <article class="kpi-card t batch-fade d5">
                <div class="kpi-icon t">📚</div>
                <div class="kpi-val">@Model.CompletedLessonsCount<sup>/@Model.TotalLessonsCount</sup></div>
                <div class="kpi-label">دروس مكتملة</div>
                <div class="kpi-delta up">@Model.CourseProgressPercent.ToString("0")% من مدة الدفعة</div>
            </article>

            <article class="kpi-card p batch-fade d6">
                <div class="kpi-icon p">⏱</div>
                <div class="kpi-val">@Model.DaysRemaining</div>
                <div class="kpi-label">يوم متبقٍ في الدفعة</div>
                <div class="kpi-delta eq">الانتهاء: @Model.EndDate.ToString("yyyy/MM/dd")</div>
            </article>
        </section>

        <section class="main-grid">

            <div class="left-stack">

                <section class="dash-card batch-fade d2">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent teal"></div>
                            <div>
                                <div class="ch-title">تقدم الدروس والوحدات</div>
                                <div class="ch-sub">@Model.CompletedLessonsCount درس مرتبط بمحاضرات الدفعة</div>
                            </div>
                        </div>
                        <button type="button" class="card-link">عرض المنهج الكامل ←</button>
                    </div>

                    <div class="lessons-grid">
                        @if (Model.Lessons.Any())
                        {
                            foreach (var lesson in Model.Lessons)
                            {
                                var safeLessonAttendance = lesson.AttendancePercent < 0 ? 0 : lesson.AttendancePercent > 100 ? 100 : lesson.AttendancePercent;

                                <div class="lesson-cell @lesson.CssClass">
                                    <span class="lc-badge">@lesson.StatusText</span>
                                    <div class="lc-num">الدرس @lesson.Number.ToString("00")</div>
                                    <div class="lc-title">@lesson.Title</div>
                                    <div class="lc-bar">
                                        <div class="lc-bar-fill" style="width:@safeLessonAttendance.ToString("0")%"></div>
                                    </div>
                                    <div class="lc-meta">
                                        <span>@safeLessonAttendance.ToString("0")% حضور</span>
                                        <span>@(lesson.HasHomework ? "✓ واجب" : "—")</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty full">لا توجد دروس مرتبطة بمحاضرات هذه الدفعة حتى الآن.</div>
                        }
                    </div>
                </section>

                <section class="dash-card batch-fade d3">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent amber"></div>
                            <div>
                                <div class="ch-title">الواجبات المنزلية</div>
                                <div class="ch-sub">@Model.Homeworks.Count واجب ظاهر في التقرير</div>
                            </div>
                        </div>
                        <a class="card-link" asp-area="Admin" asp-controller="HomeworkManagement" asp-action="Index">إدارة الواجبات ←</a>
                    </div>

                    <div class="table-wrap">
                        <table class="hw-table">
                            <thead>
                                <tr>
                                    <th style="width:32%">الواجب</th>
                                    <th>الحالة</th>
                                    <th>التسليم</th>
                                    <th>لم يسلموا</th>
                                    <th>متوسط الدرجة</th>
                                    <th>الإجراء</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Homeworks.Any())
                                {
                                    foreach (var hw in Model.Homeworks)
                                    {
                                        var safeSubmission = hw.SubmissionPercent < 0 ? 0 : hw.SubmissionPercent > 100 ? 100 : hw.SubmissionPercent;
                                        var submissionColor = safeSubmission >= 80 ? "var(--green)" : safeSubmission >= 60 ? "var(--amber)" : "var(--red)";

                                        <tr class="@(hw.StatusCssClass == "soon" ? "row-soon" : hw.StatusCssClass == "open" ? "row-open" : "")">
                                            <td>
                                                <div class="hw-title">@hw.Title</div>
                                                <div class="hw-sub">
                                                    إرسال: @hw.CreatedAt.ToString("yyyy/MM/dd")
                                                    @if (hw.EndAt.HasValue)
                                                    {
                                                        <span> • يغلق: @hw.EndAt.Value.ToString("yyyy/MM/dd")</span>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <span class="hw-status @hw.StatusCssClass">● @hw.StatusText</span>
                                            </td>
                                            <td>
                                                <div class="hw-prog">
                                                    <div class="hw-prog-bar">
                                                        <div class="hw-prog-fill" style="width:@safeSubmission.ToString("0")%;background:@submissionColor"></div>
                                                    </div>
                                                    <span class="fw7">@safeSubmission.ToString("0")%</span>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="hw-missing @hw.MissingCssClass">@hw.MissingCount طالب</span>
                                            </td>
                                            <td class="fw7">
                                                @hw.AverageScore.ToString("0")<span class="txt-blue">/100</span>
                                            </td>
                                            <td>
                                                <a class="card-link small-link"
                                                   asp-area="Admin"
                                                   asp-controller="Batches"
                                                   asp-action="HomeworkSetDetail"
                                                   asp-route-homeworkSetId="@hw.HomeworkSetId"
                                                   asp-route-batchId="@Model.Id">عرض ←</a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="empty">لا توجد واجبات مرتبطة بهذه الدفعة.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>

                <section class="dash-card batch-fade d4">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent blue"></div>
                            <div>
                                <div class="ch-title">المدربون المرتبطون بالدفعة</div>
                                <div class="ch-sub">@Model.Instructors.Count مدربين ظهروا من محاضرات الدفعة</div>
                            </div>
                        </div>
                        <a class="card-link" asp-area="Admin" asp-controller="Instructors" asp-action="Index">إدارة المدربين ←</a>
                    </div>

                    <div class="instructor-grid">
                        @if (Model.Instructors.Any())
                        {
                            foreach (var instructor in Model.Instructors)
                            {
                                var safeActivity = instructor.ActivityScore < 0 ? 0 : instructor.ActivityScore > 100 ? 100 : instructor.ActivityScore;

                                <div class="inst-card">
                                    <div class="inst-av">@instructor.AvatarText</div>
                                    <div class="inst-name">@instructor.FullName</div>
                                    <div class="inst-role">@instructor.Specialization</div>

                                    <div class="inst-stats">
                                        <div class="inst-stat-row">
                                            <span class="inst-stat-label">محاضرات هذا الأسبوع</span>
                                            <span class="inst-stat-val txt-green">@instructor.LecturesThisWeek</span>
                                        </div>
                                        <div class="inst-stat-row">
                                            <span class="inst-stat-label">واجبات الدفعة</span>
                                            <span class="inst-stat-val">@instructor.HomeworksCount</span>
                                        </div>
                                        <div class="inst-stat-row">
                                            <span class="inst-stat-label">اختبارات</span>
                                            <span class="inst-stat-val">@instructor.ExamsCount</span>
                                        </div>
                                        <div class="inst-stat-row">
                                            <span class="inst-stat-label">مشاركة الطلاب</span>
                                            <span class="inst-stat-val txt-green">@instructor.StudentParticipationPercent.ToString("0")%</span>
                                        </div>
                                    </div>

                                    <div class="inst-activity-bar">
                                        <div class="inst-activity-fill" style="width:@safeActivity.ToString("0")%;background:@instructor.ActivityCssColor"></div>
                                    </div>
                                    <div class="inst-score-label">
                                        <span>مؤشر النشاط</span>
                                        <span class="fw8">@safeActivity.ToString("0") / 100</span>
                                    </div>

                                    <a class="inst-perf-btn"
                                       asp-area="Admin"
                                       asp-controller="Batches"
                                       asp-action="InstructorBatchPerformance"
                                       asp-route-instructorId="@instructor.InstructorId"
                                       asp-route-batchId="@Model.Id">
                                        📊 مراجعة أداء المدرب
                                    </a>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty full">لا توجد محاضرات مرتبطة بمدربين في هذه الدفعة.</div>
                        }
                    </div>
                </section>

            </div>

            <aside class="right-stack">

                <section class="dash-card batch-fade d2">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent ink"></div>
                            <div>
                                <div class="ch-title">التشخيص الذكي للدفعة</div>
                                <div class="ch-sub">نقاط القوة، الضعف، الفرص، المخاطر</div>
                            </div>
                        </div>
                        <span class="ch-badge neutral">@Model.DiagnosisItems.Count عناصر</span>
                    </div>

                    <div class="diag-section">
                        @if (Model.DiagnosisItems.Any())
                        {
                            foreach (var item in Model.DiagnosisItems)
                            {
                                <div class="diag-item">
                                    <div class="diag-icon @item.CssClass">@item.Icon</div>
                                    <div>
                                        <div class="diag-title">@item.Title</div>
                                        <div class="diag-body">@item.Body</div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty">لا توجد عناصر تشخيصية حالياً.</div>
                        }
                    </div>
                </section>

                <section class="dash-card batch-fade d3">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent green"></div>
                            <div>
                                <div class="ch-title">سجل الحضور — @DateTime.Today.ToString("MMMM yyyy")</div>
                                <div class="ch-sub">نسبة حضور الدفعة اليومية</div>
                            </div>
                        </div>
                    </div>

                    <div class="att-month">
                        <div class="att-week-labels">
                            <div class="att-wl">أح</div>
                            <div class="att-wl">إث</div>
                            <div class="att-wl">ثل</div>
                            <div class="att-wl">أر</div>
                            <div class="att-wl">خم</div>
                            <div class="att-wl">جم</div>
                            <div class="att-wl">سب</div>
                        </div>

                        <div class="att-grid-cal">
                            @if (Model.AttendanceCalendar.Any())
                            {
                                foreach (var day in Model.AttendanceCalendar)
                                {
                                    <div class="att-day @day.CssClass" title="@day.Percent.ToString("0")%">
                                        @(day.HasLecture? day.Percent.ToString("0") : "—")
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="empty full">لا توجد بيانات حضور لهذا الشهر.</div>
                            }
                        </div>

                        <div class="att-legend">
                            <span><i style="background:var(--green-lt)"></i>+80%</span>
                            <span><i style="background:var(--amber-lt)"></i>60-80%</span>
                            <span><i style="background:var(--red-lt)"></i>أقل من 60%</span>
                        </div>
                    </div>
                </section>

                <section class="dash-card batch-fade d4">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent purple"></div>
                            <div>
                                <div class="ch-title">مؤشرات الأداء الإجمالية</div>
                                <div class="ch-sub">مقارنة بالهدف المطلوب</div>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        @if (Model.ProgressBars.Any())
                        {
                            foreach (var item in Model.ProgressBars)
                            {
                                var safeValue = item.Value < 0 ? 0 : item.Value > 100 ? 100 : item.Value;

                                <div class="prog-item">
                                    <div class="prog-head">
                                        <span>@item.Label</span>
                                        <b>@safeValue.ToString("0")% <span>/ هدف @item.Target.ToString("0")%</span></b>
                                    </div>
                                    <div class="prog-track">
                                        <div class="prog-fill" style="width:@safeValue.ToString("0")%;background:@item.CssColor"></div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty">لا توجد مؤشرات أداء كافية.</div>
                        }
                    </div>
                </section>

                <section class="dash-card batch-fade d5">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent teal"></div>
                            <div>
                                <div class="ch-title">كثافة النشاط الأسبوعي</div>
                                <div class="ch-sub">محاضرات + واجبات + اختبارات</div>
                            </div>
                        </div>
                    </div>

                    <div class="heatmap-wrap">
                        <div class="hm-days">
                            <div class="hm-day">أح</div>
                            <div class="hm-day">إث</div>
                            <div class="hm-day">ثل</div>
                            <div class="hm-day">أر</div>
                            <div class="hm-day">خم</div>
                            <div class="hm-day">جم</div>
                            <div class="hm-day">سب</div>
                        </div>

                        @if (Model.HeatmapWeeks.Any())
                        {
                            foreach (var week in Model.HeatmapWeeks)
                            {
                                <div class="hm-row">
                                    @foreach (var day in week.Days)
                                    {
                                        <div class="hm-cell" style="@day.CssStyle">@day.ActivityCount</div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty">لا توجد بيانات نشاط أسبوعية.</div>
                        }
                    </div>
                </section>

            </aside>
        </section>

        <section class="full-section batch-fade d5">
            <div class="sec-label">
                <div class="sec-label-line"></div>
                <div>
                    <h2>تحليل أداء الطلاب</h2>
                    <p>أعلى 5 طلاب — أدنى 5 طلاب مع مؤشرات التدخل</p>
                </div>
            </div>

            <div class="students-split">

                <section class="student-card top">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent green"></div>
                            <div>
                                <div class="ch-title">⭐ المتفوقون</div>
                                <div class="ch-sub">أعلى 5 بناءً على متوسط الاختبارات والحضور والتسليم</div>
                            </div>
                        </div>
                    </div>

                    @if (Model.TopStudents.Any())
                    {
                        foreach (var student in Model.TopStudents)
                        {
                            <div class="student-row">
                                <div class="st-rank">@student.Rank</div>
                                <div class="st-avatar top-avatar">@student.AvatarText</div>
                                <div class="st-info">
                                    <div class="st-name">@student.FullName</div>
                                    <div class="st-detail">حضور @student.AttendancePercent.ToString("0")% • تسليم @student.HomeworkSubmissionPercent.ToString("0")%</div>
                                </div>
                                <span class="st-trend @student.TrendCssClass">@student.TrendText</span>
                                <div class="st-score">@student.AverageScore.ToString("0")<small>متوسط</small></div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty">لا توجد بيانات كافية.</div>
                    }
                </section>

                <section class="student-card bottom">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent red"></div>
                            <div>
                                <div class="ch-title">🚨 يحتاجون متابعة</div>
                                <div class="ch-sub">أدنى 5 مع تفاصيل مشكلة كل طالب</div>
                            </div>
                        </div>
                        <span class="ch-badge danger">تدخل عاجل</span>
                    </div>

                    @if (Model.RiskStudents.Any())
                    {
                        foreach (var student in Model.RiskStudents)
                        {
                            <div class="student-row @(student.AverageScore < 60 ? "risk-row" : "")">
                                <div class="st-rank">⚠</div>
                                <div class="st-avatar risk-avatar">@student.AvatarText</div>
                                <div class="st-info">
                                    <div class="st-name">@student.FullName</div>
                                    <div class="problem-flags">
                                        @if (student.Flags.Any())
                                        {
                                            foreach (var flag in student.Flags)
                                            {
                                                <span class="pflag">@flag</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="pflag neutral">لا توجد تفاصيل كافية</span>
                                        }
                                    </div>
                                </div>
                                <span class="st-trend @student.TrendCssClass">@student.TrendText</span>
                                <div class="st-score">@student.AverageScore.ToString("0")<small>متوسط</small></div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty">لا توجد بيانات كافية.</div>
                    }
                </section>
            </div>
        </section>
    </div>
