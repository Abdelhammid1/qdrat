@model QdratNew.ViewModels.Batch.BatchViewModel
@using QdratNew.Entities

@{
    ViewData["Title"] = "تعديل الدفعة";
}

<style>
    .qdrat-page {
        direction: rtl;
        text-align: right;
        font-family: "Cairo", "Tajawal", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .qdrat-hero {
        background: linear-gradient(135deg, #1d4ed8 0%, #0f766e 58%, #14b8a6 100%);
        border-radius: 24px;
        padding: 28px;
        color: #fff;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 45px rgba(29, 78, 216, .18);
        margin-bottom: 22px;
    }

        .qdrat-hero::before {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .13);
            top: -80px;
            left: -70px;
        }

        .qdrat-hero::after {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, .22);
            bottom: -45px;
            right: 35px;
        }

    .qdrat-hero-content {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
    }

    .qdrat-hero h1 {
        margin: 0;
        font-size: 1.65rem;
        font-weight: 800;
        letter-spacing: -.3px;
    }

    .qdrat-hero p {
        margin: 10px 0 0;
        color: rgba(255, 255, 255, .86);
        font-size: .98rem;
        line-height: 1.8;
    }

    .qdrat-hero-icon {
        width: 62px;
        height: 62px;
        border-radius: 20px;
        background: rgba(255, 255, 255, .16);
        border: 1px solid rgba(255, 255, 255, .24);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        flex: 0 0 auto;
    }

    .qdrat-card {
        border: 0;
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 16px 42px rgba(15, 23, 42, .08);
        overflow: hidden;
    }

    .qdrat-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #eef2f7;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    }

        .qdrat-card-header h2 {
            margin: 0;
            font-size: 1.15rem;
            font-weight: 800;
            color: #0f172a;
        }

        .qdrat-card-header span {
            color: #64748b;
            font-size: .9rem;
        }

    .qdrat-card-body {
        padding: 24px;
    }

    .qdrat-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 6px 0 18px;
        color: #0f172a;
        font-weight: 800;
        font-size: 1.02rem;
    }

        .qdrat-section-title i {
            width: 34px;
            height: 34px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #eff6ff;
            color: #2563eb;
        }

    .qdrat-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .qdrat-form-group {
        margin-bottom: 0;
    }

        .qdrat-form-group.full {
            grid-column: 1 / -1;
        }

        .qdrat-form-group label {
            display: block;
            font-weight: 700;
            color: #334155;
            margin-bottom: 8px;
            font-size: .94rem;
        }

        .qdrat-form-group .form-control,
        .qdrat-form-group .form-select,
        .qdrat-form-group select,
        .qdrat-form-group input {
            min-height: 46px;
            border-radius: 14px;
            border: 1px solid #dbe3ef;
            background-color: #fff;
            color: #0f172a;
            box-shadow: none;
            transition: border-color .18s ease, box-shadow .18s ease, background-color .18s ease;
        }

            .qdrat-form-group .form-control:focus,
            .qdrat-form-group select:focus,
            .qdrat-form-group input:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .12);
            }

    .qdrat-alert {
        border: 0;
        border-radius: 18px;
        padding: 16px 18px;
        box-shadow: 0 10px 28px rgba(220, 38, 38, .08);
    }

    .qdrat-actions {
        margin-top: 26px;
        padding-top: 20px;
        border-top: 1px solid #eef2f7;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .qdrat-actions-group {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .qdrat-btn {
        border-radius: 14px;
        padding: 11px 18px;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 0;
        min-height: 44px;
    }

    .qdrat-btn-primary {
        background: linear-gradient(135deg, #2563eb 0%, #0f766e 100%);
        color: #fff;
        box-shadow: 0 12px 26px rgba(37, 99, 235, .18);
    }

        .qdrat-btn-primary:hover {
            color: #fff;
            filter: brightness(.98);
        }

    .qdrat-btn-light {
        background: #f1f5f9;
        color: #334155;
        border: 1px solid #e2e8f0;
    }

        .qdrat-btn-light:hover {
            background: #e2e8f0;
            color: #0f172a;
        }

    .field-validation-error,
    .text-danger {
        font-size: .82rem;
        margin-top: 6px;
        display: block;
    }

    @@media (max-width: 768px) {
        .qdrat-hero,
        .qdrat-card-body,
        .qdrat-card-header {
            padding: 18px;
        }

        .qdrat-form-grid {
            grid-template-columns: 1fr;
        }

        .qdrat-hero h1 {
            font-size: 1.35rem;
        }

        .qdrat-actions {
            align-items: stretch;
        }

            .qdrat-actions-group,
            .qdrat-actions-group .qdrat-btn,
            .qdrat-actions .qdrat-btn {
                width: 100%;
                justify-content: center;
            }
    }
</style>

<div class="qdrat-page">
    <div class="qdrat-hero">
        <div class="qdrat-hero-content">
            <div>
                <h1><i class="fas fa-edit"></i> تعديل الدفعة</h1>
                <p>تحديث بيانات الدفعة الحالية مع الحفاظ على نفس الربط بالدورة والفرع وإعدادات المدة.</p>
            </div>
            <div class="qdrat-hero-icon">
                <i class="fas fa-layer-group"></i>
            </div>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger qdrat-alert">
            <h4 class="alert-heading mb-2"><i class="fas fa-exclamation-circle"></i> يوجد أخطاء، الرجاء تصحيحها:</h4>
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <div class="qdrat-card">
        <div class="qdrat-card-header">
            <div>
                <h2><i class="fas fa-clipboard-check"></i> بيانات الدفعة</h2>
                <span>عدّل البيانات المطلوبة فقط ثم احفظ التغييرات.</span>
            </div>
        </div>

        <div class="qdrat-card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="qdrat-section-title">
                    <i class="fas fa-info"></i>
                    <span>المعلومات الأساسية</span>
                </div>

                <div class="qdrat-form-grid">
                    <div class="qdrat-form-group full">
                        <label asp-for="Name"></label>
                        <input asp-for="Name" class="form-control" autocomplete="off" placeholder="اكتب اسم الدفعة" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="qdrat-form-group">
                        <label asp-for="CourseId"></label>
                        <select asp-for="CourseId" class="form-control" asp-items="Model.Courses">
                            <option value="">اختر الدورة...</option>
                        </select>
                        <span asp-validation-for="CourseId" class="text-danger"></span>
                    </div>

                    <div class="qdrat-form-group">
                        <label asp-for="BranchId" class="control-label">الفرع</label>
                        <select asp-for="BranchId" asp-items="Model.Branches" class="form-control">
                            <option value="">اختر الفرع</option>
                        </select>
                        <span asp-validation-for="BranchId" class="text-danger"></span>
                    </div>

                    <div class="qdrat-form-group">
                        <label asp-for="Gender" class="form-label">الجنس</label>
                        <select asp-for="Gender" class="form-control" asp-items="Html.GetEnumSelectList<BatchGender>()">
                            <option value="">اختر الجنس...</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>

                    <div class="qdrat-form-group">
                        <label asp-for="StartDate"></label>
                        <input asp-for="StartDate" class="form-control" type="date" />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>

                    <div class="qdrat-form-group">
                        <label asp-for="EndDate"></label>
                        <input asp-for="EndDate" class="form-control" type="date" />
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="qdrat-actions">
                    <a asp-action="Index" class="qdrat-btn qdrat-btn-light">
                        <i class="fas fa-arrow-right"></i>
                        رجوع
                    </a>

                    <div class="qdrat-actions-group">
                        <button type="submit" class="qdrat-btn qdrat-btn-primary">
                            <i class="fas fa-save"></i>
                            حفظ التعديلات
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
