@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "📊 تقارير الاختبارات الترويجية";
}

<div class="container mt-4" dir="rtl">
    <h3 class="fw-bold text-primary mb-3">
        📋 قائمة الاختبارات الترويجية
    </h3>

    <table class="table table-striped table-hover text-center align-middle">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>الاسم</th>
                <th>رقم الجوال</th>
                <th>واتساب</th>
                <th>الدورة</th>
                <th>النسبة</th>
                <th>تاريخ الاختبار</th>
                <th>خيارات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                int i = 1;
                foreach (var item in Model)
                {
                    <tr>
                        <td>@i</td>
                        <td>@item.FullName</td>
                        <td>@item.PhoneNumber</td>
                        <td>@item.WhatsAppNumber</td>
                        <td>@item.Name</td>
                        <td><strong>@item.ScorePercent%</strong></td>
                        <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <a asp-action="Report" asp-route-sessionId="@item.Id"
                               class="btn btn-sm btn-outline-primary">
                                🔍 عرض التقرير
                            </a>
                        </td>
                    </tr>
                    i++;
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-muted">لا توجد اختبارات ترويجية بعد.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
