@model dynamic
@{
    ViewData["Title"] = "📑 تقرير اختبار ترويجي";
    var result = Model.Result;
    var attempts = Model.Attempts;
}

<div class="container mt-4" dir="rtl">
    <h3 class="fw-bold text-primary mb-4">📑 تقرير اختبار الطالب</h3>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="mb-2"><strong>عدد الأسئلة:</strong> @result.TotalQuestions</h5>
            <h5 class="mb-2"><strong>الصحيحة:</strong> @result.CorrectAnswers</h5>
            <h5 class="mb-2"><strong>الخاطئة:</strong> @result.WrongAnswers</h5>
            <h5 class="mb-2"><strong>المتخطاة:</strong> @result.SkippedQuestions</h5>
            <h5 class="mb-2"><strong>النسبة:</strong> <span class="text-success">@result.ScorePercent%</span></h5>
        </div>
    </div>

    <h5 class="fw-bold text-primary mb-3">🧩 تفاصيل الأسئلة</h5>

    <table class="table table-bordered table-hover text-center">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>السؤال</th>
                <th>إجابة الطالب</th>
                <th>الإجابة الصحيحة</th>
                <th>النتيجة</th>
            </tr>
        </thead>
        <tbody>
            @{
                int i = 1;
                foreach (var a in attempts)
                {
                    bool correct = a.IsCorrect;
                    <tr class="@(correct ? "table-success" : (string.IsNullOrEmpty(a.SelectedAnswer) ? "table-secondary" : "table-danger"))">
                        <td>@i</td>
                        <td>@Html.Raw(a.Question.Title)</td>
                        <td>@a.SelectedAnswer</td>
                        <td>@a.Question.CorrectAnswer</td>
                        <td>@(correct ? "✔️" : string.IsNullOrEmpty(a.SelectedAnswer) ? "⏭" : "❌")</td>
                    </tr>
                    i++;
                }
            }
        </tbody>
    </table>

    <a asp-action="Index" class="btn btn-outline-primary mt-3">🔙 العودة</a>
</div>
