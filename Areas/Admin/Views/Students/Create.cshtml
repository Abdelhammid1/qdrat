@model QdratNew.ViewModels.StudentViewModel

@{
    ViewData["Title"] = "➕ إضافة طالب جديد";
}

<div class="qdrat-page" dir="rtl">

    <div class="qdrat-hero mb-4">
        <div>
            <div class="qdrat-kicker">
                <i class="fas fa-user-plus"></i>
                إضافة طالب جديد
            </div>
            <h2 class="qdrat-title">@ViewData["Title"]</h2>
            <p class="qdrat-subtitle">
                أدخل بيانات الطالب الأساسية وبيانات الربط بالفرع والدفعة وولي الأمر وحساب المستخدم.
            </p>
        </div>

        <div class="qdrat-hero-icon">
            <i class="fas fa-user-graduate"></i>
        </div>
    </div>

    <form asp-action="Create" method="post" autocomplete="off">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert qdrat-alert qdrat-alert-danger mb-4"></div>

        <div class="row g-4">

            <div class="col-xl-8 col-lg-7 col-md-12">
                <div class="qdrat-card h-100">
                    <div class="qdrat-card-header">
                        <div>
                            <h5>
                                <i class="fas fa-id-card"></i>
                                البيانات الأساسية
                            </h5>
                            <p>بيانات الهوية والتواصل والمرحلة الدراسية الخاصة بالطالب.</p>
                        </div>
                    </div>

                    <div class="qdrat-card-body">
                        <div class="row g-4">

                            <div class="col-lg-6 col-md-12">
                                <div class="qdrat-field">
                                    <label asp-for="NationalID" class="form-label">
                                        الهوية الوطنية
                                    </label>
                                    <div class="qdrat-input-wrap">
                                        <i class="fas fa-id-card"></i>
                                        <input asp-for="NationalID" class="form-control" placeholder="أدخل رقم الهوية الوطنية" />
                                    </div>
                                    <span asp-validation-for="NationalID" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-lg-6 col-md-12">
                                <div class="qdrat-field">
                                    <label asp-for="FullName" class="form-label">
                                        الاسم الكامل
                                    </label>
                                    <div class="qdrat-input-wrap">
                                        <i class="fas fa-user"></i>
                                        <input asp-for="FullName" class="form-control" placeholder="أدخل اسم الطالب بالكامل" />
                                    </div>
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-lg-6 col-md-12">
                                <div class="qdrat-field">
                                    <label asp-for="Email" class="form-label">
                                        البريد الإلكتروني
                                    </label>
                                    <div class="qdrat-input-wrap">
                                        <i class="fas fa-envelope"></i>
                                        <input asp-for="Email" class="form-control" placeholder="example@email.com" />
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-lg-6 col-md-12">
                                <div class="qdrat-field">
                                    <label asp-for="Gender" class="form-label">
                                        الجنس
                                    </label>
                                    <div class="qdrat-input-wrap">
                                        <i class="fas fa-venus-mars"></i>
                                        <select asp-for="Gender" class="form-select">
                                            <option value="">اختر الجنس</option>
                                            <option value="ذكر">ذكر</option>
                                            <option value="أنثى">أنثى</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="Gender" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-lg-6 col-md-12">
                                <div class="qdrat-field">
                                    <label asp-for="PhoneNumber" class="form-label">
                                        رقم الموبايل
                                    </label>
                                    <div class="qdrat-input-wrap">
                                        <i class="fas fa-phone"></i>
                                        <input asp-for="PhoneNumber" class="form-control" placeholder="أدخل رقم الموبايل" />
                                    </div>
                                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-lg-6 col-md-12">
                                <div class="qdrat-field">
                                    <label asp-for="WhatsAppNumber" class="form-label">
                                        رقم الواتساب
                                    </label>
                                    <div class="qdrat-input-wrap">
                                        <i class="fab fa-whatsapp"></i>
                                        <input asp-for="WhatsAppNumber" class="form-control" placeholder="أدخل رقم الواتساب" />
                                    </div>
                                    <span asp-validation-for="WhatsAppNumber" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-lg-6 col-md-12">
                                <div class="qdrat-field">
                                    <label asp-for="School" class="form-label">
                                        المدرسة
                                    </label>
                                    <div class="qdrat-input-wrap">
                                        <i class="fas fa-school"></i>
                                        <input asp-for="School" class="form-control" placeholder="اسم المدرسة" />
                                    </div>
                                    <span asp-validation-for="School" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-lg-6 col-md-12">
                                <div class="qdrat-field">
                                    <label asp-for="Level" class="form-label">
                                        المرحلة الدراسية
                                    </label>
                                    <div class="qdrat-input-wrap">
                                        <i class="fas fa-layer-group"></i>
                                        <input asp-for="Level" class="form-control" placeholder="مثال: ثاني ثانوي" />
                                    </div>
                                    <span asp-validation-for="Level" class="text-danger small"></span>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-4 col-lg-5 col-md-12">
                <div class="qdrat-card h-100">
                    <div class="qdrat-card-header">
                        <div>
                            <h5>
                                <i class="fas fa-link"></i>
                                بيانات الربط
                            </h5>
                            <p>ربط الطالب بالفرع والدفعة وولي الأمر وحالة التسجيل.</p>
                        </div>
                    </div>

                    <div class="qdrat-card-body">
                        <div class="row g-4">

                            <div class="col-12">
                                <div class="qdrat-field">
                                    <label asp-for="BranchId" class="form-label">
                                        الفرع
                                    </label>
                                    <div class="qdrat-input-wrap">
                                        <i class="fas fa-code-branch"></i>
                                        <select asp-for="BranchId" class="form-select" asp-items="Model.Branches">
                                            <option value="">اختر الفرع</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="BranchId" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="qdrat-field">
                                    <label asp-for="BatchId" class="form-label">
                                        الدفعة
                                    </label>
                                    <div class="qdrat-input-wrap">
                                        <i class="fas fa-users"></i>
                                        <select asp-for="BatchId" class="form-select" asp-items="Model.Batches">
                                            <option value="">اختر الدفعة</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="BatchId" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="qdrat-field">
                                    <label asp-for="ParentId" class="form-label">
                                        ولي الأمر
                                    </label>
                                    <div class="qdrat-input-wrap">
                                        <i class="fas fa-user-friends"></i>
                                        <select asp-for="ParentId" class="form-select" asp-items="Model.Parents">
                                            <option value="">اختر ولي الأمر (اختياري)</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="ParentId" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="qdrat-field">
                                    <label asp-for="UserId" class="form-label">
                                        حساب المستخدم
                                    </label>
                                    <div class="qdrat-input-wrap">
                                        <i class="fas fa-user-tag"></i>
                                        <select asp-for="UserId" class="form-select" asp-items="Model.Users">
                                            <option value="">اختيار حساب المستخدم (اختياري)</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="UserId" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="qdrat-field">
                                    <label asp-for="EnrollmentStatus" class="form-label">
                                        حالة التسجيل
                                    </label>
                                    <div class="qdrat-input-wrap">
                                        <i class="fas fa-toggle-on"></i>
                                        <select asp-for="EnrollmentStatus" class="form-select">
                                            <option value="نشط">نشط</option>
                                            <option value="موقوف">موقوف</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="EnrollmentStatus" class="text-danger small"></span>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="qdrat-sticky-actions">
            <a asp-action="Index" class="btn qdrat-btn qdrat-btn-light">
                <i class="fas fa-times"></i>
                إلغاء
            </a>

            <button type="submit" class="btn qdrat-btn qdrat-btn-primary">
                <i class="fas fa-save"></i>
                حفظ
            </button>
        </div>
    </form>
</div>

<style>
    .qdrat-page {
        padding: 24px;
        background: #f5f7fb;
        min-height: calc(100vh - 80px);
        font-family: inherit;
    }

    .qdrat-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 26px;
        border-radius: 24px;
        background: linear-gradient(135deg, #102a43 0%, #1d4ed8 58%, #38bdf8 100%);
        color: #fff;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
    }

    .qdrat-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .qdrat-title {
        margin: 0;
        font-size: 28px;
        font-weight: 900;
        letter-spacing: -0.5px;
    }

    .qdrat-subtitle {
        margin: 10px 0 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 15px;
        line-height: 1.8;
        max-width: 850px;
    }

    .qdrat-hero-icon {
        width: 74px;
        height: 74px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.16);
        font-size: 34px;
        flex: 0 0 auto;
    }

    .qdrat-card {
        border: 1px solid #e5e7eb;
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    .qdrat-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
        background: #fff;
    }

        .qdrat-card-header h5 {
            margin: 0;
            color: #0f172a;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .qdrat-card-header h5 i {
                color: #2563eb;
            }

        .qdrat-card-header p {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 14px;
            line-height: 1.7;
        }

    .qdrat-card-body {
        padding: 24px;
    }

    .qdrat-field .form-label {
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 9px;
    }

    .qdrat-input-wrap {
        position: relative;
    }

        .qdrat-input-wrap > i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 3;
            pointer-events: none;
        }

        .qdrat-input-wrap .form-control,
        .qdrat-input-wrap .form-select {
            min-height: 48px;
            border-radius: 15px;
            border-color: #dbe3ef;
            padding-right: 42px;
            font-weight: 700;
        }

            .qdrat-input-wrap .form-control:focus,
            .qdrat-input-wrap .form-select:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 0.22rem rgba(37, 99, 235, 0.12);
            }

    .qdrat-sticky-actions {
        position: sticky;
        bottom: 16px;
        z-index: 20;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding: 14px;
        margin-top: 24px;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(10px);
        box-shadow: 0 16px 35px rgba(15, 23, 42, 0.12);
    }

    .qdrat-btn {
        min-height: 46px;
        border-radius: 14px;
        padding: 10px 24px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .qdrat-btn-primary {
        background: #16a34a;
        border-color: #16a34a;
        color: #fff;
    }

        .qdrat-btn-primary:hover {
            background: #15803d;
            border-color: #15803d;
            color: #fff;
        }

    .qdrat-btn-light {
        background: #f8fafc;
        border-color: #dbe3ef;
        color: #334155;
    }

        .qdrat-btn-light:hover {
            background: #eef2f7;
            border-color: #cbd5e1;
            color: #0f172a;
        }

    .qdrat-alert {
        border: 0;
        border-radius: 18px;
        padding: 15px 18px;
        font-weight: 800;
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.07);
    }

        .qdrat-alert:empty {
            display: none;
        }

    .qdrat-alert-danger {
        color: #991b1b;
        background: #fee2e2;
    }

    @@media (max-width: 768px) {
        .qdrat-page {
            padding: 14px;
        }

        .qdrat-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 20px;
        }

        .qdrat-title {
            font-size: 23px;
        }

        .qdrat-hero-icon {
            width: 58px;
            height: 58px;
            font-size: 26px;
        }

        .qdrat-card-body,
        .qdrat-card-header {
            padding: 18px;
        }

        .qdrat-sticky-actions {
            flex-direction: column-reverse;
        }

        .qdrat-btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
