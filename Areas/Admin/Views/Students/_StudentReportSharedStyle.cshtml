<style>
    .sr-page { background: #f1f5f9; min-height: 100vh; font-family: 'Cairo','Tajawal',sans-serif; direction: rtl; }

    /* Nav */
    .sr-nav { background: #1e293b; padding: 12px 24px; display: flex; align-items: center; gap: 12px; }
    .sr-back { color: #94a3b8; text-decoration: none; font-size: .82rem; font-weight: 600; transition: color .15s; }
    .sr-back:hover { color: #fff; }
    .sr-sep  { width: 1px; height: 18px; background: #334155; }
    .sr-crumb { display: flex; align-items: center; gap: 6px; font-size: .78rem; color: #64748b; }
    .sr-crumb a { color: #94a3b8; text-decoration: none; }
    .sr-crumb a:hover { color: #fff; }
    .sr-crumb span:last-child { color: #e2e8f0; font-weight: 600; }

    .sr-body { padding: 22px; max-width: 1100px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px; }

    /* Hero */
    .sr-hero {
        border-radius: 14px; padding: 22px 28px; color: #fff;
        display: flex; align-items: center; gap: 18px;
    }
    .sr-hero.blue  { background: linear-gradient(135deg,#1e40af,#1e293b); }
    .sr-hero.amber { background: linear-gradient(135deg,#92400e,#1e293b); }
    .sr-hero.green { background: linear-gradient(135deg,#065f46,#1e293b); }

    .sr-hero-icon {
        font-size: 2.4rem; width: 60px; height: 60px; border-radius: 14px;
        background: rgba(255,255,255,.12); display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .sr-hero-info { flex: 1; }
    .sr-hero-info h1 { font-size: 1.3rem; font-weight: 800; margin: 0 0 4px; }
    .sr-hero-name { font-size: .82rem; color: rgba(255,255,255,.6); }
    .sr-hero-kpis { display: flex; gap: 20px; flex-shrink: 0; }
    .sr-hkpi { text-align: center; }
    .sr-hkpi-n { display: block; font-size: 1.5rem; font-weight: 800; line-height: 1; }
    .sr-hkpi-l { display: block; font-size: .68rem; color: rgba(255,255,255,.55); margin-top: 4px; }

    /* Bar */
    .sr-bar-card {
        background: #fff; border-radius: 12px;
        padding: 14px 18px; box-shadow: 0 1px 4px rgba(0,0,0,.06);
    }
    .sr-bar-label { display: flex; justify-content: space-between; font-size: .82rem; color: #475569; margin-bottom: 8px; }
    .sr-bar { height: 8px; background: #e2e8f0; border-radius: 4px; overflow: hidden; }
    .sr-bar-fill { height: 100%; border-radius: 4px; transition: width .8s ease; }

    /* Card */
    .sr-card { background: #fff; border-radius: 14px; box-shadow: 0 1px 4px rgba(0,0,0,.06); overflow: hidden; }
    .sr-card-head {
        display: flex; align-items: center; justify-content: space-between;
        padding: 14px 18px; border-bottom: 1px solid #f1f5f9;
    }
    .sr-card-title { font-size: .9rem; font-weight: 700; color: #1e293b; }
    .sr-filters { display: flex; gap: 6px; }
    .sr-filter {
        padding: 5px 12px; border: 1.5px solid #e2e8f0; border-radius: 8px;
        background: #f8fafc; color: #64748b; font-size: .75rem; font-weight: 700;
        cursor: pointer; font-family: 'Cairo','Tajawal',sans-serif; transition: all .15s;
    }
    .sr-filter.active, .sr-filter:hover { background: #2563eb; border-color: #2563eb; color: #fff; }

    /* Table */
    .sr-table-wrap { overflow-x: auto; }
    .sr-table { width: 100%; border-collapse: collapse; }
    .sr-table th {
        background: #f8fafc; padding: 10px 14px;
        font-size: .75rem; font-weight: 700; color: #64748b;
        text-align: right; border-bottom: 1px solid #e2e8f0; white-space: nowrap;
    }
    .sr-table td {
        padding: 11px 14px; border-bottom: 1px solid #f1f5f9;
        font-size: .83rem; color: #1e293b; vertical-align: middle;
    }
    .sr-table tr:hover td { background: #f8fafc; }
    .sr-num  { color: #94a3b8; font-size: .72rem; width: 32px; }
    .sr-fw   { font-weight: 700; }
    .sr-mute { color: #64748b; font-size: .78rem; }

    .sr-badge { padding: 3px 10px; border-radius: 20px; font-size: .75rem; font-weight: 700; }
    .badge-green { background: #d1fae5; color: #065f46; }
    .badge-red   { background: #fee2e2; color: #991b1b; }

    .sr-score { font-size: 1rem; font-weight: 800; }
    .sr-score.good    { color: #059669; }
    .sr-score.warn    { color: #d97706; }
    .sr-score.bad     { color: #dc2626; }
    .sr-score.neutral { color: #94a3b8; }

    .sr-late { background: #fef3c7; color: #92400e; font-size: .68rem; font-weight: 700; padding: 2px 7px; border-radius: 10px; margin-right: 4px; }
    .sr-closed-tag { background: #fee2e2; color: #991b1b; font-size: .68rem; font-weight: 700; padding: 2px 7px; border-radius: 10px; margin-right: 4px; }

    .sr-action-link {
        display: inline-block; padding: 5px 10px; border-radius: 7px;
        background: #eff6ff; color: #2563eb; text-decoration: none;
        font-size: .72rem; font-weight: 700; margin-bottom: 3px;
        transition: background .15s;
    }
    .sr-action-link:hover { background: #dbeafe; }
    .sr-action-link.secondary { background: #f0fdf4; color: #059669; }
    .sr-action-link.secondary:hover { background: #dcfce7; }

    .sr-link {
        color: #2563eb; text-decoration: none; font-size: .78rem; font-weight: 700;
    }
    .sr-link:hover { color: #1d4ed8; }

    .sr-empty { text-align: center; padding: 40px; color: #94a3b8; font-size: .9rem; background: #fff; border-radius: 14px; }

    @@media (max-width: 768px) {
        .sr-hero { flex-direction: column; align-items: flex-start; }
        .sr-hero-kpis { gap: 12px; }
    }
</style>
