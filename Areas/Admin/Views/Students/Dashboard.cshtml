<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('studentsLiveSearch');
        const visibleRows = document.getElementById('visibleRows');
        const noLiveRows = document.getElementById('noLiveRows');
        const rows = Array.from(document.querySelectorAll('#studentsDashboardTable tbody tr'));

        function normalize(value) {
            if (!value) {
                return '';
            }

            return value.toString().trim().toLowerCase();
        }

        function applyLiveSearch() {
            const searchValue = normalize(searchInput ? searchInput.value : '');
            let shown = 0;

            rows.forEach(function (row) {
                const rowSearch = normalize(row.getAttribute('data-search'));
                const visible = searchValue === '' || rowSearch.indexOf(searchValue) !== -1;

                row.style.display = visible ? '' : 'none';

                if (visible) {
                    shown++;
                }
            });

            if (visibleRows) {
                visibleRows.textContent = shown;
            }

            if (noLiveRows) {
                noLiveRows.classList.toggle('d-none', shown !== 0);
            }
        }

        if (searchInput) {
            searchInput.addEventListener('input', applyLiveSearch);
        }

        applyLiveSearch();
    });
</script>