@model IEnumerable<QdratNew.ViewModels.Students.StudentActivityItemVm>

@{
    ViewData["Title"] = $"سجل نشاط: {ViewBag.StudentName}";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int studentId   = ViewBag.StudentId;
    string name     = ViewBag.StudentName;
    var lastLogin   = ViewBag.LastLoginAt as DateTime?;
    var items       = Model.ToList();
}

<div class="al-page" dir="rtl">

    <nav class="al-nav">
        <div class="al-nav-inner">
            <a class="al-back" asp-area="Admin" asp-controller="Students" asp-action="Details"
               asp-route-id="@studentId">← العودة لملف الطالب</a>
            <div class="al-sep"></div>
            <div class="al-crumb">
                <a asp-area="Admin" asp-controller="Students" asp-action="Index">الطلاب</a>
                <span>›</span>
                <a asp-area="Admin" asp-controller="Students" asp-action="Details" asp-route-id="@studentId">@name</a>
                <span>›</span>
                <span>سجل النشاط</span>
            </div>
        </div>
    </nav>

    <div class="al-body">

        <div class="al-hero">
            <div class="al-av">@(name.Length >= 2 ? name[..2] : "ط")</div>
            <div>
                <h1 class="al-name">@name</h1>
                <div class="al-sub">
                    سجل النشاط — الواجبات والاختبارات والحضور
                    @if (lastLogin.HasValue)
                    {
                        <span> • آخر دخول: @lastLogin.Value.ToString("yyyy/MM/dd HH:mm")</span>
                    }
                </div>
            </div>
        </div>

        <div class="al-kpis">
            <div class="al-kpi g">
                <div class="al-kpi-n">@items.Count(i => i.Type == "واجب" && i.CssTag.Contains("green"))</div>
                <div class="al-kpi-l">واجبات مُسلَّمة</div>
            </div>
            <div class="al-kpi r">
                <div class="al-kpi-n">@items.Count(i => i.Type == "واجب" && !i.CssTag.Contains("green"))</div>
                <div class="al-kpi-l">واجبات غير مُسلَّمة</div>
            </div>
            <div class="al-kpi b">
                <div class="al-kpi-n">@items.Count(i => i.Type == "حضور" && i.CssTag.Contains("green"))</div>
                <div class="al-kpi-l">حضور مسجل</div>
            </div>
            <div class="al-kpi a">
                <div class="al-kpi-n">@items.Count(i => i.Type == "اختبار" && i.CssTag.Contains("blue"))</div>
                <div class="al-kpi-l">اختبارات مُقدَّمة</div>
            </div>
        </div>

        @if (!items.Any())
        {
            <div class="al-empty">لا يوجد نشاط مسجل لهذا الطالب.</div>
        }
        else
        {
            <div class="al-timeline">
                @foreach (var item in items)
                {
                    <div class="al-item">
                        <div class="al-item-icon">@item.Icon</div>
                        <div class="al-item-body">
                            <div class="al-item-row">
                                <span class="al-tag @item.CssTag">@item.Type</span>
                                <span class="al-item-title">@item.Title</span>
                            </div>
                            <div class="al-item-detail">@item.Detail</div>
                        </div>
                        <div class="al-item-date">@item.Date.ToString("yyyy/MM/dd HH:mm")</div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .al-page { background: #f1f5f9; min-height: 100vh; font-family: 'Cairo','Tajawal',sans-serif; direction: rtl; }
    .al-nav { background: #1e293b; padding: 12px 24px; }
    .al-nav-inner { display: flex; align-items: center; gap: 12px; }
    .al-back { color: #94a3b8; text-decoration: none; font-size: .82rem; font-weight: 600; transition: color .15s; }
    .al-back:hover { color: #fff; }
    .al-sep { width: 1px; height: 18px; background: #334155; }
    .al-crumb { display: flex; align-items: center; gap: 6px; font-size: .78rem; color: #64748b; }
    .al-crumb a { color: #94a3b8; text-decoration: none; }
    .al-crumb a:hover { color: #fff; }
    .al-crumb span:last-child { color: #e2e8f0; font-weight: 600; }

    .al-body { padding: 24px; max-width: 860px; margin: 0 auto; }

    .al-hero {
        display: flex; align-items: center; gap: 16px;
        background: linear-gradient(135deg,#1e293b,#0f172a);
        border-radius: 14px; padding: 22px 28px; margin-bottom: 18px; color: #fff;
    }
    .al-av {
        width: 52px; height: 52px; border-radius: 14px;
        background: linear-gradient(135deg,#d97706,#f59e0b);
        color: #fff; font-size: 1.2rem; font-weight: 800;
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .al-name { font-size: 1.2rem; font-weight: 800; margin: 0 0 4px; }
    .al-sub  { font-size: .78rem; color: #94a3b8; }

    .al-kpis { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px; margin-bottom: 18px; }
    .al-kpi {
        background: #fff; border-radius: 12px; padding: 14px 16px;
        border-top: 3px solid transparent; box-shadow: 0 1px 4px rgba(0,0,0,.06); text-align: center;
    }
    .al-kpi.g { border-top-color: #059669; }
    .al-kpi.r { border-top-color: #dc2626; }
    .al-kpi.b { border-top-color: #2563eb; }
    .al-kpi.a { border-top-color: #d97706; }
    .al-kpi-n { font-size: 1.5rem; font-weight: 800; color: #1e293b; }
    .al-kpi-l { font-size: .7rem; color: #64748b; margin-top: 3px; }

    .al-empty { text-align: center; padding: 40px; color: #94a3b8; font-size: .9rem; }

    .al-timeline {
        display: flex; flex-direction: column; gap: 0;
        background: #fff; border-radius: 14px;
        box-shadow: 0 1px 4px rgba(0,0,0,.06); overflow: hidden;
    }
    .al-item {
        display: flex; align-items: center; gap: 14px;
        padding: 13px 18px; border-bottom: 1px solid #f1f5f9;
        transition: background .12s;
    }
    .al-item:hover { background: #f8fafc; }
    .al-item:last-child { border-bottom: none; }
    .al-item-icon { font-size: 1.3rem; flex-shrink: 0; width: 28px; text-align: center; }
    .al-item-body { flex: 1; min-width: 0; }
    .al-item-row  { display: flex; align-items: center; gap: 8px; margin-bottom: 3px; }
    .al-tag {
        padding: 2px 8px; border-radius: 10px;
        font-size: .68rem; font-weight: 700; flex-shrink: 0;
    }
    .tag-green { background: #d1fae5; color: #065f46; }
    .tag-amber { background: #fef3c7; color: #92400e; }
    .tag-blue  { background: #dbeafe; color: #1e40af; }
    .tag-red   { background: #fee2e2; color: #991b1b; }
    .al-item-title  { font-size: .85rem; font-weight: 700; color: #1e293b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .al-item-detail { font-size: .75rem; color: #64748b; }
    .al-item-date   { font-size: .72rem; color: #94a3b8; flex-shrink: 0; direction: ltr; text-align: left; }

    @@media (max-width: 600px) {
        .al-kpis { grid-template-columns: repeat(2,1fr); }
    }
</style>
