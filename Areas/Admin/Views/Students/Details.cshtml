@model QdratNew.ViewModels.Students.StudentDetailsDashboardViewModel

@{
    ViewData["Title"] = "تفاصيل الطالب";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var ringCircumference = 251.2;
    var safeHealthScore = Model.LearningHealthScore < 0 ? 0 : Model.LearningHealthScore > 100 ? 100 : Model.LearningHealthScore;
    var ringOffset = ringCircumference * (1 - (safeHealthScore / 100.0));
}

<div class="student-details-page" dir="rtl">

    <nav class="student-topnav">
        <div class="nav-brand">
            <span class="nav-logo">قدرات</span>
            <div class="nav-sep"></div>
            <div class="nav-breadcrumb">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index">لوحة التحكم</a>
                <span>›</span>
                <a asp-area="Admin" asp-controller="Students" asp-action="Index">الطلاب</a>
                <span>›</span>
                <span class="current">@Model.FullName</span>
            </div>
        </div>

        <div class="nav-actions">
            <a class="nav-btn" asp-area="Admin" asp-controller="Students" asp-action="Index">↩ رجوع</a>
            <button type="button" class="nav-btn">⬇ تصدير PDF</button>
            <button type="button" class="nav-btn">✉ إرسال تقرير</button>
            <a class="nav-btn primary" asp-area="Admin" asp-controller="Students" asp-action="Edit" asp-route-id="@Model.StudentID">⚙ تعديل الطالب</a>
        </div>
    </nav>

    <div class="student-page">

        <section class="student-hero student-fade d1">
            <div class="hero-content">
                <div class="hero-left">
                    <div class="hero-avatar">@Model.AvatarText</div>

                    <div class="hero-info">
                        <h1>@Model.FullName</h1>

                        <div class="hero-meta">
                            <span class="hero-tag @(Model.EnrollmentStatus == "نشط" || Model.EnrollmentStatus == "Active" ? "active" : "danger")">● @Model.StatusText</span>
                            <span class="hero-tag info">@Model.Level</span>
                            <span class="hero-tag info">@Model.Gender</span>
                            <span class="hero-tag neutral">@Model.BranchName</span>
                            <span class="hero-tag neutral">@Model.BatchesCount دفعات</span>
                            <span class="hero-tag neutral">ولي الأمر: @Model.ParentName</span>
                        </div>

                        <p class="hero-desc">
                            ملف تحليلي للطالب يعرض حالته التعليمية، الحضور، الواجبات، الاختبارات، محاولات الأسئلة، الخطط العلاجية، ومؤشرات التدخل المبكر.
                        </p>

                        <div class="contact-grid">
                            <div class="contact-item">
                                <span>الهوية</span>
                                <strong>@Model.NationalID</strong>
                            </div>

                            <div class="contact-item">
                                <span>الجوال</span>
                                <strong>@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "غير محدد" : Model.PhoneNumber)</strong>
                            </div>

                            <div class="contact-item">
                                <span>واتساب</span>
                                <strong>@(string.IsNullOrWhiteSpace(Model.WhatsAppNumber) ? "غير محدد" : Model.WhatsAppNumber)</strong>
                            </div>

                            <div class="contact-item">
                                <span>البريد</span>
                                <strong>@(string.IsNullOrWhiteSpace(Model.Email) ? "غير محدد" : Model.Email)</strong>
                            </div>

                            <div class="contact-item">
                                <span>المدرسة</span>
                                <strong>@(string.IsNullOrWhiteSpace(Model.School) ? "غير محدد" : Model.School)</strong>
                            </div>

                            <div class="contact-item">
                                <span>آخر دخول</span>
                                <strong>@(Model.LastLoginAt.HasValue? Model.LastLoginAt.Value.ToString("yyyy/MM/dd HH:mm") : "لا يوجد")</strong>
                            </div>
                        </div>

                        <div class="hero-actions">
                            <button type="button" class="hbtn outline">📊 تقرير مفصل</button>
                            <button type="button" class="hbtn solid-blue">✉ مراسلة الطالب</button>
                            <button type="button" class="hbtn solid-amber">⚠ إشعار متابعة</button>
                            <button type="button" class="hbtn solid-red">🚨 إجراء عاجل</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="health-ring-wrap">
                <div class="health-ring">
                    <svg viewBox="0 0 100 100" aria-hidden="true">
                        <circle class="ring-bg" cx="50" cy="50" r="40"></circle>
                        <circle class="ring-fill"
                                cx="50"
                                cy="50"
                                r="40"
                                stroke="@(safeHealthScore >= 85 ? "#059669" : safeHealthScore >= 70 ? "#2563eb" : safeHealthScore >= 55 ? "#d97706" : "#dc2626")"
                                stroke-dasharray="251.2"
                                stroke-dashoffset="@ringOffset.ToString("0.##")"></circle>
                    </svg>
                    <div class="ring-val">
                        @safeHealthScore.ToString("0")
                        <small>%</small>
                    </div>
                </div>

                <div class="health-label">
                    مؤشر صحة الطالب
                    <span class="@Model.LearningHealthCssClass">@Model.LearningHealthLabel</span>
                </div>
            </div>
        </section>

        <section class="kpi-strip">
            <article class="kpi-card g student-fade d1">
                <div class="kpi-icon g">✅</div>
                <div class="kpi-val">@Model.AttendancePercent.ToString("0")<sup>%</sup></div>
                <div class="kpi-label">الحضور</div>
                <div class="kpi-delta @(Model.AttendancePercent >= 85 ? "up" : "dn")">@Model.AttendanceDeltaText</div>
            </article>

            <article class="kpi-card a student-fade d2">
                <div class="kpi-icon a">📝</div>
                <div class="kpi-val">@Model.HomeworkSubmissionPercent.ToString("0")<sup>%</sup></div>
                <div class="kpi-label">تسليم الواجبات</div>
                <div class="kpi-delta @(Model.HomeworkSubmissionPercent >= 90 ? "up" : "dn")">@Model.HomeworkDeltaText</div>
            </article>

            <article class="kpi-card p student-fade d3">
                <div class="kpi-icon p">🧪</div>
                <div class="kpi-val">@Model.ExamAverageScore.ToString("0")<sup>%</sup></div>
                <div class="kpi-label">متوسط الاختبارات</div>
                <div class="kpi-delta @(Model.ExamAverageScore >= 80 ? "up" : "dn")">@Model.ExamDeltaText</div>
            </article>

            <article class="kpi-card b student-fade d4">
                <div class="kpi-icon b">🎯</div>
                <div class="kpi-val">@Model.CorrectAnswerPercent.ToString("0")<sup>%</sup></div>
                <div class="kpi-label">الإجابات الصحيحة</div>
                <div class="kpi-delta @(Model.CorrectAnswerPercent >= 75 ? "up" : "dn")">@Model.CorrectAnswerDeltaText</div>
            </article>

            <article class="kpi-card r student-fade d5">
                <div class="kpi-icon r">⚠</div>
                <div class="kpi-val">@Model.HomeworksMissingCount</div>
                <div class="kpi-label">واجبات متأخرة</div>
                <div class="kpi-delta @(Model.HomeworksMissingCount == 0 ? "up" : "dn")">@Model.HomeworksSubmittedCount / @Model.HomeworksAssignedCount تم تسليمه</div>
            </article>

            <article class="kpi-card t student-fade d6">
                <div class="kpi-icon t">🧩</div>
                <div class="kpi-val">@Model.RemedialPlansCount</div>
                <div class="kpi-label">خطط علاجية</div>
                <div class="kpi-delta eq">@Model.CompletedRemedialPlansCount مكتملة</div>
            </article>
        </section>

        <section class="main-grid">

            <div class="left-stack">

                <section class="dash-card student-fade d2">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent blue"></div>
                            <div>
                                <div class="ch-title">أداء الطالب داخل الدفعات</div>
                                <div class="ch-sub">@Model.Batches.Count دفعات مرتبطة بالطالب</div>
                            </div>
                        </div>
                    </div>

                    <div class="batch-grid">
                        @if (Model.Batches.Any())
                        {
                            foreach (var batch in Model.Batches)
                            {
                                var safeHealth = batch.BatchStudentHealthScore < 0 ? 0 : batch.BatchStudentHealthScore > 100 ? 100 : batch.BatchStudentHealthScore;

                                <a class="batch-card @batch.HealthCssClass" asp-area="Admin" asp-controller="Batches" asp-action="Details" asp-route-id="@batch.BatchId">
                                    <div class="batch-top">
                                        <strong>@batch.BatchName</strong>
                                        <span>@safeHealth.ToString("0")%</span>
                                    </div>

                                    <div class="mini-meter">
                                        <div class="mini-meter-fill" style="width:@safeHealth.ToString("0")%"></div>
                                    </div>

                                    <div class="batch-metrics">
                                        <span>@batch.CourseName</span>
                                        <span>حضور: @batch.AttendancePercent.ToString("0")%</span>
                                        <span>واجبات: @batch.HomeworkSubmissionPercent.ToString("0")%</span>
                                        <span>اختبارات: @batch.ExamAverageScore.ToString("0")%</span>
                                    </div>

                                    <p>@batch.DecisionHint</p>
                                </a>
                            }
                        }
                        else
                        {
                            <div class="empty full">لا توجد دفعات مرتبطة بهذا الطالب.</div>
                        }
                    </div>
                </section>

                <section class="dash-card student-fade d3">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent amber"></div>
                            <div>
                                <div class="ch-title">آخر الواجبات</div>
                                <div class="ch-sub">@Model.Homeworks.Count واجبات ظاهرة في التقرير</div>
                            </div>
                        </div>
                    </div>

                    <div class="table-wrap">
                        <table class="impact-table">
                            <thead>
                                <tr>
                                    <th style="width:32%">الواجب</th>
                                    <th>الدفعة</th>
                                    <th>الحالة</th>
                                    <th>الدرجة</th>
                                    <th>التكليف</th>
                                    <th>التسليم</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Homeworks.Any())
                                {
                                    foreach (var homework in Model.Homeworks)
                                    {
                                        <tr>
                                            <td>
                                                <div class="item-title">@homework.Title</div>
                                                <div class="item-sub">إغلاق: @(homework.EndAt.HasValue? homework.EndAt.Value.ToString("yyyy/MM/dd") : "غير محدد")</div>
                                            </td>
                                            <td>@homework.BatchName</td>
                                            <td><span class="impact-status @homework.StatusCssClass">@homework.StatusText</span></td>
                                            <td class="fw8">@(homework.Score.HasValue? homework.Score.Value.ToString("0") : "—")<span class="txt-blue">/100</span></td>
                                            <td>@homework.AssignedAt.ToString("yyyy/MM/dd")</td>
                                            <td>@(homework.SubmittedAt.HasValue? homework.SubmittedAt.Value.ToString("yyyy/MM/dd") : "لم يسلم")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="empty">لا توجد واجبات مرتبطة بهذا الطالب.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>

                <section class="dash-card student-fade d4">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent purple"></div>
                            <div>
                                <div class="ch-title">آخر الاختبارات</div>
                                <div class="ch-sub">@Model.Exams.Count اختبارات ظاهرة في التقرير</div>
                            </div>
                        </div>
                    </div>

                    <div class="table-wrap">
                        <table class="impact-table">
                            <thead>
                                <tr>
                                    <th style="width:32%">الاختبار</th>
                                    <th>الدفعة</th>
                                    <th>الحالة</th>
                                    <th>الدرجة</th>
                                    <th>التكليف</th>
                                    <th>التسليم</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Exams.Any())
                                {
                                    foreach (var exam in Model.Exams)
                                    {
                                        <tr>
                                            <td>
                                                <div class="item-title">@exam.Title</div>
                                                <div class="item-sub">Assignment: @(exam.ExamAssignmentId.HasValue? exam.ExamAssignmentId.Value.ToString() : "—")</div>
                                            </td>
                                            <td>@exam.BatchName</td>
                                            <td><span class="impact-status @exam.StatusCssClass">@exam.StatusText</span></td>
                                            <td class="fw8">@(exam.Score.HasValue? exam.Score.Value.ToString("0") : "—")<span class="txt-blue">/100</span></td>
                                            <td>@exam.AssignedAt.ToString("yyyy/MM/dd")</td>
                                            <td>@(exam.SubmittedAt.HasValue? exam.SubmittedAt.Value.ToString("yyyy/MM/dd") : "لم يسلم")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="empty">لا توجد اختبارات مرتبطة بهذا الطالب.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>

            </div>

            <aside class="right-stack">

                <section class="dash-card student-fade d2">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent ink"></div>
                            <div>
                                <div class="ch-title">التشخيص الذكي للطالب</div>
                                <div class="ch-sub">قوة، ضعف، خطر، فرصة تدخل</div>
                            </div>
                        </div>
                        <span class="ch-badge neutral">@Model.DiagnosisItems.Count عناصر</span>
                    </div>

                    <div class="diag-section">
                        @foreach (var item in Model.DiagnosisItems)
                        {
                            <div class="diag-item">
                                <div class="diag-icon @item.CssClass">@item.Icon</div>
                                <div>
                                    <div class="diag-title">@item.Title</div>
                                    <div class="diag-body">@item.Body</div>
                                </div>
                            </div>
                        }
                    </div>
                </section>

                <section class="dash-card student-fade d3">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent green"></div>
                            <div>
                                <div class="ch-title">سجل الحضور — @DateTime.Today.ToString("MMMM yyyy")</div>
                                <div class="ch-sub">حضور الطالب اليومي</div>
                            </div>
                        </div>
                    </div>

                    <div class="att-month">
                        <div class="att-week-labels">
                            <div class="att-wl">أح</div>
                            <div class="att-wl">إث</div>
                            <div class="att-wl">ثل</div>
                            <div class="att-wl">أر</div>
                            <div class="att-wl">خم</div>
                            <div class="att-wl">جم</div>
                            <div class="att-wl">سب</div>
                        </div>

                        <div class="att-grid-cal">
                            @foreach (var day in Model.AttendanceCalendar)
                            {
                                <div class="att-day @day.CssClass" title="@day.Date.ToString("yyyy/MM/dd")">
                                    @(day.HasLecture ? (day.IsPresent ? "✓" : "×") : "—")
                                </div>
                            }
                        </div>

                        <div class="att-legend">
                            <span><i style="background:var(--green-lt)"></i>حاضر</span>
                            <span><i style="background:var(--red-lt)"></i>غائب</span>
                            <span><i style="background:var(--bg-2)"></i>لا توجد محاضرة</span>
                        </div>
                    </div>
                </section>

                <section class="dash-card student-fade d4">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent purple"></div>
                            <div>
                                <div class="ch-title">مؤشرات الأداء الإجمالية</div>
                                <div class="ch-sub">مقارنة بالأهداف المطلوبة</div>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        @foreach (var item in Model.ProgressBars)
                        {
                            var safeValue = item.Value < 0 ? 0 : item.Value > 100 ? 100 : item.Value;

                            <div class="prog-item">
                                <div class="prog-head">
                                    <span>@item.Label</span>
                                    <b>@safeValue.ToString("0")% <span>/ هدف @item.Target.ToString("0")%</span></b>
                                </div>
                                <div class="prog-track">
                                    <div class="prog-fill" style="width:@safeValue.ToString("0")%;background:@item.CssColor"></div>
                                </div>
                            </div>
                        }
                    </div>
                </section>

                <section class="dash-card student-fade d5">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent red"></div>
                            <div>
                                <div class="ch-title">المحاور الأضعف</div>
                                <div class="ch-sub">حسب محاولات الأسئلة الخاطئة</div>
                            </div>
                        </div>
                    </div>

                    <div class="weakness-list">
                        @if (Model.WeaknessSections.Any())
                        {
                            foreach (var item in Model.WeaknessSections)
                            {
                                <div class="weakness-item @item.CssClass">
                                    <div>
                                        <strong>@item.Title</strong>
                                        <span>@item.WrongAttemptsCount خطأ من @item.TotalAttemptsCount محاولة</span>
                                    </div>
                                    <b>@item.WrongPercent.ToString("0")%</b>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty">لا توجد محاولات أسئلة كافية للتحليل.</div>
                        }
                    </div>
                </section>

            </aside>
        </section>

        <section class="full-section student-fade d6">
            <div class="sec-label">
                <div class="sec-label-line"></div>
                <div>
                    <h2>الخطط العلاجية وسجل الأداء</h2>
                    <p>آخر الخطط العلاجية وأحدث سجلات الأداء الأكاديمي</p>
                </div>
            </div>

            <div class="students-split">
                <section class="student-card">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent amber"></div>
                            <div>
                                <div class="ch-title">الخطط العلاجية</div>
                                <div class="ch-sub">@Model.RemedialPlans.Count خطط ظاهرة</div>
                            </div>
                        </div>
                    </div>

                    @if (Model.RemedialPlans.Any())
                    {
                        foreach (var plan in Model.RemedialPlans)
                        {
                            <div class="plan-row">
                                <div>
                                    <strong>@plan.Title</strong>
                                    <span>@plan.PerformanceLevel • @plan.CreatedAt.ToString("yyyy/MM/dd")</span>
                                </div>
                                <div class="plan-progress">
                                    <span>@plan.CompletedLessons / @plan.TotalLessons</span>
                                    <div class="mini-meter">
                                        <div class="mini-meter-fill" style="width:@plan.CompletionPercent.ToString("0")%"></div>
                                    </div>
                                </div>
                                <span class="impact-status @plan.StatusCssClass">@plan.StatusText</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty">لا توجد خطط علاجية لهذا الطالب.</div>
                    }
                </section>

                <section class="student-card">
                    <div class="card-head">
                        <div class="ch-left">
                            <div class="ch-accent blue"></div>
                            <div>
                                <div class="ch-title">سجل الأداء الأكاديمي</div>
                                <div class="ch-sub">@Model.Performances.Count سجلات ظاهرة</div>
                            </div>
                        </div>
                    </div>

                    @if (Model.Performances.Any())
                    {
                        foreach (var item in Model.Performances)
                        {
                            <div class="performance-row @item.CssClass">
                                <div>
                                    <strong>@item.Level</strong>
                                    <span>@item.ExamDate.ToString("yyyy/MM/dd") • تفاعل @item.EngagementScore.ToString("0")%</span>
                                </div>
                                <b>@item.Score.ToString("0")%</b>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty">لا توجد سجلات أداء أكاديمي.</div>
                    }
                </section>
            </div>
        </section>
    </div>
</div>

<style>
    .student-details-page {
        --font: 'Cairo', 'Tahoma', sans-serif;
        --ink: #0d1117;
        --ink-3: #374151;
        --mute: #6b7280;
        --mute-2: #9ca3af;
        --mute-3: #d1d5db;
        --bg: #f4f6fb;
        --bg-2: #eef1f8;
        --surface: #ffffff;
        --border: #e5e8f0;
        --green: #059669;
        --green-lt: #d1fae5;
        --green-dk: #064e3b;
        --blue: #2563eb;
        --blue-lt: #dbeafe;
        --blue-dk: #1e3a8a;
        --amber: #d97706;
        --amber-lt: #fef3c7;
        --amber-dk: #78350f;
        --red: #dc2626;
        --red-lt: #fee2e2;
        --red-dk: #7f1d1d;
        --purple: #7c3aed;
        --purple-lt: #ede9fe;
        --purple-dk: #3b0764;
        --teal: #0891b2;
        --teal-lt: #cffafe;
        --radius: 12px;
        --radius-lg: 18px;
        --shadow: 0 2px 16px rgba(13, 17, 23, .07);
        --shadow-sm: 0 1px 6px rgba(13, 17, 23, .05);
        min-height: 100vh;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font);
        font-size: 14px;
        line-height: 1.6;
    }

        .student-details-page *,
        .student-details-page *::before,
        .student-details-page *::after {
            box-sizing: border-box;
        }

        .student-details-page a {
            text-decoration: none;
        }

    @@keyframes studentFadeUp {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .student-details-page .student-fade {
        opacity: 1 !important;
        animation: studentFadeUp .45s ease both;
    }

    .student-details-page .d1 {
        animation-delay: .05s;
    }

    .student-details-page .d2 {
        animation-delay: .10s;
    }

    .student-details-page .d3 {
        animation-delay: .15s;
    }

    .student-details-page .d4 {
        animation-delay: .20s;
    }

    .student-details-page .d5 {
        animation-delay: .25s;
    }

    .student-details-page .d6 {
        animation-delay: .30s;
    }

    .student-topnav {
        background: var(--ink);
        padding: 0 28px;
        min-height: 54px;
        display: flex;
