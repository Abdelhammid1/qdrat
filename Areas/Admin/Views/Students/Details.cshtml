        }

    .nav-btn {
        font-family: var(--font);
        font-size: 12px;
        font-weight: 700;
        padding: 7px 14px;
        border-radius: 9px;
        border: 1px solid rgba(255, 255, 255, .16);
        background: transparent;
        color: rgba(255, 255, 255, .75);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

        .nav-btn.primary {
            background: var(--blue);
            color: #fff;
            border-color: var(--blue);
        }

    .student-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 28px 28px 60px;
    }

    .student-hero {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 28px 32px;
        margin-bottom: 20px;
        box-shadow: var(--shadow);
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 32px;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

        .student-hero::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 360px;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(37, 99, 235, .055));
            pointer-events: none;
        }

    .hero-content {
        position: relative;
        z-index: 1;
        min-width: 0;
    }

    .hero-left {
        display: flex;
        align-items: center;
        gap: 24px;
        min-width: 0;
    }

    .hero-avatar {
        width: 76px;
        height: 76px;
        border-radius: 20px;
        background: linear-gradient(135deg, #1e3a8a, #2563eb);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        font-weight: 800;
        color: #fff;
        flex-shrink: 0;
        box-shadow: 0 8px 24px rgba(37, 99, 235, .25);
    }

    .hero-info h1 {
        font-size: 26px;
        font-weight: 800;
        color: var(--ink);
        line-height: 1.2;
        margin: 0;
    }

    .hero-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 10px;
    }

    .hero-tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 11.5px;
        padding: 3px 10px;
        border-radius: 20px;
        border: 1px solid;
        font-weight: 700;
        white-space: nowrap;
    }

        .hero-tag.active {
            background: var(--green-lt);
            color: var(--green-dk);
            border-color: rgba(5, 150, 105, .25);
        }

        .hero-tag.danger {
            background: var(--red-lt);
            color: var(--red-dk);
            border-color: rgba(220, 38, 38, .25);
        }

        .hero-tag.info {
            background: var(--blue-lt);
            color: var(--blue-dk);
            border-color: rgba(37, 99, 235, .2);
        }

        .hero-tag.neutral {
            background: var(--bg-2);
            color: var(--ink-3);
            border-color: var(--border);
        }

    .hero-desc {
        font-size: 13px;
        color: var(--mute);
        margin: 8px 0 0;
        max-width: 780px;
        line-height: 1.7;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
        margin-top: 14px;
        max-width: 900px;
    }

    .contact-item {
        background: var(--bg-2);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 9px 10px;
        min-width: 0;
    }

        .contact-item span {
            display: block;
            color: var(--mute);
            font-size: 10.5px;
            font-weight: 700;
            margin-bottom: 2px;
        }

        .contact-item strong {
            display: block;
            color: var(--ink);
            font-size: 11.5px;
            font-weight: 800;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .hero-actions {
        display: flex;
        gap: 8px;
        margin-top: 14px;
        flex-wrap: wrap;
    }

    .hbtn {
        font-family: var(--font);
        font-size: 12px;
        font-weight: 700;
        padding: 7px 16px;
        border-radius: 9px;
        border: 1px solid;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

        .hbtn.outline {
            background: var(--surface);
            border-color: var(--border);
            color: var(--ink-3);
        }

        .hbtn.solid-blue {
            background: var(--blue);
            border-color: var(--blue);
            color: #fff;
        }

        .hbtn.solid-amber {
            background: var(--amber);
            border-color: var(--amber);
            color: #fff;
        }

        .hbtn.solid-red {
            background: var(--red);
            border-color: var(--red);
            color: #fff;
        }

    .health-ring-wrap {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        min-width: 120px;
    }

    .health-ring {
        position: relative;
        width: 104px;
        height: 104px;
    }

        .health-ring svg {
            transform: rotate(-90deg);
            width: 100%;
            height: 100%;
        }

    .ring-bg {
        fill: none;
        stroke: var(--bg-2);
        stroke-width: 8;
    }

    .ring-fill {
        fill: none;
        stroke-width: 8;
        stroke-linecap: round;
        transition: stroke-dashoffset .8s ease;
    }

    .ring-val {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        font-weight: 800;
        color: var(--ink);
        line-height: 1;
    }

        .ring-val small {
            font-size: 10px;
            font-weight: 700;
            color: var(--mute);
        }

    .health-label {
        font-size: 11px;
        font-weight: 700;
        color: var(--mute);
        text-align: center;
    }

        .health-label span {
            display: block;
            font-size: 13px;
            font-weight: 800;
        }

            .health-label span.ex {
                color: var(--green);
            }

            .health-label span.gd {
                color: var(--blue);
            }

            .health-label span.wn {
                color: var(--amber);
            }

            .health-label span.dg {
                color: var(--red);
            }

    .kpi-strip {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 24px;
    }

    .kpi-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 16px 18px;
        box-shadow: var(--shadow-sm);
        position: relative;
        overflow: hidden;
        min-height: 140px;
    }

        .kpi-card::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 3px;
        }

        .kpi-card.g::after {
            background: var(--green);
        }

        .kpi-card.b::after {
            background: var(--blue);
        }

        .kpi-card.a::after {
            background: var(--amber);
        }

        .kpi-card.r::after {
            background: var(--red);
        }

        .kpi-card.p::after {
            background: var(--purple);
        }

        .kpi-card.t::after {
            background: var(--teal);
        }

    .kpi-icon {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        margin-bottom: 10px;
    }

        .kpi-icon.g {
            background: var(--green-lt);
        }

        .kpi-icon.b {
            background: var(--blue-lt);
        }

        .kpi-icon.a {
            background: var(--amber-lt);
        }

        .kpi-icon.r {
            background: var(--red-lt);
        }

        .kpi-icon.p {
            background: var(--purple-lt);
        }

        .kpi-icon.t {
            background: var(--teal-lt);
        }

    .kpi-val {
        font-size: 28px;
        font-weight: 800;
        color: var(--ink);
        line-height: 1;
    }

        .kpi-val sup {
            font-size: 13px;
            font-weight: 700;
            color: var(--mute);
        }

    .kpi-label {
        font-size: 11.5px;
        color: var(--mute);
        margin-top: 7px;
        font-weight: 700;
    }

    .kpi-delta {
        font-size: 10.5px;
        margin-top: 6px;
        font-weight: 700;
    }

        .kpi-delta.up {
            color: var(--green);
        }

        .kpi-delta.dn {
            color: var(--red);
        }

        .kpi-delta.eq {
            color: var(--mute-2);
        }

    .main-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 380px;
        gap: 18px;
    }

    .left-stack,
    .right-stack {
        display: flex;
        flex-direction: column;
        gap: 18px;
        min-width: 0;
    }

    .dash-card,
    .student-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }

    .card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 20px 13px;
        border-bottom: 1px solid var(--border);
    }

    .ch-left {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }

    .ch-accent {
        width: 4px;
        height: 20px;
        border-radius: 2px;
        flex-shrink: 0;
    }

        .ch-accent.teal {
            background: var(--teal);
        }

        .ch-accent.amber {
            background: var(--amber);
        }

        .ch-accent.blue {
            background: var(--blue);
        }

        .ch-accent.ink {
            background: var(--ink);
        }

        .ch-accent.green {
            background: var(--green);
        }

        .ch-accent.purple {
            background: var(--purple);
        }

        .ch-accent.red {
            background: var(--red);
        }

    .ch-title {
        font-size: 13.5px;
        font-weight: 800;
        color: var(--ink);
    }

    .ch-sub {
        font-size: 11px;
        color: var(--mute);
        margin-top: 1px;
    }

    .ch-badge {
        font-size: 10.5px;
        font-weight: 800;
        padding: 3px 9px;
        border-radius: 20px;
        border: 1px solid;
    }

        .ch-badge.neutral {
            background: var(--bg-2);
            color: var(--ink-3);
            border-color: var(--border);
        }

    .batch-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        padding: 16px 20px;
    }

    .batch-card {
        display: block;
        color: var(--ink);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 14px;
        background: var(--bg-2);
    }

        .batch-card.health-warning {
            background: #fffbeb;
            border-color: rgba(217, 119, 6, .25);
        }

        .batch-card.health-danger {
            background: #fff5f5;
            border-color: rgba(220, 38, 38, .25);
        }

    .batch-top {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        align-items: center;
        margin-bottom: 10px;
    }

        .batch-top strong {
            font-size: 13px;
            font-weight: 800;
        }

        .batch-top span {
            font-size: 12px;
            font-weight: 900;
            color: var(--blue);
        }

    .mini-meter {
        height: 6px;
        border-radius: 999px;
        background: var(--mute-3);
        overflow: hidden;
        margin-bottom: 10px;
    }

    .mini-meter-fill {
        height: 100%;
        border-radius: 999px;
        background: var(--blue);
        transition: width .7s ease;
    }

    .health-good .mini-meter-fill {
        background: var(--green);
    }

    .health-warning .mini-meter-fill {
        background: var(--amber);
    }

    .health-danger .mini-meter-fill {
        background: var(--red);
    }

    .batch-metrics {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 8px;
    }

        .batch-metrics span {
            font-size: 10.5px;
            font-weight: 700;
            color: var(--ink-3);
            background: var(--surface);
            border: 1px solid var(--border);
            padding: 2px 7px;
            border-radius: 999px;
        }

    .batch-card p {
        margin: 0;
        font-size: 11.5px;
        color: var(--mute);
        line-height: 1.6;
    }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .impact-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 760px;
    }

        .impact-table th {
            text-align: right;
            font-size: 10.5px;
            font-weight: 800;
            color: var(--mute);
            padding: 9px 20px;
            background: var(--bg-2);
            border-bottom: 1px solid var(--border);
        }

        .impact-table td {
            padding: 12px 20px;
            border-bottom: 1px solid var(--border);
            font-size: 12.5px;
            color: var(--ink-3);
            vertical-align: middle;
        }

    .item-title {
        font-weight: 800;
        color: var(--ink);
        font-size: 13px;
    }

    .item-sub {
        font-size: 10.5px;
        color: var(--mute);
        margin-top: 2px;
    }

    .impact-status {
        display: inline-flex;
        font-size: 10.5px;
        font-weight: 800;
        padding: 3px 9px;
        border-radius: 20px;
        border: 1px solid;
        white-space: nowrap;
    }

        .impact-status.good {
            background: var(--green-lt);
            color: var(--green-dk);
            border-color: rgba(5, 150, 105, .2);
        }

        .impact-status.warning,
        .impact-status.soon {
            background: var(--amber-lt);
            color: var(--amber-dk);
            border-color: rgba(217, 119, 6, .2);
        }

        .impact-status.danger {
            background: var(--red-lt);
            color: var(--red-dk);
            border-color: rgba(220, 38, 38, .2);
        }

        .impact-status.neutral {
            background: var(--bg-2);
            color: var(--mute);
            border-color: var(--border);
        }

    .diag-section {
        padding: 14px 18px;
    }

    .diag-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 11px 0;
        border-bottom: 1px solid var(--border);
    }

        .diag-item:last-child {
            border-bottom: none;
        }

    .diag-icon {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
    }

        .diag-icon.str {
            background: var(--green-lt);
        }

        .diag-icon.wkn {
            background: var(--amber-lt);
        }

        .diag-icon.opp {
            background: var(--blue-lt);
        }

        .diag-icon.risk {
            background: var(--red-lt);
        }

    .diag-title {
        font-size: 12.5px;
        font-weight: 800;
        color: var(--ink);
    }

    .diag-body {
        font-size: 11.5px;
        color: var(--mute);
        line-height: 1.65;
        margin-top: 2px;
    }

    .att-month {
        padding: 14px 18px;
    }

    .att-week-labels {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        margin-bottom: 4px;
    }

    .att-wl {
        text-align: center;
        font-size: 9px;
        color: var(--mute-2);
        font-weight: 800;
    }

    .att-grid-cal {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 3px;
    }

    .att-day {
        aspect-ratio: 1;
        border-radius: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 900;
    }

        .att-day.present {
            background: var(--green-lt);
            color: var(--green-dk);
        }

        .att-day.absent {
            background: var(--red-lt);
            color: var(--red-dk);
        }

        .att-day.no-lecture {
            background: var(--bg-2);
            color: var(--mute-2);
        }

        .att-day.today {
            outline: 2px solid var(--blue);
            outline-offset: 1px;
        }

    .att-legend {
        display: flex;
        gap: 12px;
        margin-top: 10px;
        font-size: 10px;
        color: var(--mute);
        flex-wrap: wrap;
    }

        .att-legend i {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 2px;
            margin-left: 3px;
            vertical-align: -1px;
        }

    .card-body {
        padding: 16px 20px;
    }

    .prog-item {
        margin-bottom: 12px;
    }

    .prog-head {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        font-size: 11.5px;
        margin-bottom: 4px;
    }

        .prog-head span {
            font-weight: 700;
            color: var(--ink-3);
        }

        .prog-head b {
            font-weight: 800;
            color: var(--ink);
        }

            .prog-head b span {
                color: var(--mute);
                font-weight: 500;
            }

    .prog-track {
        height: 7px;
        background: var(--bg-2);
        border-radius: 4px;
        overflow: hidden;
        border: 1px solid var(--border);
    }

    .prog-fill {
        height: 100%;
        border-radius: 4px;
        transition: width .7s ease;
    }

    .weakness-list {
        padding: 14px 18px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .weakness-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 10px;
        background: var(--bg-2);
    }

        .weakness-item.good {
            background: var(--green-lt);
        }

        .weakness-item.warning {
            background: var(--amber-lt);
        }

        .weakness-item.danger {
            background: var(--red-lt);
        }

        .weakness-item strong {
            display: block;
            font-size: 12.5px;
            font-weight: 800;
            color: var(--ink);
        }

        .weakness-item span {
            display: block;
            font-size: 11px;
            color: var(--mute);
        }

        .weakness-item b {
            font-size: 18px;
            font-weight: 900;
            color: var(--ink);
        }

    .full-section {
        margin-top: 18px;
    }

    .sec-label {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
    }

    .sec-label-line {
        width: 4px;
        height: 20px;
        border-radius: 2px;
        background: var(--ink);
    }

    .sec-label h2 {
        font-size: 15px;
        font-weight: 800;
        color: var(--ink);
        margin: 0;
    }

    .sec-label p {
        font-size: 12px;
        color: var(--mute);
        margin: 1px 0 0;
    }

    .students-split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin-bottom: 18px;
    }

    .plan-row,
    .performance-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 140px 90px;
        align-items: center;
        gap: 12px;
        padding: 12px 18px;
        border-bottom: 1px solid var(--border);
    }

    .performance-row {
        grid-template-columns: minmax(0, 1fr) 70px;
    }

        .plan-row:last-child,
        .performance-row:last-child {
            border-bottom: none;
        }

        .plan-row strong,
        .performance-row strong {
            display: block;
            font-size: 13px;
            font-weight: 800;
            color: var(--ink);
        }

        .plan-row span,
        .performance-row span {
            display: block;
            font-size: 11px;
            color: var(--mute);
        }

        .performance-row b {
            font-size: 20px;
            color: var(--blue);
        }

        .performance-row.good b {
            color: var(--green);
        }

        .performance-row.warning b {
            color: var(--amber);
        }

        .performance-row.danger b {
            color: var(--red);
        }

    .empty {
        text-align: center;
        color: var(--mute);
        font-size: 12px;
        padding: 24px;
    }

        .empty.full {
            grid-column: 1 / -1;
        }

    .txt-blue {
        color: var(--blue);
    }

    .fw8 {
        font-weight: 800;
    }

    @@media (max-width: 1200px) {
        .kpi-strip {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .main-grid {
            grid-template-columns: 1fr;
        }

        .students-split {
            grid-template-columns: 1fr;
        }

        .batch-grid {
            grid-template-columns: 1fr;
