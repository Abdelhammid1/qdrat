@model IEnumerable<QdratNew.ViewModels.Students.StudentHomeworkRowVm>
@{
    ViewData["Title"] = $"واجبات الطالب: {ViewBag.StudentName}";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int    sid      = ViewBag.StudentId;
    string name     = ViewBag.StudentName;
    int    total    = ViewBag.Total;
    int    submitted = ViewBag.Submitted;
    double avgScore  = ViewBag.AvgScore;
    double pct = total > 0 ? Math.Round((double)submitted / total * 100, 1) : 0;
    string pctColor = pct >= 80 ? "#059669" : pct >= 60 ? "#d97706" : "#dc2626";
    var rows = Model.ToList();
}

<div class="sr-page" dir="rtl">

    <nav class="sr-nav">
        <a class="sr-back" asp-area="Admin" asp-controller="Students"
           asp-action="GeneralReport" asp-route-id="@sid">← التقرير العام</a>
        <div class="sr-sep"></div>
        <div class="sr-crumb">
            <a asp-area="Admin" asp-controller="Students" asp-action="Details" asp-route-id="@sid">@name</a>
            <span>›</span><span>الواجبات المنزلية</span>
        </div>
    </nav>

    <div class="sr-body">

        <div class="sr-hero amber">
            <div class="sr-hero-icon">📝</div>
            <div class="sr-hero-info">
                <h1>الواجبات المنزلية</h1>
                <div class="sr-hero-name">@name</div>
            </div>
            <div class="sr-hero-kpis">
                <div class="sr-hkpi">
                    <span class="sr-hkpi-n" style="color:#6ee7b7">@submitted</span>
                    <span class="sr-hkpi-l">مُسلَّم</span>
                </div>
                <div class="sr-hkpi">
                    <span class="sr-hkpi-n" style="color:#fca5a5">@(total - submitted)</span>
                    <span class="sr-hkpi-l">غير مُسلَّم</span>
                </div>
                <div class="sr-hkpi">
                    <span class="sr-hkpi-n" style="color:#fcd34d">@avgScore.ToString("0.#")</span>
                    <span class="sr-hkpi-l">متوسط الدرجة</span>
                </div>
            </div>
        </div>

        <div class="sr-bar-card">
            <div class="sr-bar-label">
                <span>نسبة التسليم الكلية</span>
                <span style="color:@pctColor;font-weight:800">@pct.ToString("0")%</span>
            </div>
            <div class="sr-bar">
                <div class="sr-bar-fill" style="width:@(Math.Min(100,pct).ToString("0"))%;background:@pctColor"></div>
            </div>
        </div>

        @if (!rows.Any())
        {
            <div class="sr-empty">لا توجد واجبات مرتبطة بهذا الطالب.</div>
        }
        else
        {
            <div class="sr-card">
                <div class="sr-card-head">
                    <span class="sr-card-title">📋 قائمة الواجبات (@total واجب)</span>
                    <div class="sr-filters">
                        <button class="sr-filter active" onclick="srFilter('all',this)">الكل</button>
                        <button class="sr-filter" onclick="srFilter('submitted',this)">مُسلَّم</button>
                        <button class="sr-filter" onclick="srFilter('missing',this)">غير مُسلَّم</button>
                    </div>
                </div>
                <div class="sr-table-wrap">
                    <table class="sr-table" id="srTable">
                        <thead>
                            <tr><th>#</th><th>الواجب</th><th>الدفعة</th><th>الدورة</th><th>آخر موعد</th><th>الحالة</th><th>الدرجة</th><th>الإجراء</th></tr>
                        </thead>
                        <tbody>
                            @{ int n = 0; }
                            @foreach (var r in rows)
                            {
                                n++;
                                bool late = r.IsSubmitted && r.EndAt.HasValue && r.SubmittedAt.HasValue && r.SubmittedAt > r.EndAt;
                                <tr data-status="@(r.IsSubmitted ? "submitted" : "missing")">
                                    <td class="sr-num">@n</td>
                                    <td>
                                        <div class="sr-fw">@r.Title</div>
                                        @if (late) { <span class="sr-late">متأخر</span> }
                                    </td>
                                    <td>@r.BatchName</td>
                                    <td class="sr-mute">@r.CourseName</td>
                                    <td class="sr-mute">
                                        @(r.EndAt.HasValue ? r.EndAt.Value.ToString("yyyy/MM/dd") : "—")
                                        @if (r.IsClosed) { <span class="sr-closed-tag">مغلق</span> }
                                    </td>
                                    <td>
                                        <span class="sr-badge @(r.IsSubmitted ? "badge-green" : "badge-red")">
                                            @(r.IsSubmitted ? "✅ مُسلَّم" : "❌ لم يُسلَّم")
                                        </span>
                                    </td>
                                    <td>
                                        @if (r.Score.HasValue)
                                        {
                                            <span class="sr-score @r.ScoreCssClass">@r.Score.Value.ToString("0.#")</span>
                                        }
                                        else { <span class="sr-mute">—</span> }
                                    </td>
                                    <td>
                                        @if (r.IsSubmitted)
                                        {
                                            <a class="sr-action-link"
                                               asp-area="Admin" asp-controller="HomeworkManagement"
                                               asp-action="HomeworkParentReport"
                                               asp-route-homeworkSetId="@r.HomeworkSetId"
                                               asp-route-studentId="@sid"
                                               target="_blank">
                                                📊 تقرير ولي الأمر
                                            </a>
                                            <a class="sr-action-link secondary"
                                               asp-area="Admin" asp-controller="HomeworkManagement"
                                               asp-action="Review"
                                               asp-route-studentId="@sid"
                                               asp-route-homeworkSetId="@r.HomeworkSetId"
                                               target="_blank">
                                                📋 مراجعة الأسئلة
                                            </a>
                                        }
                                        else { <span class="sr-mute">—</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

    </div>
</div>

@await Html.PartialAsync("_StudentReportSharedStyle")

<script>
    function srFilter(type, btn) {
        document.querySelectorAll('.sr-filter').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('#srTable tbody tr').forEach(row => {
            row.style.display = (type === 'all' || row.dataset.status === type) ? '' : 'none';
        });
    }
    document.addEventListener('DOMContentLoaded', () => {
        const fill = document.querySelector('.sr-bar-fill');
        if (fill) { const w = fill.style.width; fill.style.width = '0'; setTimeout(() => fill.style.width = w, 200); }
    });
</script>
