@model IEnumerable<QdratNew.ViewModels.Students.StudentBatchRowVm>

@{
    ViewData["Title"] = $"دفعات الطالب: {ViewBag.StudentName}";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int studentId = ViewBag.StudentId;
    string studentName = ViewBag.StudentName;
}

<div class="sb-page" dir="rtl">

    <nav class="sb-nav">
        <div class="sb-nav-inner">
            <a class="sb-back" asp-area="Admin" asp-controller="Students" asp-action="Details"
               asp-route-id="@studentId">← العودة لملف الطالب</a>
            <div class="sb-sep"></div>
            <div class="sb-breadcrumb">
                <a asp-area="Admin" asp-controller="Students" asp-action="Index">الطلاب</a>
                <span>›</span>
                <a asp-area="Admin" asp-controller="Students" asp-action="Details" asp-route-id="@studentId">@studentName</a>
                <span>›</span>
                <span class="sb-current">الدفعات المسجلة</span>
            </div>
        </div>
    </nav>

    <div class="sb-body">

        <div class="sb-hero">
            <div class="sb-hero-av">@(studentName.Length >= 2 ? studentName[..2] : "ط")</div>
            <div>
                <h1 class="sb-hero-name">@studentName</h1>
                <div class="sb-hero-sub">الدفعات المسجل فيها الطالب</div>
            </div>
        </div>

        @{
            var rows = Model.ToList();
            int count = rows.Count;
        }

        <div class="sb-summary">
            <div class="sb-kpi">
                <div class="sb-kpi-val">@count</div>
                <div class="sb-kpi-lbl">إجمالي الدفعات</div>
            </div>
            <div class="sb-kpi">
                <div class="sb-kpi-val">@rows.Count(r => r.Status == "Active" || r.Status == "نشط")</div>
                <div class="sb-kpi-lbl">دفعة نشطة</div>
            </div>
        </div>

        @if (!rows.Any())
        {
            <div class="sb-empty">لا توجد دفعات مسجلة لهذا الطالب.</div>
        }
        else
        {
            <div class="sb-table-wrap">
                <table class="sb-table">
                    <thead>
                        <tr>
                            <th>الدفعة</th>
                            <th>الدورة</th>
                            <th>تاريخ البداية</th>
                            <th>تاريخ النهاية</th>
                            <th>تاريخ التسجيل</th>
                            <th>الحالة</th>
                            <th>تفاصيل</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in rows)
                        {
                            bool isActive = (r.Status == "Active" || r.Status == "نشط");
                            <tr>
                                <td class="sb-batch-name">@r.BatchName</td>
                                <td>@r.CourseName</td>
                                <td>@r.StartDate.ToString("yyyy/MM/dd")</td>
                                <td>@(r.EndDate.HasValue ? r.EndDate.Value.ToString("yyyy/MM/dd") : "—")</td>
                                <td>@r.EnrolledAt.ToString("yyyy/MM/dd")</td>
                                <td>
                                    <span class="sb-badge @(isActive ? "active" : "idle")">
                                        @r.Status
                                    </span>
                                </td>
                                <td>
                                    <a class="sb-link"
                                       asp-area="Admin" asp-controller="Batches"
                                       asp-action="Details" asp-route-id="@r.BatchId">
                                        فتح الدفعة ←
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<style>
    .sb-page { background: #f1f5f9; min-height: 100vh; font-family: 'Cairo','Tajawal',sans-serif; direction: rtl; }
    .sb-nav { background: #1e293b; padding: 12px 24px; }
    .sb-nav-inner { display: flex; align-items: center; gap: 12px; }
    .sb-back { color: #94a3b8; text-decoration: none; font-size: .82rem; font-weight: 600; transition: color .15s; }
    .sb-back:hover { color: #fff; }
    .sb-sep { width: 1px; height: 18px; background: #334155; }
    .sb-breadcrumb { display: flex; align-items: center; gap: 6px; font-size: .78rem; color: #64748b; }
    .sb-breadcrumb a { color: #94a3b8; text-decoration: none; }
    .sb-breadcrumb a:hover { color: #fff; }
    .sb-current { color: #e2e8f0; font-weight: 600; }

    .sb-body { padding: 24px; max-width: 1000px; margin: 0 auto; }

    .sb-hero {
        display: flex; align-items: center; gap: 16px;
        background: linear-gradient(135deg,#1e293b,#0f172a);
        border-radius: 14px; padding: 24px 28px; margin-bottom: 18px; color: #fff;
    }
    .sb-hero-av {
        width: 56px; height: 56px; border-radius: 14px;
        background: linear-gradient(135deg,#2563eb,#7c3aed);
        color: #fff; font-size: 1.3rem; font-weight: 800;
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .sb-hero-name { font-size: 1.3rem; font-weight: 800; margin: 0 0 4px; }
    .sb-hero-sub  { font-size: .82rem; color: #94a3b8; }

    .sb-summary {
        display: flex; gap: 12px; margin-bottom: 18px;
    }
    .sb-kpi {
        background: #fff; border-radius: 12px; padding: 16px 22px;
        border-top: 3px solid #2563eb; box-shadow: 0 1px 4px rgba(0,0,0,.06);
        min-width: 130px;
    }
    .sb-kpi-val { font-size: 1.6rem; font-weight: 800; color: #1e293b; }
    .sb-kpi-lbl { font-size: .72rem; color: #64748b; margin-top: 3px; }

    .sb-empty { text-align: center; padding: 40px; color: #94a3b8; font-size: .9rem; }

    .sb-table-wrap { background: #fff; border-radius: 14px; box-shadow: 0 1px 4px rgba(0,0,0,.06); overflow: hidden; }
    .sb-table { width: 100%; border-collapse: collapse; }
    .sb-table th {
        background: #f8fafc; padding: 12px 16px;
        font-size: .78rem; font-weight: 700; color: #64748b;
        text-align: right; border-bottom: 1px solid #e2e8f0;
    }
    .sb-table td {
        padding: 13px 16px; border-bottom: 1px solid #f1f5f9;
        font-size: .85rem; color: #1e293b;
    }
    .sb-table tr:hover td { background: #f8fafc; }
    .sb-batch-name { font-weight: 700; }
    .sb-badge {
        padding: 3px 10px; border-radius: 20px;
        font-size: .75rem; font-weight: 700;
    }
    .sb-badge.active { background: #d1fae5; color: #065f46; }
    .sb-badge.idle   { background: #f1f5f9; color: #64748b; }
    .sb-link {
        color: #2563eb; text-decoration: none; font-size: .8rem; font-weight: 700;
        transition: color .15s;
    }
    .sb-link:hover { color: #1d4ed8; }
</style>
