@model QdratNew.ViewModels.Remedial.RemedialPlanCreateViewModel
@{
    ViewData["Title"] = "➕ إنشاء خطة علاجية جديدة";
}

<div class="qdrat-page" dir="rtl">

    <div class="qdrat-hero mb-4">
        <div>
            <div class="qdrat-kicker">
                <i class="bi bi-heart-pulse"></i>
                خطة علاجية
            </div>

            <h2 class="qdrat-title">إنشاء خطة علاجية للطالب @Model.StudentName</h2>

            <p class="qdrat-subtitle">
                أنشئ خطة علاجية موجهة بناءً على المحاور الضعيفة مع تحديد عنوان واضح ووصف يساعد الطالب وولي الأمر على فهم مسار التحسين.
            </p>
        </div>

        <div class="qdrat-hero-icon">
            <i class="bi bi-clipboard2-pulse"></i>
        </div>
    </div>

    <div class="qdrat-card">
        <div class="qdrat-card-header">
            <div>
                <h5>
                    <i class="bi bi-ui-checks-grid"></i>
                    بيانات الخطة العلاجية
                </h5>
                <p>
                    اختر المحاور الضعيفة التي ستبنى عليها الخطة العلاجية لهذا الطالب.
                </p>
            </div>
        </div>

        <div class="qdrat-card-body">
            <form asp-action="Create" method="post" autocomplete="off">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="StudentId" />

                <div asp-validation-summary="ModelOnly" class="alert qdrat-alert qdrat-alert-danger mb-4"></div>

                <div class="row g-4">
                    <div class="col-12">
                        <div class="qdrat-student-strip">
                            <div class="qdrat-student-icon">
                                <i class="bi bi-person-check"></i>
                            </div>
                            <div>
                                <span>الطالب المستهدف</span>
                                <strong>@Model.StudentName</strong>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-8 col-md-12">
                        <div class="qdrat-field">
                            <label asp-for="Title" class="form-label"></label>
                            <div class="qdrat-input-wrap">
                                <i class="bi bi-type"></i>
                                <input asp-for="Title" class="form-control" placeholder="مثال: خطة علاجية لمحور الجبر" />
                            </div>
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="qdrat-field">
                            <label asp-for="Description" class="form-label"></label>
                            <div class="qdrat-textarea-wrap">
                                <i class="bi bi-card-text"></i>
                                <textarea asp-for="Description" class="form-control" rows="5" placeholder="اكتب وصفًا مختصرًا يوضح هدف الخطة وطريقة المتابعة..."></textarea>
                            </div>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="qdrat-section-box">
                            <div class="qdrat-section-box-header">
                                <div>
                                    <h6>
                                        <i class="bi bi-exclamation-triangle"></i>
                                        المحاور الضعيفة
                                    </h6>
                                    <p>حدد المحاور التي تحتاج إلى علاج ومتابعة داخل الخطة.</p>
                                </div>
                            </div>

                            <div class="qdrat-section-grid">
                                @foreach (var s in Model.Sections)
                                {
                                    <div class="qdrat-check-card">
                                        <input class="form-check-input" type="checkbox" name="SelectedSectionIds" value="@s.Value" id="sec_@s.Value" />
                                        <label class="form-check-label" for="sec_@s.Value">
                                            <span class="qdrat-check-icon">
                                                <i class="bi bi-check2-circle"></i>
                                            </span>
                                            <span>@s.Text</span>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="qdrat-actions">
                    <a href="@Url.Action("Index")" class="btn qdrat-btn qdrat-btn-light">
                        <i class="bi bi-arrow-right"></i>
                        العودة
                    </a>

                    <button type="submit" class="btn qdrat-btn qdrat-btn-primary">
                        <i class="bi bi-check-circle"></i>
                        حفظ الخطة
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

<style>
    .qdrat-page {
        padding: 24px;
        background: #f5f7fb;
        min-height: calc(100vh - 80px);
        font-family: inherit;
    }

    .qdrat-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 26px;
        border-radius: 24px;
        background: linear-gradient(135deg, #102a43 0%, #1d4ed8 58%, #38bdf8 100%);
        color: #fff;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
    }

    .qdrat-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .qdrat-title {
        margin: 0;
        font-size: 28px;
        font-weight: 900;
        letter-spacing: -0.5px;
    }

    .qdrat-subtitle {
        margin: 10px 0 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 15px;
        line-height: 1.8;
        max-width: 850px;
    }

    .qdrat-hero-icon {
        width: 74px;
        height: 74px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.16);
        font-size: 34px;
        flex: 0 0 auto;
    }

    .qdrat-card {
        border: 1px solid #e5e7eb;
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    .qdrat-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #edf0f5;
        background: #fff;
    }

        .qdrat-card-header h5 {
            margin: 0;
            color: #0f172a;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .qdrat-card-header h5 i {
                color: #2563eb;
            }

        .qdrat-card-header p {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 14px;
        }

    .qdrat-card-body {
        padding: 24px;
    }

    .qdrat-student-strip {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 15px 18px;
        border-radius: 18px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
    }

    .qdrat-student-icon {
        width: 46px;
        height: 46px;
        border-radius: 15px;
        background: #2563eb;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex: 0 0 auto;
    }

    .qdrat-student-strip span {
        display: block;
        color: #64748b;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 3px;
    }

    .qdrat-student-strip strong {
        display: block;
        color: #0f172a;
        font-size: 17px;
        font-weight: 900;
    }

    .qdrat-field .form-label {
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 9px;
    }

    .qdrat-input-wrap,
    .qdrat-textarea-wrap {
        position: relative;
    }

        .qdrat-input-wrap > i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 3;
            pointer-events: none;
        }

        .qdrat-textarea-wrap > i {
            position: absolute;
            right: 15px;
            top: 18px;
            color: #64748b;
            z-index: 3;
            pointer-events: none;
        }

        .qdrat-input-wrap .form-control {
            min-height: 48px;
            border-radius: 15px;
            border-color: #dbe3ef;
            padding-right: 42px;
            font-weight: 700;
        }

        .qdrat-textarea-wrap .form-control {
            border-radius: 15px;
            border-color: #dbe3ef;
            padding-right: 42px;
            padding-top: 14px;
            font-weight: 700;
            line-height: 1.9;
            resize: vertical;
        }

            .qdrat-input-wrap .form-control:focus,
            .qdrat-textarea-wrap .form-control:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 0.22rem rgba(37, 99, 235, 0.12);
            }

    .qdrat-section-box {
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        background: #f8fafc;
        overflow: hidden;
    }

    .qdrat-section-box-header {
        padding: 18px 20px;
        border-bottom: 1px solid #e5e7eb;
        background: #fff;
    }

        .qdrat-section-box-header h6 {
            margin: 0;
            color: #0f172a;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .qdrat-section-box-header h6 i {
                color: #f59e0b;
            }

        .qdrat-section-box-header p {
            margin: 7px 0 0;
            color: #64748b;
            font-size: 13px;
            font-weight: 700;
        }

    .qdrat-section-grid {
        padding: 18px;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .qdrat-check-card {
        position: relative;
    }

        .qdrat-check-card .form-check-input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .qdrat-check-card .form-check-label {
            min-height: 58px;
            border: 1px solid #dbe3ef;
            border-radius: 16px;
            background: #fff;
            padding: 13px 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: #334155;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.16s ease;
        }

    .qdrat-check-icon {
        width: 30px;
        height: 30px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f1f5f9;
        color: #94a3b8;
        flex: 0 0 auto;
    }

    .qdrat-check-card .form-check-input:checked + .form-check-label {
        border-color: #2563eb;
        background: #eff6ff;
        color: #1e40af;
        box-shadow: 0 10px 22px rgba(37, 99, 235, 0.12);
    }

        .qdrat-check-card .form-check-input:checked + .form-check-label .qdrat-check-icon {
            background: #2563eb;
            color: #fff;
        }

    .qdrat-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 26px;
        margin-top: 28px;
        border-top: 1px solid #edf0f5;
    }

    .qdrat-btn {
        min-height: 46px;
        border-radius: 14px;
        padding: 10px 24px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .qdrat-btn-primary {
        background: #16a34a;
        border-color: #16a34a;
        color: #fff;
    }

        .qdrat-btn-primary:hover {
            background: #15803d;
            border-color: #15803d;
            color: #fff;
        }

    .qdrat-btn-light {
        background: #f8fafc;
        border-color: #dbe3ef;
        color: #334155;
    }

        .qdrat-btn-light:hover {
            background: #eef2f7;
            border-color: #cbd5e1;
            color: #0f172a;
        }

    .qdrat-alert {
        border: 0;
        border-radius: 18px;
        padding: 15px 18px;
        font-weight: 800;
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.07);
    }

        .qdrat-alert:empty {
            display: none;
        }

    .qdrat-alert-danger {
        color: #991b1b;
        background: #fee2e2;
    }

    @@media (max-width: 992px) {
        .qdrat-section-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .qdrat-page {
            padding: 14px;
        }

        .qdrat-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 20px;
        }

        .qdrat-title {
            font-size: 23px;
        }

        .qdrat-hero-icon {
            width: 58px;
            height: 58px;
            font-size: 26px;
        }

        .qdrat-card-body,
        .qdrat-card-header {
            padding: 18px;
        }

        .qdrat-section-grid {
            grid-template-columns: 1fr;
        }

        .qdrat-actions {
            flex-direction: column-reverse;
        }

        .qdrat-btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
