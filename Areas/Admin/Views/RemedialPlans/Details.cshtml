@model QdratNew.Entities.RemedialPlan
@{
    ViewData["Title"] = "📘 تفاصيل الخطة العلاجية";
}

<div class="container py-4">
    <h2 class="fw-bold text-primary mb-3">
        📘 تفاصيل الخطة العلاجية للطالب: @Model.Student.FullName
    </h2>

    <div class="card shadow-sm p-3 mb-4">
        <h4 class="text-secondary fw-bold mb-3">@Model.Title</h4>
        <p><strong>الوصف:</strong> @Model.Description</p>
        <p><strong>مستوى الأداء:</strong> @Model.PerformanceLevel</p>
        <p><strong>عدد الدروس:</strong> @Model.Lessons?.Count() ?? 0</p>
        <p><strong>تاريخ الإنشاء:</strong> @Model.CreatedAt.ToShortDateString()</p>
    </div>

    <h4 class="fw-bold text-info">📚 الدروس العلاجية</h4>
    <table class="table table-bordered text-center">
        <thead class="table-light">
            <tr>
                <th>المحور</th>
                <th>رابط الفيديو</th>
                <th>مواد مساعدة</th>
                <th>الحالة</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Lessons != null && Model.Lessons.Any())
            {
                foreach (var lesson in Model.Lessons)
                {
                    <tr>
                        <td>@lesson.Section?.Title</td>
                        <td>
                            @if (!string.IsNullOrEmpty(lesson.VideoUrl))
                            {
                                <a href="@lesson.VideoUrl" target="_blank" class="text-primary">مشاهدة</a>
                            }
                            else
                            {
                                <span class="text-muted">لا يوجد</span>
                            }
                        </td>
                        <td>@lesson.SupplementaryMaterial</td>
                        <td>
                            @if (lesson.IsCompleted)
                            {
                                <span class="badge bg-success">مكتمل</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">قيد التنفيذ</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="4" class="text-muted">لا توجد دروس علاجية</td></tr>
            }
        </tbody>
    </table>

    <div class="text-center mt-4">
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-right"></i> العودة
        </a>
    </div>
</div>
