@model IEnumerable<QdratNew.ViewModels.Remedial.RemedialPlanListVm>
@{
    ViewData["Title"] = "📘 إدارة الخطط العلاجية";
    var totalPlans = Model.Count();
    var completedPlans = Model.Count(p => p.IsCompleted);
    var activePlans = Model.Count(p => !p.IsCompleted);
    var weakPlans = Model.Count(p => p.PerformanceLevel == "Weak");
    double completedPercent = totalPlans > 0 ? (completedPlans * 100.0 / totalPlans) : 0;
    double activePercent = totalPlans > 0 ? (activePlans * 100.0 / totalPlans) : 0;
    double weakPercent = totalPlans > 0 ? (weakPlans * 100.0 / totalPlans) : 0;
}

<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

<h2 class="text-center fw-bold mt-3 mb-4">
    <i class="bi bi-clipboard-pulse text-primary"></i> إدارة الخطط العلاجية
</h2>

<!-- 🔹 لوحة المؤشرات التحليلية -->
<div class="row text-center mb-4">
    <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-success">
            <div class="card-body">
                <h6 class="fw-bold text-success"><i class="bi bi-check2-circle"></i> الخطط المكتملة</h6>
                <h3 class="fw-bold">@completedPlans</h3>
                <div class="progress">
                    <div class="progress-bar bg-success" role="progressbar"
                         style="width:@completedPercent%" aria-valuenow="@completedPercent" aria-valuemin="0" aria-valuemax="100">
                        @Math.Round(completedPercent, 1)%
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-warning">
            <div class="card-body">
                <h6 class="fw-bold text-warning"><i class="bi bi-hourglass-split"></i> الخطط الجارية</h6>
                <h3 class="fw-bold">@activePlans</h3>
                <div class="progress">
                    <div class="progress-bar bg-warning text-dark" role="progressbar"
                         style="width:@activePercent%" aria-valuenow="@activePercent" aria-valuemin="0" aria-valuemax="100">
                        @Math.Round(activePercent, 1)%
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-danger">
            <div class="card-body">
                <h6 class="fw-bold text-danger"><i class="bi bi-graph-down-arrow"></i> الخطط الضعيفة</h6>
                <h3 class="fw-bold">@weakPlans</h3>
                <div class="progress">
                    <div class="progress-bar bg-danger" role="progressbar"
                         style="width:@weakPercent%" aria-valuenow="@weakPercent" aria-valuemin="0" aria-valuemax="100">
                        @Math.Round(weakPercent, 1)%
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-primary">
            <div class="card-body">
                <h6 class="fw-bold text-primary"><i class="bi bi-bar-chart-line"></i> إجمالي الخطط</h6>
                <h3 class="fw-bold">@totalPlans</h3>
            </div>
        </div>
    </div>
</div>

<!-- 🔹 جدول الخطط -->
<div class="table-responsive shadow-sm p-3 bg-white rounded">
    <table id="plansTable" class="table table-striped table-hover align-middle text-center">
        <thead class="table-success text-center">
            <tr>
                <th>📋 عنوان الخطة</th>
                <th>👤 الطالب</th>
                <th>📘 المنهج</th>
                <th>📆 تاريخ الإنشاء</th>
                <th>📊 مستوى الأداء</th>
                <th>⚙️ الحالة</th>
                <th>🔍 التحكم</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td class="fw-bold">@p.Title</td>
                    <td>@p.StudentName</td>
                    <td>@p.CurriculumTitle</td>
                    <td>@p.CreatedAt.ToString("yyyy/MM/dd")</td>

                    <td>
                        @switch (p.PerformanceLevel)
                        {
                            case "Excellent":
                                <span class="badge bg-success">ممتاز</span>
                                break;
                            case "Good":
                                <span class="badge bg-info text-dark">جيد</span>
                                break;
                            case "Weak":
                                <span class="badge bg-danger">ضعيف</span>
                                break;
                            default:
                                <span class="badge bg-secondary">غير محدد</span>
                                break;
                        }
                    </td>

                    <td>
                        @if (p.IsCompleted)
                        {
                            <span class="badge bg-success"><i class="bi bi-check-circle"></i> منتهية</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split"></i> قيد التنفيذ</span>
                        }
                    </td>

                    <td>
                        <a class="btn btn-sm btn-outline-info"
                           href="@Url.Action("Details", "RemedialPlans", new { area = "Admin", id = p.Id })"
                           title="عرض تفاصيل الخطة">
                            <i class="bi bi-eye"></i>
                        </a>

                        <a class="btn btn-sm btn-outline-primary"
                           href="@Url.Action("Edit", "RemedialPlans", new { area = "Admin", id = p.Id })"
                           title="تعديل الخطة">
                            <i class="bi bi-pencil-square"></i>
                        </a>

                        <button class="btn btn-sm btn-outline-danger delete-plan"
                                data-id="@p.Id" title="حذف الخطة">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            // ✅ تهيئة DataTable
            $('#plansTable').DataTable({
                language: { url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json" },
                pageLength: 10,
                order: [[3, "desc"]],
                columnDefs: [{ orderable: false, targets: [6] }]
            });

            // ✅ حذف خطة علاجية
            $(document).on('click', '.delete-plan', function () {
                var id = $(this).data('id');
                if (confirm('هل أنت متأكد من حذف هذه الخطة العلاجية؟')) {
                    $.post('/Admin/RemedialPlans/Delete', { id: id }, function (res) {
                        alert(res.message);
                        location.reload();
                    });
                }
            });
        });
    </script>
}
