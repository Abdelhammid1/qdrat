@model QdratNew.ViewModels.Instructor.InstructorSmartEvaluationViewModel
@{
    ViewData["Title"] = "تقييم المدرب الذكي";
}

<h2 class="text-center mb-4">تقييم ذكي للمدرب: @Model.InstructorName</h2>

<!-- ✅ كرت الأداء العام -->
<div class="row mb-4 text-center">
    <div class="col-md-4 offset-md-4">
        <div class="card shadow rounded p-3 bg-light">
            <h5>المؤشر العام للأداء</h5>
            <h2 class="text-primary">@Model.AIOverallScore%</h2>
            <p class="text-muted">@Model.AIEvaluationComment</p>
        </div>
    </div>
</div>

<!-- ✅ رسم بياني لأداء المحاور -->
<div class="card mb-5">
    <div class="card-header bg-dark text-white">
        أداء المدرب في المحاور التعليمية
    </div>
    <div class="card-body">
        <canvas id="sectionChart"></canvas>
    </div>
</div>

<!-- ✅ جدول تفصيلي لأداء المحاور -->
<table class="table table-bordered text-center">
    <thead class="table-dark">
        <tr>
            <th>المحور</th>
            <th>عدد الطلاب</th>
            <th>متوسط الدرجات</th>
            <th>نسبة النجاح</th>
            <th>الصعوبة</th>
            <th>تحليل الذكاء الاصطناعي</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model.SectionsEvaluation)
        {
            <tr>
                <td>@s.SectionTitle</td>
                <td>@s.StudentCount</td>
                <td>@s.AverageScore%</td>
                <td>@s.SuccessRate%</td>
                <td>@s.DifficultyLevel</td>
                <td>@s.AIComment</td>
            </tr>
        }
    </tbody>
</table>

<!-- ✅ التوصيات الذكية -->
<div class="card mt-4">
    <div class="card-header bg-info text-white">
        توصيات الذكاء الاصطناعي
    </div>
    <div class="card-body">
        <ul class="list-group">
            @foreach (var rec in Model.AIRecommendations)
            {
                <li class="list-group-item">@rec</li>
            }
        </ul>
    </div>
</div>

<!-- ✅ زر الرجوع -->
<div class="mt-5 text-center">
    <a asp-area="Admin" asp-controller="InstructorsAIDashboard" asp-action="Index"
       asp-route-instructorId="@Model.InstructorId"
       class="btn btn-outline-primary me-2">
        📊 العودة إلى لوحة تحكم المدرب
    </a>

    <a asp-area="Admin" asp-controller="InstructorSmartEvaluation" asp-action="Index"
       asp-route-instructorId="@Model.InstructorId"
       class="btn btn-outline-success me-2">
        🤖 التحليل الذكي الشامل
    </a>

    <a asp-area="Admin" asp-controller="Instructors" asp-action="Index"
       class="btn btn-outline-dark">
        📋 قائمة المدربين
    </a>
</div>


<!-- ✅ Chart.js -->
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('sectionChart');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.SectionTitles)),
                datasets: [{
                    label: 'متوسط الدرجات لكل محور',
                    data: @Html.Raw(Json.Serialize(Model.AverageScores)),
                    borderWidth: 1,
                    backgroundColor: 'rgba(54, 162, 235, 0.6)'
                }]
            },
            options: {
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100
                    }
                }
            }
        });
    </script>
}
