@model QdratNew.Entities.Frontend.SubCourse
@{
    ViewData["Title"] = "إضافة دورة فرعية جديدة";
}

<div class="qdrat-page" dir="rtl">

    <div class="qdrat-hero mb-4">
        <div>
            <div class="qdrat-kicker">
                <i class="bi bi-layer-plus"></i>
                دورة فرعية جديدة
            </div>

            <h2 class="qdrat-title">@ViewData["Title"]</h2>

            <p class="qdrat-subtitle">
                أضف دورة فرعية مرتبطة بدورة رئيسية، مع ضبط الرابط والوصف وصورة الغلاف وترتيب الظهور في الواجهة العامة.
            </p>
        </div>

        <div class="qdrat-hero-icon">
            <i class="bi bi-layers"></i>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert qdrat-alert qdrat-alert-danger mb-4">
            <i class="bi bi-x-circle-fill"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert qdrat-alert qdrat-alert-success mb-4">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    <div class="qdrat-card">
        <div class="qdrat-card-header">
            <div>
                <h5>
                    <i class="bi bi-ui-checks-grid"></i>
                    بيانات الدورة الفرعية
                </h5>
                <p>
                    املأ البيانات كما ستظهر للزائر داخل صفحات الموقع العامة.
                </p>
            </div>
        </div>

        <div class="qdrat-card-body">
            <form asp-action="Create" enctype="multipart/form-data" method="post" class="needs-validation" novalidate autocomplete="off">
                @Html.AntiForgeryToken()

                <div class="row g-4">

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label class="form-label">الدورة الرئيسية</label>
                            <div class="qdrat-input-wrap">
                                <i class="bi bi-book"></i>
                                <select asp-for="FrontendCourseId" asp-items="ViewBag.Courses" class="form-select" required>
                                    <option value="">-- اختر الدورة الرئيسية --</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label class="form-label">عنوان الدورة الفرعية</label>
                            <div class="qdrat-input-wrap">
                                <i class="bi bi-type"></i>
                                <input asp-for="Title" class="form-control" placeholder="مثال: دورة القدرات التأسيسية" required />
                            </div>
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label class="form-label">الرابط (Slug)</label>
                            <div class="qdrat-input-wrap">
                                <i class="bi bi-link-45deg"></i>
                                <input asp-for="Slug" class="form-control" placeholder="يُولد تلقائيًا من العنوان أو يمكنك تعديله يدويًا" />
                            </div>
                            <div id="slug-feedback" class="qdrat-feedback small mt-2"></div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label class="form-label">ترتيب العرض</label>
                            <div class="qdrat-input-wrap">
                                <i class="bi bi-sort-numeric-down"></i>
                                <input asp-for="DisplayOrder" type="number" class="form-control" min="0" />
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="qdrat-field">
                            <label class="form-label">الوصف المختصر</label>
                            <div class="qdrat-textarea-wrap">
                                <i class="bi bi-card-text"></i>
                                <textarea asp-for="ShortDescription" class="form-control" rows="2" placeholder="ملخص قصير عن الدورة..."></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="qdrat-field">
                            <label class="form-label">الفقرة المهمة (الوصف الكامل)</label>
                            <div class="qdrat-textarea-wrap">
                                <i class="bi bi-file-text"></i>
                                <textarea asp-for="FullDescription" class="form-control" rows="6" placeholder="أدخل تفاصيل الدورة هنا..."></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label class="form-label">صورة الغلاف</label>
                            <div class="qdrat-file-box">
                                <i class="bi bi-image"></i>
                                <div>
                                    <input type="file" name="imageFile" class="form-control" accept="image/*" required />
                                    <small>يفضل استخدام صورة أفقية واضحة مناسبة للبطاقات والصفحة الرئيسية.</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <div class="qdrat-switch-card h-100">
                            <div class="form-check form-switch qdrat-switch">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label class="form-check-label">مفعّلة</label>
                            </div>
                            <small>تفعيل الدورة يسمح بعرضها حسب إعدادات الواجهة.</small>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <div class="qdrat-switch-card h-100">
                            <div class="form-check form-switch qdrat-switch">
                                <input asp-for="ShowOnHomePage" class="form-check-input" />
                                <label class="form-check-label">عرض في الصفحة الرئيسية</label>
                            </div>
                            <small>عند التفعيل تظهر الدورة ضمن عناصر الصفحة الرئيسية.</small>
                        </div>
                    </div>

                </div>

                <div class="qdrat-actions">
                    <a asp-action="Index" class="btn qdrat-btn qdrat-btn-light">
                        <i class="bi bi-arrow-right"></i>
                        رجوع
                    </a>

                    <button id="saveBtn" type="submit" class="btn qdrat-btn qdrat-btn-primary">
                        <i class="bi bi-save"></i>
                        حفظ الدورة
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .qdrat-page {
        padding: 24px;
        background: #f5f7fb;
        min-height: calc(100vh - 80px);
        font-family: inherit;
    }

    .qdrat-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 26px;
        border-radius: 24px;
        background: linear-gradient(135deg, #102a43 0%, #1d4ed8 58%, #38bdf8 100%);
        color: #fff;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
    }

    .qdrat-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .qdrat-title {
        margin: 0;
        font-size: 28px;
        font-weight: 900;
        letter-spacing: -0.5px;
    }

    .qdrat-subtitle {
        margin: 10px 0 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 15px;
        line-height: 1.8;
        max-width: 850px;
    }

    .qdrat-hero-icon {
        width: 74px;
        height: 74px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.16);
        font-size: 34px;
        flex: 0 0 auto;
    }

    .qdrat-card {
        border: 1px solid #e5e7eb;
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    .qdrat-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #edf0f5;
        background: #fff;
    }

        .qdrat-card-header h5 {
            margin: 0;
            color: #0f172a;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .qdrat-card-header h5 i {
                color: #2563eb;
            }

        .qdrat-card-header p {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 14px;
        }

    .qdrat-card-body {
        padding: 24px;
    }

    .qdrat-field .form-label {
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 9px;
    }

    .qdrat-input-wrap,
    .qdrat-textarea-wrap {
        position: relative;
    }

        .qdrat-input-wrap > i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 3;
            pointer-events: none;
        }

        .qdrat-textarea-wrap > i {
            position: absolute;
            right: 15px;
            top: 18px;
            color: #64748b;
            z-index: 3;
            pointer-events: none;
        }

        .qdrat-input-wrap .form-control,
        .qdrat-input-wrap .form-select {
            min-height: 48px;
            border-radius: 15px;
            border-color: #dbe3ef;
            padding-right: 42px;
            font-weight: 700;
        }

        .qdrat-textarea-wrap .form-control {
            border-radius: 15px;
            border-color: #dbe3ef;
            padding-right: 42px;
            padding-top: 14px;
            font-weight: 700;
            line-height: 1.9;
            resize: vertical;
        }

            .qdrat-input-wrap .form-control:focus,
            .qdrat-input-wrap .form-select:focus,
            .qdrat-textarea-wrap .form-control:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 0.22rem rgba(37, 99, 235, 0.12);
            }

    .qdrat-file-box {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        border: 1px dashed #cbd5e1;
        border-radius: 18px;
        background: #f8fafc;
        padding: 16px;
    }

        .qdrat-file-box > i {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #eff6ff;
            color: #2563eb;
            font-size: 21px;
            flex: 0 0 auto;
        }

        .qdrat-file-box .form-control {
            border-radius: 14px;
            border-color: #dbe3ef;
            font-weight: 700;
        }

        .qdrat-file-box small {
            display: block;
            margin-top: 8px;
            color: #64748b;
            font-weight: 700;
            line-height: 1.7;
        }

    .qdrat-switch-card {
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 18px;
        background: #f8fafc;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 10px;
    }

    .qdrat-switch {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-right: 0;
        margin-bottom: 0;
    }

        .qdrat-switch .form-check-input {
            float: none;
            margin: 0;
            width: 46px;
            height: 24px;
            cursor: pointer;
        }

        .qdrat-switch .form-check-label {
            font-weight: 900;
            color: #1e293b;
            cursor: pointer;
        }

    .qdrat-switch-card small {
        color: #64748b;
        line-height: 1.8;
        font-weight: 700;
    }

    .qdrat-feedback span {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-weight: 900;
    }

    .qdrat-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 26px;
        margin-top: 28px;
        border-top: 1px solid #edf0f5;
    }

    .qdrat-btn {
        min-height: 46px;
        border-radius: 14px;
        padding: 10px 24px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .qdrat-btn-primary {
        background: #16a34a;
        border-color: #16a34a;
        color: #fff;
    }

        .qdrat-btn-primary:hover {
            background: #15803d;
            border-color: #15803d;
            color: #fff;
        }

    .qdrat-btn-light {
        background: #f8fafc;
        border-color: #dbe3ef;
        color: #334155;
    }

        .qdrat-btn-light:hover {
            background: #eef2f7;
            border-color: #cbd5e1;
            color: #0f172a;
        }

    .qdrat-alert {
        border: 0;
        border-radius: 18px;
        padding: 15px 18px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 800;
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.07);
    }

    .qdrat-alert-danger {
        color: #991b1b;
        background: #fee2e2;
    }

    .qdrat-alert-success {
        color: #166534;
        background: #dcfce7;
    }

    @@media (max-width: 768px) {
        .qdrat-page {
            padding: 14px;
        }

        .qdrat-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 20px;
        }

        .qdrat-title {
            font-size: 23px;
        }

        .qdrat-hero-icon {
            width: 58px;
            height: 58px;
            font-size: 26px;
        }

        .qdrat-card-body,
        .qdrat-card-header {
            padding: 18px;
        }

        .qdrat-actions {
            flex-direction: column-reverse;
        }

        .qdrat-btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function arabicToSlug(text) {
            const map = {
                'ا': 'a', 'أ': 'a', 'إ': 'i', 'آ': 'a', 'ء': '', 'ئ': 'e', 'ؤ': 'o',
                'ب': 'b', 'ت': 't', 'ث': 'th', 'ج': 'j', 'ح': 'h', 'خ': 'kh',
                'د': 'd', 'ذ': 'th', 'ر': 'r', 'ز': 'z', 'س': 's', 'ش': 'sh',
                'ص': 's', 'ض': 'd', 'ط': 't', 'ظ': 'z', 'ع': 'a', 'غ': 'gh',
                'ف': 'f', 'ق': 'q', 'ك': 'k', 'ل': 'l', 'م': 'm', 'ن': 'n',
                'ه': 'h', 'و': 'w', 'ي': 'y', 'ى': 'a', 'ة': 'h', 'ﻻ': 'la'
            };

            return text.trim().toLowerCase()
                .replace(/[^\u0621-\u064A0-9\s]/g, '')
                .split('').map(ch => map[ch] || ch).join('')
                .replace(/\s+/g, '-')
                .replace(/-+/g, '-')
                .replace(/^-|-$/g, '');
        }

        document.addEventListener('DOMContentLoaded', function () {
            const titleInput = document.querySelector('input[name="Title"]');
            const slugInput = document.querySelector('input[name="Slug"]');
            const feedback = document.getElementById('slug-feedback');
            const saveBtn = document.getElementById('saveBtn');
            let slugTimer;

            async function checkSlug(slug) {
                if (!slug || slug.length < 2) {
                    feedback.innerHTML = "";
                    saveBtn.disabled = false;
                    return;
                }

                clearTimeout(slugTimer);
                slugTimer = setTimeout(async () => {
                    try {
                        const response = await fetch(`/Admin/SubCourses/CheckSlugExists?slug=${encodeURIComponent(slug)}`);
                        const data = await response.json();

                        if (data.exists) {
                            feedback.innerHTML = "<span class='text-danger'><i class='bi bi-exclamation-triangle-fill'></i> هذا الرابط مستخدم مسبقًا</span>";
                            saveBtn.disabled = true;
                        } else {
                            feedback.innerHTML = "<span class='text-success'><i class='bi bi-check-circle-fill'></i> الرابط متاح</span>";
                            saveBtn.disabled = false;
                        }
                    } catch {
                        feedback.innerHTML = "<span class='text-warning'><i class='bi bi-exclamation-circle-fill'></i> فشل التحقق من الرابط</span>";
                        saveBtn.disabled = false;
                    }
                }, 400);
            }

            if (titleInput && slugInput) {
                titleInput.addEventListener('input', function () {
                    const slugValue = arabicToSlug(this.value);
                    slugInput.value = slugValue;
                    checkSlug(slugValue);
                });

                slugInput.addEventListener('input', function () {
                    checkSlug(this.value);
                });
            }
        });
    </script>
}
