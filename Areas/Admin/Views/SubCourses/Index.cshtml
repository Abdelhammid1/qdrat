@model IEnumerable<QdratNew.Entities.Frontend.SubCourse>
@{
    ViewData["Title"] = "📚 إدارة الدورات الفرعية";
}

<div class="container mt-4" dir="rtl">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-success"><i class="bi bi-layers"></i> @ViewData["Title"]</h3>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle"></i> إضافة دورة فرعية
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center mt-5">
            🚫 لا توجد دورات فرعية مضافة بعد.
        </div>
    }
    else
    {
        <table class="table table-bordered align-middle shadow-sm bg-white">
            <thead class="table-light text-center">
                <tr>
                    <th>الصورة</th>
                    <th>العنوان</th>
                    <th>الدورة الرئيسية</th>
                    <th>الظهور في الرئيسية</th>
                    <th>الحالة</th>
                    <th>الترتيب</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="text-center">
                        <td style="width:120px">
                            @if (!string.IsNullOrEmpty(item.ImagePath))
                            {
                                <img src="@Url.Content(item.ImagePath)" alt="@item.Title"
                                     class="rounded-3 shadow-sm" style="width:100px;height:70px;object-fit:cover;" />
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>

                        <td class="fw-bold text-primary">@item.Title</td>
                        <td>@item.FrontendCourse?.Title</td>
                        <td>@(item.ShowOnHomePage ? "✅ نعم" : "🚫 لا")</td>
                        <td>@(item.IsActive ? "🟢 فعالة" : "🔴 معطلة")</td>
                        <td>@item.DisplayOrder</td>

                        <td>
                            <div class="d-flex justify-content-center gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-pencil-square"></i> تعديل
                                </a>

                                <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                                      onsubmit="return confirm('هل أنت متأكد من الحذف؟');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash"></i> حذف
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
