@using QdratNew.Enums
@model QdratNew.Entities.VerbalPassage

@{
    ViewData["Title"] = "إضافة قطعة لفظية جديدة";
}

<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

<div class="qdrat-page" dir="rtl">

    <div class="qdrat-hero mb-4">
        <div>
            <div class="qdrat-kicker">
                <i class="fa-solid fa-book-open-reader"></i>
                قطعة لفظية
            </div>
            <h2 class="qdrat-title">إضافة قطعة لفظية جديدة</h2>
            <p class="qdrat-subtitle">
                أنشئ قطعة لفظية نصية أو مدعومة بملف صوتي/فيديو لاستخدامها داخل أسئلة الفهم اللفظي.
            </p>
        </div>

        <div class="qdrat-hero-icon">
            <i class="fa-solid fa-file-lines"></i>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert qdrat-alert qdrat-alert-warning">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    @if (TempData["Message"] != null)
    {
        <div class="alert qdrat-alert qdrat-alert-success">
            <i class="fa-solid fa-circle-check"></i>
            <span>@TempData["Message"]</span>
        </div>
    }

    <div class="qdrat-card">
        <div class="qdrat-card-header">
            <div>
                <h5>
                    <i class="fa-solid fa-pen-to-square"></i>
                    بيانات القطعة
                </h5>
                <p>أدخل عنوان القطعة ومحتواها وحدد نوعها والملف المرتبط بها عند الحاجة.</p>
            </div>
        </div>

        <div class="qdrat-card-body">

            @Html.ValidationSummary(false, "", new { @class = "alert qdrat-alert qdrat-alert-danger mb-4" })

            <form asp-action="Create" method="post" enctype="multipart/form-data" autocomplete="off">
                @Html.AntiForgeryToken()

                <div class="row g-4">

                    <div class="col-12">
                        <div class="qdrat-field">
                            <label asp-for="Title" class="form-label">العنوان</label>
                            <div class="qdrat-input-wrap">
                                <i class="fa-solid fa-heading"></i>
                                <input asp-for="Title" class="form-control" placeholder="اكتب عنوان القطعة اللفظية" />
                            </div>
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="qdrat-field">
                            <label class="form-label">النص الكامل</label>
                            <div class="qdrat-editor-shell">
                                <div id="editor" class="qdrat-quill-editor"></div>
                            </div>
                            <input type="hidden" asp-for="Content" id="Content" />
                            <span asp-validation-for="Content" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-field">
                            <label class="form-label">نوع القطعة</label>
                            <div class="qdrat-input-wrap">
                                <i class="fa-solid fa-layer-group"></i>
                                <select asp-for="Type" id="passageType" class="form-select"
                                        asp-items="Html.GetEnumSelectList<PassageType>()">
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12">
                        <div class="qdrat-status-box h-100">
                            <div class="form-check form-switch qdrat-switch">
                                <input asp-for="RequireFullListen" class="form-check-input" />
                                <label class="form-check-label">إجبار الطالب على الاستماع قبل الإجابة</label>
                            </div>
                            <small>يُستخدم هذا الخيار مع القطع الصوتية أو المرئية لضمان فتح المحتوى قبل الحل.</small>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="qdrat-note">
                            <i class="fa-solid fa-circle-info"></i>
                            <span>إذا اخترت صوت أو فيديو يجب رفع ملف، ويمكن تحديد المدة بالثواني.</span>
                        </div>
                    </div>

                    <div class="col-lg-8 col-md-12" id="mediaUploadSection">
                        <div class="qdrat-field">
                            <label class="form-label">رفع ملف</label>
                            <div class="qdrat-file-wrap">
                                <input type="file" name="mediaFile" class="form-control" id="mediaInput" />
                            </div>
                            <small class="qdrat-help-text">MP3 - MP4 - WAV (حد أقصى 20MB)</small>
                            <div id="mediaPreview" class="qdrat-media-preview mt-3"></div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-12" id="durationSection">
                        <div class="qdrat-field">
                            <label class="form-label">مدة الميديا (بالثواني)</label>
                            <div class="qdrat-input-wrap">
                                <i class="fa-solid fa-stopwatch"></i>
                                <input asp-for="DurationSeconds" class="form-control" type="number" min="0" placeholder="مثال: 120" />
                            </div>
                        </div>
                    </div>

                </div>

                <div class="qdrat-actions">
                    <a asp-action="Index" class="btn qdrat-btn qdrat-btn-light">
                        <i class="fa-solid fa-arrow-right"></i>
                        رجوع
                    </a>

                    <button type="submit" class="btn qdrat-btn qdrat-btn-primary">
                        <i class="fa-solid fa-check-circle"></i>
                        حفظ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .qdrat-page {
        padding: 24px;
        background: #f5f7fb;
        min-height: calc(100vh - 80px);
        font-family: inherit;
    }

    .qdrat-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 26px;
        border-radius: 24px;
        background: linear-gradient(135deg, #102a43 0%, #1d4ed8 58%, #38bdf8 100%);
        color: #fff;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
    }

    .qdrat-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .qdrat-title {
        margin: 0;
        font-size: 28px;
        font-weight: 900;
        letter-spacing: -0.5px;
    }

    .qdrat-subtitle {
        margin: 10px 0 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 15px;
        line-height: 1.8;
        max-width: 850px;
    }

    .qdrat-hero-icon {
        width: 74px;
        height: 74px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.16);
        font-size: 34px;
        flex: 0 0 auto;
    }

    .qdrat-card {
        border: 1px solid #e5e7eb;
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    .qdrat-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #edf0f5;
        background: #fff;
    }

        .qdrat-card-header h5 {
            margin: 0;
            color: #0f172a;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .qdrat-card-header h5 i {
                color: #2563eb;
            }

        .qdrat-card-header p {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 14px;
        }

    .qdrat-card-body {
        padding: 24px;
    }

    .qdrat-field .form-label {
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 9px;
    }

    .qdrat-input-wrap {
        position: relative;
    }

        .qdrat-input-wrap > i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 3;
            pointer-events: none;
        }

        .qdrat-input-wrap .form-control,
        .qdrat-input-wrap .form-select,
        .qdrat-file-wrap .form-control {
            min-height: 48px;
            border-radius: 15px;
            border-color: #dbe3ef;
            font-weight: 700;
        }

        .qdrat-input-wrap .form-control,
        .qdrat-input-wrap .form-select {
            padding-right: 42px;
        }

            .qdrat-input-wrap .form-control:focus,
            .qdrat-input-wrap .form-select:focus,
            .qdrat-file-wrap .form-control:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 0.22rem rgba(37, 99, 235, 0.12);
            }

    .qdrat-editor-shell {
        border: 1px solid #dbe3ef;
        border-radius: 18px;
        overflow: hidden;
        background: #fff;
    }

    .qdrat-quill-editor {
        height: 280px;
        background: #fff;
    }

    .ql-toolbar.ql-snow {
        border: 0;
        border-bottom: 1px solid #e5e7eb;
        background: #f8fafc;
    }

    .ql-container.ql-snow {
        border: 0;
    }

    .ql-editor {
        direction: ltr;
        text-align: left;
        unicode-bidi: plaintext;
        line-height: 1.9;
        font-size: 15px;
        min-height: 230px;
    }

        .ql-editor[dir="rtl"] {
            direction: rtl;
            text-align: right;
        }

        .ql-editor p {
            unicode-bidi: plaintext;
            margin-bottom: .75rem;
        }

    .qdrat-status-box {
        min-height: 104px;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 18px;
        background: #f8fafc;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 10px;
    }

    .qdrat-switch {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-right: 0;
        margin-bottom: 0;
    }

        .qdrat-switch .form-check-input {
            float: none;
            margin: 0;
            width: 46px;
            height: 24px;
            cursor: pointer;
        }

        .qdrat-switch .form-check-label {
            font-weight: 900;
            color: #1e293b;
            cursor: pointer;
        }

    .qdrat-status-box small,
    .qdrat-help-text {
        color: #64748b;
        line-height: 1.8;
        font-weight: 700;
    }

    .qdrat-note {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 14px 16px;
        border-radius: 18px;
        background: #eff6ff;
        color: #1e40af;
        font-weight: 800;
        line-height: 1.8;
    }

    .qdrat-media-preview audio,
    .qdrat-media-preview video {
        width: 100%;
        max-width: 520px;
        border-radius: 16px;
        background: #0f172a;
    }

    .qdrat-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 26px;
        margin-top: 28px;
        border-top: 1px solid #edf0f5;
    }

    .qdrat-btn {
        min-height: 46px;
        border-radius: 14px;
        padding: 10px 24px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .qdrat-btn-primary {
        background: #16a34a;
        border-color: #16a34a;
        color: #fff;
    }

        .qdrat-btn-primary:hover {
            background: #15803d;
            border-color: #15803d;
            color: #fff;
        }

    .qdrat-btn-light {
        background: #f8fafc;
        border-color: #dbe3ef;
        color: #334155;
    }

        .qdrat-btn-light:hover {
            background: #eef2f7;
            border-color: #cbd5e1;
            color: #0f172a;
        }

    .qdrat-alert {
        border: 0;
        border-radius: 18px;
        padding: 15px 18px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 800;
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.07);
    }

        .qdrat-alert:empty {
            display: none;
        }

    .qdrat-alert-danger,
    .qdrat-alert-warning {
        color: #991b1b;
        background: #fee2e2;
    }

    .qdrat-alert-success {
        color: #166534;
        background: #dcfce7;
    }

    @@media (max-width: 768px) {
        .qdrat-page {
            padding: 14px;
        }

        .qdrat-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 20px;
        }

        .qdrat-title {
            font-size: 23px;
        }

        .qdrat-hero-icon {
            width: 58px;
            height: 58px;
            font-size: 26px;
        }

        .qdrat-card-body,
        .qdrat-card-header {
            padding: 18px;
        }

        .qdrat-actions {
            flex-direction: column-reverse;
        }

        .qdrat-btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

    <script>
        const quill = new Quill('#editor', {
            theme: 'snow',
            modules: {
                toolbar: [
                    [{ header: [2, 3, false] }],
                    ['bold', 'italic', 'underline'],
                    [{ 'align': [] }],
                    [{ 'direction': 'rtl' }],
                    [{ list: 'ordered' }, { list: 'bullet' }],
                    ['clean']
                ]
            }
        });

        quill.on('text-change', function () {
            document.getElementById('Content').value = quill.root.innerHTML.trim();
        });

        document.addEventListener("DOMContentLoaded", function () {
            const typeSelect = document.getElementById("passageType");
            const mediaSection = document.getElementById("mediaUploadSection");
            const durationSection = document.getElementById("durationSection");
            const mediaInput = document.getElementById("mediaInput");
            const preview = document.getElementById("mediaPreview");

            function toggleMediaFields() {
                const type = parseInt(typeSelect.value);

                if (type === 0) {
                    mediaSection.style.display = "none";
                    durationSection.style.display = "none";
                } else {
                    mediaSection.style.display = "block";
                    durationSection.style.display = "block";
                }
            }

            typeSelect.addEventListener("change", toggleMediaFields);
            toggleMediaFields();

            mediaInput.addEventListener("change", function () {
                const file = this.files[0];

                if (!file) {
                    preview.innerHTML = "";
                    return;
                }

                const url = URL.createObjectURL(file);

                if (file.type.startsWith("audio")) {
                    preview.innerHTML = `<audio controls src="${url}"></audio>`;
                }
                else if (file.type.startsWith("video")) {
                    preview.innerHTML = `<video controls src="${url}"></video>`;
                }
                else {
                    preview.innerHTML = "";
                }
            });
        });
    </script>
}
