@using QdratNew.Enums

@{
    ViewData["Title"] = "الأسئلة المرتبطة بالقطعة اللفظية";
    var isRTL = (bool)(ViewData["IsRTL"] ?? true);

    var passageTitle = ViewData["PassageTitle"]?.ToString() ?? "قطعة لفظية";
    var passageContent = ViewData["PassageContent"]?.ToString() ?? "";
    var passageMediaUrl = ViewData["PassageMediaUrl"]?.ToString();
    var passageType = ViewData["PassageType"]?.ToString();
    var passageId = ViewData["PassageId"]?.ToString();
}

@section Styles {
    <style>
        :root {
            --pr-bg: #f4f7fb;
            --pr-surface: #111827;
            --pr-card: #1c2538;
            --pr-border: rgba(255,255,255,.08);
            --pr-accent: #2563eb;
            --pr-accent-glow: rgba(37,99,235,.16);
            --pr-success: #16a34a;
            --pr-danger: #dc2626;
            --pr-warning: #f59e0b;
            --pr-text: #e2e8f0;
            --pr-muted: #64748b;
            --pr-radius: 14px;
            --pr-radius-sm: 9px;
            --pr-font: 'Cairo', sans-serif;
            --pr-transition: .2s cubic-bezier(.4,0,.2,1);
        }

        body {
            background: var(--pr-bg) !important;
        }

        .pr-page {
            font-family: var(--pr-font);
            min-height: 100vh;
            padding: 28px 0 60px;
            direction: rtl;
        }

        .pr-header {
            background: #ffffff !important;
            border: 1px solid #dbe4ef !important;
            border-radius: var(--pr-radius) !important;
            padding: 18px 22px !important;
            box-shadow: 0 8px 22px rgba(15, 23, 42, 0.06) !important;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 24px;
        }

        .pr-header-title {
            color: #0f172a !important;
            font-size: 22px !important;
            font-weight: 900 !important;
            margin: 0;
            line-height: 1.2;
        }

            .pr-header-title i {
                color: var(--pr-accent) !important;
                opacity: 1 !important;
            }

        .pr-header-sub {
            color: #475569 !important;
            font-size: 13px !important;
            font-weight: 600 !important;
            margin-top: 5px;
        }

        .pr-header-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .btn-pr-primary {
            background: var(--pr-accent);
            border: 1px solid var(--pr-accent);
            color: #ffffff;
            font-size: 13px;
            font-weight: 800;
            border-radius: var(--pr-radius-sm);
            padding: 8px 18px;
            transition: var(--pr-transition);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            cursor: pointer;
        }

            .btn-pr-primary:hover {
                background: #1d4ed8;
                border-color: #1d4ed8;
                color: #ffffff;
                transform: translateY(-1px);
                box-shadow: 0 6px 18px rgba(37,99,235,.25);
                text-decoration: none;
            }

        .btn-pr-outline {
            background: #ffffff;
            border: 1px solid #cbd5e1;
            color: #334155;
            font-size: 13px;
            font-weight: 800;
            border-radius: var(--pr-radius-sm);
            padding: 8px 18px;
            transition: var(--pr-transition);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            text-decoration: none;
        }

            .btn-pr-outline:hover {
                background: #f1f5f9;
                border-color: #94a3b8;
                color: #0f172a;
                text-decoration: none;
            }

        .btn-pr-ghost {
            background: #f8fafc;
            border: 1px solid #dbe4ef;
            color: #475569;
            font-size: 13px;
            font-weight: 800;
            border-radius: var(--pr-radius-sm);
            padding: 8px 14px;
            transition: var(--pr-transition);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .btn-pr-ghost:hover {
                color: #0f172a;
                background: #eef2ff;
                border-color: #c7d2fe;
                text-decoration: none;
            }

        .pr-hero {
            background: linear-gradient(135deg, #1a2540 0%, #1c3052 60%, #162440 100%);
            border: 1px solid var(--pr-border);
            border-radius: var(--pr-radius);
            padding: 28px 32px;
            margin-bottom: 24px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 14px 32px rgba(15, 23, 42, 0.18);
        }

            .pr-hero::before {
                content: '';
                position: absolute;
                top: -70px;
                left: -70px;
                width: 240px;
                height: 240px;
                background: radial-gradient(circle, rgba(59,130,246,.20) 0%, transparent 70%);
                pointer-events: none;
            }

        .pr-hero-label {
            font-size: 13px;
            color: #94a3b8;
            margin-bottom: 6px;
            font-weight: 700;
        }

        .pr-hero-title {
            font-size: 30px;
            font-weight: 900;
            line-height: 1.45;
            color: #ffffff;
            margin: 0;
        }

        .pr-hero-filtered {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            background: rgba(59,130,246,.14);
            color: #bfdbfe;
            border: 1px solid rgba(59,130,246,.30);
            border-radius: 20px;
            padding: 5px 13px;
            margin-top: 12px;
            font-weight: 700;
        }

        .pr-chips {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
        }

        .pr-chip {
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.10);
            border-radius: var(--pr-radius-sm);
            padding: 13px 14px;
            text-align: center;
        }

        .pr-chip-val {
            font-size: 24px;
            font-weight: 900;
            line-height: 1;
        }

        .pr-chip-lbl {
            font-size: 12px;
            color: #cbd5e1;
            margin-top: 5px;
            font-weight: 700;
        }

        .pr-section-label {
            font-size: 12px;
            font-weight: 900;
            color: #334155;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .pr-section-label::after {
                content: '';
                flex: 1;
                height: 1px;
                background: #dbe4ef;
            }

        .pr-passage-panel {
            background: #ffffff;
            border: 1px solid #dbe4ef;
            border-radius: var(--pr-radius);
            padding: 22px 24px;
            margin-bottom: 22px;
            box-shadow: 0 8px 22px rgba(15, 23, 42, 0.05);
        }

        .pr-passage-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 16px;
        }

        .pr-passage-title {
            color: #0f172a;
            font-size: 17px;
            font-weight: 900;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .pr-passage-type {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            font-weight: 900;
            color: #1e40af;
            background: #dbeafe;
            border: 1px solid #bfdbfe;
            border-radius: 20px;
            padding: 5px 13px;
        }

        .pr-media-box {
            background: #f8fafc;
            border: 1px solid #dbe4ef;
            border-radius: var(--pr-radius);
            padding: 16px;
            margin-bottom: 16px;
            text-align: center;
        }

            .pr-media-box audio,
            .pr-media-box video {
                width: 100%;
                max-width: 620px;
                border-radius: 12px;
                box-shadow: 0 8px 20px rgba(15, 23, 42, 0.10);
            }

        .pr-verbal-box {
            background: #f8fafc;
            color: #0f172a;
            border: 1px solid #dbe4ef;
            border-radius: var(--pr-radius);
            padding: 22px;
            line-height: 2;
            font-size: 15px;
            font-weight: 700;
        }

            .pr-verbal-box p {
                unicode-bidi: plaintext;
                margin-bottom: 10px;
            }

        .pr-toolbar {
            background: #111827;
            border: 1px solid #243041;
            border-radius: var(--pr-radius);
            padding: 14px 20px;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.12);
        }

        .pr-toolbar-title {
            font-size: 14px;
            font-weight: 900;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .pr-selected-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            font-weight: 800;
            color: #bfdbfe;
            background: rgba(37,99,235,.20);
            border: 1px solid rgba(37,99,235,.35);
            border-radius: 20px;
            padding: 5px 13px;
        }

        .pr-table-panel {
            background: #ffffff !important;
            border: 1px solid #d8e0ec !important;
            border-radius: var(--pr-radius) !important;
            overflow: hidden;
            box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
        }

            .pr-table-panel .table,
            .pr-table-panel table.dataTable {
                background-color: #ffffff !important;
                color: #1e293b !important;
                margin: 0 !important;
                width: 100% !important;
            }

                .pr-table-panel .table thead th,
                .pr-table-panel table.dataTable thead th {
                    background: #f1f5f9 !important;
                    color: #0f172a !important;
                    border-bottom: 1px solid #cbd5e1 !important;
                    border-color: #dbe4ef !important;
                    font-size: 12px !important;
                    font-weight: 900 !important;
                    opacity: 1 !important;
                    padding: 12px 14px !important;
                    white-space: nowrap;
                    vertical-align: middle;
                }

                .pr-table-panel .table tbody td,
                .pr-table-panel table.dataTable tbody td {
                    background: #ffffff !important;
                    color: #1e293b !important;
                    border-color: #e2e8f0 !important;
                    font-size: 13px !important;
                    font-weight: 700 !important;
                    opacity: 1 !important;
                    padding: 12px 14px !important;
                    vertical-align: middle !important;
                }

                .pr-table-panel .table tbody tr:hover td,
                .pr-table-panel table.dataTable tbody tr:hover td {
                    background: #f8fafc !important;
                }

        .pr-q-title {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            min-width: 320px;
            text-align: right;
        }

        .pr-q-title-text {
            color: #0f172a !important;
            font-weight: 800 !important;
            opacity: 1 !important;
            line-height: 1.55;
            white-space: normal;
            max-width: 520px;
        }

        .pr-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 11px;
            font-weight: 900;
            border-radius: 20px;
            padding: 3px 10px;
            border: 1px solid transparent;
            white-space: nowrap;
        }

        .pr-badge-confirmed {
            background: #dcfce7 !important;
            color: #15803d !important;
            border-color: #86efac !important;
        }

        .pr-badge-unconfirmed {
            background: #fee2e2 !important;
            color: #b91c1c !important;
            border-color: #fca5a5 !important;
        }

        .pr-badge-empty {
            background: #f1f5f9 !important;
            color: #64748b !important;
            border-color: #cbd5e1 !important;
        }

        .pr-action-group {
            display: flex;
            gap: 5px;
            align-items: center;
            justify-content: center;
            flex-wrap: nowrap;
        }

        .pr-action-btn {
            background: #f8fafc !important;
            border: 1px solid #cbd5e1 !important;
            color: #475569 !important;
            border-radius: 7px;
            width: 31px;
            height: 31px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            transition: var(--pr-transition);
            text-decoration: none;
            cursor: pointer;
            opacity: 1 !important;
        }

            .pr-action-btn:hover {
                background: #e2e8f0 !important;
                color: #0f172a !important;
                text-decoration: none;
                transform: translateY(-1px);
            }

            .pr-action-btn.preview {
                color: #2563eb !important;
            }

            .pr-action-btn.edit {
                color: #b45309 !important;
            }

            .pr-action-btn.detail {
                color: #475569 !important;
            }

        .dataTables_wrapper .dataTables_length label,
        .dataTables_wrapper .dataTables_filter label,
        .dataTables_wrapper .dataTables_info {
            color: #334155 !important;
            font-size: 13px !important;
            font-weight: 800 !important;
        }

        .dataTables_wrapper .dataTables_length select,
        .dataTables_wrapper .dataTables_filter input {
            background: #ffffff !important;
            border: 1px solid #94a3b8 !important;
            color: #0f172a !important;
            border-radius: 8px !important;
            font-size: 13px !important;
            font-weight: 700 !important;
            padding: 5px 10px;
        }

        table.dataTable thead .sorting:before,
        table.dataTable thead .sorting:after,
        table.dataTable thead .sorting_asc:before,
        table.dataTable thead .sorting_asc:after,
        table.dataTable thead .sorting_desc:before,
        table.dataTable thead .sorting_desc:after {
            color: #475569 !important;
            opacity: 1 !important;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button {
            background: #ffffff !important;
            border: 1px solid #cbd5e1 !important;
            color: #334155 !important;
            font-weight: 800 !important;
            border-radius: 7px !important;
            margin: 0 2px;
            font-size: 12px;
            padding: 4px 10px !important;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button.current,
            .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
                background: var(--pr-accent) !important;
                border-color: var(--pr-accent) !important;
                color: #ffffff !important;
            }

        .pr-modal .modal-content {
            background: #111827;
            border: 1px solid #334155;
            border-radius: var(--pr-radius);
            color: #ffffff;
            overflow: hidden;
        }

        .pr-modal .modal-header {
            background: #111827;
            border-bottom: 1px solid #334155;
            padding: 16px 22px;
        }

        .pr-modal .modal-title {
            font-size: 15px;
            font-weight: 900;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .pr-modal .modal-body {
            padding: 22px;
        }

        .pr-modal .btn-close {
            filter: invert(1) brightness(1.7);
            opacity: 1;
        }

        .pr-empty {
            text-align: center;
            padding: 50px 20px;
            color: #94a3b8;
        }

            .pr-empty i {
                font-size: 34px;
                margin-bottom: 12px;
                opacity: .75;
            }

        #questionPreviewModalBody {
            background: #111827 !important;
            color: #0f172a !important;
        }

            #questionPreviewModalBody .card,
            #questionPreviewModalBody .question-card,
            #questionPreviewModalBody .question-preview-card,
            #questionPreviewModalBody .q-card,
            #questionPreviewModalBody .preview-box,
            #questionPreviewModalBody .question-box {
                background: #ffffff !important;
                color: #0f172a !important;
                border: 1px solid #dbe4ef !important;
                box-shadow: 0 10px 24px rgba(15, 23, 42, 0.10) !important;
            }

            #questionPreviewModalBody h1,
            #questionPreviewModalBody h2,
            #questionPreviewModalBody h3,
            #questionPreviewModalBody h4,
            #questionPreviewModalBody h5,
            #questionPreviewModalBody h6,
            #questionPreviewModalBody .question-title,
            #questionPreviewModalBody .q-title,
            #questionPreviewModalBody .title {
                color: #0f172a !important;
                font-weight: 900 !important;
                opacity: 1 !important;
            }

            #questionPreviewModalBody p,
            #questionPreviewModalBody span,
            #questionPreviewModalBody div,
            #questionPreviewModalBody label,
            #questionPreviewModalBody strong,
            #questionPreviewModalBody small {
                opacity: 1 !important;
            }

            #questionPreviewModalBody .card p,
            #questionPreviewModalBody .card span,
            #questionPreviewModalBody .card div,
            #questionPreviewModalBody .card label,
            #questionPreviewModalBody .question-card p,
            #questionPreviewModalBody .question-card span,
            #questionPreviewModalBody .question-card div,
            #questionPreviewModalBody .question-card label,
            #questionPreviewModalBody .question-preview-card p,
            #questionPreviewModalBody .question-preview-card span,
            #questionPreviewModalBody .question-preview-card div,
            #questionPreviewModalBody .question-preview-card label {
                color: #0f172a !important;
            }

            #questionPreviewModalBody .question-text,
            #questionPreviewModalBody .q-text,
            #questionPreviewModalBody .question-content,
            #questionPreviewModalBody .preview-question-text {
                color: #0f172a !important;
                font-size: 16px !important;
                font-weight: 700 !important;
                line-height: 1.9 !important;
                opacity: 1 !important;
            }

            #questionPreviewModalBody .option,
            #questionPreviewModalBody .answer-option,
            #questionPreviewModalBody .choice,
            #questionPreviewModalBody .option-card,
            #questionPreviewModalBody .answer-card,
            #questionPreviewModalBody .q-option,
            #questionPreviewModalBody .list-group-item {
                background: #ffffff !important;
                color: #0f172a !important;
                border: 1px solid #cbd5e1 !important;
                border-radius: 14px !important;
                font-weight: 800 !important;
                opacity: 1 !important;
            }

                #questionPreviewModalBody .option *,
                #questionPreviewModalBody .answer-option *,
                #questionPreviewModalBody .choice *,
                #questionPreviewModalBody .option-card *,
                #questionPreviewModalBody .answer-card *,
                #questionPreviewModalBody .q-option *,
                #questionPreviewModalBody .list-group-item * {
                    color: #0f172a !important;
                    opacity: 1 !important;
                }

                #questionPreviewModalBody .correct,
                #questionPreviewModalBody .is-correct,
                #questionPreviewModalBody .correct-answer,
                #questionPreviewModalBody .answer-option.correct,
                #questionPreviewModalBody .option-card.correct,
                #questionPreviewModalBody .choice.correct {
                    background: #dcfce7 !important;
                    color: #14532d !important;
                    border: 2px solid #16a34a !important;
                    font-weight: 900 !important;
                }

            #questionPreviewModalBody .badge,
            #questionPreviewModalBody .badge-success,
            #questionPreviewModalBody .bg-success,
            #questionPreviewModalBody .correct-badge {
                background: #16a34a !important;
                color: #ffffff !important;
                border: 1px solid #15803d !important;
                font-weight: 900 !important;
                opacity: 1 !important;
            }

        #questionPreviewModalBody {
            font-size: 15px !important;
            font-weight: 600 !important;
            line-height: 1.9 !important;
        }

            #questionPreviewModalBody p,
            #questionPreviewModalBody div,
            #questionPreviewModalBody span,
            #questionPreviewModalBody label,
            #questionPreviewModalBody strong {
                font-size: 15px !important;
                font-weight: 600 !important;
                line-height: 1.9 !important;
            }

            #questionPreviewModalBody .question-text,
            #questionPreviewModalBody .q-text,
            #questionPreviewModalBody .question-content,
            #questionPreviewModalBody .preview-question-text {
                font-size: 16px !important;
                font-weight: 700 !important;
                line-height: 1.9 !important;
            }

            #questionPreviewModalBody audio {
                max-width: 520px !important;
                width: 100% !important;
            }

            #questionPreviewModalBody .card,
            #questionPreviewModalBody .question-card,
            #questionPreviewModalBody .question-preview-card,
            #questionPreviewModalBody .q-card,
            #questionPreviewModalBody .preview-box,
            #questionPreviewModalBody .question-box {
                padding: 18px !important;
            }
            #questionPreviewModalBody img {
                opacity: 1 !important;
                max-width: 100% !important;
            }

        @@media (max-width: 768px) {
            .pr-hero {
                padding: 22px;
            }

            .pr-hero-title {
                font-size: 22px;
            }

            .pr-chips {
                grid-template-columns: 1fr;
            }

            .pr-q-title {
                min-width: 260px;
            }

            .pr-toolbar {
                align-items: flex-start;
            }
        }
    </style>
}

<div class="pr-page container-fluid px-4" dir="rtl">

    <div class="pr-header">
        <div>
            <h1 class="pr-header-title">
                <i class="fas fa-book-open me-2" style="font-size:18px;"></i>
                الأسئلة المرتبطة بالقطعة اللفظية
            </h1>
            <div class="pr-header-sub">
                إدارة الأسئلة المرتبطة بالقطعة، معاينة السؤال، متابعة حالة الإجابة، والتعديل من واجهة واحدة.
            </div>
        </div>

        <div class="pr-header-actions">
            <a asp-action="Index" class="btn-pr-outline">
                <i class="fas fa-arrow-right"></i>
                العودة لقائمة القطع
            </a>

            <a asp-action="Edit"
               asp-route-id="@passageId"
               class="btn-pr-primary">
                <i class="fas fa-pen"></i>
                تعديل القطعة
            </a>
        </div>
    </div>

    <div class="pr-hero">
        <div class="row g-4 align-items-center">
            <div class="col-lg-7">
                <div class="pr-hero-label">إدارة قطعة لفظية</div>

                <h2 class="pr-hero-title">
                    @passageTitle
                </h2>

                <div class="pr-hero-filtered">
                    <i class="fas fa-layer-group" style="font-size:11px;"></i>
                    الأسئلة المعروضة مرتبطة بهذه القطعة فقط
                </div>
            </div>

            <div class="col-lg-5">
                <div class="pr-chips">
                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#bfdbfe;" id="totalLinkedQuestions">0</div>
                        <div class="pr-chip-lbl">عدد الأسئلة</div>
                    </div>

                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#86efac;" id="confirmedQuestions">0</div>
                        <div class="pr-chip-lbl">إجابات مؤكدة</div>
                    </div>

                    <div class="pr-chip">
                        <div class="pr-chip-val" style="color:#fca5a5;" id="unconfirmedQuestions">0</div>
                        <div class="pr-chip-lbl">غير مكتملة</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="pr-section-label">بيانات القطعة</div>

    <div class="pr-passage-panel">
        <div class="pr-passage-head">
            <h3 class="pr-passage-title">
                <i class="fas fa-file-lines" style="color:#2563eb;"></i>
                محتوى القطعة
            </h3>

            <span class="pr-passage-type">
                @if (passageType == "1")
                {
                    <i class="fas fa-volume-high"></i>
                    <span>قطعة صوتية</span>
                }
                else if (passageType == "2")
                {
                    <i class="fas fa-video"></i>
                    <span>قطعة فيديو</span>
                }
                else
                {
                    <i class="fas fa-align-right"></i>
                    <span>قطعة نصية</span>
                }
            </span>
        </div>

        @if (!string.IsNullOrWhiteSpace(passageMediaUrl))
        {
            <div class="pr-media-box">
                @if (passageType == "1")
                {
                    <audio controls>
                        <source src="@passageMediaUrl" />
                    </audio>
                }
                else if (passageType == "2")
                {
                    <video controls>
                        <source src="@passageMediaUrl" />
                    </video>
                }
            </div>
        }

        <div class="pr-verbal-box"
             dir="@(isRTL ? "rtl" : "ltr")"
             style="text-align:@(isRTL ? "right" : "left")">
            @Html.Raw(passageContent)
        </div>
    </div>

    <div class="pr-section-label">جدول الأسئلة</div>

    <div class="pr-toolbar">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="pr-toolbar-title">
                <i class="fas fa-table"></i>
                الأسئلة المرتبطة بالقطعة
            </div>

            <span class="pr-selected-badge">
                <i class="fas fa-bolt"></i>
                إدارة مباشرة من الجدول
            </span>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Edit"
               asp-route-id="@passageId"
               class="btn-pr-outline"
               style="background:transparent;color:#e2e8f0;border-color:#334155;">
                <i class="fas fa-pen"></i>
                تعديل القطعة
            </a>

            <a asp-action="Index"
               class="btn-pr-outline"
               style="background:transparent;color:#e2e8f0;border-color:#334155;">
                <i class="fas fa-arrow-right"></i>
                رجوع
            </a>
        </div>
    </div>

    <div class="pr-table-panel">
        <div class="table-responsive">
            <table id="linkedQuestionsTable" class="table table-hover w-100 text-center">
                <thead>
                    <tr>
                        <th style="min-width:360px;">السؤال</th>
                        <th>القسم</th>
                        <th>المحور</th>
                        <th>التاريخ</th>
                        <th>الحالة</th>
                        <th style="width:130px;">إجراءات</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade pr-modal" id="questionPreviewModal" tabindex="-1" dir="rtl">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content text-end">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-eye" style="color:#60a5fa;"></i>
                    معاينة السؤال
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="questionPreviewModalBody">
                <div class="pr-empty">
                    <i class="fas fa-spinner fa-spin"></i>
                    <p>جارٍ التحميل...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/libs/datatables/js/jquery.datatables.min.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/libs/datatables/js/datatables.buttons.min.js?v=@DateTime.Now.Ticks"></script>

    <script>
        const passageId = '@passageId';

        function cleanQuestionTitle(rawTitle) {
            if (!rawTitle) {
                return '';
            }

            return rawTitle.replace(/<span[^>]*display:none[^>]*>(.*?)<\/span>/gi, '$1');
        }

        function shortenText(text, maxLength) {
            if (!text) {
                return '';
            }

            return text.length > maxLength ? text.substring(0, maxLength) + '...' : text;
        }

        function safeText(value) {
            if (value === null || value === undefined || value === '') {
                return '—';
            }

            return value;
        }

        function formatDate(value) {
            if (!value) {
                return '—';
            }

            const date = new Date(value);

            if (isNaN(date.getTime())) {
                return value;
            }

            return date.toLocaleDateString('ar-EG');
        }

        function updateLinkedQuestionsStats(data) {
            const rows = Array.isArray(data) ? data : [];

            const total = rows.length;
            const confirmed = rows.filter(x => x.IsAnswerConfirmed === true || x.isAnswerConfirmed === true).length;
            const unconfirmed = total - confirmed;

            document.getElementById('totalLinkedQuestions').textContent = total;
            document.getElementById('confirmedQuestions').textContent = confirmed;
            document.getElementById('unconfirmedQuestions').textContent = unconfirmed;
        }

        const table = $('#linkedQuestionsTable').DataTable({
            ajax: {
                url: '/Admin/VerbalPassages/LoadLinkedQuestionsData',
                type: 'POST',
                data: function () {
                    return {
                        passageId: passageId
                    };
                },
                dataSrc: function (json) {
                    const data = json && json.data ? json.data : [];
                    updateLinkedQuestionsStats(data);
                    return data;
                }
            },
            order: [[3, 'desc']],
            pageLength: 25,
            lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "الكل"]],
            columns: [
                {
                    data: null,
                    className: 'dt-body-right',
                    render: function (_, __, row) {
                        const id = row.Id || row.id;
                        const rawTitle = row.Title || row.title || '';
                        const cleanTitle = cleanQuestionTitle(rawTitle);
                        const shortTitle = shortenText(cleanTitle, 90);

                        return `
                            <div class="pr-q-title">
                                <button class="pr-action-btn preview flex-shrink-0"
                                        type="button"
                                        onclick="showQuestionPreview('${id}')"
                                        title="معاينة">
                                    <i class="fas fa-eye"></i>
                                </button>

                                <div class="pr-q-title-text">${shortTitle || '—'}</div>
                            </div>`;
                    }
                },
                {
                    data: 'Curriculum',
                    render: function (data, type, row) {
                        const value = data || row.curriculum;
                        return `<span style="color:#334155;font-weight:800;">${safeText(value)}</span>`;
                    }
                },
                {
                    data: 'Section',
                    render: function (data, type, row) {
                        const value = data || row.section;
                        return `<span style="color:#334155;font-weight:800;">${safeText(value)}</span>`;
                    }
                },
                {
                    data: 'CreatedAt',
                    render: function (data, type, row) {
                        const value = data || row.createdAt;
                        return `<span style="color:#334155;font-weight:800;">${formatDate(value)}</span>`;
                    }
                },
                {
                    data: 'IsAnswerConfirmed',
                    render: function (data, type, row) {
                        const value = data === true || row.isAnswerConfirmed === true;

                        return value
                            ? `<span class="pr-badge pr-badge-confirmed"><i class="fas fa-check"></i> مؤكدة</span>`
                            : `<span class="pr-badge pr-badge-unconfirmed"><i class="fas fa-xmark"></i> غير مكتملة</span>`;
                    }
                },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function (_, __, row) {
                        const id = row.Id || row.id;

                        return `
                            <div class="pr-action-group">
                                <button type="button"
                                        class="pr-action-btn preview"
                                        onclick="showQuestionPreview('${id}')"
                                        title="معاينة">
                                    <i class="fas fa-eye"></i>
                                </button>

                                <a href="/Admin/Questions/Edit/${id}"
                                   target="_blank"
                                   class="pr-action-btn edit"
                                   title="تعديل">
                                    <i class="fas fa-pen"></i>
                                </a>

                                <a href="/Admin/Questions/Details/${id}"
                                   target="_blank"
                                   class="pr-action-btn detail"
                                   title="التفاصيل">
                                    <i class="fas fa-info-circle"></i>
                                </a>
                            </div>`;
                    }
                }
            ],
            language: {
                url: "//cdn.datatables.net/plug-ins/1.13.5/i18n/ar.json"
            }
        });

        function showQuestionPreview(questionId) {
            const body = document.getElementById('questionPreviewModalBody');

            body.innerHTML = `
                <div class="pr-empty">
                    <i class="fas fa-spinner fa-spin"></i>
                    <p>جارٍ التحميل...</p>
                </div>`;

            const modal = new bootstrap.Modal(document.getElementById('questionPreviewModal'));
            modal.show();

            fetch(`/Admin/Questions/Preview/${questionId}`)
                .then(response => response.text())
                .then(html => {
                    body.innerHTML = html;
                })
                .catch(() => {
                    body.innerHTML = `
                        <div class="pr-empty">
                            <i class="fas fa-exclamation-triangle"></i>
                            <p>حدث خطأ أثناء تحميل السؤال.</p>
                        </div>`;
                });
        }
    </script>
}