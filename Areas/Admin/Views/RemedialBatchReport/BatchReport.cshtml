@model IEnumerable<QdratNew.ViewModels.Remedial.RemedialBatchReportVm>
@{
    ViewData["Title"] = "📋 تقرير الجلسات العلاجية للدفعة";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

<div class="container py-4">
    <h3 class="fw-bold text-primary mb-4 text-center">
        📋 تقرير الجلسات العلاجية للدفعة @ViewBag.BatchName
    </h3>

    <table class="table table-bordered align-middle text-center shadow-sm">
        <thead class="table-light">
            <tr>
                <th>👤 الطالب</th>
                <th>🩺 حالة العلاج</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td class="fw-bold">@s.StudentName</td>
                    <td>
                        <span class="badge @s.StatusColor px-3 py-2 fw-bold">
                            @s.Status
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="alert alert-light border-start border-4 border-primary mt-4">
        <h6 class="fw-bold text-primary">💡 التحليلات المقترحة:</h6>
        <ul class="mb-0">
            <li>عرض قائمة الطلاب الذين لديهم خطة علاجية ولم يتم جدولة جلسة بعد.</li>
            <li>تقرير تغيب أسبوعي يوضح من لم يحضر الجلسة العلاجية.</li>
            <li>فلتر لعرض طلاب المحاور المتكررة في الرسوب (لمساعدة المدرب على إعداد جلسة جماعية).</li>
            <li>زر توليد تقرير PDF لتسليمه لإدارة المعهد أو المدرب.</li>
        </ul>
    </div>
</div>
