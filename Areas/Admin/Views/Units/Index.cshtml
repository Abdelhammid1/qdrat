@model QdratNew.ViewModels.UnitIndexViewModel

@{
    ViewData["Title"] = "📚 قائمة الوحدات التعليمية";
}


    <div class="container mt-4" dir="rtl">
        <div class="d-flex justify-content-center align-items-center gap-2 mb-4">
            <h2 class="text-primary text-center mb-0">
                <i class="fas fa-book"></i> قائمة الوحدات التعليمية
            </h2>
            <button type="button"
                    class="btn btn-dark btn-sm rounded-circle d-flex align-items-center justify-content-center"
                    style="width: 35px; height: 35px;"
                    data-bs-toggle="modal" data-bs-target="#helpModal" title="مساعدة">
                <i class="fas fa-info"></i>
            </button>
        </div>
    </div>

        <!-- Modal المساعدة -->
<!-- Modal تعليمات استخدام الصفحة -->
<div class="modal fade" id="helpModal" tabindex="-1" aria-labelledby="helpModalLabel" aria-hidden="true" dir="rtl">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="helpModalLabel">
                    <i class="fas fa-info-circle me-2"></i> تعليمات استخدام الصفحة
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body text-end" style="direction: rtl; text-align: right;">
                <p class="mb-3 fw-bold" style="text-align: right;">👋 مرحبًا بك في صفحة <strong>إدارة الوحدات التعليمية</strong>! توفر لك هذه الصفحة الأدوات التالية:</p>
                <ul class="list-unstyled pe-3" style="text-align: right;">
                    <li>➕ إضافة وحدة تعليمية جديدة بكل سهولة ويسر.</li>
                    <li>🔍 استعراض المحاور المرتبطة بكل وحدة تعليمية بطريقة منظمة.</li>
                    <li>🛠️ تحديث بيانات الوحدة أو حذفها عند الحاجة.</li>
                    <li>📋 تصدير قائمة الوحدات إلى ملف <strong>نسخ</strong>، <strong>Excel</strong>، أو <strong>طباعة مباشرة</strong>.</li>
                </ul>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> إغلاق
                </button>
            </div>
        </div>
    </div>
</div>



<div class="d-flex justify-content-end mb-3" style="direction: rtl; text-align: right;">
        <a asp-action="Create" class="btn btn-success btn-sm">
            <i class="fas fa-plus"></i> إنشاء وحدة جديدة
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <table id="unitsTable" class="table table-hover table-striped align-middle text-center" style="width:100%">
                <thead class="table-dark">
                    <tr>
                        <th>📘 اسم الوحدة</th>
                        <th>📚 المحاور المرتبطة</th>
                        <th>⚙️ العمليات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var unit in Model.Units)
                    {
                        <tr>
                            <td class="fw-bold">@unit.Title</td>
                            <td>
                                @if (unit.SectionTitles.Any())
                                {
                                    <span class="text-success">يوجد عدد @unit.SectionTitles.Count محور</span>
                                    <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#sectionsModal_@unit.Id">
                                        عرض
                                    </button>

                                    <!-- Modal عرض المحاور -->
                                    <div class="modal fade" id="sectionsModal_@unit.Id" tabindex="-1" aria-labelledby="sectionsModalLabel_@unit.Id" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="sectionsModalLabel_@unit.Id">
                                                        المحاور المرتبطة بالوحدة: <span class="text-primary">@unit.Title</span>
                                                    </h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <div class="d-flex flex-wrap justify-content-center gap-2">
                                                        @foreach (var sectionTitle in unit.SectionTitles)
                                                        {
                                                            <span class="badge bg-primary bg-opacity-10 text-dark border border-primary p-2">
                                                                <i class="fas fa-book-open me-1"></i> @sectionTitle
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="modal-footer d-flex justify-content-between">
                                                    <a asp-controller="SectionUnits" asp-action="Manage" asp-route-unitId="@unit.Id" class="btn btn-primary btn-sm">
                                                        <i class="fas fa-cogs"></i> إدارة الربط
                                                    </a>
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                                                        <i class="fas fa-times"></i> إغلاق
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">لا توجد محاور مرتبطة</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@unit.Id" class="btn btn-light btn-sm" title="تعديل">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                <a asp-action="Details" asp-route-id="@unit.Id" class="btn btn-light btn-sm" title="تفاصيل">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                <a asp-action="Delete" asp-route-id="@unit.Id" class="btn btn-light btn-sm" title="حذف">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                <a asp-controller="SectionUnits" asp-action="Manage" asp-route-unitId="@unit.Id" class="btn btn-light btn-sm" title="ربط المحاور">
                                        <i class="fas fa-link"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.datatables.net/1.13.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.5/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <script>
        $(document).ready(function () {
            $('#unitsTable').DataTable({
                paging: true,
                searching: true,
                ordering: true,
                responsive: true,
                dom: 'Bfrtip',
                buttons: [
                    { extend: 'copy', className: 'btn btn-secondary btn-sm', text: '<i class="fas fa-copy"></i> نسخ' },
                    { extend: 'excel', className: 'btn btn-success btn-sm', text: '<i class="fas fa-file-excel"></i> إكسل' },
                    { extend: 'print', className: 'btn btn-primary btn-sm', text: '<i class="fas fa-print"></i> طباعة' }
                ],
                language: {
                    search: "🔍 بحث:",
                    lengthMenu: "عرض _MENU_ وحدة",
                    info: "عرض _START_ إلى _END_ من _TOTAL_ وحدة",
                    paginate: {
                        previous: "السابق",
                        next: "التالي"
                    },
                    buttons: {
                        copy: "نسخ",
                        excel: "تصدير إكسل",
                        print: "طباعة"
                    }
                }
            });
        });
    </script>
}
