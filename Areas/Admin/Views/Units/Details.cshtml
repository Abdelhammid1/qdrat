@model QdratNew.ViewModels.UnitViewModel

@{
    ViewData["Title"] = "📖 تفاصيل الوحدة التعليمية";
}

<div class="container mt-4">
    <h2 class="text-info fw-bold mb-4"><i class="fas fa-info-circle"></i> تفاصيل الوحدة</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title text-primary">@Model.Title</h5>
            <p class="card-text"><strong>معرف الوحدة:</strong> @Model.Id</p>
            @* لا نعرض اسم المحور نهائيًا هنا *@
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-edit"></i> تعديل</a>
        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> رجوع</a>
    </div>
</div>
