@model QdratNew.ViewModels.UnitViewModel

@{
    ViewData["Title"] = "🗑️ حذف الوحدة التعليمية";
}

<div class="container mt-4">
    <h2 class="text-danger fw-bold mb-4"><i class="fas fa-trash-alt"></i> تأكيد حذف الوحدة</h2>

    <div class="card border-danger shadow-sm">
        <div class="card-body">
            <h5 class="card-title text-danger">@Model.Title</h5>
            <p class="card-text"><strong>معرف الوحدة:</strong> @Model.Id</p>
            @* لا نعرض اسم المحور نهائيًا هنا *@
        </div>
    </div>

    <form asp-action="DeleteConfirmed" method="post" class="d-flex justify-content-end gap-2 mt-4">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> تأكيد الحذف</button>
        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> رجوع</a>
    </form>
</div>
