@model QdratNew.Areas.Admin.ViewModels.AdminNotificationsIndexViewModel
@{
    ViewData["Title"] = "الإشعارات";

    string readStatusText(bool? value)
    {
        if (!value.HasValue)
        {
            return "كل الحالات";
        }

        return value.Value ? "المقروءة" : "غير المقروءة";
    }

    string categoryBadgeClass(QdratNew.Enums.NotificationCategory category)
    {
        return category switch
        {
            QdratNew.Enums.NotificationCategory.Homework => "notif-badge homework",
            QdratNew.Enums.NotificationCategory.Exam => "notif-badge exam",
            QdratNew.Enums.NotificationCategory.Remedial => "notif-badge remedial",
            QdratNew.Enums.NotificationCategory.Important => "notif-badge important",
            QdratNew.Enums.NotificationCategory.Reminder => "notif-badge reminder",
            _ => "notif-badge general"
        };
    }
}

<style>
    .notifications-page {
        direction: rtl;
        color: #111827;
    }

    .notifications-hero {
        background: linear-gradient(135deg, #0f766e, #164e63);
        color: #fff;
        border-radius: 8px;
        padding: 22px;
        margin-bottom: 18px;
    }

    .notifications-hero h1 {
        font-size: 1.45rem;
        font-weight: 800;
        margin: 0;
    }

    .notifications-hero p {
        color: rgba(255, 255, 255, .82);
        margin: 6px 0 0;
    }

    .notif-summary {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 16px;
    }

    .notif-stat,
    .notif-filter,
    .notif-list-wrap {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .06);
    }

    .notif-stat {
        padding: 14px;
    }

    .notif-stat span {
        display: block;
        color: #64748b;
        font-size: .82rem;
        margin-bottom: 4px;
    }

    .notif-stat strong {
        display: block;
        color: #0f172a;
        font-size: 1.35rem;
        line-height: 1.2;
    }

    .notif-filter {
        padding: 14px;
        margin-bottom: 16px;
    }

    .notif-filter label {
        color: #475569;
        font-size: .82rem;
        font-weight: 700;
    }

    .notif-list-wrap {
        overflow: hidden;
    }

    .notif-list-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 16px;
        border-bottom: 1px solid #e5e7eb;
        background: #f8fafc;
    }

    .notif-list-head h2 {
        font-size: 1rem;
        font-weight: 800;
        margin: 0;
    }

    .notif-item {
        display: grid;
        grid-template-columns: 44px minmax(0, 1fr) auto;
        gap: 12px;
        padding: 14px 16px;
        border-bottom: 1px solid #edf2f7;
        align-items: start;
    }

    .notif-item:last-child {
        border-bottom: 0;
    }

    .notif-item.unread {
        background: #f0fdfa;
    }

    .notif-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #e0f2fe;
        color: #0369a1;
    }

    .notif-message {
        font-weight: 700;
        color: #111827;
        overflow-wrap: anywhere;
    }

    .notif-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 8px;
        color: #64748b;
        font-size: .82rem;
    }

    .notif-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 24px;
        padding: 3px 9px;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 800;
    }

    .notif-badge.general { background: #f1f5f9; color: #334155; }
    .notif-badge.homework { background: #ecfdf5; color: #047857; }
    .notif-badge.exam { background: #eff6ff; color: #1d4ed8; }
    .notif-badge.remedial { background: #fff7ed; color: #c2410c; }
    .notif-badge.important { background: #fef2f2; color: #b91c1c; }
    .notif-badge.reminder { background: #fefce8; color: #a16207; }

    .notif-actions {
        display: flex;
        gap: 8px;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
    }

    .notif-empty {
        padding: 42px 18px;
        text-align: center;
        color: #64748b;
    }

    .notif-empty i {
        font-size: 2rem;
        color: #94a3b8;
        margin-bottom: 10px;
    }

    @@media (max-width: 992px) {
        .notif-summary {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .notif-summary {
            grid-template-columns: 1fr;
        }

        .notif-item {
            grid-template-columns: 38px minmax(0, 1fr);
        }

        .notif-actions {
            grid-column: 1 / -1;
            justify-content: stretch;
        }

        .notif-actions .btn,
        .notif-actions form {
            width: 100%;
        }
    }
</style>

<div class="notifications-page">
    <section class="notifications-hero">
        <h1>الإشعارات</h1>
        <p>متابعة إشعارات النظام المرتبطة بأيقونة الهيدر داخل لوحة الإدارة.</p>
    </section>

    <section class="notif-summary" aria-label="ملخص الإشعارات">
        <div class="notif-stat">
            <span>إجمالي الإشعارات</span>
            <strong>@Model.TotalCount</strong>
        </div>
        <div class="notif-stat">
            <span>غير مقروءة</span>
            <strong>@Model.UnreadCount</strong>
        </div>
        <div class="notif-stat">
            <span>غير مقروءة اليوم</span>
            <strong>@Model.TodayUnreadCount</strong>
        </div>
        <div class="notif-stat">
            <span>مقروءة</span>
            <strong>@Model.ReadCount</strong>
        </div>
    </section>

    <section class="notif-filter">
        <form method="get" asp-area="Admin" asp-controller="Notifications" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-lg-4 col-md-6">
                <label class="form-label" for="category">التصنيف</label>
                <select class="form-select" id="category" name="category">
                    <option value="All" selected="@(Model.SelectedCategory == "All")">كل التصنيفات</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Value" selected="@(Model.SelectedCategory == category.Value)">
                            @category.Text
                        </option>
                    }
                </select>
            </div>

            <div class="col-lg-4 col-md-6">
                <label class="form-label" for="isRead">حالة القراءة</label>
                <select class="form-select" id="isRead" name="isRead">
                    <option value="" selected="@(!Model.IsReadFilter.HasValue)">كل الحالات</option>
                    <option value="false" selected="@(Model.IsReadFilter == false)">غير مقروءة</option>
                    <option value="true" selected="@(Model.IsReadFilter == true)">مقروءة</option>
                </select>
            </div>

            <div class="col-lg-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="fas fa-filter"></i>
                    تطبيق
                </button>
                <a asp-area="Admin" asp-controller="Notifications" asp-action="Index" class="btn btn-outline-secondary flex-fill">
                    <i class="fas fa-rotate-left"></i>
                    إعادة ضبط
                </a>
            </div>
        </form>
    </section>

    <section class="notif-list-wrap">
        <div class="notif-list-head">
            <h2>القائمة الحالية: @readStatusText(Model.IsReadFilter)</h2>
            <form method="post" asp-area="Admin" asp-controller="Notifications" asp-action="DeleteOldNotifications">
                <button type="submit" class="btn btn-sm btn-outline-danger">
                    <i class="fas fa-trash-alt"></i>
                    حذف الأقدم من 60 يومًا
                </button>
            </form>
        </div>

        @if (Model.Notifications.Count == 0)
        {
            <div class="notif-empty">
                <i class="fas fa-bell-slash d-block"></i>
                <div class="fw-bold mb-1">لا توجد إشعارات مطابقة</div>
                <div>غيّر الفلاتر أو عد لاحقًا عند وصول إشعارات جديدة.</div>
            </div>
        }
        else
        {
            foreach (var notification in Model.Notifications)
            {
                <article class="notif-item @(notification.IsRead ? string.Empty : "unread")">
                    <div class="notif-icon">
                        <i class="fas @(notification.IsRead ? "fa-envelope-open" : "fa-bell")"></i>
                    </div>

                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                            <span class="@categoryBadgeClass(notification.Category)">
                                @notification.CategoryName
                            </span>
                            @if (!notification.IsRead)
                            {
                                <span class="badge bg-danger">جديد</span>
                            }
                        </div>

                        <div class="notif-message">@notification.Message</div>
                        <div class="notif-meta">
                            <span><i class="far fa-clock"></i> @notification.SentAt.ToString("yyyy/MM/dd HH:mm")</span>
                            <span><i class="fas fa-user"></i> @notification.RecipientType: @notification.RecipientName</span>
                        </div>
                    </div>

                    <div class="notif-actions">
                        @if (!string.IsNullOrWhiteSpace(notification.TargetUrl))
                        {
                            <a href="@notification.TargetUrl" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-arrow-up-right-from-square"></i>
                                فتح
                            </a>
                        }

                        @if (!notification.IsRead)
                        {
                            <form method="post" asp-area="Admin" asp-controller="Notifications" asp-action="MarkAsRead">
                                <input type="hidden" name="notificationId" value="@notification.NotificationId" />
                                <button type="submit" class="btn btn-sm btn-success">
                                    <i class="fas fa-check"></i>
                                    مقروء
                                </button>
                            </form>
                        }
                    </div>
                </article>
            }
        }
    </section>
</div>
