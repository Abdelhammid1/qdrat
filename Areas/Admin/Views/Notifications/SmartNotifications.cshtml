@model QdratNew.Areas.Admin.ViewModels.SmartNotificationViewModel
@{
    ViewData["Title"] = "إشعارات ذكية";
}

<h2 class="text-white">إرسال إشعارات ذكية</h2>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card bg-dark text-white mb-3">
            <div class="card-body">
                <h5 class="card-title text-info"><i class="fas fa-bell"></i> طلاب لم يحلوا آخر واجب</h5>
                <p class="card-text">عدد الطلاب: @Model.StudentsWithUnsolvedLastHomework</p>
                <form method="post" asp-action="SendUnsolvedHomeworkAlert">
                    <button type="submit" class="btn btn-outline-warning">إرسال إشعار</button>
                </form>
            </div>
        </div>

        <div class="card bg-dark text-white mb-3">
            <div class="card-body">
                <h5 class="card-title text-info"><i class="fas fa-exclamation-circle"></i> تأخر عن واجبين</h5>
                <p class="card-text">عدد الطلاب: @Model.StudentsLateTwoHomeworks</p>
                <form method="post" asp-action="SendLateHomeworkAlert">
                    <button type="submit" class="btn btn-outline-danger">إرسال إشعار تحذيري</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card bg-dark text-white mb-3">
            <div class="card-body">
                <h5 class="card-title text-info"><i class="fas fa-user-clock"></i> لم يحلوا أي واجب هذا الأسبوع</h5>
                <p class="card-text">عدد الطلاب: @Model.StudentsDidNotSolveThisWeek</p>
                <form method="post" asp-action="SendNoHomeworkThisWeek">
                    <button type="submit" class="btn btn-outline-warning">إرسال إشعار تحفيزي</button>
                </form>
            </div>
        </div>

        <div class="card bg-dark text-white mb-3">
            <div class="card-body">
                <h5 class="card-title text-info"><i class="fas fa-briefcase-medical"></i> لم يبدأوا الخطة العلاجية</h5>
                <p class="card-text">عدد الطلاب: @Model.StudentsDidNotStartRemedialPlan</p>
                <form method="post" asp-action="SendRemedialPlanReminder">
                    <button type="submit" class="btn btn-outline-info">تذكير بالخطة</button>
                </form>
            </div>
        </div>
    </div>
</div>
