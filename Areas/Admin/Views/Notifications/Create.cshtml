@model QdratNew.ViewModels.Admin.Notifications.CreateNotificationViewModel
@using QdratNew.Enums
@{
    ViewData["Title"] = "إنشاء إشعار جديد";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .create-notif-page {
        direction: rtl;
        color: #111827;
    }

    .create-notif-hero {
        background: linear-gradient(135deg, #0f766e, #164e63);
        color: #fff;
        border-radius: 10px;
        padding: 22px 28px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .create-notif-hero h1 {
        font-size: 1.4rem;
        font-weight: 800;
        margin: 0 0 4px 0;
    }

    .create-notif-hero p {
        margin: 0;
        color: rgba(255,255,255,.8);
        font-size: .9rem;
    }

    .section-card {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #e5e7eb;
        padding: 24px;
        margin-bottom: 20px;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
    }

    .section-card h3 {
        font-size: 1rem;
        font-weight: 700;
        color: #0f766e;
        margin: 0 0 18px 0;
        padding-bottom: 10px;
        border-bottom: 2px solid #f0fdf4;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* Target type tabs */
    .target-tabs {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 0;
    }

    .target-tab-btn {
        flex: 1;
        min-width: 140px;
        padding: 14px 20px;
        border: 2px solid #e5e7eb;
        border-radius: 10px;
        background: #f9fafb;
        cursor: pointer;
        text-align: center;
        transition: all .2s;
        position: relative;
    }

    .target-tab-btn:hover {
        border-color: #0f766e;
        background: #f0fdf4;
    }

    .target-tab-btn.active {
        border-color: #0f766e;
        background: linear-gradient(135deg, #f0fdf4, #ecfdf5);
        box-shadow: 0 2px 8px rgba(15,118,110,.15);
    }

    .target-tab-btn .tab-icon {
        font-size: 1.8rem;
        display: block;
        margin-bottom: 6px;
    }

    .target-tab-btn .tab-title {
        font-weight: 700;
        font-size: .95rem;
        color: #374151;
        display: block;
    }

    .target-tab-btn .tab-desc {
        font-size: .78rem;
        color: #6b7280;
        display: block;
        margin-top: 2px;
    }

    .target-tab-btn.active .tab-title {
        color: #0f766e;
    }

    .target-tab-btn input[type=radio] {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
    }

    /* Checkbox panels */
    .recipients-panel {
        display: none;
    }

    .recipients-panel.visible {
        display: block;
    }

    .recipients-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
    }

    .recipients-header span {
        font-size: .88rem;
        color: #6b7280;
    }

    .select-all-btn {
        font-size: .8rem;
        padding: 4px 12px;
        border-radius: 6px;
        border: 1px solid #0f766e;
        color: #0f766e;
        background: transparent;
        cursor: pointer;
        transition: all .15s;
    }

    .select-all-btn:hover {
        background: #0f766e;
        color: #fff;
    }

    .checkbox-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 10px;
        max-height: 380px;
        overflow-y: auto;
        padding: 4px 2px;
    }

    .checkbox-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        cursor: pointer;
        transition: all .15s;
        background: #fafafa;
    }

    .checkbox-item:hover {
        border-color: #0f766e;
        background: #f0fdf4;
    }

    .checkbox-item input[type=checkbox]:checked + .item-info {
        color: #0f766e;
    }

    .checkbox-item input[type=checkbox] {
        accent-color: #0f766e;
        width: 16px;
        height: 16px;
        flex-shrink: 0;
    }

    .item-info .item-name {
        font-weight: 600;
        font-size: .88rem;
        display: block;
        color: #1f2937;
    }

    .item-info .item-sub {
        font-size: .75rem;
        color: #9ca3af;
        display: block;
    }

    /* Batch section */
    .batch-section {
        margin-bottom: 18px;
    }

    .batch-section label {
        font-weight: 600;
        font-size: .88rem;
        color: #374151;
        display: block;
        margin-bottom: 6px;
    }

    .form-select-styled {
        width: 100%;
        max-width: 400px;
        padding: 9px 14px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-size: .9rem;
        background: #fff;
        color: #374151;
    }

    .form-select-styled:focus {
        outline: none;
        border-color: #0f766e;
        box-shadow: 0 0 0 3px rgba(15,118,110,.1);
    }

    /* Loading spinner */
    .students-loading {
        display: none;
        text-align: center;
        padding: 20px;
        color: #6b7280;
        font-size: .88rem;
    }

    .empty-students {
        text-align: center;
        padding: 30px;
        color: #9ca3af;
        font-size: .9rem;
        display: none;
    }

    /* Message section */
    .form-textarea {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-size: .9rem;
        resize: vertical;
        min-height: 100px;
        font-family: inherit;
        direction: rtl;
    }

    .form-textarea:focus {
        outline: none;
        border-color: #0f766e;
        box-shadow: 0 0 0 3px rgba(15,118,110,.1);
    }

    .form-label {
        font-weight: 600;
        font-size: .88rem;
        color: #374151;
        display: block;
        margin-bottom: 6px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    @@media (max-width: 600px) {
        .form-row { grid-template-columns: 1fr; }
    }

    .meeting-time-section {
        display: none;
    }

    .meeting-time-section.visible {
        display: block;
    }

    .form-input {
        width: 100%;
        padding: 9px 14px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-size: .9rem;
        color: #374151;
    }

    .form-input:focus {
        outline: none;
        border-color: #0f766e;
        box-shadow: 0 0 0 3px rgba(15,118,110,.1);
    }

    .meeting-toggle {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
        cursor: pointer;
        font-size: .9rem;
        color: #374151;
        font-weight: 500;
    }

    .meeting-toggle input[type=checkbox] {
        accent-color: #0f766e;
        width: 16px;
        height: 16px;
    }

    /* Submit */
    .submit-section {
        display: flex;
        align-items: center;
        gap: 14px;
        padding-top: 4px;
    }

    .btn-submit {
        padding: 12px 32px;
        background: linear-gradient(135deg, #0f766e, #0d9488);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-weight: 700;
        font-size: .95rem;
        cursor: pointer;
        transition: all .2s;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-submit:hover {
        background: linear-gradient(135deg, #0d6e66, #0c8277);
        box-shadow: 0 4px 14px rgba(15,118,110,.35);
    }

    .btn-cancel {
        padding: 11px 24px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        background: #fff;
        color: #6b7280;
        font-size: .9rem;
        cursor: pointer;
        text-decoration: none;
        transition: all .15s;
    }

    .btn-cancel:hover {
        border-color: #9ca3af;
        color: #374151;
    }

    /* Count badge */
    .selected-count {
        display: inline-block;
        background: #0f766e;
        color: #fff;
        border-radius: 99px;
        padding: 2px 10px;
        font-size: .78rem;
        font-weight: 700;
        margin-right: 8px;
        min-width: 24px;
        text-align: center;
    }

    .validation-error {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 18px;
        color: #dc2626;
        font-size: .88rem;
    }

    .field-error {
        color: #dc2626;
        font-size: .8rem;
        margin-top: 4px;
        display: block;
    }

    /* Scrollbar */
    .checkbox-grid::-webkit-scrollbar { width: 6px; }
    .checkbox-grid::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 3px; }
    .checkbox-grid::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
</style>

<div class="create-notif-page">

    <div class="create-notif-hero">
        <div>
            <h1>📣 إنشاء إشعار جديد</h1>
            <p>أرسل إشعارات مخصصة للإداريين أو الطلاب أو المدربين</p>
        </div>
        <a asp-action="Index" class="btn-cancel" style="color:#339999; border-color:rgba(255,255,255,.4);">
            ← العودة للقائمة
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        <div class="validation-error">
            <strong>⚠️ يوجد أخطاء:</strong>
            <ul style="margin:6px 0 0 0; padding-right:18px;">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background:#f0fdf4; border:1px solid #86efac; border-radius:8px; padding:12px 16px; margin-bottom:18px; color:#15803d; font-size:.88rem;">
            ✅ @TempData["SuccessMessage"]
        </div>
    }

    <form asp-action="Create" method="post" id="createNotifForm">
        @Html.AntiForgeryToken()

        <!-- ── 1. اختيار نوع المستلم ── -->
        <div class="section-card">
            <h3>🎯 المستلمون</h3>

            <div class="target-tabs" id="targetTabs">
                <label class="target-tab-btn @(Model.TargetType == "Admins" ? "active" : "")" onclick="switchTarget('Admins')">
                    <input type="radio" name="TargetType" value="Admins" @(Model.TargetType == "Admins" ? "checked" : "") />
                    <span class="tab-icon">🛡️</span>
                    <span class="tab-title">الإداريون</span>
                    <span class="tab-desc">أعضاء فريق الإدارة</span>
                </label>

                <label class="target-tab-btn @(Model.TargetType == "Students" || Model.TargetType == "" ? "active" : "")" onclick="switchTarget('Students')">
                    <input type="radio" name="TargetType" value="Students" @(Model.TargetType == "Students" || Model.TargetType == "" ? "checked" : "") />
                    <span class="tab-icon">🎓</span>
                    <span class="tab-title">الطلاب</span>
                    <span class="tab-desc">اختر دفعة ثم الطلاب</span>
                </label>

                <label class="target-tab-btn @(Model.TargetType == "Instructors" ? "active" : "")" onclick="switchTarget('Instructors')">
                    <input type="radio" name="TargetType" value="Instructors" @(Model.TargetType == "Instructors" ? "checked" : "") />
                    <span class="tab-icon">👨‍🏫</span>
                    <span class="tab-title">المدربون</span>
                    <span class="tab-desc">مدربو المنصة</span>
                </label>
            </div>
        </div>

        <!-- ── 2. قائمة الإداريين ── -->
        <div class="section-card recipients-panel @(Model.TargetType == "Admins" ? "visible" : "")" id="panel-Admins">
            <h3>🛡️ اختر الإداريين <span class="selected-count" id="count-Admins">0</span></h3>
            <div class="recipients-header">
                <span>@Model.AdminUsers.Count إداري متاح</span>
                <button type="button" class="select-all-btn" onclick="selectAll('admins-grid', 'count-Admins')">تحديد الكل</button>
            </div>
            @if (Model.AdminUsers.Any())
            {
                <div class="checkbox-grid" id="admins-grid">
                    @foreach (var admin in Model.AdminUsers)
                    {
                        <label class="checkbox-item">
                            <input type="checkbox" name="SelectedAdminUserIds" value="@admin.UserId"
                                   onchange="updateCount('admins-grid','count-Admins')"
                                   @(Model.SelectedAdminUserIds.Contains(admin.UserId) ? "checked" : "") />
                            <div class="item-info">
                                <span class="item-name">@admin.FullName</span>
                                <span class="item-sub">@admin.Email</span>
                            </div>
                        </label>
                    }
                </div>
            }
            else
            {
                <div style="text-align:center; padding:30px; color:#9ca3af;">
                    لا يوجد إداريون مسجلون حتى الآن
                </div>
            }
        </div>

        <!-- ── 3. قائمة الطلاب (دفعة ← طلاب) ── -->
        <div class="section-card recipients-panel @(Model.TargetType == "Students" || Model.TargetType == "" ? "visible" : "")" id="panel-Students">
            <h3>🎓 اختر الطلاب <span class="selected-count" id="count-Students">0</span></h3>

            <div class="batch-section">
                <label>اختر الدفعة أولاً:</label>
                <select id="batchSelect" class="form-select-styled" name="SelectedBatchId" onchange="loadStudents(this.value)">
                    <option value="">-- اختر دفعة --</option>
                    @foreach (var batch in Model.Batches)
                    {
                        if (Model.SelectedBatchId?.ToString() == batch.Value)
                        {
                            <option value="@batch.Value" selected="selected">@batch.Text</option>
                        }
                        else
                        {
                            <option value="@batch.Value">@batch.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="students-loading" id="studentsLoading">
                ⏳ جاري تحميل الطلاب...
            </div>

            <div class="empty-students" id="studentsEmpty">
                لا يوجد طلاب نشطون في هذه الدفعة
            </div>

            <div id="students-grid-wrapper" style="display:none;">
                <div class="recipients-header">
                    <span id="studentsCountLabel">0 طالب</span>
                    <button type="button" class="select-all-btn" onclick="selectAll('students-grid','count-Students')">تحديد الكل</button>
                </div>
                <div class="checkbox-grid" id="students-grid"></div>
            </div>
        </div>

        <!-- ── 4. قائمة المدربين ── -->
        <div class="section-card recipients-panel @(Model.TargetType == "Instructors" ? "visible" : "")" id="panel-Instructors">
            <h3>👨‍🏫 اختر المدربين <span class="selected-count" id="count-Instructors">0</span></h3>
            <div class="recipients-header">
                <span>@Model.Instructors.Count مدرب متاح</span>
                <button type="button" class="select-all-btn" onclick="selectAll('instructors-grid','count-Instructors')">تحديد الكل</button>
            </div>
            @if (Model.Instructors.Any())
            {
                <div class="checkbox-grid" id="instructors-grid">
                    @foreach (var inst in Model.Instructors)
                    {
                        <label class="checkbox-item">
                            <input type="checkbox" name="SelectedInstructorIds" value="@inst.InstructorId"
                                   onchange="updateCount('instructors-grid','count-Instructors')"
                                   @(Model.SelectedInstructorIds.Contains(inst.InstructorId) ? "checked" : "") />
                            <div class="item-info">
                                <span class="item-name">@inst.FullName</span>
                                <span class="item-sub">@inst.Specialization</span>
                            </div>
                        </label>
                    }
                </div>
            }
            else
            {
                <div style="text-align:center; padding:30px; color:#9ca3af;">
                    لا يوجد مدربون نشطون حتى الآن
                </div>
            }
        </div>

        <!-- ── 5. محتوى الرسالة ── -->
        <div class="section-card">
            <h3>✉️ محتوى الرسالة</h3>

            <div style="margin-bottom:18px;">
                <label class="form-label">نص الرسالة <span style="color:#dc2626">*</span></label>
                <textarea name="Message" class="form-textarea" placeholder="اكتب نص الرسالة هنا..." required>@Model.Message</textarea>
                <span asp-validation-for="Message" class="field-error"></span>
            </div>

            <div class="form-row">
                <div>
                    <label class="form-label">تصنيف الإشعار</label>
                    <select name="Category" class="form-select-styled" style="max-width:100%;">
                        @foreach (var cat in Model.Categories)
                        {
                            if (Model.Category.ToString() == cat.Value)
                            {
                                <option value="@cat.Value" selected="selected">@cat.Text</option>
                            }
                            else
                            {
                                <option value="@cat.Value">@cat.Text</option>
                            }
                        }
                    </select>
                </div>

                <div>
                    <label class="meeting-toggle">
                        <input type="checkbox" id="hasMeeting" onchange="toggleMeeting(this)"
                               @(Model.MeetingAt.HasValue ? "checked" : "") />
                        📅 إضافة موعد اجتماع
                    </label>
                    <div class="meeting-time-section @(Model.MeetingAt.HasValue ? "visible" : "")" id="meetingSection">
                        <input type="datetime-local" name="MeetingAt" id="meetingAtInput" class="form-input"
                               value="@(Model.MeetingAt?.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
                        <span style="font-size:.78rem; color:#6b7280; margin-top:4px; display:block;">
                            سيتم إرفاق موعد الاجتماع مع الرسالة
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── 6. إرسال ── -->
        <div class="section-card" style="padding:18px 24px;">
            <div class="submit-section">
                <button type="submit" class="btn-submit" id="submitBtn">
                    📤 إرسال الإشعار
                </button>
                <a asp-action="Index" class="btn-cancel">إلغاء</a>
                <span style="font-size:.82rem; color:#339999; margin-right:auto;" id="submitInfo">
                    سيتم إرسال الإشعار للمستلمين المحددين فور الضغط على "إرسال"
                </span>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // ── Switch target panel ──
        function switchTarget(type) {
            document.querySelectorAll('.recipients-panel').forEach(p => p.classList.remove('visible'));
            document.querySelectorAll('.target-tab-btn').forEach(b => b.classList.remove('active'));

            const panel = document.getElementById('panel-' + type);
            if (panel) panel.classList.add('visible');

            const tab = document.querySelector(`.target-tab-btn input[value="${type}"]`)?.closest('.target-tab-btn');
            if (tab) tab.classList.add('active');
        }

        // ── Select all checkboxes in a grid ──
        function selectAll(gridId, countId) {
            const grid = document.getElementById(gridId);
            if (!grid) return;
            const boxes = grid.querySelectorAll('input[type=checkbox]');
            const allChecked = [...boxes].every(b => b.checked);
            boxes.forEach(b => b.checked = !allChecked);
            updateCount(gridId, countId);
        }

        // ── Update selected count badge ──
        function updateCount(gridId, countId) {
            const grid = document.getElementById(gridId);
            const badge = document.getElementById(countId);
            if (!grid || !badge) return;
            const n = grid.querySelectorAll('input[type=checkbox]:checked').length;
            badge.textContent = n;
            badge.style.display = n === 0 ? 'none' : 'inline-block';
        }

        // ── Toggle meeting section ──
        function toggleMeeting(cb) {
            const section = document.getElementById('meetingSection');
            const input = document.getElementById('meetingAtInput');
            if (cb.checked) {
                section.classList.add('visible');
            } else {
                section.classList.remove('visible');
                input.value = '';
            }
        }

        // ── Load students by batch (AJAX) ──
        function loadStudents(batchId) {
            const wrapper = document.getElementById('students-grid-wrapper');
            const loading = document.getElementById('studentsLoading');
            const empty = document.getElementById('studentsEmpty');
            const grid = document.getElementById('students-grid');
            const label = document.getElementById('studentsCountLabel');

            // Reset
            wrapper.style.display = 'none';
            empty.style.display = 'none';
            grid.innerHTML = '';
            document.getElementById('count-Students').textContent = '0';

            if (!batchId) return;

            loading.style.display = 'block';

            fetch(`/Admin/Notifications/GetStudentsByBatch?batchId=${batchId}`)
                .then(r => r.json())
                .then(students => {
                    loading.style.display = 'none';

                    if (!students || students.length === 0) {
                        empty.style.display = 'block';
                        return;
                    }

                    label.textContent = students.length + ' طالب';
                    students.forEach(s => {
                        const lbl = document.createElement('label');
                        lbl.className = 'checkbox-item';
                        lbl.innerHTML = `
                            <input type="checkbox" name="SelectedStudentIds" value="${s.id}"
                                   onchange="updateCount('students-grid','count-Students')" />
                            <div class="item-info">
                                <span class="item-name">${s.name}</span>
                                <span class="item-sub">${s.nationalId ?? ''}</span>
                            </div>`;
                        grid.appendChild(lbl);
                    });

                    wrapper.style.display = 'block';
                })
                .catch(() => {
                    loading.style.display = 'none';
                    empty.textContent = '⚠️ حدث خطأ أثناء تحميل الطلاب';
                    empty.style.display = 'block';
                });
        }

        // ── Init on load ──
        document.addEventListener('DOMContentLoaded', () => {
            // Set initial counts
            updateCount('admins-grid', 'count-Admins');
            updateCount('instructors-grid', 'count-Instructors');

            // Hide zero-count badges initially
            ['count-Admins', 'count-Students', 'count-Instructors'].forEach(id => {
                const el = document.getElementById(id);
                if (el && el.textContent === '0') el.style.display = 'none';
            });

            // If batch was pre-selected (e.g. after validation failure), reload students
            const batchSelect = document.getElementById('batchSelect');
            if (batchSelect && batchSelect.value) {
                loadStudents(batchSelect.value);
            }
        });

        // ── Validate before submit ──
        document.getElementById('createNotifForm').addEventListener('submit', function (e) {
            const targetType = document.querySelector('input[name=TargetType]:checked')?.value;
            let hasRecipient = false;

            if (targetType === 'Admins') {
                hasRecipient = document.querySelectorAll('#admins-grid input[type=checkbox]:checked').length > 0;
            } else if (targetType === 'Students') {
                hasRecipient = document.querySelectorAll('#students-grid input[type=checkbox]:checked').length > 0;
            } else if (targetType === 'Instructors') {
                hasRecipient = document.querySelectorAll('#instructors-grid input[type=checkbox]:checked').length > 0;
            }

            if (!hasRecipient) {
                e.preventDefault();
                alert('⚠️ يجب اختيار مستلم واحد على الأقل قبل الإرسال');
            }

            const msg = document.querySelector('textarea[name=Message]').value.trim();
            if (!msg || msg.length < 5) {
                e.preventDefault();
                alert('⚠️ الرسالة يجب أن تكون 5 أحرف على الأقل');
            }
        });
    </script>
}
