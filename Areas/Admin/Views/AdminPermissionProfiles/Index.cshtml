@model List<QdratNew.Entities.AdminProfile>

@{
    ViewData["Title"] = "ملفات صلاحيات الأدمن";

    var totalProfiles = Model?.Count ?? 0;
    var systemProfiles = Model?.Count(x => x.IsSystemProfile) ?? 0;
    var customProfiles = Model?.Count(x => !x.IsSystemProfile) ?? 0;
}

<style>
    .profiles-page {
        direction: rtl;
    }

    .profiles-hero {
        background: linear-gradient(135deg, #111827, #1f2937);
        border-radius: 22px;
        color: #fff;
        padding: 24px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.18);
        position: relative;
        overflow: hidden;
    }

        .profiles-hero::before {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: rgba(255,255,255,0.07);
            top: -110px;
            left: -80px;
        }

        .profiles-hero .content {
            position: relative;
            z-index: 2;
        }

    .profile-stat {
        background: #fff;
        border: 1px solid #edf0f5;
        border-radius: 18px;
        padding: 16px;
        box-shadow: 0 8px 26px rgba(15, 23, 42, 0.06);
        height: 100%;
    }

        .profile-stat .label {
            color: #64748b;
            font-size: 13px;
            margin-bottom: 6px;
        }

        .profile-stat .value {
            font-weight: 800;
            font-size: 26px;
            color: #111827;
            line-height: 1;
        }

    .profiles-toolbar {
        background: #fff;
        border: 1px solid #edf0f5;
        border-radius: 18px;
        padding: 14px;
        box-shadow: 0 8px 26px rgba(15, 23, 42, 0.05);
    }

    .profile-card {
        background: #fff;
        border: 1px solid #e7ebf1;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
        overflow: hidden;
        transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
        height: 100%;
    }

        .profile-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 40px rgba(15, 23, 42, 0.09);
            border-color: #d7dee9;
        }

    .profile-card-header {
        padding: 18px;
        background: #f8fafc;
        border-bottom: 1px solid #eef2f7;
    }

    .profile-title {
        margin: 0;
        color: #111827;
        font-weight: 800;
        font-size: 18px;
    }

    .profile-description {
        color: #64748b;
        font-size: 13px;
        line-height: 1.7;
        min-height: 44px;
    }

    .profile-card-body {
        padding: 18px;
    }

    .profile-actions {
        border-top: 1px solid #eef2f7;
        padding: 14px 18px;
        background: #fff;
    }

    .soft-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 6px 10px;
        font-size: 12px;
        font-weight: 700;
    }

    .soft-badge-blue {
        background: #eff6ff;
        color: #1d4ed8;
    }

    .soft-badge-green {
        background: #ecfdf5;
        color: #047857;
    }

    .soft-badge-gray {
        background: #f1f5f9;
        color: #475569;
    }

    .soft-badge-purple {
        background: #f5f3ff;
        color: #6d28d9;
    }

    .empty-state {
        background: #fff;
        border: 1px dashed #cbd5e1;
        border-radius: 22px;
        padding: 36px;
        text-align: center;
        color: #64748b;
    }

    .hidden-by-filter {
        display: none !important;
    }

    @@media (max-width: 768px) {
        .profiles-hero {
            padding: 18px;
        }

        .profile-card-header,
        .profile-card-body,
        .profile-actions {
            padding: 14px;
        }
    }
</style>

<div class="container-fluid mt-4 profiles-page">

    <div class="profiles-hero mb-4">
        <div class="content d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="soft-badge soft-badge-blue mb-2">
                    <i class="fas fa-user-shield"></i>
                    إدارة بروفايلات الصلاحيات
                </div>

                <h3 class="mb-2 fw-bold">ملفات صلاحيات الأدمن</h3>

                <div class="text-white-50">
                    إدارة بروفايلات الصلاحيات وتحديد ما يمكن لكل بروفايل الوصول إليه داخل لوحة الإدارة.
                </div>
            </div>

            <div>
                <a asp-area="Admin"
                   asp-controller="AdminPermissionProfiles"
                   asp-action="Create"
                   class="btn btn-success px-4">
                    <i class="fas fa-plus ms-1"></i>
                    بروفايل جديد
                </a>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-4 col-md-6">
            <div class="profile-stat">
                <div class="label">إجمالي البروفايلات</div>
                <div class="value">@totalProfiles</div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="profile-stat">
                <div class="label">بروفايلات النظام</div>
                <div class="value">@systemProfiles</div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="profile-stat">
                <div class="label">بروفايلات مخصصة</div>
                <div class="value">@customProfiles</div>
            </div>
        </div>
    </div>

    <div class="profiles-toolbar mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-lg-6">
                <label class="form-label fw-bold">بحث داخل البروفايلات</label>
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="fas fa-search"></i>
                    </span>
                    <input type="text"
                           id="profileSearch"
                           class="form-control"
                           placeholder="اكتب اسم البروفايل أو الوصف..." />
                </div>
            </div>

            <div class="col-lg-4">
                <label class="form-label fw-bold">فلترة النوع</label>
                <select id="profileTypeFilter" class="form-select">
                    <option value="all">عرض الكل</option>
                    <option value="system">System فقط</option>
                    <option value="custom">Custom فقط</option>
                </select>
            </div>

            <div class="col-lg-2">
                <button type="button" id="clearProfileFilters" class="btn btn-outline-secondary w-100">
                    <i class="fas fa-undo ms-1"></i>
                    تصفير
                </button>
            </div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4" id="profilesCards">
            @foreach (var p in Model)
            {
                var profileType = p.IsSystemProfile ? "system" : "custom";
                var description = string.IsNullOrWhiteSpace(p.Description) ? "لا يوجد وصف لهذا البروفايل." : p.Description;

                <div class="col-xl-4 col-lg-6 col-md-6 profile-wrapper"
                     data-name="@p.Name"
                     data-description="@description"
                     data-type="@profileType">

                    <div class="profile-card">

                        <div class="profile-card-header">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <h5 class="profile-title">@p.Name</h5>

                                    <div class="mt-2">
                                        @if (p.IsSystemProfile)
                                        {
                                            <span class="soft-badge soft-badge-gray">
                                                <i class="fas fa-lock"></i>
                                                System
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="soft-badge soft-badge-green">
                                                <i class="fas fa-user-cog"></i>
                                                Custom
                                            </span>
                                        }
                                    </div>
                                </div>

                                <span class="soft-badge soft-badge-purple">
                                    #@p.Id
                                </span>
                            </div>
                        </div>

                        <div class="profile-card-body">
                            <div class="profile-description">
                                @description
                            </div>
                        </div>

                        <div class="profile-actions">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

                                <a asp-area="Admin"
                                   asp-controller="AdminPermissionProfiles"
                                   asp-action="Matrix"
                                   asp-route-id="@p.Id"
                                   class="btn btn-outline-primary btn-sm px-3">
                                    <i class="fas fa-shield-alt ms-1"></i>
                                    الصلاحيات
                                </a>

                                @if (!p.IsSystemProfile)
                                {
                                    <a asp-area="Admin"
                                       asp-controller="AdminPermissionProfiles"
                                       asp-action="Edit"
                                       asp-route-id="@p.Id"
                                       class="btn btn-outline-secondary btn-sm px-3">
                                        <i class="fas fa-edit ms-1"></i>
                                        تعديل
                                    </a>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-light btn-sm px-3"
                                            disabled>
                                        <i class="fas fa-lock ms-1"></i>
                                        محمي
                                    </button>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="mb-3">
                <i class="fas fa-user-shield fa-3x text-muted"></i>
            </div>

            <h5 class="fw-bold text-dark">لا توجد بروفايلات صلاحيات حتى الآن</h5>

            <p class="mb-3">
                ابدأ بإنشاء بروفايل جديد ثم قم بضبط الصلاحيات من شاشة الماتريكس.
            </p>

            <a asp-area="Admin"
               asp-controller="AdminPermissionProfiles"
               asp-action="Create"
               class="btn btn-primary px-4">
                <i class="fas fa-plus ms-1"></i>
                إنشاء بروفايل جديد
            </a>
        </div>
    }

</div>

@section Scripts {
    <script>
        function applyProfileFilters() {
            var searchInput = document.getElementById('profileSearch');
            var typeFilter = document.getElementById('profileTypeFilter');

            var searchValue = searchInput ? searchInput.value.trim().toLowerCase() : '';
            var selectedType = typeFilter ? typeFilter.value : 'all';

            document.querySelectorAll('.profile-wrapper').forEach(function (item) {
                var name = (item.getAttribute('data-name') || '').toLowerCase();
                var description = (item.getAttribute('data-description') || '').toLowerCase();
                var type = item.getAttribute('data-type') || '';

                var matchesSearch =
                    !searchValue ||
                    name.includes(searchValue) ||
                    description.includes(searchValue);

                var matchesType =
                    selectedType === 'all' ||
                    selectedType === type;

                if (matchesSearch && matchesType) {
                    item.classList.remove('hidden-by-filter');
                } else {
                    item.classList.add('hidden-by-filter');
                }
            });
        }

        document.addEventListener('input', function (e) {
            if (e.target && e.target.id === 'profileSearch') {
                applyProfileFilters();
            }
        });

        document.addEventListener('change', function (e) {
            if (e.target && e.target.id === 'profileTypeFilter') {
                applyProfileFilters();
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            var clearButton = document.getElementById('clearProfileFilters');

            if (clearButton) {
                clearButton.addEventListener('click', function () {
                    var searchInput = document.getElementById('profileSearch');
                    var typeFilter = document.getElementById('profileTypeFilter');

                    if (searchInput) {
                        searchInput.value = '';
                    }

                    if (typeFilter) {
                        typeFilter.value = 'all';
                    }

                    applyProfileFilters();
                });
            }

            applyProfileFilters();
        });
    </script>
}