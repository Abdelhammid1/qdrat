@model QdratNew.ViewModels.Admin.AdminProfileMatrixVM
@using QdratNew.Enums
@using QdratNew.ViewModels.Admin

@{
    ViewData["Title"] = "إدارة صلاحيات البروفايل";

    var totalControllers = Model.Controllers?.Count ?? 0;
    var customControllers = Model.Controllers?.Count(x => x.HasCustom) ?? 0;
    var readControllers = Model.Controllers?.Count(x => x.AccessLevel == AdminControllerAccessLevel.Read) ?? 0;
    var readWriteControllers = Model.Controllers?.Count(x => x.AccessLevel == AdminControllerAccessLevel.ReadWrite) ?? 0;
}

<style>
    .permission-page {
        direction: rtl;
        background: #f6f8fb;
        min-height: calc(100vh - 120px);
        padding-bottom: 32px;
    }

    .permission-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 48%, #0f766e 100%);
        border-radius: 26px;
        color: #fff;
        padding: 28px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.18);
        position: relative;
        overflow: hidden;
    }

        .permission-hero::before {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            border-radius: 999px;
            background: rgba(255,255,255,0.08);
            top: -125px;
            left: -90px;
        }

        .permission-hero::after {
            content: "";
            position: absolute;
            width: 190px;
            height: 190px;
            border-radius: 999px;
            background: rgba(20,184,166,0.18);
            bottom: -95px;
            right: 12%;
        }

        .permission-hero .content {
            position: relative;
            z-index: 2;
        }

    .permission-stat {
        background: #fff;
        border: 1px solid #edf0f5;
        border-radius: 20px;
        padding: 18px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
        height: 100%;
        position: relative;
        overflow: hidden;
    }

        .permission-stat::after {
            content: "";
            position: absolute;
            width: 72px;
            height: 72px;
            border-radius: 999px;
            background: #f1f5f9;
            left: -26px;
            top: -26px;
        }

        .permission-stat .label {
            color: #64748b;
            font-size: 13px;
            margin-bottom: 8px;
            position: relative;
            z-index: 2;
        }

        .permission-stat .value {
            font-weight: 900;
            font-size: 30px;
            color: #111827;
            line-height: 1;
            position: relative;
            z-index: 2;
        }

    .permission-toolbar {
        background: #fff;
        border: 1px solid #edf0f5;
        border-radius: 22px;
        padding: 18px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
    }

        .permission-toolbar .form-label {
            color: #1f2937;
        }

        .permission-toolbar .form-control,
        .permission-toolbar .form-select,
        .permission-toolbar .input-group-text {
            border-color: #dbe3ee;
            border-radius: 14px;
            min-height: 44px;
        }

        .permission-toolbar .input-group .form-control {
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
        }

        .permission-toolbar .input-group .input-group-text {
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
        }

    .permission-card {
        background: #fff;
        border: 1px solid #e7ebf1;
        border-radius: 22px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
        overflow: hidden;
        transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
    }

        .permission-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 42px rgba(15, 23, 42, 0.09);
            border-color: #d7dee9;
        }

    .permission-card-header {
        padding: 17px 20px;
        border-bottom: 1px solid #eef2f7;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    }

    .permission-card-title {
        font-weight: 900;
        color: #111827;
        margin: 0;
        font-size: 18px;
    }

    .permission-card-key {
        color: #64748b;
        font-size: 12px;
        margin-top: 5px;
        direction: ltr;
        text-align: right;
        word-break: break-word;
    }

    .permission-card-body {
        padding: 20px;
    }

    .access-box,
    .custom-box,
    .actions-panel {
        border: 1px solid #edf0f5;
        border-radius: 18px;
        padding: 14px;
        background: #fbfdff;
    }

    .actions-panel {
        background: #fff;
    }

    .access-level-select {
        border-radius: 14px;
        border-color: #dbe3ee;
        min-height: 44px;
    }

    .custom-toggle {
        cursor: pointer;
    }

    .actions-container {
        transition: opacity .15s ease;
    }

    .action-chip {
        border: 1px solid #e5e7eb;
        background: #fff;
        border-radius: 16px;
        padding: 10px 12px;
        min-height: 50px;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: background .15s ease, border-color .15s ease, box-shadow .15s ease;
    }

        .action-chip:hover {
            border-color: #cbd5e1;
            box-shadow: 0 8px 18px rgba(15, 23, 42, .05);
        }

        .action-chip:has(input:checked) {
            background: #ecfdf5;
            border-color: #86efac;
        }

        .action-chip label {
            cursor: pointer;
            font-size: 13px;
            color: #1f2937;
            line-height: 1.5;
            margin: 0;
        }

    .soft-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 7px 11px;
        font-size: 12px;
        font-weight: 800;
        white-space: nowrap;
    }

    .soft-badge-blue {
        background: rgba(239, 246, 255, .15);
        color: #fff;
        border: 1px solid rgba(255,255,255,.18);
    }

    .soft-badge-green {
        background: #ecfdf5;
        color: #047857;
    }

    .soft-badge-gray {
        background: #f1f5f9;
        color: #475569;
    }

    .sticky-save-bar {
        position: sticky;
        bottom: 12px;
        z-index: 20;
        background: rgba(255,255,255,.94);
        backdrop-filter: blur(10px);
        border: 1px solid #edf0f5;
        border-radius: 20px;
        padding: 16px;
        box-shadow: 0 -10px 30px rgba(15, 23, 42, 0.08);
    }

    .muted-help {
        color: #64748b;
        font-size: 12px;
        line-height: 1.7;
    }

    .hidden-by-filter {
        display: none !important;
    }

    .btn {
        border-radius: 14px;
        font-weight: 800;
    }

    @@media (max-width: 768px) {
        .permission-hero {
            padding: 20px;
            border-radius: 20px;
        }

        .permission-card-body {
            padding: 15px;
        }

        .sticky-save-bar {
            bottom: 8px;
            border-radius: 16px;
        }
    }
</style>

<div class="container-fluid mt-4 permission-page">

    <form asp-action="SaveMatrix" method="post" id="matrixForm">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="ProfileId" />
        <input type="hidden" asp-for="ProfileName" />
        <input type="hidden" asp-for="Description" />

        <div class="permission-hero mb-4">
            <div class="content d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <div class="soft-badge soft-badge-blue mb-2">
                        <i class="fas fa-shield-alt"></i>
                        إدارة الصلاحيات
                    </div>

                    <h3 class="mb-2 fw-bold">ماتريكس صلاحيات البروفايل</h3>

                    <div class="text-white-50">
                        @Model.ProfileName
                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <span> - @Model.Description</span>
                        }
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Index" class="btn btn-outline-light">
                        <i class="fas fa-arrow-right ms-1"></i>
                        رجوع
                    </a>

                    <button type="submit" class="btn btn-success px-4">
                        <i class="fas fa-save ms-1"></i>
                        حفظ الصلاحيات
                    </button>
                </div>
            </div>
        </div>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success border-0 shadow-sm rounded-4">
                @TempData["Message"]
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success border-0 shadow-sm rounded-4">
                @TempData["Success"]
            </div>
        }

        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6">
                <div class="permission-stat">
                    <div class="label">إجمالي الوحدات</div>
                    <div class="value">@totalControllers</div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="permission-stat">
                    <div class="label">وحدات بتخصيص</div>
                    <div class="value">@customControllers</div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="permission-stat">
                    <div class="label">وحدات عرض فقط</div>
                    <div class="value">@readControllers</div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="permission-stat">
                    <div class="label">وحدات عرض وتعديل عام</div>
                    <div class="value">@readWriteControllers</div>
                </div>
            </div>
        </div>

        <div class="permission-toolbar mb-4">
            <div class="row g-3 align-items-end">
                <div class="col-lg-5">
                    <label class="form-label fw-bold">بحث داخل الوحدات</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="fas fa-search"></i>
                        </span>
                        <input type="text"
                               id="matrixSearch"
                               class="form-control"
                               placeholder="اكتب اسم الوحدة أو اسم الكنترولر..." />
                    </div>
                </div>

                <div class="col-lg-4">
                    <label class="form-label fw-bold">فلترة العرض</label>
                    <select id="matrixFilter" class="form-select">
                        <option value="all">عرض كل الوحدات</option>
                        <option value="custom">الوحدات المخصصة فقط</option>
                        <option value="not-custom">الوحدات بدون تخصيص</option>
                        <option value="readwrite">وحدات عرض وتعديل عام</option>
                        <option value="read">وحدات عرض فقط</option>
                        <option value="none">وحدات بدون وصول عام</option>
                    </select>
                </div>

                <div class="col-lg-3">
                    <button type="button" id="clearMatrixFilters" class="btn btn-outline-secondary w-100">
                        <i class="fas fa-undo ms-1"></i>
                        تصفير البحث
                    </button>
                </div>
            </div>

            <div class="alert alert-info small mt-3 mb-0 rounded-4">
                مستوى الوصول العام يستخدم للعرض العام فقط. عند تفعيل "مخصص"، يتم الاعتماد على الأكشنات المحددة يدويًا دون الحاجة لإعطاء صلاحيات للطبقات المرتبطة مثل المناهج أو المحاور أو المؤشرات.
            </div>
        </div>

        <div class="row g-4" id="matrixCards">
            @for (var i = 0; i < Model.Controllers.Count; i++)
            {
                var actionsCount = Model.Controllers[i].CustomActions?.Count ?? 0;
                var selectedActionsCount = Model.Controllers[i].CustomActions?.Count(x => x.IsAllowed) ?? 0;
                var accessValue = Model.Controllers[i].AccessLevel.ToString();

                <div class="col-12 matrix-card-wrapper"
                     data-controller-name="@Model.Controllers[i].ControllerName"
                     data-display-name="@Model.Controllers[i].DisplayName"
                     data-has-custom="@(Model.Controllers[i].HasCustom ? "true" : "false")"
                     data-access-level="@accessValue">

                    <div class="permission-card">
                        <div class="permission-card-header">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                                <div>
                                    <h5 class="permission-card-title">
                                        @Model.Controllers[i].DisplayName
                                    </h5>

                                    <div class="permission-card-key">
                                        @Model.Controllers[i].ControllerName
                                    </div>

                                    <input type="hidden" asp-for="Controllers[i].ControllerName" />
                                    <input type="hidden" asp-for="Controllers[i].DisplayName" />
                                </div>

                                <div class="d-flex flex-wrap gap-2">
                                    <span class="soft-badge soft-badge-gray">
                                        @actionsCount أكشن
                                    </span>

                                    <span class="soft-badge soft-badge-green selected-counter">
                                        @selectedActionsCount محدد
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="permission-card-body">
                            <div class="row g-3">
                                <div class="col-xl-3 col-lg-4">
                                    <div class="access-box h-100">
                                        <label class="form-label fw-bold">مستوى الوصول العام</label>

                                        <select asp-for="Controllers[i].AccessLevel"
                                                asp-items="Html.GetEnumSelectList<AdminControllerAccessLevel>()"
                                                class="form-select access-level-select">
                                        </select>

                                        <div class="muted-help mt-2">
                                            اختر Read للعرض فقط. لو تم تفعيل التخصيص، سيتم الاعتماد على الأكشنات المحددة يدويًا.
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xl-3 col-lg-4">
                                    <div class="custom-box h-100">
                                        <label class="form-label fw-bold">التخصيص الدقيق</label>

                                        <div class="form-check form-switch mt-2">
                                            <input asp-for="Controllers[i].HasCustom"
                                                   class="form-check-input custom-toggle"
                                                   data-target="#actions_@i"
                                                   type="checkbox" />

                                            <label class="form-check-label fw-bold">
                                                تفعيل الأكشنات المخصصة
                                            </label>
                                        </div>

                                        <div class="muted-help mt-2">
                                            استخدمه عندما تريد السماح بأكشنات محددة فقط مثل تعديل نموذج أو معاينة سؤال.
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xl-6 col-lg-4">
                                    <div class="actions-panel h-100">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                            <div>
                                                <strong>إجراءات سريعة</strong>
                                                <div class="muted-help">تؤثر على هذه الوحدة فقط.</div>
                                            </div>

                                            <div class="d-flex flex-wrap gap-2">
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-success select-all-actions"
                                                        data-target="#actions_@i">
                                                    تحديد الكل
                                                </button>

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger clear-all-actions"
                                                        data-target="#actions_@i">
                                                    إلغاء الكل
                                                </button>
                                            </div>
                                        </div>

                                        <div id="actions_@i" class="row g-2 actions-container">
                                            @if (Model.Controllers[i].CustomActions != null && Model.Controllers[i].CustomActions.Count > 0)
                                            {
                                                @for (var j = 0; j < Model.Controllers[i].CustomActions.Count; j++)
                                                {
                                                    var inputId = $"ctrl_{i}_act_{j}";

                                                    <div class="col-xl-4 col-lg-6 col-md-4 col-sm-6">
                                                        <div class="action-chip">
                                                            <input type="hidden" asp-for="Controllers[i].CustomActions[j].Key" />
                                                            <input type="hidden" asp-for="Controllers[i].CustomActions[j].DisplayName" />

                                                            <input asp-for="Controllers[i].CustomActions[j].IsAllowed"
                                                                   id="@inputId"
                                                                   class="form-check-input action-checkbox" />

                                                            <label for="@inputId" class="form-check-label">
                                                                @Model.Controllers[i].CustomActions[j].DisplayName
                                                            </label>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="col-12">
                                                    <div class="text-muted small border rounded-4 p-3 bg-light">
                                                        لا توجد أكشنات مخصصة لهذه الوحدة.
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            }
        </div>

        <div class="sticky-save-bar mt-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <strong>جاهز لحفظ التعديلات؟</strong>
                    <div class="muted-help">
                        لن يتم تعطيل أي Checkbox أثناء الحفظ حتى لا تضيع القيم المرسلة للكنترولر.
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        إلغاء
                    </a>

                    <button type="submit" class="btn btn-success px-5">
                        <i class="fas fa-save ms-1"></i>
                        حفظ الصلاحيات
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function refreshActionBlocks() {
            document.querySelectorAll('.custom-toggle').forEach(function (toggle) {
                var targetSelector = toggle.getAttribute('data-target');
                var target = document.querySelector(targetSelector);
                var wrapper = toggle.closest('.matrix-card-wrapper');

                if (!target || !wrapper) {
                    return;
                }

                if (toggle.checked) {
                    target.classList.remove('opacity-50');
                    wrapper.setAttribute('data-has-custom', 'true');
                } else {
                    target.classList.add('opacity-50');
                    wrapper.setAttribute('data-has-custom', 'false');
                }
            });
        }

        function refreshSelectedCounters() {
            document.querySelectorAll('.matrix-card-wrapper').forEach(function (wrapper) {
                var count = wrapper.querySelectorAll('.action-checkbox:checked').length;
                var counter = wrapper.querySelector('.selected-counter');

                if (counter) {
                    counter.textContent = count + ' محدد';
                }
            });
        }

        function refreshAccessLevels() {
            document.querySelectorAll('.matrix-card-wrapper').forEach(function (wrapper) {
                var select = wrapper.querySelector('.access-level-select');

                if (select) {
                    var selectedText = select.options[select.selectedIndex].text;
                    var selectedValue = select.value;

                    wrapper.setAttribute('data-access-level', selectedText);
                    wrapper.setAttribute('data-access-value', selectedValue);
                }
            });
        }

        function applyMatrixFilters() {
            var searchInput = document.getElementById('matrixSearch');
            var filterInput = document.getElementById('matrixFilter');

            var searchValue = searchInput ? searchInput.value.trim().toLowerCase() : '';
            var filterValue = filterInput ? filterInput.value : 'all';

            document.querySelectorAll('.matrix-card-wrapper').forEach(function (wrapper) {
                var controllerName = (wrapper.getAttribute('data-controller-name') || '').toLowerCase();
                var displayName = (wrapper.getAttribute('data-display-name') || '').toLowerCase();
                var hasCustom = wrapper.getAttribute('data-has-custom') === 'true';
                var accessText = (wrapper.getAttribute('data-access-level') || '').toLowerCase();

                var matchesSearch =
                    !searchValue ||
                    controllerName.includes(searchValue) ||
                    displayName.includes(searchValue);

                var matchesFilter = true;

                if (filterValue === 'custom') {
                    matchesFilter = hasCustom;
                }

                if (filterValue === 'not-custom') {
                    matchesFilter = !hasCustom;
                }

                if (filterValue === 'readwrite') {
                    matchesFilter = accessText.includes('readwrite') || accessText.includes('عرض') && accessText.includes('تعديل');
                }

                if (filterValue === 'read') {
                    matchesFilter = accessText.includes('read') || accessText.includes('عرض');
                }

                if (filterValue === 'none') {
                    matchesFilter = accessText.includes('none') || accessText.includes('بدون');
                }

                if (matchesSearch && matchesFilter) {
                    wrapper.classList.remove('hidden-by-filter');
                } else {
                    wrapper.classList.add('hidden-by-filter');
                }
            });
        }

        document.addEventListener('change', function (e) {
            if (e.target && e.target.classList.contains('custom-toggle')) {
                refreshActionBlocks();
                applyMatrixFilters();
            }

            if (e.target && e.target.classList.contains('action-checkbox')) {
                refreshSelectedCounters();
            }

            if (e.target && e.target.classList.contains('access-level-select')) {
                refreshAccessLevels();
                applyMatrixFilters();
            }
        });

        document.addEventListener('click', function (e) {
            var selectAllButton = e.target.closest('.select-all-actions');
            var clearAllButton = e.target.closest('.clear-all-actions');

            if (selectAllButton) {
                var target = document.querySelector(selectAllButton.getAttribute('data-target'));

                if (target) {
                    target.querySelectorAll('.action-checkbox').forEach(function (checkbox) {
                        checkbox.checked = true;
                    });

                    var wrapper = selectAllButton.closest('.matrix-card-wrapper');
                    var toggle = wrapper ? wrapper.querySelector('.custom-toggle') : null;

                    if (toggle) {
                        toggle.checked = true;
                    }

                    refreshActionBlocks();
                    refreshSelectedCounters();
                    applyMatrixFilters();
                }
            }

            if (clearAllButton) {
                var target = document.querySelector(clearAllButton.getAttribute('data-target'));

                if (target) {
                    target.querySelectorAll('.action-checkbox').forEach(function (checkbox) {
                        checkbox.checked = false;
                    });

                    refreshSelectedCounters();
                }
            }
        });

        document.addEventListener('input', function (e) {
            if (e.target && e.target.id === 'matrixSearch') {
                applyMatrixFilters();
            }
        });

        document.addEventListener('change', function (e) {
            if (e.target && e.target.id === 'matrixFilter') {
                applyMatrixFilters();
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            refreshActionBlocks();
            refreshSelectedCounters();
            refreshAccessLevels();
            applyMatrixFilters();

            var clearButton = document.getElementById('clearMatrixFilters');

            if (clearButton) {
                clearButton.addEventListener('click', function () {
                    var searchInput = document.getElementById('matrixSearch');
                    var filterInput = document.getElementById('matrixFilter');

                    if (searchInput) {
                        searchInput.value = '';
                    }

                    if (filterInput) {
                        filterInput.value = 'all';
                    }

                    applyMatrixFilters();
                });
            }
        });
    </script>
}