@model QdratNew.ViewModels.Admin.AdminProfileEditVM

@{
    ViewData["Title"] = "تعديل بروفايل صلاحيات";
}

<style>
    .qdrat-admin-profile-page {
        direction: rtl;
        background: #f6f8fb;
        min-height: calc(100vh - 120px);
        padding-bottom: 32px;
    }

    .qdrat-page-hero {
        position: relative;
        overflow: hidden;
        border-radius: 26px;
        padding: 28px;
        color: #fff;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 48%, #7c3aed 100%);
        box-shadow: 0 18px 45px rgba(15, 23, 42, .18);
    }

        .qdrat-page-hero::before {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            border-radius: 999px;
            top: -130px;
            left: -90px;
            background: rgba(255,255,255,.09);
        }

        .qdrat-page-hero::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 999px;
            bottom: -90px;
            right: 12%;
            background: rgba(124,58,237,.22);
        }

    .qdrat-page-hero-content {
        position: relative;
        z-index: 2;
    }

    .qdrat-soft-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 999px;
        padding: 7px 12px;
        font-size: 13px;
        font-weight: 800;
        background: rgba(255,255,255,.13);
        border: 1px solid rgba(255,255,255,.18);
        color: #fff;
    }

    .qdrat-form-shell {
        margin-top: -34px;
        position: relative;
        z-index: 5;
    }

    .qdrat-form-card {
        background: #fff;
        border: 1px solid #e7ebf1;
        border-radius: 24px;
        box-shadow: 0 16px 44px rgba(15, 23, 42, .09);
        overflow: hidden;
    }

    .qdrat-card-header {
        padding: 20px 22px;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
        border-bottom: 1px solid #eef2f7;
    }

    .qdrat-card-title {
        margin: 0;
        color: #111827;
        font-weight: 900;
        font-size: 19px;
    }

    .qdrat-card-subtitle {
        margin-top: 6px;
        color: #64748b;
        font-size: 13px;
        line-height: 1.8;
    }

    .qdrat-card-body {
        padding: 24px;
    }

    .qdrat-field-box {
        border: 1px solid #edf0f5;
        border-radius: 18px;
        background: #fbfdff;
        padding: 16px;
        height: 100%;
    }

        .qdrat-field-box .form-label {
            font-weight: 800;
            color: #1f2937;
            margin-bottom: 8px;
        }

        .qdrat-field-box .form-control {
            border-radius: 14px;
            border-color: #dbe3ee;
            min-height: 46px;
        }

            .qdrat-field-box .form-control:focus {
                border-color: #7c3aed;
                box-shadow: 0 0 0 .2rem rgba(124,58,237,.12);
            }

    .qdrat-help-text {
        color: #64748b;
        font-size: 12px;
        line-height: 1.7;
        margin-top: 8px;
    }

    .qdrat-actions-bar {
        padding: 18px 24px;
        background: #f8fafc;
        border-top: 1px solid #eef2f7;
    }

        .qdrat-actions-bar .btn {
            border-radius: 14px;
            font-weight: 800;
            min-height: 44px;
        }

    @@media (max-width: 768px) {
        .qdrat-page-hero {
            border-radius: 20px;
            padding: 22px;
        }

        .qdrat-form-shell {
            margin-top: -22px;
        }

        .qdrat-card-body,
        .qdrat-actions-bar {
            padding: 18px;
        }
    }
</style>

<div class="container-fluid mt-4 qdrat-admin-profile-page">
    <div class="qdrat-page-hero mb-4">
        <div class="qdrat-page-hero-content d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="qdrat-soft-badge mb-3">
                    <i class="fas fa-user-shield"></i>
                    بروفايلات الصلاحيات
                </div>

                <h2 class="fw-bold mb-2">تعديل بروفايل صلاحيات</h2>
                <div class="text-white-50">
                    عدّل بيانات البروفايل فقط دون التأثير على مصفوفة الصلاحيات المرتبطة به.
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Index" class="btn btn-outline-light px-4">
                    <i class="fas fa-arrow-right ms-1"></i>
                    رجوع
                </a>
            </div>
        </div>
    </div>

    <div class="row justify-content-center qdrat-form-shell">
        <div class="col-xl-7 col-lg-8 col-md-10">
            <div class="qdrat-form-card">
                <div class="qdrat-card-header">
                    <h5 class="qdrat-card-title">
                        <i class="fas fa-pen-to-square text-primary ms-1"></i>
                        بيانات البروفايل
                    </h5>
                    <div class="qdrat-card-subtitle">
                        حافظ على اسم ووصف واضحين حتى يسهل تتبع صلاحيات هذا البروفايل داخل لوحة الإدارة.
                    </div>
                </div>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="qdrat-card-body">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-12">
                                <div class="qdrat-field-box">
                                    <label asp-for="Name" class="form-label"></label>
                                    <input asp-for="Name"
                                           class="form-control"
                                           autocomplete="off"
                                           placeholder="مثال: مسؤول الأسئلة - عرض وتعديل" />
                                    <div class="qdrat-help-text">
                                        تغيير الاسم لا يغيّر الصلاحيات، لكنه يغيّر طريقة ظهوره في القوائم.
                                    </div>
                                    <span asp-validation-for="Name" class="text-danger small d-block mt-2"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="qdrat-field-box">
                                    <label asp-for="Description" class="form-label"></label>
                                    <textarea asp-for="Description"
                                              class="form-control"
                                              rows="4"
                                              placeholder="وصف مختصر يوضح نطاق استخدام هذا البروفايل..."></textarea>
                                    <div class="qdrat-help-text">
                                        استخدم الوصف لتوضيح نطاق البروفايل أو الدور الإداري المقصود.
                                    </div>
                                    <span asp-validation-for="Description" class="text-danger small d-block mt-2"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="qdrat-actions-bar">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                إلغاء
                            </a>

                            <button type="submit" class="btn btn-primary px-4">
                                <i class="fas fa-save ms-1"></i>
                                حفظ التعديل
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
