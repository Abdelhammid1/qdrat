@model QdratNew.ViewModels.Curriculum.CurriculumInstructorViewModel

@{
    ViewData["Title"] = "حذف الربط";
}

<h2 class="text-danger mb-4"><i class="fas fa-trash-alt"></i> تأكيد حذف الربط</h2>

<div class="alert alert-warning">
    هل أنت متأكد أنك تريد حذف الربط التالي بين المنهج والمدرب؟
</div>

<ul class="list-group mb-3">
    <li class="list-group-item"><strong>📘 المنهج:</strong> @Model.CurriculumList?.FirstOrDefault()?.Text</li>
    <li class="list-group-item"><strong>👨‍🏫 المدرب:</strong> @Model.InstructorList?.FirstOrDefault()?.Text</li>
    <li class="list-group-item"><strong>🧬 الجنس:</strong> @Model.Gender</li>
    <li class="list-group-item"><strong>📅 تاريخ الإسناد:</strong> @Model.AssignedDate.ToShortDateString()</li>
</ul>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="CurriculumId" />
    <input type="hidden" asp-for="InstructorId" />
    <button type="submit" class="btn btn-danger"><i class="fas fa-trash-alt"></i> حذف</button>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> إلغاء</a>
</form>
