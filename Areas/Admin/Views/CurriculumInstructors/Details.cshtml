@model QdratNew.ViewModels.Curriculum.CurriculumInstructorViewModel

@{
    ViewData["Title"] = "تفاصيل الربط";
}

<h2 class="text-primary mb-4"><i class="fas fa-eye"></i> تفاصيل الربط بين المدرب والمنهج</h2>

<div class="row">
    <div class="col-md-6">
        <label class="form-label">المنهج:</label>
        <div class="form-control bg-light">@Model.CurriculumList?.FirstOrDefault()?.Text</div>
    </div>

    <div class="col-md-6">
        <label class="form-label">المدرب:</label>
        <div class="form-control bg-light">@Model.InstructorList?.FirstOrDefault()?.Text</div>
    </div>

    <div class="col-md-6">
        <label class="form-label">الجنس:</label>
        <div class="form-control bg-light">@Model.Gender</div>
    </div>

    <div class="col-md-6">
        <label class="form-label">تاريخ الإسناد:</label>
        <div class="form-control bg-light">@Model.AssignedDate.ToString("yyyy-MM-dd")</div>
    </div>

    <div class="col-md-12">
        <label class="form-label">ملاحظات:</label>
        <div class="form-control bg-light">@Model.Notes</div>
    </div>

    <div class="col-12 mt-3">
        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> العودة للقائمة</a>
    </div>
</div>
