@using QdratNew.Enums
@model QdratNew.ViewModels.Curriculum.CurriculumInstructorViewModel

@{
    ViewData["Title"] = "تعديل ربط مدرب بمنهج";
    var curriculumName = Model.CurriculumList?.FirstOrDefault(c => c.Value == Model.CurriculumId.ToString())?.Text;
    var instructorName = Model.InstructorList?.FirstOrDefault(i => i.Value == Model.InstructorId.ToString())?.Text;
}

<div class="container-fluid py-4" dir="rtl">
    <div class="qdrat-page-header mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <div class="qdrat-breadcrumb mb-2">
                    <span>الإدارة</span>
                    <i class="fas fa-chevron-left"></i>
                    <span>المناهج والمدربون</span>
                    <i class="fas fa-chevron-left"></i>
                    <strong>تعديل الربط</strong>
                </div>
                <h2 class="qdrat-page-title mb-1">
                    <i class="fas fa-edit"></i>
                    تعديل ربط مدرب بمنهج
                </h2>
                <p class="qdrat-page-subtitle mb-0">
                    عدّل بيانات الإسناد القابلة للتغيير مع الحفاظ على نفس المنهج والمدرب المرتبطين بالسجل الحالي.
                </p>
            </div>

            <div class="qdrat-header-actions">
                <a asp-action="Index" class="btn btn-light qdrat-btn-back">
                    <i class="fas fa-arrow-right"></i>
                    الرجوع إلى القائمة
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-xl-8">
            <div class="qdrat-card">
                <div class="qdrat-card-header">
                    <div>
                        <h5 class="mb-1">
                            <i class="fas fa-pen-to-square"></i>
                            بيانات التعديل
                        </h5>
                        <p class="mb-0">المنهج والمدرب للقراءة فقط، ويمكن تعديل الجنس وتاريخ الإسناد والملاحظات.</p>
                    </div>
                </div>

                <form asp-action="Edit" method="post" class="qdrat-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CurriculumId" />
                    <input type="hidden" asp-for="InstructorId" />
                    <input type="hidden" name="ReturnToInstructors" id="ReturnToInstructors" value="false" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger qdrat-validation-summary"></div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <div class="qdrat-field">
                                <label class="form-label">
                                    <i class="fas fa-book-open"></i>
                                    المنهج
                                </label>
                                <input class="form-control qdrat-input qdrat-readonly" value="@curriculumName" readonly />
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="qdrat-field">
                                <label class="form-label">
                                    <i class="fas fa-user-tie"></i>
                                    المدرب
                                </label>
                                <input class="form-control qdrat-input qdrat-readonly" value="@instructorName" readonly />
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="qdrat-field">
                                <label asp-for="Gender" class="form-label">
                                    <i class="fas fa-venus-mars"></i>
                                    الجنس
                                </label>
                                @Html.DropDownListFor(model => model.Gender, Html.GetEnumSelectList<GenderType>(), "-- اختر الجنس --", new { @class = "form-select qdrat-input" })
                                <span asp-validation-for="Gender" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="qdrat-field">
                                <label asp-for="AssignedDate" class="form-label">
                                    <i class="fas fa-calendar-check"></i>
                                    تاريخ الإسناد
                                </label>
                                <input asp-for="AssignedDate" type="date" class="form-control qdrat-input" />
                                <span asp-validation-for="AssignedDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="qdrat-field">
                                <label asp-for="Notes" class="form-label">
                                    <i class="fas fa-note-sticky"></i>
                                    ملاحظات
                                </label>
                                <textarea asp-for="Notes" class="form-control qdrat-input qdrat-textarea" rows="4" placeholder="اكتب أي ملاحظات تنظيمية خاصة بهذا الربط"></textarea>
                                <span asp-validation-for="Notes" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="qdrat-actions mt-4">
                        <button type="submit" class="btn btn-success qdrat-btn-primary">
                            <i class="fas fa-save"></i>
                            حفظ التعديلات
                        </button>

                        <button type="submit" class="btn btn-dark qdrat-btn-dark" onclick="document.getElementById('ReturnToInstructors').value = 'true'">
                            <i class="fas fa-chalkboard-teacher"></i>
                            حفظ والعودة للمدربين
                        </button>

                        <a asp-action="Index" class="btn btn-outline-secondary qdrat-btn-outline">
                            <i class="fas fa-arrow-left"></i>
                            العودة للقائمة
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="qdrat-side-card mb-4">
                <div class="qdrat-side-icon">
                    <i class="fas fa-clipboard-check"></i>
                </div>
                <h5>تعديل آمن للربط</h5>
                <p>
                    يتم تثبيت المنهج والمدرب في هذه الصفحة للحفاظ على الربط الأساسي، مع السماح بتعديل بيانات الإسناد فقط.
                </p>
            </div>

            <div class="qdrat-tips-card">
                <h6>
                    <i class="fas fa-lightbulb"></i>
                    قبل الحفظ
                </h6>
                <ul class="mb-0">
                    <li>راجع الجنس المرتبط قبل حفظ التعديلات.</li>
                    <li>تأكد من صحة تاريخ الإسناد إذا كان مرتبطًا بتقارير تشغيلية.</li>
                    <li>استخدم الملاحظات لتوثيق سبب التعديل عند الحاجة.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
    .qdrat-page-header {
        background: linear-gradient(135deg, #f8fafc 0%, #eef4ff 100%);
        border: 1px solid #e5edf8;
        border-radius: 22px;
        padding: 24px;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.06);
    }

    .qdrat-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #64748b;
        font-size: 13px;
    }

        .qdrat-breadcrumb i {
            font-size: 10px;
            color: #94a3b8;
        }

    .qdrat-page-title {
        color: #1e293b;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .qdrat-page-title i {
            color: #2563eb;
        }

    .qdrat-page-subtitle {
        color: #64748b;
        font-size: 15px;
    }

    .qdrat-btn-back, .qdrat-btn-outline, .qdrat-btn-primary, .qdrat-btn-dark {
        border-radius: 14px;
        padding: 10px 18px;
        font-weight: 700;
    }

    .qdrat-card, .qdrat-side-card, .qdrat-tips-card {
        background: #ffffff;
        border: 1px solid #e5edf8;
        border-radius: 24px;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.06);
    }

    .qdrat-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #edf2f7;
    }

        .qdrat-card-header h5 {
            color: #1e293b;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .qdrat-card-header h5 i {
                color: #2563eb;
            }

        .qdrat-card-header p {
            color: #64748b;
            font-size: 14px;
        }

    .qdrat-form {
        padding: 24px;
    }

    .qdrat-field .form-label {
        color: #334155;
        font-weight: 800;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .qdrat-field .form-label i {
            color: #2563eb;
            width: 18px;
            text-align: center;
        }

    .qdrat-input {
        min-height: 48px;
        border-radius: 14px;
        border: 1px solid #dbe5f1;
        background-color: #fbfdff;
        transition: border-color .2s ease, box-shadow .2s ease, background-color .2s ease;
    }

    .qdrat-readonly {
        background: #f1f5f9;
        color: #475569;
        font-weight: 700;
    }

    .qdrat-textarea {
        min-height: 120px;
        resize: vertical;
    }

    .qdrat-input:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .12);
        background-color: #ffffff;
    }

    .qdrat-actions {
        border-top: 1px solid #edf2f7;
        padding-top: 20px;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: flex-start;
    }

    .qdrat-validation-summary {
        border-radius: 16px;
        border: 0;
    }

    .qdrat-side-card {
        padding: 26px;
        text-align: center;
    }

    .qdrat-side-icon {
        width: 72px;
        height: 72px;
        border-radius: 24px;
        background: #eff6ff;
        color: #2563eb;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        margin-bottom: 16px;
    }

    .qdrat-side-card h5 {
        color: #1e293b;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .qdrat-side-card p {
        color: #64748b;
        line-height: 1.8;
        margin-bottom: 0;
    }

    .qdrat-tips-card {
        padding: 22px;
    }

        .qdrat-tips-card h6 {
            color: #1e293b;
            font-weight: 800;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .qdrat-tips-card h6 i {
                color: #f59e0b;
            }

        .qdrat-tips-card ul {
            padding-right: 18px;
            color: #64748b;
            line-height: 2;
            font-size: 14px;
        }

    @@media (max-width: 768px) {
        .qdrat-page-header, .qdrat-card-header, .qdrat-form, .qdrat-side-card, .qdrat-tips-card {
            padding: 18px;
        }

        .qdrat-actions {
            flex-direction: column;
        }

            .qdrat-actions .btn, .qdrat-header-actions .btn {
                width: 100%;
            }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
