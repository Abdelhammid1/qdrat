@model List<QdratNew.ViewModels.Curriculum.CurriculumInstructorViewModel>

@{
    ViewData["Title"] = "ربط المناهج بالمدربين";
}

<h2 class="text-primary mb-4"><i class="fas fa-link"></i> قائمة الربط بين المناهج والمدربين</h2>

<a href="@Url.Action("Create")" class="btn btn-dark mb-3">
    <i class="fas fa-plus-circle"></i> ربط جديد
</a>

<table class="table table-bordered table-hover text-center" id="curriculumInstructorsTable">
    <thead class="table-dark">
        <tr>
            <th>👨‍🏫 المدرب</th>
            <th>📘 المنهج</th>
           
            <th>🧬 الجنس</th>
            <th>📅 تاريخ الإسناد</th>
            <th>⚙️ إجراءات</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.Count; i++)
        {
            var item = Model[i];
            <tr>
                <td>@item.InstructorName</td>
                <td> @item.CurriculumTitle</td>
                <td>@item.Gender</td>
                <td>@item.AssignedDate.ToShortDateString()</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-dark me-1" title="تفاصيل">
                        <i class="fas fa-eye"></i>
                    </a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-dark me-1" title="تعديل">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-dark" title="حذف">
                        <i class="fas fa-trash-alt"></i>
                    </a>
                </td>

            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#curriculumInstructorsTable').DataTable({
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'copy',
                        text: '<i class="fas fa-copy"></i> نسخ',
                        className: 'btn btn-sm btn-secondary'
                    },
                    {
                        extend: 'excel',
                        text: '<i class="fas fa-file-excel"></i> Excel',
                        className: 'btn btn-sm btn-success'
                    },
                    {
                        extend: 'print',
                        text: '<i class="fas fa-print"></i> طباعة',
                        className: 'btn btn-sm btn-dark'
                    }
                ],
                language: {
                    search: "🔍 بحث:",
                    lengthMenu: "عرض _MENU_ صفوف",
                    zeroRecords: "لا توجد نتائج",
                    info: "عرض _START_ إلى _END_ من أصل _TOTAL_",
                    infoEmpty: "لا توجد بيانات",
                    paginate: {
                        first: "الأول",
                        last: "الأخير",
                        next: "التالي",
                        previous: "السابق"
                    }
                },
                responsive: true
            });
        });
    </script>
}
