@model IEnumerable<QdratNew.ViewModels.InstructorPermissions.InstructorPermissionSummaryVM>

@{
    ViewData["Title"] = "صلاحيات المدربين";
    var list = Model?.ToList() ?? new();
}

<div class="instr-perm-page" dir="rtl">

    <section class="page-hero">
        <div class="hero-main">
            <div class="hero-icon"><i class="fas fa-user-lock"></i></div>
            <div>
                <div class="hero-eyebrow">إدارة الوصول</div>
                <h1>صلاحيات المدربين</h1>
                <p>يمكن للمالك والمبرمج فقط منح أو سحب صلاحية وصول المدرب لدفعة بعينها في الحضور، الواجبات، الاختبارات، أو عرض الدفعة.</p>
            </div>
        </div>
    </section>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-bar success">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        </div>
    }

    <section class="filter-card">
        <div class="filter-grid">
            <div class="field">
                <label><i class="fas fa-search"></i> بحث باسم المدرب أو البريد</label>
                <input id="instrSearch" type="text" class="form-ctrl" placeholder="ابحث هنا..." />
            </div>
        </div>
    </section>

    <section class="table-card">
        <div class="table-head">
            <div>
                <span>قائمة المدربين</span>
                <h2>إجمالي: <strong id="visibleCount">@list.Count</strong> مدرب</h2>
            </div>
        </div>

        <div class="table-wrap">
            <table class="data-table" id="instrTable">
                <thead>
                    <tr>
                        <th style="text-align:right;">المدرب</th>
                        <th>البريد الإلكتروني</th>
                        <th>الحالة</th>
                        <th>الدفعات الممنوحة</th>
                        <th>إجمالي الصلاحيات</th>
                        <th>الإجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var instr in list)
                    {
                        <tr class="data-row" data-search="@($"{instr.FullName} {instr.Email}".ToLower())">
                            <td style="text-align:right;">
                                <div class="person-cell">
                                    <div class="avatar">@BuildAvatar(instr.FullName)</div>
                                    <div>
                                        <strong>@instr.FullName</strong>
                                    </div>
                                </div>
                            </td>
                            <td><span class="email-text">@instr.Email</span></td>
                            <td>
                                <span class="pill @(instr.IsActive ? "green" : "red")">
                                    <i class="fas fa-circle" style="font-size:7px;"></i>
                                    @(instr.IsActive ? "نشط" : "غير نشط")
                                </span>
                            </td>
                            <td>
                                <span class="number-badge blue">
                                    <i class="fas fa-layer-group"></i>
                                    @instr.GrantedBatchesCount دفعة
                                </span>
                            </td>
                            <td>
                                <span class="number-badge @(instr.TotalPermissionsCount > 0 ? "purple" : "gray")">
                                    <i class="fas fa-key"></i>
                                    @instr.TotalPermissionsCount صلاحية
                                </span>
                            </td>
                            <td>
                                <a asp-area="Admin"
                                   asp-controller="InstructorBatchPermissions"
                                   asp-action="Manage"
                                   asp-route-id="@instr.InstructorId"
                                   class="manage-btn">
                                    <i class="fas fa-sliders-h"></i>
                                    إدارة الصلاحيات
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!list.Any())
        {
            <div class="empty-box">
                <i class="fas fa-users-slash"></i>
                <strong>لا يوجد مدربون</strong>
                <span>لم يتم إضافة أي مدرب بعد.</span>
            </div>
        }
        else
        {
            <div id="noResults" class="empty-box d-none">
                <i class="fas fa-filter"></i>
                <strong>لا توجد نتائج مطابقة</strong>
            </div>
        }
    </section>
</div>

@functions {
    string BuildAvatar(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "م";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return (parts[0][0].ToString() + parts[1][0].ToString()).ToUpper();
        return name.Trim().Substring(0, Math.Min(2, name.Trim().Length)).ToUpper();
    }
}

<style>
    .instr-perm-page {
        --font: 'Cairo','Tahoma',sans-serif;
        --ink: #0d1117; --ink-3: #374151; --mute: #6b7280; --mute-2: #9ca3af;
        --bg: #f4f6fb; --surface: #fff; --border: #e5e8f0; --bg-2: #eef1f8;
        --blue: #2563eb; --blue-lt: #dbeafe; --blue-dk: #1e3a8a;
        --green: #059669; --green-lt: #d1fae5; --green-dk: #064e3b;
        --red: #dc2626; --red-lt: #fee2e2; --red-dk: #7f1d1d;
        --purple: #7c3aed; --purple-lt: #ede9fe; --purple-dk: #3b0764;
        --radius: 14px; --radius-lg: 22px;
        --shadow: 0 2px 16px rgba(13,17,23,.07); --shadow-sm: 0 1px 6px rgba(13,17,23,.05);
        background: var(--bg); min-height: 100vh; padding: 24px;
        color: var(--ink); font-family: var(--font);
    }
    .instr-perm-page * { box-sizing: border-box; }
    .instr-perm-page a { text-decoration: none; }

    .page-hero {
        background: linear-gradient(135deg, #0d1117, #1e3a5f);
        color: #fff; border-radius: var(--radius-lg); padding: 24px;
        display: flex; gap: 18px; align-items: center;
        margin-bottom: 14px; box-shadow: var(--shadow);
    }
    .hero-main { display: flex; align-items: center; gap: 16px; }
    .hero-icon {
        width: 58px; height: 58px; border-radius: 18px;
        background: rgba(255,255,255,.10); border: 1px solid rgba(255,255,255,.12);
        display: flex; align-items: center; justify-content: center; font-size: 24px; flex-shrink: 0;
    }
    .hero-eyebrow { color: #93c5fd; font-size: 12px; font-weight: 900; margin-bottom: 4px; }
    .page-hero h1 { margin: 0; font-size: 22px; font-weight: 900; }
    .page-hero p { margin: 6px 0 0; color: rgba(255,255,255,.72); font-size: 12.5px; line-height: 1.7; }

    .alert-bar {
        border-radius: var(--radius); padding: 12px 16px; margin-bottom: 14px;
        display: flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 800;
    }
    .alert-bar.success { background: var(--green-lt); color: var(--green-dk); border: 1px solid rgba(5,150,105,.20); }

    .filter-card {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--radius-lg); padding: 16px; margin-bottom: 14px; box-shadow: var(--shadow-sm);
    }
    .filter-grid { display: grid; grid-template-columns: 1fr; gap: 12px; }
    .field label { display: flex; align-items: center; gap: 6px; color: var(--ink-3); font-size: 11.5px; font-weight: 900; margin-bottom: 6px; }
    .field label i { color: var(--blue); }
    .form-ctrl {
        width: 100%; min-height: 42px; border: 1px solid var(--border); border-radius: 12px;
        background: #fff; padding: 9px 12px; color: var(--ink); font-size: 12.5px;
        font-family: var(--font); outline: none;
    }
    .form-ctrl:focus { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(37,99,235,.10); }

    .table-card {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); overflow: hidden;
    }
    .table-head {
        padding: 16px 20px; border-bottom: 1px solid var(--border);
        background: linear-gradient(180deg,#fff,#f8fafc);
    }
    .table-head span { display: block; color: var(--blue); font-size: 11px; font-weight: 900; margin-bottom: 3px; }
    .table-head h2 { margin: 0; color: var(--ink); font-size: 15px; font-weight: 900; }
    .table-head strong { color: var(--blue); }
    .table-wrap { width: 100%; overflow-x: auto; }
    .data-table { width: 100%; border-collapse: collapse; min-width: 780px; }
    .data-table th {
        background: var(--bg-2); color: var(--mute); font-size: 11px; font-weight: 900;
        padding: 11px 16px; border-bottom: 1px solid var(--border); text-align: center; white-space: nowrap;
    }
    .data-table td {
        color: var(--ink-3); font-size: 12.5px; padding: 12px 16px;
        border-bottom: 1px solid var(--border); text-align: center; vertical-align: middle;
    }
    .data-table tbody tr:hover td { background: #f8fafc; }

    .person-cell { display: flex; align-items: center; gap: 11px; }
    .avatar {
        width: 40px; height: 40px; border-radius: 13px; flex-shrink: 0;
        background: linear-gradient(135deg, #1e3a8a, #2563eb);
        color: #fff; display: flex; align-items: center; justify-content: center;
        font-size: 13px; font-weight: 900;
    }
    .person-cell strong { display: block; color: var(--ink); font-size: 13px; font-weight: 900; }
    .email-text { color: var(--mute); font-size: 11.5px; }

    .pill {
        display: inline-flex; align-items: center; gap: 5px;
        border-radius: 999px; padding: 5px 9px; font-size: 11px; font-weight: 800; border: 1px solid;
    }
    .pill.green { background: var(--green-lt); color: var(--green-dk); border-color: rgba(5,150,105,.18); }
    .pill.red { background: var(--red-lt); color: var(--red-dk); border-color: rgba(220,38,38,.18); }

    .number-badge {
        display: inline-flex; align-items: center; gap: 5px;
        border-radius: 999px; padding: 5px 10px; font-size: 12px; font-weight: 900; border: 1px solid;
    }
    .number-badge.blue { background: var(--blue-lt); color: var(--blue-dk); border-color: rgba(37,99,235,.18); }
    .number-badge.purple { background: var(--purple-lt); color: var(--purple-dk); border-color: rgba(124,58,237,.18); }
    .number-badge.gray { background: var(--bg-2); color: var(--mute); border-color: var(--border); }

    .manage-btn {
        display: inline-flex; align-items: center; gap: 6px;
        background: var(--blue); color: #fff;
        border-radius: 10px; padding: 8px 12px;
        font-size: 12px; font-weight: 900; transition: .15s;
    }
    .manage-btn:hover { background: var(--blue-dk); transform: translateY(-1px); color: #fff; }

    .empty-box { padding: 46px 20px; text-align: center; color: var(--mute); }
    .empty-box i { display: block; font-size: 34px; color: var(--mute-2); margin-bottom: 10px; }
    .empty-box strong { display: block; color: var(--ink); font-size: 16px; font-weight: 900; margin-bottom: 4px; }
    .empty-box span { display: block; font-size: 12px; }
    .d-none { display: none !important; }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const input = document.getElementById('instrSearch');
        const rows = Array.from(document.querySelectorAll('#instrTable tbody .data-row'));
        const counter = document.getElementById('visibleCount');
        const noResults = document.getElementById('noResults');

        function filter() {
            const q = (input?.value || '').trim().toLowerCase();
            let shown = 0;
            rows.forEach(function (r) {
                const match = q === '' || (r.getAttribute('data-search') || '').includes(q);
                r.style.display = match ? '' : 'none';
                if (match) shown++;
            });
            if (counter) counter.textContent = shown;
            if (noResults) noResults.classList.toggle('d-none', shown !== 0);
        }

        if (input) input.addEventListener('input', filter);
        filter();
    });
</script>
