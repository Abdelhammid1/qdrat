                            <button type="submit" class="bulk-btn grant"
                                    onclick="return confirm('سيتم منح جميع الصلاحيات لـ @instr.FullName في هذه الدفعة. هل تريد المتابعة؟')">
                                <i class="fas fa-check-double"></i> منح الكل
                            </button>
                        </form>
                    }
                </div>
            </div>
            <div class="features-row">
                @foreach (var feat in instr.FeaturePermissions)
                {
                    <div class="feat-cell @(feat.IsGranted ? "granted" : "")">
                        <div class="feat-left">
                            <span class="feat-icon @FeatClass(feat.Feature)">
                                <i class="fas @FeatIcon(feat.Feature)"></i>
                            </span>
                            <div>
                                <span class="feat-label">@feat.FeatureNameAr</span>
                                @if (feat.IsGranted && feat.GrantedAt.HasValue)
                                {
                                    <span class="feat-sub granted-text">@feat.GrantedAt.Value.ToString("yyyy/MM/dd")</span>
                                }
                                else
                                {
                                    <span class="feat-sub">لا توجد صلاحية</span>
                                }
                            </div>
                        </div>
                        <label class="tog">
                            <input type="checkbox"
                                   class="perm-toggle instr-toggle"
                                   @(feat.IsGranted ? "checked" : "")
                                   data-instructor-id="@instr.InstructorId"
                                   data-batch-id="@Model.BatchId"
                                   data-feature="@((int)feat.Feature)" />
                            <span class="tog-slider"></span>
                        </label>
                    </div>
                }
            </div>
        </div>
    }
}

@* ====================== المستخدمون (موظف / أدمن / سوبر أدمن) ====================== *@
<div class="section-header">
    <div class="section-title">
        <span class="section-title-icon green"><i class="fas fa-user-tie"></i></span>
        المستخدمون
        <span class="section-count">(@Model.Employees.Count مستخدم — موظف / أدمن / سوبر أدمن)</span>
    </div>
</div>

@if (!Model.Employees.Any())
{
    <div class="empty-section">
        <i class="fas fa-user-slash"></i>
        <strong>لا يوجد موظفون مسجلون</strong>
    </div>
}
else
{
    @foreach (var emp in Model.Employees)
    {
        <div class="person-card @(emp.HasAnyPermission ? "has-perms" : "")">
            <div class="person-card-header">
                <div class="person-info">
                    <div class="avatar-sm green">@BuildAvatar(emp.FullName)</div>
                    <div>
                        <strong>
                            @emp.FullName
                            @if (!string.IsNullOrWhiteSpace(emp.RoleName))
                            {
                                var roleClass = emp.RoleName switch {
                                    "SuperAdmin" => "role-tag superadmin",
                                    "Admin"      => "role-tag admin",
                                    _            => "role-tag employee"
                                };
                                <span class="@roleClass">@emp.RoleName</span>
                            }
                        </strong>
                        <span>@emp.Email</span>
                    </div>
                </div>
                <div class="bulk-actions">
                    @if (emp.HasAllPermissions)
                    {
                        <form asp-action="RevokeAllEmployee" method="post" class="inline-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@emp.UserId" />
                            <input type="hidden" name="batchId" value="@Model.BatchId" />
                            <button type="submit" class="bulk-btn revoke"
                                    onclick="return confirm('سيتم سحب جميع الصلاحيات من هذا الموظف. هل تريد المتابعة؟')">
                                <i class="fas fa-ban"></i> سحب الكل
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="GrantAllEmployee" method="post" class="inline-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@emp.UserId" />
                            <input type="hidden" name="batchId" value="@Model.BatchId" />
                            <button type="submit" class="bulk-btn grant"
                                    onclick="return confirm('سيتم منح جميع الصلاحيات لهذا الموظف. هل تريد المتابعة؟')">
                                <i class="fas fa-check-double"></i> منح الكل
                            </button>
                        </form>
                    }
                </div>
            </div>
            <div class="features-row">
                @foreach (var feat in emp.FeaturePermissions)
                {
                    <div class="feat-cell @(feat.IsGranted ? "granted" : "")">
                        <div class="feat-left">
                            <span class="feat-icon @FeatClass(feat.Feature)">
                                <i class="fas @FeatIcon(feat.Feature)"></i>
                            </span>
                            <div>
                                <span class="feat-label">@feat.FeatureNameAr</span>
                                @if (feat.IsGranted && feat.GrantedAt.HasValue)
                                {
                                    <span class="feat-sub granted-text">@feat.GrantedAt.Value.ToString("yyyy/MM/dd")</span>
                                }
                                else
                                {
                                    <span class="feat-sub">لا توجد صلاحية</span>
                                }
                            </div>
                        </div>
                        <label class="tog">
                            <input type="checkbox"
                                   class="perm-toggle emp-toggle"
                                   @(feat.IsGranted ? "checked" : "")
                                   data-user-id="@emp.UserId"
                                   data-batch-id="@Model.BatchId"
                                   data-feature="@((int)feat.Feature)" />
                            <span class="tog-slider"></span>
                        </label>
                    </div>
                }
            </div>
        </div>
    }
}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const toastContainer = document.getElementById('toastContainer');
        const token = document.querySelector('input[name="__RequestVerificationToken"]');

        function showToast(message, type) {
            const t = document.createElement('div');
            t.className = 'toast ' + (type || '');
            t.innerHTML = '<i class="fas ' + (type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle') + '"></i> ' + message;
            toastContainer.appendChild(t);
            setTimeout(() => t.remove(), 3000);
        }

        function postJson(url, body) {
            return fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token ? token.value : ''
                },
                body: new URLSearchParams({ ...body, __RequestVerificationToken: token ? token.value : '' })
            }).then(r => r.json());
        }

        // مدربون
        document.querySelectorAll('.instr-toggle').forEach(function (tog) {
            tog.addEventListener('change', function () {
                const instrId = this.getAttribute('data-instructor-id');
                const batchId = this.getAttribute('data-batch-id');
                const feature = this.getAttribute('data-feature');
                const isGranted = this.checked;
                const cell = this.closest('.feat-cell');
                const card = this.closest('.person-card');
                const self = this;

                postJson('/Admin/InstructorBatchPermissions/UpdatePermission', {
                    instructorId: instrId, batchId, feature, isGranted
                }).then(function (data) {
                    if (data.success) {
                        showToast(data.message, 'success');
                        cell?.classList.toggle('granted', isGranted);
                        const anyChecked = Array.from(card?.querySelectorAll('.instr-toggle') || []).some(t => t.checked);
                        card?.classList.toggle('has-perms', anyChecked);
                    } else {
                        showToast(data.message, 'error');
                        self.checked = !isGranted;
                    }
                }).catch(function () {
                    showToast('حدث خطأ في الاتصال.', 'error');
                    self.checked = !isGranted;
                });
            });
        });

        // موظفون
        document.querySelectorAll('.emp-toggle').forEach(function (tog) {
            tog.addEventListener('change', function () {
                const userId = this.getAttribute('data-user-id');
                const batchId = this.getAttribute('data-batch-id');
                const feature = this.getAttribute('data-feature');
                const isGranted = this.checked;
                const cell = this.closest('.feat-cell');
                const card = this.closest('.person-card');
                const self = this;

                postJson('/Admin/InstructorBatchPermissions/UpdateEmployeePermission', {
                    userId, batchId, feature, isGranted
                }).then(function (data) {
                    if (data.success) {
                        showToast(data.message, 'success');
                        cell?.classList.toggle('granted', isGranted);
                        const anyChecked = Array.from(card?.querySelectorAll('.emp-toggle') || []).some(t => t.checked);
                        card?.classList.toggle('has-perms', anyChecked);
                    } else {
                        showToast(data.message, 'error');
                        self.checked = !isGranted;
                    }
                }).catch(function () {
                    showToast('حدث خطأ في الاتصال.', 'error');
                    self.checked = !isGranted;
                });
            });
        });
    });
</script>
