@model QdratNew.Entities.CorporateRegistrationSetting
@{
    ViewData["Title"] = "إدارة اشتراك الشركة";
}

<!-- === PAGE: إدارة اشتراك شركة (Corporate Subscription Management) === -->

<style>
    :root {
        --mc-accent: #3b82f6;
        --mc-accent-dark: #2563eb;
        --mc-accent-glow: rgba(59, 130, 246, .16);
        --mc-success: #16a34a;
        --mc-success-bg: #ecfdf5;
        --mc-success-border: #a7f3d0;
        --mc-danger: #dc2626;
        --mc-danger-bg: #fef2f2;
        --mc-danger-border: #fecaca;
        --mc-warning: #d97706;
        --mc-warning-bg: #fffbeb;
        --mc-warning-border: #fde68a;
        --mc-border: #e5e7eb;
        --mc-text: #1e293b;
        --mc-text-muted: #64748b;
        --mc-card-bg: #ffffff;
        --mc-page-bg: #f4f6fb;
        --mc-radius: 16px;
        --mc-radius-sm: 10px;
        --mc-shadow: 0 1px 3px rgba(15, 23, 42, .06), 0 1px 2px rgba(15, 23, 42, .04);
        --mc-shadow-lg: 0 12px 32px rgba(15, 23, 42, .08);
    }

    .mc-wrap {
        max-width: 1180px;
        margin: 0 auto;
        padding: 4px 4px 40px;
        font-family: 'Cairo', sans-serif;
        color: var(--mc-text);
    }

    /* ===== Breadcrumb ===== */
    .mc-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: var(--mc-text-muted);
        margin-bottom: 18px;
    }

        .mc-breadcrumb a {
            color: var(--mc-text-muted);
            text-decoration: none;
            transition: color .15s;
        }

        .mc-breadcrumb a:hover { color: var(--mc-accent); }
        .mc-breadcrumb .current { color: var(--mc-text); font-weight: 600; }

    /* ===== Hero Header ===== */
    .mc-hero {
        position: relative;
        background: linear-gradient(135deg, #0f1623 0%, #1d2a40 55%, #243350 100%);
        border-radius: 20px;
        padding: 34px 36px;
        margin-bottom: 26px;
        overflow: hidden;
        box-shadow: var(--mc-shadow-lg);
    }

        .mc-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                radial-gradient(circle at 15% 20%, rgba(59,130,246,.25), transparent 45%),
                radial-gradient(circle at 90% 80%, rgba(34,197,94,.15), transparent 40%);
            pointer-events: none;
        }

    .mc-hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
    }

    .mc-hero-left { display: flex; align-items: center; gap: 18px; }

    .mc-hero-icon {
        width: 62px;
        height: 62px;
        flex-shrink: 0;
        border-radius: 16px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.12);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        color: #93c5fd;
        backdrop-filter: blur(6px);
    }

    .mc-hero-eyebrow {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .3px;
        color: #93c5fd;
        text-transform: uppercase;
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .mc-hero-title {
        font-size: 26px;
        font-weight: 800;
        color: #fff;
        margin: 0;
        line-height: 1.3;
    }

    .mc-hero-sub {
        font-size: 13.5px;
        color: #94a3b8;
        margin-top: 4px;
    }

    .mc-hero-badges { display: flex; gap: 10px; flex-wrap: wrap; }

    .mc-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 16px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
    }

    .mc-pill-open { background: rgba(34,197,94,.14); color: #4ade80; border: 1px solid rgba(74,222,128,.3); }
    .mc-pill-closed { background: rgba(239,68,68,.14); color: #f87171; border: 1px solid rgba(248,113,113,.3); }
    .mc-pill-visible { background: rgba(59,130,246,.14); color: #93c5fd; border: 1px solid rgba(147,197,253,.3); }
    .mc-pill-hidden { background: rgba(148,163,184,.14); color: #cbd5e1; border: 1px solid rgba(203,213,225,.3); }

    /* ===== Grid ===== */
    .mc-grid {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 22px;
        align-items: start;
    }

    @@media (max-width: 900px) {
        .mc-grid { grid-template-columns: 1fr; }
    }

    .mc-col { display: flex; flex-direction: column; gap: 22px; }

    /* ===== Card ===== */
    .mc-card {
        background: var(--mc-card-bg);
        border: 1px solid var(--mc-border);
        border-radius: var(--mc-radius);
        box-shadow: var(--mc-shadow);
        overflow: hidden;
    }

    .mc-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 18px 22px;
        border-bottom: 1px solid var(--mc-border);
        background: #fafbfd;
    }

    .mc-card-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 15.5px;
        font-weight: 800;
        color: var(--mc-text);
    }

        .mc-card-title .ico {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            flex-shrink: 0;
        }

    .ico-blue { background: var(--mc-accent-glow); color: var(--mc-accent); }
    .ico-green { background: var(--mc-success-bg); color: var(--mc-success); }
    .ico-amber { background: var(--mc-warning-bg); color: var(--mc-warning); }
    .ico-slate { background: #f1f5f9; color: #475569; }

    .mc-card-sub {
        font-size: 12.5px;
        color: var(--mc-text-muted);
        margin-top: 2px;
    }

    .mc-card-body { padding: 22px; }

    /* ===== Status block ===== */
    .mc-status-banner {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px 20px;
        border-radius: var(--mc-radius-sm);
        margin-bottom: 18px;
    }

        .mc-status-banner.open { background: var(--mc-success-bg); border: 1px solid var(--mc-success-border); }
        .mc-status-banner.closed { background: var(--mc-danger-bg); border: 1px solid var(--mc-danger-border); }

    .mc-status-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

        .mc-status-banner.open .mc-status-icon { background: var(--mc-success); color: #fff; }
        .mc-status-banner.closed .mc-status-icon { background: var(--mc-danger); color: #fff; }

    .mc-status-text-title { font-weight: 800; font-size: 16px; }
    .mc-status-banner.open .mc-status-text-title { color: #15803d; }
    .mc-status-banner.closed .mc-status-text-title { color: #b91c1c; }
    .mc-status-text-sub { font-size: 12.5px; color: var(--mc-text-muted); margin-top: 2px; }

    /* ===== Buttons ===== */
    .mc-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: none;
        border-radius: 12px;
        padding: 13px 22px;
        font-size: 14.5px;
        font-weight: 700;
        font-family: 'Cairo', sans-serif;
        cursor: pointer;
        transition: transform .15s ease, box-shadow .15s ease, opacity .15s ease;
        width: 100%;
    }

        .mc-btn:active { transform: translateY(1px); }

    .mc-btn-danger { background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff; box-shadow: 0 6px 16px rgba(220,38,38,.25); }
    .mc-btn-danger:hover { box-shadow: 0 8px 20px rgba(220,38,38,.35); color: #fff; }

    .mc-btn-success { background: linear-gradient(135deg, #22c55e, #16a34a); color: #fff; box-shadow: 0 6px 16px rgba(22,163,74,.25); }
    .mc-btn-success:hover { box-shadow: 0 8px 20px rgba(22,163,74,.35); color: #fff; }

    .mc-btn-primary { background: linear-gradient(135deg, #3b82f6, #2563eb); color: #fff; box-shadow: 0 6px 16px rgba(37,99,235,.25); }
    .mc-btn-primary:hover { box-shadow: 0 8px 20px rgba(37,99,235,.35); color: #fff; }

    .mc-btn-outline { background: #fff; color: var(--mc-text); border: 1px solid var(--mc-border); }
    .mc-btn-outline:hover { background: #f8fafc; border-color: #cbd5e1; }

    /* ===== Form fields ===== */
    .mc-label {
        font-size: 13px;
        font-weight: 700;
        color: var(--mc-text);
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .mc-input {
        width: 100%;
        border: 1px solid var(--mc-border);
        border-radius: var(--mc-radius-sm);
        padding: 12px 14px;
        font-size: 14px;
        font-family: 'Cairo', sans-serif;
        color: var(--mc-text);
        background: #fff;
        transition: border-color .15s, box-shadow .15s;
    }

        .mc-input:focus {
            outline: none;
            border-color: var(--mc-accent);
            box-shadow: 0 0 0 3px var(--mc-accent-glow);
        }

    .mc-info-box {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        background: var(--mc-accent-glow);
        border: 1px solid rgba(59,130,246,.25);
        border-radius: var(--mc-radius-sm);
        padding: 14px 16px;
        font-size: 13px;
        color: #1e40af;
        margin-top: 16px;
    }

        .mc-info-box i { margin-top: 2px; color: var(--mc-accent); }
        .mc-info-box strong { font-weight: 800; }

    /* ===== Visibility toggle card ===== */
    .mc-toggle-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
    }

    .mc-toggle-info { display: flex; align-items: flex-start; gap: 12px; }

    .mc-toggle-ico {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .mc-toggle-title { font-weight: 800; font-size: 14.5px; color: var(--mc-text); }
    .mc-toggle-desc { font-size: 12.5px; color: var(--mc-text-muted); margin-top: 3px; line-height: 1.6; }

    /* switch */
    .mc-switch {
        position: relative;
        display: inline-block;
        width: 52px;
        height: 30px;
        flex-shrink: 0;
    }

        .mc-switch input { opacity: 0; width: 0; height: 0; }

    .mc-slider {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background: #cbd5e1;
        border-radius: 999px;
        transition: .25s;
    }

        .mc-slider::before {
            content: "";
            position: absolute;
            height: 22px;
            width: 22px;
            right: 4px;
            bottom: 4px;
            background: #fff;
            border-radius: 50%;
            transition: .25s;
            box-shadow: 0 1px 3px rgba(0,0,0,.3);
        }

    .mc-switch input:checked + .mc-slider { background: var(--mc-success); }
    .mc-switch input:checked + .mc-slider::before { transform: translateX(-22px); }
    .mc-switch input:focus-visible + .mc-slider { box-shadow: 0 0 0 3px var(--mc-accent-glow); }

    /* ===== Timeline / meta list ===== */
    .mc-meta-list { display: flex; flex-direction: column; gap: 0; }

    .mc-meta-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 13px 0;
        border-bottom: 1px dashed var(--mc-border);
        font-size: 13.5px;
    }

        .mc-meta-item:last-child { border-bottom: none; }

    .mc-meta-key { color: var(--mc-text-muted); display: flex; align-items: center; gap: 8px; }
    .mc-meta-val { font-weight: 700; color: var(--mc-text); }

    /* ===== Live preview card ===== */
    .mc-preview-frame {
        border: 1px dashed var(--mc-border);
        border-radius: var(--mc-radius-sm);
        padding: 16px;
        background: #fafbfd;
        text-align: center;
    }

    .mc-preview-frame img { max-height: 46px; margin-bottom: 8px; opacity: .9; }
    .mc-preview-frame .name { font-weight: 800; font-size: 13.5px; color: var(--mc-text); }
    .mc-preview-frame .desc { font-size: 11.5px; color: var(--mc-text-muted); margin-top: 3px; }

    .mc-preview-frame.is-hidden { opacity: .45; filter: grayscale(.5); }

    .mc-hidden-tag {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 11px;
        font-weight: 700;
        color: var(--mc-danger);
        background: var(--mc-danger-bg);
        border: 1px solid var(--mc-danger-border);
        padding: 4px 10px;
        border-radius: 999px;
        margin-top: 10px;
    }
</style>

<div class="mc-wrap">

    <!-- Breadcrumb -->
    <div class="mc-breadcrumb">
        <a asp-area="Admin" asp-controller="CorporateRequests" asp-action="Index"><i class="fas fa-building"></i> طلبات الشركات</a>
        <i class="fas fa-chevron-left" style="font-size:10px;"></i>
        <span class="current">إدارة اشتراك @Model.CompanyName</span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-3" style="border-radius:12px;">
            <i class="fas fa-circle-check"></i> @TempData["Success"]
        </div>
    }

    <!-- Hero header -->
    <div class="mc-hero">
        <div class="mc-hero-inner">
            <div class="mc-hero-left">
                <div class="mc-hero-icon"><i class="fas fa-building-shield"></i></div>
                <div>
                    <div class="mc-hero-eyebrow"><i class="fas fa-users-gear"></i> إدارة اشتراكات الشركات</div>
                    <h1 class="mc-hero-title">@Model.CompanyName</h1>
                    <div class="mc-hero-sub">التحكم الكامل في حالة التسجيل، الجدولة التلقائية، وظهور الشركة بالصفحة الرئيسية</div>
                </div>
            </div>

            <div class="mc-hero-badges">
                @if (Model.IsClosed)
                {
                    <span class="mc-pill mc-pill-closed"><i class="fas fa-lock"></i> التسجيل مغلق</span>
                }
                else
                {
                    <span class="mc-pill mc-pill-open"><i class="fas fa-lock-open"></i> التسجيل مفتوح</span>
                }

                @if (Model.IsVisibleOnHomePage)
                {
                    <span class="mc-pill mc-pill-visible"><i class="fas fa-eye"></i> ظاهر بالرئيسية</span>
                }
                else
                {
                    <span class="mc-pill mc-pill-hidden"><i class="fas fa-eye-slash"></i> مخفي عن الرئيسية</span>
                }
            </div>
        </div>
    </div>

    <div class="mc-grid">

        <!-- ============ LEFT COLUMN ============ -->
        <div class="mc-col">

            <!-- Registration status -->
            <div class="mc-card">
                <div class="mc-card-head">
                    <div class="mc-card-title">
                        <span class="ico ico-blue"><i class="fas fa-toggle-on"></i></span>
                        حالة التسجيل الحالية
                    </div>
                </div>
                <div class="mc-card-body">

                    @if (Model.IsClosed)
                    {
                        <div class="mc-status-banner closed">
                            <div class="mc-status-icon"><i class="fas fa-lock"></i></div>
                            <div>
                                <div class="mc-status-text-title">التسجيل مغلق حاليًا</div>
                                <div class="mc-status-text-sub">
                                    @if (Model.AutoCloseAt != null)
                                    {
                                        <span>تم الإغلاق تلقائيًا حسب الموعد المحدد</span>
                                    }
                                    else
                                    {
                                        <span>تم الإغلاق يدويًا بواسطة الإدارة</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <form method="post" asp-action="OpenRegistration" asp-route-company="@Model.CompanyName" class="mc-confirm-form" data-confirm-title="إعادة فتح التسجيل؟" data-confirm-text="سيتمكن المتقدمون من التسجيل في شركة @Model.CompanyName مجددًا." data-confirm-icon="question" data-confirm-color="#16a34a" data-confirm-btn="نعم، افتح التسجيل">
                            <button type="submit" class="mc-btn mc-btn-success">
                                <i class="fas fa-lock-open"></i> إعادة فتح التسجيل
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="mc-status-banner open">
                            <div class="mc-status-icon"><i class="fas fa-lock-open"></i></div>
                            <div>
                                <div class="mc-status-text-title">التسجيل مفتوح ويستقبل المتقدمين</div>
                                <div class="mc-status-text-sub">يمكن للموظفين التسجيل عبر رابط الشركة الآن</div>
                            </div>
                        </div>

                        <form method="post" asp-action="CloseRegistration" asp-route-company="@Model.CompanyName" class="mc-confirm-form" data-confirm-title="إغلاق التسجيل؟" data-confirm-text="لن يتمكن أي متقدم جديد من التسجيل في شركة @Model.CompanyName حتى تتم إعادة الفتح." data-confirm-icon="warning" data-confirm-color="#dc2626" data-confirm-btn="نعم، أغلق التسجيل">
                            <button type="submit" class="mc-btn mc-btn-danger">
                                <i class="fas fa-lock"></i> إغلاق التسجيل يدويًا
                            </button>
                        </form>
                    }

                </div>
            </div>

            <!-- Auto close scheduler -->
            <div class="mc-card">
                <div class="mc-card-head">
                    <div>
                        <div class="mc-card-title">
                            <span class="ico ico-amber"><i class="fas fa-clock"></i></span>
                            الإغلاق التلقائي المجدول
                        </div>
                        <div class="mc-card-sub">جدولة إغلاق التسجيل تلقائيًا دون الحاجة لتدخل يدوي</div>
                    </div>
                </div>
                <div class="mc-card-body">

                    <form method="post" asp-action="SetAutoCloseDate" asp-route-company="@Model.CompanyName">
                        <label class="mc-label"><i class="fas fa-calendar-days text-muted"></i> تاريخ ووقت الإغلاق</label>
                        <input type="datetime-local"
                               name="autoCloseAt"
                               class="mc-input mb-3"
                               value="@(Model.AutoCloseAt?.ToString("yyyy-MM-ddTHH:mm"))" />

                        <button type="submit" class="mc-btn mc-btn-primary">
                            <i class="fas fa-save"></i> حفظ موعد الإغلاق
                        </button>
                    </form>

                    @if (Model.AutoCloseAt != null)
                    {
                        <div class="mc-info-box">
                            <i class="fas fa-calendar-check"></i>
                            <div>
                                سيتم إغلاق التسجيل تلقائيًا في
                                <strong>@Model.AutoCloseAt.Value.ToString("yyyy/MM/dd - HH:mm")</strong>
                            </div>
                        </div>

                        <form method="post" asp-action="ClearAutoCloseDate" asp-route-company="@Model.CompanyName" class="mt-3">
                            <button type="submit" class="mc-btn mc-btn-outline">
                                <i class="fas fa-calendar-xmark"></i> إزالة الإغلاق التلقائي
                            </button>
                        </form>
                    }

                </div>
            </div>

        </div>

        <!-- ============ RIGHT COLUMN ============ -->
        <div class="mc-col">

            <!-- Homepage visibility -->
            <div class="mc-card">
                <div class="mc-card-head">
                    <div class="mc-card-title">
                        <span class="ico ico-slate"><i class="fas fa-desktop"></i></span>
                        الظهور بالصفحة الرئيسية
                    </div>
                </div>
                <div class="mc-card-body">

                    <div class="mc-toggle-row">
                        <div class="mc-toggle-info">
                            <div class="mc-toggle-ico @(Model.IsVisibleOnHomePage ? "ico-blue" : "ico-slate")">
                                <i class="fas @(Model.IsVisibleOnHomePage ? "fa-eye" : "fa-eye-slash")"></i>
                            </div>
                            <div>
                                <div class="mc-toggle-title">قسم "شركاؤنا في النجاح"</div>
                                <div class="mc-toggle-desc">
                                    تحكم في ظهور بطاقة @Model.CompanyName ضمن قسم الشركاء بالصفحة الرئيسية للموقع.
                                </div>
                            </div>
                        </div>

                        <form method="post" asp-action="ToggleHomeVisibility" asp-route-company="@Model.CompanyName" id="toggleVisibilityForm">
                            <label class="mc-switch">
                                <input type="checkbox"
                                       id="visibilityCheckbox"
                                       @(Model.IsVisibleOnHomePage ? "checked" : "")
                                       onchange="document.getElementById('toggleVisibilityForm').submit()" />
                                <span class="mc-slider"></span>
                            </label>
                        </form>
                    </div>

                    <hr style="border-color:var(--mc-border); margin:20px 0;" />

                    <div class="mc-label" style="margin-bottom:12px;"><i class="fas fa-eye text-muted"></i> معاينة مباشرة</div>
                    <div class="mc-preview-frame @(Model.IsVisibleOnHomePage ? "" : "is-hidden")">
                        <img src="~/images/sponsors/petrojet.png" alt="@Model.CompanyName" onerror="this.style.display='none'" />
                        <div class="name">شركة @Model.CompanyName</div>
                        <div class="desc">شريك استراتيجي في تطوير مهارات العاملين بالذكاء الاصطناعي</div>
                        @if (!Model.IsVisibleOnHomePage)
                        {
                            <div class="mc-hidden-tag"><i class="fas fa-eye-slash"></i> مخفي حاليًا عن الزوار</div>
                        }
                    </div>

                </div>
            </div>

            <!-- Company summary / meta -->
            <div class="mc-card">
                <div class="mc-card-head">
                    <div class="mc-card-title">
                        <span class="ico ico-green"><i class="fas fa-list-check"></i></span>
                        ملخص الحالة
                    </div>
                </div>
                <div class="mc-card-body">
                    <div class="mc-meta-list">
                        <div class="mc-meta-item">
                            <span class="mc-meta-key"><i class="fas fa-signature"></i> اسم الشركة</span>
                            <span class="mc-meta-val">@Model.CompanyName</span>
                        </div>
                        <div class="mc-meta-item">
                            <span class="mc-meta-key"><i class="fas fa-door-open"></i> آخر إعادة فتح</span>
                            <span class="mc-meta-val">@(Model.ReopenedAt?.ToString("yyyy/MM/dd HH:mm") ?? "—")</span>
                        </div>
                        <div class="mc-meta-item">
                            <span class="mc-meta-key"><i class="fas fa-door-closed"></i> آخر إغلاق</span>
                            <span class="mc-meta-val">@(Model.ClosedAt?.ToString("yyyy/MM/dd HH:mm") ?? "—")</span>
                        </div>
                        <div class="mc-meta-item">
                            <span class="mc-meta-key"><i class="fas fa-stopwatch"></i> الإغلاق التلقائي المجدول</span>
                            <span class="mc-meta-val">@(Model.AutoCloseAt?.ToString("yyyy/MM/dd HH:mm") ?? "غير مفعّل")</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.querySelectorAll('.mc-confirm-form').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                Swal.fire({
                    title: form.dataset.confirmTitle,
                    text: form.dataset.confirmText,
                    icon: form.dataset.confirmIcon || 'question',
                    showCancelButton: true,
                    confirmButtonText: form.dataset.confirmBtn || 'تأكيد',
                    cancelButtonText: 'إلغاء',
                    confirmButtonColor: form.dataset.confirmColor || '#3b82f6',
                    cancelButtonColor: '#94a3b8',
                    reverseButtons: true,
                    customClass: { popup: 'text-end' }
                }).then(function (result) {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
    </script>
}
