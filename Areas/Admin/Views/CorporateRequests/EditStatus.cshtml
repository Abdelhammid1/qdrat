@model QdratNew.ViewModels.EditCorporateStatusViewModel
@{
    ViewData["Title"] = "تحديث حالة التسجيل";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="fw-bold mb-0">تحديث حالة الطلب: @Model.FullName</h5>
        </div>
        <div class="card-body">
            <form asp-action="EditStatus" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label class="form-label fw-bold">الحالة الحالية</label>
                    <select asp-for="CurrentStatus" class="form-select">
                        <option value="0">قيد المراجعة</option>
                        <option value="1">تم التواصل</option>
                        <option value="2">مشترك فعليًا</option>
                        <option value="3">تراجع</option>
                        <option value="4">مرفوض</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">ملاحظات الأدمن</label>
                    <textarea asp-for="AdminNotes" class="form-control" rows="4" placeholder="اكتب سبب التراجع أو تفاصيل التواصل..."></textarea>
                </div>

                <button type="submit" class="btn btn-success px-4">💾 حفظ التغييرات</button>
                <a asp-action="Index" class="btn btn-outline-secondary">رجوع</a>
            </form>
        </div>
    </div>
</div>
