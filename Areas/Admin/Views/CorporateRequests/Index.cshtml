@model IEnumerable<QdratNew.Entities.CorporateRegistrationRequest>
@using QdratNew.Enums;
@{
    ViewData["Title"] = "طلبات تسجيل الشركات والهيئات";
}

<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet">

<!-- ✅ استدعاء مكتبات DataTables -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" />

<style>
    body {
        font-family: 'Cairo', sans-serif;
        direction: rtl;
        text-align: right;
        background: #f9fafb;
    }

    .page-header {
        background: #fff;
        border-bottom: 3px solid #339999;
        border-radius: 12px;
        padding: 20px 25px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .btn-export {
        background-color: #339999;
        border: none;
        color: white;
        font-weight: 600;
        transition: 0.3s;
    }

        .btn-export:hover {
            background-color: #2b7f7f;
        }

    table.dataTable thead {
        background-color: #339999;
        color: #fff;
        text-align: center;
    }

    .dataTables_filter input {
        border-radius: 6px;
        border: 1px solid #ccc;
        padding: 6px;
    }

    .dt-buttons .btn {
        margin: 0 4px;
        border-radius: 6px;
    }

    .dt-button.buttons-excel {
        background-color: #2b7f7f !important;
        color: #fff !important;
    }

    .dt-button.buttons-copy {
        background-color: #777 !important;
        color: #fff !important;
    }

    .dt-button.buttons-pdf {
        background-color: #d9534f !important;
        color: #fff !important;
    }

    .dt-button.buttons-print {
        background-color: #5cb85c !important;
        color: #fff !important;
    }

    .status-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
        border-right: 6px solid transparent;
    }

        .status-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
        }

    .status-icon {
        font-size: 2.2rem;
        margin-bottom: 8px;
    }

    .status-pending {
        border-right-color: #f6c23e; /* أصفر هادئ */
    }

    .status-contacted {
        border-right-color: #36b9cc; /* أزرق سماوي */
    }

    .status-joined {
        border-right-color: #1cc88a; /* أخضر ناعم */
    }

    .status-withdrawn {
        border-right-color: #858796; /* رمادي */
    }

    .status-rejected {
        border-right-color: #e74a3b; /* أحمر خافت */
    }

    .status-title {
        font-weight: 600;
        color: #444;
    }

    .status-value {
        font-size: 1.8rem;
        font-weight: 800;
        margin-top: 5px;
    }

</style>

<div class="container mt-4">
    <div class="page-header d-flex justify-content-between align-items-center">

        <h4 class="fw-bold text-dark mb-0">🧾 طلبات تسجيل الشركات والهيئات</h4>

        <div class="d-flex gap-2">

            <!-- ⭐ زر إدارة التسجيل للشركات -->
            <a asp-action="ManageCompany"
               asp-route-company="petrojet"
               class="btn btn-dark shadow-sm">
                <i class="fas fa-cog me-1"></i> إدارة تسجيل شركة Petrojet
            </a>

            <!-- زر تصدير Excel -->
            <a asp-action="ExportToExcel" class="btn btn-export shadow-sm">
                <i class="fas fa-file-excel me-1"></i> تصدير إلى Excel
            </a>

        </div>
    </div>




    <div class="row g-3 text-center mb-4">
        <div class="col-md-2 col-6">
            <div class="status-card status-pending p-3">
                <div class="status-icon text-warning">
                    <i class="fas fa-hourglass-half"></i>
                </div>
                <div class="status-title">قيد المراجعة</div>
                <div class="status-value text-warning">
                    @Model.Count(x => x.Status == RegistrationStatus.Pending)
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="status-card status-contacted p-3">
                <div class="status-icon text-info">
                    <i class="fas fa-phone-volume"></i>
                </div>
                <div class="status-title">تم التواصل</div>
                <div class="status-value text-info">
                    @Model.Count(x => x.Status == RegistrationStatus.Contacted)
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="status-card status-joined p-3">
                <div class="status-icon text-success">
                    <i class="fas fa-user-check"></i>
                </div>
                <div class="status-title">مشترك فعليًا</div>
                <div class="status-value text-success">
                    @Model.Count(x => x.Status == RegistrationStatus.Joined)
                </div>
            </div>
        </div>

        <div class="col-md-2 col-6">
            <div class="status-card status-withdrawn p-3">
                <div class="status-icon text-secondary">
                    <i class="fas fa-sign-out-alt"></i>
                </div>
                <div class="status-title">تراجع</div>
                <div class="status-value text-secondary">
                    @Model.Count(x => x.Status == RegistrationStatus.Withdrawn)
                </div>
            </div>
        </div>

        <div class="col-md-2 col-6">
            <div class="status-card status-rejected p-3">
                <div class="status-icon text-danger">
                    <i class="fas fa-times-circle"></i>
                </div>
                <div class="status-title">مرفوض</div>
                <div class="status-value text-danger">
                    @Model.Count(x => x.Status == RegistrationStatus.Rejected)
                </div>
            </div>
        </div>
    </div>




    <div class="card shadow-sm border-0">
        <div class="card-body">
            <table id="requestsTable" class="table table-bordered table-striped align-middle">
                <thead>
                    <tr>
                        <th>الاسم الكامل</th>
                        <th>الرقم الوظيفي</th>
                        <th>البريد الإلكتروني</th>
                        <th>رقم الهوية</th>
                        <th>رقم الجوال</th>
                        <th>محل الإقامة</th>
                        <th>الشركة</th>
                        <th>تاريخ الإرسال</th>
                        <th>الحالة</th>
                        <th>آخر تحديث</th>
                        <th>إجراءات</th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.FullName</td>
                            <td>@r.EmployeeNumber</td>
                            <td>@r.Email</td>
                            <td>@r.NationalID</td>
                            <td>@r.PhoneNumber</td>
                            <td>@r.Residence</td>
                            <td>@r.CompanyName</td>
                            <td>@r.SubmittedAt.ToString("yyyy/MM/dd HH:mm")</td>
                            <td>
                                @switch (r.Status)
                                {
                                    case RegistrationStatus.Pending:
                                        <span class="badge bg-warning text-dark">قيد المراجعة</span>
                                        break;
                                    case RegistrationStatus.Contacted:
                                        <span class="badge bg-info text-dark">تم التواصل</span>
                                        break;
                                    case RegistrationStatus.Joined:
                                        <span class="badge bg-success">مشترك فعليًا</span>
                                        break;
                                    case RegistrationStatus.Withdrawn:
                                        <span class="badge bg-secondary">تراجع</span>
                                        break;
                                    case RegistrationStatus.Rejected:
                                        <span class="badge bg-danger">مرفوض</span>
                                        break;
                                }
                            </td>
                            <td>@r.LastUpdated?.ToString("yyyy/MM/dd HH:mm")</td>
                            <td>
                                <a asp-action="EditStatus" asp-route-id="@r.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-edit"></i> تعديل الحالة
                                </a>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ✅ استدعاء سكربتات DataTables -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

<script>
    $(document).ready(function () {
        $('#requestsTable').DataTable({
            language: {
                url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json"
            },
            responsive: true,
            dom: 'Bfrtip',
            buttons: [
                {
                    extend: 'copyHtml5',
                    text: '<i class="fas fa-copy"></i> نسخ',
                    className: 'btn btn-sm btn-secondary'
                },
                {
                    extend: 'excelHtml5',
                    text: '<i class="fas fa-file-excel"></i> Excel',
                    className: 'btn btn-sm btn-success'
                },
                {
                    extend: 'pdfHtml5',
                    text: '<i class="fas fa-file-pdf"></i> PDF',
                    className: 'btn btn-sm btn-danger',
                    orientation: 'landscape',
                    pageSize: 'A4',
                    exportOptions: { columns: ':visible' }
                },
                {
                    extend: 'print',
                    text: '<i class="fas fa-print"></i> طباعة',
                    className: 'btn btn-sm btn-primary'
                }
            ],
            order: [[7, 'desc']],
            pageLength: 10
        });
    });
</script>
