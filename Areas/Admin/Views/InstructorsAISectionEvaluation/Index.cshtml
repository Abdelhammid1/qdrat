@model QdratNew.ViewModels.Instructor.InstructorSectionEvaluationViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "تحليل أداء المحاور التعليمية";
}

<h2 class="mb-4 text-center">تحليل أداء المحاور التعليمية - @Model.InstructorName</h2>

<!-- ✅ نموذج الفلترة -->
<form asp-action="Index" method="get" class="row g-3 mb-4">
    <input type="hidden" name="instructorId" value="@Model.InstructorId" />

    <div class="col-md-3">
        <label class="form-label">الدفعة</label>
        <select class="form-select" name="batchId" asp-items="Model.BatchList">
            <option value="">جميع الدفعات</option>
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">المنهج</label>
        <select class="form-select" name="curriculumId" asp-items="Model.CurriculumList">
            <option value="">جميع المناهج</option>
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">من تاريخ</label>
        <input type="date" class="form-control" name="fromDate"
               value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
    </div>

    <div class="col-md-2">
        <label class="form-label">إلى تاريخ</label>
        <input type="date" class="form-control" name="toDate"
               value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-search"></i> تصفية
        </button>
    </div>
</form>

<!-- ✅ كروت الإحصائيات -->
<div class="row text-center mb-4">
    <div class="col-md-3">
        <div class="card shadow rounded p-3">
            <h5>معدل الأداء العام</h5>
            <h3>@Model.AIOverallScore%</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow rounded p-3">
            <h5>نسبة النجاح</h5>
            <h3>@Model.SuccessRate%</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow rounded p-3">
            <h5>معدل التفاعل</h5>
            <h3>@Math.Round(Model.EngagementRate * 100, 1)%</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow rounded p-3">
            <h5>معدل الحضور</h5>
            <h3>@Model.AttendanceRate%</h3>
        </div>
    </div>
</div>

<!-- ✅ التوصية العامة -->
<div class="alert alert-info text-center">
    <strong>تقييم عام:</strong> @Model.AIEvaluationComment
</div>

<!-- ✅ جدول تحليل المحاور -->
<table class="table table-bordered table-striped text-center">
    <thead class="table-dark">
        <tr>
            <th>المحور</th>
            <th>عدد الطلاب</th>
            <th>متوسط الدرجات</th>
            <th>نسبة النجاح</th>
            <th>مستوى الصعوبة</th>
            <th>ملاحظات الذكاء الاصطناعي</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model.SectionsEvaluation)
        {
            <tr>
                <td>@s.SectionTitle</td>
                <td>@s.StudentCount</td>
                <td>@s.AverageScore%</td>
                <td>@s.SuccessRate%</td>
                <td>@s.DifficultyLevel</td>
                <td>@s.AIComment</td>
            </tr>
        }
    </tbody>
</table>

<!-- ✅ التوصيات -->
<div class="card mt-4">
    <div class="card-header bg-secondary text-white">
        توصيات الذكاء الاصطناعي
    </div>
    <div class="card-body">
        <ul class="list-group">
            @foreach (var rec in Model.AIRecommendations)
            {
                <li class="list-group-item">@rec</li>
            }
        </ul>
    </div>
</div>

<div class="mt-5 text-center">
    <a asp-area="Admin" asp-controller="InstructorsAIDashboard" asp-action="Index"
       asp-route-instructorId="@Model.InstructorId"
       class="btn btn-outline-primary me-2">
        📊 العودة إلى لوحة تحكم المدرب
    </a>

    <a asp-area="Admin" asp-controller="InstructorSmartEvaluation" asp-action="Index"
       asp-route-instructorId="@Model.InstructorId"
       class="btn btn-outline-success me-2">
        🤖 التحليل الذكي الشامل
    </a>

    <a asp-area="Admin" asp-controller="Instructors" asp-action="Index"
       class="btn btn-outline-dark">
        📋 قائمة المدربين
    </a>
</div>
