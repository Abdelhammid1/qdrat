@model QdratNew.ViewModels.Instructor.InstructorCurriculumBatchViewModel

@{
    ViewData["Title"] = "ربط مدرب بمنهج ودفعة";
}

<div class="qdrat-page-wrapper" dir="rtl">
    <div class="qdrat-page-header">
        <div>
            <h1 class="qdrat-page-title">
                <i class="fas fa-link"></i>
                ربط مدرب بمنهج ودفعة
            </h1>
            <p class="qdrat-page-subtitle">
                اختر الدفعة والمنهج ليتم تحميل المدربين المناسبين تلقائيًا حسب جنس الدفعة والمنهج المحدد.
            </p>
        </div>

        <div class="qdrat-header-actions">
            <div id="batchGenderBadge" class="qdrat-gender-badge-wrapper" style="display:none;">
                <span id="batchGenderText" class="badge qdrat-gender-badge"></span>
            </div>

            <a asp-action="Index" class="qdrat-back-btn">
                <i class="fas fa-arrow-right"></i>
                العودة للقائمة
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="qdrat-alert qdrat-alert-success">
            <i class="fas fa-check-circle"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="qdrat-alert qdrat-alert-danger">
            <div class="qdrat-alert-title">
                <i class="fas fa-triangle-exclamation"></i>
                يوجد أخطاء
            </div>
            <ul class="qdrat-alert-list">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="Create" method="post" class="qdrat-form-card">
        @Html.AntiForgeryToken()

        <div class="qdrat-card-header">
            <div class="qdrat-card-icon">
                <i class="fas fa-chalkboard-teacher"></i>
            </div>
            <div>
                <h2>بيانات الربط</h2>
                <p>حدد الدفعة والمنهج ثم اختر المدرب المتاح لهذا المسار.</p>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-layer-group"></i>
                بيانات الدفعة والمنهج
            </div>

            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="BatchId" class="qdrat-label">
                            اختر الدفعة
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper qdrat-select-wrapper">
                            <i class="fas fa-users"></i>
                            <select asp-for="BatchId" class="form-control qdrat-input qdrat-select" asp-items="Model.Batches">
                                <option value="">اختر الدفعة...</option>
                            </select>
                        </div>
                        <span asp-validation-for="BatchId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="qdrat-form-group">
                        <label asp-for="CurriculumId" class="qdrat-label">
                            اختر المنهج
                            <span class="qdrat-required">*</span>
                        </label>
                        <div class="qdrat-input-wrapper qdrat-select-wrapper">
                            <i class="fas fa-book-open"></i>
                            <select asp-for="CurriculumId" class="form-control qdrat-input qdrat-select" asp-items="Model.Curriculums">
                                <option value="">اختر المنهج...</option>
                            </select>
                        </div>
                        <span asp-validation-for="CurriculumId" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="qdrat-section">
            <div class="qdrat-section-title">
                <i class="fas fa-user-tie"></i>
                المدرب المتاح
            </div>

            <div class="qdrat-form-group">
                <label asp-for="InstructorId" class="qdrat-label">
                    اختر المدرب
                    <span class="qdrat-required">*</span>
                </label>
                <div class="qdrat-input-wrapper qdrat-select-wrapper">
                    <i class="fas fa-chalkboard-user"></i>
                    <select asp-for="InstructorId" class="form-control qdrat-input qdrat-select" asp-items="Model.Instructors">
                        <option value="">اختر المدرب...</option>
                    </select>
                </div>
                <span asp-validation-for="InstructorId" class="text-danger small"></span>
                <div class="qdrat-help-text">
                    يتم تحديث قائمة المدربين تلقائيًا بعد اختيار الدفعة والمنهج.
                </div>
            </div>
        </div>

        <div class="qdrat-actions">
            <a asp-action="Index" class="qdrat-cancel-btn">
                <i class="fas fa-arrow-right"></i>
                رجوع للقائمة
            </a>

            <button type="submit" class="qdrat-save-btn">
                <i class="fas fa-save"></i>
                حفظ الربط
            </button>
        </div>
    </form>
</div>

<style>
    .qdrat-page-wrapper {
        max-width: 1180px;
        margin: 0 auto;
        padding: 24px 16px 40px;
        direction: rtl;
        font-family: 'Cairo', 'Tajawal', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .qdrat-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 22px;
        padding: 24px;
        border-radius: 26px;
        color: #fff;
        background: linear-gradient(135deg, #0f766e 0%, #0891b2 50%, #2563eb 100%);
        box-shadow: 0 18px 45px rgba(15, 118, 110, 0.22);
    }

    .qdrat-page-title {
        margin: 0;
        font-size: 26px;
        font-weight: 900;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .qdrat-page-subtitle {
        margin: 8px 0 0;
        color: rgba(255, 255, 255, 0.88);
        font-size: 14px;
        line-height: 1.8;
    }

    .qdrat-header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .qdrat-back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 150px;
        padding: 11px 18px;
        border-radius: 999px;
        color: #fff;
        text-decoration: none;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.32);
        font-size: 14px;
        font-weight: 900;
        transition: all 0.2s ease-in-out;
    }

        .qdrat-back-btn:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.24);
            transform: translateY(-1px);
        }

    .qdrat-gender-badge-wrapper {
        display: inline-flex;
        align-items: center;
    }

    .qdrat-gender-badge {
        border-radius: 999px;
        padding: 11px 16px !important;
        font-size: 13px;
        font-weight: 900;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.16);
    }

    .bg-pink {
        background-color: #db2777 !important;
        color: #fff !important;
    }

    .qdrat-alert {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        border-radius: 18px;
        padding: 14px 16px;
        margin-bottom: 18px;
        font-size: 14px;
        font-weight: 800;
        border: 1px solid transparent;
    }

    .qdrat-alert-success {
        background: #f0fdf4;
        color: #166534;
        border-color: #bbf7d0;
    }

    .qdrat-alert-danger {
        display: block;
        background: #fef2f2;
        color: #991b1b;
        border-color: #fecaca;
    }

    .qdrat-alert-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        font-weight: 900;
    }

    .qdrat-alert-list {
        margin: 0;
        padding-right: 20px;
        line-height: 1.9;
    }

    .qdrat-form-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 26px;
        box-shadow: 0 20px 55px rgba(15, 23, 42, 0.08);
        padding: 26px;
        overflow: hidden;
    }

    .qdrat-card-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding-bottom: 22px;
        border-bottom: 1px solid #eef2f7;
        margin-bottom: 24px;
    }

    .qdrat-card-icon {
        width: 54px;
        height: 54px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #ecfeff 0%, #dbeafe 100%);
        color: #0f766e;
        font-size: 22px;
        flex-shrink: 0;
    }

    .qdrat-card-header h2 {
        margin: 0;
        font-size: 20px;
        font-weight: 900;
        color: #111827;
    }

    .qdrat-card-header p {
        margin: 6px 0 0;
        color: #6b7280;
        font-size: 13px;
    }

    .qdrat-section {
        padding: 20px;
        border: 1px solid #eef2f7;
        background: #fbfdff;
        border-radius: 22px;
        margin-bottom: 20px;
    }

    .qdrat-section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 18px;
        color: #0f172a;
        font-size: 16px;
        font-weight: 900;
    }

        .qdrat-section-title i {
            color: #0f766e;
        }

    .qdrat-form-group {
        margin-bottom: 2px;
    }

    .qdrat-label {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 9px;
        color: #1f2937;
        font-size: 14px;
        font-weight: 900;
    }

    .qdrat-required {
        color: #dc2626;
        font-weight: 900;
    }

    .qdrat-input-wrapper {
        position: relative;
    }

        .qdrat-input-wrapper i {
            position: absolute;
            top: 50%;
            right: 15px;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 15px;
            z-index: 2;
            pointer-events: none;
        }

    .qdrat-input {
        height: 48px;
        border-radius: 16px;
        border: 1px solid #dbe3ef;
        background: #fff;
        padding: 10px 44px 10px 14px;
        color: #111827;
        font-size: 14px;
        font-weight: 800;
        transition: all 0.18s ease-in-out;
    }

    .qdrat-select {
        cursor: pointer;
    }

    .qdrat-input:focus {
        border-color: #0f766e;
        box-shadow: 0 0 0 4px rgba(15, 118, 110, 0.10);
    }

    .qdrat-help-text {
        margin-top: 8px;
        color: #64748b;
        font-size: 12px;
        font-weight: 800;
    }

    .qdrat-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding-top: 8px;
        flex-wrap: wrap;
    }

    .qdrat-save-btn,
    .qdrat-cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-width: 170px;
        min-height: 48px;
        border-radius: 999px;
        font-size: 15px;
        font-weight: 900;
        text-decoration: none;
        border: none;
        transition: all 0.2s ease-in-out;
    }

    .qdrat-save-btn {
        color: #fff;
        background: linear-gradient(135deg, #16a34a 0%, #0f766e 100%);
        box-shadow: 0 14px 30px rgba(22, 163, 74, 0.22);
    }

        .qdrat-save-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 18px 34px rgba(22, 163, 74, 0.28);
        }

    .qdrat-cancel-btn {
        color: #334155;
        background: #fff;
        border: 1px solid #cbd5e1;
    }

        .qdrat-cancel-btn:hover {
            color: #0f172a;
            background: #f8fafc;
            transform: translateY(-1px);
        }

    @@media (max-width: 768px) {
        .qdrat-page-header {
            flex-direction: column;
            align-items: stretch;
            padding: 20px;
        }

        .qdrat-page-title {
            font-size: 21px;
        }

        .qdrat-header-actions {
            align-items: stretch;
            justify-content: stretch;
        }

        .qdrat-back-btn,
        .qdrat-gender-badge-wrapper,
        .qdrat-gender-badge {
            width: 100%;
            justify-content: center;
            text-align: center;
        }

        .qdrat-form-card {
            padding: 18px;
            border-radius: 22px;
        }

        .qdrat-section {
            padding: 16px;
        }

        .qdrat-actions {
            flex-direction: column;
        }

        .qdrat-save-btn,
        .qdrat-cancel-btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const batchSelect = document.getElementById('BatchId');
            const curriculumSelect = document.getElementById('CurriculumId');
            const instructorSelect = document.getElementById('InstructorId');
            const batchGenderBadge = document.getElementById('batchGenderBadge');
            const batchGenderText = document.getElementById('batchGenderText');

            function loadInstructors() {
                const batchId = batchSelect.value;
                const curriculumId = curriculumSelect.value;

                if (batchId && curriculumId) {
                    fetch(`/Admin/InstructorCurriculumBatches/GetInstructorsByBatchAndCurriculum?batchId=${batchId}&curriculumId=${curriculumId}`)
                        .then(response => response.json())
                        .then(data => {
                            instructorSelect.innerHTML = '';

                            if (data.success) {
                                batchGenderText.innerText = "جنس الدفعة: " + data.batchGender;
                                batchGenderBadge.style.display = 'block';

                                if (data.batchGender === "ذكور") {
                                    batchGenderText.className = "badge bg-primary qdrat-gender-badge";
                                } else if (data.batchGender === "إناث") {
                                    batchGenderText.className = "badge bg-pink qdrat-gender-badge";
                                } else {
                                    batchGenderText.className = "badge bg-secondary qdrat-gender-badge";
                                }

                                if (data.data.length > 0) {
                                    instructorSelect.innerHTML = '<option value="">اختر المدرب...</option>';
                                    data.data.forEach(instructor => {
                                        const option = document.createElement('option');
                                        option.value = instructor.id;
                                        option.text = instructor.name;
                                        instructorSelect.appendChild(option);
                                    });
                                } else {
                                    instructorSelect.innerHTML = '<option value="">لا يوجد مدربين متاحين لهذه الدفعة والمنهج</option>';
                                }
                            } else {
                                instructorSelect.innerHTML = '<option value="">لا يوجد مدربين متاحين</option>';
                                batchGenderBadge.style.display = 'none';
                            }
                        })
                        .catch(error => {
                            console.error('خطأ أثناء تحميل المدربين:', error);
                            instructorSelect.innerHTML = '<option value="">خطأ في تحميل المدربين</option>';
                            batchGenderBadge.style.display = 'none';
                        });
                } else {
                    instructorSelect.innerHTML = '<option value="">اختر المدرب...</option>';
                    batchGenderBadge.style.display = 'none';
                }
            }

            batchSelect.addEventListener('change', loadInstructors);
            curriculumSelect.addEventListener('change', loadInstructors);
        });
    </script>
}
