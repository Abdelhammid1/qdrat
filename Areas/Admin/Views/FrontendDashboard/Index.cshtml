@{
    ViewData["Title"] = "🖥️ إدارة محتوى الواجهة الأمامية";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    body {
        background: linear-gradient(to bottom right, #eef2f3, #dfe9f3);
    }

    .dashboard-header {
        text-align: center;
        margin-bottom: 50px;
    }

        .dashboard-header h2 {
            font-weight: 800;
            color: #2b7d77;
        }

        .dashboard-header p {
            color: #666;
            font-size: 1.05rem;
        }

    .feature-card {
        border: none;
        border-radius: 1.5rem;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(10px);
        transition: all 0.4s ease;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.08);
    }

        .feature-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 25px rgba(0, 0, 0, 0.12);
        }

    .feature-icon {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        font-size: 2.2rem;
        background: linear-gradient(135deg, #2b7d77, #55c3b8);
        color: white;
        transition: all 0.3s ease;
    }

    .feature-card:hover .feature-icon {
        transform: scale(1.1) rotate(5deg);
        background: linear-gradient(135deg, #55c3b8, #2b7d77);
    }

    .feature-card h5 {
        font-weight: 700;
        color: #222;
    }

    .feature-card p {
        font-size: 0.9rem;
        color: #666;
        min-height: 55px;
    }

    .feature-btn {
        border-radius: 30px;
        font-weight: 600;
        transition: 0.3s ease;
    }

        .feature-btn:hover {
            transform: scale(1.05);
        }

    @@media (max-width: 768px) {
        .feature-icon

    {
        width: 70px;
        height: 70px;
        font-size: 1.8rem;
    }

    }
</style>

<div class="container mt-5 mb-5" dir="rtl">

    <div class="dashboard-header">
        <h2 class="mb-3"><i class="bi bi-layout-text-sidebar-reverse me-2"></i> إدارة محتوى الموقع</h2>
        <p>يمكنك من هنا إدارة كل أقسام واجهة المنصة العامة بسهولة وسرعة.</p>
    </div>

    <div class="row g-4 justify-content-center">

        <!-- 🔹 الشرائح -->
        <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="card feature-card text-center p-4">
                <div class="feature-icon"><i class="bi bi-images"></i></div>
                <h5>الشرائح الرئيسية</h5>
                <p>تحكم في بنرات الصفحة الرئيسية وصور السلايدر التفاعلي.</p>
                <a href="/Admin/HeroSlides" class="btn btn-outline-primary feature-btn">إدارة الشرائح</a>
            </div>
        </div>

        <!-- 🔹 الدورات الرئيسية -->
        <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="card feature-card text-center p-4">
                <div class="feature-icon" style="background:linear-gradient(135deg,#28a745,#60d394);"><i class="bi bi-book"></i></div>
                <h5>الدورات الرئيسية</h5>
                <p>إدارة الدورات المعروضة في واجهة الموقع.</p>
                <a href="/Admin/FrontendCourses" class="btn btn-outline-success feature-btn">إدارة الدورات</a>
            </div>
        </div>

        <!-- 🔹 الدورات الفرعية -->
        <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="card feature-card text-center p-4">
                <div class="feature-icon" style="background:linear-gradient(135deg,#17a2b8,#64d5f0);"><i class="bi bi-journal-text"></i></div>
                <h5>الدورات الفرعية</h5>
                <p>تحكم في المحتوى الفرعي والبرامج المرتبطة بالدورات.</p>
                <a href="/Admin/SubCourses" class="btn btn-outline-info feature-btn">إدارة الدورات الفرعية</a>
            </div>
        </div>

        <!-- 🔹 الصفحات الثابتة -->
        <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="card feature-card text-center p-4">
                <div class="feature-icon" style="background:linear-gradient(135deg,#ffc107,#ffda6a);"><i class="bi bi-file-earmark-text"></i></div>
                <h5>الصفحات الثابتة</h5>
                <p>تحكم في الصفحات مثل "من نحن"، "الخصوصية"، "رؤية 2030".</p>
                <a href="/Admin/StaticPages" class="btn btn-outline-warning feature-btn">إدارة الصفحات</a>
            </div>
        </div>

        <!-- 🔹 الشركاء -->
        <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="card feature-card text-center p-4">
                <div class="feature-icon" style="background:linear-gradient(135deg,#dc3545,#ff6b6b);"><i class="bi bi-people"></i></div>
                <h5>شركاؤنا في النجاح</h5>
                <p>تحكم في شعارات وروابط الشركات الشريكة.</p>
                <a href="/Admin/SuccessPartners" class="btn btn-outline-danger feature-btn">إدارة الشركاء</a>
            </div>
        </div>

        <!-- 🔹 أهداف المنصة -->
        <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="card feature-card text-center p-4">
                <div class="feature-icon" style="background:linear-gradient(135deg,#6c757d,#adb5bd);"><i class="bi bi-bullseye"></i></div>
                <h5>أهداف المنصة</h5>
                <p>تحكم في بطاقات أهداف المنصة الظاهرة في الصفحة الرئيسية.</p>
                <a href="/Admin/PlatformGoals" class="btn btn-outline-secondary feature-btn">إدارة الأهداف</a>
            </div>
        </div>

        <!-- 🔹 تسجيلات الزوار -->
        <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="card feature-card text-center p-4">
                <div class="feature-icon" style="background:linear-gradient(135deg,#343a40,#6c757d);"><i class="bi bi-person-lines-fill"></i></div>
                <h5>تسجيلات الزوار</h5>
                <p>عرض طلبات التسجيل في الدورات والبرامج.</p>
                <a href="/Admin/FrontendRegistrations" class="btn btn-outline-dark feature-btn">عرض التسجيلات</a>
            </div>
        </div>

    </div>
</div>
