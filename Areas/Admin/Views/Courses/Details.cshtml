@model QdratNew.ViewModels.Course.CourseDetailsViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "تفاصيل الدورة — " + Model.Name;
    var durationDays  = Model.DurationDays;
    int n = 0;
}

<style>
/* ══════════════════════════════════════════════
   DESIGN TOKENS
══════════════════════════════════════════════ */
:root {
    --p:        #4F46E5;
    --p-d:      #3730A3;
    --p-l:      #EEF2FF;
    --p-m:      rgba(79,70,229,.10);
    --sky:      #0EA5E9;
    --sky-l:    #E0F2FE;
    --green:    #10B981;
    --green-l:  #D1FAE5;
    --amber:    #F59E0B;
    --amber-l:  #FEF3C7;
    --red:      #EF4444;
    --red-l:    #FEE2E2;
    --violet:   #8B5CF6;
    --violet-l: #EDE9FE;
    --teal:     #14B8A6;
    --teal-l:   #CCFBF1;
    --bg:       #F1F5F9;
    --card:     #FFFFFF;
    --ink:      #0F172A;
    --sub:      #334155;
    --muted:    #64748B;
    --light:    #94A3B8;
    --border:   #E2E8F0;
    --r:        16px;
    --r-sm:     10px;
    --sh:       0 1px 3px rgba(15,23,42,.06), 0 4px 16px rgba(15,23,42,.06);
    --sh-md:    0 4px 24px rgba(15,23,42,.10);
    --font:     'Cairo','Segoe UI',sans-serif;
}

/* ══════════════════════════════════════════════
   BASE
══════════════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
.cd { font-family: var(--font); direction: rtl; background: var(--bg);
      min-height: 100vh; padding: 24px 20px 60px; color: var(--ink); }

/* ══════════════════════════════════════════════
   BREADCRUMB + HEADER
══════════════════════════════════════════════ */
.cd-bc { display: flex; align-items: center; gap: 6px;
         font-size: 12.5px; color: var(--muted); margin-bottom: 6px; }
.cd-bc a { color: var(--p); text-decoration: none; font-weight: 600; }
.cd-bc a:hover { color: var(--p-d); }
.cd-bc .sep { font-size: 10px; color: var(--light); }

/* ══════════════════════════════════════════════
   HERO BANNER
══════════════════════════════════════════════ */
.cd-hero {
    background: linear-gradient(135deg, var(--p) 0%, var(--violet) 55%, var(--sky) 100%);
    border-radius: var(--r);
    padding: 32px 36px;
    color: #fff;
    position: relative;
    overflow: hidden;
    margin-bottom: 22px;
    box-shadow: 0 8px 32px rgba(79,70,229,.3);
}
.cd-hero::before {
    content: '';
    position: absolute;
    top: -60px; left: -60px;
    width: 220px; height: 220px;
    border-radius: 50%;
    background: rgba(255,255,255,.07);
}
.cd-hero::after {
    content: '';
    position: absolute;
    bottom: -40px; right: 10%;
    width: 160px; height: 160px;
    border-radius: 50%;
    background: rgba(255,255,255,.05);
}
.cd-hero-inner { position: relative; z-index: 1; }
.cd-hero-top { display: flex; align-items: flex-start;
               justify-content: space-between; flex-wrap: wrap; gap: 16px; }
.cd-hero-title {
    font-size: 26px; font-weight: 900; letter-spacing: -.4px;
    margin-bottom: 6px; line-height: 1.25;
}
.cd-hero-desc {
    font-size: 13.5px; opacity: .85; max-width: 640px; line-height: 1.65;
}
.hero-badges { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
.hero-badge {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 4px 12px; border-radius: 20px;
    font-size: 11.5px; font-weight: 600;
    background: rgba(255,255,255,.18); backdrop-filter: blur(4px);
}
.hero-actions { display: flex; gap: 10px; flex-shrink: 0; }
.h-btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 9px 18px; border-radius: 10px;
    font-size: 13px; font-weight: 600; cursor: pointer;
    transition: all .2s; text-decoration: none; border: none;
    font-family: var(--font);
}
.h-btn-white { background: #fff; color: var(--p); }
.h-btn-white:hover { background: #f0f0ff; transform: translateY(-1px);
                     box-shadow: 0 4px 14px rgba(0,0,0,.15); }
.h-btn-ghost { background: rgba(255,255,255,.15); color: #fff;
               border: 1.5px solid rgba(255,255,255,.4); }
.h-btn-ghost:hover { background: rgba(255,255,255,.25); }

/* ══════════════════════════════════════════════
   STATUS BADGE
══════════════════════════════════════════════ */
.st-dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
.st-active .st-dot  { background: #4ade80; box-shadow: 0 0 0 3px rgba(74,222,128,.3); }
.st-inactive .st-dot{ background: #f87171; }

/* ══════════════════════════════════════════════
   STATS ROW
══════════════════════════════════════════════ */
.cd-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 22px;
}
@@media (max-width: 900px) { .cd-stats { grid-template-columns: repeat(2,1fr); } }
@@media (max-width: 520px)  { .cd-stats { grid-template-columns: 1fr; } }

.stat-card {
    background: var(--card);
    border-radius: var(--r-sm);
    box-shadow: var(--sh);
    padding: 18px 20px;
    display: flex; align-items: center; gap: 14px;
    transition: transform .2s, box-shadow .2s;
}
.stat-card:hover { transform: translateY(-2px); box-shadow: var(--sh-md); }
.stat-ico {
    width: 46px; height: 46px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; flex-shrink: 0;
}
.ico-p  { background: var(--p-l);      color: var(--p); }
.ico-g  { background: var(--green-l);  color: var(--green); }
.ico-v  { background: var(--violet-l); color: var(--violet); }
.ico-t  { background: var(--teal-l);   color: var(--teal); }
.ico-a  { background: var(--amber-l);  color: var(--amber); }
.stat-val { font-size: 24px; font-weight: 800; color: var(--ink); line-height: 1; }
.stat-lbl { font-size: 12px; color: var(--muted); margin-top: 3px; }

/* ══════════════════════════════════════════════
   MAIN GRID  (info 4col + batches 8col)
══════════════════════════════════════════════ */
.cd-grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 18px;
    align-items: start;
}
@@media (max-width: 860px) { .cd-grid { grid-template-columns: 1fr; } }

/* ══════════════════════════════════════════════
   CARD BASE
══════════════════════════════════════════════ */
.cd-card {
    background: var(--card);
    border-radius: var(--r-sm);
    box-shadow: var(--sh);
    overflow: hidden;
}
.cd-card-head {
    display: flex; align-items: center; gap: 8px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
    font-size: 13.5px; font-weight: 700; color: var(--ink);
}
.cd-card-head i { color: var(--p); font-size: 14px; }
.cd-card-body { padding: 18px; }

/* ══════════════════════════════════════════════
   INFO LIST
══════════════════════════════════════════════ */
.info-list { list-style: none; }
.info-list li {
    display: flex; align-items: center; justify-content: space-between;
    gap: 8px; padding: 11px 0;
    border-bottom: 1px solid var(--border); font-size: 13px;
}
.info-list li:last-child { border-bottom: none; padding-bottom: 0; }
.info-k { color: var(--muted); display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
.info-k i { font-size: 12px; }
.info-v { font-weight: 600; color: var(--ink); text-align: left; word-break: break-word; }

/* ── Status chips ──────────────────────────── */
.chip {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 3px 10px; border-radius: 20px;
    font-size: 11.5px; font-weight: 600;
}
.chip-green  { background: var(--green-l);  color: #065f46; }
.chip-red    { background: var(--red-l);    color: #991b1b; }
.chip-amber  { background: var(--amber-l);  color: #92400e; }
.chip-violet { background: var(--violet-l); color: #5b21b6; }
.chip-sky    { background: var(--sky-l);    color: #075985; }
.chip-gray   { background: #F1F5F9;         color: var(--muted); }

/* ── Tags list (instructors / curriculums) ── */
.tag-list { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
.tag {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 4px 10px; border-radius: 20px;
    font-size: 11.5px; font-weight: 600;
    background: var(--p-l); color: var(--p);
}
.empty-msg { color: var(--light); font-size: 12px; font-style: italic; }

/* ══════════════════════════════════════════════
   BATCHES TABLE
══════════════════════════════════════════════ */
.tbl-wrap { overflow-x: auto; }
.dtbl { width: 100%; border-collapse: collapse; font-size: 13px; }
.dtbl thead tr { background: var(--bg); }
.dtbl th {
    padding: 10px 14px; font-size: 11.5px; font-weight: 700;
    color: var(--muted); text-align: right; white-space: nowrap;
    border-bottom: 2px solid var(--border);
}
.dtbl td { padding: 11px 14px; border-bottom: 1px solid var(--border);
           vertical-align: middle; }
.dtbl tbody tr { transition: background .15s; }
.dtbl tbody tr:last-child td { border-bottom: none; }
.dtbl tbody tr:hover { background: rgba(79,70,229,.03); }

.batch-name { font-weight: 700; color: var(--ink); }
.batch-date { font-size: 11.5px; color: var(--muted); }

.st-chip { display: inline-flex; align-items: center; gap: 4px;
           padding: 3px 9px; border-radius: 20px;
           font-size: 11px; font-weight: 600; }
.st-chip.active   { background: var(--green-l);  color: #065f46; }
.st-chip.ended    { background: #F1F5F9;          color: var(--muted); }
.st-chip.archived { background: var(--amber-l);   color: #92400e; }

.t-btn {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 5px 12px; border-radius: 7px;
    font-size: 12px; font-weight: 600; color: var(--p);
    background: var(--p-l); text-decoration: none;
    transition: background .15s, transform .15s;
    font-family: var(--font);
}
.t-btn:hover { background: #dde7ff; transform: translateY(-1px); }

/* ══════════════════════════════════════════════
   EMPTY STATE
══════════════════════════════════════════════ */
.empty-state {
    display: flex; flex-direction: column; align-items: center;
    gap: 12px; padding: 40px 20px; color: var(--muted);
}
.empty-state i { font-size: 36px; color: var(--border); }
.empty-state p { font-size: 13px; }

/* ══════════════════════════════════════════════
   PROGRESS RING (duration visual)
══════════════════════════════════════════════ */
.dur-ring { display: flex; align-items: center; gap: 14px; padding: 12px 0; }
.dur-circle {
    width: 64px; height: 64px; border-radius: 50%;
    background: conic-gradient(var(--p) 0%, var(--p-l) 0%);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 0 0 4px var(--p-l);
}
.dur-inner {
    width: 48px; height: 48px; border-radius: 50%;
    background: var(--card);
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 800; color: var(--p); text-align: center;
    line-height: 1.2;
}
.dur-text .big { font-size: 20px; font-weight: 800; color: var(--ink); }
.dur-text .lbl { font-size: 12px; color: var(--muted); }

/* ══════════════════════════════════════════════
   DARK MODE
══════════════════════════════════════════════ */
@@media (prefers-color-scheme: dark) {
    :root {
        --bg:     #0F172A;
        --card:   #1E293B;
        --ink:    #F1F5F9;
        --sub:    #CBD5E1;
        --muted:  #94A3B8;
        --border: #334155;
        --p-l:    rgba(79,70,229,.2);
    }
}
</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<div class="cd">

  @* ── Breadcrumb ──────────────────────────── *@
  <div class="cd-bc">
    <a asp-area="Admin" asp-controller="Courses" asp-action="Index">
      <i class="fa-solid fa-book-open"></i> الدورات
    </a>
    <span class="sep"><i class="fa-solid fa-chevron-left"></i></span>
    <span>@Model.Name</span>
  </div>

  @* ── Hero Banner ─────────────────────────── *@
  <div class="cd-hero">
    <div class="cd-hero-inner">
      <div class="cd-hero-top">
        <div>
          <div class="cd-hero-title">@Model.Name</div>
          @if (!string.IsNullOrWhiteSpace(Model.Description))
          {
            <div class="cd-hero-desc">@Model.Description</div>
          }
          <div class="hero-badges">
            <span class="hero-badge st-@Model.StatusClass">
              <span class="st-dot"></span>
              @Model.StatusLabel
            </span>
            <span class="hero-badge">
              <i class="fa-solid fa-code-branch"></i> @Model.BranchName
            </span>
            @if (Model.ProjectName != "—")
            {
              <span class="hero-badge">
                <i class="fa-solid fa-diagram-project"></i> @Model.ProjectName
              </span>
            }
          </div>
        </div>
        <div class="hero-actions">
          <a asp-area="Admin" asp-controller="Courses"
             asp-action="Edit" asp-route-id="@Model.Id"
             class="h-btn h-btn-white">
            <i class="fa-solid fa-pen-to-square"></i> تعديل
          </a>
          <a asp-area="Admin" asp-controller="Courses"
             asp-action="Index"
             class="h-btn h-btn-ghost">
            <i class="fa-solid fa-arrow-right"></i> رجوع
          </a>
        </div>
      </div>
    </div>
  </div>

  @* ── Stats Cards ──────────────────────────── *@
  <div class="cd-stats">
    <div class="stat-card">
      <div class="stat-ico ico-p"><i class="fa-solid fa-layer-group"></i></div>
      <div>
        <div class="stat-val">@Model.TotalBatches</div>
        <div class="stat-lbl">إجمالي الدفعات</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-ico ico-g"><i class="fa-solid fa-users"></i></div>
      <div>
        <div class="stat-val">@Model.TotalStudents</div>
        <div class="stat-lbl">إجمالي الطلاب</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-ico ico-v"><i class="fa-solid fa-chalkboard-user"></i></div>
      <div>
        <div class="stat-val">@Model.TotalInstructors</div>
        <div class="stat-lbl">المدربون</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-ico ico-t"><i class="fa-solid fa-book"></i></div>
      <div>
        <div class="stat-val">@Model.TotalCurriculums</div>
        <div class="stat-lbl">المناهج</div>
      </div>
    </div>
  </div>

  @* ── Main Grid ────────────────────────────── *@
  <div class="cd-grid">

    @* ─── Left: Info Panel ─── *@
    <div style="display:flex;flex-direction:column;gap:18px;">

      @* معلومات الدورة *@
      <div class="cd-card">
        <div class="cd-card-head">
          <i class="fa-solid fa-circle-info"></i> معلومات الدورة
        </div>
        <div class="cd-card-body" style="padding:0 18px;">
          <ul class="info-list">
            <li>
              <span class="info-k"><i class="fa-solid fa-calendar-plus"></i> تاريخ البدء</span>
              <span class="info-v">@Model.StartDate.ToString("dd / MM / yyyy")</span>
            </li>
            <li>
              <span class="info-k"><i class="fa-solid fa-calendar-xmark"></i> تاريخ الانتهاء</span>
              <span class="info-v">
                @(Model.EndDate > DateTime.MinValue ? Model.EndDate.ToString("dd / MM / yyyy") : "—")
              </span>
            </li>
            <li>
              <span class="info-k"><i class="fa-solid fa-clock"></i> المدة</span>
              <span class="info-v">
                @if (durationDays > 0) {
                  @($"{durationDays} يوم")
                } else { <span style="color:var(--light)">—</span> }
              </span>
            </li>
            <li>
              <span class="info-k"><i class="fa-solid fa-circle-dot"></i> الحالة</span>
              <span class="info-v">
                <span class="chip @(Model.IsActive ? "chip-green" : "chip-red")">
                  <i class="fa-solid @(Model.IsActive ? "fa-check" : "fa-ban")" style="font-size:9px;"></i>
                  @Model.StatusLabel
                </span>
              </span>
            </li>
            <li>
              <span class="info-k"><i class="fa-solid fa-code-branch"></i> الفرع</span>
              <span class="info-v">@Model.BranchName</span>
            </li>
            <li>
              <span class="info-k"><i class="fa-solid fa-diagram-project"></i> المشروع</span>
              <span class="info-v" style="font-size:12px;">@Model.ProjectName</span>
            </li>
          </ul>
        </div>
      </div>

      @* ── شارت 1: توزيع الطلاب حسب الدفعة ── *@
      @if (Model.Batches.Any())
      {
        <div class="cd-card">
          <div class="cd-card-head">
            <i class="fa-solid fa-chart-bar"></i> توزيع الطلاب حسب الدفعة
          </div>
          <div class="cd-card-body" style="padding:14px 16px;">
            <canvas id="batchStudentsChart" height="180"></canvas>
          </div>
        </div>

        @* ── شارت 2: توزيع حالات الدفعات ── *@
        <div class="cd-card">
          <div class="cd-card-head">
            <i class="fa-solid fa-chart-pie"></i> حالة الدفعات
          </div>
          <div class="cd-card-body" style="padding:14px 16px;display:flex;align-items:center;gap:20px;">
            <canvas id="batchStatusChart" width="140" height="140" style="flex-shrink:0;"></canvas>
            <div id="statusLegend" style="flex:1;display:flex;flex-direction:column;gap:8px;font-size:12.5px;"></div>
          </div>
        </div>
      }

      @* المدربون *@
      <div class="cd-card">
        <div class="cd-card-head">
          <i class="fa-solid fa-chalkboard-user"></i> المدربون
          @if (Model.Instructors.Any()) {
            <span class="chip chip-violet" style="margin-right:auto;font-size:10px;">@Model.Instructors.Count</span>
          }
        </div>
        <div class="cd-card-body">
          @if (Model.Instructors.Any())
          {
            <div class="tag-list">
              @foreach (var ins in Model.Instructors) {
                <span class="tag"><i class="fa-solid fa-user" style="font-size:10px;"></i>@ins</span>
              }
            </div>
          }
          else {
            <span class="empty-msg">لم يُعيَّن مدرب بعد</span>
          }
        </div>
      </div>

      @* المناهج *@
      <div class="cd-card">
        <div class="cd-card-head">
          <i class="fa-solid fa-book-open"></i> المناهج المرتبطة
          @if (Model.Curriculums.Any()) {
            <span class="chip chip-sky" style="margin-right:auto;font-size:10px;">@Model.Curriculums.Count</span>
          }
        </div>
        <div class="cd-card-body">
          @if (Model.Curriculums.Any())
          {
            <div class="tag-list">
              @foreach (var cur in Model.Curriculums) {
                <span class="tag" style="background:var(--sky-l);color:#075985;">
                  <i class="fa-solid fa-bookmark" style="font-size:10px;"></i>@cur
                </span>
              }
            </div>
          }
          else {
            <span class="empty-msg">لا توجد مناهج مرتبطة</span>
          }
        </div>
      </div>

    </div>

    @* ─── Right: Batches ─── *@
    <div class="cd-card">
      <div class="cd-card-head">
        <i class="fa-solid fa-layer-group"></i> الدفعات
        @if (Model.Batches.Any()) {
          <span class="chip chip-green" style="margin-right:auto;font-size:10px;">@Model.Batches.Count دفعة</span>
        }
        <a asp-area="Admin" asp-controller="Batches" asp-action="Create"
           asp-route-courseId="@Model.Id" class="t-btn" style="margin-right:@(Model.Batches.Any() ? "0" : "auto")">
          <i class="fa-solid fa-plus"></i> دفعة جديدة
        </a>
      </div>

      @if (Model.Batches.Any())
      {
        <div class="tbl-wrap">
          <table class="dtbl">
            <thead>
              <tr>
                <th>#</th>
                <th>اسم الدفعة</th>
                <th>الفئة</th>
                <th>تاريخ البدء</th>
                <th>تاريخ الانتهاء</th>
                <th>الطلاب</th>
                <th>الحالة</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              @{ n = 0; }
              @foreach (var b in Model.Batches)
              {
                n++;
                <tr>
                  <td style="color:var(--light);font-size:12px;">@n</td>
                  <td>
                    <div class="batch-name">@b.Name</div>
                  </td>
                  <td>
                    <span class="chip chip-sky" style="font-size:11px;">@b.GenderLabel</span>
                  </td>
                  <td class="batch-date">@b.StartDate.ToString("dd/MM/yyyy")</td>
                  <td class="batch-date">
                    @(b.EndDate.HasValue ? b.EndDate.Value.ToString("dd/MM/yyyy") : "—")
                  </td>
                  <td>
                    <span style="font-weight:700;color:var(--ink);">@b.StudentCount</span>
                    <span style="font-size:11px;color:var(--muted);"> طالب</span>
                  </td>
                  <td>
                    <span class="st-chip @b.StatusClass">
                      <span style="width:6px;height:6px;border-radius:50%;background:currentColor;display:inline-block;"></span>
                      @b.StatusLabel
                    </span>
                  </td>
                  <td>
                    <a class="t-btn"
                       asp-area="Admin" asp-controller="Batches"
                       asp-action="Details" asp-route-id="@b.Id">
                      <i class="fa-solid fa-eye"></i> عرض
                    </a>
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
      else
      {
        <div class="empty-state">
          <i class="fa-solid fa-layer-group"></i>
          <p>لا توجد دفعات لهذه الدورة بعد</p>
          <a asp-area="Admin" asp-controller="Batches" asp-action="Create"
             asp-route-courseId="@Model.Id" class="t-btn">
            <i class="fa-solid fa-plus"></i> أضف أول دفعة
          </a>
        </div>
      }
    </div>

  </div>

</div>

@if (Model.Batches.Any())
{
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
  <script>
  (function () {
    var batches = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
      Model.Batches.Select(b => new {
        name   = b.Name,
        count  = b.StudentCount,
        status = b.StatusLabel
      })
    ));

    /* ── شارت 1: أعمدة — الطلاب لكل دفعة ──────────────── */
    var ctx1 = document.getElementById('batchStudentsChart');
    if (ctx1) {
      new Chart(ctx1, {
        type: 'bar',
        data: {
          labels: batches.map(function(b){ return b.name; }),
          datasets: [{
            label: 'عدد الطلاب',
            data: batches.map(function(b){ return b.count; }),
            backgroundColor: [
              'rgba(79,70,229,.75)', 'rgba(14,165,233,.75)', 'rgba(16,185,129,.75)',
              'rgba(139,92,246,.75)','rgba(245,158,11,.75)', 'rgba(20,184,166,.75)',
              'rgba(239,68,68,.75)', 'rgba(99,102,241,.75)'
            ],
            borderRadius: 6,
            borderSkipped: false,
          }]
        },
        options: {
          responsive: true,
          plugins: { legend: { display: false },
                     tooltip: { rtl: true, textDirection: 'rtl' } },
          scales: {
            x: { ticks: { font: { family: 'Cairo', size: 11 }, color: '#64748B' },
                 grid: { display: false } },
            y: { beginAtZero: true, ticks: { precision: 0,
                 font: { family: 'Cairo', size: 11 }, color: '#64748B' },
                 grid: { color: '#F1F5F9' } }
          }
        }
      });
    }

    /* ── شارت 2: دائري — توزيع حالات الدفعات ──────────── */
    var ctx2 = document.getElementById('batchStatusChart');
    if (ctx2) {
      var statusMap = { 'نشط': 0, 'منتهي': 0, 'مؤرشف': 0 };
      batches.forEach(function(b){
        if (statusMap[b.status] !== undefined) statusMap[b.status]++;
        else statusMap[b.status] = 1;
      });
      var labels  = Object.keys(statusMap).filter(function(k){ return statusMap[k] > 0; });
      var values  = labels.map(function(k){ return statusMap[k]; });
      var colors  = { 'نشط':'#10B981', 'منتهي':'#94A3B8', 'مؤرشف':'#F59E0B' };
      var bgColors = labels.map(function(l){ return colors[l] || '#4F46E5'; });

      new Chart(ctx2, {
        type: 'doughnut',
        data: { labels: labels, datasets: [{ data: values,
                backgroundColor: bgColors, borderWidth: 2,
                borderColor: '#fff', hoverOffset: 6 }] },
        options: {
          responsive: false, cutout: '68%',
          plugins: { legend: { display: false },
                     tooltip: { rtl: true, textDirection: 'rtl',
                                callbacks: { label: function(c){ return ' ' + c.label + ': ' + c.raw + ' دفعة'; } } } }
        }
      });

      /* Legend يدوي */
      var leg = document.getElementById('statusLegend');
      if (leg) {
        labels.forEach(function(l, i){
          var row = document.createElement('div');
          row.style.cssText = 'display:flex;align-items:center;gap:8px;';
          row.innerHTML =
            '<span style="width:10px;height:10px;border-radius:50%;background:' + bgColors[i] + ';flex-shrink:0;"></span>' +
            '<span style="color:#64748B;">' + l + '</span>' +
            '<span style="margin-right:auto;font-weight:700;color:#0F172A;">' + values[i] + '</span>';
          leg.appendChild(row);
        });
      }
    }
  })();
  </script>
}
