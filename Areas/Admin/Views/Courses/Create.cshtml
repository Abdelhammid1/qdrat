@model QdratNew.ViewModels.Course.CourseFormViewModel

@{
    ViewData["Title"] = "إضافة دورة جديدة";
}

<div class="container-fluid py-4" dir="rtl">
    <div class="qdrat-page-header mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <div class="qdrat-breadcrumb mb-2">
                    <span>الإدارة</span>
                    <i class="fas fa-chevron-left"></i>
                    <span>الدورات</span>
                    <i class="fas fa-chevron-left"></i>
                    <strong>إضافة دورة</strong>
                </div>
                <h2 class="qdrat-page-title mb-1">
                    <i class="fas fa-layer-group"></i>
                    إضافة دورة جديدة
                </h2>
                <p class="qdrat-page-subtitle mb-0">
                    أدخل بيانات الدورة وربطها بالفرع والمشروع لتظهر ضمن منظومة الدفعات والتشغيل.
                </p>
            </div>

            <div class="qdrat-header-actions">
                <a asp-action="Index" class="btn btn-light qdrat-btn-back">
                    <i class="fas fa-arrow-right"></i>
                    الرجوع إلى القائمة
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-xl-8">
            <div class="qdrat-card">
                <div class="qdrat-card-header">
                    <div>
                        <h5 class="mb-1">
                            <i class="fas fa-clipboard-list"></i>
                            بيانات الدورة
                        </h5>
                        <p class="mb-0">الحقول التالية تحدد اسم الدورة ووصفها ونطاق عملها داخل الفرع والمشروع.</p>
                    </div>
                </div>

                <form asp-action="Create" method="post" class="qdrat-form">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger qdrat-validation-summary"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <div class="qdrat-field">
                                <label asp-for="Name" class="form-label">
                                    <i class="fas fa-heading"></i>
                                    اسم الدورة
                                </label>
                                <input asp-for="Name" class="form-control qdrat-input" placeholder="أدخل اسم الدورة" autocomplete="off" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="qdrat-field">
                                <label asp-for="Description" class="form-label">
                                    <i class="fas fa-align-right"></i>
                                    وصف الدورة
                                </label>
                                <textarea asp-for="Description" class="form-control qdrat-input qdrat-textarea" rows="4" placeholder="أدخل وصفًا مختصرًا وواضحًا للدورة"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="qdrat-field">
                                <label asp-for="BranchId" class="form-label">
                                    <i class="fas fa-building"></i>
                                    الفرع
                                </label>
                                <select asp-for="BranchId" asp-items="Model.Branches" class="form-select qdrat-input">
                                    <option value="">اختر الفرع...</option>
                                </select>
                                <span asp-validation-for="BranchId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="qdrat-field">
                                <label asp-for="ProjectId" class="form-label">
                                    <i class="fas fa-diagram-project"></i>
                                    المشروع
                                </label>
                                <select asp-for="ProjectId" asp-items="Model.Projects" class="form-select qdrat-input">
                                    <option value="">اختر المشروع...</option>
                                </select>
                                <span asp-validation-for="ProjectId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="qdrat-field">
                                <label asp-for="StartDate" class="form-label">
                                    <i class="fas fa-calendar-plus"></i>
                                    تاريخ البداية
                                </label>
                                <input asp-for="StartDate" type="date" class="form-control qdrat-input" />
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="qdrat-field">
                                <label asp-for="EndDate" class="form-label">
                                    <i class="fas fa-calendar-check"></i>
                                    تاريخ النهاية
                                </label>
                                <input asp-for="EndDate" type="date" class="form-control qdrat-input" />
                                <span asp-validation-for="EndDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="qdrat-check-card h-100">
                                <div class="form-check form-switch m-0">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" />
                                    <label class="form-check-label" for="isActiveSwitch">
                                        <span class="qdrat-check-title">
                                            <i class="fas fa-toggle-on"></i>
                                            تفعيل الدورة
                                        </span>
                                        <span class="qdrat-check-text">عند التفعيل تظهر الدورة في قوائم التشغيل والربط داخل النظام.</span>
                                    </label>
                                </div>
                                <span asp-validation-for="IsActive" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="qdrat-actions mt-4">
                        <button type="submit" class="btn btn-success qdrat-btn-primary">
                            <i class="fas fa-save"></i>
                            حفظ الدورة
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary qdrat-btn-outline">
                            <i class="fas fa-times"></i>
                            إلغاء
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="qdrat-side-card mb-4">
                <div class="qdrat-side-icon">
                    <i class="fas fa-graduation-cap"></i>
                </div>
                <h5>تنظيم الدورات</h5>
                <p>
                    الدورة هي نقطة الربط بين المشروع والفرع والدفعات، لذلك يفضل إدخال بيانات واضحة وقابلة للفرز لاحقًا.
                </p>
            </div>

            <div class="qdrat-tips-card">
                <h6>
                    <i class="fas fa-lightbulb"></i>
                    ملاحظات إدخال
                </h6>
                <ul class="mb-0">
                    <li>استخدم اسمًا واضحًا يعبر عن نوع الدورة أو مستواها.</li>
                    <li>اختر الفرع والمشروع بدقة حتى تظهر الدورة في القوائم الصحيحة.</li>
                    <li>حدد تاريخ البداية والنهاية بما يتوافق مع خطة التشغيل.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
    .qdrat-page-header {
        background: linear-gradient(135deg, #f8fafc 0%, #eef4ff 100%);
        border: 1px solid #e5edf8;
        border-radius: 22px;
        padding: 24px;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.06);
    }

    .qdrat-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #64748b;
        font-size: 13px;
    }

        .qdrat-breadcrumb i {
            font-size: 10px;
            color: #94a3b8;
        }

    .qdrat-page-title {
        color: #1e293b;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .qdrat-page-title i {
            color: #2563eb;
        }

    .qdrat-page-subtitle {
        color: #64748b;
        font-size: 15px;
    }

    .qdrat-btn-back,
    .qdrat-btn-outline,
    .qdrat-btn-primary {
        border-radius: 14px;
        padding: 10px 18px;
        font-weight: 700;
    }

    .qdrat-card,
    .qdrat-side-card,
    .qdrat-tips-card {
        background: #ffffff;
        border: 1px solid #e5edf8;
        border-radius: 24px;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.06);
    }

    .qdrat-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #edf2f7;
    }

        .qdrat-card-header h5 {
            color: #1e293b;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .qdrat-card-header h5 i {
                color: #2563eb;
            }

        .qdrat-card-header p {
            color: #64748b;
            font-size: 14px;
        }

    .qdrat-form {
        padding: 24px;
    }

    .qdrat-field .form-label {
        color: #334155;
        font-weight: 800;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .qdrat-field .form-label i {
            color: #2563eb;
            width: 18px;
            text-align: center;
        }

    .qdrat-input {
        min-height: 48px;
        border-radius: 14px;
        border: 1px solid #dbe5f1;
        background-color: #fbfdff;
        transition: border-color .2s ease, box-shadow .2s ease, background-color .2s ease;
    }

    .qdrat-textarea {
        min-height: 120px;
        resize: vertical;
    }

    .qdrat-input:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .12);
        background-color: #ffffff;
    }

    .qdrat-check-card {
        border: 1px solid #dbeafe;
        border-radius: 18px;
        padding: 18px;
        background: #f8fbff;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .qdrat-check-card .form-switch {
            display: flex;
            gap: 12px;
            align-items: flex-start;
        }

        .qdrat-check-card .form-check-input {
            width: 3rem;
            height: 1.5rem;
            margin: 2px 0 0 0;
            cursor: pointer;
        }

    .qdrat-check-title {
        display: block;
        color: #1e293b;
        font-weight: 800;
        margin-bottom: 4px;
    }

        .qdrat-check-title i {
            color: #2563eb;
            margin-left: 6px;
        }

    .qdrat-check-text {
        display: block;
        color: #64748b;
        font-size: 13px;
        line-height: 1.7;
    }

    .qdrat-actions {
        border-top: 1px solid #edf2f7;
        padding-top: 20px;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: flex-start;
    }

    .qdrat-validation-summary {
        border-radius: 16px;
        border: 0;
    }

    .qdrat-side-card {
        padding: 26px;
        text-align: center;
    }

    .qdrat-side-icon {
        width: 72px;
        height: 72px;
        border-radius: 24px;
        background: #eff6ff;
        color: #2563eb;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        margin-bottom: 16px;
    }

    .qdrat-side-card h5 {
        color: #1e293b;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .qdrat-side-card p {
        color: #64748b;
        line-height: 1.8;
        margin-bottom: 0;
    }

    .qdrat-tips-card {
        padding: 22px;
    }

        .qdrat-tips-card h6 {
            color: #1e293b;
            font-weight: 800;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .qdrat-tips-card h6 i {
                color: #f59e0b;
            }

        .qdrat-tips-card ul {
            padding-right: 18px;
            color: #64748b;
            line-height: 2;
            font-size: 14px;
        }

    @@media (max-width: 768px) {
        .qdrat-page-header,
        .qdrat-card-header,
        .qdrat-form,
        .qdrat-side-card,
        .qdrat-tips-card {
            padding: 18px;
        }

        .qdrat-actions {
            flex-direction: column;
        }

            .qdrat-actions .btn,
            .qdrat-header-actions .btn {
                width: 100%;
            }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
