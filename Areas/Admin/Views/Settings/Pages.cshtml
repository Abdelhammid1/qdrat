@model IEnumerable<QdratNew.Entities.StaticPage>
@{
    ViewData["Title"] = "📄 الصفحات الثابتة";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-3 text-end">
    <a asp-action="CreatePage" class="btn btn-success">
        <i class="fa fa-plus-circle me-1"></i> إضافة صفحة جديدة
    </a>
</div>


<div class="container mt-4">
    <h2 class="fw-bold mb-4"><i class="fa-solid fa-file-lines me-2"></i> إدارة الصفحات الثابتة</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark text-center">
            <tr>
                <th>العنوان</th>
                <th>الرابط</th>
                <th>الحالة</th>
                <th style="width:150px;">تحكم</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Title</td>
                    <td><small class="text-muted">/Page/@p.Slug</small></td>
                    <td class="text-center">
                        @if (p.IsActive)
                        {
                            <span class="badge bg-success">نشطة</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">معطلة</span>
                        }
                    </td>
                    <td class="text-center">
                        <a asp-action="EditPage" asp-route-id="@p.Id" class="btn btn-sm btn-primary">
                            <i class="fa fa-edit"></i> تعديل
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
