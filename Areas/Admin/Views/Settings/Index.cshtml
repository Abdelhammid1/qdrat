@model List<QdratNew.Entities.SystemSetting>
@{
    ViewData["Title"] = "إعدادات النظام";

    var groups = new Dictionary<string, string>
    {
        { "التعليم", "DefaultHomeworkQuestionsPerLesson,SectionExamQuestionsCount,CurriculumExamQuestionsCount,CourseExamQuestionsCount,PromoExamQuestionCount,DefaultExamDurationMinutes,HomeworkRemedialThresholdPercentage,CurriculumLectureCount" },
        { "الاختبارات", "ExamTimePerQuestionSeconds,ExamEnforceAttendanceForLab,ExamAllowOnline,ExamAllowInLab,ExamPassPercentage,ExamShowAnswersAfterSubmit,ExamEnableAIRecommendations,FinalExamSharedQuantitativeCount,FinalExamSharedVerbalCount,FinalExamPerCurriculumQuestionCount,SelfAssessmentExamQuestionCount" },
        { "الهوية البصرية", "SiteName,SiteMetaDescription,SiteMetaKeywords,SiteLogoPath,SiteFaviconPath" },
        { "التواصل والدعم", "SupportEmail,FacebookPageUrl,FooterCopyright" },
        { "أخرى", "" } // أي إعداد غير موجود أعلاه هيتعرض هنا
    };
}

<div class="container mt-4" dir="rtl">
    <h4 class="mb-3 text-center">⚙️ إعدادات النظام</h4>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success text-center small">@TempData["Success"]</div>
    }

    @foreach (var group in groups)
    {
        var keys = group.Value.Split(',', StringSplitOptions.RemoveEmptyEntries);
        var settingsInGroup = group.Key == "أخرى"
        ? Model.Where(s => !groups.Any(g => g.Value.Split(',', StringSplitOptions.RemoveEmptyEntries).Contains(s.Key)))
        : Model.Where(s => keys.Contains(s.Key));

        if (!settingsInGroup.Any()) continue;

        <div class="mb-3">
            <h6 class="fw-bold border-bottom pb-1 mb-2 text-@(group.Key == "التعليم" ? "primary" : group.Key == "الاختبارات" ? "warning" : group.Key == "الهوية البصرية" ? "success" : group.Key == "التواصل والدعم" ? "info" : "secondary")">
                @(group.Key == "التعليم" ? "📘 إعدادات التعليم" :
                            group.Key == "الاختبارات" ? "📝 إعدادات الاختبارات" :
                            group.Key == "الهوية البصرية" ? "🎨 الهوية البصرية" :
                            group.Key == "التواصل والدعم" ? "📬 التواصل والدعم" :
                            "⚙️ أخرى")
        </h6>

            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-2">
            @foreach (var setting in settingsInGroup)
                {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm p-2" style="background-color:@(group.Key == "التعليم" ? "#f0f9ff" : group.Key == "الاختبارات" ? "#fff9ec" : group.Key == "الهوية البصرية" ? "#f9fff0" : group.Key == "التواصل والدعم" ? "#f0f0ff" : "#f9f9f9")">
                            <div class="card-body text-center p-2">
                                <div class="small text-muted mb-1">@setting.Description</div>
                                <div class="fw-bold small mb-2">@setting.Value</div>
                                <a asp-action="Edit" asp-route-id="@setting.Id" class="btn btn-sm btn-outline-secondary">تعديل</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
