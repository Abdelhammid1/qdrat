@model QdratNew.Entities.SystemSetting
@{
    ViewData["Title"] = "تعديل إعداد";

    bool isImageSetting = Model.Key == "SiteLogoPath" || Model.Key == "SiteFaviconPath";
    bool isBoolean = Model.Value?.ToLower() == "true" || Model.Value?.ToLower() == "false";
}

<h3 class="mb-3">⚙️ تعديل الإعداد: <span class="text-primary">@Model.Key</span></h3>

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="w-50" dir="rtl">
    <input type="hidden" asp-for="Id" />

    @if (isImageSetting)
    {
        <div class="mb-3">
            <label class="form-label">الصورة الحالية:</label><br />
            <img src="@Model.Value" class="img-thumbnail border border-2" style="max-height: 100px;" />
        </div>

        <div class="mb-3">
            <label class="form-label">اختيار صورة جديدة (اختياري)</label>
            <input type="file" name="ImageFile" class="form-control" accept="image/*" />
        </div>
    }

    <div class="mb-3">
        <label class="form-label">القيمة</label>

        @if (isImageSetting)
        {
            <input asp-for="Value" class="form-control" readonly />
        }
        else if (isBoolean)
        {
            <div class="form-check">
                <input class="form-check-input" type="radio" name="Value" value="true" @(Model.Value == "true" ? "checked" : "") />
                <label class="form-check-label">نعم</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="Value" value="false" @(Model.Value == "false" ? "checked" : "") />
                <label class="form-check-label">لا</label>
            </div>
        }
        else
        {
            <input asp-for="Value" class="form-control" />
        }
    </div>

    <div class="mb-3">
        <label class="form-label">الوصف</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-success">💾 حفظ</button>
    <a asp-action="Index" class="btn btn-secondary">↩️ رجوع</a>
</form>
