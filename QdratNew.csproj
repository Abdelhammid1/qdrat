<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>aspnet-QdratNew-5ff7680f-80ce-4104-88e6-8df55624869b</UserSecretsId>
		<LangVersion>latest</LangVersion>
		<Features>$(Features);experimental-data-section-string-literals</Features>

		<!-- ═══ Razor: compile at runtime in Debug, precompile on publish ═══ -->
		<RazorCompileOnBuild>false</RazorCompileOnBuild>
		
		<RazorCompileOnPublish>false</RazorCompileOnPublish>

		<!-- ═══ Build speed optimizations ═══ -->
		<!-- Disable Roslyn analyzers during build (run at design time only) -->
		<RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
		<!-- Skip source generators that slow incremental builds -->
		<EmitCompilerGeneratedFiles>false</EmitCompilerGeneratedFiles>
		<!-- No debug symbols for faster link step in Debug mode -->
		<DebugType Condition="'$(Configuration)'=='Debug'">portable</DebugType>

		<!-- ═══ Suppress warnings ═══ -->
		<NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8613;CS8618;CS8619;CS8620;CS8621;CS8625;CS8629;CS8714;CS0649;CS0472;CS1998;CS8073;CS0162;CS0219;CS0618</NoWarn>
	</PropertyGroup>

	<!-- 🧠 حذف كل المراجع القديمة الخاصة بـ System.* 4.3.0 -->
	<!-- لأن .NET 8 يحتوي عليها ضمن Microsoft.NET.Sdk.Web بالفعل -->

	<ItemGroup>
		<None Remove="MLModels\branch_model.zip" />
		<None Remove="MLModels\Charts\ChartAnalyzerModel.zip" />
		<None Remove="MLModels\student_model.zip" />
	</ItemGroup>

	<!-- 🧪 مشروع الاختبارات (QdratNew.Tests) مُتفرِّع بمشروعه الخاص — يُستبعد من هذا المشروع
	     لأنه بدون هذا الاستبعاد يلتقط SDK الافتراضي كل ملفات *.cs تحت هذا المجلد بما فيها
	     المجلد الفرعي، فيتعارض مع مراجع Xunit/Moq الخاصة بمشروع الاختبارات فقط. -->
	<ItemGroup>
		<Compile Remove="QdratNew.Tests\**" />
		<Content Remove="QdratNew.Tests\**" />
		<None Remove="QdratNew.Tests\**" />
		<EmbeddedResource Remove="QdratNew.Tests\**" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="MLModels\branch_model.zip" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="MLModels\Charts\ChartAnalyzerModel.zip" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="MLModels\student_model.zip" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="Properties\launchSettings.json" />
		<Content Include="Properties\serviceDependencies.json" />
		<Content Include="Properties\serviceDependencies.local.json" />
		<Content Include="Properties\ServiceDependencies\LMS-Qdrat-Tabuk - Web Deploy1\profile.arm.json" />
		<Content Include="Properties\ServiceDependencies\LMS-Qdrat-Tabuk - Web Deploy2\profile.arm.json" />
		<Content Include="Properties\ServiceDependencies\LMS-Qdrat-Tabuk - Web Deploy3\profile.arm.json" />
		<Content Include="Properties\ServiceDependencies\LMS-Qdrat-Tabuk - Web Deploy4\profile.arm.json" />
		<Content Include="Properties\ServiceDependencies\LMS-Qdrat-Tabuk - Web Deploy\profile.arm.json" />
	</ItemGroup>

	<ItemGroup>
		<None Update="app.db" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="Areas\**\Views\**\*.cshtml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Update="Views\**\*.cshtml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Update="Pages\**\*.cshtml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<!-- 🔹 ASP.NET & EF Core 8 -->
		<PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
		<PackageReference Include="ClosedXML" Version="0.102.0" />
		<PackageReference Include="EFCore.BulkExtensions" Version="8.0.0" />
		<PackageReference Include="EPPlus" Version="7.0.0" />

		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.4">
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		  <PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.5" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.2" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.17" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="8.0.2" />
		<PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="8.0.17" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="8.0.17" />

		<!-- 🔹 Logging & Utilities -->
		<PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />

		<!-- 🔹 Background Jobs -->
		<PackageReference Include="Hangfire" Version="1.7.36" />
		<PackageReference Include="Hangfire.AspNetCore" Version="1.7.36" />

		<!-- 🔹 ML & PDF -->
		<PackageReference Include="Microsoft.ML" Version="4.0.2" />
		<PackageReference Include="Microsoft.ML.FastTree" Version="4.0.2" />
		<PackageReference Include="Microsoft.ML.TimeSeries" Version="4.0.2" />
		<PackageReference Include="QuestPDF" Version="2024.3.0" />
		<PackageReference Include="Rotativa.AspNetCore" Version="1.4.0" />

		<!-- 🔹 Redis -->
		<PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.7" />

		<!-- 🔹 Puppeteer & Tools -->
		<PackageReference Include="PuppeteerSharp" Version="20.2.4" />
		<PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="8.0.7" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
	</ItemGroup>

	<!-- 🗂️ مجلدات المشروع -->
	<ItemGroup>
		<Folder Include="Areas\Admin\Data\" />
		<Folder Include="Areas\Admin\Models\" />
		<Folder Include="Areas\Identity\Controllers\" />
		<Folder Include="Areas\Identity\Views\" />
		<Folder Include="Areas\Instructors\Data\" />
		<Folder Include="Areas\Instructors\Models\" />
		<Folder Include="Areas\Public\Data\" />
		<Folder Include="Areas\Public\Models\" />
		<Folder Include="Areas\Students\Data\" />
		<Folder Include="Areas\Students\Models\" />
		<Folder Include="MLModels\Branches\CoursesTrend\" />
		<Folder Include="MLModels\Branches\PerformanceTrend\" />
		<Folder Include="MLModels\Branches\StudentsTrend\" />
		<Folder Include="MLModels\StudentProgress\" />
		<Folder Include="Models\" />
		<Folder Include="Models\Identity\" />
		<Folder Include="Modules\QuestionBank\Insights\Api\" />
		<Folder Include="Services\AI\Training\" />
		<Folder Include="Services\HomeworkEngine\Attempts\" />
		<Folder Include="Services\HomeworkEngine\Queries\" />
		<Folder Include="Services\Instructors\Scope\" />
		<Folder Include="wwwroot\images\slider\" />
		<Folder Include="wwwroot\lib\" />
		<Folder Include="wwwroot\uploads\editor\" />
		<Folder Include="wwwroot\uploads\courses\" />
		<Folder Include="wwwroot\uploads\passages\" />
		<Folder Include="wwwroot\uploads\partners\" />
		<Folder Include="wwwroot\uploads\pages\" />
		<Folder Include="wwwroot\uploads\slides\" />
	</ItemGroup>
	<ItemGroup>
	  <None Include="Properties\serviceDependencies.local.json.user" />
	</ItemGroup>

</Project>
